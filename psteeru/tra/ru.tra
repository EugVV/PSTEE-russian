@50206 = ~«Попроси его рассказать нам о Госпоже Боли».~
@50207 = ~«Попроси его рассказать нам о Фелле».~
@50208 = ~Над головой дабуса появляется одинокий символ. Это белый овал, перечёркнутый чёрной молнией. Дабус удерживает этот символ в воздухе несколько секунд, затем отворачивается и больше не реагирует.~
@50209 = ~«Хм… тогда прощай».~
@50210 = ~«Забудь. Пошли отсюда».~
@50211 = ~«Это всё, что я хотел знать. Прощай».~
@50212 = ~«Что он сказал, Грейс?»~
@50213 = ~«Спроси его, кто он такой».~
@50214 = ~«Спроси его, что он делает».~
@50215 = ~«Спроси его, что он делает».~
@50216 = ~«Спроси его, что он делает».~
@50217 = ~«Попроси его рассказать нам о Госпоже Боли».~
@50218 = ~Анна качает головой: «Не, я не собираюсь потом бродить в тени Госпожи, ну уж нет. Так мы только взгляд Госпожи привлечём из-за лишнего трёпа с её родней».~
@50219 = ~«Слушай, просто спроси его о Госпоже, хорошо?»~
@50220 = ~Анна качает головой: «Не, не буду».~
@50221 = ~«Просто *сделай* это. Я тебя предупредил».~
@50222 = ~Анна скрещивает руки, её хвост начинает раскачиваться взад и вперёд.~
@50223 = ~«Дай я попробую…»~
@50224 = ~«Забудь. Пошли отсюда».~
@50225 = ~«Хорошо. Можешь задать ему другой вопрос?»~
@50226 = ~«Забудь. Пошли отсюда».~
@50227 = ~«Хорошо. Можешь задать ему другой вопрос?»~
@50228 = ~«Забудь. Пошли отсюда».~
@50229 = ~«Попроси его рассказать нам о Фелле».~
@50230 = ~«Не, я не буду спрашивать старую родню Фелла о нём, не хочу. Он плохая кровь, и никому такие вопросы добра не принесут».~
@50231 = ~«Слушай, просто *задай* этот долбаный вопрос, ладно?»~
@50232 = ~«Можешь задать ему другой вопрос?»~
@50233 = ~«Забудь. Пошли отсюда».~
@50234 = ~«Забудь. Пошли отсюда».~
