@24699 = ~«Понятно».~
@24700 = ~«Э-э… подожди секунду. Ты сказал, дабусы парят, правильно? А этот ходит по земле».~
@24701 = ~«Э-э… подожди секунду. Ты сказал, дабусы парят, правильно? А этот ходит по земле».~
