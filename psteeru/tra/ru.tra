@33655 = ~Дистанционное оружие~
@33656 = ~«Послушай, Элис не хочет, чтобы кто-либо из вас пострадал… Разве вы не можете решить свои проблемы, не пугая её до смерти?»~
@33657 = ~законопослушный добрый.

Законопослушно-добрые персонажи свято верят в порядок и борются за улучшение жизни остальных. Но их определение «улучшения жизни» может разниться.~
@33658 = ~«Вот и мне тоже. Прощай».~
@33659 = ~«Послушай, Элис не хочет, чтобы кто-либо из вас пострадал… Разве вы не можете решить свои проблемы, не пугая её до смерти?»~
@33660 = ~«Послушай, Элис не хочет, чтобы кто-либо из вас пострадал… Разве вы не можете решить свои проблемы, не пугая её до смерти?»~
@33661 = ~«Прекрасно… прощай».~
@33662 = ~«Прекратите драку, а то я вас обоих в кровь изобью».~
