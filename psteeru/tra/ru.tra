@7934  = ~«Кого конкретно вы оплакиваете?»~
@7935  = ~«Кого конкретно вы оплакиваете?»~
@7936  = ~«Кого конкретно вы оплакиваете?»~
@7937  = ~«Неважно. У меня есть ещё несколько вопросов…»~
@7938  = ~«Пожалуй, я услышал достаточно. Прощай».~
@7939  = ~«Что вы делаете?»~
@7940  = ~«Почему ваша песнь изменилась?»~
@7941  = ~«Я оплакиваю мёртвого».~
@7942  = ~«Я прошу за того, кто потерял близкого».~
@7943  = ~«Я хотел бы послушать ваше пение».~
@7944  = ~«Прости, что потревожил тебя. Прощай».~
@7945  = ~Попытаться вспомнить…~
@7946  = ~Попытаться вспомнить…~
@7947  = ~Попытаться вспомнить…~
@7948  = ~Попытаться вспомнить…~
@7949  = ~Подавить воспоминание.~
@7950  = ~Восстановить ориентацию.~
@7951  = ~Восстановить ориентацию.~
@7952  = ~Слушать дальше.~
@7953  = ~Оставить их со своим пением.~
@7954  = ~«Я хочу задать тебе вопрос…»~
@7955  = ~Оставить их со своим пением.~
@7956  = ~«Я хочу задать тебе вопрос…»~
@7957  = ~Оставить их со своим пением.~
@7958  = ~«Я хочу задать тебе вопрос…»~
@7959  = ~Оставить их со своим пением.~
@7960  = ~«Я хочу задать тебе вопрос…»~
@7961  = ~Оставить их со своим пением.~
@7962  = ~«Ваша песнь изменилась… я слышу, что изменились мелодия и ритм».~
@7963  = ~«Хорошо, забудем».~
@7964  = ~«Я хочу ещё спросить…»~
@7965  = ~«Может быть. Прощай».~
@7966  = ~«Дейонарра? Я слышал о ней. Ты знаешь, как именно она умерла?»~
@7967  = ~«У меня другие вопросы…»~
@7968  = ~«Спасибо. Это всё, что я хотел узнать».~
@7969  = ~«Мне стало легче. Тот, кого вы оплакивали ранее, больше нуждается в вас, чем я».~
@7970  = ~«У меня другие вопросы…»~
@7971  = ~«Спасибо. Это всё, что я хотел узнать».~
@7972  = ~«Ей стало легче. Тот, кого вы оплакивали ранее, больше нуждается в вас, чем она».~
@7973  = ~«У меня другие вопросы…»~
@7974  = ~«Спасибо. Это всё, что я хотел узнать».~
@7975  = ~«Э-э… Адану стало легче. Тот, кого вы оплакивали ранее, больше нуждается в вас, чем он».~
@7976  = ~«У меня другие вопросы…»~
@7977  = ~«Спасибо. Это всё, что я хотел узнать».~
