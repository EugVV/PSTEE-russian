@68496 = ~ХОРОШО, ДАК'КОН. НАША СМЕРТЬ БЫЛА ДВУЕДИНОЙ. ТЫ ПОКИНЕШЬ ЭТО МЕСТО СВОБОДНЫМ.~
@68497 = ~ХОРОШО, ДАК'КОН. НАША СМЕРТЬ БЫЛА ДВУЕДИНОЙ. ТЫ ПОКИНЕШЬ ЭТО МЕСТО СВОБОДНЫМ.~
@68498 = ~ХОРОШО, ДАК'КОН. НАША СМЕРТЬ БЫЛА ДВУЕДИНОЙ. ТЫ ПОКИНЕШЬ ЭТО МЕСТО СВОБОДНЫМ.~
