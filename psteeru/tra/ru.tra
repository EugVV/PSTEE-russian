@34074 = ~~
@34075 = ~~
@34076 = ~~
@34077 = ~~
@34078 = ~~
@34079 = ~~
@34080 = ~~
@34081 = ~Чувство великой потери как чёрная вуаль окутывает эту женщину. Когда ты на неё смотришь, долгий горестный вздох слетает с её губ.~
@34082 = ~«Приветствую…»~
@34083 = ~Оставить женщину в покое.~
@34084 = ~Она смотрит на твоё лицо, прищурив подслеповатые глаза, чтобы получше тебя разглядеть: «Прости меня, молодой человек, но я старая женщина и почти ничего не вижу… я тебя знаю?»~
@34085 = ~«Нет».~
@34086 = ~«Возможно, но я тебя нет».~
@34087 = ~«Мы случайно встречались раньше, ничего больше».~
@34088 = ~Некоторое время она обдумывает твой ответ, качая головой. «Что в таком случае тебе от меня надо?»~
@34089 = ~«У меня вопросы…»~
@34090 = ~«На самом деле ничего. Прощай».~
@34091 = ~«Вопросы? — выражение её лица застывает. — О нет… ты ищешь приключений, не так ли? Имя, славу и прочий вздор? Так у меня этого нет! Проваливай!»~
@34092 = ~«Я не ищу приключений».~
@34093 = ~«Да нет… по крайней мере не совсем…»~
@34094 = ~«Тогда прощай».~
@34095 = ~«Задвинься! — женщина тыкает тебя пальцем. — Я была свидетельницей того, как Пыльные занесли в свой Мемориал имя моего мужа — да будь он проклят — моего сына и двух моих дочерей, все они были „искателями приключений“! В тот день мне *самой* пришлось взять меч в руки, поэтому я знаю, что это такое!» Кажется, пожилая женщина начинает вспоминать былую форму: её щеки покрываются румянцем, брызги слюны слетают с губ, когда она разгорячённо кричит на тебя.~
@34096 = ~Позволить ей продолжить тираду.~
@34097 = ~Уйти.~
@34098 = ~«Бьюсь об заклад, у тебя накопилась целая *куча* разных идиотских вопросов! — она пародирует твою героическую позу. — Приветствую, у меня к вам есть несколько вопросов… не могли бы вы рассказать мне об этом месте? Кто такая Госпожа Боли? Я ищу магический Железный Пояс Пижона, вы его не видели? Не знаете, случайно, где находится портал на 2817-й план Бездны? Не расскажете, где может находиться Замораживающий-и-Пылающий Святой Ворпальный Молот-Убийцы-Гронков, Поражающий и Возвращающий, Стреляющий-Молниями-из-Твоей-Задницы?» Она сплёвывает: «Дерьмо это всё! Только до книги мёртвых тебя доведёт! Я должна пнуть тебя под зад только за то, что вообще осмелился донимать всем этим бедную старую женщину! Теперь убирайся и оставь меня в покое!»~
@34099 = ~Уйти.~
@34100 = ~Когда женщина прищурившись разглядывает твоё лицо, её выражение ожесточается: «Нет, нет, нет! Только не ты опять! Я не скажу тебе больше ни слова, пшёл отсюда! *ПШЁЛ!*»~
@34101 = ~Уйти.~
@34102 = ~Кажется, эта тяжёлая дверь не просто заперта, а забаррикадирована. Здесь пройти не удастся.~
@34103 = ~Ты слишком далеко, чтобы это обследовать.~
@34104 = ~Эти руны наполнены мистической силой.~
@34105 = ~Из жерла этой огромной трубы время от времени вылетают порывы горячего скверно пахнущего воздуха. Тяжёлая железная решётка преграждает проход внутрь.~
@34106 = ~Этот человек, должно быть, умер от какой-то жуткой изнурительной болезни.~
@34107 = ~Когда ты входишь в помещение, огромный коренастый мужчина встаёт со своего стула и подходит к тебе: «Здорово! Меня звать Биш. А ты кто будешь?»~
@34108 = ~«Чё значит нет имени? Тока в Стикс окунулся, ты, хрен безмозглый?! — ты замечаешь, что рука Биша медленно тянется к оружию. — Или просто не хошь мне говорить? Думаю, ты чёт скрываешь».~
@34109 = ~«Ад… чё?» — Биш бессмысленно глазеет на тебя, затем резко трясёт головой. «Я никогда тебя раньше не видел, и Фарод ничего не говорил, что какой-то „Адан“ придёт, — ты замечаешь, что рука Биша медленно тянется к оружию. — Объясни-ка лучше путём, чё ты здесь делаешь, пень».~
@34110 = ~Неожиданно Биш выхватывает своё оружие: «Прекрасно. Если не хочешь выкладывать правду по-хорошему, я выбью её из тебя».~
@34111 = ~Ты разворачиваешься, чтобы уйти, но Биш преграждает тебе дорогу. «Спрашиваю последний раз, пень! Как твоё ИМЯ?!»~
@34112 = ~«Если б Фарод хотел тебя видеть, я б об этом знал, — неожиданно Биш выхватывает оружие. — Я устал играть в угадайки, пень. Лучше поищу ответы на твоём мёртвом теле».~
@34113 = ~«Получается, ты уже тута был? С дневником или без, я никогда в жизни тебя не видел. Я так понимаю, ты прошмыгнул у меня под носом, — неожиданно Биш выхватывает оружие. — Надеюсь, оно стоило твоей жизни, пень».~
@34114 = ~Биш раздражённо вскидывает руки вверх. «Забудь, пень! Это уже не важно, — он мотает головой туда-сюда. — Куда важней вопрос: чё ты здесь делаешь?»~
@34115 = ~Биш недовольно хмурит брови: «Ладно. Ты можешь идти». Когда ты проходишь мимо Биша, он наклоняется и тихо предупреждает: «Но помни, пень. Будут там внизу проблемы из-за тебя — я разнесу тебе череп, если опять увижу».~
@34116 = ~Биш качает головой: «Нам всем что-то нужно, парень». Он разражается смехом: «Я тебя не знаю и ты мне не нравишься, так что предлагаю сделку. Твои деньги или твоя голова».~
@34117 = ~«Ты ещё большая бестолочь, чем я думал, парень! — Биш пожимает плечами. — Ну ладно, тощий мальчик, давай выясним, чё ты за птица!»~
@34118 = ~Биш рычит. «Ты выглядишь как годный громила, точняк, — он кивает тебе, а затем достаёт оружие. — Но через меня тебе не прорваться».~
@34119 = ~Биш тщательным образом осматривает твои пожитки. «Всё равно надо бы отвернуть тебе башку, ведь это всё, чего ты заслуживаешь! Теперь убирайся. И предупреждаю, если наделаешь там внизу шуму, я тебя разыщу и выбью всё, что ещё осталось!»~
@34120 = ~Ты видишь Биша, несущего свою службу. Как только ты приближаешься, он бросает на тебя взгляд и кивает: «Здорово. Иди своей дорогой и пошустрей».~
@34121 = ~Биш осматривает твои пожитки в поисках денег… но ничего не находит. «Решил отнять моё время или думал, что твоя шкура чё-то стоит? — Биш размахивает оружием. — Кажись, взамен мне придётся продать твоё мёртвое тело!»~
@34122 = ~Биш подскакивает, чтобы поприветствовать тебя с оружием в руках: «Ты слышал, чё я тебе сказал, пень? Пришёл сюда подраться — так щас я размозжу твой череп!»~
@34123 = ~«У меня нет имени».~
@34124 = ~Ложь: «Меня зовут „Адан“».~
@34125 = ~«Не твоё дело».~
@34126 = ~Не обращать внимания на мужчину, идти дальше.~
@34127 = ~«Послушай, я говорю тебе правду. Я не знаю своего имени».~
@34128 = ~«Мне нечего скрывать и я не собираюсь создавать проблем. Я просто хочу пройти».~
@34129 = ~Ложь: «Ладно, ладно… меня зовут „Адан“».~
@34130 = ~«Я просто хочу пройти»~
@34131 = ~«Если сейчас же не отойдёшь в сторону, ты дорого за это заплатишь».~
@34132 = ~«Если сейчас же не отойдёшь в сторону, ты дорого за это заплатишь».~
@34133 = ~«Я ищу мужчину по имени Фарод».~
@34134 = ~«Я ищу дневник».~
@34135 = ~«Мне сказали, что в этих местах я смогу найти Фарода».~
@34136 = ~«Не твоё дело».~
@34137 = ~Атаковать Биша.~
@34138 = ~«Я ищу мужчину по имени Фарод».~
@34139 = ~«Я ищу дневник».~
@34140 = ~«Не твоё дело».~
@34141 = ~«Мне нечего скрывать и я не собираюсь создавать проблем. Я просто хочу пройти».~
@34142 = ~«Я просто хочу пройти»~
@34143 = ~«Если сейчас же не отойдёшь в сторону, ты дорого за это заплатишь».~
@34144 = ~«Если сейчас же не отойдёшь в сторону, ты дорого за это заплатишь».~
@34145 = ~Атаковать Биша.~
@34146 = ~Не обращать внимания на Биша, идти дальше.~
@34147 = ~«Только попробуй…»~
@34148 = ~«Я не знаю, как меня зовут».~
@34149 = ~Ложь: «Меня зовут „Адан“».~
@34150 = ~«Не твоё дело!»~
@34151 = ~Атаковать Биша.~
@34152 = ~Продолжать игнорировать Биша и постараться его обойти.~
@34153 = ~«Я так не думаю…»~
@34154 = ~«В любом случае…»~
@34155 = ~«Я ищу мужчину по имени Фарод».~
@34156 = ~«Я ищу дневник».~
@34157 = ~«Не твоё дело».~
@34158 = ~«Я не собираюсь создавать проблем. Просто хочу пройти».~
@34159 = ~«Я просто хочу пройти»~
@34160 = ~«Если сейчас же не отойдёшь в сторону, ты дорого за это заплатишь».~
@34161 = ~«Если сейчас же не отойдёшь в сторону, ты дорого за это заплатишь».~
@34162 = ~Атаковать Биша.~
@34163 = ~Не обращать внимания на Биша, идти дальше.~
@34164 = ~«Прощай…»~
@34165 = ~«Как захочу, так и поступлю…»~
@34166 = ~«Тогда деньги».~
@34167 = ~«Тогда деньги».~
@34168 = ~«Ничего я тебе не дам!»~
@34169 = ~«Я тебе покажу бестолочь…»~
@34170 = ~«Вынужден не согласиться…»~
@34171 = ~«Уже иду».~
@34172 = ~«Ублюдок…»~
@34173 = ~«Замётано».~
@34174 = ~«Попробуй…»~
@34175 = ~«Много болтаешь…»~
@34176 = ~Эта солоноватая, ржавого цвета вода холодна как лёд.~
@34177 = ~Похоже на бур огромной бурильной установки, вгрызшийся в камень и соскочивший со своей оси.~
@34178 = ~Невозможно точно сказать, что это за механизм. Скорее всего, он предназначался для добычи руды или бурения камня.~
@34179 = ~[нет текста]~
@34180 = ~[нет текста]~
@34181 = ~[нет текста]~
@34182 = ~[нет текста]~
@34183 = ~[нет текста]~
@34184 = ~Покои Ненни~
@34185 = ~Покои Джульетты~
@34186 = ~Лестница вверх в Бордель~
@34187 = ~Сотни кусочков полупрозрачного зелёного стекла, из которых состоит этот витраж, как будто ничем не прикреплены друг к другу, а скорее свободно движутся, чудесным образом не покидая границ железной рамы. Кусочки колышутся и двигаются медленными волнами, вызывая постоянно меняющиеся фантастические рисунки на поверхности, когда различные их части преломляют падающий из галереи свет. Небольшая табличка около рамы гласит: «Аркадийские витражи».~
@34188 = ~Массивный рог из кованого свинца, оплетённый бронзовыми цепями. Рог ужасно искорёжен, будто его раздавила какая-то сокрушительная сила. По всей его длине торчат зазубренные лезвия, словно он должен был использоваться не только как боевой рог, но и в качестве дубины для какого-то огромного существа. Табличка под ним гласит: «Очищающий рог Ахерона».~
@34189 = ~Приложить голову к стене и попробовать подуть в рог.~
@34190 = ~На этом пьедестале стоит прекрасная рубиновая статуэтка, изображающая человекоподобное создание с крыльями. Фигурка то ли дьявола, то ли ангела… точно определить невозможно, так как она странным образом преломляет свет, падающий на неё из галереи. Рядом со статуей нет таблички, указывающей название произведения искусства.~
@34191 = ~Этот прозрачный камень, покоящийся в петле из гравированных серебряных лент, ярко пульсирует внутренним светом. У его основания вырезано слово «ИВЕС».~
@34192 = ~Живая кровавая железная цепь, которая сматывается и разматывается сама по себе. Кажется, цепь гнётся и извивается, словно хребет змеи. Маленькая табличка гласит: «Живая цепь китона из Шумного Хитера».~
@34193 = ~Эта картина — абстрактное сочетание зелёных и фиолетовых тонов. Когда на неё смотрят, изображение покрывается рябью и извивается. При более внимательном изучении становится ясно, что меняется нарисованное изображение, а не холст, на котором оно нарисовано. На табличке написано: «Мгновенный Взгляд со стен Моч'чмы».~
@34194 = ~Этот янтарного цвета камень, покоящийся в петле из гравированных серебряных лент, пульсирует мягким жёлтым светом. У его основания вырезаны слова «КИМАЗИ ЯЗЫК-ГАДЮКИ».~
@34195 = ~Этот камень оранжево-красного цвета, покоящийся в петле из гравированных серебряных лент, пульсирует тёплым оранжевым светом. У его основания вырезано слово «ДОЛОРА».~
@34196 = ~Поверхность этой картины — дикий коллаж ярких цветов… она постоянно колеблется, будто это поверхность пруда во время мелкого дождика. Табличка гласит: «Эскиз движения волн #7».~
@34197 = ~Этот прозрачный бело-голубой камень, покоящийся в петле из гравированных серебряных лент, пульсирует мягким голубым светом. У его основания вырезано слово «КЕЗАЙ-СЕРРИС».~
@34198 = ~Серия из четырёх картин, изображающих пустынный пляж в ночной тиши. Воздух вокруг картин слегка пахнет морем, и кажется, что нарисованные волны накатываются на тёмный берег. Табличка гласит: «Побережье Каразутры».~
@34199 = ~Этот сиреневый камень, покоящийся в петле из гравированных серебряных лент, пульсирует насыщенным фиолетовым светом. У его основания вырезано слово «МАРИССА».~
@34200 = ~На картине изображены высокие чёрные скалы на фоне кроваво-красного неба. Кажется, будто в расщелинах скал скрываются фигуры людей, но когда ты вглядываешься в картину и пытаешься их различить — они словно растворяются. Табличка гласит: «Налётчики Внешних Земель».~
@34201 = ~На этой картине нарисовано нечто, похожее на бесконечно длинную уходящую в темноту струю тошнотворного зелёного газа. В правом нижнем углу картины видна пустынная скалистая равнина… создаётся впечатление, что «голова» зелёного облака сейчас нанесёт по ней удар. Табличка гласит: «Хазазот поглощает Н'гара».~
@34202 = ~На этой картине изображён морской берег с огромным оранжево-красным солнцем, садящимся то ли за полуостров, то ли за большой пирс. Сама сцена хотя и лишена оригинальности, но захватывает дух — игра угасающего дневного света на поверхности воды передана великолепно. Но если долго смотреть на солнце — начинают болеть глаза. Табличка гласит: «Поверхность Таласии».~
@34203 = ~На этой картине изображена огромная гранитная башня — уродливая и низкая, утыканная злобно смотрящими горгульями — в обрамлении чего-то похожего на ночное небо. На заднем плане по правому краю полотна вихрем кружится облако фиолетово-красных испарений. Табличка гласит: «Библиотека».~
@34204 = ~На этой картине — тёмный городской пейзаж, отдалённый вид на огромный центр цивилизации, сожжённый дотла. Однако улицы города пусты — нет ни солдат, ни беженцев, ни даже трупов. Табличка гласит: «Глупость Удо».~
@34205 = ~Это похоже на подземный пейзаж… огромная пещера заполнена цветными, слабо светящимися гигантскими грибами. Табличка гласит: «Долина под Клангеддином».~
@34206 = ~Это гротескный портрет старой-престарой карги с длинным крючковатым носом. Её кожа болезненного серо-голубого цвета, глаза горят красным светом, как угольки затухающего огня. Её длинный острый подбородок сильно выступает вперёд, два жёлтых клыка, как маленькие бивни, торчат вверх из нижней челюсти. Злая улыбка на иссохших лиловых губах говорит о какой-то страшной тайне. Табличка гласит: «Серая ведьма Оиноса».~
@34207 = ~Этот фиолетово-голубой камень, покоящийся в петле из гравированных серебряных лент, пульсирует мягким сиреневым светом. У его основания вырезано слово «ВИВЬЕН».~
@34208 = ~Этот полупрозрачный зелёный камень, покоящийся в петле из гравированных серебряных лент, пульсирует ярко-зелёным светом. У его основания вырезано слово «ЭККО».~
@34209 = ~Этот ярко-красный камень, покоящийся в петле из гравированных серебряных лент, пульсирует пламенеющим кровавым светом. У его основания вырезано слово «НЕННИ».~
@34210 = ~Этот полупрозрачный фиолетово-синий камень, покоящийся в петле из гравированных серебряных лент, пульсирует тёмно-синим светом. У его основания вырезано слово «ДЖУЛЬЕТТА».~
@34211 = ~Этот бело-серый камень, покоящийся в петле из гравированных серебряных лент, пульсирует внутренним светом. Когда-то на его основании была вырезана надпись, но кто-то её старательно стёр.~
@34212 = ~«Я камень чувств #1 общественного сенсориума в Фестхолле».~
@34213 = ~«Я камень чувств #2 общественного сенсориума в Фестхолле».~
@34214 = ~Это необычный фиолетовый камень. Он надёжно прикреплён к основанию, на котором покоится.~
@34215 = ~Это необычный жёлто-зелёный камень. Он надёжно прикреплён к основанию, на котором покоится.~
@34216 = ~Это необычный оранжево-красный камень. Он надёжно прикреплён к основанию, на котором покоится.~
@34217 = ~Это необычный фиолетовый камень. Он надёжно прикреплён к основанию, на котором покоится.~
@34218 = ~Это необычный голубой камень. Он надёжно прикреплён к основанию, на котором покоится.~
@34219 = ~Это необычный оранжево-красный камень. Он надёжно прикреплён к основанию, на котором покоится.~
@34220 = ~Это необычный фиолетовый камень. Он надёжно прикреплён к основанию, на котором покоится.~
@34221 = ~Это необычный пурпурно-синий камень. Он надёжно прикреплён к основанию, на котором покоится.~
@34222 = ~Принести Ай-Вин бальзамирующую жидкость и нитку с иголкой.~
@34223 = ~Я повстречал странную женщину с когтями на руках и кожей цвета свиного сала на втором этаже Мортуария в комнате для бальзамирования. Она приняла меня за зомби и попросила принести ей бальзамирующую жидкость и нитку с иголкой. Эти вещи должны быть где-то в Мортуарии.~
@34224 = ~Я повстречал странную женщину с когтями на руках и кожей цвета свиного сала на втором этаже Мортуария в комнате для бальзамирования. Она приняла меня за зомби и попросила принести бальзамирующую жидкость и нитку с иголкой. Поиски заняли какое-то время, но я всё же сумел найти их и отдать ей.~
@34225 = ~Достать для Ваксиса ключ от комнаты бальзамирования.~
@34226 = ~В самой восточной комнате Мортуария, южнее комнаты для бальзамирования, я встретил шпиона, замаскировавшегося под зомби. Он попросил принести ему ключ от этой комнаты, а взамен пообещал помочь мне сбежать отсюда.~
@34227 = ~В самой восточной комнате Мортуария, южнее комнаты для бальзамирования, я встретил шпиона, замаскировавшегося под зомби. Он попросил принести ему ключ от этой комнаты, а взамен пообещал помочь мне сбежать отсюда. Я получил ключ от Ай-Вин и отдал его Ваксису.~
@34228 = ~Помочь зомби Димтри уйти на покой.~
@34229 = ~Зомби Димтри хочет уйти на заслуженный отдых, упокоившись с миром. Я должен найти его создателя, Себастьяна, и узнать, как это можно сделать.~
@34230 = ~Я выучил нужное заклинание, чтобы освободить Димтри от магии Себастьяна. Димтри наконец ушёл на заслуженный отдых.~
@34231 = ~Достать со склада подушку для гроба.~
@34232 = ~Мне нужно получить на складе подушку для гроба. Но сперва мне, возможно, придётся разобраться со сложившейся там ситуацией.~
@34233 = ~Я успешно справился со всеми трудностями на складе, и теперь подушка для гроба у меня.~
@34234 = ~Достать со склада планы гробницы.~
@34235 = ~Максимальные пункты здоровья:~
@34236 = ~Сила:~
@34237 = ~Интеллект:~
@34238 = ~Мудрость:~
@34239 = ~Ловкость:~
@34240 = ~Телосложение:~
@34241 = ~Харизма:~
@34242 = ~Класс защиты:~
@34243 = ~Мировоззрение изменилось [Морте]~
@34244 = ~Анзе награждает тебя своей обычной беззубой улыбкой: «С возвращеньицем, здоровяк. Чёт понадобилось опять?»~
@34245 = ~«Я хочу взглянуть на твой товар».~
@34246 = ~«У меня пара вопросов…»~
@34247 = ~«Ничего. Прощай».~
@34248 = ~«Я скорблю по моему мальчику, Лазло. Магазин закрыт до… прям и не знаю, када открою…»~
@34249 = ~Уйти.~
@34250 = ~У тебя ловкость неповоротливого дурачка. Ты получаешь ухудшение к классу зашиты -%d.~
@34251 = ~Твоя ловкость демонстрирует твои плохо развитые рефлексы. Ты получаешь ухудшение к классу зашиты -%d.~
@34252 = ~Твой низкий уровень ловкости приносит тебе ухудшение к классу зашиты -%d.~
@34253 = ~Твоё болезненное телосложение уменьшает пункты здоровья на %d за уровень.~
@34254 = ~Твой низкий уровень телосложения стоит тебе ухудшения в размере -%d пунктов здоровья за каждый уровень.~
@34255 = ~Твой интеллект приносит тебе славу полного идиота.~
@34256 = ~Твой интеллект намного ниже среднего уровня.~
@34257 = ~Твой интеллект ниже среднего уровня.~
@34258 = ~Твоя мудрость приносит тебе славу одного из самых глупых людей.~
@34259 = ~Твоя мудрость намного ниже среднего уровня.~
@34260 = ~Твоя мудрость ниже среднего уровня.~
@34261 = ~Твоё телосложение ниже среднего.~
@34262 = ~Твоя харизма отвратительна.~
@34263 = ~Твоя харизма намного ниже среднего уровня.~
@34264 = ~Ты видишь большого и шумного торговца. Он выглядит абсолютно безволосым, а его жёлтая кожа вся изрезана шрамами от ожогов. Он пристально смотрит, как ты подходишь.~
@34265 = ~«Приветствую».~
@34266 = ~Не обращать на него внимания.~
@34267 = ~Он улыбается: «Здорово, я Циндер. Я слышал о тебе. Ты — парень со шрамами, бестолочь, которая ходит по району и задаёт вопросы. Чем я могу тебе помочь?»~
@34268 = ~«Ну, у меня кое-какие вопросы…»~
@34269 = ~«У тебя, как я вижу, тоже чуток шрамов имеется».~
@34270 = ~«Ничем, прощай».~
@34271 = ~«С удовольствием отвечу на твои вопросы… — он прищуривает глаза и хитро улыбается. — По поводу магазина и товаров, которые ты здесь видишь, вот и всё. Я не проводник, ясно?»~
@34272 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@34273 = ~«У меня был череп, но его украли. Не знаешь, кто бы мог это сделать?»~
@34274 = ~«Мне нужно приобрести оружие».~
@34275 = ~«Мне нужны магические товары».~
@34276 = ~«Меня интересуют заклинания».~
@34277 = ~«Что это за место?»~
@34278 = ~«Мне пора идти. Прощай».~
@34279 = ~Он хмурится, задумавшись: «Лотар… Повелитель Ко… не-а, ни о чём не говорит».~
@34280 = ~«Ясно. У меня ещё вопросы…»~
@34281 = ~«Спасибо, прощай».~
@34282 = ~Он хмурится: «Череп? Ты сказал… череп?»~
@34283 = ~«Да, череп».~
@34284 = ~«Нет, я просто пошутил».~
@34285 = ~«Неважно. Прощай».~
@34286 = ~Он выглядит озадаченно: «Не вижу никаких причин держать у себя череп, не говоря уж зачем какому-то пню вдруг красть его у тебя».~
@34287 = ~«Ясно. У меня ещё вопросы…»~
@34288 = ~«Спасибо, прощай».~
@34289 = ~Он смотрит на тебя с раздражением: «Мне вполне ясно, что нам с тобой не по пути, здоровяк. Возвращайся, когда появится ко мне серьёзное дело».~
@34290 = ~«У меня ещё вопросы…»~
@34291 = ~«Мне пора идти. Прощай».~
@34292 = ~Он выглядит сердитым: «Плевать мне на твои вопросы. *Покупать* что-нибудь собираешься или нет? Моя жизнь не настолько длинная, чтоб разбазаривать время на вопросы. Если хочешь потрепаться — поговори вон с тем ленивым мальчишкой, Лазло. Только дай парню шанс, и в его трёп Великое Кольцо можно будет завернуть».~
@34293 = ~«Лазло?»~
@34294 = ~«Спасибо, прощай».~
@34295 = ~Он кивает: «Он обычно присматривает за топкой».~
@34296 = ~«Спасибо, прощай».~
@34297 = ~Он указывает на другой конец рынка: «Тогда тебе нужен Анзе. Он торгует около печи».~
@34298 = ~«Я хотел спросить о другом…»~
@34299 = ~«Спасибо, прощай».~
@34300 = ~Он указывает на другой конец рынка: «Тогда тебе нужен Аалек. Его лавка за печью в самом дальнем углу».~
@34301 = ~«Я хотел спросить о другом…»~
@34302 = ~«Спасибо, прощай».~
@34303 = ~Он улыбается: «Думаю, я могу тебе помочь. Разреши мне показать тебе свой товар».~
@34304 = ~«Хорошо».~
@34305 = ~«Неважно, прощай».~
@34306 = ~Пустая вершина~
@34307 = ~~
@34308 = ~~
@34309 = ~~
@34310 = ~Сперва он хмурится, затем начинает громко смеяться: «Ага, есть такое дело. Несколько лет назад у меня была хата в Улье. Один сбрендивший маг решил спалить район. Чуть меня вместе с ним не сжёг. Целый месяц я после этого болел».~
@34311 = ~«Месяц? Ну, ещё легко отделался».~
@34312 = ~«Ясно. У меня другие вопросы…»~
@34313 = ~«Мне пора идти. Прощай».~
@34314 = ~Он кивает и какое-то время смотрит вдаль: «Ага, могло быть и хуже. Местный маг вылечил меня, заживил шрамы и всё такое. Мог бы и волосы вернуть, но мне, в принципе, и так нравится».~
@34315 = ~«Как думаешь, этот маг сможет залечить мои шрамы?»~
@34316 = ~«Ясно. У меня другие вопросы…»~
@34317 = ~«Мне пора идти. Прощай».~
@34318 = ~Он оглядывает тебя, затем пожимает плечами. «А почему бы и нет? Твои шрамы не так уж плохо выглядят… — он осматривает тебя внимательней. — Ну да, тебе стоит к нему обратиться. Но говорить с ним будешь сам. Его зовут Себастьян; он постоянно торчит около Кузницы».~
@34319 = ~«Возможно, так и сделаю. У меня к тебе другие вопросы…»~
@34320 = ~«Мне пора идти. Прощай».~
@34321 = ~Циндер тебе улыбается: «Ага, вернулся? Что я могу предложить тебе на этот раз?»~
@34322 = ~«У меня кое-какие вопросы…»~
@34323 = ~«Мне нужны кое-какие заклинания».~
@34324 = ~«Ничего, прощай».~
@34325 = ~Он горделиво показывает вокруг себя. «Это открытый рынок, один из лучших в Сигиле. Просто подарок судьбы, что ты здесь оказался, парень. У нас тут есть пустой прилавок, — он указывает на прилавок по соседству. — Если ты купец, то можешь открыть свою лавку и обмениваться товаром с остальными, если только от тебя не будет слишком много шума или проблем…»~
@34326 = ~«Почему тот прилавок пуст?»~
@34327 = ~«Буду иметь в виду. У меня к тебе ещё вопросы…»~
@34328 = ~«Спасибо, я должен идти. Прощай».~
@34329 = ~Он бросает взгляд на пустой прилавок: «Раньше этим прилавком владел купец, которого звали Зак. Недавно он заполучил себе страничку в книге мёртвых». Он хмурится: «Это очень странная история».~
@34330 = ~«В каком смысле?»~
@34331 = ~«Книге мёртвых?»~
@34332 = ~«Я хотел спросить о другом…»~
@34333 = ~«Спасибо, я должен идти. Прощай».~
@34334 = ~На минуту он задумывается. «Ну… я не знаю всех секретов этого дела, но у Зака были проблемы, и он нуждался в деньгах. Он занял денег у ростовщика Байрона Пикита. После этого Пикит пытался прибрать его бизнес к рукам, но Зак отказывался», — он замолкает.~
@34335 = ~«Продолжай».~
@34336 = ~Он вздыхает и качает головой: «Немного спустя Зак был мёртв. Пикит вызвал его вдову, Трист, в суд, чтобы взять с неё бабки, которые был должен Зак. Она заявила, что долг был выплачен и обещала предоставить подтверждающие это бумаги… но бумаг не оказалось».~
@34337 = ~«Так что же всё-таки случилось?»~
@34338 = ~«Я хотел спросить о другом…»~
@34339 = ~«Спасибо, я должен идти. Прощай».~
@34340 = ~Он пожимает плечами: «Без доказательства, что долг был выплачен, дело продали, а вдову Трист признали ответственной за оставшуюся часть долга. Она не смогла выплатить долг, так что её ждёт помост».~
@34341 = ~«Помост?»~
@34342 = ~«Ты что-то говорил о пропавших бумагах».~
@34343 = ~«Я хотел спросить о другом…»~
@34344 = ~«Спасибо, я должен идти. Прощай».~
@34345 = ~«Ага, аукционный помост. Если не можешь расплатиться по долгам, тебя в качестве наказания продают в рабство на несколько лет», — он печально качает головой.~
@34346 = ~«Где мне найти помост?»~
@34347 = ~«Ты что-то говорил о пропавших бумагах».~
@34348 = ~«Я хотел спросить о другом…»~
@34349 = ~«Спасибо, я должен идти. Прощай».~
@34350 = ~«Двигайся на север от рынка. Ты не ошибёшься, там будет толпа».~
@34351 = ~«Ты что-то говорил о пропавших бумагах».~
@34352 = ~«Я хотел спросить о другом…»~
@34353 = ~«Спасибо, я должен идти. Прощай».~
@34354 = ~«Ага. Трист говорила, что её муж Зак выплатил долг полностью и что у неё были подтверждающие это бумаги. Когда она собиралась их предъявить, бумаг не обнаружилось, — он фыркает и выглядит раздражённым. — Я думаю, за всем этим стоит Пикит».~
@34355 = ~«Где я могу найти этого Пикита?»~
@34356 = ~«Кто-нибудь занимается этим делом?»~
@34357 = ~«Ясно. Я хотел спросить о другом…»~
@34358 = ~Он странно смотрит на тебя: «Ага, ты бестолочь, что ли? Он был убит и записан в книгу мёртвых».~
@34359 = ~«Ясно. Так ты рассказывал мне о пустом прилавке».~
@34360 = ~«Ясно. Я хотел спросить о другом…»~
@34361 = ~«Спасибо, я должен идти. Прощай».~
@34362 = ~«Обычно он торчит снаружи рынка, прямо у входа, здоровяк. Ты его не пропустишь».~
@34363 = ~«Ясно. Я хотел спросить о другом…»~
@34364 = ~«Спасибо, я должен идти. Прощай».~
@34365 = ~Эта темноволосая бледнокожая женщина выглядит образованной и изысканной. Когда она поворачивается к тебе, ты замечаешь, что её глаза — ранее казавшиеся серыми — цвета полированной стали.~
@34366 = ~«Приветствую…»~
@34367 = ~«Тогда не будем терять времени, ладно? Мои Клинки защитят меня».~
@34368 = ~«Ты всегда должен быть уверен, парень. Вот я уверен, что ты скоро умрёшь», — он делает лёгкое движение рукой.~
@34369 = ~«Думай как хошь, а всё, что здесь происходит, — это моё дело. Ещё раз спрашиваю… чего тебе здесь надо?»~
@34370 = ~«Жаль, что приходится тебе это говорить. Ещё больше жаль, что ты умрёшь», — он делает сигнал рукой и достаёт нож.~
@34371 = ~«Уже нашёл Чёрную Розу? Завалил его, как мы договаривались?»~
@34372 = ~«Ещё нет? Ты что, неспособен? Иди уже, найди его и не возвращайся, пока не выполнишь заказ!» — он раздражённо отворачивается.~
@34373 = ~Глаза Гнилого Уильяма загораются: «Ты всех уделал, да? Тогда у меня для тебя награда. Дай я только её достану…» — внезапно он выхватывает кинжал и намеревается проткнуть тебе живот.~
@34374 = ~Его глаза кинжалами впиваются в тебя: «Ты убил ту жалкую суку, как я тебе приказал, или опять пришёл хвастаться своей неудачей?»~
@34375 = ~Он качает головой. «Даже эти засранцы, которые называют себя моими товарищами, способны сделать то, что обещают. От тебя вообще никакой пользы. Мы сделаем всему городу одолжение, если от тебя избавимся», — он вытаскивает нож.~
@34376 = ~«Ага, так ты всё-таки выполнил работу. Мне нужно, чтоб ты избавился от грёбаного киллера, который устраняет моих людей. Я даже удвою твою награду. Неплохо, не правда ли? Тебе не стоит отказываться от этого предложения, правда не стоит».~
@34377 = ~Мне нужно получить на складе планы гробницы. Но сперва мне, возможно, придётся разобраться с возникшей там проблемой.~
@34378 = ~Я удачно справился со всеми проблемами, и теперь у меня есть планы гробницы.~
@34379 = ~«Ты точно уверен, что тебе не нужна эта работа?»~
@34380 = ~«Очень жаль. Ну что ж. Настало время сжечь этот мусор, парни», — он медленно достаёт нож и направляется в твою сторону…~
@34381 = ~«Отлично. Ты найдёшь его блуждающим по аллее. Думаю, он скрывается где-нибудь в тени».~
@34382 = ~«Ты уже избавился от этой жалкой суки Кристалл?»~
@34383 = ~Он цедит сквозь зубы, но выделяя при этом каждое слово: «Не… смей… возвращаться… пока… она… не будет… мертва. Ты… меня… понял?» Затем отворачивается: «Чтоб и духу твоего тут не было, пока с ней не покончено».~
@34384 = ~«Что ты имеешь в виду?»~
@34385 = ~«Я ищу Фарода».~
@34386 = ~«Я ищу дневник».~
@34387 = ~«Я просто прохожу мимо».~
@34388 = ~«Я не хочу неприятностей».~
@34389 = ~«Чёрная Роза хочет твоей смерти».~
@34390 = ~«Кристалл желает твоей смерти».~
@34391 = ~«Я сказал, это не твоё дело».~
@34392 = ~Драться.~
@34393 = ~Бежать.~
@34394 = ~«Ещё нет».~
@34395 = ~«Я его нашёл, но он убедил меня взамен убить тебя».~
@34396 = ~«Он мёртв. Я хочу получить свою награду».~
@34397 = ~«Сначала я бы задал несколько вопросов…»~
@34398 = ~«Ну ладно».~
@34399 = ~Драться.~
@34400 = ~Бежать.~
@34401 = ~«Ещё нет».~
@34402 = ~«Она мертва».~
@34403 = ~Драться.~
@34404 = ~Бежать.~
@34405 = ~«Боюсь, мне придётся отказаться».~
@34406 = ~«Будет сделано».~
@34407 = ~«Уверен».~
@34408 = ~«А с другой стороны, удвоенное вознаграждение — это звучит неплохо. Считай, договорились».~
@34409 = ~Драться.~
@34410 = ~Бежать.~
@34411 = ~«Я его найду».~
@34412 = ~«Ещё нет».~
@34413 = ~«Она мертва».~
@34414 = ~«Хорошо. Прощай».~
@34415 = ~«Да. Он мёртв. Тебе больше не нужно беспокоиться ни о нём, ни о его шайке».~
@34416 = ~«Ладно, чего только не сделаешь, чтобы ты перестала докучать мне».~
@34417 = ~«Я всё равно не собираюсь этого делать. Прощай».~
@34418 = ~«Тогда прощай».~
@34419 = ~«Забудь».~
@34420 = ~«Что за просьба?»~
@34421 = ~«Что я получу?»~
@34422 = ~«Будет сделано».~
@34423 = ~«А мне что с того?»~
@34424 = ~«Неинтересно. Прощай».~
@34425 = ~«Да».~
@34426 = ~«Нет».~
@34427 = ~«По рукам. До свидания».~
@34428 = ~Есть кто-нибудь, кого Кристалл не хочет видеть мёртвым? Теперь мне нужно найти мстителя по имени Чёрная Роза и устранить его. Она обещала мне деньги и дружбу за эту работёнку.~
@34429 = ~«Прекрасно. Прощай».~
@34430 = ~«Ещё нет».~
@34431 = ~«Да. Больше тебе не нужно о нём беспокоиться».~
@34432 = ~«Ясно. Прощай».~
@34433 = ~Я получил свои деньги за устранение Чёрной Розы. И довольно приличную сумму, к тому же.~
@34434 = ~«Прощай».~
@34435 = ~«Я весь в поисках. Прощай».~
@34436 = ~«Посмотрю я, как ты будешь в нём шариться с дырками в шкуре».~
@34437 = ~«Я уже заплатил за этот раз».~
@34438 = ~Блеф: «Я уже заплатил за этот раз».~
@34439 = ~Бежать.~
@34440 = ~«С Гнилым Уильямом? Ага, я пущу тебя поговорить с ним, как только разрешишь мне заглянуть в твой кошелёк».~
@34441 = ~«Только через твой труп».~
@34442 = ~«Сколько тебе надо?»~
@34443 = ~«Нет. Это не настолько важно».~
@34444 = ~«Совсем немного, — говорит он с великодушным видом. — Всего-то 10 медяков, и ты проходишь».~
@34445 = ~«Договорились».~
@34446 = ~«Ни за что».~
@34447 = ~«Ты поймёшь, насколько это не важно, когда будешь истекать кровью».~
@34448 = ~Драться.~
@34449 = ~Бежать.~
@34450 = ~Он берёт твои деньги, кладёт их в карман и говорит: «А теперь проваливай отсюда».~
@34451 = ~Уйти.~
@34452 = ~«Тогда ты не уйдёшь отсюда живым», — он выхватывает нож и нападает!~
@34453 = ~Драться.~
@34454 = ~Бежать.~
@34455 = ~Он бросает взгляд в тень, делает движение рукой и снова смотрит на тебя: «Прекрасно. Проходи. Пень».~
@34456 = ~«Спасибо. Прощай».~
@34457 = ~Он бросает взгляд в тень, делает движение рукой и снова смотрит на тебя: «Нет, не платил. Ты умрёшь».~
@34458 = ~Драться.~
@34459 = ~Бежать.~
@34460 = ~«Что, опять ты? Ещё не устал платить нам деньги? Наверно, нет, раз опять здесь. 10 монет, и сможешь пройти ещё разок».~
@34461 = ~«Мне нужно поговорить с вашим лидером».~
@34462 = ~«Сколько тебе надо?»~
@34463 = ~«Посмотрю я, как ты их возьмёшь с дырками в шкуре».~
@34464 = ~«Я уже заплатил за этот раз».~
@34465 = ~Блеф: «Я уже заплатил за этот раз».~
@34466 = ~Бежать.~
@34467 = ~«Слыхал я, Гнилой Уильям послал тебя убивать, ага? А пока ты этого не сделал, плати. 10 монет».~
@34468 = ~«Хорошо. Держи».~
@34469 = ~«У меня столько нет».~
@34470 = ~«Но я работаю на Гнилого Уильяма!»~
@34471 = ~«Тебе вовсе не обязательно их собирать».~
@34472 = ~«Попробуй взять эти деньги с моего трупа, если сможешь».~
@34473 = ~«Я уже заплатил за этот раз».~
@34474 = ~Блеф: «Я уже заплатил за этот раз».~
@34475 = ~«Ты ведь ещё не закончил с заказом от Гнилого Уильяма? Придётся платить за такую задержку. 10 монет, и можешь идти своей дорогой».~
@34476 = ~«Хорошо. Держи».~
@34477 = ~«У меня столько нет».~
@34478 = ~«Но я работаю на Гнилого Уильяма!»~
@34479 = ~«Тебе вовсе не обязательно их собирать».~
@34480 = ~«Попробуй взять эти деньги с моего трупа, если сможешь».~
@34481 = ~«Я уже заплатил за этот раз».~
@34482 = ~Блеф: «Я уже заплатил за этот раз».~
@34483 = ~«Чудно. Поговори со мной лично, когда вернёшься, ага?» — он тебе подмигивает.~
@34484 = ~«Очень смешно. Прощай».~
@34485 = ~«Какая жалость. Гнилой Уильям будет не очень-то рад услышать, что ты поскользнулся и упал на нож», — он достаёт своё оружие и бросается на тебя.~
@34486 = ~Драться.~
@34487 = ~Бежать.~
@34488 = ~«Как и я. Так что скажешь? Заплатишь и останешься, или прольётся кровь?»~
@34489 = ~«Заплачу».~
@34490 = ~«У меня столько нет».~
@34491 = ~Драться.~
@34492 = ~Бежать.~
@34493 = ~«Я уже заплатил за этот раз».~
@34494 = ~Блеф: «Я уже заплатил за этот раз».~
@34495 = ~«Тебе вовсе не обязательно собирать деньги».~
@34496 = ~«Попробуй взять эти деньги с моего трупа, если сможешь».~
@34497 = ~Он внимательно осматривает тебя и обдумывает твои слова. «На этот раз, — говорит он. — тебе сойдёт с рук. Проваливай отсюда».~
@34498 = ~«Спасибо. Прощай».~
@34499 = ~«Ты даже не представляешь, как сильно я хотел это услышать», — он достаёт свой нож и бросается на тебя.~
@34500 = ~Драться.~
@34501 = ~Бежать.~
@34502 = ~«Ты вписал имя Гнилого Уильяма в книгу мёртвых красным, здоровяк. Значит, можешь проходить по земле Ангелов-Лезвий бесплатно».~
@34503 = ~«Спасибо. Прощай».~
@34504 = ~Этот обитатель аллеи приветствует тебя с напускной вежливостью и отвешивает низкий поклон: «Приветствую тебя, незнакомец. Ты выбрал, хм, благоприятный день, чтоб пройти через наши земли. Это будет стоить тебе всего 10 монет».~
@34505 = ~«Десять монет? Это чересчур!»~
@34506 = ~«Я только что заплатил столько же вон тем пням!»~
@34507 = ~«Десять? Хорошо. Держи».~
@34508 = ~«Я уже платил».~
@34509 = ~Блеф: «Я уже платил».~
@34510 = ~«Если сможешь отнять».~
@34511 = ~«Сначала тебе придётся поймать меня».~
@34512 = ~«Всего лишь 10 медяков. Это наша земля. Ты наверняка знал, что здесь не место для слабаков. И пришёл сюда по доброй воле. Теперь плати как хошь: деньгами или кровью. Ну так что это будет?»~
@34513 = ~«Деньги. Держи».~
@34514 = ~«Я выбираю кровь».~
@34515 = ~«Почему бы тебе не попробовать поймать меня?»~
@34516 = ~«Ага, и те пни не на нашей стороне. Клинки — наши кровные враги. Теперь отстёгивай и нам или будешь валяться мёртвым».~
@34517 = ~«Тогда вот. Держи деньги».~
@34518 = ~«Ты умрёшь первым, приятель».~
@34519 = ~«Почему бы тебе не попробовать поймать меня?»~
@34520 = ~«Ангелы-Лезвия благодарны тебе. Иди с миром, путник».~
@34521 = ~«Спасибо, пень. Прощай».~
@34522 = ~Ангел-Лезвие на минуту отводит взгляд в тень, затем делает жест рукой и кивает: «Точно, было дело. Тогда проходи. Возьмём с тебя деньги в следующий раз».~
@34523 = ~«Не сомневаюсь. Прощай».~
@34524 = ~Ангел-Лезвие на минуту отводит взгляд в тень, затем делает жест рукой и качает головой: «Ничего подобного. Это наше последнее предупреждение. 10 монет или холодная земля».~
@34525 = ~«Тогда вот. Держи деньги».~
@34526 = ~«Попробуй их у меня отнять, пень».~
@34527 = ~«Сначала тебе придётся поймать меня».~
@34528 = ~«Смотрю, ты вернулся. Если хочешь пройти — цена та же. 10 монет, дружище, и у тебя не прибавится шрамов».~
@34529 = ~«Десять монет? Это чересчур!»~
@34530 = ~«Я только что заплатил столько же вон тем пням!»~
@34531 = ~«Десять? Хорошо. Держи».~
@34532 = ~«Я уже платил».~
@34533 = ~Блеф: «Я уже платил».~
@34534 = ~«Если сможешь отнять».~
@34535 = ~«Сначала тебе придётся поймать меня».~
@34536 = ~«Слыхал я, ты выполняешь кое-какую работёнку для Кристалл. Клёво. Делай её поскорее, слышишь? О… пока не забыл, тебе нужно заплатить за вход. Так как ты на нашей стороне, с тебя вдвое меньше: всего-то пять монет».~
@34537 = ~«Но я же работаю на Кристалл!»~
@34538 = ~«Держи».~
@34539 = ~«Я только что заплатил столько же вон тем пням!»~
@34540 = ~«Я уже платил».~
@34541 = ~Блеф: «Я уже платил».~
@34542 = ~«Ты умрёшь раньше, приятель».~
@34543 = ~«Сперва тебе придётся поймать меня».~
@34544 = ~«Ты ведь ещё не прикончил Гнилого Уильяма? Пока Кристалл не решила по-другому, плати 5 монет».~
@34545 = ~«Но я же работаю на Кристалл!»~
@34546 = ~«Держи».~
@34547 = ~«Я только что заплатил столько же вон тем пням!»~
@34548 = ~«Я уже платил».~
@34549 = ~Блеф: «Я уже платил».~
@34550 = ~«Ты умрёшь раньше, приятель».~
@34551 = ~«Сперва тебе придётся поймать меня».~
@34552 = ~«Верно. Как и я. И всем хочется кушать, так что придётся раскошелиться. 5 монет, или я порву тебя».~
@34553 = ~«Держи».~
@34554 = ~«Ты умрёшь первым, приятель».~
@34555 = ~«Сначала тебе придётся поймать меня».~
@34556 = ~«Рад был встрече. Удачи тебе с этим ублюдком Гнилым Уильямом».~
@34557 = ~«Да, спасибо».~
@34558 = ~«Ага, и тебе придётся убить их, чтоб получить деньги обратно. Но то они, а это мы. Плати, дружок».~
@34559 = ~«Держи».~
@34560 = ~«Почему бы тебе не попробовать отнять у меня деньги? Я готов».~
@34561 = ~«Исключено. Я ухожу».~
@34562 = ~В поисках подтверждения Ангел-Лезвие смотрит в тень. Затем поворачивается обратно: «Ага, мои извинения. Тогда проходи».~
@34563 = ~«Спасибо».~
@34564 = ~В поисках подтверждения Ангел-Лезвие смотрит в тень. Затем поворачивается обратно: «Не-а. Плати, дружок, а не то и до Гнилого Уильяма не доберёшься».~
@34565 = ~«Держи».~
@34566 = ~«Я убью его сразу после того, как расправлюсь с тобой».~
@34567 = ~«Не думаю, что у тебя получится меня поймать».~
@34568 = ~«Ты расплатился, завалив эту суку Кристалл. Для босса достаточно. Я всё ещё думаю, что мы должны тя пришить. Пшёл… вали отсюда».~
@34569 = ~«Трогательно. Прощай».~
@34570 = ~«Нам нужны от тя деньги и поскорее. Деньги или кровь. Иди разбирайся со сборщиком платы — и даже не пытайся свалить по-тихому. Согласен?»~
@34571 = ~«Я так не думаю».~
@34572 = ~«Ладно».~
@34573 = ~Бежать.~
@34574 = ~«Ты заплатил, так почему б те, не отвалить? Больше ты тут не нужен».~
@34575 = ~«Как скажешь. Прощай».~
@34576 = ~«Мне сказали, терь ты можешь бесплатно ходить по земле Ангелов-Лезвий, пень. Не вздумай нарываться».~
@34577 = ~«Спасибо. Прощай».~
@34578 = ~«Стой прямо тут. Кой-кто придёт с тобой потолковать».~
@34579 = ~«Даже не рассчитывай. Меня и след простынет, когда он здесь появится».~
@34580 = ~«Почему бы не поприветствовать его кровью? Пролью-ка я сперва твою».~
@34581 = ~«Прекрасно. Я подожду здесь».~
@34582 = ~«Ты заплатил, можешь проходить свободно. Пользуйся, пока время не вышло».~
@34583 = ~«Спасибо, так и сделаю. Прощай».~
@34584 = ~Фракция: не входит

Никаких обязательств.~
@34585 = ~Фракция: Верующие в Источник («Боготы»)

Девиз: вся жизнь исходит из одного священного источника, восходя и закатываясь по воле космоса.~
@34586 = ~Фракция: Убийцы Милосердия («Красная Смерть»)

Девиз: справедливость — это всё. При должном применении наказание ведёт к совершенству.~
@34587 = ~Фракция: Общество Восприятия («Чующие»)

Девиз: познай вселенную, испытав её всю. Чувства — путь к истине, ведь мультивселенная не существует вне их.~
@34588 = ~Фракция: Пыльные («Мёртвые»)

Девиз: все мертвы. Подави страсти и приди к чистоте Истинной Смерти.~
@34589 = ~Фракция: Революционная Лига («Анархисты»)

Девиз: уничтожить все фракции; они построены на лжи и алчности. Разрушить их до основания и построить заново — вот путь к истине.~
@34590 = ~Фракция: Хаоситекты («Хаоситы»)

Девиз: истина — хаос. Случайность приняв, мультивселенной секрет познать лишь можно.~
@34591 = ~Фактол Хаоситектов («Хаоситов»)

Девиз?! ФАКТОЛ Хаоситов же ты прям сей-час! Хаоз — правда. Случайно при-няв вселенную, познаешь секреты ли-шь?~
@34592 = ~Игра не может быть сохранена на данной территории.~
@34593 = ~Игра не может быть сохранена в режиме диалога.~
@34594 = ~Игра не может быть сохранена во время отдыха или просмотра видео.~
@34595 = ~Игра не может быть сохранена во время игровой вставки.~
@34596 = ~Игра не может быть сохранена пока включен режим магазина.~
@34597 = ~Игра не может быть сохранена в данный момент.~
@34598 = ~Игра не может быть сохранена, рядом враги!~
@34599 = ~Ты не можешь отдыхать сейчас.~
@34600 = ~Ты не можешь отдыхать, рядом враги!~
@34601 = ~На этой территории нельзя отдыхать.~
@34602 = ~Конец~
@34603 = ~Далее~
@34604 = ~«Маленькая птичка потеряла дорогу домой, а? Если маленькая птичка хочет пролететь, ей придётся заплатить».~
@34605 = ~«Сколько?»~
@34606 = ~«Если тебе нужны мои деньги, попробуй их у меня взять».~
@34607 = ~«Сначала тебе следует поймать меня».~
@34608 = ~«10 монет, мой друг!»~
@34609 = ~«Держи».~
@34610 = ~«У меня столько нет».~
@34611 = ~«Забудь. Тебе придётся самому взять их, если они тебе так нужны».~
@34612 = ~«Сначала тебе придётся поймать меня!»~
@34613 = ~Бандит низко и с насмешкой кланяется: «Надеюсь, вскоре мы снова будем вести дела вместе».~
@34614 = ~«Как скажешь. Прощай».~
@34615 = ~Лицо головореза искажает возмущение: «В таком случае тебе придётся заплатить кровью. Прощай, приятель».~
@34616 = ~«Эй, подожди…»~
@34617 = ~«Приступим».~
@34618 = ~«Маленькая птичка вернулась домой, а? Прилетела покормить остальных?»~
@34619 = ~«Ты о чём?»~
@34620 = ~«Да. Вот твои деньги».~
@34621 = ~«Нет. Я пришёл убить тебя».~
@34622 = ~Он корчит лицо в пародии на страдание: «Хочешь сказать, ты уже забыл? Ага, дорогуша. Ты должен мне 10 монет за проход по этой улице. Давай… гони».~
@34623 = ~«Ну, держи».~
@34624 = ~«В этот раз тебе придётся сразиться со мной».~
@34625 = ~«Разве мы не можем как-нибудь договориться?»~
@34626 = ~«Извини, пень. У нас есть правила игры, по которым играем, а у тебя есть кровь, которой ты расплатишься. Передай своей силе мой поклон».~
@34627 = ~Сразиться с ним.~
@34628 = ~Бежать.~
@34629 = ~Ты видишь хорошо одетого мужчину средних лет. Кажется, он намётанным глазом просматривает толпу. Заметив твоё приближение, он удостаивает тебя быстрым оценивающим взглядом.~
@34630 = ~Он улыбается и едва заметно кланяется: «Я Байрон Пикит, ростовщик. Чем могу помочь?»~
@34631 = ~Он опять кивает. «Да, я оказываю помощь торговцам. Хочешь начать своё дело? Поддержать на плаву тонущее? Или, может, расширить дело? В любом из этих случаев можешь обращаться ко мне, — он осматривает тебя с головы до ног. — Сомневаюсь, что ты торговец, сэр. Чем могу быть полезен?»~
@34632 = ~Он улыбается и на секунду отводит глаза. «Торговец смертью, возможно, но не тот сорт торговцев, с какими я имею дело, — он хмурится. — Если ты намерен монополизировать моё время, то будь добр, подходи ближе к делу».~
@34633 = ~Он хмурится и качает головой: «Нет, не вижу основания…» Он осматривает тебя с головы до ног: «Ты точно не из тех, с кем я обычно имею дело. Думаю, тебе стоит уйти». Он отводит взгляд.~
@34634 = ~Он вздыхает: «Хорошо, давай быстрее».~
@34635 = ~«Если ты имеешь в виду район в целом, то он называется Нижний район. Если ты имеешь в виду это конкретное место, то тут открытый рынок».~
@34636 = ~Он выглядит скучающим. «Это дом для обычных людей, — он обводит жестом окрестности. — Оглянись вокруг и ты увидишь всё, что здесь можно увидеть… ничего. Ничего интересного».~
@34637 = ~Он улыбается. «Единственное дело, в котором преуспевают эти безмозглые бедолаги, — трата денег. Это даёт им ощущение достижения чего-то в их бессмысленной жизни», — он замолкает и неприязненно смотрит вокруг.~
@34638 = ~Он пожимает плечами. «Там, где есть деньги, ты обязательно найдёшь торговцев и воров. Я помогаю обеспечивать торговцев, столь необходимых для освобождения их… — он показывает вокруг, — …от так тяжело достающихся им монет». Он улыбается.~
@34639 = ~«Не я… — он одаривает тебя оценивающим взглядом и улыбается. — А почему ты спрашиваешь?»~
@34640 = ~Он смеётся: «Такого рода любопытство может быть очень опасным… даже смертельным при неосторожности». Он замолкает, чтобы тщательно взвесить свою следующую фразу, одновременно изучает тебя. «Возможно, тебе стоит поговорить с Ленни. Обычно его можно найти к юго-востоку от рынка, — он снова прерывается. — Скажи ему, что это я тебя послал».~
@34641 = ~Он указывает на здание за своей спиной. «Отличный рынок, куда поставляют почти всё необходимое каждому, — на миг он задумывается, затем продолжает: — Ничего экзотического, эти несчастные не могут себе такого позволить, но тем не менее рынок хорош».~
@34642 = ~Он пожимает плечами: «Я вовсе не гид. Если хочешь узнать Сигил, исследуй его. Я думаю, тебе стоит этим заняться. Но должен предупредить, копнёшь слишком глубоко — умрёшь».~
@34643 = ~Он на минуту задумывается, аккуратно взвешивая свою следующую фразу: «Сигил хранит очень много тайн. Как хороших, так и плохих. Откроешь слишком много плохих и можешь поплатиться жизнью».~
@34644 = ~Он удивлённо на тебя смотрит и неожиданно разражается смехом: «Они перестанут быть тайнами, если я тебе их поведаю, не так ли?»~
@34645 = ~«А, Трист…» — он хмурится и отводит взгляд. Мгновение спустя он смотрит на тебя и поднимает брови: «Что насчёт неё?»~
@34646 = ~Он вздыхает и качает головой: «Не существует никакого *пропавшего* документа. Это была уловка, придуманная Трист, чтобы все усомнились в её долге. То дело было тщательно расследовано Убийцами Милосердия, и никаких доказательств существования такого документа они не нашли».~
@34647 = ~«Да, фракция фанатиков, посвятивших себя поискам *истины* в уголовных делах и установлению справедливости. Их часто используют в качестве следователей в судах Сигила. Они провели тщательное расследование, но ничего не нашли…» — он меряет тебя сердитым взглядом.~
@34648 = ~«Это возможно, но маловероятно. Ты, очевидно, мало знаком с Убийцами Милосердия и их методами, чтобы делать такие утверждения. Если они не смогли найти документ — это значит, что его не существует», — в его взгляде мелькает неприкрытая злоба.~
@34649 = ~В какой-то момент он чуть было не выходит из себя, но затем его лицо расцветает торжествующей улыбкой. «Какая ужасная мысль… как жаль, что нет никаких доказательств…» — он продолжает улыбаться.~
@34650 = ~«Да, она могла, и я сделал ей такое предложение, — он сурово смотрит на тебя. — Однако она отказалась. Я не даю второго шанса. Никто не отказывает мне без последствий. Никто…»~
@34651 = ~Он смеётся: «Ну, удачи тебе. Если Убийцы Милосердия не смогли помочь бедняжке Трист, вряд ли у тебя что-нибудь получится. Теперь проваливай». Он отворачивается от тебя.~
@34652 = ~«Нет, я уже наобщался с тобой, на всю оставшуюся жизнь хватит. Я не отвечу больше ни на один твой вопрос. А теперь проваливай», — он отворачивается от тебя.~
@34653 = ~Он окидывает тебя недоумённым взглядом: «В самом деле? И с чего это вдруг тебе понадобилось его искать?»~
@34654 = ~Он на минуту замолкает. «У меня есть причины, достаточно веские причины, могу заверить, не рассказывать никому о Лотаре. А теперь проваливай», — он отворачивается от тебя.~
@34655 = ~«Да ладно? И что ты собираешься делать, просто войти и потребовать назад?» — он оглядывает тебя с головы до ног. «Я признаю, ты выглядишь как человек, способный показать себя в бою, но против Лотара? — он фыркает. — Твой череп украсит его стены».~
@34656 = ~Он громко смеётся, затем скептически смотрит на тебя: «Лотар выше закона, пень. Он настолько могущественен, настолько крут…»~
@34657 = ~Он качает головой. «На самом деле… — он вздыхает и отводит глаза. — Я могу тебя заверить, что твой череп не подлежит возврату. Забудь о нём, найди себе замену».~
@34658 = ~«Потому что, вероятнее всего, твоим черепом владеет Повелитель Костей, Лотар. Если это на самом деле так, то пиши пропало», — он пожимает плечами.~
@34659 = ~Ты видишь Байрона Пикита, ростовщика. «Опять ты?»~
@34660 = ~Он оглядывается со смехом. «Правда? Что ж, такие вещи не стоит говорить каждому встречному», — он внимательно изучает тебя, одновременно обдумывая следующую фразу. «Как уже сказал, я не имею никаких дел с ворами… Возможно, тебе стоит поговорить с Ленни. Обычно его можно найти к юго-востоку от рынка, — он прерывается. — Скажи ему, что это я тебя послал».~
@34661 = ~«Приветствую».~
@34662 = ~Не обращать на него внимания.~
@34663 = ~«Ростовщик?»~
@34664 = ~«У меня кое-какие вопросы…»~
@34665 = ~«Неважно. Прощай».~
@34666 = ~«Я торговец».~
@34667 = ~«У меня кое-какие вопросы…»~
@34668 = ~«Ничем, прощай».~
@34669 = ~«Расскажешь мне о своём деле?»~
@34670 = ~«У меня кое-какие вопросы…»~
@34671 = ~~
@34672 = ~«У меня кое-какие вопросы…»~
@34673 = ~«Хорошо, прощай».~
@34674 = ~«Что это за место?»~
@34675 = ~«Я хочу поговорить с тобой о Трист».~
@34676 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@34677 = ~«Я потерял череп… не знаешь никого, кому бы он мог понадобиться?»~
@34678 = ~«Мне пора идти. Прощай».~
@34679 = ~«Расскажи мне о Нижнем районе».~
@34680 = ~«Расскажи мне об открытом рынке».~
@34681 = ~«Я хочу спросить о другом…»~
@34682 = ~«Мне пора идти. Прощай».~
@34683 = ~«Тогда зачем ты здесь?»~
@34684 = ~«Расскажи мне об открытом рынке».~
@34685 = ~«Я хочу спросить о другом…»~
@34686 = ~«Мне пора идти. Прощай».~
@34687 = ~«Продолжай».~
@34688 = ~«Я хочу спросить о другом…»~
@34689 = ~«Мне пора идти. Прощай».~
@34690 = ~«Ты упомянул воров. Кто помогает обеспечивать *их*?»~
@34691 = ~«Ясно. У меня ещё кое-какие вопросы…»~
@34692 = ~«Мне пора идти. Прощай».~
@34693 = ~«Считай это любопытством…»~
@34694 = ~«Хочу перенять опыт…»~
@34695 = ~«Считай это любопытством…»~
@34696 = ~Я узнал о воре, которого зовут Ленни. Его можно найти к юго-востоку от рынка. Возможно, я узнаю что-нибудь от него.~
@34697 = ~«Расскажи мне об открытом рынке».~
@34698 = ~«Я хочу спросить о другом…»~
@34699 = ~«Истинная Смерть?..»~
@34700 = ~«Мы с тобой ещё встретимся».~
@34701 = ~«Хм-м… „Софе“? „Трофе“? Не-е…»~
@34702 = ~«„Подкофе“? Не-а… „отшофе“? Не-е…»~
@34703 = ~«Возможно, „котофе“… не-е…»~
@34704 = ~::Хихикает::~
