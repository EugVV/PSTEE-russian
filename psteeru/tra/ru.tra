@38355 = ~Ключ от гробницы четыре~
@38356 = ~КЛЮЧ ОТ ГРОБНИЦЫ ЧЕТЫРЕ
Вес: 0

Это ключ от портала.~
@38357 = ~«Тогда я лучше спрошу кого-нибудь другого. До свидания».~
@38358 = ~«Тогда я поищу что-нибудь такое, что вернёт тебе голос. До свидания, Экко».~
@38359 = ~«Тогда по рукам. Я поищу что-нибудь такое, что вернёт тебе голос. До свидания».~
@38360 = ~«У меня вопросы…»~
@38361 = ~«Просто мимо проходил, Экко. Прощай».~
@38362 = ~«Я принёс тебе этот язык изверга…»~
@38363 = ~~
@38364 = ~«Я всё ещё не нашёл способа вернуть тебе голос. Обязательно вернусь, когда найду».~
@38365 = ~~
@38366 = ~~
@38367 = ~~
@38368 = ~«Тогда позволь спросить кое о чём другом…»~
@38369 = ~«Это всё, что я хотел знать. Прощай».~
@38370 = ~«У меня другие вопросы…»~
@38371 = ~«Я ухожу, счастливо».~
@38372 = ~«Мне сказали, что если поместить его в рот, то снова сможешь разговаривать».~
@38373 = ~«Ты в порядке?»~
@38374 = ~Подождать ответа.~
@38375 = ~«А?»~
@38376 = ~«Это, должно быть… язык изверга…»~
@38377 = ~«Я попробую найти выход — может, у Вришики найдётся что-нибудь ещё, что тебе поможет. До свидания».~
@38378 = ~«Ну, ты снова можешь говорить… в каком-то роде… так где моя награда?»~
@38379 = ~«Думаю, я не получу своё вознаграждение, пока не сделаю всё как надо. Я вернусь… может, у Вришики найдётся что-нибудь ещё, что тебе поможет. До свидания».~
@38380 = ~«Думаю, я не стану брать своё вознаграждение, пока не сделаю всё как надо. Я вернусь… может, у Вришики найдётся что-нибудь ещё, что тебе поможет. До свидания».~
@38381 = ~«Я принёс тебе слёзы дэва… они смягчат проклятие языка».~
@38382 = ~«Экко… я нашёл способ тебе помочь… слёзы дэва в магазинчике странностей Вришики. Правда, стоят они недёшево…»~
@38383 = ~«Я ещё не нашёл способа тебе помочь… вернусь, когда найду».~
@38384 = ~«Рад был помочь. Счастливо, Экко».~
@38385 = ~«Рад был помочь. Счастливо, Экко».~
@38386 = ~«Счастлив помочь… но слёзы дэва влетели мне в копеечку…»~
@38387 = ~«Пожалуйста… и забудь о вознаграждении, Экко. Я был счастлив помочь».~
@38388 = ~«Пожалуйста… и забудь о вознаграждении, Экко. Я был счастлив помочь».~
@38389 = ~«Да, всегда пожалуйста… теперь о моей награде…»~
@38390 = ~«Да… этого вполне достаточно. Я вернусь, когда получу слёзы, Экко».~
@38391 = ~«Счастливо, Экко».~
@38392 = ~«Спасибо, Экко. Счастливо».~
@38393 = ~«Спасибо, Экко. Счастливо».~
@38394 = ~«Погоди… награда хороша, но как быть со слезами дэва? Я отвалил за них девять сотен и ещё девяносто девять монет, знаешь ли».~
@38395 = ~«Спасибо. Прощай».~
@38396 = ~«Спасибо. Прощай».~
@38397 = ~«Привет, Экко… У меня вопросы…»~
@38398 = ~«Рад встрече, Экко. Я просто мимо проходил, счастливо».~
@38399 = ~«У меня пара вопросов…»~
@38400 = ~«Просто мимо проходил. Прощай, Экко».~
@38401 = ~«Чующих?»~
@38402 = ~«Я хочу спросить о другом…»~
@38403 = ~«Это всё, что я хотел узнать. Прощай».~
@38404 = ~«*Что*?»~
@38405 = ~«Где мне их найти?»~
@38406 = ~«Интересно. У меня другой вопрос…»~
@38407 = ~«Какая прелесть. Спасибо, Экко, прощай».~
@38408 = ~~
@38409 = ~~
@38410 = ~~
@38411 = ~«Продолжай…»~
@38412 = ~«У меня другой вопрос…»~
@38413 = ~«Это всё, что мне нужно было знать. Прощай».~
@38414 = ~«Чующей?»~
@38415 = ~«Интересно. Позволь спросить ещё кое о чём…»~
@38416 = ~«Возможно. Счастливо, Экко».~
@38417 = ~«Желаю тебе успехов, какой бы путь ты ни выбрала, Экко. Счастливо».~
@38418 = ~«Говорить-то ты можешь?»~
@38419 = ~«У меня другие вопросы…»~
@38420 = ~«Неважно. Прощай».~
@38421 = ~«У меня есть ещё вопросы…»~
@38422 = ~«Это всё, что мне нужно было знать. Прощай».~
@38423 = ~«У меня другие вопросы…»~
@38424 = ~«Это всё, что мне нужно было знать. Прощай».~
@38425 = ~~
