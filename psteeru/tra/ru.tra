@67038 = ~«Спасибо. Я хочу учиться другому оружию, если ты можешь меня обучить».~
@67039 = ~«Спасибо. Я хочу учиться другому оружию, если ты можешь меня обучить».~
@67040 = ~«Спасибо. Это всё, что я хотел узнать».~
@67041 = ~«Можешь обучить меня другому оружию?»~
@67042 = ~«Можешь обучить меня другому оружию?»~
@67043 = ~«Можешь обучить меня другому оружию?»~
@67044 = ~«Ну тогда ладно. Спасибо и прощай».~
@67045 = ~«Можешь обучить меня другому оружию?»~
@67046 = ~«Можешь обучить меня другому оружию?»~
@67047 = ~«Ну тогда ладно. Спасибо и прощай».~
@67048 = ~Нажать для показа других~
@67049 = ~Улучшения класса защиты~
@67050 = ~~
@67051 = ~«Слышала о ночной ведьме по имени Рейвел Клубок-Загадок?»~
@67052 = ~«Не знаешь, где я могу найти „кусок“ Рейвел?»~
@67053 = ~При упоминании этого имени Анна плюёт три раза и чертит над сердцем полукруг. «Ш-ш-ш! *Рехнулся*? Не упоминай *её* имя, если жить не надоело!»~
@67054 = ~«Неважно. У меня другие вопросы…»~
@67055 = ~«Почему?»~
@67056 = ~«Тогда забудь. Пошли дальше».~
@67057 = ~«Она — самая злобная из Серых Леди, вот она кто, — голос Анны падает почти до шёпота, будто она боится быть подслушанной. — Жуткая дрянь, а по могуществу с некоторыми силами потягается. Говорят, она вся поросла ежевикой, даже её *сердце*. Говорят, её НИ В ЖИСТЬ не убьёшь, ведь у ней тело как дерево — рубишь ветку, а другая сразу же растёт *ещё* где-нибудь на планах».~
@67058 = ~«Ты говоришь так, будто она ещё жива».~
@67059 = ~«Неважно. У меня другие вопросы…»~
@67060 = ~«Тогда забудь. Пошли дальше».~
@67061 = ~«Ясен перец, жива. Куда она денется? — голос Анны снова падает. — Как ты убьёшь тварь вроде неё? Вот почему Госпожа посадила её в ЛАБИРИНТ, так говорят».~
@67062 = ~«Хм-м. У меня есть ещё вопросы…»~
@67063 = ~«Ясно. Давай двигать».~
@67064 = ~«Кусок этой ведьмы? Не-а, не знаю, где тебе найти такую штуку, — Анна раздумывает минуту, её хвост медленно ходит туда-сюда, затем ухмыляется. — Ясен перец, она своих ростков пораскидала по планам немерено, так что можешь поспрошать о них».~
@67065 = ~«„Ростков“? Что ты имеешь в виду?»~
@67066 = ~«Неважно. У меня другие вопросы…»~
@67067 = ~«Тогда забудь. Пошли дальше».~
@67068 = ~Анна сказала, что у Рейвел были «ростки» — одна или несколько дочерей, разбросанных по планам. Интересно, смогу ли я найти одну из них… может быть, они знают, как достичь лабиринта. Осталось узнать, где их искать.~
@67069 = ~«Ростки, семя, потомки… у Рейвел фигова туча дочерей, так сказочники болтают, — или всего одна, эт смотря какой сказочник и сколько выжрал, — Анна опять понижает голос. — Рейвел родила их от какого-то *изверга*, если верить байкам».~
@67070 = ~«Как думаешь, может ли где-то здесь быть одна из дочерей? Они могут знать, как её найти».~
@67071 = ~«Интересно. У меня другие вопросы…»~
@67072 = ~«Ясно. Давай двигать».~
@67073 = ~Анна пожимает плечами: «Без понятия. Зуб даю, я б не хотела одну из них *встретить*. Если они хоть вполовину такие злобные, как она…»~
@67074 = ~«Неважно. У меня другие вопросы…»~
@67075 = ~«Может, тогда мне стоит поискать одну из них. Пойдём».~
@67076 = ~«А? — она хмурится. — О чём эт ты?»~
@67077 = ~«Я хочу бросить на время военное дело и заняться скрытным преследованием».~
@67078 = ~«Я хочу отложить на время Искусство и попробовать себя в скрытном преследовании».~
@67079 = ~«Я хочу бросить на время военное дело и вернуться к воровскому промыслу. Сможешь меня обучить?»~
@67080 = ~«Я хочу отложить на время Искусство и вернуться к воровскому промыслу. Сможешь меня обучить?»~
@67081 = ~«Я бы хотел узнать у тебя больше о скрытности и воровстве».~
@67082 = ~«Забудь. У меня другие вопросы…»~
@67083 = ~«Не бери в голову, Анна. Пойдём».~
@67084 = ~~
@67085 = ~Она смотрит скептически, затем закатывает глаза. «Ага, могу… но для начала закрой варежку и слушай сюда… и не сачковать, понял? — она оглядывает тебя с головы до ног. — Сперва ты должен сменить позу. Перестань трясти задницей и задирать нос, как ты любишь…»~
@67086 = ~«Хорошо…»~
@67087 = ~Анна по-быстрому вводит тебя в курс дела. Через короткое время она делает шаг назад и кивает; кажется, она поражена: «Ага, ты ухватил главное. Быстро ловишь, ты глянь».~
@67088 = ~«У меня к тебе другие вопросы…»~
@67089 = ~«Спасибо. Теперь пойдём».~
@67090 = ~Она единожды меряет тебя взглядом, затем смотрит с сомнением в глазах: «Ты щас *серьёзно*?»~
@67091 = ~«Да, я хочу научиться быть вором. Можешь меня обучить?»~
@67092 = ~Анна секунду смотрит на тебя, затем качает головой: «Не-а, ты слишком *тормозишь*, да… ходишь, как мешок камней». Она хмурится: «Вот двигался б пошустрее, мог бы быстро меня достать, мож, хоть *чему-то* и научился бы».~
@67093 = ~Рвануться вперёд, схватить её за руку.~
@67094 = ~Рвануться вперёд, схватить её за руку.~
@67095 = ~Рвануться вперёд, схватить её за руку.~
@67096 = ~«Тогда ладно. У меня другие вопросов…»~
@67097 = ~«Тогда неважно. Пошли».~
@67098 = ~«Ш-ш-ш!» — как только ты пытаешься это сделать, Анна немедленно отскакивает с шипением. «Ага, я б с равным успехом могла на Шпиле сидеть. Тормоз, те надо быть НАМНОГО быстрее, чтоб поймать меня, — она слегка расслабляется. — Хотя *чуток* скорости в лапах у тя есть…»~
@67099 = ~«Так ты будешь учить меня?»~
@67100 = ~«Ш-ш-ш!» — Анна отскакивает, но недостаточно быстро. Ты напарываешься рукой на лезвие один из её кастетных кинжалов, по руке течёт кровь.~
@67101 = ~Анна смотрит на кровь на твоих руках, следит, как рана постепенно затягивается, как порез на глазах закрывается. Мгновение спустя она сплёвывает. «Сам наскрёб, идиот! Лапы выдали твои намерения ещё до того, как сам осознал, — она слегка расслабляется. — Хотя *немного* скорости в теле у тя есть…»~
@67102 = ~Ты выбрасываешь руку вперёд как хлыст, и, прежде чем Анна успевает двинуться, твоя рука уже крепко смыкается на её запястье. Она немедленно начинает шипеть, пытаясь вырваться из твоего захвата. «Пусти, идиот! Пусти, а то новую дырку в шкуре проткну, без балды!»~
@67103 = ~Отпустить её.~
@67104 = ~Анна отскакивает; её щёки пылают, она тяжело дышит. «Ты, держи грабли *подальше* от меня! — она успокаивает дыхание, затем хмурится. — Ты быстрый, правда, этого не отнимешь. Никто не мог словить меня так, как ты щас… у тя змеи в роду, не иначе».~
@67105 = ~«Так ты будешь учить меня?»~
@67106 = ~Она смотрит скептически, затем закатывает глаза: «Ага, я могу… но для начала закрой варежку и слушай сюда… и не сачковать, понял?»~
@67107 = ~«Хорошо…»~
@67108 = ~«Есть несколько вещей, которые надо запомнить, чтоб тя было трудно поймать… ты должен знать, как спрятаться, когда не хошь, чтоб тя видели».~
@67109 = ~«Хорошо».~
@67110 = ~«Думаю, основное я понял, Анна».~
@67111 = ~«Ты всегда должен знать, где ты и как быстро можешь стать ЧАСТЬЮ этого места, — как бы подчёркивая, она сопровождает каждое слово ударом хвоста. — Когда научишься делать это как следует, будешь как тень, правда».

^NПРИМЕЧАНИЕ. Если выбирать затемнённые места, чтобы спрятаться, то шансы остаться незамеченным увеличатся.^-~
@67112 = ~«И как же мне это делать?»~
@67113 = ~«Думаю, основное я понял, Анна».~
@67114 = ~«Важнее сказать, как НЕ делать: ты не можешь прятаться, если кто-то уже пялится на тебя, если ты нападаешь или пытаешься вскрыть замок, так что будь осторожен, када прячешься, усёк?»

^NПРИМЕЧАНИЕ. Спрятаться позволяет соответствующая иконка из особых способностей в быстром меню. Её выбор даёт шанс спрятаться в тенях. Любое действие против другого персонажа или объекта отменяет маскировку.^-~
@67115 = ~«В чём же тогда смысл пряток в тенях?»~
@67116 = ~«Думаю, основное я понял, Анна».~
@67117 = ~«В ТОМ… — Анна закручивает хвост для выразительности, — …что когда ты выходишь из тени и пыряешь кого-нибудь ножом сзади, РАНЫ намного серьёзнее. Это особая фишка при невидимости, вот».

^NПРИМЕЧАНИЕ. При нанесении удара по кому-либо из тени урон может быть в два, три, а то и четыре раза больше.^-~
@67118 = ~«Ох».~
@67119 = ~«Думаю, основное я понял, Анна».~
@67120 = ~«Следующее, что те надо знать, — это как стырить чё-нить из чужого кармана. Дело нехитрое, но тут как и с тенями — надо выбирать цель осторожно, усёк? Таскать монеты у бакланов легко, но есть народ посильней и поумней, их не так просто натянуть. Если пень разозлён, даже не пробуй у него ничего стянуть, обязательно заметит».~
@67121 = ~«Звучит слишком опасно, чтобы вообще этим заниматься».~
@67122 = ~«Думаю, основное я понял, Анна».~
@67123 = ~«Ну…» — Анна ухмыляется. «Кошельки большинства народу легко заполучить, ага. А иногда там чё-нить покруче медяков, вот это праздник, я скажу, — она улыбается. — И у торговцев — если не тормозить, можно тырить в магазинах».

^NПРИМЕЧАНИЕ. <PICKPOCKET> Воровство в магазинах осуществляется с помощью кнопки на экране магазина.^-~
@67124 = ~«А что, если торговец запер свой товар?»~
@67125 = ~«Думаю, основное я понял, Анна».~
@67126 = ~«Ну, тогда берёшь и заставляешь закрытый замок открыться, доступно? Иногда это трудно, но всё запертое стоит взлома… — она хмурится. — Ну, почти всё».

^NПРИМЕЧАНИЕ. <PICKLOCKS>^-~
@67127 = ~«Доступно».~
@67128 = ~«Думаю, основное я понял, Анна».~
@67129 = ~«Но эт уже подводит к следующему, ага. Если кто действительно не хочет, чтоб его добро тебе досталось, уж тут понятно, он оставит рядом с замком какую-нить гадость: обычно одно из вертящихся лезвий, сносящих голову, или бумажную рвущуюся сумку со смертельными жуками, или струю заднего выхлопа баатезу… — Анна загибает пальцы, перечисляя ловушки. — Или гадское заклинание. Или два. Или три».~
@67130 = ~«И как мне их заметить?»~
@67131 = ~«Думаю, основное я понял, Анна».~
@67132 = ~«Это отчасти как „быть тенью“: надо обращать *внимание* на окружение. Когда вступаешь в опасное место, глянь вокруг: есть чё-нить необычное? Сквозняк в запечатанном проходе? Странный участок пола? Секретного вида сундук, как нарочно стоящий посреди комнаты? — Анна тыкает тебя хвостом. — Вот так надо искать ловушки, ага».

^NПРИМЕЧАНИЕ. Для обнаружения ловушек иконка поиска ловушек из особых способностей в быстром меню переключается в положение «включено». В этом случае персонаж имеет шанс обнаружить ловушки, и они будут подсвечиваться курсором.^-~
@67133 = ~«А как их избежать?»~
@67134 = ~«Думаю, основное я понял, Анна».~
@67135 = ~«Избежать? Ну, обычно надо *снять* ловушку с места, которое взламываешь, или провернуть подобный фокус. Если только уверен, что у тебя хорошие шансы убрать ловушку… но раз уж нашёл… — Анна пожимает плечами. — Тебе должно повезти. В большинстве случаев».

^NПРИМЕЧАНИЕ. <DISARMTRAP> Если не получится, то есть вероятность срабатывания ловушки.^-~
@67136 = ~«Что-нибудь ещё?»~
@67137 = ~«Думаю, основное я понял, Анна».~
@67138 = ~«Больше тут ничё не скажешь — всё методом проб и ошибок, вот. Желаю удачи… — она нехорошо ухмыляется. — Только не там, где промышляю я, ага?»~
@67139 = ~«Ладно».~
@67140 = ~«Хорошо…» — она оглядывает тебя с головы до ног. «Давай-ка перейдём к крови и поту, без которых работы не бывает, — она хмурится, изучая тебя. — Первое, что тебе нужно, — сменить походку: не тряси задом и не задирай голову, как ты любишь…»~
@67141 = ~«Хорошо…»~
@67142 = ~«Хорошо…»~
@67143 = ~«Хорошо…»~
@67144 = ~«Хорошо…»~
@67145 = ~Анна по-быстрому вводит тебя в курс дела, проверяет твои рефлексы и равновесие. Когда она это делает, ты смутно чувствуешь нечто знакомое, как будто часть тебя просыпается, и твоё тело начинает отвечать этим воспоминаниям. Анна кажется удивлённой твоим умениям, но не теряется, и скоро ты обнаруживаешь, что вы с ней хорошо сработались. В конце концов она кивает, поражённая: «Ага, ты поймал главное. Быстро врубаешься, правда».~
@67146 = ~«У меня к тебе другие вопросы…»~
@67147 = ~«Спасибо. Теперь пойдём».~
@67148 = ~Анна по-быстрому вводит тебя в курс дела, проверяет твои рефлексы и равновесие. Когда она это делает, ты чувствуешь, как с твоей памяти раз за разом спадают всё новые покровы, будто каждая проверка открывает новую дверь: смутные образы тёмных аллей, засады на крышах, срезание кошельков на многолюдных рынках, вскрывание замков на воротах — эти воспоминания вливаются в тебя рекой, и ты каждый раз легко решаешь задачи, поставленные Анной, в ответ испытывая её.~
@67149 = ~Анна быстро… и охотно… включается в соревнование, пытаясь поймать тебя так, потом иначе, а ты без усилий справляешься с каждой её хитростью, отвечая новой. Закончив испытание, Анна отстраняется и, похоже, видит тебя в новом свете. «Ты *уверен*, что не занимался этим раньше? Ты… ты быстрый, точняк. Кажись, я от тя узнала больше, чем ты от меня».~
@67150 = ~Жезл в твоих руках кажется холодным и безжизненным. Возможно, он не будет работать в твоём нынешнем местоположении.~
@67151 = ~Убрать его.~
@67152 = ~Жезл в твоих руках кажется холодным и безжизненным. Возможно, он не будет работать в твоём нынешнем местоположении.~
@67153 = ~Убрать его.~
@67154 = ~Портальная линза~
@67155 = ~Я доставил рекламное объявление в «Горящий труп» и вернулся к Гильтспуру. Он сказал, что работы у него для меня больше нет.~
@67156 = ~Мощная регенерация~
@67157 = ~Медленная регенерация~
@67158 = ~Иммунитет к не-серебряному, не-магическому~
@67159 = ~~
@67160 = ~«Себастьян. Маг, которого я встретил в Нижнем районе».~
@67161 = ~«Китла, женщина, которую я встретил в Керсте».~
@67162 = ~Я воспользовался порталом, о котором мне рассказала Тухлая Мэри, и попал в тронный зал Безмолвного Короля. Там я обнаружил, что державный владыка Мёртвых Народов на самом деле немногим больше, чем иссохший труп. Я согласился никому об этом не рассказывать, в обмен Харгримм освободил меня из Мёртвых Народов.~
@67163 = ~~
@67164 = ~~
@67165 = ~Металлическая плита явно используется в качестве постели. С одной из её сторон есть часть, которую можно открыть с помощью рычага.~
@67166 = ~Открыть и посмотреть внутрь.~
@67167 = ~Уйти.~
@67168 = ~Миньон Тени~
@67169 = ~Миньон Тени~
@67170 = ~«Спасибо. Прощай».~
@67171 = ~«Знаком ли ты с искусством запрещённых сделок? Приходилось ли когда-нибудь воровать кошельки, чтобы выжить? Крался ли беззвучно по тёмным коридорам? Или мне нужно учить тебя с чистого листа?»~
@67172 = ~«Забудь. Прощай».~
@67173 = ~«Ничего. Прощай».~
@67174 = ~«Уверен, что хочешь таких изменений? Ты не сможешь драться и воровать одновременно, знаешь ли».~
@67175 = ~«Хорошо. И не забывай основы, ладно?»~
@67176 = ~«Не размениваешься на мелочи, так? Ну ладно. Начнём. Сперва посмотрим, как у тебя с ловкостью. Удержи этот кинжал на кончике пальца», — он бросает тебе нож.~
@67177 = ~Ты ловишь нож на кончик пальца и ловким движением заставляешь его вращаться. Челюсть Набата отвисает: «Хорошо. Очевидно, что ты достаточно быстр. Тебе точно нужно обучение?»~
@67178 = ~Ты ловишь кинжал за рукоять и быстро устанавливаешь его на кончик указательного пальца. «Вполне неплохо. Ты уверен, что тебе нужно обучение?»~
@67179 = ~Ты пытаешься поймать кинжал, но рукоять отскакивает от твоей руки и ты едва не режешься в попытке его удержать. «Прости, друг. У тебя определённо нет способностей, чтобы быть рыцарем наживы. Нужно что-нибудь ещё?»~
@67180 = ~«Ну хорошо. Во-первых, самое основное, чем ты должен овладеть: скрытность, взлом замков, поиск и обезвреживание ловушек и обнаружение слабостей врага».~
@67181 = ~«Одна из важнейших вещей, которой нужно обучиться, — это перемещаться незаметно. Это позволит тебе проскользнуть мимо поста стражи, подойти к врагу сзади, избежать обнаружения и так далее. Только помни, что это невозможно, если на тебя кто-то глазеет».~
@67182 = ~«Ладно. Замки. Замки тебе не друзья. Ты должен кое-что знать об их механике, если вообще хочешь куда-нибудь попасть. Далее, некоторые ублюдки оставляют маленькие сюрпризы тем, кто претендует на их собственность, так что ты должен проверять замок на ловушки. К этому мы ещё вернёмся».~
@67183 = ~«Так, теперь тебе нужно знать, как сунуть куда-нибудь руку, чтобы никто этого не заметил. Иногда чтобы облегчить чей-то кошелёк, иногда — чтобы заполучить вещицу, на которую положил глаз. Но будь готов драться или дать дёру, если тебя за этим поймают».~
@67184 = ~«Помнишь, что я говорил о ловушках? Они могут стать твоим злейшим врагом. Когда видишь что-то под охраной — или, что ещё хуже, *без* охраны — приближайся медленно и гляди в оба глаза. Такое сразу не заметишь, поищи как следует».~
@67185 = ~«Если ты нашёл ловушку, есть два пути: попытаться её обойти или обезвредить. Когда пытаешься обезвредить, есть риск, что она сработает прямо тебе в лицо. Ты искушаешь судьбу, пытаясь обдурить неизвестную магию или механизмы».~
@67186 = ~«А вот и большой приз: удар в спину! С ручищами как у тебя это будет ой как больно! Подкрадываешься к кому-нибудь сзади, тщательно выбираешь место — и удар. Нанесёшь как следует — причинишь серьёзный, очень серьёзный урон. Но первой же атакой ты себя обнаружишь, сам понимаешь, так что думай, куда бьёшь».~
@67187 = ~«Первое, чему тебе стоит научиться, — это никогда не спешить. Спешка приводит к ошибкам, а ошибки приводят к неприятностям. Неприятности тебе нужны меньше всего…»

Твоё обучение воровству начинается.~
@67188 = ~Через некоторое время он прерывается: «Достаточно. Ты быстро учишься. Это всё, что я могу тебе дать. Остальное ты усвоишь сам».~
@67189 = ~Через некоторое время он прерывается. «Достаточно. Ты быстро учишься. Это всё, что я могу тебе дать. Остальное ты усвоишь сам… но с твоими навыками я почти уверен, что ты занимался этим раньше», — с этими словами к тебе приходит понимание, что ты *действительно* занимался этим раньше… что когда-то обладал этими навыками и обучение только разбудило их.~
@67190 = ~Когда в памяти всплывают угасшие было воспоминания о засадах в тёмных коридорах и уклонении от смертельных ловушек, ты «обучаешься» даже большему, чем тебе преподал Набат.~
@67191 = ~«Мне приходилось заниматься таким раньше».~
@67192 = ~«Боюсь, придётся начинать с чистого листа».~
@67193 = ~«Ты знаешь, забудь. Прощай».~
@67194 = ~Скелет-торговец~
@67195 = ~Скелет-торговец~
@67196 = ~«Знаю. Я не хочу больше быть воином. Давай-ка стряхнём пыль с моего набора трюков».~
@67197 = ~«Знаю. Я не хочу больше быть магом. Давай-ка стряхнём пыль с моего набора трюков».~
@67198 = ~«Нет, пожалуй, не уверен. Прощай».~
@67199 = ~«Не забуду. У меня было ещё немного вопросов…»~
@67200 = ~«Не забуду. Прощай».~
@67201 = ~Легко поймать его на кончик пальца.~
@67202 = ~Поймать его за рукоять, потом поставить на кончик пальца.~
@67203 = ~Попытаться поймать его.~
@67204 = ~Защита от рубящего~
@67205 = ~Защита от колющего~
@67206 = ~Защита от дробящего~
@67207 = ~Защита от дистанционного~
@67208 = ~Сопротивление~
@67209 = ~Обычному огню~
@67210 = ~Магическому огню~
@67211 = ~Обычному холоду~
@67212 = ~Магическому холоду~
@67213 = ~Электричеству~
@67214 = ~Кислоте~
@67215 = ~Магии~
@67216 = ~Рубящему урону~
@67217 = ~Колющему урону~
@67218 = ~Дробящему урону~
@67219 = ~Дистанционным атакам~
@67220 = ~Норма~
@67221 = ~Страж сердито смотрит на тебя: «Прочь с дороги. У нас неотложное дело».~
@67222 = ~«Прощай».~
@67223 = ~Нет~
@67224 = ~«Да. Обучи меня».~
@67225 = ~«Нет, забудь. Ответь на пару вопросов…»~
@67226 = ~«Нет, забудь. До свиданья».~
@67227 = ~«Да. Обучи меня».~
@67228 = ~«Нет, забудь. Ответь на пару вопросов…»~
@67229 = ~«Нет, забудь. До свиданья».~
@67230 = ~«Ответь на пару вопросов».~
@67231 = ~«Нет, забудь. До свиданья».~
@67232 = ~«Продолжай…»~
@67233 = ~«Думаю, основы я понял. Давай приступим к практике».~
@67234 = ~«Продолжай…»~
@67235 = ~«Продолжай…»~
@67236 = ~«Думаю, основы я понял. Давай приступим к практике».~
@67237 = ~«Продолжай…»~
@67238 = ~«Продолжай…»~
@67239 = ~«Продолжай…»~
@67240 = ~«Думаю, основы я понял. Давай приступим к практике».~
@67241 = ~«Думаю, основы я понял. Давай приступим к практике».~
@67242 = ~«Думаю, основы я понял. Давай приступим к практике».~
@67243 = ~«Думаю, основы я понял. Давай приступим к практике».~
@67244 = ~«Ладно. Давай приступим к практике».~
@67245 = ~Усвоить всё, что получится.~
@67246 = ~Усвоить всё, что получится.~
@67247 = ~Усвоить всё, что получится.~
@67248 = ~Я обучился на вора под руководством Набата, наставника из таверны «Врата предателей» в Керсте.~
@67249 = ~«Благодарю тебя. Прощай».~
@67250 = ~«Возможно, и занимался. Спасибо тебе и прощай».~
@67251 = ~Уйти.~
@67252 = ~«Ты *осмелишься* воровать у Вришики?!»~
@67253 = ~«Во дела! В этом была нужда?!»~
@67254 = ~«…и он — вор!»~
@67255 = ~«Па! Что случилось? Кто *сделал* это с тобой?!»~
@67256 = ~«Крадёшь у честного человека, да?!»~
@67257 = ~«Я отрежу тебе руки и продам их!»~
@67258 = ~Причуды Аалека~
@67259 = ~Магическая лавка Циндера~
@67260 = ~Наковальня Анзе~
@67261 = ~«Когда-нибудь, может быть, я буду здесь торговать».~
@67262 = ~«Хм-м. Может, хоть тут кто-нибудь захочет поболтать…»~
@67263 = ~«Приветик, я Карина. Как самочувствие?»~
@67264 = ~«Столько людей, а мне по-прежнему одиноко…»~
@67265 = ~«Иногда я думаю, что меня избегают…»~
@67266 = ~«Интересно, что искали те абишаи…»~
@67267 = ~«Мне надо следить за очагом».~
@67268 = ~Крыса-оборотень шипит на тебя, но сдерживает в себе явное желание напасть. Вместо этого она крадучись отступает назад, не отрывая от тебя глаз.~
@67269 = ~«Тогда прощай».~
@67270 = ~GlobalGT("Join_Anarchists", "GLOBAL", 0)~
@67271 = ~Закончить чтение Круга.~
@67272 = ~Закончить чтение символов.~
@67273 = ~~
@67274 = ~«Я нашёл и убил стаю черепокрыс среди камней старого прохода».~
@67275 = ~Закончить чтение символов.~
@67276 = ~Закончить чтение символов.~
@67277 = ~Закончить чтение символов.~
@67278 = ~Закончить чтение символов.~
@67279 = ~Закончить чтение символов.~
@67280 = ~Продолжить чтение символов…~
@67281 = ~Ведунья Саросса в Великой Кузнице сказала, что называет меня получеловеком, потому что не может увидеть мою душу. Она не знает, значит ли это, что у меня нет души, или та просто вне досягаемости, но называть меня получеловеком это ей не мешает.~
@67282 = ~Я солгал ведунье Сароссе, что разделяю убеждения Боготов, и эта стерва выкачала из меня силу единым словом.~
@67283 = ~Я сказал ведунье Сароссе, что разделяю убеждения Боготов, и она подарила мне озарение. Почему-то я чувствую себя… мудрее.~
@67284 = ~Я предъявил Тильдону шило, которое мне дал Сарос. Тильдон утверждает, что Сарос его подставил.~
@67285 = ~Тильдон утверждает, что Сарос — Анархист, который вместе с инженером Бедай-Лин пытается его дискредитировать.~
@67286 = ~Сегодня я убил в Нижнем районе больную женщину-гитцерай. Ей было трудно дышать грязным воздухом района, и смерть её не страшила.~
@67287 = ~Я заставил Дак'кона убить больную женщину-гитцерай болезненно. Думаю, она оценила этот жест, если отбросить сантименты.~
@67288 = ~Я позволил Дак'кону помочь женщине его народа, больной гитцерай, которая слишком глубоко вдохнула ядовитые испарения Нижнего района. Он убил её, но она казалась благодарной.~
@67289 = ~Аукционер Гильтспур предложил мне 100 монет, чтобы я доставил сообщение для Келдора из Дуриана в Великую Кузницу.~
@67290 = ~«Хочу перенять опыт…»~
@67291 = ~«Да просто так. У меня другие вопросы…»~
@67292 = ~«Кто-то похитил документ и затем уничтожил. Таким образом долг будет оплачен дважды…»~
@67293 = ~«Кто-то похитил документ… А может, даже уничтожил».~
@67294 = ~Помощь~
@67295 = ~Местоположение, необходимое для твоей задачи, отрезано от тебя.~
@67296 = ~«Правда? Почему же ты тогда так нервничаешь, а, Ленни? Попробую догадаться: Байрон думает что ты уничтожил бумаги, но, возможно, это не так. Может, ты их сохранил. Небольшой компромат, а?»~
@67297 = ~«Почему же ты тогда так нервничаешь, Ленни? Думаю, ты врёшь».~
@67298 = ~«Мне пора идти. Прощай».~
@67299 = ~Токола по имени Торп и двое его друзей-токола собираются сражаться с абишаем. Кажется, токола не особо-то яркие личности, но выглядят достаточно круто. Может быть, у них и получится.~
@67300 = ~Похоже, Торп и его друзья напились и оскорбили леди в таверне, пролив на неё всю выпивку. Леди Ксантия отказалась принять извинения Торпа до тех пор, пока он не покажет себя истинным воином. Для этого он должен убить абишая.~
@67301 = ~Я предупредил Торпа, что абишая можно ранить только магией или магическим оружием. Я сделал доброе дело, ведь иначе он и его друзья погибли бы.~
@67302 = ~Кажется, Торп не знает, что абишай может быть поражён только магией или магическим оружием. Я мог бы предупредить его… но какого дьявола. Зато будет забавно.~
@67303 = ~Иногда я сам себе удивляюсь. Я пожалел Торпа и его друзей и помог им убить абишая. Что я могу сказать… минутная слабость с моей стороны?~
@67304 = ~Я встретил в Нижем районе женщину по имени Ксантия. Она была расстроена тем, что трое пьяных токола испортили её вечернее платье, пролив на него выпивку. Она решила отомстить им и не принимать извинений, пока они не победят в рукопашном бою абишая. По её словам, абишай может быть поражён только магией или магическим оружием, которого токола не имеют. Она хочет посмотреть, как абишай разорвёт токола. Стоит ли мне предупредить их?~
@67305 = ~«Думаю, мне приходилось раньше заниматься подобным. Так или иначе, у меня к тебе ещё вопросы…»~
@67306 = ~«Спасибо за обучение. Пойдём».~
@67307 = ~Это невидимое КОЛЬЦО, которое дает существу иммунитет к Литанию Проклятий.~
@67308 = ~«Ага… эт можно. Типа чего?»~
@67309 = ~«Я бы хотел узнать больше об умении прятаться».~
@67310 = ~«Меня интересует всё, что ты знаешь о вскрытии замков».~
@67311 = ~«Можешь рассказать что-нибудь об обезвреживании ловушек?»~
@67312 = ~«Есть советы как залезть в чей-нибудь карман?»~
@67313 = ~«На самом деле, это тебе у меня стоит поучиться».~
@67314 = ~«Ничего. У меня другие вопросы…»~
@67315 = ~«Забудь. Пошли».~
@67316 = ~Она кивает. «Ага, ну, фокус невидимости в понимании где ты и умении быстро стать ЧАСТЬЮ того места. Я знаю несколько фенек, одна из них — спрятаться там, где никто не ждёт, например, в комнате на потолке; или даже *менять* своё укрытие, когда тя ищут… — она злобно улыбается. — Один раз я пряталась от шайки этих крепкоголовых… „законников“… и вот что я *сделала*…»~
@67317 = ~«Да?..»~
@67318 = ~«…и вот, лежит этот крепкоголовый мордой в сточной канаве, без штанов, а остальные трое заперты в комнате прабабушки и воют на небеса, — Анна переводит дыхание. — Вот так-то. Бери на вооружение, пригодится, если захочешь действительно сныкаться».~
@67319 = ~«Так, посмотрим: обеспечить себе отход в хорошо знакомое место, а ещё лучше, если там в окрестностях есть какие-нибудь естественные укрытия. Если нет, то их стоит сделать».~
@67320 = ~«Вскрытие замков… ну, могу сказать, чего НЕ надо делать. Во-первых, всегда носи с собой чуток масла или типа того, чтоб смазать отмычку, если замок заело; ещё одно, что я узнала, прикинь, от старого костыля Фарода: что многие замки в Сигиле на самом деле сработаны одним кузнецом чуть не в каменном веке, и у них один и тот же прикол…»~
@67321 = ~«Продолжай…»~
@67322 = ~«…так вот, это случилось незадолго до пика, с первыми признаками зари, и я знала, что меня ищут по чердакам. Но замок-то на чердаке был сигильский, и я быстренько заклинила ту щеколду, а они этого не учли, что дало мне достаточно времени, чтоб смыться по крышам вместе с серебром, вот».~
@67323 = ~«Значит, этот „тип“ запорного механизма используется во многих замках… это должно помочь, если придётся взламывать подобный замок».~
@67324 = ~«Ну, тут как раз всё легко объяснить: самое главное — кто-то ведь должен был ПОСТАВИТЬ ловушку, и этот кто-то должен ЗНАТЬ, где она стоит. Так что ищи как следует их следы там, где лежит что-то ценное. Вот, было как-то раз, влезла я в Большое Поместье в районе Клерков и…»~
@67325 = ~«Да…»~
@67326 = ~«…и тот факт, что ковёр на полу вокруг шкафа недавно меняли, меня насторожил. Я приподняла его кинжалом — и точно, на камнях под ковром были пятна от кислоты. Так я просекла, что надо опасаться кислотной ловушки, када вскрою шкаф и буду тырить медяки».~
@67327 = ~«Значит, когда ищешь и обезвреживаешь ловушки, надо смотреть не только на признаки их установки, но и на следы, оставленные хозяином при необходимости обхода этих ловушек».~
@67328 = ~«Ну, стянуть чей-то кошелёк не так трудно, как можно подумать… — Анна пожимает плечами. — Тут больше вопрос скорости и аккуратности, чтоб лопух не заметил. Если как следует потренироваться, всё получится». Она кивает тебе: «Покажи мне».~
@67329 = ~«Ну, я не хочу вот так сразу совать руку в чужой карман под твоим наблюдением. Может быть, в другой раз».~
@67330 = ~«Не-а, попробуй спереть немного медяков у меня. Я скажу, чё ты неправильно делаешь».~
@67331 = ~«Ладно… э-э, где ты их хранишь?»~
@67332 = ~«А это уж ты *сам* должен узнать, если хошь стать настоящим вором».~
@67333 = ~«Ну ладно… дай мне попробовать спереть… э-э, обчистить твои карманы».~
@67334 = ~Как только ты делаешь движение по направлению к ней, Анна поднимает руку. «Ладно, хорош — ты уже попался, так и знай».~
@67335 = ~«Что?»~
@67336 = ~«Те надо следить за тем, как подходишь к клиенту, ага. Ты ж не какой-нить токола, чтоб продираться прямо к нему, особенно с твоей-то внешностью». Анна внезапно кладёт руки на бёдра и отворачивается, как будто скучая. «Надо вести себя так, будто клиент для тя никто, даже меньше, чем никто. Те ваще на него наплевать».~
@67337 = ~«Хорошо, я веду себя так, будто мне плевать. Что дальше?»~
@67338 = ~«Дальше надо выбрать момент для *щипка*. Я обычно делаю это сразу, как приближусь к клиенту. А те лучше делать это сразу *после* того, как приблизишься, — он наверняка будет слишком напуган, чтоб сразу оглядываться, куда ты ушёл. И вот ещё что те нужно сделать…»~
@67339 = ~«Да?..»~
@67340 = ~«…так что оденься победнее и, мож, стоит попытаться выглядеть не так жутко, тада ты усыпишь бдительность клиента… или его самого, если он наклюкался».~
@67341 = ~«Хорошо. Итак, попытаться никого не пугать, расслабиться, сделать вид, что не замечаю клиента, а потом незаметно обшарить его, да?»~
@67342 = ~Она кивает: «Ага, в этом вся суть».~
@67343 = ~«У меня другие вопросы…»~
@67344 = ~«Хорошо. Пошли».~
@67345 = ~«Чё? Ты *серьёзно*? — она поднимает бровь. — *Мне*? Поучиться у тебя?»~
@67346 = ~«Думаю, я могу дать тебе кое-какие советы о том, как быть незаметней».~
@67347 = ~«Я знаю кое-что о замках, чего не знаешь ты».~
@67348 = ~«Да, я могу кое-чему научить тебя в вопросе карманных краж».~
@67349 = ~«Да, я хотел бы поделиться некоторыми секретами нахождения и обезвреживания ловушек».~
@67350 = ~«Не бери в голову; не думаю, что смогу чему-то научить тебя прямо сейчас. У меня были другие вопросы…»~
@67351 = ~«Забудь. Пошли».~
@67352 = ~«Да ладно? — ухмыляется она. — Например?»~
@67353 = ~«Ну, я считаю, что хвост мешает тебе несколько больше, чем ты думаешь. Я заметил, как ты дёргаешь им, когда нервничаешь или за тобой наблюдают; этого достаточно, чтобы тот, кто тебя ищет, мог заметить. И ещё кое-что…»~
@67354 = ~«Ты используешь не те отмычки, когда взламываешь замки. Нужны другие: одна с наконечником в виде буквы „Y“, а другая…»~
@67355 = ~«Когда ты шаришь по карманам, используй для пущего эффекта своё тело; оно отвлечёт клиента от его имущества. И…»~
@67356 = ~«Тебе стоит искать не только *видимые* признаки ловушек, но и все остальные, начиная с запаха серы и заканчивая изменением температуры…»~
@67357 = ~«Чё? — Анна моргает. — Хошь сказать, я должна изображать шлюху?»~
@67358 = ~«Ну, а какого ещё дьявола ты носишь эту вещь? Я думал, ты это нарочно».~
@67359 = ~Анна оглядывает себя, затем опять поднимает глаза: «Да мне просто *жарко*, ага; думаю, это всё моя кровь. Жилет позволяет коже дышать».~
@67360 = ~«Ну, если добавить чуток разрезов, то клиента в последнюю очередь будет беспокоить, лезет кто-то в его карман или нет. Теперь посмотри на мои руки: когда ты срезаешь кошелёк, тебе нужно…»~
@67361 = ~Ты показываешь Анне, как срезать кошельки, но она стоит как столб.~
@67362 = ~«Что *сейчас*?»~
@67363 = ~«Ничего не могу поделать… эт ты виноват! — Анна зажмуривается. — Те не надо было говорить о моём жилете, теперь я только об этом и думаю, ага».~
@67364 = ~«Посмотри мне в глаза. Теперь просто успокойся».~
@67365 = ~Глаза Анны встречаются с твоими, и ты замечаешь, что она всё ещё напряжена и кусает губы.~
@67366 = ~«Смотри, я быстро покажу тебе, и всё».~
@67367 = ~Ты наклоняешься, и в этот момент Анна внезапно делает движение навстречу, а её руки обвиваются вокруг тебя. Она нежно обнимает тебя, затем прижимается сильнее, её лёгкое дыхание у твоей шеи, потом у щеки. «Мне… мне нравится твой запах, правда, — она трётся щекой об твою, и ты удивляешься, какая гладкая у неё кожа. — Твоя кожа как дублёная, да».~
@67368 = ~Проверить свой кошелёк.~
@67369 = ~Ты нагибаешься и хватаешь Анну за хвост, конец которого оказывается в твоих пожитках. Анна отступает назад, затем ухмыляется. «Это то, о чём ты говорил? Тырить кошельки у лохов вот так, ага? — она слегка покраснела, ты замечаешь её участившееся сердцебиение. — Как просто, надо же».~
@67370 = ~«Да… думаю, ты уловила суть. Слушай, у меня к тебе другой вопрос…»~
@67371 = ~«Так и есть… пойдём».~
@67372 = ~Выслушав твои наставления, Анна спокойно кивает. «Ага, об этом я и не подумала, точно, — она хмурится. — Я бы и сама допёрла в конце концов, так что не воображай себя каким-то фестхолльским наставником, усёк?»~
@67373 = ~«Просто пытался помочь».~
@67374 = ~«Уж поблагодарила так поблагодарила. У меня были к тебе ещё вопросы…»~
@67375 = ~«Всегда пожалуйста. Пойдём».~
@67376 = ~«Больше похоже на то, что пытался выставить меня *дурой*, ага».~
@67377 = ~«О чём ты, дьявол возьми?»~
@67378 = ~«Уж поблагодарила так поблагодарила. У меня были к тебе ещё вопросы…»~
@67379 = ~«Всегда пожалуйста. Пойдём».~
@67380 = ~«Вот ты припёрся ко двору Фарода, и он носится с тобой как дурак с писаной торбой, чуть ботинки не лижет, потом ПРИКАЗЫВАЕТ мне идти с тобой, как НИКОГДА не делал, а ты ещё трындишь, что знаешь больше меня… какое ты имеешь *право*? Да кто ты вообще ТАКОЙ?»~
@67381 = ~«Я ВСЕГО ЛИШЬ пытаюсь помочь тебе, Анна».~
@67382 = ~«Уж поблагодарила так поблагодарила. У меня были к тебе ещё вопросы…»~
@67383 = ~«Всегда пожалуйста. Пойдём».~
@67384 = ~«О, да ладно? Значит, каждый раз, когда я тырю кошелёк или вскрываю замок, ты просто качаешь головой за моей спиной и думаешь про себя: „Неуклюжая, тупая девка. Она вообще не знает, как это надо делать“. И чувствуешь себя крутым после этого, да?»~
@67385 = ~«Анна, я только показывал, как сделать некоторые вещи ещё *лучше*… я ничего тебе не навязываю. Я *не* считаю тебя неуклюжей и *не* считаю тебя тупой».~
@67386 = ~Анна хмурится, размахивая хвостом взад-вперёд: «Ага, ну… лучше следи за языком. Терпеть не могу, када мне сочувствуют, ага».~
@67387 = ~«Хорошо. У меня только пара вопросов…»~
@67388 = ~«Прекрасно. Пошли».~
@67389 = ~«Место, где я нашла твоё тело, лежит за нарисованной дверью в квартале проституток Улья. Дверь выходит на северную улицу, к северо-востоку от бара „Горящий труп“. За дверью — аллея, где валялось твоё тело. Странное место, вот. Не всякий пень туда попадёт».~
@67390 = ~«Странное место? Почему?»~
@67391 = ~«Ясно. У меня другие вопросы…»~
@67392 = ~«Тогда ладно. Вперёд».~
@67393 = ~«Есть странная такая аллея в дальней стороне от насеста Лающих Псов — туда нам и надо, вот. Сзади их логова есть дверь, через которую нам надо пройти».~
@67394 = ~«Странная аллея? Что ты имеешь в виду?»~
@67395 = ~«Ясно. У меня другие вопросы…»~
@67396 = ~«Тогда ладно. Вперёд».~
@67397 = ~«Есть место на юго-восток по странной аллее, через старые ворота, потом несколько ступенек вниз. Там я и нашла тебя».~
@67398 = ~«Странная аллея? Что ты имеешь в виду?»~
@67399 = ~«Ясно. У меня другие вопросы…»~
@67400 = ~«Тогда ладно. Вперёд».~
@67401 = ~«Какой-нить трусливый пень сказал бы, что она *с призраками*, ага, — Анна плюёт и очерчивает полукруг над сердцем. — Брехня. Иногда, когда ветер дует сквозь неё, слышны жуткие вздохи. Но это ж не значит, что там духи, призраки или типа того».~
@67402 = ~«Ясно. У меня другие вопросы…»~
@67403 = ~«Тогда ладно. Вперёд».~
@67404 = ~«Ага, и какой?»~
@67405 = ~«Ну, зачем ты искала трупы на беременной улице? Я имею в виду, ты должна была проползти через логово, затем миновать дабуса, чтобы попасть туда. А это место не так посещаемо, как все остальные в Улье. Так что тебя надоумило искать там трупы?»~
@67406 = ~Анна пожимает плечами: «Всё остальное в Улье выгребли подчистую, вот. Пришлось искать новые места, чтоб нарыть жмурика, так-то».~
@67407 = ~Когда Анна говорит, твой затылок охватывает странное ощущение, и ты внезапно понимаешь, что она тебе лжёт.~
@67408 = ~«Ты *уверена*, Анна?»~
@67409 = ~Должно быть, есть что-то в твоём голосе, потому как хвост Анны на секунду замирает, а потом начинает двигаться медленнее. «Ага… я *думаю*, — она хмурится и выглядит неуверенно. — *Обычно* я не хожу туда подбирать жмуриков, нет… подумать, так и не была там до этого. Просто забрела, типа того».~
@67410 = ~«Так зачем ты пришла туда?»~
@67411 = ~«Без… без понятия! Просто пришла… и твоё счастье, что пришла, ага, а то б до сих пор там валялся!»~
@67412 = ~То же ползучее ощущение прокрадывается в заднюю часть черепа, и ты вдруг чётко осознаёшь: Анна лжёт, но, как ни странно, сама *не знает*, что лжёт.~
@67413 = ~«Анна, тебя заставили туда прийти? И так ты нашла меня?»~
@67414 = ~Я думаю, Анну каким-то образом *заставили* найти моё тело. Она сказала, что тело для неё не отличалось от камня, и ей пришлось искать его.~
@67415 = ~Она кивает… медленно: «Ага, похоже». Затем недоумённо пожимает плечами. «Это не было моим любимым местом, но я… ничего не могла поделать. Просто *захотела* в тот день посмотреть чё там — а там был ты, не живей полена, — она прерывается. — Ты был совсем как камень, ага. Без понятия, как я вообще тя нашла».~
@67416 = ~«Хм-м. Любопытно. У меня были ещё вопросы…»~
@67417 = ~«Просто хотел знать. Пойдём».~
@67418 = ~Она кивает слегка настороженно: «Ага, встречались. Тя забыть непросто».~
@67419 = ~«Когда я спросил тебя о Фароде, ты отправила меня на юго-запад от Мортуария, где его *не было*».~
@67420 = ~«Что ты делала у Мортуария?»~
@67421 = ~«Ага, отправила — и ты б сделал то же самое, если б какая-то покрытая шрамами развалина подошла и спросила, как найти твоего папашу, — она пожимает плечами. — Ты ж его всё равно нашёл, так что хватит капать мне на мозги, правда».~
@67422 = ~«Что ты делала у Мортуария?»~
@67423 = ~«Неважно. У меня другие вопросы…»~
@67424 = ~«Ну, если бы ты просто сказала мне, где он, нам обоим было бы намного проще. А теперь пойдём».~
@67425 = ~«Это мой район, жмуриков я искала, вот, — она меряет тебя взглядом, потом ухмыляется. — Нашла одного ходячего, вот».~
@67426 = ~«Ясно. У меня другие вопросы…»~
@67427 = ~«Пошли».~
@67428 = ~Анна смотрит на тебя настороженно, её хвост на секунду замирает, а потом начинает двигаться медленнее, чем раньше: «Ага, *может*, я чё-то и нашла. Но *если* я чё-то нашла, это моё по праву, вот. Остальное присвоил Фарод».~
@67429 = ~«Анна, у меня нет времени на игры… *что* ты нашла на моём трупе?»~
@67430 = ~«Ну, у тя был кастет, ага… и чуть-чуть медяков, но это я оставила Пылюкам, чтоб не считали меня совсем уж нечестной. Ещё у тя было отвратное кольцо, которое я сныкала… — она суёт палец под наруч и выуживает маленькое колечко с вделанным в него камнем. — Стоит раза в три дороже, чем те медяки с кастетом, вот». Она осматривает кольцо, косясь на тебя: «Жалко, слишком уж страшное, чтоб носить».~
@67431 = ~«Верни мне кольцо. Сейчас же».~
@67432 = ~Она хмуро оглядывает кольцо, бросает взгляд на тебя, потом опять на него. Фыркнув, она щелчком отправляет тебе кольцо: «Не надо мне такой дряни, ага».~
@67433 = ~«Прекрасно. Но ты упоминала, что остальное найденное на моём теле „присвоил“ Фарод. Что ты имела в виду?»~
@67434 = ~«Неважно. У меня другие вопросы…»~
@67435 = ~«Мы поговорим об этом позже. А сейчас пошли».~
@67436 = ~«Ага. Фарод берёт дань с каждого трупа, найденного нами, правда. Эт его право, как хозяина в деревне и всё такое».~
@67437 = ~«С КАЖДОГО трупа из всех, что вы находите? Это *много* трупов».~
@67438 = ~«Наверное, он хранил это всё в своём бункере. У меня были ещё вопросы…»~
@67439 = ~«Должно быть, он хранил это всё в своём бункере. Пошли».~
@67440 = ~«О, ага… поговаривают, старый костыль хранит свои манатки где-то рядом с собой. Это единственная причина сидеть в этом грязном холодном зале, вот. Сплошная вонь и тень».~
@67441 = ~«В самом деле? Так вот где он складывает свою дань?»~
@67442 = ~«Ага, — косится она на тебя. — Ну-ка, о чём это ты? Никак хочешь его стукнуть?»~
@67443 = ~Правда: «Нет. У меня нет причин делать подобное. Фарод мне ничего плохого не сделал».~
@67444 = ~Ложь: «Нет. У меня нет причин делать подобное».~
@67445 = ~«После всей беготни за этой сферой для него практически за так — очень хочется».~
@67446 = ~«Ну, *хорошо*… я б те не советовала, правда. Мож, Фарод и тупит иногда, но он злобен, как плевок старого изверга, када его потрошат, — она хмурится. — И он *любит* свои цацки, уж будь уверен».~
@67447 = ~«Но где он мог бы их хранить? Если он в деревне так долго, как говорит, — наверняка он собрал впечатляющую коллекцию».~
@67448 = ~«Я б те не советовала, правда. Мож, Фарод и тупит иногда, но он злобен, как плевок старого изверга, када его потрошат, — она хмурится. — И он *любит* свои цацки, уж будь уверен».~
@67449 = ~«Но где он мог бы их хранить? Если он в деревне так долго, как говорит, — наверняка он собрал впечатляющую коллекцию».~
@67450 = ~«Ну… — секунду Анна молчит. — Я знаю, что он никогда не уходит из зала, если ему нужно чё-то из его побрякушек».~
@67451 = ~«Он и не ушёл бы далеко на своей-то хромой ноге, однако».~
@67452 = ~«Ага, это правда… если только не посмотреть внимательно. Он не хромой, хотя прекрасно разыгрывает из себя слабого на ногу».~
@67453 = ~«Тогда зачем он ходит с этим костылем?»~
@67454 = ~«Так его костыль… может быть ключом портала?»~
@67455 = ~Анна пожимает плечами: «Не знаю». Она кивает на тебя: «Ты б ещё спросил, зачем у тя эти кости вокруг талии скачут, ага».~
@67456 = ~«Неважно. У меня другие вопросы…»~
@67457 = ~«Забудь. Пошли».~
@67458 = ~Секунду Анна задумчиво хмурится, потом медленно кивает головой. «Ага… это мысль, — она пожимает плечами. — Хотя я не знаю, как его использовать. Может, надо просто *иметь* его».~
@67459 = ~«Вот и проверим. У меня тут ещё вопросы…»~
@67460 = ~«Может, выясним это позже. Пойдём».~
@67461 = ~«Старый костыль? Он мой папа… ну, не *настоящий* папа. Он нашёл меня, када я была сопливой девчонкой… — Анна пожимает плечами. — Ему нужен был Сборщик, чтоб залезать туда, где все остальные его жирные чурки не протиснутся, вот он и взял меня под свой костыль».~
@67462 = ~«Я заметил, что вы с ним не очень-то похожи».~
@67463 = ~«Можешь рассказать о нём что-нибудь ещё?»~
@67464 = ~«У меня другие вопросы…»~
@67465 = ~«Ясно. Давай двигать».~
@67466 = ~Анна сужает глаза и начинает мести землю хвостом: «*Чё* эт ты имеешь в виду, а?»~
@67467 = ~«Я имел в виду, трудно заметить сходство между этим мерзким, тупым, жадным, вонючим помойным троллем и тобой».~
@67468 = ~«Я имел в виду, что он непохож на тифлинга».~
@67469 = ~«Я имел в виду, что ты не очень похожа на человека».~
@67470 = ~«Я имел в виду, что ты не такая, как другие».~
@67471 = ~«Не бери в голову. У меня другие вопросы».~
@67472 = ~«Забудь. Пошли».~
@67473 = ~«Ага, *непохож*… да если б ещё ты знал чё-нить о тифлингах кроме того, что сказал какой-нить полоротый ульевец на улице, ты б понял, что мы, тифлинги, вообще не похожи друг на друга, усёк? — она трясёт головой. — Кретином был, кретином и останешься, это и к бабке не ходи».~
@67474 = ~«Я не имел в виду ничего *плохого*. Вы оба такие разные. Я говорю, что Фарод… ну… это *Фарод*, а ты — нет».~
@67475 = ~«Не бери в голову. У меня другие вопросы».~
@67476 = ~«Забудь. Пошли».~
@67477 = ~«О-о, вот это шикарно, чтоб меня! Ты шляешься тут, весь как ходячая коллекция ран, и ещё имеешь наглость втирать мне, как должны выглядеть *люди*? Да чтоб ты в собственную кучу упал, силы-заступники!»~
@67478 = ~«Я не имел в виду ничего *плохого*. Вы оба такие разные. Я говорю, что Фарод… ну… это *Фарод*. А ты — нет».~
@67479 = ~«Не бери в голову. У меня другие вопросы».~
@67480 = ~«Забудь. Пошли».~
@67481 = ~«Ё-моё, как догадался? По волосам? По коже? Не понимаю… — Анна слегка хлопает себя по лбу, потом саркастически фыркает. — Может быть, по *хвосту*? О, ага, и как я не допёрла! Ты сильно умнее меня, точно. Просто бездна интеллекта».~
@67482 = ~«Я имел в виду, трудно заметить сходство между этим мерзким, тупым, жадным, вонючим помойным троллем и тобой».~
@67483 = ~«Какого дьявола ты взвилась? Я просто сказал, а тебе как кинжал в зад воткнули».~
@67484 = ~«Не бери в голову. У меня другие вопросы».~
@67485 = ~«Забудь. Пошли».~
@67486 = ~«Вот уж точно, кинжал и есть».~
@67487 = ~«Всё, что я сказал, — это что вы с Фародом не имеете ничего общего. У вас и правда нет большого сходства».~
@67488 = ~«Не-ет, кончай пороть мне эту бредятину про „забудь и пошли“! Ну-ка, расскажи мне, чё эт только щас вякнула твоя помойная пасть?»~
@67489 = ~«Я имел в виду, трудно заметить сходство между этим мерзким, тупым, жадным, вонючим помойным троллем и тобой».~
@67490 = ~«Я имел в виду, что он непохож на тифлинга».~
@67491 = ~«Я имел в виду, что ты не очень похожа на человека».~
@67492 = ~«Я имел в виду, что ты не такая, как другие».~
@67493 = ~Лицо Анны густо краснеет. «О, *вот* как? И как эт ты заметил?»~
@67494 = ~Правда: «Я хочу сказать, ты когда-нибудь *смотрела* на себя в зеркало? Если отбросить твоё поведение, ты волевая, чувственная и привлекательная. И это ещё если не принимать во внимание твою очевидно прекрасную внешность: эти густые, огненно-рыжие волосы, эти пронзительные зелёные глаза и эффектный профиль».~
@67495 = ~Ложь: «Я хочу сказать, ты когда-нибудь *смотрела* на себя в зеркало? Если отбросить твоё поведение, ты волевая, чувственная и привлекательная. И это ещё если не принимать во внимание твою очевидно прекрасную внешность: эти густые, огненно-рыжие волосы, эти пронзительные зелёные глаза и эффектный профиль».~
@67496 = ~Правда: «Я хочу сказать, посмотри на себя. Да ты в два раза более жадная мародёрка, чем Фарод, и от тебя несёт этой странной ульевской вонью, от которой у меня глаза слезятся, и у тебя из задницы торчит этот мерзкий крысиный хвост».~
@67497 = ~Оскал искажает лицо Анны, а её глаза вспыхивают: «Лучше *на себя* посмотри, ё-моё. В другой раз я скорей засуну тя в книгу мёртвых, вместо того чтоб вытаскивать оттуда».~
@67498 = ~«Ну, попробуй, *девочка*, только если кому и достанется после этого труп, то мне твой и никак иначе».~
@67499 = ~«Продолжай бросаться угрозами, если так чувствуешь себя круче. Между тем у меня были ещё вопросы…»~
@67500 = ~«Неважно. Пошли».~
@67501 = ~Анна просто глазеет на тебя.~
@67502 = ~«И это всё, что я имел в виду, когда сказал, что вы с Фародом не очень-то похожи».~
@67503 = ~Анна кивает, продолжая глазеть на тебя. Она даже не моргает.~
@67504 = ~«Ты меня слушаешь?»~
@67505 = ~Внезапно Анна наклоняется и кусает тебя острыми зубами за шею, издавая мягкое шипение. Вместо того, чтобы отпрянуть, она теснее прижимается к тебе и шепчет на ухо: «Ты представляешь, чем рискуешь?» Её хвост начинает медленно раскачиваться взад-вперёд, но ритм скорее гипнотический, чем сердитый.~
@67506 = ~Ты чувствуешь, как сердце в груди Анны начинает стучать быстрее, её щеки розовеют. Внезапно ты осознаёшь, насколько её кожа мягкая и гладкая. «Я хочу кой-чего те сказать, только не смейся».~
@67507 = ~«Хорошо…»~
@67508 = ~«Ты знаешь, что мне нравится твой *запах*? О, ага, он делает меня психованней Хаоситов, правда, — она обнюхивает твою щёку и издаёт тихое страстное шипение. — Я видела, как ты на меня пялился, и мне это *нравится*. У тя голодные *глаза*, вот. Это меня возбуждает».~
@67509 = ~«Хочу кусать тебя, нежно, за шею…» — она дразнит твою шею зубами, не прокусывая кожу, и каждый раз, когда она шепчет, ты чувствуешь у своего уха её дыхание. Её рука скользит по твоему затылку, сжимается, и ты чувствуешь, как ногти впиваются в кожу. «Хочу терзать твою шею ногтями и заставить тебя целовать меня».~
@67510 = ~«Хотел бы просто вклинится и уточнить: я не собираюсь говорить ничего такого, что испортило бы настрой, шеф. Просто летаю тут и смотрю. Не обращайте на меня внимания, вы мне не мешаете».~
@67511 = ~«Ты знаешь, что я могу *почуять* тебя за пятьдесят шагов; эту вонь формалина, которой от тебя несёт, как от ковылял Пылюков? Мож, если б ты чуть помылся, те б чего и перепало, — её глаза вспыхивают. — Мне прям страстно хочется сбросить тя со шпиля». Она отступает назад, слегка стегая тебя хвостом по ногам, затем награждает тебя тяжёлым взглядом. «Так чё… я те нравлюсь?»~
@67512 = ~Обнять её и слушать…~
@67513 = ~Ты хватаешь Анну и, пока она не успела вырваться, слегка кусаешь её в шею. Когда твои зубы касаются кожи, Анна громко шипит, царапается как кошка и вырывается из твоих объятий. «Я только *дразнила* тя, вампир драный! Отвали-и-и!» Однако, несмотря на протесты, её лицо раскраснелось, она тяжело дышит. «И в следующий раз не распускай свои лапы! — она скрещивает руки на груди. — Ты меня в краску вогнал, вот!»~
@67514 = ~Схватить её и тоже укусить.~
@67515 = ~«Да… да, нравишься».~
@67516 = ~«Анна, давай не будем больше об этом, ладно?»~
@67517 = ~Ложь: «В чём дело? Там, откуда я родом, кусают друг друга в качестве приветствия».~
@67518 = ~«Ты кусаешь *меня*, я кусаю *тебя*. Если тебе это не нравится, тогда не ДЕЛАЙ так».~
@67519 = ~«Слушай, довольно этого… у меня были к тебе вопросы».~
@67520 = ~«Хватит с меня; пойдём отсюда».~
@67521 = ~«О, *конечно*, я те верю, — дыхание Анны успокаивается, приходя в норму. — Просто держи лапы при себе, слышишь?»~
@67522 = ~«Слушай, довольно этого… у меня были к тебе вопросы».~
@67523 = ~«Хватит с меня; пойдём отсюда».~
@67524 = ~«Чё *хочу*, то и делаю, — фыркает Анна; она всё ещё кажется слегка покрасневшей. — Просто держи лапы при себе, слышишь?»~
@67525 = ~«Слушай, довольно этого… у меня были к тебе вопросы».~
@67526 = ~«Хватит с меня; пойдём отсюда».~
@67527 = ~«Ну, ты многовато о себе вообразил, — фыркает Анна; она всё ещё кажется слегка покрасневшей. — Я только *дразнила* тя, вампир драный! Ты не *настолько* хорошо пахнешь, не-а».~
@67528 = ~«Слушай, довольно этого… у меня были к тебе вопросы».~
@67529 = ~«Хватит с меня; пойдём отсюда».~
@67530 = ~«Не парься, — фыркает Анна; она всё ещё кажется слегка покрасневшей. — Я только *дразнила* тя, вампир драный! Ты не *настолько* хорошо пахнешь, не-а».~
@67531 = ~«Слушай, довольно этого… у меня были к тебе вопросы».~
@67532 = ~«Хватит с меня; пойдём отсюда».~
@67533 = ~«Был в деревне дольше, чем я. Пришёл туда чуть не в каменном веке, может, даже *основал* это место, как говорят некоторые наши, — Анна хмурится. — Фарод из расчётливых, ага. Умеет заколачивать деньги и без медяков никогда не сидел».~
@67534 = ~«И всё это время он разыскивал бронзовую сферу?»~
@67535 = ~«И всё это время он разыскивал бронзовую сферу?»~
@67536 = ~«Он не показался мне особенно богатым, когда я его посещал. Наверное, он ещё более прижимист, чем ты думаешь».~
@67537 = ~«У меня другие вопросы…»~
@67538 = ~«Ясно. Давай двигать».~
@67539 = ~«Наверно, — Анна опять пожимает плечами. — Я не знаю, чё он так рвался её получить. Я учуяла, када ты её принёс». Она морщит нос: «Тухлый крем, вот чем она пахла. Хотя… чё-то явно ценное для него в этой сфере, раз он с ней так носится — почти половина Сборщиков прописалась в книге мёртвых, пытаясь её достать».~
@67540 = ~«Кажется, он её искал, потому как думал, что она спасёт ему жизнь».~
@67541 = ~«У меня другие вопросы…»~
@67542 = ~«Ясно. Давай двигать».~
@67543 = ~«Если всё, как ты сказал, наверно, да», — Анна снова пожимает плечами. «Вряд ли дело в глупости Фарода, не-а. Побрякушка не спасёт от рук судьбы. Если пятна на твоей душе достаточно черны, их уже ничем не отмоешь, — она прерывается. — И всё же, если он думал, что она спасёт его, мож, чё-то важное в ней и *было*… на крайняк, она может стоить медяков».~
@67544 = ~«У меня другие вопросы…»~
@67545 = ~«Ясно. Давай двигать».~
@67546 = ~Она моргает: «Чё ты имеешь в виду?»~
@67547 = ~«Я так понял, Фарод не был праведником. Когда-то он был „Старейшиной“ в одном из Верхних районов. Очевидно, он использовал своё положение, чтобы лгать, жульничать и вредить другим — достаточно для того, чтобы обречь себя на посмертный ад. Он думал, что бронзовая сфера может его как-то спасти, так что отринул свой титул, своё богатство и положение в обществе, чтобы попытаться её найти».~
@67548 = ~Я рассказал Анне о том, что узнал у Вонючки в Улье; похоже, она ничего не знала о прошлом Фарода и была удивлена тем, что услышала.~
@67549 = ~«Серьёзно?» — она замолкает на секунду, потом качает головой. «Вряд ли тут дело в глупости Фарода, не-а. Побрякушка не спасёт от рук судьбы. Если пятна на твоей душе достаточно черны, их уже ничем не отмоешь, — она прерывается. — И всё же, если он думал, что она спасёт его, мож, чё-то важное в ней и *было*… на крайняк, она может стоить медяков».~
@67550 = ~«У меня другие вопросы…»~
@67551 = ~«Ясно. Давай двигать».~
@67552 = ~«Не-а, он этого не показывает, но он барахольщик, сто пудов. И не любит, когда другие копаются в его вещах, поэтому их и прячет».~
@67553 = ~«Так он прячет свои ценности?»~
@67554 = ~Анна хмурится: «Это *ничё* не значит, правда. Болтовня спятившей ведьмы, вот».~
@67555 = ~«Ты уверена?»~
@67556 = ~«Тогда не бери в голову. Я хотел спросить кое-что ещё…»~
@67557 = ~«Тогда забудь. Пошли».~
@67558 = ~«Это ЧУШЬ. Если ты без понятия, чё она сказала, то я уж тем более».~
@67559 = ~«Ну, если ты хочешь об этом поговорить, то я слу…»~
@67560 = ~«Тогда не бери в голову. Я хотел спросить кое-что ещё…»~
@67561 = ~«Тогда забудь. Пошли».~
@67562 = ~«Я… — Анна на секунду опускает глаза. — Я не знаю, почему болтаюсь с тобой! Я не знаю, зачем пошла с тобой искать Рейвел!» Она хмурится, но выглядит скорее растерянно, чем сердито: «Я не вижу тут никакого *смысла*, вот, и мне это не нравится».~
@67563 = ~«Я…» — Анна глубоко вздыхает. «Я думаю, у меня есть к те *чувства*. Это так странно, вот… не думаю, что мне хоть *кто-то* когда-либо нравился. Но ты…» — Анна пожимает плечами, не глядя тебе в глаза. «Не знаю, чё в тебе такого… ты часто ведешь себя как *придурок*, ходишь так, будто у тя бёдра перебиты, ты неуклюж, пахнешь как зомби, но… — она вздыхает. — Ты мне *нравишься*».~
@67564 = ~Анна хмурится, уставившись в землю: «Ага, мож, это и к *лучшему*. Чувства к другим только наносят раны, которые не исцелить».~
@67565 = ~«Анна, почему ты молчала? Нам стоило поговорить уже дав…»~
@67566 = ~«Анна, ты мне небезразлична… но в другом смысле».~
@67567 = ~«Анна, почему ты молчала? Нам стоило поговорить уже дав…»~
@67568 = ~«Это потому, что я считаю тя *обречённым*, — внезапно Анна встречается с тобой взглядом. — Думаю, ты скован, но ещё не знаешь об этом. Так что я… *неравнодушна* к тебе, но боюсь за тебя… и это *убивает* меня, вот. Я не хочу, чтоб с тобой чё-то случилось, но не знаю, как тя уберечь. Так что… я пошла с тобой».~
@67569 = ~«Я ценю, что ты рядом со мной, Анна».~
@67570 = ~«Ну, думаю, я обречён. Слушай, у меня были другие вопросы…»~
@67571 = ~«Ясно. Слушай, хватит об этом, пойдём».~
@67572 = ~«Ага… ну… — она погружается в молчание на минуту, затем пожимает плечами. — Неважно».~
@67573 = ~«Слушай, у меня были другие вопросы…»~
@67574 = ~«Ну ладно тогда, Анна. Пошли».~
@67575 = ~«Это потому, что я считаю тя *обречённым*, — внезапно Анна встречается с тобой взглядом. — Думаю, ты скован, но ещё не знаешь об этом. Так что я… *неравнодушна* к тебе, но боюсь за тебя… и это *убивает* меня, вот. Я не хочу, чтоб с тобой чё-то случилось, но не знаю, как тя уберечь!»~
@67576 = ~Поцеловать её.~
@67577 = ~Поцеловать её.~
@67578 = ~Анна рычит. «Ага, отвали, любитель сосаться. Чтоб ты знал, целовать ту ведьму куда *безопаснее*, чем раскатывать губы на изверга, — она сплёвывает. — А теперь хорош трындеть, не хочу больше ни слова об этом слышать, ага».~
@67579 = ~«Тогда не бери в голову. Я хотел спросить кое-что ещё…»~
@67580 = ~«Тогда забудь. Пошли».~
@67581 = ~Анна хмурится, затем кивает: «Ага, ты был прав, что не поцеловал ту ведьму, правда».~
@67582 = ~«Ну, я не поцеловал её потому, что хотел поцеловать тебя».~
@67583 = ~«Тогда не бери в голову. Я хотел спросить кое-что ещё…»~
@67584 = ~«Тогда забудь. Пошли».~
@67585 = ~«А? Чё?»~
@67586 = ~Поцеловать её.~
@67587 = ~Поцеловать её.~
@67588 = ~«Не обращай внимания. Я хотел спросить кое-что ещё…»~
@67589 = ~«Забудь. Пошли».~
@67590 = ~Анна вращает глазами: «О, ага, ты можешь целовать самую злобную и отвратную ведьму на всех известных планах, но раскатываешь губы на меня? Ну уж, хуже этого ты ничего не мог придумать!»~
@67591 = ~Поцеловать её.~
@67592 = ~Поцеловать её.~
@67593 = ~«ПОЖАЛУЙСТА, ТОЛЬКО НЕ БЕЙ ПО ГОЛОВЕ!»~
@67594 = ~«Тогда не бери в голову. Я хотел спросить кое-что ещё…»~
@67595 = ~«Тогда забудь. Пошли».~
@67596 = ~Свободной рукой ты обнимаешь её за шею и видишь, как лицо Анны каменеет, когда ты притягиваешь её к себе и целуешь в губы.~
@67597 = ~Вначале это всё равно, что целовать стену; потом она медленно начинает отвечать тебе, сперва скованно, потом с большей уверенностью, её зубы легонько покусывают твою верхнюю губу. Ты слышишь рычание, идущее у неё откуда-то из горла, а её хвост обвивает твою ногу и начинает *сжиматься* в ритме её укусов.~
@67598 = ~Свободной рукой ты обнимаешь её за шею и видишь, как лицо Анны каменеет, когда ты притягиваешь её к себе и целуешь в губы.~
@67599 = ~Вначале это всё равно, что целовать стену; потом она медленно начинает отвечать тебе, сперва скованно, потом с большей уверенностью, её зубы легонько покусывают твою верхнюю губу. Ты слышишь рычание, идущее у неё откуда-то из горла, а её хвост обвивает твою ногу и начинает *сжиматься* в ритме её укусов.~
@67600 = ~«Эй, вы двое, прекратите, пока я не позвал сюда дабуса, чтобы вас разделить! — Морте хмыкает. — Или хотя бы позвольте мне присоединиться».~
@67601 = ~Во время поцелуя ты внезапно замечаешь, что кожа Анны начинает теплеть… точнее, излучать жар, как горячие угли. Ты отстраняешься, зубы Анны в последний раз кусают тебя, и она смотрит на тебя в растерянности, затем в гневе: «Чё такое, а? Я недостаточно хороша, ага?»~
@67602 = ~«Нет, это твоя кожа. Почему она вдруг раскалилась?»~
@67603 = ~«Да ладно?» — Анна хмурится и оглядывает себя; ты замечаешь маленькие струйки дыма, идущие от краёв её жилета. «Кровь извергов, вот что… — она поднимает бровь. — Однако *такого* у меня никогда раньше не было».~
@67604 = ~«Что? Тебя раньше никто не целовал?»~
@67605 = ~Она пожимает плечами: «Никто не *осмеливался*. А даже если и осмеливался, сомневаюсь, что со мной было такое».~
@67606 = ~«Тогда я приму это за комплимент».~
@67607 = ~«Ага… э-э… — Анна оглядывается, её хвост совершает загадочные движения. — Мы вообще собираемся идти, или чё? У нас нет времени стоять и трепаться, правда».~
@67608 = ~«Ну, *я* ещё не закончил с поцелуем. Иди сюда».~
@67609 = ~Она отшатывается, встревоженная: «Не-а… кто знает, чё будет дальше — мож, моё тело *сгорит*, вот! Держи свои губы от меня подальше!»~
@67610 = ~«Ну хорошо… на ЭТОТ раз. Пойдём».~
@67611 = ~Когда ты обращаешься к Анне, она просто смотрит на тебя, нахмурившись: «Ага? Чё ты *теперь* хочешь?»~
@67612 = ~«Ты в порядке?»~
@67613 = ~«У меня к тебе есть вопросы».~
@67614 = ~«Ничего, Анна. Просто проверял, по-прежнему ли ты со мной».~
@67615 = ~Анна не спускает с тебя сердитого взгляда.~
@67616 = ~«Я хотел задать тебе пару вопросов».~
@67617 = ~«Тогда неважно. Пошли».~
@67618 = ~«А чё не задаёшь вопросы своей суке-в-кубе? — глаза Анны сужаются в щёлки. — Зачем мы вообще *путешествуем* с ней? Она не НУЖНА нам, точно говорю».~
@67619 = ~«У меня нет *времени* на это, Анна. Перестань косить под баньши и помоги мне».~
@67620 = ~«Анна, мне нужна любая помощь, включая твою».~
@67621 = ~«Анна, *пожалуйста*. Ты очень важна для меня, и мне нужна твоя помощь».~
@67622 = ~«Анна, мне нужна не она, а ты. Если она тебя беспокоит, я попрошу её уйти».~
@67623 = ~«У меня нет *времени* спорить с тобой, Анна. Если тебе не нравится Падшая Грейс — уходи».~
@67624 = ~«Мы обсудим это позже. Пойдём».~
@67625 = ~«Так сделай это! — Анна пристально смотрит на тебя. — На спор, что не сделаешь. Если сделаешь, то и базара не будет, а если нет — так и будем ругаться, ага».~
@67626 = ~«Анна, мне нужна любая помощь, включая твою».~
@67627 = ~«Анна, *пожалуйста*. Ты очень важна для меня, и мне нужна твоя помощь».~
@67628 = ~~
@67629 = ~«У меня нет *времени* спорить с тобой, Анна. Если тебе не нравится Падшая Грейс — уходи».~
@67630 = ~«Мы обсудим это позже. Пойдём».~
@67631 = ~«Да кому ты *НУЖЕН*, а?! — Анна хватает свой рюкзак, вываливает перед тобой его содержимое, затем плюёт. — Даже не пытайся БОЛЬШЕ заговаривать со мной, а то я выпотрошу тя, мерзкая, тупая, ободранная, зловонная РАЗВАЛИНА. Надеюсь, ты СГНИЁШЬ!»~
@67632 = ~«Тогда уходи. Не хочу больше тебя видеть».~
@67633 = ~«Да ты просто *врун* с усохшим перцем, вот. Ты позволяешь мне шляться с тобой только потому, что ничё другого не придумал, ага! Почему ты просто не сказал мне отвалить, как только Фарод сделал меня твоей нянькой?!»~
@67634 = ~«Потому что…»~
@67635 = ~«Думаешь, мне НРАВИТСЯ с тобой ходить?! Ты так ДУМАЕШЬ?! Да ты… — гримаса отвращения появляется на лице Анны. — Твоя жизнь, если ты так это НАЗЫВАЕШЬ, — просто БАРДАК, как и твоя *кожа*, вся порезанная на куски и покрытая шрамами. Ты-то думаешь, что у тя какая-то там судьба и предназначение, а фиг тебе! Ты просто воплощение *бардака*, ага!»~
@67636 = ~«Анна, я не просил тебя уйти, потому что не хотел, чтобы ты уходила».~
@67637 = ~«*Никогда* больше не смей так со мной разговаривать. Твоё дело — молчать и исполнять, что я велю, или я тебе покажу, что такое настоящий бардак».~
@67638 = ~«У меня нет *времени* спорить с тобой, Анна. Если тебе не нравится Падшая Грейс — уходи».~
@67639 = ~«О, ага, и зачем тогда всё ЭТО? Вот шикарно, ё-моё. Ты жалеешь меня, да? Считаешь, что я тебе мешаю? Давай, скажи это!»~
@67640 = ~«Я не *жалею* тебя, и ты *не* мешаешь мне. Ты быстрая, умелая, и я правда нуждаюсь в любой помощи».~
@67641 = ~Анна хмурится, мотая хвостом взад-вперёд. «Ага… ну… *знай*, что я выпотрошу её, если она начнёт пускать слюнки, глядя на нас, вот, — она пристально смотрит на тебя. — И не думай даже, что я остаюсь по *твоему* желанию. Я просто добрая сегодня, ага».~
@67642 = ~«Прекрасно. У меня тут были вопросы…»~
@67643 = ~«Тогда пошли».~
@67644 = ~«Чего ТЫ хошь?!»~
@67645 = ~«Анна, мне нужна твоя помощь. Ты пойдёшь со мной снова?»~
@67646 = ~«Анна, мне нужна твоя помощь. Ты пойдёшь со мной снова?»~
@67647 = ~«Если ты не собираешься больше с нами путешествовать, то мне нужны мои вещи. Немедленно».~
@67648 = ~«ФИГА с два! Не с такими, как *она*, ё-моё! Вы оба можете убираться в Бездну и СГНИТЬ там, ага!»~
@67649 = ~«Анна, мне нужно *твоё* общество. Ты не против опять путешествовать со мной?»~
@67650 = ~Правда: «Анна, Падшая Грейс значит для меня не так много, как ты. Пожалуйста, пойдём опять с нами, а?»~
@67651 = ~Ложь: «Анна, Падшая Грейс значит для меня не так много, как ты. Пожалуйста, пойдём опять с нами, а?»~
@67652 = ~«Если ты не собираешься больше с нами путешествовать, то мне нужны мои вещи. Немедленно».~
@67653 = ~«Не-а, я никуда не пойду с душепожирающей сукой вроде неё, ни в жисть! Она должна *уйти*, да!»~
@67654 = ~«Ладно, я подумаю насчёт её ухода. Поговорим в следующий раз».~
@67655 = ~«Если ты не собираешься больше с нами путешествовать, то мне нужны мои вещи. Немедленно».~
@67656 = ~«Если она для тя не так много значит, то *она* должна уйти, ага. Я никуда не пойду с душепожирающей сукой вроде неё, ни в жисть!»~
@67657 = ~Правда: «Анна, слушай, она мне *безразлична*. Мне *нужно*, чтобы ты была рядом, но мне нужна и её помощь тоже, на время. После этого будем только ты и я».~
@67658 = ~Ложь: «Анна, слушай, она мне *безразлична*. Мне *нужно*, чтобы ты была рядом, но мне нужна и её помощь тоже, на время. После этого будем только ты и я».~
@67659 = ~«Тогда ты НИ С КЕМ не пойдёшь. Я оставлю тебя здесь, и можешь возвращаться к своей жалкой карьере сборщицы трупов. Или пойдём с нами».~
@67660 = ~«Ладно, я подумаю насчёт её ухода. Поговорим в следующий раз».~
@67661 = ~«Если ты не собираешься больше с нами путешествовать, то мне нужны мои вещи. Немедленно».~
@67662 = ~Минуту Анна разглядывает тебя, пытаясь прочитать выражение твоего лица. «Лучше б те не врать мне, ага».~
@67663 = ~«Я не вру. Пошли».~
@67664 = ~Анна смотрит на тебя. Пока ты говоришь, её гнев испаряется, а лоб разглаживается. «Так… может… я и вернусь. Пока что меня это не подводило!»~
@67665 = ~«Блестяще. Иди, возвращайся к своим трупакам и, может быть, однажды ты кончишь как Фарод, вся скрюченная, больная и *слабая*. ИЛИ ты можешь пойти с нами. Твой выбор».~
@67666 = ~Анна пялится на тебя, её хвост неподвижен.~
@67667 = ~«Твой выбор. Прямо сейчас».~
@67668 = ~«Я… я пойду с тобой, да».~
@67669 = ~«Хорошо. Тогда пошли».~
@67670 = ~«Ага, так целуйся со своей крылатой шлюхой! — Анна сплёвывает. — Мне нет больше дела до вас обоих, вот!»~
@67671 = ~«Тогда прощай».~
@67672 = ~Глаза Анны сужаются в щёлки: «Ну и где же сука-в-кубе, а? Подавилась куском твоей шеи и послала тя в Бездну, ага?»~
@67673 = ~«Она больше не путешествует с нами, Анна. Я хочу, чтобы ты опять ко мне присоединилась».~
@67674 = ~«Не имеет значения, забудь. Прощай».~
@67675 = ~«Откуда мне знать, что так оно и ОСТАНЕТСЯ, а? Что если она вернётся или… — Анна кажется разочарованной. — Кто-то вроде НЕЁ прилипнет, а? Будет опять то же самое?»~
@67676 = ~«Анна, этого не повторится».~
@67677 = ~«Забудь. Прощай».~
@67678 = ~«Ага… ну… в следующий раз будь осторожнее, вот. Я пойду с тобой опять, лады».~
@67679 = ~«Прекрасно. Пошли».~
@67680 = ~«Так где то место, в котором валялось моё тело?»~
@67681 = ~«Так где то место, в котором валялось моё тело?»~
@67682 = ~«Так где то место, в котором валялось моё тело?»~
@67683 = ~«У меня вопрос о том, как ты нашла моё тело…»~
@67684 = ~«Анна… мы ведь с тобой встречались в Улье, до того как я нашёл Фарода?»~
@67685 = ~«Анна, у меня было что-нибудь при себе до того, как ты принесла меня в Мортуарий?»~
@67686 = ~«Расскажи мне немного о Фароде».~
@67687 = ~«Анна, когда Фарод пошёл возвращать найденное на моём теле, он ненадолго исчез, а затем вернулся, но залы Дурного Ветра не покидал. Не знаешь, куда он уходил?»~
@67688 = ~«Я хочу, чтобы ты знала, когда я поцеловал Рейвел в лабиринте, я…»~
@67689 = ~«Я хочу, чтобы ты знала, когда я поцеловал Рейвел в лабиринте, я…»~
@67690 = ~«Анна, можешь поучить меня воровским навыкам?»~
@67691 = ~Лотар сказал, что я бессмертен, так как моя смертность была похищена у меня омерзительной ночной ведьмой Рейвел Клубок-Загадок. Ещё он сообщил, что если я хочу получить ответы на свои вопросы, то должен искать её в лабиринте, в который её отправила Госпожа Боли. Теперь мне всего-то осталось выяснить, как туда попасть…~
@67692 = ~«Ну ладно, пойдем».~
@67693 = ~«Анна, я нашёл Фарода мёртвым в залах Дурного Ветра».~
@67694 = ~«Анна, ты знаешь, как умер Фарод?»~
@67695 = ~«В лабиринте Рейвел говорила о твоих муках… что она имела в виду?»~
@67696 = ~«Я ценю то, что ты рядом со мной, Анна».~
@67697 = ~Хвост Анны останавливается, когда ты говоришь, потом она пристально смотрит на тебя: «Ты серьёзно? Щас не время для шуток, правда».~
@67698 = ~«Нет, Анна… я правда нашёл его мёртвым в залах Дурного Ветра. Не знаешь, кто мог его убить?»~
@67699 = ~«Я… — она качает головой. — Я *не знаю*. Никто б не рискнул, у кого хоть чуть-чуть мозгов. У Фарода длинная тень, ага. Убить его — чё-то типа самоубийства, правда».~
@67700 = ~«Ты не обязана идти со мной дальше, Анна. Если тебе нужно остаться в Похороненной деревне, я…»~
@67701 = ~«Ну ладно. У меня были ещё вопросы…»~
@67702 = ~«Тогда неважно. Пошли».~
@67703 = ~~
@67704 = ~«Не-а… — прерывает тебя Анна. — Мне не надо быть в деревне — нечего мне там делать. Тем более что Фарод залез в книгу мёртвых, вот». Она фыркает: «Прикинь, наверно, он там в аду щас обрабатывает чью-то стенку, ага».~
@67705 = ~«Но… он твой отец. Ты не…»~
@67706 = ~«Не *настоящий* папа, нет, — её взгляд становится жёстким. — Он был жадным, тупым и себялюбивым, а ещё он был слабаком». Она хмурится: «А теперь он умер. Вот и всё».~
@67707 = ~«Ну хорошо тогда. Хотел у тебя спросить кое-что ещё…»~
@67708 = ~«Тогда пошли».~
@67709 = ~«Не-а, без понятия… но мне *надо* осмотреть тело. Фарод — хитрый хрен, он мог и наколоть тебя…»~
@67710 = ~«Покажу чуть позже. Сперва ответь на пару других вопросов…»~
@67711 = ~«Тогда я сейчас покажу тебе».~
@67712 = ~«Ага?»~
@67713 = ~~
@67714 = ~«Так где то место, в котором валялось моё тело?»~
@67715 = ~Уступить.~
@67716 = ~«Так где то место, в котором валялось моё тело?»~
@67717 = ~«Так где то место, в котором валялось моё тело?»~
@67718 = ~Уступить.~
@67719 = ~«У меня вопрос о том, как ты нашла моё тело…»~
@67720 = ~«Анна… мы ведь с тобой встречались в Улье, до того как я нашёл Фарода?»~
@67721 = ~«Анна, у меня было что-нибудь при себе до того, как ты принесла меня в Мортуарий?»~
@67722 = ~«Анна, я нашёл Фарода мёртвым в залах Дурного Ветра».~
@67723 = ~«Анна, ты знаешь, как умер Фарод?»~
@67724 = ~«Расскажи мне немного о Фароде».~
@67725 = ~«Анна, когда Фарод пошёл возвращать найденное на моём теле, он ненадолго исчез, а затем вернулся, но залы Дурного Ветра не покидал. Не знаешь, куда он уходил?»~
@67726 = ~«Анна, можешь поучить меня воровским навыкам?»~
@67727 = ~«Я хочу, чтобы ты знала, когда я поцеловал Рейвел в лабиринте, я…»~
@67728 = ~«Я хочу, чтобы ты знала, когда я поцеловал Рейвел в лабиринте, я…»~
@67729 = ~«В лабиринте Рейвел говорила о твоих муках… что она имела в виду?»~
@67730 = ~«Слышала о ночной ведьме по имени Рейвел Клубок-Загадок?»~
@67731 = ~«Не знаешь, где я могу найти „кусок“ Рейвел?»~
@67732 = ~«Неважно, Анна. Просто проверял, по-прежнему ли ты со мной».~
@67733 = ~Анна рассказала мне одну вещь о карманных кражах; она сказала, что воровать у одних легче, чем у других. Одно дело обычное городское население и совсем другое — торговцы или стражники. Анна сказала, что если обокрасть много народу, то навар вполне себя оправдывает. Ещё она сказала, что можно воровать в магазинах, так что если у обычных ульевцев нет ничего ценного, я всегда могу зайти в лавку и выбрать, что меня интересует…~
@67734 = ~Как часть моего обучения, Анна рассказала об умении остаться незамеченным или прятаться в тени. В основном это может быть сделано везде и в любой обстановке, но не во время вскрытия дверного замка, взлома сундука… или обшаривания чьих-то карманов.~
@67735 = ~Анна рассказала об одном плюсе пряток в тенях: когда я нападаю на кого-то из тени, мои атаки причиняют ГОРАЗДО больший урон. Кажется, это называется «удар в спину». Стоит как-нибудь попробовать.~
@67736 = ~~
@67737 = ~«Так ты будешь учить меня?»~
@67738 = ~Её глаза вспыхивают: «О? Изучал ли ты Искусство раньше?»~
@67739 = ~«И ты желаешь бросить то, чем занимаешься сейчас, чтобы восстановить своё мастерство?»~
@67740 = ~После небольшого разговора об Искусстве она кивает головой и улыбается: «Ты поистине одарённый. У тебя есть всё необходимое, чтобы снова вступить на мистический путь».~
@67741 = ~«Давай сперва посмотрим, есть ли у тебя способности», — она приступает к тестам твоего интеллекта и способности к рассуждению с помощью длинной серии логических и словесных загадок…~
@67742 = ~«Похоже, твой разум по крайней мере действует, — она рассматривает тебя. — И у тебя есть книга. Хорошо. Тебе она понадобится, чтобы записывать заклинания. Всем заклинаниям нужно место для хранения. Они бывают разных видов и размеров, но в конце концов все они должны быть записаны магом для изучения. Пока понятно?»~
@67743 = ~Она удерживается от того, чтобы не поднять тебя на смех, но ты замечаешь в её глазах огонёк презрения. «У тебя нет разума, необходимого для мага. Все твои заклинания будут как вода вытекать через уши до того, как ты успеешь ими воспользоваться. Попробуй лучше с мечом или стань вором. Хорошего мага из тебя не получится».~
@67744 = ~«Давай я немного тебя проверю. Взгляни сюда, — она достаёт свиток. — Прочитай и расскажи мне, что здесь написано». Знаки на свитке извиваются у тебя перед глазами, теряя смысл.~
@67745 = ~Инстинктивно ты позволяешь глазам расслабиться и воспринимаешь смысл свитка на уровне подсознания, как будто просто восстановилась очередная часть мозга. В свитке перечислены тайные слова, компоненты, жесты и ритуалы, необходимые для совершения заклинания.~
@67746 = ~Ты стараешься изо всех сил, но не можешь понять смысл букв на свитке. Каждый раз, когда ты думаешь, что удержал символы в голове, они плывут в твоих глазах, оставляя тебе лишь пульсирующую головную боль. Наконец через несколько минут тщательного разглядывания ты отстраняешься от пергамента с остекленевшими глазами… и внезапно содержание свитка становится ясным. В свитке перечислены тайные слова, компоненты, жесты и ритуалы, необходимые для совершения заклинания.~
@67747 = ~Китла ухмыляется: «Так ты уже знаешь, как читать свиток заклинания, да? Это означает, что когда-то ты обучался магии, даже если забыл об этом, потому что только маг может прочитать символы на этом свитке. Теперь твой разум снова открыт. Ты только что сэкономил годы обучения. Поздравляю».~
@67748 = ~«У тебя уже есть книга, так что всё, что тебе требуется, — это знать, как запоминать и использовать заклинания. Во-первых, тебе нужна свежая голова и достаточно отдыха для того, чтобы запомнить заклинания. Перед тем, как отдыхать, и это существенно, выбери заклинания, которые ты хочешь запомнить, а потом расслабься. Когда проснёшься, потрать немного времени на записанные заклинания, и они войдут в твой мозг».~
@67749 = ~«Когда ты только начинаешь, твои заклинания ограничены. Ты сможешь использовать одно заклинание, а может быть, даже до трёх. Не разбрасывайся ими попусту, поскольку, когда они кончатся, тебе придётся отдыхать снова, чтобы запомнить ещё. Однако, делая успехи в Искусстве, ты сможешь со временем запоминать всё больше и больше».~
@67750 = ~«Однажды произнесённое заклинание исчезает из твоей памяти. Если тебе нужно использовать одно заклинание два раза, и запоминать его нужно два раза, — она прерывается, задумавшись. — Всё время ищи новые заклинания. Найти их можно в самых разных местах и формах, узнать от разных людей. Когда найдёшь заклинание, сохрани его и при первой возможности запиши в книгу. Просто изучи его внимательно и запиши».~
@67751 = ~«Ты понял. Хорошо. Вот. Возьми эти свитки и запиши их в книгу заклинаний. Удачи».~
@67752 = ~«Благодарю тебя. Прощай».~
@67753 = ~«Прощай».~
@67754 = ~«Тогда ладно. Прощай».~
@67755 = ~«Может, позже. До свидания».~
@67756 = ~«Да. Мне всего лишь нужно освежить некоторые умения».~
@67757 = ~«Нет. Мне нужно наставление».~
@67758 = ~«Забудь. Просто ответь на пару вопросов».~
@67759 = ~«Забудь. Прощай».~
@67760 = ~«Да».~
@67761 = ~«Вообще-то нет. Лучше ответь на пару вопросов…»~
@67762 = ~«Нет, не думаю. Прощай».~
@67763 = ~«Спасибо. Прощай».~
@67764 = ~Отвечать на её вопросы как можно лучше.~
@67765 = ~Отвечать на её вопросы как можно лучше.~
@67766 = ~«Да. Мне нужна книга, чтобы записать туда заклинания, которые я смогу позже изучить».~
@67767 = ~«Хорошо. Прощай».~
@67768 = ~Изучить свиток.~
@67769 = ~Изучить свиток.~
@67770 = ~«Это малое предсказание, не так ли? Служит для опознания предметов».~
@67771 = ~«Это малое предсказание, не так ли? Служит для опознания предметов».~
@67772 = ~«Спасибо. И какой же следующий шаг?»~
@67773 = ~«Думаю, основы я усвоил. Давай перейдём к практике».~
@67774 = ~Китла, маг в таверне «Врата предателей» в Керсте, показала мне магический свиток, и я смог его прочитать. По её словам, моя способность читать свитки говорит о том, что когда-то я обучался магии.~
@67775 = ~«Сколько заклинаний я смогу использовать?»~
@67776 = ~«Думаю, основы я усвоил. Давай перейдём к практике».~
@67777 = ~«Хорошо. Продолжай»~
@67778 = ~«Думаю, основы я усвоил. Давай перейдём к практике».~
@67779 = ~«Ладно. Это всё?»~
@67780 = ~«Думаю, основы я усвоил. Давай перейдём к практике».~
@67781 = ~Китла обучила меня основам магии. Перед отдыхом я должен отметить заклинания для запоминания, открыв свою книгу заклинаний и выбрав их. Если я хочу несколько раз использовать одно и то же заклинание, и запоминать его нужно несколько раз. Всякий раз после отдыха я буду просыпаться на следующее утро с заклинаниями в памяти, готовыми к произнесению. Я смогу запоминать очень мало заклинаний, пока не наберусь опыта в магии.~
@67782 = ~Очевидно, я не понимаю значение следующего Круга в Неразорванном Круге Зертимона, или так говорит Дак'кон. Думаю, смысл слов выходит за рамки написанного на камне… придётся приложить к учению Зертимона собственную мудрость, прежде чем я постигну Путь Зертимона.~
@67783 = ~«Сейчас».~
@67784 = ~«Сейчас».~
@67785 = ~«Позже. Ответь мне на пару вопросов, ладно?»~
@67786 = ~«Я сделаю это позже. Прощай».~
@67787 = ~«Сейчас».~
@67788 = ~«Сейчас».~
@67789 = ~«Позже. Ответь мне на пару вопросов, ладно?»~
@67790 = ~«Я сделаю это позже. Прощай».~
@67791 = ~Я нашёл путь в осадную башню в Нижнем районе. Там оказался железный голем размером почти что с саму башню. Похоже, он куёт оружие, используя горн в башне.~
@67792 = ~Обратно в Мёртвые Народы~
@67793 = ~Трон Безмолвного Короля~
@67794 = ~«В его жилище есть доказательство — его дневник. Стоило мне о том заикнуться, как он превратился в крысу-оборотня и напал на меня».~
@67795 = ~«Так… ты замолвишь за меня словечко перед Безмолвным Королём?»~
@67796 = ~«Так… ты замолвишь за меня словечко перед Безмолвным Королём?»~
@67797 = ~«В его жилище есть доказательство — его дневник. Однако теперь он мёртв».~
@67798 = ~«В его жилище есть доказательство — его дневник».~
@67799 = ~«В его жилище есть доказательство — его дневник. Стоило мне о том заикнуться, как он превратился в крысу-оборотня и напал на меня».~
@67800 = ~Скелет-священник издаёт глубокое *хрм-м-м*, свет его глаз тускнеет, пока он думает. «Соэго. Избавь нас от этого проклятого Пыльного, и я поговорю с Безмолвным Королём о твоей свободе. Однако… я *не желаю* его убийства. Просто дай нам причину, дабы выдворить его из Мёртвых Народов».~
@67801 = ~«Он что?.. Тьфу! Полагаю, ты ждёшь от меня разговора с Безмолвным Королём о твоём освобождении… но зря! Пока ты не обоснуешь мне убийство, ты *не покинешь* это место».~
@67802 = ~«Соэго? О… он мёртв».~
@67803 = ~«А ты знаешь, что он шпион черепокрыс?»~
@67804 = ~«Что так сильно беспокоит тебя в Соэго?»~
@67805 = ~«Попробую. У меня другие вопросы…»~
@67806 = ~«Я посмотрю, что можно сделать. Прощай».~
@67807 = ~«Хорошо. У меня были вопросы…»~
@67808 = ~«Думаю, я попытаюсь что-нибудь найти».~
@67809 = ~«Но… что *ещё* я должен сделать, чтобы тебя убедить?»~
@67810 = ~Я спросил Харгримма, что ещё я должен сделать, чтобы убедить его отпустить меня на свободу. Он попросил найти повод выдворить Соэго из Мёртвых Народов, и тогда он поговорит с Безмолвным Королём о моём освобождении.~
@67811 = ~«А ты знаешь, что он шпион черепокрыс?»~
@67812 = ~Я изобличил Соэго перед Харгриммом, сказав, что он является шпионом черепокрыс.~
@67813 = ~Найти Харгримму причину для выдворения Соэго из Мёртвых Народов.~
@67814 = ~«Нет, я всё ещё над этим работаю. До свидания».~
@67815 = ~~
@67816 = ~Ивана, смотрительница галереи искусств в районе Клерков, сказала мне, что Тёмные Птицы Окантуса, которые представлены на выставке, — на самом деле осколки льда из Стикса. Любой, достаточно безумный, чтобы их съесть, испытает на себе действие воды Стикса, то есть потеряет все воспоминания. Явно обратно тому, что мне нужно, однако наводит на некоторые мысли…~
@67817 = ~Келдор~
@67818 = ~Эта женщина обливается потом и тяжело дышит: «Пожалуйста… прошу… спаси меня от этих людей…»~
@67819 = ~«Хорошо. До свидания».~
@67820 = ~«Расскажи мне что-нибудь об оружии».~
@67821 = ~«Хорошо. Прощай».~
@67822 = ~«Нет. Прощай».~
@67823 = ~«Расскажи мне сначала что-нибудь об оружии».~
@67824 = ~«Спасибо. Прощай».~
@67825 = ~«Расскажи мне сначала что-нибудь об оружии».~
@67826 = ~«Спасибо. Прощай».~
@67827 = ~Я придумал имя для безымянной зомби; кажется, она весьма им довольна.~
@67828 = ~«Тогда у меня другие вопросы…»~
@67829 = ~«В таком случае прощай».~
@67830 = ~«Хорошо. Но… ты кого-то ищешь?»~
@67831 = ~«Обратно так с-с-скоро? Уйди. Мы едим».~
@67832 = ~«Хорошо. Прощай».~
@67833 = ~«Военная реликвия»~
@67834 = ~~
@67835 = ~«Хорошо. Но… ты кого-то ищешь?»~
@67836 = ~Пятнистый Барс~
@67837 = ~~
@67838 = ~~
@67839 = ~Кузнец Крамплпанч~
@67840 = ~Клинок Порфатиса~
@67841 = ~КЛИНОК ПОРФАТИСА
(Проклятый)
Урон: 1-6 колющий
Зачаровано: +3
Особенности:
   Урон кислотой: 1-6
   Берсерк
THAC0: +3
Фактор скорости: 0
Вес: 1
Навык: клинок
Недоступно: священникам

Кислоты Порфатиса, пятого слоя Карцери, опасны не только для телесной оболочки — они просачиваются в сам разум и душу, пожирая рассудок. Оружие, выкованное в этом сердце предательства, делает со своим владельцем то же самое. Но слишком многие верят, что кислотные силы оружия, сделанного в Порфатисе, стоят того, чтобы рискнуть.~
@67842 = ~КИНЖАЛ
Урон: 1-6 колющий
Фактор скорости: 0
Вес: 1
Навык: клинок
Недоступно: священникам

У этого кинжала очень необычная конструкция. Острые углы и загогулины вдоль лезвия заставляют задуматься, для чего оно сделано.~
@67843 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@67844 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@67845 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@67846 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@67847 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@67848 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@67849 = ~Винокур Кестер~
@67850 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@67851 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@67852 = ~Салабеш темнеет лицом. «Нет… недавно я огорчил главу фестхолльских магов и думаю, что вернее будет отложить свой запрос. Кроме того, я уверен, что эта „леди“ Торнкомб нескоро выйдет из сенсориума…» — он подло хихикает.~
@67853 = ~«Я хочу спросить о другом…»~
@67854 = ~«Это всё, что я хотел узнать. Прощай».~
@67855 = ~«Хмф! Эта пустая легкомысленная девчонка… Торнкомб в кои-то веки выползла из сенсориума, так что мой шанс потерян. И говорить больше об этом не хочу!» — Салабеш продолжает еле слышно бормотать злобные проклятья.~
@67856 = ~«Тогда у меня другой вопрос…»~
@67857 = ~«Это всё, что я хотел узнать. Прощай».~
@67858 = ~«Ты уже подал заявление на место преподавателя магии в Фестхолле?»~
@67859 = ~«Так… как дела с твоим назначением преподавателем магии в Фестхолле?»~
@67860 = ~«Ты уже подал заявление на место преподавателя магии в Фестхолле?»~
@67861 = ~«Так… как дела с твоим назначением преподавателем магии в Фестхолле?»~
@67862 = ~В Фестхолле я встретил человека по имени Джамбл Убийца Чувств, который проклял Вонючку.~
@67863 = ~«Я бы попросил тебя снять проклятие с Вонючки».~
@67864 = ~«Я бы попросил тебя снять проклятие с Вонючки».~
@67865 = ~«Ладно. Но я бы хотел, чтобы ты снял проклятие с Вонючки».~
@67866 = ~«Я бы попросил тебя снять проклятие с Вонючки».~
@67867 = ~Джамбл громко вздыхает, закатывает глаза и кивает.~
@67868 = ~«Я хочу, чтобы ты снял с него своё старое проклятие».~
@67869 = ~«Это всё, что я хотел знать. Прощай».~
@67870 = ~«Ты и Вонючку проклял, не так ли?»~
@67871 = ~«Ты и Вонючку проклял, не так ли?»~
@67872 = ~Эта личность безумными от страха глазами смотрит, как гехрелеты губят народ: «Спаси нас, пожалуйста!»~
@67873 = ~«Попробую что-нибудь сделать…»~
@67874 = ~«Спасибо! Без тебя нас разорвали бы на части!»~
@67875 = ~«Не сомневаюсь. Прощай».~
@67876 = ~Смотритель Кайз~
@67877 = ~~
@67878 = ~~
@67879 = ~Отвары Двера~
@67880 = ~«Уйду, когда захочу. Прощай».~
@67881 = ~Этот мужчина не обращает на тебя внимания, всё его внимание занимает судилище на помосте. Его губы плотно сжаты, а костяшки побелели. Он сухо посмеивается про себя, даже не замечая твоего присутствия.~
@67882 = ~«Тогда забудь».~
@67883 = ~«Так зови…»~
@67884 = ~«Хорошо, прощай».~
@67885 = ~Сталь Тилеро~
@67886 = ~«Спасибо, что уделил время. Прощай».~
@67887 = ~«Кретины».~
@67888 = ~«УБЕЙТЕ себя… воры!»~
@67889 = ~«Прекратите! Прекратите это!»~
@67890 = ~Добрая инкарнация~
@67891 = ~Инкарнация~
@67892 = ~Параноидальная инкарнация~
@67893 = ~Практичная инкарнация~
@67894 = ~Дом лингвиста Финама~
@67895 = ~Ивес наклоняется вперёд, когда ты рассказываешь историю улицы, рождающей новую жизнь… она ловит каждое слово. Когда ты заканчиваешь, она улыбается тебе, затем Нордому: «Я запомню эту историю. А сейчас я расскажу тебе свою — „Часы и квадрон“».~
@67896 = ~«Погоди… у меня вопрос…»~
@67897 = ~«Продолжай…»~
@67898 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@67899 = ~Рассказать ей историю улицы Протяжных Вздохов.~
@67900 = ~Казармы~
@67901 = ~Винокурня~
@67902 = ~Администрация Керста~
@67903 = ~Врата в Карцери~
@67904 = ~Кузница~
@67905 = ~Звон и стук изнутри здания склоняет к мысли, что это кузница.~
@67906 = ~Эта маленькая будка вся облеплена уведомлениями, предложениями работы и другими объявлениями. Сейчас на ней вывеска, гласящая: «КАРАНТИН».~
@67907 = ~«Мне пора идти. Прощай».~
@67908 = ~«Мне пора идти. Прощай».~
@67909 = ~Эти тяжёлые ворота закрыты, заперты и опечатаны. Наклееное на них большое объявление гласит: «ЗОНА КАРАНТИНА. ВХОД И ВЫХОД ИЗ ГОРОДА ЗАПРЕЩЕНЫ».~
@67910 = ~Этот мужчина весь в синяках и крови. Его лицо раздулось от зверских побоев, нанесённых стражей Керста. Говорить он не может, только выплёвывает зуб и полный рот крови.~
@67911 = ~«Тогда прощай».~
@67912 = ~Стражник ненадолго прерывается, чтобы сказать: «Ты ничего не видел, если ещё жить охота». Затем снова поворачивается к своей жертве.~
@67913 = ~«Прощай».~
@67914 = ~«Ничего, не бери в голову. Прощай».~
@67915 = ~«Тогда забудь. Прощай».~
@67916 = ~«Жалко, что ты так считаешь… но не бери в голову. Прощай».~
@67917 = ~«Жалко, что ты так считаешь… но не бери в голову. Прощай».~
@67918 = ~«Помоги мне! Останови их!»~
@67919 = ~«Посмотрю, что можно сделать…»~
@67920 = ~«Плевать мне, что ты там надумал. Оставь меня в покое».~
@67921 = ~«Хорошо. Прощай».~
@67922 = ~«Скажи нам, и мы перестанем тебя мучить».~
@67923 = ~«Я не могу сказать…»~
@67924 = ~«Упрости себе жизнь».~
@67925 = ~«Просто скажи нам!»~
@67926 = ~«Я не могу!»~
@67927 = ~«Она всего лишь девчонка! Ну что такого она сделала?»~
@67928 = ~«Больше жизни, ребятки! Нам полагается доля!»~
@67929 = ~«Хорош гнать, парни… это не главная задача!»~
@67930 = ~«Всё веселье нам испортил!»~
@67931 = ~«Спасибо за доставку, уважаемый. Ты найдёшь его в Главном зале Боготов», — он открывает тебе ворота.~
@67932 = ~«Спасибо».~
@67933 = ~«Нет дела. Извини. Прощай».~
@67934 = ~«Где ты это спрятал, Янсен?»~
@67935 = ~Когда ты прерываешь эту особу, она оборачивается, презрительно щуря глаза. Окинув тебя взглядом, несколько смягчает выражение лица до обычной хмурой гримасы; затем неохотно отвешивает лёгкий поклон и снова отворачивается.~
@67936 = ~Уйти.~
@67937 = ~Эта личность поворачивается и отвечает, едва оторвав взгляд от выпивки: «Ничем не помогу и не отвечу на твои вопросы… так что просто оставь меня в покое. Прощай».~
@67938 = ~Уйти.~
@67939 = ~Выпивоха поворачивается и сердито на тебя смотрит: «Чё надо? Не видишь, мне не до тебя? Если захочется поболтать, я тебе скажу». Затем отворачивается, качая головой.~
@67940 = ~Уйти.~
@67941 = ~Эта личность поворачивается и нервно на тебя смотрит: «Пей тут сколько влезет, но говорить с тобой я не буду… так-то вот». Затем отворачивается и возвращается к выпивке.~
@67942 = ~Уйти.~
@67943 = ~Этой особе больше нечего тебе сказать.~
@67944 = ~Уйти.~
@67945 = ~Лицо повара от гнева наливается кровью: «Ты что, не слышал меня? Вон! Вон из моей кухни!»~
@67946 = ~Уйти.~
@67947 = ~«Какого… эта дверь была заперта, я *точно* помню! Убирайся, слышишь?»~
@67948 = ~Уйти.~
@67949 = ~«Наверно, это мой долбаный косяк, забыть запереть дверь… но тебе лучше немедленно покинуть мою комнату. Прошу, уходи», — тебя подталкивают к двери.~
@67950 = ~Уйти.~
@67951 = ~На тебя смотрят гневно и указывают на дверь, не желая даже тратить слова.~
@67952 = ~Уйти.~
@67953 = ~Эта безвкусно и скудно одетая женщина жеманно улыбается, спуская с плеча одну из бретелек лифчика, когда ты к ней приближаешься: «Двадцать монет, здоровяк, и я твоя…»~
@67954 = ~Она вздыхает и натягивает лифчик обратно: «Нет. Прости, но обойдёшься».~
@67955 = ~«Почему нет? — она порочно улыбается, поигрывая своими волосами. — Если это будет весело, может, они и присоединятся…» Она подмигивает и манит тебя к себе.~
@67956 = ~«Ах, он? — она оглядывается на крепкого стражника в дверях, стоящего спиной к комнате и оглядывающего вестибюль. — Мы с подругами просто суём ему чуток медяков, чтоб он нас охранял, вот и всё. А что? Он тебя нервирует? Не бойся, он не будет смотреть… иди сюда…» Она открывает тебе объятия.~
@67957 = ~Ты заканчиваешь своё грязное дело, одеваешься и собираешь вещи.

«М-м-м, а тебя непросто утомить, да? Ну, приходи повидать меня снова, если захочешь. Пока».~
@67958 = ~«Вообще-то у меня вопросы…»~
@67959 = ~«Звучит приемлемо… вот деньги».~
@67960 = ~«Хм-м… вместе с остальными здесь?»~
@67961 = ~«Нет, спасибо. Прощай».~
@67962 = ~«Хотя бы скажи, что тут делает стражник…»~
@67963 = ~«Ну… тогда как насчёт стать моей за двадцать монет?»~
@67964 = ~«Ладно… прощай».~
@67965 = ~«Ты права… почему нет? Вот деньги…»~
@67966 = ~«Вообще-то… у меня только пара вопросов…»~
@67967 = ~«Нет, спасибо. Прощай».~
@67968 = ~«Почему нет? Вот деньги…»~
@67969 = ~«Хм-м… вместе с остальными здесь?»~
@67970 = ~«Нет, спасибо. Прощай».~
@67971 = ~«Может быть. Пока».~
@67972 = ~Уйти.~
@67973 = ~Крепкий стражник Керста оглядывает тебя с головы до ног. «Тебе не со мной надо говорить, здоровяк… а с ними, — он жестом указывает на нескольких привлекательных — если не вызывающего вида — женщин в комнате позади. — И будь с ними ласков, парень… дамы не любят грубого обращения».~
@67974 = ~Он качает головой, через узкую прорезь его шлема ты видишь, как он закатывает глаза. Ни слова больше он не произносит.~
@67975 = ~«Вообще-то я хотел поговорить с *тобой*…»~
@67976 = ~«Тогда прощай».~
@67977 = ~Уйти.~
@67978 = ~Рабочий только на мгновение отрывается от дела. «Слушай… моя работа сама себя не сделает, пока я тут травлю байки с прохожими. Так что не мешай мне вкалывать, ладно?» — он возвращается к своей работе.~
@67979 = ~Уйти.~
@67980 = ~Эта особа поворачивается к тебе, недовольная, что прервали: «Я тебя *знаю*? Верно… вряд ли. Теперь оставь меня… прощай».~
@67981 = ~Уйти.~
@67982 = ~Эта личность останавливается и смотрит на тебя, когда ты пытаешься привлечь внимание: «Не прими за грубость, здоровяк, но я не говорю с тем, кого не знаю, — а знакомиться с тобой не хочу. Найди для своих вопросов кого другого, ладно? Прощай».~
@67983 = ~Уйти.~
@67984 = ~Не успеваешь ты что-либо сказать, как получаешь в ответ ухмылку и тебя обрывают: «Не хочу слышать ни слова. Найди себе другого придурка для допросов, усёк?»~
@67985 = ~Уйти.~
@67986 = ~Тебе нервно улыбаются, поднимая руки в защитном жесте: «Я не хочу неприятностей, кореш, а судя по твоему виду — ты и есть неприятность. Просто оставь меня… прошу».~
@67987 = ~Уйти.~
@67988 = ~Этой особе больше нечего тебе сказать.~
@67989 = ~Уйти.~
@67990 = ~Эта личность глядит на тебя, явно не в восторге, что прервали разговор, и поворачивается назад к своей компании.~
@67991 = ~Следует грубый ответ: «Ты мне мешаешь. Конечно нет!»~
@67992 = ~«Ну и ладно. Прощай».~
@67993 = ~«Я только хотел спросить…»~
@67994 = ~«Прощай тогда…»~
@67995 = ~Этот мужчина с большим недовольством отрывается от птичьего боя. «Что? Иди, задавай другим свои тупые вопросы!» Он возвращается к схватке.~
@67996 = ~«Отлично».~
@67997 = ~Житель Керста~
@67998 = ~Житель Керста~
@67999 = ~Сомневающийся скелет~
@68000 = ~::Шёпот::~
@68001 = ~::Поцелуй::~
@68002 = ~«Вон из моей кухни! Вон!»~
@68003 = ~«Ох ты ж! Я тебе покажу, как вламываться в *мою* комнату, сволочуга!»~
@68004 = ~«Ну, ты всё?»~
@68005 = ~«Почти… почти…»~
@68006 = ~*Клёкот*~
@68007 = ~*Ш-ш-ш-ш*~
@68008 = ~«Сделай его! Сделай!»~
@68009 = ~«Давай, парень! Так его!»~
@68010 = ~«Дешёвая шлюха!»~
@68011 = ~«Дерьмовый лишенец!»~
@68012 = ~«Проститутка неблагодарная!»~
@68013 = ~«Кастрированный хам!»~
@68014 = ~«Безмозглая потаскуха!»~
@68015 = ~«Трусливый кусок мужика!»~
@68016 = ~«У этой птицы убавится перьев, попомни мои слова».~
@68017 = ~«Он боец, боец…»~
@68018 = ~«Ты понимаешь, о чём я?»~
@68019 = ~«Кто-то задолжает мне сегодня кучу медяков!»~
@68020 = ~«Не скажи, не скажи».~
@68021 = ~«Ну и живучий же!»~
@68022 = ~«Пока моя птица клюнула три раза».~
@68023 = ~«Тогда растаскиваем их».~
@68024 = ~«Ладно, парень… иди сделай его!»~
@68025 = ~«Я поставил на тебя много денег, птица!»~
@68026 = ~Запах пролитого пива и отчаяния, идущий от этого места, говорит о том, что это таверна…~
@68027 = ~Подавляющий запах медленно гниющих съестных припасов говорит о том, что эта башня — некий склад продовольствия.~
@68028 = ~Это сторожевая башня. Как ни странно, стражи в ней не видно.~
@68029 = ~Этот длинный деревянный бар отполирован до насыщенного блеска красного дерева.~
@68030 = ~Это гигантское чудовище явно выставлено в качестве шутки, которую никто не оценил. Оно пыльное, и всем на него плевать.~
@68031 = ~Эта картина на бархате кажется плохо исполненной и смазанной. Если внимательно её разглядеть, можно предположить, что на ней женщина.~
@68032 = ~В книге посетителей гостиницы большое количество имён. Многие из них выглядят написанными одной рукой — как будто кто-то пытался скрыть, что приходит сюда слишком часто.~
@68033 = ~Очевидно, сегодня на ужин тушёный кролик.~
@68034 = ~Я наконец-то закончил этот долбаный Построитель Снов. Получил я за это… перо. Предполагается, что это ключ, открывающий дверь в грёзы. Надеюсь, оно того стоило.~
@68035 = ~Я принёс Зандеру подушку из гроба от Хэмриса. Интересно, что ещё мне придётся принести?~
@68036 = ~После того, как я достал птичью клетку с лезвиями, Нил Зандер отправил меня за подушкой из гроба, чтобы имитировать сон мертвеца.~
@68037 = ~Я принёс флакон со своей плотью и кровью для Зандера и его… моего… Построителя Снов. Теперь он требует птичью клетку с лезвиями.~
@68038 = ~Принести флакон с кожей и кровью.~
@68039 = ~Нил Зандер попросил меня принести ему флакон с моей кожей и кровью для завершения Построителя Снов.~
@68040 = ~Я принёс Зандеру флакон. Он послал меня искать птичью клетку с лезвиями.~
@68041 = ~Достать птичью клетку с лезвиями.~
@68042 = ~Я принёс Зандеру флакон. Он послал меня искать птичью клетку с лезвиями.~
@68043 = ~Найти ночную ведьму Рейвел Клубок-Загадок.~
@68044 = ~Я вернулся клеткой для птиц. Теперь Нил Зандер просит подушку из гроба.~
@68045 = ~Принести Зандеру подушку для гроба.~
@68046 = ~~
@68047 = ~Я принёс Зандеру подушку. Это моё последнее задание для завершения Построителя Снов… кроме получения ключа.~
@68048 = ~Получить ключ.~
@68049 = ~Чтобы получить ключ, мне всего лишь нужно попросить его у Нила Зандера.~
@68050 = ~Я заслужил ключ к снам.~
@68051 = ~«Секира Небесного огня»~
@68052 = ~Рюкзак уже полон.~
@68053 = ~Друзилла, стоящая у входа в баре «Горящий труп», рассказала мне о горящем человеке. Его имя Игнус, и он, по-видимому, был лучшим магом из всех, рождавшихся в Улье за последние века. Недруги открыли через тело Игнуса канал на стихийный план Огня, и сейчас он сохраняет себя в живых путём полного сосредоточения. Крутой мужик, правда…~
@68054 = ~«Аукционер Гильтспур хотел, чтобы ты повесил этот листок».~
@68055 = ~«Ничего. Прощай».~
@68056 = ~«Ничего. Прощай».~
@68057 = ~«Прекрасно… тогда я поищу по району что-нибудь подходящее».~
@68058 = ~Довольно эксцентричный маг по имени Квелл отказывается со мной говорить на том основании, что я не выразил ему должного уважения, не вручив подарок. Он упомянул конфеты или шоколад, но не обычного сорта… это должна быть «экзотика». Я сказал ему, что поищу в районе Клерков продавца чего-нибудь подобного.~
@68059 = ~«*Знай*, я не научу этому, но *знай*, я могу служить проводником. Не *знаю*, как люди могут стать сведущими в „Искусстве“, но когда ты изучишь Искусство, вернись и спроси ещё раз».~
@68060 = ~«Тогда спрошу ещё раз, когда стану магом. Между тем, у меня другие вопросы…»~
@68061 = ~«Тогда поищу сперва учителя магии. Пойдём».~
@68062 = ~«Можешь научить меня Искусству, Дак'кон?»~
@68063 = ~«Мне нужно идти. Прощай».~
@68064 = ~«Да, директор. Не отделяй никого из своих компаньонов во время пребывания в лабиринте. Если лабиринт подвергнется перезагрузке или выбору нового уровня сложности — любой оставшийся в нём будет убит».~
@68065 = ~«Ясно… не буду никого выгонять в лабиринте. Что-нибудь ещё?»~
@68066 = ~«Да, директор. Не бросай предметы и снаряжение в лабиринте. Если лабиринт подвергнется перезагрузке или выбору нового уровня сложности — любой оставшийся в нём предмет будет уничтожен».~
@68067 = ~«Ясно… не буду бросать там ничего важного. Что-нибудь ещё?»~
@68068 = ~Он на минуту задумывается. «Нет, директор».~
@68069 = ~«Ясно. У меня ещё вопрос…»~
@68070 = ~«Хорошо, прощай».~
@68071 = ~Находясь в лабиринте модронов, я не могу изменять состав группы. Если лабиринт будет перезагружен или изменится уровень сложности, любой оставшийся там погибнет.~
@68072 = ~Находясь в лабиринте модронов, не следует бросать ничего важного. Если лабиринт будет перезагружен или изменится уровень сложности, всё оставленное там будет уничтожено.~
@68073 = ~Этот предмет делает создание иммунным к магии смерти.~
@68074 = ~Пятнистый Барс попросил меня спасти его дочь от работорговцев. Он сказал мне поговорить в таверне с бывшим офицером Гармониума Маркезом.~
@68075 = ~«Как я уже сказал, у меня есть вопросы…»~
@68076 = ~«Неужели так трудно схватить её?»~
@68077 = ~«Напрягите задницы, собаки!»~
@68078 = ~Маркез~
@68079 = ~Маркез~
@68080 = ~Чек'ка Плут~
@68081 = ~Чек'ка Плут~
@68082 = ~«Я просто проходил мимо. Прощай».~
@68083 = ~«Мне жаль, но мой вопрос?..»~
@68084 = ~~
@68085 = ~~
@68086 = ~Скелет скрещивает руки на груди и не произносит ни единого слова.~
@68087 = ~Уйти.~
@68088 = ~~
@68089 = ~«Нет. Не будь ты здесь пленником, ожидающим смерти, ответ мог быть другим».~
@68090 = ~«А *почему* я здесь пленник?»~
@68091 = ~«У меня другие вопросы…»~
@68092 = ~«Это всё, что я хотел узнать. Прощай».~
@68093 = ~«Могу я здесь отдохнуть?»~
@68094 = ~«Мне нужно лечение, не поможешь?»~
@68095 = ~«Можем мы здесь отдохнуть?»~
@68096 = ~«Нам нужно лечение, не поможешь?»~
@68097 = ~«Помоги мне! Прошу, убей их, пока они не угнали меня в рабство!»~
@68098 = ~«Сделаю что смогу…»~
@68099 = ~~
@68100 = ~Уйти.~
@68101 = ~Уйти.~
@68102 = ~Уйти.~
@68103 = ~Уйти.~
@68104 = ~«У меня есть несколько вопросов…»~
@68105 = ~«Неважно, прощай».~
@68106 = ~Бедай-Лин сказала мне найти Своевольного Пенна в печатной мастерской и передать ему слова: «Город должен гореть».~
@68107 = ~Сомневающийся скелет~
@68108 = ~Озадаченный скелет~
@68109 = ~Озадаченный скелет~
@68110 = ~Скелет-загадка~
@68111 = ~Скелет-загадка~
@68112 = ~Безымянная зомби~
@68113 = ~Безымянная зомби~
@68114 = ~«Хорошо, Любовь моя… если ты намерен идти дальше, то должен знать вот что: за входом в Крепость есть большой зал с бесчисленными тенями. Ты должен двигаться быстро и не давать им собираться вокруг тебя, иначе тебя наверняка убьют!»~
@68115 = ~Упырь с ножом~
@68116 = ~Упырь с ножом~
@68117 = ~Дейонарра предупредила меня, что после входа в Крепость есть большой зал с тенями. Она сказала, что в зале есть огромные часы, с помощью которых я когда-то бежал оттуда. Я должен буду найти их и осмотреть, если увижу.~
@68118 = ~Здесь в скалах есть расселина. Похоже, ты можешь в неё протиснуться — с трудом — но непохоже, что она куда-то ведёт. Ты замечаешь, что земля тут усеяна осколками обсидиана, словно случайный огненный шар из числа проносящихся в воздухе долины попал в какой-то огромный валун и взрывом раздробил его на части.~
@68119 = ~Поднять осколок обсидиана, засунуть в рот и укусить так, чтобы он порезал язык…~
@68120 = ~Уже собираясь воспользоваться порталом, ты вдруг понимаешь, что до сих пор не имеешь представления о том, где находится портал в Крепость Сожалений, а также где и чем может быть портальный ключ. Пока ты не получишь этой информации от Колонны Черепов, нельзя покидать Баатор.~
@68121 = ~Уйти.~
@68122 = ~Уйти.~
@68123 = ~~
@68124 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@68125 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@68126 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@68127 = ~«Нет, я этого не сделаю после твоего чудного *подарка*».~
@68128 = ~Ксантия довольно смеётся: «Как мило…» Затем отворачивается и больше не обращает на тебя внимания.~
@68129 = ~«Прощай».~
@68130 = ~Это невидимый предмет, делающий создание иммунным к парализации.~
@68131 = ~«ВОЗНЕСЕНИЕ»
Урон: 3-10 рубящий
Зачаровано: +2
Особенности:
   Рубящий урон: +2
   Харизма: +1
   Класс защиты: +1
THAC0: +2
Фактор скорости: 4
Вес: 4
Навык: топор
Доступно: воинам
Доступно: Боготам

«Вознесение» — один из прекраснейших образцов оружия, созданного в Великой Кузнице, доме Верующих в Источник. Это оружие — одно из трёх, названных «Триада Испытаний». Комплект также включает в себя молот «Причина» и кинжал «Просвещение». На обухе топора выгравирован символ фракции, а лезвия столь остры, что ими можно разрезать волос вдоль. Тебе предоставлена честь стать первым владельцем оружия.~
@68132 = ~«Вознесение»~
@68133 = ~«ПРОСВЕЩЕНИЕ»
Урон: 2-7 колющий
Зачаровано: +2
Особенности:
   Колющий урон: +2
   Харизма: +1
   Класс защиты: +1
THAC0: +2
Фактор скорости: 1
Вес: 1
Навык: клинок
Недоступно: священникам
Доступно: Боготам

Второе оружие из Боготской «Триады Испытаний» (в комплект также входят «Вознесение» и «Причина»). Этот кинжал тонкий, отлично сбалансированный и лёгкий как пёрышко. Вдоль лезвия выгравирован символ Боготов, и все оружие кажется дрожащим, словно от нетерпения. До тебя никто не владел этим оружием.~
@68134 = ~«Просвещение»~
@68135 = ~«ПРИЧИНА»
Урон: 5-12 дробящий
Зачаровано: +2
Особенности:
   Дробящий урон: +2
   Харизма: +1
   Класс защиты: +1
THAC0: +2
Фактор скорости: 6
Вес: 5
Навык: молот
Доступно: воинам
Доступно: Боготам

Этот громадный молот — третье оружие в Боготской «Триаде Испытаний»; остальные два — это топор «Вознесение» и кинжал «Просвещение». Его боёк покрыт мистическими рунами и украшен символом Боготов. Молот гудит в твоих руках. Станешь ли ты первым владельцем оружия?~
@68136 = ~«Причина»~
@68137 = ~Я нашёл неуловимую ведьму Рейвел Клубок-Загадок.~
@68138 = ~Лотар предложил в качестве следующего шага отправиться в Фестхолл, где кто-нибудь наверняка сможет больше рассказать мне о ведьме Рейвел Клубок-Загадок, которая, по утверждению Лотара, украла у меня мою смертность.~
@68139 = ~«Так и сделаю. До свидания».~
@68140 = ~«Хорошо. Я вернусь».~
@68141 = ~Оставить ворота в покое.~
@68142 = ~Когда ты пропеваешь первый слог, ворота скрипят и стонут. После второго металлические шипы вращаются и раздвигаются, а на третьем ворота распахиваются.~
@68143 = ~«Вот и всё».~
@68144 = ~Он наклоняется вперёд с видом заговорщика. «У меня тут есть секретный вход под землю, тайное место, о котором почти никто не знает. Это путь в подземелье города… — он прерывается. — Но я никогда не использовал его. Чувствую, отправься я вниз, вряд ли смог бы вернуться. Путь вниз скользкий, и камни могут осыпаться за моей спиной. Когда буду готов к смерти, я пойду туда и позволю чудовищам пировать на своих костях».~
@68145 = ~«У меня ещё пара вопросов…»~
@68146 = ~«Ясно. Прощай».~
@68147 = ~Смотритель свалки рассказал мне о секретном входе в подземелье Керста. Он также сказал, что я, скорее всего, не смогу вернуться обратно тем же путём. Стоит иметь это в виду.~
@68148 = ~«Ничего. Прощай».~
@68149 = ~«Прощай».~
@68150 = ~«Нет. Прощай».~
@68151 = ~«Ясно. Прощай».~
@68152 = ~«Прощай».~
@68153 = ~«Ясно. Прощай».~
@68154 = ~«Ничего. Прощай».~
@68155 = ~ТОГДА ПРИГОТОВЬСЯ УМЕРЕТЬ СНОВА, ПОЛОМАННЫЙ.~
@68156 = ~«Я вернусь за тобой, даже если умру. *Клянусь.* Я снова выслежу тебя, сколько бы это ни заняло времени».~
@68157 = ~«Я вернусь за тобой, даже если умру. *Клянусь.* Я снова выслежу тебя, сколько бы это ни заняло времени».~
@68158 = ~«Я вернусь за тобой, даже если умру. *Клянусь.* Я снова выслежу тебя, сколько бы это ни заняло времени».~
@68159 = ~Обратно в подземелье Керста~
@68160 = ~Внешнее кольцо~
@68161 = ~Среднее кольцо~
@68162 = ~Внутреннее кольцо~
@68163 = ~Святилище~
@68164 = ~Лобное место Триаса~
@68165 = ~«Хорошо… Я подожду здесь. Если ты вернешься».~
@68166 = ~«Хорошо… Я подожду здесь. Если ты вернешься».~
@68167 = ~«Хорошо… Я подожду здесь. Если ты вернешься».~
@68168 = ~«Хорошо… Я подожду здесь. Если ты вернешься».~
@68169 = ~«Хорошо… Я подожду здесь. Если ты вернешься».~
@68170 = ~«Хорошо… Я подожду здесь. Если ты вернешься».~
@68171 = ~Когда ты протягиваешь руку, Морте внезапно начинает говорить: «Эй, эй, эй! Постой, шеф. Э… я должен сказать тебе пару слов».~ [MRT242]
@68172 = ~«Э-э, ага… поумирай с моё — научишься притворяться как следует. Я тут вроде как подслушал весь ваш разговор. Используй свою приобретённую силу на ком-нибудь ещё — мне это не нужно».~
@68173 = ~«Ну, *да*, шеф. Непохоже, чтобы ты умирал. Я хочу сказать, если бы тебе не повезло, то нужен же кто-то, чтобы помнить за тебя. Плюс ты же знаешь, как я бесполезен в драке — ну, разве что могу дразнить магов или типа того…»~
@68174 = ~Ты опять прибегаешь к своей силе…~
@68175 = ~Воскресить Анну.~
@68176 = ~«Морте?!.. Ты не мёртв!»~
@68177 = ~«Так ты намеревался *лежать* здесь, пока мне не надерут задницу?»~
@68178 = ~«Тогда, может быть, это мне от тебя и нужно. Поговорим об этом *позже*, Морте…»~
@68179 = ~Воскресить Дак'кона.~
@68180 = ~Воскресить Падшую Грейс.~
@68181 = ~Воскресить Нордома.~
@68182 = ~Воскресить Игнуса.~
@68183 = ~Воскресить Вейлора.~
@68184 = ~Ты используешь свою силу, стремительно поднимается поток воздуха, и Анна оживает: она медленно поднимает голову, потом трясёт ею, ошеломлённая.~
@68185 = ~«Я нашёл свою смертность, Анна, но, похоже, я ей не слишком нравлюсь. Мне нужна твоя помощь».~
@68186 = ~В глазах Анны вспыхивает решимость, затем она кивает: «Я готова».~ [ANA205A]
@68187 = ~«Тогда вперёд…»~
@68188 = ~«…не освободил Коаксметала из осадной башни».~
@68189 = ~«Тогда, может быть, это мне от тебя и нужно. Поговорим об этом *позже*, Морте…»~
@68190 = ~«Тогда, может быть, это мне от тебя и нужно. Поговорим об этом *позже*, Морте…»~
@68191 = ~«Тогда, может быть, это мне от тебя и нужно. Поговорим об этом *позже*, Морте…»~
@68192 = ~«Тогда, может быть, это мне от тебя и нужно. Поговорим об этом *позже*, Морте…»~
@68193 = ~«Тогда, может быть, это мне от тебя и нужно. Поговорим об этом *позже*, Морте…»~
@68194 = ~«Тогда, может быть, это мне от тебя и нужно. Поговорим об этом *позже*, Морте…»~
@68195 = ~Когда твоя сила касается Дак'кона, он делает судорожный вдох, потом с трудом открывает глаза. Похоже, он едва цепляется за жизнь.~
@68196 = ~«Дак'кон, однажды ты сделал Пророчество о Двуединой Смерти. Время пришло».~
@68197 = ~«Дак'кон, ты нужен мне сейчас. Поможешь мне?»~
@68198 = ~Дак'кон выдыхает, затем берёт себя в руки, его клинок *заостряется* у тебя на глазах: «Этот клинок принадлежит тебе».~ [DAK025]
@68199 = ~«Отлично».~
@68200 = ~«Отлично».~
@68201 = ~«Отлично».~
@68202 = ~«Отлично».~
@68203 = ~«Отлично».~
@68204 = ~«Отлично».~
@68205 = ~«Тогда вперёд…»~
@68206 = ~«Тогда вперёд…»~
@68207 = ~«Тогда вперёд…»~
@68208 = ~«Тогда вперёд…»~
@68209 = ~Когда твоя сила касается Падшей Грейс, она неуверенно поднимается на ноги… даже будучи дезориентированной, она как-то ухитряется сохранять спокойствие.~
@68210 = ~«Падшая Грейс, мы в Крепости Сожалений, и я нашёл своего убийцу — это моя собственная смертность, которая начала жить сама по себе. Мне действительно сейчас нужна твоя помощь».~
@68211 = ~Кажется, её сила возвращается, пока она слушает тебя. Грейс медленно кивает: «Боюсь, раз уж мы вошли, это место нас так просто не выпустит».~ [FFG070]
@68212 = ~«Посмотрим…»~
@68213 = ~«Посмотрим…»~
@68214 = ~«Посмотрим…»~
@68215 = ~«Посмотрим…»~
@68216 = ~Игнус шевелится, воздух над ним слегка мерцает, почти достаточно для возвращения его к жизни.~
@68217 = ~Вспышка пламени и жара, и Игнус воспаряет в воздух, который *прогибается* под действием потоков тепла, исходящих от его тела. Он поворачивается к тебе, его глаза — как порталы в ад: «*Я твой… пока с-с-смерть не придёт к нам обоим*».~ [IGN248]
@68218 = ~«Вставай, Игнус. Я нуждаюсь в тебе».~
@68219 = ~«Может быть, это случится сегодня, Игнус…»~
@68220 = ~«Может быть, это случится сегодня, Игнус…»~
@68221 = ~«Может быть, это случится сегодня, Игнус…»~
@68222 = ~Легчайшее касание твоей силы словно бы пропускает заряд через броню Вейлора: она поднимается в воздух и снова обращается в подобие человека. Когда доспех собирается полностью, из-под шлема зажигаются два огня.~
@68223 = ~«Вейлор?»~
@68224 = ~~
@68225 = ~*Я ПРОБУДИЛСЯ.*~ [VHA002]
@68226 = ~«Вейлор, слушай меня: свершилась великая несправедливость. Когда я умираю, кто-то другой на планах умирает вместо меня. Это случалось сотни, тысячи, может быть, сотни тысяч раз. Мультивселенная умирает, чтобы я мог жить».~
@68227 = ~Когда ты произносишь эти слова, Вейлор как будто *растёт*, становится больше — скорее за счёт силы, чем из-за доспехов.~
@68228 = ~«Я сознаю своё преступление и я пытаюсь предотвратить его повторение, но единственное создание, способное положить конец несправедливости, *отказывается* по собственным эгоистическим мотивам».~
@68229 = ~*ОТНЫНЕ ТЫ СРЕДИ ОСУЖДЁННЫХ. КАК И ТОТ ДРУГОЙ. Я УВИЖУ ДУШИ ВАС ОБОИХ ПРОНЗЁННЫМИ КЛИНКОМ СПРАВЕДЛИВОСТИ.*~
@68230 = ~«Прекрасно, Вейлор… но я бы попросил тебя сначала обратить внимание на другого».~
@68231 = ~*БУДЬ ПО-ТВОЕМУ. ПОТОМ Я ВЕРНУСЬ ЗА ТОБОЙ.*~
@68232 = ~«Договорились, Вейлор».~
@68233 = ~«Договорились, Вейлор».~
@68234 = ~Ты используешь свою силу, вкладывая душу в тело Нордома, медленно, пока она не встаёт на место. Дрожь пробегает по его контуру, и Нордом вскакивает на ноги.~
@68235 = ~«Нордом, мне *действительно* нужна твоя помощь прямо сейчас… я нашёл своего убийцу — это моя смертность».~
@68236 = ~«Жду приказа».~ [NOR063]
@68237 = ~«Приготовься. Скоро у твоих арбалетов появится цель…»~
@68238 = ~«Приготовься. Скоро у твоих арбалетов появится цель…»~
@68239 = ~«Тогда, может быть, это мне от тебя и нужно. Поговорим об этом *позже*, Морте…»~
@68240 = ~«Отлично».~
@68241 = ~«Тогда вперёд…»~
@68242 = ~«Посмотрим…»~
@68243 = ~«Может быть, это случится сегодня, Игнус…»~
@68244 = ~«Замечательно, Вейлор».~
@68245 = ~По разносящейся вони протухшего пива ты определяешь пивную.~
@68246 = ~За этой оградой расположилось необычное собрание железных конструкций и фонтанов. Точно не скажешь, но ты полагаешь, что это может быть городским парком.~
@68247 = ~Это приспособление выглядит так, будто им часто пользовались.~
@68248 = ~На эту будку прилеплено другое объявление:
«ПО ПРИКАЗУ БЮРГЕРА ЛЮБОЕ ДВИЖЕНИЕ ЧЕРЕЗ ВОРОТА ВРЕМЕННО ОСТАНОВЛЕНО».~
@68249 = ~Врата в Карцери украшены различными черепами… в их глазницах тихо стонет ветер.~
@68250 = ~Ты не уверен, что эта тяжелая железная плита когда-либо двигалась — но сейчас она точно никуда не собирается.~
@68251 = ~«Мне пора идти. Прощай».~
@68252 = ~«Мне пора идти. Прощай».~
@68253 = ~После прикосновения к кристаллу я очнулся в закрытой комнате, окружённый собственными инкарнациями. Одна из них заявила мне, что только *один* сможет покинуть это место. Он сказал, что мы должны либо соединиться — при этом остальные преклонят свою волю перед одним — либо один из нас должен будет убить троих других. Придётся мне прибегнуть к своим талантам и разрешить эту головоломку… может, что-то даст разговор с остальными.~
@68254 = ~«Наверное, ничего. Счастливо».~
@68255 = ~Дак'кон качает головой: «*Знай*, что близко враги. Сейчас не время».~
@68256 = ~«Ладно».~
@68257 = ~«Давай обсудим твоё учение».~
@68258 = ~Анна хмурится и мотает головой: «Не-а, не щас… тут враги рядом, сто пудов!»~
@68259 = ~«Тогда забудь…»~
@68260 = ~«Анна, можешь поучить меня воровским навыкам?»~
@68261 = ~«Анна, можешь поучить меня воровским навыкам?»~
@68262 = ~«Мне пора идти. Прощай».~
@68263 = ~«Вейлор, мне нужна твоя помощь — моя смертность собирается нас убить».~
@68264 = ~*ТОГДА ТВОЯ СМЕРТНОСТЬ УМРЁТ.*~
@68265 = ~«Хорошо, Вейлор…»~
@68266 = ~«Хорошо, Вейлор…»~
@68267 = ~«Хорошо, Вейлор…»~
@68268 = ~«Дейонарра сказала, что я могу вернуть лишь тех, кто умер рядом. Но это то, что пробудила во мне она. Ты утверждаешь, что это лишь часть моей власти над жизнью и смертью?»~
@68269 = ~«Если у *тебя*, по твоим словам, есть сила, то она есть и у меня. Даже если я не был там в момент смерти».~
@68270 = ~Едва ты произносишь эти слова, глаза Дак'кона закрываются — на мгновение ты думаешь, что он умирает, — потом снова открываются и меняют цвет с угольно-чёрного, какими всегда были на твоей памяти, на металлический, как у его клинка. И ты чувствуешь, что Дак'кон стал каким-то *другим* — намного более могущественным.~
@68271 = ~~
@68272 = ~«Я разобрался с гехрелетом, он мёртв. Так теперь мы партнёры?»~
@68273 = ~«Мне пора идти. Прощай».~
@68274 = ~Сиабха сделала мне последнее предложение в их с Ан'изиусом игре в предателей.~
@68275 = ~~
@68276 = ~Я сообщил капитану стражи Керста, что Сиабха замышляет убийство Ан'изиуса. Он был доволен моим доносом и пообещал её арестовать. Надеюсь, я поступил правильно…~
@68277 = ~Я сообщил капитану стражи Керста, что Ан'изиус замышляет убийство Сиабхи. Он был доволен моим доносом и пообещал арестовать гитиянки. Надеюсь, я поступил правильно…~
@68278 = ~«И тебе всего хорошего, Сиабха».~
@68279 = ~~
@68280 = ~~
@68281 = ~~
@68282 = ~~
@68283 = ~~
@68284 = ~~
@68285 = ~~
@68286 = ~~
@68287 = ~«Я оставил его томиться в пентаграмме. Можешь освободить его сама. Я перепризвал его… остальное в твоих руках».~
@68288 = ~Мне сказали, что я не смогу научиться большему в обращении с оружием, пока не сосредоточусь на пути воина. Более усердное изучение воинских искусств, без отвлечения на магию и воровство, поможет мне гораздо дальше продвинуться в умении сражаться.~
@68289 = ~«Нет. Прощай».~
@68290 = ~«Нет, спасибо. Прощай».~
@68291 = ~«Спасибо, ничего. Прощай».~
@68292 = ~«Забудь. Прощай».~
@68293 = ~«Ещё нет».~
@68294 = ~[нет текста]~
@68295 = ~Этот туннель уходит прямо под поверхность города. Ты можешь и не вернуться, если сунешься туда. Ты думаешь, что лучше бы сначала исчерпать все другие способы.~
@68296 = ~«Хорошо. Я готов снова стать смертным».~
@68297 = ~«Хорошо. Я готов снова стать смертным».~
@68298 = ~«Хорошо. Я готов снова стать смертным».~
@68299 = ~«Хорошо. Я готов снова стать смертным».~
@68300 = ~«Хорошо. Я готов снова стать смертным».~
@68301 = ~«Хорошо. Я готов снова стать смертным».~
@68302 = ~«Хорошо. Я готов снова стать смертным».~
@68303 = ~«Хорошо. Я готов снова стать смертным».~
@68304 = ~«Хорошо. Я готов снова стать смертным».~
@68305 = ~«Хорошо. Я готов снова стать смертным».~
@68306 = ~«Хорошо. Я готов снова стать смертным».~
@68307 = ~«Хорошо. Я готов снова стать смертным».~
@68308 = ~«Хорошо. Я готов снова стать смертным».~
@68309 = ~«Хорошо. Я готов снова стать смертным».~
@68310 = ~Едва ты обращаешься к своей силе, как Морте внезапно взмывает в воздух: «Э… погоди, шеф. Тебе не нужно возрождать меня, я просто… гм… лежал себе тут, слушая вас двоих».~
@68311 = ~ТЫ ПРИТВОРИЛСЯ МЁРТВЫМ.~
@68312 = ~«Ну, да. Хочу сказать, я *уже* мёртвый и… эй, шеф, а что случилось с твоим *голосом*?»~
@68313 = ~Я… ТЕПЕРЬ НЕЧТО ИНОЕ. ОСТАЁТСЯ СОВСЕМ НЕДОЛГО, И СКОРО СУДЬБА И ВРЕМЯ НАСТИГНУТ МЕНЯ. Я ВЕРНУ ТЕБЯ В СИГИЛ, МОРТЕ, ЕСЛИ ХОЧЕШЬ.~
@68314 = ~«Чт?.. Вернёшь меня? А как насчёт *тебя*? Да ладно, шеф. Может, я и *трус*, но здесь я тебя не оставлю».~
@68315 = ~МНОГО ПРЕСТУПЛЕНИЙ БЫЛО СВЕРШЕНО, КОГДА Я РАЗДЕЛИЛСЯ СО СВОЕЙ СМЕРТНОСТЬЮ. ЗА ПРЕСТУПЛЕНИЯ ДОЛЖНА БЫТЬ… РАСПЛАТА. ТЫ НЕ МОЖЕШЬ ОТПРАВИТЬСЯ ТУДА, ГДЕ Я СКОРО ОКАЖУСЬ.~
@68316 = ~«Я *могу* отправиться с тобой куда угодно, шеф, если ты не против… в смысле, мы ведь бывали и в куда худших передря…»~
@68317 = ~НЕ В ЭТОТ РАЗ. ВОЗМОЖНО, ОДНАЖДЫ МЫ СНОВА ВСТРЕТИМСЯ, НА ДРУГОМ ПЛАНЕ. НО НЕ СЕЙЧАС.~
@68318 = ~Морте внимательно смотрит на тебя, а затем вздыхает: «Не то чтобы я до слёз растрогался, но мне… э-э… было приятно с тобой путешествовать, шеф».~ [MRT109]
@68319 = ~ПРОЩАЙ, МОРТЕ.~
@68320 = ~ПРОЩАЙ, МОРТЕ.~
@68321 = ~ПРОЩАЙ, МОРТЕ.~
@68322 = ~ПРОЩАЙ, МОРТЕ.~
@68323 = ~ПРОЩАЙ, МОРТЕ.~
@68324 = ~ПРОЩАЙ, МОРТЕ.~
@68325 = ~ПРОЩАЙ, МОРТЕ.~
@68326 = ~АННА. ТЫ В ПОРЯДКЕ?~
@68327 = ~При звуках твоего голоса глаза Анны расширяются: «Чт… что с тобой *случилось*? Твой голос… он как эхо, типа того».~
@68328 = ~Я ИЗМЕНИЛСЯ. ТЕПЕРЬ Я НЕЧТО ДРУГОЕ И НЕ МОГУ СЛИШКОМ ДОЛГО ЗДЕСЬ ОСТАВАТЬСЯ. Я ВЕРНУ ТЕБЯ В СИГИЛ, ЕСЛИ ХОЧЕШЬ.~
@68329 = ~«Чт?.. — Анна застывает с раскрытым ртом. — Ку… куда *ты* собрался?»~
@68330 = ~МНОЖЕСТВО ПРЕСТУПЛЕНИЙ СВЕРШЕНО ЗА ВРЕМЯ МОЕГО РАЗДЕЛЕНИЯ СО СМЕРТНОСТЬЮ. ЗА ПРЕСТУПЛЕНИЯМИ СЛЕДУЕТ… РАСПЛАТА. НА НИЖНИХ ПЛАНАХ ЕСТЬ МЕСТА ДЛЯ ТАКИХ, КАК Я. ЭТО… СВОЕГО РОДА НАКАЗАНИЕ.~
@68331 = ~«Но я… я *не хочу*, чтоб ты уходил».~
@68332 = ~Я НЕ ЗАБУДУ, ЧЕМ ТЕБЕ ПРИШЛОСЬ ПОЖЕРТВОВАТЬ РАДИ МЕНЯ, АННА.~
@68333 = ~Анна кивает. Кажется, она хочет сказать что-то ещё, но молчит. И давнее, невысказанное признание остаётся в её сердце.~
@68334 = ~МНЕ НЕ НУЖНЫ СЛОВА, ЧТОБЫ ПОНЯТЬ ТВОЁ СЕРДЦЕ, АННА. ПРОЩАЙ.~
@68335 = ~МНЕ НЕ НУЖНЫ СЛОВА, ЧТОБЫ ПОНЯТЬ ТВОЁ СЕРДЦЕ, АННА. ПРОЩАЙ.~
@68336 = ~МНЕ НЕ НУЖНЫ СЛОВА, ЧТОБЫ ПОНЯТЬ ТВОЁ СЕРДЦЕ, АННА. ПРОЩАЙ.~
@68337 = ~МНЕ НЕ НУЖНЫ СЛОВА, ЧТОБЫ ПОНЯТЬ ТВОЁ СЕРДЦЕ, АННА. ПРОЩАЙ.~
@68338 = ~МНЕ НЕ НУЖНЫ СЛОВА, ЧТОБЫ ПОНЯТЬ ТВОЁ СЕРДЦЕ, АННА. ПРОЩАЙ.~
@68339 = ~МНЕ НЕ НУЖНЫ СЛОВА, ЧТОБЫ ПОНЯТЬ ТВОЁ СЕРДЦЕ, АННА. ПРОЩАЙ.~
@68340 = ~ПРОБУДИСЬ, ДАК'КОН ИЗ ШРА'КТ'ЛОРА, ПОСЛЕДНИЙ НОСИТЕЛЬ КЛИНКА *КАРАЧ*.~
@68341 = ~Услышав твои слова, Дак'кон медленно кивает: «Твой голос… ты наконец *познал* себя?»~
@68342 = ~ДА. ЭТО БЫЛО… ТЯЖЕЛО И СТОИЛО МНОЖЕСТВА ЖИЗНЕЙ. МНОГИЕ ПОСТРАДАЛИ, ЧТОБЫ Я СНОВА СМОГ ПОЗНАТЬ СЕБЯ.~
@68343 = ~«*Познание* себя — тяжёлый путь».~
@68344 = ~ПОЗНАВ СЕБЯ, Я ПОЗНАЛ, КУДА МНЕ СКОРО ПРЕДСТОИТ ПОПАСТЬ. ПОКА МЫ ГОВОРИМ, ВРЕМЯ И СУДЬБА НАСТИГАЮТ МЕНЯ, И Я НЕ МОГУ ОСТАВАТЬСЯ ЗДЕСЬ ДОЛЬШЕ. Я ВЕРНУ ТЕБЯ В СИГИЛ, ДАК'КОН, ЕСЛИ ХОЧЕШЬ.~
@68345 = ~Дак'кон на мгновение умолкает; когда он начинает говорить снова, его голос становится более резким, будто разрубает какую-то связь: «*Знай*, однажды я задолжал тебе. *Знай*, что ты спас мою жизнь, и *знай*, что я следовал за тобой, чтобы оплатить этот долг».~
@68346 = ~«Я заплатил своей жизнью за твою. Долг оплачен».~ [DAK030]
@68347 = ~ХОРОШО, ДАК'КОН. НАША СМЕРТЬ БЫЛА ДВУЕДИНОЙ. ТЫ ПОКИНЕШЬ ЭТО МЕСТО СВОБОДНЫМ.~
@68348 = ~ХОРОШО, ДАК'КОН. НАША СМЕРТЬ БЫЛА ДВУЕДИНОЙ. ТЫ ПОКИНЕШЬ ЭТО МЕСТО СВОБОДНЫМ.~
@68349 = ~ХОРОШО, ДАК'КОН. НАША СМЕРТЬ БЫЛА ДВУЕДИНОЙ. ТЫ ПОКИНЕШЬ ЭТО МЕСТО СВОБОДНЫМ.~
@68350 = ~ХОРОШО, ДАК'КОН. НАША СМЕРТЬ БЫЛА ДВУЕДИНОЙ. ТЫ ПОКИНЕШЬ ЭТО МЕСТО СВОБОДНЫМ.~
@68351 = ~ХОРОШО, ДАК'КОН. НАША СМЕРТЬ БЫЛА ДВУЕДИНОЙ. ТЫ ПОКИНЕШЬ ЭТО МЕСТО СВОБОДНЫМ.~
@68352 = ~~
@68353 = ~~
@68354 = ~ПАДШАЯ ГРЕЙС.~
@68355 = ~Падшая Грейс поднимает взор и на какое-то время задерживает его, глядя тебе в глаза, затем легко улыбается, но в её улыбке больше печали, чем чего-либо другого: «Твой голос… ты наконец-то нашёл себя?»~
@68356 = ~ДА. ЦЕНА БЫЛА… ВЫСОКА. ЦЕНОЙ БЫЛО МНОЖЕСТВО ЖИЗНЕЙ, МОИХ И ЧУЖИХ.~
@68357 = ~«Да, цену подобного редко измеришь в медяках, — Падшая Грейс изучает твои черты. — Ты ещё…»~
@68358 = ~Я ТОТ, КОГО ТЫ ЗНАЕШЬ, НО МОЁ ВИДЕНИЕ… ИЗМЕНИЛОСЬ. Я НЕ ЗАБЫЛ ТЕБЯ, ЕСЛИ ТЫ БОИШЬСЯ ЭТОГО.~
@68359 = ~Падшая Грейс снова печально улыбается: «Нет, не этого я боюсь».~
@68360 = ~Я НЕ МОГУ ЗДЕСЬ ДОЛЬШЕ ОСТАВАТЬСЯ. МОЯ КАРА ЗОВЁТ, СУДЬБА И ВРЕМЯ СКОРО БУДУТ ЗДЕСЬ. Я ВЕРНУ ТЕБЯ В СИГИЛ, ЕСЛИ ХОЧЕШЬ.~
@68361 = ~«Моё желание иное», — Падшая Грейс приближается, её рука слегка касается твоей. Ты чувствуешь лёгкое, почти неощутимое покалывание, а потом она убирает руку. «Я *найду* тебя снова — неважно, где на Нижних планах ты будешь, — и у тебя тоже будет возможность найти меня…»~
@68362 = ~ЭТО МОЖЕТ ЗАНЯТЬ МНОГО ВРЕМЕНИ. ТАМ, ГДЕ Я БУДУ, ВРЕМЯ НЕ ИЗМЕРЯЕТСЯ ГОДАМИ. И МОИ ПРЕСТУПЛЕНИЯ БУДУТ ДЕРЖАТЬ МЕНЯ КРЕПЧЕ ЛЮБОЙ КЛЕТКИ.~
@68363 = ~«Никакая клетка на разделит нас, и никакой план не разлучит, — лицо Падшей Грейс становится похожим на камень. — Помни меня, и мы снова встретимся».~
@68364 = ~Я НИКОГДА НЕ ЗАБУДУ, ЧЕМ ТЫ РАДИ МЕНЯ ПОЖЕРТВОВАЛА.~
@68365 = ~Она качает головой: «Просто не забывай меня».~
@68366 = ~ВРЕМЯ ОПУСТОШАЕТ ВСЁ. НО ПОКА МОГУ — Я БУДУ БИТЬСЯ С НИМ.~
@68367 = ~«Не время твой враг, а вечность».~ [FFG196]
@68368 = ~ВОЗМОЖНО, И ТАК. ПРОЩАЙ, ГРЕЙС.~
@68369 = ~ВОЗМОЖНО, И ТАК. ПРОЩАЙ, ГРЕЙС.~
@68370 = ~ВОЗМОЖНО, И ТАК. ПРОЩАЙ, ГРЕЙС.~
@68371 = ~ВОЗМОЖНО, И ТАК. ПРОЩАЙ, ГРЕЙС.~
@68372 = ~НОРДОМ.~
@68373 = ~Нордом моргает, его веки часто *щёлкают*, затем зрачки сужаются до точек, будто он щурится на тебя: «Твой голос пре-восходит стандартные параметры распознавания».~
@68374 = ~Я СНОВА… СТАЛ ЦЕЛЫМ. Я ИЗМЕНИЛСЯ И ВСКОРЕ ПОКИНУ ЭТО МЕСТО. Я ВЕРНУ ТЕБЯ В СИГИЛ, НОРДОМ, ЕСЛИ ХОЧЕШЬ.~
@68375 = ~«Запрос: каков твой следующий пункт назначения? Нордом последует и защитит тебя».~
@68376 = ~ЗА МНОГО ЖИЗНЕЙ Я СОВЕРШИЛ МНОЖЕСТВО ПРЕСТУПЛЕНИЙ. ТЕПЕРЬ Я ОТПРАВЛЯЮСЬ В МЕСТО НАКАЗАНИЯ. ТЫ НЕ МОЖЕШЬ ПОЙТИ СО МНОЙ.~
@68377 = ~«Уточняющий запрос: ты не (нуждаешься) или не (хочешь) присутствия Нордома?»~
@68378 = ~ТЫ НЕ МОЖЕШЬ ИДТИ СО МНОЙ, НОРДОМ. ЭТО НЕ МОЙ ВЫБОР. СЕЙЧАС ДРУГИЕ СИЛЫ РУКОВОДЯТ МОИМИ ДЕЙСТВИЯМИ. ВСЕГДА РУКОВОДИЛИ. НО ТЕПЕРЬ ОНИ ЗНАЮТ, ЧЕМ Я ЯВЛЯЮСЬ, И С КАЖДОЙ СЕКУНДОЙ ПРИБЛИЖАЮТСЯ ВСЁ БЛИЖЕ.~
@68379 = ~Пару мгновений Нордом *тарахтит*, потом его арбалеты начинают *щёлкать* и *звенеть*: «Нордом высказывает благодарность. Ты помог Нордому найти его личность».~
@68380 = ~А ТЫ ПОМОГ МНЕ НАЙТИ СЕБЯ. Я ОТПУСКАЮ ТЕБЯ, НОРДОМ. ИССЛЕДУЙ, УЧИСЬ, РАСТИ. ВОЗМОЖНО, МЫ ЕЩЁ ВСТРЕТИМСЯ НА ДРУГОМ ПЛАНЕ, МНОГО ВЕКОВ СПУСТЯ.~
@68381 = ~«Ответ: услышано и принято к исполнению. Нордом ожидает обещанной встречи».~
@68382 = ~ПОЛОЖИСЬ НА СВОЮ ЛОГИКУ, НОРДОМ. ТЫ НАЙДЁШЬ ЕЁ ЛУЧШЕЙ ЗАЩИТОЙ, ЧЕМ ЛЮБЫЕ СТРАСТИ, ГОСПОДСТВУЮЩИЕ НА ПЛАНАХ.~
@68383 = ~«Высказывание более не соответствует общей логике».~ [NOR149]
@68384 = ~ПРОЩАЙ, НОРДОМ.~
@68385 = ~ПРОЩАЙ, НОРДОМ.~
@68386 = ~ПРОЩАЙ, НОРДОМ.~
@68387 = ~ВОССТАНЬ, ИГНУС.~
@68388 = ~Игнус взмывает в воздух в мощном потоке пламени и дыма, воздух *колеблется* от жара, исходящего от его тела. Он поворачивается к тебе, его глаза подобны порталам в ад; Игнус издаёт длинное низкое шипение — не угрожающее, а просто встревоженное, такого ты от него ещё не слышал.~
@68389 = ~СКОРО Я ПОКИНУ ЭТО МЕСТО, ИГНУС. Я ВЕРНУ ТЕБЯ В СИГИЛ, ЕСЛИ ХОЧЕШЬ.~
@68390 = ~Игнус внимательно смотрит на тебя; выражение его лица непередаваемо — и ты вдруг понимаешь, чего Игнус желает.~
@68391 = ~Я ОТПРАВЛЮ ТЕБЯ НА СТИХИЙНЫЙ ПЛАН ОГНЯ, ИГНУС. ТАМ ТЫ БУДЕШЬ ПАРИТЬ НАД НЕБЕСАМИ ИЗ ОГНЯ, И ВСЕ СОЗДАНИЯ БУДУТ ЗНАТЬ ТВОЁ СЕРДЦЕ. ТЫ БУДЕШЬ ЖИТЬ В ВЕЧНОМ ПЛАМЕНИ, КАК И ЖЕЛАЛ.~
@68392 = ~Игнус парит в молчании, а затем говорит, его голос подобен… голосу ребёнка, того ученика, каким он был давным-давно, когда пришёл за знаниями к одной из твоих инкарнаций: «Учитель, прости меня… я предал твоё учение».~ [IGN254]
@68393 = ~КОГДА-ТО Я НАУЧИЛ ТЕБЯ СТРАДАНИЮ, ИГНУС, И ИМЕННО Я ПРЕДАЛ ТЕБЯ. ТЕПЕРЬ Я ОТПРАВЛЯЮ ТЕБЯ ТУДА, ГДЕ ТВОЁ СЕРДЦЕ БУДЕТ СВОБОДНО.~
@68394 = ~БЫЛО МНОГО ПРЕДАТЕЛЬСТВ, ИГНУС. Я ПРОЩАЮ ТЕБЯ.~
@68395 = ~Игнус молча кланяется. Языки пламени окутывают его, частички пепла кружат вокруг, словно маленькие листья.~
@68396 = ~ПРОЩАЙ, ИГНУС.~
@68397 = ~ПРОЩАЙ, ИГНУС.~
@68398 = ~ВОССТАНЬ, ВЕЙЛОР.~
@68399 = ~Шлем Вейлора поворачивается к тебе, его глаза пульсируют в такт биению сердца.~
@68400 = ~ВЕЙЛОР, РУКА СПРАВЕДЛИВОСТИ БЫСТРА, НАКОНЕЦ ОНА ДОТЯНУЛАСЬ И ДО МЕНЯ. СКОРО Я ПОКИНУ ЭТО МЕСТО. Я ВЕРНУ ТЕБЯ В СИГИЛ, ЕСЛИ ПОЖЕЛАЕШЬ.~
@68401 = ~*Какие ПРЕСТУПЛЕНИЯ занесли над тобой руку СПРАВЕДЛИВОСТИ?*~
@68402 = ~МНОГИЕ УМЕРЛИ, ЧТОБЫ Я МОГ ЖИТЬ, ВЕЙЛОР. ПРЕСТУПЛЕНИЕ ВЕЛИКО — И ВРЕМЯ, И СУДЬБА ТЕПЕРЬ ПРИШЛИ ЗА МНОЙ.~
@68403 = ~*ПОЗВОЛЬ мне НАПУТСТВОВАТЬ тебя. СПРАВЕДЛИВОСТЬ — это наставник. Ищи СИЛУ в своём НАКАЗАНИИ. Через наказание ты достигнешь СОВЕРШЕНСТВА.*~
@68404 = ~ВОЗМОЖНО, И ТАК, ВЕЙЛОР. Я ПОДУМАЮ НАД ТВОИМИ СЛОВАМИ.~
@68405 = ~*ЗНАЙ: если ты сбежишь от своего приговора, я найду тебя, БЕЗЫМЯННЫЙ.*~
@68406 = ~*Рука правосудия не остановится.*~ [VHA010]
@68407 = ~ДУМАЮ, БОЛЬШЕ МЫ НЕ ВСТРЕТИМСЯ, ВЕЙЛОР. НА ВРЕМЯ Я ПОСЕЛЮСЬ В ЗАЛАХ СПРАВЕДЛИВОСТИ, И ВРЕМЯ ЭТО НЕ ИСЧИСЛЯЕТСЯ ГОДАМИ. ПРОЩАЙ.~
@68408 = ~Морте внимательно смотрит на тебя, а затем вздыхает: «Не то чтобы я до слёз растрогался, но мне… э-э… было приятно с тобой путешествовать, шеф».~ [MRT109]
@68409 = ~«Тогда давай займемся делом…»~
@68410 = ~В глазах Анны вспыхивает решимость, затем она кивает: «Я с тобой».~
@68411 = ~«Тогда вперёд…»~
@68412 = ~Дак'кон кивает: «Этот клинок принадлежит тебе».~ [DAK025]
@68413 = ~«Хорошо, покажи его в деле…»~
@68414 = ~«Жду приказов».~ [NOR063]
@68415 = ~«Просто готовь все свои арбалетные болты, позже им найдётся применение…»~
@68416 = ~Грейс кивает тебе: «Боюсь, раз уж мы вошли, это место нас так просто не выпустит».~ [FFG070]
@68417 = ~«Посмотрим. Сперва надо заняться моей смертностью…»~
@68418 = ~Игнус — как вышедший из-под контроля ад. Струи пламени прокатываются по его телу, как волны в каком-нибудь огненном океане: «*Гори-и-и-и…*»~ [IGN090A]
@68419 = ~«Давай, Игнус, не дай ему сконцентрироваться».~
@68420 = ~*Рука правосудия не остановится.*~ [VHA010]
@68421 = ~«Давай, Вейлор. Не дай ему сконцентрироваться».~
@68422 = ~Я ОТПРАВЛЮ ТЕБЯ НА СТИХИЙНЫЙ ПЛАН ОГНЯ, ИГНУС. ТАМ ТЫ БУДЕШЬ ПАРИТЬ НАД НЕБЕСАМИ ИЗ ОГНЯ, И ВСЕ СОЗДАНИЯ БУДУТ ЗНАТЬ ТВОЁ СЕРДЦЕ. ТЫ БУДЕШЬ ЖИТЬ В ВЕЧНОМ ПЛАМЕНИ, КАК И ЖЕЛАЛ.~
@68423 = ~~
@68424 = ~«Интересно…»~
@68425 = ~GlobalGT("Regret","GLOBAL",1)~
@68426 = ~Расслабиться и постараться вспомнить.~
@68427 = ~ЭТО ТЕБЕ *НЕ ПОМОЖЕТ*. ТЫ ОЖИВИЛ СВОИХ ТОВАРИЩЕЙ ДЛЯ НОВОЙ СМЕРТИ.~
@68428 = ~«Я вернусь за тобой, даже если мы умрём. *Клянусь*. Я снова выслежу тебя, сколько бы это ни заняло времени».~
@68429 = ~«Я вернусь за тобой, даже если мы умрём. *Клянусь*. Я снова выслежу тебя, сколько бы это ни заняло времени».~
@68430 = ~«Я вернусь за тобой, даже если мы умрём. *Клянусь*. Я снова выслежу тебя, сколько бы это ни заняло времени».~
@68431 = ~«Тогда вперёд…»~
@68432 = ~«Тогда вперёд…»~
@68433 = ~«Отлично».~
@68434 = ~«Отлично».~
@68435 = ~«Посмотрим…»~
@68436 = ~«Посмотрим…»~
@68437 = ~Капитан стражи~
@68438 = ~«Тогда, может быть, это мне от тебя и нужно. Поговорим об этом *позже*, Морте…»~
@68439 = ~«Тогда, может быть, это мне от тебя и нужно. Поговорим об этом *позже*, Морте…»~
@68440 = ~Капитан стражи~
@68441 = ~«Может быть, это случится сегодня, Игнус…»~
@68442 = ~«Хорошо… Я подожду здесь. Если ты вернешься».~
@68443 = ~«Тогда вперёд…»~
@68444 = ~«Отлично».~
@68445 = ~«Посмотрим…»~
@68446 = ~«Тогда, может быть, это мне от тебя и нужно. Поговорим об этом *позже*, Морте…»~
@68447 = ~«Оживи моих друзей и позволь им уйти. *Если* это, конечно, тебе под силу».~
@68448 = ~«Я требую оживления моих товарищей и возможности для них уйти отсюда. *Если* это, конечно, тебе под силу».~
@68449 = ~«Прежде чем мы воссоединимся, я хочу вернуть моим друзьям жизнь…»~
@68450 = ~«Перед этим я требую возрождения моих товарищей».~
@68451 = ~«Тогда какой же вред в?..»~
@68452 = ~У МЕНЯ НЕТ *ЖЕЛАНИЯ* СПАСАТЬ ТВОЕГО ТОВАРИЩА. ТВОЯ СМЕРТНАЯ… *ШАВКА* БРОСИЛА МНЕ ВЫЗОВ В МОЁМ ДОМЕ, И ЭТА СМЕРТЬ ПОСЛУЖИТ НАПОМИНАНИЕМ ВСЕМ ОСТАЛЬНЫМ.~
@68453 = ~«Ты просто не можешь воскресить моего товарища, да?»~
@68454 = ~«Не думаю, что у тебя есть выбор. Не думаю, что ты вообще можешь воскресить моего товарища».~
@68455 = ~«Возможно, твоя смерть скоро последует. Я хочу знать кое-что другое…»~
@68456 = ~«Тогда ты тоже умрёшь. Приготовься, дух. Посмотрим, может ли моя смертность быть повержена».~
@68457 = ~«О чём ты?»~
@68458 = ~«Нет, но я хочу купить кое-какие заклинания».~
@68459 = ~Интеллект уменьшился навсегда~
@68460 = ~Мудрость снижена навсегда~
@68461 = ~Ловкость уменьшилась навсегда~
@68462 = ~Телосложение уменьшилось навсегда~
@68463 = ~Харизма уменьшилась навсегда~
@68464 = ~Максимум пунктов здоровья уменьшился навсегда~
@68465 = ~Класс защиты уменьшился навсегда~
@68466 = ~Карманная кража удалась [Анна]~ [ANA487G]
@68467 = ~ПРОЩАЙ, ИГНУС.~
@68468 = ~Твой рюкзак заполнен. Некоторые предметы купить нельзя.~
@68469 = ~«Хорошо. Я готов снова стать смертным».~
@68470 = ~«Хорошо. Я готов снова стать смертным».~
@68471 = ~«Хорошо. Я готов снова стать смертным».~
@68472 = ~«Хорошо. Я готов снова стать смертным».~
@68473 = ~«Хорошо. Я готов снова стать смертным».~
@68474 = ~«Хорошо. Я готов снова стать смертным».~
@68475 = ~«ЧТО? Я должен и дальше терпеть твоё присутствие? Неужели эти муки никогда не кончатся? Пфе! Ладно, что ж! Располагайся на полу! Опустошай мои запасы еды! Рушь мои эксперименты! Если понадоблюсь — найдёшь по дыму! Пфе!» — бушует он.~
@68476 = ~~
