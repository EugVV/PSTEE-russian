@64130 = ~~
@64131 = ~Анна — тифлинг, нахальная девчонка на грани женственности. Её хвост резко ходит из стороны в сторону, когда она в гневе. Анна — приёмная дочь Фарода Червеголового, на посылках у его Сборщиков. Она ловкая и осмотрительная беспризорница, а Улей ей как дом родной. Умения и способности Анны делают её полезной… а может быть, она станет для тебя кем-то большим, чем просто компаньон.~
@64132 = ~~
@64133 = ~~
@64134 = ~~
@64135 = ~~
@64136 = ~ТЫ НЕ МОЖЕШЬ УМЕРЕТЬ.~
@64137 = ~~
@64138 = ~~
@64139 = ~~
@64140 = ~~
@64141 = ~~
@64142 = ~~
@64143 = ~Дак'кон — гитцерай, он из народа, населяющего план Лимбо. У них очень хорошо развита кастовая система. Кожа Дак'кона жёлтая и морщинистая. Похоже, он очень стар, а в его маленьких чёрных глазах таится боль. Дак'кон владеет клинком *карач*, изготовленным из первичной материи плана Лимбо и принимающим любую желаемую форму. Он путешествует с тобой из чувства долга… и, похоже, без особой охоты.~
@64144 = ~Падшая Грейс — суккуб, одна из танар'ри, существ, буквально слепленных из чистого хаоса и зла. Её тело и разум — великолепные образцы для искушения мужчин любой расы и возраста… но Грейс утверждает, что отказалась от своей природы, взамен пытаясь улучшить свою жизнь и жизнь окружающих через развитие ментальной дисциплины. Грейс — бывшая хозяйка Борделя Безумной Интеллектуальной Страсти; теперь она путешествует с тобой, поскольку хочет ощутить космос через твои глаза.~
@64145 = ~«У меня ещё вопросы…»~
@64146 = ~«Я проверю. Ещё поговорим позже. До встречи».~
@64147 = ~«У меня ещё вопросы».~
@64148 = ~«Уж постараюсь. До встречи».~
@64149 = ~«Не сомневаюсь. У меня ещё вопросы».~
@64150 = ~«Не сомневаюсь. До встречи».~
@64151 = ~Найти отца Шерил.~
@64152 = ~Я поговорил с Норочи и сделал то, что он просил: решил проблему с вором, притворявшемся Пыльным. Я вернулся и сказал Эморику, что сделал это, и могу продолжать посвящение в Пыльные.~
@64153 = ~Найти и вернуть дневник исследований Финама.~
@64154 = ~Опровергнуть утверждение Кви-Сая, что тренироваться на вора лучше, чем на воина.~
@64155 = ~Я не смог найти садовника в Улье, поэтому вернулся к Меббет. Она сказала, что ничего страшного. Возможно, ей самой удастся прорастить одно из чёрных шипастых семян.~
@64156 = ~Ты видишь Финеаса. Он смотрит на тебя поверх очков: «А, друг мой. Что я могу для вас сделать на *этот* раз, м-м?»~
@64157 = ~«А что это ты не выпрыгнул из штанов, когда я снова пришёл?»~
@64158 = ~«У меня кое-какие вопросы…»~
@64159 = ~«Ничего, прощай».~
@64160 = ~Он вздыхает, затем улыбается. «После вашего подвига я чувствую… облегчение. Должен признать, давно я не чувствовал себя так спокойно, — он на минуту задумывается. — Благодарю вас за это. Итак, что я могу для вас сделать?»~
@64161 = ~«У меня кое-какие вопросы…»~
@64162 = ~«Ничего, прощай».~
@64163 = ~«Как ты общаешься с остальными зомби? Я не понимаю их, в отличие от тебя…»~
@64164 = ~«А, привет. Не за гробом в магазин пришёл? — он приветливо улыбается. — У меня больше нет для тебя работы, так что… Чем могу помочь?»~
@64165 = ~«У меня вопросы…»~
@64166 = ~«Ничем, до встречи».~
@64167 = ~Ты видишь Ксантию. Она награждает тебя скучающим взглядом: «Итак… я видела, как ты говорил с этим олухом Торпом. Ты предупредил его?»~
@64168 = ~«Нет, решил насладиться зрелищем вместе с тобой».~
@64169 = ~Ксантия смеётся: «Как мило… Пожалуйста, присоединяйся». На мгновение она задумывается, затем отвязывает сбоку кошелёк: «Вот… возьми за то, что не испортил леди удовольствия». Она протягивает кошелёк тебе.~
@64170 = ~«Спасибо, Ксантия. До встречи».~
@64171 = ~Вришика слегка хмурится, читая вексель. «Ну… полагаю, позже я могу приказать Стэндишу забрать их. Хорошо, вот, — она протягивает тебе флакон. — Пожалуйста, наслаждайся новейшим приобретением».~
@64172 = ~«Хочу взглянуть на оружие и амулеты…»~
@64173 = ~«Хочу снова взглянуть на экзотику…»~
@64174 = ~«Прощай».~
@64175 = ~«У меня есть вексель на тысячу медяков из Борделя…»~
@64176 = ~«Нет, спасибо. Прощай».~
@64177 = ~Фестхолл~
@64178 = ~Вызванный конструкт~
@64179 = ~Вызванный конструкт~
@64180 = ~Навык дистанционное оружие.~
@64181 = ~Этот магический жезл позволяет вызвать от одного до трёх модронов-конструктов, которые будут бесстрашно биться на стороне вызвавшего до своей смерти.~
@64182 = ~Использовать.~
@64183 = ~Убрать.~
@64184 = ~Этот магический жезл позволяет вызвать от одного до трёх модронов-конструктов, которые будут бесстрашно биться на стороне вызвавшего до своей смерти.~
@64185 = ~Использовать.~
@64186 = ~Убрать.~
@64187 = ~Профессиональное владение Клинком~
@64188 = ~Этот магический жезл позволяет вызвать от одного до трёх модронов-конструктов, которые будут бесстрашно биться на стороне вызвавшего до своей смерти.~
@64189 = ~Использовать.~
@64190 = ~Навык Кулачного Боя.~
@64191 = ~Убрать.~
@64192 = ~День <GAMEDAY>  <HOUR>:<MINUTE>~
@64193 = ~«Р-р-ра-ам-м-мб т-ты-ый де-е-елы…»~
@64194 = ~«Дздр-р-р-ра-а-ас-с Бузмолны-ы-ы Кр-р-рол-ль…»~
@64195 = ~«Скр-р-ро-о-о мы-ы сво-о-ободмс-с-ся у-ут пл-л-лоти…»~
@64196 = ~Игнус — горящий человек, влюблённый в пламя. Когда ты вылил на него графин бесконечной воды, пламя Игнуса не погасло — с него просто спали чары, которые держали его неподвижным и горящим. Теперь он стал чем-то большим, нежели человек, чем-то изначальным — и порой сердце подсказывает тебе, что у него есть сила навсегда уничтожить тебя.~
@64197 = ~Лотар, повелитель Костей Ночи, держит у себя в гостиной полные полки черепов. Черепа шепчут о древних секретах, их шёпот наполняет Лотара тайными познаниями. Он один из тех немногих, кто действительно может тебя уничтожить. Жители Сигила произносят его имя шёпотом и с почтением и в ужасе трясутся при мысли оскорбить его.

Знания Лотара оправдали себя: он сказал тебе, где находится ведьма Рейвел Клубок-Загадок и как к ней попасть. А ещё он предостерёг тебя насчёт неё, рассказав, что её магия практически сорвала Сигил со Шпиля.~
@64198 = ~Нордом — бродячий модрон, прячущийся внутри куба модронов в Лимбо. Если другие модроны его обнаружат, то наверняка разберут на части из-за обретённой им индивидуальности.~
@64199 = ~Эти громоздкие доспехи содержат в себе дух, называющий себя «Вейлор». Его движущая сила — справедливость, и чем страшнее несправедливость, встречаемая духом, тем больше силы он обретает. Его красные как угли глаза горят из-под шлема, а непреклонную преданность делу Убийц Милосердия подчёркивает символика, украшающая его доспехи, шлем и в особенности секиру. Нечто в этом существе заставляет тебя верить, что если ты совершишь несправедливость, то Вейлор может навсегда убить тебя. Из всех созданий, встреченных тобой, именно его ты не хотел бы сердить.~
@64200 = ~Нордом — это модрон-бродяга, присоединившийся к тебе. Если другие модроны его обнаружат, то наверняка разберут на части из-за обретённой им индивидуальности. При себе Нордом имеет пару арбалетов. Время от времени он разговаривает с ними, и они, кажется, даже отвечают ему.~
@64201 = ~«Не стой рядом со мной, Морте».~ [ANA575F]
@64202 = ~~
@64203 = ~«Ясно. Расскажи мне о своей дочери».~
@64204 = ~«Ясно. Расскажи мне о своей дочери».~
@64205 = ~Когда ты смотришь на разлагающиеся остатки трупа, то замечаешь, что левая рука осталась целой — её оторвало во время падения. На руку не распространилось гниение, поразившее остальные части трупа.~
@64206 = ~«Хм-м. Интересно, смогу ли я использовать эту руку…»~
@64207 = ~Триас — это дэв, небесное создание с Верхних планов. В первый раз ты нашёл его под Керстом, заключённым в обсидиановую оболочку. Красота Триаса просто поражает; его окружает аура доброты, величественная, как сияние света. Его крылья обожжены до костей, и это ранит его гордость.

Ты был обманут.

Триаса зовут Предателем. Это он привёл армию демонов к вратам Рая, и за это был изгнан из небесного братства. Триас обманул изверга Фьюлла Двуличного, заставив его делать добро. Несомненно, что внутри Триас всё то же зло.~
@64208 = ~«Послушай, Грейс… а у тебя сёстры есть?»~ [MRT461AB]
@64209 = ~«Эй, Нордом, почему бы тебе не вернуться в Механус, а?»~ [MRT466B]
@64210 = ~«Этот должен сосредоточится на *На-Следии*».~
@64211 = ~«Отойди оттуда, или получишь».~
@64212 = ~«Эй, пень, не трогай ничего чужого!»~
@64213 = ~«Этот должен придерживаться заповедей *На-Следия*».~
@64214 = ~«Хм-м-м-м-мн».~
@64215 = ~«Меббет, ты в порядке?»~
@64216 = ~«Меббет, твой голос… ты говоришь голосом *Рейвел*. *Кто* ты?!»~
@64217 = ~~
@64218 = ~(auto link)~
@64219 = ~«Внимание: Морте. Ты знаешь, что у меня шесть граней?»~ [NOR311]
@64220 = ~«Анна, твой хвост помогает тебе удерживать равновесие?»~ [NOR291A]
@64221 = ~::Окидывает Морте злым взглядом::~
@64222 = ~«Спасибо. Я должен идти».~
@64223 = ~Ленни улыбается и кивает в раздумье. «Вот, здоровяк, возьми подарок от Ленни. Может тебе пригодятся… мне они больше не нужны», — он протягивает тебе пару кастетных кинжалов.~
@64224 = ~«Спасибо, Ленни. До встречи».~
@64225 = ~Огромные часы кажутся частично вплавленными в окружающий их чёрный камень… земля же вокруг них потревожена, словно «недавно» кто-то здесь ходил — несколько лет назад, возможно.~
@64226 = ~На часах что-то грубо нацарапано, и заднюю часть твоего черепа внезапно охватывает странное чувство: ты знаешь, что это послание тебе… и от тебя же.~
@64227 = ~По-видимому, послание на лицевой стороне часов вырезано кинжалом:

«БЕГИ — ДВЕРИ — это ЛОЖЬ — ИСПОЛЬЗУЙ Пушки — затем ПОРТАЛ».

Явно видно, что сообщение писалось в спешке. Под надписью нарисована грубая «стрелка», указывающая в направлении, противоположном длинной стрелке часов.~
@64228 = ~Огромные часы кажутся частично вплавленными в окружающий их чёрный камень… земля же вокруг них потревожена, словно «недавно» кто-то здесь ходил — несколько лет назад, возможно. На часах выцарапано послание тебе… от тебя же самого.~
@64229 = ~Осмотреть надпись.~
@64230 = ~Оставить часы в покое.~
@64231 = ~«Спасибо за совет…»~
@64232 = ~Осмотреть надпись.~
@64233 = ~Оставить часы в покое.~
@64234 = ~Огромные часы кажутся частично вплавленными в окружающий их чёрный камень… при взгляде на циферблат часов заднюю часть твоего черепа внезапно охватывает странное чувство: ты уже видел похожие часы, но не эти. С ними связано что-то важное, но что именно — ты не помнишь.~
@64235 = ~Огромные часы кажутся частично вплавленными в окружающий их чёрный камень… но в отличие от других часов с посланием, на лицевой стороне этих нет никаких пометок. Очевидно, эти часы не попали под руку твоей предыдущей инкарнации.~
@64236 = ~Оставить часы в покое.~
@64237 = ~Оставить часы в покое.~
@64238 = ~Я нашёл в Крепости странную машину: она напоминает пушку, но есть подозрение, что это нечто вроде «стража ворот» или запирающего механизма Крепости. Когда я переключил её, то оказался в другой части Крепости — на балконе, возвышающемся над главной галереей. Я знаю, что мне надо отыскать и как-то включить другие машины. Похоже, мои воспоминания возвращаются. Если сообщение, выцарапанное на часах, — правда, то одна из моих инкарнаций уже когда-то прошла через всё это.~
@64239 = ~Я нашёл в Крепости странную машину: она напоминает пушку, но есть подозрение, что это нечто вроде «стража ворот» или запирающего механизма Крепости. Когда я переключил её, то оказался в другой части Крепости — на балконе, возвышающемся над главной галереей. Я знаю, что мне надо отыскать и как-то включить другие машины. Не знаю почему, но мне кажется, что я уже это делал.~
@64240 = ~Я натолкнулся в Крепости на большие разрушенные часы… при взгляде на них я почувствовал: с подобными часами должно быть связано нечто *важное*. Возможно, в прошлом я видел другие такие же часы.~
@64241 = ~Это древнее устройство напоминает забытую военную реликвию. Почти всё оно покрыто пылью, кроме странной панели с рычагами. Как ни странно, земля вокруг панели потревожена, словно «недавно» кто-то здесь ходил — несколько лет назад, возможно.~
@64242 = ~На панели находится ряд механизмов и рычагов, под каждым — ряд пометок, в спешке нацарапанных кинжалом. Под некоторыми пометок нет, другие же отмечены единичными засечками. Под одним из них нацарапано «X». Не понимая откуда, ты вспоминаешь, что рычаг «X» как-то позволит тебе покинуть это место.~
@64243 = ~Рычаг легко опускается от твоего прикосновения, а затем, к твоему удивлению, разлагается в лёгкий туман… тот окружает кисть твоей руки, которая тоже начинает исчезать, затем всю руку, и в конце концов тебя одолевает головокружение, а стены вокруг исчезают…~
@64244 = ~Это древнее устройство напоминает забытую военную реликвию. Почти всё оно покрыто пылью, кроме странной панели с рычагами. От того рычага, что ты нажал, не осталось и следа: он пропал, словно и не существовал.~
@64245 = ~Ты быстро находишь рычаг с пометкой «X» и тянешь его. Он легко уступает твоему прикосновению, а затем распадается в дымку. Ты глубоко вдыхаешь, и волна головокружения снова одолевает тебя, в то время как стены вокруг исчезают…~
@64246 = ~Осмотреть панель в поисках рычага с пометкой «X».~
@64247 = ~Осмотреть панель.~
@64248 = ~Оставить устройство в покое.~
@64249 = ~Потянуть рычаг, отмеченный «X».~
@64250 = ~Потянуть рычаг, отмеченный «X».~
@64251 = ~Оставить устройство в покое.~
@64252 = ~«Чт…»~
@64253 = ~Оставить устройство в покое.~
@64254 = ~«Куда меня забросит *тепе…*»~
@64255 = ~Ты быстро находишь рычаг «X» и тянешь его. Он легко уступает твоему прикосновению, а затем распадается в дымку. Ты глубоко вдыхаешь, но, в отличие от прошлого раза… ничего не происходит.~
@64256 = ~Издалека слышится громкий шум, словно *что-то* открылось, а через помещение проносится завывающий ветер. Пока ты пытаешься понять, откуда раздаётся звук, ты вдруг осознаёшь, что распадаешься и сам становишься частью ветра…~
@64257 = ~«*Теперь-то* что происходит?!..»~
@64258 = ~~
@64259 = ~Я отказался освободить голема из осадной башни, и в ответ он изгнал меня из башни прочь. Но, всё же это лучше для планов, чем если бы я освободил его.~
@64260 = ~Когда я нажал переключатель на четвёртой реликвии, в недрах Крепости словно бы что-то открылось… может, выход из этого места? Я должен найти его и проваливать отсюда…~
@64261 = ~Осмотреть панель в поисках рычага с пометкой «X».~
@64262 = ~Этот скелет или много сражался, или падал с многочисленных лестниц. Все его конечности были хотя бы по разу сломаны и скреплены с помощью кожаных ремней и тонких железных реек. Передняя часть его черепа несёт на себе номер «863»… задняя же провалилась, образовав пустую полость. Ты замечаешь, что кто-то воспользовался этим и положил внутрь черепа обрывок пергамента.~
@64263 = ~Забрать пергамент из черепа.~
@64264 = ~Оставить скелет в покое.~
@64265 = ~Ты вытаскиваешь пергамент из черепа рабочего. Довольно странно, но похоже, что полость в черепе как раз и *предназначается* для хранения посланий: тоненький шнурок соединяет пергамент с крючком, закреплённым внутри черепа, удерживая пергамент от случайного выпадения.~
@64266 = ~Снять шнурок с крючка и взять пергамент.~
@64267 = ~Ты снимаешь шнурок с крючка и осматриваешь пергамент. Похоже на памятку от одного из смотрителей Мортуария. Судя по заметке, этот скелет своего рода ходячий посыльный. Ещё раз взглянув на него, ты понимаешь, что он остановился перед плитой, поскольку не может сообразить, как её обойти.

^NПРИМЕЧАНИЕ. <READSTUFF>^-~
@64268 = ~Ещё раз осмотреть скелет.~
@64269 = ~Оставить скелет в покое.~
@64270 = ~У этого ковыляющего трупа зашиты глаза, как впрочем и рот, а на брови вырезан номер «732». Нить, которой зашиты веки, выглядит неимоверно ветхой… непонятно, зашили ли глаза до или уже после смерти. Ты замечаешь, что труп держит в руках толстый том, словно несёт его куда-то.~
@64271 = ~Осторожно взять том из его рук.~
@64272 = ~Оставить труп в покое.~
@64273 = ~Ты осторожно берёшь том из рук трупа, похоже, тот вообще не замечает. По-видимому, этот том является книгой чар и охранных заклинаний: он заполнен диаграммами и таблицами, поясняющими разнообразные аспекты искусства некромантии. Сама по себе книга очень тяжёлая; зомби, должно быть, очень сильный.

^NПРИМЕЧАНИЕ. <READSTUFF>^-~
@64274 = ~Внимательно осмотреть труп ещё раз.~
@64275 = ~Оставить труп в покое.~
@64276 = ~ДРЕВНЯЯ МЕДНАЯ СЕРЬГА (ЗАКРЫТАЯ)
Вес: 0
Нельзя использовать (закрыта)

Эта медная серьга выглядит древней. Странно, но на ней нет ни крючка, ни любого другого приспособления, чтобы можно было надеть её на ухо. На внутренней стороне серьги сделан ряд странных углублений, как бы то ни было, они могут заслуживать более тщательного осмотра.

^NПРИМЕЧАНИЕ. Некоторые предметы можно использовать из экрана снаряжения для дальнейшего изучения или воздействия на них. У таких предметов в описании слева внизу есть кнопка «ИСПОЛЬЗОВАТЬ». Эта кнопка позволяет манипулировать объектом через экран диалога. Нажав кнопку «Использовать», можно тщательнее осмотреть углубления на серьге.^-~
@64277 = ~~
@64278 = ~Зубчатый круг, похоже, был клеймён на лбу этого трупа очень давно, возможно, ещё до смерти. Это могло быть каким-то религиозным символом или обрядом посвящения. Ты замечаешь в одном из промежутков между внутренними «зубцами» круга изображение маленького треугольника, словно это место имеет какое-то особое значение.~
@64279 = ~«Хм-м. Интересно… как этот знак попал сюда, а, труп?»~
@64280 = ~«Хм-м… интересно, а не соответствуют ли промежутки между зубцами круга углублениям на медной серьге, которую я нашёл…»~
@64281 = ~~
@64282 = ~«Яннис, в сенсориуме есть камень чувств, содержащий часть переживаний твоей дочери».~
@64283 = ~«Не уверен. В Фестхолле есть камень чувств, который хранит номер наследства».~
@64284 = ~«Не уверен. Я нашёл номер в камне чувств, о котором уже говорил. Он был предназначен для меня».~
@64285 = ~«Не уверен. В Фестхолле есть камень чувств, который хранит номер наследства».~
@64286 = ~«Не уверен. Я нашёл номер в камне чувств, о котором уже говорил. Он был предназначен для меня».~
@64287 = ~«Может быть. В камне чувств она оставила для меня номер наследства…»~
@64288 = ~«Может быть. В камне чувств она оставила для меня номер наследства…»~
@64289 = ~«Вскоре я всё устрою. А сейчас, она оставила для меня номер наследства в камне чувств…»~
@64290 = ~«Вскоре я всё устрою. А сейчас, она оставила для меня номер наследства в камне чувств…»~
@64291 = ~«Тогда я быстро всё устрою. А сейчас меня интересует наследство, которое она для меня оставила…»~
@64292 = ~«Тогда я быстро всё устрою. А сейчас меня интересует наследство, которое она для меня оставила…»~
@64293 = ~Осмотреть символы.~
@64294 = ~Сравнить руны с описанием в томе кости и праха.~
@64295 = ~Ты справляешься в томе и сравниваешь диаграммы со знаками на кирасе. Из почерпнутой информации можно заключить, что руны являются слабым заклинанием улучшения защиты, но несколько рун в виде черепов и сферические следы по краям доспеха означают, что были также вплетены несколько более мощных некромантских и охранных заклинаний. Прикосновение к скелету, скорее всего, заставит его проснуться… и защищаться.~
@64296 = ~Сравнить образец с заклинаниями в томе кости и праха и попытаться определить, как могут быть разбиты руны.~
@64297 = ~Прочитав том, ты понимаешь, что, вероятнее всего, чары защиты применяются только к кирасе; некромантское заклинание позволяет оживить скелет, но охранные чары дают скелету ограниченное осознание окружающего. Ты предполагаешь, что если будешь как-то воздействовать на руны скелета, то он воспримет это как нападение… если только ты сперва не ослепишь его каким-то образом.~
@64298 = ~Обратиться к тому кости и праха и попытаться определить, как можно разрушить руны.~
@64299 = ~Оставить руны и снова осмотреть скелет.~
@64300 = ~Разрушить руны: сначала воздействовать на чары защиты, затем на некромантские, а в конце на охранные чары.~
@64301 = ~Разрушить руны: сначала охранные чары, затем в обратном порядке согласно образцу руны снять некромантские, а потом и защитные чары.~
@64302 = ~Разрушить руны: сначала охранные чары, затем в обратном порядке согласно образцу руны снять некромантские, а потом и защитные чары.~
@64303 = ~Оставить руны и снова осмотреть скелет.~
@64304 = ~НЕБО И ЗЕМЛЯ
Урон: 2-20 дробящий
Зачаровано: +3
Особенности:
   Дробящий урон: +3
   Сила: +2
THAC0: +3
Фактор скорости: 2
Вес: 10
Навык: булава
Доступно: воинам
Доступно: добрым персонажам
Доступно только Безымянному

Грозная аура силы исходит от этого массивного оружия. Древко булавы украшают отчётливые, яркие линии, которые ведут прямо к идеальному шару, служащему наконечником оружия. Прекрасно вырезанные шипы, исходящие из этого шара безупречной формы, одновременно и предостерегают, и вдохновляют. Могущественное оружие окружает вибрирующее сияние цвета королевского пурпура.

Это оружие может взять в руки лишь тот, кто чист сердцем.~
@64305 = ~Долговое обязательство~
@64306 = ~ДОЛГОВОЕ ОБЯЗАТЕЛЬСТВО
Вес: 0

Это долговое обязательство на сумму в тысячу медяков, которые владелец может получить с Борделя Безумной Интеллектуальной Страсти. Тебе его вручила Экко с просьбой купить слёзы дэва. Вряд ли ты сможешь сделать с этим обязательством что-либо ещё.~
@64307 = ~Кастетные кинжалы Шар~
@64308 = ~КАСТЕТНЫЕ КИНЖАЛЫ ШАР
Урон: 1-4 колющий
Зачаровано: +3
Особенности:
   Все спасброски: +2
   Сопротивление магии: +35%
Фактор скорости: 2
Вес: 2
Навык: кулачный бой
Доступно: воинам и ворам

Этими кинжалами когда-то владела Шар, убийца магов. Она была заслуженной наёмной убийцей, которая решила специализироваться на «устранении» магов за большое вознаграждение. Для достижения своих замыслов, Шар поручила магу Тэксу Вуртону создать эти клинки. С этим оружием в руках она весьма преуспела в своём ремесле.

Шар встретила свою гибель, когда её наняли для убийства того самого мага, который изготовил эти кинжалы. Неожиданно для неё, оружие не смогло нанести вред своему создателю. Кинжалы также не дали ей защиту от его заклинаний…~
@64309 = ~МЁРТВЫЙ ЛИМ-ЛИМ
Вес: 5

Этот маленький трупик был твоим ручным зверьком лим-лимом… какая бы сила ни действовала на Негативном материальном плане, она не позволила лим-лиму выжить.~
@64310 = ~«Чт…»~
@64311 = ~«Чт…»~
@64312 = ~«*Теперь-то* что происходит?!..»~
@64313 = ~«*Теперь-то* что происходит?!..»~
@64314 = ~«Куда меня забросит *тепе…*»~
@64315 = ~«Куда меня забросит *тепе…*»~
@64316 = ~Это древнее устройство напоминает забытую военную реликвию. Почти всё оно покрыто пылью, кроме странной панели с рычагами. Как ни странно, земля вокруг панели потревожена, словно «недавно» кто-то здесь ходил — несколько лет назад, возможно.~
@64317 = ~Осмотреть панель в поисках рычага с пометкой «X».~
@64318 = ~Ты быстро находишь рычаг «X» и тянешь его. Он легко уступает твоему прикосновению, а затем распадается в дымку. Ты глубоко вдыхаешь, но, в отличие от прошлого раза… ничего не происходит.~
@64319 = ~Издалека слышится громкий шум, словно *что-то* открылось, а через помещение проносится завывающий ветер. Пока ты пытаешься понять, откуда раздаётся звук, ты вдруг осознаёшь, что распадаешься и сам становишься частью ветра…~
@64320 = ~«*Теперь-то* что происходит?!..»~
@64321 = ~«*Теперь-то* что происходит?!..»~
@64322 = ~«*Теперь-то* что происходит?!..»~
@64323 = ~Осмотреть панель в поисках рычага с пометкой «X».~
@64324 = ~Ты быстро находишь рычаг «X» и тянешь его. Он легко уступает твоему прикосновению, а затем распадается в дымку. Ты глубоко вдыхаешь, и волна головокружения снова одолевает тебя, в то время как стены вокруг исчезают…~
@64325 = ~«Куда меня забросит *тепе…*»~
@64326 = ~«Куда меня забросит *тепе…*»~
@64327 = ~«Куда меня забросит *тепе…*»~
@64328 = ~Осмотреть панель.~
@64329 = ~На панели находится ряд механизмов и рычагов, под каждым — ряд пометок, в спешке нацарапанных кинжалом. Под некоторыми пометок нет, другие же отмечены единичными засечками. Под одним из них нацарапано «X». Не понимая откуда, ты вспоминаешь, что рычаг «X» как-то позволит тебе покинуть это место.~
@64330 = ~Потянуть рычаг, отмеченный «X».~
@64331 = ~Рычаг легко опускается от твоего прикосновения, а затем, к твоему удивлению, разлагается в лёгкий туман… тот окружает кисть твоей руки, которая тоже начинает исчезать, затем всю руку, и в конце концов тебя одолевает головокружение, а стены вокруг исчезают…~
@64332 = ~«Чт…»~
@64333 = ~«Чт…»~
@64334 = ~«Чт…»~
