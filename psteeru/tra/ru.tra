@61943 = ~Morte Taunts 1~ [MRT314B]
@61944 = ~Morte Taunts 2~ [MRT315]
@61945 = ~Игнус~
@61946 = ~Вейлор~
@61947 = ~«Эти крылья у тебя на спине… кто ты?»~
@61948 = ~«Эти крылья у тебя на спине… кто ты?»~
@61949 = ~«Эти крылья у тебя на спине… кто ты?»~
@61950 = ~«Позволь спросить, леди Грейс, эти крылья у тебя на спине… ты не человек, так ведь?»~
@61951 = ~«Позволь спросить, леди Грейс, эти крылья у тебя на спине… ты не человек, так ведь?»~
@61952 = ~«Позволь спросить, леди Грейс, эти крылья у тебя на спине… ты не человек, так ведь?»~
@61953 = ~«Как ты получила имя „Падшая Грейс“?»~
@61954 = ~«Почему тебя зовут „Падшая Грейс“?»~
@61955 = ~«Почему тебя зовут „Падшая Грейс“?»~
@61956 = ~«Почему тебя зовут „Падшая Грейс“?»~
@61957 = ~«Как ты получила имя „Падшая Грейс“?»~
@61958 = ~«Можешь рассказать мне, что ты знаешь о Чующих?»~
@61959 = ~«Можешь обучить меня чему-нибудь из Искусства, Грейс?»~
@61960 = ~«Я хочу поговорить о нас…»~
@61961 = ~«Я хочу поговорить о наших товарищах…»~
@61962 = ~«Ты вообще пользуешься оружием?»~
@61963 = ~«Я хочу спросить о наших странствиях…»~
@61964 = ~«Неважно. Пошли».~
@61965 = ~«На сегодня вопросов больше нет. Прощай».~
@61966 = ~Кири убила Карла Парфидора. Я связался с Робертой и получил своё вознаградждение. Всё сложилось удачно.~
@61967 = ~Карл Парфидор не допускал меня к Товусу Гильяфу, городскому голове Керста. Я решил рассказать ему о том, что его жена Роберта вынашивает планы его убийства. Я наивно надеялся, что в знак благодарности он допустит меня к Товусу. А он пригрозил посадить меня в тюрьму за сообщничество, если я не уйду.~
@61968 = ~«Аукционер Гильтспур хотел, чтобы ты повесил этот листок».~
@61969 = ~На улицу Протяжных Вздохов~
@61970 = ~В Верхний район~
@61971 = ~«У меня вопросы…»~
@61972 = ~«До встречи, Хэмрис».~
@61973 = ~~
@61974 = ~«Почему тебе пришло в голову основать бордель?»~
@61975 = ~«Можно почитать твой дневник?»~
@61976 = ~«Ивес говорила, что у тебя есть история, которой ты не желаешь с ней делиться».~
@61977 = ~«Я бы хотел снова услышать о твоём прошлом».~
@61978 = ~«Похоже, Вришика относится к тебе слишком предвзято, не находишь?»~
@61979 = ~«Можешь рассказать мне об этом символе на моей руке?»~
@61980 = ~«Ты когда-нибудь слышала о ночной ведьме по имени Рейвел?»~
@61981 = ~«Не расскажешь мне о Рейвел ещё раз?»~
@61982 = ~«Что ты знаешь о Кровавой Войне?»~
@61983 = ~«Когда мы были в лабиринте Рейвел, та сказала о твоих муках… тебе больно?»~
@61984 = ~«Вообще-то у меня появился вопрос о другом…»~
@61985 = ~«Неважно. Пошли».~
@61986 = ~«Ты тоже танар'ри?»~
@61987 = ~«Как тебя занесло в Сигил?»~
@61988 = ~«Ясно. Могу я задать другой вопрос?»~
@61989 = ~«Спасибо за разъяснение… пошли».~
@61990 = ~«О, нет необходимости извиняться. Я более чем рада обсудить подобный вопрос, если пожелаешь».~
@61991 = ~«Зачем тебе понадобилось открывать такое заведение?»~
@61992 = ~«Зачем тебе понадобилось открывать такое заведение?»~
@61993 = ~«Если ты из Бездны, то как тебя занесло в Сигил?»~
@61994 = ~«Ясно. Могу я задать другой вопрос?»~
@61995 = ~«Спасибо за разъяснение… пошли».~
@61996 = ~«Прости меня, я не хотел быть столь прямолинейным. Простое любопытство».~
@61997 = ~«Так… зачем?»~
@61998 = ~«Ну, довольно странно для суккуба основывать подобное заведение… это же должно быть противно вашей природе».~
@61999 = ~«Ясно. У меня ещё вопросы…»~
@62000 = ~«Тогда не бери в голову. Могу я задать другой вопрос?»~
@62001 = ~«Мне пора идти. Прощай».~
@62002 = ~«Забудь, обойдусь без разъяснений… пошли».~
@62003 = ~«Мне пора идти. Прощай».~
@62004 = ~«Быть может, ответ на твой вопрос отчасти лежит в философии Общества Восприятия, членом которого я являюсь. Мы верим, что каждый должен на собственном опыте познать мультивселенную настолько, насколько возможно».~
@62005 = ~«Из этих порталов кто-нибудь когда-нибудь появлялся?»~
@62006 = ~«И потому был открыт Бордель?»~
@62007 = ~«У меня ещё вопросы…»~
@62008 = ~«Ясно, я уже всё понял. Могу я задать другой вопрос?»~
@62009 = ~«Мне пора идти. Прощай».~
@62010 = ~«Спасибо за разъяснение… пошли».~
@62011 = ~«Хотелось бы послушать».~
@62012 = ~«Довольно странно для суккуба основывать подобное заведение… это же должно быть противно вашей природе».~
@62013 = ~«У меня ещё вопросы…»~
@62014 = ~«Мне пора идти. Прощай».~
@62015 = ~«Не сейчас. Могу я задать другой вопрос?»~
@62016 = ~«Может, в другой раз… пошли».~
@62017 = ~«Бордель был создан для того, чтобы удовлетворить потребности даже самого искушённого интеллектуала. Он призван стимулировать разум, повышать понимание себя и других, создавать новые пути *познания* окружающих. Он для тех, кто ищет чего-то большего, нежели пустое удовлетворение похоти — этого добра полно и в Улье, и в Нижнем районе».~
@62018 = ~«Я бы не назвал это пустым… ну, то есть, я понимаю. Так Бордель — это своего рода школа?»~
@62019 = ~«Ясно. То есть это заведение поощряет интеллектуальные связи, а не… э-э, связи *иного* рода. Значит, Бордель — это своего рода школа?»~
@62020 = ~«Могу я задать другой вопрос?»~
@62021 = ~«Спасибо за разъяснение… пошли».~
@62022 = ~«Когда-то я был магом, но свернул с пути Искусства. И хотел бы вернуться на него».~
@62023 = ~«Да. Я надеюсь, что обучаясь искусству языка и его тонкостям, посетители и ученики могут глубже познать самих себя. И нет здесь иных границ, кроме уровня владения языком. Пробуждать чувства в других с помощью речи — это высокое и великое искусство».~
@62024 = ~«Если ты из Бездны, то как тебя занесло в Сигил?»~
@62025 = ~«Ясно. Могу я задать другой вопрос?»~
@62026 = ~«Спасибо за разъяснение… пошли».~
@62027 = ~«Верно. Я — из младших танар'ри, точнее, суккуб, — она тихо вздыхает. — Боюсь, нас на Нижних планах развелось уж слишком много, и везде мы думаем только о себе. Большинство из нас тратит своё время на то, чтобы соблазнять смертных разнообразными плотскими утехами».~
@62028 = ~«А ты?..»~
@62029 = ~«Ясно. Могу я задать другой вопрос?»~
@62030 = ~«Я услышал достаточно. Пошли».~
@62031 = ~«Я — из младших танар'ри, точнее, суккуб, — она тихо вздыхает. — Боюсь, нас на Нижних планах развелось уж слишком много, и везде мы думаем только о себе. Большинство из нас тратит своё время на то, чтобы соблазнять смертных разнообразными плотскими утехами».~
@62032 = ~«А ты?..»~
@62033 = ~«Ясно. Могу я задать другой вопрос?»~
@62034 = ~«Я услышал достаточно. Пошли».~
@62035 = ~«Я могу только порадоваться, что мне удалось несколько дистанцироваться от этого… довольно бесполезный способ времяпрепровождения в мультивселенной. В жизни есть и масса другого интересного, не так ли?»~
@62036 = ~«Может быть. Могу я задать другой вопрос?»~
@62037 = ~«Я услышал достаточно. Пошли».~
@62038 = ~«Чующие — это фракция Сигила, которая целиком посвящает себя жизненному опыту. Без опыта, без восприятия мы слепы перед мультивселенной. Таким образом, Чующие ищут столько опыта, сколько возможно. И только с пришедшим опытом открывается истина мультивселенной…»~
@62039 = ~«Интересная философия. Могу ли я присоединиться к Чующим?»~
@62040 = ~«Ясно. Могу я задать другой вопрос?»~
@62041 = ~«Я услышал достаточно. Пошли».~
@62042 = ~Она улыбается: «Чтобы присоединиться, нужно всего лишь учиться у самой жизни».~
@62043 = ~«Я хотел сказать, что заинтересован в присоединении к фракции».~
@62044 = ~«Ясно. Могу я задать другой вопрос?»~
@62045 = ~«Я услышал достаточно. Пошли».~
@62046 = ~«Конечно… прости моё поддразнивание, — Грейс кивает. — Если хочешь присоединиться к Чующим, тебе следует навести справки в Общественном Фестхолле. Там наверняка смогут помочь».~
@62047 = ~«Ясно. Могу я задать другой вопрос?»~
@62048 = ~«Прекрасно. Пошли».~
@62049 = ~«Кровавая Война — это конфликт между баатезу и танар'ри, который бушует на Нижних планах. Они решают между собой вопрос, должно ли зло быть хаотичным, или же законопослушным, — Падшая Грейс ненадолго замолкает. — Этой войны лучше избегать во что бы то ни стало. Пусть баатезу и танар'ри бьются головами, оставив остальные планы в покое… или хотя бы в относительном покое».~
@62050 = ~«В относительном покое?»~
@62051 = ~«А людей они используют?»~
@62052 = ~«И как долго всё это продолжается?»~
@62053 = ~«А тебе в ней приходилось участвовать?»~
@62054 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@62055 = ~«Я услышал достаточно. Пошли».~
@62056 = ~«Ну, война настолько масштабная, что большинство рас в неё вовлечены вопреки желанию. А игнорировать её зачастую так же опасно, как и участвовать».~
@62057 = ~«А людей они используют?»~
@62058 = ~«И как долго всё это продолжается?»~
@62059 = ~«А тебе в ней приходилось участвовать?»~
@62060 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@62061 = ~«Я услышал достаточно. Пошли».~
@62062 = ~«Да, время от времени. В Кровавой Войне участвует множество людей-наёмников. Иногда они — солдаты, иногда — пушечное мясо, а иногда — и просто закуска для извергов».~
@62063 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@62064 = ~«И как долго всё это продолжается?»~
@62065 = ~«А тебе в ней приходилось участвовать?»~
@62066 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@62067 = ~«Я услышал достаточно. Пошли».~
@62068 = ~«Согласно записям хроник, Кровавая Война продолжается с тех пор, когда баатезу впервые встретились с танар'ри. Это было очень, *очень* давно — мне даже неизвестно человеческое слово, которое бы выражало такой большой период, — Падшая Грейс качает головой. — Боюсь, ни баатезу, ни танар'ри неспособны взять верх в этой бесконечной войне».~
@62069 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@62070 = ~«А людей они используют?»~
@62071 = ~«А тебе в ней приходилось участвовать?»~
@62072 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@62073 = ~«Я услышал достаточно. Пошли».~
@62074 = ~«Нет. А вот моя мать участвовала. Суккубы обычно соблазняют смертных и затаскивают их души в Бездну для создания новых танар'ри, которые будут умирать на Кровавой Войне».~
@62075 = ~«Твоя мать служила на Кровавой Войне?»~
@62076 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@62077 = ~«А людей они используют?»~
@62078 = ~«И как долго всё это продолжается?»~
@62079 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@62080 = ~«Я услышал достаточно. Пошли».~
@62081 = ~«Да. Она была из лучших, соблазнила великое множество смертных мужчин. Теперь она живёт в Бездне, зарабатывает продажей своих детей в рабство».~
@62082 = ~«Ты… была продана в рабство своей матерью?»~
@62083 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@62084 = ~«А людей они используют?»~
@62085 = ~«И как долго всё это продолжается?»~
@62086 = ~«Эти вопросы не причиняют тебе беспокойства?»~
@62087 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@62088 = ~«Я услышал достаточно. Пошли».~
@62089 = ~«На некоторое время. Мне удалось завоевать себе свободу в соревновании по импровизации. Это было давным-давно».~
@62090 = ~«И кому она тебя продала?»~
@62091 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@62092 = ~«А людей они используют?»~
@62093 = ~«И как долго всё это продолжается?»~
@62094 = ~«Эти вопросы не причиняют тебе беспокойства?»~
@62095 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@62096 = ~«Я услышал достаточно. Пошли».~
@62097 = ~«О чём они говорили?»~
@62098 = ~«Мне пора идти. Прощай».~
@62099 = ~«О башне?»~
@62100 = ~«У меня ещё вопросы…»~
@62101 = ~«Мне пора идти. Прощай».~
@62102 = ~«Какой ключ?»~
@62103 = ~«Может, секрет входа в том, что нужно не желать войти…»~
@62104 = ~«Расскажи мне, где этот портал».~
@62105 = ~«Она продала меня баатезу. Думаю, она надеялась, что они меня убьют. Несмотря на её обширные познания, она немногое знает об их культуре».~
@62106 = ~«Она продала тебя заклятым врагам танар'ри?»~
@62107 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@62108 = ~«А людей они используют?»~
@62109 = ~«И как долго всё это продолжается?»~
@62110 = ~«Эти вопросы не причиняют тебе беспокойства?»~
@62111 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@62112 = ~«Я услышал достаточно. Пошли».~
@62113 = ~«Да, — Падшая Грейс резко выпрямляется. — Ты хотел узнать что-то ещё?»~
@62114 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@62115 = ~«А людей они используют?»~
@62116 = ~«И как долго всё это продолжается?»~
@62117 = ~«Эти вопросы не причиняют тебе беспокойства?»~
@62118 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@62119 = ~«Я услышал достаточно. Пошли».~
@62120 = ~«О нет, вовсе нет. Тебе следует знать, что Кровавая Война лежит в основе множества событий на планах. Очень важно понимать, чем она является и какое место занимает».~
@62121 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@62122 = ~«А людей они используют?»~
@62123 = ~«И как долго всё это продолжается?»~
@62124 = ~«А тебе в ней приходилось участвовать?»~
@62125 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@62126 = ~«Я услышал достаточно. Пошли».~
@62127 = ~«Мне знакомо это имя, — Падшая Грейс на мгновение замолкает. — Слухи о ней роятся в изобилии, и большинство склонно считать её вымыслом, однако я думаю, что она действительно существовала и наделала большого шуму в Клетке, когда была здесь». Она выглядит озадаченной: «А почему ты спрашиваешь?»~
@62128 = ~«Я намерен её найти».~
@62129 = ~«Неважно. У меня другие вопросы…»~
@62130 = ~«Просто так. Я услышал достаточно. Пошли».~
@62131 = ~Грейс поднимает бровь: «Правда? Я вынуждена спросить: зачем?»~
@62132 = ~«Мне нужна от неё кое-какая информация».~
@62133 = ~«Неважно. У меня другие вопросы…»~
@62134 = ~«Просто так. Я услышал достаточно. Пошли».~
@62135 = ~«И больше спросить не у кого?»~
@62136 = ~«Подозреваю, только Рейвел знает то, что мне нужно».~
@62137 = ~«Неважно. У меня другие вопросы…»~
@62138 = ~«Я не знаю, но собираюсь выяснить. Пошли».~
@62139 = ~Грейс легонько касается твоей руки: «Поразмысли хорошенько: если Рейвел до сих пор существует, тогда она чрезвычайно могущественна и коварна. Если хоть доля слухов о ней — правда, то она не просто воплощение зла, она обогатила само понятие зла новым смыслом. Её поиски — не то, за что стоит браться необдуманно».~
@62140 = ~«Я понимаю».~
@62141 = ~«Что ж, мне никогда не приходилось встречаться с живой легендой. Вот это была бы экскурсия! — она улыбается. — Ты никогда не пробовал заняться чем-нибудь скучным?»~
@62142 = ~«Стараюсь воздерживаться… знаешь ещё что-нибудь о Рейвел?»~
@62143 = ~~
@62144 = ~~
@62145 = ~«По возможности избегаю. Можно мне задать парочку вопросов о другом?»~
@62146 = ~«Может, в других инкарнациях, но не сейчас. Пошли».~
@62147 = ~«Она была одной из ведьм Серой Пустоши и верила, что обладает силами и коварством, превосходящими всё известное её сёстрам. Она появилась в Сигиле давно и принесла такое зло, что оно, согласно легендам, грозило самому существованию Клетки. Теперь же она просто персонаж из сказки, — Грейс прерывается. — Я думаю, Госпожа Боли обошлась с ней, как обходилась со всеми, кто когда-либо угрожал Сигилу».~
@62148 = ~«Как?»~
@62149 = ~«Что такое Серая Пустошь?»~
@62150 = ~«Может о ней знать кто-нибудь ещё?»~
@62151 = ~«Могу я задать вопрос о другом?»~
@62152 = ~«Ясно. Пошли».~
@62153 = ~«Скорее всего, Рейвел была отправлена в лабиринт. Одну из тюрем Госпожи».~
@62154 = ~«Лабиринт? Что это?»~
@62155 = ~«Что такое Серая Пустошь?»~
@62156 = ~«Может о ней знать кто-нибудь ещё?»~
@62157 = ~«Могу я задать вопрос о другом?»~
@62158 = ~«Ясно. Пошли».~
@62159 = ~«План разложения, который фактически лежит „между“ Баатором и Бездной. Там часто проходят сражения Кровавой Войны».~
@62160 = ~«Что ты знаешь о судьбе Рейвел?»~
@62161 = ~«Достаточно о Рейвел… что такое Кровавая Война?»~
@62162 = ~«Может о ней знать кто-нибудь ещё?»~
@62163 = ~«Могу я задать вопрос о другом?»~
@62164 = ~«Ясно. Пошли».~
@62165 = ~«Возможно, о ней больше знает кто-нибудь в Фестхолле».~
@62166 = ~«Что ты знаешь о судьбе Рейвел?»~
@62167 = ~«Что такое Серая Пустошь?»~
@62168 = ~«Могу я задать вопрос о другом?»~
@62169 = ~«Может, туда мы и направимся. Пошли».~
@62170 = ~ПУСТО~
@62171 = ~«Значение имён — очень сложная тема. Тут можно многое сказать, а о многом лучше промолчать».~
@62172 = ~«Падшая Грейс — твоё настоящее имя?»~
@62173 = ~«Ну хорошо. Могу я задать вопрос о другом?»~
@62174 = ~«Всегда пожалуйста, друг. Вот тебе ещё два заклинания; они могут пригодиться. А теперь, с твоего позволения, я вернусь к работе».~
@62175 = ~«Хватить об этом. Пошли».~
@62176 = ~«Возможно, — на её губах играет лёгкая улыбка. — А может быть, и нет. Есть имена, которые дают, а есть и те, которые заслуживают. Кто скажет, какие из них настоящие?»~
@62177 = ~«Прощай».~
@62178 = ~«Пожалуй, важнее заслуженное имя».~
@62179 = ~«Пожалуй, важнее имя, которое дают».~
@62180 = ~«Спасибо, Себастьян».~
@62181 = ~«Думаю, я вообще не придаю именам значения».~
@62182 = ~«Ну хорошо. Могу я задать вопрос о другом?»~
@62183 = ~«Хватить об этом. Пошли».~
@62184 = ~«Может, и так. Обоснуй, почему ты так думаешь?»~
@62185 = ~«Потому что заслуженное имя не случайно: оно говорит о том, чего ты добился».~
@62186 = ~«Может, и так. Обоснуй, почему ты так думаешь?»~
@62187 = ~«Потому что оно определяет, как тебя воспринимают другие. А их восприятие может быть важнее твоего мнения о себе».~
@62188 = ~Она с любопытством смотрит на тебя: «В самом деле?»~
@62189 = ~«Имя — это всего лишь плащ из букв, наброшенный на личность, и не более того. Иногда имя может приоткрыть долю правды об обладателе, порой даже может влиять на личность, но имя не есть *сама* личность».~
@62190 = ~Грейс кивает: «Твоя точка зрения хорошо обоснована».~
@62191 = ~«Так почему тебя зовут Падшей Грейс?»~
@62192 = ~«Так почему тебя зовут Падшей Грейс?»~
@62193 = ~«Так почему тебя зовут Падшей Грейс?»~
@62194 = ~«Разве это важно? — она улыбается. — Это заслуженное имя».~
@62195 = ~«Для меня важно. Я хотел бы знать, как ты получила это имя».~
@62196 = ~«Разве это важно? — она улыбается. — Это имя мне дали».~
@62197 = ~«Для меня важно. Я хотел бы знать, как ты получила это имя».~
@62198 = ~«Разве это важно? — она улыбается. — Это просто плащ из букв».~
@62199 = ~«Для меня важно. Я хотел бы знать, как ты получила это имя».~
@62200 = ~«Я пала для своего народа… некоторые сказали бы — возвысилась, но „пала“ более точно передаёт мои *чувства*, — она вопросительно на тебя смотрит. — Это имеет значение?»~
@62201 = ~«Да, имеет. Кроме прочего, „падение“ означает ещё и потерю».~
@62202 = ~«Да, имеет. Могу я задать ещё кое-какие вопросы?»~
@62203 = ~«Да… пожалуй, я понял. Пошли».~
@62204 = ~Падшая Грейс некоторое время молчит, затем задумчиво кивает: «Да… пожалуй, именно так можно описать мои чувства. Я… смирилась с потерей давным-давно, но имя осталось».~
@62205 = ~«Ты уверена, что смирилась?»~
@62206 = ~«Ты уверена, что смирилась? По-моему, Рейвел иного мнения».~
@62207 = ~«Ты уверена, что смирилась?»~
@62208 = ~«Ты уверена, что смирилась? По-моему, Рейвел иного мнения».~
@62209 = ~«Ну хорошо. Могу я задать вопрос о другом?»~
@62210 = ~«Ясно. Пошли».~
@62211 = ~Падшая Грейс встречается с тобой взглядом, и тебя снова поражает яркий лазурный оттенок её глаз… они глубоки и взволнованны, как море перед штормом. «Я так думала. Но сейчас, в нашем разговоре, ты подвёл меня к осознанию некоторых вещей, — она улыбается. — Я благодарна тебе».~
@62212 = ~«Что ж, если захочешь о них поговорить, дай мне знать, ладно?»~
@62213 = ~«Что ж, если захочешь о них поговорить, дай мне знать, ладно?»~
@62214 = ~«Ну хорошо. Могу я задать вопрос о другом?»~
@62215 = ~«Хорошо. Пошли».~
@62216 = ~Она кивает: «Ты очень добр. Я так и сделаю».~
@62217 = ~«Ну хорошо. Могу я задать вопрос о другом?»~
@62218 = ~«Хорошо. Пошли».~
@62219 = ~Грейс соединяет указательные и большие пальцы обеих рук, образуя грубый круг. «Говорят, сила Госпожи позволяет взять кусочки Сигила… — ты с удивлением наблюдаешь, как призрачные подобия её пальцев отрываются от рук и начинают вращаться в воздухе, образуя небольшой кружок, — …и создать лабиринт».~
@62220 = ~«Продолжай…»~
@62221 = ~«Ясно. Не расскажешь мне больше о плане, откуда родом Рейвел… о Серой Пустоши?»~
@62222 = ~«Думаю, я понял. Может о Рейвел знать кто-нибудь ещё?»~
@62223 = ~«Неважно. Могу я спросить кое о чём другом?»~
@62224 = ~«Ясно. Это всё, что я хотел узнать. Пошли».~
@62225 = ~Небольшой призрачный кружок висит в воздухе и начинает медленно вращаться. «И кусочек Сигила превращается в тюрьму, из которой просто нет выхода. Это может случиться в любой момент, идёшь ли ты по улице или проходишь через дверь… — она хлопает ладонями, — …и вдруг ты где-то в другом месте». Внезапно в центре призрачного круга ты видишь намёк на движение, как будто там кто-то бежит.~
@62226 = ~«Продолжай…»~
@62227 = ~«Ясно. Не расскажешь мне больше о плане, откуда родом Рейвел… о Серой Пустоши?»~
@62228 = ~«Думаю, я понял. Может о Рейвел знать кто-нибудь ещё?»~
@62229 = ~«Неважно. Могу я спросить кое о чём другом?»~
@62230 = ~«Ясно. Это всё, что я хотел узнать. Пошли».~
@62231 = ~Грейс продолжает, маленький призрачный лабиринт отражается в её глазах. «Говорят, есть порталы, которые выводят из любого лабиринта, но их сложно найти. Возможно, они оставлены для того, чтобы дать узнику надежду. Или мучить его, — призрачный лабиринт в её глазах тает. — А может, и то и другое».~
@62232 = ~«Ясно. Не расскажешь мне больше о плане, откуда родом Рейвел… о Серой Пустоши?»~
@62233 = ~«Думаю, я понял. Может о Рейвел знать кто-нибудь ещё?»~
@62234 = ~«Неважно. Могу я спросить кое о чём другом?»~
@62235 = ~«Ясно. Это всё, что я хотел узнать. Пошли».~
@62236 = ~«Да, к сожалению. Но я её не осуждаю».~
@62237 = ~«А почему она сказала, что ты была полковой шлюшкой баатезу?»~
@62238 = ~«А почему она сказала, что ты была полковой шлюшкой баатезу?»~
@62239 = ~«А почему она сказала, что ты была полковой шлюшкой баатезу?»~
@62240 = ~«Почему нет?»~
@62241 = ~«Могу я задать вопрос о другом?»~
@62242 = ~«Ясно. Это всё, что я хотел узнать. Пошли».~
@62243 = ~«Мы уже это обсуждали. Я некоторое время была рабыней баатезу. За то время они причинили мне немало боли».~
@62244 = ~«Ну, мне интереснее узнать насчёт слов Вришики „полковая шлюшка“. Что она имела в виду?»~
@62245 = ~«Тогда забудь. Почему ты сказала, что не осуждаешь Вришику за ненависть к тебе?»~
@62246 = ~«Могу я задать вопрос о другом?»~
@62247 = ~«Это всё, что я хотел знать. Пошли».~
@62248 = ~«Одно время я была рабыней баатезу… давным-давно. Я выиграла свободу в состязании по импровизации».~
@62249 = ~«Ну, мне интереснее узнать насчёт слов Вришики „полковая шлюшка“. Что она имела в виду?»~
@62250 = ~«Ясно. Почему ты сказала, что не осуждаешь Вришику за ненависть к тебе?»~
@62251 = ~«Могу я задать вопрос о другом?»~
@62252 = ~«Это всё, что я хотел знать. Пошли».~
@62253 = ~«Ты ведь наверняка помнишь, что я говорила тебе о своём прошлом?»~
@62254 = ~«Ну, мне интереснее узнать насчёт слов Вришики „полковая шлюшка“. Что она имела в виду?»~
@62255 = ~«Тогда забудь. Почему ты сказала, что не осуждаешь Вришику за ненависть к тебе?»~
@62256 = ~«Могу я задать вопрос о другом?»~
@62257 = ~«Ясно. Это всё, что я хотел узнать. Пошли».~
@62258 = ~Падшая Грейс выглядит удивлённой… некоторое время она изучает тебя, пытаясь прочитать выражение твоего лица. Наконец она произносит, понизив голос: «Это имеет значение?»~
@62259 = ~«Для меня имеет. Я бы хотел знать, с кем путешествую».~
@62260 = ~«Нет, не имеет. Почему ты сказала, что не осуждаешь Вришику за ненависть к тебе?»~
@62261 = ~«Могу я задать вопрос о другом?»~
@62262 = ~«Это всё, что я хотел знать. Пошли».~
@62263 = ~«Отвечаю на твой вопрос: баатезу — не люди. Их страсти относятся к сфере власти, а не плоти, и потому они не получают удовольствия от насилования своих пленников, как это принято среди людей. Пытки баатезу намного более изощрённы и намного более мучительны, чем *любое* плотское насилие, а шрамы держатся намного дольше. Это ты хотел узнать?»~
@62264 = ~«Да. Я просто хотел знать о тех, с кем странствую».~
@62265 = ~«Да. Почему ты сказала, что не осуждаешь Вришику за ненависть к тебе?»~
@62266 = ~«Могу я задать вопрос о другом?»~
@62267 = ~«Это всё, что я хотел знать. Пошли».~
@62268 = ~«А я-то думала, ты уже знаешь, — Падшая Грейс чуть наклоняет голову. — Видимо, я ошибалась».~
@62269 = ~«Почему ты сказала, что не осуждаешь Вришику за ненависть к тебе?»~
@62270 = ~«Могу я задать вопрос о другом?»~
@62271 = ~«Это всё, что я хотел знать. Пошли».~
@62272 = ~«Вришика из танар'ри, изверг как и я, но другого вида — алу-изверг. Чтобы понять её, ты должен усвоить, что культура танар'ри основана на хаосе. Они хаотичны по натуре и плевать хотели на закон или справедливость. Алу-извергов же считают… чужаками. Просто так, без причины. Во многих аспектах это пострашнее, чем смертный приговор».~
@62273 = ~«А почему она сказала, что ты была полковой шлюшкой баатезу?»~
@62274 = ~«А почему она сказала, что ты была полковой шлюшкой баатезу?»~
@62275 = ~«А почему она сказала, что ты была полковой шлюшкой баатезу?»~
@62276 = ~«Ясно. Могу я задать вопрос о другом?»~
@62277 = ~«Это всё, что я хотел знать. Пошли».~
@62278 = ~Падшая Грейс некоторое время хранит молчание, устремив взгляд вдаль. Когда она оборачивается к тебе, её глаза странного оттенка лазури, в них стоят горе и слёзы.~
@62279 = ~«Рейвел многое видит своими чёрно-ежевичными глазами, многое из того, что сокрыто от глаз других, даже веши о твоей собственной природе, — она медленно качает головой. — Иногда… иногда боль прорывается и даёт о себе знать. Я усвоила, что *непросто* отвернуться от своей природы».~
@62280 = ~«Ты в порядке?»~
@62281 = ~«С тобой всё будет хорошо?»~
@62282 = ~«Ясно. Могу я задать вопрос о другом?»~
@62283 = ~«Это всё, что я хотел узнать. Пошли».~
@62284 = ~Её губ касается едва заметная улыбка, а взгляд встречается с твоим: «Да… спасибо за любезный вопрос. Боль всё ещё даёт о себе знать, но я смирилась со своей природой много веков назад».~
@62285 = ~«Тогда лад…»~
@62286 = ~Грейс останавливает тебя, прежде чем ты успеваешь закончить: «Благодарю, что спросил о моём самочувствии. Мне приятно твоё участие».~
@62287 = ~«Просто хотел убедиться, что ты в порядке. У меня другие вопросы…»~
@62288 = ~«Конечно. Я просто хотел знать. Пошли».~
@62289 = ~Падшая Грейс покачивает головой: «Нет, не думаю. Искусство… и те дисциплины, которые практикую я, различны».~
@62290 = ~«Что ты имеешь в виду?»~
@62291 = ~«Тогда забудь. Могу я задать вопрос о другом?»~
@62292 = ~«Это всё, что я хотел узнать. Пошли».~
@62293 = ~«Мои „силы“, каким ты их видишь, проистекают из моей веры, а не из работы с энергиями, как это делается в Искусстве. Искусство есть *механизм*, ставящий тебе на службу силы мультивселенной с помощью жестов, ритуалов и магических устройств. Мои „силы“ приходят ко мне другим образом. Моя вера и природа моего сознания позволяют мне использовать силы мультивселенной».~
@62294 = ~«Вера и природа твоего сознания? Во что ты веришь?»~
@62295 = ~«Ясно. Могу я задать другой вопрос?»~
@62296 = ~«Это всё, что я хотел узнать. Пошли».~
@62297 = ~«Я верю в *жизненный опыт*. Я верю, что личность может изменяться к лучшему по мере постижения всё большей части мультивселенной, и всё больше позволяя мультивселенной познавать себя. Я верю, что сущность опыта позволяет мне…» — она на мгновение прерывается, задумавшись.~
@62298 = ~Ты подходишь к месту, где должен находиться портал, о котором говорил тот парень Лазло. В голове крутится разговор с ним. «Может, секрет входа в том, что нужно не желать войти…» — слышишь ты свой собственный голос.~
@62299 = ~Подавить в себе желание войти в башню.~
@62300 = ~Уйти.~
