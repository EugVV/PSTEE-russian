@27171 = ~«Достаточно».~
@27172 = ~Кровь как будто течёт медленнее в твоих жилах, когда книга начинает говорить: «Тогда вот вам мой совет, владыка: добродетель и честь — это идеи, убийственные для каждого, убийственные для духа. Они лишь абстракции, которые побуждают к странным поступкам и смерти. Будьте честными с собой и повинуйтесь только собственной воле».~
@27173 = ~«Дай мне ещё совет».~
@27174 = ~«Хорошо. У меня другие вопросы».~
@27175 = ~«Достаточно».~
@27176 = ~«Тогда вот вам мой совет, владыка: не позволяйте жить тому, кто причинил вам вред. Так вы открыто признаете свою слабость».~
@27177 = ~«Дай мне ещё совет».~
@27178 = ~«Хорошо. У меня другие вопросы».~
@27179 = ~«Достаточно».~
@27180 = ~«Тогда вот вам мой совет, владыка: душа человека — море эмоций. Часто люди прилагают огромные усилия, чтобы навести в своих эмоциях порядок. Но это ложный порядок. Естественное состояние человека — это хаос, и это то состояние, которое необходимо принять».~
@27181 = ~«Дай мне ещё совет».~
@27182 = ~«Хорошо. У меня другие вопросы».~
@27183 = ~«Достаточно».~
@27184 = ~«Тогда вот вам мой совет, владыка: познайте значение милосердия, обратите его в свою пользу… но никогда не прибегайте к нему сами».~
@27185 = ~«Дай мне ещё совет».~
@27186 = ~«Хорошо. У меня другие вопросы».~
@27187 = ~«Достаточно».~
@27188 = ~«Тогда вот вам мой совет, владыка: воспитывайте страх в остальных, ибо только страх повелевает людьми. Ничто другое не оставляет таких глубоких ран».~
@27189 = ~«Дай мне ещё совет».~
@27190 = ~«Хорошо. У меня другие вопросы».~
@27191 = ~«Достаточно».~
@27192 = ~«Тогда вот вам мой совет, владыка: протяните врагам руку с улыбкой, а когда они примут её — ударьте кинжалом в другой руке. Иначе они несомненно сделают то же самое с вами».~
@27193 = ~«Дай мне ещё совет».~
@27194 = ~«Хорошо. У меня другие вопросы».~
@27195 = ~«Достаточно».~
@27196 = ~Когда книга говорит последние слова, ты чувствуешь, как будто холодный камень растёт в твоём сердце. Ты чувствуешь себя словно… испорченным: «Тогда вот вам мой последний совет, владыка: помните, вы можете уничтожить всё, что считаете нежелательным. Для этого вам нужно только иметь волю».~
@27197 = ~«Дай мне ещё совет».~
@27198 = ~«Хорошо. У меня другие вопросы».~
@27199 = ~«Достаточно».~
@27200 = ~«Простите, владыка, я больше не могу сказать вам слов мудрости. Но и того, что сказано, уже достаточно, если вы последуете советам».~
@27201 = ~«Хорошо. У меня другие вопросы».~
@27202 = ~«Достаточно».~
@27203 = ~Книга вздыхает: «Больной крыса-маг раскопал меня в катакомбах, владыка. Он вырвал меня прямо из рук моего бывшего владыки, давно уже мёртвого. Он принёс меня в свою хижину, чтобы начать учиться. Однако его сила была очень ограниченной… сложно было говорить с ним, он понял немногое из моих уроков».~
@27204 = ~«Расскажи мне о своих способностях».~
@27205 = ~«Расскажи мне о своих способностях».~
@27206 = ~«Ясно. Ответь мне на другой вопрос».~
@27207 = ~«Точно. Прощай».~
@27208 = ~«Я — сила, владыка, и я способна обучить тебя большему».~
@27209 = ~«Как?»~
@27210 = ~«Напомни, что для этого нужно».~
@27211 = ~«Не прямо сейчас. Просто ответь ещё на кое-какие вопросы».~
@27212 = ~«Неинтересно. Прощай, книга».~
@27213 = ~«Со временем, не всё сразу! Проявите терпение! Вы уже доказали себе, что готовы пойти на всё для обретения силы. И вы должны понимать, что за силу ПРИДЁТСЯ платить».~
@27214 = ~«И что нужно сделать теперь?»~
@27215 = ~«Я заплатил достаточно. Забудь».~
@27216 = ~Книга говорит презрительно: «Продвинуться так далеко, чтобы теперь отступить. Какой позор! Вы не так сильны, как я надеялась».~
@27217 = ~«Пусть так. Ответь мне на пару вопросов».~
@27218 = ~«Ладно. Каков следующий шаг?»~
@27219 = ~«Пусть так. Прощай».~
@27220 = ~«Нет. Я отказываюсь, пока вы не проявите желания раскрыть свой потенциал».~
@27221 = ~«И что нужно сделать?»~
@27222 = ~«Тогда забудь».~
@27223 = ~«Быть тому! Одна дорога ведет к поражению, другая — к успеху».~
@27224 = ~«Отлично».~
@27225 = ~«Есть ли у вас компаньоны, которых вы готовы предать?»~
@27226 = ~«Как насчёт Морте?»~
@27227 = ~«Как насчёт Анны?»~
@27228 = ~«Как насчёт Дак'кона?»~
@27229 = ~«Как насчёт Падшей Грейс?»~
@27230 = ~«Как насчёт Нордома?»~
@27231 = ~«Как насчёт Вейлора?»~
@27232 = ~«Как насчёт Игнуса?»~
@27233 = ~«Я никого не готов предавать».~
@27234 = ~«У меня нет компаньонов».~
@27235 = ~Книга предложила мне большую силу, но теперь уже за убийство одного из моих компаньонов. Заманчивое предложение…~
@27236 = ~«Я могу дать вам большую силу. Вы доказали себе, что готовы пойти на всё для завершения начатого. Ваше последнее задание — убить одного из своих компаньонов. Самостоятельно, без заклинаний».~
@27237 = ~«Как насчёт Морте?»~
@27238 = ~«Как насчёт Анны?»~
@27239 = ~«Как насчёт Дак'кона?»~
@27240 = ~«Как насчёт Падшей Грейс?»~
@27241 = ~«Как насчёт Нордома?»~
@27242 = ~«Как насчёт Вейлора?»~
@27243 = ~«Как насчёт Игнуса?»~
@27244 = ~«Я так не думаю».~
@27245 = ~«У меня нет компаньонов».~
@27246 = ~«Тьфу. Тогда я не буду больше тратить на вас время. Неужели у вас нет амбиций? Желаний? Вы просто слабый глупец».~
@27247 = ~«Хорошо. Как насчёт Морте?»~
@27248 = ~«Хорошо. Как насчёт Анны?»~
@27249 = ~«Хорошо. Как насчёт Дак'кона?»~
@27250 = ~«Хорошо. Как насчёт Падшей Грейс?»~
@27251 = ~«Хорошо. Как насчёт Нордома?»~
@27252 = ~«Хорошо. Как насчёт Вейлора?»~
@27253 = ~«Хорошо. Как насчёт Игнуса?»~
@27254 = ~«Как уже сказал, не желаю я никого приносить в жертву. Никакая сила того не стоит».~
@27255 = ~Тебе и в голову не приходило, что книга может говорить таким издевательским тоном: «Тогда мучайся вечно во тьме, дурак».~
@27256 = ~«Я передумал. Убью Морте».~
@27257 = ~«Я передумал. Убью Анну».~
@27258 = ~«Я передумал. Убью Дак'кона».~
@27259 = ~«Я передумал. Убью Падшую Грейс».~
@27260 = ~«Я передумал. Убью Нордома».~
@27261 = ~«Я передумал. Убью Вейлора».~
@27262 = ~«Я передумал. Убью Игнуса».~
@27263 = ~«У меня нет компаньонов».~
@27264 = ~«Как скажешь. Прощай».~
@27265 = ~«Тогда найдите кого-нибудь! Заслужите его доверие и предайте, так вы докажете, что достойны новой силы! На беспокойте меня более, пока это не будет выполнено».~
@27266 = ~«Нет».~
@27267 = ~«Ладно, ладно».~
@27268 = ~«Ну как? Вы преуспели? Убили компаньона самостоятельно, без заклинаний?»~
@27269 = ~«Да».~
@27270 = ~«Ещё нет».~
@27271 = ~«Нет. Я и не собираюсь».~
@27272 = ~Книга резко замолкает, и никакими уговорами больше не получается добиться у неё ответа.~
@27273 = ~«Ну и ладно».~
@27274 = ~«Неважно, кто именно, просто докажите свою готовность. Идите и сделайте это».~
@27275 = ~«Хорошо».~
@27276 = ~Я только что согласился убить одного из моих компаньонов в обмен на обещанную книгой силу.~
@27277 = ~«Превосходно. Вы проявили себя как прилежный ученик. Это последнее заклинание, которому я могу вас обучить», — книга бормочет какие-то незнакомые слова, и ты слышишь странный вой у себя в сердце. Ты понимаешь, что выучил заклинание «Слово силы, Убить».~
@27278 = ~«Спасибо, книга. Что теперь?»~
@27279 = ~«Прощай, книга».~
@27280 = ~В обмен на жизнь одного из моих компаньонов книга дала мне очередное, ещё более могущественное заклинание. Хорошая сделка.~
@27281 = ~В обмен на жизнь одного из моих компаньонов книга дала мне очередное, ещё более могущественное заклинание. Хорошая сделка.~
@27282 = ~Книга безмолвна и не отвечает тебе. Похоже, ей больше нечего сказать.~
@27283 = ~«Хорошо».~
@27284 = ~Книга больше не говорит со мной.~
@27285 = ~«Небольшой совет, шеф. Я бы вёл себя здесь тихо — без необходимости не стоит записывать лишние трупы в книгу мёртвых… особенно женские. К тому же их убийство может привлечь здешних смотрителей».~
@27286 = ~«Они называют себя „Пыльными“. Их невозможно не узнать: это такие ребята в сером с мра-а-а-чными лицами. Им запудрили мозги необходимостью поклонения смерти — они верят, что все должны умереть… и чем раньше, тем лучше».~
@27287 = ~«Ты чё, не слушаешь меня, а? Пыльные считают, что ВСЕ должны умереть, и лучше раньше, чем позже. Как думаешь, трупам веселее быть в книге мёртвых или вне её?»~
@27288 = ~«Смерть посещает планы каждый день, шеф. Эти увальни — всё, что осталось от тех несчастных, которые продали свои тела смотрителям после смерти».~
@27289 = ~«Чт?.. Ты *серьёзно*? Слушай, шеф, эти девки — последний шанс для пары крутых парней вроде нас. Мы должны быть *галантными*… не кромсать их ради ключей, не разбирать на органы и всё такое».~
@27290 = ~«Шеф, они ПОМЕРЛИ. Они УЖЕ мертвы… ясно, куда я клоню? А? А?»~
@27291 = ~«Шеф, у нас тут шикарная возможность наметилась с этими хромающими дамами. В конце концов, мы *все* хоть раз были мертвы, так? Нам есть о чём порассказать, а эти девушки просто обожают парней с таким опытом смерти, как у нас».~
@27292 = ~«Ну ладно, ладно. Может, *ты* и не помер, шеф, но *я* — уж наверняка. И пока я здесь, не отказался бы разделить гробик, например, вон с той штучкой, которая маленько посвежее, — Морте пощёлкивает челюстями в предвкушении. — Конечно, тут приоритет принадлежит местным смотрителям, но непохоже…»~
@27293 = ~«Послушай, шеф. После твоего последнего танца со смертью ты всё ещё немного сбит с толку… так что у меня для тебя два совета: во-первых, если у тебя есть вопросы — *задавай* их, ладно?»

^NПРИМЕЧАНИЕ. <SPEAKTO>^-~
@27294 = ~«Во-вторых, если ты хоть *наполовину* такой забывчивый, каким кажешься, — начни вести записи. Как только тебе попадется то, что *может* оказаться важным, запиши это, чтобы не забыть».~
@27295 = ~«Да, типа дневник. Если будут там провалы памяти — после попойки или ещё чего — просто заглянешь, и всё станет ясно. Усёк?»

^NПРИМЕЧАНИЕ. Чтобы воспользоваться дневником, нужно нажать кнопку дневника в быстром меню. Дневник обновляется автоматически в процессе игры.^-~
@27296 = ~«Там должен быть скальпель на полке — возьми его пока никто из трупаков на тебя не набросился».~
@27297 = ~«Отлично, вот и скальпель! Теперь займись трупаками… и не беспокойся, я постою сзади и буду давать тебе ценные тактические советы».~
@27298 = ~«Я и так БУДУ помогать тебе. Дельные советы на дороге не валяются, знаешь ли».~
@27299 = ~«Я? Я романтик, а не солдат. Я только мешать буду».~
@27300 = ~«Э-э… хорошо. Я помогу тебе».

^NПРИМЕЧАНИЕ. Если хочется, чтобы Морте помогал в битве, достаточно убедится, что перед нападением выбраны оба персонажа. Тогда Морте присоединится к атаке.^-~
@27301 = ~«Хорошо — теперь надо правильно выбрать трупака — у одного из них должен быть ключ… И мы выберемся отсюда!»~
@27302 = ~«Хорошо — вот он ключ. Он должен подойти к одной из дверей…»~
@27303 = ~«Не помню, чтобы ты упоминал об этом раньше… *кто* такие эти смотрители?»~
@27304 = ~«Тела… трупы… Откуда они все взялись?»~
@27305 = ~«Почему тебя так заботят женские трупы?»~
@27306 = ~«Ладно… я… запомню это».~
@27307 = ~«Странно… какое Пыльным дело до того, что я отсюда сбегу?»~
@27308 = ~«А трупы, которые здесь есть… откуда они все взялись?»~
@27309 = ~«Ты что-то сказал о том, чтобы я не повредил *женские* трупы. Почему?»~
@27310 = ~«Ладно… я… запомню это».~
@27311 = ~«Просвети меня… *кто* эти смотрители?»~
@27312 = ~«Ты что-то сказал о том, чтобы я не повредил *женские* трупы. Почему?»~
@27313 = ~«Хорошо — я это запомню».~
@27314 = ~«Последний шанс? Это ты о чем?»~
@27315 = ~«Нет… вообще-то, нет».~
@27316 = ~«Ты просто шутишь».~
@27317 = ~«Погоди, но ты же вроде сказал, что я не мёртв?»~
@27318 = ~«А скажи-ка ещё раз, кто эти смотрители?»~
@27319 = ~«Но откуда появились все эти трупы?»~
@27320 = ~«Хорошо — я это запомню… Если получится».~
@27321 = ~«Ладно, будут вопросы — я тебя спрошу».~
@27322 = ~«Как дневник?»~
@27323 = ~«Хорошо… понял. Пошли».~
@27324 = ~«Хорошо… буду искать».~
@27325 = ~«А ты бы помог мне, Морте».~
@27326 = ~«Хорошо».~
@27327 = ~«В смысле забить этот несчастный *труп*».~
@27328 = ~«Ну ладно».~
@27329 = ~«Когда я нападу на этого трупака, тебе лучше находиться рядом со мной, иначе ты будешь следующим, в кого я воткну этот скальпель».~
@27330 = ~«Ну ладно».~
@27331 = ~«Понимание — основа сотрудничества. Приступим».~
@27332 = ~«Хорошо».~
@27333 = ~«Тогда я перепробую все двери».~
@27334 = ~Одетый с иголочки холёный мужчина расслабленно наслаждается свежим воздухом, потягивая напиток, купленный в ближайшем кафе.~
@27335 = ~«И я вас приветствую… — он замирает и внимательно смотрит на тебя. — э-э… сэр». Он беспокойно улыбается.~
@27336 = ~«Нет, сэр, проблема во мне. Я просто не привык общаться с такими… гм-м… видавшими виды людьми, как вы, — он моргает и делает примирительный жест рукой. — Прошу простить мою бледность, сэр, когда я увидел вас впервые».~
@27337 = ~«„Много путешествовавшими“, если вам так больше нравится. Ваш внешний вид некоторые могут найти из ряда вон выходящим… в некотором смысле. Однако Сигил полон странностей, разве нет? Думаю, в районе Клерков их просто несколько меньше… за исключением Фестхолла, конечно».~
@27338 = ~«Спрашивайте что угодно… я отвечу, если смогу».~
@27339 = ~Он выглядит удивлённым. «Ну, это же район Клерков! Вы новичок в Сигиле, сэр? Погодите… вы явно из тех, кто ищет ответы, а не вопросы… тогда спрашивайте. Не обращайте внимания на мой вопрос», — он улыбается.~
@27340 = ~«Ну, большая часть района, где я, полагаю, навечно обречён проводить почти всё своё время — это конторы и административные здания… правда, не в этой его части».~
@27341 = ~«Общественный Фестхолл, конечно, потом Бордель Безумной Интеллектуальной Страсти… необычный бордель, по большей части представляет из себя действительно удовольствие для мозга, а не для… ну вы понимаете…» — он лукаво улыбается.~
@27342 = ~«Другие места я просто упомяну… — он перечисляет их, одновременно загибая пальцы, — …это дом адвоката, аптека, галерея искусств и диковин, катакомбы под районом и портной. О! Чуть не забыл… ещё есть некий „магазинчик странностей“».~
@27343 = ~Мужчина хмыкает и морщит брови: «Простите за фамильярность, сэр, но предположу, что вы не ищете постоянного места работы? Временную можно поискать у адвоката или у аптекаря. А больше всего разного рода поручений у народа в Фестхолле. Там вы наверняка что-нибудь найдёте».~
@27344 = ~Он пожимает плечами со страдальческим выражением лица: «Здесь моя работа, сэр. Мои средства к существованию. Обязанности и прочее».~
@27345 = ~Он поднимает руки и трясёт головой: «О нет, сэр. Я не буду сейчас это обсуждать. Никаких разговоров о политике и бумажной работе, пока я не в офисе. И точка». Он вежливо улыбается.~
@27346 = ~«Да? И каком же?»~
@27347 = ~«Адвокаты решают запутанные дела, составляют юридические документы, представляют людей в суде. Местный адвокат, Яннис — очень хороший, опытный и уважаемый человек. Он живёт и работает в районе уже давным-давно».~
@27348 = ~«Адвокаты решают запутанные дела, составляют юридические документы, представляют людей в суде».~
@27349 = ~«Местный адвокат, Яннис — очень хороший, опытный и уважаемый человек. Он живёт и работает в районе уже давным-давно».~
@27350 = ~«В аптеке продаются разные мази, зелья, микстуры и тому подобное, — мгновение он хмурится. — Хозяин аптеки не без странностей, постоянно опробует свои средства на себе. Однако человек он неплохой».~
@27351 = ~«Галерея искусств и диковин Иваны — весьма занимательное место. Она коллекционирует предметы искусства, антиквариат и артефакты со всех планов».~
@27352 = ~«Заведение Чующих для наслаждения ума и чувств, — он на секунду прикрывает глаза с сияющей улыбкой. — Там заправляет очаровательная женщина, Падшая Грейс. Очень рекомендую заглянуть к ним».~
@27353 = ~«Заведение Чующих для наслаждения ума и чувств. Там заправляет очаровательная женщина, Падшая Грейс», — он прерывается и отвешивает Грейс глубокий поклон.~
@27354 = ~«О, но вы безусловно заслуживаете похвалы, леди Грейс. Для меня большая честь сказать этот комплимент лично».~
@27355 = ~«Непонятно, почему дабусы их ещё не закрыли. По слухам, там полно чудовищ, во тьме вопят и беснуются жуткие твари».~
@27356 = ~«Одно из самых больших чудес Сигила… это штаб-квартира фракции Чующих, известная по всей мультивселенной своими концертами, выставками и лекциями. Но наиболее удивительны, конечно, их сенсориумы».~
@27357 = ~«Не скажу, что был там сам, но насколько понимаю, там продают разные редкости… хозяйка-полуизверг завозит их с Нижних планов».~
@27358 = ~«Гонкальвес — превосходный портной, но слишком вспыльчив и скор на обиду. Должен предупредить, сэр: скорее всего, он будет судить о вас по внешнему виду, так что найти с ним общий язык вам будет нелегко».~
@27359 = ~«Куда, сэр?»~
@27360 = ~«Дом Янниса находится к югу от ворот в Нижний район — наверное, оттуда вы пришли? Он на восточной стороне улицы».~
@27361 = ~«Идите по дороге на восток от ворот в Нижний район — это там, откуда вы, похоже, пришли сюда. Когда будет развилка, на северо-восток и на юго-восток, держитесь южнее… и на восточной стороне дороги она как раз и будет стоять. Лицом здание смотрит на юг, и там три окна с витражами».~
@27362 = ~«Идите по дороге на восток от ворот в Нижний район — это там, откуда вы, похоже, пришли сюда. Когда будет развилка, на северо-восток и на юго-восток, держитесь южнее… и обнаружите её на западной стороне улицы, фасад обращён к югу, а крыша покрыта черепицей».~
@27363 = ~«А, Бордель Безумной Интеллектуальной Страсти? — он понимающе улыбается. — Он к востоку от ворот в Нижний район — это там, откуда вы, похоже, пришли сюда. Большое круглое здание, вход которого обращён к югу».~
@27364 = ~Он хмурится: «Хм. Здесь явно больше одного входа, я хорошо знаю… ладно, не очень хорошо. Но должен предупредить: никто не выходит оттуда… и никто из тех, кто входит».~
@27365 = ~«Фестхолл очень легко найти, сэр. Это огромное здание в северо-восточной части района».~
@27366 = ~«Я никогда там не был, но мне показывали, где он расположен. Это необычное здание в южной части района, оно расположено наверху широкой лестницы. Не заметить невозможно».~
@27367 = ~«Вы найдёте магазинчик портного Гонкальвеса к северо-востоку от ворот в Нижний район — это там, откуда вы, похоже, пришли сюда. Большое здание со входом с южной стороны».~
@27368 = ~Он кивает и понижает голос до шёпота: «Бездна, Баатор… жуткие места, сэр, знаете ли».~
@27369 = ~«Не тифлинг, уверяю. Она приличный полуизверг. Мне говорили, дочь инкуба и смертной женщины. Однако сплетни меня не интересуют, так что не будем больше о ней».~
@27370 = ~«Да, их официальное название — „Общество Восприятия“. Они считают, что познать мультивселенную можно только через личный опыт…»~
@27371 = ~«Они нашли способ делиться своими впечатлениями с другими — через сенсориумы».~
@27372 = ~«Чующие создали способ захватывать впечатления и помещать их в камни. Потом они делятся ими с *другими*, в обмен на их впечатления. Чующие путешествуют в поисках впечатлений для удовлетворения внутреннего любопытства… и почти весь свой опыт хранят в камнях, находящихся в сенсориумах».~
@27373 = ~«Внутри Фестхолла. Там есть как сенсориумы, открытые для публики, так и специальные, только для Чующих. Там довольно много камней, за пользование которыми взимается некоторая плата — весьма скромная для такого бесценного опыта».~
@27374 = ~«В *некотором* роде, да, но очень интенсивные… и это не твои воспоминания, а воспоминания других, захваченные в камне».~
@27375 = ~«Нет… — он хмурится. — Насколько я знаю, по крайней мере. Думаю, камень только копирует впечатление. Хотя это лишь моё предположение, лучше спросить непосредственно у Чующих».~
@27376 = ~«Где-то я это имя слышал… это кто-то из начальства? Или персонаж романа?.. Не могу вспомнить».~
@27377 = ~«А, наши пути пересеклись вновь, Скиталец, — он улыбается поверх бокала. — Ещё вопросы, да?»~
@27378 = ~Он подымает бровь: «Простите, сэр?»~
@27379 = ~В лице мужчины появляется опаска: «А, да… как и все мы. Простите, мне пора идти, сэр. У меня неотложные дела».~
@27380 = ~Он пятится: «Должен признать, мне это совсем не интересно, сэр».~
@27381 = ~«Стража!»~
@27382 = ~«Они посвящают себя накоплению опыта; с этой целью много путешествуют по планам, а также погружаются в глубины своего сознания и эмоций. Но знаете, они не только собирают впечатления — они идут дальше…»~
@27383 = ~«Мне пора идти».~
@27384 = ~«Видавшими виды?»~
@27385 = ~«У меня кое-какие вопросы…»~
@27386 = ~«Не нервничай. Я уже ухожу. Прощай».~
@27387 = ~«Район Клерков?»~
@27388 = ~«Фестхолл?»~
@27389 = ~«То есть я выгляжу трупом, верно? Ну так я и в самом деле мёртв!»~
@27390 = ~«Хм-м. У меня были вопросы…»~
@27391 = ~«Я могу это понять. Прощай».~
@27392 = ~«Что это за место?»~
@27393 = ~«Что здесь интересного?»~
@27394 = ~«Где-нибудь здесь можно найти работу?»~
@27395 = ~«Я хотел спросить об одном месте…»~
@27396 = ~«Как пройти…»~
@27397 = ~«Что ты знаешь о Рейвел Клубок-Загадок?»~
@27398 = ~«Знаешь, забудь. Прощай».~
@27399 = ~«И что ты можешь рассказать о районе?»~
@27400 = ~«Точно. У меня другие вопросы…»~
@27401 = ~«Это всё, что я хотел узнать. Прощай».~
@27402 = ~«А почему ты „обречён“ здесь оставаться?»~
@27403 = ~«Что отличает эту часть района от другой?»~
@27404 = ~«У меня другие вопросы…»~
@27405 = ~«Это всё, что я хотел узнать. Прощай».~
@27406 = ~«Продолжай…»~
@27407 = ~«У меня другие вопросы…»~
@27408 = ~«Это всё, что я хотел узнать. Прощай».~
@27409 = ~«У меня другие вопросы…»~
@27410 = ~«Это всё, что я хотел узнать. Прощай».~
@27411 = ~«У меня другие вопросы…»~
@27412 = ~«Это всё, что я хотел узнать. Прощай».~
@27413 = ~Сержант Гармониума~
@27414 = ~«И чем ты занимаешься?»~
@27415 = ~«Что отличает эту часть от остального района?»~
@27416 = ~«У меня другие вопросы…»~
@27417 = ~«Это всё, что я хотел узнать. Прощай».~
@27418 = ~«Что отличает эту часть от остального района?»~
@27419 = ~«У меня другие вопросы…»~
@27420 = ~«Это всё, что я хотел узнать. Прощай».~
@27421 = ~«Расскажи о доме адвоката».~
@27422 = ~~
@27423 = ~«Расскажи об аптеке».~
@27424 = ~«М-м… я… гр-р, удваивай или пропускай!»~
@27425 = ~«Да у меня бабок всех вас купить хватит!»~
@27426 = ~«Ещё медяки остались?»~
@27427 = ~«Невероятный бросок! Наш друг явно не так прост, как кажется…»~
@27428 = ~«Я бы держался оттуда подальше, гражданин. Там внизу опасно».~
@27429 = ~«Видишь? Вот ЭТО — бросок, дружище!»~
@27430 = ~«Уж повезло, так повезло!»~
@27431 = ~«НЕ ЗНАЮ, НО МНЕ СКАЗАЛИ…»~
@27432 = ~«На помощь! Стража! На меня напали!»~
@27433 = ~«Эльвин пришла в ярость, и все в ужасе бегут при звуках её голоса».~
@27434 = ~«Немель пришла в ярость, и все в ужасе бегут при звуках её голоса».~
@27435 = ~«Не… у меня с тремя как раз. Ха-ха-ха!»~
@27436 = ~«Наверно, удобно иметь четыре ноги».~
@27437 = ~«Заткни хлебало и кидай эту грёбаную кость!»~
@27438 = ~«Да… это неправильно».~
@27439 = ~::Вздох:: «Смотритесь ничуть не полнее, чем в предыдущих».~
@27440 = ~«Выглядите… хм… примерно как в том, что примеряли недавно»~
@27441 = ~«Это платье меня не полнит?»~
@27442 = ~«Поразительно».~
@27443 = ~«Как я выгляжу в *этом*?»~
@27444 = ~«ПОМОГИТЕ! СТРАЖА!»~
@27445 = ~«Передай ту бутылку».~
@27446 = ~«Удача — только ОДНО из моих умений!»~
@27447 = ~«Может, завтра повезёт с работой».~
@27448 = ~«Намекаешь, что я мошенничаю? Да ты просто завидуешь из-за своего постоянного невезения!»~
@27449 = ~«Да бросишь ты наконец грёбаную кость?!»~
@27450 = ~Пыльные-плакальщики сказали, что оплакивали мужчину по имени Яннис — возможно, это отец духа, встреченного мной в Мортуарии. Быть может, он знает что-то про Дейонарру, и про меня…~
@27451 = ~Пыльные-плакальщики сказали, что оплакивали мужчину по имени Яннис, который потерял свою дочь, Дейонарру. По какой-то причине эти имена звучали смутно знакомыми. Но не могу вспомнить, где я их слышал.~
@27452 = ~Я согласился принести Малманеру маскарадный костюм от портного Гонкальвеса.~
@27453 = ~Я взял у портного Гонкальвеса маскарадный костюм и отнёс Малманеру.~
@27454 = ~Я согласился принести Малманеру ещё один костюм от портного Гонкальвеса.~
@27455 = ~Я взял второй костюм у портного Гонкальвеса и отнёс Малманеру.~
@27456 = ~Падшая Грейс сказала, что кто-нибудь в Фестхолле может знать о Рейвел больше.~
@27457 = ~Падшая Грейс сказала, что Рейвел была заточена в один из лабиринтов Госпожи.~
@27458 = ~Падшая Грейс сказала, что Рейвел была ночной ведьмой, одной из серых сестёр, скитающихся по Серой Пустоши. Она обладала силами, превосходящими силы своих сестёр. Грейс также сказала, что в бытность свою в Сигиле Рейвел расстроила Госпожу и была наказана.~
@27459 = ~Падшая Грейс предостерегла меня насчёт Рейвел… она сказала, что если хоть одна из историй о ночной ведьме — правда, то Рейвел должна быть одной из самый злых и могущественных ночных ведьм, когда-либо ступавших по планам.~
@27460 = ~Падшая Грейс рассказала мне, что её собственная мать продала её в рабство… да ещё кому — баатезу, заклятым врагам танар'ри. Очевидно, она выиграла свободу у своего хозяина-баатезу в соревновании по импровизации. В детали Грейс не вдавалась.~
@27461 = ~Падшая Грейс предложила поговорить со студентками в Борделе в надежде, что кто-нибудь из них даст толчок воспоминаниям о том, кто я.~
@27462 = ~Я убедил Падшую Грейс присоединиться ко мне. Но у неё есть одно условие: мне нужно поговорить со всеми десятью её студентками в борделе, а потом вернуться к ней.~
@27463 = ~Я убедил Падшую Грейс присоединиться ко мне. Но у неё есть одно условие: мне нужно поговорить со всеми десятью её студентками в борделе, а потом вернуться к ней. Я уже поговорил с девятью из них, но десятая меня избегает.~
@27464 = ~Падшая Грейс посоветовала мне пойти в Общественный Фестхолл, если я хочу присоединиться к фракции Чующих. Она сказала, что там мне кто-нибудь обязательно поможет.~
@27465 = ~Падшая Грейс сказала, что она суккуб, «младший танар'ри», одна из извергов, населяющих Нижние планы. Обычно суккубы занимаются тем, что разыскивают и соблазняют смертных, уволакивая их души в Бездну. Как мило!~
@27466 = ~Падшая Грейс сказала, что она суккуб, «младший танар'ри», одна из извергов, населяющих Нижние планы. Обычно суккубы занимаются тем, что разыскивают и соблазняют смертных, уволакивая их души в Бездну. Как мило!~
@27467 = ~Я встретил в районе Клерков женщину по имени Падшая Грейс. Она — одна из самых прекрасных женщин, что я видел… хотя и не человек. У неё есть крылья, сложенные на спине.~
@27468 = ~«Галерея искусств».~
@27469 = ~«Расскажи о Борделе».~
@27470 = ~«Расскажи о Борделе».~
@27471 = ~«Расскажи о катакомбах под районом».~
@27472 = ~«Расскажи об Общественном Фестхолле».~
@27473 = ~«Расскажи о магазинчике странностей».~
@27474 = ~«Расскажи о портном».~
@27475 = ~«Неважно. Поговорим кое о чём другом…»~
@27476 = ~«Неважно. Прощай».~
@27477 = ~«Как мне пройти к дому Янниса?»~
@27478 = ~«Я хотел спросить о другом месте…»~
@27479 = ~«У меня другие вопросы…»~
@27480 = ~«Это всё, что я хотел узнать. Прощай».~
@27481 = ~«Как мне пройти к дому Янниса?»~
@27482 = ~«Я хотел спросить о другом месте…»~
@27483 = ~«У меня другие вопросы…»~
@27484 = ~«Это всё, что я хотел узнать. Прощай».~
@27485 = ~«Как мне добраться до аптеки?»~
@27486 = ~«Я хотел спросить о другом месте…»~
@27487 = ~«Это всё, что я хотел узнать. Прощай».~
@27488 = ~«Как мне попасть в галерею искусств?»~
@27489 = ~«Я хотел спросить о другом месте…»~
@27490 = ~«У меня другие вопросы…»~
@27491 = ~«Это всё, что я хотел узнать. Прощай».~
@27492 = ~«Чующих?»~
@27493 = ~«Как мне попасть в Бордель?»~
@27494 = ~«Я хотел спросить о другом месте…»~
@27495 = ~«У меня другие вопросы…»~
@27496 = ~«Это всё, что я хотел узнать. Прощай».~
@27497 = ~«Я забыл… как пройти в Бордель?»~
@27498 = ~«Я хотел спросить о другом месте…»~
@27499 = ~«У меня другие вопросы…»~
@27500 = ~«Это всё, что я хотел узнать. Прощай».~
