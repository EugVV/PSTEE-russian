@7562  = ~Схватить её за руку.~
@7563  = ~«Эй! Что ж ты делаешь?!»~
@7564  = ~Подставиться, чтобы женщина ещё раз залезла к тебе в карман, и проследить за её техникой.~
@7565  = ~Оставить его в покое.~
@7566  = ~Подставиться, чтобы женщина ещё раз залезла к тебе в карман, и проследить за её техникой.~
@7567  = ~Подставиться, чтобы женщина ещё раз залезла к тебе в карман, и проследить за её техникой.~
@7568  = ~Напасть на неё.~
@7569  = ~Игнорировать инцидент, уйти.~
@7570  = ~Схватить её за руку.~
@7571  = ~Схватить её за руку.~
@7572  = ~Схватить её за руку.~
@7573  = ~«Эй! Что ж ты делаешь?!»~
@7574  = ~Напасть на неё.~
@7575  = ~Игнорировать инцидент, уйти.~
@7576  = ~«Верни, что спёрла. Немедленно».~
@7577  = ~Сломать ей шею свободной рукой.~
@7578  = ~Отпустить её и уйти.~
@7579  = ~«Мы в расчёте. И больше чтобы я тебя не видел. Ясно?»~
@7580  = ~Блеф: «Если хочешь жить, отдавай всё, что у тебя есть».~
@7581  = ~Правда: «Если хочешь жить, отдавай всё, что у тебя есть».~
@7582  = ~Кивнуть в знак благодарности и сломать ей шею свободной рукой.~
@7583  = ~Отпустить её и уйти.~
@7584  = ~«Я сказал *всё*, так что отдавай мне *всё*».~
@7585  = ~«Чтобы я тебя больше не видел. Ясно?»~
@7586  = ~Кивнуть в знак благодарности и сломать ей шею свободной рукой.~
@7587  = ~Отпустить её и уйти.~
@7588  = ~«Неплохо. И больше чтобы я тебя не видел. Ясно?»~
@7589  = ~Кивнуть в знак благодарности и сломать ей шею свободной рукой.~
@7590  = ~Отпустить её и уйти.~
@7591  = ~Сломать ей шею свободной рукой.~
@7592  = ~Отпустить её и уйти.~
@7593  = ~Опустить её тело.~
@7594  = ~Опустить её тело.~
@7595  = ~Уйти.~
@7596  = ~Уйти.~
@7597  = ~«Проклятье…»~
@7598  = ~«В чём дело?»~
@7599  = ~«Что ты?..»~
@7600  = ~«Хм… ты уверена, Анна?»~
@7601  = ~«Убери эти клинки, дьявол побери, пока *моё* терпение не лопнуло, хорошо?»~
@7602  = ~«Извини, женщина, сегодня явно не твой день. Отдавай деньги».~
@7603  = ~«Отпусти её, Анна. Она того не стоит».~
@7604  = ~«Убери эти клинки, дьявол побери, пока *моё* терпение не лопнуло, хорошо?»~
@7605  = ~«Отпусти её, Анна. Она того не стоит».~
@7606  = ~«Я не дам её тронуть, пока не докажешь, что она действительно провинилась».~
@7607  = ~«Последний раз говорю. Убери оружие и отпусти её».~
@7608  = ~«Ну и что? Она того не стоит».~
@7609  = ~«Убирайся, женщина. И лучше бы мы тебя тут больше не видели».~
@7610  = ~«Женщина, лучше уходи».~
@7611  = ~«Кажется, ты была права, Анна. Ладно, женщина, отдавай, что спёрла».~
@7612  = ~«Неважно. Забудь, Анна».~
@7613  = ~«Убирайся, женщина. И лучше тебе тут больше не показываться».~
@7614  = ~«Прощай».~
@7615  = ~«Прощай».~
@7616  = ~«Прощай».~
@7617  = ~«Прощай».~
@7618  = ~Ты уже собираешься уйти, как вдруг чувствуешь, что чего-то не хватает. Охваченный подозрением, ты снова бросаешь взгляд на мужчину и замечаешь, как он вытаскивает руку из твоего кошелька… нельзя сказать с уверенностью, но похоже, он что-то у тебя стащил.~
@7619  = ~Схватить его руку.~
@7620  = ~Схватить его руку.~
@7621  = ~«Эй! Что ж ты делаешь?!»~
@7622  = ~Подставиться, чтобы мужчина ещё раз залез к тебе в карман, и наблюдать за его приёмами.~
@7623  = ~«Я сказал, „приветствую“».~
@7624  = ~Подставиться, чтобы мужчина ещё раз залез к тебе в карман, и наблюдать за его приёмами.~
@7625  = ~Подставиться, чтобы мужчина ещё раз залез к тебе в карман, и наблюдать за его приёмами.~
@7626  = ~Напасть на него.~
@7627  = ~Игнорировать инцидент, уйти.~
@7628  = ~Ты резко вскидываешь руку и мёртвой хваткой вцепляешься в его запястье. Мужчина издаёт сдавленный выкрик и отчаянно вырывается.~
@7629  = ~Тихо: «Не дёргайся, или рука останется у меня».~
@7630  = ~«Не дёргайся, мать твою!»~
@7631  = ~Напасть на него.~
@7632  = ~Отпустить его.~
@7633  = ~Он оказывается расторопнее и вырывает руку раньше, чем ты успеваешь схватить её. С криком он убегает вдаль по улице.~
@7634  = ~«Ну и ладно…»~
@7635  = ~Мужчина от неожиданности подпрыгивает, а затем бросается бежать.~
@7636  = ~«Ну и ладно…»~
@7637  = ~Он продолжает вырываться. Удерживать его становится всё труднее.~
@7638  = ~Напасть на него.~
@7639  = ~Отвесить ему тумака свободной рукой, чтобы привлечь внимание.~
@7640  = ~Отпустить его.~
@7641  = ~Возможно, твои собственные навыки карманной кражи заставляют тебя насторожиться, но уже уходя, ты инстинктивно проверяешь кошелёк… и застаёшь там руку мужика. Кажется, он не заметил твоего внимания.~
@7642  = ~Схватить его руку.~
@7643  = ~Схватить его руку.~
@7644  = ~«Эй! Что ж ты делаешь?!»~
@7645  = ~Подставиться, чтобы мужчина ещё раз залез к тебе в карман, и наблюдать за его приёмами.~
@7646  = ~Пусть уходит.~
@7647  = ~Подставиться, чтобы мужчина ещё раз залез к тебе в карман, и наблюдать за его приёмами.~
@7648  = ~Подставиться, чтобы мужчина ещё раз залез к тебе в карман, и наблюдать за его приёмами.~
@7649  = ~Напасть на него.~
@7650  = ~Игнорировать инцидент, уйти.~
@7651  = ~Ты втягиваешь мужчину в разговор ни о чём и незаметно наблюдаешь, как он работает. А делает он следующее: во-первых, прикидывается заблудившимся обеспеченным горожанином, чтобы усыпить бдительность жертвы, во-вторых, отвлекает её внимание, тыча рукой в различных направлениях… когда жертва поворачивается вслед за жестом, мужчина запускает руки в кошелёк и тащит его содержимое в свои рукава (очень длинные). Ты откладываешь эту технику в памяти… как раз во время очередного вторжения в твой кошелёк.~
@7652  = ~Схватить его руку.~
@7653  = ~Схватить его руку.~
@7654  = ~«Эй! Что ж ты делаешь?!»~
@7655  = ~Напасть на него.~
@7656  = ~Игнорировать инцидент, уйти.~
@7657  = ~Кажется, в твоём тоне было *нечто* особенное, потому как он перестаёт вырываться и как загипнотизированный смотрит на тебя.~
@7658  = ~«Верни, что спёр. Немедленно».~
@7659  = ~Отпустить его и уйти.~
@7660  = ~Он кивает и начинает выгружать карманы. Тебе достаётся пригоршня монет, куда больше, чем было похищено… пропала-то всего пара десятков медяков.~
@7661  = ~«Нет, остальное забери обратно… чужого мне не надо».~
@7662  = ~«Ну, мы в расчёте. И больше чтоб я тебя не видел. Ясно?»~
@7663  = ~Блеф: «Отдай мне всё, что у тебя есть, и я пощажу тебя».~
@7664  = ~Правда: «Отдай мне всё, что у тебя есть, и я пощажу тебя».~
@7665  = ~Кивнуть в знак благодарности и напасть.~
@7666  = ~Отпустить его и уйти.~
@7667  = ~Он удивлённо смотрит на тебя, как если бы ты его надул. Затем пожимает плечами и ссыпает излишек к себе в карман.~
@7668  = ~«Ну, мы в расчёте. И больше чтоб я тебя не видел. Ясно?»~
@7669  = ~Напасть на него.~
@7670  = ~«Э-э… — он сглатывает. — Это всё, здоровяк. Больше нету».~
@7671  = ~Отпустить его и уйти.~
@7672  = ~«Я сказал *всё, что есть*, так что отдай мне *всё, что есть*».~
@7673  = ~«Хорошо. И чтоб я тебя больше не видел. Ясно?»~
@7674  = ~«Тогда попрощайся со своей жизнью. Сейчас ты умрёшь».~
@7675  = ~Отпустить его и уйти.~
@7676  = ~Он кивает.~
@7677  = ~Двинуть ему как следует, чтобы дошло.~
@7678  = ~Напасть на него.~
@7679  = ~Отпустить его и уйти.~
@7680  = ~Твой кулак въезжает ему в челюсть, и он растягивается на булыжной мостовой. Придерживая рукой челюсть, он стонет и, пошатываясь, встаёт. Похоже, несколько его зубов выбито.~
@7681  = ~«А теперь исчезни».~
@7682  = ~Хук левой приходится ему в шею, он снова вскрикивает. Слегка пошатываясь и придерживая свободной рукой место удара, он поворачивается к тебе.~
@7683  = ~«Ну, ты меня слушаешь?»~
@7684  = ~Он молча кивает.~
@7685  = ~«Отдай назад всё, что у меня стащил».~
@7686  = ~«Без разницы, что ты там у меня спёр… но чтобы я тебя больше не видел. Никогда. Ясно?»~
@7687  = ~Он снова кивает.~
@7688  = ~Двинуть ему как следует, чтобы дошло.~
@7689  = ~Напасть на него.~
@7690  = ~Отпустить его и уйти.~
@7691  = ~Ты видишь того же мужчину, что и в прошлый раз… он опять выглядит заблудившимся и бормочет, разглядывая дома.~
@7692  = ~«Приветствую».~
@7693  = ~Пройти мимо.~
@7694  = ~Он вздрагивает, когда ты обращаешься к нему; похоже, он нервничает. «Э-э… ещё раз здравствуйте, почтенный, — кажется, он приободряется. — Простите, не могу ли я снова воспользоваться вашей любезностью и попросить указать мне дорогу?»~
@7695  = ~«И куда же указать дорогу в этот раз?»~
@7696  = ~«Нет, не сегодня».~
@7697  = ~«Это правда! У меня больше ничего нету!»~
@7698  = ~«Хорошо. И чтоб я тебя больше не видел. Ясно?»~
@7699  = ~«Тогда прощайся со своей жизнью. Сейчас ты умрёшь».~
@7700  = ~Отпустить его и уйти.~
@7701  = ~Когда ты отворачиваешься, Анна вдруг подходит вплотную и толкает тебя.~
@7702  = ~«Что ты делаешь?»~
@7703  = ~Анна снова кивает на мужчину, который всё ещё стоит и разглядывает дома. «Этот сигильский подонок тебя обчистил, — она улыбается. — Ты бы лучше смотрел за своими карманами, чем греметь шкатулкой с кем попало, так совсем без медяков останешься».~
@7704  = ~«Ты о чём?»~
@7705  = ~Она вынимает из кармана пригоршню монет и отдаёт их тебе: «Все медяки обратно у хозяина, ага?» Анна бросает ещё один взгляд назад. «Во жульё недоделанное, в карман не может залезть, чтоб все колокола в Сигиле не затрезвонили. Он у тебя спёр, а я у него, — она улыбается. — Ага?»~
@7706  = ~«Э-э… а ты уверена, что это моё, Анна?»~
@7707  = ~«Эй… спасибо».~
@7708  = ~«Ась?» — Анна хмурится и хлещет себя хвостом. «*Уверена*?! — она отходит от тебя. — Ты мне не веришь?» Она сплёвывает: «Неважно».~
@7709  = ~«Мне важно. Если это не наши деньги…»~
@7710  = ~«Тогда забудем».~
@7711  = ~«Э? — Анна шипит как кошка. — Совсем *тупой*?! Он тебя обчистил, он. Если ты совсем ослеп и не видишь, то так тебе и надо!»~
@7712  = ~«А чем докажешь?»~
@7713  = ~«Тогда забудем».~
@7714  = ~Анна на некоторое время замолкает, затем выхватывает деньги из твоей руки и швыряет их на землю. Ты смотришь, как монеты скачут по мостовой, подскакивают на камнях и падают в грязь. «Так пусть он их и забирает! — Анна плюёт тебе под ноги. — Ты в *любом* случае их недостоин!»~
@7715  = ~«Держи себя в руках. Пошли».~
@7716  = ~Анна кивает и нехорошо улыбается: «Ага, всегда пожалуйста».~
@7717  = ~«Хорошо. Пошли».~
@7718  = ~Оставить существо в покое.~
@7719  = ~Существо медленно наклоняет голову, чтобы взглянуть на тебя. Его чешуйчатый лоб недовольно хмурится, затем оно открывает рот и издаёт низкое шипение, переходящее в рычание. Ты замечаешь, что выделяемый существом жар начинает усиливаться.~
@7720  = ~«Я хотел немного поговорить с тобой».~
@7721  = ~«Я хотел немного поговорить с тобой».~
@7722  = ~«Я хотел немного поговорить с тобой».~
@7723  = ~Оставить существо в покое.~
@7724  = ~Существо открывает рот, обнажая ряд почерневших клыков. Вокруг его плеч и рук пляшет пламя, существо издаёт длинное, низкое шипение.~
@7725  = ~«Тихо ты! Я просто хотел поговорить».~
@7726  = ~Прошипеть в ответ.~
@7727  = ~Оставить существо в покое.~
@7728  = ~Существо издаёт дикий рёв и кидается на тебя!~
@7729  = ~«Я уже сказал, что не собираюсь этого делать!»~
@7730  = ~Защищаться…~
@7731  = ~Существо скрипуче шипит, его голос похож на скрежет грубых камней. Шипение продолжается несколько секунд, скрипучий голос повышается и понижается.~
@7732  = ~«Хм… что?»~
@7733  = ~Оставить существо в покое.~
@7734  = ~Существо рычит. «НЕЧЕГО тебе с-с-сказать, — глаза изверга сужаются до щёлочек. — Ес-с-сли не уйдёш-ш-шь, твоя тёплая кровь з-з-зальёт камни».~
@7735  = ~«Я просто хотел задать кое-какие вопросы…»~
@7736  = ~«Ну попробуй, и посмотрим, чья кровь в итоге зальёт камни».~
@7737  = ~Отступить и оставить существо в покое.~
@7738  = ~Существо вдруг с шумом втягивает воздух, затем отворачивается со странным шипением. Похоже, оно унюхало какой-то неприятный запах.~
@7739  = ~«Я сказал, что хочу поговорить с тобой».~
@7740  = ~«Я сказал, что хочу поговорить с тобой».~
@7741  = ~Оставить существо в покое.~
@7742  = ~Глаза существа останавливаются на Анне, затем сужаются до щёлочек. Оно открывает рот, обнажая ряд почерневших клыков. Вокруг плеч и рук существа пляшет пламя, исходящий от него жар усиливается.~
@7743  = ~«Эй! Я к тебе обращаюсь!»~
@7744  = ~Оставить существо в покое, забрать Анну и уйти.~
@7745  = ~Глаза существа останавливаются на Падшей Грейс, затем сужаются до щёлочек. Оно открывает рот, обнажая ряд почерневших клыков. Вокруг плеч и рук существа пляшет пламя, исходящий от него жар усиливается.~
@7746  = ~«Эй! Я к тебе обращаюсь!»~
@7747  = ~Отступить, забрать Падшую Грейс и уйти.~
@7748  = ~Существо издаёт дикий рёв и кидается на Анну!~
@7749  = ~«Проклятье!..»~
@7750  = ~Существо издаёт дикий рёв и кидается на Падшую Грейс!~
@7751  = ~«Проклятье!..»~
@7752  = ~Эта покрытая чёрной чешуёй рептилия возвышается на восемь футов. Её огромный рост, однако, компенсируется тонким, как у змеи, телом. Длинный цепкий хвост волочится сзади, кожистые крылья собраны за спиной. От существа исходит резкий неприятный запах… а вдобавок ещё и жар. Кажется, оно тебя не замечает.~
@7753  = ~«Приветствую».~
@7754  = ~~
@7755  = ~~
@7756  = ~~
@7757  = ~~
@7758  = ~Оставить абишая в покое.~
@7759  = ~Кажется, Пыльный услышал тебя, но не поднимает головы.~
@7760  = ~Все Пыльные выдерживают один и тот же тон и ритм. Песнь каждые несколько минут усиливается почти до крика, затем медленно затихает до еле слышного эха. Один раз она совсем прерывается, Пыльные произносят несколько фраз во славу «Истинной Смерти» и начинают свои завывания снова.~
@7761  = ~Пыльный поднимает голову. Он не прекращает пение, выдерживая тот же ритм и тон, что и остальные.~
@7762  = ~Пыльный ничего не отвечает, вместо этого он вновь склоняет голову и продолжает песнопение.~
@7763  = ~Плакальщик внезапно останавливается и изучает тебя. «Ты тоскуешь о том, кто умер?»~
@7764  = ~«Мы оплачем твою боль и боль её отца, если не возражаешь».~
@7765  = ~«Мы оплачем твою боль, если ты этого хочешь».~
@7766  = ~«Мы оплачем твою боль, если ты этого хочешь».~
@7767  = ~«Мы оплачем её боль, если она не возражает».~
@7768  = ~«Мы оплачем его боль, если он не возражает».~
@7769  = ~Пыльный кивает и продолжает пение.~
@7770  = ~Пыльный склоняет голову и продолжает пение.~
@7771  = ~«Мы оплакиваем».~
@7772  = ~«Мы не оплакиваем мёртвых. Мы оплакиваем живых».~
@7773  = ~«Мы оплакиваем живых, страдающих от потери».~
@7774  = ~«Когда душа достигает Истинной Смерти, она чаще всего освобождается от груза проблем. Когда же умер не ты, а дорогой тебе человек, часто возникает боль и чувство потери».~
@7775  = ~«Эй, шеф! — Морте перебивает тебя, пока ты ещё не заговорил с существом. — Задвинься. Ты ж не собираешься греметь костями с каждым извергом на дороге. Пошли».~
@7776  = ~«Я хотел задать ему пару вопросов…»~
@7777  = ~Оставить существо в покое.~
@7778  = ~«Не-а, не хотел, — Морте бросает взгляд на существо, затем поворачивается к тебе и понижает голос до шёпота. — Они очень чувствительны. Пошли лучше».~
@7779  = ~«Я рискну».~
@7780  = ~Оставить существо в покое.~
@7781  = ~«Отчаяние и чувство потери — очень сильные чувства. Такие чувства привязывают живущего к этой форме существования, мешая ему достичь Истинной Смерти, когда смерть приходит к нему. Мы плачем о живых, находящихся в плену этих страстей».~
@7782  = ~«Иногда её называют окончательной смертью. Истинная Смерть — свобода от этого призрачного, мучительного существования. Свобода от чувств. Свобода от разума. Свобода от телесной оболочки».~
@7783  = ~Пыльный кивает: «Некоторые называют её и так, хотя это не совсем точно».~
@7784  = ~Пыльный ждёт.~
@7785  = ~Все Пыльные выдерживают один и тот же тон и ритм. В отличие от того песнопения, которое ты слышал при первом визите в мемориал, эта песнь циклична, похожа на ритм волн, набегающих на берег. Эта мысль почему-то будоражит твою память…~
@7786  = ~Ты смутно припоминаешь себя стоящим на далёком берегу… где-то в другом месте, далеко отсюда. С тобой женщина. Она стоит слева от тебя, на самой границе твоего бокового зрения, и ты не можешь разглядеть её фигуру. Когда ты пытаешься оживить воспоминание, оно пропадает…~
@7787  = ~…и ты снова оказываешься в толпе Пыльных-плакальщиков. Они поют так тихо, что их почти не слышно. Затем они прерываются, говорят несколько фраз во славу «Истинной Смерти» и снова начинают петь.~
@7788  = ~Все Пыльные выдерживают один и тот же тон и ритм. В отличие от того песнопения, которое ты слышал при первом визите в мемориал, эта песнь намного выше по тону и напоминает свист стрелы или посвист ветра в скалах. Песнь быстро начинается и быстро заканчивается — когда Пыльные замолкают, они говорят несколько фраз во славу «Истинной Смерти» и снова начинают петь.~
@7789  = ~Все Пыльные выдерживают один и тот же тон и ритм. В отличие от того песнопения, которое ты слышал при первом визите в мемориал, эта песнь несёт в себе силу и долю случайности — она непредсказуема, кажется, звук изменяется прямо на губах поющих. Но всё равно Пыльные прекрасно выдерживают эту дикую мелодию. Когда песнь наконец стихает почти до полной тишины, Пыльные говорят несколько фраз во славу «Истинной Смерти» и снова начинают петь.~
@7790  = ~В отличие от того песнопения, которое ты слышал при первом визите в мемориал, эта песнь тянется на одной ноте, вот уже несколько минут… она напоминает тебе звон огромного колокола. После окончания Пыльные какой-то миг молчат, затем говорят несколько фраз во славу «Истинной Смерти» и снова начинают петь свою «песнь».~
@7791  = ~В отличие от того песнопения, которое ты слышал при первом визите в мемориал, эта песнь более утончённа; временами они поют так тихо, что кажется, сейчас звук пропадёт в уличном шуме. Наконец Пыльные примерно на минуту полностью замолкают, затем говорят несколько фраз во славу «Истинной Смерти» и снова начинают петь свою «песнь».~
@7792  = ~Пыльный безучастно смотрит на тебя: «Наша песнь не менялась. Мы продолжали петь ту же самую песнь, что и начали».~
@7793  = ~Пыльный качает головой: «Наверное, изменился ты сам».~
@7794  = ~«Я оплакиваю Янниса. Он глубоко опечален потерей своей первой и единственной дочери, Дейонарры».~
@7795  = ~«Мы оплакиваем тебя, скорбящего о потере».~
@7796  = ~«Мы скорбим вместе с женой Ангияра, оплакивающей свою утрату».~
@7797  = ~«Мы оплакиваем Адана, скорбящего о потере».~
@7798  = ~Пыльный кивает, затем склоняет голову и продолжает петь.~
@7799  = ~Плакальщик внезапно останавливается и изучает тебя: «Тот, за кого ты просишь, тоскует об умершем?»~
@7800  = ~«Мы оплачем твою боль, если ты этого хочешь».~
@7801  = ~«Обстоятельства её смерти мне неизвестны».~
@7802  = ~«Мы оплачем его боль, если он не против».~
@7803  = ~В отличие от того песнопения, которое ты слышал при первом визите в мемориал, мелодию этой песни трудно вычленить. Слушая, ты улавливаешь странные модуляции, как будто звуки впитываются в воздух. Наконец Пыльные примерно на минуту полностью замолкают, затем говорят несколько фраз во славу «Истинной Смерти» и снова начинают петь свою песнь.~
@7804  = ~«Мы оплакиваем того, о ком ты говоришь, кто скорбит о потере».~
@7805  = ~Когда ты уже готов заговорить с существом, Морте вздыхает.~
@7806  = ~«Да?»~
@7807  = ~«О, ничего… ты знаешь, жизнь — лучший учитель». Он кивает на существо: «Продолжай».~
@7808  = ~«С твоего позволения продолжу».~
@7809  = ~«Хорошо, забудь. Пошли».~
@7810  = ~Уйти.~
@7811  = ~«Я хотел немного поговорить с тобой».~
@7812  = ~Слушать пение.~
@7813  = ~Слушать пение.~
@7814  = ~Слушать пение.~
@7815  = ~Слушать пение.~
@7816  = ~Слушать пение.~
@7817  = ~Слушать пение.~
@7818  = ~Слушать пение.~
@7819  = ~Уйти.~
@7820  = ~«Приветствую».~
@7821  = ~Оставить их со своим пением.~
@7822  = ~«Нет! — Анна приходит в ужас. — Нет, только не греми с ними костями! Эти изверги тебя живьём съедят!»~
@7823  = ~«Что вы делаете?»~
@7824  = ~«Я оплакиваю мёртвого».~
@7825  = ~«Я прошу за того, кто потерял близкого».~
@7826  = ~«Я хотел задать ему пару вопросов…»~
@7827  = ~«Хорошо, хорошо. Пошли отсюда».~
@7828  = ~«Прости, что потревожил тебя. Прощай».~
@7829  = ~Анна качает головой: «Выпотрошат и съедят, точно говорю».~
@7830  = ~«Я рискну».~
@7831  = ~Оставить существо в покое.~
@7832  = ~«Ты *тупой*?! — вклинивается Анна, её хвост хлещет взад-вперёд. — Совсем не слышишь, чё я говорю?! Не греми шкатулкой с извергами!»~
@7833  = ~«Я рискну».~
@7834  = ~«Ладно, ладно. Оставлю его в покое… пошли».~
@7835  = ~«Да ты прям сказочный идиот, вот ты кто!» — Анна сплёвывает. Она в бешенстве. «Ты пробкой вылетишь из этой жизни, и тогда я наконец от тебя избавлюсь!»~
@7836  = ~«Я буду просто счастлив. А теперь дай мне поговорить».~
@7837  = ~«Я быстро. Остынь».~
@7838  = ~«Ладно, ладно. Оставлю его в покое… пошли».~
@7839  = ~«Я хотел бы поговорить с тобой».~
@7840  = ~Слушать пение.~
@7841  = ~Слушать пение.~
@7842  = ~Слушать пение.~
@7843  = ~Слушать пение.~
@7844  = ~Слушать пение.~
@7845  = ~Слушать пение.~
@7846  = ~Слушать пение.~
@7847  = ~Оставить его в покое.~
@7848  = ~«Нет. Смерть не взволнует моих чувств».~
@7849  = ~Правда: «Да… я полагаю, что в ответе за смерть невинно убиенной женщины, Дейонарры. Не только эта боль гложет меня, но и вина перед её отцом, которому я причинил столько горя».~
@7850  = ~Правда: «Да… я виновен в смерти невинно убиенного мужчины, Хакарии. Его потеря волнует меня».~
@7851  = ~Правда: «Да… я виновен в смерти многих невинных на разных планах. Это причиняет мне боль едва ли не большую, чем я могу вынести».~
@7852  = ~«Это не я. Это женщина, жена Ангияра, которая потеряла сына. Она очень тяжело переживает своё горе».~
@7853  = ~Ложь: «Нет, ну, я про своего друга, э-э… Адан его зовут — это он скорбит по умершему».~
@7854  = ~«Да, эта недавняя смерть повергла меня в страшное горе и отчаяние».~
@7855  = ~«Ну, э-э, перед тем как я расскажу, я хотел спросить тебя…»~
@7856  = ~«Если бы вы могли, это облегчило бы боль её отца и мою».~
@7857  = ~«Нет, не нужно. Прощай».~
@7858  = ~«Если бы вы могли, это облегчило бы мою боль».~
@7859  = ~«Нет, не нужно. Прощай».~
@7860  = ~«Если бы вы могли, это облегчило бы мою боль».~
@7861  = ~«Нет, не нужно. Прощай».~
@7862  = ~«Если бы вы могли, это облегчило бы её боль».~
@7863  = ~«Нет, не нужно. Прощай».~
@7864  = ~«Если бы вы могли, это облегчило бы его боль».~
@7865  = ~«Нет, не нужно. Прощай».~
@7866  = ~Слушать пение.~
