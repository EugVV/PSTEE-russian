@27538 = ~«Что ты знаешь об этом месте?»~
@27539 = ~Бармен~
@27540 = ~Головорез района Клерков~
@27541 = ~Раненая трокопотака~
@27542 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27543 = ~«Ясно, спасибо. Прощай».~
@27544 = ~«Что ты можешь рассказать о Борделе?»~
@27545 = ~«Что ты можешь рассказать о Борделе?»~
@27546 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27547 = ~«Ясно, спасибо. Прощай».~
@27548 = ~«Что ещё можешь о них рассказать?»~
@27549 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27550 = ~«Ясно, спасибо. Прощай».~
@27551 = ~«Что ты можешь рассказать о Фестхолле?»~
@27552 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27553 = ~«Что ты можешь рассказать о Фестхолле?»~
@27554 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27555 = ~«Ясно, спасибо. Прощай».~
@27556 = ~«Что ты знаешь об этом месте?»~
@27557 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27558 = ~«Ясно, спасибо. Прощай».~
@27559 = ~«Что ты можешь рассказать об этом месте?»~
@27560 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27561 = ~«Ясно, спасибо. Прощай».~
@27562 = ~«Ты сказал, что она полуизверг?»~
@27563 = ~«А как можно найти этот магазинчик странностей?»~
@27564 = ~«Я хотел спросить о другом месте…»~
@27565 = ~«У меня другие вопросы…»~
@27566 = ~«Это всё, что я хотел узнать. Прощай».~
@27567 = ~«Так ты говоришь, она завозит товар с Нижних планов?»~
@27568 = ~«А как можно найти этот магазинчик странностей?»~
@27569 = ~«Я хотел спросить о другом месте…»~
@27570 = ~«У меня другие вопросы…»~
@27571 = ~«Это всё, что я хотел узнать. Прощай».~
@27572 = ~«Ясно. Продолжай».~
@27573 = ~«У меня другие вопросы…»~
@27574 = ~«Это всё, что я хотел узнать. Прощай».~
@27575 = ~«Сенсориумы?»~
@27576 = ~«У меня другие вопросы…»~
@27577 = ~«Это всё, что я хотел узнать. Прощай».~
@27578 = ~«А где находятся эти сенсориумы?»~
@27579 = ~«Эти впечатления… они как воспоминания?»~
@27580 = ~«У меня другие вопросы…»~
@27581 = ~«Это всё, что я хотел узнать. Прощай».~
@27582 = ~«Где находится Фестхолл?»~
@27583 = ~«Эти впечатления… они как воспоминания?»~
@27584 = ~«У меня другие вопросы…»~
@27585 = ~«Это всё, что я хотел узнать. Прощай».~
@27586 = ~«Захваченные? Погоди, а тот кто отдаёт воспоминания, он что, сам всё забывает?»~
@27587 = ~«А где находятся эти сенсориумы?»~
@27588 = ~«У меня другие вопросы…»~
@27589 = ~«Это всё, что я хотел узнать. Прощай».~
@27590 = ~«У меня другие вопросы…»~
@27591 = ~«Это всё, что я хотел узнать. Прощай».~
@27592 = ~«Не бери в голову. У меня ещё вопросы…»~
@27593 = ~«Неважно. Прощай».~
@27594 = ~«Верно».~
@27595 = ~«Вообще-то нет… просто мимо проходил. Прощай».~
@27596 = ~«Я сказал: „Я мёртв!“ Мёртв, мёртв, ха-ха! Мёртв, мёртв, ха-ха…»~
@27597 = ~«Не бери в голову. У меня были кое-какие вопросы…»~
@27598 = ~«Неважно. Прощай».~
@27599 = ~«Погоди! Я ещё не сказал *почему* я мёртв…»~
@27600 = ~«Подожди минуту. У меня кое-какие вопросы…»~
@27601 = ~«Тогда прощай».~
@27602 = ~«Потому что в предыдущих жизнях я убил слишком много народу».~
@27603 = ~«Тогда забудь. У меня кое-какие вопросы…»~
@27604 = ~«Тогда прощай».~
@27605 = ~Напасть на него.~
@27606 = ~Попытаться скрыться, пока никто не явился.~
@27607 = ~«Как это?»~
@27608 = ~«У меня другие вопросы…»~
@27609 = ~«Это всё, что я хотел узнать. Прощай».~
@27610 = ~«Никак не могу найти работу».~
@27611 = ~«О, перестань! Я и с закрытыми глазами так девять раз брошу!»~
@27612 = ~«Столько мусора вокруг».~
@27613 = ~«Выпить бы сейчас».~
@27614 = ~«Хотелось бы мне пожрать».~
@27615 = ~*Тяжело дышит*~
@27616 = ~*Кашляет*~
@27617 = ~«Холодная будет ночка».~
@27618 = ~«А вот тебе! Уверен, что расплатиться сумеешь? Ха-ха-ха!»~
@27619 = ~Эта огромная фигура в доспехах красного цвета стоит на месте и внимательно следит за прохожими. Ты смутно вспоминаешь: такие знаки и узоры на броне свидетельствуют, что перед тобой — офицер Гармониума, тот, кто охраняет порядок в городе.~
@27620 = ~Оставить его в покое.~
@27621 = ~Когда он говорит, его взгляд скорее скользит по жителям района, чем по тебе: «Проходи».~
@27622 = ~Хотя его внимание по-прежнему обращено главным образом на прохожих, он удостаивает тебя быстрым взглядом: «Нечего тебе тут делать. Проходи».~
@27623 = ~Он качает головой: «Тогда поговори с гражданами. У меня служба… и я не брошу её ради ради разговора с тобой или кем бы то ни было. Проходи».~
@27624 = ~Он поднимает оружие. «Нужна помощь? Было совершено преступление?»~
@27625 = ~Он вздыхает. «Я понимаю, что у тебя вопросы, гражданин, в другое время и в другом месте я бы охотно помог. Но… — он прерывается и подозрительно смотрит на прохожего, затем возвращается взглядом к тебе. — Но теперь не время и не место, так что… просто проходи, уважаемый. Сейчас же».~
@27626 = ~«Смотри, пень, у меня… — он прерывается и подозрительно смотрит на прохожего, затем возвращается взглядом к тебе. — У меня есть определённого рода работа, и она не будет выполнена, если я буду отрываться на разговоры со всяким тупоголовым, который хочет знать, как найти такого-то или пройти туда-то. Проходи».~
@27627 = ~Он пожимает плечами, вызвав бряцание доспехов: «Можешь и постоять тут, но не приставай к стражам порядка, если не хочешь нажить… неприятностей. Прощай».~
@27628 = ~Этот офицер Гармониума внимательно осматривает улицу. Ты смутно чувствуешь, что встречал этого парня раньше, но определённо сказать нельзя. Бравые ребята в закрытых шлемах и одинаковых доспехах Гармониума все на одно лицо.~
@27629 = ~Ты понимаешь, что это член Гармониума, фракции, которая с недавних пор тебя преследует. Кажется, он тебя пока не заметил.~
@27630 = ~Даже через прорези шлема ты видишь, как его глаза расширяются: «Это он!» Он выхватывает оружие и вопит: «Взять его, живым или мёртвым!»~
@27631 = ~«Приветствую…»~
@27632 = ~«Приветствую…»~
@27633 = ~«У меня кое-какие вопросы…»~
@27634 = ~Уйти.~
@27635 = ~«Мне всего-то нужны ответы на пару вопросов…»~
@27636 = ~«Мне нужна твоя помощь…»~
@27637 = ~«И каково это — стоять тут как столб?»~
@27638 = ~Уйти.~
@27639 = ~«Но мне нужна твоя помощь…»~
@27640 = ~«И каково это — стоять тут как столб?»~
@27641 = ~Уйти.~
@27642 = ~«Ну… нет. Но у меня были кое-какие вопросы».~
@27643 = ~«Ну… нет. Но у меня были кое-какие вопросы».~
@27644 = ~«Нет, не бери в голову. Прощай».~
@27645 = ~«И каково это — стоять тут как столб?»~
@27646 = ~Уйти.~
@27647 = ~«И каково это — стоять тут как столб?»~
@27648 = ~Уйти.~
@27649 = ~Уйти.~
@27650 = ~«Приветствую…»~
@27651 = ~Оставить офицера в покое.~
@27652 = ~Уйти, пока он тебя не видит.~
@27653 = ~Защищаться.~
@27654 = ~Эта изысканно одетая женщина отдыхает здесь, наслаждаясь лёгким ветерком и потягивая напиток, заказанный в ближайшем кафе.~
@27655 = ~«Приветствую…»~
@27656 = ~«Приветствую…»~
@27657 = ~«Приветствую…»~
@27658 = ~Оставить женщину в покое.~
@27659 = ~Её глаза слегка расширяются, когда она тебя замечает: «Ах… я вас тоже приветствую, сэр». Она беспокойно улыбается.~
@27660 = ~«У меня кое-какие вопросы…»~
@27661 = ~«Что-то не так в моей внешности?»~
@27662 = ~«Мне пора идти».~
@27663 = ~«Я… мне стыдно признать, что я на мгновение испугалась вас. Просто я нечасто общаюсь с такими… гм-м-м… видавшими виды людьми, — она примирительно склоняет голову. — Надеюсь, сэр, я вас ничем не оскорбила».~
@27664 = ~«Видавшими виды?»~
@27665 = ~«У меня кое-какие вопросы…»~
@27666 = ~«Не нервничай. Я уже ухожу. Прощай».~
@27667 = ~«Возможно, лучше подойдёт „много путешествовавшими“? Ваш внешний вид некоторым может показаться из ряда вон выходящим… в некотором смысле. Однако Сигил полон странностей, не так ли? Я думаю, что в районе Клерков их просто несколько меньше… за исключением Фестхолла, конечно».~
@27668 = ~«Район Клерков?»~
@27669 = ~«Фестхолл?»~
@27670 = ~«То есть я выгляжу трупом, верно? Ну так я и в самом деле мёртв!»~
@27671 = ~«Хм-м. У меня есть вопрос…»~
@27672 = ~«Я могу это понять. Прощай».~
@27673 = ~Она кивает: «Спрашивайте».~
@27674 = ~«Что это за место?»~
@27675 = ~«Что здесь интересного?»~
@27676 = ~«Где-нибудь здесь можно найти работу?»~
@27677 = ~«Я хотел спросить об одном месте…»~
@27678 = ~«Как попасть…»~
@27679 = ~«Что ты знаешь о Рейвел Клубок-Загадок?»~
@27680 = ~«На самом деле, неважно. Прощай».~
@27681 = ~Она смотрит на тебя так, будто ты шутишь, но затем осознаёт, что это не так, и смущённо смеётся: «Ну, это же район Клерков, сэр».~
@27682 = ~«Что ты можешь рассказать о районе?»~
@27683 = ~«Точно. У меня другие вопросы…»~
@27684 = ~«Это всё, что я хотел узнать. Прощай».~
@27685 = ~«Ну, большая часть района, где я исполняю свои служебные обязанности, — это конторы, административные здания и всё такое прочее… правда, не в этой его части».~
@27686 = ~«Служебные обязанности?»~
@27687 = ~«Что отличает эту часть района от другой?»~
@27688 = ~«У меня другие вопросы…»~
@27689 = ~«Это всё, что я хотел узнать. Прощай».~
@27690 = ~«Общественный Фестхолл, конечно. Галерея искусств и диковин, а ещё…»~
@27691 = ~«Продолжай…»~
@27692 = ~«У меня другие вопросы…»~
@27693 = ~«Это всё, что я хотел узнать. Прощай».~
@27694 = ~«Другие примечательные места — это дом адвоката, аптека, Бордель Безумной Интеллектуальной Страсти, катакомбы под районом и портной. Да, есть ещё магазинчик всяких странностей».~
@27695 = ~«У меня другие вопросы…»~
@27696 = ~«Это всё, что я хотел узнать. Прощай».~
@27697 = ~«Вы, наверное, не ищете постоянного места работы, так? Вы не похожи на тех, кто здесь оседает… — она прерывается и окидывает тебя взглядом. — Ну, можно попробовать спросить у адвоката, можно у аптекаря и, конечно, чаще всего всякая случайная работа есть в Общественном Фестхолле».~
@27698 = ~«У меня другие вопросы…»~
@27699 = ~«Это всё, что я хотел узнать. Прощай».~
@27700 = ~Она кивает и закатывает глаза: «Мои обязанности, сэр. Я работаю в одном из многих, многих административных учреждений в этом районе».~
@27701 = ~«А что ты там делаешь?»~
@27702 = ~«Так что отличает эту часть от остального района?»~
@27703 = ~«У меня другие вопросы…»~
@27704 = ~«Это всё, что я хотел узнать. Прощай».~
@27705 = ~Она улыбается и качает головой: «Прошу вас, сэр, окажите мне услугу — не поднимайте эту тему. Не сейчас, когда я пытаюсь хоть немного отдохнуть».~
@27706 = ~«Что отличает эту часть от остального района?»~
@27707 = ~«У меня другие вопросы…»~
@27708 = ~«Это всё, что я хотел узнать. Прощай».~
@27709 = ~«Я расскажу вам то немногое, что знаю…»~
@27710 = ~«Расскажи о доме адвоката».~
@27711 = ~«Расскажи о доме адвоката».~
@27712 = ~«Расскажи об аптеке».~
@27713 = ~«Расскажи о галерее искусств».~
@27714 = ~«Расскажи о Борделе».~
@27715 = ~«Расскажи о Борделе».~
@27716 = ~«Расскажи о ПодСигиле, подземной области».~
@27717 = ~«Расскажи об Общественном Фестхолле».~
@27718 = ~«Расскажи о магазинчике странностей».~
@27719 = ~«Расскажи о портном».~
@27720 = ~«Забудь. Поговорим о кое о чём другом…»~
@27721 = ~«Неважно. Прощай».~
@27722 = ~«Адвокаты решают запутанные дела, составляют юридические документы, представляют людей в суде. Местный адвокат, Яннис — очень хороший, опытный и уважаемый человек. Он живёт и работает в районе уже давным-давно».~
@27723 = ~«Как мне пройти к дому Янниса?»~
@27724 = ~«Я хотел спросить о другом месте…»~
@27725 = ~«У меня другие вопросы…»~
@27726 = ~«Это всё, что я хотел узнать. Прощай».~
@27727 = ~«Адвокаты  решают запутанные дела, составляют юридические документы, представляют людей в суде».~
@27728 = ~Эта огромная фигура в доспехах красного цвета стоит на посту и, по-видимому, охраняет вход на лестницу. Ты смутно вспоминаешь: такие знаки и узоры на броне свидетельствуют, что перед тобой — офицер Гармониума, тот, кто охраняет порядок в городе.~
@27729 = ~«Местный адвокат, Яннис — очень хороший, опытный и уважаемый человек. Он живёт и работает в районе уже давным-давно».~
@27730 = ~«Как мне пройти к дому Янниса?»~
@27731 = ~«Я хотел спросить о другом месте…»~
@27732 = ~«У меня другие вопросы…»~
@27733 = ~«Это всё, что я хотел узнать. Прощай».~
@27734 = ~«В аптеке продаются всякие снадобья, притирания, микстуры, пилюли и всё такое, — она секунду хмурится. — Правда, хозяин аптеки не без странностей, постоянно опробует лекарства на себе. Однако он неплохой человек».~
@27735 = ~«Как мне найти аптеку?»~
@27736 = ~«Я хотел спросить о другом месте…»~
@27737 = ~«У меня другие вопросы…»~
@27738 = ~«Это всё, что я хотел узнать. Прощай».~
@27739 = ~«Галерея искусств и диковин Иваны — весьма занимательное место. Она коллекционирует предметы искусства, антиквариат и артефакты со всех планов».~
@27740 = ~«Как мне попасть в галерею искусств?»~
@27741 = ~«Я хотел спросить о другом месте…»~
@27742 = ~«У меня другие вопросы…»~
@27743 = ~«Это всё, что я хотел узнать. Прощай».~
@27744 = ~«Заведение Чующих для наслаждения ума и чувств. Там, что вполне уместно, заправляет суккуб, её зовут Падшая Грейс».~
@27745 = ~«Чующих?»~
@27746 = ~«Как мне попасть в Бордель?»~
@27747 = ~«Я хотел спросить о другом месте…»~
@27748 = ~«У меня другие вопросы…»~
@27749 = ~«Это всё, что я хотел узнать. Прощай».~
@27750 = ~«Заведение Чующих для наслаждения ума и чувств. Там, что вполне уместно, заправляет суккуб», — она вежливо кланяется Падшей Грейс.~
@27751 = ~«Чующих?»~
@27752 = ~«Как мне попасть в Бордель?»~
@27753 = ~«Я хотел спросить о другом месте…»~
@27754 = ~«У меня другие вопросы…»~
@27755 = ~«Это всё, что я хотел узнать. Прощай».~
@27756 = ~[нет текста]~
@27757 = ~[нет текста]~
@27758 = ~На лице женщины появляется лёгкая озабоченность: «Так странно, что это место пока ещё не прикрыли. Насколько я понимаю, от этой подземной области только проблем полно. Она опасна для всех, кто туда попадает».~
@27759 = ~«И как туда попасть?»~
@27760 = ~«Я хотел спросить о другом месте…»~
@27761 = ~«У меня другие вопросы…»~
@27762 = ~«Это всё, что я хотел узнать. Прощай».~
@27763 = ~«Безусловно, одним из самых больших чудес Сигила является штаб-квартира фракции Чующих, известная по всей мультивселенной своими концертами, выставками и лекциями. Но наиболее удивительны, конечно, их сенсориумы».~
@27764 = ~«Чующих?»~
@27765 = ~«Сенсориумы?»~
@27766 = ~«Где находится Фестхолл?»~
@27767 = ~«Я хотел спросить о другом месте…»~
@27768 = ~«У меня другие вопросы…»~
@27769 = ~«Это всё, что я хотел узнать. Прощай».~
@27770 = ~«Не скажу, что была там сама, но насколько понимаю, там продаются всякие редкости… хозяйка-полуизверг завозит их с Нижних планов».~
@27771 = ~«Полуизверг?»~
@27772 = ~«Нижние планы?»~
@27773 = ~«Где я могу найти это место?»~
@27774 = ~«Я хотел спросить о другом месте…»~
@27775 = ~«У меня другие вопросы…»~
@27776 = ~«Это всё, что я хотел узнать. Прощай».~
@27777 = ~«Гонкальвес — превосходный портной, но слишком вспыльчив и скор на обиду. Должна предупредить, сэр: скорее всего, он будет судить о вас по внешнему виду… вам нелегко будет найти с ним общий язык».~
@27778 = ~«А где магазин Гонкальвеса?»~
@27779 = ~«Я хотел спросить о другом месте…»~
@27780 = ~«У меня другие вопросы…»~
@27781 = ~«Это всё, что я хотел узнать. Прощай».~
@27782 = ~«Куда?»~
@27783 = ~«К дому адвоката».~
@27784 = ~«В аптеку».~
@27785 = ~«В галерею искусств».~
@27786 = ~«В Бордель».~
@27787 = ~«В ПодСигил, подземную область».~
@27788 = ~«В Общественный Фестхолл».~
@27789 = ~«В магазинчик странностей».~
@27790 = ~«К портному».~
@27791 = ~«Неважно. Позволь спросить кое о чём другом…»~
@27792 = ~«Неважно. Прощай».~
@27793 = ~«Дом Янниса находится к югу от ворот в Нижний район. Видимо, вы пришли оттуда? Он на восточной стороне дороги».~
@27794 = ~«Что ты можешь сказать об адвокате?»~
@27795 = ~«Что ты можешь сказать об адвокате?»~
@27796 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27797 = ~«Ясно, спасибо. Прощай».~
@27798 = ~«Идите по дороге на восток от ворот в Нижний район — это там, откуда вы, похоже, пришли сюда. Когда будет развилка, на северо-восток и на юго-восток, держитесь южнее… и на восточной стороне дороги она как раз и будет стоять. Лицом здание смотрит на юг, и там три окна с витражами».~
@27799 = ~«Что ты можешь рассказать об этом месте?»~
@27800 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27801 = ~«Ясно, спасибо. Прощай».~
@27802 = ~«Идите по дороге на восток от ворот в Нижний район — это там, откуда вы, похоже, пришли сюда. Когда будет развилка, на северо-восток и на юго-восток, держитесь южнее… и обнаружите её на западной стороне дороги, фасад обращён к югу, а крыша покрыта черепицей».~
@27803 = ~«Что ты знаешь об этом месте?»~
@27804 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27805 = ~«Ясно, спасибо. Прощай».~
@27806 = ~Она смотрит многозначительно и качает головой: «Он к востоку от ворот в Нижний район — это там, откуда вы, похоже, пришли сюда. Большое круглое здание, вход которого обращён к югу».~
@27807 = ~«Что ты можешь рассказать о Борделе?»~
@27808 = ~«Что ты можешь рассказать о Борделе?»~
@27809 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27810 = ~«Ясно, спасибо. Прощай».~
@27811 = ~Она пожимает плечами: «Не знаю. Однако я бы предостерегла от поисков пути туда. Говорят, ничто не выходит из подземной области… включая и тех, кто туда вошёл».~
@27812 = ~«Что ещё ты можешь о нём рассказать?»~
@27813 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27814 = ~«Ясно, спасибо. Прощай».~
@27815 = ~«Фестхолл очень просто найти, сэр. Это огромное здание в северо-восточной части этого района».~
@27816 = ~«Что ты можешь рассказать о Фестхолле?»~
@27817 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27818 = ~«Ясно, спасибо. Прощай».~
@27819 = ~«Это в юго-восточной части района, Необычное здание, к которому поднимается широкая лестница. Но сама я туда никогда не поднималась… у меня от него мурашки по коже».~
@27820 = ~«Что ты знаешь об этом месте?»~
@27821 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27822 = ~«Ясно, спасибо. Прощай».~
@27823 = ~«Вы найдёте магазинчик портного Гонкальвеса к северо-востоку от ворот в Нижний район — это там, откуда вы, похоже, пришли сюда. Это большое здание со входом с южной стороны».~
@27824 = ~«Что ты можешь рассказать об этом месте?»~
@27825 = ~«Спасибо. Позволь спросить кое о чём другом…»~
@27826 = ~«Ясно, спасибо. Прощай».~
@27827 = ~Она шепчет с оглядкой по сторонам: «Бездна, Баатор… жуткие места, сэр, знаете ли».~
@27828 = ~«Ты сказала, что она полуизверг?»~
@27829 = ~«А как можно найти этот магазинчик странностей?»~
@27830 = ~«Я хотел спросить о другом месте…»~
@27831 = ~«У меня другие вопросы…»~
@27832 = ~«Это всё, что я хотел узнать. Прощай».~
@27833 = ~«Не тифлинг, уверяю вас. Она приличный полуизверг. Я бы сказала, дочь инкуба и смертной женщины. Однако меня не интересуют сплетни, поэтому не будем больше о ней».~
@27834 = ~«Так ты говоришь, она завозит товар с Нижних планов?»~
@27835 = ~«А как можно найти этот магазинчик странностей?»~
@27836 = ~«Я хотел спросить о другом месте…»~
@27837 = ~«У меня другие вопросы…»~
@27838 = ~«Это всё, что я хотел узнать. Прощай».~
@27839 = ~«Да, их официальное название — „Общество Восприятия“. Они считают, что познать мультивселенную можно только через личный опыт…»~
@27840 = ~«Ясно. Продолжай».~
@27841 = ~«У меня другие вопросы…»~
@27842 = ~«Это всё, что я хотел узнать. Прощай».~
@27843 = ~«Они нашли способ делиться своим опытом с другими — через сенсориумы».~
@27844 = ~«Сенсориумы?»~
@27845 = ~«У меня другие вопросы…»~
@27846 = ~«Это всё, что я хотел узнать. Прощай».~
@27847 = ~«Чующие создали способ захватывать впечатления и помещать их в камни. Потом они делятся ими с *другими*, в обмен на их впечатления. Чующие путешествуют по планам, утоляя собственное внутреннее любопытство. Практически весь свой опыт Чующие хранят в камнях, находящихся в сенсориумах».~
@27848 = ~«А где находятся эти сенсориумы?»~
@27849 = ~«Эти впечатления… они как воспоминания?»~
@27850 = ~«У меня другие вопросы…»~
@27851 = ~«Это всё, что я хотел узнать. Прощай».~
@27852 = ~«Внутри Фестхолла. Там есть как сенсориумы, открытые для публики, так и специальные, только для Чующих. Там довольно много камней, за пользование которыми взимается некоторая плата — весьма скромная для такой бесценной услуги».~
@27853 = ~«Где находится Фестхолл?»~
@27854 = ~«Эти впечатления… они как воспоминания?»~
@27855 = ~«У меня другие вопросы…»~
@27856 = ~«Это всё, что я хотел узнать. Прощай».~
@27857 = ~«В *некотором* роде, но очень интенсивные… и это не твои воспоминания, а воспоминания других, захваченные в камне».~
@27858 = ~«Захваченные? Погоди, а тот, кто отдаёт воспоминания, он сам всё забывает?»~
@27859 = ~«А где находятся эти сенсориумы?»~
@27860 = ~«У меня другие вопросы…»~
@27861 = ~«Это всё, что я хотел узнать. Прощай».~
@27862 = ~«Нет… — она хмурится. — Насколько я знаю, по крайней мере. Думаю, камень только копирует впечатления. Хотя это лишь моё предположение, лучше спросить непосредственно у Чующих».~
@27863 = ~«У меня другие вопросы…»~
@27864 = ~«Это всё, что я хотел узнать. Прощай».~
@27865 = ~«Имя кажется знакомым… она персонаж какой-то книги? Злодейка из романа, нет? Не могу вспомнить».~
@27866 = ~«Не бери в голову. У меня другие вопросы…»~
@27867 = ~«Тогда неважно. Прощай».~
@27868 = ~«Приятно встретиться с вами вновь, — она улыбается поверх бокала. — Ещё вопросы, полагаю?»~
@27869 = ~«Верно».~
@27870 = ~«Вообще-то нет… просто мимо проходил. Прощай».~
@27871 = ~Она выглядит озадаченной: «Простите, сэр?»~
@27872 = ~«Я сказал: „Я мёртв!“ Мёртв, мёртв, ха-ха! Мёртв, мёртв, ха-ха…»~
@27873 = ~«Не бери в голову. У меня были кое-какие вопросы…»~
@27874 = ~«Неважно. Прощай».~
@27875 = ~Выражение лица женщины становится напряжённым: «А, да… как и все мы. Простите, сэр, но мне нужно уходить. Кажется, я совсем забыла о срочном деле в другом месте».~
@27876 = ~«Погоди! Я ещё не сказал *почему* я мёртв…»~
@27877 = ~«Подожди минуту. У меня кое-какие вопросы…»~
@27878 = ~«Тогда прощай».~
@27879 = ~Она пятится назад: «Должна признать, мне это не очень интересно, сэр». Она начинает озираться по сторонам, будто ищя возможной помощи со стороны.~
@27880 = ~«Потому что в предыдущих жизнях я убил слишком много народа».~
@27881 = ~«Неважно. У меня были кое-какие вопросы…»~
@27882 = ~«Тогда прощай».~
@27883 = ~Она бросает бокал и кричит: «Стража! Стража!»~
@27884 = ~Напасть на неё.~
@27885 = ~Попытаться скрыться, пока никто не явился.~
@27886 = ~«Они посвящают себя накоплению опыта; с этой целью много путешествуют по планам, а также погружаются в глубины своего сознания и эмоций. Но знаете, они не только собирают впечатления — они идут дальше…»~
@27887 = ~«Как это?»~
@27888 = ~«У меня другие вопросы…»~
@27889 = ~«Это всё, что я хотел узнать. Прощай».~
@27890 = ~Её глаза слегка расширяются, когда она тебя замечает. Она беспокойно улыбается. «Ах… я вас тоже приве… — внезапно её взгляд падает на Морте. — О! Какой славный маленький мимир!»~
@27891 = ~«Мимир?»~
@27892 = ~«Не правда ли? Он обожает, когда ему чешут верхушку черепа».~
@27893 = ~«Я бы его не трогал — он кусается».~
@27894 = ~«Да-да. У меня были кое-какие вопросы…»~
@27895 = ~«Что-то не так в моей внешности?»~
@27896 = ~«Нет. Прощай».~
@27897 = ~Женщина улыбается: «Какой милый! И даже сам разговаривает!»~
@27898 = ~«Приветствую…»~
@27899 = ~Она качает головой: «Нет, никогда такого не видела. Они же обычные вещи, разве не?..»~
@27900 = ~Оставить его в покое.~
@27901 = ~Женщина пожимает плечами: «Вполне возможно».~
@27902 = ~«У меня кое-какие вопросы…»~
@27903 = ~«Мне пора идти».~
@27904 = ~«Правда? — она продолжает улыбаться, но уже несколько неуверенно. — Вы же шутите, сэр! Это всего лишь мимир…»~
@27905 = ~«Что ты имеешь в виду? Разве не всем им это нравится?»~
@27906 = ~«Нет, я говорю правду. Можешь попробовать».~
@27907 = ~«Не обращай на него внимания. Я бы хотел задать пару вопросов…»~
@27908 = ~Она протягивает руку к Морте и осторожно его похлопывает… а тот немедленно начинает тереться о её ладонь, подмигивая вам и широко улыбаясь. Женщина неловко смеётся: «Как странно!»~
@27909 = ~«Да… итак, у меня кое-какие вопросы…»~
@27910 = ~«В самом деле? Прощай».~
@27911 = ~Морте шипит тебе в ухо: «Законник».~
@27912 = ~«Разновидность говорящей энциклопедии, шеф. Но на самом деле я не люблю говорить об этом».~
@27913 = ~Морте покачивает надбровьями и направляется к женщине: «Я много чего ещё уме…»~
@27914 = ~«Хватит, Морте».~
@27915 = ~«Да, да. Хорошо, — Морте вращает глазами и ворчит себе под нос. — Тьфу, я с таким же успехом мог быть *мёртвым*…»~
@27916 = ~«Слушай… ты сказала „сам разговаривает“? Разве они обычно так не делают?»~
@27917 = ~«Я хочу задать пару вопросов этой женщине…»~
@27918 = ~Оставить женщину в покое.~
@27919 = ~Морте прерывает её: «Ну, видишь ли, шеф, всё дело в *качестве* твоего мимира. Некоторые — вроде меня — более продвинутые, чем другие, вот и всё. С большим… э-э… „самосознанием“, вот как это называется».~
@27920 = ~«Хм-м».~
@27921 = ~«Ясно».~
@27922 = ~«Эй! Я просто хочу немного повеселиться, шеф!»~
@27923 = ~Мужчина небрежно показывает жестом в сторону улицы: «Проходи, уважаемый».~
@27924 = ~«Что ты здесь делаешь?»~
@27925 = ~«У меня кое-какие вопросы…»~
@27926 = ~Уйти.~
@27927 = ~«Бесполезно задавать здесь вопросы, уважаемый. Проходи».~
@27928 = ~«Что ты здесь делаешь?»~
@27929 = ~«Мне всего-то нужны ответы на пару вопросов…»~
@27930 = ~«Мне нужна твоя помощь…»~
@27931 = ~«И каково это — стоять тут как столб?»~
@27932 = ~Уйти.~
@27933 = ~Он качает головой: «Тогда поговори с гражданами. Я на службе… и не брошу её ради разговоров с тобой или кем бы то ни было, уважаемый. Теперь проходи».~
@27934 = ~«Можешь просто сказать, что ты здесь делаешь?»~
@27935 = ~«Но мне нужна твоя помощь…»~
@27936 = ~«И каково это — стоять тут как столб?»~
@27937 = ~Уйти.~
@27938 = ~Он поднимает оружие: «Нужна помощь? Было совершено преступление?»~
@27939 = ~«М-м… нет. Всего лишь возникли вопросы».~
@27940 = ~«М-м… нет. Всего лишь возникли вопросы».~
@27941 = ~«Нет, не бери в голову. Прощай».~
@27942 = ~Он вздыхает. «Я понимаю, что у тебя вопросы, в другое время и в другом месте я бы охотно помог. Но… — он прерывается и подозрительно оглядывает ступеньки вниз. — Но теперь не время и не место, так что… просто проходи, уважаемый. Сейчас же».~
@27943 = ~«Можешь просто сказать, что ты здесь делаешь?»~
@27944 = ~«И каково это — стоять тут как столб?»~
@27945 = ~Уйти.~
@27946 = ~«Эй, пень, у меня… — он подозрительно оглядывает ступеньки вниз, затем возвращает взгляд на тебя. — У меня есть определённые задачи и нет времени на разговор с каждым безмозглым малым, который ищет такого и сякого или проход кто-знает-куда. Проходи».~
@27947 = ~«Можешь просто сказать, что ты здесь делаешь?»~
@27948 = ~«И каково это — стоять тут как столб?»~
@27949 = ~Уйти.~
@27950 = ~Он пожимает плечами, вызвав бряцание доспехов: «Можешь и постоять тут, но не приставай к стражам порядка, если не хочешь нажить… неприятностей. Прощай».~
@27951 = ~«Можешь просто сказать, что ты здесь делаешь?»~
@27952 = ~Уйти.~
@27953 = ~Этот офицер Гармониума явно охраняет лестницу позади. Ты смутно чувствуешь, что встречал этого парня раньше, но определённо сказать нельзя. Бравые ребята в закрытых шлемах и одинаковых доспехах Гармониума все на одно лицо.~
@27954 = ~«Приветствую…»~
@27955 = ~Оставить офицера в покое.~
@27956 = ~Ты понимаешь, что это член Гармониума, фракции, которая с недавних пор тебя преследует. Кажется, он тебя пока не заметил.~
@27957 = ~«Приветствую…»~
@27958 = ~Уйти, пока он тебя не видит.~
@27959 = ~Даже через прорези шлема ты видишь, как его глаза расширяются: «Это он!» Он выхватывает оружие и вопит: «Взять его, живым или мёртвым!»~
@27960 = ~Защищаться.~
@27961 = ~Он показывает на ступени сзади, кажется, ведущие под землю: «Охраняю лестницу, уважаемый».~
@27962 = ~«Зачем? Куда она ведёт?»~
@27963 = ~«У меня другие вопросы…»~
@27964 = ~«Это всё, что я хотел узнать. Прощай».~
@27965 = ~«В подземную область, — видя твоё выражение лица, он продолжает. — ПодСигил, наверное, слышал это название».~
@27966 = ~«А есть ли смысл не позволять гражданам проходить туда?»~
@27967 = ~«У меня другие вопросы…»~
@27968 = ~«Это всё, что я хотел узнать. Прощай».~
@27969 = ~Он тихо посмеивается, вызвав бряцание пластин брони: «Моё дело — следить за тем, что выходит *оттуда*, уважаемый. Тварями, которые *не являются* частью Сигила».~
@27970 = ~«А что там, внизу?»~
@27971 = ~«У меня другие вопросы…»~
@27972 = ~«Это всё, что я хотел узнать. Прощай».~
@27973 = ~«Не создавай себе проблем, — он с любопытством смотрит на тебя. — Подумываешь о спуске, не так ли? Что ж, будь осторожен. Много нехорошего рассказывают о созданиях, живущих там, под землёй».~
@27974 = ~«Спасибо. У меня другие вопросы…»~
@27975 = ~«Спасибо за предупреждение. Прощай».~
@27976 = ~Худой мужчина с резкими чертами лица бросается к тебе, пытаясь привлечь внимание: «Э, сэр, сэр! Всего лишь минуту вашего времени! Не собираетесь ли вы, случайно, посетить портного?»~
@27977 = ~Мужчина прерывает тебя: «Я спрашиваю, сэр, потому что чем-то, э, обидел портного. Я заказал этому вспыльчивому дураку костюм, а он просто вышвырнул меня из своей лавки и теперь не разговаривает со мной».~
@27978 = ~Внезапно мужчина сжимает кулаки и грозит ими небу: «И чем я заслужил подобное обращение? Ничем, слышите! Я *клиент*! Он должен был *обслужить* меня, этот шут гороховый!»~
@27979 = ~«Могу я попросить вас зайти за костюмом Пыльного для меня, сэр? Я собираюсь на костюмированный бал, и у меня просто нет времени заказывать костюм у другого портного».~
@27980 = ~«А? — он снова обращает внимание на тебя. — О! Да, вы…»~
@27981 = ~«Прошу! Погодите!»~
@27982 = ~«О, великолепно, сэр! Здание прямо перед вами, вот оно… — он показывает на длинное приземистое строение рядом к северу. — Благодарю вас, сэр!»~
@27983 = ~Он рычит, закатывая глаза: «Этот свиноподобный хам! Я якобы „обидел“ этого надутого, напыщенного нахала! Он запретил мне входить в лавку и отказывается разговаривать. Представьте!»~
@27984 = ~«*Что*? О силы, человек, я лишь прошу вас принести мне *костюм*! Это займёт всего минуту вашего времени! Я вовсе не думаю, что такое скромное поручение стоит оплаты, сэр!»~
@27985 = ~«Погодите… — он громко вздыхает. — Если так, десять монет за минутное поручение. Это вас устроит… „сэр“?»~
@27986 = ~Он весь исходит на ворчание, но протягивает тебе деньги. «Вот это длинное здание, прямо здесь… — он указывает на длинное приземистое строение рядом. — И поторопитесь, пожалуйста».~
@27987 = ~Он орёт на тебя: «Ты… порубленный кусок плоти! Морщинистый, паршивый мешок отбросов! Вернись, жалкий рассадник болезней! Никто не может сделать подобного с Малманером! Верни всё сейчас же, пока я не позвал стражу!»~
@27988 = ~Он орёт на тебя: «Ты… порубленный кусок плоти! Морщинистый, паршивый мешок отбросов! Вернись, жалкий рассадник болезней! Никто не может сделать подобного с Малманером! Верни всё сейчас же, пока я не позвал стражу!»~
@27989 = ~«Хмф!» — он выхватывает у тебя монеты, убирает их в кошель и топает прочь.~
@27990 = ~Он потрясённо глазеет на тебя: «Ты… наглец…»~
@27991 = ~«Я тебе покажу! Стража! Стража!»~
@27992 = ~«Ну-ну, добрейший человек в Сигиле… — едкий голос мужчины исполнен сарказма. — Спасибо, *огромное* спасибо вам за помощь, сэр. О… погодите… вы же и не помогли вовсе, так? Пф».~
@27993 = ~Мужчина смотрит на тебя с нетерпением: «Ну? Ну? Принесли костюм от Гонкальвеса?»~
@27994 = ~«Давайте же, идите тогда! У меня маскарад на носу!»~
@27995 = ~Мужчина смотрит на тебя с нетерпением: «Ну? Ну? Принесли костюм от Гонкальвеса?»~
@27996 = ~«ЧТО?! Хмф! Ладно, ладно… забирайте деньги и принесите мне уже этот проклятый костюм!» — он отсчитывает тридцать медяков.~
@27997 = ~Он орёт на тебя: «Ты… порубленный кусок плоти! Морщинистый, паршивый мешок отбросов! Вернись, жалкий рассадник болезней! Никто не может сделать подобного с Малманером! Верни всё сейчас же, пока я не позвал стражу!»~
@27998 = ~Он орёт на тебя: «Ты… порубленный кусок плоти! Морщинистый, паршивый мешок отбросов! Вернись, жалкий рассадник болезней! Никто не может сделать подобного с Малманером! Верни всё сейчас же, пока я не позвал стражу!»~
@27999 = ~Мужчина выглядит поражённым: «Невозможно! Возмутительно! Мы договаривались на тридцать медяков, когда я делал заказ!»~
@28000 = ~Он смотрит подозрительно, затем смягчается: «Ладно! Забирайте, вот. Просто принесите мне уже этот проклятый костюм!» Он отсчитывает пятьдесят медяков.~
@28001 = ~Мужчина смотрит на тебя с нетерпением: «Ну? Ну? Принесли костюм от Гонкальвеса?»~
@28002 = ~«Ладно, ладно! Забирайте, вот», — он отсчитывает тебе тридцать медяков.~
@28003 = ~Он смотрит на тебя подозрительно, поджав губы.~
@28004 = ~Мужчина выглядит поражённым: «Невозможно! Возмутительно! Мы договаривались на тридцать медяков, когда я делал заказ!»~
@28005 = ~Он смотрит подозрительно, затем смягчается. «Ладно! Забирайте, вот! — он отсчитывает пятьдесят медяков. — А теперь мне пора идти…»~
@28006 = ~Он смотрит на тебя подозрительно, поджав губы.~
@28007 = ~«Что? Проклятье! Ну и как я буду смотреться в таком *заурядном* костюме?»~
@28008 = ~«Наконец-то! — он выхватывает костюм у тебя из рук. — А теперь мне пора…»~
@28009 = ~Он с отвращением бросает одежду назад: «Фу! Какая гадость… только посмотрите! Поеденная молью грязная тряпка… а материал-то какой грубый! Я никогда не выйду в свет в этом рубище».~
@28010 = ~Он с отвращением бросает одежду назад. «Фу! Какая гадость… только посмотрите! Поеденная молью грязная тряпка… а материал-то какой грубый! Я никогда не выйду в свет в этом рубище, — он смотрит на тебя с подозрением. — И что *это* такое, сэр?»~
@28011 = ~«Хмф!» — он уходит, вполголоса ругаясь.~
@28012 = ~«Неплохая идея, вовсе неплохая. Быстрее, сходите посмотрите, нет ли у этого тучного простофили другого, ладно?»~
@28013 = ~Он закатывает глаза и усмехается: «Я должен был догадаться! Вот, *наёмник*! Надеюсь, хватит?» Он протягивает тебе двадцать медяков.~
@28014 = ~Мужчина смотрит выжидательно: «Ну? Ну? Удалось достать другой костюм?»~
@28015 = ~Мужчина смотрит выжидательно: «Ну? Ну? Удалось достать другой костюм?»~
@28016 = ~Он рвёт на себе волосы, выкрикивая: «О силы, за что же вы так с бедным, благородным Малманером! Будь проклят этот маскарад, и трижды будь проклят этот омерзительный портной!» Он отсчитывает тебе пятьдесят медяков: «Идите уже!»~
@28017 = ~«Это… это… невообразимо! Совершенно абсурдно! Кем он себя возомнил?! — вдруг он хмурится. — Погодите, это звучит уже *слишком*, даже для Гонкальвеса». Он смотрит на тебя подозрительно.~
@28018 = ~Он смотрит подозрительно, затем смягчается: «Ладно! Берите, берите всё. Просто принесите мне уже этот другой костюм, и побыстрей!» Он отсчитывает восемьдесят медяков.~
@28019 = ~Он смотрит на тебя подозрительно, поджав губы. Он явно тебе ни капельки не верит.~
@28020 = ~Пустой узел.~
@28021 = ~Он смотрит на тебя с нетерпением: «Ну? Ну? Принесли костюм от Гонкальвеса?»~
@28022 = ~Он раздражённо ворчит, потом выхватывает у тебя костюм и суёт пятьдесят медяков. «Так, мне пора…»~
@28023 = ~«Как раз вовремя! — он выхватывает у тебя костюм. — Мне пора идти…»~
@28024 = ~«Это… это… невообразимо! Совершенно абсурдно! Кем он себя возомнил?! — вдруг он хмурится. — Погодите, это звучит уже *слишком*, даже для Гонкальвеса». Он смотрит на тебя подозрительно.~
@28025 = ~Он смотрит на тебя подозрительно, поджав губы.~
@28026 = ~Он смотрит подозрительно, потом смягчается, выхватывает у тебя костюм и суёт восемьдесят медяков. «Так, мне пора…»~
@28027 = ~«Я ид…»~
@28028 = ~Игнорировать его и идти дальше.~
@28029 = ~«И чт…»~
@28030 = ~«Что ты хочешь от меня?»~
@28031 = ~«У меня нет на это времени. Прощай».~
@28032 = ~«Хорошо, я зайду».~
@28033 = ~«Могу и зайти, но не забесплатно».~
@28034 = ~«А что бы тебе самому не сходить?»~
@28035 = ~«Нет, мне некогда. Прощай».~
@28036 = ~Морте восторженно кивает: «Эй, а парень-то не промах».~
@28037 = ~Морте восторженно кивает: «Эй, а парень-то не промах».~
@28038 = ~«Ладно, вот… забирай свои деньги, Малманер».~
@28039 = ~Швырнуть в Малманера тридцать медяков.~
@28040 = ~«Ладно, вот… забирай свои деньги, Малманер».~
@28041 = ~«Ладно, вот… забирай свои деньги, Малманер».~
@28042 = ~Швырнуть в Малманера десять медяков.~
@28043 = ~«Правда? Я ничего особенного не услышал, Морте. Пошли».~
@28044 = ~Швырнуть в Малманера пятьдесят медяков.~
@28045 = ~«Ладно, вот… забирай свои деньги, Малманер».~
@28046 = ~Швырнуть в Малманера пятьдесят медяков.~
@28047 = ~«Ладно, вот… забирай свои деньги, Малманер».~
@28048 = ~Швырнуть в Малманера восемьдесят медяков.~
@28049 = ~«Правда? Я ничего особенного не услышал, Морте. Пошли».~
@28050 = ~Выслушать его.~
@28051 = ~Уйти.~
@28052 = ~«Прощай».~
@28053 = ~«Ладно, схожу».~
@28054 = ~«Я принесу костюм, но не забесплатно».~
@28055 = ~«У меня нет на это времени. Прощай».~
@28056 = ~«Ладно, схожу я за ним».~
@28057 = ~«Тогда это не стоит моего времени. Прощай».~
@28058 = ~«Конечно, давай деньги, будет тебе костюм».~
@28059 = ~«Мне не нравится твой тон, „сэр“. Начинаю понимать, почему портной к тебе так отнёсся. Прощай».~
@28060 = ~«Забудь. Прощай».~
@28061 = ~«Пойду принесу. До свидания».~
@28062 = ~«Торопиться? Куда? О, кстати, спасибо за деньги. Прощай… „сэр“».~
@28063 = ~«Торопиться? Куда? О, кстати, спасибо за деньги. Прощай… „сэр“».~
@28064 = ~«Ладно, вот… забирай свои деньги».~
@28065 = ~Швырнуть в него десять медяков.~
@28066 = ~Не обращать на него внимания и уйти.~
@28067 = ~Уйти.~
@28068 = ~«Прикрой рот, если не хочешь потерять язык».~
@28069 = ~Не обращать на него внимания и уйти.~
@28070 = ~Напасть на него.~
@28071 = ~На самом деле удалить этого персонажа из группы?~
@28072 = ~Попытаться скрыться, пока никто не явился.~
@28073 = ~«Я передумал. Принесу я тебе костюм».~
@28074 = ~«Странно, как эти лошади спят стоя?»~
@28075 = ~«Слушай… я могу принести тебе костюм, но за плату».~
@28076 = ~«Прощай».~
@28077 = ~«Нет, ещё нет».~
@28078 = ~«Я вернусь с костюмом. До свидания».~
@28079 = ~«Нет, пока нет. Он сказал, что ты должен ему за работу тридцать медяков».~
@28080 = ~Вы не можете изменить порядок группы Безымянного.~
@28081 = ~Замешательство~
@28082 = ~Закрыть~
@28083 = ~Ложь: «Нет, пока нет. Он сказал, что ты должен ему за работу полтинник».~
@28084 = ~«Нет, но как насчёт настоящей одежды Пыльного?»~
@28085 = ~Ложь: «Э-э… да. Вот одежда Пыльного… то есть костюм».~
@28086 = ~«Нет, ещё нет».~
@28087 = ~«Я вернусь с костюмом. До свидания».~
@28088 = ~«Хм-м… какой ещё костюм? О, и спасибо за денежки. Пока!»~
@28089 = ~«Хм-м… какой ещё костюм? О, и спасибо за денежки. Пока!»~
@28090 = ~«Ладно, вот… забирай свои деньги»~
@28091 = ~Швырнуть в него тридцать монет.~
@28092 = ~«Ладно, вот… забирай свои деньги»~
@28093 = ~Швырнуть в него пятьдесят монет.~
@28094 = ~«Ладно, вот… забирай свои деньги»~
@28095 = ~Швырнуть в него пятьдесят монет.~
@28096 = ~«Ладно, вот… забирай свои деньги»~
@28097 = ~Швырнуть в него восемьдесят монет.~
@28098 = ~Не обращать на него внимания и уйти.~
@28099 = ~Ложь: «Он был очень расстроен, Малманер. Ты оскорбил его, поэтому он и повысил цену».~
@28100 = ~Ложь: «Ну, он был, э-э, расстроен и повысил цену».~
@28101 = ~«Прости, оговорился. Всего лишь тридцать монет».~
@28102 = ~«Я вернусь с костюмом. До свидания».~
@28103 = ~«Хм-м… какой ещё костюм? О, и спасибо за денежки. Пока!»~
@28104 = ~«Хм-м… какой ещё костюм? О, и спасибо за денежки. Пока!»~
@28105 = ~«Да, вот. Он стоил мне тридцатку».~
@28106 = ~Ложь: «Да, вот. Он стоил мне полтинник».~
@28107 = ~«Да, вот он».~
@28108 = ~«Погоди… Гонкальвес сказал, что многие собирались пойти на маскарад в костюме Пыльных».~
@28109 = ~«Прощай».~
@28110 = ~«Прости, оговорился. Всего лишь тридцать монет».~
@28111 = ~Ложь: «Он был очень расстроен, Малманер. Ты оскорбил его, поэтому он и повысил цену».~
@28112 = ~Ложь: «Ну, он был, э-э, расстроен и повысил цену».~
@28113 = ~«Прости, оговорился. Всего лишь тридцать монет».~
@28114 = ~«Погоди… Гонкальвес сказал, что многие собирались пойти на маскарад в костюме Пыльных».~
@28115 = ~«Прощай».~
@28116 = ~«Прости, оговорился. Всего лишь тридцать монет».~
@28117 = ~«Погоди… Гонкальвес сказал, что многие собирались пойти на маскарад в костюме Пыльных».~
@28118 = ~«Прощай».~
@28119 = ~«Ну, он говорит, что за нормальный костюм ты должен тридцать медяков».~
@28120 = ~Ложь: «Ну, он говорит, что за нормальный костюм, э-э, ты должен пятьдесят медяков».~
@28121 = ~«Ну, мне пока не удалось достать нормальный костюм».~
@28122 = ~«Ничего. Он говорит, что за нормальный костюм ты должен тридцать медяков».~
@28123 = ~Ложь: «Ничего. Он говорит, что за нормальный костюм ты должен пятьдесят медяков».~
@28124 = ~«Забудь. Я пока не достал костюм».~
@28125 = ~«Я могу посмотреть, нет ли у него другого костюма».~
@28126 = ~«Я попробую достать другой… но это будет тебе стоить».~
@28127 = ~«Вот беда. Прощай».~
@28128 = ~Уйти.~
@28129 = ~«Я вернусь с другим костюмом».~
@28130 = ~«Конечно… но тебе это будет стоить».~
@28131 = ~«Неважно, забудь моё предложение. Прощай».~
@28132 = ~«Пожалуй. Я вернусь с другим костюмом».~
@28133 = ~«Вообще-то забудь моё предложение. Прощай».~
@28134 = ~«Нет, ещё нет».~
@28135 = ~«Нет, пока нет. У него есть другой костюм, но он хочет за него пятьдесят медяков».~
@28136 = ~Ложь: «Нет, пока нет. У него есть другой костюм, но он хочет за него восемьдесят медяков».~
