@19830 = ~«Расскажи о Харгримме».~
@19831 = ~«Безмолвный Король?»~
@19832 = ~«„Попадут под попечение“?»~
@19833 = ~«У меня другие вопросы…»~
@19834 = ~«Это всё, что я хотел узнать. Прощай».~
@19835 = ~«Подопечными?»~
@19836 = ~«Кто такой Безмолвный Король?»~
@19837 = ~«У меня другие вопросы…»~
@19838 = ~«Это всё, что я хотел узнать. Прощай».~
@19839 = ~«Не особо. У меня кое-какие вопросы».~
@19840 = ~«Нет пока. Прощай».~
@19841 = ~«У меня другие вопросы…»~
@19842 = ~«Это всё, что я хотел узнать. Прощай».~
@19843 = ~«Безмолвный Король».~
@19844 = ~«Харгримм».~
@19845 = ~«Тухлая Мэри».~
@19846 = ~«Акаста».~
@19847 = ~«Соэго».~
@19848 = ~«Неважно. У меня другие вопросы».~
@19849 = ~«Ни о ком, забудь. До свиданья».~
@19850 = ~«Расскажи мне о Безмолвном Короле».~
@19851 = ~«Позволь спросить кое о ком другом…»~
@19852 = ~«У меня другие вопросы…»~
@19853 = ~«Это всё, что я хотел узнать. Прощай».~
@19854 = ~«Расскажи мне о зомби».~
@19855 = ~«Позволь спросить кое о ком другом…»~
@19856 = ~«У меня другие вопросы…»~
@19857 = ~«Это всё, что я хотел узнать. Прощай».~
@19858 = ~«Расскажи мне об упырях».~
@19859 = ~«Позволь спросить кое о ком другом…»~
@19860 = ~«У меня другие вопросы…»~
@19861 = ~«Это всё, что я хотел узнать. Прощай».~
@19862 = ~Другой~
@19863 = ~Бесполый~
@19864 = ~Оба~
@19865 = ~Охранник выпрямляется. «Ты принёс то, что нужно Фароду, пень?»~
@19866 = ~«Да».~
@19867 = ~«Ещё нет».~
@19868 = ~«Покажи мне, пень, — и я открою. Но не раньше, понял?»~
@19869 = ~Показать.~
@19870 = ~«Ладно, у меня нет того, что нужно. Но есть то, что может тебя заинтересовать».~
@19871 = ~«Я так не думаю. Ещё вернусь».~
@19872 = ~«Если нет, зачем тратишь моё время попусту?» — он сдавленно фыркает.~
@19873 = ~«У меня есть то, что может тебя заинтересовать».~
@19874 = ~«Ладно. Пока прощай».~
@19875 = ~«Хорошо, проходи».~
@19876 = ~«Спасибо».~
@19877 = ~«Да ну? И что же это?»~
@19878 = ~«Медяки. Как насчёт монетки?»~
@19879 = ~«Медяки. Как насчёт десяти монет?»~
@19880 = ~«Медяки. Как насчёт двадцати пяти монет?»~
@19881 = ~«Медяки. Как насчёт пятидесяти монет?»~
@19882 = ~«Медяки. Как насчёт пятидесяти монет?»~
@19883 = ~«Медяки. Как насчёт сотни монет?»~
@19884 = ~«А с другой стороны, ничего».~
@19885 = ~«Забудь».~
@19886 = ~«Тогда тебе не вернуться, пень», — он плюёт тебе под ноги.~
@19887 = ~«Тогда прощай».~
@19888 = ~Он криво улыбается: «Ты почти оскорбляешь меня, пень. Попробуй ещё раз».~
@19889 = ~«Ладно. Как насчёт десяти монет?»~
@19890 = ~«Ладно. Как насчёт двадцати пяти монет?»~
@19891 = ~Малый меч~
@19892 = ~«Ладно. Как насчёт пятидесяти монет?»~
@19893 = ~«Ладно. Как насчёт пятидесяти монет?»~
@19894 = ~Дробящее оружие~
@19895 = ~«Ладно. Как насчёт сотни монет?»~
@19896 = ~«Забудь».~
@19897 = ~Топор~
@19898 = ~Дистанционное оружие~
@19899 = ~«Я так не думаю…»~
@19900 = ~«Ладно. Как насчёт двадцати пяти монет?»~
@19901 = ~«Ладно. Как насчёт пятидесяти монет?»~
@19902 = ~«Ладно. Как насчёт пятидесяти монет?»~
@19903 = ~«Ладно. Как насчёт сотни монет?»~
@19904 = ~«Забудь».~
@19905 = ~«Тепло, пень, но не горячо».~
@19906 = ~«Ладно. Как насчёт пятидесяти монет?»~
@19907 = ~«Ладно. Как насчёт пятидесяти монет?»~
@19908 = ~«Ладно. Как насчёт сотни монет?»~
@19909 = ~«Забудь».~
@19910 = ~Его уродливое лицо бороздит улыбка: «Неплохо, неплохо. Гони сюда, и я открою ворота».~
@19911 = ~«Но у меня нет достаточного количества».~
@19912 = ~Отдать пятьдесят медяков: «Вот. Тут вся сумма».~
@19913 = ~Отдать сорок медяков: «Вот. Тут вся сумма».~
@19914 = ~Заставить его тянуться за мешочком: «Схватишь — будет твоё».~
@19915 = ~«Забудь. Я лучше в катакомбы вернусь».~
@19916 = ~Он задумывается, затем отвечает: «Нет. Хочешь войти — гони больше».~
@19917 = ~«Ладно. Как насчёт сотни монет?»~
@19918 = ~«Забудь».~
@19919 = ~«Вот это дело. Звучит просто прекрасно. Гони сюда, и я открою ворота».~
@19920 = ~«Но у меня нет достаточного количества».~
@19921 = ~Отдать сто медяков: «Вот. Тут вся сумма».~
@19922 = ~Отдать девяносто медяков: «Вот. Тут вся сумма».~
@19923 = ~Заставить его тянуться за мешочком: «Схватишь — будет твоё».~
@19924 = ~«Забудь. Я лучше в катакомбы вернусь».~
@19925 = ~Монеты сыплются у охранника между пальцами, он прикидывает их вес и говорит: «Похоже, тут достаточно». Он открывает ворота.~
@19926 = ~«До встречи».~
@19927 = ~«Очень жаль. Увидимся, когда раздобудешь. До того момента ты не пройдёшь», — он отворачивается.~
@19928 = ~«Ну и ладно…»~
@19929 = ~Он тянется к мешочку сквозь решётку.~
@19930 = ~Схватить его руку и заломить.~
@19931 = ~Схватить его руку и заломить.~
@19932 = ~Схватить его руку и заломить.~
@19933 = ~Схватить его руку и заломить.~
@19934 = ~Отдать пятьдесят медяков: «Вот. Тут вся сумма».~
@19935 = ~Отдать сорок медяков: «Вот. Тут вся сумма».~
@19936 = ~«Но у меня нет достаточного количества».~
@19937 = ~«Забудь. Я иду обратно».~
@19938 = ~Он тянется к мешочку сквозь решётку.~
@19939 = ~Схватить его руку и заломить.~
@19940 = ~Схватить его руку и заломить.~
@19941 = ~Схватить его руку и заломить.~
@19942 = ~Схватить его руку и заломить.~
@19943 = ~«Но у меня нет достаточного количества».~
@19944 = ~Отдать сто медяков: «Вот. Тут вся сумма».~
@19945 = ~Отдать девяносто медяков: «Вот. Тут вся сумма».~
@19946 = ~«Забудь. Я лучше в катакомбы вернусь».~
@19947 = ~Ты легко захватываешь его руку и заламываешь её. Охранник кричит от боли в заломленном суставе.~
@19948 = ~«Пропускай меня, или я сломаю руку!»~
@19949 = ~Отпустить его. «Теперь пропусти меня, или разорву на части. Больше мы не играем по твоим правилам».~
@19950 = ~Как только он дотягивается до монет, ты захватываешь его руку. Он пытается вырваться, но тебе в конце концов удаётся её заломить. Охранник кричит от боли.~
@19951 = ~«Пропускай меня, или я сломаю руку!»~
@19952 = ~Отпустить его. «Теперь пропусти меня, или разорву на части. Больше мы не играем по твоим правилам».~
@19953 = ~Он поспешно открывает ворота, пока ты воплотил угрозу в жизнь, и отбегает на безопасное, по его мнению, расстояние.~
@19954 = ~«Перейдёшь мне дорожку опять — и твои конечности будут собирать по разным склепам. Уяснил? Замечательно».~
@19955 = ~«Усвоил урок? Я рассчитываю на большее твоё уважение в следующий раз. Пока».~
@19956 = ~Охранник смотрит на тебя угрожающе. «Теперь проход будет стоить тебе две сотни, пень. И никаких больше шуточек!»~
@19957 = ~«У меня столько нет».~
@19958 = ~«Хорошо. Держи».~
@19959 = ~«Забудь».~
@19960 = ~Мужчина внимательно пересчитывает монеты. Наконец удостоверившись, что ты не обманул его даже на медяк, он отпирает ворота. «Не забудь, пень… теперь тебе каждый проход будет стоить столько же!»~
@19961 = ~«Ну да, конечно».~
@19962 = ~«Не волнуйся, я не бедствую».~
@19963 = ~Охранник слегка выпрямляется: «У тебя есть деньги заплатить сбор?»~
@19964 = ~«В большинстве мест нет. Но тут — надо».~
@19965 = ~«Сбор? И сколько?»~
@19966 = ~«Я не знал, что здесь за проход надо платить».~
@19967 = ~«Нет. Прощай».~
@19968 = ~«И сколько?»~
@19969 = ~«И сколько?»~
@19970 = ~«Тогда забудь. Прощай».~
@19971 = ~«Для тебя? Пятьдесят монет».~
@19972 = ~«Пятьдесят? Не думаю, что смогу столько заплатить».~
@19973 = ~«Полагаю, такую сумму потяну».~
@19974 = ~«Забудь».~
@19975 = ~«Для тебя? Сотня монет».~
@19976 = ~«Сотня? Не думаю, что смогу столько заплатить».~
@19977 = ~«Полагаю, такую сумму потяну».~
@19978 = ~«Забудь».~
@19979 = ~«Чего тебе ещё надо?»~
@19980 = ~«Фарод сказал мне спуститься вниз, в катакомбы. Открой ворота».~
@19981 = ~«Что там, за воротами?»~
@19982 = ~«Что там, за воротами?»~
@19983 = ~«Можешь опять открыть для меня ворота?»~
@19984 = ~«Что ты можешь рассказать об области за воротами?»~
@19985 = ~«Я хочу спуститься».~
@19986 = ~«Кто ты?»~
@19987 = ~«Чем занимаешься?»~
@19988 = ~«Ничего. Прощай».~
@19989 = ~Ты видишь крупного человека в пёстрых обносках, от которого разит элем. Он настоящий великан — очевидно, что на эту работу его выбрали благодаря мускулам, а вовсе не мозгам. «Чего тебе надо?»~
@19990 = ~«Фарод сказал мне спуститься вниз, в катакомбы. Открой ворота».~
@19991 = ~«Что там, за воротами?»~
@19992 = ~«Что там, за воротами?»~
@19993 = ~«Что ты можешь рассказать об области за воротами?»~
@19994 = ~«Я хочу спуститься».~
@19995 = ~«Кто ты?»~
@19996 = ~«Чем занимаешься?»~
@19997 = ~«Ничего. Прощай».~
@19998 = ~Он распахивает ворота: «Вали, пень, да поживее».~
@19999 = ~«Прощай».~
@20000 = ~«Катакомбы Плачущих Камней. Много трупаков, много склепов для разграбления».~
@20001 = ~«Почему они называются катакомбы Плачущих Камней?»~
@20002 = ~«А поподробнее знаешь?»~
@20003 = ~«Спасибо. У меня другие вопросы…»~
@20004 = ~«Спасибо. Прощай».~
@20005 = ~«Много воды сверху капает, стены выглядят, будто плачут. Вот и назвали так».~
@20006 = ~«Ясно. Можешь ответить ещё на пару вопросов?»~
@20007 = ~«Спасибо».~
@20008 = ~«Не особо. Сам-то я спускался туда только раз или два… в основном другие там за трупаками рыскают. Грызь оттуда много добычи таскал, но я так понимаю, что-то его там поймало и прописало в книгу мёртвых».~
@20009 = ~«Грызь?»~
@20010 = ~«Ясно. У меня другие вопросы…»~
@20011 = ~«Ясно. Прощай».~
@20012 = ~«Да, „Стервятник Грызь“. Он с парой парней пошли и не вернулись несколько пиков назад. Найдёшь тело — тащи сюда, — он скалит зубы, как шакал. — Можно будет толкнуть Пылюкам, медяками разживёмся».~
@20013 = ~«Ха. У меня есть ещё вопросы…»~
@20014 = ~«Хорошо. Прощай».~
@20015 = ~Охранник окидывает тебя взглядом и лыбится: «Спальня твоей матушки. Мы держим ворота закрытыми, поскольку не хотим, чтоб всякие шлялись туда-сюда, — он разражается хохотом. — Проваливай, пока не присоединился к трупакам внизу».~
@20016 = ~«Просто ответь мне на пару вопросов…»~
@20017 = ~«Ладно».~
@20018 = ~Охранник бросает на тебя взгляд и качает головой: «Да, да… всем нам туда прям невтерпёж. Погляди-ка. Ты явно не из местных. Проваливай».~
@20019 = ~«Тогда просто ответь мне на пару вопросов…»~
@20020 = ~«Хорошо».~
@20021 = ~Он окидывает тебя взглядом и без лишних слов открывает ворота.~
@20022 = ~«Прощай».~
@20023 = ~«Не твоё собачье дело, по правде говоря. Отвали».~
@20024 = ~«Ответь мне сначала на пару вопросов…»~
@20025 = ~«Спасибо… друг».~
@20026 = ~«А чем я, по-твоему, занимаюсь, трусы стираю? Отвали, тупой пень!»~
@20027 = ~«Только один вопрос…»~
@20028 = ~«Как скажешь».~
@20029 = ~Измождённая женщина смотрит на тебя с ужасом в глазах и, прежде чем ты с ней заговариваешь, убегает.~
@20030 = ~«Тогда пока…»~
@20031 = ~Женщина смотрит на тебя со страхом, глаза её в широко распахнуты: «Стой где стоишь, пень, и я тебя не трону!»~
@20032 = ~«Успокойся. Я просто хочу знать, кто ты».~
@20033 = ~«Эй, расслабься. Чем занимаешься?»~
@20034 = ~«Чего ты боишься?»~
@20035 = ~«Хорошо. Прощай».~
@20036 = ~«Кто я? — она горько смеётся. — Спроси ещё имя у песчинки, здоровяк, ведь я значу не больше!»~
@20037 = ~«Какая жизнеутверждающая точка зрения. Могу я задать пару вопросов?»~
@20038 = ~«Ясно. Прощай».~
@20039 = ~«Давай… что тебе нужно знать?»~
@20040 = ~«Кто ты?»~
@20041 = ~«Чем занимаешься?»~
@20042 = ~«Чего ты боишься?»~
@20043 = ~«Неважно. Прощай».~
@20044 = ~«Чем занимаюсь? Ну, всего лишь цепляюсь за тяжкую жизнь под Площадью Мусорщиков и бегаю от тех, благодаря кому я здесь. Вот и всё».~
@20045 = ~«Ладно. У меня другие вопросы…»~
@20046 = ~«Спасибо. Прощай».~
@20047 = ~«Всего лишь хотела убедиться, что ты не из существ, которые разорвали Фарода».~
@20048 = ~«Существ? Каких существ?»~
@20049 = ~«Фарод мёртв?»~
@20050 = ~«У меня другие вопросы…»~
@20051 = ~«Ясно. Прощай».~
@20052 = ~«Угу, пришли создания ночи и тьмы, создания нежизни, распугали всех своим холодом и исчезли во дворе Фарода. Его крик стоит в ушах до сих пор…»~
@20053 = ~«Ладно. Скажи мне ещё кое-что…»~
@20054 = ~«Это всё, что я хотел узнать. Прощай».~
@20055 = ~Она вытирает сопли рукавом: «Чего тебе надо в этот раз?»~
@20056 = ~«Мне нужны ответы».~
@20057 = ~«Ничего. Прощай».~
@20058 = ~Ты видишь измождённую женщину, на её морщинистом от забот лице виден каждый шрам, который оставило время. Её глаза смотрят понимающе и устало, при разговоре она хлюпает носом: «Чего от меня надо?»~
@20059 = ~«Ответы на кое-какие вопросы…»~
@20060 = ~«Ничего. Прощай».~
@20061 = ~«Мы встретились снова, м-м?» — он широко улыбается.~
@20062 = ~«О… опять ты», — он хмуро глядит вдаль.~
@20063 = ~«У меня есть несколько вопросов…»~
@20064 = ~«Просто проходил мимо. Пока».~
@20065 = ~«У меня есть несколько вопросов…»~
@20066 = ~«Просто проходил мимо. Пока».~
@20067 = ~Оборванец бросается бежать при твоём приближении, страх искажает черты его лица.~
@20068 = ~«Может, в другой раз…»~
@20069 = ~Мужчина в лохмотьях смотрит на тебя со страхом, затем понимает, что прямо сейчас ты его убивать не будешь, и успокаивается: «Чё надо, пень?»~
@20070 = ~«Кто ты?»~
@20071 = ~«Чем занимаешься?»~
@20072 = ~«Чего ты боишься?»~
@20073 = ~«Ничего. Прощай».~
@20074 = ~«Неважно, здоровяк. Давным-давно ныкаюсь от властей… а может, и от себя. Так или иначе, я просто ещё один, кто пытается заработать на жизнь любыми возможными способами».~
@20075 = ~«Ладно. У меня другие вопросы».~
@20076 = ~«Ясно. Прощай».~
@20077 = ~«Только быстро, здоровяк, мне надо кормить немало ртов».~
@20078 = ~«Кто ты?»~
@20079 = ~«Чем занимаешься?»~
@20080 = ~«Чего ты боишься?»~
@20081 = ~«Тогда забудь. Прощай».~
@20082 = ~«Пытаюсь выжить. А на что это похоже? И у меня нету времени отвечать на вопросы. Ты уже закончил?»~
@20083 = ~«Нет. У меня другие вопросы…»~
@20084 = ~«Пока».~
@20085 = ~«В смысле, кроме дабусов, которые закладывают это место кирпичами, и Твердоголовых, которые нас обчищают, и трупаков, которые лезут из катакомб снизу, и черепокрыс, которые пытаются нас захватить, и всех остальных, кто режет нам глотки, и голода? Кроме повседневных вещей я боюсь тех существ, что прикончили Фарода».~
@20086 = ~«Существ? Каких существ?»~
@20087 = ~«Фарод мёртв?»~
@20088 = ~«У меня другие вопросы…»~
@20089 = ~«Ясно. Прощай».~
@20090 = ~«Существа прям из пасти Баатора — вот, кто это был… создания темнейшего ночного кошмара и ужаса, тени и ничего больше. Они его схватили и разорвали. Совсем ничего не осталось. Или почти ничего — мы похоронили то, что смогли найти».~
@20091 = ~«Ладно. Скажи мне ещё кое-что…»~
@20092 = ~«Это всё, что я хотел узнать. Прощай».~
@20093 = ~Он громко кашляет в руку. «Чё опять надо?»~
@20094 = ~«Мне нужны ответы».~
@20095 = ~«Ничего. Прощай».~
@20096 = ~Ты видишь оборванца, облачённого в сшитую из лоскутов одежду. От него воняет дымом и отбросами, а кожа имеет желтоватый оттенок. Он косится на тебя: «Чё от меня надо, паря?»~
@20097 = ~«Просто ответь на кое-какие вопросы…»~
@20098 = ~«Ничего. Прощай».~
@20099 = ~«Опять?!»~
@20100 = ~«У меня вопросы…»~
@20101 = ~«Пустяки, просто проходил мимо. Прощай».~
@20102 = ~Тело как будто уменьшилось в размерах, ссутулившись под тяжестью отчаяния духа.~
@20103 = ~«У меня есть несколько вопросов…»~
@20104 = ~«Просто проходил мимо. Прощай».~
@20105 = ~ХАРАКТЕР

Отражает склонность к добру или злу, порядку или хаосу.~
@20106 = ~ФРАКЦИЯ

Группа с едиными убеждениями о природе мультивселенной. Планами правит вера; если многие верят в идею — она становится реальностью.~
@20107 = ~Нет ответа.~
@20108 = ~Уйти.~
@20109 = ~Унылый мужчина смотрит на тебя, в его глазах мелькает огонёк надежды. Однако говорит он так же невыразительно, как и всегда: «Дала ли она тебе моё имя и номер? Она предложила деньги, не так ли? Я не могу жить. Деньги без имени не значат ничего. Дай мне имя. Дала ли она тебе его?»~
@20110 = ~«Да, дала».~
@20111 = ~Ложь: «Нет, пока не дала».~
@20112 = ~«Нет, пока не дала».~
@20113 = ~«Нет, пока не дала. Подожди. Прощай».~
@20114 = ~Шквал эмоций бороздит его каменное лицо. «Прости меня, если ошибаюсь в суждениях о тебе, — говорит он. — Я вижу по твоему лицу, что моё имя и номер у тебя, а голос говорит, что нет. Я спрашиваю снова. Есть ли у тебя моё имя и номер?»~
@20115 = ~Ложь: «Нет, нету».~
@20116 = ~«Да, есть».~
@20117 = ~«Ответь мне на пару вопросов сначала…»~
@20118 = ~«Третий раз должен я спросить и больше не стану. Таково правило. Есть ли у тебя моё имя и номер?»~
@20119 = ~Ложь: «Нет».~
@20120 = ~«Да, есть».~
@20121 = ~«Ответь мне на пару вопросов сначала…»~
@20122 = ~«Нет здесь справедливости. Я был обманут и не могу говорить об этом. Я — ничто и останусь таким навсегда. Мы не встретимся больше».~
@20123 = ~«Погоди, у меня есть твоё имя и номер…»~
@20124 = ~«Ответь мне на пару вопросов сначала…»~
@20125 = ~«Ладно, как хочешь».~
@20126 = ~Он качает головой, разворачивается и уходит.~
@20127 = ~«Тогда прощай».~
@20128 = ~«Могу ли я взять их?»~
@20129 = ~«Что ты дашь мне взамен?»~
@20130 = ~«Да. Твоё имя Ку'у Йин. Держи номер».~
@20131 = ~«Нет».~
@20132 = ~«Я не могу дать ничего, потому что ничем не владею. Можешь ли ты отдать мне имя и номер?»~
@20133 = ~«Да. Твоё имя Ку'у Йин. Держи номер».~
@20134 = ~«Нет».~
@20135 = ~«Спасибо за имя и номер. Да. Ку'у Йин. Да. Но нет. Теперь я осознал, что номер мне больше не нужен. Я найду себе новый, если понадобится. Старый номер отдаю тебе. Он — покров закона. Защита. Принимаешь ли ты его?»~
@20136 = ~«Да».~
@20137 = ~«Нет».~
@20138 = ~Он принимает подарок с серьёзным видом: «Спасибо за имя и номер. Да. Ку'у Йин. Да. Мои благодарности. Я запомню тебя». Он накидывает номер на шею, как шарф, и тот тонет в складках его кожи. Ку'у Йин собирается уходить.~
@20139 = ~«Погоди. Ответь мне на кое-какие вопросы…»~
@20140 = ~«Прощай».~
@20141 = ~«Пусть он согреет тебя. Верь в него. Он защитит тебя. Прощай», — он разворачивается и собирается уходить.~
@20142 = ~«Погоди. Ответь мне на кое-какие вопросы…»~
@20143 = ~«Прощай».~
@20144 = ~«И какие же?»~
@20145 = ~«Расскажи мне о себе».~
@20146 = ~«Расскажи мне об этом месте».~
@20147 = ~«Что ты делаешь?»~
@20148 = ~«Никакие, забудь. Прощай».~
@20149 = ~«Я — Ку'у Йин. Пришёл сюда случайно. Но теперь я здесь и намерен узнать больше. Должен узнать больше».~
@20150 = ~«У меня другие вопросы…»~
@20151 = ~«Удачи тебе. Прощай».~
@20152 = ~«Я сам намерен узнать о нём. С именем — я вновь личность. Я могу учиться. И я буду учиться».~
@20153 = ~«У меня другие вопросы…»~
@20154 = ~«Удачи тебе. Прощай».~
@20155 = ~«Готовлюсь предстать перед новым миром с моей старой личностью. Теперь я знаю, чего следует избегать. Я намерен узнать всё возможное. Теперь я готов».~
@20156 = ~«У меня другие вопросы…»~
@20157 = ~«Удачи тебе. Прощай».~
@20158 = ~Он накидывает номер на шею, как шарф, и тот тонет в складках его кожи. «Тогда я буду носить свой старый номер. Мои благодарности. Прощай». Он разворачивается и собирается идти к выходу.~
@20159 = ~«У меня кое-какие вопросы…»~
@20160 = ~«Удачи тебе. Прощай».~
@20161 = ~Когда ты приближаешься, он без всякого выражения говорит: «Я умоляю тебя, продолжай переговоры с воровкой. Без имени и номера я ничто».~
@20162 = ~«Уже иду. Но не ответишь мне сперва на пару вопросов?»~
@20163 = ~«Хорошо. Прощай».~
@20164 = ~«Что тебе нужно знать?»~
@20165 = ~«Расскажи мне о себе».~
@20166 = ~«Расскажи мне о себе».~
@20167 = ~«Расскажи мне об этом месте».~
@20168 = ~«Расскажи мне о Сигиле».~
@20169 = ~«Ничего. Прощай».~
@20170 = ~«Ничего. Прощай».~
@20171 = ~«Нашёл ли ты женщину с моим именем и номером? Она где-то в деревне. Она скажет тебе, что выиграла их, но это не так. Она украла их. Мне нужны моё имя и номер».~
@20172 = ~Ложь: «Нет, пока не нашёл».~
@20173 = ~«Да, твоё имя и номер у меня».~
@20174 = ~«Нашёл. Но она их не отдаёт».~
@20175 = ~«Пока у меня их нет».~
@20176 = ~На мгновение он бледнеет: «Она должна. Они мои. Она украла их у меня. Я прошу у тебя помощи».~
@20177 = ~«Хорошо».~
@20178 = ~«А как насчёт пары вопросов…»~
@20179 = ~«Забудь об этом».~
@20180 = ~«Я нуждаюсь в помощи. Признателен буду любому содействию. Прошу, помоги».~
@20181 = ~«Начнём с вопросов…»~
@20182 = ~«Прощай».~
@20183 = ~«Когда-то я жил в мире металлических машин и открывающихся словом дверей. Я грежу о древних металлических городах и пустых оболочках — наших людях. Всё, что у меня было в жизни, — имя и номер, как и у всех моих собратьев. А теперь у меня нет ни имени, ни номера. Они украдены. Без них я ничто. Я прошу твоей помощи…»~
@20184 = ~«Посмотрю, что можно сделать. Но сначала — пара вопросов…»~
@20185 = ~«У кого твои имя и номер?»~
@20186 = ~«Что ты можешь мне дать?»~
@20187 = ~«Посмотрим. У меня кое-какие вопросы…»~
@20188 = ~«Посмотрим. Прощай».~
@20189 = ~«Попробую. Прощай».~
@20190 = ~«Я ничего не знаю. Я не знаю это место. У меня нет ни имени, ни номера, ни воспоминаний об этом месте. Мне холодно. Я напуган. Так странно быть беззащитным. Боюсь, я умру».~
@20191 = ~«Что ты имеешь в виду?»~
@20192 = ~«Что ты имеешь в виду?»~
@20193 = ~«У меня другие вопросы…»~
@20194 = ~«Хм. Любопытно. Прощай».~
@20195 = ~«Хм. Любопытно. Прощай».~
@20196 = ~«У меня ничего нет. Я прошу твоей помощи».~
@20197 = ~«Посмотрю, что можно сделать. У меня другие вопросы…»~
@20198 = ~«Посмотрим. У меня другие вопросы…»~
@20199 = ~«Забудь. Прощай».~
@20200 = ~«Попробую. Прощай».~
@20201 = ~«Некто, кто была Радин. Она украла их у меня. Я предложил ей защиту своего имени и номера, а она украла их у меня. Они мои по праву и на законном основании. Найди её. Она где-то в деревне».~
@20202 = ~«Посмотрю, что можно сделать. Но сначала — пара вопросов…»~
@20203 = ~«Жестоко. Ответь на пару вопросов…»~
@20204 = ~«Посмотрю, что тут можно сделать».~
@20205 = ~«Да, нехорошо. Прощай».~
@20206 = ~Ты видишь странного серого мужчину с идеально круглым лицом. Он смотрит без выражения и ничего не говорит. По виду его голос должен быть безжизненным, как пустыня.~
@20207 = ~«Приветствую. Я бы хотел услышать ответы на пару вопросов…»~
@20208 = ~Оставить его в покое.~
@20209 = ~Женщина при виде тебя визжит и бросается наутёк. Ты успеваешь заметить, как извивается татуировка у неё на шее.~
@20210 = ~«Стой…»~
@20211 = ~Отпустить её.~
@20212 = ~Она морщит лицо, завидев тебя снова: «Он опять отказался, не так ли? И ты, конечно же, пришёл забрать то, что по праву моё».~
@20213 = ~«Твоё? У тебя нет прав на эти имя и номер. Ты их украла».~
@20214 = ~«Тебе не нужен номер, чтобы жить. А ему нужен. Ты должна отдать его, даже если это причинит тебе боль. В конечном счёте так будет лучше для вас обоих».~
@20215 = ~«Отдай сама, или я заберу силой».~
@20216 = ~«Тебе не нужен его номер, чтобы жить. Заведи свой собственный, пусть он тебя греет».~
@20217 = ~«Ладно. Прощай, Радин».~
@20218 = ~«Полагаю, ты прав. Я была плохой, несомненно, и не могу оставить это у себя. Вот, — она отдирает отслаивающуюся татуировку от шеи и отдаёт тебе. — И скажи ему его имя — Ку'у Йин. Теперь позволь мне уйти».~
@20219 = ~«Вот тебе немножко монет за беспокойство — купи себе что-нибудь согреться».~
@20220 = ~«Спасибо. Ответь мне на пару вопросов…»~
@20221 = ~«Спасибо. Прощай».~
@20222 = ~От твоих угроз её бросает в дрожь. «А он ещё сказал мне, что номер защитит меня от плохих людей. Забери тогда эту проклятую штуку, хватит с меня!» — она отрывает от шеи татуировку, прихватив порядочный кусок кожи, и бросается бежать.~
@20223 = ~Преследовать.~
@20224 = ~Отпустить её.~
@20225 = ~«Благодарю, здоровяк, — она кладёт деньги в карман и на мгновение кажется посеревшей, когда улетучивается магия татуировки. — Теперь мне лучше уйти… с помощью твоих медяков, быть может, мы когда-нибудь встретимся при более благоприятных обстоятельствах».~
@20226 = ~«Да. Прощай, Радин».~
@20227 = ~«Не кради больше имён, Радин. Прощай».~
@20228 = ~Она отворачивается и бредёт прочь, с безжизненным видом без татуировки, придававшей ей ауру таинственности. Ты видишь её в последний раз.~
@20229 = ~«Прощай».~
@20230 = ~Она безучастно смотрит, как ты возвращаешься, а затем встряхивается от своего оцепенения. При этом татуировка на её шее извивается. «Опять ты, а, здоровяк? Я же сказала, что не отдам татуировку и имя. Вот что я скажу: мне с ними постоянно везёт. Давай я лучше хорошо за них заплачу, а он себе не хуже купит?»~
@20231 = ~«Сколько дашь?»~
@20232 = ~«Не думаю. Мне нужны имя и номер».~
@20233 = ~«Как насчёт двадцати монет? Они должны преодолеть затруднения и позволить ему разжиться новым набором, а? Будь добр, скажи ему, может, он согласится».~
@20234 = ~«Просто отдай мне имя и номер, или мне придётся их из тебя вытрясти. Поверь, тебе это не понравится».~
@20235 = ~«Хорошо, я поговорю с ним. Но ответь мне на пару вопросов…»~
@20236 = ~«Хорошо, я поговорю с ним».~
@20237 = ~«Может, отвечу, а может — нет».~
@20238 = ~«Расскажи мне про себя».~
@20239 = ~«Расскажи мне об этом месте».~
@20240 = ~«Расскажи мне об этой татуировке».~
@20241 = ~«Повтори, какую цену ты называла?»~
@20242 = ~«Тогда забудь».~
@20243 = ~«Меня? У меня теперь два имени, но скажу я тебе только одно — не хочу, чтобы ты украл у меня новое, хи-хи! Можешь называть меня Радин, лапа, но другое имя останется при мне!»~
@20244 = ~«Мужчина, которому принадлежало это имя и номер, умирает. Он не может без них».~
@20245 = ~«Знаю, это будет для тебя нелегко, но… не будешь ли ты так добра и не отдашь ли ему имя и номер?»~
@20246 = ~«Два имени, да? Наверное, это здорово».~
@20247 = ~«Ещё бы. У меня другие вопросы…»~
@20248 = ~«Хорошо. Прощай».~
@20249 = ~«Эта извивающаяся штука? Это идентификационный номер, который мне дал один добрый приятель, когда увидел, как я замерзаю без защиты. Теперь он со мной, и я счастлива как никогда».~
@20250 = ~«Этот приятель хочет его вернуть».~
@20251 = ~«Интересно. А как он работает?»~
@20252 = ~«Ясно. У меня другие вопросы…»~
@20253 = ~«Ясно. Прощай».~
@20254 = ~«Похороненная деревня? Полагаю, достаточно милое место, если не считать вони трупов, мусора на крышах и постоянного писка крыс. Но тут холодно — особенно, без защиты номера».~
@20255 = ~«Как тебя зовут?»~
@20256 = ~«Расскажи мне о номере».~
@20257 = ~«У меня другие вопросы…»~
@20258 = ~«Ясно. Прощай».~
@20259 = ~Её голос перерастает в визг: «Ну уж нет, он их не получит! Он предложил мне сам, и я оставлю их себе. Он ничего не говорил, что даёт *взаймы*, и не заикался о возврате. Ничего он не получит! Так ему и скажи! Если ему и правда нужно имя, пускай забирает моё… имя „Радин“ любому неплохо подойдёт!»~
@20260 = ~«Если оно не устраивает тебя, почему ты думаешь, что оно подойдёт ему?»~
@20261 = ~«Я дам ему знать. Ответь мне на кое-какие вопросы…»~
@20262 = ~«Я скажу ему. Прощай».~
@20263 = ~«Да, милашка, так оно и есть».~
@20264 = ~«Мужчина, которому принадлежало это имя и номер, умирает. Он не может без них».~
@20265 = ~«Знаю, это будет для тебя нелегко, но… не будешь ли ты так добра и не отдашь ли ему имя и номер?»~
@20266 = ~«Можешь ответить на другие вопросы?»~
@20267 = ~«Спасибо. Прощай».~
@20268 = ~«Номера дают безопасность. С безопасностью приходит тепло, а с теплом — комфорт. И это всё дают номера, дорогуша, если только ты чтишь их силу».~
@20269 = ~«Мужчина, который дал тебе этот номер, хочет забрать его назад…»~
@20270 = ~«Ясно. У меня другие вопросы…»~
@20271 = ~«Ясно. Прощай».~
@20272 = ~«Огромная разница — вырасти с именем или получить другое, дорогуша. Новое положение после старого имени может изменить всё. Видишь, чего я добилась с этим?»~
@20273 = ~«Я поговорю с ним об этом. Ответь мне на кое-какие вопросы…»~
@20274 = ~«Ладно, я ему скажу. Прощай».~
@20275 = ~У женщины снова отсутствующий взгляд, но в этот раз она не так далеко — твоё появление пугает её уже не так сильно: «А, опять ты?»~
@20276 = ~«Ты Радин? Мужчина, у которого ты забрала имя, хочет его вернуть».~
@20277 = ~«У меня кое-какие вопросы…»~
@20278 = ~«Неважно. Прощай».~
@20279 = ~Ты видишь женщину в блёклой одежде, которая полностью погружена в себя. Хотя её лицо покрыто морщинами, как будто новая жизнь светится сквозь старую кожу. На её шею нанесена узорчатая татуировка. Она вздрагивает, когда ты с ней заговариваешь: «А? Что тебе надо?»~
@20280 = ~«Просто хотел задать тебе пару вопросов…»~
@20281 = ~«Ничего. Прощай».~
@20282 = ~Скелет бормочет себе под нос, иногда прерываясь, чтобы почесать черепушку. Он достаточно стар, и на его костях не осталось ни следа плоти… лишь пара цветных тряпок.~
@20283 = ~Он кивает в ответ, но ничего не говорит.~
@20284 = ~Скелет поднимает на тебя взгляд и расстроенно ворчит: «Не сейчас! Прости, но у меня тут *кошмарная* загадка, и я не могу её разгадать!»~
@20285 = ~Он выглядит удивлённым: «О? Неужели намерен попробовать?»~
@20286 = ~«Хорошо. Это загадка того хихикающего и паясничающего мешка с костями, которого ты можешь обнаружить поблизости. Он отказывается дать мне ответ, и меня это просто *убивает*!»~
@20287 = ~Он кивает: «Подумай о словах, которые кончаются на „ОФЕ“. Два таких слова: кофе и подшофе. Всего во всеобщем планарном языке три слова… какое третье? Это нечто, что используют каждый день. Если ты слушал внимательно, ты это слово только что слышал».~
@20288 = ~Он смотрит скептически: «*Что*? Но…»~
@20289 = ~[нет текста]~
@20290 = ~«Это… это… ох! Какая коварная уловка! Да у меня ведь даже нет языка! — его разбирает смех, пыль клубами летит из его скрипучих челюстей. — Замечательно, я запомню. Спасибо тебе!»~
@20291 = ~«Заковыристо, да? Дай мне знать, если тебе посчастливиться найти ответ… или выведать его у того болтливого придурка, который загадал мне загадку!»~
@20292 = ~Скелет поднимает взгляд: «Ну как, решил эту подлую загадку?»~
@20293 = ~«И снова спасибо, что решил загадку! Полагаю, мой „друг“ будет сильно огорчён!» — вид у него ликующий.~
@20294 = ~«Но… но почему? Эй, ну же! Ты *должен* мне сказать!»~
@20295 = ~Он разочарованно скрежещет зубами: «Тьфу! Точь-в-точь как этот… этот… пустомеля с пылью вместо мозгов! А теперь и *ты*! Премного благодарен!»~
@20296 = ~«Приветствую…»~
@20297 = ~Оставить скелет в покое.~
@20298 = ~«У меня кое-какие вопросы…»~
@20299 = ~«Мне пора идти».~
@20300 = ~«И что за загадка?»~
@20301 = ~«Тогда прощай».~
@20302 = ~«Да, давай».~
@20303 = ~«Нет, не бери в голову. Прощай».~
@20304 = ~«Продолжай же…»~
@20305 = ~«Конечно слышал. Это „язык“».~
@20306 = ~«Это… э-э… хм».~
@20307 = ~«Я подумаю. До свидания».~
@20308 = ~«Первые два предложения не имеют значения, они только чтобы тебя запутать. Вспомни: всего во „всеобщем планарном языке“ три слова. И третье слово как раз „язык“».~
@20309 = ~Посмеяться и уйти.~
@20310 = ~«Конечно. Прощай».~
@20311 = ~«Прощай».~
@20312 = ~«Да. Это „язык“».~
@20313 = ~«Да, но ответ тебе не скажу».~
@20314 = ~Ложь: «Э… нет. Прощай».~
@20315 = ~«Нет. Расскажи-ка мне загадку ещё раз».~
@20316 = ~«Нет, ещё нет. Прощай».~
@20317 = ~«Конечно. Прощай».~
@20318 = ~«Хорошо, это „язык“».~
@20319 = ~«Хорошо, это „язык“».~
@20320 = ~«Я обещал, что не скажу».~
@20321 = ~Разве? Прощай».~
@20322 = ~«Хорошо, хорошо, это „язык“».~
@20323 = ~«Ну, прости. Прощай».~
@20324 = ~Скелет трясёт головой и хихикает под нос. Временами он откровенно гогочет и фыркает, затыкая себе рот костистой рукой. Он достаточно стар, и на его костях не осталось ни следа плоти… лишь пара цветных тряпок.~
@20325 = ~«Приветствую, да!» — он давится от смеха, с каждым выдохом из пасти вырывается клуб пыли.~
@20326 = ~«Лучше бы тебе поискать ответы в другом месте, ибо у меня нет желания слушать твои вопросы, — он фыркает, прикрывая рот. — Я знаю, это страшно грубо, но ты должен меня простить».~
@20327 = ~Он издевательски прыскает: «Как бы не так!» Твоё выражение лица вызывает у него ещё более беспардонный смех, его зубы клацают.~
@20328 = ~Смех резко прекращается. «Хмф!» — скелет отворачивает от тебя голову.~
@20329 = ~Хихикая, он кивает: «Желаешь ли её услушать?»~
@20330 = ~«Гм! Подумай о словах, которые кончаются на „ОФЕ“. Два таких слова: кофе и подшофе. Всего во всеобщем планарном языке три слова… какое третье? Это нечто, что используют каждый день. Если ты слушал внимательно, ты это слово только что слышал».~
@20331 = ~«А-а-а! Откуда ты знаешь?!»~
@20332 = ~[нет текста]~
@20333 = ~«Ай, объедки троллей! А, ладно. Просто никому не рассказывай ответ. Хоть это мне обещаешь?»~
@20334 = ~«Потому как меня забавляет идея, что они целую вечность будут тут стоять и думать над разрешением загадки, — он зло хихикает, прикрывая рот костистой рукой. — Ладно? Ты обещаешь?»~
@20335 = ~«Помни… — его разбирает смех. — Не говори ответ никому!»~
@20336 = ~«Негодяй! Всё веселье мне испортил, провались ты в Баатор!» — скелет отворачивается.~
@20337 = ~«Погоди, погоди! Никому не рассказывай ответ. Хоть это мне обещаешь?»~
@20338 = ~Скелет разражается приступом издевательского хохота. Он показывает на тебя пальцем и стучит от смеха зубами, держась рукой за воображаемый живот.~
@20339 = ~«Ни за что! Ни за что!» — твоё обескураженное выражение лица вызывает у него ещё более беспардонный смех, его зубы клацают.~
@20340 = ~Смех неожиданно прерывается. «Что такое? — он подпирает костистой ладонью череп, склоняя голову. — Неужели я слышу… вызов? Да… да, давай! Но буде ты проиграешь или сдашься на полпути, я с тобой больше не разговариваю!»~
@20341 = ~Он с нетерпением кивает.~
@20342 = ~«Просто, слишком просто! Фунт золота *всегда* стоит больше, чем полфунта! Глупо, глупо!» — он хихикает.~
@20343 = ~Скелет приседает и пальцем рисует в пыли лицо. Показывает на рисунок и говорит: «Ни братьев, ни дядек нет у меня, но отец этого парня — сын моего отца. Кто это?»~
@20344 = ~«Тьфу! Твоя очередь».~
@20345 = ~Скелет глупо хихикает. «Неправда, неправда! Ответ — „гроб“, а свой гроб я, безусловно, вижу!»~
@20346 = ~«Какое слово даже величайший из смертных мудрецов произнесёт неправильно?»~
@20347 = ~Он грозит тебе кулаком: «О-о-о, проклятье! Продолжай».~
@20348 = ~«Э-э… м-м-м… звёзды! Звёзды, хи-хи!»~
@20349 = ~Скелет трещит суставами. «Меня никогда не было, я всегда буду. Меня никто не видел и никогда не увидит. И всё же можно быть уверенней всего, что в этих залах жить я буду».~
@20350 = ~«А-а-ай! Да, завтра, разумеется. Тогда продолжай».~
@20351 = ~Скелет саркастически хихикает, но внезапно останавливается: «А… гм. О боже!»~
@20352 = ~Скелет опускает голову: «Я… я не знаю».~
@20353 = ~Он кивает. «Хорошо, ответ — „язык“. Первые два предложения не имеют значения, они только чтобы тебя запутать. Вспомни: всего во „всеобщем планарном языке“ три слова. И третье слово как раз „язык“, — он громко вздыхает. — А твой ответ?»~
@20354 = ~«Хе… занятно. Так каков же ответ? Эй… постой! Куда ты пошёл?»~
@20355 = ~Скелет заходится в громком, истерическом смехе. Его хохот и улюлюканье эхом летит по катакомбам, череп ликующе вертится на шее, зубы клацают.~
@20356 = ~«Приветствую…»~
@20357 = ~Игнорировать и пройти мимо.~
@20358 = ~«Я так понимаю, у тебя есть сложная загадка».~
@20359 = ~«Я хотел бы услышать ответ на одну из твоих загадок».~
@20360 = ~«У меня кое-какие вопросы…»~
@20361 = ~«Мне пора идти. Прощай».~
@20362 = ~«Я так понимаю, у тебя есть сложная загадка».~
@20363 = ~«Я хотел бы услышать ответ на одну из твоих загадок».~
@20364 = ~«Хорошо, поищу кого-нибудь другого. Прощай».~
@20365 = ~«А что за загадка?»~
@20366 = ~Правда: «Расскажи мне, иначе я просто разобью тебя на маленькие хихикающие кусочки».~
@20367 = ~Блеф: «Расскажи мне, иначе я просто разобью тебя на маленькие хихикающие кусочки».~
@20368 = ~«Тогда прощай».~
@20369 = ~~
@20370 = ~Уйти.~
@20371 = ~«Да».~
@20372 = ~«Нет, прощай».~
@20373 = ~«Конечно слышал, это „язык“».~
@20374 = ~«Это… э-э… хм».~
@20375 = ~«Мне нужно подумать. Прощай».~
@20376 = ~«Первые два предложения не имеют значения, они только чтобы тебя запутать. Смотри: всего во „всеобщем планарном языке“ три слова. И третье слово как раз „язык“».~
@20377 = ~Посмеяться и уйти.~
@20378 = ~«И зачем мне обещать?»~
@20379 = ~«Конечно, я обещаю, что не расскажу никому. Прощай».~
@20380 = ~«Не буду я ничего обещать. Прощай».~
@20381 = ~«Конечно, я обещаю, что не расскажу никому. Прощай».~
@20382 = ~«Не буду я ничего обещать. Прощай».~
@20383 = ~«Помню, помню. Прощай».~
@20384 = ~Уйти.~
@20385 = ~«И зачем мне обещать?»~
@20386 = ~«Конечно, я обещаю, что не расскажу никому. Прощай».~
@20387 = ~«Не буду я ничего обещать. Прощай».~
@20388 = ~«Хорошо, но каков ответ?»~
@20389 = ~«Хе. Прощай».~
@20390 = ~«А что, если мне удастся поставить в тупик *тебя*? Тогда скажешь?»~
@20391 = ~Правда: «Расскажи мне, иначе я просто разобью тебя на маленькие хихикающие кусочки».~
@20392 = ~Блеф: «Расскажи мне, иначе я просто разобью тебя на маленькие хихикающие кусочки».~
@20393 = ~«Тогда прощай».~
@20394 = ~«Хорошо. Начнём».~
@20395 = ~«Тогда забудь. Прощай».~
@20396 = ~«Хм-м. Скажи, что стоит больше: фунт золотых монет достоинством по сотне обычных медяков или же полфунта, но по две сотни?»~
@20397 = ~«Нет, забудь. Прощай».~
@20398 = ~«Хорошо, твоя очередь».~
@20399 = ~«Нет, забудь. Прощай».~
@20400 = ~«Твой сын».~
@20401 = ~«Я… не знаю».~
@20402 = ~«Нет, забудь. Прощай».~
@20403 = ~«Тому, кто изготовил, это не нужно. Тот, кто купил, этим не пользуется. Тот, кто это использует, этого не видит. Что это?»~
@20404 = ~«Нет, забудь. Прощай».~
@20405 = ~«Хорошо, твоя очередь».~
@20406 = ~«Нет, забудь. Прощай».~
@20407 = ~«Хм-м. „Неправильно“».~
@20408 = ~«Я… не знаю».~
@20409 = ~«Нет, забудь. Прощай».~
@20410 = ~«Ночью их не приносят, но они появляются. Утром их не крадут, но они исчезают».~
@20411 = ~«Нет, забудь. Прощай».~
@20412 = ~«Да, конечно. Загадывай».~
@20413 = ~«Нет, забудь. Прощай».~
@20414 = ~«Ответ… ответ… а! „Завтра“».~
@20415 = ~«Я… не знаю».~
@20416 = ~«Нет, забудь. Прощай».~
@20417 = ~«Конечно. Скажи-ка, с чего начинается вечность, что стоит в начале времён, конце пространств и содержится в каждом слове?»~
@20418 = ~«Нет, забудь. Прощай».~
@20419 = ~«Ну? Я жду ответа».~
@20420 = ~Показать ему, как ты умеешь издевательски хохотать.~
@20421 = ~Терпеливо ждать.~
@20422 = ~«Говори мне ответ на твою загадку, а я тебе скажу ответ на мою».~
@20423 = ~«Буква „В“».~
@20424 = ~«Ни за что, ни за что! Прощай».~
@20425 = ~«Ладно. Буква „В“».~
@20426 = ~Посмеяться и уйти.~
@20427 = ~~
@20428 = ~Уйти.~
@20429 = ~Карта мира~
@20430 = ~Задания~
@20431 = ~Ложь: «Я сожалею, что был груб… и хотел бы извиниться».~
@20432 = ~Женщина, похоже, тебя не слышит. Она уткнулась в один из длинных столов и продолжает возиться с лежащим на нём трупом. «Ну же, давай… — она щёлкает зубами. — Не будь таким упрямым с Мартой… он упрямится, правда, Марта?… Да-да, он упрямится…»~
@20433 = ~Насколько удаётся разглядеть, она вырывает зубы у трупа… пользуясь только своими руками и ногтями. Когда у неё не выходит, она берёт расколотое деревянное долото с молотком и выколачивает их с омерзительным *хрустом*, после чего складывает в мешок на поясе.~
@20434 = ~Марта испуганно отскакивает от трупа и пронзительно визжит: «Айи-и-и!» Отдышавшись, она сердито шипит телу на столе: «Если не мёртвый ты, мог бы и раньше сказать, лживый труп, мерзкий труп, да! Неужто у тебя никакого *стыда* нету?»~
@20435 = ~«Ха!» — Марта упирает руки в боки и возмущёно надувается. «Как будто тебе твои зубы не *без разницы*! Все гнилые, дырявые и коричневые — странно, как ещё не повыпадывали! — она чешет в затылке. — Не так ли, Марта? Ага, все гнилые и выпадывают…»~
@20436 = ~«Ха! Ты слышишь это, Марта? Слышишь? — лицо Марты морщится, как выжатая тряпка. — Я слышу это, Марта! Слышу!» Рыча, она бросается на тело с кулаками и начинает его колошматить: «Ну же, попреследуй меня ещё! Вот тебе! Вот тебе!»~
@20437 = ~«Долбаные трупаки… — Марта глубоко вздыхает и роняет долото. — Так уже лучше, а, Марта? Да, да… тело тихое… да».~
@20438 = ~Марта косится и поворачивается: «А? Как ты оказался тут так шустро?» Она бормочет под нос: «Марта, как он это сделал? Без понятия, без понятия».~
@20439 = ~Марта продолжает бормотать под нос, что-то про *трупы* и *благодарность*, но остальное разобрать не получается.~
@20440 = ~Марта косится и поворачивается: «А? Как ты оказался тут так шустро?» Она бормочет под нос: «Марта, как он это сделал? Без понятия, без понятия».~
@20441 = ~«Марта, этот что, спрашивает, кто я? Ага, спрашивает, спрашивает… — она начинает напевать. — Никто кроме меня, я Марта, Марта Швея… хм-м-м… Мар-та Шве-я, Ма-рта Шве-е-ея…» Она отворачивается к трупу, мурлыкая под нос своё имя.~
@20442 = ~Марта раздражённо поворачивается обратно к трупу. «Пытаюсь помочь этому пню освободиться от зубов со швами, а он ну никак не желает способ-ствовать, нет-нет…» — она грозит трупу пальцем, словно маленькому ребёнку. «Упрям как камень, не так ли, Марта? — она надувает губы. — Да-да, упрям…»~
@20443 = ~«Он сказал „вопросы“, Марта?.. — Марта моргает, затем хмурится. — Ага, Марта, он так сказал, судя по вопросительной морде, верно…»~
@20444 = ~«Щас мы распустим швы и вытянем зубки… э, Марта, без твоей помощи не обойтись… да уж *помогу*, куда денусь, дырка старая… не надо так со мной… распустим швы, вытянем зубки, да. И штучки внутри».~
@20445 = ~«Штучечки».~
@20446 = ~«Откладываю их, Марта, вот чего я делаю, — она скребёт голову. — Ага, Марта, мы так и делаем… нитки и зубики дорогие, за них дадут денюжку. „Мы приносим трупы, а ты обирай, — сказали они Марте. — Извлекай зубки, нитки, штучки изнутри, оставляй голыми, а мы продадим их Пыльненьким“».~
@20447 = ~Марта хмурится. «Разве мы не сказали, что продаём их, Марта? — она хмурится ещё сильней и трясёт головой. — Ага, Марта, мы сказали. Пыльненькие забирают тела, но сначала мы берём, что можно».~
@20448 = ~«Штучки, штучечки… — она криво пожимает плечами. — Другие забирают их».~
@20449 = ~«Толстомордый свинтус Квинт, да ещё другой старый хромой костыль, хромой костыль Фарод, правда, Марта? — она кивает с безумной ухмылкой. — Ну да, так и есть, Марта…»~
@20450 = ~Марта пожимает плечами. «Он что, спросил, где Фарод? Да тута он, Марта, верно?.. — она кивает. — Ага, Фарод тута, Марта. В одном из тутошних домов, вот…»~
@20451 = ~«Продают. Продают за блестяшечки».~
@20452 = ~Марта косится на тебя: «Хмн-н». Затем кивает: «Марта может это сделать, ведь может, Марта? Да, может».~
@20453 = ~Марта косится на тебя: «Хмн-н». Затем кивает: «Марта может это сделать, ведь может, Марта? Да, может». Она вытаскивает своё расколотое долото. «Где? Где…» — Марта оглядывает тебя, как будто ищет место, где тебя было бы удобнее вскрыть.~
@20454 = ~«Где? Где…» — Марта оглядывает тебя, как будто ищет место, где тебя было бы удобнее вскрыть.~
@20455 = ~Твоё зрение медленно возвращается… ты видишь склонившуюся над тобой Марту, покачивающую головой. «Ничего, ничего не нашли, а, Марта? — она трясёт головой. — Нет, ничего, Марта, не повезло… может, попробовать ещё разок?»~
@20456 = ~Она выглядит сбитой с толку. «Продажа? Бабки-бабки? Неужто ты здесь, чтоб их забрать, а? Забрать нитки, кости, зубки?»~
@20457 = ~«Вот тебе, коль пришёл… — она пихает тебе вещи. — Всё, что есть, всё, что есть…»~
@20458 = ~Она глазеет на монеты в твоей руке, словно не понимает, что с ними делать. «Блестяшки-блестяшечки? Блестят…» — она хмурится. «Чего они опять хотят, Марта? — бормочет она. — Марта… Марта, чего они хотят?»~
@20459 = ~Марта кивает. «Марта дома, Марта тут спит; можешь и ты спать, коль хочется, да. Никаких проблем, Марта… ведь так, Марта? — она трясёт головой. — Нет-нет, Марта, никаких, раз уж и у тебя никаких…»~
@20460 = ~Как только ты заговариваешь, Марта окидывает тебя взглядом. «Он сказал „вопросы“, Марта?.. — Марта моргает, затем хмурится. — Ага, Марта, он так сказал, судя по вопросительной морде, верно…»~
@20461 = ~«Штучки внутри, штучечки… да, Марта? — она кивает, потом качает головой. — Когда они там есть, Марта, когда они там есть…»~
@20462 = ~Ты лежишь на столе и последнее, что видишь, — стоящую над тобой Марту с долотом и молотком наготове. Слышится отчётливое *крак*, ты кричишь, а вокруг всё темнеет.~
@20463 = ~Ты лежишь на столе, а Марта стоит над тобой с молотком и долотом наготове. Она вскрывает грудную клетку с отчётливым *крак* и начинает ковыряться у тебя в лёгких. Крик застревает в глотке… ты судорожно пытаешься вдохнуть, но не получается, затем от боли вокруг тебя смыкается темнота.~
@20464 = ~Ты лежишь на столе, а Марта стоит над тобой со ржавым ножом в руках. Тебя пронзает острая боль, когда она вспарывает брюшную полость и грубо пилит дальше, открывая кишки. Несмотря на боль, ты молча наблюдаешь и чувствуешь нездоровое восхищение зрелищем, как она выворачивает твои органы, что-то напевая себе под нос…~
@20465 = ~«А-а!» Страшная волна боли захлёстывает тебя, как только Марта поднимает выше массу твоих кишок, оттуда брызжет кровь и ещё что-то… «Глянь-ка на это, Марта… глянь-ка… вижу, вижу, подрежем чуть-чуть тут и тут…» — Марта ловко делает небольшой надрез с одной из сторон, и ты слышишь, как со *звоном* что-то металлическое падает на пол.~
@20466 = ~Марта сваливает твои кишки обратно в брюшную полость и поднимает что-то маленькое с пола. Кольцо… это становится понятно, как только она показывает его тебе. «Прелесть, прелесть, а, Марта? — она кивает. — Да, Марта, ему не следовало глотать такие вещички, нет, нет…»~
@20467 = ~«Больше ничего нету, ведь нету, Марта? — она кивает. — Забрал всё в прошлый раз, было только это, больше ничего, ничего больше…»~
@20468 = ~Ты лежишь на столе, а Марта стоит над тобой со ржавым ножом в руках. Тебя пронзает острая боль, когда она вспарывает брюшную полость и грубо пилит дальше, открывая кишки. Несмотря на боль, ты наблюдаешь и чувствуешь нездоровое восхищение зрелищем, как она вытаскивает твой желудок…~
@20469 = ~«Эта могильная крыса слепа и почти глуха».~
@20470 = ~«Думаю, она имеет в виду органы. Я надеюсь, она имеет в виду органы».~
@20471 = ~Морте поворачивается к Марте: «Да, „штучечки“». Затем он поворачивается к тебе: «Это всё игра словами».~
@20472 = ~«Я даже *смотреть* на это не хочу».~
@20473 = ~«Приветствую».~
@20474 = ~Уйти.~
@20475 = ~«Привет, Марта».~
@20476 = ~«Марта, у меня к тебе вопросы…»~
@20477 = ~Не обращать на Марту внимания.~
@20478 = ~«Э-э… привет?»~
@20479 = ~Наблюдать за её действиями.~
@20480 = ~Наблюдать за её действиями.~
@20481 = ~Не обращать на Марту внимания.~
@20482 = ~«Эй… что ты делаешь?»~
@20483 = ~Игнорировать Марту и исследовать комнату.~
@20484 = ~Замогильный голос: «Это у *тебя* стыда нет. Вот так вышибать мои зубы… у тебя совсем никакого уважения к мёртвым?»~
@20485 = ~Замогильный голос: «Это у *тебя* стыда нет. Разбирать меня на части… у тебя совсем никакого уважения к мёртвым?»~
@20486 = ~«Это говорил я, а не тело».~
@20487 = ~«Это говорил я, а не тело».~
@20488 = ~Игнорировать Марту.~
@20489 = ~Замогильный голос: «У-у-у-у… ты будешь *наказана* за злостное воровство зубов, Марта. Я буду *преследовать* тебя до конца дней твоих…»~
@20490 = ~«Это говорил я, а не тело».~
@20491 = ~«Это говорил я, а не тело».~
@20492 = ~Игнорировать Марту.~
@20493 = ~Замогильный голос: «У-у-у-у… стой… стой… Больше я не буду преследовать тебя… прости меня…»~
@20494 = ~«Это говорил я, а не тело».~
@20495 = ~«Это говорил я, а не тело».~
@20496 = ~Игнорировать Марту.~
@20497 = ~«Это говорил я, а не тело».~
@20498 = ~«Это говорил я, а не тело».~
@20499 = ~Игнорировать Марту.~
@20500 = ~«Кто ты?»~
@20501 = ~«Хм… ладно. Мне пора уходить. Прощай».~
@20502 = ~«Кто ты?»~
@20503 = ~«Хм… ладно. Мне пора уходить. Прощай».~
@20504 = ~«Чем ты занимаешься?»~
@20505 = ~«Чем ты занимаешься?»~
@20506 = ~«Хм… ладно. Мне пора уходить. Прощай».~
@20507 = ~«Зубы… со швами? О чём ты?»~
@20508 = ~«Ясно. Могу я задать ещё пару вопросов?»~
@20509 = ~«Хм… ладно. Мне пора уходить. Прощай».~
@20510 = ~«Кто ты?»~
@20511 = ~«Чем ты занимаешься?»~
@20512 = ~«Зачем тебе зубы трупов?»~
@20513 = ~«Зачем тебе зубы трупов?»~
@20514 = ~«Слушай, а ты можешь покопаться в моём теле, вдруг что-нибудь найдёшь?»~
@20515 = ~«Слушай, а ты можешь покопаться в моём теле, вдруг что-нибудь найдёшь?»~
@20516 = ~«Могу я тут поспать?»~
@20517 = ~«Ты распускаешь швы у трупов… а не найдётся у тебя нитки с иголкой на продажу?»~
@20518 = ~«Могу я взять что-нибудь из того, что ты повытаскивала из тел?»~
@20519 = ~«Не покажешь мне, что нашла в трупах за последнее время?»~
@20520 = ~«Вопросов не будет, мне пора идти. Прощай».~
@20521 = ~«Штучки внутри?»~
@20522 = ~«Штучки внутри?»~
@20523 = ~«Зачем тебе зубы трупов?»~
@20524 = ~«Зачем тебе зубы трупов?»~
@20525 = ~«Ясно. Могу я задать ещё пару вопросов?»~
@20526 = ~«Хм… ладно. Мне пора уходить. Прощай».~
@20527 = ~«Продадим Пыльным?..»~
@20528 = ~«Кто сказал тебе эти заниматься?»~
@20529 = ~«Что ты находишь в телах?»~
@20530 = ~«Ты ищешь всякие штуки внутри трупов? А в моём теле не покопаешься, вдруг что-нибудь найдёшь?»~
@20531 = ~«Ты ищешь всякие штуки внутри трупов? А в моём теле не покопаешься, вдруг что-нибудь найдёшь?»~
@20532 = ~«Ты распускаешь швы у трупов… а не найдётся у тебя нитки с иголкой на продажу?»~
@20533 = ~«Могу я взять что-нибудь из того, что ты повытаскивала из тел?»~
@20534 = ~«Не покажешь мне, что нашла в трупах за последнее время?»~
@20535 = ~«Не возражаешь, если я тут отдохну?»~
@20536 = ~«Ясно. Могу я задать ещё пару вопросов?»~
@20537 = ~«Хм… ладно. Тогда прощай».~
@20538 = ~По-видимому, работа швеи Марты заключается в том, чтобы обирать трупы, которые ей дают, выдирать им зубы, распускать швы, искать внутри тел любые ценные предметы, а затем заштопывать обратно.~
@20539 = ~«Кто сказал тебе обирать тела?»~
@20540 = ~«Ясно. Могу я задать ещё пару вопросов?»~
@20541 = ~«Это всё, что я хотел узнать. Прощай».~
@20542 = ~«Кто?»~
@20543 = ~«Ясно. Могу я задать ещё пару вопросов?»~
@20544 = ~«Это всё, что я хотел узнать. Прощай».~
@20545 = ~«Фарод? А где он?»~
@20546 = ~«И что они делают с теми вещами, которые ты достаёшь из трупов?»~
@20547 = ~«Ясно. Могу я задать ещё пару вопросов?»~
@20548 = ~«Это всё, что я хотел узнать. Прощай».~
@20549 = ~«И что они делают с теми вещами, которые ты достаёшь из трупов?»~
@20550 = ~«Ясно. Могу я задать ещё пару вопросов?»~
@20551 = ~«Это всё, что я хотел узнать. Прощай».~
@20552 = ~«Ясно. Могу я задать ещё пару вопросов?»~
@20553 = ~«Это всё, что я хотел узнать. Прощай».~
@20554 = ~«Давай попробуем желудок…»~
@20555 = ~«Как насчёт грудной клетки?..»~
@20556 = ~«Посмотри в кишках… там может оказаться буквально что угодно».~
@20557 = ~«Слушай, а ты можешь вскрыть мой череп?»~
@20558 = ~«Не бери в голову. У меня другие вопросы…»~
@20559 = ~«Э-э… забудь. Прощай».~
@20560 = ~«Давай попробуем желудок…»~
@20561 = ~«Как насчёт грудной клетки?..»~
@20562 = ~«Посмотри в кишках… там может оказаться буквально что угодно».~
@20563 = ~«Слушай, а ты можешь вскрыть мой череп?»~
@20564 = ~«Не бери в голову. У меня другие вопросы…»~
@20565 = ~«Э-э… забудь. Прощай».~
@20566 = ~«Д-д-давай попробуем желудок…»~
@20567 = ~«К-к-как насчёт грудной клетки?..»~
@20568 = ~«Пу… п-п… посмотри в кишках… там может оказаться буквально что угодно».~
@20569 = ~«Сы… с… слушай, а ты можешь вскрыть мой череп?»~
@20570 = ~«Ны… н-н… н-нет, у меня есть ещё вопросы…»~
@20571 = ~«Не… н-нет пок-ка. Прощай».~
@20572 = ~Ложь: «Да, я здесь, чтобы их забрать».~
@20573 = ~«Нет, я не собираюсь ничего забирать, но кое-что купил бы».~
@20574 = ~«Нет, я не собираюсь ничего забирать, но кое-что купил бы… будь у меня деньги. А пока у меня есть ещё парочка вопросов».~
@20575 = ~«Не бери в голову. У меня другие вопросы…»~
@20576 = ~«Хм… не бери в голову. Прощай».~
@20577 = ~«Спасибо. У меня другие вопросы…»~
@20578 = ~«Спасибо… это может пригодиться. Прощай».~
@20579 = ~«Можно посмотреть, что у тебя есть?»~
@20580 = ~«Ничего. У меня другие вопросы…»~
@20581 = ~«Хм… не бери в голову. Прощай».~
@20582 = ~На самом деле покинуть планы?~
@20583 = ~«Отлично…»~
@20584 = ~«Пока я не хочу отдыхать. Но у меня ещё кое-какие вопросы…»~
@20585 = ~«Может, я вернусь, когда захочется спать. Прощай».~
@20586 = ~«Кто ты?»~
@20587 = ~«Чем ты занимаешься?»~
@20588 = ~«Зачем тебе зубы трупов?»~
@20589 = ~«Зачем тебе зубы трупов?»~
@20590 = ~«Слушай, а ты можешь покопаться в моём теле, вдруг что-нибудь найдёшь?»~
@20591 = ~«Слушай, а ты можешь покопаться в моём теле, вдруг что-нибудь найдёшь?»~
@20592 = ~«Могу я тут поспать?»~
@20593 = ~«Ты распускаешь швы у трупов… а не найдётся у тебя нитки с иголкой на продажу?»~
@20594 = ~«Могу я взять что-нибудь из того, что ты повытаскивала из тел?»~
@20595 = ~«Не покажешь мне, что нашла в трупах за последнее время?»~
@20596 = ~«Вопросов не будет, мне пора идти. Прощай».~
@20597 = ~«Зачем тебе зубы трупов?»~
@20598 = ~«Зачем тебе зубы трупов?»~
@20599 = ~«Ясно. Могу я задать ещё пару вопросов?»~
@20600 = ~«Хм… ладно. Мне пора уходить. Прощай».~
@20601 = ~Погрузиться во тьму…~
@20602 = ~Я попросил Марту… сумасшедшую швею из Похороненной деревни… заглянуть внутрь моего черепа и посмотреть, есть ли там что-нибудь необычное. Внутри ничего не оказалось.~
@20603 = ~Погрузиться во тьму…~
@20604 = ~Наблюдать…~
@20605 = ~Погрузиться во тьму…~
@20606 = ~«Урк-к-кх-х…»~
@20607 = ~Я попросил Марту, сумасшедшую швею из Похороненной деревни… пошариться в моих кишках и посмотреть, нет ли там чего-нибудь необычного. Она нашла кольцо… а в придачу оставила мне дополнительный комплект кишок.~
@20608 = ~«С-с-спа… спасибо. А там… что-нибудь… ещё было?»~
@20609 = ~«Ладно. У меня другие вопросы…»~
@20610 = ~«Тогда забудь. Прощай».~
@20611 = ~Наблюдать…~
@20612 = ~«Марта, зачем тебе зубы трупов?»~
@20613 = ~«Марта, зачем тебе зубы трупов?»~
@20614 = ~«Хм… ладно. Мне пора уходить. Прощай, Марта».~
@20615 = ~Тело лежит неподвижно. Как ни тормоши, не получается добиться от него ни слова, ни движения.~
@20616 = ~«Полагаю, это не зомби…»~
@20617 = ~Тело заметно дёргается, как если бы через него пропустили разряд, а изо рта исходит продолжительный вздох.~
@20618 = ~«Приветствую».~
@20619 = ~«Кто ты?»~
@20620 = ~«Мне нужно задать пару вопросов».~
@20621 = ~«Приветствую».~
@20622 = ~«Н-н-нгах-х! Агх-х-х…» — труп едва шевелит размягшим языком, ни слова разобрать не удаётся.~
@20623 = ~«Ну и ладно, забудь…»~
@20624 = ~«Ну и ладно, забудь…»~
@20625 = ~Анна нервно переступает ногами. «Лучше б те не связываться с мёртвыми. Плохая примета и всё такое».~
@20626 = ~«Ладно. Всё равно это тело ничего не говорит. Пошли».~
@20627 = ~Анна нервно переступает ногами. «Лучше б те не связываться с мёртвыми. Плохая примета и всё такое».~
@20628 = ~«Может, он ответит на кое-какие вопросы».~
@20629 = ~«Точняк, нечего тут вытрясаться. Пошли, ага? Ничего хорошего из возни с трупаками не выйдет».~
@20630 = ~«Пошли».~
@20631 = ~«Кто ты?»~
@20632 = ~«Мне нужно задать пару вопросов».~
@20633 = ~«Забудь».~
