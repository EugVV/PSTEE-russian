@16935 = ~«Спасибо, Грейс. Прощай, Плачущий-по-Деревьям».~
@16936 = ~«Спасибо. Морте? Ты как думаешь?»~
@16937 = ~«Спасибо. Анна? Не могла бы ты?»~
@16938 = ~«Спасибо. Игнус?»~
@16939 = ~«Спасибо. Грейс, не подумаешь?»~
@16940 = ~«Спасибо. Нордом, как ты думаешь, сможешь помочь?»~
@16941 = ~«Спасибо. Вейлор, не мог бы ты помочь?»~
@16942 = ~«Спасибо. У меня были кое-какие вопросы, Плачущий…»~
@16943 = ~«Спасибо, Дак'кон. Прощай, Плачущий-по-Деревьям».~
@16944 = ~«Хорошо. Морте? Ты как думаешь?»~
@16945 = ~«Хорошо. Анна? Не могла бы ты?»~
@16946 = ~«Хорошо. Игнус?»~
@16947 = ~«Хорошо. Грейс, не подумаешь?»~
@16948 = ~«Хорошо. Нордом, как ты думаешь, сможешь помочь?»~
@16949 = ~«Хорошо. Вейлор, не мог бы ты помочь?»~
@16950 = ~«Вот, Плачущий. У меня были кое-какие вопросы…»~
@16951 = ~«Это должно немного помочь, Плачущий-по-Деревьям. Прощай».~
@16952 = ~«Я прошу тебя помочь Плачущему в заботе о деревьях здесь».~
@16953 = ~«Я прошу тебя помочь Плачущему в заботе о деревьях здесь».~
@16954 = ~«Нордом: Желать, чтобы все деревья в районе Сигила „Улей“ стали здоровыми и цветущими».~
@16955 = ~«Нет… нет, я имел в виду „беспокоиться“. Дорожить».~
@16956 = ~«Нет… нет, я имел в виду „беспокоиться“. Дорожить».~
@16957 = ~«Неважно. У меня были кое-какие вопросы, Плачущий…»~
@16958 = ~«Забудь. Прощай, Плачущий-по-Деревьям».~
@16959 = ~«Ты выглядишь немного усталым».~
@16960 = ~«Да, госпожа Кел'лера».~
@16961 = ~«Эта часть расшаталась, проверь, пожалуйста».~
@16962 = ~«Всё нормально».~
@16963 = ~«Доклад о прогрессе?»~
@16964 = ~«Хм-м-м. Именно это может сработать».~
@16965 = ~«Попробуй-ка вот этот инструмент взамен».~
@16966 = ~«Ты прав. Спасибо».~
@16967 = ~«Тебе понадобится поменять эту часть на новую».~
@16968 = ~«Спасибо, госпожа Кел'лера».~
@16969 = ~«Хорошая работа, так держать».~
@16970 = ~«Неважно. Морте? Ты как думаешь?»~
@16971 = ~«Неважно. Анна? Не могла бы ты?»~
@16972 = ~«Неважно. Игнус?»~
@16973 = ~«Неважно. Грейс, не подумаешь?»~
@16974 = ~«Мы охраняем эту штуку уже довольно долго».~
@16975 = ~«У кого есть молот?»~
@16976 = ~«Кто взял гвозди?»~
@16977 = ~«Куда делся инструмент?»~
@16978 = ~«Да, госпожа».~
@16979 = ~«Не сдавайся».~
@16980 = ~::Зевает:: «Да, я пытаюсь решить проблему с этой частью».~
@16981 = ~«Неважно. Дак'кон, не поможешь этому человеку?»~
@16982 = ~«Неважно. Дак'кон: помоги этому человеку».~
@16983 = ~«Неважно. Вейлор, не мог бы ты помочь?»~
@16984 = ~«Неважно. У меня были кое-какие вопросы, Плачущий…»~
@16985 = ~«Эта машина когда-нибудь будет закончена?»~
@16986 = ~«И ЧТО ЖЕ ТЫ ДЕЛАЕШЬ?»~
@16987 = ~«Уже почти время перерыва, а?»~
@16988 = ~«Почти закончил с этой стороной».~
@16989 = ~«КХЕ! ЗАТЯНИ ещё немного!»~
@16990 = ~«Забудь. Прощай, Плачущий-по-Деревьям».~
@16991 = ~«Улей — это место Хаоса и разложения. Высоки шансы, что присутствие жизнеспособных деревьев принесёт в это место ощущение порядка».~
@16992 = ~«Высказанное желание приводится в осуществление немедленно».~
@16993 = ~«Улей — это место Хаоса и разложения. Высоки шансы, что присутствие жизнеспособных деревьев принесёт в это место ощущение порядка».~
@16994 = ~«Я благодарю тебя, Нордом. Морте? Ты как думаешь?»~
@16995 = ~«Я благодарю тебя, Нордом. Анна? Не могла бы ты?»~
@16996 = ~«Я благодарю тебя, Нордом. Игнус?»~
@16997 = ~«Я благодарю тебя, Нордом. Грейс, не подумаешь?»~
@16998 = ~«Я благодарю тебя, Нордом. Дак'кон, не поможешь этому человеку?»~
@16999 = ~«Я благодарю тебя, Нордом. Дак'кон: помоги этому человеку».~
@17000 = ~«Я благодарю тебя, Нордом. Вейлор, не мог бы ты помочь?»~
@17001 = ~«Я благодарю тебя, Нордом. У меня были кое-какие вопросы, Плачущий…»~
@17002 = ~«Я благодарю тебя, Нордом. Прощай, Плачущий-по-Деревьям».~
@17003 = ~«…Вейлор? Ты меня слышал?»~
@17004 = ~«Ладно. Морте? Ты как думаешь?»~
@17005 = ~«Ладно. Анна? Не могла бы ты?»~
@17006 = ~«Ладно. Игнус?»~
@17007 = ~«Ладно. Грейс, не подумаешь?»~
@17008 = ~«Ладно. Дак'кон, не поможешь этому человеку?»~
@17009 = ~«Ладно. Дак'кон: помоги этому человеку».~
@17010 = ~«Ладно. Нордом, как ты думаешь, сможешь помочь?»~
@17011 = ~«Ладно. У меня были кое-какие вопросы, Плачущий…»~
@17012 = ~«Хорошо, Вейлор. Прощай, Плачущий-по-Деревьям».~
@17013 = ~::Зевает::~
@17014 = ~«Прошу прощения, госпожа! Сейчас я её достану».~
@17015 = ~«УВЕРЕНА ЛИ Я? ДА!»~
@17016 = ~«Вы уверены?»~
@17017 = ~«ЭТА ДЕТАЛЬ СЮДА НЕ ПОДХОДИТ!»~
@17018 = ~«А?»~
@17019 = ~«Интересно, что же это такое?»~
@17020 = ~«Эта штука никогда не заработает».~
@17021 = ~«Привет, Боб!»~
@17022 = ~«Похоже, нет сегодня трупаков, кроме ходячих…»~
@17023 = ~«Похоже, Пыльные потеряли одного из своих трупаков…»~
@17024 = ~«Ах! Никогда не видала я ничего уродливей, нет…»~
@17025 = ~«Ты чё, *тупой*?! Мы привлечём взгляд Госпожи, если останемся здесь, эт точно!»~
@17026 = ~«Это ведь одна из студий Фелла, не так ли? Я давно хотела с ним встретиться».~
@17027 = ~«Смотри, чтобы это опять не случилось».~
@17028 = ~«Если я не смогу найти ни одного трупака, может, Пыльника выпотрошить…»~
@17029 = ~«А старый неряха с костылём подсчитывает щас медяки…»~
@17030 = ~«Медленный сигильский день…»~
