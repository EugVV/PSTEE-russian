@7981  = ~«Нет. Это не волнует его чувств».~
@7982  = ~«Да. Женщина, жена Ангияра, потеряла сына. Она очень тяжело переживает своё горе».~
@7983  = ~Ложь: «Э-э, да… мой друг… Адан его зовут… потерял близкого человека. Он сильно скорбит по умершему».~
@7984  = ~«Да, эта недавняя смерть повергла его в страшное горе и отчаяние».~
@7985  = ~«Прошу прощения… я оговорился. Прощай».~
@7986  = ~«Если бы вы могли, это облегчило бы мою боль».~
@7987  = ~«Нет, не нужно. Прощай».~
@7988  = ~«У меня другие вопросы…»~
@7989  = ~«Хорошо. Это всё, что я хотел узнать».~
@7990  = ~«Если бы вы могли, это облегчило бы его боль».~
@7991  = ~«Нет, не нужно. Прощай».~
@7992  = ~«Я хочу задать тебе несколько вопросов…»~
@7993  = ~Оставить их со своим пением.~
@7994  = ~«Этому человеку стало легче. Тот, кого вы оплакивали ранее, больше нуждается в вас, чем он».~
@7995  = ~«У меня другие вопросы…»~
@7996  = ~«Спасибо. Это всё, что я хотел узнать».~
@7997  = ~«Понимаю».~
@7998  = ~«Нет. Забудь».~
@7999  = ~«Хорошо. Кел'лера, я хотел спросить тебя…»~
@8000  = ~«Целая цепочка догадок. Она не ошиблась, Кел'лера?»~
@8001  = ~«Интересно. Буду иметь в виду. А сейчас, Кел'лера, ответь ещё на вопрос».~
@8002  = ~«Целая цепочка догадок. Она не ошиблась, Кел'лера?»~
@8003  = ~«Интересно. Буду иметь в виду. А сейчас, Кел'лера, ответь ещё на вопрос».~
@8004  = ~Эта личность в плаще с капюшоном ссутулилась возле входа в Мортуарий. Тень от капюшона скрывает его лицо… ты видишь только подбородок, заросший щетиной и покрытый какой-то нездоровой зелёной и багровой сыпью. Сыпь обильнее на шее, выше подбородка она исчезает.~
@8005  = ~«Приветствую».~
@8006  = ~Фигура не движется… сначала и не отвечает, потом говорит высоким, писклявым голосом, который больше подошёл бы десятилетней девочке, чем мужчине: «Хей?»~
@8007  = ~«Хей?»~
@8008  = ~«Чума я, хей».~
@8009  = ~«Хей, жду жмуриков, ага».~
@8010  = ~«Нахожу жмурика, проношу его через ворота, получаю свои медяки и опять жду, хей».~
@8011  = ~«Жмурики для Пыльных — что медяки для Сборщиков. Приносишь им трупака, а они тебе дают медяки у ворот, хей».~
@8012  = ~«Улицы чистые, жмурики все где положено, улицы не воняют, жмурики не пропадают, все внутри, все довольны, хей».~
@8013  = ~«Собирают жмуриков внутри, за воротами, кладут их на плиты, режут, закапывают или заставляют ходить, хей».~
@8014  = ~«Хей, они платят кое-что, если жмурик при жизни даёт Пыльным разрешение, а потом жмурик становится скелетом или зомбаком».~
@8015  = ~«Первенцем был, предки меня постоянно проклинали: „Чума тебя побери“. Так и прилипло, и накаркали, заразу подхватил, хей», — и вновь твоё внимание привлекает багрово-зеленоватая сыпь, покрывающая шею и подбородок Чумы.~
@8016  = ~Ты видишь Чуму, ссутулившегося у входа в Мортуарий. Он… или она… оно вроде и не пошевелилось с момента вашей последней встречи.~
@8017  = ~«Дай Чума посмотрит, как ты играешь в жмурика. Хороший будет жмурик, Чума тебя протащит, хей».~
@8018  = ~Чума наблюдает твоё представление без комментариев. Когда ты встаёшь, он говорит: «Пыльные не поверят, что ты жмурик. Всегда проверяют, сдох ли жмурик, и если жмурик дышит, не берут. Плохая сделка, хей».~
@8019  = ~Чума наблюдает твоё представление без комментариев. Когда ты встаёшь, он говорит: «Хей, Чума получит за тебя медяки. Так прям щас тебя продать?»~
@8020  = ~Кажется, вопрос Чуму нисколько не смущает: «Хей, могу, как в прошлый раз, хей?»~
@8021  = ~«Хей. Ты много раз просишь, Чума всегда делает».~
@8022  = ~«Много раз, хей».~
@8023  = ~«Хей».~
@8024  = ~«Ты жмурик, который недолго жмурик, хей. Дела делаешь с Чумой, угу».~
@8025  = ~«Ты жмурик, который недолго жмурик, хей. Дела делаешь с Чумой, угу».~
@8026  = ~Чума вынимает руки из-под плаща: руки все покрыты сыпью, в каждой ржавый кинжал. Два клинка со свистом прочерчивают линии поперёк твоего горла, и в глазах темнеет…~
@8027  = ~«Хей, Сборщики. Собирают жмуриков, тащат их к Пыльным, к воротам, за медяки».~
@8028  = ~«Хей, никаких дневи-ков не видел. Что в Улье с воза упало, то пропало, может, и дневик кому достался, хей».~
@8029  = ~«Хей, Фарод. Сборщик, шишка, громкое имя, длинную тень отбрасывает, хей».~
@8030  = ~«Хей, Сборщик. Собирает жмуриков, тащит их к Пыльным за медяки».~
@8031  = ~«Хей, здесь в Улье, здесь он. Где-то здесь, хей».~
@8032  = ~«Хей, где-то здесь в Улье, здесь он. Фарод прячется. Очень трудно найти, очень. Не стоит искать, нет».~
@8033  = ~«Хей, многие его ненавидят, даже другие Сборщики. Шергрейв ненавидит его, совсем не любит Фарода, хей».~
@8034  = ~«Хей, Шергрейв — большая шишка, большая, большая тень, ага. Скажет Чуме, что делать, — он сделает».~
@8035  = ~«Хей, Шергрейв знает дно. Знает, где прячется Фарод. Шергрейв на Площади Мусорщиков, несколько кварталов на запад, хей. Скажи Шергрейву, что ты от Чумы, скажи ему, Шергрейв с Чумой поделится медяками, хей».~
@8036  = ~«Хей, в ворота одни только жмуры и Пыльники проходят. Хочешь, Чума тебя опять жмуриком сделает?»~
@8037  = ~Оставить личность в покое.~
@8038  = ~«Кто ты?»~
@8039  = ~Оставить его в покое.~
@8040  = ~«Кто ты?»~
@8041  = ~«Как ты заработал имя „Чума“?»~
@8042  = ~«Чем занимаешься?»~
@8043  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@8044  = ~«Я потерял дневник… тебе он нигде не попадался?»~
@8045  = ~«Можешь посодействовать моему попаданию в Мортуарий?»~
@8046  = ~«Если я прикинусь жмуриком, можешь протащить меня внутрь?»~
@8047  = ~«Прости, что потревожил. Прощай».~
@8048  = ~«Хм… Чума?»~
@8049  = ~«Чем занимаешься?»~
@8050  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@8051  = ~«Я потерял дневник… тебе он нигде не попадался?»~
@8052  = ~«Прости, что потревожил. Прощай».~
@8053  = ~«„Жмуриков“? Трупы, что ли? Зачем?»~
@8054  = ~«Ясно. Слушай, у меня ещё вопросы…»~
@8055  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8056  = ~«Через ворота? Зачем?»~
@8057  = ~«Эти парадные ворота — единственный вход в Мортуарий?»~
@8058  = ~«Ясно. Слушай, у меня ещё вопросы…»~
@8059  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8060  = ~«Почему Пыльные платят за трупы?»~
@8061  = ~«Сборщики? Что это такое?»~
@8062  = ~«Эти парадные ворота — единственный вход в Мортуарий?»~
@8063  = ~«Ясно. Слушай, у меня ещё вопросы…»~
@8064  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8065  = ~«Что Пыльные *делают* с этими жмуриками, которых покупают?»~
@8066  = ~«Эти парадные ворота — единственный вход в Мортуарий?»~
@8067  = ~«Ясно. Слушай, у меня ещё вопросы…»~
@8068  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8069  = ~«Заставляют ходить?»~
@8070  = ~«Эти парадные ворота — единственный вход в Мортуарий?»~
@8071  = ~«Ясно. Слушай, у меня ещё вопросы…»~
@8072  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8073  = ~«Эти парадные ворота — единственный вход в Мортуарий?»~
@8074  = ~«Ясно. Слушай, у меня ещё вопросы…»~
@8075  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8076  = ~«Ого. У меня к тебе ещё пара вопросов…»~
@8077  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8078  = ~«Чума, у меня к тебе пара вопросов…»~
@8079  = ~Оставить Чуму в покое.~
@8080  = ~Прикинуться мёртвым…~
@8081  = ~Прикинуться мёртвым…~
@8082  = ~Прикинуться мёртвым…~
@8083  = ~Прикинуться мёртвым…~
@8084  = ~Прикинуться мёртвым…~
@8085  = ~«Не сейчас. Сперва у меня кое-какие вопросы…»~
@8086  = ~«Забудь, может, в другой раз. Прощай».~
@8087  = ~«А если бы я по-настоящему помер? Можешь выпотрошить меня и продать им моё тело?»~
@8088  = ~«Это проблема. У меня другие вопросы…»~
@8089  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8090  = ~«Да».~
@8091  = ~«Да».~
@8092  = ~~
@8093  = ~~
@8094  = ~«Нет, не сейчас. Сперва у меня кое-какие вопросы».~
@8095  = ~«Может, в другой раз, спасибо. Прощай».~
@8096  = ~«Да».~
@8097  = ~«Э-э… „в прошлый раз“?»~
@8098  = ~«Ясно. Слушай, у меня ещё вопросы…»~
@8099  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8100  = ~«Хм… а точнее, сколько раз?»~
@8101  = ~«Ясно. Слушай, у меня ещё вопросы…»~
@8102  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8103  = ~«Так… мы встречались и раньше?»~
@8104  = ~«Ясно. Слушай, у меня ещё вопросы…»~
@8105  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8106  = ~«Что ты знаешь обо мне?»~
@8107  = ~«Ясно. Слушай, у меня ещё вопросы…»~
@8108  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8109  = ~«Знаешь обо мне что-нибудь ещё?»~
@8110  = ~«Ясно. Слушай, у меня ещё вопросы…»~
@8111  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8112  = ~«Хм… знаешь ещё что-нибудь, кроме этого?»~
@8113  = ~«Тогда убей меня. Я хочу попасть в Мортуарий».~
@8114  = ~«Э-э, ну ладно. А если я просто прикинусь мёртвым и ты протащишь меня внутрь?»~
@8115  = ~«Хм-м. У меня другие вопросы…»~
@8116  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8117  = ~Погрузиться во тьму…~
@8118  = ~Погрузиться во тьму…~
@8119  = ~«Зачем Пыльным нужны мертвецы… эти жмурики?»~
@8120  = ~«Эти парадные ворота — единственный вход в Мортуарий?»~
@8121  = ~«Ясно. Слушай, у меня ещё вопросы…»~
@8122  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8123  = ~«Ясно. Слушай, у меня ещё вопросы…»~
@8124  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8125  = ~«Сборщик?»~
@8126  = ~«Не знаешь, где его можно найти?»~
@8127  = ~«У меня другие вопросы…»~
@8128  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8129  = ~«Не знаешь, где его можно найти?»~
@8130  = ~«О. У меня другие вопросы…»~
@8131  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8132  = ~«А поконкретней?»~
@8133  = ~«У меня другие вопросы…»~
@8134  = ~«Постараюсь его разыскать. Прощай».~
@8135  = ~«„Не стоит искать“? Что ты имеешь в виду?»~
@8136  = ~«У меня другие вопросы…»~
@8137  = ~«Спасибо, я сам его найду. Прощай».~
@8138  = ~«Шергрейв?»~
@8139  = ~«У меня другие вопросы…»~
@8140  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8141  = ~«Может, твой босс… этот Шергрейв… знает, где Фарод?»~
@8142  = ~«Может, твой босс… этот Шергрейв… знает, где Фарод?»~
@8143  = ~«Хм-м. У меня другие вопросы…»~
@8144  = ~«Это всё, что я хотел узнать, спасибо. Прощай».~
@8145  = ~«У меня другие вопросы…»~
@8146  = ~«Площадь Мусорщиков, к западу отсюда? Хорошо, пойду разыщу там этого Шергрейва».~
@8147  = ~«Э-э… опять?»~
@8148  = ~«Да, сделай из меня жмурика. Мне нужно попасть в Мортуарий».~
@8149  = ~«А как насчёт того, чтобы я просто прикинулся жмуриком? Так ты сможешь протащить меня внутрь?»~
@8150  = ~«Нет-нет… у меня другие вопросы…»~
@8151  = ~«Может, в другой раз, спасибо. Прощай».~
@8152  = ~«Надо бы снова пойти разыскивать этого пня».~
@8153  = ~«Хм-м-мф!»~
@8154  = ~«Где вы все?»~
@8155  = ~«Может, здесь?»~
@8156  = ~«Тьфу! Совершенно сухой!»~
@8157  = ~«Тьфу! Мне придётся самому убить какого-нибудь пня, если продолжится в том же духе!»~
@8158  = ~«Где же эти сраные трупы?!»~
@8159  = ~«Может, тут внизу есть жмурики?»~
@8160  = ~«Кто-нибудь вообще в этом городе *копыта отбрасывает*?»~
@8161  = ~«Трупаки?»~
@8162  = ~«Где же вы, мать вашу, жмурики?!»~
@8163  = ~«Трупаки! Вы где?»~
@8164  = ~«Трупаки! Эй?»~
@8165  = ~«Трупаки! Сюда, давайте сюда!»~
@8166  = ~«Мэри, радость моя, жмуриков не видела?»~
@8167  = ~«Может, Мэри что-то подскажет».~
@8168  = ~«Хм-мф. Тут ничего».~
@8169  = ~«Шари? Золотце? Жмуриков не видела?»~
@8170  = ~«А! Может, Шари знает».~
@8171  = ~«Тогда ладно…»~
@8172  = ~«Рози, пышечка, жмуриков не видела?»~
@8173  = ~«Эй, Рози!»~
@8174  = ~«А! Может, Рози спросить!»~
@8175  = ~«Куда… куда… куда вы удалились…»~
@8176  = ~«Хм-мф! Ядрёная девка!»~
@8177  = ~«Нэнси, ягодка, я ищу жмуриков… хоть какого-нибудь жмурика».~
@8178  = ~«А! Может, Нэнси знает о жмуриках!»~
@8179  = ~«Куда щас?..»~
@8180  = ~«Может, *третий* поворот налево?»~
@8181  = ~«Нет-нет… совсем не тот путь».~
@8182  = ~«Хм-м-мф. Хорошо, девочка».~
@8183  = ~«Я тебе медяка ломаного не заплачу, нет».~
@8184  = ~«Медяка ломаного?! Мои медяки не хуже, чем у этого засранца!»~
@8185  = ~«Кажется, я хожу по кругу…»~
@8186  = ~«Все эти улицы такие одинаковые…»~
@8187  = ~Исход души~
@8188  = ~Печень Хакарии~
@8189  = ~Сердце Хакарии~
@8190  = ~Выбор персонажа~
@8191  = ~Диалог~
@8192  = ~Выбор оружия~
@8193  = ~Выбор заклинания~
@8194  = ~Выбор предмета~
@8195  = ~Выбор особой способности~
@8196  = ~Кнопка действия~
@8197  = ~Прокрутить предметы влево~
@8198  = ~Прокрутить предметы вправо~
@8199  = ~Якорь меню (для перемещения нажмите и удерживайте кнопку)~
@8200  = ~Дни~
@8201  = ~Кажется, Пыльная услышала тебя, но не поднимает головы.~
@8202  = ~Все Пыльные выдерживают один и тот же тон и ритм. Песнь каждые несколько минут усиливается почти до крика, затем медленно затихает до еле слышного эха. Один раз она совсем прерывается, Пыльные произносят несколько фраз во славу «Истинной Смерти» и начинают свои завывания снова.~
@8203  = ~Пыльная поднимает голову. Она не прекращает пение, выдерживая тот же ритм и тон, что и остальные.~
@8204  = ~Пыльная ничего не отвечает, вместо этого она вновь склоняет голову и продолжает песнопение.~
@8205  = ~Плакальщица внезапно останавливается и изучает тебя: «Ты тоскуешь о том, кто умер?»~
@8206  = ~«Мы оплачем твою боль и боль её отца, если не возражаешь».~
@8207  = ~«Мы оплачем твою боль, если ты этого хочешь».~
@8208  = ~«Мы оплачем твою боль, если ты этого хочешь».~
@8209  = ~«Мы оплачем её боль, если она не возражает».~
@8210  = ~«Мы оплачем его боль, если он не возражает».~
@8211  = ~Пыльная кивает и продолжает пение.~
@8212  = ~Пыльная склоняет голову и продолжает пение.~
@8213  = ~«Мы оплакиваем».~
@8214  = ~«Мы не оплакиваем мёртвых. Мы оплакиваем живых».~
@8215  = ~«Мы оплакиваем живых, страдающих от потери».~
@8216  = ~«Когда душа достигает Истинной Смерти, она чаще всего освобождается от груза проблем. Когда же умер не ты, а дорогой тебе человек, часто возникает боль и чувство потери».~
@8217  = ~«Отчаяние и чувство потери — очень сильные чувства. Такие чувства привязывают живущего к этой форме существования, мешая ему достичь Истинной Смерти, когда смерть приходит к нему. Мы плачем о живых, находящихся в плену этих страстей».~
@8218  = ~«Иногда её называют окончательной смертью. Истинная Смерть — свобода от этого призрачного, мучительного существования. Свобода от чувств. Свобода от разума. Свобода от телесной оболочки».~
@8219  = ~Пыльная кивает: «Некоторые называют её и так, хотя это не совсем точно».~
@8220  = ~Пыльная ждёт.~
@8221  = ~Все Пыльные выдерживают один и тот же тон и ритм. В отличие от того песнопения, которое ты слышал при первом визите в мемориал, эта песнь циклична, похожа на ритм волн, набегающих на берег. Эта мысль почему-то будоражит твою память…~
@8222  = ~Ты смутно припоминаешь себя стоящим на далёком берегу… где-то в другом месте, далеко отсюда. С тобой женщина. Она стоит слева от тебя, на самой границе твоего бокового зрения, и ты не можешь разглядеть её фигуру. Когда ты пытаешься оживить воспоминание, оно пропадает…~
@8223  = ~…и ты снова оказываешься в толпе Пыльных-плакальщиков. Они поют так тихо, что их почти не слышно. Затем они прерываются, говорят несколько фраз во славу «Истинной Смерти» и снова начинают петь.~
@8224  = ~Все Пыльные выдерживают один и тот же тон и ритм. В отличие от того песнопения, которое ты слышал при первом визите в мемориал, эта песнь намного выше по тону и напоминает свист стрелы или посвист ветра в скалах. Песнь быстро начинается и быстро заканчивается — когда Пыльные замолкают, они говорят несколько фраз во славу «Истинной Смерти» и снова начинают петь.~
@8225  = ~Все Пыльные выдерживают один и тот же тон и ритм. В отличие от того песнопения, которое ты слышал при первом визите в мемориал, эта песнь несёт в себе силу и долю случайности — она непредсказуема, кажется, звук изменяется прямо на губах поющих. Но всё равно Пыльные прекрасно выдерживают эту дикую мелодию. Когда песнь наконец стихает почти до полной тишины, Пыльные говорят несколько фраз во славу «Истинной Смерти» и снова начинают петь.~
@8226  = ~В отличие от того песнопения, которое ты слышал при первом визите в мемориал, эта песнь тянется на одной ноте, вот уже несколько минут… она напоминает тебе звон огромного колокола. После окончания Пыльные какой-то миг молчат, затем говорят несколько фраз во славу «Истинной Смерти» и снова начинают петь свою «песнь».~
@8227  = ~В отличие от того песнопения, которое ты слышал при первом визите в мемориал, эта песнь более утончённа; временами они поют так тихо, что кажется, сейчас звук пропадёт в уличном шуме. Наконец Пыльные примерно на минуту полностью замолкают, затем говорят несколько фраз во славу «Истинной Смерти» и снова начинают петь свою «песнь».~
@8228  = ~Пыльная безучастно смотрит на тебя: «Наша песнь не менялась. Мы продолжали петь ту же самую песнь, что и начали».~
@8229  = ~Пыльная качает головой: «Наверное, изменился ты сам».~
@8230  = ~«Я оплакиваю Янниса. Он глубоко опечален потерей своей первой и единственной дочери, Дейонарры».~
@8231  = ~«Мы оплакиваем тебя, скорбящего о потере».~
@8232  = ~«Мы скорбим вместе с женой Ангияра, оплакивающей свою утрату».~
@8233  = ~«Мы оплакиваем Адана, скорбящего о потере».~
@8234  = ~Пыльная кивает, затем склоняет голову и продолжает петь.~
@8235  = ~Плакальщица внезапно останавливается и изучает тебя: «Тот, за кого ты просишь, тоскует об умершем?»~
@8236  = ~«Мы оплачем твою боль, если ты этого хочешь».~
@8237  = ~«Обстоятельства её смерти мне неизвестны».~
@8238  = ~«Мы оплачем его боль, если он не против».~
@8239  = ~В отличие от того песнопения, которое ты слышал при первом визите в мемориал, мелодию этой песни трудно вычленить. Слушая, ты улавливаешь странные модуляции, как будто звуки впитываются в воздух. Наконец Пыльные примерно на минуту полностью замолкают, затем говорят несколько фраз во славу «Истинной Смерти» и снова начинают петь свою песнь.~
@8240  = ~«Мы оплакиваем того, о ком ты говоришь, кто скорбит о потере».~
@8241  = ~Уйти.~
@8242  = ~«Я хотел немного поговорить с тобой».~
@8243  = ~Слушать пение.~
@8244  = ~Слушать пение.~
@8245  = ~Слушать пение.~
@8246  = ~Слушать пение.~
@8247  = ~Слушать пение.~
@8248  = ~Слушать пение.~
@8249  = ~Слушать пение.~
@8250  = ~Уйти.~
@8251  = ~«Приветствую».~
@8252  = ~Оставить их со своим пением.~
@8253  = ~«Что вы делаете?»~
@8254  = ~«Я оплакиваю мёртвого».~
@8255  = ~«Я прошу за того, кто потерял близкого».~
@8256  = ~«Прости, что потревожил тебя. Прощай».~
@8257  = ~«Я хотел бы поговорить с тобой».~
@8258  = ~Слушать пение.~
@8259  = ~Слушать пение.~
@8260  = ~Слушать пение.~
@8261  = ~Слушать пение.~
@8262  = ~Слушать пение.~
@8263  = ~Слушать пение.~
@8264  = ~Слушать пение.~
@8265  = ~Оставить её в покое.~
@8266  = ~«Нет. Смерть не взволнует моих чувств».~
@8267  = ~Правда: «Да… я полагаю, что в ответе за смерть невинно убиенной женщины, Дейонарры. Не только эта боль гложет меня, но и вина перед её отцом, которому я причинил столько горя».~
@8268  = ~Правда: «Да… я виновен в смерти невинно убиенного мужчины, Хакарии. Его потеря волнует меня».~
@8269  = ~Правда: «Да… я виновен в смерти многих невинных на разных планах. Это причиняет мне боль едва ли не большую, чем я могу вынести».~
@8270  = ~«Это не я. Это женщина, жена Ангияра, которая потеряла сына. Она очень тяжело переживает своё горе».~
@8271  = ~Ложь: «Нет, ну, я про своего друга, э-э… Адан его зовут — это он скорбит по умершему».~
@8272  = ~«Да, эта недавняя смерть повергла меня в страшное горе и отчаяние».~
@8273  = ~«Прошу прощения… я оговорился. Прощай».~
@8274  = ~«Если бы вы могли, это облегчило бы боль её отца и мою».~
@8275  = ~«Нет, не нужно. Прощай».~
@8276  = ~«Если бы вы могли, это облегчило бы мою боль».~
@8277  = ~«Нет, не нужно. Прощай».~
@8278  = ~«Если бы вы могли, это облегчило бы мою боль».~
@8279  = ~«Нет, не нужно. Прощай».~
@8280  = ~«Если бы вы могли, это облегчило бы её боль».~
@8281  = ~«Нет, не нужно. Прощай».~
@8282  = ~«Если бы вы могли, это облегчило бы его боль».~
@8283  = ~«Нет, не нужно. Прощай».~
@8284  = ~Слушать пение.~
@8285  = ~Слушать пение.~
@8286  = ~Слушать пение.~
@8287  = ~Слушать пение.~
@8288  = ~Слушать пение.~
@8289  = ~Слушать пение.~
@8290  = ~Слушать пение.~
@8291  = ~Уйти.~
@8292  = ~Уйти.~
@8293  = ~«Кто умер?»~
@8294  = ~«Я думал, что вы, Пыльные, выше плача и вообще всех чувств».~
@8295  = ~«Кого конкретно вы оплакиваете?»~
@8296  = ~«Кого конкретно вы оплакиваете?»~
@8297  = ~«Кого конкретно вы оплакиваете?»~
@8298  = ~«Кого конкретно вы оплакиваете?»~
@8299  = ~«Кого конкретно вы оплакиваете?»~
@8300  = ~«Кого конкретно вы оплакиваете?»~
@8301  = ~«Это всё, что я хотел узнать. Прощай».~
@8302  = ~«Живых?»~
@8303  = ~«Кого конкретно вы оплакиваете?»~
@8304  = ~«Кого конкретно вы оплакиваете?»~
@8305  = ~«Кого конкретно вы оплакиваете?»~
@8306  = ~«Кого конкретно вы оплакиваете?»~
@8307  = ~«Кого конкретно вы оплакиваете?»~
@8308  = ~«Кого конкретно вы оплакиваете?»~
@8309  = ~«Ясно. У меня ещё вопросы…»~
@8310  = ~«Пожалуй, я услышал достаточно. Прощай».~
@8311  = ~«Зачем?»~
@8312  = ~«Кого конкретно вы оплакиваете?»~
@8313  = ~«Кого конкретно вы оплакиваете?»~
@8314  = ~«Кого конкретно вы оплакиваете?»~
@8315  = ~«Кого конкретно вы оплакиваете?»~
@8316  = ~«Кого конкретно вы оплакиваете?»~
@8317  = ~«Кого конкретно вы оплакиваете?»~
@8318  = ~«Ясно. У меня ещё вопросы…»~
@8319  = ~«Пожалуй, я услышал достаточно. Прощай».~
@8320  = ~«Какой нормальный…»~
@8321  = ~«И вы оплакиваете живых, потому что…»~
@8322  = ~«Истинной Смерти?»~
@8323  = ~«Кого конкретно вы оплакиваете?»~
@8324  = ~«Кого конкретно вы оплакиваете?»~
@8325  = ~«Кого конкретно вы оплакиваете?»~
@8326  = ~«Кого конкретно вы оплакиваете?»~
