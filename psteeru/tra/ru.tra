@4092  = ~Попробовать вынуть болты, которые держат доспехи скелета.~
@4093  = ~«Эй, как насчёт ЭТОГО скелета, Морте? Сгодится в качестве тела?»~
@4094  = ~Оставить скелет в покое.~
@4095  = ~«Ты пожалеешь, что не остался мёртвым, Костяшка…»~
@4096  = ~«Долбаный мешок костей!..»~
@4097  = ~«Прихвачу-ка это с собой…»~
@4098  = ~«Посмотрим, что у нас тут есть…»~
@4099  = ~«Прихвачу-ка это с собой…»~
@4100  = ~«Прихвачу-ка это с собой…»~
