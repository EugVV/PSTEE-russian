@13613 = ~«Я хотел бы разорвать договор, который ты заключил с Ангияром».~
@13614 = ~«Тот договор, который ты заключил с Ангияром, у тебя с собой?»~
@13615 = ~«Могу я ещё раз посмотреть на договор Ангияра?»~
@13616 = ~«Неважно. У меня другие вопросы…»~
@13617 = ~«Я просто полюбопытствовал. Прощай».~
@13618 = ~«Что-то не так?»~
@13619 = ~«Прощай, Мортаи».~
@13620 = ~«Возможно. Я тебя не помню».~
@13621 = ~«Нет, не думаю».~
@13622 = ~«Прощай, Мортаи».~
@13623 = ~«Прощай, Мортаи».~
@13624 = ~Уйти.~
@13625 = ~«У меня к тебе вопросы…»~
@13626 = ~«Неважно. Мне надо идти».~
@13627 = ~«Договор?»~
@13628 = ~«Договор?»~
@13629 = ~«Это ты заключил Посмертный Договор с Ангияром?»~
@13630 = ~«Могу я увидеть тот договор, который ты заключил с Ангияром?»~
@13631 = ~«Нет, но у меня пара вопросов…»~
@13632 = ~«Не думаю, что ты можешь мне помочь. Я должен идти».~
@13633 = ~«У меня к тебе вопросы…»~
@13634 = ~«Неважно. Мне надо идти».~
@13635 = ~«Да, хочу».~
@13636 = ~«Да, хочу».~
@13637 = ~«Разве выказывать эмоции плохо?»~
@13638 = ~«Прошу прощения, но я не хочу подписывать договор. Однако у меня другие вопросы…»~
@13639 = ~«Я не хочу никого оскорбить… но не думаю, что ты можешь мне помочь. Прощай».~
@13640 = ~Ждать его возвращения…~
@13641 = ~Прикинувшись, что изучаешь договор, подменить его фальшивым, затем отдать Мортаи.~
@13642 = ~Прикинувшись, что изучаешь договор, подменить его фальшивым, затем отдать Мортаи.~
@13643 = ~Прикинувшись, что изучаешь договор, подменить его фальшивым, затем отдать Мортаи.~
@13644 = ~«Хорошо… кажется, всё как положено».~
@13645 = ~~
@13646 = ~«Я хотел бы разорвать этот договор».~
@13647 = ~«Могу я ещё раз посмотреть на договор Ангияра?»~
@13648 = ~«Да, но у меня другие вопросы…»~
@13649 = ~«Да, это всё, что я хотел узнать. Прощай».~
@13650 = ~Отдать ему обратно.~
@13651 = ~~
@13652 = ~Отдать ему «договор Ангияра» обратно.~
@13653 = ~«Вообще-то, забудь. У меня другие вопросы…»~
@13654 = ~«Вообще-то, забудь. У меня другие вопросы…»~
@13655 = ~«Прощай».~
@13656 = ~Оставить его в покое.~
@13657 = ~Он бросает на тебя быстрый взгляд и уже было отворачивается — но, передумав, поворачивается к тебе. Его глаза осматривают тебя с головы до ног, при этом он медленно качает головой: «Ну ты и тип, здоровяк. Никогда не видел, чтобы у человека было столько шрамов. Где ты их заработал? Дрался в одиночку со всеми ордами Баатора?»~
@13658 = ~«У меня к тебе кое-какие вопросы».~
@13659 = ~«Не твоё дело, старик».~
@13660 = ~«В нескольких битвах я поучаствовал и получил там эти шрамы».~
@13661 = ~«Что здесь происходит?»~
@13662 = ~«Неважно».~
@13663 = ~Он хмурится на тебя: «Ты где-нибудь видишь у меня вытатуированное слово „мудрец“?» Он как будто по-настоящему ждёт ответа.~
@13664 = ~«Я… ну, нет. Я просто подумал, что человек твоих лет должен бы обладать большой мудростью и делиться ею с менее одарёнными…»~
@13665 = ~«Слушай, я просто хочу задать пару вопросов. Можешь на них ответить?»~
@13666 = ~«О, неважно. Прощай».~
@13667 = ~Его хмурая гримаса превращается в улыбку, он начинает хихикать. «Ты приколист, здоровяк. „Большая мудрость“ у меня в жопе, — он на миг замолкает. — Хорошо, ты можешь задать несколько вопросов. Чем я могу тебе помочь?»~
@13668 = ~«Сначала спрошу: что здесь происходит?»~
@13669 = ~Он указывает себе за плечо: «Видишь палача? Один бедняга сегодня станет короче на голову. Не каждый день такое увидишь».~
@13670 = ~«А что он наделал?»~
@13671 = ~«Ох. Я хочу спросить о другом».~
@13672 = ~«Ясно. Ну, спасибо за помощь. Прощай».~
@13673 = ~«Не знаю точно. Может, убил кого, может, его кто подкосил и отправил на плаху. Ты просто не знаешь, что это за город».~
@13674 = ~«Подкосил?»~
@13675 = ~«У меня ещё вопрос».~
@13676 = ~«О… спасибо. Всего хорошего».~
@13677 = ~Он улыбается, посмеиваясь: «Ты здесь недавно, ведь так? „Подкосил“. Предал, подставил и так далее. Такое в Керсте бывает».~
@13678 = ~«Ясно. Расскажи мне о другом…»~
@13679 = ~«Хм-м. Мне пора идти. Прощай».~
@13680 = ~Он ухмыляется и делает неприличный жест: «Отвали, пень!» Он поворачивается спиной.~
@13681 = ~Оставить его в покое.~
@13682 = ~Он кивает в знак согласия: «Пожалуй, так и было. Так чем я могу тебе помочь?»~
@13683 = ~«У меня кое-какие вопросы».~
@13684 = ~«Расскажи, что тут происходит».~
@13685 = ~«На самом деле ничем. Прощай».~
@13686 = ~«Конечно», — он ждёт вопроса.~
@13687 = ~«Я ищу дэва. Говорят, он где-то в Керсте».~
@13688 = ~«Что можешь рассказать мне о Керсте?»~
@13689 = ~«Кто тут всем заправляет?»~
@13690 = ~«Что новенького?»~
@13691 = ~«Неважно. Прощай».~
@13692 = ~«Ходит байка, что дэв в городе… но не знаю, где он может быть. Дэв в городе уж точно привлёк бы большое внимание, — он задумывается. — Не отвечу. Спроси кого-нибудь ещё. Наверно, кто-то его да видел».~
@13693 = ~«Ещё вопрос».~
@13694 = ~«Ты очень помог. Мне пора идти».~
@13695 = ~Он задумывается, затем оглядывается по сторонам: «Керст — отвратная куча дерьма, простая и грубая. Ты ещё увидишь изнанку,здоровяк… вот и всё, что я хочу сказать».~
@13696 = ~«Хорошо. Тогда я задам ещё один вопрос».~
@13697 = ~«Спасибо тебе за помощь. Прощай».~
@13698 = ~«Это, должно быть, Товус Гильяф. Его можно найти в городской управе. Мой тебе совет: не суй свой нос в его дела. Это может кратчайшим путём привести тебя на плаху», — он указывает на гильотину за своей спиной.~
@13699 = ~«Я это запомню. Ещё вопрос…»~
@13700 = ~«Ясно. Мне пора идти. Прощай».~
@13701 = ~На миг он погружается в мысли: «Ну… ходит байка, что дочь Пятнистого Барса пропала. Он по этому поводу несколько распсиховался. Совсем не тот, что раньше».~
@13702 = ~«Кто такой Пятнистый Барс?»~
@13703 = ~«Я хочу задать ещё вопрос».~
@13704 = ~«Спасибо тебе за помощь. Прощай».~
@13705 = ~«Он хозяин кабака „Врата предателей“. Это местная забегаловка. По-моему, по этой улице вниз», — он указывает рукой направление.~
@13706 = ~«Расскажи мне о другом».~
@13707 = ~«Мне нужно идти. Прощай».~
@13708 = ~Не обращать на него внимания.~
@13709 = ~Сначала тебе кажется, что он не услышал, но затем он поворачивает голову, удостаивает тебя беглым взглядом и отворачивается мгновение спустя: «Я тебя не знаю, пень, и знать не хочу. Проваливай, или мне придётся взгреть тебя».~
@13710 = ~«Слушай, у меня всего лишь пара вопросов».~
@13711 = ~«Не тому угрожаешь, придурок. Просто ответь на мои вопросы, или придётся поучить тебя хорошим манерам».~
@13712 = ~Напасть на него.~
@13713 = ~«Хорошо. Тогда я ухожу».~
@13714 = ~Он поворачивает к тебе багровое от ярости лицо и произносит сквозь зубы: «Вопросы? Я что, похож на местного учёного, пень? Пшёл вон с глаз моих, или я тебе добавлю парочку шрамов».~
@13715 = ~«Не тому угрожаешь, придурок. Просто ответь на мои вопросы, или придётся поучить тебя хорошим манерам».~
@13716 = ~«Ну так покажи себя».~
@13717 = ~«Хорошо, уже ухожу».~
@13718 = ~Он разворачивается, лицо его налито яростью. Уже открыв рот для очередной угрозы, он вдруг захлопывает его и оглядывает тебя внимательней. По мере того как он охватывает взглядом все твои шрамы, его гнев всё более и более сменяется страхом: «Гм… извини, здоровяк. Так что ты хочешь знать?»~
@13719 = ~«Я ищу дэва. Говорят, он где-то здесь».~
@13720 = ~«Что новенького?»~
@13721 = ~«Расскажи мне о Керсте».~
@13722 = ~«Неважно».~
@13723 = ~Он хмурится в раздумье, затем на миг отводит взгляд: «Не те ворота, здоровяк. Дэвы этим путём не ходят, по крайней мере я о таком не слышал».~
@13724 = ~«Хорошо. Тогда у меня ещё вопросы».~
@13725 = ~«Спасибо. Ещё увидимся».~
@13726 = ~«Тут не подскажу. Я стараюсь ни в чьи дела нос не совать и ничего не знаю. Так и дольше проживёшь, и лучше, — он замолкает и выглядит чуть нервным. — Не хочу обидеть… но лучше бы и тебе поступать так же».~
@13727 = ~«Буду иметь в виду. Но у меня ещё вопросы».~
@13728 = ~«Смешно… когда мне понадобится совет, я тебя извещу. Ещё одна такая шуточка с рук тебе не сойдёт».~
@13729 = ~«Спасибо за совет. Увидимся».~
@13730 = ~Он фыркает и оглядывается по сторонам: «Этот город неспроста называется Керстом, Проклятым городом. Тут тюрьма для всех бедолаг, запутавшихся в жизни. И самое прискорбное, что большинство этих пней даже не знают, что они узники».~
@13731 = ~«Тюрьма?»~
@13732 = ~«Ясно. Другой вопрос».~
@13733 = ~«Что ж, спасибо за информацию».~
@13734 = ~«Конечно. Что ты хочешь узнать?»~
@13735 = ~«Я ищу дэва. Говорят, он где-то здесь».~
@13736 = ~«Что новенького?»~
@13737 = ~«Расскажи мне о Керсте».~
@13738 = ~«Неважно».~
@13739 = ~Его лицо снова багровеет, но он пытается сдержаться: «Прости, больше не повторится. Тебе, гм, нужно что-нибудь ещё?»~
@13740 = ~«Да, у меня вопросы».~
@13741 = ~«Нет, это всё».~
@13742 = ~Он оглядывается по сторонам и чуть придвигается к тебе. «Да, на первый взгляд и не скажешь, но Керст — совершенно точно тюрьма. Просто попробуй выйти и увидишь, что будет. Если у тебя нет по-настоящему хорошей причины и способа осуществить задуманное, ты не пройдёшь через городские ворота, — он замолкает и снова оглядывается. — Больше я ничего не могу сказать».~
@13743 = ~«Хм. Позволь спросить о другом».~
@13744 = ~«Спасибо. Ещё увидимся».~
@13745 = ~Мужчина поворачивается к тебе, заслышав вой, затем изображает кривую ухмылку и запрокидывает голову, воя вместе с тобой. Через несколько секунд он останавливается, затем снова начинает бегать вприпрыжку, рычать и лаять, как одичавшая собака.~
@13746 = ~Лай человека переходит в рычание, и он бросается на тебя!~
@13747 = ~Этот мужик с дикими глазами по-прежнему бегает вприпрыжку, лает и воет, насколько хватает лёгких.~
@13748 = ~«Ну, это отрезанный ломоть, — Морте вращает глазами. — Бессмысленно трепаться с Хаоситектами, шеф. Они просто банда психов».~
@13749 = ~«Они „фракция“, которая не признаёт никаких правил… кроме того, чтобы мысли в голове не задерживались. Их иногда называют „Хаоситами“. Не надо объяснять почему».~
@13750 = ~«Наверно, те как мухи к ним слетаются… ну, те, кто достаточно хаотичен и у кого крыша давно поехала. Не думаю, что у них есть специальные вербовщики… хотя о них ничего нельзя сказать с уверенностью».~
@13751 = ~Когда ты уже готов заговорить, Анна вцепляется в тебя и шипит: «Ты *рехнулся*?! Ни слова с ним! Он из Голодных Псов». Она понижает голос: «Хаоситы, спятившие, опасные! Их тут как собак нерезаных, ага, того и гляди выскочат».~
@13752 = ~«Они банда из Улья и Хаоситы к тому же! — она качает головой, затем толкает тебя в спину хвостом. — Держись от них подальше и не подставляй спину. Я с ними сталкивалась, кусают они страшнее, чем лают».~
@13753 = ~«Они фракция, вроде Пыльников, Старейшин или Чующих… вот только нет у них никаких правил или убеждений… — для выразительности Анна описывает хвостом спираль. — Они просто свихнувшиеся, психованные, безбашенные, ясно?» На минуту она задумывается. «Некоторые называют их Хаоситектами, но это неважно».~
@13754 = ~Анна пожимает плечами: «Без понятия. Те просто появляются. Как мухи на дерьмо, мне кажется».~
@13755 = ~«Приветствую».~
@13756 = ~«Приветствую».~
@13757 = ~Издать длинный, безнадёжный вой.~
@13758 = ~Издать длинный, безнадёжный вой.~
@13759 = ~Оставить мужчину в покое.~
@13760 = ~Оставить мужчину в покое.~
@13761 = ~«Я *сказал*, „приветствую“».~
@13762 = ~Зарычать в ответ, обнажив зубы.~
@13763 = ~«Хм… тогда прощай».~
@13764 = ~«Хм… тогда прощай».~
@13765 = ~«Я *сказал*, „приветствую“».~
@13766 = ~Зарычать в ответ, обнажив зубы.~
@13767 = ~«Хм… замечательно поговорили».~
@13768 = ~«Хм… замечательно поговорили».~
@13769 = ~«Если ты хочешь умереть именно так, человек-волк…»~
@13770 = ~«Приветствую».~
@13771 = ~Издать длинный, безнадёжный вой.~
@13772 = ~Оставить мужчину в покое.~
@13773 = ~Оставить мужчину в покое.~
@13774 = ~«Хаоситекты?»~
@13775 = ~«Так кто такие эти Хаоситекты?»~
@13776 = ~«Думал, от него можно кое-что узнать. Ладно, пошли».~
@13777 = ~«Как они набирают членов?»~
@13778 = ~«Ясно. Пошли».~
@13779 = ~«Ясно. Спасибо за информацию».~
@13780 = ~«Голодные Псы? О чём ты говоришь?»~
@13781 = ~«Голодные Псы? Так кто они?»~
@13782 = ~«Я всё равно хочу с ним поговорить».~
@13783 = ~«Может, ты и права. Пошли».~
@13784 = ~«Хаоситы?»~
@13785 = ~«Так кто такие Хаоситы?»~
@13786 = ~«Я всё равно хочу с ним поговорить».~
@13787 = ~«Думал, у него можно кое-что узнать. Ладно, пошли».~
@13788 = ~«Как они принимают новых членов?»~
@13789 = ~«Я всё равно хочу с ним поговорить».~
@13790 = ~«Ясно. Пошли».~
@13791 = ~«Пожалуй, я всё равно с ним поговорю».~
@13792 = ~«Ясно. Спасибо за информацию».~
@13793 = ~Мужчина прерывается на середине рыка и тянется к пелене волос, закрывающих глаза. Когда его высохшая рука откидывает грязные пряди назад, несколько странных красновато-коричневых жучков сваливаются с волос и разбегаются по мостовой. Лицо его под волосами мертвенно-бледное, в глубоких морщинах. Густые кустистые брови поднимаются крыльями, когда он глазеет на тебя. «Руку, мою бери и вместе на луну-у-у?»~
@13794 = ~Человек с энтузиазмом кивает головой, затем по-детски хлопает в ладоши: «Ответы растекаются полусиним маслом! ЗНАЙ! Твой откуда вопль рос!» Затем он разражается длинным заливистым воем, срываясь временами на короткий лай.~
@13795 = ~Мужчина откидывает голову назад и *воет*. Звук настолько ужасен, что ты вынужден заткнуть уши. Даже этого мало: когда ты затыкаешь уши, вой, кажется, разрастается пронзительным сверлящим визгом, проникает в уши, ввёртывается в череп, пожирая остатки рассудка. Звук такой невыносимый, что ты даже не можешь собраться с силами и что-нибудь сказать.~
@13796 = ~Мужчина хмурится, но его брови складываются домиком, придавая лицу причудливое выражение. Трудно представить, как вообще можно добиться такой экспрессии на лице, и тебе становится не по себе, когда ты видишь, как его лицевые мускулы образуют новую гримасу. Сложно сказать, выражение ли это ярости, удивления, того и другого вместе или же вообще чего-то иного. «Пой поцелуя рас-с-сказ мужчины, ответы пред женщины с-с-сердца деревом».~
@13797 = ~Кажется, человек загипнотизирован твоим голосом. С каждым произносимым тобой словом в его глазах зажигается огонёк. «Лающий-Дикарь я, Я! Хочу, Вопроса, Можешь-ты, ты-можешь?»~
@13798 = ~Он радостно хлопает в ладоши, как ребёнок на празднике, затем выкрикивает с подвыванием: «Вопль-РОСЫ! Вопль-РОСЫ!»~
@13799 = ~Дикарь хмурится, закрывает глаза, потом открывает их снова. Когда он снова начинает говорить, его голос звучит уравновешенно и без причуд… как будто с тобой говорит другая, здравомыслящая личность. Эффект пугающий. «Ты потерял больше одного, и должен найти больше одного. У каждой твоей части был свой, поэтому ты должен искать их все», — он моргает и трясёт головой, как бы удивляясь собственным речам, затем неловко смеётся.~
@13800 = ~Кажется, мужчина готов возразить, но вдруг его левый кулак поднимается и бьёт его в висок. Он воет в ответ, затем вдруг останавливается, моргая. «Один в шкафу твоей гостевой комнаты в зале Чующих, другой на стенах гробницы, запечатанной глубоко под городом, где плачут камни. Остальные…» — закончить Лающий-Дикарь не успевает, поднимается правый кулак и бьёт его по морде, вызывая новое завывание. Секунду он моргает и трясёт головой, как будто удивляясь сам себе, потом неловко улыбается.~
@13801 = ~Лающий-Дикарь разводит руками… похоже, он не помнит, что сейчас сказал.~
@13802 = ~Лающий-Дикарь на какой-то миг выглядит испуганным, затем показывает вверх с выражением надежды: «Э-э… там?» Он сглатывает. Кажется, он не знает, и ты почему-то ему веришь.~
@13803 = ~Лающий-Дикарь пожимает плечами, настороженно глядя на тебя. «Может, в других местах?» — он судорожно сглатывает.~
@13804 = ~Лающий-Дикарь пожимает плечами, затем отвечает нараспев: «Довольно странно? Не довольно, не странно, не потерян, не помог…» Он рычит про себя, словно прочищая горло. «Может, ты сперва потерял его, потом спросил меня, тогда не будет ли странно довольно это?»~
@13805 = ~«Хай-ос!» — он запинается в середине слова, как будто оно никак не сходит с языка. «Некоторые говорят Хаоситекты, я говорю Ы-тект-И-соах. ХАОС-иты. Люди нет. Идюл нет, люди да, три носочка навсегда, — он приседает на корточки и начинает раскачиваться взад-вперёд, напевая детским дискантом. — Хао-сит, хао-сит, дома прыгает на ножке, это фракция такая, нас пока немножко».~
@13806 = ~В ответ он принимается изо всех сил лаять. Ты видишь, как из его рта во все стороны обильно летит слюна, и делаешь шаг назад, чтобы не забрызгало. Через некоторое время он останавливается и издаёт длинный, безнадёжный вой.~
@13807 = ~Он подозрительно на тебя смотрит, пожимает плечами, затем склоняется и начинает тебя обнюхивать. «Шмыг… дрыг, хлоп… топ, придур… — он фыркает и рычит себе под нос. — Пидор!»~
@13808 = ~Это первое из сказанного тобой Лающему-Дикарю, что его, по-видимому, сбивает с толку. Он на миг задумывается, рычит, затем тыкает тебя пальцем: «Хаоса человек ты уже! Всему ко готов ты-ы-ы-ы!»~
@13809 = ~Как будто в черепушке Дикаря кто-то зажёг факел, его глаза широко распахиваются, и он расплывается в улыбке. Улыбка превращается в ухмылку, затем в презрительную гримасу. Он начинает скакать и приплясывать перед тобой. «Умный! Шумный! Полоумный! — он похлопывает тебя по плечу обеими руками, затем воет на небо. — Снова Хаоситект ты! Дважды! Трижды! Жды!»~
@13810 = ~Дикарь приостанавливает свой танец ровно настолько, чтобы устремить на тебя пристальный взгляд. «Фактолом станешь скоро с такими мозгами ты, цену твой разум заплатит за мысли такие! — он хихикает и выбрасывает руки вверх. — Грядёт безумный король, и планы встанут тормашками вверх!»~
@13811 = ~Дикарь широко разевает рот от удивления. «Фактолом становишься ты, цену твой разум платит за мысли такие! — он наставляет на тебя палец, как скипетр. — Преклонись, фактол! Король Хаоситов! Я провозглашаю тебя мужем плоти и женой хаоса! Можешь поцеловать уздечку!»~
@13812 = ~Заслышав тебя, Дикарь распахивает глаза и широко разевает рот. Он вскакивает на ноги и наставляет на тебя палец, как скипетр: «Преклонись, фактол! Король ВСЕХ Хаоситов! Я провозглашаю тебя мужем плоти и женой хаоса! Можешь поцеловать уздечку!»~
@13813 = ~Дикарь разводит руками. «Король Хаоса, ты, фактол — имя только лишь, которое навешиваешь ты как грязную рубаху на себя».~
@13814 = ~Дикарь пожимает плечами, затем зло ухмыляется. «Как в жизни, нет выбора. Полнейшая неудача и ушат проклятий на тебя! — он прищуривается. — Сменить ты хочешь титул, измени свой разум. Одно легче другого, если не болван ты!»~
@13815 = ~Дикарь отвешивает низкой поклон и складывает пальцы рук треугольником. «Хитро, хитро! Теперь не фактол ты! Справедливость, правила с законами и прочая дребедень не могут в голове фактола быть… — на мгновение он задумывается. — Оковы спали!» Он снова хмурится, затем пожимает плечами: «И оковы наложены! Но не фактол теперь».~
@13816 = ~На пару с Дикарём, вы несколько минут безумно скачете, воя на небо. Редкие прохожие кидают на вас странные взгляды, а кое-кто издалека кричит вам успокоиться. Наконец Дикарь падает и прекращает танец, едва встав на ноги.~
@13817 = ~Когда ты произносишь эти слова, словно искра разумного света проскальзывает в глазах мужчины. На миг он обращает взор в небо, затем поднимает левую ногу и смотрит на землю под ней. Видимо, ничего там не найдя, он разводит руки и скашивает на них глаза, каждый на свою, отчего глаза смотрят в разные стороны. Затем он трясёт головой (попутно вернув глаза в нормальное положение) и косится на твоё лицо.~
@13818 = ~Дикарь пожимает плечами. Он не похож на сильно озабоченного. «Не-ладно, ладно-не, эге?»~
@13819 = ~Некоторое время он бормочет себе под нос, затем выкрикивает: «Важно вне!» Не успеваешь ты отреагировать, как его руки со свистом рассекают воздух и шлепают тебя по лицу. «Встрече рад! Трижды хэй-ос с тобой!» — он хихикает, наблюдая, как у тебя спадает покраснение от пощёчины. У тебя странное чувство, что это было просто посвящение… и что Дикарь получил от него огромное удовольствие.~
@13820 = ~«Назад идти нет… — бормочет Дикарь, всё ещё кося глазами. — Старые-не фракции забудь…»~
@13821 = ~Мужчина рычит, затем улыбается, приставив к голове рожки из двух пальцев: «Ничего!» Он самодовольно ухмыляется, убирает рожки и разводит руки как крылья: «Всё!» Он издаёт сдавленное всхлипывание и вытирает глаза. «Кто ищет, тот всегда найдёт, кто найдёт — тот ищет… — он хлопает в ладоши. — Какое кому дело? Ищи не вы-годы, ву-спеха, и они искать будут тебя…»~
@13822 = ~Дикарь внезапно выглядит заинтересованным: «Что у тебя меня для, хм-м-м-м?!»~
@13823 = ~Он смотрит на твоё барахло без всякого интереса: «Ничего! Всякая всячина щёголей для! Хлам!»~
@13824 = ~Он фыркает и скрещивает руки на груди. Как будто прячется за своими лохмами. «Ничего нет!»~
@13825 = ~Он визжит… «Всё! Всё есть у меня! И всё — это ничего, так что лучше всё ЗАВЯЖИ! — он по-детски ревёт, вцепившись в голяшку. — Бедная нога, бедная нога, не хотел сделать тебе больно…»~
@13826 = ~Глаза Дикаря немедленно вцепляются в один из твоих крысиных хвостов. Он выхватывает хвост у тебя рук и вертит в пальцах, как червяка. Со скоростью молнии он завязывает его в какой-то странный узел и бросает тебе. «За-чарован, ах-х-хм уве-е-ерен…» — он произносит эти слова и хихикает.~
@13827 = ~Ты видишь Лающего-Дикаря. Он всё ещё сутулится, прячется за своими длинными, грязными космами… и всецело поглощён рычанием себе под нос.~
@13828 = ~«Ну, это отрезанный ломоть, — Морте вращает глазами. — Бессмысленно трепаться с Хаоситектами, шеф. Они просто банда психов».~
@13829 = ~«Они „фракция“, которая не признаёт никаких правил… кроме того, чтобы мысли в голове не задерживались. Их иногда называют „Хаоситами“. Не надо объяснять почему».~
@13830 = ~«Наверно, те как мухи к ним слетаются… ну, те, кто достаточно хаотичен и у кого крыша давно поехала. Не думаю, что у них есть специальные вербовщики… хотя о них ничего нельзя сказать с уверенностью».~
@13831 = ~Когда ты уже готов заговорить, Анна вцепляется в тебя и шипит: «Ты *рехнулся*?! Ни слова с ним! Он из Голодных Псов». Она понижает голос: «Хаоситы, спятившие, опасные! Их тут как собак нерезаных, ага, того и гляди выскочат».~
@13832 = ~«Они банда из Улья и Хаоситы к тому же! — она качает головой, затем толкает тебя в спину хвостом. — Держись от них подальше и не подставляй спину. Я с ними сталкивалась, кусают они страшнее, чем лают».~
@13833 = ~«Они фракция, вроде Пыльников, Старейшин или Чующих… вот только нет у них никаких правил или убеждений… — для выразительности Анна описывает хвостом спираль. — Они просто свихнувшиеся, психованные, безбашенные, ясно?» На минуту она задумывается. «Некоторые называют их Хаоситектами, но это неважно».~
@13834 = ~Анна пожимает плечами. «Без понятия. Те просто появляются. Как мухи на дерьмо, мне кажется».~
@13835 = ~«Приветствую».~
@13836 = ~«Приветствую».~
@13837 = ~«Приветствую».~
@13838 = ~Прорычать в ответ.~
@13839 = ~Прорычать в ответ.~
@13840 = ~Прорычать в ответ.~
@13841 = ~Оставить мужчину в покое.~
@13842 = ~Оставить мужчину в покое.~
@13843 = ~«Э-э, не сегодня. У меня были вопросы…»~
@13844 = ~«„Брать твою руку и вместе на луну“? В другой раз, друг мой».~
@13845 = ~«„Брать твою руку и вместе на луну“? В другой раз, друг мой».~
@13846 = ~«Луну — луны — ынул — унул?»~
@13847 = ~Прорычать в ответ, затем залаять.~
@13848 = ~Наклонить голову в сторону, как бы изучая его.~
@13849 = ~«Хм… тогда прощай».~
@13850 = ~«Хм… тогда прощай».~
@13851 = ~«Слушай, успокойся. У меня к тебе кое-какие вопросы…»~
@13852 = ~«Хм… тогда прощай».~
@13853 = ~«Хм… тогда прощай».~
@13854 = ~Развернуться и уйти.~
@13855 = ~Развернуться и уйти.~
@13856 = ~«Э-э, не сегодня. У меня были вопросы…»~
@13857 = ~«Хм-м?»~
@13858 = ~Сымпровизировать песенку: «Простой мужик, пустой мужик, сквозь чащу он бежит… древесным женским сердцем грезит и смехом на снегу блестит».~
@13859 = ~«„Один лишь поцелуй расскажет нам о сердце женском. Но предпочтёшь ли ты ответ мужской“? Хорошо. Но знай тогда, что мой ответ — это вопрос, а ответ от *тебя* — вот то, что предпочту я».~
@13860 = ~«„Один лишь поцелуй расскажет нам о сердце женском. Но предпочтёшь ли ты ответ мужской“? Хорошо. Но знай тогда, что мой ответ — это вопрос, а ответ от *тебя* — вот то, что предпочту я».~
@13861 = ~«Хм… тогда прощай».~
@13862 = ~«Хм… тогда прощай».~
@13863 = ~«Ты можешь, а я хочу: кто ты такой… или что… ты такое?»~
@13864 = ~«Ты можешь, а я хочу: ты из Хаоситов?»~
@13865 = ~«У меня такой вопрос: ты один из Голодных Лающих Псов?»~
@13866 = ~«Я могу вступить в ряды Хаоситов?»~
@13867 = ~«Вступить я в Хаоситов могу ряды?»~
@13868 = ~«Вступить я в Хаоситов могу ряды?»~
@13869 = ~«Я ищу мужчину по имени Фарод. Не знаешь такого?»~
@13870 = ~«Я ищу потерянный дневник. Не знаешь, где я могу его найти?»~
@13871 = ~«Так что ты говорил про мой дневник?»~
@13872 = ~«Что я получу от присоединения к Хаоситам? Какие-то силы? Или особые способности?»~
@13873 = ~«Могу я посмотреть, какие предметы Хаоситы продают своим членам?»~
@13874 = ~«Хм… сегодня вопросов не будет. Прощай».~
@13875 = ~«Хм… сегодня вопросов не будет. Прощай».~
@13876 = ~«Не увиливай от вопроса: кто ты такой… или что… ты такое?»~
@13877 = ~«Не увиливай от вопроса: ты из Хаоситов?»~
@13878 = ~«У меня такой вопрос: ты один из Голодных Лающих Псов?»~
@13879 = ~«Я могу вступить в ряды Хаоситов?»~
@13880 = ~«Вступить я в Хаоситов могу ряды?»~
@13881 = ~«Вступить я в Хаоситов могу ряды?»~
@13882 = ~«Я ищу мужчину по имени Фарод. Не знаешь такого?»~
@13883 = ~«Я ищу потерянный дневник. Не знаешь, где я могу его найти?»~
@13884 = ~«Так что ты говорил про мой дневник?»~
@13885 = ~«А что я получу от присоединения к Хаоситам? Какие-то силы? Или особые способности?»~
@13886 = ~«Могу я посмотреть, какие предметы Хаоситы продают своим членам?»~
@13887 = ~«Хм… сегодня вопросов не будет. Прощай».~
@13888 = ~«Хм… сегодня вопросов не будет. Прощай».~
@13889 = ~«Можешь мне сказать, где хоть один из них?»~
@13890 = ~«Зал Чующих? Это где такое?»~
@13891 = ~«Гробница под городом? Где?»~
@13892 = ~«А где эти остальные дневники?»~
@13893 = ~«У меня другие вопросы…»~
@13894 = ~«Хм… тогда прощай».~
@13895 = ~«Хм… тогда прощай».~
@13896 = ~«Ты сказал, что один в гробнице под городом? Где это?»~
@13897 = ~«А где остальные дневники, которые ты упоминал?»~
@13898 = ~«У меня другие вопросы…»~
@13899 = ~«Тогда забудь. Я сам всё найду».~
@13900 = ~«Тогда забудь. Я сам всё найду».~
@13901 = ~«Ты сказал, что один в зале Чующих? Где это?»~
@13902 = ~«А где остальные дневники, которые ты упоминал?»~
@13903 = ~«У меня другие вопросы…»~
@13904 = ~«Тогда забудь. Я сам всё найду».~
@13905 = ~«Тогда забудь. Я сам всё найду».~
@13906 = ~«Ты сказал, что один в зале Чующих? Где это?»~
@13907 = ~«Ты сказал, что один в гробнице под городом? Где это?»~
@13908 = ~«У меня другие вопросы…»~
@13909 = ~«Тогда забудь. Я сам всё найду».~
@13910 = ~«Тогда забудь. Я сам всё найду».~
@13911 = ~«Чтобы его потерять, я сперва должен его найти. У меня ещё кое-какие вопросы…»~
@13912 = ~«Тогда забудь. Я сам его найду».~
@13913 = ~«Тогда забудь. Я сам его найду».~
@13914 = ~«Так ты из Хаоситов. Хорошо. У меня другие вопросы…»~
@13915 = ~«Хм… тогда прощай».~
@13916 = ~«Хм… тогда прощай».~
@13917 = ~«Пожалуй, можно расценить как да. Хорошо. У меня ещё кое-какие вопросы…»~
@13918 = ~«Хм… тогда прощай».~
@13919 = ~«Хм… тогда прощай».~
@13920 = ~«Пожалуй, можно расценить как нет. Хорошо. У меня ещё кое-какие вопросы…»~
@13921 = ~«Хм-м-м. Вступить я в Хаоситов могу ряды?»~
@13922 = ~«Хм… тогда прощай».~
@13923 = ~«Хм… тогда прощай».~
@13924 = ~Улыбнуться, прищурив глаза, и сказать: «Точ-но».~
@13925 = ~«Ох, я и забыл. Прости. Я хотел спросить о другом…»~
@13926 = ~«Попытаться стоило. Тогда прощай».~
@13927 = ~«Попытаться стоило. Тогда прощай».~
@13928 = ~«Жды я, Хаоситект я!»~
@13929 = ~«Жды я, Хаоситект я!»~
@13930 = ~«Может быть, быть может. Но для тебя другие вопросы есть у меня…»~
@13931 = ~«Э-э… фактол?»~
@13932 = ~«Фактол я! Уздечку всем!»~
@13933 = ~«Э-э… фактол?»~
@13934 = ~«Фактол я! Уздечку всем!»~
@13935 = ~«Не хочу быть фактолом».~
@13936 = ~«Фактол я! Рубахам грязным навсегда нет!»~
@13937 = ~«Ну, не думаю, что справедливо назначать меня фактолом, не узнав даже моего мнения. Наверняка тут должны быть какие-то правила».~
@13938 = ~«Фактол я! Болваны все вокруг!»~
@13939 = ~«Теперь, когда с низложением закончили, у меня к тебе кое-какие вопросы…»~
@13940 = ~«Просто хотел прояснить ситуацию. Прощай».~
@13941 = ~«У меня вопросы есть!»~
@13942 = ~«Вопросов у меня нет! Всего хорошего! Хорошего всего!»~
@13943 = ~«Я уже принадлежу к Боготам, но…»~
@13944 = ~«Я уже принадлежу к Пыльным, но…»~
@13945 = ~«Я уже принадлежу к Анархистам, но…»~
@13946 = ~«Я уже принадлежу к Чующим, но…»~
@13947 = ~«Я уже принадлежу к Боготам. Я передумал… не хочу их предавать».~
@13948 = ~«Я уже принадлежу к Пыльным. Я передумал… не хочу их предавать».~
@13949 = ~«Я уже принадлежу к Анархистам. Я передумал… не хочу их предавать».~
@13950 = ~«Я уже принадлежу к Чующим. Я передумал… не хочу их предавать».~
@13951 = ~«Так… дальше что?»~
@13952 = ~«Ты знаешь, не бери в голову. Я хотел спросить…»~
@13953 = ~«Вообще-то, забудь. Не хочу я быть Хаоситом. Прощай».~
@13954 = ~«У меня ещё кое-какие вопросы…»~
@13955 = ~«Хм… тогда прощай».~
@13956 = ~«Готов ряды в Хаоситектов вступить я. Верности нет фракции прежней Боготов».~
@13957 = ~«Готов ряды в Хаоситектов вступить я. Верности нет фракции прежней Пыльных».~
@13958 = ~«Готов ряды в Хаоситектов вступить я. Верности нет фракции прежней Анархистов».~
@13959 = ~«Готов ряды в Хаоситектов вступить я. Верности нет фракции прежней Чующих».~
@13960 = ~Солгать, чтобы внедриться к Хаоситам ради Анархистов: «Готов ряды в Хаоситектов вступить я. Верности нет фракции прежней».~
@13961 = ~«Забудь. У меня другие вопросы…»~
@13962 = ~«Не думаю, что я и вправду готов к этому. Прощай».~
@13963 = ~Напасть на него за то, что ударил.~
@13964 = ~«Тогда тебя для другие вопросы у меня…»~
@13965 = ~«Хм… тогда прощай».~
@13966 = ~«У меня другие вопросы…»~
@13967 = ~«Хм… тогда прощай».~
@13968 = ~«Нет-нет, я спросил, что у тебя есть для меня».~
@13969 = ~Показать ему, что есть у тебя.~
@13970 = ~Показать ему, что есть у тебя.~
@13971 = ~Показать ему, что есть у тебя.~
@13972 = ~«Неважно. Прощай».~
@13973 = ~«Тогда у меня другие вопросы…»~
@13974 = ~Оставить Дикаря в покое.~
@13975 = ~Пнуть его по голени. Как следует.~
@13976 = ~«Тогда у меня другие вопросы…»~
@13977 = ~Оставить Дикаря в покое.~
@13978 = ~«Тогда у меня другие вопросы…»~
@13979 = ~Оставить Дикаря в покое.~
@13980 = ~«У меня к тебе есть другие вопросы…»~
@13981 = ~«Спасибо, Дикарь. Прощай».~
@13982 = ~«Вопль-РОСЫ, Дикарь! Закрой уши и внимай мне!»~
@13983 = ~«Вопль-РОСЫ, Дикарь! Закрой уши и внимай мне!»~
@13984 = ~«Вопль-РОСЫ, Дикарь! Закрой уши и внимай мне!»~
@13985 = ~«Слушай нет мои ВОПЛЬ-РОСЫ, Дикарь, ВОПЛЬ-РОСЫ есть у меня…»~
@13986 = ~«Хаоситекты?»~
@13987 = ~«Так кто такие эти Хаоситекты?»~
@13988 = ~«Думал, от него можно кое-что узнать. Ладно, пошли».~
@13989 = ~«Как они набирают членов?»~
@13990 = ~«Ясно. Тогда пошли».~
@13991 = ~«Ясно. Спасибо за информацию».~
@13992 = ~«Голодные Псы? О чём ты говоришь?»~
@13993 = ~«Голодные Псы? Так кто они?»~
@13994 = ~«Я всё равно хочу с ним поговорить».~
@13995 = ~«Может, ты и права. Пошли».~
@13996 = ~«Хаоситы?»~
@13997 = ~«Так кто такие Хаоситы?»~
@13998 = ~«Я всё равно хочу с ним поговорить».~
@13999 = ~«Думал, у него можно кое-что узнать. Ладно, пошли».~
@14000 = ~«Как они принимают новых членов?»~
@14001 = ~«Я всё равно хочу с ним поговорить».~
@14002 = ~«Ясно. Пошли».~
@14003 = ~«Пожалуй, я всё равно с ним поговорю».~
@14004 = ~«Ясно. Спасибо за информацию».~
@14005 = ~Оставить Дикаря в покое.~
@14006 = ~«Слушай нет мои ВОПЛЬ-РОСЫ, Дикарь, ВОПЛЬ-РОСЫ есть у меня…»~
@14007 = ~Когда ты подходишь, Ожидающий-Смерть поворачивается к тебе. «Ещё раз здравствуй, — на его лице проступает слабая улыбка. — Спасибо тебе за помощь».~
@14008 = ~Пыльный не поворачивает взора. Он глядит прямо перед собой, как будто высматривает что-то в нескольких лигах от бара.~
@14009 = ~Пыльный не отвечает. Он продолжает смотреть вдаль.~
@14010 = ~Пыльный не отвечает. Он продолжает смотреть вдаль.~
@14011 = ~Когда ты собираешься уходить, Пыльный вдруг что-то произносит, почти шёпотом — тебе с трудом удаётся разобрать слова. *По-твоему*, он что-то говорит о договоре.~
@14012 = ~Пыльный поворачивается к тебе, его лицо как будто высечено из камня, в глазах никакого выражения: «Почему ты подписал тот Посмертный Договор?»~
@14013 = ~На его лице появляется отвращение: «Медяки. Именно этого и следовало ожидать».~
@14014 = ~«Освежить память? — он хмурится. — И ничего не вспомнить, кроме той жизни, которую ты должен покинуть?»~
@14015 = ~Он смотрит на тебя со странным выражением: «Что ты имеешь в виду?»~
@14016 = ~Пыльный хмыкает: «И ты продал своё тело без мысли, без цели… вот и всё. Ты ничего больше не хотел?»~
@14017 = ~«Освобождение? Освобождение от этого существования. Слушай… ты наверняка видел трупы, которые ходят по улицам Сигила? — он вздыхает. — Безмозглые, не чувствующие боли и гнева, груза лет… вот такова Истинная Смерть, которая гуляет по нашим улицам. Вот оно, совершенство».~
@14018 = ~«Я хотел бы — я жажду освободиться. Пустота. Ни боли, ни страдания».~
@14019 = ~«*Так* ли? Ты видишь только внешность, я вижу освобождение от боли и мук».~
@14020 = ~Когда ты собираешься уходить, Пыльный вдруг что-то произносит, почти шёпотом — тебе с трудом удаётся разобрать слова. *По-твоему*, он что-то говорит о желании умереть.~
@14021 = ~Лицо парня остаётся совершенно неподвижным: «Ты хочешь умереть?»~
@14022 = ~Он моргает. «Да… да, так и есть. А ты что, убить меня хочешь? — он каменеет, как бы приняв решение. — Давай, мне всё равно».~
@14023 = ~«Да… — он тебя изучает. — Почему ты хочешь умереть?»~
@14024 = ~«Да… — он тебя изучает. — Почему ты хочешь жить?»~
@14025 = ~Пыльный молча слушает. Когда ты замолкаешь, он не отвечает и только смотрит на тебя. Похоже, он задумался.~
@14026 = ~Пыльный опускает взгляд и умолкает. «Тогда нам нечего обсуждать… ни сейчас, ни когда бы то ни было. Прощай».~
@14027 = ~«Да».~
@14028 = ~«Это существование… это существование — жалкая пародия на жизнь. Я не желаю больше продолжать этот фарс, — его лицо морщится от отвращения. — Почему кто-то должен хотеть остаться в этом гадостном городе в центре мультивселенной, полном боли и ненависти? Смерть… молчалива… и приветлива».~
@14029 = ~«Это *жизнь*? — он скалится и сжимает кулаки. — Это существование… это существование — жалкая *пародия* на жизнь. Я не желаю больше продолжать этот фарс. Смерть… молчалива… и приветлива».~
@14030 = ~Кажется, у парня твоё замечание вызывает раздражение: «А тебе откуда знать?»~
@14031 = ~Парень пристально на тебя смотрит. «Ты говоришь искренне, — его взгляд переполняет удивление. — Что там? Что ты увидел?»~
@14032 = ~«Ты *должен* мне сказать! Я должен знать!»~
@14033 = ~«Ты должен мне сказать! — он сжимает кулаки. — Что бы ты хотел *просить* у меня?!»~
@14034 = ~«Ты смеёшься надо мной, уважаемый. Выставляешь в дурацком свете мои вопросы…»~
@14035 = ~«Скажи, что ты видел! Какова она, Истинная Смерть?! Что ты там видел?» — его голос крепнет, так что к вам поворачивают головы соседние Пыльные.~
@14036 = ~«Нет различия… — он смотрит в пол и со странным выражением кусает губы. — За тенью этого существования ждёт ещё большее страдание. Нет забвения, нет очищения… ничего не меняется. Планы вращаются… и ничего не меняется».~
@14037 = ~Он усмехается: «Нет, я пробовал. Неоднократно».~
@14038 = ~«Это больше чем вера, это реальность, — его взгляд мрачнеет. — Ты видел этот город? Он гниёт, и всё в городе гниёт вместе с ним… нет никакой надежды, не к чему *стремиться*. Всё запятнано тьмой и тенью».~
@14039 = ~«Как я и подозревал», — он вздыхает. «Тогда там должно быть лучше, чем здесь. И поскольку я должен умереть, чтобы достичь этого… — он смотрит на тебя. — Ты не поможешь мне умереть?»~
@14040 = ~Пыльный коротко улыбается, затем его лицо мрачнеет. «Тогда я *должен* умереть, — он с надеждой смотрит на тебя. — Ты не поможешь мне?»~
@14041 = ~Он пристально смотрит на тебя, открывает рот, затем закрывает его. «Тогда уходи. Больше мы говорить не будем».~
@14042 = ~Он кивает: «Философия Пыльных — достойная цель. В противном случае я не стал бы Пыльным».~
@14043 = ~Он рычит. «Ты говоришь, как один из шишек… они никогда не упускают случая прочитать мне *наставления*…»~
@14044 = ~«Но как… — он выглядит озадаченным. — Как мне с этим справиться?»~
@14045 = ~«Возможно… — он обдумывает твои слова. — Возможно, ты прав. Но… иногда тяжело отрешиться от боли этой жизни. Как мне с этим справиться?»~
@14046 = ~Парень впадает в молчание, задумавшись. Наконец он поворачивается к тебе: «Твои слова весомы, уважаемый… и дают новую перспективу. Я поступлю, как ты сказал».~
@14047 = ~«Я искал способ покончить счёты с жизнью. Ты убьёшь меня?»~
@14048 = ~«Хорошо же. Уходи. Больше мы говорить не будем».~
@14049 = ~Он облегчённо вздыхает, затем достаёт из складок одежды мешочек.
В мешочке *звякает*, когда он кладёт его перед тобой. «Сделай это сейчас. Я не могу больше ждать».~
@14050 = ~Он закрывает глаза.~
@14051 = ~Ты осторожно поднимаешь мешочек и быстро удаляешься — там на вес около пятидесяти монет. Пыльный так и остаётся стоять, неподвижно и с закрытыми глазами.~
@14052 = ~Ты обхватываешь его шею руками и медленно сдавливаешь. Парень хватает воздух ртом, а его глаза широко открываются — с умоляющим выражением он царапает твои руки.~
@14053 = ~Ты собираешься душить его и дальше, но внезапно, без всякого обдумывания, убираешь руки с шеи. Ожидающий-Смерть делает вдох и кажется готовым сказать тебе спасибо, что ты не придушил его насмерть, когда ты резко кладёшь руки ему на виски и сворачиваешь шею. Раздаётся *крак*, и парень бездыханно падает к твоим ногам.~
@14054 = ~К твоему удивлению, действие было инстинктивным, как будто раньше ты делал это много раз… эта мысль вызывает всплеск в памяти, но слишком слабый, чтобы уловить что-либо.~
@14055 = ~Когда тело падает на землю, весь бар пронизывает громкий рёв…~
@14056 = ~Ты отпускаешь его… и к своему неудовольствию обнаруживаешь, что делаешь это крайне неохотно. Парень жадно дышит, тяжело кашляя.~
@14057 = ~Парень слабо кивает.~
@14058 = ~Парень молча глядит на тебя, затем медленно кивает, потирая шею.~
@14059 = ~Парень снова кивает и наконец переводит дыхание: «Хорошо… хорошо. Спасибо… тебе, уважаемый. За то, что дал мне… новую перспективу».~
@14060 = ~«Дело не в убеждённости…»~
@14061 = ~Он выкладывает на стол маленький мешочек: «Здесь всё, что у меня есть. Пятьдесят медяков. Убей меня, и они твои».~
@14062 = ~Пыльный усмехается: «Трудно поверить».~
@14063 = ~Пыльный моргает, затем усмехается: «Первая смерть? Так ты был воскрешён?»~
@14064 = ~Пыльный моргает, затем усмехается: «Ты лжёшь. Никто из людей не может умереть больше, чем однажды… если только не был воскрешён могучей магией».~
@14065 = ~«Воскрешён… возвращён к жизни… тут нужна подлинно могучая магия».~
@14066 = ~«Могущественный колдун или жрец… или одна из сил… но никто, кого бы я знал, — он хмурится. — И я не думаю, что ты таких знаешь».~
@14067 = ~Он смотрит на тебя скептически: «Нет, я так не думаю, даже если бы я чувствовал к тому побуждение».~
@14068 = ~«Что… ты имеешь в виду? — похоже, он уже хочет отвернуться, но всё-таки не отворачивается. — Не можешь же ты всерьёз…»~
@14069 = ~Зрение медленно возвращается… в этот раз твоя смерть была другой. Ты видишь стоящего над тобой Ожидающего-Смерть… он напуган и удивлён. Он усаживает тебя на стул и бросает нерешительные взгляды на остальных посетителей… кажется, они ничего не заметили или приняли за пьяную галлюцинацию.~
@14070 = ~«Ты псих, — он оглядывает твои раны. — Ты не можешь умереть, тебя можно только ранить».~
@14071 = ~«Ты… ты один из ходячих мертвецов?»~
@14072 = ~«Тогда кто ты?»~
@14073 = ~«Но… ты по-прежнему думаешь, по-прежнему чувствуешь?»~
@14074 = ~«Быть мёртвым… и *по-прежнему* думать и чувствовать?! Страдать невозможностью покинуть своё тело? — похоже, эти мысли приводят его в ужас. — Даже смерть не несёт освобождения».~
@14075 = ~«Ну и ладно… — шипит тебе Морте. — Пошли отсюда, шеф. Этот Пыльник может оказаться ещё и удобрением».~
@14076 = ~«Приветствую».~
@14077 = ~Оставить его в покое.~
@14078 = ~«Приветствую».~
@14079 = ~Пройти мимо не обращая внимания.~
@14080 = ~«Рад было помочь. Прощай».~
@14081 = ~«Могу я задать вопрос?»~
@14082 = ~«Могу я задать вопрос?»~
@14083 = ~«Могу я задать вопрос?»~
@14084 = ~«Прощай».~
@14085 = ~«Прощай».~
@14086 = ~«Прощай».~
@14087 = ~«Прощай».~
@14088 = ~«Тогда прощай».~
@14089 = ~«Тогда прощай».~
@14090 = ~«Тогда прощай».~
@14091 = ~«Тогда прощай».~
@14092 = ~«Что ты сказал?»~
@14093 = ~Игнорировать его и уйти.~
@14094 = ~Правда: «Мне были нужны деньги».~
@14095 = ~Правда: «Хотел проверить, освежит ли это мою память».~
@14096 = ~Правда: «Ну, что касается этой смерти, я просто решил, что ничего не теряю».~
@14097 = ~Правда: «По правде говоря, сам не знаю».~
@14098 = ~«А тебе какое дело?»~
@14099 = ~«Не твоё собачье дело. Прощай».~
@14100 = ~«А для чего ещё мне следовало это сделать?»~
@14101 = ~«А для чего ещё мне следовало это сделать?»~
@14102 = ~«Я видел, что за порогом смерти».~
@14103 = ~«Не знаю. Для начала я должен увидеть, что за порогом смерти, запомнить это. Если я опять умру, возможно, тогда смогу говорить об этом».~
@14104 = ~«Я уже умирал. Однако почти ничего не помню».~
@14105 = ~«Просто я так думаю. Можешь считать это предчувствием».~
@14106 = ~«Неважно. Мне пора идти. Прощай».~
@14107 = ~«Например?..»~
@14108 = ~«Зачем кому-то этого хотеть?»~
@14109 = ~«„Совершенство“? Задвинься. Это просто гнилое мясо».~
@14110 = ~«Ты не стар, ты просто невежествен. Ты должен жить, не думая о смерти. Она сама придёт за тобой довольно быстро, так что живи, пока можешь».~
@14111 = ~«Возможно, и так, не мне судить. Прощай».~
@14112 = ~«Ты хочешь умереть?»~
@14113 = ~«Я должен идти. Прощай».~
@14114 = ~«Ты хочешь умереть?»~
@14115 = ~«Я должен идти. Прощай».~
@14116 = ~«Что ты сказал?»~
@14117 = ~Игнорировать его и уйти.~
@14118 = ~Правда: «Нет. А ты?»~
@14119 = ~~
@14120 = ~Правда: «Да. А ты?»~
@14121 = ~Ложь: «Да. А ты?»~
@14122 = ~«Не знаю. А *ты* хочешь?»~
@14123 = ~«Ты *угрожаешь* мне, мальчишка?»~
@14124 = ~«Прощай».~
@14125 = ~«Если таково твоё желание, я его уважу… готовься к смерти».~
@14126 = ~«Ты *хочешь* умереть?»~
@14127 = ~«И мне всё равно. Прощай».~
@14128 = ~Правда: «Ради чего здесь жить? Я загнан в этот город, полный тварей и уродов, и не могу вспомнить, как я сюда попал и зачем. Я чужак как для города, так и для себя самого. В жизни для меня нет ничего ценного».~
@14129 = ~Правда: «Потому что мне в этом отказано. Уже это заставляет меня желать смерти».~
@14130 = ~Правда: «Внутри меня чего-то… недостаёт. Я вот говорю тут с тобой и по-прежнему чувствую внутри некую пустоту. Неважно, что я делаю, это чувство не проходит. Пожалуй, умереть было бы лучше».~
@14131 = ~Правда: «Я думаю, в смерти могу научиться чему-то, что было недоступно мне при жизни».~
@14132 = ~Правда: «Я солгал, я не хочу умереть. А кто хочет? Ты?»~
@14133 = ~Правда: «Я солгал, я не хочу умереть. А кто хочет? Ты?»~
@14134 = ~Правда: «Просто хочу».~
@14135 = ~Правда: «Инстинкт самосохранения. Я *хочу* жить».~
@14136 = ~Правда: «Пока я не хочу быть преданным забвению. Быть живым мне нравится *куда* больше».~
@14137 = ~Правда: «Мне ещё надо кое с чем разобраться в жизни, прежде чем я захочу её покинуть. Я хочу узнать, кто же я».~
@14138 = ~«Не знаю».~
@14139 = ~«Я не хочу обсуждать это с тобой. Прощай».~
@14140 = ~«Ты хочешь умереть? И поэтому спросил?»~
@14141 = ~«Я должен идти. Прощай».~
@14142 = ~«Прежде чем я уйду… почему ты хочешь умереть?»~
@14143 = ~«Тогда прощай».~
@14144 = ~«Почему ты хочешь умереть?»~
@14145 = ~«Почему ты не хочешь жить?»~
@14146 = ~«Тогда почему ты ещё не покончил жизнь самоубийством?»~
@14147 = ~«Я должен идти. Прощай».~
@14148 = ~«Наверняка жизнь не может быть так плоха, как ты её расписываешь».~
@14149 = ~«Безрадостная точка зрения… жизнь — это много больше, чем просто боль и ненависть».~
@14150 = ~«Тогда почему ты ещё не покончил жизнь самоубийством?»~
@14151 = ~«Я должен идти. Прощай».~
@14152 = ~«Поверь мне, это не так».~
@14153 = ~«Может быть, после первой смерти».~
@14154 = ~«Тогда почему ты ещё не покончил жизнь самоубийством?»~
@14155 = ~«Если эта жизнь ничем тебя не держит, то тебе следует умереть».~
@14156 = ~«Я должен идти. Прощай».~
@14157 = ~«Я видел, что за порогом смерти».~
@14158 = ~«Не знаю. Для начала я должен увидеть, что за порогом смерти, запомнить это. Если я опять умру, возможно, тогда смогу говорить об этом».~
@14159 = ~«Думаю, я уже умирал. Однако почти ничего не помню».~
@14160 = ~«Просто я так думаю. Можешь считать это предчувствием».~
@14161 = ~«Неважно. Мне пора идти. Прощай».~
@14162 = ~Правда: «Я лежу на острове, дрейфующем по океану великой тьмы. Остров образован из тенистых камней… но камни *вовсе* не камни, они что-то шепчут и бормочут мне, а я не могу понять что. Нет ни тишины, ни покоя, а холод проникает сквозь плоть и сковывает кости».~
@14163 = ~«Я никому не буду говорить об этом месте. Я уже слишком много сказал».~
@14164 = ~Правда: «Я лежу на острове, дрейфующем по океану великой тьмы. Остров образован из тенистых камней… но камни *вовсе* не камни, они что-то шепчут и бормочут мне, а я не могу понять что. Нет ни тишины, ни покоя, а холод проникает сквозь плоть и сковывает кости».~
@14165 = ~«Я ничего тебе не скажу».~
@14166 = ~«Я не буду говорить об этом. Прощай».~
@14167 = ~«Я попросил бы тебя жить».~
@14168 = ~«Я ничего не предлагаю и ничего от тебя не прошу. Прощай».~
@14169 = ~«Ты и *есть* дурак, если хочешь вот так бездумно отбросить свою жизнь. Это оскорбляет и жизнь, и смерть».~
@14170 = ~«Нам больше не о чём говорить. Прощай».~
@14171 = ~Правда: «Я лежу на острове, дрейфующем по океану великой тьмы. Остров образован из тенистых камней… но камни *вовсе* не камни, они что-то шепчут и бормочут мне, а я не могу понять что. Нет ни тишины, ни покоя, а холод проникает сквозь плоть и сковывает кости».~
@14172 = ~Ложь: «Это забвение. Там нет ничего. Это небытие».~
@14173 = ~Ложь: «Это место величайшей радости, небесной красоты. Это место, в котором душа может обрести счастье».~
@14174 = ~«Я не скажу. Прощай».~
@14175 = ~«Кроме тебя. Ты ещё можешь измениться».~
@14176 = ~«Если ты веришь в это, то оно станет правдой».~
@14177 = ~«Мне пора идти. Прощай».~
@14178 = ~«Если ты веришь в это, то оно станет правдой».~
@14179 = ~«Тогда больше не о чём говорить. Я ухожу».~
@14180 = ~«А как насчёт твоих убеждений как Пыльного? Разве это не достойная цель?»~
@14181 = ~«Тогда больше не о чём говорить. Я ухожу».~
@14182 = ~«Нет».~
@14183 = ~«Да».~
@14184 = ~«Зависит от того… сколько?»~
@14185 = ~«Если тебе не хватает убеждённости, чтобы самому покончить с собой, я за тебя это делать не собираюсь».~
@14186 = ~«Нет… прощай».~
@14187 = ~«Нет».~
@14188 = ~«Да».~
@14189 = ~«Зависит от того… сколько?»~
@14190 = ~«Если тебе не хватает убеждённости, чтобы самому покончить с собой, я за тебя это делать не собираюсь».~
@14191 = ~«Нет… прощай».~
@14192 = ~Уйти.~
@14193 = ~«Тогда учти вот что: ты слишком жаждешь обрести забвение. В соответствии с догматами Пыльных такая жажда Истинной Смерти навеки отвратит тебя от неё».~
@14194 = ~«Тогда почему бы не сделать упор на веру Пыльных? Быть может, жизнь действительно есть боль и страдание, но если сосредоточится на твоих убеждениях и на том, что они значат для тебя, то это тебе поможет».~
@14195 = ~«Тогда больше не о чем говорить. Я ухожу».~
@14196 = ~«И правильно делают — они видят в твоём сердце только страстную жажду смерти. Если ты хочешь достичь Истинной Смерти, ты должен сначала примириться с этой жизнью, неважно, насколько она для тебя мучительна. Это возможность, и ты ещё очень молод. Быть может, когда ты глубже узнаешь жизнь, твоё стремление к смерти охладеет».~
@14197 = ~«Тогда я больше не буду читать тебе наставлений. Прощай».~
@14198 = ~«Просто попытайся жить в меру своих сил. Используй эту жизнь, неважно, несколько она мучительна, как возможность. Ты молод. Быть может, когда ты узнаешь жизнь глубже, твоя жажда смерти исчезнет».~
@14199 = ~«Ты должен терпеть эту жизнь. Терпение научит пропускать боль и страдание сквозь себя, не оставляя следов. Скоро они вообще не будут задевать тебя, и тогда ты начнёшь своё движение к Истинной Смерти и к забвению».~
@14200 = ~«Всё зависит от тебя. Прощай».~
@14201 = ~«Просто попытайся жить в меру своих сил. Используй эту жизнь, неважно, несколько она мучительна, как возможность. Ты молод. Быть может, когда ты узнаешь жизнь глубже, твоя жажда смерти исчезнет».~
@14202 = ~«Ты должен терпеть эту жизнь. Терпение научит пропускать боль и страдание сквозь себя, не оставляя следов. Скоро они вообще не будут задевать тебя, и тогда ты начнёшь своё движение к Истинной Смерти и к забвению».~
@14203 = ~«Всю свою жизнь мы учимся умирать. Только ты можешь ответить на свой вопрос».~
@14204 = ~«Всё зависит от тебя. Прощай».~
@14205 = ~«Это всё, что я прошу… живи, взрослей и учись. Прощай».~
@14206 = ~«Нет».~
@14207 = ~«Да».~
@14208 = ~«Зависит от того… сколько?»~
@14209 = ~«Если тебе не хватает убеждённости, чтобы самому покончить с собой, я за тебя это делать не собираюсь».~
@14210 = ~«Прощай».~
@14211 = ~«Тогда прощай».~
@14212 = ~«Хорошо… закрой глаза».~
@14213 = ~«Стоп… мне не нужны твои деньги. Я хочу знать, почему ты хочешь умереть».~
@14214 = ~«Я этого не сделаю. Прощай».~
@14215 = ~Обхватить его шею руками и задушить.~
@14216 = ~Забрать деньги и тихо исчезнуть.~
@14217 = ~«Забери свои деньги. Я хочу знать, почему ты хочешь умереть».~
@14218 = ~«Я этого не сделаю. Прощай».~
@14219 = ~«Этот мешочек — плата за твою глупость. Прощай…»~
@14220 = ~Свернуть ему шею.~
@14221 = ~Отпустить его.~
@14222 = ~«Встретимся на той стороне, Пыльник…»~
@14223 = ~«Встретимся на той стороне, Пыльник…»~
@14224 = ~Дать телу упасть на пол.~
@14225 = ~«Ой-ой…»~
@14226 = ~«Передумал?»~
@14227 = ~«Слушай… когда в следующий раз надумаешь „умереть“, лучше будь в этом уверен, а то другой приятель не остановится, когда ты его попросишь. И раз уж ты так цепляешься за жизнь, то нечего тут ныть, что она полна боли и страданий».~
@14228 = ~«Я заберу деньги как плату за урок».~
@14229 = ~«Я не выполнил свою часть договора, так что забери деньги».~
@14230 = ~«Не говори мне спасибо, просто *живи*. Вот такое бездумное отношение к жизни оскорбляет смерть. Прощай».~
@14231 = ~«Тогда дело в другом. Поэтому спрошу тебя: что именно в жизни тебя так отталкивает?»~
@14232 = ~«Именно в ней. Если бы ты действительно хотел умереть, ты бы уже нашёл способ. Так что не будем тратить время на пустую болтовню. Прощай».~
@14233 = ~«Хорошо… закрой глаза».~
@14234 = ~«Стоп… мне не нужны твои деньги. Я хочу знать, почему ты хочешь умереть».~
@14235 = ~«Я этого не сделаю. Прощай».~
@14236 = ~«Ну так попробуй, убей меня. Увидишь, что будет».~
@14237 = ~«Могу доказать».~
@14238 = ~«Я видел, что за порогом смерти».~
@14239 = ~«Не знаю. Для начала я должен увидеть, что за порогом смерти, запомнить это. Если я опять умру, возможно, тогда смогу говорить об этом».~
@14240 = ~«По-моему, лжёшь только ты и только себе. Прощай».~
@14241 = ~«Воскрешён?»~
@14242 = ~«Попробуй, убей меня. Увидишь, что будет».~
@14243 = ~«Хочешь увидеть?»~
@14244 = ~«Я видел, что за порогом смерти».~
@14245 = ~«Не знаю. Для начала я должен увидеть, что за порогом смерти, запомнить это. Если я опять умру, возможно, тогда смогу говорить об этом».~
@14246 = ~«Если я когда-нибудь умру и всё запомню, я вернусь и расскажу тебе. Тогда и разберёмся, лгал я или нет. Прощай».~
@14247 = ~«По-моему, лжёшь только ты и только себе. Прощай».~
@14248 = ~«Воскрешён?»~
@14249 = ~«Ну так попробуй, убей меня. Увидишь, что будет».~
@14250 = ~«Хочешь увидеть?»~
@14251 = ~«Если я когда-нибудь умру и всё запомню, я вернусь и расскажу тебе. Тогда и разберёмся, лгал я или нет. Прощай».~
@14252 = ~«По-моему, лжёшь только ты и только себе. Прощай».~
@14253 = ~«Кто может обладать такой силой?»~
@14254 = ~«Ты не веришь, что я не могу умереть? Ну так попробуй, убей меня. Посмотришь, что будет».~
@14255 = ~«Ты не веришь, что я не могу умереть? Ну так я тебе докажу».~
@14256 = ~«Если я когда-нибудь умру и всё запомню, я вернусь и расскажу тебе. Тогда и разберёмся, лгал я или нет. Прощай».~
@14257 = ~«Я должен идти. Прощай».~
@14258 = ~«Ты не веришь, что я не могу умереть? Ну так попробуй, убей меня. Посмотришь, что будет».~
@14259 = ~«Ты не веришь, что я не могу умереть? Ну так я тебе докажу».~
@14260 = ~«Если я когда-нибудь умру и всё запомню, я вернусь и расскажу тебе. Тогда и разберёмся, лгал я или нет. Прощай».~
@14261 = ~«По-моему, лжёшь только ты и только себе. Прощай».~
@14262 = ~«Тогда я заставлю тебя смотреть, покажу, что такое смерть».~
@14263 = ~«Ладно, не бери в голову. Что ты имел в виду, когда говорил о „воскрешении“?»~
@14264 = ~«Если все твои действия продиктованы страхом и сомнениями, то сомневаюсь, что ты найдёшь в жизни какие-то радости».~
@14265 = ~«Тогда хватит об этом. Прощай».~
@14266 = ~Руками свернуть себе шею.~
@14267 = ~«Ну, убедился?»~
@14268 = ~«Нет».~
@14269 = ~«Да».~
@14270 = ~«Не знаю».~
@14271 = ~«Не знаю. Но я умираю и возрождаюсь».~
@14272 = ~«Да».~
@14273 = ~«Да, но я чувствую… я чувствую пустоту. Чего-то не хватает, это тревожит меня и никак не оставит в покое».~
@14274 = ~«Действительно. Возможно, не стоит тебе торопиться уйти из этой жизни, ещё не зная, что ждёт тебя в следующей».~
@14275 = ~«Вполне может. Ладно, пошли отсюда».~
@14276 = ~«Вполне может. Ладно, пошли отсюда».~
@14277 = ~«Вполне может. Ладно, пошли отсюда».~
@14278 = ~«Вполне может. Ладно, пошли отсюда».~
@14279 = ~~
@14280 = ~«У меня кое-какие вопросы…»~
@14281 = ~«Прощай».~
@14282 = ~«Я не хочу обсуждать это с тобой. Прощай».~
@14283 = ~Кость фаланги пальца~
@14284 = ~Отрубленная рука~
@14285 = ~Простое серебряное кольцо~
@14286 = ~Бронзовая сфера~
@14287 = ~Мешочек зубов~
@14288 = ~Кишки~
@14289 = ~Витое кольцо~
@14290 = ~Ожерелье пустых зубов~
@14291 = ~Татуировка с номером~
@14292 = ~Помятая кружка~
@14293 = ~Бельё Меббет~
@14294 = ~Чёрное шипастое семя~
@14295 = ~Рецепт: Цветная сфера~
@14296 = ~Рецепт: Кровавый мост~
@14297 = ~Рецепт: Опознание~
@14298 = ~Куб модронов~
@14299 = ~Тряпичная кукла Госпожи Боли~
@14300 = ~Нож Ухира~
@14301 = ~Кружка с чернилами~
@14302 = ~Графин~
@14303 = ~ОТРУБЛЕННАЯ РУКА
Урон: 1-8 дробящий
Особенности: новые татуировки
Фактор скорости: 4
Вес: 5
Навык: булава
Доступно: воинам и ворам

Эта отрубленная рука тверда, как деревянная дубина. Похоже, она была аккуратно отсечена от плеча (вероятнее всего, чем-то очень острым). Даже несмотря на то, что ей не менее десятка лет, рука выглядит скорее окаменелой, чем сгнившей. Она нездорового бледно-серого цвета и вся покрыта шрамами. Поверхность руки украшают замысловатые татуировки, по спирали поднимающиеся от запястья до остатков плеча.

Ты не можешь объяснить причину, но чувствуешь, что должен забрать руку с собой и показать её татуировщику… некоторые татуировки на ней просто восхитительны.~
@14304 = ~ПРОСТОЕ СЕРЕБРЯНОЕ КОЛЬЦО
Вес: 0

Похоже, это небольшое серебряное колечко предназначено для женского пальца. Оно слегка тёплое на ощупь, но других особых свойств у него не заметно.~
@14305 = ~МЕШОЧЕК ЗУБОВ
Вес: 2

Этот маленький кожаный мешочек содержит несколько зубов, от человеческих коренных до клыков, по виду принадлежащих извергам. При встряхивании издаёт звук, похожий на маракасы.~
@14306 = ~КИШКИ
Вес: 2

Это липкая масса окровавленных кишок, раньше явно принадлежавших тебе. Следует признать, наблюдать их за пределами своего тела несколько некомфортно.~
@14307 = ~ВИТОЕ КОЛЬЦО
Особенности:
Класс защиты: +1
Вес: 0

Это кольцо выглядит так, словно три колечка были переплетёны между собой. Один лишь взгляд на него вызывает лёгкое головокружение.~
@14308 = ~БРОНЗОВАЯ СФЕРА
Вес: 5

Это обычный бронзовый шар, около фута в диаметре, но на удивление лёгкий, будто полый внутри.

Хотя его вид довольно обычен, он каким-то образом воздействует на все твои чувства. Поверхность сферы — точнее «ощущение» её поверхности — выстраивает у тебя в голове впечатление, будто это яйцо, которое вот-вот распахнётся. Даже от простого прикосновения к сфере по твоей коже бегут мурашки. В довершение всего, она так сильно пахнет тухлятиной, что глаза слезятся.~
@14309 = ~ОЖЕРЕЛЬЕ ПУСТЫХ ЗУБОВ
Вес: 1

Это ожерелье сделано из заточенных зубов. При ближайшем рассмотрении обнаруживается, что каждый зуб высверлен внутри, словно для заполнения какой-то жидкостью.~
@14310 = ~ТАТУИРОВКА С НОМЕРОМ
Вес: 0

Это татуировка с изображением номера, замысловатое соединение чернил и плоти. Когда её держишь, она извивается, как будто ищет хозяина.~
@14311 = ~ПОМЯТАЯ КРУЖКА
Вес: 3

Эта старая пивная кружка вся покрыта вмятинами, а её ручка, кажется, вот-вот отвалится. Судя по величине некоторых вмятин, этой кружкой пытались проломить чей-то череп.~
@14312 = ~КРУЖКА С ЧЕРНИЛАМИ
Вес: 4

Эта старая пивная кружка вся покрыта вмятинами, а её ручка, кажется, вот-вот отвалится. Судя по величине некоторых вмятин, этой кружкой пытались проломить чей-то череп.

Теперь кружка наполнена чернилами рыбы *брогота-фин*. Надеюсь, эта дурацкая хрень — последнее, что нужно принести Меббет с рынка.~
@14313 = ~БЕЛЬЁ МЕББЕТ
Вес: 15

Это сплющенная кучка зелёного тряпья, тонкого, как бумага, но такого жёсткого, что кажется куда твёрже досок. Оно настолько пропитано зеленовато-лимонным крахмалом, что для смягчения его, вероятно, придётся отмачивать годами. Может, Меббет и найдёт способ использовать свои тряпки, но тебе кажется, что это за пределами человеческих возможностей.~
@14314 = ~ЧЁРНОЕ ШИПАСТОЕ СЕМЯ
Вес: 0

По всей поверхности этого маленького чёрного семени в разные стороны торчат шипы.~
@14315 = ~РЕЦЕПТ: ЦВЕТНАЯ СФЕРА
Позволяет записать «Цветная сфера» в книгу заклинаний
Дистанция: 50 футов
Длительность: особая
Время чтения: 1
Зона действия: 1 существо
Спасбросок: отменяет
Вес: 0
Доступно: магам

Этот рваный листок бумаги содержит рецепт с ингредиентами и ритуалами, необходимыми для малого заклинания школы призыва «Цветная сфера».~
@14316 = ~РЕЦЕПТ: КРОВАВЫЙ МОСТ
Позволяет записать «Кровавый мост» в книгу заклинаний
Дистанция: 0
Длительность: мгновенно
Время чтения: 2
Зона действия: 1 существо
Спасбросок: нет
Вес: 0
Доступно: магам

Этот рваный листок бумаги содержит рецепт с ингредиентами и ритуалами, необходимыми для малого заклинания школы некромантии «Кровавый мост». Заклинание даёт возможность поделиться частичкой своей жизненной энергии с другим существом, ослабив себя, но дав силу ему.~
@14317 = ~РЕЦЕПТ: ОПОЗНАНИЕ
Позволяет записать «Опознание» в книгу заклинаний
Дистанция: 1 предмет
Длительность: мгновенно
Время чтения: 1
Зона действия: только на экране снаряжения
Спасбросок: нет
Вес: 0
Доступно: магам

Этот рваный листок бумаги содержит рецепт с ингредиентами и ритуалами, необходимыми для малого заклинания школы прорицания «Опознание». Заклинание определяет магию, содержащуюся в предметах, и позволяет узнать их возможности.~
@14318 = ~КУБ МОДРОНОВ
Вес: 1

Эта небольшая металлическая игрушка — точная копия какого-то существа с кубическим телом и огромными глазами на одной из сторон. У игрушки две руки, две ноги, два складывающихся крыла и по меньшей мере восемнадцать сочленений. Возможно, это коллекционный предмет.~
@14319 = ~Годы не оставили следов на этой маленькой тряпичной кукле; похоже на то, что даже нитки не запутались. Она выглядит как женщина с нимбом из шипов.~
@14320 = ~ТРЯПИЧНАЯ КУКЛА ГОСПОЖИ БОЛИ
Вес: 1

Годы не были милосердны к этой маленькой тряпичной кукле. Швы несколько поистрепались, а кое-где нитки и вовсе разошлись. Выглядит она как странная женщина в мантии и с ореолом из шипов вокруг головы.~
@14321 = ~КЛЮЧ ОТ КАБИНЕТА В МОРТУАРИИ
Вес: 1

Этот тяжёлый ключ состоит из кости, странным образом объединённой с неизвестным кроваво-красным металлом. У него С-образная бородка, напоминающая челюсти, готовые укусить неосторожного владельца. Этот ключ открывает внутренние двери Мортуария.

^NПРИМЕЧАНИЕ. Для открытия двери достаточно иметь в вещах нужный ключ. Иногда он может исчезнуть после применения… это сделано для того, чтобы освободить место в рюкзаке для более важных вещей, когда ключ больше не нужен.^-~
@14322 = ~НОЖ УХИРА
Урон: 1-3 колющий
Фактор скорости: 1
Вес: 0
Навык: клинок
Недоступно: священникам

Это ничем не примечательный, весь покрытый грязью кинжал, на рукояти которого вырезано «УХИР». Несмотря на дешёвый вид, лезвие неплохо сбалансировано.~
@14323 = ~УГОЛЬНЫЙ АМУЛЕТ
Особенности:
   Сопротивление огню: +50%
   Сопротивление магическому огню: +25%
Вес: 0

Этот кусочек угля — обгорелая кость какого-то существа, похожая на палец или коготь. Множество символов нацарапано на поверхности кости… символы едва заметны, разобрать их невозможно.

Этот угольный амулет временно защищает владельца от огня и сильного жара. Для использования его надо разломить пополам, обе половинки растолочь в порошок, который затем втереть в кожу над сердцем.~
@14324 = ~ПОДУШКА СНОВ
Вес: 1

Эта маленькая, украшенная вышивкой подушка для гроба из заведения гробовщика.~
@14325 = ~КЛЕТКА СНОВ
Вес: 0

Это изящная клетка для птиц, украшенная лезвиями, которую ты получил от голема Коаксметала. Тебе нужно отнести её Нилу Зандеру для использования в Построителе Снов.~
@14326 = ~КЛЮЧ СНОВ
Вес: 0

Это простое чёрное пёрышко, которое используется для управления Построителем Снов в Великой Кузнице.~
@14327 = ~ФЛАКОН СНОВ
Вес: 0

Этот флакон содержит кусочки твоей кожи и немного крови для заправки Построителя Снов Нила Зандера.~
@14328 = ~МОЛИТВЕННЫЕ ЧЁТКИ
Вес: 1

Это ожерелье для молитвы из красных и чёрных бусин. Паутина чёрных линий, обвивающая края этих чёток, распускается странными узорами, которые ты не можешь разобрать.~
@14329 = ~МЕДНАЯ СЕРЬГА
Вес: 0

Этот грубое медное колечко выглядит как жертва страстного любовника… или кого-то, кто любит грызть металл. С одной стороны оно погнуто и имеет отметины от зубов.~
@14330 = ~СЕРЕБРЯНАЯ СЕРЬГА
Вес: 0

У этой незатейливой серебряной серьги на поверхности видна полустёршаяся гравировка, но разобрать узор ты не можешь.~
@14331 = ~ЗОЛОТАЯ СЕРЬГА
Вес: 0

Возможно, эта простая золотая серёжка когда-то свисала с уха дворянина.~
@14332 = ~БРОНЗОВОЕ КОЛЬЦО
Вес: 0

Это грубое бронзовое кольцо слегка изогнуто, как будто кто-то в прошлом носил его в носу. Несмотря на многочисленные выбоины и царапины, его можно продать местным торговцам за несколько монет.~
@14333 = ~ЗОЛОТОЕ КОЛЬЦО
Вес: 0

Наружная сторона этого золотого кольца покрыта гравировкой, но ты не можешь понять её значение. Для чего бы оно ни предназначалось ранее, возможно, местные торговцы дадут за него несколько монет.~
@14334 = ~БРОНЗОВАЯ СФЕРА
Вес: 5

Это обычный бронзовый шар, около фута в диаметре, но на удивление лёгкий, будто полый внутри.

Хотя его вид довольно обычен, он каким-то образом воздействует на все твои чувства. Поверхность сферы — точнее «ощущение» её поверхности — выстраивает у тебя в голове впечатление, будто это яйцо, которое вот-вот распахнётся. Даже от простого прикосновения к сфере по твоей коже бегут мурашки. В довершение всего, она так сильно пахнет тухлятиной, что глаза слезятся.~
@14335 = ~КОЛЬЦО ГЕРАЙЗА
Особенности:
   Спасброски против яда: +3
Вес: 0

Похоже, это небольшое серебряное колечко предназначено для женского пальца. Оно слегка тёплое на ощупь и обладает способностью нейтрализовать яд в крови надевшего.~
@14336 = ~ОТРУБЛЕННАЯ РУКА
Урон: 1-8 дробящий
Зачаровано: +1
Особенности:
   Дробящий урон: +2
   Новые татуировки
Фактор скорости: 4
Вес: 5
Навык: булава
Доступно: воинам и ворам

Эта отрубленная рука тверда, как деревянная дубина. Похоже, она была аккуратно отсечена от плеча (вероятнее всего, чем-то очень острым). Даже несмотря на то, что ей не менее десятка лет, рука выглядит скорее окаменелой, чем сгнившей. Она нездорового бледно-серого цвета и вся покрыта шрамами. Поверхность руки украшают замысловатые татуировки, по спирали поднимающиеся от запястья до остатков плеча.

При детальном осмотре ты понимаешь, что рука однозначно твоя. Остаётся только гадать, как долго она лежала и ждала тебя. Ты не можешь объяснить причину, но чувствуешь, что должен забрать руку с собой и показать её татуировщику… татуировки могут поведать о чём-то, что случилось с твоими прошлыми инкарнациями, пока рука ещё не была отрублена.~
@14337 = ~ГРАФИН БЕСКОНЕЧНОЙ ВОДЫ
Вес: 2

Совершенно обычный закупоренный графин, который каким-то образом несёт в себе бесконечный запас воды. Хорошо использовать для тушения пожаров и тому подобных вещей.~
@14338 = ~«Ни из какого склепа я не выползал».~
@14339 = ~«Вообще-то, я только что из Мортуария».~
@14340 = ~Шутка: «Ну, склеп уже утратил своё очарование, так что теперь я присматриваю подходящее место, чтобы помереть. Не знаешь такого?»~
@14341 = ~«Прости, я перепутал тебя с другой. Пока».~
@14342 = ~Сере ухмыляется, увидев тебя: «Ба, уж не выползший ли это из склепа? Что привело тебя к двери Сере в этот раз, парень?»~
@14343 = ~«Не *ползал* я ни по каким склепам».~
@14344 = ~«Не *ползал* я ни по каким склепам».~
@14345 = ~Шутка: «Ну, склеп уже утратил своё очарование, так что теперь я присматриваю подходящее место, чтобы помереть. Не знаешь такого?»~
@14346 = ~«У меня кое-какие вопросы…»~
@14347 = ~«Так, остановился взглянуть на тебя. Пока».~
@14348 = ~«Вопросы, да? Ладно, можешь спрашивать… — Сере смотрит на тебя суровым взглядом, но потом улыбается, — …выползший из склепа».~
@14349 = ~«Не *ползал* я ни по каким склепам».~
@14350 = ~«Не *ползал* я ни по каким склепам».~
@14351 = ~«Я хочу спросить тебя кое о ком из Пыльных…»~
@14352 = ~«Ты Пыльная?»~
@14353 = ~«Можешь рассказать мне о Хэмрисе?»~
@14354 = ~«Я хочу поговорить с тобой о твоей вере. Что случилось такого, что отвратило тебя от философии Пыльных?»~
@14355 = ~«Сере, ты уже не Пыльная. Хочешь альтернативу?»~
@14356 = ~«Не видела недавно дневник? Я свой дневник потерял».~
@14357 = ~«Я ищу мужчину по имени Фарод. Ты его не видела?»~
@14358 = ~«Я должен идти. Прощай».~
@14359 = ~«Вот как? — Сере поднимает брови. — Порадуй меня, скажи что принёс в то место смех, парень. Немного живительной влаги для тех, кто не освободился». Она фыркает: «Пф-ф-ф. Слишком много пыльных и поросших паутиной умов».~
@14360 = ~«Ты не любишь Мортуарий? Разве ты не Пыльная?»~
@14361 = ~«У меня кое-какие вопросы…»~
@14362 = ~«Мне надо идти, пока».~
@14363 = ~Она хмурится, её лицо морщится как смятый пергамент. «Ладно. Из какого *гроба* ты выполз? — бормочет она. — Из одного из этих плохо обструганных гробов Хэмриса, наверное. Я слышала, мёртвые в них все в занозах лежат». Она фыркает: «С тех пор, как его отец помер, парень и гроша ломаного не стоит».~
@14364 = ~«Из *гроба* я также не выползал».~
@14365 = ~«Кто такой Хэмрис?»~
@14366 = ~«Не выползал я из гроба… на самом деле я только что из Мортуария».~
@14367 = ~Шутка: «Ну, в гробу, который он сделал, мешали сквозняки. Так что теперь я присматриваю подходящее место, чтобы прилечь и помереть. Не знаешь такого?»~
@14368 = ~«Мне нужно кое-что узнать. Могу я задать тебе пару вопросов?»~
@14369 = ~«Прости, что побеспокоил. Прощай».~
@14370 = ~Она улыбается, демонстрируя неровные зубы. «Ладно, парень. Из какого *саркофага* ты выполз? — она прерывается и тихо хихикает. — Я только подшучиваю, парень. Не злись. Просто выглядишь как сама смерть».~
@14371 = ~«Кто такой Хэмрис, о котором ты говорила?»~
@14372 = ~«Неудивительно… я только что из Мортуария».~
@14373 = ~Шутка: «Я и не злюсь. Честно говоря, в саркофаге стало тесновато, так что теперь я присматриваю подходящее место, чтобы прилечь и помереть. Не знаешь такого?»~
@14374 = ~«Хэмрис — гроболом… прости, грободел… из Нижнего района. Унаследовал мастерскую, когда его отец помер, к досаде каждого трупа, которому нужен гроб, склеп или надгробие в Сигиле».~
@14375 = ~«Мне нужно кое-что узнать. Могу я задать тебе пару вопросов?»~
@14376 = ~«Прости, что побеспокоил. Прощай».~
@14377 = ~«Что случилось с его отцом?»~
@14378 = ~«Ясно. Можно задать тебе пару вопросов?»~
@14379 = ~«Спасибо за информацию… и пока».~
@14380 = ~«А уши у тебя только для вида, парень? Он *помер*, — бормочет она. — Сын заговорил его до смерти, скорей всего. У этого парня язык как помело. Странно, как у него ещё голова не отвалилась от постоянного сотрясения воздуха».~
@14381 = ~«Похоже, у вас и с ним много общего».~
@14382 = ~Шутка: «Судя по всему, мне бы не хотелось быть похороненным в одном из его гробов. Не подскажешь другое место, где я мог бы прилечь и помереть?»~
@14383 = ~«Мне нужно кое-что узнать. Могу я задать тебе пару вопросов?»~
@14384 = ~«Я должен идти. Прощай».~
@14385 = ~Она прищуривается: «Сделай нам обоим одолжение, захлопни шкатулку, парень. Не высасывай из пальца общее между мной и этим тявкающим щенком».~
@14386 = ~«Хорошо. У меня другие вопросы…»~
@14387 = ~«Я должен идти. Прощай».~
@14388 = ~Она разражается лающим смехом, который терзает твой слух: «Ха! Не здесь… если ты, конечно, не планируешь помереть от скуки».~
@14389 = ~«А что здесь не так?»~
@14390 = ~«Буду иметь в виду. У меня ещё пара вопросов…»~
@14391 = ~«Мне пора. Пока, Сере».~
@14392 = ~«Пф-ф-ф. Что-то повредило твой слух и *зрение*, парень?» Она обводит бар рукой: «Оглядись. Что твои глаза говорят тебе?»~
@14393 = ~«Пыльные».~
@14394 = ~«Бар Пыльных».~
@14395 = ~«Банда весёлых Пыльных, радостно пьющих и оживлённо общающихся, прославляя жизнь во всём её многообразии».~
@14396 = ~«У меня другие вопросы…»~
@14397 = ~«Я должен идти. Прощай».~
@14398 = ~«*Очень* хорошо! — Сере сухо хихикает, но непохоже, чтобы она смеялась над тобой. — Могу рискнуть уточнить, что Пыльные — самые тупые из всех тупиц, свивших гнездо в Сигиле… всегда говорят о смерти с благоговением, как будто это величайшее благо для всех существ мультивселенной, к которому только и стоит стремиться. Пф-ф-ф».~
@14399 = ~«Но ты же Пыльная».~
@14400 = ~«Ясно. У меня другие вопросы…»~
@14401 = ~«Я должен идти. Прощай».~
@14402 = ~«Ты тут много умного наплёл, парень… может, твой язык вообще умнее тебя? — Сере косится на тебя, затем фыркает. — Это бы объяснило твои шрамы».~
@14403 = ~«Но это не объясняет, почему Пыльная сидит здесь и высмеивает других Пыльных. Не желаешь ответить ещё на вопросик? Ты *действительно* Пыльная?»~
@14404 = ~«Складно излагаешь. Слушай, у меня ещё пара вопросов…»~
@14405 = ~«Пожалуй, я услышал достаточно. Прощай».~
@14406 = ~«Пыльная? Вроде того… — Сере фыркает. — Пф-ф-ф. Немало воды утекло, пока я носила эти одежды. Моё тело почти готово переправиться на другой берег». Она смеётся, но в смехе не слышно радости.~
@14407 = ~«Ты боишься умирать?»~
@14408 = ~«У меня кое-какие вопросы…»~
@14409 = ~«Я должен идти. Прощай».~
@14410 = ~«Конечно да, парень! А кто нет? — она хмурится и быстро оглядывается. — Ну, кроме Пыльных. Они не боятся, так как ослепли, десятилетиями глотая дерьмо о том, что смерть — это разновидность „освобождения“. Пф-ф-ф».~
@14411 = ~«Она и *есть* в каком-то роде освобождение».~
@14412 = ~«Говоришь ты не как Пыльная».~
@14413 = ~«Что вызвало такой кризис веры?»~
@14414 = ~«Что вызвало такой кризис веры?»~
@14415 = ~«Ясно. У меня другие вопросы…»~
@14416 = ~«Я должен идти. Прощай».~
@14417 = ~«Если ты думаешь, что жизнь — это тяжкая ноша, тогда может быть, парень. А я так не думаю».~
@14418 = ~«Что вызвало такой кризис веры?»~
@14419 = ~«Что вызвало такой кризис веры?»~
@14420 = ~«Так ты не веришь тому, что говорят Пыльные? Разве ты сама не Пыльная?»~
@14421 = ~«Ясно. У меня другие вопросы…»~
@14422 = ~«Я должен идти. Прощай».~
@14423 = ~Она пожимает плечами: «Жизнь, я полагаю. Она… э…» Она хмурится: «Ха! Всё это неважно. Не хочу утомлять тебя незначительными деталями».~
@14424 = ~«Вообще-то мне хотелось бы знать».~
@14425 = ~«Ясно. У меня другие вопросы…»~
@14426 = ~«Ну и хвала силам. Пока».~
@14427 = ~«Я должен идти. Прощай».~
@14428 = ~«Ах, тебе *хотелось бы*? — она смотрит на тебя скептически. — Пф-ф-ф. Как думаешь, я старая?»~
@14429 = ~Правда: «Старая».~
@14430 = ~Надо же быть джентльменом: «Да нет, не очень».~
@14431 = ~Солгать по-доброму: «Скорее молодая».~
@14432 = ~«Я не знаю, да мне и без разницы».~
@14433 = ~«У меня кое-какие вопросы…»~
@14434 = ~«Я должен идти. Прощай».~
@14435 = ~Она фыркает. «Ты ошибаешься. Я *действительно* старая. Я потратила долгие годы своей жизни на обучение Пыльных. Видела многих детей Пыльных, которым показывала пути фракции, учила их хранить веру и соблюдать её постулаты… — она хмурится, — …и всякое такое. Нет вопросов. Нет сомнений. Эта жизнь — лишь преддверие Истинной Смерти».~
@14436 = ~«И что случилось?»~
@14437 = ~«Знаешь, это начинает мне надоедать. Пока».~
@14438 = ~«Ясно. У меня другие вопросы…»~
@14439 = ~«Я должен идти. Прощай».~
@14440 = ~Сере моргает, а потом улыбается: «Ну разве ты не милый?» Она тихо смеётся, потом кашляет. «Я старше, чем выгляжу. Гораздо старше», — она вздыхает. «Я потратила долгие годы своей жизни на обучение Пыльных. Видела многих детей Пыльных, которым показывала пути фракции, учила их хранить веру и соблюдать её постулаты… — она хмурится, — …и всякое такое. Нет вопросов. Нет сомнений. Эта жизнь — лишь преддверие Истинной Смерти».~
@14441 = ~«И что случилось?»~
@14442 = ~«Знаешь, это начинает мне надоедать. Пока».~
@14443 = ~«Ясно. У меня другие вопросы…»~
@14444 = ~«Я должен идти. Прощай».~
@14445 = ~Сере хмурится: «Пф-ф-ф. Именно *ты* просил меня трещать шкатулкой, парень. Впредь я ещё подумаю, стоит ли отвечать на твои вопросы».~
@14446 = ~«Обязательно. Прощай».~
@14447 = ~«Ну… две недели назад у меня началась лихорадка, — она вздыхает. — Я думала, мне конец. Это… ох, это всё во мне перетряхнуло».~
@14448 = ~«Как?»~
@14449 = ~«Знаешь, это начинает мне надоедать. Пока».~
@14450 = ~«Ясно. У меня другие вопросы…»~
@14451 = ~«Я должен идти. Прощай».~
@14452 = ~Её лицо каменеет. «Члены твоей фракции ходят вокруг твоего смертного ложа, как стая бледнорожих упырей, наперебой рассказывая тебе, как хорошо умирать: „О, Сере так везёт! Она скоро освободится от груза жизни!“ *Груза жизни*? Вот тогда меня как стукнуло…»~
@14453 = ~«И?..»~
@14454 = ~«Знаешь, это начинает мне надоедать. Пока».~
@14455 = ~«Ясно. У меня другие вопросы…»~
@14456 = ~«Я должен идти. Прощай».~
@14457 = ~«Есть что-то… — странное выражение проступает на её лице, — …здорово сбивающее с толку в том, что никто вокруг не ценит твою *жизнь*. Пыльные твердят, что жизнь — это боль и страдания… так ли? И мы должны радоваться уходу в небытие… должны ли?» Она качает головой: «Вопросы, вопросы… и очень мало ответов».~
@14458 = ~«Похоже, ты больше не веришь в философию Пыльных».~
@14459 = ~«И что ты будешь делать?»~
@14460 = ~«Ясно. У меня другие вопросы…»~
@14461 = ~«Я должен идти. Прощай».~
@14462 = ~«У меня такое чувство, что сомнения просто роятся у меня в голове, — она трёт виски. — Они не дают мне покоя. Они нуждаются в ответах, а у меня пока не получилось найти ни единого».~
@14463 = ~«И что ты будешь делать?»~
@14464 = ~«Ясно. У меня другие вопросы…»~
@14465 = ~«Я должен идти. Прощай».~
@14466 = ~«Если честно, парень, я не знаю, — Сере вздыхает. — Проблема в моих сомнениях. Я не могу даже верить в правдивость своих чувств, или в то, что страх смерти не вызван последствиями лихорадки. Как тут решить, что делать? Пройдёт ли это? Не знаю».~
@14467 = ~«Сере, если бы ты действительно верила в философию Пыльных, то лихорадка не вызвала бы у тебя таких сомнений».~
@14468 = ~«Сере, я трактую это как испытание твоей веры. Судя по всему, эти чувства — временные. Все эти годы глубокой веры в правоту убеждений Пыльных не могли быть ложью».~
@14469 = ~«Суть философии Пыльных в том, что жизнь — сплошная боль. Это оружие, которое жизнь использует против душ, чтобы привязать их к существованию. Не позволяй испытаниям разрушить твои убеждения Пыльной. Время излечит сомнения».~
@14470 = ~«Тут сложно что-то советовать. Слушай, у меня другие вопросы…»~
@14471 = ~«Я должен идти. Прощай».~
@14472 = ~Сере изумлённо смотрит на тебя, потом медленно кивает: «Может быть… может быть». Она сводит брови, её лицо покрывается морщинами от напряжённых раздумий. «Я должна хорошенько это обмозговать».~
@14473 = ~«Давай. Это немаловажно».~
@14474 = ~«Это всё, чего я хотел. Слушай, у меня другие вопросы…»~
@14475 = ~«Я должен идти. Прощай».~
@14476 = ~«Эй, лады… хорош трепаться о моих бедах! — Сере внимательно смотрит на твои шрамы. — Выглядишь так, будто не раз со смертью на брудершафт пил. Разве это не поменяло отчасти твоих взглядов? Разве не стал чуть больше ценить жизнь?»~
@14477 = ~«Ну, мой случай вообще особенный… я очнулся в Мортуарии. Думаю, меня по ошибке приняли за труп, и готовились хоронить. Что самое странное, думаю, я и правда умер… а потом выздоровел».~
@14478 = ~«Да, мои отношения со смертью гораздо ближе, чем у других людей. Похоже, я не могу умереть… по крайней мере, сколько себя помню».~
@14479 = ~Правда: «Стал».~
@14480 = ~Правда: «Не так чтобы очень».~
@14481 = ~«Мне не очень хочется об этом говорить. Но у меня другие вопросы…»~
@14482 = ~«Я должен идти. Прощай».~
@14483 = ~Сере моргает: «Ты пугаешь мой гроб».~
@14484 = ~«Это правда».~
@14485 = ~«Эй, я только пошутил».~
@14486 = ~«Да ну?»~
@14487 = ~«Мне не очень хочется об этом говорить. Но у меня другие вопросы…»~
@14488 = ~«Думаю, сказано уже достаточно. Пока».~
@14489 = ~«Непредсказуемы пути планов, и я видела слишком много, чтобы отбрасывать даже *самую* невероятную историю, — она изучает твоё лицо. — Если это правда, как так получилось?»~
@14490 = ~«Не знаю».~
@14491 = ~«Всё, что я знаю, — это что я очнулся в Мортуарии, лишённый памяти и покрытый таким количеством ран, которого хватило бы трижды убить меня».~
@14492 = ~«Знать бы самому. Слушай, у меня другие вопросы…»~
@14493 = ~«Думаю, сказано уже достаточно. Пока».~
@14494 = ~Мгновение она смотрит на тебя, потом пожимает плечами: «Значит, мы похожи. Странная история. Никогда ничего подобного не слышала. Позор моей памяти».~
@14495 = ~«Нет никаких догадок, как это могло случиться?»~
@14496 = ~«У меня другие вопросы…»~
@14497 = ~«Прощай».~
@14498 = ~«Не говори так громко, — она оглядывается вокруг. — Странная история. Никогда ничего подобного не слышала. Позор моей памяти».~
@14499 = ~«Нет никаких догадок, как это могло случиться?»~
@14500 = ~«У меня другие вопросы…»~
@14501 = ~«Прощай».~
@14502 = ~«Нет, ни единой. Никогда не слышала ни о ком, кого не могла бы забрать смерть… до сих пор».~
@14503 = ~«Ладно, может, я могу задать ещё пару вопросов…»~
@14504 = ~«Прощай».~
@14505 = ~Она хмурит брови: «Следи за своими шутками. Они достаточно остры, чтобы убить тебя». Она отворачивается, делая отталкивающий жест рукой: «Оставь меня».~
@14506 = ~«Прощай».~
@14507 = ~«А? Говори ясней, парень».~
@14508 = ~«У меня есть друзья, которые считают, что такие организации как Пыльные должны быть низложены».~
@14509 = ~«Вообще-то я просто оговорился. У меня другие вопросы…»~
@14510 = ~«Неважно. Мне пора идти. Прощай».~
@14511 = ~«О? — она ухмыляется. — Уж не говоришь ли ты о *Лиге*?»~
@14512 = ~«Да».~
@14513 = ~«Может быть…»~
@14514 = ~«Вообще-то я просто оговорился. У меня другие вопросы…»~
@14515 = ~«Неважно. Мне пора идти. Прощай».~
@14516 = ~«Пф-ф-ф! Эти бешеные подстрекатели ещё безумнее Пыльных, парень. Среди них не место такой старой женщине, как я».~
@14517 = ~«Разве? Я думаю, ты можешь быть ценным членом».~
@14518 = ~«Прежде чем скажешь нет, подумай вот о чём: твоё знакомство со смертью заставило тебя понять ценность жизни. Пыльные портят новых членов, заставляя их поверить в то, что смерть предпочтительней жизни. Как думаешь, это правильно?»~
@14519 = ~«Похоже, тебе нужны перемены».~
@14520 = ~«Ладно. Я ухожу… дай мне знать, если твоё мнение изменится».~
@14521 = ~«Думаю, ты ошибаешься, — Сере улыбается; похоже, твои слова её позабавили. — У меня есть сомнения, но они никогда не уводили меня *так* далеко».~
@14522 = ~«Подумай вот о чём: твоё знакомство со смертью заставило тебя понять ценность жизни. Пыльные портят новых членов, заставляя их поверить в то, что смерть предпочтительней жизни. Как думаешь, это правильно?»~
@14523 = ~«Ладно, последний вопрос: что ты думаешь о Посмертном Договоре?»~
@14524 = ~«Забудь. У меня вопросы…»~
@14525 = ~«Ладно. Я ухожу… дай мне знать, если твоё мнение изменится».~
@14526 = ~«Посмертный Договор? — она выглядит удивлённой. — А что?»~
@14527 = ~«Ты думаешь, покупка тела для использования в рабском труде — это *хорошо*? Использовать момент слабости духа, чтобы поработить тело после кончины? Как думаешь, Пыльным стоит этим гордиться?»~
@14528 = ~«Сомнительно, парень».~
@14529 = ~«Могу я задать ещё пару вопросов?..»~
@14530 = ~«Тогда прощай».~
@14531 = ~«Ну, нет… но…»~
@14532 = ~«А как насчёт Посмертного Договора? Ты думаешь, покупка тела для использования в рабском труде — это *хорошо*? Использовать момент слабости духа, чтобы поработить тело после кончины? Как думаешь, Пыльным стоит этим гордиться?»~
@14533 = ~«Послушай сама себя, Сере. Каждый твой ответ выдаёт твои сомнения. Ты не веришь в философию Пыльных. Ты знаешь, что она неправильна».~
@14534 = ~«Э… ну… — Сере хмурится. — Хм-м. Я никогда не говорила, что согласна со *всей* деятельностью Пыльные, но что твои друзья собираются со всем этим делать?»~
@14535 = ~«Мы разрушим стены. Мы начнём снова. И все освободятся от этого лицемерия, которое они зовут философией».~
@14536 = ~«Ладно, я буду ушами для твоих друзей, — Сере, похоже, удивляется сама себе. — А может, и большим». Она смеётся: «Я чувствую себя полной жизни… всё это должно быть страшно интересным».~
@14537 = ~«Ты не пожалеешь. У меня другие вопросы…»~
@14538 = ~«Спасибо тебе, Сере. Пока».~
@14539 = ~«На что он похож?»~
@14540 = ~«Без понятия».~
@14541 = ~«Неважно. У меня другие вопросы…»~
@14542 = ~«Не имеет значения. Мне пора. Пока».~
@14543 = ~«Если ты не знаешь, как он выглядит, как ты собираешься его искать?»~
@14544 = ~«Вот и мне непонятно. У меня другие вопросы…»~
@14545 = ~«Не имеет значения. Мне пора. Пока».~
@14546 = ~Лицо Сере неодобрительно морщится: «Этот *пёс*… он наихудший из всех Сборщиков. Я слышала, что его логово где-то на Площади Мусорщиков, в нескольких улицах к западу от ворот Мортуария. Опасное место. Некоторым сборщикам недостаёт терпения подождать, пока человек умрёт, если могут продать его за медяки».~
@14547 = ~«Сборщики?»~
@14548 = ~«Ясно. У меня другие вопросы…»~
@14549 = ~«Спасибо за предупреждение. Прощай».~
@14550 = ~«Они — сброд, который копается в потрохах Улья в поисках трупов, чтобы потом продать их Пыльным. Зарабатывают на жизнь, избавляясь от мёртвых. Пёстрый народ. Порой становится стыдно только из-за того, что живёшь с ними в одном городе, — она вздыхает. — Пф-ф-ф. Ну они хотя бы помогают держать улицы чистыми».~
@14551 = ~«А. У меня другие вопросы…»~
@14552 = ~«Я должен идти. Прощай».~
@14553 = ~«Ничего плохого в том нет. Кто у тебя на уме?»~
@14554 = ~«Можешь рассказать мне об Ожидающем-Смерть?»~
@14555 = ~«Не расскажешь мне о Мортаи?»~
@14556 = ~«Не расскажешь мне про Эморика?»~
@14557 = ~«Можешь рассказать мне о старике Медноглазом?»~
@14558 = ~«В Мортуарии я встретил писаря по имени Дхалл. Ты его знаешь?»~
@14559 = ~«Я встретил в Мортуарии гида, Соэго. Ты его знаешь?»~
@14560 = ~«Одна из бальзамировщиц Мортуария… Ай-Вин. Не знаешь её?»~
@14561 = ~«Конкретно, никто. Я никого из них по именам не знаю».~
@14562 = ~«Ладно, забудь. У меня другие вопросы…»~
@14563 = ~«Я должен идти. Прощай».~
@14564 = ~«Этот парень здесь часто появляется. Не знаю, что с ним случилось. Быть может, он потрясён после гибели друга».~
@14565 = ~«Поясни».~
@14566 = ~«Поясни».~
@14567 = ~«Соэго всегда был гидом в Мортуарии?»~
@14568 = ~«Могу я спросить тебя о других Пыльных?»~
@14569 = ~«У меня другие вопросы…»~
@14570 = ~«Я должен идти. Прощай».~
@14571 = ~«Один из его друзей погиб в Улье пару недель назад, его разорвали на части крысы, — она качает головой. — Грязное дело».~
@14572 = ~«Соэго всегда был гидом в Мортуарии?»~
@14573 = ~«Могу я спросить тебя о других Пыльных?»~
@14574 = ~«Ясно. У меня другие вопросы…»~
@14575 = ~«Я должен идти. Прощай».~
@14576 = ~«Нет, только последние несколько месяцев… и недавно я слышала, что он вызвался куда-то миссионером, но я не знаю куда».~
@14577 = ~«Могу я спросить тебя о других Пыльных?»~
@14578 = ~«Ясно. У меня другие вопросы…»~
@14579 = ~«Я должен идти. Прощай».~
@14580 = ~«Пф-ф-ф. Дхалл? Он был моим учителем философии во время обучения в Мортуарии, а ещё он сварливый дурак. Он болен, как я слышала. Готова поспорить, его присутствие наскучит даже самой смерти».~
@14581 = ~«Он умирает?»~
@14582 = ~«Могу я спросить тебя о других Пыльных?»~
@14583 = ~«Ясно. У меня другие вопросы…»~
@14584 = ~«Я должен идти. Прощай».~
@14585 = ~«Пф-ф-ф. Больней паршивой собаки. Часы его жизни отмеряют последние песчинки».~
@14586 = ~«Могу я спросить тебя о других Пыльных?»~
@14587 = ~«Ясно. У меня другие вопросы…»~
@14588 = ~«Я должен идти. Прощай».~
@14589 = ~Ты видишь Эморика. Он смотрит на тебя неподвижным взглядом.~
@14590 = ~Игнорировать его.~
@14591 = ~«У меня к тебе кое-какие вопросы».~
@14592 = ~«У меня к тебе кое-какие вопросы».~
@14593 = ~«Ожидающий-Смерть? Пф-ф-ф! Мозгов у этого парня *вдвое* меньше, чем у осла. Он *хочет* умереть, хотя и очень молод. Надеюсь, смерть *сможет* на него повлиять. Научит его кое-чему…»~
@14594 = ~«Могу я спросить тебя о других Пыльных?»~
@14595 = ~«Ясно. У меня другие вопросы…»~
@14596 = ~«Я должен идти. Прощай».~
@14597 = ~«А, этот старый дурень с каменным лицом. Я учила его, знаешь ли, и всегда была высокого о нём мнения, но потом мои глаза открылись. Он просто старый сварливый упырь, который торчит тут часами, чтобы молодые Пыльные не ровен час не усомнились, кто здесь главный, — ворчит она. — Старый стервятник».~
@14598 = ~«Могу я спросить тебя о других Пыльных?»~
@14599 = ~«Ясно. У меня другие вопросы…»~
@14600 = ~«Я должен идти. Прощай».~
@14601 = ~«Мортаи? Ха! Я думала, ты собирался спрашивать о Пыльных, — она сплёвывает. — Не найдёшь Пыльного, который был бы меньше Пыльным, чем это пустоголовое, жадное до денег трепло!»~
@14602 = ~«Что ты имеешь в виду?»~
@14603 = ~«Могу я спросить тебя о других Пыльных?»~
@14604 = ~«Ясно. У меня другие вопросы…»~
@14605 = ~«Я должен идти. Прощай».~
@14606 = ~«Мортаи так стремится превзойти всех по количеству подписанных Посмертных Договоров, что я сомневаюсь, был ли он когда-либо вообще Пыльным».~
@14607 = ~«Не понимаю».~
@14608 = ~«Могу я спросить тебя о других Пыльных?»~
@14609 = ~«Ясно. У меня другие вопросы…»~
@14610 = ~«Я должен идти. Прощай».~
@14611 = ~«Он *страстно* желает заключать эти договоры, парень. Он озабочен своей репутацией. Думает только о своей *карьере* среди Пыльных. Это уже говорит о нём всё».~
@14612 = ~«Я всё равно не понимаю».~
@14613 = ~«Я всё равно не понимаю».~
@14614 = ~«Могу я спросить тебя о других Пыльных?»~
@14615 = ~«Ясно. У меня другие вопросы…»~
@14616 = ~«Я должен идти. Прощай».~
@14617 = ~«Говорят, что страсти убивают, — Сере фыркает. — Пф-ф-ф. Для Пыльного это глупость. Страсти держат тебя живым. И если ты не сможешь освободиться от страстей, например, страстных желаний, жадности или честолюбия, то ты никогда не достигнешь Истинной Смерти, потому что жизнь всегда будет удерживать кусочек тебя».~
@14618 = ~«Могу я спросить тебя о других Пыльных?»~
@14619 = ~«Ясно. У меня другие вопросы…»~
@14620 = ~«Я должен идти. Прощай».~
@14621 = ~«Кто такая?»~
@14622 = ~«Странная молодая женщина… с плохим зрением, почти глухая, когти на руках?»~
@14623 = ~«Неважно. Могу я спросить тебя о других Пыльных?»~
@14624 = ~«Не имеет значения. У меня другие вопросы…»~
@14625 = ~«Забудь. Мне пора. Пока».~
@14626 = ~Сере качает головой: «Может, она из новеньких. Никогда о ней не слышала».~
@14627 = ~«Ну и ладно. Могу я спросить тебя о других Пыльных?»~
@14628 = ~«Неважно. У меня другие вопросы…»~
@14629 = ~«Я должен идти. Прощай».~
@14630 = ~«Я очень мало о нём знаю. Он странный… никогда не покидает это место, не ест, не пьёт, только ждёт, — она слегка вздрагивает. — Меня это тревожит».~
@14631 = ~«Могу я спросить тебя о других Пыльных?»~
@14632 = ~«Ясно. У меня другие вопросы…»~
@14633 = ~«Это всё, что я хотел узнать. Прощай».~
@14634 = ~«Так и должно быть. Нет в смерти ничего утешительного».~
@14635 = ~«Ну, мой случай вообще особенный… я очнулся в Мортуарии. Думаю, меня по ошибке приняли за труп, и готовились хоронить. Что самое странное, думаю, я и правда умер… а потом выздоровел».~
@14636 = ~«Ну, мои отношения со смертью гораздо ближе чем у других людей. Похоже, я не могу умереть… по крайней мере, сколько себя помню».~
@14637 = ~«Я тоже так думаю. У меня другие вопросы…»~
@14638 = ~«Я должен идти. Прощай».~
@14639 = ~«Ба, очень жаль, парень, — Сере хмыкает. — Если близкой улыбки смерти недостаточно, чтобы у тебя появилось желание остаться в живых, то вряд ли все силы планов смогут вбить в твою голову хоть немного ума».~
@14640 = ~«Ну, мой случай вообще особенный… я очнулся в Мортуарии. Думаю, меня по ошибке приняли за труп, и готовились хоронить. Что самое странное, думаю, я и правда умер… а потом выздоровел».~
@14641 = ~«Ну, мои отношения со смертью гораздо ближе чем у других людей. Похоже, я не могу умереть… по крайней мере, сколько себя помню. Это просто меня убивает».~
@14642 = ~«Это твоё мнение. У меня другие вопросы…»~
@14643 = ~«Я должен идти. Прощай».~
@14644 = ~«Ха, ну а я избавлю тебя от представлений, — Сере фыркает. — Это пёстрая компания. Если хочешь узнать поподробней о ком-то из них, сначала узнай его имя, а потом приходи ко мне».~
@14645 = ~«Хорошо. У меня другие вопросы…»~
@14646 = ~«Думаю, мне стоит поговорить с кем-то из них. Пока».~
@14647 = ~Сере пожимает плечами: «Полагаю, одежды Пыльных подходят мне куда меньше, чем я привыкла считать».~
@14648 = ~«Что случилось?»~
@14649 = ~«Что вызвало такой кризис веры?»~
@14650 = ~«Что вызвало такой кризис веры?»~
@14651 = ~«У меня пара вопросов…»~
@14652 = ~«Я должен идти. Прощай».~
@14653 = ~Сере хмурится при виде тебя: «Лучше ползи в свой склеп обратно, парень. У меня в этой жизни осталось не так много времени, чтобы трепаться с тобой».~
@14654 = ~«Да, да. Он узнал?»~
@14655 = ~«Да, конечно, ты абсолютно прав». Изверг поворачивается к тебе: «Что ты знаешь об этом Сборщике, старинный друг?»~
@14656 = ~«Я бы сказал тебе, друг, но, увы, я поклялся никому не говорить!»~
@14657 = ~«А ты не клялся, Тегар'ин?»~
@14658 = ~«Восхитительно!»~
@14659 = ~Другой изверг вмешивается, пока Тегар'ин не заговорил: «Кулон! Не забывай!»~
@14660 = ~«…может быть, ты согласишься заключить с нами сделку? Как в старые добрые времена…»~
@14661 = ~«Мы расскажем тебе всё, что знаем о „Сборщике“…»~
@14662 = ~«…его слабости, как его победить, тем самым получив этот кулон, который мы можем использовать, чтобы сделать тебя гораздо сильнее. Взамен…»~
@14663 = ~«Да, кулон. Он сделан в форме человеческого черепа с шестью сияющими кристаллами в короне».~
@14664 = ~«Нам запрещено приближаться к „Сборщику“, беспокоить или вредить ему».~
@14665 = ~«Тебе — ничего».~
@14666 = ~«Никаких других сил у него нет; по сути, это полностью пассивная вещь».~
@14667 = ~«Но конечно, ты можешь посмотреть, как такие вещи используем мы».~
@14668 = ~«Очень, очень плохо».~
@14669 = ~«Прекрасно».~
@14670 = ~«Понимаешь, она была проклята и приняла ту форму, в которой ты её видишь. Большая часть её силы ушла, изгнанная святой силой священника».~
@14671 = ~«Верно, им бы больше порхать да ворковать».~
@14672 = ~«Просто сними кулон с её тела и верни его нам, друг. Мы используем души, которые она успела захватить, чтобы дать тебе силу, а опустевшую вещь оставим себе».~
@14673 = ~«Прекрасно! Возвращайся сюда, когда дело будет сделано».~
@14674 = ~«Какая жестокость!»~
@14675 = ~«Да, *гораздо* сильнее!»~
@14676 = ~«Тегар'ин! Что случилось?»~
@14677 = ~«А может, убьём его сейчас, утащим в Баатор?»~
@14678 = ~«Ха! Слышишь, как он захныкал, Тегар'ин?»~
@14679 = ~«Как прекрасно!» — Этельгрин выхватывает у тебя кулон Йемета и бросает его Тегар'ину.~
@14680 = ~Этельгрин отводит взгляд, словно его вдруг заинтересовало что-то на столе рядом.~
@14681 = ~«М-м? О нет, не знал».~
@14682 = ~«Боюсь, невозможно. Он наш и слишком дорог нам, чтобы потерять его. Пожалуйста, возвращайся, когда освободишься от магии, мешающей нам помочь тебе».~
@14683 = ~«Что? Нет! Ты не можешь!»~
@14684 = ~«Убьём его?»~
@14685 = ~«Возмутительный негодяй! Вон!»~
@14686 = ~«Смотри, он вернулся с кулоном!»~
@14687 = ~«Смотри, кто вернулся. Прости, друг, но нам не о чём с тобой говорить, пока ты не вернёшься с нашим кулоном. Пока».~
@14688 = ~«Посмотри-ка, кто это, Тегар'ин…»~
@14689 = ~«Она будет прятаться в аллее к северу от этого заведения, между двумя зданиями. Ищи её там поздно вечером».~
@14690 = ~«Он говорит о Волоките, да?»~
@14691 = ~«Он спрашивает о нём… наш друг расспрашивает нас, неужели он не знал? Или не подозревал, по крайней мере?»~
@14692 = ~«И ты удивляешься, Этельгрин, почему у тебя до сих пор нет прозвища? — изверг поворачивается к тебе: — Я буду рад просветить тебя».~
@14693 = ~«Я поклялся, но не так, как ты! Я не могу говорить на эту тему ни с одним танар'ри. Но, мне кажется, нашего друга к ним никак не отнесёшь».~
@14694 = ~«А то! — изверг снова обращается к тебе: — Этот сборщик, друг мой, — дьявол, проклятый святым человеком. Красивый молодой джентльмен, которого ты мог видеть рядом с ним, находится в рабстве у Сборщика, хотя и сам этого не осознаёт».~
@14695 = ~«Как можно, Этельгрин? Разумеется, нет».~
@14696 = ~«У изверга есть кулон, магический артефакт, и нам очень хотелось бы обладать им. Гарантирую, для тебя он не имеет почти никакой ценности, друг, так что, может…»~
@14697 = ~«…*всё*…»~
@14698 = ~«…мы просим только кулон. Именно он позволит нам дать тебе обещанную силу».~
@14699 = ~«Увы, даже я не могу нарушать правила. В таких вопросах наши руки связаны, друг».~
@14700 = ~«Вообще ничего, друг».~
@14701 = ~«Он улавливает души, когда они покидают свои оболочки».~
@14702 = ~«Зачем тебе такая вещь? Продашь её за жалкие медяки? Или прибьёшь над камином?»~
@14703 = ~«Да, Этельгрин, очень жаль. Мы останемся здесь, старый друг, на случай если ты поумнеешь и передумаешь».~
@14704 = ~«„Сборщик“ был эринией. Она перешла границы дозволеного, в своих амбициях она пыталась соблазнить того, кто выше подобного».~
@14705 = ~«Так вот, эринии — плохие бойцы, ты увидишь».~
@14706 = ~Изверг поворачивается к своему компаньону: «Да, точно». Затем шипит в твою сторону: «Как я сказал, без магической верёвки, которая есть у всех Сестёр, и обычной защиты извергов, убить её очень легко. Если рядом не будет её молодого повесы, конечно».~
@14707 = ~«А, я как раз собирался это сказать, старый друг. Ты можешь найти её прячущуюся, одинокую, в аллее к северу от этого заведения, между двумя зданиями. Ищи её там незадолго до антипика».~
@14708 = ~«О, но сделка уже заключена, друг. Ты же согласился, помнишь? Мы выполнили свою часть сделки; не будешь же ты таким бесчувственным, чтобы забыть нашу старую дружбу и кинуть нас?»~
@14709 = ~«Безусловно, Этельгрин». Изверг поворачивается к тебе, похоже, он очень обеспокоен: «Разве ты забыл об обещанной силе? Талисман в наших руках может сделать тебя сильнее, друг…»~
@14710 = ~«Ты уверен, что хочешь так запросто отмахнуться от нас?»~
@14711 = ~«Я был дураком, Этельгрин. Я составил договор, но сделал большую ошибку, понадеявшись на нашу дружбу в сделке». Он поворачивается к тебе, презрительно ухмыляясь: «Проклинаю тебя, жалкий человечишка… ты пожалеешь об этом. Знай, что с этого дня Тегар'ин Трижды Проклятый будет добиваться не просто твоей погибели, но и твоей души. Когда добьюсь, ты станешь пушечным мясом в Кровавой Войне, рабом на побегушках у низших из извергов!»~
@14712 = ~«Нет, не сейчас. Пусть идёт своей дорогой. У нас впереди целая вечность для интриг против него…» — изверги злобно улыбаются друг другу и отмахиваются от тебя.~
@14713 = ~«Молчи, Этельгрин! Все мы совершаем ошибки, — Тегар'ин поворачивается к тебе, глядя насмешливо и презрительно. — Ты знаешь, что нам от тебя нужно. Большинство ран время лечит… возможно, если ты выполнишь свою часть сделки, наша дружба будет такой же, как прежде. До встречи».~
@14714 = ~«Мы используем силу, которую он содержит, чтобы укрепить тебя… она сделает тебя физически сильнее и крепче. Эффект будет постоянным… конечно, пока ты не умрёшь. Но не будем о грустном, старый друг».~
@14715 = ~«Подожди… сначала нам нужен кулон».~
@14716 = ~«Да, Этельгрин, прекрасно. А теперь, чтобы дать тебе силу кулона, старый друг…» Изверг зажимает кулон в своих когтях, и его глаза загораются огненно-красным светом. Сияние силы на мгновение окружает кулон, затем всё прекращается.~
@14717 = ~«Я… я не знаю, старый друг! — Тегар'ин выглядит неподдельно удивлённым, но Этельгрин рядом с ним зло улыбается. — Похоже… похоже, над тобой поработала какая-то странная магия, которая не даёт тебе воспринять силу кулона».~
@14718 = ~«Нет, мой старый друг! Я безусловно ничего не знал. Этельгрин?» — изверг бросает кулон обратно своему компаньону.~
@14719 = ~«Мне правда очень жаль, дорогой друг. Возможно, если ты избавишься от этой магии, мы сможем использовать этот кулон для твоей пользы. Ты знаешь, где нас найти, если что», — изверг улыбается тебе.~
@14720 = ~Тегар'ин грустно качает головой.~
@14721 = ~«Теперь он по праву наш. Помни о сделке, старинный друг».~
@14722 = ~«О, как печально… неужели ты действительно отбросишь старую дружбу так бездумно? Пожалуйста, я прошу тебя… не предавай древнее братство. Верни кулон».~
@14723 = ~«Да, давай».~
@14724 = ~«Ладно… — два изверга улыбаются друг другу, затем кивают. — В таком случае…»~
@14725 = ~«Смотри, он вернулся с кулоном!»~
@14726 = ~«А, смотри, кто вернулся. Прости, друг, но нам не о чём с тобой говорить, пока ты не вернёшься с нашим кулоном. Пока».~
@14727 = ~«Так-так… предатель друзей!»~
@14728 = ~После твоих слов наступает долгое, неловкое молчание, изверги холодно смотрят на тебя. Наконец Тегар'ин говорит: «Ладно. Очень жаль… друг».~
@14729 = ~«Ещё раз, где прячется этот Сборщик?»~
@14730 = ~«Какую „силу“ даст мне этот кулон?»~
@14731 = ~«У меня не получилось отобрать кулон у эринии, и она удрала».~
@14732 = ~Ложь: «Я не смог найти эринию; её не было в аллее, о которой вы мне говорили».~
@14733 = ~«Вот кулон».~
@14734 = ~«Ещё раз, где прячется этот Сборщик?»~
@14735 = ~«Какую „силу“ даст мне этот кулон?»~
@14736 = ~«У меня не получилось отобрать кулон у эринии, и она удрала».~
@14737 = ~Ложь: «Я не смог найти эринию; её не было в аллее, о которой вы мне говорили».~
@14738 = ~«Вот кулон».~
@14739 = ~«Нет. Прощай».~
@14740 = ~«Ничего. Я надеялся, что вы сможете просветить меня».~
@14741 = ~«Почти ничего, только у него странные привычки, и ему явно приходилось общаться с демонами».~
@14742 = ~«Очень мало. Ладно, расспрошу вас о нём в другой раз. Пока».~
@14743 = ~«Нет. Никаких сделок».~
@14744 = ~«Что ты имеешь в виду?»~
@14745 = ~«Почему бы вам не забрать его самим?»~
@14746 = ~«Что даёт этот кулон?»~
@14747 = ~«Согласен».~
@14748 = ~«Нет. Никаких сделок».~
@14749 = ~«Почему бы вам не забрать его самим?»~
@14750 = ~«Согласен».~
@14751 = ~«Нет. Никаких сделок».~
@14752 = ~«Интересно…»~
@14753 = ~«Понимаю».~
@14754 = ~«Я отказываюсь. Сделки не будет».~
@14755 = ~«Прежде чем уйду, я хочу задать пару вопросов…»~
@14756 = ~«Тогда прощай».~
@14757 = ~Напасть на демонов.~
@14758 = ~«Хм-м. Пока».~
@14759 = ~«Подождите… Кулон у меня».~
@14760 = ~Уйти.~
@14761 = ~«Подождите, какую силу он мне даст?»~
@14762 = ~«Вот, держи».~
@14763 = ~«Я решил оставить кулон себе».~
@14764 = ~Уйти.~
@14765 = ~«У меня другие вопросы…»~
@14766 = ~«Это всё, что я хотел узнать. Прощай».~
@14767 = ~«Продолжай…»~
@14768 = ~«Что за кулон?»~
@14769 = ~«Послушаю это в другой раз. Пока».~
@14770 = ~«Что даёт этот кулон?»~
@14771 = ~«Согласен».~
@14772 = ~«Нет. Никаких сделок».~
@14773 = ~«Рассказывайте, или сделки не будет».~
@14774 = ~«Почему бы вам не забрать его самим?»~
@14775 = ~«Согласен».~
@14776 = ~«Нет. Никаких сделок».~
@14777 = ~«У меня другие вопросы…»~
@14778 = ~«Прощай».~
@14779 = ~«Как я могу застать её одну?»~
@14780 = ~«Нет, ты прав».~
@14781 = ~«Буду».~
@14782 = ~«Нет, ты прав».~
@14783 = ~«Да, так запросто и отмахнусь».~
@14784 = ~«Стоп! Стоп! Я передумал!»~
@14785 = ~Уйти.~
@14786 = ~Уйти.~
@14787 = ~«Вот кулон».~
@14788 = ~«У меня другие вопросы…»~
@14789 = ~«У меня другие вопросы…»~
@14790 = ~«Это всё, что я хотел узнать. Прощай».~
@14791 = ~«Это всё, что я хотел узнать. Прощай».~
@14792 = ~«Вот, держи».~
@14793 = ~«Я решил оставить кулон себе».~
@14794 = ~«Что случилось?»~
@14795 = ~«Что?! Ты знал об этом заранее?»~
@14796 = ~«Тогда давай кулон обратно. Я верну его, когда эта магия исчезнет».~
@14797 = ~Напасть на демонов.~
@14798 = ~«Хм-м. Пока».~
@14799 = ~«Ладно. Держи».~
@14800 = ~«Нет, думаю, я пока придержу его».~
@14801 = ~«Ладно. Вот он».~
@14802 = ~«Нет. И не надейся».~
@14803 = ~Принять бой.~
@14804 = ~Бежать с кулоном.~
@14805 = ~«Подождите, какую силу он мне даст?»~
@14806 = ~«Вот он».~
@14807 = ~«Я решил оставить кулон себе».~
@14808 = ~«Подождите, какую силу он мне даст?»~
@14809 = ~«Вот, держи».~
@14810 = ~«Я решил оставить кулон себе».~
@14811 = ~Уйти.~
@14812 = ~«У меня другие вопросы…»~
@14813 = ~«Вот и всё. Прощай».~
@14814 = ~«Я согласен на сделку, о которой мы говорили раньше».~
@14815 = ~«Неважно. Прощай».~
@14816 = ~«Я согласен на сделку, о которой мы говорили раньше».~
@14817 = ~«Прошу прощения… я оговорился. Прощай».~
@14818 = ~«Маленькие ублюдки! Вы не спрячетесь от Крысёныша!»~
@14819 = ~«Ар-р! Где вы?»~
@14820 = ~«Ещё одна пустая ловушка…»~
@14821 = ~«Хм-м… — *вздох* — Тьфу. Опять ничего!»~
@14822 = ~«Проклятые крысы! Чтоб вы все попали в Баатор!»~
@14823 = ~Не останавливаться, игнорировать Эморика.~
@14824 = ~«Ты от нас отрёкся, — Эморик замолкает; звучит так, будто он произносит приговор. — Больше ты не Пыльный».~
@14825 = ~«Догадываюсь. Но есть ещё кое-что, что я хотел бы узнать…»~
@14826 = ~«Прости, что потревожил. Прощай».~
@14827 = ~«Ты выглядишь потерявшимся, — голос мужчины грохочет, как оседающие камни. — Ветром занесло, или с какой-то целью здесь?»~
@14828 = ~«Кто ты?»~
@14829 = ~«Я только гость. Пока».~
@14830 = ~«Я — Эморик, Фактотум и Посвящённый Четвёртого Круга».~
@14831 = ~«Это твой бар?»~
@14832 = ~«Замечательно. Это всё, что я хотел узнать. Пока».~
@14833 = ~«Если ты исчисляешь владение в деньгах, то это не моё заведение. Если ты имеешь в виду духовное руководство, то оно моё, — он выдерживает паузу, чтобы придать больше веса своим словам. — Пыльные здесь — мои ученики. Они под моей защитой».~
@14834 = ~«Могу я задать кое-какие вопросы?..»~
@14835 = ~«Я должен идти. Прощай».~
@14836 = ~Эморик ждёт.~
@14837 = ~«Это твой бар?»~
@14838 = ~«Можешь рассказать мне о фракции Пыльных?»~
@14839 = ~«Можешь рассказать мне о фракции Пыльных?»~
@14840 = ~«Я хотел бы вступить во фракцию Пыльных».~
@14841 = ~«Я хотел бы вступить во фракцию Пыльных».~
@14842 = ~«Я хотел бы вступить во фракцию Пыльных».~
@14843 = ~«Я хотел бы вступить во фракцию Пыльных».~
@14844 = ~Проникнуть к Пыльным, чтобы шпионить для Анархистов: «Я хотел бы вступить во фракцию Пыльных».~
@14845 = ~«Можешь рассказать мне о Посмертных Договорах?»~
@14846 = ~«Я пришёл сюда в поисках дневника».~
@14847 = ~«Я ищу мужчину по имени Фарод. Ты его не видел?»~
@14848 = ~«Я говорил с Фародом и узнал, где он достаёт для вас тела».~
@14849 = ~«Я по поводу поиска Фарода и выяснения его источника тел… эта работа ещё не занята?»~
@14850 = ~«Я поговорил с Норочи и сделал, как он просил».~
@14851 = ~«Я поговорил с Ожидающим-Смерть».~
@14852 = ~«Я поговорил с Сере».~
@14853 = ~~
@14854 = ~«Я нашёл Соэго».~
@14855 = ~«Я нашёл Соэго».~
@14856 = ~«Как Пыльный, я прошу твоей помощи».~
@14857 = ~«Как Пыльный, я хочу задать кое-какие вопросы о нашей фракции…»~
@14858 = ~«Я должен идти. Прощай».~
@14859 = ~«Я бы хотел знать, зачем ты ищешь Сборщика Фарода».~
@14860 = ~«Сборщика?»~
@14861 = ~«Он кое-что у меня украл».~
@14862 = ~«Мне надо с ним поговорить».~
@14863 = ~«К чему вопрос? Что-то не так?»~
@14864 = ~«Вообще-то я оговорился. У меня другие вопросы…»~
@14865 = ~«Неважно. Прощай».~
@14866 = ~«Сборщики собирают трупы и приносят их нам. Я бы хотел знать, зачем ты ищешь этого Сборщика».~
@14867 = ~«Зачем Сборщики собирают трупы?»~
@14868 = ~«Он кое-что у меня украл».~
@14869 = ~«Мне надо с ним поговорить».~
@14870 = ~«К чему вопрос? Что-то не так?»~
@14871 = ~«Вообще-то я оговорился. У меня другие вопросы…»~
@14872 = ~«Неважно. Прощай».~
@14873 = ~«Они приносят их к нам ради денег».~
@14874 = ~«Вы платите им за трупы? Зачем?»~
@14875 = ~«Он кое-что у меня украл».~
@14876 = ~«Мне надо с ним поговорить».~
@14877 = ~«К чему вопрос? Что-то не так?»~
@14878 = ~«Вообще-то я оговорился. У меня другие вопросы…»~
@14879 = ~«Это всё, что я хотел узнать. Прощай».~
@14880 = ~«Улицы — не кладбище. Место для захоронения трупов — Мортуарий. Это долг Пыльных», — Эморик на секунду замолкает. Ты чувствуешь, что он пытается подобраться к сути: «Мне надо знать, зачем ты ищешь Сборщика Фарода».~
@14881 = ~«Мне надо с ним поговорить».~
@14882 = ~«К чему вопрос? Что-то не так?»~
@14883 = ~«Вообще-то я оговорился. У меня другие вопросы…»~
@14884 = ~«Неважно. Прощай».~
@14885 = ~«Сборщик Фарод за последнее время доставил в Мортуарий много тел. Необходимо спросить его, где он их взял».~
@14886 = ~«Я узнал, откуда они».~
@14887 = ~«Расскажи мне больше о телах».~
@14888 = ~«Слушай, ваши дела — это ваши дела. Мне нужно только узнать, где он».~
@14889 = ~«Возможно, я сумею узнать, откуда берутся эти тела».~
@14890 = ~«Даже и не знаю. Слушай, у меня другие вопросы…»~
@14891 = ~«Не думаю, что смогу тебе помочь. До встречи».~
@14892 = ~«Некоторые свежие. У них даже последнее мгновение видно в глазах. Другие же умерли столетия назад. На их костях лежит пыль веков. Кому-нибудь необходимо узнать, откуда эти тела».~
@14893 = ~«Я узнал, откуда они».~
@14894 = ~«Слушай, ваши дела — это ваши дела. Мне нужно только узнать, где он».~
@14895 = ~«Возможно, я сумею узнать, откуда берутся эти тела».~
@14896 = ~«Даже и не знаю. Слушай, у меня другие вопросы…»~
@14897 = ~«Не думаю, что смогу тебе помочь. До встречи».~
@14898 = ~Эморик сохраняет тишину. Его взгляд нервирует… похоже, он не моргает.~
@14899 = ~«Зачем тебе надо знать о моих делах с Фародом?»~
@14900 = ~«У меня другие вопросы…»~
@14901 = ~«Я должен идти. Прощай».~
@14902 = ~«Как и мне. Но это весьма непросто осуществить. Он говорит только через других, — Эморик делает секундную паузу. — Когда двое говорят через кого-то, мало говорится, и многое теряется».~
@14903 = ~«Зачем тебе говорить с Фародом?»~
@14904 = ~«Почему Фарод так поступает?»~
@14905 = ~«Не знаешь, где мне его найти?»~
@14906 = ~«У меня другие вопросы…»~
@14907 = ~«Я должен идти. Прощай».~
@14908 = ~«Неизвестно. Он человек, который прячется от других и не выдаёт своих мотивов».~
@14909 = ~«Зачем тебе надо знать о моих делах с Фародом?»~
@14910 = ~«У меня другие вопросы…»~
@14911 = ~«Я должен идти. Прощай».~
@14912 = ~«Как ты намерен это сделать?»~
@14913 = ~«Я найду Фарода и спрошу его».~
@14914 = ~«Даже и не знаю. Слушай, у меня другие вопросы…»~
@14915 = ~«Не думаю, что смогу помочь тебе. До встречи».~
@14916 = ~«Если поговоришь со Сборщиком Фародом и вернёшься с ответами — ты окажешь Пыльным большую услугу. Узнай, где он находит тела для нас, и будешь вознаграждён».~
@14917 = ~«Хорошо. Я найду Фарода, поговорю с ним и узнаю, откуда он берёт тела, которые доставляет вам».~
@14918 = ~«Нет, спасибо. Такая работа не для меня».~
@14919 = ~Эморик кивает: «Твой путь — это твой путь. Возвращайся с ответами Сборщика Фарода».~
@14920 = ~«Можешь сказать мне, где он?»~
@14921 = ~«Хорошо. У меня другие вопросы…»~
@14922 = ~«Я посмотрю, что можно сделать. До встречи».~
@14923 = ~Эморик кивает: «Твой путь в твоей власти».~
@14924 = ~«Можешь сказать мне, где он?»~
@14925 = ~«У меня другие вопросы…»~
@14926 = ~«Я должен идти. Прощай».~
@14927 = ~«Мне неизвестно, где находится Сборщик Фарод. Он скрывается от глаз Пыльных. Я бы поискал других Сборщиков и задал твои вопросы им».~
@14928 = ~«Хорошо. У меня другие вопросы…»~
@14929 = ~«Я посмотрю, что можно сделать. До встречи».~
@14930 = ~«Откуда он доставляет к нам тела?»~
@14931 = ~Правда: «Из катакомб под Сигилом. Он берёт тела, которые вы похоронили, и продаёт их вам обратно. А когда вы их снова хороните, он их снова откапывает».~
@14932 = ~Правда: «Из катакомб под Сигилом. Он берёт тела, которые вы похоронили, и продаёт их вам обратно. А когда вы их снова хороните, он их снова откапывает».~
@14933 = ~Ложь: «Очень многие люди на Площади Мусорщиков поражены опустошающей болезнью, которая заставляет их тела разлагаться преждевременно. Эти тела только *кажутся* такими старыми».~
@14934 = ~«Прости, я оговорился. Я пока не нашёл ответа. У меня есть ещё вопросы…»~
@14935 = ~«Вообще-то, я продолжаю поиски. До встречи».~
@14936 = ~Эморик держит паузу. Он смотрит на тебя своим неподвижным взглядом, и тебе кажется, будто его глаза проникают прямо в твой череп.~
@14937 = ~«Э-э…»~
@14938 = ~Эморик кивает: «Ты оказал большую услугу Пыльным». Он вынимает руки из рукавов, затем его длинные рукава закрывают поверхность стола, как покрывало. Когда он их убирает, на столе стоит маленький гробик из лазурита. Это крошечная вещь около двух дюймов в ширину и трёх в длину. На крышке выгравирован символ Пыльных.~
@14939 = ~Взять ящичек.~
@14940 = ~Когда ты берёшь гробик, он щёлкает, открывается и распадается струёй медных монет, которая устилает пол бара. Как такое большое количество монет могло уместиться в таком маленьком гробике, ты не понимаешь.~
@14941 = ~«Спасибо. У меня другие вопросы…»~
@14942 = ~«Я должен идти. Прощай».~
@14943 = ~«Эти глаза не видели дневника. Быть может, тебе стоит продолжить поиски в другом месте».~
@14944 = ~«Хорошо. У меня другие вопросы…»~
@14945 = ~«Ладно, поищу где-нибудь ещё. Пока».~
@14946 = ~«Пыльные стремятся к Истинной Смерти. Некоторые зовут её „забвением“, но это неправильно. Для Пыльных Истинная Смерть — освобождение от цепей этой лживой жизни».~
@14947 = ~«Лживой жизни?»~
@14948 = ~«У меня другие вопросы…»~
@14949 = ~«Точно, как я мог забыть. Пока».~
@14950 = ~«Эта „жизнь“, за которую многие цепляются своими чувствами и страстями, есть лживое существование. Пока цепляешься за неё, ты будешь снова и снова перерождаться. Чтобы вырваться из этого круга, надо освободиться от страстей».~
@14951 = ~«Ясно. Можешь рассказать мне, как организована ваша фракция?»~
@14952 = ~«Ясно. Можешь рассказать мне, как организована ваша фракция?»~
@14953 = ~«У меня другие вопросы…»~
@14954 = ~«Точно, как я мог забыть. Пока».~
@14955 = ~«Пыльные организованы в пять кругов. Пятый Круг — низший ранг среди Пыльных, Посвящённые. Первый Круг составлен из Пыльных высочайшего ранга, которые управляют нашей фракцией».~
@14956 = ~«У меня другие вопросы…»~
@14957 = ~«Точно, как я мог забыть. Пока».~
@14958 = ~«Ты хочешь подписать Посмертный Договор?»~
@14959 = ~«Что это такое?»~
@14960 = ~«Да, я подпишу».~
@14961 = ~«Нет, я хочу задать ещё несколько вопросов…»~
@14962 = ~«Может, в другой раз. Пока».~
@14963 = ~«В обмен на пятьдесят медных монет, Посмертный Договор даёт фракции Пыльных все права на твоё тело после смерти. Хочешь подписать Посмертный Договор?»~
@14964 = ~«Я подпишу».~
@14965 = ~Несмотря на заключённый с Мортаи договор: «Я подпишу».~
@14966 = ~Несмотря на заключённый с Медноглазым договор: «Я подпишу».~
@14967 = ~Несмотря на заключённые с Мортаи и Медноглазым договоры: «Я подпишу».~
@14968 = ~«Нет, я хочу задать ещё несколько вопросов…»~
@14969 = ~«Может, в другой раз. Пока».~
@14970 = ~Эморик извлекает из складок одежды пыльный кусок пергамента и перо. Он указывает тебе три места, в которых надо подписать пергамент.~
@14971 = ~Подписать в указанных местах.~
@14972 = ~Подписать в указанных местах.~
@14973 = ~«Я передумал. У меня есть ещё несколько вопросов…»~
@14974 = ~«Может, в другой раз. Пока».~
@14975 = ~Ты берёшь перо и начинаешь выводить на пергаменте свои каракули… перо издаёт странный *скрежет*, как резец по камню.~
@14976 = ~Продолжать подписывать…~
@14977 = ~Однако как ты ни пытаешься расписаться, ничего не выходит, словно перо засорилось… не имеет значения, насколько старательно ты им водишь, вывести своё имя не получается. Чернила не хотят покидать перо.~
@14978 = ~«Ох… Эморик, что с этим договором?»~
@14979 = ~Когда ты поднимаешь взгляд, обращаясь к Эморику, ты видишь, как его лицо каменеет… он словно превращается в статую. Остальная часть бара затянута каким-то серым туманом, скрывающим остальных, находящихся в баре. Слабый шёпот вырывается из уст Эморика, как будто в его груди пытаются дышать каменные лёгкие.~
@14980 = ~Мужчина перед тобой *стар*. Его сухую, жёлтую кожу покрывают шрамы всюду побывававшего и нигде надолго не задерживавшегося путешественника. Его исхудалое лицо нечеловечески угловато, острые к кончикам уши отогнуты от черепа. Одет он в просторную оранжевую тунику, странное блестящее лезвие висит на ремне за спиной. Лезвие выглядит как двухзубое копьё, металл которого переливается разводами, как плёнка масла на поверхности пруда.~
@14981 = ~«Эморик?..»~
@14982 = ~Мужчина поворачивается к тебе, его глаза похожи на полированные угольки. Он смотрит сквозь тебя, и на мгновение тебе кажется, что он слеп. Оружие внезапно становится мертвенно-чёрным, повторяя цвет его глаз.~
@14983 = ~Ты едва можешь разобрать шёпот, исходящий из каменных губ Эморика, когда начинаешь понимать, что шепчет не один голос, а несколько…

  *Подпиши*

  *Но знай, что цена заключена в душе и камне*

  *И что может изменить природу человека?*

Эти слова сливаются в рваный, мёртвый хор, их произносят пять, десять, двадцать, сто голосов — старые, юные, женские, мужские, отчаявшиеся, спокойные, истеричные…~
@14984 = ~Минуту он ничего не говорит, вглядываясь в твоё лицо. «Приветствую… странник», — голос его тихий и печальный, как дуновение ветра в кроне могучего дерева.~ [DAK001B]
@14985 = ~Мужчина встречает твой взгляд, его глаза утыкаются в твои. Оружие теряет свой чёрный цвет, возвращаясь к тому странному блеску, который ты видел перед вашим разговором. «Твои глаза выдают того, кто странствовал далеко, чтобы попасть сюда».~ [DAK001C]
@14986 = ~«Стой», — голос мужчины тихий и печальный, как дуновение ветра в кроне могучего дерева. Почему-то этот голос действует на тебя успокаивающе. Когда ты оборачиваешься, то видишь, что он вглядывается в твои черты. «Твои глаза выдают того, кто странствовал далеко, чтобы попасть сюда».~
@14987 = ~«Ты не побеспокоил меня. Мои мысли неизменны», — взгляд мужчины неподвижен, и ты чувствуешь, что сложно отвести глаза, пока его внимание приковано к тебе. «Я *известен* как Дак'кон», — ударение, которое он делает на слове *известен*, кажется тебе странным… и в то же время знакомым. «Ты… *неизвестен* мне».~
@14988 = ~«Природу человека?..»~
@14989 = ~Мужчина не сводит с тебя взгляда. «Я *известен* как Дак'кон, — ударение, которое он делает на слове *известен*, кажется тебе странным… и в то же время знакомым. — Ты… *неизвестен* мне».~
@14990 = ~«Это к лучшему. Кроме *знания* самого себя, мало что на планах стоит *знать*, — он некоторое время выдерживает паузу, изучая тебя своими угольно-чёрными глазами. — Я хочу *знать*, зачем ты пришёл в этот город».~
@14991 = ~Дак'кон некоторое время выдерживает паузу, изучая тебя своими угольно-чёрными глазами. «Планы насчитывают множество реальностей, но всё же ты здесь. Я хочу *знать*, зачем ты пришёл в этот город».~
@14992 = ~Как только ты произносишь эти слова, наваливается внезапная слабость и следующее, что ты слышишь, — нормальный голос Эморика: «Ты всё ещё хочешь подписать?»~
@14993 = ~«В этом вопросе мы под одинаковыми небесами, — Дак'кон некоторое время выдерживает паузу, изучая тебя своими угольно-чёрными глазами. — Планы насчитывают множество реальностей, но всё же ты здесь. Я хочу *знать*, зачем ты пришёл в этот город».~
@14994 = ~Попытаться прийти в себя…~
@14995 = ~«Задавай свои вопросы. Я выслушаю тебя».~
@14996 = ~Время как будто перевело дух и восстановило своё течение… туман рассеялся, а Эморик больше не похож на статую. Ты чувствуешь странное давление в черепе, как будто что-то отчаянно пытается вырваться наружу, но не может. К тебе словно возвращается множество осколков воспоминаний, все они вонзаются друг в друга, образуя единую картину… ты откуда-то знаешь, что каждый шёпот из каменных губ Эморика принадлежал *кому-то*… давно умершему.~
@14997 = ~«Гитцерай».~
@14998 = ~«Гитцерай — один из Народа».~
@14999 = ~«Гитцерай».~
@15000 = ~Секунду Дак'кон молчит, потом произносит: «Наша история и не должна быть *известна* тебе. Мы до смерти истечём кровью от клинка времени, прежде чем я изложу хотя бы крупицу истории Народа».~
@15001 = ~Снова посмотреть на пергамент.~
@15002 = ~Дак'кон на мгновение замолкает. «*Знай* это и прими как ответ: мы — Народ, который сделал своим домом меняющийся план Лимбо», — ловким движением Дак'кон выхватывает из-за спины клинок и выставляет перед собой.~
@15003 = ~При взгляде на пыльный пергамент на столе, ты понимаешь, что не первый раз выводишь своё имя на договоре… а может быть, не первый раз подписываешь именно такой договор.~
@15004 = ~«Вот, мы придаём форму материи Лимбо силой наших разумов. Мы создаём города своими мыслями». Ты видишь, как от центра лезвия по металлу разбегаются волны. Высота волн и движение их гребней соответствуют изменениям интонации Дак'кона. «В хаосе, где мы обитаем, только наше *знание* хранит нас. Мы — гитцерай».~
@15005 = ~«Его *знают* под именем „Сигил“. Среди Народа его *знают* как город, который не *знает* сам себя».~
@15006 = ~«Город существует, но не *знает* себя. В его *незнании* — изъян его существования».~
@15007 = ~«Он может не иметь сознания и *знания* себя в том смысле, как *знаем* себя ты или я, но он живёт. Растёт, меняется и затрагивает разум всех, кто живёт здесь».~
@15008 = ~«Город существует, сопротивляясь сам себе. Он разместился в стороне от планов, но пытается быть везде одновременно. Его стены — двери, но эти двери заперты. Такое существование говорит о нём как о создании, не *знающем* себя. В *незнании* себя — его изъян».~
@15009 = ~Закончить подписывать договор.~
@15010 = ~«Отвечаю на твой вопрос вопросом: что, если город имеет изъян и ты видишь все его противоречия вокруг себя?»~
@15011 = ~Всё равно подписать договор Эморика, несмотря на уже подписанный договор с Мортаи.~
@15012 = ~Дак'кон замолкает. «Нет *знания* в ответах на вопросы, которые мы задали. Город всё ещё существует. Это всё».~
@15013 = ~Всё равно подписать договор Эморика, несмотря на уже подписанный договор с Медноглазым.~
@15014 = ~«Тогда мы прекратим попытки *узнать* себя, — голос Дак'кона немного меняется, становится сильнее. — Такие слова были сказаны ранее. Я слышал их и *знаю* их».~
@15015 = ~Всё равно подписать договор Эморика, несмотря на уже подписанные договоры с Мортаи и Медноглазым.~
@15016 = ~«Это мои слова. Я *знал* их и *знал* их смысл. Я забыл их, пока ты не произнёс», — взгляд Дак'кона устремляется вдаль сквозь тебя, его клинок, теперь полупрозрачный, перестаёт блестеть, отсвечивая всеми цветами. После минуты молчания взгляд Дак'кона вновь останавливается на тебе: «Я пойду с тобой твоим путём».~
@15017 = ~«Наверное, пока я воздержусь от заключения договора. Сперва у меня кое-какие вопросы…»~
@15018 = ~«Сам город построен из дверей. Эти двери ведут куда угодно».~
@15019 = ~«Я передумал подписывать. Прощай».~
@15020 = ~«Двери везде… — Дак'кон на секунду замолкает. — Каждое ограниченное пространство в пределах этого города — дверь, которая куда-то ведёт».~
@15021 = ~«Представь себе дверь в бар „Горящий труп“. Убери дверь. Рама останется. Пространство внутри рамы останется дверью».~
@15022 = ~«Многие двери ты не можешь увидеть. Ты можешь пройти сквозь них, как сквозь воздух, и не *знать*, что это такое. Они скрыты от твоего взгляда и прикосновения».~
@15023 = ~«Говорят, каждое ограниченное пространство в Сигиле — дверь. Точно они *неизвестны*. Двери движутся. Двери меняются. Двери исчезают. И все они закрыты».~
@15024 = ~«Дверь неощутима, как воздух, пока у тебя нет ключа, который бы её отпирал. Когда ты получишь ключ, ты *узнаешь* дверь».~
@15025 = ~«К каждой двери — свой ключ. Некоторые ключи *известны*, некоторые — *неизвестны*».~
@15026 = ~«Существует много ключей к разным дверям. Ключ — не всегда предмет из металла. Ключом может быть удар двух мечей, капля крови из языка умирающего, память о прошедшей любви или злое проклятие небесам. Когда дверь встречается с ключом, она проявляется».~
@15027 = ~«Попытки были, но все неудачные. Когда город меняется, меняются и двери. Никакое *знание* не остаётся *знанием* долго».~
@15028 = ~«Для всего существующего, живого или нет, существование определяется *знанием* себя».~
@15029 = ~Снова коснувшись пером пергамента, ты слышишь шёпот, потоком накатывают воспоминания и мысли…~
@15030 = ~«Когда разум не *знает* себя — он имеет изъян. Когда разум с изъяном — изъян имеет и обладатель. Когда личность с изъяном — изъян передаётся всему, чего она касается, — Дак'кон выдерживает паузу. — Говорят, всё, что видит личность с изъяном, её руки ломают».~
@15031 = ~Подавить наплыв воспоминаний, подписать договор…~
@15032 = ~Дак'кон замолкает. Взгляд его угольно-чёрных глаз устремляется в ту же даль, что и в начале разговора.~
@15033 = ~Поддаться воспоминаниям.~
@15034 = ~Когда Дак'кон начинает говорить снова, его голос меняется; слова рождают эхо, как будто большой камень падает в пропасть. Похоже, он как-то усиливает слова, исходящие из его груди. «Нет моей *воли*, чтобы ты это *знал*».~
@15035 = ~«Думаю, пока я воздержусь от заключения договора. Сперва у меня кое-какие вопросы…»~
@15036 = ~Слова исходят из Дак'кона медленно, как будто одно цепляется за другое. «Так… случилось, что я не *знаю* себя».~
@15037 = ~«Я передумал подписывать. Прощай».~
@15038 = ~Голос Дак'кона падает до шёпота, похожего на шелест песчинок. «Я не *знаю*, почему. Я *знаю*, что это произошло, но не *знаю*, как и когда… и как *познать* себя снова».~
@15039 = ~«Это клинок *карач*. Это вещь, по которой остальные *знают* положение владельца».~
@15040 = ~«Клинок — символ, носимый *зертами*. *Зерт* — тот, кто *знает* слово Зертимона. В *познании* слов Зертимона они *познают* себя».~
@15041 = ~«Зертимон создал нашу расу. Он *знал* гитцерай раньше, чем они *узнали* себя. Он создал Народ. Дал им сознание».~
@15042 = ~Дак'кон на секунду замолкает, как будто в поиске правильных слов. «Ближайший перевод в твоём языке — „материя хаоса“. Народ может придавать ей форму своими мыслями».~
@15043 = ~«Гитцерай».~
@15044 = ~«*Карач* выкован не жаром и молотом, а *знанием* себя. Это зеркало, которое отражает волю владельца на поверхности и лезвии. Когда владелец *знает* себя, лезвие сильно — твёрже и сильней стали. Когда он не *знает* себя, лезвие как вода — бесформенное и слабое».~
@15045 = ~«Если он попадёт в чужие руки, то станет ничем. Клинок *знает* мой разум, а я *знаю* его сердце. Мы умрём одной смертью».~
@15046 = ~«Такой мне *неизвестен*».~
@15047 = ~«Местоположение таких вещей я не *знаю*».~
@15048 = ~Когда ты собираешься уходить, мужчина вдруг заговаривает, и ты впервые с начала разговора слышишь в его голосе новые нотки. «Стой, — он понижает голос. — Ты не *знаешь* этот город. Я пройду твоим путём вместе с тобой».~
@15049 = ~«Ты должен выслушать меня», — прежде чем ты успеваешь уйти, Дак'кон заговаривает снова. Ты чувствуешь, что уйти непросто, пока его внимание приковано к тебе. «Ты чужой в этом городе. Ты не *знаешь* этот город, и он опасен для тебя. Два клинка могут больше, чем один, даже когда остаются в ножнах», — пока он говорит, ты замечаешь, что его клинок меняет цвет на мертвенно-чёрный, как когда он увидел тебя впервые.~
@15050 = ~«Я буду здесь, когда ты вернёшься. Позволь мне *узнать* тебя, и твой путь станет моим».~
@15051 = ~Взгляд Дак'кона меняется. Он смотрит словно мимо тебя, как в начале разговора. «Я стар, но путешествовал в далёкие места. Я *знаю* искусство войны. Я *знаю* тайные течения этого города».~
@15052 = ~«Там, где ты бьёшь вслепую, мой клинок попадает в цель. Двери, закрытые для тебя, открыты для меня. Если ты *узнаешь* всё это через меня, ты станешь сильнее. Я пройду твоим путём вместе с тобой».~
@15053 = ~«Твой путь — мой путь», — странное дело, его голос кажется далёким и создаёт эхо, как если бы он говорил издалека.~ [DAK206]
@15054 = ~Дак'кон поворачивается при твоём приближении, его глаза похожи на полированные угольки. Он смотрит сквозь тебя, и на мгновение тебе кажется, что он может быть слепым.~
@15055 = ~«Приветствую».~
@15056 = ~Игнорировать его.~
@15057 = ~~
@15058 = ~«Ты в порядке?»~
@15059 = ~~
@15060 = ~«Приветствую».~
@15061 = ~«Прости, что потревожил тебя. Прощай».~
@15062 = ~«Можно сказать и так».~
@15063 = ~«Прости, что побеспокоил тебя. Прощай».~
@15064 = ~«Можно сказать и так».~
@15065 = ~«Не хотел тебя беспокоить. Пока».~
@15066 = ~«Да я и сам себя не знаю».~
@15067 = ~«Не хотел тебя беспокоить. Пока».~
@15068 = ~«Да я и сам себя не знаю».~
@15069 = ~«Я в этом городе гость».~
@15070 = ~«А ты неизвестен мне».~
@15071 = ~«Я ищу ответы… у меня много вопросов».~
@15072 = ~«Я ищу ответы… у меня много вопросов».~
@15073 = ~«Я ищу ответы… у меня много вопросов».~
@15074 = ~«Ты выглядишь… непривычно для меня. Кто ты?»~
@15075 = ~«Можешь ещё раз рассказать мне о народе гитцерай?»~
@15076 = ~«Можешь рассказать мне об этом городе?»~
@15077 = ~«Кажется, ты делаешь особое ударение на слово „знание“. Что ты имеешь в виду?»~
@15078 = ~«Что у тебя за клинок?»~
@15079 = ~«Не знаешь мужчину по имени Фарод? Судя по всему, он кое-что обо мне знает».~
@15080 = ~«Я потерял дневник. Не знаешь, где он может быть?»~
@15081 = ~«Мне нечего больше сказать. Прощай».~
@15082 = ~«Гитцерай?»~
@15083 = ~«У меня другие вопросы…»~
@15084 = ~«Ясно. Мне пора идти. Прощай».~
@15085 = ~Ты царапаешь «X» в трёх местах, которые указал Эморик. Когда заканчиваешь, Эморик забирает договор и даёт тебе мешочек с пятьюдесятью монетами.~
@15086 = ~«Ну вот, с этим разобрались, теперь у меня есть пара вопросов…»~
@15087 = ~«Наша сделка заключена… прощай».~
@15088 = ~«Ты уже числишься в рядах другой фракции».~
@15089 = ~Ложь: «Ты ошибся. Я не принадлежу ни к одной другой фракции».~
@15090 = ~«Я хочу выйти из этой фракции и присоединиться к Пыльным».~
@15091 = ~«Неважно. У меня другие вопросы…»~
@15092 = ~«Точно, как я мог забыть. Пока».~
@15093 = ~«Я не ошибся», — голос Эморика твёрд как камень, но ты можешь различить в нём слабые трещинки сомнения.~
@15094 = ~«Ты ошибся. Мой разум принадлежит Пыльным, а не какой-либо другой фракции. Если ты *сомневаешься* во мне, то назначь испытание».~
@15095 = ~«Хорошо, я хочу выйти из этой фракции и присоединиться к Пыльным».~
@15096 = ~«Забудь. У меня другие вопросы…»~
@15097 = ~«Тогда нам больше нечего обсуждать. Прощай».~
@15098 = ~Когда ты произносишь слово «сомневаешься», Эморик чуть вздрагивает; это почти незаметно за его каменной маской, но от твоего внимательного взгляда не ускользает. Может быть, Эморик и Пыльный, но незначительные изменения выражения лица всё же выдают его мысли.~
@15099 = ~«Повторяю: если тебя одолевают *сомнения*, испытай меня. Ты поймёшь, что мой разум свободен от чувств, а мой путь — с Пыльными».~
@15100 = ~«Забудь. У меня другие вопросы…»~
@15101 = ~«Я должен идти. Прощай».~
@15102 = ~Эморик в молчании изучает тебя. Через некоторое время он произносит: «Меня не одолевают сомнения. Но испытание всё же необходимо. Если ты желаешь вступить в ряды Пыльных, озвучь мне свою просьбу».~
@15103 = ~«Да, я желаю вступить в ряды Пыльных».~
@15104 = ~«И снова ты меня не понял. Я не *желаю* вступить в ряды Пыльных. Я просто верую в то, во что веруют Пыльные».~
@15105 = ~«Забудь. У меня другие вопросы…»~
@15106 = ~«Я должен идти. Прощай».~
@15107 = ~«Твоё желание вступить в ряды Пыльных сильнее, чем твоя преданность той фракции?»~
@15108 = ~«Да».~
@15109 = ~«Ты неправильно понял мои намерения. Я не *желаю* вступить в ряды Пыльных. Я просто верую в то, во что веруют Пыльные».~
@15110 = ~«Я отзываю свою просьбу. У меня другие вопросы…»~
@15111 = ~«Не бери в голову. Мне пора идти, прощай».~
@15112 = ~«Если ты желаешь вступить в ряды Пыльных, тобой движет страсть. А путь страстей — не путь Пыльных».~
@15113 = ~«Я неправильно выразился. Я не *желаю* вступить в ряды Пыльных. Я просто верую в то, во что веруют Пыльные».~
@15114 = ~«Я неправильно выразился. Я не *желаю* вступить в ряды Пыльных. Я просто верую в то, во что веруют Пыльные».~
@15115 = ~«Можешь ли ты тогда рассказать мне больше о пути Пыльных?»~
@15116 = ~«Я отзываю свою просьбу. У меня другие вопросы…»~
@15117 = ~«Не бери в голову. Мне пора идти, прощай».~
@15118 = ~«Это навлечёт на тебя гнев твоей прежней фракции. Ты больше не будешь желанным гостем в их залах и сердцах».~
@15119 = ~Отречься от фракции: «Пусть случится то, чему должно случиться. Мой разум должен быть предан мне и никому другому. Потому я отвергаю доктрину Боготов».~
@15120 = ~Отречься от фракции: «Пусть случится то, чему должно случиться. Мой разум должен быть предан мне и никому другому. Потому я отвергаю… э-э, „доктрину“ Хаоситов».~
@15121 = ~Отречься от фракции: «Пусть случится то, чему должно случиться. Мой разум должен быть предан мне и никому другому. Потому я отвергаю доктрину Чующих».~
@15122 = ~Солгать, чтобы проникнуть к Пыльным ради Анархистов: «Пусть случится то, чему должно случиться. Мой разум должен быть предан мне и никому другому. С этого момента я отрекаюсь от веры моей прежней фракции».~
@15123 = ~«Забудь. У меня другие вопросы…»~
@15124 = ~«Тогда я не готов. Прощай».~
@15125 = ~«Один из народа?»~
@15126 = ~«У меня другие вопросы…»~
@15127 = ~«Ясно. Мне пора идти. Прощай».~
@15128 = ~«Да, но кто именно эти гитцерай?»~
@15129 = ~«Спасибо за объяснение. Теперь всё стало ясно. У меня другие вопросы…»~
@15130 = ~«Ясно. Мне пора идти. Прощай».~
@15131 = ~«Я не нуждаюсь в изучении вашей истории… но хотел бы знать, что вы представляете из себя сейчас».~
@15132 = ~«У меня другие вопросы…»~
@15133 = ~«Ясно. Мне пора идти. Прощай».~
@15134 = ~Ждать и смотреть, что будет дальше.~
@15135 = ~«У меня другие вопросы…»~
@15136 = ~«Мне нечего больше сказать. Прощай».~
@15137 = ~«Какой у тебя странный клинок… он движется в такт твоим словам».~
@15138 = ~«У меня другие вопросы…»~
@15139 = ~«Замечательно. Прощай».~
@15140 = ~«Не знает сам себя? Что ты имеешь в виду?»~
@15141 = ~«У меня другие вопросы…»~
@15142 = ~«Мне нечего больше сказать. Прощай».~
@15143 = ~«И как изъян проявляется?»~
@15144 = ~«Ты говоришь так, будто город живой».~
@15145 = ~«У меня другие вопросы…»~
@15146 = ~«Мне нечего больше сказать. Прощай».~
@15147 = ~«Почему ты сказал, что город не знает сам себя?»~
@15148 = ~«Ясно. У меня другие вопросы…»~
@15149 = ~«Спасибо за информацию. Прощай».~
@15150 = ~«Когда ты говорил, что город везде одновременно, что ты имел в виду?»~
@15151 = ~«Его стены — двери?»~
@15152 = ~Правда: «А что, если это *вовсе* не изъян города? Неживому не нужно стремиться к порядку и познавать себя. Что, если эти противоречия — проявления невидимых тебе сил?»~
@15153 = ~Правда: «А что, если это *вовсе* не изъян города? Неживому не нужно стремиться к порядку и познавать себя. Что, если эти противоречия — проявления невидимых тебе сил?»~
@15154 = ~Правда: «А что, если это *вовсе* не изъян города и ты просто не знаешь причины этих противоречий? Порядок проявляется во всём. Возможно, здесь мы имеем дело с глубинным порядком, который ты не можешь постичь».~
@15155 = ~Правда: «А что, если это *вовсе* не изъян города и ты просто не знаешь причины этих противоречий? Порядок проявляется во всём. Возможно, здесь мы имеем дело с глубинным порядком, который ты не можешь постичь».~
@15156 = ~«Ты говоришь так, будто город живой».~
@15157 = ~«У меня другие вопросы…»~
@15158 = ~«Мне нечего больше сказать. Прощай».~
@15159 = ~Правда: «Отвечу на *твой* вопрос вопросом: ты утверждаешь, что в существовании города есть изъян. Ты принял это утверждение вместо того, чтобы исследовать ту вероятность, что здесь мы имеем дело с чем-то большим. Не означает ли это, что изъян как раз в тебе… и что ты ищешь не знание, а только приемлемый ответ?»~
@15160 = ~Правда: «Отвечу на *твой* вопрос вопросом: ты утверждаешь, что в существовании города есть изъян. Ты принял это утверждение вместо того, чтобы исследовать ту вероятность, что здесь мы имеем дело с чем-то большим. Не означает ли это, что изъян как раз в тебе… и что ты ищешь не знание, а только приемлемый ответ?»~
@15161 = ~«Когда ты говорил, что город везде одновременно, что ты имел в виду?»~
@15162 = ~«У меня другие вопросы…»~
@15163 = ~«Мне нечего больше сказать. Прощай».~
@15164 = ~«Но я бы сказал, что мы *познаём* себя с помощью вопросов, которые себе задаём или не задаём. Если мы перестанем задавать вопросы и примем только то, что можем воспринять…»~
@15165 = ~«Но я бы сказал, что мы *познаём* себя с помощью вопросов, которые себе задаём или не задаём. Если мы перестанем задавать вопросы и примем только то, что можем воспринять…»~
@15166 = ~«Неважно. У меня другие вопросы…»~
@15167 = ~«Я не хотел беспокоить тебя. Прощай».~
@15168 = ~«Где ты их слышал?»~
@15169 = ~«Неважно. У меня другие вопросы…»~
@15170 = ~«Я не хотел беспокоить тебя. Прощай».~
@15171 = ~«Я обдумаю это. У меня другие вопросы…»~
@15172 = ~«Я согласен. Ещё один клинок всегда кстати».~
@15173 = ~«Ты стар. Для чего ты можешь мне сгодиться?»~
@15174 = ~«Где эти двери?»~
@15175 = ~«Не сегодня. Прощай».~
@15176 = ~«Так почему ты сказал, что в городе есть изъян?»~
@15177 = ~«Ясно. У меня другие вопросы…»~
@15178 = ~«Спасибо за информацию. Прощай».~
@15179 = ~«Не понимаю».~
@15180 = ~«Так почему ты сказал, что в городе есть изъян?»~
@15181 = ~«Ясно. У меня другие вопросы…»~
@15182 = ~«Спасибо за информацию. Прощай».~
@15183 = ~«Но я прошёл через ту дверь сюда. Это просто… открытое пространство».~
@15184 = ~«Так почему ты сказал, что в городе есть изъян?»~
@15185 = ~«Ясно. У меня другие вопросы…»~
@15186 = ~«Спасибо за информацию. Прощай».~
@15187 = ~«И эти невидимые двери *повсюду* в Сигиле?»~
@15188 = ~«Так почему ты сказал, что в городе есть изъян?»~
@15189 = ~«Ясно. У меня другие вопросы…»~
@15190 = ~«Спасибо за информацию. Прощай».~
@15191 = ~«Так почему ты сказал, что в городе есть изъян?»~
@15192 = ~«Закрыты?»~
@15193 = ~«Ясно. У меня другие вопросы…»~
@15194 = ~«Спасибо за информацию. Прощай».~
@15195 = ~«Как узнать, что из себя представляет ключ?»~
@15196 = ~«Так почему ты сказал, что в городе есть изъян?»~
@15197 = ~«Ясно. У меня другие вопросы…»~
@15198 = ~«Спасибо за информацию. Прощай».~
@15199 = ~«А что за ключи?»~
@15200 = ~«Так почему ты сказал, что в городе есть изъян?»~
@15201 = ~«Ясно. У меня другие вопросы…»~
@15202 = ~«Спасибо за информацию. Прощай».~
@15203 = ~«Хорошо. Ты знаком с нашей философией?»~
@15204 = ~«Звучит так, будто найти все эти двери и ключи может быть очень сложно».~
@15205 = ~«Да».~
@15206 = ~«Нет, не полностью».~
@15207 = ~«Я отзываю свою просьбу о присоединении к фракции Пыльных. У меня другие вопросы…»~
@15208 = ~«Так почему ты сказал, что в городе есть изъян?»~
@15209 = ~«Не бери в голову. Мне пора идти, прощай».~
@15210 = ~«Пыльные стремятся к Истинной Смерти. Некоторые зовут её „забвением“, но это неправильно. Для Пыльных Истинная Смерть — освобождение от цепей этой лживой жизни».~
@15211 = ~«Лживой жизни?»~
@15212 = ~«Я отзываю свою просьбу о присоединении к Пыльным. У меня другие вопросы…»~
@15213 = ~«Не бери в голову. Мне пора идти, прощай».~
@15214 = ~«Эта „жизнь“, за которую многие цепляются своими чувствами и страстями, есть лживое существование. Пока цепляешься за неё, ты будешь снова и снова перерождаться. Чтобы вырваться из этого круга, надо освободиться от страстей».~
@15215 = ~«Ясно. У меня другие вопросы…»~
@15216 = ~«Отлично. Теперь я понимаю вашу философию».~
@15217 = ~«Я отзываю свою просьбу о присоединении к Пыльным. У меня другие вопросы…»~
@15218 = ~«Спасибо за информацию. Прощай».~
@15219 = ~«Забудь, мне пора идти. Прощай».~
@15220 = ~«Так почему ты сказал, что в городе есть изъян?»~
@15221 = ~«Изложи её».~
@15222 = ~«Ясно. У меня другие вопросы…»~
@15223 = ~«Цель всех Пыльных состоит в достижении Истинной Смерти, забвения. Эта „жизнь“, за которую многие цепляются своими чувствами и страстями, есть лживое существование. Пока цепляешься за неё, ты будешь снова и снова перерождаться. Чтобы вырваться из этого круга, надо освободиться от страстей».~
@15224 = ~«Спасибо за информацию. Прощай».~
@15225 = ~«Я отзываю свою просьбу. У меня другие вопросы…»~
@15226 = ~«А если кто-то не знает себя?»~
@15227 = ~«Забудь, мне пора идти. Прощай».~
@15228 = ~«У меня другие вопросы…»~
@15229 = ~«Веруешь ли ты в это?»~
@15230 = ~Правда: «Да».~
@15231 = ~«Мне нечего больше сказать. Прощай».~
@15232 = ~Ложь: «Да».~
@15233 = ~Правда: «Не полностью».~
@15234 = ~«А ты знаешь себя?»~
@15235 = ~«Я отзываю свою просьбу о присоединении к Пыльным. У меня другие вопросы…»~
@15236 = ~«У меня другие вопросы…»~
@15237 = ~«Мне нечего больше сказать. Прощай».~
@15238 = ~«Я снова спрашиваю: ты знаешь себя?»~
@15239 = ~«Забудь, я больше не хочу вступать в ряды Пыльных. Прощай».~
@15240 = ~«Неважно. У меня другие вопросы…»~
@15241 = ~«Я не хотел беспокоить тебя. Прощай».~
@15242 = ~«Может быть, я слишком мягко изложил это как вопрос. Расскажи мне».~
@15243 = ~«Забудь. У меня другие вопросы…»~
@15244 = ~«Прошу прощения. Не бери в голову. Прощай».~
@15245 = ~«Почему?»~
@15246 = ~«Забудь. У меня другие вопросы…»~
@15247 = ~«Прошу прощения. Не бери в голову. Прощай».~
@15248 = ~«Забудь. У меня другие вопросы…»~
@15249 = ~«Прошу прощения. Не бери в голову. Прощай».~
@15250 = ~«*Карач*? Что это означает?»~
@15251 = ~«Он выполнен из странного металла… то, как он движется туда-сюда, почти завораживает».~
@15252 = ~«Какое положение он означает?»~
@15253 = ~«У меня другие вопросы…»~
@15254 = ~«Ясно. Мне пора идти. Прощай».~
@15255 = ~«Зертимон?»~
@15256 = ~«Так из чего этот клинок?»~
@15257 = ~«У меня другие вопросы…»~
@15258 = ~«Так из чего этот клинок?»~
@15259 = ~«Ясно. Мне пора идти. Прощай».~
@15260 = ~«У меня другие вопросы…»~
@15261 = ~«Ясно. Мне пора идти. Прощай».~
@15262 = ~«Народ?»~
@15263 = ~«Придавать форму своими мыслями?»~
@15264 = ~«У меня другие вопросы…»~
@15265 = ~«Ясно. Мне пора идти. Прощай».~
@15266 = ~«Что такое гитцерай?»~
@15267 = ~«Так что такое гитцерай?»~
@15268 = ~«И ты говоришь, что гитцерай могут придавать форму этому *карачу*… своими мыслями?»~
@15269 = ~«У меня другие вопросы…»~
@15270 = ~«Ясно. Мне пора идти. Прощай».~
@15271 = ~«Не хочешь продать его?»~
@15272 = ~«Какое положение означает клинок?»~
@15273 = ~«У меня другие вопросы…»~
@15274 = ~«Ясно. Мне пора идти. Прощай».~
@15275 = ~«У меня другие вопросы…»~
@15276 = ~«Ясно. Мне пора идти. Прощай».~
@15277 = ~«У меня другие вопросы…»~
@15278 = ~«Мне нечего больше сказать. Прощай».~
@15279 = ~«У меня другие вопросы…»~
@15280 = ~«Мне нечего больше сказать. Прощай».~
@15281 = ~«Я согласен. Ещё один клинок всегда кстати».~
@15282 = ~«Ты стар. Для чего ты можешь мне сгодиться?»~
@15283 = ~«Не сегодня. Прощай».~
@15284 = ~«Прекрасно. Ещё один клинок всегда кстати, Дак'кон».~
@15285 = ~«Ты хочешь заставить меня слушать себя, но сам меня не слушаешь. Я не хочу, чтобы ты был рядом со мной. Оставайся здесь. Теперь прощай».~
@15286 = ~«Буду иметь в виду. Прощай».~
@15287 = ~«И тем не менее…»~
@15288 = ~«Не сегодня. Прощай».~
@15289 = ~«Хорошо, я согласен».~
@15290 = ~«Я так не думаю. Прощай».~
@15291 = ~«Хорошо. Пошли».~
@15292 = ~«Ещё раз здравствуй, Дак'кон. У меня были кое-какие вопросы…»~
@15293 = ~«Я буду рад тебе и твоему клинку, Дак'кон».~
@15294 = ~Игнорировать его.~
@15295 = ~~
@15296 = ~Этот чуть женоподобный, безукоризненно выглядящий молодой человек разглядывает прохожих с презрительной ухмылкой. Его рука покоится на искусно выполненном, украшенном самоцветами эфесе сабли. В шёлковой одежде и замшевых сапогах он выглядит до неприличия неуместно.~
@15297 = ~Несмотря на нежные черты лица и тонкие губы, позволяющие сойти за миловидную женщину, его голос, хотя и мягкий, без сомнения принадлежит мужчине. «М-м-м, путник. Ещё один „здоровяк“… — он буквально выплёвывает это слово, как будто вкус ему крайне неприятен, — …пришёл помериться силами с моим клинком?»~
@15298 = ~«Тогда уходи. У меня нет времени на таких, как ты», — он отмахивается от тебя.~
@15299 = ~Глаза молодого человека вспыхивают ледяным пламенем, на губах появляется холодная полуулыбка: «Да ладно? А ну-ка повтори, неуклюжая грубая развалина. Что ты мне сказал?»~
@15300 = ~Во мгновение ока сабля оказывается у него в руках. Он облизывает губы и тихо смеётся: «Постарайся не залить кровью мои сапоги, ладно?» За ним ты видишь грязную фигуру в плаще, наблюдающую за тобой жадным взглядом…~
@15301 = ~«Нет-нет-нет… не так просто, — он закрывает глаза и качает головой в притворном сожалении. — Ты из этой истории выйдешь трупом или трусом; вот и всё, что тебе осталось, выбирай».~
@15302 = ~Во мгновение ока сабля оказывается у него в руках. «Ты просто видишь себя в моих глазах, животное. Постарайся не залить кровью мои сапоги, ладно?» За ним ты видишь грязную фигуру в плаще, наблюдающую за тобой жадным взглядом…~
@15303 = ~Когда ты уходишь, он говорит: «Так я и думал. Трус». За его спиной ты слышишь едва различимый вздох разочарования.~
@15304 = ~На миг он выглядит удивлённым, затем кивает: «Так *всегда*, разве нет? Хм-м… Я думаю, ты можешь просить прощения и молиться какой-нибудь силе, чтобы я оказался в добром расположении духа».~
@15305 = ~Он хмурится, закатывая глаза. «Хорошо, я…» — вдруг он осекается в замешательстве и кладёт руку на висок.~
@15306 = ~«Я… э… нет, прощения быть не может! — он качает головой, и выражение замешательства сменяется мрачной решимостью. — Беги или умри!»~
@15307 = ~Когда ты уходишь, он бросает тебе в спину: «Вернись, негодяй бесхребетный!»~
@15308 = ~Когда ты поворачиваешься к нему лицом, сабля во мгновение ока оказывается у него в руках. «А, хорошо; так ты будешь драться! Постарайся не залить кровью мои сапоги, ладно?» За ним ты видишь грязную фигуру в плаще, наблюдающую за тобой жадным взглядом…~
@15309 = ~Он злобно смеётся. «Тебе меня не запугать, грубое животное. Лучше уходи, пока твоя жизнь не утекла в сточные канавы Сигила».~
@15310 = ~«А я *должен*? Хм-м… твоя наглость забавна, обитатель Улья. Что ты хотел у меня спросить?»~
@15311 = ~«Имена здешнего… „люда“… меня не интересуют. Я не знаю и знать не хочу этого Фарода, даже если видел его».~
@15312 = ~«Ты умеешь *читать*? — он усмехается под нос. — Так… ты потерял его здесь? Без сомнения, его украли, наверное, местные дегенераты пустили на подстилку или на растопку. Забудь, что он у тебя когда-то был; я уверен, теперь ты не захочешь взять эту вещь в руки, если натолкнёшься».~
@15313 = ~«Ты можешь обращаться ко мне как к Адизоэлю из дома Эриан-Ард».~
@15314 = ~Он нехорошо ухмыляется; зубы его, безупречные и белые, как свежевыпавший снег, к тому же выглядят острыми, как ножи. «О, и то и сё. Испытываю свои умения, ищу приключений. „Хождение в Улей“, так сказать».~
@15315 = ~Глаза молодого человека вспыхивают ледяным пламенем; на губах появляется холодная полуулыбка. «Превосходно… — во мгновение ока сабля оказывается у него в руках. — Постарайся не залить кровью мои сапоги, ладно?» За ним ты видишь грязную фигуру в плаще, наблюдающую за тобой жадным взглядом…~
@15316 = ~Его глаза загораются. «Пожалуй, это отлич…» — вдруг он осекается в замешательстве и кладёт руку на висок.~
@15317 = ~«А… э… нет, никаких ставок! Выиграешь — будешь жить; проиграешь — умрёшь. Всё просто».~
@15318 = ~«Прекрасно, прекрасно. Задавай».~
@15319 = ~Завидев тебя, Адизоэль кивает головой: «А, опять вернулся. В этот раз пришёл скрестить мечи или опять приставать с вопросами?»~
@15320 = ~Он резко произносит: «И тебе „прощай“. Я должен попросить тебя больше ко мне не приставать, если только не захочешь сразиться».~
@15321 = ~Адизоэль презрительно роняет тебе в спину: «Я ещё в прошлый раз сказал: не приставай ко мне больше, если только не захочешь сразиться. Если нам суждено встретиться снова, я так это и пойму; мы сразу скрестим мечи, хочешь ты этого или нет».~
@15322 = ~Ты вспоминаешь, что Адизоэль просил тебя больше не приставать к нему, если только не захочешь сразиться.~
@15323 = ~Ты вспоминаешь слова Адизоэля, что попытку заговорить с ним он расценит как вызов и нападёт.~
@15324 = ~«Ха! Трусливая скотина вернулась!»~
@15325 = ~Он презрительно ухмыляется, отворачивая голову: «У меня нет ответов для такой бесхребетной твари, как ты. Дерись со мной или уходи».~
@15326 = ~«Я не позволю тебе больше приставать ко мне, трус. Не хочу тебя больше видеть, если только ты не захочешь сразиться. Если нам суждено встретиться снова, я так это и пойму; мы сразу скрестим мечи, хочешь ты этого или нет».~
@15327 = ~Адизоэль выглядит неподдельно удивлённым: «Что, опять? Откуда ты вылез, животное? Я был уверен, что покончил с тобой».~
@15328 = ~Молодой человек отшатывается и разинув рот глядит на Морте. «А *ты* кто такой?»~
@15329 = ~Всё, что у мужчины получается выдавить, — это приглушённое рычание, с его губ слетают брызги слюны: «Раргх!» Его сабля в мгновение ока вылетает из ножен, лицо наливается яростью: «Хватит! Я *ТРЕБУЮ* удовлетворения!»~
@15330 = ~«Прекрасно! Тогда вы оба умрёте!» Пока он готовится к удару, ты замечаешь на заднем плане грязную фигуру в плаще, наблюдающую за тобой жадным взглядом…~
@15331 = ~«Что? — молодой человек недоверчиво косится на Морте. — Это *странный* мимир, если не сказать ещё хуже!»~
@15332 = ~«Молчать, болтливый дурак! — он успокаивается и убирает саблю. — Вы оба: сражайтесь или бегите, третьего не дано». Хотя он охвачен яростью, в глазах горит ледяная ненависть.~
@15333 = ~«Эй ты, оставь беднягу в покое. Разве он не слишком жалок, чтобы тебе надо было разглагольствовать перед ним?»~
@15334 = ~«Это уж мне решать. А теперь оставь это жалкое создание в покое, или поплатишься».~
@15335 = ~«Потому что… потому что…» — вдруг он осекается в замешательстве и кладёт руку на висок. Он как будто оцепенел.~
@15336 = ~Он стряхивает замешательство: «Не твоё дело. Я ставлю тебе ультиматум: дерись со мной или уходи».~
@15337 = ~Анна толкает тебя в плечо, пока ты не успел поздороваться с мужчиной. «Погоди-ка… Слыхала я об этом типе. Недавно в Улье и воображает себя мастером меча. А ещё он убил всех громил, кто с ним дрался. Лучше те держаться от него подальше».~
@15338 = ~«Хе! Отлично! Мне без разницы! Тока не думай, что я буду ждать, пока он из тя котлету сделает!»~
@15339 = ~«Разорви этого слащавого хлыща на части, шеф! Покажи ему, как это делается!»~
@15340 = ~«Да, ответишь!»~
@15341 = ~«Ставлю десять монет на этого здоровенного парня в шрамах! — Морте подлетает ближе и шепчет. — Эй, это я о тебе, шеф. Не подведи нас».~
@15342 = ~«Хорошо, шеф, в этот раз ты его сделаешь! Дерись грязно!»~
@15343 = ~«Верно, разодетая, надушенная, слащавая мажорская задница… ты его слышала!»~
@15344 = ~«Кто *я*? Ха! Я мог бы быть твоим отцом, но та мартышка меня опередила!»~
@15345 = ~«Что-то не так, принцесса? Слова все растеряла? Ты бы лучше хлебало-то захлопнула, а то мухи слетятся! Да, ты меня слышала! Подбирай оборки и драпай к мамке под юбку, откуда выползла! Да, и не забудь ей передать от меня привет!»~
@15346 = ~«А? О… извини, шеф. Этот тип парней просто выводит меня…»~
@15347 = ~«И если бы я не знал, что к чему, я мог бы сказать…»~
@15348 = ~«Что? Я просто мимир, шеф! Я не могу „драться“!»~
@15349 = ~«Это такая… говорящая энциклопедия. Не хотелось бы напоминать, но тут у нас вообще-то некое затруднение».~
@15350 = ~«Да ладно, шеф… ты так его и отпустишь после такого? Давай вздуем этого жеманного повесу! Ты с ног сбиваешь, а я глаза выдираю!»~
@15351 = ~«Приветствую…»~
@15352 = ~«Приветствую…»~
@15353 = ~Пройти мимо.~
@15354 = ~«Нет, но у меня были кое-какие вопросы…»~
@15355 = ~«Почему бы и нет? Рискну».~
@15356 = ~«Почему бы и нет? Рискну».~
@15357 = ~«Да, но каковы ставки?»~
@15358 = ~«Да, но каковы ставки?»~
@15359 = ~«Нет. Прощай».~
@15360 = ~«Ты меня недооцениваешь, „сударь“. Так ты будешь слушать мои вопросы или нет?»~
@15361 = ~«Так найди время. Ты ответишь на мои вопросы».~
@15362 = ~«Так найди время. Ты ответишь на мои вопросы».~
@15363 = ~«Тогда я не буду отнимать твоё время, грубиян неотёсанный».~
@15364 = ~Уйти.~
@15365 = ~«Ты меня слышала, женщина».~
@15366 = ~«Ты меня слышала, женщина».~
@15367 = ~«Ничего. Прощай».~
@15368 = ~Дать ему отпор.~
@15369 = ~Бежать.~
@15370 = ~«Ты уверен, что третьего не дано?»~
@15371 = ~«Я вижу только один труп перед собой».~
@15372 = ~Развернуться и уйти.~
@15373 = ~Дать ему отпор.~
@15374 = ~Бежать.~
@15375 = ~Повернуться и напасть на него.~
@15376 = ~Не обратить внимания и уйти.~
@15377 = ~Не обратить внимания и уйти.~
@15378 = ~«Никогда. Мы будем драться».~
@15379 = ~«Тогда я прошу у тебя прощения. Я неудачно выразился».~
@15380 = ~«Не дождёшься. Прощай».~
@15381 = ~Подождать, что будет дальше.~
@15382 = ~«Ты в порядке?»~
@15383 = ~Напасть, пока он не ожидает.~
@15384 = ~Уйти, пока он не в себе.~
@15385 = ~Напасть на него.~
@15386 = ~Уйти.~
@15387 = ~Развернуться к нему лицом.~
@15388 = ~Уйти.~
@15389 = ~Дать ему отпор.~
@15390 = ~Бежать.~
@15391 = ~Правда: «Даю тебе последний шанс ответить, пока я не сломал пополам и тебя, и твой миленький меч».~
@15392 = ~Блеф: «Даю тебе последний шанс ответить, пока я не сломал пополам и тебя, и твой миленький меч».~
@15393 = ~Уйти.~
@15394 = ~«Кто ты?»~
@15395 = ~«Что ты здесь делаешь?»~
@15396 = ~«Я хочу драться».~
@15397 = ~«Я хочу драться».~
@15398 = ~«Я ищу мужчину по имени Фарод».~
@15399 = ~«Я ищу свой потерянный дневник».~
@15400 = ~«Ничего, неважно. Прощай».~
@15401 = ~«У меня другие вопросы…»~
@15402 = ~«Тогда прощай».~
@15403 = ~«Тогда прощай».~
@15404 = ~«Тогда прощай».~
@15405 = ~«У меня другие вопросы…»~
@15406 = ~«Тогда прощай».~
@15407 = ~«Тогда прощай».~
@15408 = ~«Тогда прощай».~
@15409 = ~«У меня другие вопросы…»~
@15410 = ~«Может, ещё поговорим, Адизоэль. Прощай».~
@15411 = ~«Может, ещё поговорим, Адизоэль. Прощай».~
@15412 = ~«Может, ещё поговорим, Адизоэль. Прощай».~
@15413 = ~«Думаю, я буду хорошим испытанием твоих умений».~
@15414 = ~«Думаю, я буду хорошим испытанием твоих умений».~
@15415 = ~«У меня другие вопросы…»~
@15416 = ~«Надеюсь, ты найдёшь себе приключений. Прощай».~
@15417 = ~«Надеюсь, ты найдёшь себе приключений. Прощай».~
@15418 = ~«Надеюсь, ты найдёшь себе приключений. Прощай».~
@15419 = ~«Стой…»~
@15420 = ~Дать ему отпор.~
@15421 = ~Бежать.~
@15422 = ~Подождать, что будет дальше.~
@15423 = ~«Ты в порядке?»~
@15424 = ~Напасть, пока он не ожидает.~
@15425 = ~Уйти, пока он не в себе.~
@15426 = ~«Отлично. Давай драться».~
@15427 = ~«Отлично. Давай драться».~
@15428 = ~«Забудь. Я хотел спросить…»~
@15429 = ~«Тогда забудь. Прощай».~
@15430 = ~«Кто ты?»~
@15431 = ~«Что ты здесь делаешь?»~
@15432 = ~«Я хочу драться».~
@15433 = ~«Я хочу драться».~
@15434 = ~«Я ищу мужчину по имени Фарод».~
@15435 = ~«Я ищу свой потерянный дневник».~
@15436 = ~«Неважно. Прощай».~
@15437 = ~«Неважно. Прощай».~
@15438 = ~«Я пришёл драться».~
@15439 = ~«Я пришёл драться».~
@15440 = ~«У меня пара вопросов…»~
@15441 = ~«У меня пара вопросов…»~
@15442 = ~«Ни то, ни другое. Прощай».~
@15443 = ~«Ни то, ни другое. Прощай».~
@15444 = ~Уйти.~
@15445 = ~Уйти.~
@15446 = ~Всё равно заговорить с ним.~
@15447 = ~Оставить его в покое.~
@15448 = ~Всё равно заговорить с ним.~
@15449 = ~Оставить его в покое.~
@15450 = ~«У меня кое-какие вопросы…»~
@15451 = ~«Я слышу лай собачки? Я пришёл подраться, облезлый хвост».~
@15452 = ~«Я слышу лай собачки? Я пришёл подраться, облезлый хвост».~
@15453 = ~Развернуться и уйти.~
@15454 = ~«Тогда я буду драться».~
@15455 = ~«Тогда я буду драться».~
@15456 = ~«Я ухожу. Прощай».~
@15457 = ~Уйти.~
@15458 = ~«Не совсем так. Я вернулся, чтобы подраться ещё раз».~
@15459 = ~«Не совсем так. Я вернулся, чтобы подраться ещё раз».~
@15460 = ~«Но не покончил. Я хотел задать пару вопросов…»~
@15461 = ~«Ты ошибся. Прощай».~
@15462 = ~«Просто не обращай на него внимания, он безобидный».~
@15463 = ~Позволить Морте высказаться.~
@15464 = ~«Я могу только попросить тебя простить моего товарища».~
@15465 = ~«Ну, Морте? Не хочешь подраться с ним?»~
@15466 = ~«Прекрасно… но ты будешь драться с нами обоими».~
@15467 = ~Дать ему отпор.~
@15468 = ~Бежать.~
@15469 = ~«Мимир?»~
@15470 = ~«Можешь простить его оскорбления?»~
@15471 = ~«Ты получишь драку… но мы будем драться вдвоём».~
@15472 = ~Напасть на него.~
@15473 = ~Развернуться и уйти.~
@15474 = ~«Не твоё дело».~
@15475 = ~«Заткнись, или ты следующий».~
@15476 = ~«Хорошо. Прощай».~
@15477 = ~«Сначала скажи мне, почему это вообще тебя как-то касается».~
@15478 = ~«А поплатиться меня ты заставишь? Ну же, давай, попытайся».~
@15479 = ~«Хорошо. Прощай».~
@15480 = ~«Ты в порядке?»~
@15481 = ~Ждать.~
@15482 = ~Уйти, пока он не в себе.~
@15483 = ~«А это уж мне решать. Теперь говори».~
@15484 = ~«Будем драться».~
@15485 = ~«Будем драться».~
@15486 = ~«Я бы сказал ему то же самое».~
@15487 = ~«Тогда я обойду его сторонкой».~
@15488 = ~Заговорить с мужчиной.~
@15489 = ~«Может, ты и права, Анна. Обойду-ка я его сторонкой».~
@15490 = ~«Морте, завязывай».~
@15491 = ~Позволить Морте продолжать.~
@15492 = ~«Морте, заткнись *немедленно*».~
@15493 = ~Позволить Морте продолжать.~
@15494 = ~«Ты прав… давай его вздуем».~
@15495 = ~«Ещё не время, Морте. Пошли отсюда».~
@15496 = ~Этот грязный мужчина в плаще слоняется вокруг, настороженно посматривая по сторонам. Ты замечаешь, что он не отходит далеко от молодого дворянина. Увидев, что ты на него смотришь, он спешит скрыться.~
@15497 = ~Он поворачивается к тебе лицом, глаза его расширены от страха. Ты обращаешь внимание, что всё его лицо покрыто мокнущими гнойниками; по голове лениво ползают толстые чёрные мухи. «Не бейте меня, господин… Я ничего не знаю, я ничего не брал!»~
@15498 = ~Он пятится назад, спотыкаясь, и бормочет: «Но… но я же сказал, господин… я ничего не знаю! Не знаю!»~
@15499 = ~«Да… я… я буду говорить с вами, господин…» — он нервно заламывает руки, попутно отмахиваясь от мух, садящихся на его болячки.~
@15500 = ~Он перепугано кивает: «Что угодно, господин… только спросите…»~
@15501 = ~«Ничего такого, господин, ничего. Я клянусь!» — он вытягивает вперёд пустые руки для осмотра.~
@15502 = ~Он качает головой: «Не-а, не знаю его, господин».~
@15503 = ~«Э? О! Я сам по себе, господин. Ага. Ни друзей, ни корешей…»~
@15504 = ~«Я? Мальрик, господин. Но, э… но меня зовут Волокитой».~
@15505 = ~«А? О… я всюду таскаюсь за тем чуваком», — он кивает в сторону молодого дворянина неподалёку, а тот поворачивает в его сторону голову и презрительно хмурится, прежде чем снова устремить взгляд вдаль. «Подчищаю за ним, если понятно, о чём я. Трупы».~
@15506 = ~«Я, э, продаю жмуриков в Мортуарий, Пыльным. За медяки, понятно дело. И шмотки их тоже продаю, если они одинокими померли. Без друзей».~
@15507 = ~«Кто, он? Без понятия, господин. Пришёл тут, начал всех задирать… как там он это называет… а, „дуэль“. Я с ним не заговариваю, ясно дело… просто утаскиваю жмуриков. Может, пойдёте да спросите, э-э, его самого…»~
@15508 = ~Он кивает. «Ох, да… Я не шибко знаток, ясно дело, но он прям убойно дерётся. Я б с ним драться не стал, если такая мыслишка проскакивает…»~
@15509 = ~«Э… таким кривым мечом, господин, мечом. Прям шикарная штука, и он прям шикарно ей машется. Такой быстрый, прям как танцует, — мужчина прыгает, неуклюже подражая стойке фехтовальщика, с него тучами летят потревоженные мухи. — Вжик! Вжик! Вжик-фюить! И ты уже помер!» Он кивает.~
@15510 = ~Внезапно в глазах у него появляется тревога. «Э, нет! Я совсем не то сказал, господин! Ведь я не видел вас в бою. Может, стоит, э, проверить. Выяснить. Но если вы недостаточно круты, он вас прирежет. Если хотите, могу передать Пыльным ваше последнее желание. В случае, если вы… проиграете».~
@15511 = ~«Улей, господин? — он скребёт макушку, пожимая плечами. — Он такой, какой есть… унылые трущобы от края до края. Правду говоря, ничего больше и не скажешь».~
@15512 = ~Мужчина, похоже, перепуган твоим появлением, но вскоре по его гноящемуся лицу расползается выражение узнавания: «Моё почтение, господин».~
@15513 = ~Этот грязный мужчина в плаще слоняется вокруг, настороженно посматривая по сторонам. Увидев, что ты на него смотришь, он спешит скрыться.~
@15514 = ~Мужчина вдруг бросается бежать в окружении тучи трупных мух и грязных бурых тряпок!~
@15515 = ~Мужчина видит твоё приближение, и его покрытое гнойниками лицо искажает страх. Он начинает пятиться.~
@15516 = ~«А? Вы о чём, господин?» — он выглядит совсем растерявшимся.~
@15517 = ~«Я… я не знаю, чего вы добиваетесь, господин… на самом деле не знаю! Может, вы обознались?»~
@15518 = ~Ужас искажает гноящееся лицо мужчины по мере твоего приближения, он вскрикивает и начинает пятиться.~
@15519 = ~Он таращит на тебя глаза, онемев от ужаса.~
@15520 = ~«Приветствую…»~
@15521 = ~Оставить его в покое.~
@15522 = ~«Хватит играть. Я знаю, кто ты, изверг».~
@15523 = ~«Я слышал, что ты далеко не тот, кем хочешь казаться».~
@15524 = ~«У меня кое-какие вопросы…»~
@15525 = ~«Тогда прощай».~
@15526 = ~«Хватит играть. Я знаю, кто ты, изверг».~
@15527 = ~«Я слышал, что ты далеко не тот, кем хочешь казаться».~
@15528 = ~«Ещё выясним. Ты будешь говорить?»~
@15529 = ~«Тогда ладно, свободен. Прощай».~
@15530 = ~«Хватит играть. Я знаю, кто ты, изверг».~
@15531 = ~«Я слышал, что ты далеко не тот, кем хочешь казаться».~
@15532 = ~«Кто ты?»~
@15533 = ~«Что ты здесь делаешь?»~
@15534 = ~«Расскажи мне об этом районе».~
@15535 = ~«Я ищу одного типа по имени Фарод».~
@15536 = ~«Я ищу свой потерянный дневник. Не видел?»~
@15537 = ~«Хватит играть. Я знаю, кто ты, изверг».~
@15538 = ~«Я слышал, что ты далеко не тот, кем хочешь казаться».~
@15539 = ~«Кто ты?»~
@15540 = ~«Что ты здесь делаешь?»~
@15541 = ~«Расскажи мне об этом районе».~
@15542 = ~«Я ищу одного типа по имени Фарод».~
@15543 = ~«Я ищу свой потерянный дневник. Не видел?»~
@15544 = ~«Ничего, неважно. Прощай».~
@15545 = ~«У меня другие вопросы…»~
@15546 = ~«Тогда прощай».~
@15547 = ~«Ты уверен? Я так понимаю, он Сборщик».~
@15548 = ~«Я хотел спросить о другом…»~
@15549 = ~«Тогда неважно. Прощай».~
@15550 = ~«Ясно. У меня другие вопросы…»~
@15551 = ~«Тогда неважно. Прощай».~
@15552 = ~«Почему бы это?»~
@15553 = ~«У меня другие вопросы…»~
@15554 = ~«Это всё, что я хотел узнать. Прощай».~
@15555 = ~«Зачем ты это делаешь?»~
@15556 = ~«Кто он?»~
@15557 = ~«У меня другие вопросы…»~
@15558 = ~«Это всё, что я хотел узнать. Прощай».~
@15559 = ~«Кто тот вельможа?»~
@15560 = ~«У меня другие вопросы».~
@15561 = ~«Это всё, что я хотел узнать. Прощай».~
@15562 = ~«Так значит, он хороший боец?»~
@15563 = ~«Зачем ты таскаешь трупы?»~
@15564 = ~«У меня другие вопросы…»~
@15565 = ~«Наверно, так и сделаю. Прощай».~
@15566 = ~Он кивает. «Ох, да… Я не шибко знаток, ясно дело, но он прям убойно дерётся. Я б с ним драться не стал, если такая мыслишка проскакивает…»~
@15567 = ~«Ты думаешь, он лучше меня?»~
@15568 = ~«Чем он дерётся? Мечом? Магией?»~
@15569 = ~«У меня другие вопросы…»~
@15570 = ~«Это всё, что я хотел узнать. Прощай».~
@15571 = ~«Ты думаешь, он лучше меня?»~
@15572 = ~«У меня другие вопросы…»~
@15573 = ~«Это всё, что я хотел узнать. Прощай».~
@15574 = ~«Чем он дерётся? Мечом? Магией?»~
@15575 = ~«Не волнуйся об этом. У меня другие вопросы…»~
@15576 = ~«Нет, спасибо. Прощай».~
@15577 = ~«У меня другие вопросы…»~
@15578 = ~«Это всё, что я хотел узнать. Прощай».~
@15579 = ~«Хватит играть. Я знаю, кто ты, изверг».~
@15580 = ~«Привет, „Волокита“. Я слышал, что ты далеко не тот, кем хочешь казаться».~
@15581 = ~«Привет, Волокита. У меня были кое-какие вопросы…»~
@15582 = ~«Привет и прощай».~
@15583 = ~«Приветствую…»~
@15584 = ~Оставить его в покое.~
@15585 = ~«Проклятье…»~
@15586 = ~«Хватит играть. Я знаю, кто ты, изверг».~
@15587 = ~~
@15588 = ~~
@15589 = ~«Я слышал, что ты далеко не тот, кем хочешь казаться».~
@15590 = ~«У меня другие вопросы…»~
@15591 = ~Оставить его в покое.~
@15592 = ~«Почему бы не рассказать мне всё, „Волокита“?»~
@15593 = ~«Ты знаешь, о чём я. Кто ты на самом деле?»~
@15594 = ~«Забудь. У меня другие вопросы…»~
@15595 = ~«Неважно. Прощай».~
@15596 = ~«Ладно. Тогда у меня другие вопросы…»~
@15597 = ~Правда: «Говори, или я выбью из тебя ответ, ублюдок!»~
@15598 = ~Блеф: «Говори, или я выбью из тебя ответ, ублюдок!»~
@15599 = ~«Тогда прощай».~
@15600 = ~«Подожди, у меня были вопросы…»~
@15601 = ~Отпустить его.~
@15602 = ~«Ну?»~
@15603 = ~«Хватить трястись, ничего я тебе не сделаю».~
@15604 = ~«Так я и думал. Прощай».~
@15605 = ~«Тогда ты должен пройти испытание. Поговори с Посвящённым Норочи. Он здесь, в баре. Возвращайся, когда сделаешь то, что он попросит».~
@15606 = ~Этот грязный Сборщик уставился в пространство, кажется, забыв обо всём вокруг.~
@15607 = ~Он испуганно вздрагивает, пробуждаясь от своей медитации. Когда он видит тебя, на его лице проступает настоящая паника.~
@15608 = ~«А… э… о чём вы хотели поговорить, господин?»~
@15609 = ~«Я поговорю с ним. Но сначала я хотел задать пару вопросов…»~
@15610 = ~«Прекрасно. Прямо сейчас и пойду».~
@15611 = ~«Не думаю, что мне всё это надо. Прощай».~
@15612 = ~«Вера может прийти со временем. Или твои убеждения столь сильны, что наша доктрина никогда не придётся тебе по душе?»~
@15613 = ~«Я хотел бы проверить свою неопределённость временем. Я проведу некоторое время с Пыльными, а затем проверю свои убеждения».~
@15614 = ~«Не думаю, что когда-либо приму вашу философию. Я отзываю свою просьбу. У меня другие вопросы…»~
@15615 = ~«Не думаю, что хочу вступать во фракцию Пыльных. Прощай».~
@15616 = ~Эморик кивает: «Ты сделал, как я просил. Хочешь продолжить процедуру посвящения?»~
@15617 = ~«Что? Нет, господин! Я ничего не знаю о… о…» — под твоим тяжёлым взглядом он умолкает, затем вздыхает. Когда он снова открывает рот, его речь спокойна и культурна: «Ладно же. И как ты узнал мою тайну?»~
@15618 = ~«Да. Я хотел бы узнать больше о фракции Пыльных».~
@15619 = ~«Крысолов? Как странно, — он почёсывает подбородок. — Хм-м. А не знаешь ли ты имя сей особы?»~
@15620 = ~«Да. Я всё ещё не уверен, что мои воззрения совместимы с доктриной Пыльных, но я хотел бы узнать больше о вашей фракции перед тем, как принять окончательное решение».~
@15621 = ~«Понятно. Благодарю тебя, — он прерывается; наверное, фиксирует имя в памяти. — Ну, и с какой целью ты явился ко мне?»~
@15622 = ~«Нет. Я хотел бы отозвать свою просьбу о вступлении во фракцию Пыльных».~
@15623 = ~Он грустно качает головой: «Весьма прискорбно. Ну, и с какой целью ты явился ко мне?»~
@15624 = ~Он грустно качает головой: «Можно понять. И всё же, могу ли я что-либо предложить тебе в обмен на сию информацию? Глупо с твоей стороны было бы предавать за так… если только не желаешь им вреда. Ну, и с какой целью ты явился ко мне?»~
@15625 = ~Он смотрит с недоверием: «Что?! Сие просто невозможно! Как… как они посмели! — его глаза темнеют, а губы расходятся, обнажая в оскале кривые чёрные зубы. — Кто? Как их имена? Знаешь ли ты их?»~
@15626 = ~«Никаких вопросов больше не имею».~
@15627 = ~Он ухмыляется: «Трижды Проклятый, ну конечно! О, как они поплатятся за сие, тысячу лет я буду глядеть на их муки!» Он берёт себя в руки: «Ну, и с какой целью ты явился ко мне?»~
@15628 = ~«Хорошо. Но вопросы ещё есть у меня…»~
@15629 = ~Он нехорошо усмехается, сжимая от расстройства кулаки: «Ар-рх! Я их разыщу… о, как они поплатятся за сие, тысячу лет я буду глядеть на их муки!» Он берёт себя в руки: «Ну, и с какой целью ты явился ко мне?»~
@15630 = ~«Тогда я пойду. Прощай».~
@15631 = ~«Неужели? Тогда с какой целью ты явился ко мне?»~
@15632 = ~«Хм-м? — он выглядит сбитым с толку. — И что же сие за кулон?»~
@15633 = ~«Да нет же… совершенно ничего подобного. Откуда могла появилась сия мысль?»~
@15634 = ~«Ты должен пройти ещё одно испытание. Разыщи одного из посвящённых по имени Ожидающий-Смерть. Он здесь, в баре. Он слишком уж страстно стремится к Истинной Смерти. Если он будет в этом упорствовать, то никогда её не достигнет. Поговори с ним и выясни, можно ли ему помочь».~
@15635 = ~Он вздыхает: «Снова, ладно же. И что ты желаешь знать о моём кулоне?»~
@15636 = ~«Я уже поговорил с ним об этом».~
@15637 = ~«Но… — он пятится от тебя. — Я не могу с ним расстаться! Ты не понимаешь… его потеря равносильна смерти!»~
@15638 = ~«Он не хочет говорить со мной».~
@15639 = ~«Сие есть сосуд, ничего более. Кулон может поймать душу, когда она покидает свою умирающую оболочку, и удерживать её до тех пор, пока она не перейдёт на нужный план бытия».~
@15640 = ~«Я поговорю с Ожидающим-Смерть и посмотрю, что можно сделать».~
@15641 = ~«Кулон был сделан по заказу смертного колдуна немалой силы, Йемета. Он искал бессмертия, но идея стать личем его отталкивала. Судя по дневникам, в основу конструкции сего устройства легли его познания в темнейшем искусстве некромантии. Устройство позволяло ему ловить души и использовать их сущности для продления собственного существования, подпитки своих слабеющих к тому моменту жизненных сил».~
@15642 = ~«Я поговорю с ним. Но сначала у меня кое-какие вопросы…»~
@15643 = ~«Сведения об их личностях были утрачены со временем. Некоторые мастера время от времени притязали на честь разработки сего устройства, ходили даже слухи, что задумка родилась в мозгу изверга».~
@15644 = ~«Я отзываю свою просьбу о присоединении к Пыльным».~
@15645 = ~«Мои слова он также не намерен слушать. Я хотел бы услышать твоё мнение об Ожидающем-Смерть».~
@15646 = ~«Имеет ли право Пыльный, в чьей душе бушуют такие страсти, называться Пыльным? По-моему, нет».~
@15647 = ~«Он не Пыльный. Может, станет им со временем».~
@15648 = ~«Он Пыльный».~
@15649 = ~«У меня нет мнения по этому поводу. Что выросло, то выросло».~
@15650 = ~«Йемет был полностью уничтожен в разрушительной магической битве, скорее всего, конкурентом, могущественным магом… предположительно, от него совсем ничего не осталось, и посему силы устройства были бесполезны. Сам же кулон переходил из рук в руки на протяжение столетий, пока не попал ко мне».~
@15651 = ~«Я хотел бы узнать, о чём ты говорил».~
@15652 = ~«Он не хочет говорить со мной. Я пытался, но он не стал меня слушать».~
@15653 = ~«Он предпочёл жизнь смерти. Пока».~
@15654 = ~«Предположительно, да, но я не знаю, как. Ещё раз повторю: кулон не более чем сосуд, для его многочисленных применений необходимы ритуалы и заклятия, кои могли быть навсегда утрачены, умереть вместе с самим Йеметом».~
@15655 = ~«Он выбрал жить дальше и попытаться преодолеть свою тягу к смерти».~
@15656 = ~«Он выбрал терпеть груз жизни, и в этом терпении преодолеть свою тягу к смерти».~
@15657 = ~Он тихо вздыхает: «Процесс, с помощью коего смертный маг или священник становится нежитью великой силы. Процесс длинный и сложный — занимает годы, требует в превеликих количествах магических реагентов и тому подобного — и часто заканчивается неудачей. Лич же — разновидность нежити, наделённая свободой воли, как вампиры, но при этом сохранившая разум и способности, коими смертный обладал при жизни».~
@15658 = ~«Он выбрал жить дальше и учиться тому, как надо умереть».~
@15659 = ~«Сие долгая история. Если ты действительно желаешь знать причину, придётся начать сначала».~
@15660 = ~«Я отзываю свою просьбу о присоединении к Пыльным».~
@15661 = ~«Как ты уже заметил, я баатезу, изверг. Я из так называемых „эриний“, дьявольских искусительниц. Моя подлинная форма отличается невообразимой прелестью, той самой, что заставляет кровь мужчин кипеть желанием, а мелочных женщин скрежетать зубами от ревности».~
@15662 = ~«Я всё объясню в нужное время. Ты будешь слушать или как?»~
@15663 = ~«Нас всего пять сотен по всем планах — ведомо ли тебе сие? Мы редкое и высокомерное племя, завидуем высшим и презираем низших. Помимо красоты, все мои Сёстры и я сама честолюбивы, как и все изверги, и состязаемся друг с другом в том, сколько душ смертных заманим в бездны Баатора».~
@15664 = ~«„Ценнейшие“ из душ — это души тех смертных, кто считал себя наиболее благочестивыми и чистыми… например, духовных особ. И именно задумав сие, я так глупо просчиталась, ослеплённая предполагаемым триумфом в случае успеха с сим обескураживающим предприятием…»~
@15665 = ~«Я пыталась совратить святого человека великой веры, высшего клирика немалой духовной силы. Столь близка я была к победе, — или только мнила сие? — пока в один несчастный день он вдруг не оттолкнул меня».~
@15666 = ~«Я хотел бы узнать, о чём ты говорил».~
@15667 = ~«Он проклял меня, ублюдок, обратил в ту жалкую тварь, коею ты видишь перед собой. Обычно такие шуточки в ходу у дьяволов, но могущество сего смертного было так велико… поистине, то глаза его божества обратились на меня!»~
@15668 = ~«Он предпочёл жизнь смерти. Пока».~
@15669 = ~«Как ты можешь догадаться, мои Сёстры не оказали мне никакой помощи, они жаждали увидеть моё падение и как новая эриния займёт низшее место среди пятисот — сие укрепило бы их собственные позиции».~
@15670 = ~«Он выбрал жить дальше и попытаться преодолеть свою тягу к смерти».~
@15671 = ~«Он выбрал терпеть груз жизни, и в этом терпении преодолеть преодолеть свою тягу к смерти».~
@15672 = ~«Чёрная Восьмёрка, могущественные дьяволы, перед коими отчитываются все эринии, нашли всю эту историю забавной, но не были совсем лишены сострадания — или, скорее, понимали ценность соблазнительницы с таким опытом, как у меня. Мне был предъявлен ультиматум…»~
@15673 = ~«Он выбрал жить дальше и учиться тому, как надо умереть».~
@15674 = ~«Я отзываю свою просьбу о присоединении к Пыльным».~
@15675 = ~«Я должна в течение года отправить в Баатор десять душ… не больше и не меньше. Если я преуспею, то буду восстановлена в моём былом великолепии. Если не справлюсь, я буду понижена до жалкого кокрачона — или даже хуже, до барбазу или… — она вздрагивает, — …до спинагона».~
@15676 = ~«Да, он моя единственная надежда. Я собрала в нём несколько душ, и выпущу их в Бааторе, где они и останутся на веки вечные. Времени осталось очень мало, но мне надо поймать ещё всего одну душу… лишь одну душу, и я воспряну во всём своём великолепии среди моих прекрасных и ужасных Сестёр».~
@15677 = ~Она пятится назад ещё на шаг: «Стой! Ты не понимаешь! Смерть для меня — лишь мелкая неприятность; со временем я просто воскресну в Бааторе. Однако сие продлится дольше отпущенного мне года… я буду разжалована, выброшена из рядов эриний на столетия — а может быть, и навсегда. Понимаешь? Потерять кулон для меня хуже смерти!»~
@15678 = ~«Я хотел бы выслушать твоё мнение о выборе Ожидающего-Смерть».~
@15679 = ~«По двум причинам… одна из них в том, что я не полностью лишена силы. Подумай сам… тот молодой воитель, который защищал меня днём — мой раб; навеки попался он в ловушку моей дьявольской силы. Ты завидуешь его положению?»~
@15680 = ~«Он никогда не будет Пыльным».~
@15681 = ~«Он не Пыльный. Может, станет им со временем».~
@15682 = ~«Нет, но выслушай меня!»~
@15683 = ~«Он — Пыльный. Он выучил свой урок».~
@15684 = ~Она продолжает: «Вторая причина в том, что тебе не дано воспользоваться возможностями кулона, тогда как мне дано. Что ты собираешься с ним делать? Не лучше ли заручиться расположением эринии? Подумай об этом…»~
@15685 = ~«У меня нет мнения по этому поводу. Что выросло, то выросло».~
@15686 = ~«Силу? — она усмехается. — И кто же? Какой вид силы тебе был обещан? Наверняка ничего сравнимого с тем, что могла бы предложить я».~
@15687 = ~Минуту она молча смотрит на тебя. «Не уверен в объёмах или действии силы? Ты подписал договор?»~
@15688 = ~«О, сие как раз крайне важно, поверь мне!»~
@15689 = ~«Без договора изверги не обязаны предоставлять обещанную силу, какая бы то сила ни была. И что, если сила сия придётся тебе не по вкусу?»~
@15690 = ~«Что если у тебя, например, отрастут оленьи рога, дарующие „сверхъестественные оленьи силы“? Или сие будет сила превращаться в фиалку каждые две недели? Ну-ка скажи, будет ли тебе польза от таких сил? Если сии изверги заслуживают своей серы, ты не дождёшься от них ничего, кроме фокусов и пустых обещаний».~
@15691 = ~«Да, есть. Позволь мне оставить кулон у себя, с его помощью я восстановлю своё былое великолепие. Я связана массой обязательств, таких, как кровная месть… но через три года я обязуюсь служить тебе не менее четырёх полных месяцев. Я подпишусь под сим — мы заключим договор по всей форме, стоит тебе согласиться. Подумай, израненный: изверг-слуга или почти бесполезная безделушка?»~
@15692 = ~«Ты поговорил с Посвящённым Ожидающим-Смерть. Твоё мнение о Посвящённом Ожидающим-Смерть мне известно. Ты выполнил моё задание», — Эморик кивает. «Следующее испытание. Я хочу, чтобы ты поговорил с ещё одной Пыльной в баре. Её имя Сере. Она посвящённая Пятого Круга, — Эморик на мгновение замолкает. — Она более не чтит учения Пыльных, как когда-то. В её сердце горечь. Необходимо узнать причину».~
@15693 = ~«Она не хочет говорить со мной».~
@15694 = ~Она тихо посмеивается, качая головой: «Ай-ай! Тебе предлагают исключительно прекрасную и полностью бесстыдную дьяволицу в роли служанки, так? Я оттачивала своё искусство долгие годы, израненный — не назову точный срок, но достаточно долго. Не следовало бы тебе быть таким недальновидным. Если не в силах обуздать нетерпение, я могу служить тебе два месяца через два года».~
@15695 = ~«Я уже поговорил с ней. Полмесяца назад она заболела горячкой и потому боится смерти. Она порицает Пыльных».~
@15696 = ~«Я могу служить тебе шесть месяцев через три года, но не больше. Согласен ли ты на сие?»~
@15697 = ~«Пойду поговорю с ней прямо сейчас».~
@15698 = ~Она кивает. «Хоть я обычно и не веду дела таким образом, но я всё же должна быть к сему готовой…» — она замолкает, хмуро роясь в складках плаща. Наконец её глаза загораются, она находит и вытаскивает перевязанный полупрозрачный свиток. «А! Вот сие…» — она протягивает тебе договор и красное перо для письма.~
@15699 = ~«Я пойду поговорю с ней. Но сперва у меня кое-какие вопросы…»~
@15700 = ~Договор выглядит, будто написан на плоти, а не на пергаменте; письмена похожи на тонкие капилляры под кожей. Кажется, с текстом всё в порядке.~
@15701 = ~«Не хочу я выполнять это задание. Я отзываю свою просьбу о присоединении к Пыльным».~
@15702 = ~Договор выглядит, будто написан на плоти, а не на пергаменте; письмена похожи на тонкие капилляры под кожей. Как ты и подозревал, в тексте скрыто несколько ловушек.~
@15703 = ~Договор выглядит, будто написан на плоти, а не на пергаменте; письмена похожи на тонкие капилляры под кожей. Твои умозаключения, что в тексте наверняка будут скрыты ловушки, оказываются верными.~
@15704 = ~Договор выглядит, будто написан на плоти, а не на пергаменте; письмена похожи на тонкие капилляры под кожей. Твои умозаключения, что в тексте наверняка будут скрыты ловушки, оказываются верными. Ты ищешь лазейки, которые можно обратить в твою пользу, но не можешь найти ни одной.~
@15705 = ~Договор выглядит, будто написан на плоти, а не на пергаменте; письмена похожи на тонкие капилляры под кожей. Ты сразу находишь в документе несколько ловушек, некоторые из них просто прекрасно замаскированы. Ты также видишь несколько лазеек, которые можно обратить в твою пользу.~
@15706 = ~«Разумеется, ничего другого я от тебя и не ожидала», — вы с дьяволицей начинаете править договор, споря о каждой мелочи, идя на компромиссы и маневрируя, и у тебя возникает чувство, что ты и раньше занимался подобным…~
@15707 = ~Когда ты заканчиваешь подписывать договор, и он, и перо растворяются в воздухе, оставив после себя ароматное облачко красноватого дыма. «Прощай, странник… увидимся снова, когда пройдёт должное время, и тогда я буду служить тебе, как уговорено», — она кланяется и собирается уходить.~
@15708 = ~«Какого ещё, господин? У меня нет украшений…»~
@15709 = ~«Ты получишь ответы, кои в моих силах».~
@15710 = ~«Но почему?»~
@15711 = ~«И что же ты собираешься с ним делать? Беречь от попадания в плохие руки? Продать? Обменять? Ну и как думаешь, что будет делать с кулоном новый владелец?»~
@15712 = ~«Только если ты найдёшь способ спрятать его туда, где никто не найдёт. Сама его природа залогом, что никакого добра от него быть не может. По некоторым причинам кулон лучше оставить мне, уверяю тебя».~
@15713 = ~Она выглядит шокированной. «И как у тебя только язык поворачивается? Хочешь ограбить меня, как самый обыкновенный бандит, украсть мою единственную и верную надежду, разбить мои мечты на кусочки, а потом говоришь мне, что причины сего — не моё дело?»~
@15714 = ~«Ты сильно ошибаешься, меня это касается в первую очередь… Как я могу сделать тебе контрпредложение, если не знакома с условиями действующего договора?»~
@15715 = ~«Просто заносчивый молодой дворянин, к тому же непревзойдённый фехтовальщик. Он мой раб, хотя и не осознаёт сего, пока я не решу его отпустить или уничтожить».~
@15716 = ~«Просто заносчивый молодой дворянин, к тому же непревзойдённый фехтовальщик. Он был моим рабом, хотя и не осознавал сего, и невольно служил мне защитником».~
@15717 = ~Наконец вы заканчиваете обсуждение договора. «Ну? Ты удовлетворён?»~
@15718 = ~Поразмыслив как следует, ты понимаешь, что определённо имел дело с подобным и раньше. Дни, проведённые над заплесневелыми манускриптами и правовыми документами, осторожно составленные фразы со скрытым вторым смыслом, лазейки в лазейках, ложь, запрятанная среди правды, жонглирование законами и обещаниями до тех пор, пока не станет трудно вообще хоть в чём-то разобраться… воспоминания обо всём этом и многом другом всплывают в твоей памяти.~
@15719 = ~«Никаких вопросов. При следующей встрече у нас будет уйма времени на разговоры, тогда и спросишь всё, что пожелаешь. Прощай».~
@15720 = ~Мальрик Волокита стоит и смотрит в пустоту. «Он» кажется отрешённым от всего окружающего.~
@15721 = ~«Приветствую…»~
@15722 = ~Напасть на него.~
@15723 = ~Оставить его в покое.~
@15724 = ~«Нам нужно поговорить…»~
@15725 = ~Напасть на него.~
@15726 = ~«Просто проходил мимо. Прощай».~
@15727 = ~«Можешь больше не притворяться. Я знаю, кто ты, изверг».~
@15728 = ~«Как насчёт твоего кулона?»~
@15729 = ~«О твоей смерти…»~
@15730 = ~«Ни о чём, неважно. Прощай».~
@15731 = ~«Мне рассказал крысолов».~
@15732 = ~«От пары извергов».~
@15733 = ~«Не твоё дело. У меня кое-какие вопросы…»~
@15734 = ~«Да. Его зовут Крысёныш».~
@15735 = ~«Я хотел бы знать, что она сказала тебе».~
@15736 = ~Ложь: «Нет, не знаю».~
@15737 = ~«Она не хочет говорить со мной».~
@15738 = ~«Не могу сказать».~
@15739 = ~«Полмесяца назад она заболела горячкой и потому боится смерти. Она порицает Пыльных».~
@15740 = ~«Пока ничего важного. Пойду поговорю с ней снова».~
@15741 = ~«Я отзываю свою просьбу о присоединении к Пыльным».~
@15742 = ~«За твоим кулоном».~
@15743 = ~«У меня кое-какие вопросы…»~
@15744 = ~«Я хотел бы знать, что ты ей сказал».~
@15745 = ~«За твоей смертью…»~
@15746 = ~«Я сказал, что её страх и сомнения определили её будущее. Она не Пыльная».~
@15747 = ~«Я сказал, что её страх пройдёт. Время покажет, Пыльная она или нет».~
@15748 = ~«На самом деле ни с какой. Прощай».~
@15749 = ~«Я сказал, что её страх пройдёт. Время покажет, Пыльная она или нет».~
@15750 = ~«Я нашёл источник её беспокойства, но не смог помочь ей советом».~
@15751 = ~«Меня она также слушать не намерена, — Эморик кивает. — Ты выполнил моё задание. Хочешь продолжить процедуру посвящения?»~
@15752 = ~«Не хочу говорить. Я отзываю свою просьбу о присоединении к Пыльным».~
@15753 = ~«Да. Я должен узнать больше о фракции Пыльных. Я хочу продолжить испытание».~
@15754 = ~«Нет. Я отзываю свою просьбу о присоединении к Пыльным».~
@15755 = ~«Ты выполнил моё задание. Хочешь продолжить процедуру посвящения?»~
@15756 = ~«Да. Я должен узнать больше о фракции Пыльных. Я хочу продолжить испытание».~
@15757 = ~«Не думаю, что могу научиться ещё чему-то. Я отзываю свою просьбу о присоединении к Пыльным».~
@15758 = ~«Посвящённый Пятого круга, Соэго, отправился в миссионерское путешествие от фракции Пыльных, — Эморик на минуту замолкает… ты не знаешь, в раздумье или в смущении. — Его путь не известен ни мне, ни фракции. Я хотел бы знать его местонахождение».~
@15759 = ~«Разве Соэго не в Мортуарии?»~
@15760 = ~«Я думал, я уби… э-э, я слышал, он стал жертвой несчастного случая. Разве он уже не в Мортуарии?»~
@15761 = ~«Я уже нашёл его».~
@15762 = ~«Я уже нашёл его».~
@15763 = ~«Тогда я отправлюсь на поиски. Но сначала я хотел задать кое-какие вопросы…»~
@15764 = ~«Не хочу я выполнять это задание. Я отзываю свою просьбу о присоединении к Пыльным».~
@15765 = ~«Нет, он теперь не там. Его отбытие было внезапным».~
@15766 = ~«Тогда я отправлюсь на поиски. Но сначала я хотел задать кое-какие вопросы…»~
@15767 = ~«Тогда я отправлюсь на поиски. Прощай».~
@15768 = ~«Я отзываю свою просьбу о присоединении к Пыльным».~
@15769 = ~«Я хотел бы знать, где он находится».~
@15770 = ~«Я нашёл его в катакомбах под Сигилом. Он там умер».~
@15771 = ~«Я нашёл его в катакомбах под Сигилом».~
@15772 = ~«Не хочу говорить. Я отзываю свою просьбу о присоединении к Пыльным».~
@15773 = ~«Почему он там?»~
@15774 = ~«Не знаю».~
@15775 = ~~
@15776 = ~«Он встретил группу нежити — стражей катакомб. Он пытается убедить их присоединиться к Истинной Смерти».~
@15777 = ~~
@15778 = ~«Он заразился ликантропией. Его разум более ему не принадлежит, а его убеждения Пыльного утрачены».~
@15779 = ~«Не хочу говорить. Я отзываю свою просьбу о присоединении к Пыльным».~
@15780 = ~«Почему он оказался там?»~
@15781 = ~«Не знаю».~
@15782 = ~~
@15783 = ~«Он встретил группу нежити — стражей катакомб. Он пытался убедить их присоединиться к Истинной Смерти».~
@15784 = ~~
@15785 = ~«Он заразился ликантропией, и она загнала его в катакомбы. Его разум более ему не принадлежал, а его убеждения Пыльного были утрачены».~
@15786 = ~«Не хочу говорить. Я отзываю свою просьбу о присоединении к Пыльным».~
@15787 = ~«За твоим кулоном».~
@15788 = ~«У меня кое-какие вопросы…»~
@15789 = ~«За твоей смертью…»~
@15790 = ~«Хорошо. Ты нашёл его, — Эморик не реагирует на твой ответ ничем, кроме короткого кивка. — Ты выполнил все задания, которые я тебе дал. Я провозглашаю тебя Пыльным, Посвящённым Пятого круга. Ты по-прежнему хочешь вступить в нашу фракцию?»~
@15791 = ~«Да».~
@15792 = ~«Нет. Я передумал».~
@15793 = ~«На самом деле ни с какой. Прощай».~
@15794 = ~«Для посвящения требуется принести клятву».~
@15795 = ~~
@15796 = ~«За твоим кулоном».~
@15797 = ~«Клятву?»~
@15798 = ~«Ты должен поклясться служить Пыльным. Ты должен поклясться, что оставил Жизнь позади себя. Ты должен поклясться, что твоя цель — достичь Истинной Смерти».~
@15799 = ~«У меня вопросы…»~
@15800 = ~«Э-э… нет, спасибо».~
@15801 = ~«За твоей смертью…»~
@15802 = ~«Отлично».~
@15803 = ~«На самом деле ни с какой. Прощай».~
@15804 = ~«Да. Этельгрин и Тегар'ин Трижды Проклятый».~
@15805 = ~Ложь: «Нет, не знаю».~
@15806 = ~«Не могу сказать».~
@15807 = ~«За твоим кулоном».~
@15808 = ~«У меня вопросы…»~
@15809 = ~«За твоей смертью…»~
@15810 = ~«На самом деле ни с какой. Прощай».~
@15811 = ~«За твоим кулоном».~
@15812 = ~«У меня вопросы…»~
@15813 = ~«За твоей смертью…»~
@15814 = ~«На самом деле ни с какой. Прощай».~
@15815 = ~«За твоим кулоном».~
@15816 = ~«У меня вопросы…»~
@15817 = ~«За твоей смертью…»~
@15818 = ~«На самом деле ни с какой. Прощай».~
@15819 = ~«Не трать моё время. Ты знаешь, о чём я говорю».~
@15820 = ~«Разве у тебя нет кулона? В форме черепа?»~
@15821 = ~«Не бери в голову. Я хотел задать кое-какие вопросы…»~
@15822 = ~«Забудь, что я спрашивал. Прощай».~
@15823 = ~«Не трать моё время. Ты знаешь, о чём я говорю».~
@15824 = ~«Тогда ты не будешь возражать, если я обыщу тебя…»~
@15825 = ~«Не бери в голову, забудем про кулон. Я хотел задать кое-какие вопросы…»~
@15826 = ~«Забудь, что я спрашивал. Прощай».~
@15827 = ~«Я хочу получить его».~
@15828 = ~«Что это такое?»~
@15829 = ~«Не бери в голову, забудем про кулон. Я хотел задать кое-какие вопросы…»~
@15830 = ~«Тогда ты умрёшь…»~
@15831 = ~«Но почему? Что это такое?»~
@15832 = ~«Не бери в голову, забудем про кулон. Я хотел задать кое-какие вопросы…»~
@15833 = ~«Зачем понадобилось делать такую штуку?»~
@15834 = ~«Зачем он тебе?»~
@15835 = ~Правда: «Хватит. Отдавай кулон, или умрёшь».~
@15836 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@15837 = ~«У меня другие вопросы…»~
@15838 = ~«Это всё, что я хотел узнать. Прощай».~
@15839 = ~«Стать личем?»~
@15840 = ~«А кто именно сделал кулон?»~
@15841 = ~«Тогда как он потерял кулон?»~
@15842 = ~«Его можно использовать для увеличения чьей-то силы?»~
@15843 = ~«Ещё раз: ты веришь в догматы Пыльных?»~
@15844 = ~Ложь: «Да».~
@15845 = ~«Да».~
@15846 = ~«Нет. Я передумал».~
@15847 = ~«Зачем он тебе?»~
@15848 = ~«Я буду твоим свидетелем. Приноси клятву».~
@15849 = ~Клятва: «Я клянусь служить Пыльным. Я оставил Жизнь позади. Я ищу только Истинной Смерти».~
@15850 = ~Ложь: «Я клянусь служить Пыльным. Я оставил Жизнь позади. Я ищу только Истинной Смерти».~
@15851 = ~«Нет. Я передумал».~
@15852 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@15853 = ~«Теперь ты причислен к Мёртвым. Я должен сообщить тебе несколько вещей».~
@15854 = ~Слушать.~
@15855 = ~«Ходячие трупы обитают вместе с Пыльными. Работают с Пыльными. Хотя в других условиях они — враги живых».~
@15856 = ~«Это не ускользнуло от моего внимания».~
@15857 = ~«Пыльные находятся в состоянии перемирия со всеми Мёртвыми. Это перемирие известно как *Перемирие Мёртвых*. Мёртвые никогда не причинят вреда Пыльному, пока мы его придерживаемся», — Эморик выделяет эти слова интонацией. Внезапно заднюю часть твоего черепа охватывает странное чувство… ты что-то знаешь о Перемирии Мёртвых, но не может вспомнить, что именно.~
@15858 = ~«Понятно».~
@15859 = ~«У меня другие вопросы…»~
@15860 = ~«Хм… да, полагаю, они никогда не причинят вреда настоящему Пыльному… а вот у тех, кто только называет себя Пыльными, такой защиты нет».~
@15861 = ~«Хм… да, полагаю, они никогда не причинят вреда настоящему Пыльному… а вот у тех, кто только называет себя Пыльными, такой защиты нет».~
@15862 = ~«Хм… да, полагаю, они никогда не причинят вреда настоящему Пыльному… а вот у тех, кто только называет себя Пыльными, такой защиты нет».~
@15863 = ~«Хм… да, полагаю, они никогда не причинят вреда настоящему Пыльному… а вот у тех, кто только называет себя Пыльными, такой защиты нет».~
@15864 = ~«Это всё, что я хотел узнать. Прощай».~
@15865 = ~«Как Йемет потерял кулон?»~
@15866 = ~«Его можно использовать для увеличения чьей-то силы?»~
@15867 = ~«Далее. Существуют магические способы продления жизни и вмешательства в смерть. Эта магия в нашей фракции предана анафеме. Она редко действует на наших членов. Ничто не должно сбивать Пыльного с пути к Истинной Смерти. Понятно?»~
@15868 = ~«Зачем он тебе?»~
@15869 = ~~
@15870 = ~Правда: «Хватит. Отдавай кулон, или умрёшь».~
@15871 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@15872 = ~«У меня другие вопросы…»~
@15873 = ~~
@15874 = ~«Это всё, что я хотел узнать. Прощай».~
@15875 = ~«А что если есть… сложности… для человека по части собственно смерти?»~
@15876 = ~«Заклинания лечения сюда относятся?»~
@15877 = ~«У меня вопрос относительно Перемирия Мёртвых…»~
@15878 = ~«Хм… да, полагаю, табу на воскрешение относится только к настоящим Пыльным, так? А заклинания лечения оно не запрещает?»~
@15879 = ~«Хм… да, полагаю, табу на воскрешение относится только к настоящим Пыльным, так? А заклинания лечения оно не запрещает?»~
@15880 = ~«Хм… да, полагаю, табу на воскрешение относится только к настоящим Пыльным, так? А заклинания лечения оно не запрещает?»~
@15881 = ~«Хм… да, полагаю, табу на воскрешение относится только к настоящим Пыльным, так? А заклинания лечения оно не запрещает?»~
@15882 = ~«Понятно. Теперь, когда я стал Пыльным, у меня появились кое-какие вопросы о фракции…»~
@15883 = ~«У меня вопросы, не относящиеся к фракции…»~
@15884 = ~«Понятно. Прощай».~
@15885 = ~Эморик ждёт.~
@15886 = ~«Насчёт этой философии „ничто не должно мешать Истинной Смерти“… А что если есть… сложности… для человека по части собственно смерти?»~
@15887 = ~«Это правило „запрета на воскрешение“ включает в себя заклинания лечения?»~
@15888 = ~«У меня вопрос относительно Перемирия Мёртвых».~
@15889 = ~«Как Пыльный, какого вида помощь я могу получить?»~
@15890 = ~«Мне нужна помощь».~
@15891 = ~«У меня вопросы, не относящиеся к фракции…»~
@15892 = ~«Неважно. Прощай».~
@15893 = ~«Природа твоего вопроса неясна, Посвящённый».~
@15894 = ~Правда: «Полагаю, я бессмертен».~
@15895 = ~Правда: «Полагаю, я бессмертен».~
@15896 = ~«Ну, я знаю одного бессмертного и спрашиваю о нём».~
@15897 = ~«А что если в вопросе речь идёт о бессмертном Пыльном?»~
@15898 = ~«Не бери в голову. У меня другие вопросы о фракции…»~
@15899 = ~«Забудь. У меня вопросы, не относящиеся к фракции…»~
@15900 = ~«Неважно. Прощай».~
@15901 = ~«Что побудило тебя сказать такое, Посвящённый?»~
@15902 = ~«Кажется, я не могу умереть. Мои раны моментально заживают».~
@15903 = ~«Не бери в голову. У меня другие вопросы о фракции…»~
@15904 = ~«Забудь. У меня вопросы, не относящиеся к фракции…»~
@15905 = ~«Прощай».~
@15906 = ~Эморик пристально на тебя смотрит: «Покажи мне, Посвящённый».~
@15907 = ~Показать.~
@15908 = ~«Не бери в голову. У меня другие вопросы о фракции…»~
@15909 = ~«Забудь… я неудачно выразился. У меня вопросы, не относящиеся к фракции…»~
@15910 = ~«Я неудачно выразился. Прощай».~
@15911 = ~Ты делаешь неглубокий разрез, и ранка почти сразу же затягивается. Эморик не отрываясь смотрит, как заживает ранка, и после продолжительного молчания произносит: «Что-то в твоей натуре сопротивляется Истинной Смерти. Более ты не Пыльный. Ты должен уйти».~
@15912 = ~«Если должен… я слагаю с себя звание Пыльного. Прощай».~
@15913 = ~Эморик задумывается: «Тогда… этот твой знакомый… жестоко страдает. Он запер себя в этом лживом существовании и не может достичь Истинной Смерти».~
@15914 = ~«Запер *себя*?»~
@15915 = ~«Зачем кому-то оставаться запертым в этом лживом существовании?»~
@15916 = ~«Ясно. У меня другие вопросы о фракции…»~
@15917 = ~«У меня вопросы, не относящиеся к фракции…»~
@15918 = ~«Понял. Прощай».~
@15919 = ~«Для достижения Истинной Смерти необходимо побороть все страсти и все привязанности к этому лживому существованию. Эти вещи — якорь для духа. Многие создания, такие, как призраки или другие неупокоенные духи, привязаны к этому лживому существованию неутолёнными страстями».~
@15920 = ~«Когда ты говорил, что этот бессмертный привязал себя к этой жизни, что ты имел в виду?»~
@15921 = ~«Ясно. У меня другие вопросы о фракции…»~
@15922 = ~«У меня вопросы, не относящиеся к фракции…»~
@15923 = ~«Ясно. Спасибо за информацию. Прощай».~
@15924 = ~«Тогда он не может быть Пыльным. Его вера в бессмертие будет удерживать Посвящённого в этой жизни, и он никогда не достигнет Истинной Смерти, — Эморик на миг замолкает. — Что заставило тебя задать такой вопрос, Посвящённый?»~
@15925 = ~Правда: «Полагаю, я бессмертен».~
@15926 = ~Правда: «Полагаю, я бессмертен».~
@15927 = ~«Знаешь, у меня есть бессмертный знакомый. Я спрашивал о нём».~
@15928 = ~«Его удерживает *вера*? Как это?»~
@15929 = ~«Просто так. У меня другие вопросы о фракции…»~
@15930 = ~«Не бери в голову. У меня вопросы, не относящиеся к фракции…»~
@15931 = ~«Просто спросил. Прощай».~
@15932 = ~«Лечебная магия работает как обычно. А вот магия воскрешения и реинкарнации не должна использоваться членами нашего ордена. Подобная магия сбивает верующего с пути к Истинной Смерти».~
@15933 = ~«Ясно. У меня другие вопросы о фракции…»~
@15934 = ~«У меня вопросы, не относящиеся к фракции…»~
@15935 = ~«Хорошо. Мне пора идти. Прощай».~
@15936 = ~Эморик ждёт.~
@15937 = ~«Что будет, если я нападу на одного из ходячих мертвецов?»~
@15938 = ~«А что по поводу самозащиты?»~
@15939 = ~«У меня другие вопросы о фракции…»~
@15940 = ~«У меня вопросы, не относящиеся к фракции…»~
@15941 = ~«Ладно. Мне пора идти. Прощай».~
@15942 = ~«Тогда ты нарушишь Перемирие Мёртвых».~
@15943 = ~«А что по поводу самозащиты?»~
@15944 = ~«Ясно. У меня другие вопросы о фракции…»~
@15945 = ~«У меня вопросы, не относящиеся к фракции…»~
@15946 = ~«Ладно. Мне пора идти. Прощай».~
@15947 = ~«Невозможна ситуация, в которой Мёртвый напал бы на тебя, пока соблюдается Перемирие».~
@15948 = ~«А что будет, если я нападу на одного из них?»~
@15949 = ~«Ясно. У меня другие вопросы о фракции…»~
@15950 = ~«У меня вопросы, не относящиеся к фракции…»~
@15951 = ~«Хорошо. Мне пора идти, прощай».~
@15952 = ~«Чем мы можем помочь тебе, Посвящённый?»~
@15953 = ~«Мне нужно лечение».~
@15954 = ~«Мне нужно место для отдыха».~
@15955 = ~«У вас есть какие-нибудь заклинания или предметы, которые могли бы мне помочь?»~
@15956 = ~«Ничем, забудь. У меня ещё кое-какие вопросы о фракции…»~
@15957 = ~«У меня вопросы, не относящиеся к фракции…»~
@15958 = ~«Ничего сегодня не надо. Прощай».~
@15959 = ~Эморик слегка склоняет голову, и ты чувствуешь, как через твоё тело проходит волна холодного оцепенения, как если бы твои кости и мышцы обратились в камень. По мере того как холод в теле рассеивается, боль от ран исчезает. Через несколько секунд ощущения возвращаются… но боли больше нет.~
@15960 = ~«Спасибо. У меня ещё кое-какие вопросы о фракции…»~
@15961 = ~«Я снова здоров. У меня вопросы, не относящиеся к фракции…»~
@15962 = ~«Спасибо. Прощай».~
@15963 = ~«Ты можешь отдыхать здесь, Посвящённый».~
@15964 = ~«Спасибо тебе…»~
@15965 = ~Через некоторое время ты просыпаешься со свежими силами, затем возвращаешься к Эморику.~
@15966 = ~«Я отдохнул, спасибо тебе. У меня ещё кое-какие вопросы о фракции…»~
@15967 = ~«Я снова здоров. У меня вопросы, не относящиеся к фракции…»~
@15968 = ~«Спасибо, что позволил мне отдохнуть. Прощай».~
@15969 = ~«Если ты желаешь вступить в ряды Пыльных, озвучь мне свою просьбу».~
@15970 = ~«Да, я желаю вступить в ряды Пыльных».~
@15971 = ~«Ты неправильно понял мои намерения. Я не *желаю* вступить в ряды Пыльных. Я просто верую в то, во что веруют Пыльные».~
@15972 = ~«Неважно. У меня другие вопросы…»~
@15973 = ~«Не сегодня. Мне пора идти, прощай».~
@15974 = ~«Как Посвящённый фракции Пыльных ты имеешь доступ в наше хранилище знаний, в хранилище магии и предметов. Ты можешь также обратиться ко мне, если тебе необходимо лечение тела, или если необходимо отдохнуть».~
@15975 = ~«Мне нужно лечение».~
@15976 = ~«Мне нужно место для отдыха».~
@15977 = ~«Что у вас есть в хранилище?»~
@15978 = ~«Ясно. У меня другие вопросы о фракции…»~
@15979 = ~«Хорошо. У меня вопросы, не относящиеся к фракции…»~
@15980 = ~«Спасибо. Прощай».~
@15981 = ~Когда ты уже готов заговорить, ты чувствуешь покалывание в задней части черепа. У тебя возникает чувство, что говорить о своей «особенности» Эморику не самая лучшая идея. Он всё ещё смотрит на тебя, ожидая ответа.~
@15982 = ~Правда: «Полагаю, я бессмертен».~
@15983 = ~«Ну, я знаю одного бессмертного и спрашиваю о нём».~
@15984 = ~«А что если в вопросе речь идёт о бессмертном Пыльном?»~
@15985 = ~«Не бери в голову. У меня другие вопросы о фракции…»~
@15986 = ~«Забудь. У меня вопросы, не относящиеся к фракции…»~
@15987 = ~«Неважно. Прощай».~
@15988 = ~«Тебе нужно что-нибудь ещё, Посвящённый?»~
@15989 = ~«Мне нужно лечение».~
@15990 = ~«Мне нужно место для отдыха».~
@15991 = ~«Я хотел бы снова заглянуть в хранилище».~
@15992 = ~«У меня ещё кое-какие вопросы о фракции…»~
@15993 = ~«Да. У меня вопросы, не относящиеся к фракции…»~
@15994 = ~«Ничего сегодня не надо. Прощай».~
@15995 = ~«Бессмертие — это выбор. Вера — во что бы ты ни верил — влияет на плоть. Человек бессмертен потому, что он не *хочет* отбросить жизнь».~
@15996 = ~«Но тогда, по твоей же логике, смерть — это тоже выбор. Почему же люди умирают в первом попавшемся месте?»~
@15997 = ~«Зачем кому-то оставаться запертым в этом лживом существовании?»~
@15998 = ~«Ясно. У меня другие вопросы о фракции…»~
@15999 = ~«Хм-м-м. У меня вопросы, не относящиеся к фракции…»~
@16000 = ~«Интересно. Прощай».~
@16001 = ~«Смерть — тоже выбор. Но, в отличие от бессмертия, в смерть верят многие. Их вера разрешает им умирать, — Эморик выдерживает паузу. — Мы не собираемся жить вечно, Посвящённый. В наших головах мы принимаем это за истину».~
@16002 = ~«Так… зачем кому-то оставаться запертым в этом лживом существовании?»~
@16003 = ~«Ясно. У меня другие вопросы о фракции…»~
@16004 = ~«Хм-м-м. У меня вопросы, не относящиеся к фракции…»~
@16005 = ~«Интересно. Прощай».~
@16006 = ~«Кто именно сделал кулон?»~
@16007 = ~«Его можно использовать для увеличения чьей-то силы?»~
@16008 = ~«Зачем он тебе?»~
@16009 = ~Правда: «Хватит. Отдавай кулон, или умрёшь».~
@16010 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@16011 = ~«У меня другие вопросы…»~
@16012 = ~«Это всё, что я хотел узнать. Прощай».~
@16013 = ~«Кто именно сделал кулон?»~
@16014 = ~«Как Йемет потерял кулон?»~
@16015 = ~«Зачем он тебе?»~
@16016 = ~Правда: «Хватит. Отдавай кулон, или умрёшь».~
@16017 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@16018 = ~«У меня другие вопросы…»~
@16019 = ~«Это всё, что я хотел узнать. Прощай».~
@16020 = ~«Кто сделал этот кулон?»~
@16021 = ~«Как Йемет потерял кулон?»~
@16022 = ~«Кулон можно использовать для увеличения чьей-то силы?»~
@16023 = ~«Для чего тебе кулон?»~
@16024 = ~Правда: «Хватит. Отдавай кулон, или умрёшь».~
@16025 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@16026 = ~«У меня другие вопросы…»~
@16027 = ~«Это всё, что я хотел узнать. Прощай».~
@16028 = ~«Хорошо. Продолжай…»~
@16029 = ~Правда: «Хватит. Отдавай кулон, или умрёшь».~
@16030 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@16031 = ~«Наверное, в другой раз. У меня были кое-какие вопросы…»~
@16032 = ~«Может, в другой раз. Прощай».~
@16033 = ~«Как я могу быть в этом уверенным?»~
@16034 = ~«Ясно. Продолжай…»~
@16035 = ~Правда: «Хватит. Отдавай кулон, или умрёшь».~
@16036 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@16037 = ~«Дослушаю в другой раз. У меня были кое-какие вопросы…»~
@16038 = ~«Пока это всё, что я хотел узнать. Прощай».~
@16039 = ~«Да. Продолжай…»~
@16040 = ~Правда: «Хватит. Отдавай кулон, или умрёшь».~
@16041 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@16042 = ~«Дослушаю в другой раз. У меня были кое-какие вопросы…»~
@16043 = ~«Пока это всё, что я хотел узнать. Прощай».~
@16044 = ~«Продолжай…»~
@16045 = ~Правда: «Хватит. Отдавай кулон, или умрёшь».~
@16046 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@16047 = ~«Дослушаю в другой раз. У меня были кое-какие вопросы…»~
@16048 = ~«Пока это всё, что я хотел узнать. Прощай».~
@16049 = ~Слушать дальше.~
@16050 = ~Правда: «Хватит. Отдавай кулон, или умрёшь».~
@16051 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@16052 = ~«Дослушаю в другой раз. У меня были кое-какие вопросы…»~
@16053 = ~«Пока это всё, что я хотел узнать. Прощай».~
@16054 = ~«Продолжай…»~
@16055 = ~Правда: «Хватит. Отдавай кулон, или умрёшь».~
@16056 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@16057 = ~«Дослушаю в другой раз. У меня были кое-какие вопросы…»~
@16058 = ~«Пока это всё, что я хотел узнать. Прощай».~
@16059 = ~«Проклял, обратив в форму отвратительного мужчины? Иронично. Продолжай…»~
@16060 = ~«Дослушаю в другой раз. У меня были кое-какие вопросы…»~
@16061 = ~«Пока это всё, что я хотел узнать. Прощай».~
@16062 = ~«Продолжай…»~
@16063 = ~Правда: «Хватит. Отдавай кулон, или умрёшь».~
@16064 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@16065 = ~«Дослушаю в другой раз. У меня были кое-какие вопросы…»~
@16066 = ~«Пока это всё, что я хотел узнать. Прощай».~
@16067 = ~«Продолжай…»~
@16068 = ~Правда: «Хватит. Отдавай кулон, или умрёшь».~
@16069 = ~Блеф: «Хватит. Отдавай кулон, или умрёшь».~
@16070 = ~«Дослушаю в другой раз. У меня были кое-какие вопросы…»~
@16071 = ~«Пока это всё, что я хотел узнать. Прощай».~
@16072 = ~«Так этот кулон…»~
@16073 = ~Правда: «Интересная сказочка. Теперь давай сюда цацку, или умрёшь».~
@16074 = ~Блеф: «Интересная сказочка. Теперь давай сюда цацку, или умрёшь».~
@16075 = ~«Ясно. Но я должен забрать кулон».~
@16076 = ~«Не бери в голову, забудем про кулон. У меня были кое-какие вопросы…»~
@16077 = ~«Тогда оставь кулон себе. Прощай».~
@16078 = ~«Почему это должно волновать меня?»~
@16079 = ~Напасть на него.~
@16080 = ~«Забудь, оставь кулон себе. Прощай».~
@16081 = ~«Ты мне угрожаешь?»~
@16082 = ~«Нет, но какова вторая причина?»~
@16083 = ~«Ты блефуешь. Я знаю, что проклятие сделало тебя слабой».~
@16084 = ~Напасть на него, пока он ничего больше не сказал.~
@16085 = ~«Забудь, оставь кулон себе. Прощай».~
@16086 = ~«Всего лишь вопрос могущества. Мне обещали силу за его доставку».~
@16087 = ~«Тебе есть что мне предложить?»~
@16088 = ~«Хватит трепотни, я просто тебя зарежу и заберу кулон».~
@16089 = ~«Забудь, оставь кулон себе. Прощай».~
@16090 = ~«Пара извергов, но я не уверен, какого вида эта сила».~
@16091 = ~«Тебя это не касается».~
@16092 = ~«Хватит трепотни, я просто тебя зарежу и заберу кулон».~
@16093 = ~«Забудь, оставь кулон себе. Прощай».~
@16094 = ~«Нет».~
@16095 = ~«Какое это имеет значение?»~
@16096 = ~«Хватит трепотни, я просто тебя зарежу и заберу кулон».~
@16097 = ~«Забудь, оставь кулон себе. Прощай».~
@16098 = ~«Что ты имеешь в виду?»~
@16099 = ~«Хватит трепотни, я просто тебя зарежу и заберу кулон».~
@16100 = ~«Забудь, оставь кулон себе. Прощай».~
@16101 = ~«Тебе есть что мне предложить?»~
@16102 = ~«Хватит трепотни, я просто тебя зарежу и заберу кулон».~
@16103 = ~«Забудь, оставь кулон себе. Прощай».~
@16104 = ~«Согласен. Дай я посмотрю договор».~
@16105 = ~«Три года ожидания — слишком большой срок».~
@16106 = ~«Я хочу восемь месяцев. Можешь ли ты служить такой срок?»~
@16107 = ~«Хватит трепотни, я просто тебя зарежу и заберу кулон».~
@16108 = ~«Забудь, оставь кулон себе. Прощай».~
@16109 = ~«Я согласен на два месяца службы через два года».~
@16110 = ~«Я согласен на четыре месяца службы через три года».~
@16111 = ~«Я хочу восемь месяцев. Можешь ли ты служить такой срок?»~
@16112 = ~«Хватит трепотни: я просто тебя зарежу и заберу кулон».~
@16113 = ~«Забудь, оставь кулон себе. Прощай».~
