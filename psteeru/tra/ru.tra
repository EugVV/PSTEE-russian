@16137 = ~«Некоторые тонкости нуждаются в пересмотре…»~
@16138 = ~Подписать договор в исходном виде.~
@16139 = ~«Я передумал, лучше просто зарежу тебя и заберу кулон».~
@16140 = ~«Забудь, оставь кулон себе. Прощай».~
@16141 = ~«Некоторые тонкости нуждаются в пересмотре…»~
@16142 = ~Подписать договор в исходном виде.~
@16143 = ~«Я передумал, лучше просто зарежу тебя и заберу кулон».~
@16144 = ~«Забудь, оставь кулон себе. Прощай».~
@16145 = ~Попытаться вспомнить.~
@16146 = ~Подавить воспоминания.~
@16147 = ~«Подожди. У меня были кое-какие вопросы…»~
@16148 = ~Отпустить его.~
@16149 = ~«Можешь больше не притворяться. Я знаю, кто ты, изверг».~
@16150 = ~«Хватит разговоров… я просто тебя зарежу и заберу его».~
@16151 = ~«Неважно. Прощай».~
@16152 = ~«Почему ты здесь?»~
@16153 = ~«Расскажи мне свою историю ещё раз».~
@16154 = ~«Расскажи мне о своём кулоне».~
@16155 = ~«Кто этот повеса, который стоит тут каждый день?»~
@16156 = ~«Кто был тот повеса, который стоял тут каждый день?»~
@16157 = ~«Забудь, просто отдавай мне кулон».~
@16158 = ~«Забудь, просто отдавай мне кулон».~
@16159 = ~«Неважно. Прощай».~
@16160 = ~«Потому что мне обещали силу за его доставку».~
@16161 = ~«Потому что ты творишь с его помощью зло».~
@16162 = ~«Не твоё дело».~
@16163 = ~«Хватит трепотни: я просто тебя зарежу и заберу кулон».~
@16164 = ~«Не бери в голову, забудем пока про кулон. У меня были вопросы…»~
@16165 = ~«Забудь, оставь кулон себе. Прощай».~
@16166 = ~«Ничего хуже того, что делаешь с ним ты».~
@16167 = ~«Я обменяю его двум извергам на силу».~
@16168 = ~«Хватит трепотни, я просто тебя зарежу и заберу кулон».~
@16169 = ~«Не бери в голову, забудем пока про кулон. У меня были вопросы…»~
@16170 = ~«Забудь, оставь кулон себе. Прощай».~
@16171 = ~«И каким же?»~
@16172 = ~«Хватит трепотни, я просто тебя зарежу и заберу кулон».~
@16173 = ~«Не бери в голову, забудем пока про кулон. У меня были вопросы…»~
@16174 = ~«Забудь, оставь кулон себе. Прощай».~
@16175 = ~«Потому что мне обещали силу за его доставку».~
@16176 = ~«Потому что ты творишь с его помощью зло».~
@16177 = ~«Хватит трепотни, я просто тебя зарежу и заберу кулон».~
@16178 = ~«Не бери в голову, забудем пока про кулон. У меня были вопросы…»~
@16179 = ~«Забудь, оставь кулон себе. Прощай».~
@16180 = ~«Я договорился с парой извергов, но не уверен, какого вида эта сила».~
@16181 = ~«Тебе есть что мне предложить?»~
@16182 = ~«Хватит трепотни, я просто тебя зарежу и заберу кулон».~
@16183 = ~«Забудь, оставь кулон себе. Прощай».~
@16184 = ~«У меня другие вопросы…»~
@16185 = ~«Это всё, что я хотел узнать. Прощай».~
@16186 = ~«У меня другие вопросы…»~
@16187 = ~«Это всё, что я хотел узнать. Прощай».~
@16188 = ~«Да, сейчас я подпишу его».~
@16189 = ~«Нет… я просто зарежу тебя и заберу кулон».~
@16190 = ~«Забудь о договоре; оставь кулон себе. Прощай».~
@16191 = ~Продолжать…~
@16192 = ~Продолжать…~
@16193 = ~Продолжать…~
@16194 = ~Продолжать…~
@16195 = ~«Приветствую…»~
@16196 = ~Напасть на него.~
@16197 = ~Оставить «его» в покое.~
@16198 = ~«Приветствую?..»~
@16199 = ~Жар вокруг этого… существа… просто неописуемый. К твоему изумлению, железная решётка, над которой парит создание, прогнулась от жары. Первой твоей мыслью было, что жар исходит от решётки… но теперь ты ощущаешь, что он исходит именно от существа. На твоих глазах от корчащегося тела отлетают хлопья пепла и медленно поднимаются к потолку.~
@16200 = ~Обследовать горящий труп.~
@16201 = ~«Хм-м. Интересно, сможет ли этот бездонный графин воды что-нибудь сделать?..»~
@16202 = ~Ты наклоняешь графин над решёткой и начинаешь лить. Тонкая бледно-голубая струйка воды течёт из графина и касается пламени решётки с ужасающим шипением, образуя облака пара… словно в ответ на этот вызов, графин вдруг *прыгает* вперёд, падает на решётку и разбивается!~
@16203 = ~Шипящая волна пара и яростный треск распространяются от решётки, накрывают тебя, вынудив схватиться за уши и отшатнуться… затем раздаётся крик, смешанный с гоготом, ужасный звук, как будто горит сразу сотня домов и кричат люди, заглушаемые рёвом пламени и шипением горящей плоти…~
@16204 = ~Когда ты поднимаешь руки к ушам, чтобы их заткнуть, то чувствуешь на руках что-то липкое, как плавленый сыр или свечной воск… от шума у тебя из ушей течёт кровь! Ты отнимаешь руки, они покрыты кусочками растаявшей плоти со сгустками крови…~
@16205 = ~Ты уже собираешься бежать из бара, куда угодно скрыться от этого звука, как вдруг устанавливается гробовая тишина, нарушаемая только слабым потрескиванием решётки. Ты поворачиваешься. На решётке лежит бездонный графин воды, вернее, то, что от него осталось, — испускающие пар осколки. Над ним находится существо. Пламя по-прежнему струится по его телу, вылизывая пол бара. Оно смотрит на тебя, его глаза мерцают, как два факела…~
@16206 = ~Лицо существа трескается, обожжённая плоть расходится от зубов в разные стороны, так что оно может говорить: «*Дас-с-с…*» Его голос потрескивает, горит, ревёт, вырываясь из груди, с каждым словом хлопья пепла и зола летят изо рта, кружатся в воздухе. Ты с трудом удерживаешь взгляд на существе — от сияния пламени вокруг него режет глаза.~ [IGN116]
@16207 = ~«*Дас-с-с-с…* — существо подплывает к тебе, и воздух дрожит от жара. — *Долго же я с-с-спал… с-с-сны о пламени…*» Как бы в ответ, пламя завивается колечком в горле Игнуса, и из-за почерневших зубов вырывается язык огня. «*Я твой… пока с-с-смерть не разлучит нас-с-с-с…*»~ [IGN004C]
@16208 = ~Когда ты приближаешься, воздух дрожит от жара, и существо шипит: «*Долго же я с-с-спал… с-с-сны о пламени…*»~ [IGN004B]
@16209 = ~Как бы в ответ, пламя завивается колечком в горле Игнуса, и из-за почерневших зубов вырывается язык огня. «*Я твой… пока с-с-смерть не разлучит нас-с-с-с…*»~ [IGN248]
@16210 = ~Оставить его в покое.~
@16211 = ~~
@16212 = ~Осмотреть существо.~
@16213 = ~«Хм-м. Интересно, сможет ли этот бездонный графин воды что-нибудь сделать?..»~
@16214 = ~Оставить его в покое.~
@16215 = ~«Приветствую?..»~
@16216 = ~«Хм-м. Интересно, сможет ли этот бездонный графин воды что-нибудь сделать?..»~
@16217 = ~Оставить его в покое.~
@16218 = ~«Какого дьявола?!..»~
@16219 = ~Заткнуть уши, перекрыть звук.~
@16220 = ~Попытаться выбежать из бара.~
@16221 = ~«Я *знаю* тебя…»~
@16222 = ~«Игнус…»~
@16223 = ~«Здравствуй, Игнус… ты пойдёшь со мной?»~
@16224 = ~«Что это за проект?»~
@16225 = ~Этот длинный, худой парень глазеет на землю под ногами; временами он останавливается и становится на колени, словно пытается отыскать в грязи какой-то предмет или подсказку. Несмотря на его странное, долговязое сложение, он выглядит быстрым и гибким.~
@16226 = ~Как только ты заговариваешь, он поворачивается и сжимается в низком старте… хотя ты не можешь определить, куда он собрался прыгнуть: на тебя или куда-то ещё. «Что? Говори побыстрее, ну…»~
@16227 = ~«Не буду я отвечать. Пошёл на!..» — раньше ты не замечал, но в руке у него длинный, изогнутый кинжал.~
@16228 = ~«Да ну? — он косится на тебя какой-то миг, затем сплёвывает на землю. — Откуда мне эт знать, а?»~
@16229 = ~«Какую часть ты не допёр, пень? Хм! Слухай сюда: откуда мне знать, чё ты просто „вопросы“ задать хошь? А чё, ежели твои вопросы мне не понравятся, а? Чё тада? Прижмёшь меня, пытать станешь? М-м?»~
@16230 = ~«Нет. Без мазы. Иди доставай кого ещё».~
@16231 = ~«А чё? Крысёныш тя пугает? Ты чё, пень, угрозу усмотрел?»~
@16232 = ~«Хе-хе! Сечёшь фишку… Ладно, чё хотел?»~
@16233 = ~«Ну, эт типа твои проблемы. Тада заткнись и отвали».~
@16234 = ~Когда ты уже собираешься уходить, он окликает: «Эй! Подожди малёха…»~
@16235 = ~Он выпрямляется и убирает оружие: «Кто тебя послал? Зачем ты здесь?»~
@16236 = ~Он снова сплёвывает: «Хмф. Тада проваливай».~
@16237 = ~«Хм-м…» Он искоса смотрит на тебя длинным, тяжёлым взглядом; после продолжительного молчания он говорит: «Ладно. Чё те от меня нужно?»~
@16238 = ~«Тада давай. Задавай свои вопросы».~
@16239 = ~«Я Крысёныш. А ты кто?»~
@16240 = ~Он хмуро смотрит на тебя: «Ага, конечно».~
@16241 = ~Крысёныш ухмыляется: «Ну конечно нет, я уж догадался. Почему б и нет, а?»~
@16242 = ~Брови Крысёныша взлетают вверх: «Чё, правда? Слишком странно для правды… хе. А чё случилось? Кто-то так разрисовал тя пёрышком?»~
@16243 = ~«О? Хмф. Базарить с тобой было плохой идей, эт я сразу просёк. Отвали, больше у меня никаких дел с тобой».~
@16244 = ~Он прерывает тебя: «Нет! И слышать не хочу. Пшёл вон». Он отворачивается и возобновляет свои поиски.~
@16245 = ~«Хе! Ты уже забыл, пень? Крысёныш!»~
@16246 = ~«Ничего, чё б те стоило знать».~
@16247 = ~«Нет, я на самом деле охочусь… — внезапно он осекается и подозрительно глядит на тебя. — Какое *тебе* дело, а?»~
@16248 = ~«Хм-м. Ну, я охочусь на мозговых крыс».~
@16249 = ~«Не просто крыс, заметь, мозговых крыс. За них награда объявлена. Не знал? По медяку за каждый хвост».~
@16250 = ~«А? Потому, что они не как обычные крысы, намного опаснее для всяких пней. Чем их больше собирается вместе, тем умнее они становятся… даже заклинания читать могут, во, как маги. Улей — хе, да даж весь Сигил — и без того опасен, не хватало ещё разумных колдующих крыс повсюду!»~
@16251 = ~«Зачем те? Сам крыс ловишь аль собираешься?»~
@16252 = ~«Тогда найди себе другое место, пень! Их в последнее время и так мало, а тут ещё всякие дурни на мой участок приходят».~
@16253 = ~«Не, не знаю. Мож быть, их переловили; ты ж знаешь, я не один такой крысолов в Сигиле. Просто единственный крысолов на Площади Мусорщиков».~
@16254 = ~«Хм-м, — минуту он косится на тебя, затем вздыхает. — Не знаю, на кой я тебе такие секреты выдаю, но это на восток, за пределы Площади, затем на юг пройди. Выйдешь к югу от рынка. Только не ходи ловить крыс сюда, тут и для меня одного мало!»~
@16255 = ~«Хм-м. Ну, я не собираюсь запросто так байки тут травить. Сначала скажи, чё тут делаешь ты?»~
@16256 = ~«А? Эй, пень, придумай чего получше. Враньё, а если и бродишь… то явно уже не просто так!» — он вращает глазами и злобно хихикает.~
@16257 = ~«Да? Хм-м… — он склоняется ближе и понижает голос. — Он близко, знаешь ли. Зачем ты его ищешь, а? Он твой друг? Враг?»~
@16258 = ~«Вот как? Ну, ты там, где надо. Просто осмотрись получше. Мужик нехило прячется, но ты обязательно найдёшь его тут, на Площади Мусорщиков. И довольно скоро».~
@16259 = ~«Да ну? — Крысёныш внимательно смотрит на тебя. — Хм-м. Ищешь у него работу, да? По-моему, ты не того типа. Ну, неважно… ты там, где надо. Просто осмотрись получше. Мужик нехило прячется, но ты обязательно найдёшь его тут, на Площади Мусорщиков. И довольно скоро».~
@16260 = ~Он вздрагивает, а затем качает головой, посмеиваясь: «Хе! Не хотел бы, чтоб здоровяк твоего прикида припёрся ко мне! Не думаю, что старый Фарод заценит, если я какому-то толкачу вроде тя скажу, где он прячется. У Крысёныша могут быть проблемы…»~
@16261 = ~«Да пошло оно всё! Эх… не спрашивай, почему, но я те поверю, — он сплёвывает через плечо. — Но чоб я потом не пожалел, пень! Просто осмотрись получше. Мужик нехило прячется, но ты обязательно найдёшь его тут, на Площади Мусорщиков. И довольно скоро».~
@16262 = ~Он грустно качает головой: «Прости, не могу. Но он близко. Ты скоро найдёшь его сам».~
@16263 = ~Он усмехается, затем сплёвывает тебе под ноги: «Хмф. И эт после того, как ты зуб давал, что не накатишь бочку. Базарить с тобой было плохой идей, эт я сразу просёк. Отвали, больше у меня никаких дел с тобой».~
@16264 = ~Он недовольно качает головой: «Разве мы это уже не перетёрли? Просто осмотрись получше. Мужик нехило прячется, но ты обязательно найдёшь его тут, на Площади Мусорщиков. Вали ищи уже, пока опять не забыл и меня доставать не припёрся!»~
@16265 = ~Лицо Крысёныша мрачнеет: «Я ж говорил: ничё не скажу. Он близко. Ищи сам».~
@16266 = ~«Если здесь его потерял, то удачи в поисках среди этой помойки. Я уж точно тут ничем не помогу».~
@16267 = ~«Чё те нада знать? Может, Крысёныш и ответит на пару вопросов».~
@16268 = ~«Работа? В Улье её немного. И в любом случае не слишком приличная. Если ты отчаянный — иди работать Сборщиком… но я бы присмотрел другой район. Например, Нижний получше будет».~
@16269 = ~«Это просто. Всего лишь… хм-м, нет. Правду сказать, тот путь, которым я ходил, весь запутан… эти дабусы всё переделали. Я щас и не знаю, как здоровяку туда попасть».~
@16270 = ~«Угу. Сборщики собирают жмуриков в Сигиле… большей частью в Улье… и тащат в Мортуарий. Мёртвые — то есть Пыльные — платят за трупы. Чтобы зараза не расползалась».~
@16271 = ~«Ты и вправду бестолочь? Лады! Дабусы — слуги Госпожи Боли, Владычицы Сигила. Даже не думай меня ещё и о ней спрашивать, это несчастье приносит».~
@16272 = ~Крысёныш поднимает ладони, словно хочет тебя остановить: «Ну уж нет! И не думай об этом… по крайней мере не здесь! Тут их и на меня-то не хватает; пожалуй, почти всех повывели. Иди куда-нибудь ещё и там охоться».~
@16273 = ~«Не знаю, чё те конкретно надо, но скажу вот чё: везде, кроме этого места. Даже с „дамочками“ могут быть проблемы в этой части Сигила, сечёшь?»~
@16274 = ~«Э… тогда ладно».~
@16275 = ~«Ничего особенного… просто никогда не знаешь, откуда могут свалиться неприятности. Просто держи ушки на макушке, и следи за тем, чё и кому говорить. Если погреметь шкатулкой не с тем мужиком, можешь мигом попасть в книгу мёртвых, а то и хуже».~
@16276 = ~Он резко кивает: «Конечно. Тока не говори, чё ты не знаешь ничего хуже смерти…»~
@16277 = ~«Прорва. Но по-хорошему бояться следует только одного… тут по Улью шатается какой-то повеса. На громилу не похож, но дерётся так, будто с мечом в руках родился».~
@16278 = ~«Слухай сюда, пень, я ещё не закончил. Я хотел сказать тебе: сам повеса — фигня, бояться надо грязного Сборщика, который за ним хвостом ходит. Скажу тебе, этот Сборщик имеет со свежих жмуриков повесы больше, чем просто навар в Мортуарии».~
@16279 = ~«Это те, кто собирает мёртвых в Сигиле — большей частью в Улье — и относят в Мортуарий за медяки».~
@16280 = ~«Хм-м… слушай, я вижу, тебе интересно, но это не обычная байка, сечёшь, — это мёртвая тайна. Я попрошу у тебя кой-чего, прежде чем скажу ещё хоть слово».~
@16281 = ~«Хорошо, хорошо. Я пари заключил с дружком… чё-то вроде соревнования. Всё, чё тебе надо знать, — мне нужны крысиные хвосты и чем больше, тем лучше. Тока не обычных крыс, а этих башковитых… мозговых крыс. Дай мне пять штук, и я тебе всё про этого грязного Сборщика и кровавого повесу выложу».~
@16282 = ~«Верно. Они не похожи на обычных крыс; намного опаснее для всяких пней. Чем их больше собирается вместе, тем умнее они становятся… даже заклинания читать могут, во, как маги. Просто осторожнее, когда будешь охотиться за хвостами!»~
@16283 = ~«Хорошо. Чё-нибудь ещё?»~
@16284 = ~«Как пожелаешь. Ты знаешь, чё мне нужно, чтоб я тебе все ихние секреты выложил. Чё-нибудь ещё?»~
@16285 = ~«Не нада мне, чтоб ты возвращался. Я и слова те не скажу».~
@16286 = ~«Нет, пень, ты слишком далеко зашёл. Врал, да ещё и наезжать надумал… проваливай».~
@16287 = ~«Хмф, — он думает минуту, затем сплёвывает через плечо. — Не скажу, чё я против второго шанса для тя… так и быть. Только присмотри за базаром, пень».~
@16288 = ~«Нет, пень, я давал тебе шанс… Задвинься и проваливай».~
@16289 = ~Крысёныш поднимает взгляд при твоём появлении: «Хм-м?»~
@16290 = ~Крысёныш поднимает взгляд при твоём появлении: «Снова-здорово. Принёс хвосты, нет ещё?»~
@16291 = ~Он берёт хвосты и убирает их в кожаный мешочек, не переставая хихикать про себя: «И точно, они! Премного тебе обязан».~
@16292 = ~«Конечно, конечно. Я подумал, что дело нечисто, ещё когда в первый раз увидел этого повесу. В Улье дуэлянты стараются не привлекать внимания, а этот торчит тут сутками… даже ночует в Улье, вместо того чтобы мотаться к себе домой и обратно».~
@16293 = ~«Ну да, закона. Убийц Милосердия и тому подобных. Они патрулируют улицы Сигила — по крайней мере некоторые — наводя „порядок“, — он корчит рожу. — Но держатся подальше от самых бедных уголков города, типа Улья».~
@16294 = ~«Так вот, я зарёкся воровать давным-давно — не спрашивай, почему — но оказалось уж слишком чересчур, слишком просто. Однажды поздно ночью, около антипика, я заглянул сзади в ту задрипанную дыру, которую он снимает, и представь, кто там в окне торчал? Тот самый Сборщик!»~
@16295 = ~«Так что я стал вдвойне подозрителен. Во мне проснулся старый Крысёныш, и я стал ходить за этим Сборщиком по пятам. Он никогда не спит, никогда не ест… когда его повесы нет рядом, он просто сидит в самой тёмной аллее, какую только найдёт, и зырит в пустоту».~
@16296 = ~«А теперь самое интересное. Тёмной ночкой, када я лежал на крыше рядом с улочкой, где сидел Сборщик, как думаешь, кто заговорил с ним?»~
@16297 = ~«Нет! *Изверг*!»~
@16298 = ~«Изверг, точно те говорю. Красивая, с крыльями, как у ангела, а губки как… как… короче, убойная девка. Но изверг, ясно дело. Обольстительница, баатезу, из тех, кого они называют эриниями, как я слышал».~
@16299 = ~«Мне б подползти и послушать, чё они там лопочут, но уж больно страшно было привлечь извергово внимание. Всё, чё я знаю, — они чуть поболтали, затем извергиня рассмеялась — грубым таким, гадким смехом — и пропала, а Сборщик плевался и шипел ей вслед!»~
@16300 = ~«Хе! Просто сам на него посмотри, если уж мне не веришь! Но не испытывай судьбу — тот повеса в натуре крут, и все, кто с ним дерётся или обижает того Сборщика, отправляются прямиком в книгу мёртвых».~
@16301 = ~«Ты самое главное пропустил, кожеголовый бедняга! Никакой он не Сборщик! Хе… если когда-нибудь придётся говорить с извергом… с баатезу, то есть, а не с этими психованными танар'ри… почему б не спросить о нём? Никогда не знаешь, чё выяснишь».~
@16302 = ~«Ты самое главное пропустил, кожеголовый бедняга! Никакой он не Сборщик! Хе… если когда-нибудь придётся говорить с извергом… с баатезу, то есть, а не с этими психованными… — он осекается, заметив Падшую Грейс. — Э-э, то есть „более свободными“, танар'ри… почему б не спросить о нём? Никогда не знаешь, чё выяснишь».~
@16303 = ~«Я ж сказал, чё я хочу за этот секрет: пять крысиных хвостов. Только не обычных крыс, а этих башковитых… мозговых крыс. Дай мне пять штук, и я тебе всё про этого грязного Сборщика и кровавого повесу выложу».~
@16304 = ~Крысёныш поднимает взгляд при твоём появлении: «Хм-м?»~
@16305 = ~«Приветствую…»~
@16306 = ~Оставить его в покое.~
@16307 = ~«У меня кое-какие вопросы…»~
@16308 = ~«Ничего, неважно. Прощай».~
@16309 = ~«Тебе ничего не будет от того, что просто поговоришь со мной…»~
@16310 = ~«Ты мне угрожаешь?»~
@16311 = ~«Прощай».~
@16312 = ~«Не понимаю».~
@16313 = ~«Тебе просто придётся мне поверить».~
@16314 = ~«Неважно. Прощай».~
@16315 = ~«Просто поговори со мной. У меня всего пара вопросов…»~
@16316 = ~Клятва: «Я не буду пытаться причинить тебе вред; вот тебе моё слово».~
@16317 = ~Ложь: «Я не буду пытаться причинить тебе вред; вот тебе моё слово».~
@16318 = ~«Забудь, что я спрашивал. Прощай».~
@16319 = ~Уйти.~
@16320 = ~«Нет».~
@16321 = ~«Да».~
@16322 = ~«Забудь. Прощай».~
@16323 = ~«Как уже сказал, я хотел задать пару вопросов…»~
@16324 = ~«Ничего, неважно. Прощай».~
@16325 = ~Уйти.~
@16326 = ~«Да?»~
@16327 = ~Игнорировать его и уйти.~
@16328 = ~«Никто меня не посылал. Я тут сам по себе».~
@16329 = ~«Почему ты думаешь, что меня кто-то послал?»~
@16330 = ~«О *чём* ты?»~
@16331 = ~«Не твоё дело».~
@16332 = ~Уйти.~
@16333 = ~«Как уже сказал, я хотел задать пару вопросов…»~
@16334 = ~«Ничего, неважно. Прощай».~
@16335 = ~«Кто ты?»~
@16336 = ~«Напомни, кто ты?»~
@16337 = ~«Что ты здесь делаешь?»~
@16338 = ~«Можешь рассказать мне об этом месте?»~
@16339 = ~«Расскажи мне ещё раз про Сборщика и повесу».~
@16340 = ~«Я ищу кое-кого по имени Фарод».~
@16341 = ~«Я ищу кое-кого по имени Фарод».~
@16342 = ~«Я ищу кое-кого по имени Фарод».~
@16343 = ~«Я ищу потерянный дневник».~
@16344 = ~«Неважно. Прощай».~
@16345 = ~Ложь: «Меня зовут, э… Адан».~
@16346 = ~«У меня нет имени».~
@16347 = ~«Я… не знаю».~
@16348 = ~«Не твоё дело».~
@16349 = ~«У меня другие вопросы…»~
@16350 = ~«Да, это я. Прощай».~
@16351 = ~Ложь: «Хорошо… меня зовут, э, Адан».~
@16352 = ~«Потому что я его не помню».~
@16353 = ~«Не твоё дело».~
@16354 = ~«Вроде того. У меня другие вопросы…»~
@16355 = ~«Долгая история; может, в другой раз. Прощай».~
@16356 = ~«У меня другие вопросы…»~
@16357 = ~«Тогда прощай».~
@16358 = ~Уйти.~
@16359 = ~«У меня другие вопросы…»~
@16360 = ~«Это всё, что я хотел узнать. Прощай».~
@16361 = ~«Ты как будто что-то ищешь».~
@16362 = ~«Я хочу спросить о другом…»~
@16363 = ~«Тогда прощай».~
@16364 = ~«Просто любопытно».~
@16365 = ~Правда: «Может, я смогу помочь».~
@16366 = ~Ложь: «Может, я смогу помочь».~
@16367 = ~«Никакого. У меня есть ещё вопросы…»~
@16368 = ~«Никакого. Прощай».~
@16369 = ~«Зачем ты охотишься на крыс?»~
@16370 = ~«У меня другие вопросы…»~
@16371 = ~«Это всё, что я хотел узнать. Прощай».~
@16372 = ~«Почему за них награда?»~
@16373 = ~«Куда ты относишь хвосты?»~
@16374 = ~«Интересно. У меня другие вопросы…»~
@16375 = ~«Это всё, что я хотел узнать. Прощай».~
@16376 = ~«Куда ты относишь хвосты?»~
@16377 = ~«У меня другие вопросы…»~
@16378 = ~«Это всё, что я хотел узнать. Прощай».~
@16379 = ~«Да».~
@16380 = ~«Может быть».~
@16381 = ~«Нет, просто спросил».~
@16382 = ~«В последнее время их мало? А почему, не знаешь?»~
@16383 = ~«И всё-таки я бы хотел знать».~
@16384 = ~«У меня другие вопросы…»~
@16385 = ~«Прощай».~
@16386 = ~«Интересно. У меня другие вопросы…»~
@16387 = ~«Это всё, что я хотел узнать. Прощай».~
@16388 = ~«Тут их мало? Не знаешь, почему?»~
@16389 = ~«Спасибо. У меня другие вопросы…»~
@16390 = ~«Спасибо, как-нибудь схожу туда. Прощай».~
@16391 = ~«Я ищу мужчину по имени Фарод».~
@16392 = ~«Я ищу свой потерянный дневник».~
@16393 = ~«Сам не знаю. Просто брожу».~
@16394 = ~«Не думаю, что это твоё дело».~
@16395 = ~«Забудь, что я спрашивал. Прощай».~
@16396 = ~«Я ищу мужчину по имени Фарод».~
@16397 = ~«Я ищу свой потерянный дневник».~
@16398 = ~«Я просто брожу, как и сказал».~
@16399 = ~Что-нибудь насочинять.~
@16400 = ~«Забудь, что я спрашивал. Прощай».~
@16401 = ~«У него есть для меня информация».~
@16402 = ~Ложь: «Он мой друг».~
@16403 = ~Ложь: «Враг».~
@16404 = ~«Не думаю, что это твоё дело».~
@16405 = ~«Неважно. Прощай».~
@16406 = ~«Спасибо. У меня другие вопросы…»~
@16407 = ~«Тогда пойду искать его. Прощай».~
@16408 = ~«Спасибо. У меня другие вопросы…»~
@16409 = ~«Тогда пойду искать его. Прощай».~
@16410 = ~Клятва: «Даю слово, что не упомяну твоё имя».~
@16411 = ~Клятва: «Даю слово, что не упомяну твоё имя».~
@16412 = ~Ложь: «Клянусь, что не упомяну твоё имя».~
@16413 = ~Правда: «Говори, что знаешь, или разделишь его судьбу».~
@16414 = ~Правда: «Говори, что знаешь, или разделишь его судьбу».~
