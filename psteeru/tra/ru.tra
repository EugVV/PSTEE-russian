@38331 = ~«Это всё, что я хотел узнать. Прощай».~
@38332 = ~«Может, это было что-то другое?»~
@38333 = ~«У меня вопросы о другом…»~
@38334 = ~«Это всё, что я хотел узнать. Прощай».~
@38335 = ~«Может, это было что-то другое?»~
@38336 = ~«У меня вопросы о другом…»~
@38337 = ~«Это всё, что я хотел узнать. Прощай».~
@38338 = ~«Ты знаешь *какой-нибудь* способ вернуть твой голос?»~
