@13202 = ~«Я хочу задать вопрос о другом…»~
@13203 = ~«Что ты говорила насчёт сбора „жмуриков“?»~
@13204 = ~«А если я захочу поразвлечься, куда мне идти?»~
@13205 = ~«Должен ли я чего-нибудь здесь остерегаться?»~
@13206 = ~«Должен ли я чего-нибудь здесь остерегаться?»~
