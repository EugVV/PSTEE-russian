@4362  = ~«Сперва ты скажешь мне, что здесь делаешь. Иначе я позову стражу».~
@4363  = ~«Сперва ты скажешь мне, что здесь делаешь. Иначе я позову стражу».~
@4364  = ~«Отвечай на мои вопросы, дьявол побери, или я сделаю твою маскировку реальностью, оглянуться не успеешь».~
@4365  = ~«Отвечай на мои вопросы, дьявол побери, или я сделаю твою маскировку реальностью, оглянуться не успеешь».~
@4366  = ~Зомби кивает на это, и тебе кажется, что под слоем маскировки его распирает от гордости за свою работу.~
@4367  = ~«Ладно, ладно… Я ухожу».~
@4368  = ~«Не поможешь мне выбраться отсюда?»~
@4369  = ~«Так что ты здесь делаешь?»~
@4370  = ~Ложь: «Так ты шпион Анархистов? Ну, я тоже шпионю за Пыльниками… но сейчас не могу много об этом говорить, если понимаешь, о чём я. Какое у *тебя* здесь задание?»~
@4371  = ~Ложь: «Так ты шпион Анархистов? И я шпионю за Пыльниками… но сейчас не могу много об этом говорить. Что ты здесь делаешь?»~
@4372  = ~«Э-э, сейчас у меня нет времени на разговоры… может, в другой раз».~
@4373  = ~Кажется, зомби заинтересовался: «У теа профлемы? Фто флуфилось?»~
@4374  = ~«Я очнулся на одной из плит наверху».~
@4375  = ~«Я… здесь некоторым образом в западне. Не поможешь мне выбраться?»~
@4376  = ~«Может, в следующий раз расскажу».~
@4377  = ~Зомби смотрит на тебя, как на сумасшедшего: «Ты фпятил?»~
@4378  = ~«Да, спятил. Совсем спятил».~
@4379  = ~«„Спятил“? Что это значит?»~
@4380  = ~«„Спятил“? Что это значит?»~
@4381  = ~«Я знаю, в это трудно поверить, но я не собираюсь тебе врать: я очнулся после смерти на одной из плит наверху».~
@4382  = ~«Э-э, нет… вообще-то, я здесь некоторым образом в западне. Не поможешь мне выбраться?»~
@4383  = ~«Забудь, что мы говорили. Я должен идти».~
@4384  = ~Он смотрит на тебя, затем шипит и движением руки приказывает уходить. «Ты псих! Убиайся от мея!»~
@4385  = ~«Никуда я не пойду. Отвечай, что ты здесь делаешь, или я позову стражу».~
@4386  = ~«Никуда я не пойду. Отвечай, что ты здесь делаешь, или я позову стражу».~
@4387  = ~«Сначала ты ответишь на мои вопросы, дьявол побери, или я сделаю эту маскировку реальностью».~
@4388  = ~«Сначала ты ответишь на мои вопросы, дьявол побери, или я сделаю эту маскировку реальностью».~
@4389  = ~«Ладно, ладно… прощай».~
@4390  = ~Фальшивый зомби подозрительно смотрит на вас обоих.~
@4391  = ~«Это правда — я очнулся на одной из плит наверху».~
@4392  = ~«Э-э, прости. Вообще-то, я здесь некоторым образом в западне. Не поможешь мне выбраться?»~
@4393  = ~«Неважно. Я должен идти».~
@4394  = ~Он смотрит на тебя, затем шипит и машет рукой: «Придуок! Идиотина! Убиайся, пень! Фали!»~
@4395  = ~«Никуда я не пойду. Отвечай, что ты здесь делаешь, или я позову стражу».~
@4396  = ~«Никуда я не пойду. Отвечай, что ты здесь делаешь, или я позову стражу».~
@4397  = ~«Сначала ты ответишь на мои вопросы, дьявол побери, или я сделаю эту маскировку реальностью».~
@4398  = ~«Сначала ты ответишь на мои вопросы, дьявол побери, или я сделаю эту маскировку реальностью».~
@4399  = ~«Ладно, ладно… ухожу».~
@4400  = ~Некоторое время он кажется напуганным, затем изучает тебя и расплывается в ухмылке: «Ты пфоболтаефся обо ме, а я об *тефе*. У мея фдесь пфячутся друфья, а у тея фдесь *никоо*. Тее нельфя фдесь нахоиться. Пыльники уфьют тея. А я фбегу».~
@4401  = ~«Ты не сбежишь, если я тебя УБЬЮ. Теперь отвечай на мой вопрос, или я сделаю твою маскировку реальностью».~
@4402  = ~«Ты не сбежишь, если я тебя УБЬЮ. Теперь отвечай на мой вопрос, или я сделаю твою маскировку реальностью».~
@4403  = ~«Тогда гори в аду. Я ухожу».~
@4404  = ~Глаза зомби сужаются, и он шипит на тебя: «ПОПФОБУЕШЬ фапифать мея в кьиу мёфтвых? У мея фдесь пфячутся друфья, у тея фдесь *никоо*. Тронефь мея — они уфьют ТЕА».~
@4405  = ~«Я рискну. Приготовься к смерти».~
@4406  = ~«Тогда гори в аду. Я ухожу. А ты лучше сам поберегись… *зомби*».~
@4407  = ~Некоторое время он кажется напуганным, затем изучает твоё сложение и расплывается в ухмылке: «ПОПФОБУЕШЬ фапифать мея в кьиу мёфтвых? У мея фдесь пфячутся друфья. Тронефь мея — они уфьют ТЕА».~
@4408  = ~«Я рискну. Приготовься к смерти».~
@4409  = ~«А что если я открою твою маскировку страже?»~
@4410  = ~«А что если я открою твою маскировку страже?»~
@4411  = ~«Тогда гори в аду. Я ухожу. А ты лучше сам поберегись… *зомби*».~
@4412  = ~Глаза зомби сужаются, и он шипит на тебя: «Ты пфоболтаефся обо ме, а я об *тефе*. У мея фдесь пфячутся друфья, а у тея фдесь *никоо*. Пыльники уфьют тея. А я фбегу».~
@4413  = ~«Это был твой последний шанс, труп. Приготовься к смерти».~
@4414  = ~«Тогда гори в аду. Я ухожу. А ты лучше сам поберегись… *зомби*».~
@4415  = ~Должно быть, что-то в твоих глазах вызывает у зомби страх. «Не-не-не! Не фофи фтрафу! — он явно напуган. — Я-я-я фпионю фа Пыльниками, фот и фсё. Больфе ни-ни-ничефо».~
@4416  = ~«Шпионишь? Для кого?»~
@4417  = ~«И чем же Пыльные занимаются?»~
@4418  = ~«У меня другие вопросы…»~
@4419  = ~«Это всё, что я хотел знать. Прощай, *зомби*».~
@4420  = ~«Н-н-нет! Не тфо-о-огай меяа-а! — твоё явное превосходство в мышечной массе, похоже, сильно колеблет его решимость. — Не тфо-о-огай меяа-а! Я фпионю фа Пыльниками, и тофько. Бо-больфе ничефо».~
@4421  = ~«Шпионишь? Для кого?»~
@4422  = ~«И чем же Пыльные занимаются?»~
@4423  = ~«У меня другие вопросы…»~
@4424  = ~«Это всё, что я хотел знать. Прочь с дороги, *зомби*».~
@4425  = ~Зомби впадает в ступор от страха. Кажется, он не желает больше говорить.~
@4426  = ~«Говори. Для кого ты здесь шпионишь?»~
@4427  = ~«Говори. Для кого ты здесь шпионишь?»~
@4428  = ~«Тебе будет не так СИЛЬНО больно, если ты мне скажешь, для кого ты шпионишь».~
@4429  = ~«Тебе будет не так СИЛЬНО больно, если ты мне скажешь, для кого ты шпионишь».~
@4430  = ~«Неважно. Чем занимаются Пыльные?»~
@4431  = ~«Я хотел бы узнать ещё кое-что…»~
@4432  = ~«Забудь. Прощай, *зомби*».~
@4433  = ~«Ифкал мея? Фачем? — он косится на тебя. — У тя ефть для мея соофение?»~
@4434  = ~Ложь: «Да, у меня для тебя сообщение».~
@4435  = ~«От кого?»~
@4436  = ~«Нет, у меня сообщений нет».~
@4437  = ~Он зло шипит: «Тофда чео тее *нао*, пень?!»~
@4438  = ~«Я хочу выбраться отсюда. Не поможешь мне?»~
@4439  = ~«Мне нужна информация…»~
@4440  = ~«Скажи мне, что ты здесь делаешь, или я позову стражу».~
@4441  = ~«Скажи мне, что ты здесь делаешь, или я позову стражу».~
@4442  = ~«Мне надо, чтобы ты отвечал на мои вопросы, дьявол побери, или я сделаю твою маскировку реальностью, оглянуться не успеешь».~
@4443  = ~«Мне надо, чтобы ты отвечал на мои вопросы, дьявол побери, или я сделаю твою маскировку реальностью, оглянуться не успеешь».~
@4444  = ~«Прости за беспокойство… кто бы ты ни был. Прощай».~
@4445  = ~«Какое сообщение?»~
@4446  = ~«Ты должен рассказать мне о своём поручении».~
@4447  = ~Ложь: «У меня для тебя новые приказы».~
@4448  = ~Ложь: «У меня… для тебя новые приказы».~
@4449  = ~«Извини, у меня нет сообщений».~
@4450  = ~«Неважно. Извини за беспокойство. Прощай».~
@4451  = ~Его глаза зло сужаются: «Ты НЕ фьязной. Фто ты?»~
@4452  = ~«Я хочу выбраться отсюда. Не поможешь мне?»~
@4453  = ~«Мне нужна информация…»~
@4454  = ~«Скажи мне, что ты здесь делаешь, или я позову стражу».~
@4455  = ~«Скажи мне, что ты здесь делаешь, или я позову стражу».~
@4456  = ~«Вопросы здесь задаю *я*, *зомби*. Скажи мне, кто ты, или я сделаю эту маскировку реальностью».~
@4457  = ~«Вопросы здесь задаю *я*, *зомби*. Скажи мне, кто ты, или я сделаю эту маскировку реальностью».~
@4458  = ~«Прости за беспокойство… кто бы ты ни был. Прощай».~
@4459  = ~«Я фпионю за Пыльниками. Говою то, чео вижу. Больфе ничефо».~
@4460  = ~«И чем же Пыльные занимаются?»~
@4461  = ~«Ясно. Я хочу ещё кое-что знать…»~
@4462  = ~«Это всё, что я хотел знать. Прощай».~
@4463  = ~«Нифем. Они ничео не деают. Ничео не фмог обнауфить. Мёфтвые, мёфтвые, профто мёфтвые люди, Пыльники *нифео* не деают, — его глаза убеждённо сужаются. — Но я ефё пока выфматрифаю».~
@4464  = ~«Ясно. Я хочу ещё кое-что знать…»~
@4465  = ~«Это всё, что я хотел знать. Прощай».~
@4466  = ~Он сужает глаза, как будто пытается получше тебя разглядеть: «Какие пфиказы?»~
@4467  = ~«Расскажи мне о своём поручении».~
@4468  = ~«Мне надо найти способ убраться отсюда, чтобы меня не засекли».~
@4469  = ~«Я здесь, чтобы сменить тебя. Выкладывай всю информацию, которую собрал, и все вещи. Затем уходи».~
@4470  = ~«Я здесь, чтобы при необходимости помочь тебе».~
@4471  = ~«Твои приказы подождут до следующего раза. Я вернусь».~
@4472  = ~Он молчит какое-то время, затем слегка кивает, как будто понимая: «Фачем мие помоать тее?»~
@4473  = ~«Потому что мне нужна твоя помощь».~
@4474  = ~«Возможно, мы сможем помочь друг другу. Что ты хочешь взамен?»~
@4475  = ~«Потому что я не *сдам* тебя местным… если ты мне поможешь».~
@4476  = ~«Потому что я не *сдам* тебя местным… если ты мне поможешь».~
@4477  = ~«Ты похож на человека, который скорее прикидывается трупом, а НЕ ЯВЛЯЕТСЯ им. Этого достаточно?»~
@4478  = ~«Ты похож на человека, который скорее прикидывается трупом, а НЕ ЯВЛЯЕТСЯ им. Этого достаточно?»~
@4479  = ~«Забудь, что мы встречались. Я должен идти. Прощай».~
@4480  = ~Зомби ухмыляется: «Фсем чео-то *нуфно*, но нифто ничео не *даёт*. *Дай* мие чео-нить, и, *мофет*, я помоу».~
@4481  = ~«И чего же тебе надо?»~
@4482  = ~«Как насчёт того, что ты мне поможешь, а я не позову стражу?»~
@4483  = ~«Как насчёт того, что ты мне поможешь, а я не позову стражу?»~
@4484  = ~«По-моему, тебе куда лучше оставаться в живых, чем говорить мне нет… последний раз спрашиваю: как можно выбраться отсюда?»~
@4485  = ~«По-моему, тебе куда лучше оставаться в живых, чем говорить мне нет… последний раз спрашиваю: как можно выбраться отсюда?»~
@4486  = ~«Не интересно. Прощай».~
@4487  = ~Он оглядывает тебя сверху донизу, будто оценивая, кто из вас сильнее, смотрит на твои шрамы, а затем решает, что лучше не связываться: «Хм-мф. Ты мовефь бефать чеез поуталы».~
@4488  = ~Порталы?~
@4489  = ~«Ты не сбежишь, если я УБЬЮ тебя. Давай, начинай говорить, или я сделаю эту маскировку реальностью».~
@4490  = ~«Ты не сбежишь, если я УБЬЮ тебя. Давай, начинай говорить, или я сделаю эту маскировку реальностью».~
@4491  = ~Некоторое время он кажется напуганным, затем изучает тебя и расплывается в ухмылке: «Ты пфоболтаефся обо ме, а я об *тефе*. У мея фдесь пфячутся друфья, а у тея фдесь *никоо*. Тее нельфя фдесь нахоиться. Пыльники уфьют тея. А я фбегу».~
@4492  = ~«Тогда гори в аду. Я ухожу».~
@4493  = ~«Дофтань мее *ключ*. Нуфен шелефный ключ от комнаы бальфамиовання».~
@4494  = ~«Ты имеешь в виду этот ключ?»~
@4495  = ~«Ладно. Где этот ключ?»~
@4496  = ~«У меня нет на это времени. Помоги мне бежать, или я позову стражу».~
@4497  = ~«У меня нет на это времени. Помоги мне бежать, или я позову стражу».~
@4498  = ~«Я не собираюсь ничего тебе доставать. Помоги мне бежать, или я сломаю тебе шею прямо здесь и сейчас».~
@4499  = ~«Я не собираюсь ничего тебе доставать. Помоги мне бежать, или я сломаю тебе шею прямо здесь и сейчас».~
@4500  = ~«Нет, спасибо. Может, в другой раз».~
@4501  = ~«Он у офной Пыльной, — он показывает на свои глаза. — У неё жёутые глафа…» Затем он делает движения пальцами, которые напоминают тебе пару ножниц для стрижки: «Лефвия на пайцах».~
@4502  = ~«Мы уже пересекались. Вот ключ».~
@4503  = ~«Пыльная… с жёлтыми глазами и лезвиями на пальцах? Ладно. Я вернусь с ключом».~
@4504  = ~«Эта Пыльная, наверное, ничего. Ты точно не хочешь, чтобы я представил вас друг другу?»~
@4505  = ~Зомби моргает. Похоже, он тебя не понял.~
@4506  = ~«Это была шутка, вот смотри, ты… ладно, забудь, я пойду поищу ключ».~
@4507  = ~Зомби косится на тебя: «Еси тея помают, не говои офо мие. Инафе я уфью тея, поа ты будефь фпать».~
@4508  = ~«Принесу я твой проклятый ключ… но не смей мне угрожать, понял?»~
@4509  = ~«Я вернусь».~
@4510  = ~«Принесу я твой проклятый ключ… но не смей мне угрожать, понял?»~
@4511  = ~«Я вернусь».~
@4512  = ~«У мея хорофая мас-ки-рофка. У мея ефо ефть и фрамы. У мея мноа жидкофти для бальфамирофания. Иф мея полуфилфя ХОРОФЫЙ фомби, — зомби хихикает сквозь сшитые губы, затем стучит себя по голове. — Пыльники тупые».~
@4513  = ~Этот опрятный, хорошо одетый мужчина определённо куда-то направляется.~
@4514  = ~«Я фду тея фдесь. Нефи ключ, — зомби одаривает тошнотворной улыбкой. — Тофда я помоу».~
@4515  = ~«Если найду, я вернусь».~
@4516  = ~«Забудь об этом».~
@4517  = ~Глаза зомби расширяются, затем он протягивает руку и сгибает пальцы: «Дафай его фюда».~
@4518  = ~«Погоди. Мне ещё кое-что надо сделать».~
@4519  = ~«Забирай».~
@4520  = ~Глаза зомби расширяются, и он хватает ключ у тебя из рук. Затем вертит его, всё время кивая: «Хорофо… хорофо».~
@4521  = ~«Теперь… как мне отсюда выбраться?»~
@4522  = ~«Теперь… мне бы хотелось кое-что выяснить…»~
@4523  = ~«Фто ты хочефь фнать?»~
@4524  = ~«Как я могу отсюда выбраться?»~
@4525  = ~«Где этот портал, о котором ты говорил?»~
@4526  = ~«Можешь замаскировать меня под зомби?»~
@4527  = ~«Можешь опять замаскировать меня под зомби?»~
@4528  = ~«Что ты здесь делаешь?»~
@4529  = ~Ты знаешь кого-нибудь по имени Фарод?~
@4530  = ~«Я потерял дневник. Не видел его?»~
@4531  = ~«Можешь что-нибудь рассказать про Дхалла?»~
@4532  = ~«Можешь что-нибудь рассказать про Дейонарру?»~
@4533  = ~«Можешь что-нибудь рассказать про Соэго?»~
@4534  = ~«Как тебе удаётся так выглядеть?»~
@4535  = ~«Как тебе удаётся так выглядеть?»~
@4536  = ~«Неважно. У меня могут появиться вопросы позднее. Никуда не уходи».~
@4537  = ~«Фа-ОД?» — зомби задумчиво хмурится. «Я флыфал… он жиёт де-то в Улье, — он качает головой. — Не фнаю де». Затем снова хмурится: «Пыльники раффержены, им НЕ НРАФИТСЯ Фа-од».~
@4538  = ~«В Улье?»~
@4539  = ~«Почему Пыльным не нравится Фарод?»~
@4540  = ~«Я хотел бы узнать ещё кое-что…»~
@4541  = ~«Неважно. У меня могут появиться вопросы позднее. Никуда не уходи».~
@4542  = ~«Труфобы фнаужи этоо мефта».~
@4543  = ~«Почему Пыльные не любят Фарода?»~
@4544  = ~«Я хотел бы узнать ещё кое-что…»~
@4545  = ~«Неважно. У меня могут появиться вопросы позднее. Никуда не уходи».~
@4546  = ~«Он Сборфик. Пвинофит мёфтвых в Мортуарий, пводаёт их Пыльным. Пвинофит МНОО трупоф. Пыльные не фнают, откуа он беёт мефтвяков. Дуают, фто он сам их фанофит в кьигу мёфтвых».~
@4547  = ~«Э-э… что?»~
@4548  = ~«Э-э… что?»~
@4549  = ~«Я хочу ещё кое-что выяснить…»~
@4550  = ~«Неважно. У меня могут появиться вопросы позднее. Никуда не уходи».~
@4551  = ~«Не фнаю. Фто-то тея обчифтил?»~
@4552  = ~«Э-э… что?»~
@4553  = ~«Э-э… что?»~
@4554  = ~«Я хочу ещё кое-что выяснить…»~
@4555  = ~«Неважно. У меня могут появиться вопросы позднее. Никуда не уходи».~
@4556  = ~Зомби пытается заговорить, выдерживает паузу, снова пробует, затем пожимает плечами. По-видимому, лучше он объяснить не может.~
@4557  = ~«Я хочу ещё кое-что выяснить…»~
@4558  = ~«Неважно. У меня могут появиться вопросы позднее. Никуда не уходи».~
@4559  = ~Зомби бормочет: «Ты мовефь бефать чеез поуталы». Он делает движение руками: «Пу-уф».~
@4560  = ~«Порталы? Какие порталы?»~
@4561  = ~~
@4562  = ~~
@4563  = ~«Поуталы… — зомби обводит рукой всё вокруг. — Поуталы вефде».~
@4564  = ~«Можешь показать мне один из таких порталов?»~
@4565  = ~~
@4566  = ~~
@4567  = ~Зомби кивает. «Еси хочефь выбваться, иди к афке на пефвом этафе, севео-фападная комната… тее нуфна кофть пайца ифогнутой фоумы… — он поднимает свой указательный палец и сгибает его. — Кода дофтанефь кьюч, иди к афке, пуыгай в поутал и окажефься в склепе, откуа можефь с леукофтью выбваться наужу». Он оживлённо кивает: «Там ты можефь ОДОФНУТЬ».~
@4568  = ~«У меня другие вопросы…»~
@4569  = ~«Арка на первом этаже, северо-западная комната? Ладно, пойду проверю».~
@4570  = ~«Слуфай! Фапомиай! — зомби злится. — Афка, пефвый этаж, севео-фападная комната…» Он поднимает свой указательный палец и сгибает его: «Тее нуфна кофть пайца. Идефь в секрефный поуход. Доога к спафению. Там ты можефь ОДОФНУТЬ».~
@4571  = ~«Я хотел бы узнать ещё кое-что…»~
@4572  = ~«Арка, первый этаж, северо-западная комната, открывается кривой пальцевой костью? Ладно, теперь понял».~
@4573  = ~«Пифарь, — он пожимает плечами. — Фтарый. Жёлтый».~
@4574  = ~«Больше нечего сказать, я полагаю. Но мне ещё кое-что надо знать…»~
@4575  = ~«Неважно. У меня могут появиться вопросы позднее. Никуда не уходи».~
@4576  = ~«Хмн? — он хмурится. — Фто она?»~
@4577  = ~«Забудь. Я хочу знать ещё кое-что…»~
@4578  = ~«Неважно. У меня могут появиться вопросы позднее. Никуда не уходи».~
@4579  = ~«Гид. Он у главных воот Мовтуаия. Что тебе от него нуфно?»~
@4580  = ~«Что ты о нём знаешь?»~
@4581  = ~«Неважно. У меня могут появиться вопросы позднее. Никуда не уходи».~
@4582  = ~«Стванно себя ведёт, не Пыльный, не Анавхист, глафа меняются… — он пожимает плечами. — Похож на крысу. Стванно».~
@4583  = ~«Хорошо, что он тут один такой странный. Мне ещё кое-что нужно выяснить…»~
@4584  = ~«Неважно. У меня могут появиться вопросы позднее. Никуда не уходи».~
@4585  = ~Перед тобой стоит фальшивый зомби. Ты буквально поражён такой маскировкой… его дыхание так приглушено, что почти незаметно.~
@4586  = ~«Приветствую».~
@4587  = ~«Приветствую».~
@4588  = ~«Приветствую».~
@4589  = ~«Приветствую».~
@4590  = ~Оставить его в покое.~
@4591  = ~Зомби быстро оглядывается, чтобы удостовериться, что никто не смотрит, и поворачивается к тебе: «Фто?»~
@4592  = ~«Вот ключ от комнаты бальзамирования».~
@4593  = ~«Вот ключ от комнаты бальзамирования».~
@4594  = ~«Где тот ключ, про который ты говорил?»~
@4595  = ~«У меня вопросы…»~
@4596  = ~«Неважно».~
@4597  = ~Зомби быстро оглядывается, чтобы удостовериться, что никто не смотрит, затем машет на тебя рукой и шипит: «Иди отфюда! Фали!»~
@4598  = ~«Нет. Сперва я бы хотел задать пару вопросов…»~
@4599  = ~«Неважно».~
@4600  = ~«Неважно».~
@4601  = ~«У мея хорофая мас-ки-рофка. У мея ефо ефть и фрамы. У мея мноа жидкофти для бальфамирофания. Иф мея полуфилфя ХОРОФЫЙ фомби, — зомби хихикает сквозь сшитые губы, затем стучит себя по голове. — Пыльники тупые».~
@4602  = ~«Да, это *они* тупые. Точно».~
@4603  = ~«А это не больно?»~
@4604  = ~«Отличная маскировка. Скажи… можешь и меня замаскировать под зомби?»~
@4605  = ~«Я хотел бы узнать ещё кое-что…»~
@4606  = ~«Я должен идти. Прощай».~
@4607  = ~Сарказм определённо не доходит до зомби, он оживлённо кивает: «Ту-упые Пыльники. Я делаю ХОРОФИХ фомби».~
@4608  = ~«А это не больно?»~
@4609  = ~«Отличная маскировка. Можешь меня замаскировать под зомби?»~
@4610  = ~«Я хотел бы узнать ещё кое-что…»~
@4611  = ~«Я должен идти. Прощай».~
@4612  = ~«Я хотел бы узнать ещё кое-что…»~
@4613  = ~«Я должен идти. Прощай».~
@4614  = ~Зомби смотрит на твои шрамы. «Я фадал бы тее тот же вопвос. Нет, это не больно, — он хлопает себя по груди. — Я КИЕПКИЙ».~
@4615  = ~«Отличная маскировка. Можешь меня замаскировать под зомби?»~
@4616  = ~«Я хотел бы узнать ещё кое-что…»~
@4617  = ~«Я должен идти. Прощай».~
@4618  = ~«Я хотел бы узнать ещё кое-что…»~
@4619  = ~Он оглядывает тебя сверху донизу, что-то бормоча себе под нос, затем кивает: «Уху. Мие нуфен сосуд с жидкофтью для бальфамирофания». Указывает на шрамы на твоей груди: «И нитка ф игоукой».~
@4620  = ~«Держи».~
@4621  = ~«Я подумаю над этим. У меня есть ещё вопросы…»~
@4622  = ~«Нет, спасибо. Может, в другой раз… прощай».~
@4623  = ~«Жидкость для бальзамирования и нитка? Пойду поищу».~
@4624  = ~Он оглядывает тебя сверху вниз со странным выражением на лице. «Ты будефь ХОВОФИМ фомби. Я могу фделать из тя фомби. ХОРОФАЯ маскивовка».~
@4625  = ~«В любом случае спасибо. У меня есть ещё вопросы…»~
@4626  = ~«Конечно. Ты можешь это сделать?»~
@4627  = ~«Почему бы и нет? Я уже чувствую себя, как ходячий мертвец».~
@4628  = ~«Нет… нет… и так нормально. Прощай».~
@4629  = ~Зомби берёт у тебя всё необходимое и принимается за работу…~
@4630  = ~Попробовать не двигаться.~
@4631  = ~Попробовать не двигаться.~
@4632  = ~Попробовать не двигаться.~
@4633  = ~Зомби обильно наносит бальзамирующую жидкость на твоё тело, затем сшивает некоторые из твоих шрамов. Начиная с ног и поднимаясь вверх, он сшивает шрамы, а затем заканчивает маскировку, сшивая твои губы.~
@4634  = ~«М-м-м хм-м-м… фпафибо».~
@4635  = ~«М-м-м хм-м-м… фпафибо».~
@4636  = ~«М-м-м хм-м-м… фпафибо».~
@4637  = ~Зомби поднимает руку: «Офтовожно! Рафгооры рфут швы, унифтожают мафкирофку. Фомби не говоят. Тее нао говоить? Говои медвенно, офторофно».

^NПРИМЕЧАНИЕ. Стоит учесть, никто не ожидает, что зомби будет говорить. Если заговорить с кем-то, находясь в маскировке зомби, есть риск быть раскрытым.^-~
@4638  = ~«М-мф… м-м-м. Я… понял».~
@4639  = ~Зомби хмурится: «Маскирофка доуго не деужится… бальфамируюфая жифкость выфохнет, фвы рафойдутся». Он пожимает плечами: «Навевно доуго не продевжится за пведелами Мовтуаия. И нельфя бегать! Еси ты побежифь — рафрушишь вфю маскирофку».

^NПРИМЕЧАНИЕ. Если вооружиться и/или побежать, вся маскировка сразу же будет сведена на нет. Если найдено новое оружие, стоит воздержаться пользоваться им, пока не захочется снять маскировку. Настройку «Всегда бежать» нужно выключить, чтобы оставаться в маскировке после разговора с Ваксисом.^-~
@4640  = ~Снова кивнуть и уйти.~
@4641  = ~«Зомби» хмурится: «Ты кажефся мне фнакомым. Я тефя раньфе не фидел?»~
@4642  = ~«Может быть. Где ты меня видел?»~
@4643  = ~«Нет».~
@4644  = ~К твоему удивлению, зомби отворачивается… он начинает испуганно оглядываться.~
@4645  = ~«Не хочешь говорить? Тогда приготовься кричать».~
@4646  = ~«Неважно. Чем занимаются Пыльные?»~
@4647  = ~«Я хотел бы узнать ещё кое-что…»~
@4648  = ~«Забудь. Прощай, *зомби*».~
@4649  = ~Зомби испуганно смотрит на вас обоих. Он всё ещё молчит… но что-то в нём говорит тебе, что догадка Морте была правильной.~
@4650  = ~«Анархист, да? Для них ты следишь за этим местом?»~
@4651  = ~«Ты будешь не так СИЛЬНО мучиться от боли, если скажешь мне, зачем Анархисты послали тебя следить за этим местом».~
@4652  = ~«Неважно. Чем занимаются Пыльные?»~
@4653  = ~«Я хотел бы узнать ещё кое-что…»~
@4654  = ~«Забудь. Прощай, *зомби*».~
@4655  = ~Зомби выглядит разочарованным, но пожимает плечами и начинает искать что-то у себя за пазухой. «Тихо вфё. Пыльные все тихие, нифиво нофого со фьемени пофлетнего доклада, — через мгновение он протягивает тебе какие-то предметы, затем хрюкает. — Вот». Судя по запаху, они были спрятаны так, чтобы нельзя было найти при обыске. «Я фяс пойду».~
@4656  = ~«Уходишь? Как?»~
@4657  = ~~
@4658  = ~Зомби бормочет: «Поутал — это афка. Пефвый этаж, севео-фападная комната. Нуфна кофть пайца от скеета, фтобы его откыть». Он кивает: «Удафи».~
@4659  = ~«Ладно».~
@4660  = ~Глаза зомби сужаются, и он шипит на тебя: «ПОПФОБУЕШЬ фапифать мея в кьиу мёфтвых? У мея фдесь пфячутся друфья. Тронефь мея — они уфьют ТЕА».~
@4661  = ~«Это был твой последний шанс. Приготовься к смерти».~
@4662  = ~«Тогда гори в аду. Я ухожу. А ты лучше сам поберегись… *зомби*».~
@4663  = ~Некоторое время он кажется напуганным, затем изучает твоё сложение и ухмыляется: «ПОПФОБУЕШЬ фапифать мея в кьиу мёфтвых? У мея фдесь пфячутся друфья, у тея фдесь *никоо*. Тронефь мея — они уфьют ТЕЯ».~
@4664  = ~«А если я открою твою маскировку страже?»~
@4665  = ~«А если я открою твою маскировку страже?»~
@4666  = ~«Я рискну. Приготовься к смерти».~
@4667  = ~«Тогда гори в аду. Я ухожу. А ты лучше сам поберегись… *зомби*».~
@4668  = ~Глаза зомби сужаются, и он шипит на тебя: «Ты пфоболтаефся обо ме, а я об *тефе*. У мея фдесь пфячутся друфья, а у тея фдесь *никоо*. Пыльники уфьют тея. А я фбегу».~
@4669  = ~«Это был твой последний шанс, трупак. Приготовься к смерти».~
@4670  = ~«Тогда гори в аду. Я ухожу. А ты лучше сам поберегись… *зомби*».~
@4671  = ~«А?»~
@4672  = ~«Порталы?»~
@4673  = ~«Знаешь кого-нибудь по имени Фарод?»~
@4674  = ~«Я должен идти. Прощай».~
@4675  = ~Морте встревает и шепчет: «Во имя сил… этот пень — *Анархист*. Прикидываться зомби вполне в духе этих пустоголовых малых».~
@4676  = ~«Анархист?»~
@4677  = ~«Анархисты… это фракция… — Морте выглядит так, будто собирается выдать тираду оскорблений, затем замечает, что зомби пялится на вас обоих, внимательно слушая, — …они, э, хотят *освободить* всех от цепей правительства. Свергнуть старый и установить новый порядок вообще без какого-либо порядка».~
@4678  = ~Правда: «Похоже на благородное стремление. Порядку может пойти на пользу, если его время от времени свергать».~
@4679  = ~Ложь: «Похоже на благородное стремление. Любой Анархист, преданный подобным возвышенным целям, *определённо* мой друг».~
@4680  = ~«Это представляется довольно… противоречивым».~
@4681  = ~«Одна из самых глупых вещей, которые я когда-либо слышал».~
@4682  = ~Правда: «Непохоже, что это для кого-либо окажется конструктивным. Хоть какой-то порядок, какой-то закон всегда необходимы для прогресса».~
@4683  = ~Морте шепчет: «Он интересуется, не чокнутый ли ты… мне, кстати, тоже интересно. Давай, заканчивай свою песню „я очнулся после смерти“, ага? Ты меня смущаешь».~
@4684  = ~«Я смущаю ТЕБЯ?»~
@4685  = ~«Я просто хотел знать, о чём этот… труп… говорил. Ладно?»~
@4686  = ~«Я не виноват, что никто в этом чокнутом… „спятившем“… месте не говорит как нормальный человек… или хотя бы ВЫГЛЯДИТ нормальным».~
@4687  = ~«Слушай, я НЕ СОБИРАЮСЬ врать этому парню. Лучше быть с ним честным».~
@4688  = ~Морте вздыхает: «Послушай, шеф… включай мозги. Ты не можешь всем всё время говорить ПРАВДУ. Мы не можем себе позволить, чтобы каждый встречный прощелыга брал нас на мушку, понятно?»~
@4689  = ~«„Прощелыга“? „На мушку“? Какого… ладно, неважно».~
@4690  = ~«Закройся, Морте».~
@4691  = ~«Приму к сведению. Я всё ещё хочу поговорить с этим „зомби“».~
@4692  = ~«Погоди-ка… — на Морте словно находит озарение. — Этот пень явно *Анархист*. Хе. Прикидываться зомби вполне в духе этих пустоголовых малых».~
@4693  = ~«Анархист?»~
@4694  = ~«Анархисты… это фракция, которая тратит своё время на шпионаж за властями и поиски способов свергнуть всё, что хоть как-то связано с контролем или порядком, — Морте фыркает. — Анархисты думают, что если изничтожить правящую верхушку, то каждый пень на планах будет счастлив и свободен в поисках собственной „правды“. Они хотят установить новый порядок — чтобы порядка не было вообще».~
@4695  = ~Правда: «Похоже на благородное стремление. Порядку может пойти на пользу, если его время от времени свергать».~
@4696  = ~«Это представляется довольно… противоречивым».~
@4697  = ~«Одна из самых глупых вещей, которые я когда-либо слышал».~
@4698  = ~«Как скажешь».~
@4699  = ~Правда: «Непохоже, что это для кого-либо окажется конструктивным. Хоть какой-то порядок, какой-то закон всегда необходимы для прогресса».~
@4700  = ~«Он говорит, что этот пень Фарод продаёт много мертвецов… трупаков… Пыльным. Этим занимаются Сборщики: они собирают мёртвые тела и продают их Пыльным. Похоже, этот Фарод продаёт слишком много трупов, и Пыльные думают, что он прописывает народ в книгу мёртвых, прежде чем им суждено… короче, убивает людей».~
@4701  = ~«Ясно. Я бы ещё кое-что хотел бы выяснить…»~
@4702  = ~«Похоже, этот Фарод прямо святой. Может, у меня потом появятся вопросы. Никуда не уходи».~
@4703  = ~«Он хочет знать, может, тебя ограбили? Наверно, так оно и было».~
@4704  = ~«Ясно. Я бы ещё кое-что хотел бы выяснить…»~
@4705  = ~«Ага, и мне не терпится найти этого вора. Слушай, у меня могут появится вопросы позднее. Никуда не уходи».~
@4706  = ~«Ага, *они* тупые, точно».~
@4707  = ~Экран статистики~
@4708  = ~«Не могу поверить, что ты решился на это. СОВСЕМ двинулся?»~
@4709  = ~Свиток священника~
@4710  = ~«Не мог бы ты покрепче сшить ему губы?»~
@4711  = ~«Туп-п-пой, Морте…»~
@4712  = ~«М-м-м ХМ-МФ!»~
@4713  = ~Литания проклятий~
@4714  = ~Центральная палата~
@4715  = ~Препарационная комната.~
@4716  = ~Приёмная.~
@4717  = ~Крематорий~
@4718  = ~СИЛ~
@4719  = ~Расписка Боготов~
@4720  = ~Расписка~
@4721  = ~Раскрывающийся портал~
@4722  = ~Щипцы~
@4723  = ~Кузнечный молот~
@4724  = ~Железная руда~
@4725  = ~Топор из рогов~
@4726  = ~Некачественный стилет~
@4727  = ~Высококачественная кувалда~
@4728  = ~Укус Морте~
@4729  = ~«Разве ты не должен был уйти? Стража! Сопроводите этого пня на выход!»~
@4730  = ~Уйти.~
@4731  = ~«На помощь! Стража! Стража!»~
@4732  = ~Атаковать.~
@4733  = ~Уйти.~
@4734  = ~«Высшие силы! Наши машины уничтожены! Где же теперь фактол возьмёт деньги нам на зарплату? Хорошо, что мы преданны нашей цели. Я должен вернуться к работе… теперь придётся вкалывать вдвойне. Адово испытание».~
@4735  = ~Уйти.~
@4736  = ~«Привет, брат! Жаль, что у меня нет времени поговорить с тобой, но расплавленная сталь никого не ждёт. Если тебе что-нибудь надо, поговори с бригадирами вон там… у них время найдётся».~
@4737  = ~«Хорошо. Удачи».~
@4738  = ~«Так ты расследуешь убийство, да? Не могу сказать, что я очень расстроился, узнав о смерти этого ублюдка, но с другой стороны, не было никого, кто бы сочувствовал этому пьянице. Где тебе искать? Я не знаю».~
@4739  = ~«Но ты хотел бы сказать мне ещё кое-что, не так ли?»~
@4740  = ~«Но ты хотел бы сказать мне ещё кое-что, не так ли?»~
@4741  = ~«Ладно. Можешь опять рассказать, как пользоваться кузницей?»~
@4742  = ~«Хорошо. Спасибо, что уделил мне время».~
@4743  = ~«Ну… — кузнец украдкой оглядывается. — Лучше всего тебе начать с бригадирши. В последнее время она что-то малость раздражённая. Не думаю, что это её рук дело, но, возможно, у неё есть какие-нибудь мысли насчёт того, кто бы это мог быть».~
@4744  = ~«Бригадирша? Где мне её найти?»~
@4745  = ~«Спасибо, что уделил мне время. До свидания».~
@4746  = ~«Нет, я и так уже много сказал».~
@4747  = ~«Ладно. Можешь опять рассказать, как пользоваться кузницей?»~
@4748  = ~«Хорошо. Спасибо, что уделил мне время».~
@4749  = ~«Ты хочешь работать в кузнице. Во-первых, тебе нужен защитный фартук. Затем тебе нужны щипцы, молот и свободная наковальня. Берёшь немного руды, кладёшь в огонь, пока она не раскалится, а потом долбишь по ней на наковальне как ошпаренный. Когда добьёшься нужной формы, опусти в ведро с водой, которое стоит рядом. Это поверхностный курс, обрати внимание… тебе нужен навык, чтобы справится».~
@4750  = ~«Разве тут могут быть сложности?»~
@4751  = ~«Хорошо. У меня другие вопросы».~
@4752  = ~«Хорошо. Спасибо».~
@4753  = ~«Обычно её можно найти в канцелярии… наблюдающей за нами. Дьявол, это её работа, но мне-то хоть можно было бы доверять».~
@4754  = ~«Спасибо. У меня другие вопросы».~
@4755  = ~«Если тебе можно было бы доверять — и бригадир был бы не нужен. До свидания».~
@4756  = ~«Могу себе представить. Прощай».~
@4757  = ~«Ты будешь удивлён, пень. Убирайся. Я занят».~
@4758  = ~Уйти.~
@4759  = ~«Ты будешь удивлён, пень. Убирайся. Я занят».~
@4760  = ~«Да? Чего? Побыстрее. Я занят».~
@4761  = ~«Кто ты?»~
@4762  = ~«Где мне найти канцелярию?»~
@4763  = ~«Где ваш бригадир?»~
@4764  = ~«Что ты здесь делаешь?»~
@4765  = ~«Что ты можешь рассказать о Боготах?»~
@4766  = ~«Что? Я слишком занят, чтобы болтать с окружающими. Тебе надо чего-то конкретного?»~
@4767  = ~«Ну, да».~
@4768  = ~«Нет. Вообще-то нет».~
@4769  = ~«Тогда хватит тратить моё время. У меня плотный график. Всего хорошего».~
@4770  = ~Уйти.~
@4771  = ~«Видишь комнату вон там с письменным столом и стариком за ним? Это и есть канцелярия, а за столом сидит клерк. Ещё чего-нибудь надо или я уже могу возвращаться к работе?»~
@4772  = ~«У меня есть ещё вопросы».~
@4773  = ~«Нет, мне пора. Пока».~
@4774  = ~«Прохлаждаюсь весь день. Слушай, не хочу показаться грубым, но неужели не очевидно, что я здесь делаю: кую железо. И если я быстро не вернусь к работе, то мне придётся всё начинать с начала».~
@4775  = ~«Ладно-ладно. У меня всего пара вопросов».~
@4776  = ~«Спасибо, что уделил мне время. Прощай».~
@4777  = ~«Нет нужды для такого отношения, „друг“. Доброго дня».~
@4778  = ~Кузнец перестаёт работать и смотрит на тебя, как бы оценивая: «Богот — это чувак, который верит, что все мы можем быть богами. Даже ты. Неважно, к добру или к худу… все мы проходим сквозь наше существование, учась, как развиться в более совершенные формы. Другое определение Богота — это тот, кто относится подозрительно к людям, задающим вопросы, на которые сами должны знать ответы».~
@4779  = ~«Так ты говоришь, что мы должны пройти испытание, чтобы стать совершеннее?»~
@4780  = ~«Хочешь сказать, ты не лучший собеседник, с кем можно было бы это сейчас обсудить?»~
@4781  = ~«Спасибо. Ухожу».~
@4782  = ~«Я говорю, что тебе следует поговорить с одним из фактотумов, которые сидят вон за той дверью в восточной стене, — им всё равно время девать некуда. А мне есть куда. Всего хорошего».~
@4783  = ~«У меня есть ещё вопросы».~
@4784  = ~Уйти.~
@4785  = ~«Друг, я думаю, ты достаточно поработал. Все поверили, что у тебя есть… э-э… некоторый навык в этом. Отойди-ка и дай поработать другим, кто действительно нуждается в этом».~
@4786  = ~«Ладно, принято».~
@4787  = ~«Высшие силы! Наши машины уничтожены! Где же теперь фактол возьмёт деньги нам на зарплату? Хорошо, что мы преданны нашей цели. Я должен вернуться к работе… теперь придётся вкалывать вдвойне. Адово испытание».~
@4788  = ~Уйти.~
@4789  = ~«Высшие силы! Наши машины уничтожены! Где же теперь фактол возьмёт деньги нам на зарплату? Хорошо, что мы преданны нашей цели. Я должен вернуться к работе… теперь придётся вкалывать вдвойне. Адово испытание».~
@4790  = ~Уйти.~
@4791  = ~«Забудь».~
@4792  = ~«Некоторые подписывают договор, позволяющий Пыльным использовать их тела после смерти. Возможно, ты стал жертвой… необычного стечения обстоятельств. Ты кажешься гораздо умнее, чем наши обычные зомби».~
@4793  = ~«Люди продают вам свои тела после смерти?»~
@4794  = ~«О. У меня другие вопросы…»~
@4795  = ~«У меня нет на это времени. Прощай».~
@4796  = ~«О, да. У многих возникает соблазн за небольшую сумму медью продать тело, которое больше не понадобится, когда они достигнут Истинной Смерти».~
@4797  = ~«Что Пыльные делают с этими телами?»~
@4798  = ~«Ясно… ты не против, если я задам ещё вопрос?»~
@4799  = ~«Спасибо за информацию. Прощай».~
@4800  = ~«Оболочки выполняют всю чёрную работу в Мортуарии. Они таскают тела, моют полы, помогают нам подготавливать тела для похорон… относительно простые задания. Жаль, но они не способны на что-то более интеллектуальное».~
@4801  = ~«Ладно, „контрактник“ или нет, но как я попал сюда, если не был мёртв?»~
@4802  = ~«Ясно… ты не против, если я задам ещё вопрос?»~
@4803  = ~«Спасибо за информацию. Прощай».~
@4804  = ~Соэго кивает: «Можешь спрашивать».~
@4805  = ~«Я бы хотел уйти. Можешь провести меня к выходу?»~
@4806  = ~«Можешь вывести меня отсюда?»~
@4807  = ~«Знаешь, на втором этаже есть труп, который на деле загримированный человек».~
@4808  = ~«То есть?»~
@4809  = ~«Позволь полюбопытствовать… с тобой всё в порядке? Выглядишь уставшим».~
@4810  = ~«Ты Соэго, верно? Я слышал, что для Пыльного ты немного странный. Ведёшь себя как крыса».~
@4811  = ~«Ты Соэго, верно? Я слышал, что для Пыльного ты немного странный. Ведёшь себя как крыса».~
@4812  = ~Качественное зеркало~
@4813  = ~Железная руда~
@4814  = ~P3 SFull~
@4815  = ~Серебряная серьга~
@4816  = ~Сердце Хакарии~
@4817  = ~Исход души~
@4818  = ~Отгонять нежить~
@4819  = ~Печень Хакарии~
@4820  = ~Булыжник~
@4821  = ~Обточенная медная монета~
@4822  = ~Посмертный договор Ангияра~
@4823  = ~Посмертный договор Медноглазого~
@4824  = ~Поддельный посмертный договор~
@4825  = ~Древковое оружие~
@4826  = ~Подвеска-череп~
@4827  = ~Малый меч~
@4828  = ~Кинжал Адана~
@4829  = ~Кольцо Адана~
@4830  = ~Плоский чёрный знак~
@4831  = ~Крысиный амулет~
@4832  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@4833  = ~«Я потерял дневник. Не видел ничего похожего?»~
@4834  = ~«Не стоит беспокойства. Я должен идти. Прощай».~
@4835  = ~«Не стоит беспокойства. Я должен идти. Прощай».~
@4836  = ~«Человек наверху маскируется под труп. Я думаю, он шпионит за Пыльными».~
@4837  = ~«Человек наверху маскируется под труп. Я думаю, он шпионит за Пыльными».~
@4838  = ~«Забудь. У меня другие вопросы…»~
@4839  = ~«Забудь. Я должен идти. Прощай».~
@4840  = ~«Что? Зачем кому-то?..» — голос Соэго внезапно понижается до шипения, а его губы расходятся, открывая ряд неровных зубов. «*Анархист*, — в его глазах появляется ярко-красный отблеск. — Анархист. *Здесь*». Вдруг он словно вспоминает о твоём присутствии и обращается к тебе: «Спасибо за информацию. Я прослежу, чтобы стража занялась этим делом».~
@4841  = ~РАСКРЫВАЮЩИЙСЯ ПОРТАЛ
Вес: 10
Доступно только Безымянному

Это блестящее металлическое изделие филигранной работы, которое ты получил в Великой Кузнице. Выглядит оно почти прозрачным, с краёв выступают острые концы. Ты и понятия не имеешь, куда ведёт портал, но он должен быть очень важен для твоей главной цели.

Всё, что тебе нужно для его активации, — это отыскать нужный ключ.~
@4842  = ~ЩИПЦЫ
Вес: 5

Эти покрытые сажей щипцы используются для того, чтобы держать железную руду в огне печи.~
@4843  = ~КУЗНЕЧНЫЙ МОЛОТ
Вес: 4

Молот, используемый для ковки раскалённой руды. Очень тяжёлый.~
@4844  = ~ЖЕЛЕЗНАЯ РУДА
Вес: 5

Кусок железной руды.~
@4845  = ~НЕКАЧЕСТВЕННАЯ КУВАЛДА
Урон: 2-7 дробящий
Фактор скорости: 8
Вес: 10
Навык: молот
Доступно: воинам

Этот молот представляет собой немногим больше, чем тяжёлый кусок металла на конце прочной палки. Да, кувалда мощная, но с плохим балансом и полным отсутствием изящества.~
@4846  = ~ВЫСОКОКАЧЕСТВЕННАЯ КУВАЛДА
Урон: 1-10 дробящий
Фактор скорости: 8
Вес: 9
Навык: молот
Доступно: воинам

Этот превосходно выполненный молот хорошо сбалансирован и приятен для глаз. Но не засматривайся на внешний вид — это оружие опасно. Необходимы две руки и желание нанести дробящий урон своим врагам.~
@4847  = ~ВЫСОКОКАЧЕСТВЕННЫЙ СТИЛЕТ
Урон: 1-4 колющий
Фактор скорости: 1
Вес: 1
Навык: клинок
Недоступно: священникам

Этот тонкий кинжал — образец красоты среди себе подобных. Это одноручное колющее оружие.~
@4848  = ~НЕКАЧЕСТВЕННЫЙ СТИЛЕТ
Урон: 1-2 колющий
Фактор скорости: 2
Вес: 1
Навык: клинок
Недоступно: священникам

Этот короткий кинжал можно считать колющим оружием только в идеале. Выглядит стилет так, будто лучше всего его использовать в качестве пресс-папье: он и не острый, и не сбалансированный, и может разве только мешать в бою.~
@4849  = ~ТОПОР ИЗ РОГОВ
Урон: 2-7 рубящий
Фактор скорости: 8
Вес: 8
Навык: топор
Доступно: воинам

Примитивные культуры часто использовали части животных в качестве оружия. Похоже, это рога какого-то животного, из которых сделали грубую разновидность боевого топора.~
@4850  = ~БУЛЫЖНИК
Вес: 3

Это отполированный булыжник, который находился в черепе зомби. С него по-прежнему капают остатки мозгового вещества.~
@4851  = ~КОЖАНЫЙ ФАРТУК
Вес: 5

Тяжёлый фартук, сделанный из кожи какого-то животного. Такие фартуки используются, чтобы защитить одежду рабочих от жара, исходящего от топки.~
@4852  = ~«Нет проблем. У меня есть ещё вопросы…»~
@4853  = ~«Ладно. Я должен идти. Прощай».~
@4854  = ~«Ладно. Я должен идти. Прощай».~
@4855  = ~Ты уже собираешься всё это произнести, но внезапно останавливаешься. Странное чувство не даёт покоя, когда ты смотришь на Соэго… по какой-то причине ты понимаешь, что не стоит ничего говорить.~
@4856  = ~«Я слышал, ты странный, Соэго. Совсем как крысы».~
@4857  = ~«Э-э… я хотел кое-что спросить».~
@4858  = ~«Не стоит беспокойства. Я должен идти. Прощай».~
@4859  = ~«Не стоит беспокойства. Я должен идти. Прощай».~
@4860  = ~Соэго замолкает, изучая тебя. В его глазах появляется ярко-красный отблеск, и он слегка шипит: «Я думаю, ты засиделся у нас в гостях». Неожиданно он делает шаг назад, затем трижды звонко хлопает в ладоши. В ответ в Мортуарии начинает звонить большой железный колокол.~
@4861  = ~«Какого?.. Что ты делаешь?»~
@4862  = ~«Ладно. Приготовься умереть, Соэго».~
@4863  = ~Соэго изображает слабое подобие улыбки, уголки его губ слегка подёргиваются: «Недавно я болел… небольшая лихорадка, ничего более. Иногда она затрудняла… сон».~
@4864  = ~«Могу я чем-нибудь помочь?»~
@4865  = ~«О. У меня другие вопросы…»~
@4866  = ~«Ясно. Ну, я должен идти. Прощай».~
@4867  = ~«Ясно. Ну, я должен идти. Прощай».~
@4868  = ~Соэго качает головой: «Нет-нет, спасибо за беспокойство… я справлюсь». Он слегка хмурится: «Ты хотел чего-нибудь ещё?»~
@4869  = ~«Да. У меня другие вопросы…»~
@4870  = ~«Нет, не буду больше тебя беспокоить. Спасибо за информацию».~
@4871  = ~«Нет, не буду больше тебя беспокоить. Спасибо за информацию».~
@4872  = ~«Фарод? Конечно, я его знаю, — он хмурится, а его глаза вспыхивают красными огоньками. — Омерзительный человек. Никакого уважения к мёртвым, а к живым и того меньше. Он Сборщик».~
@4873  = ~«Сборщик?»~
@4874  = ~«Не знаешь, где я мне найти?»~
@4875  = ~«А. У меня другие вопросы…»~
@4876  = ~«Ясно. Пожалуй, я пойду».~
@4877  = ~«Ясно. Пожалуй, я пойду».~
@4878  = ~«Сборщики зарабатывают себе на жизнь, собирая трупы и принося их в Мортуарий. А мы затем следим, чтобы тела были должным образом захоронены».~
@4879  = ~«Значит, если Сборщик находит тело… моё, например… он, скорее всего, принесёт его сюда и продаст вам?»~
@4880  = ~«Так этот Сборщик, Фарод… не знаешь, где мне его найти?»~
@4881  = ~«А. У меня другие вопросы…»~
@4882  = ~«Ясно. Ну, я должен идти. Прощай».~
@4883  = ~«Ясно. Ну, я должен идти. Прощай».~
@4884  = ~«Да».~
@4885  = ~«Хм-м. Мне необходимо поговорить с Фародом. Не знаешь, где его найти?»~
@4886  = ~«Ясно. У меня другие вопросы…»~
@4887  = ~«Спасибо за информацию. Прощай».~
@4888  = ~«Спасибо за информацию. Прощай».~
@4889  = ~«Он обитает в Улье, в трущобах за пределами Мортуария, но где точно — я не знаю. Другие Сборщики могут знать, но вот скажут ли они тебе…»~
@4890  = ~«Повтори ещё раз, что эти Сборщики делают?»~
@4891  = ~«О. У меня другие вопросы…»~
@4892  = ~«Спасибо за информацию. Прощай».~
@4893  = ~«Спасибо за информацию. Прощай».~
@4894  = ~«Дневник? — Соэго выглядит озадаченным. — Нет, ничего такого не видел».~
@4895  = ~«Не беда. У меня есть ещё вопросы…»~
@4896  = ~«Всё равно спасибо. Прощай».~
@4897  = ~«Всё равно спасибо. Прощай».~
@4898  = ~Ты видишь устало выглядящего человека в чёрном одеянии. В глаза бросается необычайная бледность его худощавого лица, и вообще он выглядит так, будто давно не спал: плечи ссутулены, под налитыми кровью глазами большие мешки. Он так глубоко задумался, что даже не замечает тебя.~
@4899  = ~«Приветствую».~
@4900  = ~~
@4901  = ~~
@4902  = ~~
@4903  = ~~
@4904  = ~«Приветствую…» — человек поворачивается к тебе и слегка кивает. Неожиданно ты замечаешь, что его глаза не налиты кровью, а просто слегка покраснели. «Я Соэго. Чем могу… — внезапно он замечает твои шрамы, и уголки его губ слегка дёргаются. — Прошу прощения, любезный, ты потерялся?»~
@4905  = ~«Да».~
@4906  = ~«Нет».~
@4907  = ~«Нет, я не потерялся. У меня пара вопросов…»~
@4908  = ~«Нет. Я просто искал выход. Прощай».~
@4909  = ~«Ну, тогда… — уголки губ Соэго снова дёргаются, как будто от неприязни. — Позволь я позову стражу, чтобы она проводила тебя. Подожди минутку». Похоже, он собирается позвать стражу.~
@4910  = ~«Подожди! Пожалуйста… нет необходимости звать стражу. Я был здесь на похоронах и просто заплутал в этих залах… Можешь показать мне выход?»~
@4911  = ~«Нет! Я просто оговорился».~
@4912  = ~Сломать ему шею, прежде чем он закричит.~
@4913  = ~Сломать ему шею, прежде чем он закричит.~
@4914  = ~Быстро уйти.~
@4915  = ~Ждать.~
@4916  = ~«Я не припомню, чтобы впускал тебя, — Соэго смотрит на тебя подозрительно, его глаза вспыхивают в свете факелов красными огоньками. — Могу я спросить, что ты здесь делаешь?»~
@4917  = ~«Я был на похоронах, отдавал дань уважения. Уже готов был уйти… но что-то заплутал здесь. Не поможешь мне найти выход?»~
@4918  = ~«Не твоё дело».~
@4919  = ~«Я очнулся на одной из плит в вашей препарационной».~
@4920  = ~«Я здесь, чтобы кое с кем увидеться».~
@4921  = ~«Я был здесь на похоронах, но кажется, произошла ошибка».~
@4922  = ~Нагнуться к нему, будто собираешься что-то прошептать, а когда он наклонится в ответ, сломать ему шею.~
@4923  = ~Быстро уйти.~
@4924  = ~Он выглядит удивлённым: «Ты… очнулся на одной из плит наверху?»~
@4925  = ~«Э-э… нет. Я оговорился».~
@4926  = ~«Да. Я знаю, в это трудно поверить, но это правда: я проснулся на одной из ваших плит наверху».~
@4927  = ~Соэго кивает: «С кем ты должен здесь увидеться? Я буду несказанно рад направить тебя».~
@4928  = ~«Не твоё дело».~
@4929  = ~«Я здесь, чтобы увидеть Дхалла».~
@4930  = ~«Я здесь, чтобы навестить Дейонарру».~
@4931  = ~Ложь: «Э-э… с Аданом. Он ещё работает здесь, или?..»~
@4932  = ~Ложь: «Э-э… с Аданом. Он ещё работает здесь, или?..»~
@4933  = ~«Э-э, ни с кем. Я оговорился».~
@4934  = ~«Дхалла? Писаря Дхалла можно найти в приёмной на верхнем этаже, — уголок губ Соэго коротко дёргается. — Он несколько занят. И со здоровьем у него не всё в порядке. Только если у тебя очень срочное дело, иначе я бы не стал его беспокоить».~
@4935  = ~«А что с Дхаллом?»~
@4936  = ~«Приёмная?»~
@4937  = ~«Хорошо. Надолго я его не задержу. Прощай».~
@4938  = ~«Да… приёмная — это место, куда попадают тела из города, когда их доставляют в Мортуарий. Там их записывают, а затем готовят к похоронам».~
@4939  = ~«А что с Дхаллом?»~
@4940  = ~«Спасибо за указания. Надолго я его не задержу. Прощай».~
@4941  = ~«О, с ним всё в порядке. Дхалл… — Соэго щёлкает зубами, — …*стар*. Его преданность делу каталогизации мёртвых почти довела его до могилы. Смерть, без сомнения, последует за его изнуряющей болезнью».~
@4942  = ~«Хорошо. Надолго я его не задержу. Прощай».~
@4943  = ~«Дейонарра? Женщина с этим именем похоронена в северо-западном зале. Это её ты ищешь?»~
@4944  = ~«Да… можешь мне сказать, что с ней случилось?»~
@4945  = ~«Да. Пойду отдам ей дань уважения».~
@4946  = ~«Я не знаю, но она здесь находится уже некоторое время. Её отец наверняка должен знать, что с ней приключилось… он часто приходит сюда из Верхнего района. Именно по его настоянию её поместили в мемориальном зале».~
@4947  = ~«Спасибо за информацию. Пойду отдам ей дань уважения».~
@4948  = ~«Адан… — глаза Соэго сужаются, а красный отблеск в них становится ярче. — Никто с таким именем не обитает в залах Мортуария — ни живой, ни мёртвый». Его рот дёргается, и, к твоему удивлению, он принюхивается.~
@4949  = ~«Э-э… тогда я, должно быть, оговорился».~
@4950  = ~Уголки губ Соэго снова дёргаются, а глаза вспыхивают: «Тогда что ты тут делаешь?»~
@4951  = ~«Я был здесь на похоронах, отдавал дань уважения. Уже готов был уйти… но что-то заплутал здесь. Не поможешь мне найти выход?»~
@4952  = ~«Не твоё дело».~
@4953  = ~«Я очнулся на одной из плит в вашей препарационной».~
@4954  = ~«Я здесь, чтобы кое с кем увидеться».~
@4955  = ~«Я был здесь на похоронах, но кажется, произошла ошибка».~
@4956  = ~Нагнуться к нему, будто собираешься что-то прошептать, а когда он наклонится в ответ, сломать ему шею.~
@4957  = ~Соэго хмурится, когда ты наклоняешься, заметно, что он принюхивается, как будто проверяя воздух. Внезапно его глаза сужаются. Похоже, он собирается позвать стражу.~
@4958  = ~Сломать ему шею, прежде чем он закричит.~
@4959  = ~Сломать ему шею, прежде чем он закричит.~
@4960  = ~Когда ты кидаешься на него, Соэго отскакивает, в его глазах вспыхивает красный огонёк, а зубы обнажаются в оскале. Шипя, он трижды звонко хлопает в ладоши. В ответ в Мортуарии начинает звонить большой железный колокол.~
@4961  = ~«Ну и ладно…»~
@4962  = ~«Кого хоронят? Возможно, служба идёт где-то в другом зале Мортуария».~
@4963  = ~«Ты не понял… ошибка в том, что похоронить собирались МЕНЯ».~
@4964  = ~«Прости… я оговорился. Я не знаю имя покойного».~
@4965  = ~«Её звали Дейонарра».~
@4966  = ~«Ну…» — Соэго щурится. Кажется, он в замешательстве. «Очевидно, была допущена ошибка. Либо тебя принесли родственники, либо другие Пыльные, либо… — внезапно Соэго шипит, как будто ему в голову пришла неприятная мысль. — Либо один из *Сборщиков*».~
@4967  = ~Ложь: «Его звали… э-э, Адан».~
@4968  = ~Ложь: «Его звали… э-э, Адан».~
@4969  = ~Наклониться вперёд, будто ты хочешь что-то прошептать, и свернуть ему шею.~
@4970  = ~Убежать.~
@4971  = ~«Сборщиков?»~
@4972  = ~«Да, Сборщики… банды падальщиков, которые приносят нам тела. Они могли принять тебя за мёртвого… — Соэго шипит, а его глаза сверкают, — …и они настолько жадные до денег, что даже не удосужились проверить тебя, прежде чем принести сюда». Соэго изучает тебя: «Хорошо, что ты очнулся… иначе мог бы достигнуть Истинной Смерти до положенного срока».~
@4973  = ~«Значит, то была ошибка… тогда я пошёл. Прямо сейчас».~
@4974  = ~Соэго кивает, а уголок его губ дёргается: «Ну… конечно, конечно. Позволь я открою для тебя главные ворота».~
@4975  = ~«Хорошо».~
@4976  = ~«Хорошо».~
@4977  = ~«Тебя?»~
@4978  = ~«Да, *меня*. Я очнулся на одной из плит наверху».~
@4979  = ~«Прошу прощения… Я оговорился».~
@4980  = ~При твоём приближении Соэго принюхивается и поднимает голову. Заметив тебя, он хмурится: «Я открыл для тебя ворота. Почему ты всё ещё здесь?»~
@4981  = ~«Я бы хотел задать пару вопросов, прежде чем уйти».~
@4982  = ~«Уже направляюсь к выходу. Прощай».~
@4983  = ~При твоём приближении Соэго принюхивается и поднимает голову. Увидев тебя, он слегка кивает: «Ты нашёл то, что искал?»~
@4984  = ~«Да, спасибо. Прости, я совсем здесь заплутал… не поможешь мне найти выход?»~
@4985  = ~«Да. Я хочу уйти. Можешь отвести меня к выходу?»~
@4986  = ~«Да, я уже ухожу. Прощай».~
@4987  = ~Соэго кивает, а уголки его губ подёргиваются: «Ну… да, конечно. Эти залы *могут* сбить посетителей с толку. Позволь я открою парадный вход».~
@4988  = ~«Спасибо».~
@4989  = ~«Спасибо».~
@4990  = ~«Вот это самое странное», — глаза Соэго вспыхивают красными огоньками, а уголки губ слегка подёргиваются, как будто от неприязни. «Может… — он усмехается, демонстрируя ряд грязных острых зубов. — Может, мне позвать стражу? Да… думаю, именно это я и сделаю».~
@4991  = ~«Подожди минутку! Я потерялся… просто заплутал в этих залах и, похоже, не могу найти выход. Ты мне не поможешь?»~
@4992  = ~«Стой! Не зови стражу! Я просто хочу отсюда выбраться… не поможешь мне?»~
@4993  = ~Сломать ему шею, прежде чем он закричит.~
@4994  = ~Сломать ему шею, прежде чем он закричит.~
@4995  = ~«Что ж, зови свою стражу. С нетерпением жду встречи».~
@4996  = ~Соэго кивает… а его рот снова дёргается. Кажется, он даже не замечает этого: «Возвращайся, когда отдашь дань уважения, и я открою для тебя ворота. Уже давно пробило девять, так что тебе следует поторопиться со своими делами».~
@4997  = ~«Знаешь, пожалуй, я сделаю это в другой раз. Можешь меня выпустить?»~
@4998  = ~«Спасибо. Я вернусь».~
@4999  = ~«У меня действительно нет на это времени. Прощай».~
@5000  = ~У этого огромного топора двойное лезвие, увенчанное клином. Оружие требует двух рук, но длинная рукоятка позволяет вкладывать в удар приличную силу. Выглядит как кусок железа с острыми краями, и баланс не очень хорош. Это оружие последней надежды, если ничего другого нет.~
@5001  = ~Этот молот представляет собой немногим больше, чем тяжёлый кусок металла на конце прочной палки. Он мощен, да, но баланс очень плох и оружие совсем неприглядно на вид. Молот двуручный.~
@5002  = ~Этот превосходно выполненный молот хорошо сбалансирован и приятен для глаз. Но не засматривайся на внешний вид — это оружие опасно. Необходимы две руки и желание нанести дробящие повреждения твоим врагам.~
@5003  = ~ВЫСОКОКАЧЕСТВЕННЫЙ СТИЛЕТ
Урон: 1-4 колющий
Фактор скорости: 1
Вес: 1
Навык: клинок
Недоступно: священникам

Этот тонкий кинжал — образец красоты среди себе подобных. Это одноручное колющее оружие.~
@5004  = ~Этот короткий кинжал, в идеале он был бы колющим оружием, выглядит так, что лучше всего его использовать как пресс-папье. Он не острый и не сбалансированный, и может только мешать в бою.~
@5005  = ~Это пригоршня живых зубов Ингресс. Очевидно, они не захотели отправиться с ней через портал на домашний план. Зубы постукивают друг о друга и напоминают тебе кучу жутких скачущих жучков цвета слоновой кости.~
@5006  = ~БУЛЫЖНИК
Вес: 3

Это отполированный булыжник, который находился в черепе зомби. С него по-прежнему капают остатки мозгового вещества.~
@5007  = ~СЕРДЦЕ ХАКАРИИ
Вес: 10
Доступно: воинам

Этот чёрный предмет размером с кулак больше похож на кусок пережжённого угля, чем на сердце Хакарии. Он невероятно тяжёл для своих размеров, и вся его поверхность покрыта трещинами… как будто он может в любой момент разломиться пополам. Предмет оставляет на руках странные ржавые полосы, которые не стираются.~
@5008  = ~СЕРЕБРЯНАЯ СЕРЬГА
Вес: 0

Эту маленькую серебряную серёжку ты забрал у пьяной шлюхи недалеко от бара «Горящий труп».~
@5009  = ~ОБТОЧЕННАЯ МЕДНАЯ МОНЕТА
Вес: 0

Эта медная монета была «обточена»… большая часть меди состругана, но сделавший это несомненно постарался, чтобы она всё ещё выглядела как обычная монета. А из стружки, по-видимому, хотели сделать другую монету. Она ничего не стоит.~
@5010  = ~ИСХОД ДУШИ
Вес: 1~
@5011  = ~ПЕЧЕНЬ ХАКАРИИ
Вес: 3

Печень Хакарии выглядит как огромный, мёртвый слизень, а по текстуре напоминает винный бурдюк, несколько лет пролежавший в грязной луже. Чтобы орган сохранился, в него было закачано достаточное количество жидкости для бальзамирования, но запахи гниения и формальдегида, кажется, борются друг с другом за преобладание.~
@5012  = ~ПОСМЕРТНЫЙ ДОГОВОР АНГИЯРА
Вес: 0

От этого потрескавшегося куска пергамента пахнет плесенью, как будто его слишком долго держали на чердаке. Документ написан сжатым, миниатюрным почерком, из того, что получается разобрать: это договор между двумя сторонами, фракцией Пыльных и человеком по имени «Ангияр». В обмен на тридцать медных монет Ангияр передаёт права на пользование своим трупом Пыльным, предполагается, что те будут использовать его как разнорабочего в Мортуарии.~
@5013  = ~ГРАФИН
Вес: 2

Это обычный закрытый сосуд. В нём есть немного воды.~
@5014  = ~КОЛЬЦО АДАНА
Вес: 0

Этот подарок ты получил от Адана, когда расстался с ним баре «Горящий труп». Это простое металлическое кольцо выглядит очень толстым и тяжёлым, но на деле оно почти ничего не весит. Когда ты смотришь на него, оно как будто меняется: из серебра в бронзу, из бронзы в золото.~
@5015  = ~КИНЖАЛ АДАНА
Урон: 2-5 колющий
THAC0: +1
Фактор скорости: 1
Вес: 0
Навык: клинок
Недоступно: священникам

Этот подарок ты получил от Адана, когда расстался с ним баре «Горящий труп». Это простой металлический кинжал с серебряной рукояткой. Очень трудно почувствовать его баланс, потому что он почти ничего не весит. Само лезвие сделано из какого-то странного металла, который изменяется при рассмотрении — становится то серебряным, то бронзовым, то золотым.~
@5016  = ~Отгонять нежить~
@5017  = ~ПОДДЕЛЬНЫЙ ПОСМЕРТНЫЙ ДОГОВОР
Вес: 0

Этот фальшивый «Посмертный Договор» такой же, как и обыкновенный, но мелкий неразборчивый почерк скрывает факт, что подписавший его в действительности не отдавал свой труп в пользование Пыльным… по сути, любой Пыльный, который подписал договор, просто платит подписавшему определённую сумму за подпись.~
@5018  = ~ПОСМЕРТНЫЙ ДОГОВОР МЕДНОГЛАЗОГО
Вес: 0

Этот бланк договора ты получил у Медноглазого, он имеет слабый металлический запах. Мелкий, неразборчивый почерк документа позволяет разобрать, что это, похоже, договор между двумя сторонами: Пыльными и пока ещё неназванным подписавшим. За тридцать медных монет подписавший отдаёт Пыльным права на пользование своим трупом. Под этим подразумевается, что труп подписавшего будут использовать в Мортуарии в качестве разнорабочего.~
@5019  = ~БУЛАВА С ШИПАМИ
Урон: 1-6 дробящий
Урон: 1-6 колющий
Фактор скорости: 7
Вес: 12
Навык: булава
Недоступно: магам

Это тяжёлая железная булава с острыми шипами.~
@5020  = ~ИНТ~
@5021  = ~МУД~
@5022  = ~ЛОВ~
@5023  = ~ТЕЛ~
@5024  = ~ХАР~
@5025  = ~КЛАСС ЗАЩИТЫ~
@5026  = ~ЗДОРОВЬЕ~
@5027  = ~ПУНКТЫ ХАРАКТЕРИСТИК~
@5028  = ~Убежать.~
@5029  = ~«Эй! Эй! Что ты делаешь?»~
@5030  = ~«Я *собирался* поговорить с этим парнем. Какие-то проблемы?»~
@5031  = ~«Ничего, пошли».~
@5032  = ~«Если собираешься чесать языком с Пыльными, избавь меня от этого. Я и они — не лучшие приятели… и тебе не стоит якшаться с ними. Они скорее спалят тебя или похоронят, чем будут слушать. Не будь идиотом; давай валить отсюда».~
@5033  = ~«Спасибо за совет, но я *всё же* собираюсь поговорить с этим парнем».~
@5034  = ~«Договорились, пошли».~
@5035  = ~«Эй! Ты что, оглох? Что ты делаешь?»~
@5036  = ~«Слушай, я собираюсь поговорить с этим парнем. Есть проблемы?»~
@5037  = ~«Ничего, пошли».~
@5038  = ~«Тогда *не* слушай меня — это твои похороны».~
@5039  = ~«Ага, можешь заказывать панихиду. А сейчас помолчи».~
@5040  = ~«Ты прав. Забудь. Пошли».~
@5041  = ~«Что ты *делаешь*?! Если хочешь убить его — так сделай это!»~
@5042  = ~«Я и *сделал*! Я сломал ему шею! Он не должен даже шевелиться!»~
@5043  = ~«Во всяком случае, он *может* ходить, — фыркает Морте. — Летать становится не так прикольно, как только возникает желание кому-нибудь напинать».~
@5044  = ~(Авто-линк.)~
@5045  = ~Похоже, кто-то только что занимался вскрытием этого тела.~
@5046  = ~Бочки с тёмной жидкостью. По запаху — нечто среднее между уксусом и формальдегидом.~
@5047  = ~Test Drink for Tavern Test 1~
@5048  = ~На этом столе разбросаны катушки ниток, обрывки ткани, ржавые инструменты, покрытые пятнами пузырьки и окровавленные листы бумаги.~
@5049  = ~«Эй, шеф! Ты что делаешь?!»~
@5050  = ~«Я хотел поговорить с этим писарем. Может, он знает что-нибудь о том, как я сюда попал».~
@5051  = ~Это тело выглядит так, будто его вывернули наизнанку. Машина на краю стола содрала кожу со лба, чтобы можно было беспрепятственно работать с черепом.~
@5052  = ~«Слушай, греметь шкатулкой с Пыльными — вообще ПОСЛЕДНЕЕ дело…»~
@5053  = ~«И мы *в особенности* не станем трепаться с этими мерзопакостными Пыльниками. Давай же, пошли. Чем быстрее мы помашем этому месту ручкой, тем лу…»~
@5054  = ~Как и другие трупы в комнате, это тело залито кровью и полностью выпотрошено.~
@5055  = ~Это похоже на гигантскую дробилку. Из-под неё сочится свежая кровь.~
@5056  = ~Это тело целиком покрыто грубой тёмной тканью.~
@5057  = ~Это тело целиком замотано бинтами, как мумия.~
@5058  = ~«Приветствую».~
@5059  = ~Плита покрыта засохшей кровью и прочими останками.~
@5060  = ~Оставить старого писаря в покое.~
@5061  = ~Это устройство похоже на швейную машинку… рычаги с крючками, трубки, вниз свисает металлическая нить.~
@5062  = ~«Ты меня знаешь?»~
@5063  = ~«Прощай».~
@5064  = ~Через всю комнату протянулась система рельсов. Похоже, плиты в комнате можно передвигать по этим направляющим.~
@5065  = ~Это разлагающееся тело опутано трубками, по которым циркулирует жёлтая жидкость. Они подключены к странной машине, которая издаёт щёлкающие звуки, подобно насекомому.~
@5066  = ~В ногу этого тела вставлена трубка, подключенная к странной щёлкающей машине рядом с плитой.~
@5067  = ~Поверхность этой металлической плиты покрыта пятнами крови, ржавчиной и всяким мусором. Сама плита намного крупнее большинства остальных и расположена на поворотной платформе.~
@5068  = ~На этом выпотрошенном теле кто-то словно бы проверял, насколько сильно можно растянуть плоть, не порвав её.~
@5069  = ~«Ты знаешь, кто я?»~
@5070  = ~«Где её тело?»~
@5071  = ~«Я о ней ничего не знаю».~
@5072  = ~«Она утверждает, что знает меня. Но я её не помню».~
@5073  = ~«Ты сказал, что были и другие. Здесь есть кто-то ещё?»~
@5074  = ~«Ты сказал, что были и другие. Здесь есть кто-то ещё?»~
@5075  = ~«Северный мемориальный зал этажом ниже. Проверь надгробия в этом зале… её имя должно быть на одной из мемориальных табличек. Быть может, там память вернётся к тебе».~
@5076  = ~«Не знаю. Не припомню, чтобы я когда-либо путешествовал с женщиной».~
@5077  = ~«Ну, она утверждает, что знает меня. Но я её не помню».~
@5078  = ~«Ты сказал, что были и другие. Здесь есть кто-то ещё?»~
@5079  = ~«Ты сказал, что были и другие. Здесь есть кто-то ещё?»~
@5080  = ~Дхалл не отвечает. Смотрит на тебя и молчит.~
@5081  = ~«Где я могу её найти?»~
@5082  = ~«Ты говорил, что здесь похоронены и другие из тех, кто странствовал со мной. Где они?»~
@5083  = ~«Ты говорил, что здесь похоронены и другие из тех, кто странствовал со мной. Где они?»~
@5084  = ~Ещё одно тело на каменной плите… ничто не указывает на причину смерти.~
@5085  = ~Кровь на этой плите ещё свежая.~
@5086  = ~Ты готовишься снова поднять молот…~
@5087  = ~«…что ещё?»~
@5088  = ~Ты подходишь к горну. Около него нестерпимо жарко. Твой выбор?~
@5089  = ~Работать с горном.~
@5090  = ~Работать с горном.~
@5091  = ~Работать с горном.~
@5092  = ~Отступить назад.~
@5093  = ~Пламя нестерпимо горячее, даже для твоей огнеупорной кожи. Огонь причиняет тебе вред.~
@5094  = ~Работать с горном.~
@5095  = ~Отступить назад.~
@5096  = ~Пламя источает нестерпимый жар, но благодаря защите ты можешь выдержать его без вреда для себя. Ты будешь работать с горном?~
@5097  = ~Да.~
@5098  = ~Нет.~
@5099  = ~Пламя снова обжигает кожу. Что ты хочешь сделать сначала?~
@5100  = ~Приготовить клещи.~
@5101  = ~Бить молотом по наковальне.~
@5102  = ~Взять руду.~
@5103  = ~Взять клещами руду и положить её в пламя горна.~
@5104  = ~Положить руду на наковальню и ударить по ней молотом.~
@5105  = ~Выйти из кузницы.~
@5106  = ~Ты умер. Слишком горячо.~
@5107  = ~Ты крепко держишь клещи, а пламя горна оставляет ожоги на коже. Что ты будешь делать дальше?~
@5108  = ~Бить молотом по наковальне.~
@5109  = ~Взять руду клещами и держать её в огне.~
@5110  = ~Положить руду на наковальню и ударить по ней молотом.~
@5111  = ~Выйти из кузницы.~
@5112  = ~Ты умер. Слишком горячо.~
@5113  = ~Несколько секунд ты колотишь по пустой наковальне, и звон металла о металл возносится к предавшим тебя небесам, а пламя горна продолжает палить тебя. Что дальше?~
@5114  = ~Приготовить клещи.~
@5115  = ~Бить молотом по наковальне.~
@5116  = ~Взять руду.~
@5117  = ~Взять клещами руду и положить её в пламя горна.~
@5118  = ~Положить руду на наковальню и ударить по ней молотом.~
@5119  = ~Выйти из кузницы.~
@5120  = ~Ты умер. Слишком горячо.~
@5121  = ~Ты держишь кусок руды руками. Там, где ты стоишь, пламя горна почти способно плавить железо — коже определённо не поздоровится. Что дальше?~
@5122  = ~Бить молотом по наковальне.~
@5123  = ~Держать руду в пламени горна клещами.~
@5124  = ~Положить руду на наковальню и ударить по ней молотом.~
@5125  = ~Держать руду в пламени горна голыми руками.~
@5126  = ~Выйти из кузницы.~
@5127  = ~Амулет обточенной монеты~
@5128  = ~Серебряная серьга~
@5129  = ~Булыжник~
@5130  = ~Зубы Ингресс~
@5131  = ~Некачественная кувалда~
@5132  = ~«Тест таверны»~
@5133  = ~«Ом-м-м-м».~
@5134  = ~«Давно тебя жду, здоровяк».~
@5135  = ~«Ищешь компанию, здоровяк?»~
@5136  = ~«Поговори со мной, красавчик».~
@5137  = ~«Порталы! Везде порталы!..»~
@5138  = ~*Кхе*~
@5139  = ~*Кхе*… *кхе*~
@5140  = ~Ещё одна ржавая плита, залитая кровью.~
@5141  = ~Эти голубые шпалеры сделаны из тонких металлических цепочек.~
@5142  = ~Большой выбор ножей, топоров и молотов. Хотя и выглядят эффектно, но уж больно непрочные, чтобы можно было использовать в качестве оружия.~
@5143  = ~Некоторые чашки наполнены сухим веществом, похожим на извёстку. В других непонятная маслянистая жидкость.~
@5144  = ~На этой полке лишь несколько кусков грубой ткани.~
@5145  = ~Этот мумифицированный труп выглядит подготовленным к кремации.~
@5146  = ~Ты умер. Слишком горячо.~
@5147  = ~Руда быстро размягчается, и вот уже с ней можно работать. Твоя кожа сплошь покрыта ожогами.~
@5148  = ~Положить мягкую руду в горн и придать ей форму.~
@5149  = ~Мой молот! Я забыл взять молот! Пойду отсюда!~
@5150  = ~Отойти от горна.~
@5151  = ~Ты умер. Слишком горячо.~
@5152  = ~Ты кладёшь холодную руду на наковальню и бьёшь по ней молотом. Руда превращается в бесполезную крошку. Пламя близкого горна исполняет на твоей коже симфонию боли.~
@5153  = ~Выйти из кузницы.~
@5154  = ~Ты умер. Слишком горячо.~
@5155  = ~Пламя причиняет неописуемую боль. Руда в твоих руках стала мягкой, как глина, воздух наполнен запахом горелого мяса. Железо плавится в твоей руке, ты теряешь сознание от боли.~
@5156  = ~Готово.~
@5157  = ~Что ты хочешь выковать?~
@5158  = ~Что-нибудь маленькое и смертоносное: стилет!~
@5159  = ~Двуручный молот.~
@5160  = ~Боевой топор.~
@5161  = ~~
@5162  = ~Ничего. Слишком горячо.~
@5163  = ~Стилет… быстрое и простое оружие, так что ты очень скоро выйдешь из этого огненного ада. Тебе действительно нужен стилет?~
@5164  = ~Да.~
@5165  = ~Да.~
@5166  = ~Да.~
@5167  = ~Нет. Лучше я выкую что-нибудь другое.~
@5168  = ~Нет. Я ничего не буду сейчас ковать.~
@5169  = ~Молот — простая работа, ты пробудешь в кузнице недолго. Тебе действительно нужен молот?~
@5170  = ~Да.~
@5171  = ~Да.~
@5172  = ~Да.~
@5173  = ~Нет. Лучше я выкую что-нибудь другое.~
@5174  = ~Нет. Я ничего не буду сейчас ковать.~
@5175  = ~Топор долго ковать — и всё это время пламя будет пожирать твою плоть. Ты уверен?~
@5176  = ~Да.~
@5177  = ~Да.~
@5178  = ~Да.~
@5179  = ~Нет. Лучше я выкую что-нибудь другое.~
@5180  = ~Нет. Я ничего не буду сейчас ковать.~
@5181  = ~На этой плите изображён странный символ: кричащий череп с торчащими из него острыми клинками.~
@5182  = ~Эти ржавые стальные ворота надёжно заперты. Непохоже, чтобы их можно было открыть.~
@5183  = ~Толстые металлические трубы выходят из пола и уходят в стену.~
@5184  = ~Эти тяжёлые шпалеры сделаны из какой-то блестящей материи. На них выткан кричащий череп с торчащими из него острыми клинками.~
@5185  = ~Табличка на этой гробнице гласит: «Здесь покоится Дейонарра».~
@5186  = ~Похоже на большую гробницу. Мраморная отделка придаёт ей довольно изысканный вид.~
@5187  = ~Табличка на этом катафалке пуста.~
@5188  = ~ТОЧКА ОТСЧЁТА~
@5189  = ~Ты критически рассматриваешь своё изделие — ну, конечно, не шедевр, но хоть что-то ты сделал.~
@5190  = ~~
@5191  = ~~
@5192  = ~~
@5193  = ~~
@5194  = ~Сойдёт для моего испытания.~
@5195  = ~Полагаю, драться им можно…~
@5196  = ~Приятного мало. Жар нестерпимый. Но хоть это задание для Боготов выполнено.~
@5197  = ~Приятного мало. Жар нестерпимый.~
@5198  = ~Стилет готов. Ты отходишь от огня, чтобы полюбоваться плодами своих трудов.~
@5199  = ~Стилет. Для испытания сойдёт.~
@5200  = ~Стилет. Какой красивый… похоже, и в деле будет хорош.~
@5201  = ~Жар нестерпимый. Задание выполнено, но дорогой ценой.~
@5202  = ~Жар нестерпимый. Цена оказалась очень высока.~
@5203  = ~Чудесная вещица! Твой стилет не просто хорош — он отлично сбалансирован и выглядит устрашающе. Прекрасная работа.~
@5204  = ~Эта вещица сослужит мне хорошую службу. Келдор будет просто поражён! Пора уходить из кузницы.~
@5205  = ~Эта штука хорошо послужит мне в будущих испытаниях. Пойду отсюда.~
@5206  = ~Жар нестерпимый.~
@5207  = ~Жар неописуемый. Не двинуться… не вздохнуть…~
@5208  = ~Этот, с позволения сказать, молот выглядит так, будто ты нашёл кусок железа на большой дороге. Но приложить им можно.~
@5209  = ~Для меня сойдёт. Пойду покажу Келдору.~
@5210  = ~Столько трудов ради куска металла? Силы небесные! Пойду-ка я отсюда.~
@5211  = ~Жар нестерпимый. Но хоть задание выполнено.~
@5212  = ~Жар нестерпимый.~
@5213  = ~Смотри! Кувалда… в точности как и любая другая кувалда.~
@5214  = ~Здорово. Для Келдора сойдёт. Больше никаких дел в кузнице.~
@5215  = ~Для меня сойдёт. Настало время расколоть пару черепушек. Больше никаких дел в кузнице.~
@5216  = ~В кузнице нестерпимо жарко. Но задание выполнено.~
@5217  = ~В кузнице нестерпимо жарко.~
@5218  = ~Прекрасный молот… изящен, хорошо сбалансирован и прекрасно лежит в твоей руке.~
@5219  = ~Хорошо. Пойду покажу его Келдору… и, может быть, потом расколю этой штукой парочку голов.~
@5220  = ~Хорошо. Пригодится.~
@5221  = ~В кузнице нестерпимо жарко. Но задание для Боготов выполнено, и выполнено с блеском.~
@5222  = ~В кузнице нестерпимо жарко.~
@5223  = ~Я вроде бы хотел сделать топор? Больше похоже на кувалду, но с острыми краями, так что назовём это произведение топором и успокоимся.~
@5224  = ~Хм. Ну, надеюсь, Келдора это устроит.~
@5225  = ~Хм. Отдать, что ли, на металлолом…~
@5226  = ~Жар в этой адской кузнице действительно неописуемый. Но задание выполнено.~
@5227  = ~Жар в этой адской кузнице действительно неописуемый.~
@5228  = ~Получилось неплохо. Наград на выставке не соберёт, но убить им можно.~
@5229  = ~Весьма и весьма. Келдор им просто залюбуется, я уверен.~
@5230  = ~Компетенция — это замечательно. Она до сих пор сочится через порванную кожу и разбитые кости.~
@5231  = ~Чёрный дым и удушающий жар кузницы больше нельзя выдержать. Но задание выполнено.~
@5232  = ~Чёрный дым и удушающий жар кузницы больше нельзя выдержать.~
@5233  = ~Ещё чуть-чуть подправить, и этот топор подойдёт самому взыскательному воину. Просто хорош.~
@5234  = ~Ай да я! Всегда подозревал, что я гений. Пойду покажу Келдору… и, может, оставлю себе.~
@5235  = ~У нас с этим топором впереди долгая и счастливая жизнь. Я в него просто влюбился.~
@5236  = ~Замечательная работа. К сожалению, жар в кузнице такой невыносимый, что находиться тут больше нельзя.~
@5237  = ~К сожалению, жар в кузнице такой невыносимый, что находиться тут больше нельзя.~
@5238  = ~Что ты хочешь сделать сначала?~
@5239  = ~Приготовить клещи.~
@5240  = ~Бить молотом по наковальне.~
@5241  = ~Взять руду.~
@5242  = ~Взять клещами руду и положить её в пламя горна.~
@5243  = ~Положить руду на наковальню и ударить по ней молотом.~
@5244  = ~Выйти из кузницы.~
@5245  = ~В шкафу бутылки, бинты и рваные тряпки.~
@5246  = ~На этом сундуке разбросаны пузырьки, бутылки и прочий хлам.~
@5247  = ~На этом столе аккуратно разложены старые пергаменты и бинты.~
@5248  = ~На этой полке стоят глиняные кувшины и другая посуда, лежат обрывки пергамента и куски ткани.~
@5249  = ~Ты крепко держишь клещи, пот льёт с тебя ручьями. Что ты будешь делать теперь?~
@5250  = ~Бить молотом по наковальне.~
@5251  = ~Взять руду клещами и держать её в огне.~
@5252  = ~Положить руду на наковальню и ударить по ней молотом.~
@5253  = ~Выйти из кузницы.~
@5254  = ~Ты несколько секунд колотишь по пустой наковальне, и звон металла о металл возносится к предавшим тебя небесам. Жарко, работа тяжёлая — пот льёт в три ручья. Что дальше?~
@5255  = ~Приготовить клещи.~
@5256  = ~Бить молотом по наковальне.~
@5257  = ~Взять руду.~
@5258  = ~Взять клещами руду и положить её в пламя горна.~
@5259  = ~Положить руду на наковальню и ударить по ней молотом.~
@5260  = ~Выйти из кузницы.~
@5261  = ~Ты держишь кусок руды руками. Там, где ты стоишь, пламя горна почти способно плавить железо… Хорошо, что ты защищён от огня. Что дальше?~
@5262  = ~Бить молотом по наковальне.~
@5263  = ~Держать руду в пламени горна клещами.~
@5264  = ~Положить руду на наковальню и ударить по ней молотом.~
@5265  = ~Держать руду в пламени горна голыми руками.~
@5266  = ~Держать руду в пламени горна голыми руками.~
@5267  = ~Выйти из кузницы.~
@5268  = ~Руда быстро размягчается, и вот уже с ней можно работать. Твои руки мокрые от пота.~
@5269  = ~Положить мягкую руду в горн и придать ей форму.~
@5270  = ~Мой молот! Я забыл взять молот! Пойду отсюда!~
@5271  = ~Отойти от горна.~
@5272  = ~Ты кладёшь холодную руду на наковальню и бьёшь по ней молотом. Руда превращается в бесполезную крошку. Пламя в горне бушует, вздымая к небесам запах горелого металла.~
@5273  = ~Выйти из кузницы.~
@5274  = ~Пламя причиняет неописуемую боль. Руда в твоих руках стала мягкой, как глина, воздух наполнен запахом горелого мяса. Железо плавится в твоей руке, ты теряешь сознание от боли.~
@5275  = ~Что ты хочешь выковать?~
@5276  = ~Выйти.~
@5277  = ~Что-нибудь маленькое и смертоносное: стилет!~
@5278  = ~Двуручный молот.~
@5279  = ~Боевой топор.~
@5280  = ~~
@5281  = ~Стилет… простое оружие и куётся быстро — ты очень скоро выйдешь из этого огненного ада. Тебе действительно нужен стилет?~
@5282  = ~Да.~
@5283  = ~Да.~
@5284  = ~Да.~
@5285  = ~Нет. Лучше я выкую что-нибудь другое.~
@5286  = ~Нет. Я ничего не буду сейчас ковать.~
@5287  = ~Молот — простая работа, ты пробудешь в этой потогонке недолго. Тебе действительно нужен молот?~
@5288  = ~Да.~
@5289  = ~Да.~
@5290  = ~Да.~
@5291  = ~Нет. Лучше я выкую что-нибудь другое.~
@5292  = ~Нет. Я ничего не буду сейчас ковать.~
@5293  = ~Топор долго ковать — выдержать столько времени здесь будет трудно, но по крайней мере ты не обгоришь до смерти. Тебе действительно нужен топор?~
@5294  = ~Да.~
@5295  = ~Да.~
@5296  = ~Да.~
@5297  = ~Нет. Лучше я выкую что-нибудь другое.~
@5298  = ~Нет. Я ничего не буду сейчас ковать.~
@5299  = ~~
@5300  = ~~
@5301  = ~~
@5302  = ~Ты критически рассматриваешь своё изделие — ну, конечно, не шедевр, но хоть что-то ты сделал.~
@5303  = ~Сойдёт для моего испытания.~
@5304  = ~Полагаю, драться им можно…~
@5305  = ~Стилет готов. Ты отходишь от огня, чтобы полюбоваться плодами своих трудов.~
@5306  = ~Стилет. Для испытания сойдёт.~
@5307  = ~Стилет. Какой красивый… похоже, и в деле будет хорош.~
@5308  = ~Чудесная вещица! Твой стилет не просто хорош — он отлично сбалансирован и выглядит устрашающе. Прекрасная работа.~
@5309  = ~Эта вещица сослужит мне хорошую службу. Келдор будет просто поражён! Пора уходить из кузницы.~
@5310  = ~Эта штука хорошо послужит мне в будущих испытаниях. Пойду отсюда.~
@5311  = ~Этот, с позволения сказать, молот выглядит так, будто ты нашёл кусок железа на большой дороге. Но приложить им можно.~
@5312  = ~Столько трудов ради куска металла? Силы небесные! Пойду-ка я отсюда.~
@5313  = ~Для меня сойдёт. Пойду покажу Келдору.~
@5314  = ~Смотри! Кувалда… в точности как и любая другая кувалда.~
@5315  = ~Здорово. Для Келдора сойдёт. Больше никаких дел в кузнице.~
@5316  = ~Для меня сойдёт. Настало время расколоть пару черепушек. Больше никаких дел в кузнице.~
@5317  = ~Прекрасный молот… изящен, хорошо сбалансирован и прекрасно лежит в твоей руке.~
@5318  = ~Хорошо. Пойду покажу его Келдору… и, может быть, потом расколю этой штукой парочку голов.~
@5319  = ~Хорошо. Пригодится.~
@5320  = ~Я вроде бы хотел сделать топор? Больше похоже на кувалду, но с острыми краями, так что назовём это произведение топором и успокоимся.~
@5321  = ~Хм. Ну, надеюсь, Келдора это устроит.~
@5322  = ~Хм. Отдать, что ли, на металлолом…~
@5323  = ~Получилось неплохо. Наград на выставке не соберёт, но убить им можно.~
@5324  = ~Весьма и весьма. Келдор им просто залюбуется, я уверен.~
@5325  = ~Компетенция — это замечательно. Она до сих пор сочится через порванную кожу и разбитые кости.~
@5326  = ~Ещё чуть-чуть подправить, и этот топор подойдёт самому взыскательному воину. Просто хорош.~
@5327  = ~Ай да я! Всегда подозревал, что я гений. Пойду покажу Келдору… и, может, оставлю себе.~
@5328  = ~У нас с этим топором впереди долгая и счастливая жизнь. Я в него просто влюбился.~
@5329  = ~Благодаря устойчивости к огню ты додержал руду в огне до тех пор, пока она не расплавилась и не потекла. Другие кузнецы в благоговейном страхе смотрят, как расправленный металл протекает у тебя между пальцами. К сожалению, руды больше нет.~
@5330  = ~Уйти.~
@5331  = ~Ты подходишь к горну. Около него нестерпимо жарко. Твой выбор?~
@5332  = ~Работать с горном.~
@5333  = ~Работать с горном.~
@5334  = ~Работать с горном.~
@5335  = ~Отступить назад.~
@5336  = ~«Стража! Стража! Задержите этого человека! ХВАТАЙ ЕГО!»~
@5337  = ~Уйти.~
@5338  = ~«Исчезни, пень. Возвращайся как-нибудь в другой раз — может, мы и поговорим».~
@5339  = ~«Я только хотел спросить…»~
@5340  = ~«Я… сказала… ИСЧЕЗНИ. Вернёшься, когда выпадет случай получше подумать о следующих действиях».~
@5341  = ~Уйти.~
@5342  = ~Она саркастически улыбается: «Спасибо тебе огромное за то, что согласился починить наши машины. Твоя забота о благополучии Кузницы обнадёживает и поднимает настроение. Пень». Плюнув тебе под ноги, она отворачивается.~
@5343  = ~Напасть на неё.~
@5344  = ~«Я хотел задать тебе пару вопросов».~
@5345  = ~Уйти.~
@5346  = ~«О чём? Давай телись, сволочь… Для таких, как ты, у меня мало терпения, да и работы полно — между прочим, из-за тебя».~
@5347  = ~«Я передумал. Я помогу тебе починить механизмы».~
@5348  = ~«Напомни, где находится стол заказов?»~
@5349  = ~«Как я могу вступить в ваши ряды?»~
@5350  = ~«Могу я чем-то это возместить?»~
@5351  = ~«Забудь. Я ухожу».~
@5352  = ~«Ах, так когда тебе самому что-то понадобилось, ты тут же согласился помочь? Может быть, все твои испытания проверяют уровень эгоизма, пень, но это не значит, что результаты мне нравятся. А мне они не нравятся. И ты не нравишься. Мы уже нашли другого, чтобы их починить. Так что обломись», — она поворачивается и уходит.~
@5353  = ~Уйти.~
@5354  = ~«Спроси кого-нибудь другого, пень, или сам разберись», — она поворачивается и уходит.~
@5355  = ~Уйти.~
@5356  = ~Она на секунду задумывается, как будто взвешивая, что лучше: послать тебя подальше или завербовать нового сторонника. Наконец она неохотно произносит: «Иди через дверь в самой правой стене Кузницы — окажешься в зале собраний. Найди там Келдора из Дуриана. Он может тебе помочь».~
@5357  = ~«Спасибо. У меня ещё вопрос».~
@5358  = ~Уйти.~
@5359  = ~«Можешь ли ты чем-то возместить? Ха! Пожалуй, ничем, сволочь. Проваливай в лабиринт», — она поворачивается и уходит.~
@5360  = ~Уйти.~
@5361  = ~«Здравствуй, посетитель. Чем я могу тебе помочь? Пожалуйста, будь краток… у нас ещё куча дел».~
@5362  = ~«Я хочу получить одну вещь у клерка. Где он?»~
@5363  = ~«Мне нужно попасть в ту охраняемую комнату».~
@5364  = ~«Мне нужно попасть в ту охраняемую комнату».~
@5365  = ~~
@5366  = ~«Мне нужно попасть в ту охраняемую комнату».~
@5367  = ~«Мне нужно попасть в ту охраняемую комнату, а я потерял жетон».~
@5368  = ~«Мне нужно попасть в ту охраняемую комнату, а я потерял жетон».~
@5369  = ~~
@5370  = ~~
@5371  = ~~
@5372  = ~«Мне нужно поработать в кузнице».~
@5373  = ~«Мне нужно поработать в кузнице».~
@5374  = ~«Где я могу получить инструмент для работы в кузнице?»~
@5375  = ~«Пожалуй, мне ничего не нужно. До свидания».~
@5376  = ~«Видишь вон ту комнату, где стоит стол? За столом нужный тебе человек. Там ты и получишь свою вещь».~
@5377  = ~«Спасибо. У меня ещё вопросы».~
@5378  = ~Она оглядывается по сторонам, чтобы удостоверится, не смотрит ли кто, затем снимает с шеи золотой медальон и украдкой суёт тебе в руку. «Никому не говори, где ты это взял», — шепчет она.~
@5379  = ~«Спасибо. Прощай».~
@5380  = ~«Спасибо. У меня ещё вопросы».~
@5381  = ~«Спасибо. Прощай».~
@5382  = ~«Мне бы хотелось помочь, но это может разрешить только самое высокое начальство. Тебе нужно поговорить с Келдором».~
@5383  = ~«Хорошо. У меня ещё вопросы».~
@5384  = ~«И на том спасибо. До свидания».~
@5385  = ~«Разумеется. Только для этого нужно иметь следующие вещи: костюм для защиты от огня, клещи, молот и, конечно, свою руду».~
@5386  = ~«Хорошо. У меня ещё вопросы».~
@5387  = ~«Где я могу найти эти вещи?»~
@5388  = ~«Спасибо. Прощай».~
@5389  = ~«Боюсь, мы должны пустить к горну других наших соратников. Ты слишком долго занимаешь его, родной».~
@5390  = ~«Хорошо. Тогда у меня другие вопросы».~
@5391  = ~«Хорошо. Прощай».~
@5392  = ~«Мне хотелось бы помочь, но, кажется, я куда-то засунула жетон, который даёт доступ туда. Извини, ищущий».~
@5393  = ~«Хорошо. У меня ещё вопросы».~
@5394  = ~«Хорошо. Пока».~
@5395  = ~«Ещё вопросы? И о чём?»~
@5396  = ~«Я хочу получить одну вещь у приёмщика. Где он?»~
@5397  = ~«Мне нужно попасть в ту охраняемую комнату».~
@5398  = ~«Мне нужно попасть в ту охраняемую комнату».~
@5399  = ~«Мне нужно попасть в ту охраняемую комнату».~
@5400  = ~«Мне нужно попасть в ту охраняемую комнату».~
@5401  = ~«Мне нужно попасть в ту охраняемую комнату, а я потерял жетон».~
@5402  = ~«Мне нужно попасть в ту охраняемую комнату, а я потерял жетон».~
@5403  = ~«Мне нужно попасть в ту охраняемую комнату».~
@5404  = ~«Мне нужно попасть в ту охраняемую комнату, а я потерял жетон».~
@5405  = ~«Мне нужно попасть в ту охраняемую комнату, а я потерял жетон».~
@5406  = ~«Мне нужно поработать в кузнице».~
@5407  = ~«Мне нужно поработать в кузнице».~
@5408  = ~«По поручению Келдора я расследую убийство, которое здесь произошло. Что ты можешь мне об этом рассказать?»~
@5409  = ~«Я ищу выход отсюда».~
@5410  = ~«Я ищу стол заказов. Мне надо забрать заказ».~
@5411  = ~«Я бы хотел небольшую экскурсию».~
@5412  = ~«Кто ты?»~
@5413  = ~«Что здесь происходит?»~
@5414  = ~«Каких именно принципов придерживаются Боготы?»~
@5415  = ~«Где я могу получить инструмент для работы в кузнице?»~
@5416  = ~«Пожалуй, мне ничего не нужно, До свидания».~
@5417  = ~«Хорошо, что у меня он всё ещё есть. Возьми мой, но никому не говори, что это я тебе дала, договорились? Удачи».~
@5418  = ~«Спасибо. У меня ещё вопросы».~
@5419  = ~«Спасибо. Прощай».~
@5420  = ~«У меня больше ни одного не осталось. Извини. Поищи другой способ попасть внутрь».~
@5421  = ~«Спасибо. У меня ещё вопросы».~
@5422  = ~«Спасибо. Прощай».~
@5423  = ~«Если не сможешь найти их где-нибудь, придётся купить у клерка… по номиналу, разумеется».~
@5424  = ~«Ясно. У меня ещё вопросы».~
@5425  = ~«Спасибо. Прощай».~
@5426  = ~«Да? И чего ты ждёшь? Иди ковать! Мы же не можем раздувать горн всё время, пока ты тут прохлаждаешься».~
@5427  = ~«Ну, я хотел сначала спросить…»~
@5428  = ~«Так где я могу найти вещи для работы в кузне?»~
@5429  = ~«Ладно-ладно, иду».~
@5430  = ~«Я уже рассказала тебе всё, что знаю! Чего тебе ещё надо?»~
@5431  = ~«Я хотел бы ещё раз услышать твою историю… и помедленнее».~
@5432  = ~«У меня ещё вопросы».~
@5433  = ~«Ничего. Пока».~
@5434  = ~«Хочешь знать, что я видела в ночь убийства? Ну… я немного задержалась на работе, было уже поздно, и вдруг я услышала шум схватки. Когда подбежала к месту, откуда раздавался шум, то увидела, как какая-то неясная фигура проскользнула в дверь зала собраний. После этого я подняла тревогу».~
@5435  = ~«Ещё что-нибудь знаешь?»~
@5436  = ~«Это всё?»~
@5437  = ~«А как ты докажешь, что это не твоя работа?»~
@5438  = ~«Спасибо. У меня ещё вопросы».~
@5439  = ~«Спасибо. Прощай».~
@5440  = ~«Я знаю только, что этой ночью доступ в здание был у троих: Тильдона, Сароса и Бедай-Лин. Выглядят эти трое совсем по-разному, но в дыму кузни я толком не разглядела фигуру».~
@5441  = ~«А как ты докажешь, что это не твоя работа?»~
@5442  = ~«То есть подозреваемых только трое? Уж больно просто получается».~
@5443  = ~«Хорошо. Где я могу найти Тильдона?»~
@5444  = ~«У меня есть алиби. Не говоря о том, что Келдор уже выяснил у меня всю правду. Мне нечего скрывать. А вот Тильдону, Саросу и Бедай-Лин, очевидно, есть что, потому как они не спешат давать показания под заклинанием Келдора».~
@5445  = ~«Хорошо. Где я могу найти Сароса?»~
@5446  = ~«Прекрасно. Где я могу найти Бедай-Лин?»~
@5447  = ~«Хорошо. У меня ещё вопросы».~
@5448  = ~«У меня ещё вопросы».~
@5449  = ~«Хорошо. У меня ещё вопросы».~
@5450  = ~«Где я могу найти Тильдона?»~
@5451  = ~«Где я могу найти Сароса?»~
@5452  = ~«Где я могу найти Бедай-Лин?»~
@5453  = ~«Спасибо. Это очень ценная информация. Прощай».~
@5454  = ~«Обычно его можно найти либо здесь, в главном цехе, либо в экспериментальной камере сзади. Ты найдёшь его без труда».~
@5455  = ~«Где я могу найти Сароса?»~
@5456  = ~«Где я могу найти Бедай-Лин?»~
@5457  = ~«Он обычно в главном зале собраний. Ты его не пропустишь».~
@5458  = ~«Где я могу найти Тильдона?»~
@5459  = ~«Где я могу найти Бедай-Лин?»~
@5460  = ~«Она может быть в любой части Кузницы. Она — один из наших главных инженеров и может находиться в любом месте. Ты узнаешь её, стоит только увидеть».~
@5461  = ~«Где я могу найти Тильдона?»~
@5462  = ~«Где я могу найти Сароса?»~
@5463  = ~«Спасибо тебе за то, что помог нам с машинами. Может, без тебя мы бы их и починили, но это заняло бы уйму времени. Благодарю. Что ещё я могу для тебя сделать?»~
@5464  = ~«У меня кое-какие вопросы».~
@5465  = ~«Ну, на самом деле почти ничего. Прощай».~
@5466  = ~«Опять ты? Теперь чего тебе надо? Прошу прощения за грубость, но у нас тут куча дел».~
@5467  = ~«Я хотел задать тебе пару вопросов».~
@5468  = ~«По поручению Келдора я расследую убийство, которое здесь произошло. Что ты можешь мне об этом рассказать?»~
@5469  = ~«Ничего. Я ухожу».~
@5470  = ~Ты видишь невысокую женщину с тонкими рожками на лбу и загибающимися назад остроконечными ушами. От неё слабо пахнет серой, это чувствуется даже в наборе ароматов Кузницы. «Привет. Чем могу быть полезной?»~
@5471  = ~«По поручению Келдора я расследую убийство, которое здесь произошло. Что ты можешь мне об этом рассказать?»~
@5472  = ~«Я ищу выход отсюда».~
@5473  = ~«Я ищу стол заказов. Мне надо забрать заказ».~
@5474  = ~«Я бы хотел небольшую экскурсию».~
@5475  = ~«Кто ты?»~
@5476  = ~«Что здесь происходит?»~
@5477  = ~«Каких именно принципов придерживаются Боготы?»~
@5478  = ~«Спасибо, ничем. Прощай».~
@5479  = ~«Посмотри, откуда ты пришёл. Видишь длинный туннель? Просто пройди по нему — и окажешься у главных ворот».~
@5480  = ~«Спасибо».~
@5481  = ~«Это вон в том отделе с конторкой. Там сидит нужный тебе человек».~
@5482  = ~«Спасибо. У меня ещё вопросы».~
@5483  = ~«Спасибо. До свидания».~
@5484  = ~«Обычно я и сама люблю экскурсии больше всего. К сожалению, сейчас мы несколько заняты. Возвращайся через год или около того, и я с радостью её тебе предоставлю».~
@5485  = ~«Что происходит?»~
@5486  = ~«Хорошо. У меня ещё вопросы».~
@5487  = ~«Хорошо. Прощай».~
@5488  = ~«Я Алисса Тилд, смотритель этого участка. Это главный кузнечный цех Великой Кузницы. Большая часть нашей текущей открытой работы выполняется здесь. Разумеется, сама Кузница намного больше, но мы работаем над крупным заказом и обязались хранить его подробности в тайне, поэтому для посторонних доступ в большую часть рабочей области закрыт. Прошу прощения».~
@5489  = ~«Ясно. У меня ещё вопросы».~
@5490  = ~«Посторонним вход воспрещён? Какой бред! Прощай!»~
@5491  = ~«Ясно. Спасибо за информацию».~
@5492  = ~«Мы получили большой и невероятно секретный заказ, на работу над которым уходят практически все наши ресурсы. Мы выполняем и другие, меньшие заказы по изготовлению обычных вещей, но именно сейчас все ресурсы Кузницы брошены на наш большой заказ. Не спрашивай о нём ничего, я не могу тебе рассказывать».~
@5493  = ~«Кажется, ты непоколебима. Ладно. У меня другие вопросы».~
@5494  = ~«Похоже, тебя вряд ли удастся переубедить. Прощай».~
@5495  = ~«Это одновременно и общественная, и личная фракция — всё зависит от точки зрения и того, с кем ведётся разговор. Но основная идея состоит в том, что всё происходящее с нами — это своего рода испытание. Всё на свете испытывает нас, и от того, как мы проходим испытание, зависит наше понимание сути вещей. Мы ищем истину в мультивселенной и не сомневаемся, что мы на верном пути».~
@5496  = ~«Ясно. У меня ещё вопросы».~
@5497  = ~«Как я могу вступить в ваши ряды?»~
@5498  = ~«Хм. Спасибо за информацию».~
@5499  = ~«Поговори с Келдором из Дуриана. Он в зале собраний, туда ведёт дверь в правой стене».~
@5500  = ~«Спасибо. У меня ещё вопросы».~
@5501  = ~«Спасибо. До свидания».~
@5502  = ~Уйти.~
@5503  = ~Цеховой рабочий поворачивается и убегает.~
@5504  = ~«Ладно».~
@5505  = ~Этот человек старательно не обращает внимания ни на тебя, ни на стражу, сопровождающую тебя к выходу.~
@5506  = ~«Ладно».~
@5507  = ~«Я слышал, рядом с телом нашли кузнечное шило. Но дело в том, что такое же можно найти здесь где угодно. Сдаётся мне, преступник тут Тильдон — в Кузнице никогда не было никого гаже».~
@5508  = ~«Спасибо тебе за помощь. Но мне нужно ещё кое о чём спросить».~
@5509  = ~«Спасибо. Это всё, что мне было нужно узнать».~
@5510  = ~«Спрашивай».~
@5511  = ~«Кто ты?»~
@5512  = ~«Чем ты занят?»~
@5513  = ~«Кто твой начальник?»~
@5514  = ~«Забудь. До свидания».~
@5515  = ~«А что? Ты из Берущих? Я уже заплатил налоги».~
@5516  = ~«Берущие? Кто это такие?»~
@5517  = ~«Нет, просто поинтересовался. Ну, знаешь. По-дружески».~
@5518  = ~«Забудь. Я хотел узнать другое».~
@5519  = ~«Забудь».~
@5520  = ~«Отрабатываю свою ежедневную зарплату. Работаю над своим совершенствованием. Делаю здесь уборку. Приношу кузнецам материал, когда он им нужен. Отправляю готовую продукцию по назначению… вот, вкратце, и вся моя работа».~
@5521  = ~«То есть ты в основном прибираешь и делаешь чёрную работу?»~
@5522  = ~«Ясно. Ещё один вопрос».~
@5523  = ~«Ясно. Пока».~
@5524  = ~«А что? Ты работаешь на него?»~
@5525  = ~«М-м… да».~
@5526  = ~«Смеёшься?»~
@5527  = ~«Чего-о? Городские сборщики налогов, кто же ещё. Ты чё, бестолочь? Ну тебя, у меня дел полно».~
@5528  = ~Уйти.~
@5529  = ~«У меня просто нет времени на дружеский трёп, особенно когда за моей работой наблюдает начальник. Сейчас мы заняты. Я просто скажу, что буду более расположен к тебе после того, как мы доделаем этот проект».~
@5530  = ~«Хорошо. Могу я задать тебе ещё один вопрос?»~
@5531  = ~«Конечно. Прощай».~
@5532  = ~«Если ты хочешь так считать. С тех пор как я слушаю всю эту боготскую нудятину, мне кажется, что это проверка на упорство. Пожалуй, вся моя жизнь — проверка на упорство».~
@5533  = ~«А почему бы не посчитать это проверкой на разумность и просто не уйти?»~
@5534  = ~«Это действительно поможет?»~
@5535  = ~«Ясно. Прощай».~
@5536  = ~«Он — соль земли. Настоящий джентльмен. Не могу рассказать о нём подробно только потому, что должен продолжать работу», — рабочий отворачивается и больше на тебя не реагирует.~
@5537  = ~Уйти.~
@5538  = ~«Один из самых грязных подонков, с каким я имел несчастье столкнуться… а вырос-то я в Улье, где было полно претендентов на первое место. Надеюсь, его скоро убьют… и зверски. И многие из рабочих так думают».~
@5539  = ~«Ясно. Могу я задать тебе ещё вопрос?»~
@5540  = ~«Ладно. Всего доброго».~
@5541  = ~«А куда уйти? Кто даст мне работу? В системе все уверены, что я гожусь только для чёрной работы, потому что родом из Улья. Дьявол, да я рад, что хоть сюда взяли. Если тока ты дашь мне работу получше… а так, я просто счастлив, что работаю здесь. Всё лучше, чем помирать с голоду».~
@5542  = ~«Да ладно, ты можешь добиться чего угодно, если включишь мозги».~
@5543  = ~«Звучит убедительно. Но ты не думаешь, что мог бы устроиться и получше?»~
@5544  = ~«А вдруг. Даёт надежду, что я когда-нибудь устроюсь лучше, в этой жизни или в следующей. Может, я и не вижу очевидного, но ты сам когда-нибудь в помойке копался? Оч-чень здорово учит ценить мелкие радости жизни. Жизнь бедняков вовсе не усыпана розами, пень, — рабочий поворачивается к тебе спиной. — Мне надо продолжать работу».~
@5545  = ~Уйти.~
@5546  = ~«Ну да, и в конце концов стану таким вот красавчиком зомби вроде тебя? Нет уж, спасибо. Не знаю, чем ты занимался, но моя жизнь меня вполне устраивает. По мне, лучше богатеть медленно. А теперь прошу меня извинить, но у меня рабочий день», — рабочий поворачивается к тебе спиной и больше не отвечает.~
@5547  = ~Уйти.~
@5548  = ~«Вот что я тебе скажу… живи как хочешь, а меня не трогай. Договорились? А теперь мне надо работать», — рабочий поворачивается к тебе спиной и больше не отвечает.~
@5549  = ~Уйти.~
@5550  = ~«Скажу я тебе, после всех этих потрясений в последние дни я плохо понимаю, что происходит. Будто я никогда и не покидал Улей… чем я могу тебе помочь?»~
@5551  = ~«Можешь ответить на пару вопросов».~
@5552  = ~«Ничем. Забудь».~
@5553  = ~Ты видишь серого жителя Улья. Он таскает ящики. Ты не можешь даже определить пол этого несчастного создания. «Что тебе от меня нужно?»~
@5554  = ~«Я хотел задать тебе пару вопросов».~
@5555  = ~«Ничего. Прощай».~
@5556  = ~«Что тебе нужно?»~
@5557  = ~«Получить ответы на вопросы».~
@5558  = ~«Ничего».~
@5559  = ~«СТРАЖА! СТРАЖА! Тут злоумышленники!»~
@5560  = ~Уйти.~
@5561  = ~«Извини. Прямо сейчас не могу с тобой говорить. Может, в другой раз».~
@5562  = ~Уйти.~
@5563  = ~«Не знаю, как и благодарить тебя за устранение этой ненормальной инженерши. Кто бы мог подумать, что она Анархист? Нас всех могли убить! Чем я могу тебе помочь?»~
@5564  = ~«Не расскажешь, для кого разрабатывается этот проект?»~
@5565  = ~«Ты что-то говорил о критическом этапе?»~
@5566  = ~«Что это за проект?»~
@5567  = ~«Что эта штуковина делает?»~
@5568  = ~«Почему всё держится в такой тайне?»~
@5569  = ~«Когда заказ будет готов?»~
@5570  = ~«Если ты что-нибудь знаешь, расскажи мне об убийстве в главной кузне».~
@5571  = ~«Что ты можешь рассказать о своей начальнице?»~
@5572  = ~«Что ты можешь рассказать о своей начальнице?»~
@5573  = ~«Расскажи мне об инженерах, работающих над этим проектом».~
@5574  = ~«Не знаешь, где можно найти стол заказов?»~
@5575  = ~«Нет, не могу тебе сказать. Во-первых, не знаю. Во-вторых, я подписал тайный договор, который связывает мою жизнь с сохранностью проекта. Если проект выйдет из строя — я могу погибнуть, как и все мои друзья здесь. Я не могу так рисковать».~
@5576  = ~«Расскажи мне о Боготах».~
@5577  = ~«Расскажи мне об инженерах, работающих над этим проектом».~
@5578  = ~«Расскажи мне об инженерах, работающих над этим проектом».~
@5579  = ~«Расскажи мне об инженерах, работающих над этим проектом».~
@5580  = ~«Сейчас ничем, спасибо».~
@5581  = ~«Разумно. Тогда расскажи мне кое о чём другом».~
@5582  = ~«Хорошо. Прощай».~
@5583  = ~«Это ужасно. Я слыхал, убитый совсем не был ангелом, но это же не значит, что его надо было толкнуть в машину. Так как Кузницу закрыли почти на целый год, пока мы не закончим заказ, то это, должно быть, кто-то из местных. Всё, что могу сказать, — я поручусь за любого из рабочих: мы никогда не пропадаем из поля зрения других настолько, чтобы можно было успеть».~
@5584  = ~«Ясно. Можно задать тебе ещё вопрос?»~
@5585  = ~«Хорошо. Прощай».~
@5586  = ~«Её обычно можно найти где-то здесь. Она гитцерай, которую изгнал собственный народ. Работает здесь потому, что тут её мало кто видит и её позор становится немного легче. Она одарённая и умная».~
@5587  = ~«Интересно, будет ли она говорить с моим другом Дак'коном…»~
@5588  = ~«Наверное, я поговорю с ней позже. У меня к тебе ещё кое-какие вопросы».~
@5589  = ~«Спасибо за информацию. Всего доброго».~
@5590  = ~«Наш главный инженер, Нил Зандер, — настоящий гений. Он создавал такие вещи, о которых я вообще не думал, что они возможны. Говорят, когда-то он создал складной портал, а в свободное время работает над Построителем Снов. Говорят, когда-то давно его семья подрядилась создать эту машину для человека, который не мог видеть сны сам.
Другой наш инженер, Бедай-Лин, работает не так давно, но настолько же одарена. Она немного сумасбродка, но её работы отличаются блестящим замыслом и исполнением.
Обоих обычно можно найти в главном зале собраний».~
@5591  = ~«Замечательно. А сейчас я хотел бы задать тебе ещё кое-какие вопросы».~
@5592  = ~«Построитель Снов, да? Наверное, стоит его разыскать».~
@5593  = ~«Стол заказов можно найти сразу за главной кузней».~
@5594  = ~«Спасибо. Ответь мне на другой вопрос».~
@5595  = ~«Спасибо».~
@5596  = ~«Что я думаю о Боготах? Одна из самых ярких особенностей нашей фракции — мы действительно заботимся о людях, причём обо всех, а не только о наших соратниках. Все мы можем когда-то стать богами, и даже больше, чем богами, — и поэтому мы помогаем всем. Иначе мы были бы эгоистами, даже хуже — дураками. А мы не дураки».~
@5597  = ~«Время покажет. Ещё один вопрос».~
@5598  = ~«Хорошо. Прощай».~
@5599  = ~«Ты уже знаешь, что Бедай-Лин схватили за убийство. Она была хорошая, но ненадёжная. Откуда мы могли знать, что она убийца?
А наш главный инженер, Нил Зандер, — выдающийся старик. Говорят, когда-то он создал складной портал, а в свободное время работает над Построителем Снов. Говорят, когда-то давно его семья подрядилась создать эту машину для человека, который не мог видеть сны сам. Его обычно можно найти в главном зале собраний».~
@5600  = ~«Замечательно. Ещё один вопрос».~
@5601  = ~«Построитель Снов? Я разыщу этого инженера».~
@5602  = ~«Слава силам, что ты поймал эту суку Бедай-Лин и больше она не будет нам вредить. Мы все могли погибнуть».

«Что касается другого нашего инженера, Нила Зандера, то его обычно можно найти в главном зале собраний. За свою жизнь он создал массу хитроумных устройств и, скорее всего, создаст их ещё много».~
@5603  = ~«Спасибо. Поговорим о другом».~
@5604  = ~«Говоришь, создаст ещё много? Ну, прощай».~
@5605  = ~«Кто мог знать, что Бедай-Лин хотела уничтожить всю организацию Боготов? Мы знали её как способного мага-инженера, но не знали, что она из Анархистов».

«Что касается Нила Зандера, то его обычно можно найти в главном зале собраний. За свою жизнь он создал массу хитроумных устройств и, скорее всего, создаст их ещё много».~
@5606  = ~«Ну конечно. Кто мог знать? У меня ещё вопросы».~
@5607  = ~«Наверное, я пойду разыщу его. Всего доброго».~
@5608  = ~Он испытующе смотрит на тебя и, по-видимому, приходит к выводу, что тебе можно доверять. «Хм… где в настоящее время слабые места? Внешняя оболочка всё ещё слабая — мы её пока не укрепляли. В пушечных портах есть оружие, но само оружие сейчас более чем нестабильно. Паровой котёл внутри может взорваться при максимальной нагрузке. Вся эта хреновина может вот-вот рассыпаться на части. Я бы сказал, что самая уязвимая часть — это спусковой механизм в конце. И если он взорвётся, мы все тут погибнем».~
@5609  = ~«Спасибо. У меня ещё вопрос».~
@5610  = ~«Спасибо. Прощай».~
@5611  = ~«Ты хочешь расспросить о Кел'лере? Её убил какой-то сраный выродок, вот и всё, что я могу сказать о ней. Разговор окончен. Уходи. Стража! Выведите отсюда этого пня!»~
@5612  = ~Уйти.~
@5613  = ~«Да? Что ты хочешь узнать?»~
@5614  = ~«Так какие части этой конструкции уязвимы?»~
@5615  = ~«Ты что-то говорил о критическом этапе?»~
@5616  = ~«Что это за проект?»~
@5617  = ~«Что эта штуковина делает?»~
@5618  = ~«Почему всё держится в такой тайне?»~
@5619  = ~«Когда заказ будет готов?»~
@5620  = ~«Не расскажешь, для кого разрабатывается этот проект?»~
@5621  = ~«Если ты что-нибудь знаешь, расскажи мне об убийстве в главной кузне».~
@5622  = ~«Что ты можешь рассказать о своей начальнице?»~
@5623  = ~«Что ты можешь рассказать о своей начальнице?»~
@5624  = ~«Расскажи мне об инженерах, работающих над этим проектом».~
@5625  = ~Он смотрит на тебя подозрительно: «А тебе это зачем вообще?»~
@5626  = ~«Не знаешь, где можно найти стол заказов?»~
@5627  = ~«Расскажи мне о Боготах».~
@5628  = ~«Расскажи мне об инженерах, работающих над этим проектом».~
@5629  = ~«Расскажи мне об инженерах, работающих над этим проектом».~
@5630  = ~«Расскажи мне об инженерах, работающих над этим проектом».~
@5631  = ~«Сейчас ничего, спасибо».~
@5632  = ~«Видишь ли, я сам немного понимаю в магической инженерии и полагаю, что мог бы помочь вам в работе. Если ты расскажешь мне о слабых местах конструкции, то я, может быть, найду решение».~
@5633  = ~«Видишь ли, я сам немного понимаю в магической инженерии и полагаю, что мог бы помочь вам в работе. Если ты расскажешь мне о слабых местах конструкции, то я, может быть, найду решение».~
@5634  = ~«Просто вся эта конструкция выглядит крайне ненадёжно».~
@5635  = ~«Мне даны полномочия осмотреть этот проект, и я хотел бы знать его изъяны».~
@5636  = ~«Мне даны полномочия осмотреть этот проект, и я хотел бы знать его изъяны».~
@5637  = ~«Просто из любопытства, вот и всё».~
@5638  = ~«Неважно. У меня другие вопросы».~
@5639  = ~«Забудь о том, что я спрашивал. До свидания».~
@5640  = ~В его взгляде появляется ещё большее подозрение. «Я не отвечу. Если тебе нужно знать что-нибудь подобное, спрашивай у Кел'леры, а не у меня».~
@5641  = ~«Где я могу найти Кел'леру?»~
@5642  = ~«Где я могу найти Кел'леру?»~
@5643  = ~«Забудь, что я спрашивал. Всего хорошего».~
@5644  = ~«Я полагаю, это оружие. Мы не знаем, предназначено ли оно для войны или для охоты — и силы всевышние, если для охоты, я не хотел бы встретиться со зверюгой, на которую его готовят, — но когда мы закончим, оно будет сравнимо с Кораблём Хаоса Стражей Судьбы, построенному несколько лет назад танар'ри. Правда, пока это только в теории».~
@5645  = ~«Что эта штука делает?»~
@5646  = ~«Почему всё хранится в такой тайне?»~
@5647  = ~«Когда заказ будет готов?»~
@5648  = ~«Я хочу спросить о другом».~
@5649  = ~«Прощай».~
@5650  = ~«Понимаешь, я сам до конца не уверен. Тебе следовало бы поговорить об этом с кем-нибудь из инженеров. Я знаю, что эта штука выстреливает мощную направленную струю жара — как минимум, эту часть мы закончили. Мы даже накрепко вставили её в устройство. Есть и другие узлы, над которыми мы ещё не начинали работать. Нам не позволяют видеть их до тех пор, пока не закончим с остальными частями».~
@5651  = ~«И всё-таки, что это такое?»~
@5652  = ~«Почему всё хранится в такой тайне?»~
@5653  = ~«Когда заказ будет готов?»~
@5654  = ~«Не мог бы ты ответить на другой вопрос?»~
@5655  = ~«Спасибо. Прощай».~
@5656  = ~«Если бы ты знал, что враг готовит для войны против тебя оружие, разве ты не сделал бы всё, что в твоих силах, лишь бы уничтожить его оружие? У нас даже нет никакого представления, для кого оно предназначено. Мы просто верим начальству, а оно обещало, что эта штука не будет использоваться в целях, с которыми мы можем не согласиться. Никто из нас не знает, кто её заказал, так что нет возможности выдать эту тайну тому, кто хотел бы уничтожить эту штуку… в особенности потому, что мы все связали с ней свои жизни».~
@5657  = ~«Что ты имеешь в виду?»~
@5658  = ~«И всё-таки, что это такое?»~
@5659  = ~«И что она делает?»~
@5660  = ~«Когда заказ будет готов?»~
@5661  = ~«Не мог бы ты ответить на другой вопрос?»~
@5662  = ~«Спасибо. Прощай».~
@5663  = ~«Наверное, мы не закончим проект до конца десятилетия, но самая сложная часть должна быть готова в этом году. Необходимо совершить несколько магических ритуалов, а они требуют времени. Мы все вздохнём свободнее, когда узнаем, что изделие, с которым мы связали свои жизни, не взорвётся от непрочности».~
@5664  = ~«Связали свои жизни? Что ты имеешь в виду?»~
@5665  = ~«И всё-таки, что это такое?»~
@5666  = ~«И что оно делает?»~
@5667  = ~«Почему всё хранится в такой тайне?»~
@5668  = ~«У меня к тебе другой вопрос».~
@5669  = ~«Спасибо. Прощай».~
@5670  = ~«В силу самой природы этого проекта — секретность и всё такое, не говоря уже о том, что и работать можно только с помощью магии, — каждому из нас пришлось связать с этой машиной часть своей жизни. Мы получим свои жизни обратно, когда проект завершится. Но если машина взорвётся вследствие неисправности или — да спасут нас силы — саботажа, то взрыв унесёт и наши жизни».~
@5671  = ~«Звучит скверно. Но я хочу задать ещё пару вопросов».~
@5672  = ~«Плохи дела. Удачи, тебе она понадобится. Прощай».~
@5673  = ~Ты видишь тифлинга в одежде Боготов, внимательно осматривающего устройство в центре комнаты. «Мне сейчас не до разговоров. Мы на критическом этапе».~
@5674  = ~«На критическом этапе чего?»~
@5675  = ~«Я надеялся, ты ответишь мне на кое-какие вопросы».~
@5676  = ~«Тогда извини, что побеспокоил. Прощай».~
@5677  = ~«Опять ты? Что тебе нужно на этот раз?»~
@5678  = ~«Ты что-то говорил о критическом этапе?»~
@5679  = ~«Я хотел задать тебе кое-какие вопросы».~
@5680  = ~«Оставлю тебя в покое. До свидания».~
@5681  = ~«Да. Проект, над которым мы работаем, — это оружие, которое, должно быть, будет активно применяться и в мирное время. Наша работа далека от завершения, но сейчас очень тонкий этап — настолько тонкий, что если какой-нибудь пень сейчас помешает, нас всех можно смело записывать в книгу мёртвых».~
@5682  = ~«Над чем вы сейчас работаете?»~
@5683  = ~«Ой. У меня ещё вопросы».~
@5684  = ~«Ясно. Удачи».~
@5685  = ~«Мы настраиваем параметры нижнего диапазона магического резонанса устройства. Одна ошибка может погубить весь проект, а если он сорвётся — нас всех убьёт магической волной».~
@5686  = ~«Ясно. Могу я задать другой вопрос?»~
@5687  = ~«Ясно. Прощай».~
@5688  = ~«Я был бы счастлив встретить ещё одного отверженного, ещё одного изгоя. Наверное, разделив наш общий позор, мы ослабим его остроту для нас обоих».~
@5689  = ~«Рад за вас. Но я спрашивал не тебя. У меня ещё вопросы к этому малому».~
@5690  = ~«Мы поговорим с ней совсем скоро, друг. А сейчас у меня ещё вопросы к нашему приятелю».~
@5691  = ~«Товарищи! Ко мне! Здесь нарушители! Сюда!»~
@5692  = ~Драться.~
@5693  = ~«Гражданин, тебя попросили уйти. Будь добр, исполняй. Сейчас же».~
@5694  = ~«Ладно».~
@5695  = ~«Пожалуйста, очисти дворик, уважаемый. Или входи, или выходи».~
@5696  = ~~
@5697  = ~~
@5698  = ~~
@5699  = ~~
@5700  = ~~
@5701  = ~ТОЧКА ОТСЧЁТА~
@5702  = ~~
@5703  = ~~
@5704  = ~ТОЧКА ОТСЧЁТА~
@5705  = ~~
@5706  = ~~
@5707  = ~~
@5708  = ~ТОЧКА ОТСЧЁТА~
@5709  = ~~
@5710  = ~~
@5711  = ~~
@5712  = ~«Добрый день, уважаемый. Могу чем-нибудь помочь?»~
@5713  = ~«Что находится за теми охраняемыми дверями?»~
@5714  = ~«Ну, да. Не знаю, с кем об этом поговорить, но мне кажется, тебе сказать можно. Бедай-Лин просила меня убить Сандоза. Как тебе такая информация?»~
@5715  = ~«Я расследую убийство кузнеца. Ты что-нибудь видел той ночью?»~
@5716  = ~«Где находится стол заказов?»~
@5717  = ~«Где найти ваше начальство?»~
@5718  = ~«Где найти ваше начальство?»~
@5719  = ~«Нет, спасибо. До свидания».~
@5720  = ~«Боюсь, что это тайна, уважаемый. Даже для наших проверенных соратников. Если ты не участвуешь в проекте и не имеешь разрешения от нашего начальства, мы не можем пустить тебя внутрь».~
@5721  = ~«Ладно. Как мне найти стол заказов?»~
@5722  = ~«Хорошо. Где найти ваше начальство?»~
@5723  = ~«Хорошо. Где найти ваше начальство?»~
@5724  = ~«Я расследую убийство кузнеца. Ты что-нибудь видел той ночью?»~
@5725  = ~«Что касается начальства: Бедай-Лин просила меня убить Сандоза. Как тебе такая информация?»~
@5726  = ~«А если я тебе врежу?»~
@5727  = ~«Ясно. Прощай».~
@5728  = ~«Вопрос, как всегда. И, как всегда, неправильный вопрос», — он слегка кланяется, но это движение внезапно вызывает у него приступ кашля. «Я… — он на секунду замолкает, переводя дыхание, — я… Дхалл».~
@5729  = ~«Тот вопрос был всего лишь первым, Дхалл. Я хочу узнать ещё много чего…»~
@5730  = ~«Хорошо, Беспокойный», — кивает Дхалл. «Но, боюсь, время тебе в этом деле не враг, — он снова берётся за перо. — Если ты когда-нибудь захочешь поговорить со мной, я буду здесь».~
@5731  = ~«Возможно, ты ответишь на кое-какие вопросы, Дхалл…»~
@5732  = ~«У меня нет на это времени. Прощай».~
@5733  = ~Дхалл качает головой: «Страсти — тяжёлый груз. Якорь, который держит тебя в этой тени жизни. Пока ты цепляешься за чувства, ты будешь снова и снова возрождаться к этой „жизни“ и вечно будешь страдать, так никогда и не познав чистоты Истинной Смерти».~
@5734  = ~«Изживи свои страсти. Освободись от необходимости чувствовать. Когда ты полностью очистишься, эта череда перерождений закончится и ты обретёшь покой, — Дхалл вздыхает… это звучит как предсмертный гортанный хрип. — Там, за этими нашими оболочками, за Вечной Границей, лежит тот покой, которого ищет каждая душа».~
@5735  = ~«У меня другие вопросы…»~
@5736  = ~«Расскажи мне побольше о Мортуарии».~
@5737  = ~«Ясно. У меня другие вопросы…»~
@5738  = ~«Прощай, Дхалл».~
@5739  = ~«Расскажи мне побольше о Мортуарии».~
@5740  = ~«Ясно. У меня другие вопросы…»~
@5741  = ~«Прощай, Дхалл».~
@5742  = ~«Я говорю о ранах сознания. Ты многое забыл, разве нет? Быть может, настоящие твои раны куда глубже, чем те шрамы, которыми покрыта твоя кожа… — Дхалл снова кашляет, — …но этого никто, кроме тебя, знать не может».~
@5743  = ~«Расскажи мне побольше о Мортуарии».~
@5744  = ~«Ясно. У меня другие вопросы…»~
@5745  = ~«Прощай, Дхалл».~
@5746  = ~«У меня другие вопросы…»~
@5747  = ~«Прощай, Дхалл».~
@5748  = ~«Чем ты здесь занимаешься?»~
@5749  = ~«У меня есть ещё вопросы…»~
@5750  = ~«Прощай, Дхалл».~
@5751  = ~«У меня другие вопросы…»~
@5752  = ~«Прощай, Дхалл».~
@5753  = ~«Прощай, Дхалл».~
@5754  = ~«Ясно. У меня другие вопросы…»~
@5755  = ~«Я чувствую, что наши пути ещё пересекутся. До свидания, Дхалл».~
@5756  = ~«Я больше не могу говорить с тобой. Прощай, Дхалл».~
@5757  = ~«Спасибо. У меня другие вопросы…»~
@5758  = ~«Прощай, Дхалл».~
@5759  = ~«Прямо на юге от главной кузни, уважаемый, находится контора, в которой стоит стол. Это и есть стол заказов».~
@5760  = ~«Спасибо. А где найти ваше начальство?»~
@5761  = ~«Спасибо. А где найти ваше начальство?»~
@5762  = ~«Я расследую убийство кузнеца. Ты что-нибудь видел той ночью?»~
@5763  = ~«Не знаю, кому это можно рассказать, но… Бедай-Лин просила меня убить Сандоза».~
@5764  = ~«Что находится за теми охраняемыми дверями?»~
@5765  = ~«Пожалуй, единственный, кто может тебе помочь после гибели Сандоза, — Келдор. Его можно найти в главном зале собраний — это за дверью в правой части главной кузни. Ты его не пропустишь».~
@5766  = ~«Хорошо. Что находится за теми охраняемыми дверями?»~
@5767  = ~«Не подскажешь мне, как найти стол заказов?»~
@5768  = ~«Я расследую убийство кузнеца. Ты что-нибудь видел той ночью?»~
@5769  = ~Уйти.~
@5770  = ~«Тут тебе могут помочь либо Сандоз, либо Келдор. Келдор находится в главном зале собраний, это за дверью в правой части главной кузни. Сандоза обычно можно найти в комнатах за залом».~
@5771  = ~«Спасибо. А как мне найти стол заказов?»~
@5772  = ~«Что находится за теми охраняемыми дверями?»~
@5773  = ~«Я расследую убийство кузнеца. Ты что-нибудь видел той ночью?»~
@5774  = ~«Кстати, о Сандозе: Бедай-Лин попросила меня убить его. Как тебе такая информация?»~
@5775  = ~«Спасибо. Прощай».~
@5776  = ~«Хотел бы я посмотреть, что у тебя получится, почтенный».~
@5777  = ~Напасть.~
@5778  = ~Уйти.~
@5779  = ~«Нет, уважаемый. На ночь мы ушли из зала».~
@5780  = ~«Это необычно?»~
@5781  = ~«Кто мог отдать такой приказ?»~
@5782  = ~«У меня к тебе другой вопрос, не об убийстве».~
@5783  = ~«Ясно. Интересно. Спасибо за информацию».~
@5784  = ~«ЧТО? Ты не шутишь? Иди расскажи это Келдору. А мы пока займёмся инженером. Спасибо».~
@5785  = ~Уйти.~
@5786  = ~«Да, уважаемый, это необычно. Как правило, нас держат здесь день и ночь, чтобы обеспечить безопасность проекта».~
@5787  = ~«А кто имеет право тебя отпустить?»~
@5788  = ~«Что ты можешь сказать мне об этом проекте?»~
@5789  = ~«Так ты хочешь сказать, что ничего не видел?»~
@5790  = ~«Интересно. Спасибо».~
@5791  = ~«Только Тильдон и Бедай-Лин. Полагаю, отдать такой приказ могло и начальство или кто-нибудь близкий к ним, но это вообще невероятное событие. Я не знаю, от кого исходил приказ, и не знаю, зачем это понадобилось».~
@5792  = ~«Не слишком-то много, но уже кое-что для начала. Я хочу задать тебе ещё вопрос».~
@5793  = ~«И в том, что вы получили такой приказ, ничего необычного не было?»~
@5794  = ~«И ты ничего не видел?»~
@5795  = ~«Это… „содержательно“. Доброго дня».~
@5796  = ~«Ещё вопрос?»~
@5797  = ~«Что находится за теми охраняемыми дверями?»~
@5798  = ~«Ну, да. Не знаю, с кем об этом поговорить, но мне кажется, тебе сказать можно. Бедай-Лин просила меня убить Сандоза. Как тебе такая информация?»~
@5799  = ~«Я расследую убийство кузнеца. Ты что-нибудь видел той ночью?»~
@5800  = ~«Где находится стол заказов?»~
@5801  = ~«Где найти ваше начальство?»~
@5802  = ~«Где найти ваше начальство?»~
@5803  = ~«Забудь. До свидания».~
@5804  = ~«Так точно, почтенный. Я ничего не видел».~
@5805  = ~«Хм. Тогда у меня к тебе ещё вопрос».~
@5806  = ~«Ты не подумал, что этот приказ необычен?»~
@5807  = ~«Это… „содержательно“. Доброго дня».~
@5808  = ~«Я понимаю, мы должны помогать тебе с этим убийством, как только можем, но должен предупредить, что моя помощь не особо ценна».~
@5809  = ~«Почему нет? Тебя там не было?»~
@5810  = ~«Это точно. В любом случае у меня ещё вопрос».~
@5811  = ~«О. Тогда забудь».~
@5812  = ~Ты видишь скучающего охранника внушительного вида. «Приветствую тебя, почтенный. Могу я чем-нибудь помочь?»~
@5813  = ~«Что находится за теми охраняемыми дверями?»~
@5814  = ~«Ну, да. Не знаю, с кем об этом поговорить, но мне кажется, тебе сказать можно. Бедай-Лин просила меня убить Сандоза. Как тебе такая информация?»~
@5815  = ~«Где находится стол заказов?»~
@5816  = ~«Где найти ваше начальство?»~
@5817  = ~«Где найти ваше начальство?»~
@5818  = ~«Забудь. До свидания».~
@5819  = ~«Приветствую тебя, почтенный. Могу я чем-нибудь помочь?»~
@5820  = ~«Что находится за теми охраняемыми дверями?»~
@5821  = ~«Ну, да. Не знаю, с кем об этом поговорить, но мне кажется, тебе сказать можно. Бедай-Лин просила меня убить Сандоза. Как тебе такая информация?»~
@5822  = ~«Где находится стол заказов?»~
@5823  = ~«Где найти ваше начальство?»~
@5824  = ~«Где найти ваше начальство?»~
@5825  = ~«Забудь. До свидания».~
@5826  = ~«Опять ты? Стража! Стража!»~
@5827  = ~Драться.~
@5828  = ~Уйти.~
@5829  = ~«Опять ты? Стража! Стража!»~
@5830  = ~Драться.~
@5831  = ~Уйти.~
@5832  = ~«Хорошо, пень… проходи мимо, и никто тебя не тронет».~
@5833  = ~Уйти.~
@5834  = ~«Добро пожаловать в Кузницу снова, уважаемый».~
@5835  = ~«Спасибо. Мне нужно забрать одну вещь».~
@5836  = ~«Спасибо».~
@5837  = ~«Добро пожаловать в Кузницу снова, уважаемый».~
@5838  = ~«Спасибо. Мне нужно забрать одну вещь».~
@5839  = ~«Спасибо».~
@5840  = ~Здоровенному стражнику на вид скучно: «Изложи своё дело, пожалуйста».~
@5841  = ~«Просто осматриваюсь».~
@5842  = ~«Мне нужно забрать заказ».~
@5843  = ~«Мне нужно разместить заказ».~
@5844  = ~«Кто ты?»~
@5845  = ~«Чем ты занят?»~
@5846  = ~«Я помогаю Зандеру работать над Построителем Снов».~
@5847  = ~«Я здесь для того, чтобы использовать Построитель Снов».~
@5848  = ~«Тогда я уверен, ты не будешь против просто пройти мимо».~
@5849  = ~«Могу ли я войти?»~
@5850  = ~«Не буду».~
@5851  = ~«Да, уважаемый. Можно взглянуть на твою квитанцию?»~
@5852  = ~«Да».~
@5853  = ~Ложь: «Да».~
@5854  = ~«Нет».~
@5855  = ~«Я уверен, что брал её с собой…»~
@5856  = ~«Прошу прощения, уважаемый, но в настоящее время мы не принимаем новые заказы, так как работаем над большим проектом. Приходи примерно через год. Спасибо, что обратился к нам».~
@5857  = ~«Ладно. У меня есть ещё вопросы».~
@5858  = ~«Спасибо».~
@5859  = ~«Я страж Верующих в Источник, уважаемый».~
@5860  = ~«Верующих в Источник?»~
@5861  = ~«О, ясно. У меня ещё вопросы».~
@5862  = ~«Спасибо».~
@5863  = ~«Охраняю ворота, уважаемый».~
@5864  = ~«Хор-рошо. У меня есть ещё вопросы».~
@5865  = ~«Спасибо за информацию».~
@5866  = ~«Ты находишься перед входом в Великую Кузницу, дом Верующих в Источник».~
@5867  = ~«Кого-кого?»~
@5868  = ~«Что такое Великая Кузница?»~
@5869  = ~«Ого. Спасибо. У меня другие вопросы».~
@5870  = ~Уйти: «Ой».~
@5871  = ~«Изложи суть своих потребностей, уважаемый».~
@5872  = ~«Просто осматриваюсь».~
@5873  = ~«Мне нужно забрать заказ».~
@5874  = ~«Мне нужно разместить заказ».~
@5875  = ~«Кто ты?»~
@5876  = ~«Чем ты занят?»~
@5877  = ~«Что это за место?»~
@5878  = ~«Никаких дел. Извини».~
@5879  = ~«Нет, пока ты не докажешь, что у тебя здесь действительно дела, уважаемый».~
@5880  = ~«Ясно. У меня есть ещё вопросы».~
@5881  = ~«Ясно. До свидания».~
@5882  = ~«Добро пожаловать, уважаемый. Служащий, который тебе нужен, держит свою контору у южной стены Кузницы. Спасибо за посещение», — он открывает перед тобой ворота.~
@5883  = ~Уйти.~
@5884  = ~«Почтенный… по-моему, у тебя нет никакой квитанции».~
@5885  = ~«Я уверен, что брал её с собой…»~
@5886  = ~«Хм. Нет. Но я хотел бы задать другой вопрос».~
@5887  = ~Уйти.~
@5888  = ~«Тогда боюсь, тебе придётся уйти, уважаемый».~
@5889  = ~Уйти.~
@5890  = ~«Конечно, почтенный, я уверен, так оно и было. Однако пока ты не докажешь, что у тебя здесь действительно дела, боюсь, мы не можем тебя впустить».~
@5891  = ~«У меня другие вопросы».~
@5892  = ~Уйти.~
@5893  = ~«Да, уважаемый. Нас называют Боготами».~
@5894  = ~«Почему?»~
@5895  = ~«Замечательно. До свидания».~
@5896  = ~«Это не только дом Верующих в Источник, но и одна из крупнейших кузнечных мастерских в этом мире. Через эти ворота проходят многие; мы получаем заказы со всех планов. Сейчас мы не принимаем новые заказы: большинство мастеров работают над новым проектом, а остальные выполняют мелкие заказы, там очередь на несколько месяцев вперёд. Практически же это означает, что ты не попадёшь внутрь, если у тебя нет квитанции на выдачу заказа или важного дела к нам».~
@5897  = ~«У меня и есть важное дело!»~
@5898  = ~«У меня есть квитанция!»~
@5899  = ~Уйти.~
@5900  = ~«Мы — одна из пятнадцати признанных фракций Сигила, уважаемый. Мы верим, что каждое существо несёт в себе божественную искру — не обязательно добрую или злую, но потенциальное божественную. Под божественностью мы понимаем нечто большее. Мы верим, что у любой жизни есть смысл и цель, и мы призваны осознать эту цель. Каждым шагом в своей жизни мы стремимся к этому величию».~
@5901  = ~«Звучит солидно».~
@5902  = ~«Замечательно. Можешь меня впустить?»~
@5903  = ~«Мы верим, что это так, уважаемый. Могу я ещё чем-нибудь помочь тебе?»~
@5904  = ~«Да. У меня есть ещё вопросы».~
@5905  = ~«Нет».~
@5906  = ~«Нет, спасибо».~
@5907  = ~«Да, уважаемый. Входи».~
@5908  = ~«Спасибо».~
@5909  = ~«Так ты один из тех, из-за кого вся эта заваруха, а? Не то чтоб я их винил… ты на вид опасен. Проходи, давай отсюда».~
@5910  = ~Убить старика.~
@5911  = ~Уйти.~
@5912  = ~«Я бы с охотой тебе помог, сынок, но мне от этого будет больше вреда, чем пользы. Иди и возвращайся как-нибудь в другой раз, когда стражи не будут так всё вынюхивать».~
@5913  = ~Уйти.~
@5914  = ~Ты видишь морщинистого старика с трясущимися руками и хитрым выражением лица. Он внимательно смотрит на тебя и произносит: «Хе… хм… я тебя раньше не видел? Чем-то мне твоё лицо знакомо».~
@5915  = ~«Думаю, всё возможно».~
@5916  = ~«Не может такого быть, дедуля».~
@5917  = ~«Откуда? Не помнишь, где видел?»~
@5918  = ~«Мне нужно забрать одну вещь».~
@5919  = ~«Мне нужна запасная спецовка и кузнечный инструмент».~
@5920  = ~«Мне нужна маскировка».~
@5921  = ~«Кто ты?»~
@5922  = ~«Я хотел бы получить кузнечный инструмент».~
@5923  = ~«Интересно. До свидания, старик».~
@5924  = ~«Тебе нужно что-нибудь ещё?»~
@5925  = ~«Ты упоминал, что уже видел меня раньше. Не припомнишь, где это было?»~
@5926  = ~«Нет, просто хотел посмотреть на твою улыбку».~
@5927  = ~«Мне нужно забрать одну вещь».~
@5928  = ~«Мне нужна запасная спецовка и кузнечный инструмент».~
@5929  = ~«Мне нужна маскировка».~
@5930  = ~«Кто ты?»~
@5931  = ~«Я хотел бы получить кузнечный инструмент».~
@5932  = ~«Интересно. До свидания, старик».~
@5933  = ~«Я никогда не забываю лица… обязательно вспомню… а, катись оно в Баатор».~
@5934  = ~«Не припомнишь, где это было? Для меня это важно».~
@5935  = ~«Мне нужно забрать одну вещь».~
@5936  = ~«Мне нужна запасная спецовка и кузнечный инструмент».~
@5937  = ~«Мне нужна маскировка».~
@5938  = ~«Кто ты?»~
@5939  = ~«Я хотел бы получить кузнечный инструмент».~
@5940  = ~«Забудь. Всего хорошего».~
@5941  = ~«Зуб даю, я тебя уже где-то видел. Никогда не имел проблем с законом? — старик тихонько хихикает про себя. — А, забудь. Я вспомню».~
@5942  = ~«Ладно. Тогда ответь мне на вопросы».~
@5943  = ~«Надеюсь, что нет. Всего хорошего».~
@5944  = ~«Придержи лошадок, парниша. Ты задал мне такую задачку, что пока шарики раскрутятся — ой-ой времени пройдёт. Я прожил долгую жизнь и видел такую прорву лиц, что припомнить не так уж просто. Память — штука слишком летучая, чтобы на неё полагаться».

Перед ответом ты бормочешь себе под нос: «Так давай вспоминай, „парниша“».~
@5945  = ~«Тогда забудь. Я здесь, чтобы забрать одну вещь».~
@5946  = ~«Ну ладно. Мне нужна запасная спецовка и кузнечный инструмент».~
@5947  = ~«Хорошо. Мне нужна маскировка».~
@5948  = ~«Тогда скажи мне, кто ты такой?»~
@5949  = ~«Тогда я хотел бы получить кузнечный инструмент».~
@5950  = ~«Ладно. Всего хорошего, „парниша“».~
@5951  = ~«У тебя есть квитанция? Без квитанции я тебе ничего не дам».~
@5952  = ~«У меня тут даже две».~
@5953  = ~«Конечно. Вот».~
@5954  = ~«Конечно. Вот».~
@5955  = ~«Да».~
@5956  = ~Ложь: «Да».~
@5957  = ~«Конечно. Вот».~
@5958  = ~«Нет».~
@5959  = ~«Забудь. Всего хорошего».~
@5960  = ~«Да? Ну хорошо. Это будет стоить… дай посмотрю… скажем, шестьдесят медяков».~
@5961  = ~«Держи».~
@5962  = ~«У меня столько нет».~
@5963  = ~«Неважно. У меня другие вопросы».~
@5964  = ~«Забудь. Всего хорошего».~
@5965  = ~«Маскировка, а? Я уже догадываюсь, для чего тебе она понадобилась, и вручу её тебе за смешную цену в шестьдесят медяков».~
@5966  = ~«Держи».~
@5967  = ~«У меня столько нет».~
@5968  = ~«Неважно. У меня другие вопросы».~
@5969  = ~«Забудь. Всего хорошего».~
@5970  = ~«Я-то? Я Надилин, великий воин Боготов! — он вздыхает. — По крайней мере, был раньше. Теперь я приёмщик заказов в Кузнице, дышу здешней копотью и приближаю свой конец».~
@5971  = ~«Какая жалость. У меня ещё вопросы».~
@5972  = ~«Ладно. Это всё, что я хотел узнать. Прощай».~
@5973  = ~«А, ты хочешь стать кузнецом, ага, парниша? Замечательно. Тебе нужен фартук — десять медяков, клещи — ещё десять, и молот — это двадцать. Всего получается… минутку… пятьдесят».~
@5974  = ~«Вообще-то получается сорок, старик».~
@5975  = ~Заплатить пятьдесят медяков.~
@5976  = ~Заплатить пятьдесят медяков.~
@5977  = ~«Прошу прощения, но мне кажется, скорее получается сорок».~
@5978  = ~«Неважно. У меня другие вопросы».~
@5979  = ~«Не думаю, что мне это нужно прямо сейчас. Прощай».~
@5980  = ~«Мир тебе, сынок. А теперь прошу меня извинить — буду снова пялиться в окно».~
@5981  = ~«Э-э… ну ладно».~
@5982  = ~«Сейчас принесу». Проходит несколько минут, он семенит обратно и выкладывает перед тобой пару предметов: маленькую, почти невесомую металлическую вещицу и тонкой работы палицу. «Первой-то штучке больше ста лет! Долго ж ты её не забирал, приятель. Как она тебе досталась?»~
@5983  = ~«Оставлял для себя, но всё было некогда».~
@5984  = ~«От старших поколений в семье».~
@5985  = ~«По наследству передали».~
@5986  = ~Старик берёт твою квитанцию и сличает со своими записями. Потом выбегает из комнаты на пару минут и возвращается с палицей тонкой работы: «Вот, парниша».~
@5987  = ~«Спасибо. У меня были вопросы».~
@5988  = ~«Спасибо. Всего хорошего».~
@5989  = ~Старик берёт у тебя квитанцию и внимательно её изучает: «Да этой вещице больше сотни лет! Как она тебе досталась?»~
@5990  = ~«Оставлял для себя, но всё было некогда».~
@5991  = ~«От старших поколений в семье».~
@5992  = ~Он на секунду замолкает. «Если у тебя есть квитанция, тащи её сюда, иначе я тебе ничего не выдам. А пока гуляй. Ходют тут всякие, а у меня дел и без того полно».~
@5993  = ~Уйти.~
@5994  = ~«Тогда вот. Забери эту сучку отсюда, потому что мы не хотим больше терпеть её вероломство».~
@5995  = ~Ложь: «Что? Мне не для этого надо!»~
@5996  = ~«Как ты узнал?»~
@5997  = ~«Спасибо огромное, дедуля. Прощай».~
@5998  = ~«Тогда я правда не могу тебе ничего дать. Извини».~
@5999  = ~«Ладно. Тогда ответь мне на вопросы».~
@6000  = ~«Хорошо. До свидания».~
@6001  = ~Он чуть ли не обнюхивает квитанцию, а потом поднимает глаза на тебя. «Так я ж тебе выдал по ней! А ты опять пришёл? Не-а, второй раз не дам, — он прячет квитанцию в карман. — Пшёл вон!»~
@6002  = ~Уйти.~
@6003  = ~«И о чём я думал? Конечно, сорок. Скажу тебе, память — капризная штука».~
@6004  = ~«Вот. Выдай мне, что полагается».~
@6005  = ~«Вот. Выдай мне, что полагается».~
@6006  = ~«Ну, это всё равно для меня слишком дорого».~
@6007  = ~«Не забудь взять у Тильдона руду, если собираешься работать в кузне. Он, конечно, редкостная сволочь, но руду выдаёт только он».~
@6008  = ~«Спасибо. У меня к тебе ещё вопросы».~
@6009  = ~«Спасибо. До свидания».~
@6010  = ~«Если хочешь работать в кузне, тебе нужна руда. Найди заместительницу Тильдона… забыл, как зовут, но она выдаст тебе руду без всякого базара».~
@6011  = ~«Спасибо, дедуля. Я ещё хотел спросить…»~
@6012  = ~«Спасибо и всего хорошего».~
@6013  = ~«Это хорошая вещица, парень. Бьюсь об заклад, ты был сильно занят!» — он усмехается про себя. Затем передаёт тебе предмет, который держит в руках: «Вот. Обращайся с ней бережно, слышишь?»~
@6014  = ~«Обязательно. Но сейчас у меня ещё вопросы».~
@6015  = ~«Разумеется. Прощай».~
@6016  = ~«Передавали из поколения в поколение, ага? Твоё счастье, что вещь до сих пор не выбросили — мы иногда выкидываем невостребованное или продаём, если заказчик точно не придёт и не заберёт. Хорошо, держи. Обращайся с ней бережно, слышишь?»~
@6017  = ~«Обязательно. Могу я задать тебе ещё пару вопросов?»~
@6018  = ~«Договорились. Прощай».~
@6019  = ~«Ясненько. Тебе досталась шикарная штука, парниша. Вот, держи. Обращайся с этой железякой бережно, слышишь?»~
@6020  = ~«Разумеется. Можно тебя ещё спросить?»~
@6021  = ~«Разумеется. Всего хорошего».~
@6022  = ~Он смотрит на тебя с отвращением: «Слушай, юноша. Ты получил своё барахло. Теперь топай отсюда, или я передумаю и стражу позову».~
@6023  = ~Уйти.~
@6024  = ~«Может, я и старый дурак, но ещё могу прикинуть, что к чему. Бедай-Лин уже давно не в своей тарелке, и она никогда не любила сотрудничать с извергами. Теперь гуляй. Уверен, у меня тут работка найдётся».~
@6025  = ~Уйти.~
@6026  = ~«Возможно, мне стоит поговорить с Фародом. Прощай, Дхалл».~
@6027  = ~«Тогда я пойду разыщу его. Прощай, Дхалл».~
@6028  = ~«Обнадёживающе. Прощай, Дхалл».~
@6029  = ~«Прощай, Дхалл».~
@6030  = ~«Я пойду туда и спрошу. Прощай».~
@6031  = ~«Тогда я найду этого Фарода. Прощай, Дхалл».~
@6032  = ~«Может, ты объяснишь мне, зачем Пыльные хотят меня убить?»~
@6033  = ~«Что есть Истинная Смерть?»~
@6034  = ~«Эта жизнь является тенью?»~
@6035  = ~«Расскажи мне побольше о Мортуарии».~
@6036  = ~«У меня к тебе другие вопросы…»~
@6037  = ~«Тогда прощай».~
@6038  = ~«Я услышал достаточно. Прощай, Дхалл».~
@6039  = ~«Я услышал достаточно. Прощай, Дхалл».~
@6040  = ~«Хорошо. Прощай, Дхалл».~
@6041  = ~«У меня другие вопросы…»~
@6042  = ~«Похоже, я в долгу у тебя за твою помощь. Прощай, Дхалл».~
@6043  = ~«Похоже на забвение. Зачем кому-то этого хотеть?»~
@6044  = ~«Ох. Можешь рассказать мне побольше о Мортуарии?»~
@6045  = ~«Ясно. У меня другие вопросы».~
@6046  = ~«Мне надо уходить. Прощай, Дхалл».~
@6047  = ~«Тень жизни?»~
@6048  = ~«Расскажи мне побольше о Мортуарии».~
@6049  = ~«Ясно. У меня другие вопросы».~
@6050  = ~«Мне надо уходить. Прощай, Дхалл».~
@6051  = ~«Полагаю, твой фатализм взял над тобой верх. Те элементы — лишь часть жизни, но не вся жизнь».~
@6052  = ~«Держат в клетке? Как?»~
@6053  = ~«Достаточно философии. Какое отношение весь этот разговор имеет к тому, что я очнулся здесь?»~
@6054  = ~«Ясно. И как можно вырваться из круга перерождений и достичь этой… Истинной Смерти?»~
@6055  = ~«Расскажи мне побольше о Мортуарии».~
@6056  = ~«У меня другие вопросы…»~
@6057  = ~«Прощай, Дхалл».~
@6058  = ~«Вечная Граница?»~
@6059  = ~«Расскажи мне побольше о Мортуарии».~
@6060  = ~«У меня другие вопросы…»~
@6061  = ~«Прощай, Дхалл».~
@6062  = ~«Прощай, Дхалл».~
@6063  = ~«Может быть. У меня есть ещё вопросы…»~
@6064  = ~«Тогда я схожу в мемориальный зал и поищу там её тело».~
@6065  = ~«Ты как будто болен. Всё в порядке?»~
@6066  = ~«Ясно. Прощай, Дхалл».~
@6067  = ~«Возможно, стоит пойти её поискать. Но сначала у меня есть ещё вопросы…»~
@6068  = ~«Я пойду вниз, в мемориальный зал, и попробую найти там её тело».~
@6069  = ~«У меня к тебе другие вопросы…»~
@6070  = ~«Тогда прощай».~
@6071  = ~«Эй, шеф, ты тут или где? Ты как будто в осадок выпал».~
@6072  = ~«Э? Дух?»~
@6073  = ~«Ты тут гремел костями с бабой? Где? — Морте потрясённо осматривается. — Какая она была из себя?»~
@6074  = ~«Э-э… нет, ты просто вроде как отлучился, ну, в осадок выпал и стоял тут, как столб. Я уж забоялся, что ты снова протух».~
@6075  = ~«Нет, я в порядке. Ты знаешь, что это был за дух?»~
@6076  = ~«Я в порядке. Пошли».~
@6077  = ~«Тот призрак, с которым я говорил. Женщина».~
@6078  = ~«Она была прямо над гробницей. Ты её не видел?»~
@6079  = ~«Нет, я в порядке… пожалуй. Пошли».~
@6080  = ~«Нет. Прощай… Дейонарра».~
@6081  = ~Уйти.~
@6082  = ~Уйти.~
@6083  = ~«У меня нет для тебя ответов! До сих пор тебя вело твоё безжалостное сердце, так пусть оно ведёт тебя и дальше! А теперь уходи прочь!»~
@6084  = ~«Я должен идти, Дейонарра. Прощай».~
@6085  = ~Уйти.~
@6086  = ~Ярость на лице Дейонарры утекает, как вода… скорость, с которой на её лице проступает новое выражение, пугает не меньше, чем само это выражение — беспросветное отчаяние. «Нет! Остановись, Любовь моя! — взывает она. — Пожалуйста, прости меня, умоляю! Не уходи!»~
@6087  = ~Ярость на лице Дейонарры утекает, как вода… скорость, с которой на её лице проступает новое выражение, пугает не меньше, чем само это выражение — беспросветное отчаяние: «Нет… нет, нет… Я всё ещё та Дейонарра, которую ты помнишь, Любовь моя. Пожалуйста, прости меня, умоляю!»~
@6088  = ~Её голос падает до еле различимого шёпота: «Да… да, пожалуйста, не уходи». Умоляющее выражения на её лице вызывает у тебя лёгкую дрожь… не от страха, а от удовольствия. У тебя такое чувство, что ты не первый раз обращаешься с этой женщиной как с марионеткой.~
@6089  = ~«Брошу *тебя*?! Ты СМЕЕШЬ мне говорить, что я бросаю ТЕБЯ?!» — Дейонарра резко разводит руки дугой, затем вытягивает их вперёд, направляя оба указательных пальца на тебя. Выглядит похожим на какое-то колдовство. «Ты СМЕЕШЬ!..»~
@6090  = ~«Гори! Гори так, как если бы ужасное пламя Баатора пожирало тебя изнутри! Гори и знай, что это только *малая часть* моей ненависти! Проклинаю тебя — проклинаю всем сердцем и душой, и никогда не сбросишь ты оков этой жалкой нежизни. Ты иссохнешь и умрёшь, а разум твой будет сохнуть и гнить вместе с телом!»~
@6091  = ~«Проклятие, однажды произнесённое, уже не снять, — голос Дейонарры падает до шёпота. — Знай, у меня в запасе вечность, „Любовь моя“. Я буду ждать, пока ты придёшь в палаты смерти». Она улыбается, но нет радости в её улыбке: «Мы *будем* вместе снова».~
@6092  = ~Дейонарра замирает. Кажется, она хочет что-то сказать, затем вздыхает с побеждённым видом. «Хорошо, Любовь моя… как и прежде, я буду верить тебе», — она закрывает глаза.~
@6093  = ~Клятва: «Клянусь, я найду способ спасти тебя или воссоединиться с тобой».~
@6094  = ~«Пусть так. Прощай, Дейонарра».~
@6095  = ~«Дейонарра, моё терпение на исходе. Если мы хотим продолжать разговор, *держи* себя в руках, или мы никогда больше не будем говорить. Ты останешься одна. Я понятно выразился?»~
@6096  = ~«Я прощаю тебя. Сейчас мне нужна твоя помощь, Дейонарра».~
@6097  = ~«Дейонарра, моё терпение на исходе. Если мы хотим продолжать разговор, *держи* себя в руках, или мы никогда больше не будем говорить. Ты останешься одна. Я понятно выразился?»~
@6098  = ~«Я прощаю тебя. Сейчас мне нужна твоя помощь, Дейонарра».~
@6099  = ~«Теперь слушай, Дейонарра. Я хочу спросить тебя…»~
@6100  = ~«Молчи! Внимай мне, призрак! Я сыт твоими играми по горло…»~
@6101  = ~Приготовиться защищаться.~
@6102  = ~«Поосторожней с проклятьями, женщина! Моё терпение иссякло…»~
@6103  = ~«Дейонарра! Постой, я должен попросить прощения…»~
@6104  = ~«Подожди, минутку! Я хотел поговорить…»~
@6105  = ~«Сними то, что ты сделала! Предупреждаю…»~
@6106  = ~Ждать…~
@6107  = ~«Пока ничего, Дейонарра, хотя я вернусь. Прощай».~
@6108  = ~Дейонарра грустно качает головой: «Произнесённое проклятие невозможно снять. Прости меня, Любовь моя».~
@6109  = ~«Если и есть, то он мне неизвестен… — к Дейонарре возвращается надежда. — Но есть те, кто могущественней меня, и они смогут снять его. Я снова прошу у тебя прощения, Любовь моя. Я не ведала, что творила».~
@6110  = ~«Есть кто-нибудь, кто может снять его?»~
@6111  = ~«Понимаю… Я хотел спросить тебя о другом…»~
@6112  = ~«Полагаю, теперь просить прощения уже поздно. Прощай, Дейонарра».~
@6113  = ~«Может быть, кто-нибудь поможет мне. Прощай, Дейонарра».~
@6114  = ~«Полагаю, теперь просить прощения уже поздно. Прощай, Дейонарра».~
@6115  = ~«Может быть, кто-нибудь поможет мне. Прощай, Дейонарра».~
@6116  = ~«Я хотел спросить тебя о другом…»~
@6117  = ~«Полагаю, теперь просить прощения уже поздно. Прощай, Дейонарра».~
@6118  = ~«Может быть, кто-нибудь поможет мне. Прощай, Дейонарра».~
@6119  = ~«Полагаю, теперь просить прощения уже поздно. Прощай, Дейонарра».~
@6120  = ~«Может быть, кто-нибудь поможет мне. Прощай, Дейонарра».~
@6121  = ~«Выбраться?.. — голос Дейонарры падает до шёпота и вновь набирает силу. — *Выбраться*?! Я тут по твоей милости, и ты меня ещё спрашиваешь, как отсюда *выбраться*?!»~
@6122  = ~Ты хочешь задать Дейонарре вопрос, но он застревает у тебя в горле. Тебе вдруг становится ясно, что если ты спросишь о пути бегства, она, скорее всего, вообразит, что ты намерен её бросить. Если ты собираешься расспрашивать её о подобном, тебе следует очень аккуратно выбирать выражения.~
@6123  = ~«Я чувствую, что в этом месте множество дверей, скрытых от глаз смертного. Быть может, отсюда можно выйти через один из этих порталов».~
@6124  = ~«Порталов?»~
@6125  = ~«Опасность? — Дейонарра кажется встревоженной. — Конечно, Любовь моя. Я помогу тебе всем, чем только могу…» Она на миг закрывает глаза, и ты видишь, как небесный эфир протекает сквозь её тело, шевеля волосы. Потом эфир пропадает, она медленно открывает глаза: «Пожалуй, путь есть».~
@6126  = ~«Да?»~
@6127  = ~«Пока никак, Дейонарра, хотя я вернусь. Прощай».~
@6128  = ~«Пока ничего, Дейонарра, хотя я вернусь. Прощай».~
@6129  = ~Ложь: «Ты не та Дейонарра, которую я знал. Та Дейонарра, которую я любил, была доброй, благородной душой… она никогда не отказывала в помощи нуждающемуся. Неужели ты пала так низко?»~
@6130  = ~«Мне нужна твоя помощь, Дейонарра. Неужели ты бросишь меня в момент, когда я больше всего в тебе нуждаюсь?»~
@6131  = ~Блеф: «Ну хорошо. Я исполню твоё желание, Дейонарра… уйду и больше не вернусь».~
@6132  = ~Блеф: «Ну хорошо. Я исполню твоё желание, Дейонарра… уйду и больше не вернусь».~
@6133  = ~«Прости, Дейонарра. Я не хотел причинять тебе боль. Я ухожу и больше тебя не побеспокою».~
@6134  = ~Тихо уйти.~
@6135  = ~«Ты пришёл ко мне после смерти только потому, что тебе нужна моя помощь, чтобы *снова* покинуть меня?! — её лицо превращается в маску гнева. — Я *умерла* ради тебя, Любовь моя. Даже теперь мне *больно*!»~
@6136  = ~Дейонарра закрывает глаза и тает под лёгкий шелест эфира.~
@6137  = ~«Да, мне нужно выбраться из этого места. Ты знаешь путь отсюда?»~
@6138  = ~«Извини за мой вопрос, я не хотел тебя обидеть. Прошу, ответь на другие вопросы…»~
@6139  = ~«Дейонарра, мне угрожает опасность. Ты можешь вывести меня в безопасное место? А потом я вернусь к тебе, как только смогу».~
@6140  = ~«Я должен идти. Прощай, Дейонарра».~
@6141  = ~«Я должен идти. Прощай, Дейонарра».~
@6142  = ~«Не скажешь мне, как выбраться из этого места?»~
@6143  = ~«Дейонарра, мне угрожает опасность. Ты можешь вывести меня в безопасное место? А потом я вернусь к тебе, как только смогу».~
@6144  = ~«У меня к тебе другие вопросы…»~
@6145  = ~«Я должен идти. Прощай, Дейонарра».~
@6146  = ~«Я должен идти. Прощай, Дейонарра».~
@6147  = ~«Да?»~
@6148  = ~«Да?»~
@6149  = ~«Дейонарра, прошу тебя… мне нужна твоя помощь. Неужели ты бросишь меня в беде?»~
@6150  = ~«Дейонарра, я спрашиваю об этом только потому, что мне угрожает опасность. Ты можешь вывести меня в безопасное место? А потом я вернусь к тебе, как только смогу».~
@6151  = ~«Не бери в голову. У меня другие вопросы…»~
@6152  = ~«Я должен идти. Прощай, Дейонарра».~
@6153  = ~«Я должен идти. Прощай, Дейонарра».~
@6154  = ~Уйти.~
@6155  = ~Уйти.~
@6156  = ~Тяжёлый деревянный ящик, заколоченный гвоздями.~
@6157  = ~Этот ящик изготовлен из старого дерева. Странно, что у него нет крышки.~
@6158  = ~СЕРДЦЕ ХАКАРИИ
(Малый артефакт)
Особенности:
   Ловкость: навсегда увеличивается на 1, когда разломлено
   Класс защиты против дистанционного оружия: навсегда увеличивается на 1
Вес: 10
Доступно: воинам

Этот чёрный предмет размером с кулак больше похож на кусок пережжённого угля, чем на сердце Хакарии. Он невероятно тяжёл для своих размеров, и вся его поверхность покрыта трещинами… как будто он может в любой момент разломиться пополам. Предмет оставляет на руках странные ржавые полосы, которые не стираются.

Что-то связанное с весом этой штуковины заставляет тебя поближе присмотреться к ней. При внимательном рассмотрении оказывается, что на самом деле это не сердце Хакарии, а камень. Насколько можно различить, нет ни единого признака, что эта штука когда-то была живой плотью. Непонятно, как Хакария жил с *этим* вместо сердца.

Какое бы благословение, позволявшее его стрелам лететь точно в цель, ни лежало на глазах Хакарии, оно оставило след и в его сердце. Если разломить сердце Хакарии пополам, то сломавший получит часть зрения, ловкости и наблюдательности Хакарии. Это даст прибавку к ловкости и шанс уклониться от любых метательных снарядов.~
@6159  = ~ДРЕВКОВОЕ ОРУЖИЕ
Урон: 1-10 рубящий
Вес: 15
Фактор скорости: 9
Навык: клинок
Доступно: воинам

Типовое древковое оружие для модели персонажа, который вооружён таковым.~
@6160  = ~ПОСМЕРТНЫЙ ДОГОВОР АНГИЯРА
Вес: 0

От этого потрескавшегося куска пергамента пахнет плесенью, как будто его слишком долго держали на чердаке. Документ написан сжатым, миниатюрным почерком. Из того, что получается разобрать: это договор между двумя сторонами, фракцией Пыльных и человеком по имени «Ангияр». В обмен на тридцать медных монет Ангияр передаёт права на пользование своим трупом Пыльным, предполагается, что те будут использовать его как разнорабочего в Мортуарии.~
@6161  = ~СЕРЕБРЯНАЯ СЕРЬГА
Вес: 0

Эту маленькую серебряную серёжку ты забрал у пьяной шлюхи недалеко от бара «Горящий труп».~
@6162  = ~АМУЛЕТ ОБТОЧЕННОЙ МОНЕТЫ
Особенности:
   Малое медное благословение
   Удача: +1 (временно)
Вес: 0

Эта медная монета была «обточена»… большая часть меди состругана, но сделавший это несомненно постарался, чтобы она всё ещё выглядела как обычная монета. А из стружки, по-видимому, хотели сделать другую монету. Хотя этот метод «делать деньги» широко распространён в Улье, конкретно фракция Обречённых делает это с особой целью — с целью создания амулетов, отражающих их жалкую сущность.

Чтобы производить подобного рода амулеты, члены фракции Обречённых выискивают тех, кто в прошлом преуспевал в делах и обладал богатством, но ныне разорён и отстранён от дел. Им дают зачарованные резаки и заставляют «обтачивать медь» для Обречённых, проводя за этим скучным занятием дни напролёт. Обречённые считают, что этот ритуал наделяет медные монеты остатками былой удачи человека.

Если подкинуть амулет обточенной монеты, он рассыплется дождём из медных монет и одновременно увеличит удачу кидавшего.~
@6163  = ~ПЕЧЕНЬ ХАКАРИИ
Вес: 3

Печень Хакарии выглядит как огромный, мёртвый слизень, а по текстуре напоминает винный бурдюк, несколько лет пролежавший в грязной луже. Чтобы орган сохранился, в него было закачано достаточное количество жидкости для бальзамирования, но запахи гниения и формальдегида, кажется, борются друг с другом за преобладание.~
@6164  = ~Отгонять нежить~
@6165  = ~ИСХОД ДУШИ
Вес: 1~
@6166  = ~ЗУБЫ ИНГРЕСС
Урон: 1-6 дробящий
Фактор скорости: 4
Вес: 1
Навык: кулачный бой
Доступно только Морте

Это пригоршня живых зубов Ингресс. Очевидно, они не захотели отправиться с ней через портал на домашний план. Зубы постукивают друг о друга и напоминают тебе кучу жутких скачущих жучков цвета слоновой кости.

^NПРИМЕЧАНИЕ. Тип зубов меняется нажатием «Использовать». По мере того, как Морте будет получать уровни, зубы могут приобретать новые возможности и способности.^-~
@6167  = ~Оставить женщину в покое.~
@6168  = ~«Что от моя надо? — женщина говорит с сильным акцентом, её речь трудно понять. — Забрать моя отсюда хотеть? НЕ ВЫБРАТЬСЯ из города, нет, моя — нет. Я не могу, стараться уже, это не город, везде тюрьма».~
@6169  = ~«Везде?»~
@6170  = ~«Извини, мне пора идти».~
@6171  = ~«Там миры, там… — её глаза безумно блестят, — …планы, которые зыбучие пески, поля жадной крапивы быть, слепые миры, где твоя члены получать жизнь и ненависть, города из пыли, люди в них пыль и пепел, дом без дверей, Сумречные земли, поющие ветры, поющие ветры…» Она тихо всхлипывает, но кажется, слёз у неё уже не осталось: «И тени… ужасные тени там быть».~
@6172  = ~«И где же эти места?»~
@6173  = ~«Извини, мне пора идти».~
@6174  = ~«Де? Де эти места? — она описывает обрубком правой руки широкий круг, как бы обводя весь город. — ЗДЕСЬ все они быть. Двери, двери, отсюда во *всюда*».~
@6175  = ~«Двери?»~
@6176  = ~«Извини, мне пора идти».~
@6177  = ~«Что? Твоя не знать?! — она опасливо косится на тебя, а её зубы начинают стучать. — Сказать твоя я могу: бойся в этом трижды проклятом городе всех мест, где ходить, трогать всё… Двери, ворота, арки, окна, витражи, открытый рот статуи, проходы меж шкафами… бойся ВСЕХ замкнутых пространств. ВСЕ они — в другие места двери».~
@6178  = ~«Что ты имеешь в виду?»~
@6179  = ~«Извини, мне пора идти».~
@6180  = ~«Каждая дверь КЛЮЧ иметь, и этому ключу дверь являть свою подлинную сущность… арка становиться порталом, картина становиться порталом, окно становиться порталом… и все жаждать унести твоя в ДРУГОЕ место. Они украсть твоя… — она воздевает остаток правой руки вверх. — И иногда что-то на той стороне забирать часть твоя как ПЛАТУ».~
@6181  = ~«Что это за ключи?»~
@6182  = ~«Извини, мне пора идти».~
@6183  = ~«Ключи… ключей много быть, как и дверей в этом городе. К каждой двери — ключ, к каждому ключу — дверь, — её зубы снова стучат, как от озноба. — А ключ?.. Ключом быть *что угодно*. Может чувство быть, может — железный гвоздь, зажатый меж указательным пальцем и мизинцем, или три раза подумать, а потом один раз наоборот подумать, или стеклянная роза».~
@6184  = ~«И всё это ключи, которые открывают эти двери?»~
@6185  = ~«Извини, мне пора идти».~
@6186  = ~«Да, — её зубы опять начинают отстукивать дробь, она усилием закрывает рот и косит глазами. — Д-д-да. Н-не убежать… не убежать…»~
@6187  = ~«Как ты сюда попала?»~
@6188  = ~«Извини, мне пора идти».~
@6189  = ~«Из… — кажется, она чуть успокаивается, а её взгляд теперь устремлён куда-то очень далеко. — Из другого места моя прийти, много лет назад, почти целая жизнь, напевать тогда мелодию на полянке, где два поваленных рядом дерева быть. Меж деревьями открыться бриллиантовая дверь, и на другой стороне этот город быть… Я шагнуть, здесь оказаться».~
@6190  = ~«Почему ты не можешь вернуться?»~
@6191  = ~«Извини, мне пора идти».~
@6192  = ~«Я пытаться!» — она снова всхлипывает, но слёз не видно. «Пытаться! ВСЕ двери вести в ДРУГИЕ места, — она вздрагивает и сжимает левой рукой растаявшую правую. — Пройти через три десятка порталов, какой специально, какой случайно и никакой туда. Не найти пути обратно…»~
@6193  = ~«Но должен же быть портал, который ведёт назад».~
@6194  = ~«Извини, мне пора идти».~
@6195  = ~«Не в состоянии даже отсюда уйти! Из этого квартала! Вон, то место смерти за воротами ждать моя! — она указывает на Мортуарий за воротами, затем опять поворачивается к тебе, и на лице у неё только отчаяние. — Никуда не мочь пойти в этом городе!»~
@6196  = ~«Никуда не можешь пойти? Что ты имеешь в виду?»~
@6197  = ~«Извини, мне пора идти».~
@6198  = ~«Портал что угодно быть. Любая арка, любая дверь, не зная ключа, можно опять оказаться в ужасном месте… — её зубы снова отстукивают дробь, — …моя не проходить через замкнутые проёмы, любой может дверью быть, а у моя может ключ быть, а я и не знать…»~
@6199  = ~«Ты… ты боишься пройти сквозь ЛЮБУЮ дверь или арку только потому, что она *может* оказаться порталом?»~
@6200  = ~«Извини, мне пора идти».~
@6201  = ~Она кивает, отстукивая зубами.~
@6202  = ~«Как долго ты этого боишься?»~
@6203  = ~«Извини, мне пора идти».~
@6204  = ~Она косится. «С тех пор, как моя в последний раз пройти через портал, в место, где остаться моя рука… — она прерывается. — С того Оборота… уже четвёртый десяток Оборотов начинать теперь». Она снова стучит зубами.~
@6205  = ~«Тридцать лет? Ты уже тридцать лет не можешь пройти *ни через одну* дверь?»~
@6206  = ~«Извини, мне пора идти».~
@6207  = ~Её взгляд чуть проясняется. Она глядит на тебя, стуча зубами.~
@6208  = ~«Раз уж ты сюда попала, то здесь должен быть портал, который перенесёт тебя назад. Его надо только найти…»~
@6209  = ~«Чтобы со страху *вообще* через двери не ходить, это уж…»~
@6210  = ~«Женщина, ты совсем *сбрендила*! Это какой дурой надо быть, чтобы сидеть на месте и не сметь сунуть нос никуда, где может оказаться портал…»~
@6211  = ~«Извини, мне пора идти».~
@6212  = ~Она улыбается. Оказывается, её зубы стучат вовсе не от озноба… они сами движутся во рту, а дёсны при этом гнутся. На твоих глазах зубы пляшут вперёд и назад, постукивая при этом друг о друга.~
@6213  = ~«Что?..»~
@6214  = ~«Э-э… пожалуй, я лучше пойду… прощай».~
@6215  = ~Она шипит: «Стоит твоя ХОТЬ РАЗ, с-случайно пройти портал, и твоя всегда их бояться быть. Я пройти через трижды-десять порталов, потерять руку, получить ожоги и разум терять». Она смотрит на свои ноги: «Больше никогда, никогда».~
@6216  = ~«Прости… если я найду способ как-нибудь помочь тебе, я помогу. Прощай».~
@6217  = ~«Ну так и помирай в городе, раз боишься сделать отсюда хоть шаг. Подчиняйся и дальше своим страхам. Скатертью дорожка, прощай».~
@6218  = ~«Спасибо за предупреждение, я запомню его. Прощай».~
@6219  = ~Ты видишь Ингресс. Она съёжилась под своей накидкой из грязного тряпья, зубы её стучат. Она настороженно оглядывается, как будто в любой миг ожидает нападения.~
@6220  = ~«Здравствуй, Ингресс».~
@6221  = ~Оставить её в покое.~
@6222  = ~«Э? Это твоя! — она опасливо на тебя косится. — Что от моя надо теперь?! Забрать моя отсюда хотеть? НЕ ВЫБРАТЬСЯ из города, нет, моя — нет. Я не могу, стараться уже, это не город, везде тюрьма».~
@6223  = ~«Везде тюрьма? Что ты имеешь в виду?»~
@6224  = ~«Расскажи мне ещё раз о тех местах… о тех планах, где ты побывала».~
@6225  = ~«Что это за двери, о которых ты толкуешь?»~
@6226  = ~«Что это за ключи, о которых ты толкуешь?»~
@6227  = ~«Как ты попала сюда?»~
@6228  = ~«Ингресс, я нашёл того, кто может вернуть тебя на твой родной план».~
@6229  = ~Этот грязно выглядящий труп в отвратительном состоянии: его плечи поникли, одна нога сломана, поэтому он кренится на одну сторону. Пятна покрывают его с макушки до пят… судя по аромату и внешнему виду — это пятна от тухлых яиц, грязи и продуктов жизнедеятельности птиц. В довершение картины всё его тело расписано граффити, а на груди, спине и голове прибито гвоздями несколько записок.~
@6230  = ~«А я-то думал, что это *мне* досталось как следует. Наверно, все эти гвозди — здорово больно?»~
@6231  = ~Обследовать труп.~
@6232  = ~Труп не отвечает.~
@6233  = ~Обследовать труп.~
@6234  = ~Осмотреть граффити и записки.~
@6235  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6236  = ~«Приятно было пообщаться. Прощай».~
@6237  = ~Оставить труп в покое.~
@6238  = ~Обследовать труп.~
@6239  = ~Обследовать труп.~
@6240  = ~Осмотреть граффити и записки.~
@6241  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6242  = ~«Приятно было пообщаться. Прощай».~
@6243  = ~Оставить труп в покое.~
@6244  = ~Этот труп не отвечает. Кажется, он находится слишком далеко отсюда, чтобы ответить.~
@6245  = ~Обследовать труп.~
@6246  = ~Обследовать труп.~
@6247  = ~Осмотреть граффити и записки.~
@6248  = ~Оставить труп в покое.~
@6249  = ~Несмотря на огромное количество швов, разлагающаяся кожа трупа кое-где отходит, обнажая мышцы и кости. Пожалуй, этот зомби часто использовался в качестве мишени… он весь заляпан грязью и тухлыми яйцами, в некоторых разрывах кожи видны камешки и осколки стекла. Из черепа до сих пор торчит здоровенный булыжник.~
@6250  = ~Осмотреть граффити и записки.~
@6251  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6252  = ~Вынуть булыжник из черепа.~
@6253  = ~Оставить труп в покое.~
@6254  = ~Несмотря на огромное количество швов, разлагающаяся кожа трупа кое-где отходит, обнажая мышцы и кости. Пожалуй, этот зомби часто использовался в качестве мишени… он весь заляпан грязью и тухлыми яйцами, в некоторых разрывах кожи видны камешки и осколки стекла.~
@6255  = ~Осмотреть граффити и записки.~
@6256  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6257  = ~Оставить труп в покое.~
@6258  = ~Несколько листков размыты дождём, но некоторые ещё можно прочесть. Записка на заднице подписана неким «Управлением по контролю за паразитами и болезнями»; на лбу, похоже, ресторанное меню, на груди какая-то официальная бумага, остальные, видимо, представляют собой что-то вроде частных объявлений.~
@6259  = ~Обследовать труп.~
@6260  = ~Обследовать труп.~
@6261  = ~Не читать записки, осмотреть только граффити.~
@6262  = ~Ознакомиться с бумагой от «Управления по контролю за паразитами и болезнями».~
@6263  = ~Прочитать ресторанное меню.~
@6264  = ~Прочитать официальную бумагу.~
@6265  = ~Татуировка спасителя Трист~
@6266  = ~Татуировка глаз справедливости~
@6267  = ~«Тем Гражданем Улья Каторые Ищут Харошую Работу в Самом УВАЖАСТНОМ и ЩЕДОРЫМ Правительстьве Сигила: Обращатся в Управление по контролю за паразитами и болезнями. АХОТА НА КРЫС! Платим за каждый пренисеный крысиный хвост. (Хвосты только настоящее и только от крыс. Кошачьи, собачьи и прочее не принемаем.) Обращатся несколко улиц к ЮГУ И ЗАПАДУ от Врат Мортуария, в нижнем Улье. Спросить афициального Главного Инспектора, ДАСТАПАЧТЕНАГО ФИНЕАСА Т. ЛОРТА 39-го».~
@6268  = ~«„Управление по контролю за паразитами и болезнями“?»~
@6269  = ~Обследовать труп.~
@6270  = ~Обследовать труп.~
@6271  = ~Просмотреть другие записки.~
@6272  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6273  = ~Оставить труп в покое.~
@6274  = ~Меню из бара «Собиратели пыли», но прочесть его невозможно, потому что кто-то накорябал поверх углем слова: «БАР ГОРЯЩИЙ ТРУП».~
@6275  = ~«Бар „Горящий труп“?»~
@6276  = ~«Бар „Горящий труп“?»~
@6277  = ~«Бар „Горящий труп“?»~
@6278  = ~Обследовать труп.~
@6279  = ~Обследовать труп.~
@6280  = ~Просмотреть другие записки.~
@6281  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6282  = ~Оставить труп в покое.~
@6283  = ~«ОФИЦИАЛЬНОЕ ОБЪЯВЛЕНИЕ: Согласно постановлению Законодательного Совета и Совета граждан Сигила, умышленная порча данного зарегистрированного слуги Пыльных, как-то: нанесение надписей, физический ущерб или использование в качестве доски объявлений — объявляется ПРЕСТУПЛЕНИЕМ, и совершивший его привлекается к ответственности за акт вандализма в отношении вышеупомянутого слуги», — по поручению Зала Советников.~
@6284  = ~Обследовать труп.~
@6285  = ~Обследовать труп.~
@6286  = ~Просмотреть другие записки.~
@6287  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6288  = ~Оставить труп в покое.~
@6289  = ~Граффити включает в себя как ненормативную лексику по отношению к Пыльным, так и прославление местных банд. Одна надпись бросается тебе в глаза… кто-то вырезал на левой руке трупа имя «Фарод», после чего перечеркнул его символом «X».~
@6290  = ~«Фарод?»~
@6291  = ~«Фарод?»~
@6292  = ~Обследовать труп.~
@6293  = ~Обследовать труп.~
@6294  = ~Просмотреть другие записки.~
@6295  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6296  = ~Оставить труп в покое.~
@6297  = ~Зомби тотчас же рывком поднимает левую руку вверх и указывает ей далеко на юго-восток. В следующий миг рука падает обратно с глухим БУХ.~
@6298  = ~Обследовать труп.~
@6299  = ~Обследовать труп.~
@6300  = ~«Хм-м. Интересно, будет ли то же самое и с другими записками…»~
@6301  = ~«Хм-м-м. Интересно, будет ли то же самое и с другими записками…»~
@6302  = ~Просмотреть другие записки.~
@6303  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6304  = ~«Э-э… спасибо».~
@6305  = ~Зомби тотчас же рывком поднимает левую руку вверх и указывает ей далеко на юго-запад. В следующий миг рука падает обратно с глухим БУХ.~
@6306  = ~Обследовать труп.~
@6307  = ~Обследовать труп.~
@6308  = ~Просмотреть другие записки.~
@6309  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6310  = ~«Э-э… спасибо».~
@6311  = ~Зомби тотчас же рывком поднимает левую руку вверх и указывает ей далеко на запад… и вниз. В следующий миг рука падает обратно с глухим БУХ.~
@6312  = ~Обследовать труп.~
@6313  = ~Обследовать труп.~
@6314  = ~Просмотреть другие записки.~
@6315  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6316  = ~«Э-э… спасибо».~
@6317  = ~Ты берёшься за булыжник и вытаскиваешь его из головы трупа. Из дырки медленно вытекают остатки мозгов и разложившейся плоти… как будто всё, что было в голове, давным-давно превратилось в жижу.~
@6318  = ~Обследовать труп.~
@6319  = ~Просмотреть записки.~
@6320  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6321  = ~Оставить труп в покое.~
@6322  = ~Зомби тотчас же рывком поднимает левую руку вверх и указывает ей далеко на юго-восток. В следующий миг рука падает обратно с глухим БУХ.~
@6323  = ~Назад в Нижний район~
@6324  = ~«Напоминает работу, которая у меня когда-то была, — он выглядит смущённым. — Ну, я имею в виду… без рук».~
@6325  = ~Обследовать труп.~
@6326  = ~Обследовать труп.~
@6327  = ~«Хм-м. Интересно, будет ли то же самое и с другими записками…»~
@6328  = ~«Хм-м-м. Интересно, будет ли то же самое и с другими записками…»~
@6329  = ~Просмотреть другие записки.~
@6330  = ~Использовать на трупе «Разговор с мёртвыми».~
@6331  = ~Оставить труп в покое.~
@6332  = ~«Тест постоялого двора»~
@6333  = ~«Тест храма»~
@6334  = ~«Итого три хвоста, по три монеты за крысу…»~
@6335  = ~«Ещё один крысолов убит… эти паразиты становятся умнее…»~
@6336  = ~«Инспектор Финеас Т. Лорт 39-й в ответе, чего изволите…»~
@6337  = ~«Просто чудо, что Улей не кишит паразитами!»~
@6338  = ~«Мы все ищем утешения в её объятиях».~
@6339  = ~«Истинная Смерть ждёт».~
@6340  = ~~
@6341  = ~~
@6342  = ~«Ты узнаешь, что я могу за себя постоять, израненный. Не подходи ближе».~
@6343  = ~«Идёт».~
@6344  = ~«Ясно, что ты не здешний. Вон отсюда, или стража будет для тебя не только почётным эскортом».~
@6345  = ~«Всего лишь быстрый вопрос».~
@6346  = ~«Всего лишь быстрый вопрос».~
@6347  = ~Уйти.~
@6348  = ~«Исчезни. Сейчас же. Пока это не стало ошибкой, о которой мы все пожалеем».~
@6349  = ~«Но я только спросить хотел!»~
@6350  = ~Уйти.~
@6351  = ~Ты видишь женщину-гитцерай со шрамами на лице. По меркам гитцерай она, наверно, красавица. «Я не могу тебе помочь. Уходи, или я позову стражу. Я отказываюсь от такой благодарности только из-за твоего компаньона». Она поворачивается к Дак'кону и говорит: «Прости меня, почтенный».~
@6352  = ~«Это всё замечательно, но мне нужно задать тебе пару вопросов».~
@6353  = ~«Хорошо». Уйти.~
@6354  = ~«Ты не оставил мне выбора». Она замолкает, потом кричит: «СТРАЖА! КО МНЕ!»~
@6355  = ~Уйти.~
@6356  = ~«Я просто хотел спросить!»~
@6357  = ~Она снова поворачивается к Дак'кону: «Прошу прощения». Затем снова к тебе: «Позволь мне прояснить. Уходи. Сейчас же. Или мне придётся позвать стражу, чтобы тебя „проводили“ отсюда. Наш проект нельзя компрометировать».~
@6358  = ~Уйти.~
@6359  = ~«Ты не оставил мне выбора». Она замолкает, потом кричит: «СТРАЖА! КО МНЕ!»~
@6360  = ~Уйти.~
@6361  = ~Она опять обращается к Дак'кону: «Почтенный… не приходи сюда больше. Нет на то моей воли, но я вызову стражу. Уходи».~
@6362  = ~«Я просто хочу задать пару вопросов».~
@6363  = ~Уйти.~
@6364  = ~Её чёрные глаза останавливаются на Дак'коне: «Почтенный… ты не оставил мне выбора. Прости меня перед лицом наших предков». Она отворачивается и кричит: «Стража! Стража!»~
@6365  = ~Уйти.~
@6366  = ~Ты видишь женщину-гитцерай, лысую, со шрамами на щеках и с кошачьей грацией в движениях. Повернувшись к тебе, она замечает Дак'кона. Её глаза расширяются от изумления. Она обращается к нему: «Ты принёс радость в моё сердце. Моё имя Кел'лера. Чем я могу тебе помочь?»~
@6367  = ~«Что это значит?»~
@6368  = ~«Ладно. Тогда я задам другой вопрос, если ты не возражаешь».~
@6369  = ~«Ладно. Тогда всё. Прощай».~
@6370  = ~«Так спрашивай, а я отвечу, если смогу. Твой товарищ несёт ношу твоего молчания как часть собственной чести, и хотя я не уверена, можно ли доверять тебе, я знаю, что могу доверять ему».~
@6371  = ~«Расскажи мне, что делает это устройство».~
@6372  = ~«Какие у этого устройства слабые места?»~
@6373  = ~«Кто заказал устройство?»~
@6374  = ~«Кто заказал устройство?»~
@6375  = ~«Что ты можешь рассказать мне об убийстве?»~
@6376  = ~«Что ты можешь рассказать об инженерах?»~
@6377  = ~В сторону, обращаясь к Дак'кону: «Кто она и почему относится к тебе с таким почтением?»~
@6378  = ~«Сейчас вопросов нет. Прощай».~
@6379  = ~«Наше устройство выбрасывает струю магического огня особого рода, который причиняет вред даже тем, кто невосприимчив к обычному огню. Мы работаем над устройствами, которые могли бы пробить даже защиту монстров, устойчивых к магии».~
@6380  = ~«Какие у него могут быть другие применения?»~
@6381  = ~«Хорошо. Ответь мне на другие вопросы».~
@6382  = ~«Это всё. Прощай».~
@6383  = ~Она глядит на Падшую Грейс и её рот изящно изгибается: «Прошу прощения, уважаемый, но я не имею права говорить об этом. Я принуждена — как контрактом, так и магией — молчать об этом там, где меня могут услышать некие… „распространители“, скажем так… поверь мне». Она поворачивается к суккубу: «Мои извинения, госпожа Грейс».~
@6384  = ~Кел'лера кланяется.~
@6385  = ~«Что это значит?»~
@6386  = ~«Ладно. Тогда я задам другой вопрос, если ты не возражаешь».~
@6387  = ~Она беспокойно глядит на Дак'кона, тот секунду меряет тебя глазами, а затем кивает ей в знак подтверждения. «Хорошо. Самое слабое звено — это казённик в задней части устройства. Если повредить этот узел, это может убить нас всех. Может начаться цепная реакция, которая уничтожит всех, кто связан с устройством. У вредителя, скорее всего, будет время, чтобы удрать, а вот у тех из нас, кто подключён к машине, его не будет».~
@6388  = ~«Подключён? Что ты имеешь в виду?»~
@6389  = ~«Ладно. Ответь мне на другие вопросы».~
@6390  = ~«Спасибо». Уйти.~
@6391  = ~Смотрительница снова тревожно смотрит на Падшую Грейс и стискивает зубы: «Я не имею права об этом говорить».~
@6392  = ~«Ладно. Ответь мне на другие вопросы».~
@6393  = ~Уйти.~
@6394  = ~«Помимо чисто военных? Оно может очень пригодиться в горнорудном деле. А если правильно настроить, оно может валить лес целыми просеками или жать хлеб целыми полями. Устройство могло бы на некоторое время придать прочность оболочкам из материалов Лимбо — мы уже опробовали в работе первые приложения этой технологии — или даже служить двигателем при перемещении между сферами Карцери. Его применения ограничены только воображением. Так что это не просто оружие разрушения».~
@6395  = ~«Интересно. Ответь мне на другие вопросы».~
@6396  = ~«Хорошо. Прощай». Уйти.~
@6397  = ~Она оглядывается по сторонам, вздыхает и произносит: «Хотя я и не принимала участия в переговорах, мне кажется, это был тот баатезу, который оплачивал наши услуги. Жетон, который ты носишь, обеспечивает некоторую степень дипломатической неприкосновенности среди тех баатезу, которых ты можешь встретить».~
@6398  = ~«Уверен, это будет полезно. Я задам тебе ещё вопрос, если ты не против».~
@6399  = ~«Спасибо за информацию. Прощай».~
@6400  = ~«Я мало что могу рассказать. Я и моя бригада кузнецов ни на минуту не прерывались и потому ничего не видели. Пожалуй, об этом следовало бы поговорить с кем-нибудь из тех, кто мог быть в кузне после наступления темноты. Назову тебе два имени: Тильдон, главный смотритель работ, и тот тип, Сарос, который вечно что-то воровато высматривает».~
@6401  = ~«Тильдон и Сарос, да? Замечательно. Я задам тебе ещё вопрос, если ты не против».~
@6402  = ~«Тильдон и Сарос, да? Пойду разыщу их. Прощай».~
@6403  = ~Она хмурится, и на её покрытом шрамами лице добавляется морщин: «Если тебе нужно *узнать* об инженерах — спроси кого-нибудь из моих кузнецов. От меня же ты о них доброго слова не услышишь».~
@6404  = ~«Почему нет?»~
@6405  = ~«Ладно. Тогда ответь на другие вопросы».~
@6406  = ~«Хорошо». Уйти.~
@6407  = ~«Почему? Да потому, что они не питают особой любви к этому проекту, как и к своим товарищам. Потому что они только мечтать горазды, а сами ничего не делают. И наконец потому, что я не верю в благо нам от их намерений: они выгодны им и только им».~
@6408  = ~«Ясно. Тогда я задам другой вопрос».~
@6409  = ~«Я понял. Прощай».~
@6410  = ~«Я имею в виду то, что мы связаны с этой машиной посредством магических ритуалов, которые вдохнут в неё силу. Случись вдруг поломка или, ещё хуже, вредительство — я и все, кого ты видишь в этом помещении, наверняка будем испепелены. Хуже того, погибнут сами наши души, канут в холодную тьму забвения. Теперь ты понял, почему мы храним тайну?»~
@6411  = ~«Пожалуй, да. Ответь мне на другие вопросы, если не против…»~
@6412  = ~«Пожалуй. Прощай».~
@6413  = ~«Спрашивай, и я отвечу, если смогу. Я верю в благоразумие твоего спутника».~
@6414  = ~«Расскажи мне, что делает это устройство».~
@6415  = ~«Какие у этого устройства слабые места?»~
@6416  = ~«Кто заказал устройство?»~
@6417  = ~«Кто заказал устройство?»~
@6418  = ~«Что ты можешь рассказать мне об убийстве?»~
@6419  = ~«Что ты можешь рассказать об инженерах?»~
@6420  = ~В сторону, обращаясь к Дак'кону: «Кто она и почему относится к тебе с таким почтением?»~
@6421  = ~«Сейчас вопросов нет. Прощай».~
@6422  = ~Лысая, покрытая шрамами женщина-гитцерай крутится перед тобой с непередаваемой грацией. Она окидывает тебя оценивающим взглядом и произносит: «Твой жетон даёт тебе права доступа. Что ещё тебе от меня нужно?»~
@6423  = ~«Всего лишь хотел услышать ответы на кое-какие вопросы».~
@6424  = ~«Не смей говорить со мной в таком тоне или получишь у меня».~
@6425  = ~«Сейчас ничего. Прощай».~
@6426  = ~«Спрашивай, что хотел, и поскорее. Да будет тебе известно, что у меня много работы».~
@6427  = ~«Расскажи мне, что делает это устройство».~
@6428  = ~«Какие у этого устройства слабые места?»~
@6429  = ~«Кто заказал устройство?»~
@6430  = ~«Кто заказал устройство?»~
@6431  = ~«Что ты можешь рассказать мне об убийстве?»~
@6432  = ~«Что ты можешь рассказать об инженерах?»~
@6433  = ~«Сейчас вопросов нет. Прощай».~
@6434  = ~Её и без того узкие глаза превращаются в две щёлочки: «Ты смеешь мне угрожать, здесь? Убирайся с глаз долой, и я сделаю вид, что ничего не слышала, иначе я позову стражу, и они выкинут на улицу то, что от тебя останется».~
@6435  = ~«Скорей я умру».~
@6436  = ~«Тогда ладно. Прощай».~
@6437  = ~«Это я тебе сейчас устрою. СТРАЖА! Убейте нарушителя!»~
@6438  = ~Приготовиться к бою.~
@6439  = ~«Наше устройство выбрасывает струю магического огня особого рода, который причиняет вред даже тем, кто невосприимчив к обычному огню. Мы работаем над устройствами, которые могли бы пробить даже защиту монстров, устойчивых к магии».~
@6440  = ~«Какие у него могут быть другие применения?»~
@6441  = ~«Хорошо. Ответь мне на другие вопросы».~
@6442  = ~«Это всё. Прощай».~
@6443  = ~«Помимо чисто военных? Оно может очень пригодиться в горнорудном деле. А если правильно настроить, оно может валить лес целыми просеками или жать хлеб целыми полями. Устройство могло бы на некоторое время придать прочность оболочкам из материалов Лимбо — мы уже опробовали в работе первые приложения этой технологии — или даже служить двигателем при перемещении между сферами Карцери. Его применения ограничены только воображением. Так что это не просто оружие разрушения».~
@6444  = ~«Интересно. Ответь мне на другие вопросы».~
@6445  = ~«Хорошо. Прощай». Уйти.~
@6446  = ~«Не вижу причины, по которой тебе может понадобиться эта информация, Богот ты или нет. Я на такую провокацию не поддамся».~
@6447  = ~«А если я тебя заставлю сказать?»~
@6448  = ~«Хорошо. Тогда я задам тебе другой вопрос».~
@6449  = ~«Разумно. Всего хорошего».~
@6450  = ~Она оглядывается по сторонам, вздыхает и произносит: «Хотя я и не принимала участия в переговорах, мне кажется, это был тот баатезу, который оплачивал наши услуги. Жетон, который ты носишь, обеспечит некоторую степень дипломатической неприкосновенности среди тех баатезу, которых ты можешь встретить».~
@6451  = ~«Уверен, это будет полезно. Я задам тебе ещё вопрос, если ты не против».~
@6452  = ~«Спасибо за информацию. Прощай».~
@6453  = ~Она глядит на Падшую Грейс, и её рот изящно изгибается: «Прошу прощения, уважаемый, но я не имею права говорить об этом. Я принуждена — как контрактом, так и магией — молчать об этом там, где меня могут услышать некие… „распространители“, скажем так… поверь мне». Она поворачивается к суккубу: «Мои извинения, госпожа Грейс».~
@6454  = ~«Прекрасно. Тогда всё. Прощай».~
@6455  = ~«Да».~
@6456  = ~«Да».~
@6457  = ~Смотрительница снова тревожно смотрит на Падшую Грейс и цедит сквозь зубы: «Не могу сказать!»~
@6458  = ~«Ладно. Ответь мне на другие вопросы».~
@6459  = ~Уйти.~
@6460  = ~«Я мало что могу рассказать. Я и моя бригада кузнецов ни на минуту не прерывались и потому ничего не видели. Пожалуй, об этом следовало бы поговорить с кем-нибудь из тех, кто мог быть в кузне после наступления темноты. Назову тебе два имени: Тильдон, главный смотритель работ, и тот тип, Сарос, который вечно высматривает, что плохо лежит».~
@6461  = ~«Тильдон и Сарос, да? Замечательно. Я задам тебе ещё вопрос, если ты не против».~
@6462  = ~«Тильдон и Сарос, да? Пойду разыщу их. Прощай».~
@6463  = ~Она хмурится, и на её покрытом шрамами лице добавляется морщин: «Если тебе нужно *узнать* об инженерах, спроси кого-нибудь из моих кузнецов. От меня же ты о них доброго слова не услышишь».~
@6464  = ~«Почему нет?»~
@6465  = ~«Ладно. Тогда ответь на другие вопросы».~
@6466  = ~«Хорошо». Уйти.~
@6467  = ~«Почему? Да потому, что они не питают особой любви к этому проекту, как и к своим товарищам. Потому что они только мечтать горазды, а сами ничего не делают. И наконец потому, что я не верю в благо нам от их намерений: они выгодны им и только им».~
@6468  = ~«Ясно. Тогда я задам другой вопрос».~
@6469  = ~«Я понял. Прощай».~
@6470  = ~Она смотрит на тебя, а затем снова бросает вопросительный взгляд на него: «Разумеется, уважаемый, если ты поручишься за него и принимаешь ответственность за сохранение всего услышанного в тайне». Она неохотно поворачивается к тебе: «У тебя вопросы?»~
@6471  = ~«Кажется, мой спутник хотел расспросить тебя о работе над этим устройством. Может быть, он будет говорить от лица нас обоих?»~
@6472  = ~Кел'лера кланяется.~
@6473  = ~«Она из Народа. Знаки на её теле говорят, что она ушла из Лимбо и была принуждена не *знать* наш родной дом. Знаки повелевают всем гитцерай оказывать ей помощь и показывают, что она до сих пор одна из Народа. Она относится ко мне так почтительно потому, что я один из *зертов*».~
@6474  = ~«Она не может говорить об этом в присутствии извергов. Из того, что она связана договором, можно сделать вывод, что это проект Закона. А из того, что она связана магически, можно сделать вывод, что он, похоже, связан с баатезу».~
@6475  = ~Кел'лера кивает.~
@6476  = ~«Она не может говорить об этом в присутствии извергов. Из того, что она связана договором, можно сделать вывод, что это проект Закона. А из того, что она связана магически, можно сделать вывод, что он, похоже, связан с баатезу».~
@6477  = ~«Понимаю».~
@6478  = ~«Что это за место?»~
@6479  = ~«У меня сообщение для Келдора от аукциониста Гильтспура».~
@6480  = ~«Да, уважаемый. Нам о тебе сообщили. Входи».~
@6481  = ~«Спасибо».~
@6482  = ~Минуту охранник смотрит на тебя с непонятным выражением. «Удачи тебе. Входи».~
@6483  = ~«Спасибо».~
@6484  = ~Этот ходячий труп уставился на тебя отсутствующим взглядом. На лбу у него вырезан номер «463», а губы сшиты. Лёгкий запах формальдегида исходит от его тела.~
@6485  = ~«Так… что-нибудь интересненькое происходит?»~
@6486  = ~Труп продолжает пялиться на тебя.~
@6487  = ~Труп не отвечает. Кажется, он витает слишком далеко, чтобы отвечать на твои вопросы.~
@6488  = ~«Так… что-нибудь интересненькое происходит?»~
@6489  = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@6490  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6491  = ~«Было приятно пообщаться. Прощай».~
@6492  = ~Оставить труп в покое.~
@6493  = ~Оставить труп в покое.~
@6494  = ~Оставить труп в покое.~
@6495  = ~У этого оживлённого трупа сшиты губы, а над бровью вырезан номер «310»; он распространяет вокруг себя сильный запах формальдегида. Когда ты преграждаешь ему путь, он обращает на тебя свои безжизненные глаза.~
@6496  = ~Труп продолжает пялиться на тебя.~
@6497  = ~Труп не отвечает. Кажется, он витает слишком далеко, чтобы отвечать на твои вопросы.~
@6498  = ~На мгновение тебя посещает мысль, что душа этого трупа слишком далеко, чтобы ответить… но вдруг ты замечаешь в его глазах глубочайшее страдание и отчаяние от того, что душа принуждена вернуться в свою старую оболочку.~
@6499  = ~«Так… что-нибудь интересненькое происходит?»~
@6500  = ~«Так… что-нибудь интересненькое происходит?»~
@6501  = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@6502  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6503  = ~«Приятно было пообщаться. Прощай».~
@6504  = ~Оставить труп в покое.~
@6505  = ~Оставить труп в покое.~
@6506  = ~«Я хотел спросить тебя…»~
@6507  = ~Глаза этого трупа близко посажены и чуть косят, один глаз смотрит вправо, а другой — влево. На изуродованном лбу ты с трудом различаешь номер «257». Похоже, по лбу несколько раз сильно ударили, из-за чего номер практически не прочитать.~
@6508  = ~В глазах трупа нет ни тени понимания; они смотрят всё так же: один вправо, другой влево.~
@6509  = ~Душа возвращается в тело с таким усилием, что вызывает страшные судороги, которые отбрасывает тело назад! В тот же миг труп снова вскакивает на ноги и начинает какую-то бешеную пляску, заламывая руки и извиваясь всеми частями тела. При этом полуотвалившиеся обрывки плоти болтаются туда-сюда, глаза вылезают из орбит и бешено вращаются в нескончаемом припадке безумного смеха…~
@6510  = ~«Ты, часом, не сошёл с ума, что так глаза вытаращил?»~
@6511  = ~«Ты, часом, не сошёл с ума, что так глаза вытаращил?»~
@6512  = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@6513  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6514  = ~«Приятно было пообщаться. Прощай».~
@6515  = ~Оставить труп в покое.~
@6516  = ~Оставить труп в покое.~
@6517  = ~«Э-э… я хочу спросить тебя, дух…»~
@6518  = ~На лбу этого ходячего трупа вырезан номер «1146». Губы его сшиты грубой чёрной нитью, а всё тело покрыто ужасными шрамами — оно даже хуже твоего, как будто его хозяин сгорел заживо. Носа, ушей и нескольких пальцев нет — наверное, сгорели давным-давно в пожаре. Когда ты преграждаешь ему путь, чтобы привлечь «внимание», он останавливается и смотрит на тебя отсутствующим взглядом.~
@6519  = ~Труп продолжает пялиться на тебя.~
@6520  = ~Когда дух возвращается в своё прежнее жилище, тебя захлёстывает запахами сернистых испарений, горелого волоса и опалённой крови. Почти сразу же труп валится на пол, бьётся в судорогах и жалобно стонет. Ты почти видишь тонкие струйки зловонного дыма, исходящие от его туловища и конечностей.~
@6521  = ~«Так… что-нибудь интересненькое происходит?»~
@6522  = ~«Так… что-нибудь интересненькое происходит?»~
@6523  = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@6524  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6525  = ~«Приятно было пообщаться. Прощай».~
@6526  = ~Оставить труп в покое.~
@6527  = ~Оставить труп в покое.~
@6528  = ~«Ты… в порядке?»~
@6529  = ~У этого ковыляющего трупа зашиты глаза, как впрочем и рот, а на брови вырезан номер «732». Нить, которой зашиты веки, выглядит неимоверно ветхой… ты теряешься в догадках, зашили ли глаза до или уже после смерти.~
@6530  = ~Труп продолжает пялиться на тебя.~
@6531  = ~Труп не отвечает. Кажется, он витает слишком далеко, чтобы отвечать на твои вопросы.~
@6532  = ~«Прости, что забрал у тебя ту книгу… она выглядела слишком уж интересной, чтобы пройти мимо».~
@6533  = ~«Прости, что забрал у тебя ту книгу… она выглядела слишком уж интересной, чтобы пройти мимо».~
@6534  = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@6535  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6536  = ~«Приятно было пообщаться. Прощай».~
@6537  = ~Оставить труп в покое.~
@6538  = ~Оставить труп в покое.~
@6539  = ~Оставить труп в покое.~
@6540  = ~На лбу у этого еле переставляющего ноги трупа глубоко вырезаны цифры «613», но между цифрами «1» и «3» отошло сантиметра три кожи. Приглядевшись, ты с трудом различаешь там вырезанную цифру «2».~
@6541  = ~Труп продолжает пялиться на тебя.~
@6542  = ~Труп не отвечает. Кажется, он витает слишком далеко, чтобы отвечать на твои вопросы.~
@6543  = ~«Так… что-нибудь интересненькое происходит?»~
@6544  = ~«Так… что-нибудь интересненькое происходит?»~
@6545  = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@6546  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6547  = ~«Приятно было пообщаться. Прощай».~
@6548  = ~Оставить труп в покое.~
@6549  = ~Оставить труп в покое.~
@6550  = ~Оставить труп в покое.~
@6551  = ~Татуировка смерти Гросука~
@6552  = ~Страж Магуса~
@6553  = ~Книга Финама~
@6554  = ~Ужасные оковы~
@6555  = ~~
@6556  = ~~
@6557  = ~~
@6558  = ~~
@6559  = ~~
@6560  = ~~
@6561  = ~~
@6562  = ~На лбу этого ходячего трупа вырезан номер «1094». Его рот крепко зашит, резкий химический запах свежего формальдегида завис в воздухе вокруг него. Несмотря на бледность, впалые черты лица и безжизненные молочно-белые глаза, ясно видно, что когда-то это был весьма симпатичный молодой мужчина.~
@6563  = ~Труп продолжает пялиться на тебя.~
@6564  = ~Труп на миг вздрагивает, затем затихает — дух снова возвращается в покинутую телесную оболочку. Спустя несколько секунд в глазах зомби появляются проблески жизни, и труп удивлённо оглядывается по сторонам. Всё тело окружает едва заметная золотая аура.~
@6565  = ~«Итак… видел тут что-нибудь интересненькое?»~
@6566  = ~«Итак… видел тут что-нибудь интересненькое?»~
@6567  = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@6568  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6569  = ~«Приятно было пообщаться. Прощай».~
@6570  = ~Оставить труп в покое.~
@6571  = ~Оставить труп в покое.~
@6572  = ~«Я хотел спросить тебя…»~
@6573  = ~Этот оживлённый труп мужчины носит на лбу вырезанный номер «1041». Его кожа высохла и натянулась, но, похоже, при жизни он имел весьма выдающуюся внешность. Губы зомби крепко зашиты, скорее всего, чтобы не стонал всё время. От него сильно пахнет формалином.~
@6574  = ~Труп продолжает пялиться на тебя.~
@6575  = ~В момент, когда дух возвращается в прежнее обиталище, тело слегка пошатывается. Миндалевидные глаза становятся ещё темнее, слабый бронзовый оттенок проступает поверх бледной плоти. Мужчина выпрямляется, выбивая тучу пыли из тряпья, служащего одеждой.

Заметив наконец вызвавшего, призрак мгновение смотрит на тебя странным взглядом, затем слегка кивает.~
@6576  = ~«Так… что-нибудь интересненькое происходит?»~
@6577  = ~«Так… что-нибудь интересненькое происходит?»~
@6578  = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@6579  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6580  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6581  = ~«Приятно было пообщаться. Прощай».~
@6582  = ~Оставить труп в покое.~
@6583  = ~Кивнуть в ответ.~
@6584  = ~Слегка деформированная голова этого трупа скреплена узкими металлическими лентами, привинченными болтами прямо к черепу. На ржавой железной пластинке над его левым глазом вытравлен номер «475». Теми же болтами плотно завинчен его рот, от трупа разит бальзамирующей жидкостью.~
@6585  = ~Труп продолжает пялиться на тебя.~
@6586  = ~Труп не отвечает. Кажется, он витает слишком далеко, чтобы отвечать на твои вопросы.~
@6587  = ~«Так… что-нибудь интересненькое происходит?»~
@6588  = ~«Так… что-нибудь интересненькое происходит?»~
@6589  = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@6590  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6591  = ~«Приятно было пообщаться. Прощай».~
@6592  = ~Оставить труп в покое.~
@6593  = ~Оставить труп в покое.~
@6594  = ~Оставить труп в покое.~
@6595  = ~Скелет поворачивается к тебе. На лбу у него высечен номер «42», а ряд его костей — в основном челюсти и суставы — связаны кожаными ремешками. На тело наброшен чёрный халат.~
@6596  = ~При звуке твоего голоса скелет вдруг выпрямляется. Он скрещивает руки на груди, а пальцами хватается за рёбра.~
@6597  = ~Этот скелет не отвечает. Кажется, он слишком далеко отсюда, чтобы отвечать на твои вопросы.~
@6598  = ~Поразительно, как этот набор костей до сих пор не рассыпался. Пожелтевшие кости замазаны гипсом и несколькими слоями вонючего клея… при ближайшем рассмотрении оказывается, что они покрыты сотнями тонюсеньких трещин. Хотя кто-то озаботился скрепить этот скелет кожаными ремешками и болтами, ремешки износились, а болты выглядят так, словно вот-вот выпадут.~
@6599  = ~В ответ скелет резко опускает руки в стороны. Кожаные ремни, укрепляющие его торс, лопаются, и грудная клетка распахивается, как двустворчатые дверки.~
@6600  = ~К твоему удивлению, рука исчезает, войдя внутрь грудной клетки… странное чувство, будто она где-то в *другом* месте. Внутри рука натыкается на невидимый предмет. Он размером с кулак и, судя по всему, прикреплён к позвоночнику скелета.~
@6601  = ~Болты легко выходят из суставов скелета. Он рассыпается, некоторые кости ещё подёргиваются.~
@6602  = ~Как только ты вынимаешь предмет, скелет внезапно разрушается, железные болты со стуком падают на пол. Чем бы ни была эта вещь, похоже, только она и удерживала кости вместе.~
@6603  = ~Похоже на обыкновенный кусок железа. Ты едва ли можешь предположить, зачем кому-то понадобилось прятать его в грудной клетке скелета.~
@6604  = ~В ответ скелет резко опускает руки в стороны. Кожаные ремни, укрепляющие его торс, лопаются, и грудная клетка распахивается, как двустворчатые дверки. Ты вдруг чувствуешь непонятное побуждение засунуть руку внутрь грудной клетки.~
@6605  = ~Руки скелета опускаются.~
@6606  = ~Похоже на обыкновенный кусок железа. Наверно, в предыдущей инкарнации у тебя были веские причины запрятать его сюда.~
@6607  = ~Скелет снова скрещивает руки на груди.~
@6608  = ~Скелет снова скрещивает руки на груди.~
@6609  = ~«Эй, шеф. Это же вандализм. Возможно, те болты — единственное, что скрепляет этот мешок костей. Так вот действуют силы некромантии, знаешь ли».~
@6610  = ~«Хм-м-м. Интересно, будет ли против этот серобородый, если *я* позаимствую его тело…»~
@6611  = ~«Может, прекратишь? Его руки вот-вот отломаются».~
@6612  = ~«*Думаю*, это тот самый труп, о котором я тогда вспомнил…»~
@6613  = ~«Извини, ты не видел здесь других скелетов?»~
@6614  = ~«Никак не пойму, зачем тебе халат? Скрывать-то под ним вроде уже нечего».~
@6615  = ~«Никак не пойму, зачем тебе халат? Скрывать-то под ним вроде уже нечего».~
@6616  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@6617  = ~Внимательно осмотреть скелет.~
@6618  = ~Попробовать вытащить болты из скелета.~
@6619  = ~Попробовать вытащить болты из скелета.~
@6620  = ~Попробовать вытащить болты из скелета.~
@6621  = ~«Как насчёт этого скелета, Морте? Сгодится в качестве тела?»~
@6622  = ~Оставить скелет в покое.~
@6623  = ~Оставить скелет в покое.~
@6624  = ~Оставить скелет в покое.~
@6625  = ~Скрестить свои руки на груди.~
@6626  = ~Повторить телодвижение… и посмотреть, что будет.~
@6627  = ~«Э-э…»~
@6628  = ~Оставить скелет в покое.~
@6629  = ~Оставить скелет в покое.~
@6630  = ~Оставить скелет в покое.~
@6631  = ~Оставить скелет в покое.~
@6632  = ~Попробовать вытащить болты из скелета.~
@6633  = ~Попробовать вытащить болты из скелета.~
@6634  = ~«Не против, если я позаимствую эти ремни и болты?»~
@6635  = ~Оставить скелет в покое.~
@6636  = ~Оставить скелет в покое.~
@6637  = ~Оставить скелет в покое.~
@6638  = ~Запустить руку в грудную клетку и пошарить там.~
@6639  = ~Оставить скелет в покое.~
@6640  = ~Вынуть предмет.~
@6641  = ~Оставить скелет в покое.~
@6642  = ~«Извини, Костяшка…»~
@6643  = ~Осмотреть предмет.~
@6644  = ~Осмотреть предмет.~
@6645  = ~Осмотреть кусок железа.~
@6646  = ~Запустить руку в грудную клетку и пошарить там.~
@6647  = ~Оставить скелет в покое.~
@6648  = ~«Хм… привет?»~
@6649  = ~«Хм… привет?»~
@6650  = ~Внимательно осмотреть скелет.~
@6651  = ~Оставить скелет в покое.~
@6652  = ~Внимательно осмотреть кусок железа.~
@6653  = ~Скрестить свои руки на груди.~
@6654  = ~Повторить телодвижение… и посмотреть, что будет.~
@6655  = ~«Э-э…»~
@6656  = ~Оставить скелет в покое.~
@6657  = ~Старик смотрит на тебя без страха и произносит: «Так ты один из тех, из-за кого вся эта суматоха, а? Тогда мотай отсюда. Мне нечего тебе сказать».~
@6658  = ~«И чего?»~
@6659  = ~«Ох… я не хотел причинять необратимые повреждения».~
@6660  = ~«Ладно, неважно. Может, в другой раз».~
@6661  = ~«„Седобородый“?»~
@6662  = ~«Я не думаю, что он будет возражать».~
@6663  = ~«Что-то мне подсказывает, что ты был бы в два раза надоедливее, будь у тебя руки. Пошли».~
@6664  = ~Скрестить свои руки на груди.~
@6665  = ~Повторить телодвижение скелета… и посмотреть, что будет.~
@6666  = ~«Э-э…»~
@6667  = ~Оставить скелет в покое.~
@6668  = ~Уйти.~
@6669  = ~Старик моргает пару раз и произносит: «Тут я тебе не помогу. Придётся тебе пройти отсюда со стражей». Он опять обращает всё своё внимание на устройство, которое держит в руках.~
@6670  = ~Уйти.~
@6671  = ~«И ты вправду думаешь, что я буду помогать тебе после того, как ты мне угрожал? Тогда ты ещё тупее, чем я думал, совсем кожеголовый. Я жду извинений. Прямо сейчас».~
@6672  = ~«Шёл бы ты в Девять кругов Ада, старик».~
@6673  = ~Ложь: «Прости, не сдержался. Это больше не повторится».~
@6674  = ~«Прости, не сдержался. Это больше не повторится».~
@6675  = ~«Нет. Прощай».~
@6676  = ~«Механизмы совсем разладились, друг. А поскольку эта говнюха Бедай-Лин мертва, я думаю, что должен дать тебе совет о том, как их починить. Итак, надо сделать вот что…» — и он вываливает такую прорву информации, что ты сомневаешься, уловил ли всё.~
@6677  = ~«Пожалуй, я понял. Короче говоря, надо просто снять главную шестерню, очистить её, заострить затупившиеся зубья, смазать и установить на место?»~
@6678  = ~«Пожалуй, я понял… что там была за деталь главного блока мотивации …нет, постой. Я не всё понял».~
@6679  = ~«Конечно. Теперь я могу продолжать работу, или ты и дальше будешь приставать ко мне с вопросами?»~
@6680  = ~«Ну, я и вправду хотел задать тебе ещё пару вопросов».~
@6681  = ~«Нет, это всё. Прощай».~
@6682  = ~«Ясно, что ты не сможешь починить эту штуку. Пожалуй, мне следует сделать это самому». Он ворчит себе что-то под нос и встаёт со словами: «Из-за некоторых пней нам, седобородым, так трудно приходится».~
@6683  = ~«Перед тем, как ты уйдёшь, я хотел задать ещё пару вопросов».~
@6684  = ~«Ну да, у некоторых из нас есть и другие умения. Пень».~
@6685  = ~«В любое время, когда ты будешь готов получить ключ снов, израненный, скажи только слово, и я тебе его дам».~
@6686  = ~«Дай мне ключ».~
@6687  = ~«Нет. Не сейчас. У меня ещё вопросы».~
@6688  = ~«Забудь».~
@6689  = ~Он замолкает, как бы прислушиваясь к своим блуждающим мыслям. «Закрой глаза и протяни руку, — говорит он. — Ты должен почувствовать этот ключ до того, как увидишь его, иначе он не сработает».~
@6690  = ~Сделать, как он сказал.~
@6691  = ~Подсмотреть.~
@6692  = ~Ты чувствуешь, как что-то касается твоей мозолистой ладони. Сначала это нечто почти неосязаемо, но в считанные мгновения оно набирает вес, и наконец ты слышишь голос Зандера: «Открой глаза». Открыв глаза, ты видишь в своей ладони простое чёрное перо. «Моя работа закончена, — Зандер кивает. — Этот ключ надо использовать на самой левой двери Кузницы, и Построитель Снов откроется тебе. А теперь мне пора… возвращаться к работе».~
@6693  = ~«Пёрышко? Столько трудов ради какого-то пёрышка?»~
@6694  = ~~
@6695  = ~«Благодарю тебя, Зандер. Прощай».~
@6696  = ~Сквозь щёлочку в глазах ты видишь, как Зандер на секунду сосредотачивается, затем протягивает руку и держит над твоей. Ничего не произходит. Зандер открывает глаза, смотрит на твою пустую руку и взрывается: «Я сказал закрыть глаза, пень! Это тебе не игрушки! Буду я ещё тратить время на твою тупость! Уж не думаешь ли ты, что мне нужно твоё сомнение в моей работе?! Закрой глаза, пень, и не открывай, иначе ничего не получишь!»~
@6697  = ~«Дай мне ключ, старик. Сейчас же».~
@6698  = ~Сделать, как он сказал.~
@6699  = ~«Забудь. У меня есть дела получше, чем выслушивать весь этот бред сивой кобылы». Уйти.~
@6700  = ~«Это последний страж Построителя Снов, дубина. Я ж не мог позволить всем подряд гулять там как по бульвару? Я покамест из ума не выжил. Тебе нужно что-нибудь ещё, или я могу вернуться к работе?»~
@6701  = ~~
@6702  = ~«Возвращайся к работе».~
@6703  = ~«Возвращайся к работе, и спасибо тебе».~
@6704  = ~Он наливается краской, кажется, готовый вот-вот перейти на многоэтажную брань. Затем переводит дыхание и говорит со сдерживаемой яростью: «Пень, ключ подчиняется вере. Либо ты мне веришь и закрываешь глаза, либо нет — и тогда вовеки не найдёшь свои сны. Твой выбор, дружок».~
@6705  = ~Сделать, как он сказал.~
@6706  = ~«Забудь. У меня есть дела получше, чем выслушивать весь этот бред сивой кобылы».~
@6707  = ~«Мне нужна от тебя ещё одна вещь, и мы сможем наконец приступить к запуску Построителя Снов. Мне нужна подушка, которая побывала в гробу. Она усыпит тебя так глубоко, как если бы ты умер. Это откроет твой разум для излучения Построителя Снов. Я бы сказал, она как источник вдохновения».~
@6708  = ~«Подушка из гроба, да? Ты её получишь. Но сначала я ещё кое о чём спрошу».~
@6709  = ~«Сильно сомневаюсь, хочу ли я продолжать таскать тебе всякое барахло».~
@6710  = ~«Я принёс тебе подушку. Когда начнём?»~
@6711  = ~«Я принесу её».~
@6712  = ~«Не хочешь? Тогда включи-ка мозги и подумай вот о чём: ты таскаешь всё это барахло для СВОЕЙ задумки, для проекта, который в первую очередь ТЫ САМ хотел реализовать, для создания устройства столь неосуществимого, что его разрабатывали три поколения моих предков и я сам, и всё для ТЕБЯ. Если хочешь, чтобы этот проект заработал, ты должен завершить последние этапы и перестать ныть».~
@6713  = ~«Старик, сбавь обороты, или эти слова будут для тебя последними».~
@6714  = ~«Ладно-ладно. Я это сделаю. Только не ворчи».~
@6715  = ~«Значит, ты готов выбросить на помойку всё время и усилия? Готов потерять свои сны только потому, что тебя обозвали тупым? Правильно, ты кожеголовый, если вообразил, что можешь завершить этот проект без меня. И ещё тупее, если считаешь, что за дерзость надо убивать. Ты и вправду думаешь, что можно решить все проблемы угрозами? На планах такое не работает, мой меченый приятель».~
@6716  = ~«Я бы убил и за меньшее».~
@6717  = ~«Пойду-ка я отсюда. Пока не сделал того, о чём потом мы оба пожалеем».~
@6718  = ~«Уматывай, козёл. Ты никогда не вернёшь свои сны. С твоим замечательным Построителем Снов покончено».~
@6719  = ~Уйти.~
@6720  = ~«Я и не сомневался, придурок. Всё, твоя тупая игра мускулами стала последней каплей. И ты, и твой Построитель Снов могут катиться колбаской прямо в Бездну», — кажется, он готов позвать стражу.~
@6721  = ~Сломать ему шею, пока он не открыл рот.~
@6722  = ~Сломать ему шею, пока он не открыл рот.~
@6723  = ~Бежать.~
@6724  = ~В мгновение ока твои руки смыкаются на тощей шее старого инженера. Ты ломаешь её как прутик, и он с выпученными глазами корчится в агонии у твоих ног. Ты показал ему, это уж точно. К сожалению, показал ты и всем остальным в зале. Раздаются звуки тревоги.~
@6725  = ~«Ну и ладно».~
@6726  = ~Он ловко уворачивается и зовёт стражу.~
@6727  = ~«Чтоб тебя!»~
@6728  = ~«Машине нужна изящная клетка для птиц, украшенная лезвиями, для имитации разрушительной силы снов и их способности покорять наши сердца и воображение. Поищи клетку в Осадной Башне, я её там заказывал».~
@6729  = ~«Как мне туда попасть?»~
@6730  = ~Ты задаёшь дабусу несколько вопросов, пытаясь разобраться в ребусах, появляющихся над его головой. Он проявляет исключительное терпение во время этой «дискуссии», отвечая лёгкими для перевода предложениями. Через несколько минут ты начинаешь осваиваться… и понимаешь, что уже делал это раньше.~
@6731  = ~Ты задаёшь дабусу несколько вопросов, пытаясь разобраться в ребусах, появляющихся над его головой. Хотя во время всей «дискуссии» он проявляет исключительное терпение, у тебя ничего не получается. В конце концов дабус перестаёт играть символами и просто ждёт.~
@6732  = ~Дабус отвешивает лёгкий поклон. Символы вьются над его головой, затем он отворачивается.~
@6733  = ~Над головой дабуса появляется ряд символов. Затем он кланяется и отворачивается.~
@6734  = ~Дабус ждёт.~
@6735  = ~Дабус чуть склоняет голову, и над ней появляется целый поток символов. Как ты понимаешь, он говорит, что он дабус.~
@6736  = ~Над головой дабуса появляется группа символов. Как ты понимаешь, он говорит, что выполняет свой долг… или свои обязанности.~
@6737  = ~Дабус чуть склоняет голову, и над ней появляется целый поток символов. (Я дабус.)~
@6738  = ~Над головой дабуса появляется группа символов. (Я выполняю свои обязанности.)~
@6739  = ~Дабус чуть склоняет голову, и над ней появляется целый поток символов.~
@6740  = ~Над головой дабуса появляется группа символов.~
@6741  = ~Дабус чуть склоняет голову, и над ней появляется целый поток символов. Как ты понимаешь, он говорит, что он дабус.~
@6742  = ~Над головой дабуса появляется группа символов. Как ты понимаешь, он говорит, что выполняет свой долг… или свои обязанности.~
@6743  = ~Дабус чуть склоняет голову, и над ней появляется целый поток символов. (Я дабус.)~
@6744  = ~Над головой дабуса появляется группа символов: (Я выполняю свои обязанности.)~
@6745  = ~Над головой дабуса появляется одинокий символ. Это металлическая женская маска, из сторон которой торчат клинки. Один только взгляд на этот символ вызывает у тебя тревогу.~
@6746  = ~Над головой дабуса появляется одинокий символ. Это белый овал, перечёркнутый чёрной молнией. Дабус удерживает этот символ в воздухе несколько секунд, затем отворачивается и больше не реагирует.~
@6747  = ~Ты видишь дабуса. Он одет в длинные ниспадающие одежды и невысоко парит над землёй.~
@6748  = ~Существо поворачивается к тебе, и вокруг его головы появляется ряд символов. Символы слабо светятся и просто… парят в воздухе.~
@6749  = ~«Не знаю, хочу ли я бегать за этим барахлом».~
@6750  = ~«У меня она с собой. Теперь верни мне мои сны».~
@6751  = ~«Ты уже доказал, что находчив. Найди способ».~
@6752  = ~«Хорошо. Тогда ответь мне на другой вопрос».~
@6753  = ~«Хорошо. Мы ещё встретимся».~
@6754  = ~«Для начала финального этапа работы с Построителем Снов мне нужен кусок твоей кожи, погружённый в твою кровь, чтобы машина могла ознакомиться с твоей физической сущностью. Всё это должно быть в сине-зелёном флаконе, что символизирует океан снов, в котором ты будешь плыть».~
@6755  = ~«У меня всё с собой. Держи. Покажи мне мои сны».~
@6756  = ~«Не знаю, хочу ли я бегать за этим барахлом».~
@6757  = ~«Плоть и кровь, хм? Я за последнее время достаточно отдал и того, и другого. Сначала я кое о чём тебя спрошу».~
@6758  = ~«Просто ответь на пару вопросов, это ведь не трудно? Мне нет дела до твоего Построителя Снов».~
@6759  = ~«Плоть, кровь, бутылка. Прекрасно. Я вернусь».~
@6760  = ~Зандер выглядит так, будто ты его прилюдно выпорол. «Нет до него дела? Но… четыре поколения моих предков… мой прадед говорил, что ты был так озабочен… у него был этот свиток…»~
@6761  = ~«Твой прадед? Вот как? Расскажи, что ты обо мне знаешь».~
@6762  = ~«Нет. Меня это не интересует. Просто ответь на пару вопросов».~
@6763  = ~«Ты пришёл к моему прадеду Ксеро и сказал ему, что не видишь снов. Сказал, что хочешь снова обрести способность видеть сны. Ты предложил чудовищную кучу денег за то, чтобы он создал машину, которая вернула бы тебе утерянную способность видеть сны. Сказал, что вернёшься через несколько лет, но так и не вернулся».

Ты чувствуешь наплыв воспоминаний.~
@6764  = ~Подавить воспоминания.~
@6765  = ~Открыться воспоминаниям.~
@6766  = ~Открыться воспоминаниям.~
@6767  = ~Усилием воли ты не даёшь воспоминаниям заполнить голову.

«После смерти Ксеро работа над машиной была продолжена. Моя бабка Ньюла с помощью своих познаний в эзотерике разработала, на основе растений и мозаичных камней, механизм генерации магических схем, которые должны были призывать фрагменты снов с Астрального и Эфирного планов. Мой дядя продвинулся ещё на шаг, он пользовался помощью с Нижних и Верхних планов. Что же касается меня… я разработал ритуалы для высвобождения этого потенциала… и теперь ты можешь получить свои сны обратно».~
@6768  = ~«Хорошо. Ты меня убедил. Так что мне нужно для того, чтобы вернуть свои сны?»~
@6769  = ~«Сейчас мне это не нужно. Просто ответь на пару вопросов».~
@6770  = ~«Интересно. Пожалуй, я поговорю с тобой об этом позже. Прощай».~
@6771  = ~«Она заправляет в этом городе. Ты узнаешь её, если увидишь: вокруг её лица эти клинки, она ростом примерно с великана и парит над землёй, вот как эти ребятки, — Морте кивает на дабуса, который смотрит на вас обоих. — Никто толком о ней не знает… она же много не говорит. Всё, что тебе нужно знать, — не зли её. Если ты её увидишь, мой тебе совет: драпай».~
@6772  = ~Воспоминание о молодом изобретателе Ксено Зандере заглушает слова его потомка, и ты вспоминаешь дерзкого молодого мага, показывающего заклинание собственного изобретения. «Я назвал его „Умиротворение“», — говорит он. Вы вдвоём созерцаете частицы магии. нежно обволакивающие тебя, и на тебя нисходит покой. «Действенно, — говоришь ты. — Давай надеяться, что ты будешь так же успешен с этим Построителем Снов».

Нил Зандер прерывает свой рассказ: «Ты меня вообще слушаешь?»~
@6773  = ~«Что? Ну да, конечно. Ты не мог бы повторить?»~
@6774  = ~«Нет, не слушаю. Прощай».~
@6775  = ~Он выглядит раздражённым, но сдерживается и повторяет: «После смерти Ксеро работа над машиной была продолжена. Моя бабка Ньюла с помощью своих познаний в эзотерике разработала, на основе растений и мозаичных камней, механизм генерации магических схем, которые должны были призывать фрагменты снов с Астрального и Эфирного планов. Мой дядя продвинулся ещё на шаг, он пользовался помощью с Нижних и Верхних планов. Что же касается меня… я разработал ритуалы для высвобождения этого потенциала… и теперь ты можешь получить свои сны обратно».~
@6776  = ~«Хорошо. Ты меня убедил. Так что мне нужно для того, чтобы вернуть свои сны?»~
@6777  = ~«Сейчас мне это не нужно. Просто ответь на пару вопросов».~
@6778  = ~«Интересно. Пожалуй, я поговорю с тобой об этом позже. Прощай».~
@6779  = ~На его и без того морщинистом лбу появляются новые складки, он весь внимание: «Что ты хотел бы узнать?»~
@6780  = ~«Ты упоминал Построитель Снов. Расскажи о нём подробнее».~
@6781  = ~«Расскажи мне, что ты знаешь об убийстве кузнеца».~
@6782  = ~«Меня попросили починить эти механизмы в Кузнице. Не расскажешь мне, как это сделать?»~
@6783  = ~Когда он дотягивается до монет, ты пытаешься захватить его руку. Охранник отдёргивает руку обратно за ворота и рычит: «Ты дважды заплатишь за это, подонок! Прочь с глаз моих!» Он поворачивается спиной.~
@6784  = ~Морте усмехается: «Да я скорее повешусь на кишках танар'ри, чем разгадаю, что эти летающие козлиные головы пытаются втолковать. Тебе нужен переводчик? Найди коренного сигильца».~
@6785  = ~«Кто ты?»~
@6786  = ~«О, у них *есть* имена. Я уверен».~
@6787  = ~«Что ты можешь рассказать о Боготах?»~
@6788  = ~«Расскажи мне о своих товарищах по работе».~
@6789  = ~«Что ты здесь делаешь?»~
@6790  = ~«Это *ты* так говоришь, изверг».~
@6791  = ~«Это одновременно и машина, и ритуал. Она и состояние разума, и конструкция из пара и крови. Она дарит сны тому, кто внутрь неё входит. Она была создана для тебя, и она ждёт тебя. Ты готов завершить работу над ней? Она ждёт тебя уже несколько десятков лет».~
@6792  = ~«Откуда ты знаешь, что она создана для меня?»~
@6793  = ~«Да».~
@6794  = ~Морте усмехается. «Да я скорее повешусь на кишках танар'ри, чем разгадаю, что эти летающие козлиные головы пытаются втолковать. Тебе нужен переводчик? Пускай эта девка-изверг переводит, — он кивает на Анну. — Она же местная, из Улья».~
@6795  = ~«Нет. Может быть, я ещё вернусь к ней. У меня другие вопросы».~
@6796  = ~«Нет. Прощай».~
@6797  = ~Морте усмехается. «Да я скорее повешусь на кишках танар'ри, чем разгадаю, что эти летающие козлиные головы пытаются втолковать. Тебе нужен переводчик? — он кивает в сторону Дак'кона. — Вот этот святее-тебя-и-вдвойне-молчаливее вполне справится».~
@6798  = ~«Мой прадед, Ксено Зандер, вырубил твоё лицо на камне, чтобы мы узнали тебя, когда ты придёшь за заказом. Его не покидала уверенность, что ты вернёшься, но никто больше в это по-настоящему не верил. Наша семья закончила работу потому, что мы обещали… и вот ты пришёл».~
@6799  = ~«Этот камень сохранился?»~
@6800  = ~Морте усмехается. «Да я скорее повешусь на кишках танар'ри, чем разгадаю, что эти летающие козлиные головы пытаются втолковать. Тебе нужен переводчик? Ну так танар'ри подойдёт, — он кивает в сторону Падшей Грейс. — Она наверняка спелась с этими парнями».~
@6801  = ~«Значит, у меня были причины. Давай закончим работу».~
@6802  = ~«Мне нет до этого дела. Я хочу спросить о другом».~
@6803  = ~«Нет. Примерно год назад мой дом обокрали. Я заметил только убегающую тень. Причём унесли только этот камень. Ума не приложу, кому он понадобился, но черты лица я накрепко запомнил».~
@6804  = ~«Хорошо. Давай закончим с Построителем Снов».~
@6805  = ~«Сейчас мне не до того. Я хотел спросить тебя о другом».~
@6806  = ~«Мне нет дела до Построителя Снов. Может, потом. Прощай».~
@6807  = ~«Э-э… — Анна странно смотрит на тебя. — Это ж дабус, ты чё?»~
@6808  = ~«Поговори с Бедай-Лин. Она должна знать. Мелкие детали этого места — её забота. Она не настоящий выдумщик, не проектировщик. Всего лишь присматривает за тем, что приводит тут всё в движение».~
@6809  = ~«Хорошо, я так и сделаю. У меня ещё вопросы».~
@6810  = ~«Хорошо, прямо сейчас и поговорю».~
@6811  = ~Анна понижает голос до шёпота: «Дабус — один из *Её* родичей: они заботятся о городе, чинят его, сносят всё и снова отстраивают. Они базарят символами-головоломками в воздухе — надо сложить части вместе, чтоб понять, о чём речь». Она выглядит раздражённой: «Одна головная боль от них, вот чё».~
@6812  = ~«Я ничего не знаю. Я работал над своим проектом и ни на что больше внимания не обращал. И не смотрел, что делают рабочие. Они делают свою работу, а я — свою».~
@6813  = ~«Госпожи Боли, — Анна чертит в воздухе перед собой полукруг. — Они её слуги, а она их защищает. Не приставай к ним, а то привлечёшь её взгляд».~
@6814  = ~«Ш-ш-ш-ш! — Анна проводит пальцем у горла. — Не греми о ней костями. У неё уши *повсюду*, так что не упоминай её имя всуе, ага?»~
@6815  = ~Она отвечает не сразу: «Ага… могу».~
@6816  = ~«Ясно. Тогда вот ещё какой вопрос…»~
@6817  = ~«Ясно. Прощай».~
@6818  = ~Анна качает головой: «Не, я не собираюсь потом из-за этого бродить в тени Госпожи, ну уж нет! Давай не будем терять время, ага? Так мы ничо не добьёмся, только взгляд Госпожи привлечём из-за лишнего трёпа с её роднёй».~
@6819  = ~«Я Нил Зандер, правнук изобретателя Ксено Зандера, инженер, проектировщик, конструктор. И я закончил его работу, работу, которую ты ему заказал, — Построитель Снов! Готов проверить его работу на себе?»~
@6820  = ~«Построитель Снов? Что это такое?»~
@6821  = ~«Нет. Я хочу спросить тебя ещё кое о чём».~
@6822  = ~Анна кивает. Дабус продолжает глазеть на вас обоих, руки его спрятаны в рукавах.~
@6823  = ~«Нет. Я хочу спросить тебя ещё кое о чём».~
@6824  = ~«Нет».~
@6825  = ~«Он сказал только, что он из дабусов, — она пожимает плечами. — У них нет имён».~
@6826  = ~«Он сказал только, что он из дабусов, — она пожимает плечами. — У них нет имён».~
@6827  = ~«Тьфу. У них нет настоящего огня. Они говорят о творчестве, бахвалятся своими талантами, но никогда не придумают ничего нетривиального. Их воображение бедно, ограничено, погрязло в мелких деталях. Настоящий выдумщик, как я считаю, идёт от общего к частному: сначала прорабатывает общую схему, а затем занимается мелочами. Идти от частного — удел муравьёв… маленьких насекомых, которые думают только о жратве».~
@6828  = ~«Ну, этот пока не назвался, а, череп?!»~
@6829  = ~«Очень снисходительно с твоей стороны. Я хотел бы задать тебе другой вопрос, если ты не против».~
@6830  = ~«Ясно. На этом глубоком наблюдении позволь откланяться. Прощай».~
@6831  = ~Он вздыхает и собирается с мыслями. «Это долгий разговор. Начнём сначала. Итак, все существа чего-то хотят, правда? Они творят, строят, разрушают, мечтают, сражаются, любятся… и всё это они делают, ведомые желанием чего-то большего. Даже на самом примитивном уровне развития каждая букашка желает лучшей доли. Некоторым это удаётся, некоторые гибнут в борьбе».~
@6832  = ~«Продолжай».~
@6833  = ~«Забудь. Я лучше спрошу тебя о другом».~
@6834  = ~«С другой стороны, забудь. Прощай».~
@6835  = ~Она пожимает плечами: «Он говорит, что выполняет свою работу. Ну ты знаешь — они заботятся о городе и всё такое».~
@6836  = ~«Управляющий Келдор вон там, на возвышении. Поговори с ним. Или найди этого самоубийцу Сандоза и поговори с ним. Теперь ты от меня отстанешь?»~
@6837  = ~«Ещё нет».~
@6838  = ~«Да. Прощай».~
@6839  = ~Ты видишь мужчину с буйной шевелюрой, одетого по последнему писку моды — вот только последний писк эта мода испустила полсотни лет назад. Кажется, будто его одежда состоит из отобранных у уличных безпризорников драных тряпок, а он словно бы хочет таким образом подчеркнуть своё пренебрежительное к ней отношение — а может, так оно и есть. Он не удостаивает тебя даже взглядом, пока ты к нему не обращаешься, а после его глаза внимательно изучают твоё лицо: «Тебе чё-нить надо?»~
@6840  = ~Анна качает головой: «Не, я не собираюсь потом бродить в тени Госпожи, ну уж нет. Так мы только взгляд Госпожи привлечём из-за лишнего трёпа с её родней».~
@6841  = ~«Расскажи мне, что ты знаешь об убийстве кузнеца».~
@6842  = ~«Меня попросили починить эти механизмы в Кузнице. Не расскажешь мне, как это сделать?»~
@6843  = ~«Меня попросили починить эти механизмы в Кузнице. Не расскажешь мне, как это сделать?»~
@6844  = ~«Тогда прощай…»~
@6845  = ~Анна качает головой: «Не, не буду».~
@6846  = ~«Кто ты?»~
@6847  = ~«Что ты можешь рассказать о Боготах?»~
@6848  = ~Анна скрещивает руки, её хвост начинает раскачиваться взад и вперёд.~
@6849  = ~«Расскажи мне о своих товарищах по работе».~
@6850  = ~«Что ты здесь делаешь?»~
@6851  = ~«Не, я не буду спрашивать старую родню Фелла о нём, не хочу. Он плохая кровь, и никому такие вопросы добра не принесут».~
@6852  = ~Он взрывается: «Я могу помочь ей только тем, что оставлю её в покое! Бессмертие — едва ли не самое страшное проклятие из того, что только может выдумать человек: каждый пень думает, что он этого хочет, и никто не представляет, что это вообще такое. Это дурацкий подарок, и только дурак его примет!» Чуть более спокойным тоном: «А кроме того, я до сих пор не нашёл способа управиться с моими машинами».~
@6853  = ~«Ясно. Тогда ответь мне на другой вопрос».~
@6854  = ~«Ясно. Всё равно спасибо за помощь. Прощай».~
@6855  = ~Дак'кон кивает.~
@6856  = ~«Он говорит, что он дабус».~
@6857  = ~«Он говорит, что выполняет свои обязанности».~
@6858  = ~Падшая Грейс кивает: «Да, конечно».~
@6859  = ~«Он говорит, что он „дабус“, — Грейс делает паузу. — Редко встретишь дабуса, у которого вообще было бы имя… по крайней мере то, что мы могли бы назвать именем. Кажется, они более склонны использовать символы».~
@6860  = ~«Он говорит, что выполняет свои обязанности, — она поворачивается к тебе. — Большую часть времени они чинят и разбирают участки города. Они местные смотрители во многих отношениях».~
@6861  = ~«Пожалуй, на определённый ответ вряд ли стоит рассчитывать».~
@6862  = ~Грейс хмурится: «Не думаю, что было бы мудро о нём спрашивать. Можно обидеть дабуса, так как Фелл больше не входит в их сообщество…»~
@6863  = ~Оставить существо в покое.~
@6864  = ~Попытаться вступить в разговор и посмотреть, сможешь ли ты разобрать, о чём говорит дабус.~
@6865  = ~«У меня всё с собой. Теперь верни мне мои сны».~
@6866  = ~«Клетка. Как прозаично. Ладно, клетка так клетка. Но сперва ответь мне на вопрос».~
@6867  = ~Попытаться вступить в разговор и посмотреть, сможешь ли ты разобрать, о чём говорит дабус.~
@6868  = ~«Клетка с лезвиями. Я вернусь».~
@6869  = ~Попытаться заговорить с дабусом и посмотреть, сможешь ли ты понять его.~
@6870  = ~«У меня к тебе вопросы…»~
@6871  = ~«Морте, можешь перевести мне, что он говорит?»~
@6872  = ~«Морте, можешь перевести мне, что он говорит?»~
@6873  = ~«Морте, можешь перевести мне, что он говорит?»~
@6874  = ~«Морте, можешь перевести мне, что он говорит?»~
@6875  = ~«Анна, можешь перевести мне, что он говорит?»~
@6876  = ~«Дак'кон, можешь перевести мне, что он говорит?»~
@6877  = ~«Падшая Грейс, можешь перевести мне, что он говорит?»~
@6878  = ~«Прости, я тебя не понимаю».~
@6879  = ~«Э-э… прощай».~
@6880  = ~«Может, ты поможешь мне…»~
@6881  = ~«Просто хотел попрактиковаться в ребусах. Прощай».~
@6882  = ~«Морте, можешь перевести мне, что он говорит?»~
@6883  = ~«Морте, можешь перевести мне, что он говорит?»~
@6884  = ~«Морте, можешь перевести мне, что он говорит?»~
@6885  = ~«Морте, можешь перевести мне, что он говорит?»~
@6886  = ~«Анна, можешь перевести мне, что он говорит?»~
@6887  = ~«Дак'кон, можешь перевести мне, что он говорит?»~
@6888  = ~«Падшая Грейс, можешь перевести мне, что он говорит?»~
@6889  = ~«Прости, я тебя не понимаю».~
@6890  = ~«Э-э… прощай».~
@6891  = ~Уйти.~
@6892  = ~«Э-э… прощай».~
@6893  = ~«Кто ты?»~
@6894  = ~«Что делаешь?»~
@6895  = ~«Кто ты?»~
@6896  = ~«Что делаешь?»~
@6897  = ~«Можешь рассказать мне о Госпоже Боли?»~
@6898  = ~«Можешь рассказать мне о Фелле?»~
@6899  = ~«Прощай».~
@6900  = ~«У меня другой вопрос».~
@6901  = ~«Это всё, что я хотел узнать. Прощай».~
@6902  = ~«У меня другой вопрос».~
@6903  = ~«Это всё, что я хотел узнать. Прощай».~
@6904  = ~«У меня другой вопрос…»~
@6905  = ~«Очень информативно. Спасибо и прощай».~
@6906  = ~«Это всё, что я хотел узнать. Прощай».~
@6907  = ~«У меня другой вопрос…»~
@6908  = ~«Очень информативно. Спасибо и прощай».~
@6909  = ~«Это всё, что я хотел узнать. Прощай».~
@6910  = ~«Что он сказал, Анна?»~
@6911  = ~«Что он сказал, Анна?»~
@6912  = ~«Что он сказал, Дак'кон?»~
@6913  = ~«Что он сказал, Грейс?»~
@6914  = ~«Что он сказал, Анна?»~
@6915  = ~«Что он сказал, Дак'кон?»~
@6916  = ~«Что он сказал, Грейс?»~
@6917  = ~«Что он сказал, Анна?»~
@6918  = ~«Что он сказал, Анна?»~
@6919  = ~«Что он сказал, Дак'кон?»~
@6920  = ~«Что он сказал, Грейс?»~
@6921  = ~«Что он сказал, Анна?»~
@6922  = ~«Что он сказал, Дак'кон?»~
@6923  = ~«Что он сказал, Грейс?»~
@6924  = ~«Что он сказал, Анна?»~
@6925  = ~«Что он сказал, Анна?»~
@6926  = ~«Что он сказал, Дак'кон?»~
@6927  = ~«Что он сказал, Грейс?»~
@6928  = ~«Что он сказал, Анна?»~
@6929  = ~«Что он сказал, Дак'кон?»~
@6930  = ~«Что он сказал, Грейс?»~
@6931  = ~«Хм… не совсем тот ответ, на который я рассчитывал».~
@6932  = ~«Хм… ясно. Дак'кон, можешь задать ему другой вопрос?»~
@6933  = ~«Хм… у меня другой вопрос…»~
@6934  = ~«Хм… это всё, что я хотел узнать. Прощай».~
@6935  = ~«Хм… тогда прощай».~
@6936  = ~«Приветствую».~
@6937  = ~Оставить дабуса в покое.~
@6938  = ~Оставить дабуса в покое.~
@6939  = ~Попытаться вступить в разговор и посмотреть, сможешь ли ты разобрать, о чём говорит дабус.~
@6940  = ~Попытаться вступить в разговор и посмотреть, сможешь ли ты разобрать, о чём говорит дабус.~
@6941  = ~Попытаться заговорить с существом и посмотреть, сможешь ли ты понять его.~
@6942  = ~«У меня к тебе вопросы…»~
@6943  = ~«Прости… я тебя не понимаю».~
@6944  = ~«Морте, можешь перевести мне, что он говорит?»~
@6945  = ~«Морте, можешь перевести мне, что он говорит?»~
@6946  = ~«Морте, можешь перевести мне, что он говорит?»~
@6947  = ~«Морте, можешь перевести мне, что он говорит?»~
@6948  = ~«Анна, можешь перевести мне, что он говорит?»~
@6949  = ~«Дак'кон, можешь перевести, что он говорит?»~
@6950  = ~«Падшая Грейс, можешь перевести, что он говорит?»~
@6951  = ~«Неважно. Прости, что побеспокоил. Прощай».~
@6952  = ~«„Госпожа Боли“? Кто это?»~
@6953  = ~«Что ты можешь рассказать мне о Госпоже Боли?»~
@6954  = ~«Ясно».~
@6955  = ~«Ясно».~
@6956  = ~«Брось, Морте. Анна, можешь задать ему ещё пару вопросов?»~
@6957  = ~«Забудь. Пошли».~
@6958  = ~«Может, у меня получится…»~
@6959  = ~«Может, у меня получится…»~
@6960  = ~«Может, у меня получится…»~
@6961  = ~«Что такое „дабус“?»~
@6962  = ~«„Её“ родичей? Чьих?»~
@6963  = ~«Понятно».~
@6964  = ~«Можешь рассказать мне о Госпоже Боли?»~
@6965  = ~«Понятно».~
@6966  = ~«Ох».~
@6967  = ~«Хорошо, хорошо».~
@6968  = ~«А согласна?»~
@6969  = ~«А согласна?»~
@6970  = ~«А согласна?»~
@6971  = ~«Тогда давай».~
@6972  = ~«Тогда давай».~
@6973  = ~«Забудь. Пошли отсюда».~
@6974  = ~«Забудь. Пошли отсюда».~
@6975  = ~«Понятно».~
@6976  = ~«Спроси его, кто он такой».~
@6977  = ~«Спроси его, кто он такой».~
@6978  = ~«Спроси его, кто он такой».~
@6979  = ~«Спроси его, что он делает».~
@6980  = ~«Спроси его, что он делает».~
@6981  = ~«Спроси его, что он делает».~
@6982  = ~«Попроси его рассказать нам о Госпоже Боли».~
@6983  = ~«Попроси его рассказать нам о Фелле».~
@6984  = ~«Забудь. Пошли отсюда».~
@6985  = ~«Можешь задать ему другой вопрос?»~
@6986  = ~«Это всё, что я хотел узнать. Пошли отсюда».~
@6987  = ~«Можешь задать ему другой вопрос?»~
@6988  = ~«Это всё, что я хотел узнать. Пошли отсюда».~
@6989  = ~«Слушай, просто спроси его о Госпоже, хорошо?»~
@6990  = ~«Хорошо. Можешь задать ему другой вопрос?»~
@6991  = ~«Забудь. Пошли отсюда».~
@6992  = ~«Просто *сделай* это. Я тебя предупредил».~
@6993  = ~«Хорошо. Можешь задать ему другой вопрос?»~
@6994  = ~«Забудь. Пошли отсюда».~
@6995  = ~«Дай я попробую…»~
@6996  = ~«Забудь. Пошли отсюда».~
@6997  = ~«Слушай, просто *задай* этот долбаный вопрос, ладно?»~
@6998  = ~«Можешь задать ему другой вопрос?»~
@6999  = ~«Забудь. Пошли отсюда».~
@7000  = ~«Спроси его, кто он такой».~
@7001  = ~«Спроси его, кто он такой».~
@7002  = ~«Спроси его, кто он такой».~
@7003  = ~«Спроси его, что он делает».~
@7004  = ~«Спроси его, что он делает».~
@7005  = ~«Спроси его, что он делает».~
@7006  = ~«Попроси его рассказать нам о Госпоже Боли».~
@7007  = ~«Попроси его рассказать нам о Фелле».~
@7008  = ~«Забудь. Пошли отсюда».~
@7009  = ~«Можешь задать ему другой вопрос?»~
@7010  = ~«Это всё, что я хотел узнать. Прощай».~
@7011  = ~«Можешь задать ему другой вопрос?»~
@7012  = ~«Это всё, что я хотел узнать. Прощай».~
@7013  = ~«Спроси его, кто он такой».~
@7014  = ~«Спроси его, кто он такой».~
@7015  = ~«Спроси его, кто он такой».~
@7016  = ~«Спроси его, что он делает».~
@7017  = ~«Спроси его, что он делает».~
@7018  = ~«Спроси его, что он делает».~
@7019  = ~«Попроси его рассказать нам о Госпоже Боли».~
@7020  = ~«Попроси его рассказать нам о Фелле».~
@7021  = ~«Забудь. Пошли отсюда».~
@7022  = ~«Можешь задать ему другой вопрос?»~
@7023  = ~«Это всё, что я хотел узнать. Прощай».~
@7024  = ~«Можешь задать ему другой вопрос?»~
@7025  = ~«Это всё, что я хотел узнать. Прощай».~
@7026  = ~«Можешь задать ему другой вопрос?»~
@7027  = ~«Это всё, что я хотел узнать. Прощай».~
@7028  = ~«И всё же, можешь его спросить?»~
@7029  = ~«Достаточно наставлений, просто спроси».~
@7030  = ~«Можешь задать ему другой вопрос?»~
@7031  = ~«Тогда забудь. Пошли».~
@7032  = ~«Покажи мне „Таверну1“, пожалуйста».~
@7033  = ~Картина маслом, изображающая молодую женщину.~
@7034  = ~Лоза с чёрными листьями… стебли выглядят очень острыми.~
@7035  = ~Здесь навалены горы мусора… кажется, это большая городская свалка.~
@7036  = ~Попробовать выпивку в Гостинице 1~
@7037  = ~«Покажи мне „Храм1“, пожалуйста».~
@7038  = ~«Неважно. Открой снова главное меню».~
@7039  = ~«Я хочу выйти из этого диалога».~
@7040  = ~Отвернувшись, ты замечаешь глазеющего на тебя Морте. «А? А?»~
@7041  = ~«Ты *видел*, как эта бледная красавица на меня смотрела? — зубы Морте стучат, словно в предвкушении. — Она ищет какого-нибудь везунчика, чтобы он обогрел её гроб».~
@7042  = ~Морте игнорирует твои слова и впадает в задумчивость: «На самом деле, я совсем не имел в виду внимание… просто я хотел бы выглядеть как-нибудь получше, чем просто череп, ясно? Мои чувства глубже простых животных инстинктов. Я хочу ухаживать, а не неделями вышвыривать жизнь в мавзолее».~
@7043  = ~«Эй, шеф… — Морте чуть отступает из пределов досягаемости твоей руки. — Женщины, они ценят любовников, а не воинов».~
@7044  = ~«Ну хорошо, может, я и просто череп, но у меня большое сердце».~
@7045  = ~«Что? Ты свалился мне на голову для того, чтобы обсирать мои мечты и стремления?! Хорошо, пусть будет так. У меня нет сердца, но *душа* есть».~
@7046  = ~«Если бы у тебя была хоть половина тех чувств, с которыми ты умер, ты бы понял, — голос Морте становится жутко самодовольным. — Что касается анналов любви, знай, я их заполнил все».~
@7047  = ~«Приятно было пообщаться. Прощай».~
@7048  = ~Оставить труп в покое.~
@7049  = ~«Приятно было пообщаться. Прощай».~
@7050  = ~Оставить труп в покое.~
@7051  = ~«Ладно. Приятно было поговорить. Прощай».~
@7052  = ~«Ладно. Приятно было поговорить. Прощай».~
@7053  = ~Оставить труп в покое.~
@7054  = ~Оставить труп в покое.~
@7055  = ~«Что такое?»~
@7056  = ~«*Пожалуйста*, не заводи эту волынку снова».~
@7057  = ~«О *чём* ты?»~
@7058  = ~«Что, этот бессмысленный загробный взгляд?»~
@7059  = ~«Продолжай в том же духе, и *я* зашвырну тебя куда подальше».~
@7060  = ~«Морте, ты *череп*. И никто тебе не поможет, ты всегда будешь выглядеть как череп. Смирись с этим».~
@7061  = ~«Я понял. Теперь давай пойдём отсюда, ладно?»~
@7062  = ~«Пожалуй, ты *последний*, от кого я хотел бы выслушивать романтические советы».~
@7063  = ~«Как скажешь, Морте. Пошли».~
@7064  = ~«На самом деле у тебя ничего такого *нет*».~
@7065  = ~«Как скажешь, Морте. Пошли».~
@7066  = ~«Ну, вообще-то я бы не поручился… а, забудь. Пошли».~
@7067  = ~«Как скажешь, Морте. Пошли».~
@7068  = ~«Как скажешь, Морте. Пошли».~
@7069  = ~Кто-то связал кости этого скелета кожаными ремнями, намотанными на тело так, что они напоминают мускулы и сухожилия. Сами ремни закреплены металлическими болтами, вбитыми в суставы скелета. Он находится в весьма хорошем состоянии; похоже, его кости недавно были покрыты известковым раствором, а все следы бывшего тела с него счищены.~
@7070  = ~Как и у скелетов из Мортуария, кто-то связал кости этого скелета кожаными ремнями, намотанными на тело так, что они напоминают мускулы и сухожилия. Однако в отличие от скелетов из Мортуария, в суставах нет болтов… тебе так и не удаётся понять, на чём же они держатся. В целом этот скелет в весьма неплохом состоянии; его кости недавно были покрыты известковым раствором, а все следы бывшего тела с него счищены.~
@7071  = ~Морте какое-то время изучает скелет, затем качает головой: «Не-а… этот слишком чистый… вряд ли мясо осталось хоть где-то. К тому же я никогда не смог бы счистить всю эту извёстку».~
@7072  = ~«Как насчёт этого скелета, Морте? Сгодится в качестве тела?»~
@7073  = ~«Прощай».~
@7074  = ~Оставить скелет в покое.~
@7075  = ~Оставить скелет в покое.~
@7076  = ~«Не знаю, если он „слишком чистый“… то тебе стоит изучить пару вещей о чистоплотности».~
@7077  = ~«Ладно. Пошли».~
@7078  = ~Этот Пыльный одет в длинный тёмный балахон, его руки спрятаны в рукавах. Склонив голову, он размеренно поёт вместе с другими Пыльными рядом с ним.~
@7079  = ~«Приветствую».~
@7080  = ~Эта Пыльная одета в длинный тёмный балахон, её руки спрятаны в рукавах. Склонив голову, она размеренно поёт вместе с другими Пыльными рядом с ней.~
@7081  = ~«Приветствую».~
@7082  = ~«Я — один из плакальщиков, обретающихся вне пределов лавочки Пыльных в AR0200 (Улей B). Мы „оплакиваем живущих“, и игрок может попросить нас оплакать тех, кто потерял своих родных и близких».~
@7083  = ~«Спасибо за информацию».~
@7084  = ~«Я — один из плакальщиков, обретающихся вне пределов лавочки Пыльных в AR0200 (Улей B). Мы „оплакиваем живущих“, и игрок может попросить нас оплакать тех, кто потерял своих родных и близких».~
@7085  = ~«Спасибо за информацию».~
@7086  = ~«Нужно отправить ещё один отчёт в Зал Записей…»~
@7087  = ~«Ну-ка, глянем, нет ли кого тут, а?»~
@7088  = ~«Пфе! Трижды проклятая сыпь на ногах…»~
@7089  = ~«Пфе! Трижды проклятая бутылка!»~
@7090  = ~«Хм-м-м-м…»~
@7091  = ~«Перегоняйся, или я из тебя ночной горшок сделаю! Пфе!»~
@7092  = ~«Эти мелкие паршивцы видели свои последние дни!..»~
@7093  = ~Ты осматриваешь зубы Ингресс. Поражает их сходство с жучками из слоновой кости. У тебя такое чувство, будто они смотрят на тебя в ожидании приказа.~
@7094  = ~«Эй, Морте! Поди-ка сюда на минутку».~
@7095  = ~«Айи-и-и! Стража! Здесь грабители!»~
@7096  = ~Готово.~
@7097  = ~«Уважаемый, тебе лучше уйти. Если надо, тебя даже проводят, не хочу тебя тут удерживать».~
@7098  = ~Уйти.~
@7099  = ~«Чем я могу помочь, уважаемый?»~
@7100  = ~«Мне нужно поработать в кузнице. Можешь выдать мне руду?»~
@7101  = ~«Мне нужно поработать в кузнице. Можешь выдать мне руду?»~
@7102  = ~«Расскажи мне о своём предшественнике».~
@7103  = ~«Расскажи мне о своём предшественнике».~
@7104  = ~«Расскажи мне о своём предшественнике».~
@7105  = ~«Ничего. Прощай».~
@7106  = ~«Прошу прощения, уважаемый. Смотритель сказал мне, что ты уже слишком долго занимаешь горн. Другим тоже надо. Прими мои извинения».~
@7107  = ~«Расскажи мне о своём предшественнике».~
@7108  = ~«Расскажи мне о своём предшественнике».~
@7109  = ~«Расскажи мне о своём предшественнике».~
@7110  = ~«Хорошо. До свидания».~
@7111  = ~«Тебе нужна руда? Ладно. Примени её с пользой, уважаемый. Она жаждет быть обработанной».~
@7112  = ~«Обязательно. Прощай».~
@7113  = ~«Ладно. До свидания».~
@7114  = ~«Это было более чем странно! Как только Сароса посадили под замок, Тильдон просто исчез. Ни записочки, ни объяснения… ничего. Просто исчез. Он был невероятное чмо, так что никто о нём не пожалел».~
@7115  = ~«Мне нужно поработать в кузнице. Можешь выдать мне руду?»~
@7116  = ~«Мне нужно поработать в кузнице. Можешь выдать мне руду?»~
@7117  = ~«Ясно. Прощай».~
@7118  = ~«Хорошо! После того как его повязали и посадили, мы просто выкинули его из памяти. Мы всегда ненавидели этого пня, и только вздохнули с облегчением».~
@7119  = ~«Мне нужно поработать в кузнице. Можешь выдать мне руду?»~
@7120  = ~«Мне нужно поработать в кузнице. Можешь выдать мне руду?»~
@7121  = ~«Ясно. Прощай».~
@7122  = ~«Дьявольски жаль, что Сароса убрали. Хотя вместо этого кожеголового Тильдона… это сделка с извергом, наверняка. Ладно Сарос, но Тильдон? Он исчез. Уже это хорошо».~
@7123  = ~«Мне нужно поработать в кузнице. Можешь выдать мне руду?»~
@7124  = ~«Мне нужно поработать в кузнице. Можешь выдать мне руду?»~
@7125  = ~«Ясно. Прощай».~
@7126  = ~«Ясно. Прощай».~
@7127  = ~«Это прямо к юго-западу от Мортуария, или к югу от „Собирателей пыли“, бара Пыльников».~
@7128  = ~«Хозяйка Сигила? Ты чё, не *слыхал* о ней? Да ты прям блаженный или бестолочь… э-э, в смысле, ты точно мало знаешь о Сигиле», — он тихо усмехается. «Слова Госпожи — закон в Сигиле, — он задумывается на мгновение. — Только вот много она не говорит. Вообще хранит мёртвое молчание».~
@7129  = ~Он осторожно на тебя смотрит: «Не хочу много о ней говорить, мужик… не стоит пересекать её тень или, там, петь ей хвалы, сечёшь? Давай больше не будем об этом. Трепаться о ней — не дело, точно говорю».~
@7130  = ~«Да!»~
@7131  = ~«Ничего. Прощай».~
@7132  = ~«Неважно. Прощай».~
@7133  = ~«Спасибо. Прощай».~
@7134  = ~«У меня другие вопросы…»~
@7135  = ~«Ясно. Спасибо за информацию. Прощай».~
@7136  = ~«Я услышал достаточно. Прощай».~
@7137  = ~«Что это за „ключи“, о которых ты говорил?»~
@7138  = ~«А куда все эти двери ведут?»~
@7139  = ~«У меня к тебе другие вопросы…»~
@7140  = ~«Это всё, что я хотел узнать. Прощай».~
@7141  = ~«У меня другие вопросы…»~
@7142  = ~«Хорошо… прощай».~
@7143  = ~«У меня другие вопросы…»~
@7144  = ~«Неважно. Прощай».~
@7145  = ~«Ясно. У меня другие вопросы…»~
@7146  = ~«Неважно. Прощай».~
@7147  = ~«Неважно. Прощай».~
@7148  = ~«Ясно. Прощай».~
@7149  = ~«Неважно. Прощай».~
@7150  = ~«Прощай».~
@7151  = ~«У меня другие вопросы…»~
@7152  = ~«Спасибо. Прощай».~
@7153  = ~«Интересный закон».~
@7154  = ~«Что ещё ты мне можешь рассказать об этой Госпоже?»~
@7155  = ~«Неважно. Прощай».~
@7156  = ~«Тогда прощай».~
@7157  = ~Эти ворота ведут обратно в район Мортуария.~
@7158  = ~Бар «Собиратели пыли»~
@7159  = ~Огромный монумент… нет ни имени, ни таблички, чтобы определить, кому он посвящён.~
@7160  = ~На этом обсидиановом монументе выбиты имена.~
@7161  = ~На этой обсидиановой стене выбиты тысячи имён.~
@7162  = ~Окно Мортуария… Настолько грязное и покрытое копотью, что не пропускает даже света.~
@7163  = ~Похоже на зеркало… но бар в нём не отражается.~
@7164  = ~Эти ворота сделаны из ничем не примечательного чёрного металла. Похоже, открыть их никак нельзя.~
@7165  = ~Барная стойка сделана из зелёного камня. Похоже, любая жидкость, пролитая на неё, тут же испаряется.~
@7166  = ~Видимо, это некое подобие плевательницы для нежити… песчаное дно покрывают выброшенные части тел.~
@7167  = ~Бочка наполнена тёмной жидкостью с сильным запахом рассола.~
@7168  = ~Из этих булькающих баков содержимое разливается в деревянные бочонки. В воздухе витает слабый запах уксуса.~
@7169  = ~Эта жаровня давно не использовалась. На дне осталась только зола.~
@7170  = ~Похоже, этот саркофаг стоит здесь уже несколько веков. У него нет крышки… снаружи он выглядит сделанным из цельного камня.~
@7171  = ~Решетчатые металлические ворота. На взгляд невероятно древние, но, в отличие от других ворот в городе, совсем не ржавые.~
@7172  = ~Окно… если это действительно оно… похоже, сделано из синего камня, который движется и изгибается на глазах. Оно мягко горит в тусклом городском свете.~
@7173  = ~Грубая деревянная телега. Выглядит так, будто развалится при первом же прикосновении.~
@7174  = ~Старая повозка лавочника.~
@7175  = ~Доски этих ящиков покоробились, позволяя увидеть, что внутри. Там сгнившие мешки с зерном.~
@7176  = ~Этот огромный ящик в два раза больше подиума.~
@7177  = ~Эти бочки пусты. Железные обручи, скрепляющие деревянную основу, насквозь проржавели.~
@7178  = ~Эта скамья вот-вот рассыплется.~
@7179  = ~Похоже на вход, но нет ни ручки, ни какого-либо другого приспособления, чтобы его открыть.~
@7180  = ~Вывеска над дверью гласит, что это «Управление по контролю за паразитами и болезнями».~
@7181  = ~Видимо, эти ворота ведут в район Мортуария.~
@7182  = ~Странно, но эту решётку, похоже, не ковали… а вырастили.~
@7183  = ~Анна медленно остывает, но её хвост по-прежнему ходит взад-вперёд: «Лучше следи за собой, если хошь остаться живым и невредимым».~
@7184  = ~Анна делает движение хвостом… явно неприличное.~
@7185  = ~Анна взмахивает своими клинками, оставляя на теле женщины тонкий кровавый след. «Я т-тя помечу», — шипит она. Женщина выглядит парализованной страхом и не способной пошевелиться.~
@7186  = ~Грейс понимающе кивает, словно позволяя тебе уединиться. «Я скоро вернусь», — она поворачивается и уходит.~
@7187  = ~«Говорящая энциклопедия. Это я, шеф».~
@7188  = ~Морте, словно загипнотизированный, глазеет на то, как шлюха изрыгает поток непристойностей. Когда она таки иссякает, Морте минуту молчит, а потом поворачивается к тебе: «Ого, шеф. Кой-чего я раньше не слышал». Он поворачивается обратно к шлюхе, которая переводит дыхание: «Я тоже тебя люблю».~ [MRT387]
@7189  = ~На замковом камне над входом в этот дом изображён белый овал, перечёркнутый чёрной молнией.~
@7190  = ~«Приветствую».~
@7191  = ~Пройти мимо.~
@7192  = ~«О?»~
@7193  = ~«Я потерял дневник».~
@7194  = ~«Может, ты и поможешь мне найти то, что я потерял».~
@7195  = ~«На самом деле я хотел спросить…»~
@7196  = ~«Не сегодня, спасибо».~
@7197  = ~«Забудь о дневнике. Может, ты поможешь мне найти то, что я *на самом деле* потерял».~
@7198  = ~«Ничего я не потерял, но у меня есть вопросы…»~
@7199  = ~«Неважно. Прощай».~
@7200  = ~«Ясно. Сколько?»~
@7201  = ~«Забудь. Я хотел спросить…»~
@7202  = ~«Неважно. Прощай».~
@7203  = ~«Держи».~
@7204  = ~«Забудь. Я лучше тебя спрошу…»~
@7205  = ~«Не бери в голову. Я найду что искал без тебя, спасибо».~
@7206  = ~«Не бери в голову. Я найду что искал без тебя, спасибо».~
@7207  = ~«Не бери в голову. Я найду что искал без тебя, спасибо».~
@7208  = ~Идти за ней…~
@7209  = ~Похоже на сточный желоб. Судя по всему, он почти не использовался.~
@7210  = ~Над дверью нацарапано: Бар «Горящий труп».~
@7211  = ~Идти за ней…~
@7212  = ~Идти за ней…~
@7213  = ~«Э-э… тогда прощай».~
@7214  = ~«Э-э… „мимир“?»~
@7215  = ~«Не переживай, Морте. Судя по её виду, я спас тебя от второй смерти».~
@7216  = ~Эти печные трубы выбрасывают из здания клубы горячего пара.~
@7217  = ~«Ладно, тогда прощай».~
@7218  = ~«Э-э…»~
@7219  = ~«Я могу заплатить. Сколько?»~
@7220  = ~Наверное, эти бочки для сбора дождевой воды. В них только пыль.~
@7221  = ~Лоза на этом доме иссушена жарой, исходящей от стен.~
@7222  = ~Эта неустойчивая платформа выглядит так, будто вот-вот обрушится.~
@7223  = ~«Я могу заплатить. Сколько?»~
@7224  = ~«Я могу заплатить. Сколько?»~
@7225  = ~«Ладно, тогда прощай».~
@7226  = ~«Звучит неплохо. Вот десять монет».~
@7227  = ~«Неважно».~
@7228  = ~«Буду иметь в виду. Прощай».~
@7229  = ~«Буду иметь в виду. Прощай».~
@7230  = ~«Буду иметь в виду. Прощай».~
@7231  = ~«Я хотел кое о чём спросить…»~
@7232  = ~«Не расскажешь мне об этом городе?»~
@7233  = ~«Можешь рассказать мне о Сигиле?»~
@7234  = ~«Что-то не так?»~
@7235  = ~«Ну конечно, „привет“, — изысканно украшенный шкаф издаёт ещё одно *хмф!* — Так что мы тут делаем? Дамское бельё с оборками спереть хотим, м-м-м?»~
@7236  = ~«Скажи мне, что здесь есть интересного?»~
@7237  = ~«Можешь рассказать мне о фракциях?»~
@7238  = ~«Что ты можешь рассказать мне о Госпоже Боли?»~
@7239  = ~«Я ищу одного типа по имени Фарод».~
@7240  = ~«Я ищу дневник».~
@7241  = ~«Вообще-то забудь. Прощай».~
@7242  = ~«Что он такое?»~
@7243  = ~«Что он такое?»~
@7244  = ~«Вообще-то, у меня были другие вопросы…»~
@7245  = ~«Неважно. Прощай».~
@7246  = ~«Неважно. Прощай».~
@7247  = ~«Неважно. Прощай».~
@7248  = ~«Где точно расположен Сигил?»~
@7249  = ~«Вообще-то, у меня были другие вопросы…»~
@7250  = ~«Неважно. Прощай».~
@7251  = ~«Неважно. Прощай».~
@7252  = ~«Неважно. Прощай».~
@7253  = ~«Почему „фигня“?»~
@7254  = ~«Вообще-то, у меня были другие вопросы…»~
@7255  = ~«Неважно. Прощай».~
@7256  = ~«Неважно. Прощай».~
@7257  = ~«Неважно. Прощай».~
@7258  = ~«Хм-м-м. У меня были другие вопросы…»~
@7259  = ~«Спасибо за информацию. Прощай».~
@7260  = ~«Спасибо за информацию. Прощай».~
@7261  = ~«Спасибо за информацию. Прощай».~
@7262  = ~«Они собирают трупы? Зачем?»~
@7263  = ~«Что тут ещё есть интересного?»~
@7264  = ~«Хорошо… у меня были другие вопросы…»~
@7265  = ~«Неважно. Прощай».~
@7266  = ~«Неважно. Прощай».~
@7267  = ~«Неважно. Прощай».~
@7268  = ~В этом портрете лишь с трудом удаётся разглядеть человеческие формы.~
@7269  = ~«Что тут ещё есть интересного?»~
@7270  = ~«Хорошо… у меня были другие вопросы…»~
@7271  = ~Нижняя часть этой платформы густо заросла бритвенной лозой. Кажется, она-то и не даёт платформе развалиться.~
@7272  = ~«Неважно. Прощай».~
@7273  = ~«Неважно. Прощай».~
@7274  = ~«Неважно. Прощай».~
@7275  = ~«И даже Пыльных?»~
@7276  = ~«Хорошо… у меня были другие вопросы…»~
@7277  = ~«Неважно. Прощай».~
@7278  = ~«Неважно. Прощай».~
@7279  = ~«Неважно. Прощай».~
@7280  = ~«Ясно… у меня были другие вопросы…»~
@7281  = ~«Поучительно… прощай».~
@7282  = ~«Поучительно… прощай».~
@7283  = ~«Поучительно… прощай».~
@7284  = ~«У меня были другие вопросы…»~
@7285  = ~«Неважно. Прощай».~
@7286  = ~«Неважно. Прощай».~
@7287  = ~«Неважно. Прощай».~
@7288  = ~Ты видишь Пыльного с застывшей кривой улыбкой на лице. Несмотря на улыбку, глаза его тусклые, как стекляшки. Его правая рука короче левой, и он прижимает её к груди, как будто баюкает младенца.~
@7289  = ~«Приветствую».~
@7290  = ~Оставить мужчину в покое.~
@7291  = ~Глаза Пыльного скользят по тебе. «Имя», — его голос звучит, как звон колокола.~
@7292  = ~«Я… я не знаю».~
@7293  = ~«Э-э… прости, что потревожил».~
@7294  = ~«Нет имени, нет имени — ничем не могу помочь, — Пыльный говорит странным голосом нараспев. — Нужно имя, если ты хочешь узнать, где оно умерло».~
@7295  = ~«Что?»~
@7296  = ~«Получаешь имя при рождении, отдаёшь его назад, когда оно больше тебе не нужно. Смерть-Имён, Смерть-Имён, — его глаза скользят по монолиту, затем по стенам. — Похоронил здесь много имён, Смерть-Имён похоронил. Назови мне имя, и я покажу тебе его могилу».~
@7297  = ~«Хакария».~
@7298  = ~«Дейонарра».~
@7299  = ~«Дхалл».~
@7300  = ~«Дхалл».~
@7301  = ~~
@7302  = ~~
@7303  = ~«Квентин».~
@7304  = ~«Э-э… ну, не знаю. Пусть будет „Адан“».~
@7305  = ~Он качает головой: «Ещё не умерло, это имя. Не похоронено здесь. Не время, не время».~
@7306  = ~«Позволь назвать другое имя…»~
@7307  = ~«Можешь похоронить имя для меня?»~
@7308  = ~«Ладно… ладно. Прости, что потревожил тебя».~
@7309  = ~Он кивает, потом отнимает свою короткую руку от груди. Похоже, она недоразвита… размером с детскую ручонку. «Похоронить имя не бесплатно, давай медяки. Три медяка, три».~
@7310  = ~«Хакария».~
@7311  = ~«Дейонарра».~
@7312  = ~«Дхалл».~
@7313  = ~«Дхалл».~
@7314  = ~~
@7315  = ~~
@7316  = ~~
@7317  = ~«Квентин».~
@7318  = ~«Разумно. Вот тридцать монет».~
@7319  = ~«Разумно. Вот двадцать одна монета».~
@7320  = ~«Разумно. Вот девять монет».~
@7321  = ~«Хм-м. У меня столько нет. Однако у меня были другие вопросы…»~
@7322  = ~«Хм-м. У меня столько нет. Однако у меня были другие вопросы…»~
@7323  = ~«Хм-м. У меня столько нет. Однако у меня были другие вопросы…»~
@7324  = ~«Забудь… у меня были другие вопросы…»~
@7325  = ~«Неважно. Прощай».~
@7326  = ~«Неважно. Прощай».~
@7327  = ~«Неважно. Прощай».~
@7328  = ~«За *такую* цену — всё, что ты можешь мне о нём рассказать».~
@7329  = ~«Что ты можешь мне о нём рассказать?»~
@7330  = ~«Забудь… у меня были другие вопросы…»~
@7331  = ~«Неважно. Прощай».~
@7332  = ~«Неважно. Прощай».~
@7333  = ~«Неважно. Прощай».~
@7334  = ~«Где я могу его найти?»~
@7335  = ~«Где я могу его найти?»~
@7336  = ~«Ладно, Фарода проехали… у меня были другие вопросы…»~
@7337  = ~«Неважно. Прощай».~
@7338  = ~«Неважно. Прощай».~
@7339  = ~«Неважно. Прощай».~
@7340  = ~«Площадь Мусорщиков?»~
@7341  = ~«Ясно… у меня были другие вопросы…»~
@7342  = ~«Спасибо за информацию. Прощай».~
@7343  = ~«Спасибо за информацию. Прощай».~
@7344  = ~«Спасибо за информацию. Прощай».~
@7345  = ~«Кто такие Сборщики?»~
@7346  = ~«Ясно… у меня были другие вопросы…»~
@7347  = ~«Спасибо за информацию. Прощай».~
@7348  = ~«Спасибо за информацию. Прощай».~
@7349  = ~«Спасибо за информацию. Прощай».~
@7350  = ~Монеты падают в руку Смерти-Имён, и он снова прижимает её к груди. Его глаза вдруг оживают, закатываются, затем снова обращаются вперёд и начинают обшаривать монолит и стены мемориала.~
@7351  = ~Ждать…~
@7352  = ~Его взгляд цепляется за пустое место на стене, он, ссутулившись, торопится к нему, затем начинает высекать. Через несколько минут он останавливается, выпрямляется и возвращается к тебе: «Похоронено». Это слово окончательно лишает тебя душевного равновесия.~
@7353  = ~«Я хочу, чтобы ты нашёл здесь имя…»~
@7354  = ~«Я хочу похоронить другое имя».~
@7355  = ~«Спасибо. Прощай».~
@7356  = ~Ты видишь Смерть-Имён. Он стоит у монумента с той же кривой улыбкой на лице, рука прижата к груди.~
@7357  = ~«Приветствую».~
@7358  = ~Оставить его в покое.~
@7359  = ~Его глаза снова скользят по тебе. «Имя», — голос звучит, как звон колокола.~
@7360  = ~«Я… я не знаю».~
@7361  = ~«Я хочу похоронить имя».~
@7362  = ~«Хакария».~
@7363  = ~«Дейонарра».~
@7364  = ~«Дхалл».~
@7365  = ~«Дхалл».~
@7366  = ~«Ксикси».~
@7367  = ~«Ксикси».~
@7368  = ~«Квентин».~
@7369  = ~Его глаза закатываются, затем снова обращаются вперёд. С диким блеском они обшаривают стены монумента, перебирая имена с нечеловеческой скоростью. Затем он указывает на часть стены: «Похоронено».~
@7370  = ~Осмотреть тот участок, на который он указал.~
@7371  = ~«Ещё одно имя…»~
@7372  = ~«Я хочу похоронить имя».~
@7373  = ~«Просто проверял. Прощай».~
@7374  = ~В чёрном камне тонкой вязью высечено названное тобой имя. Оно почти затерялось в океане окружающих имён.~
@7375  = ~«Ещё одно имя…»~
@7376  = ~«Я хочу похоронить имя…»~
@7377  = ~«Просто проверял. Прощай».~
@7378  = ~Он качает головой: «Похоронено».~
@7379  = ~«Я хочу хорошо провести время».~
@7380  = ~«Ещё одно имя…»~
@7381  = ~«Я ищу работу».~
@7382  = ~«Я хочу похоронить имя…»~
@7383  = ~«Просто проверял. Прощай».~
@7384  = ~Его глаза закатываются, затем снова обращаются вперёд. С диким блеском они обшаривают стены монумента, перебирая имена с нечеловеческой скоростью. Затем он указывает на основание монумента: «Похоронено».~
@7385  = ~«Неважно. Прощай».~
@7386  = ~Осмотреть тот участок, на который он указал.~
@7387  = ~«Ещё одно имя…»~
@7388  = ~«Я хочу похоронить имя».~
@7389  = ~«Неважно. Прощай».~
@7390  = ~«Просто проверял. Прощай».~
@7391  = ~В чёрном камне тонкой вязью высечено имя Квентина. Бедный Квентин: непохоже, чтобы его имени хватило расколоть монумент, как он надеялся.~
@7392  = ~«Ещё одно имя…»~
@7393  = ~«Неважно. Прощай».~
@7394  = ~«Я хочу похоронить имя…»~
@7395  = ~«Ясно… у меня были другие вопросы…»~
@7396  = ~«Спасибо за информацию. Прощай».~
@7397  = ~«Спасибо за информацию. Прощай».~
@7398  = ~«Спасибо за информацию. Прощай».~
@7399  = ~«Ясно… у меня были другие вопросы…»~
@7400  = ~«Спасибо за информацию. Прощай».~
@7401  = ~«Спасибо за информацию. Прощай».~
@7402  = ~«Спасибо за информацию. Прощай».~
@7403  = ~«Просто проверял. Прощай».~
@7404  = ~Монеты падают в руку Смерти-Имён, и он снова прижимает её к груди. Его глаза вдруг оживают, закатываются, затем снова обращаются вперёд и начинают обшаривать монолит и стены мемориала.~
@7405  = ~Ждать…~
@7406  = ~Он поворачивается к основанию монолита, ссутулившись, торопится к нему, затем начинает высекать. Бедный Квентин: монумент не сдвигается ни на пядь, когда на нём заносят его имя. Через несколько минут Смерть-Имён останавливается, выпрямляется и возвращается к тебе: «Похоронено». Это слово окончательно лишает тебя душевного равновесия.~
@7407  = ~«Я хочу, чтобы ты нашёл здесь имя…»~
@7408  = ~«Я хочу похоронить другое имя».~
@7409  = ~«Спасибо. Прощай».~
@7410  = ~Мужчина перед тобой среднего возраста и роста. Это крепыш с толстой, бычьей шеей, его плечи поникли, как будто на них лежит непосильная тяжесть. Он беспокойно разглядывает чёрный монолит перед собой.~
@7411  = ~«Приветствую».~
@7412  = ~Оставить мужчину в покое.~
@7413  = ~Мужчина бросает на тебя короткий взгляд: «Здесь есть место, здоровяк. Нет нужды просить меня подвинуться, чтобы тут стоять».~
@7414  = ~«На самом деле я хотел узнать, что это за монолит».~
@7415  = ~«Хорошо. Прости, что потревожил».~
@7416  = ~«Это надгробная плита планов, — усмехается он. — На этом камне высечены целые кладбища имён. Могу только надеяться, что на моём имени он наконец треснет». Он указывает на основание монолита: «„Квентин“, вот здесь оно будет выбито, и эта проклятая громадина наконец расколется».~
@7417  = ~«„Надгробная плита планов“?»~
@7418  = ~«Ясно. Прощай».~
@7419  = ~«Ага», — Квентин печально улыбается. «Пыльники выбивают на этом монументе имена умерших… — он обводит рукой стены. — И на стенах тоже. Места не хватает, по моему разумению, но всё равно… они делают, что могут. Половину имён с трудом разберёшь».~
@7420  = ~«Что ты здесь делаешь?»~
@7421  = ~«Ясно. Прощай».~
@7422  = ~«Читаю новые имена. Каждый день пытаюсь найти новое и пытаюсь вспомнить, знал ли я его, ничего больше».~
@7423  = ~«Пыльные выбивают на монументе имена всех умерших?»~
@7424  = ~«Ясно. Прощай».~
@7425  = ~«Ага, они выбивают их на этом камне… и на стенах тоже, — Квентин усмехается. — Не знаю уж, зачем они столько сил уделяют подсчёту мёртвых… Пыльники же больше заботятся о живых».~
@7426  = ~«О живых?»~
@7427  = ~«О живых?»~
@7428  = ~«Ясно. Прощай».~
@7429  = ~«Ага… знаешь о плакальщиках Пыльных, что сюда приходят? Они же оплакивают не мёртвых, а живых. Едва ли ты добьёшься от них хоть слова, если только не попросишь оплакать какого-нибудь *живого* доходягу».~
@7430  = ~«Почему они оплакивают живых?»~
@7431  = ~«Ясно. Прощай».~
@7432  = ~«Спроси чего полегче, здоровяк, — он пожимает плечами. — А лучше их спроси. По мне, мёртвые втройне заслуживают жалости любого бедняги в этой помойной яме». Он кивает на монумент: «Каждое имя, выбитое здесь, благословлено в моей книге».~
@7433  = ~«Приходилось слышать, чтобы кто-нибудь вернулся после появления здесь его имени?»~
@7434  = ~«Можешь сказать мне, кто такой этот безумный Пыльник с той стороны монолита?»~
@7435  = ~«Ясно. Спасибо за беседу. Прощай».~
@7436  = ~Ты видишь Квентина. Он всё ещё изучает камень, как будто хочет расколоть его взглядом.~
@7437  = ~«Здравствуй, Квентин».~
@7438  = ~Оставить его в покое.~
@7439  = ~«А? — Квентин бросает на тебя взгляд и кивает. — Привет, здоровяк. Ты пришёл, чтобы потребовать кусок стены под своё имя?»~
@7440  = ~«Нет пока, успеется. Я хотел спросить тебя…»~
@7441  = ~«Нет, просто мимо проходил. Прощай, Квентин».~
@7442  = ~Квентин ухмыляется: «Не самая нормальная птичка в этом курятнике, правда? Этот псих зовёт себя „Смерть-Имён“». Он снова ухмыляется: «Хотя ему более подошло бы „Смерть-Мозгов“».~
@7443  = ~«Что он здесь делает?»~
@7444  = ~«Ясно. Спасибо».~
@7445  = ~«Он хранитель мемориала. Знает, где высечено каждое имя, и может тебе показать, если надо. Конечно, крыша у него давно поехала, но пару раз он мне помог, — Квентин пожимает плечами. — В его обязанности входит также высечение новых имён, когда их владельцы отправляются в мир иной».~
@7446  = ~«У меня к тебе другие вопросы…»~
@7447  = ~«Ясно. Спасибо».~
@7448  = ~«То бишь вернулся после смерти? — Квентин качает головой. — Никто, здоровяк. Всё живое умирает, таков закон природы». Он пожимает плечами: «Однако учитывая, что планы вечны и всё такое, наверное, возможно всё».~
@7449  = ~«Пожалуй, да. У меня к тебе другие вопросы…»~
@7450  = ~«Ясно. Спасибо».~
@7451  = ~«Спрашивай, здоровяк, никакого вреда в этом нет».~
@7452  = ~«Скажи мне ещё раз, что это за монумент?»~
@7453  = ~«Что ты здесь делаешь?»~
@7454  = ~«Приходилось слышать, чтобы кто-нибудь вернулся после появления здесь его имени?»~
@7455  = ~«Можешь сказать мне, кто такой этот безумный Пыльник с той стороны монолита?»~
@7456  = ~«Ясно. Спасибо».~
@7457  = ~«Хорошо… у меня были другие вопросы…»~
@7458  = ~«Неважно. Прощай».~
@7459  = ~«Неважно. Прощай».~
@7460  = ~«Неважно. Прощай».~
@7461  = ~«Я хотел тебя спросить. Э-э… дай сосредоточусь».~
@7462  = ~«Спасибо. Прощай».~
@7463  = ~«Спасибо. Прощай».~
@7464  = ~«Спасибо. Прощай».~
@7465  = ~«Звучит неплохо. Вот семь монет».~
@7466  = ~«Неважно».~
@7467  = ~«Звучит неплохо. Вот три монеты».~
@7468  = ~«Неважно».~
@7469  = ~«Эй! Анна, остынь!»~
@7470  = ~«Убери эти грёбаные клинки!»~
@7471  = ~Наблюдать, что будет дальше.~
@7472  = ~«„Подровняешь черешок“? И я должен это спустить?»~
@7473  = ~«Прекрати угрожать женщине, или я *тебе* хвост подровняю, ясно?»~
@7474  = ~«Я не интересовался твоим мнением, Анна».~
@7475  = ~«Хорошо, хорошо… остынь».~
@7476  = ~«Не надо мне *угрожать* Анна. Это у тебя тут жизнь одна, понятно?»~
@7477  = ~«Я не интересовался твоим мнением, Анна».~
@7478  = ~«Ладно, ладно… просто успокойся. Пока твоя кровь изверга не вскипела».~
@7479  = ~Амулет черепокрысы~
@7480  = ~«Хе. Хорошая работа».~
@7481  = ~«Анна, остынь…»~
@7482  = ~Идти за шлюхой…~
@7483  = ~«Ясно. Ладно, не переживай, Морте. Судя по её виду, я спас тебя от второй смерти».~
@7484  = ~«Пошли-ка отсюда. Прощай, мисс».~
@7485  = ~Уйти.~
@7486  = ~«Ты в порядке?»~
@7487  = ~«Прощай».~
@7488  = ~«Прощай».~
@7489  = ~«Прощай».~
@7490  = ~«Прощай».~
@7491  = ~«Твоё предложение?»~
@7492  = ~«Да, вроде того. Слушай, помощь мне и правда не помешает. Я хотел спросить…»~
@7493  = ~«Прощай».~
@7494  = ~«Прощай».~
@7495  = ~«Прощай».~
@7496  = ~«Прощай».~
@7497  = ~«Нет, спасибо. Но я хотел спросить…»~
@7498  = ~«Нет, спасибо».~
@7499  = ~«Конечно».~
@7500  = ~«Прощай».~
@7501  = ~«Прощай».~
@7502  = ~«Прощай».~
@7503  = ~«Прощай».~
@7504  = ~«Прощай».~
@7505  = ~«Прощай».~
@7506  = ~«Прощай».~
@7507  = ~«Прощай».~
@7508  = ~«Ну и ладно. У меня кое-какие вопросы…»~
@7509  = ~«Ясно. Тогда прощай».~
@7510  = ~«Ясно. Тогда прощай».~
@7511  = ~«Ясно. Тогда прощай».~
@7512  = ~«Ясно. Тогда прощай».~
@7513  = ~«Не расскажешь мне об этом городе?»~
@7514  = ~«Не расскажешь мне об этом районе?»~
@7515  = ~«Я ищу дневник. Ты его не видела?»~
@7516  = ~«Я ищу кое-кого по имени Фарод. Не знаешь, где его можно найти?»~
@7517  = ~«Неважно. Прощай».~
@7518  = ~«Неважно. Прощай».~
@7519  = ~«Неважно. Прощай».~
@7520  = ~«Неважно. Прощай».~
@7521  = ~«Что да?»~
@7522  = ~«У меня другие вопросы…»~
@7523  = ~«Неважно. Прощай».~
@7524  = ~«Неважно. Прощай».~
@7525  = ~«Неважно. Прощай».~
@7526  = ~«Неважно. Прощай».~
@7527  = ~«Хм… у меня другие вопросы…»~
@7528  = ~«Тогда забудем».~
@7529  = ~«Тогда забудем».~
