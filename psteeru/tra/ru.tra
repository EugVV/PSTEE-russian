@39654 = ~«Продолжай…»~
@39655 = ~«Погоди… у меня вопрос…»~
@39656 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39657 = ~«У меня есть ещё одна история».~
@39658 = ~«У меня к тебе вопрос, Ивес…»~
@39659 = ~«Мне пора идти. Счастливо, Ивес».~
@39660 = ~«У меня есть ещё одна история».~
@39661 = ~«У меня к тебе вопрос, Ивес…»~
@39662 = ~«Мне пора идти. Счастливо, Ивес».~
@39663 = ~«Просто расскажи уже историю, Анна».~
@39664 = ~«Пожалуйста, расскажи нам свою историю, Анна…»~
@39665 = ~«Просто расскажи уже историю, Анна».~
@39666 = ~«Пожалуйста, расскажи нам свою историю, Анна…»~
@39667 = ~«Я могу поделиться другой историей, Ивес».~
@39668 = ~«У меня к тебе вопрос, Ивес…»~
@39669 = ~«Может, в другой раз, Ивес. Прощай».~
@39670 = ~«Продолжай…»~
@39671 = ~«Погоди… у меня вопрос…»~
@39672 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39673 = ~«У меня есть ещё одна история».~
@39674 = ~«У меня к тебе вопрос, Ивес…»~
@39675 = ~«Мне пора идти. Счастливо, Ивес».~
@39676 = ~«Главы Пыли».~
@39677 = ~«Часы и квадрон».~
@39678 = ~«Проситель у ворот».~
@39679 = ~«Рассказ о пчеловоде».~
@39680 = ~«Позолоченная история».~
@39681 = ~«Ухажёр Госпожи».~
@39682 = ~«История о человеке, который не захотел делиться своим впечатлением».~
@39683 = ~«Казнь».~
@39684 = ~«Опалённая земля».~
@39685 = ~«Твоя версия „Ач'али Утопшей“».~
@39686 = ~«Цветы и Чующие».~
@39687 = ~«Рассказ об отце, дочери и её возлюбленном».~
@39688 = ~«Вообще-то у меня вопрос…»~
@39689 = ~«Неважно, Ивес. Прощай».~
@39690 = ~«Да».~
@39691 = ~«Нет, но у меня пара вопросов…»~
@39692 = ~«Вообще-то я просто проходил мимо. Прощай, Ивес».~
@39693 = ~«У меня вопрос о другом…»~
@39694 = ~«Тогда прощай, Ивес».~
@39695 = ~«Пожалуйста. У меня другой вопрос…»~
@39696 = ~«Конечно. Прощай, Ивес».~
@39697 = ~«У меня вопрос о другом…»~
@39698 = ~«Это всё, что я хотел узнать, Ивес. Счастливо».~
@39699 = ~«Да, с удовольствием послушаю».~
@39700 = ~«Не сейчас. У меня вопрос…»~
@39701 = ~«Вообще-то я просто проходил мимо, Ивес. Послушаю твою историю позже. До свидания».~
@39702 = ~«Продолжай…»~
@39703 = ~«Погоди… у меня вопрос…»~
@39704 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39705 = ~«Продолжай…»~
@39706 = ~«Погоди… у меня вопрос…»~
@39707 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39708 = ~«Продолжай…»~
@39709 = ~«Погоди… у меня вопрос…»~
@39710 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39711 = ~«Спасибо. У меня к тебе вопрос, Ивес…»~
@39712 = ~«Спасибо, Ивес. Мне пора идти, прощай».~
@39713 = ~«Тогда забудь».~
@39714 = ~«Просто расскажи свою историю, Морте».~
@39715 = ~«Ну уж нет, Морте. Я не хочу это слышать».~
@39716 = ~«Прекрасно… начинай».~
@39717 = ~«Вряд ли она настолько прекрасна».~
@39718 = ~«Что такое развязка?»~
@39719 = ~«Прекрасно… начинай».~
@39720 = ~«Погоди… что такое развязка?»~
@39721 = ~«Хорошо, начинай».~
@39722 = ~«Прекрасно, начинай».~
@39723 = ~~
@39724 = ~«Продолжай, Морте…»~
@39725 = ~«Погоди… у меня был вопрос к Ивес…»~
@39726 = ~«Мы дослушаем это в другой раз, Морте. Прощай, Ивес».~
@39727 = ~«Продолжай, Морте…»~
@39728 = ~«Погоди… у меня был вопрос к Ивес…»~
@39729 = ~«Мы дослушаем это в другой раз, Морте. Прощай, Ивес».~
@39730 = ~Это невидимое дробящее оружие для большого существа уровня 7-9.~
@39731 = ~УКУС МОРТЕ
(Оружие по умолчанию)
Урон: 1-3 колющий
Фактор скорости: 1
Вес: 0
Навык: «кулачный бой» (Даже не спрашивайте.)

Укус Морте смертелен и он действительно МОЖЕТ зажевать противника до смерти. До тех пор, пока не все его оружейные ячейки заполнены, Морте всегда может выбрать укус как текущее оружие.

^NПРИМЕЧАНИЕ. Укус Морте — его оружие по умолчанию. И хотя урон, наносимый им, сравнительно мал, он позволяет очень быстро атаковать, что выведет из себя любого мага, пытающегося прочесть заклинание.^-~
@39732 = ~Руководствуясь тем, что Морте вычитал из татуировок с моей спины, я должен найти кого-то по имени «Фарод». Без понятия, где следует начинать поиски… надеюсь, кто-нибудь из местных поможет мне найти его в этом странном месте.~
@39733 = ~Я нашёл Фарода… встреча была несколько разочаровывающей. Он оказался дряхлым похитителем тел и куда больше старался вытрясти услуги у меня, чем выдать хоть какую-то полезную информацию.~
@39734 = ~Найти свой пропавший дневник.~
@39735 = ~Морте вычитал из татуировок с моей спины, что после пробуждения в Мортуарии у меня при себе должен был быть дневник. Лучше бы мне его найти. Надеюсь, он поможет разобраться, что здесь происходит.~
@39736 = ~Я нашёл ОДИН из своих дневников… очевидно, их у меня было *несколько*. Придётся продолжать поиски, где-нибудь неподалёку могут быть остальные.~
@39737 = ~Гнилой Уильям мёртв. Теперь Кристалл просит убить Чёрную Розу.~
@39738 = ~Чёрная Роза мёртв.~
@39739 = ~Гнилой Уильям требует убить Кристалл в обмен на бесплатный проход через аллею Опасных Углов.~
@39740 = ~Кристалл мертва. Теперь Гнилой Уильям требует убить Чёрную Розу.~
@39741 = ~Чёрная Роза мёртв. Гнилой Уильям попытался предать меня.~
@39742 = ~Чёрная Роза требует убить Кристалл.~
@39743 = ~Кристалл мертва.~
@39744 = ~Чёрная Роза требует убить Гнилого Уильяма.~
@39745 = ~Гнилой Уильям мёртв.~
@39746 = ~Кристалл просит убить Гнилого Уильяма.~
@39747 = ~Кристалл просит убить Гнилого Уильяма в обмен на бесплатный проход через аллею Опасных Углов.~
@39748 = ~Кристалл просит убить Чёрную Розу.~
@39749 = ~Гнилой Уильям требует убить Кристалл.~
@39750 = ~Гнилой Уильям требует убить Чёрную Розу.~
@39751 = ~Чёрная Роза требует убить Кристалл.~
@39752 = ~«Продолжай, Морте…»~
@39753 = ~«Погоди… у меня был вопрос к Ивес…»~
@39754 = ~«Мы послушаем это в другой раз, Морте. Прощай, Ивес».~
@39755 = ~Спросить другого спутника.~
@39756 = ~«Я могу сам поделиться историей, Ивес».~
@39757 = ~«Тогда у меня вопрос к Ивес…»~
@39758 = ~«Тогда пошли. Прощай, Ивес».~
@39759 = ~«Это… интересная история, Нордом».~
@39760 = ~«Приукрашена?»~
@39761 = ~«Продолжай, Ивес…»~
@39762 = ~«Погоди, Ивес… у меня к тебе вопрос…»~
@39763 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39764 = ~«Продолжай, Анна…»~
@39765 = ~«Погоди… у меня есть для тебя история, Ивес».~
@39766 = ~«Забудь, Анна. Я хотел спросить Ивес…»~
@39767 = ~«Не бери в голову, Анна. Прощай, Ивес».~
@39768 = ~«Продолжай, Анна…»~
@39769 = ~«Погоди… у меня вопрос к Ивес…»~
@39770 = ~«Мы дослушаем твою историю в другой раз, Анна. Прощай, Ивес».~
@39771 = ~«Продолжай, Анна…»~
@39772 = ~«Погоди… у меня вопрос к Ивес…»~
@39773 = ~«Мы дослушаем твою историю в другой раз, Анна. Прощай, Ивес».~
@39774 = ~«Продолжай, Анна…»~
@39775 = ~«Погоди… у меня вопрос к Ивес…»~
@39776 = ~«Мы дослушаем твою историю в другой раз, Анна. Прощай, Ивес».~
@39777 = ~«Продолжай, Анна…»~
@39778 = ~«Погоди… у меня вопрос к Ивес…»~
@39779 = ~«Мы дослушаем твою историю в другой раз, Анна. Прощай, Ивес».~
@39780 = ~«Продолжай, Анна…»~
@39781 = ~«Погоди… у меня вопрос к Ивес…»~
@39782 = ~«Мы дослушаем твою историю в другой раз, Анна. Прощай, Ивес».~
@39783 = ~«Продолжай, Анна…»~
@39784 = ~«Погоди… у меня вопрос к Ивес…»~
@39785 = ~«Мы дослушаем твою историю в другой раз, Анна. Прощай, Ивес».~
@39786 = ~«Продолжай, Анна…»~
@39787 = ~«Погоди… у меня вопрос к Ивес…»~
@39788 = ~«Мы дослушаем твою историю в другой раз, Анна. Прощай, Ивес».~
@39789 = ~«Продолжай, Анна…»~
@39790 = ~«Погоди… у меня вопрос к Ивес…»~
@39791 = ~«Мы дослушаем твою историю в другой раз, Анна. Прощай, Ивес».~
@39792 = ~«Эй, шеф. Ты в порядке? Притворяешься трупом или просто пудришь мозги Пыльникам? Я уж было подумал, что ты совсем дал дуба».~ [MRT001]
@39793 = ~«Чт?.. Кто ты?»~
@39794 = ~~
@39795 = ~«Хм… кто *я*? А может, начнём с *тебя*? Кто ты?»~
@39796 = ~«Я… не знаю. Я не помню».~
@39797 = ~«Я спросил тебя *первым*, череп».~
@39798 = ~«Ты не помнишь своего *имени*? Хе. Что ж, в СЛЕДУЮЩИЙ раз, когда захочешь провести ночь в этом городишке, полегче с выпивкой. Меня звать Морте. Я тоже здесь в ловушке».~
@39799 = ~«В ловушке?»~
@39800 = ~«Ага, а я спросил тебя *вторым*. Тебя как звать?»~
@39801 = ~«Я… не знаю. Я не помню».~
@39802 = ~«Ты первый, череп. Последний раз спрашиваю».~
@39803 = ~«Тс-с-с… да ты тугой, как мокрая верёвка. Ну ладно, *я* тут буду хорошим парнем. Звать Морте. А ты кто?»~
@39804 = ~«Я… не знаю. Я не помню».~
@39805 = ~«Ага, и пока ты ещё не размял ноги, вот тебе сказ: я ломился во все двери, эта комната заперта надёжнее пояса целомудрия».~
@39806 = ~«Мы заперты… где? Что это за место?»~
@39807 = ~«Оно называется „Мортуарий“… большое чёрное сооружение с архитектурным очарованием беременной паучихи».~
@39808 = ~«„Мортуарий“? Э-э… я что, умер?»~
@39809 = ~«Насколько я могу видеть, нет. Правда, у тебя куча шрамов… как будто какой-то пень расписал тебя ножом. Ещё одна причина поскорее смыться, пока этот садист не вернулся закончить свою работу».~
@39810 = ~«Шрамы? Насколько они ужасны?»~
@39811 = ~«Ну… порезы на твоей груди не СЛИШКОМ ужасны… но те, что на спине… — Морте замолкает на какое-то время. — Скажем так, шеф, у тебя там целая галерея татуировок. И там что-то написано…»~
@39812 = ~«Татуировки у меня на спине? Что там написано?»~
@39813 = ~«Хе! Похоже, к тебе прилагаются инструкции… — Морте кашляет, делая вид, что прочищает горло. — Та-ак, посмотрим… начинается с…

„Я знаю, ты чувствуешь себя так, будто нахлебался мутных вод Стикса, но тебе нужно СОБРАТЬСЯ. Среди твоих вещей должен быть ДНЕВНИК, который прольёт немного света на это тёмное дело. ФАРОД расскажет тебе оставшуюся часть истории, если, конечно, он ещё не попал в книгу мёртвых“».~
@39814 = ~«Фарод?.. Там больше ничего не написано?»~
@39815 = ~«Да, есть ещё кое-что… — Морте замолкает на мгновение. — Посмотрим… продолжение…

„Не потеряй свой дневник, иначе мы снова погрузимся в воды Стикса. И что бы ты ни делал, НИКОГДА никому НЕ говори, КТО ты или ЧТО с тобой случилось, а то они устроят тебе скорое паломничество в крематорий. Делай, как я говорю: ПРОЧТИ дневник, а потом НАЙДИ Фарода“».~
@39816 = ~«Неудивительно, что спина так болит: на ней целый роман написан, чтоб его. Что касается дневника, который должен быть при мне… он был со мной, пока я здесь валялся?»~
@39817 = ~«Нет… когда ты сюда прибыл, на тебе вообще ничего не было. Кроме того, похоже, у тебя и так уже целый дневник на спине написан».~
@39818 = ~«А что насчёт Фарода? Ты его знаешь?»~
@39819 = ~«Такого не знаю. И вообще, круг знакомых у меня невелик. Хотя наверняка мы натолкнёмся на какого-нибудь дурня, который знает, где найти Фарода… э-э, как только выберемся отсюда».~
@39820 = ~«Как нам отсюда *выбраться*?»~
@39821 = ~«Ну, все двери заперты, поэтому нам нужен ключ. Весьма вероятно, что он есть у одного из ходячих трупов в этой комнате».~
@39822 = ~«Ходячих трупов?»~
@39823 = ~«Ага, хозяева Мортуария используют мёртвые тела как дешёвую рабочую силу. Покойнички тупые, как камни, но они безвредны и не станут нападать на тебя первыми».~
@39824 = ~«А другого пути нет? Я не хочу убивать их только ради ключа».~
@39825 = ~«Так я должен напасть на один из трупов и отобрать ключ?»~
@39826 = ~«Ты что, боишься их этим огорчить? Они МЕРТВЫ. Кроме того, есть и положительный момент: если ты перебьёшь трупаков, они хотя бы отдохнут, пока хозяева снова не поднимут их работать».~
@39827 = ~«Что ж, ладно… я завалю одного из них и добуду ключ».~
@39828 = ~«Ну, перед нападением тебе нужно вооружиться. Я видел скальпель на полке».

^NПРИМЕЧАНИЕ. Стоит обыскать полки в комнате и найти оружие, чтобы атаковать зомби. <SEARCH_WEAPON>^-~
@39829 = ~«Ладно, я поищу».~
@39830 = ~«И последнее: эти трупы медленные, как черепахи, но удар кого-нибудь из них будет равносилен для тебя поцелую тарана. Если почувствуешь, что трупак тебя побеждает, не забывай, что ты можешь БЕГАТЬ, а они — нет. Используй эту возможность, чтобы держаться на расстоянии, если тебе потребуется подлечиться».

^NПРИМЕЧАНИЕ. <RUNAWAY> Если персонаж сильно ранен и может умереть, можно использовать бег, чтобы держаться от зомби на расстоянии.^-~
@39831 = ~«Хорошо. Спасибо за совет».~
@39832 = ~«На одной из полок должен быть скальпель. Лучше бы тебе его найти, прежде чем бодаться со здешними трупаками».

^NПРИМЕЧАНИЕ. Стоит обыскать полки в комнате и найти оружие, чтобы атаковать зомби. <SEARCH_WEAPON>^-~
@39833 = ~«Хорошо, я поищу».~
@39834 = ~«Отлично, вот и скальпель! Теперь займись трупаками… и не беспокойся, я постою сзади и буду давать тебе ценные тактические советы».~
@39835 = ~«А может, ты лучше *поможешь* мне в бою, Морте?»~
@39836 = ~«Хорошо».~
@39837 = ~«Я и так БУДУ помогать тебе. Дельные советы на дороге не валяются, знаешь ли».~
@39838 = ~«Я имел в виду, поможешь мне *драться* с трупами».~
@39839 = ~«Ну ладно».~
@39840 = ~«Я? Я романтик, а не солдат. Я только мешать буду».~
@39841 = ~«Когда я нападу на трупака, лучше бы тебе находиться рядом со мной, иначе ты будешь следующим, в кого я воткну этот скальпель».~
@39842 = ~«Ну ладно».~
@39843 = ~«Э-э… хорошо. Я помогу тебе».

^NПРИМЕЧАНИЕ. Если хочется, чтобы Морте помогал в битве, достаточно убедится, что перед нападением выбраны оба персонажа. Тогда Морте присоединится к атаке.^-~
@39844 = ~«Я рад, что мы поняли друг друга».~
@39845 = ~«Тогда настало время этим трупам во второй раз посмотреть в глаза смерти…»

^NПРИМЕЧАНИЕ. <ATTACKNOTE>^-~
@39846 = ~«Пошли».~
@39847 = ~«Хорошо, похоже, ты позаботился о том самом трупе. Теперь тебе нужно найти ключ. Он должен быть у него на теле. Когда ключ будет у нас в руках, мы сможем выбраться отсюда».

^NПРИМЕЧАНИЕ. Если существо имеет при себе какую-либо вещь, то после его смерти она упадёт на землю. Все предметы будут лежать кучкой рядом с телом. <DEADPILE>^-~
@39848 = ~«Ладно».~
@39849 = ~«Замечательно, вот и ключ. Он должен подойти к замку одной из дверей в этой комнате».~
@39850 = ~«Тогда я перепробую все двери».~
@39851 = ~«Я знал, что ты вернёшься, шеф! Наконец понял, что я тебе нужен, а?»~ [MRT516]
@39852 = ~«Да… пошли».~
@39853 = ~«Не сейчас, Морте».~
@39854 = ~«Пф. Что ж, не знаю, как долго я ещё буду здесь ждать, так что даю тебе один ПОСЛЕДНИЙ шанс. Ты точно уверен, что тебе не нужны мой быстрый ум и мудрые советы?»~
@39855 = ~«Морте, но у тебя же нет НИ того, НИ другого».~
@39856 = ~«Ну хорошо, я передумал. Идём».~
@39857 = ~«Не сейчас, Морте. Возможно, позже».~
@39858 = ~«Пытаешься меня обидеть, шеф? Я что-то не так сказал? Или это из-за отсутствия у меня рук? В чём же дело?»~
@39859 = ~«Ну хорошо, я передумал. Идём».~
@39860 = ~«Дело вовсе не в этом. Просто прямо сейчас мне не нужна твоя компания. Прощай, Морте».~
@39861 = ~«Ну что ж, я не собираюсь ждать ВЕЧНО, так что лучше бы тебе поскорее вернуться, если передумаешь».~
@39862 = ~«Так и сделаю. Прощай, Морте».~
@39863 = ~«Что тебя гложет, шеф?»~ [MRT515]
@39864 = ~«Прямо сейчас ничего, Морте. Просто проверял, со мной ли ты ещё».~
@39865 = ~Оставить её в покое.~
@39866 = ~Улыбающаяся девушка грациозно приседает в реверансе и, улыбаясь, смотрит на тебя. «*Рада встрече*, добрый господин! Я Ненни! А как *ты* поживаешь в этот прекрасный д?.. — вдруг она замечает твои шрамы и прикрывает рот рукой. — О боже! У тебя раны!» Она моргает: «По всему телу!»~
@39867 = ~«Это старые шрамы. Со мной всё в порядке».~
@39868 = ~«Ничего серьёзного, со мной вскоре всё будет в порядке».~
@39869 = ~«Да, но мои раны заживают быстро».~
@39870 = ~«Не обращай внимания. У меня были кое-какие вопросы…»~
@39871 = ~«Не переживай так. Прощай».~
@39872 = ~Она тихо кивает, опуская руки.~
@39873 = ~«У меня кое-какие вопросы…»~
@39874 = ~«Мне пора идти».~
@39875 = ~«Пожалуйста, спрашивай!» — она легкомысленно улыбается.~
@39876 = ~«Что ты здесь делаешь?»~
@39877 = ~«Можешь рассказать мне об этом месте?»~
@39878 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@39879 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@39880 = ~«Кимази сказала, что кто-то украл вещи из её комнаты. Ты не замечала ничего необычного?»~
@39881 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@39882 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@39883 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@39884 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@39885 = ~«Знаешь что-нибудь о Рейвел Клубок-Загадок?»~
@39886 = ~«Не бери в голову. Прощай».~
@39887 = ~«Нет, извини. Хотя это *громкое* имя, да? Бьюсь об заклад, она очень интересная личность! Эй… тебе стоит спросить о ней у Ивес. Она собирает *всевозможные* истории!»~
@39888 = ~«Так и сделаю. Позволь задать ещё вопрос…»~
@39889 = ~«Это всё, что я хотел узнать. Прощай, Ненни».~
@39890 = ~«А?» — она как будто не может оторвать глаз от твоих шрамов. «О, мне так стыдно! Не обращай внимания на мои неприличные взгляды! Меня зовут Ненни, — она приседает в лёгком реверансе. — Добро пожаловать в наш Бордель Безумной Интеллектуальной Страсти». Её взгляд возвращается к твоему телу. «Под твоими шрамами ещё и татуировки видны! Что тут написано?» — она показывает на одну из твоих татуировок.~
@39891 = ~«На этой…»~
@39892 = ~«Забудь о ней, я…»~
@39893 = ~«Выглядит очаровательно! Только посмотри на ход чернильных линий… я думаю, это чернила…» — она косится на татуировку, затем тянется, чтобы её потрогать.~
@39894 = ~Позволить ей дотронуться.~
@39895 = ~Не позволяй ей дотрагиваться до тебя.~
@39896 = ~«Я *думаю*, это чернила, — она проводит пальцем по краю татуировки. — Это чернила? Какой рисунок! Посмотри, как тут пересекаются линии». Её пальцы касаются центра татуировки: «Это просто великолепно…» Она поджимает губы и разочарованно хмурится: «Я бы разглядела её гораздо лучше, если бы не все эти шрамы…»~
@39897 = ~«Со шрамами уже ничего нельзя сделать, они навсегда».~
@39898 = ~«У меня кое-какие вопросов…»~
@39899 = ~«Мне пора уходить. Прощай».~
@39900 = ~Ненни поднимает взгляд, когда ты не даёшь ей дотронуться до своей кожи. «Прости меня, добрый господин! Я не думала причинить никакого вреда, просто хотела дотронуться до татуировки и проследить за её узором. Она так очаровательна! — на мгновение она надувает губки, затем легонько хлопает себя по лбу. — Слишком прямолинейна! Я слишком прямолинейна! Мои извинения, добрый джентльмен! Пожалуйста, не гневайся!»~
@39901 = ~«Никаких проблем».~
@39902 = ~«Смотри, чтобы это не повторилось».~
@39903 = ~Ненни кивает, затем мило улыбается: «Я приношу свои извинения …но мне *необходимо* знать… ты абсолютно *уверен*, что с тобой всё в порядке? Вот смотрю я, и мне ничего не остаётся, кроме как поверить, что у тебя *ничего* не болит».~
@39904 = ~«Никакой физической боли, правда».~
@39905 = ~«У меня амнезия, это всё».~
@39906 = ~«Забудь об этом. У меня были кое-какие вопросы…»~
@39907 = ~«Не переживай так. Прощай».~
@39908 = ~«Ох, прости, прости меня… разрази меня чума за одно упоминание о них! — она ёжится. — Но мне *необходимо* знать… ты абсолютно *уверен*, что с тобой всё в порядке? Вот смотрю я, и мне ничего не остаётся, кроме как поверить, что у тебя *ничего* не болит».~
@39909 = ~«Никакой физической боли, правда».~
@39910 = ~«У меня амнезия, это всё».~
@39911 = ~«Забудь об этом. У меня были кое-какие вопросы…»~
@39912 = ~«Не переживай так. Прощай».~
@39913 = ~«О! У тебя болит изнутри? В голове? — она с энтузиазмом хлопает в ладоши. — Может, я смогу помочь! Я даже уверена, что смогу помочь! Избавление от боли является частью обучения Чующих… моя учительница говорит, что Чующий может забрать боль из раны и перенести её на самого себя… но тем не менее, я *смогу* помочь! Можно мне хотя бы попробовать?! Пожалуйста, скажи „да“!»~
@39914 = ~«Чующий?»~
@39915 = ~«Да, попробуй».~
@39916 = ~«Твоя учительница?»~
@39917 = ~«Нет. Но у меня кое-какие вопросы…»~
@39918 = ~«Нет, у меня ничего не болит. Прощай».~
@39919 = ~«О да, — с блеском в глазах говорит Ненни. — Госпожа Грейс. Она — самая прекрасная личность, какую я когда-либо знала!»~
@39920 = ~«Расскажи мне о госпоже Грейс».~
@39921 = ~«Понимаю. Ну давай, попробуй помочь».~
@39922 = ~«Мне правда не нужна твоя помощь, но у меня пара вопросов…»~
@39923 = ~«Ясно. На самом деле мне не нужна твоя помощь. Прощай».~
@39924 = ~«Она так прекрасна, не правда ли? Трудно поверить, что она родом с Нижних планов, такая умная и милая!»~
@39925 = ~«При чём здесь Нижние планы?»~
@39926 = ~«Понимаю. Ну давай, попробуй помочь».~
@39927 = ~«Мне правда не нужна твоя помощь, но у меня пара вопросов…»~
@39928 = ~«Ясно. На самом деле мне не нужна твоя помощь. Прощай».~
@39929 = ~Неожиданно Ненни замечает рядом с тобой Падшую Грейс. «О! Госпожа Грейс!» — она приседает в реверансе, Грейс с улыбкой кивает в ответ.~
@39930 = ~«При чём здесь Нижние планы?»~
@39931 = ~«Понимаю. Ну давай, попробуй помочь».~
@39932 = ~«Мне правда не нужна твоя помощь, но у меня пара вопросов…»~
@39933 = ~«Ясно. На самом деле мне не нужна твоя помощь. Прощай».~
@39934 = ~«Ну, там внизу все такие *злые*. Кто бы мог подумать, что госпожа Грейс оттуда родом?»~
@39935 = ~«Понимаю. Ну давай, попробуй помочь».~
@39936 = ~«Мне правда не нужна твоя помощь, но у меня пара вопросов…»~
@39937 = ~«Ясно. На самом деле мне не нужна твоя помощь. Прощай».~
@39938 = ~Ненни складывает руки и легонько кладёт их тебе на лоб.~
@39939 = ~Позволить ей дотронуться.~
@39940 = ~Позволить ей дотронуться.~
@39941 = ~Не позволять ей дотрагиваться до тебя.~
@39942 = ~Когда Ненни подходит ближе, ты замечаешь, что её кожа слегка пахнет сиренью. Она мягко кладёт руки в перчатках тебе на лоб и закрывает глаза. Напевает что-то себе под нос, и ты чувствуешь, как по твоему телу разливается тепло.~
@39943 = ~«О… спасибо. Это было прекрасно».~
@39944 = ~«Конечно! Я так рада, что смогла помочь!» — лицо Ненни сияет, она кажется готовой лопнуть от счастья.~
@39945 = ~«Позволь задать вопрос…»~
@39946 = ~«Мне пора идти. Прощай».~
@39947 = ~Ненни замирает, она выглядит удивлённой и даже немного обиженной: «Прошу прощения! Извини! Тебе не нравится, когда до тебя дотрагиваются? Я должна была предупредить! Таким образом работает чувственное касание… я кладу руки на тело — обычно около раны, чтобы сконцентрировать там энергию, — а затем забираю боль».~
@39948 = ~«Чувственное касание?..»~
@39949 = ~«Хорошо. Тогда продолжай».~
@39950 = ~«У меня был вопрос…»~
@39951 = ~«Мне пора идти. Прощай».~
@39952 = ~«Амнезия?» — Ненни моргает, затем её лицо вновь озаряется. «Потеря памяти! Ты *такой* счастливый… — её голосок радостно звенит. — Всё должно казаться тебе таким *новым*».~
@39953 = ~«Доля правды в этом есть, но я не очень рад… этой новизне».~
@39954 = ~«Никогда ничего такого не хотел».~
@39955 = ~«С этой стороны… я как-то не смотрел».~
@39956 = ~«Я бы предпочёл, чтобы некоторые вещи были мне более знакомы».~
@39957 = ~Она моргает: «Это звучит так *печально*».~
@39958 = ~«Да, так и есть… но у меня кое-какие вопросы…»~
@39959 = ~«Вовсе нет. У меня пара вопросов…»~
@39960 = ~«Возможно… в любом случае прощай».~
@39961 = ~«Правда? Почему?»~
@39962 = ~«Потому что нет. Разве можно объяснить чувство?»~
@39963 = ~«Я не люблю терять память, и смерть — не самая приятная штука».~
@39964 = ~«Без фундамента, с которого можно начинать, хоть какого-то понятия о том, кто я есть, я не могу развиваться».~
@39965 = ~«Просто… не бери в голову. У меня назрел вопрос…»~
@39966 = ~«Я не хочу больше об этом говорить. Прощай».~
@39967 = ~Ненни радостно хлопает в ладоши: «Я так рада, что открыла тебе новую точку зрения! Я слышала, что это и значит быть настоящим Чующим… нести другим новый опыт».~
@39968 = ~«Чующим?»~
@39969 = ~«У меня кое-какие вопросы…»~
@39970 = ~«Мне пора идти. Прощай».~
@39971 = ~«Наподобие кого? — она улыбается, затем тихо хихикает. — Я имею в виду, наподобие чего?»~
@39972 = ~«Например, мой убийца».~
@39973 = ~«Не Морте. Он слишком знаком».~
@39974 = ~«Хотелось бы знать, был ли я в прошлом знаком с кем-нибудь из своих спутников».~
@39975 = ~«Просто… не бери в голову. У меня назрел вопрос…»~
@39976 = ~«Я не хочу больше об этом говорить. Прощай».~
@39977 = ~«О, всегда можно попробовать! — бодро отвечает Ненни. — Попробуй! Давай, я знаю, ты сможешь».~
@39978 = ~«Я не люблю терять память, и смерть — не самая приятная штука».~
@39979 = ~«Без фундамента, с которого можно начинать, хоть какого-то понятия о том, кто я есть, я не могу развиваться».~
@39980 = ~«Просто… не бери в голову. У меня назрел вопрос…»~
@39981 = ~«Я не хочу больше об этом говорить. Прощай».~
@39982 = ~«Чующие! О, они такие *дивные*. Верят, что понимания можно достичь, только испробовав в мультивселенной всё, что сможешь! Попробуй это, послушай то, потрогай это, посмотри на то… и всего этого *так* много, это *настолько* огромное место, что иногда бывает трудно всё это переварить».~
@39983 = ~«У меня другие вопросы…»~
@39984 = ~«Это всё, что я хотел узнать. Прощай».~
@39985 = ~Ненни хихикает.~
@39986 = ~«У меня кое-какие вопросы…»~
@39987 = ~«Прощай, Ненни».~
@39988 = ~«Хм, — Ненни хмурит брови, напряжённо думая. — Я думаю, это имеет смысл. Хотелось бы мне хоть чем-то помочь!»~
@39989 = ~«Что ж, ты *можешь* ответить на мой вопрос…»~
@39990 = ~«Как и мне. Прощай, Ненни…»~
@39991 = ~«Да! Все Чующие могут его делать, но я ещё не совсем Чующая, так что у меня оно не настолько хорошо получается. Когда я усвою эту способность, я смогу брать боль людей на себя, чтобы помогать им и прочее!»~
@39992 = ~«Тогда попробуй».~
@39993 = ~«У меня вопрос…»~
@39994 = ~«Мне пора идти. Прощай».~
@39995 = ~«Понятия не имею! Прости. Хм-м. Может, стоит спросить Джульетту? Они с Кезай раньше были лучшими подругами. Потом Джульетта встретила Монтекки, с тех пор они редко общаются».~
@39996 = ~«У меня ещё вопрос, Ненни…»~
@39997 = ~«Это всё, что я хотел узнать. Прощай».~
@39998 = ~«О, Экко! Она такая загадочная, не *так* ли?! Ты знаешь, что она никогда не разговаривает? Правда! — Ненни наклоняется ближе и понижает голос. — Я думаю, она эмоционально изранена, причём настолько, что может никогда больше не заговорить! Бьюсь об заклад, Долора знает об этом больше, ведь она иногда общается с последним возлюбленным Экко, который знал ту, когда она ещё говорила!»~
@39999 = ~«У меня ещё вопрос, Ненни…»~
@40000 = ~«Это всё, что я хотел узнать. Прощай».~
@40001 = ~«Разговариваю с *тобой*, глупенький! — она хихикает и тыкает тебя в живот. — Точно так же я разговариваю со *всеми* здешними посетителями. Все проститутки разговаривают, в этом весь смысл Борделя! Открывать новые возможности общения, делиться опытом и достигать понимания с другими».~
@40002 = ~«У меня ещё вопрос, Ненни…»~
@40003 = ~«Это всё, что я хотел узнать. Прощай».~
@40004 = ~«М-м… конечно, могу! Бордель Безумной Интеллектуальной Страсти — это школа, которую основала госпожа Падшая Грейс. Проститутки здесь — такие, как я! — обучены всем тонкостям искусства разговора. Всё сделано для того, чтобы узнать побольше о себе и о других. Мне здесь очень нравится… этот непрекращающийся поток новых ощущений, врывающихся в меня и наполняющих голову всё новыми и новыми идеями!»~
@40005 = ~«Может, я ещё вернусь. Прощай».~
@40006 = ~«У меня ещё вопрос, Ненни…»~
@40007 = ~«Это всё, что я хотел узнать. Прощай».~
@40008 = ~«Хм-м, — Ненни мрачнеет. — Я… гм…»~
@40009 = ~«Что?»~
@40010 = ~«О, я просто не могу! Не могу сказать ни о ком ничего дурного! У меня это просто не получается!»~
@40011 = ~«В том, чтобы выдать вора, нет нечего дурного, Ненни».~
@40012 = ~«Забудь… у меня другой вопрос».~
@40013 = ~«Не бери в голову, Ненни. Прощай».~
@40014 = ~«Но я же не знаю, воровка она или нет…» — Ненни прикусывает губу и умоляюще смотрит на тебя, как будто упрашивает перевести разговор на другую тему.~
@40015 = ~«Послушай, почему бы тебе не *попробовать* сказать о ней что-нибудь плохое».~
@40016 = ~«Забудь… у меня другой вопрос».~
@40017 = ~«Не бери в голову, Ненни. Прощай».~
@40018 = ~«Ну хорошо», — Ненни упирает руки в боки и сильно хмурится. Ты стараешься подавить в себе желание засмеяться. «О-о-о, она мне очень, *очень* не нравится, — на мгновение она замолкает и искоса смотрит на тебя, как будто оценивая твою реакцию. — Это звучало достаточно убедительно?»~
@40019 = ~«Нет, не очень…»~
@40020 = ~«Нет. Просто забудь об этом… у меня другой вопрос».~
@40021 = ~«Не бери в голову, Ненни. Прощай».~
@40022 = ~Ненни хмурится. «Так и думала, что у меня ничего не получится! — она поднимает на тебя глаза, полные отчаяния. — Знаешь, насколько *тяжело* говорить о ком-то плохо?! Это так неправильно».~
@40023 = ~«Почему бы тебе не попрактиковаться на мне, Ненни?»~
@40024 = ~«Забудь… у меня другой вопрос».~
@40025 = ~«Не бери в голову, Ненни. Прощай».~
@40026 = ~«Полагаю, я могу попробовать…» — её терзают сомнения. «Ты большая злая противная скотина! — она упирает руки в боки. — Вредина!» Она глядит на тебя: «Ну как?»~
@40027 = ~«Сделай больший акцент на слово „скотина“».~
@40028 = ~«Попробуй меня ударить».~
@40029 = ~«Ты большая злая противная *скотина*!»~
@40030 = ~«Лучше. Теперь ударь меня».~
@40031 = ~Ненни прикрывает рот руками, она выглядит потрясённой. «Ох, у меня не получится! Я не должна! — она моргает. — Да как вообще можно кого-то ударить?»~
@40032 = ~«Попробуй. Сделай это слегка, если тебе так будет проще. Помни: я злая противная скотина. Я этого заслуживаю».~
@40033 = ~Ненни даёт тебе пощечину, ты едва её чувствуешь. Тем не менее она в шоке и боится, что сделала тебе больно: «О, прости меня! Тебе больно? Скажи, что с тобой всё в порядке!»~
@40034 = ~«Не выходи из образа, Ненни. Давай, покажи, на что способна. Ты можешь сказать что-нибудь грубое… просто позволь всему этому выйти наружу».~
@40035 = ~«О! Проклятье, меня ещё никто не бил так сильно!»~
@40036 = ~«Ох… я имею в виду, о!» Ненни выпрямляется во весь свой крошечный рост, сжимает руки в кулаки, упирает их в боки и придаёт своему лицу выражение милой озлобленности. «Да будь ты проклят! Ты заслужил это за все унижения, через которые заставил меня пройти! Уходишь из дома среди ночи, — её глаза блуждают вверх-вниз по твоему телу, — ввязываешься в драки и получаешь эти ужасные шрамы! Что о тебе подумают дети, а?!»~
@40037 = ~«Прекрасно».~
@40038 = ~«Хм… дети?»~
@40039 = ~«О, и не нахваливай меня, как будто я ищу твоего одобрения! Я женщина, которая принадлежит только себе одной, и эта женщина собирается уйти из твоей жизни, если не получит твёрдых обязательств!»~
@40040 = ~«Ладно… для первого раза неплохо, Ненни».~
@40041 = ~«Эй… успокойся. Время утихомирить злость».~
@40042 = ~Ненни бьёт тебя кулаком. Ты еле это чувствуешь. «Вот тебе, — она бьёт ещё раз. — И ещё!» Она бьёт тебя снова и снова, постепенно становясь похожей на машущую кулаками маленькую ветряную мельницу.~
@40043 = ~«Хорошо, хорошо… пора утихомирить злость».~
@40044 = ~Ненни устало вздыхает: «Фух. Это было легче, чем я думала!»~
@40045 = ~«Кроме шуток».~
@40046 = ~«И я уверена, в следующий раз у меня получится лучше! Я так рада, что научилась чему-то новому… благодарю!»~
@40047 = ~«Обращайся ещё. А теперь у меня вопрос…»~
@40048 = ~«Что?!» — ярость Ненни вырастает до нового уровня. «Как ты мог забыть о наших детях?! Настолько отупел от выпивки, что даже не помнишь о том, что у нас есть *дети*?! — Ненни в гневе вскидывает руки. — Ты — безнадёжный, безмозглый и ещё много чего „без“, о чём я прямо сейчас лучше промолчу».~
@40049 = ~«Эй… успокойся. Время утихомирить злость».~
@40050 = ~Глаза Ненни расширяются от ужаса, когда ты морщишься, изображая боль: «Боже мой! Я не хотела тебя так сильно ударить! Прости меня! Прости!»~
@40051 = ~«Никогда не говори „прости“. Скажи: „Тебе придётся к этому привыкнуть“».~
@40052 = ~Ненни поднимает глаза: «Ох… э-э, тебе придётся к этому привыкнуть».~
@40053 = ~«Нахмурься, когда это произносишь. Говори строго, с убеждённостью в голосе».~
@40054 = ~Ненни выпрямляется во весь свой крошечный рост, сжимает руки в кулаки, упирает их в боки и придаёт своему лицу выражение милой озлобленности: «Придётся привыкнуть к такому обращению!»~
@40055 = ~«Прекрасно».~
@40056 = ~«Может быть… я видела, как эта плохая, плохая Марисса однажды ночью выходила из комнаты Вивьен. Не хочу сказать, что это она украла, но я знаю, что Марисса не очень приятная особа. И это, конечно, выглядит подозрительно, да? Я бы пошла и спросила об этом её», — Ненни кивает.~
@40057 = ~«Спасибо, Ненни. У меня ещё вопрос…»~
@40058 = ~«Это всё, что я хотел узнать. Прощай, Ненни».~
@40059 = ~«Бьюсь об заклад, знаю! Однажды ночью я видела, как эта мерзкая Кимази Язык-Гадюки выходила из комнаты Мариссы. Вообще-то они обе противные, но Кимази просто ужасна! В любом случае я бы сначала поговорила именно с ней».~
@40060 = ~«Спасибо, Ненни. У меня ещё вопрос…»~
@40061 = ~«Это всё, что я хотел узнать. Прощай, Ненни».~
@40062 = ~Глаза Ненни неожиданно расширяются: «О! Точно! Однажды я видела мужчину, выходившего из комнаты Кимази, когда её там не было… я наблюдала за входом в Бордель весь этот день, но так и не увидела, чтобы он выходил! Разве это не странно? Не думаю, что он мог выбраться через окно, так что я так и не поняла, куда он исчез. А потом я совсем забыла об этом! Странно, да?»~
@40063 = ~«Да, странно. У меня другой вопрос…»~
@40064 = ~«Так и есть. Прощай, Ненни».~
@40065 = ~«*Рада встрече*, добрый господин! Я Ненни! А как *ты* поживаешь в этот прекрасный д?.. O! Мы уже встречались! — Ненни хихикает, потом радостно тебе улыбается. — Прошу прощения! Я *знала*, что ты выглядишь знакомым, но…»~
@40066 = ~«Всё хорошо, Ненни. У меня пара вопросов…»~
@40067 = ~«Я просто проходил мимо. Прощай, Ненни».~
@40068 = ~Морте вертится вокруг тебя, подшучивая над простотой девушки: «Высшие силы, шеф… она права! Я никогда раньше не замечал… ты весь покрыт *шрамами*!»~
@40069 = ~«Это старые шрамы. Со мной всё в порядке».~
@40070 = ~«Ничего серьёзного, со мной всё будет в порядке».~
@40071 = ~«Да. И очень сильно».~
@40072 = ~«Не обращай внимания. У меня были кое-какие вопросы…»~
@40073 = ~«Не переживай так. Прощай».~
@40074 = ~Морте покачивает бровями: «Ладно, ты тоже слишком „прямолинейна“… может, это как-то связано с этими обвислыми, раскачивающимися гр…»~
@40075 = ~«Морте, это уже чересчур».~
@40076 = ~Морте затыкается.~
@40077 = ~«Никаких проблем, Ненни».~
@40078 = ~«Смотри, чтобы это не повторилось, Ненни».~
@40079 = ~«Никаких проблем, мисс».~
@40080 = ~«Смотри, чтобы это не повторилось, девочка».~
@40081 = ~«Эй!»~
@40082 = ~Морте бормочет себе под нос: «Полагаю, очень хорошо, что там хоть *что-то* есть».~
@40083 = ~«У меня ещё вопрос, Ненни…»~
@40084 = ~«Это всё, что я хотел узнать, Ненни. Прощай».~
@40085 = ~«Ясно. У меня кое-какие вопросы…»~
@40086 = ~«Вообще-то я просто проходил мимо. Прощай».~
@40087 = ~Знатная женщина грациозно приседает в реверансе, заметив твоё приближение: «Здравствуйте ещё раз, сэр».~
@40088 = ~«Да, здравствуй. У меня кое-какие вопросы…»~
@40089 = ~«Рад встрече. Я просто проходил мимо. Прощай».~
@40090 = ~Женщина кивает: «Конечно».~
@40091 = ~«Говоришь, ты здесь посетительница?»~
@40092 = ~«Что ты здесь делаешь?»~
@40093 = ~«Что можешь рассказать мне об этом месте?»~
@40094 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@40095 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@40096 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@40097 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@40098 = ~«Знаешь что-нибудь о Рейвел Клубок-Загадок?»~
@40099 = ~«Я поговорил всего с девятью проститутками… не знаешь, где десятая ученица?»~
@40100 = ~«Неважно. Прощай».~
@40101 = ~Она кивает: «Верно, молодой человек. Однажды я пришла сюда, чтобы своими глазами увидеть, куда постоянно ходит мой муж… быстро подружилась с несколькими проститутками и вот я здесь! Не только мужчины любят интересные разговоры, знаете ли».~
@40102 = ~«Точно подмечено. У меня другой вопрос…»~
@40103 = ~«Наверное. В любом случае прощай».~
@40104 = ~«Бордель — это школа, основанная госпожой Падшей Грейс… она обучает будущих членов Общества Восприятия деликатному искусству владения языком и общением. Если то, что мне сказали — правда, то Бордель содержится за счёт пожертвований его самых богатых клиентов».~
@40105 = ~«Падшей Грейс?»~
@40106 = ~«Расскажи мне об Обществе Восприятия».~
@40107 = ~«Я хочу спросить о другом…»~
@40108 = ~«Это всё, что я хотел узнать. Прощай».~
@40109 = ~Женщина странно смотрит на тебя, но быстро отводит взгляд: «Конечно, вы слышали о них раньше, так ведь? Чующие? Они фракция, которая верит, что испытать всё на собственном опыте — значит получить ключ к пониманию мультивселенной. Штаб-квартира фракции находится в Фестхолле, недалеко отсюда… из Борделя поверните налево, затем снова налево. Многие там охотно расскажут об Обществе Восприятия».~
@40110 = ~«Я хочу спросить о другом…»~
@40111 = ~«Это всё, что я хотел узнать. Прощай».~
@40112 = ~«Я её не знаю… и не могу вспомнить её имени. Мне сказали, что она не говорит, и поэтому я ни разу не пыталась поговорить с ней».~
@40113 = ~«Я хочу спросить о другом…»~
@40114 = ~«Это всё, что я хотел узнать. Прощай».~
@40115 = ~«Рейвел? Я не знаю никого по имени Рейвел, не говоря уже о предполагаемой матери Кезай. Хотя Кезай говорила мне, что она сирота, а её отец, полуизверг, отдал её на воспитание сюда, в Сигил».~
@40116 = ~«Я хочу спросить о другом…»~
@40117 = ~«Это всё, что я хотел узнать. Прощай».~
@40118 = ~«Нет. Вивьен уже не раз упоминала о нём… она так расстроена! Я бы очень хотела, чтобы ей вернули её „личный аромат“, так как она почти ни о чём другом в последнее время не говорит».~
@40119 = ~«Я хочу спросить о другом…»~
@40120 = ~«Это всё, что я хотел узнать. Прощай».~
@40121 = ~Женщина резко хмурится: «О, меня не волнует Марисса… у неё пренеприятный характер, будьте уверены! Что же касается её вуали… я ничего об этом не знаю».~
@40122 = ~«Я хочу спросить о другом…»~
@40123 = ~«Это всё, что я хотел узнать. Прощай».~
@40124 = ~«Рейвел… Клубок-Загадок… — она произносит имя медленно, как будто никогда не произносила его раньше. — Признаться, я ничего о ней не знаю».~
@40125 = ~«Я хочу спросить о другом…»~
@40126 = ~«Это всё, что я хотел узнать. Прощай».~
@40127 = ~«Я знаю только о девяти проститутках… и почти уверена, что говорила со всеми. Возможно, появилась новая девушка, которую я ещё не встречала?..»~
@40128 = ~«Я хочу спросить о другом…»~
@40129 = ~«Это всё, что я хотел узнать. Прощай».~
@40130 = ~«Заглянула поболтать с подругами, вот и всё. Я одна из немногих женщин, посещающих Бордель Безумной Интеллектуальной Страсти».~
@40131 = ~«Ты посетительница?»~
@40132 = ~«Не порекомендуешь мне кого-нибудь?»~
@40133 = ~«Я хочу спросить о другом…»~
@40134 = ~«Это всё, что я хотел узнать. Прощай».~
@40135 = ~«Это зависит от того, с какого рода личностью вам нравится общаться, сэр. Что касается меня — я дружу с Вивьен и Кезай-Серрис, но иногда могу поболтать с этим маленьким милым мотыльком Ненни».~
@40136 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@40137 = ~«Я хочу спросить о другом…»~
@40138 = ~«Это всё, что я хотел узнать. Прощай».~
@40139 = ~«Да… проститутки зовут её мадам Грейс. Обычно она встречает клиентов в фойе Борделя… вы можете найти её там, если пожелаете поговорить».~
@40140 = ~«Я хочу спросить о другом…»~
@40141 = ~«Это всё, что я хотел узнать. Прощай».~
@40142 = ~«Я бы посоветовал относиться ко мне с уважением».~
@40143 = ~«Подумывал, да время впустую тратить жалко. Прощай».~
@40144 = ~«Нет. Прощай».~
@40145 = ~«Ты опять надоедаешь мне своим присутствием. Если бы мне захотелось поговорить с кем-нибудь *твоего* сорта, что ж, таких к востоку отсюда целый район. Теперь оставь меня».~
@40146 = ~«Я бы посоветовал относиться ко мне с уважением».~
@40147 = ~Уйти.~
@40148 = ~Дворянин смотрит на тебя, прищурив глаза: «Меня это не волнует… ни капельки! Теперь убирайся. Уходи, оставь меня в покое».~
@40149 = ~«Я бы посоветовал относиться ко мне с уважением».~
@40150 = ~Уйти.~
@40151 = ~Он закрыает глаза и делает глубокий вздох, словно успокаивая себя: «Если подобное необходимо, чтобы избавиться от тебя, так и быть: будьте настолько *добры*, сэр, я вас очень прошу уйти и поискать себе собеседника *в другом месте*».~
@40152 = ~«Прекрасно… прощай».~
@40153 = ~Уйти.~
@40154 = ~«Привет и прощай».~
@40155 = ~«Ещё раз приветствую, сэр».~
@40156 = ~«Приветствую. У меня кое-какие вопросы…»~
@40157 = ~«Привет и прощай».~
@40158 = ~Он кивает: «Да, продолжайте…»~
@40159 = ~«Откуда у тебя синяк под глазом?»~
@40160 = ~«Что ты здесь делаешь?»~
@40161 = ~«Что можешь рассказать мне об этом месте?»~
@40162 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@40163 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@40164 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@40165 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@40166 = ~«Знаешь что-нибудь о Рейвел Клубок-Загадок?»~
@40167 = ~«Я поговорил всего с девятью проститутками… не знаешь, где десятая ученица?»~
@40168 = ~«Вообще-то неважно. Прощай».~
@40169 = ~Он глупо улыбается: «А, это? Долгая история, сэр. Которая вряд ли будет вам интересна».~
@40170 = ~«Но мне интересно… прошу, расскажи».~
@40171 = ~«Хорошо. У меня был другой вопрос…»~
@40172 = ~«Тогда прощай».~
@40173 = ~Мужчина вздыхает, закатывая глаза: «Хорошо… но я не буду углубляться в подробности. Несмотря на моё прошлое замечание о длине истории, я могу рассказать её в трёх словах: Кимази Язык-Гадюки».~
@40174 = ~«Кто?»~
@40175 = ~«О… да, я её знаю».~
@40176 = ~«Ясно. Я хотел спросить о другом…»~
@40177 = ~«Это всё, что я хотел узнать. Прощай».~
@40178 = ~«А, вам ещё не довелось поговорить с ней, понятно. Тогда я не буду рассказывать о том, насколько очаровательна Кимази, добрый сэр… вместо этого я посоветую вам самому поговорить с ней. Она — одна из местных проституток и самая лучшая ученица леди Грейс», — он улыбается.~
@40179 = ~«Леди Грейс?»~
@40180 = ~«Я хочу спросить о другом…»~
@40181 = ~«Возможно, я разыщу её. Прощай».~
@40182 = ~Мужчина мечтательно вздыхает: «Ну разве она не прекрасна?» Внезапно он спускается с небес на землю: «Но погодите! Не принимайте мою болтовню за любовь, сэр… в конце концов, я помолвлен с женщиной, которую по-настоящему люблю. Но Кимази… она такая… *непохожая* в общении». Он улыбается.~
@40183 = ~«Непохожая… да. У меня другой вопрос…»~
@40184 = ~«Мне пора идти. Прощай».~
@40185 = ~«Ну так наслаждаюсь радостями Борделя! А вы разве нет?»~
@40186 = ~«Радостями?»~
@40187 = ~«Я хочу спросить о другом…»~
@40188 = ~«Это всё, что я хотел узнать. Прощай».~
@40189 = ~«Да, верно… разве вы пришли сюда не для того, чтобы пообщаться с дамами, сэр? Для этого, в конце концов, и был создан Бордель. Чтобы клиенты могли пообщаться с прекрасными ученицами леди Грейс!»~
@40190 = ~«Леди Грейс?»~
@40191 = ~«Я хочу спросить о другом…»~
@40192 = ~«Это всё, что я хотел узнать. Прощай».~
@40193 = ~Мужчина кивает. «Да, и что за зрелище она собой представляет! Да я могу слушать её голос часами! Только Кимази я нахожу более занимательной… — кажется, на мгновение он погружается в мечты. — О! Но, как я уже говорил, леди Грейс — хозяйка Борделя. Наверняка она где-то здесь… идите и поговорите с ней сами. Вы не будете разочарованы, уверяю».~
@40194 = ~«Я хочу спросить о другом…»~
@40195 = ~«Это всё, что я хотел узнать. Прощай».~
@40196 = ~«Какой же гражданин Сигила не знает о Борделе Безумной Интеллектуальной Страсти? Должно быть, вы здесь совсем недавно, сэр, — он вздыхает. — Гуляешь… разговариваешь с дамами… в этом и есть весь смысл Борделя. Если вам интересна история этого места и всё такое, я советую поговорить об этом с леди Грейс».~
@40197 = ~«Леди Грейс?»~
@40198 = ~«Я хочу спросить о другом…»~
@40199 = ~«Это всё, что я хотел узнать. Прощай».~
@40200 = ~Мужчина задумывается. «Никогда не говорил с ней, но думаю, что её зовут „Экко“».~
@40201 = ~«Я хочу спросить о другом…»~
@40202 = ~«Это всё, что я хотел узнать. Прощай».~
@40203 = ~«Рейвел… Рейвел… вы имеете в виду легендарную ночную ведьму? Мне трудно поверить в то, что такое чудовищное создание может быть *чьей-то* матерью, тем более Кезай».~
@40204 = ~«Я хочу спросить о другом…»~
@40205 = ~«Это всё, что я хотел узнать. Прощай».~
@40206 = ~«Она потеряла свой аромат? Странно… я проходил мимо неё пару часов назад, и от неё довольно мило пахло. Как и обычно. На самом деле, я не помню, чтобы когда-либо встречал женщину со столь же заманчивым ароматом».~
@40207 = ~«Вообще-то она потеряла свой *личный* аромат».~
@40208 = ~«Я хочу спросить о другом…»~
@40209 = ~«Это всё, что я хотел узнать. Прощай».~
@40210 = ~«Неужели? Я и понятия не имел, что такое возможно. Ну, я действительно надеюсь, что она получит его обратно!»~
@40211 = ~«Я хочу спросить о другом…»~
@40212 = ~«Мне пора идти. Прощай».~
@40213 = ~«Нет. Хотя должен признаться, Марисса меня немного пугает. Я боюсь, что в её покоях поджидает нечто ужасное и что она просто веселит тебя перед тем, как разорвать на части. Я, например, буду только рад, если она найдёт свою вуаль и будет встречаться с клиентами снаружи, а не в своей тёмной комнате».~
@40214 = ~«Я хочу спросить о другом…»~
@40215 = ~«Мне пора идти. Прощай».~
@40216 = ~«Всё, что я знаю о Рейвел, ограничивается обычными детскими сказками… что она невероятно злая, что она вызвала гнев Госпожи Боли и была навеки изгнана».~
@40217 = ~«Я хочу спросить о другом…»~
@40218 = ~«Мне пора идти. Прощай».~
@40219 = ~«Десятая? Десятая ученица… десятая проститутка… хм-м-м. Нет. Не могу сказать, чтобы я даже слышал о ней, не говоря уже о том, кем она может быть».~
@40220 = ~«Я хочу спросить о другом…»~
@40221 = ~«Мне пора идти. Прощай».~
@40222 = ~«О-о-о, нет… ты просто *обязан* рассказать нам и прямо сейчас».~
@40223 = ~«Да… прошу, расскажи».~
@40224 = ~«Брось, Морте. У меня к нему другой вопрос…»~
@40225 = ~«Забудь об этом, Морте, пошли».~
@40226 = ~Она окидывает тебя быстрым взглядом, прежде чем снова уставиться вдаль. «Приветствую, о да… меня зовут Джульетта. Чем я могу… а впрочем, вздор. Пожалуйста, оставь меня», — она раздражённо вздыхает.~
@40227 = ~«О, вовсе нет. Лишь то, что провожу я день за днём, в лицо обыденности глядя, пытаясь убежать, уйти из череды ужасных серых буден».~
@40228 = ~«Увы, всё так, — она вздыхает, закрыв глаза и массируя виски. — Ужасающе скучна!»~
@40229 = ~«Нет-нет… сколь ни было бы предложение любезным. Ведь есть уже любимый у меня, и чувство наше искренне и нежно. Желаю просто я… — она постукивает пальцем подбородок, — …чего-то *большего* от наших отношений».~
@40230 = ~Она хмурится и закатывает глаза. «Сильно сомневаюсь. Ведь есть уже любимый у меня, и чувство наше искренне и нежно. Желаю просто я… — она постукивает пальцем подбородок, — …чего-то *большего* от наших отношений».~
@40231 = ~Точка отсчёта.~
@40232 = ~«Одной лишь вещи, сударь, *не хватает* мне — волнений. О наших чувствах весть прекрасно приняли семейства наши. Мою родню его родные обожают, ну а друзья все как один твердят, что силы сами освятили наш союз. Прекрасно просто всё, вот только слишком… — она хмурится, — …*гладко*. Не должно чувствам быть совсем уж без проблем».~
@40233 = ~«Да, есть проблема в том… — она вскипает, — …что нет у нас проблем для обсужденья! О наших чувствах весть прекрасно приняли семейства наши. Мою родню его родные обожают, ну а друзья все как один твердят, что силы сами освятили наш союз. Прекрасно просто всё, вот только слишком… — она хмурится, — …*гладко*. Не должно чувствам быть совсем уж без проблем».~
@40234 = ~Точка отсчёта.~
@40235 = ~«В самом деле? А были ль у тебя когда-нибудь такого рода отношенья? — она быстро окидывает тебя взглядом. — Похоже, жизнь твоя полна проблемами иными, коли судить по бледности твоей».~
@40236 = ~«Так обстоят дела, что у моих друзей у всех столь отношенья интересны… там суматоха, тут вражда семей… безумная родня, кинжалы в спину, яд, отцы с мечами наготове. Ну а с возлюбленным моим спокойствие и мир, всеобщая любовь… — она снова вздыхает, — …и вечная досада. Измыслить способ жажду я разнообразить наши отношенья…»~
@40237 = ~«И всё ж желаю я проблемы испытать. Желаю пережить все взлеты и паденья в отношеньях… но только с ним, ни с кем другим, — она вздыхает. — Ах, такова любовь. Тоской зелёной может быть она, а это ни к чему мечтающей в круг Чующих войти».~
@40238 = ~«Не знаю точно я. Опасности, быть может, элемент. Иль ревности. Хм… *напряжённого* чего-то».~
@40239 = ~Она прикусывает губу. «И речи нет о *подлинном* романе, ведь слишком сильно я его люблю! Но может быть… мне стоит ложный завести? — она оглядывает тебя с головы до ног. — По виду твоему, опасность хорошо тебе знакома. Поклонником моим не соизволишь объявиться?»~
@40240 = ~Джульетта хмурится: «Достаточно моей компании и благодарности моей».~
@40241 = ~Новое осложнение заставляет её ещё сильнее нахмурится: «Что в мыслях у тебя… ужель *дотронуться* меня задумал?»~
@40242 = ~Джульетта всё хорошенько взвешивает, затем кивает: «Прекрасно. Получишь нужное, коль мне ты одолжение окажешь. Договорились мы?»~
@40243 = ~«Тогда зашли в тупик переговоры. Уверенность сильна твоя, что передумать не желаешь?»~
@40244 = ~Глаза Джульетты озаряются: «Сколь восхитительна идея эта!» Неожиданно она хмурится: «Но знает почерк мой он… не изволишь написать ты за меня?»~
@40245 = ~«O, неужели будет так? Прекрасно! Когда придумаешь, прошу, отдай любви моей, Монтекки… его найдёшь в Фестхолле городском. Что писем же касается… пожалуй, Своевольный Пенн поможет. В районе Нижнем типографией владеет он. Благодарю тебя!»~
@40246 = ~Джульетта бросает на тебя взгляд, затем усмехается: «О, сильно сомневаюсь я, что… гм. Постой, не столь глупа идея эта, насколько я подумала сперва. И тем не менее, она достаточно *опасна*». Она смотрит тебе прямо в глаза, как будто покупает лошадь: «Настолько ль грозен ты, насколь показывает внешность?»~
@40247 = ~«Так значит, сделаешь ты это для меня?»~
@40248 = ~«Превосходно! В Фестхолле городском найдёшь любовь мою, Монтекки. Благодарю тебя!»~
@40249 = ~Джульетта закатывает глаза: «O, молви, коль нужду имеешь».~
@40250 = ~Джульетта издаёт долгий безнадёжный вздох. Ты понимаешь, что она даже не смотрит на тебя.~
@40251 = ~«М-м? Ох, я прослушала, прощения прошу. Но ты пришёл вестимо не за тем, чтоб чередой вопросов скуку моей жизни тяготить?..»~
@40252 = ~«Готовлюсь в этом месте Чующей я стать. Наставницею Грейс у нас. Все проститутки здесь — её студенты».~
@40253 = ~Джульетта кивает: «Членом Общества Восприятия, той фракции, что ощущениям и опыту посвящена. Пожалуй, ты о Чующих вопросы задай уж лучше Грейс, чем мне».~
@40254 = ~Джульетта довольно улыбается: «Бордель… то школа для стремящихся в круг Чующих войти. Меж тем, тебе о месте этом расскажет лучше Грейс, чем я. Возможно, стоит с ней поговорить?»~
@40255 = ~Джульетта грустно качает головой. «Действительно, какая жалость! Бедняжка. Признаюсь, заходила я не раз в её покои, дабы воспользоваться капелькой духов… но кто посмел у Вивьен личный аромат забрать? Невыносимо грубо! Коль случай выпадет, спроси малышку Ненни. Порхает здесь она везде и видит всех».~
@40256 = ~«Ох, и зачем вообще кому-то эту вещь *искать*? Надеюсь я, коль спросишь, что мегера эта пребудет в заточеньи в комнате своей, покуда не покину это место! Но отвечая на вопрос твой: нет, не видела и представленья не имею, где может быть вуаль. Быть может, Ненни знает, у неё спроси. Порхает здесь она везде и видит всех».~
@40257 = ~«Рейвел? Кто? — Джульетта кажется сбитой с толку. — Неужто это вправду чьё-то имя? Коль так, то Ивес может знать её. Ей ведомо бесчисленное множество историй, возможно, и о „Рейвел“ хоть одна из них гласит».~
@40258 = ~«О ком ты *молвишь*?»~
@40259 = ~«Понятья не имею я, о ком ты».~
@40260 = ~Ты видишь печальную Джульетту, выглядит она как всегда несчастной. Она почти не замечает твоего присутствия, бросив лишь краткий взгляд в твою сторону, прежде чем снова уставиться вдаль.~
@40261 = ~Джульетта с надеждой смотрит на тебя: «Ну что? Какие вести?»~
@40262 = ~Джульетта выглядит потрясённой, минуту спустя она уже всхлипывает и жалостно плачет.~
@40263 = ~Она с трудом подавляет рыдания, вытирает слёзы и смотрит на тебя.~
@40264 = ~«Ты рассказал ему?.. Проклятье! Что теперь мне делать?!»~
@40265 = ~Джульетта кивает. «Похоже, прав ты, да. Благодарить тебя должна».~
@40266 = ~Точка отсчёта.~
@40267 = ~Джульетта выглядит потрясённой: «*Что*… что сказал он?! Как я могла решиться на такое… ох! Похоже, в наших отношениях проблемы были, которых жаждала я, но не замечала в меланхолии своей!»~
@40268 = ~Джульетта разочарованно сжимает зубы: «О-о-о! Сколь моё расстройство велико! Придётся при таком раскладе попробовать мне что-нибудь ещё».~
@40269 = ~Джульетта с надеждой смотрит на тебя: «Ну что? Какие вести?»~
@40270 = ~«Неужто драться за меня он не намерен?»~
@40271 = ~Ты никогда ещё не видел Джульетту в таком ужасном состоянии. Её лицо осунулось и побледнело, под покрасневшими глазами — чёрные круги. Она улыбается наигранной улыбкой, как будто пытается произвести приятное впечатление.~
@40272 = ~«Приветствую. Должно быть, есть вопросы у тебя, я верно понимаю?»~
@40273 = ~«Рейвел… хм… a! Мыслю, где-то слышала уже я это имя. Не знаю я всей правды, но *ходили* слухи. Коль знать желаешь, ты Кимази Язык-Гадюки вопроси… они наполовину сёстры».~
@40274 = ~«O, ты об Экко вопрошаешь. Молва идёт, что по неведомой причине ни слова больше поклялась не говорить она. Я даже не могу себе представить, подвигло что её на этот шаг».~
@40275 = ~Морте подлетает ближе и шепчет: «Жаль мне её любовника. Он даже не представляет, насколько у неё всё запущено. Такая девчонка — сама по себе источник проблем».~
@40276 = ~«Звучит не очень мудро, Джульетта. Довольствуйся тем, что имеешь».~
@40277 = ~«Что ты задумала, Джульетта?»~
@40278 = ~«У меня пара вопросов, Джульетта…»~
@40279 = ~«Это всё, что я хотел узнать, Джульетта. Прощай».~
@40280 = ~«Что-то не так?»~
@40281 = ~«Сначала я бы задал пару вопросов…»~
@40282 = ~«Хорошо, прощай».~
@40283 = ~«Твоя жизнь действительно настолько скучна?»~
@40284 = ~«Ясно. Я хотел спросить…»~
@40285 = ~«Это всё, что я хотел узнать. Прощай».~
@40286 = ~«Возможно, я смогу сделать её менее скучной, моя леди».~
@40287 = ~«Уверен, я смогу приукрасить твою жизнь волнениями…»~
@40288 = ~«Уверен, я смогу приукрасить твою жизнь волнениями…»~
@40289 = ~«Ясно. Я хотел спросить…»~
@40290 = ~«Это всё, что я хотел узнать. Прощай».~
@40291 = ~~
@40292 = ~~
@40293 = ~~
@40294 = ~~
@40295 = ~~
@40296 = ~~
@40297 = ~~
@40298 = ~«Я не припомню, чтобы у меня с кем-то были настоящие отношения».~
@40299 = ~«Я не припомню, чтобы у меня с кем-то были настоящие отношения. В остатках воспоминания о некоторых одни лишь проблемы».~
@40300 = ~«Ясно. Я хотел спросить…»~
@40301 = ~«Это всё, что я хотел узнать. Прощай».~
@40302 = ~«Звучит не очень мудро. Довольствуйся тем, что имеешь».~
@40303 = ~«Что ты имеешь в виду?»~
@40304 = ~«Ясно. Я хотел спросить…»~
@40305 = ~«Это всё, что я хотел узнать. Прощай».~
@40306 = ~«Аххх боллен… варгуллль укусиллла… так боллен…»~
@40307 = ~«И каким образом ты хочешь разнообразить отношения?»~
@40308 = ~«Ты мечтаешь стать Чующей?»~
@40309 = ~«Ясно. Я хотел спросить…»~
@40310 = ~«Это всё, что я хотел узнать. Прощай».~
@40311 = ~«Почему бы тебе не завести роман?»~
@40312 = ~«Почему бы тебе не сочинить пару ложных любовных писем, как будто у тебя тайный роман?»~
@40313 = ~«Я могу притвориться ревнивым ухажёром, если хочешь».~
@40314 = ~«Ясно. Я хотел спросить…»~
@40315 = ~«Удачи тебе. Прощай».~
@40316 = ~«Хорошо, я это сделаю».~
@40317 = ~«А что мне с того?»~
@40318 = ~«Нет… но у меня пара вопросов…»~
@40319 = ~«Нет, не хочу. Прощай».~
@40320 = ~«Хорошо, тогда я это сделаю».~
@40321 = ~«Нет».~
@40322 = ~«Забудь. У меня пара вопросов…»~
@40323 = ~«Нет, не хочу. Прощай».~
@40324 = ~«Не льсти себе больше, чем хватит меня разозлить. Мне нужна информация».~
@40325 = ~«Мне нужна информация».~
@40326 = ~«Согласен».~
@40327 = ~«Нет, так не пойдёт».~
@40328 = ~«Ладно… я это сделаю».~
@40329 = ~«Нет, прости. У меня пара вопросов…»~
@40330 = ~«Нет. Прощай, Джульетта».~
@40331 = ~«Я в таком не силён. Хотя попробую что-нибудь придумать».~
@40332 = ~«Вообще-то забудь. У меня пара вопросов…»~
@40333 = ~«Я предпочту отказаться. Прощай, Джульетта».~
@40334 = ~«Конечно. Прощай».~
@40335 = ~«Уверяю тебя, я круче, чем выгляжу».~
@40336 = ~«Да».~
@40337 = ~«Да, сделаю».~
@40338 = ~«Ну, а что мне с этого будет?»~
@40339 = ~«Вообще-то… нет. Но у меня пара вопросов…»~
@40340 = ~«Ох… это звучит не очень-то хорошо…»~
@40341 = ~«Конечно. Пойду поговорю с ним… до свидания».~
@40342 = ~«Что ты здесь делаешь?»~
@40343 = ~«Можешь рассказать мне об этом месте?»~
@40344 = ~«Можешь мне что-нибудь рассказать о молчаливой проститутке?»~
@40345 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@40346 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@40347 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@40348 = ~«Знаешь что-нибудь о Рейвел Клубок-Загадок?»~
@40349 = ~«Я уже говорил с девятью проститутками… ты не знаешь, где десятая ученица?»~
@40350 = ~«Что ты здесь делаешь?»~
@40351 = ~«Можешь рассказать мне об этом месте?»~
@40352 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@40353 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@40354 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@40355 = ~«Знаешь что-нибудь о Рейвел Клубок-Загадок?»~
@40356 = ~«Я уже говорил с девятью проститутками… ты не знаешь, где десятая ученица?»~
@40357 = ~«Не бери в голову. Прощай».~
@40358 = ~«Джульетта? Ты меня слышишь?»~
@40359 = ~«Неважно. Прощай».~
@40360 = ~«Твоя жизнь действительно настолько скучна?»~
@40361 = ~«Вообще-то да, у меня были вопросы…»~
@40362 = ~«Это всё, что я хотел узнать. Прощай».~
@40363 = ~«Чующей?»~
@40364 = ~«У меня вопрос о другом…»~
@40365 = ~«Это всё, что я хотел узнать. Прощай».~
@40366 = ~«У меня вопрос о другом…»~
@40367 = ~«Это всё, что я хотел узнать. Прощай».~
