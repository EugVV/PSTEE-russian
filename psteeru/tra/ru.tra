@42928 = ~~
@42929 = ~«Я бы предложил не замечать девчонку… быть холодным и невозмутимым. Это сильно оживит отношения!»~
@42930 = ~«Доверься мне, парень. Не обращай на неё внимания, придумай повод для разногласий, пусть гадает. Она за соломинку будет хвататься, чтобы понять в чём дело. Верно, шеф?»~
@42931 = ~«Да… она подумает, будто что-то не так, и хоть раз он будет игроком, а не мишенью».~
@42932 = ~«Нет… это плохая идея».~
@42933 = ~Повертеть игрушку и дождаться какого-нибудь эффекта.~
@42934 = ~Повертеть игрушку и дождаться какого-нибудь эффекта.~
@42935 = ~Повертеть игрушку и дождаться какого-нибудь эффекта.~
@42936 = ~Согнуть правое колено до угла в пятнадцать градусов, после чего максимально расправить крылья, а потом развернуть правую руку на 180 градусов.~
@42937 = ~Повертеть игрушку и дождаться какого-нибудь эффекта.~
@42938 = ~Ты вертишь игрушку в руках, замечая, что её конечности часто внезапно возвращаются в исходную позицию. Наконец, когда ты сгибаешь её левое колено, игрушка издаёт странный *хлопок* и начинает дрожать в твоих руках…~
@42939 = ~~
@42940 = ~Покрутить левую руку.~
@42941 = ~~
@42942 = ~Покрутить правую руку.~
@42943 = ~Расправить левое крыло.~
@42944 = ~Расправить правое крыло.~
@42945 = ~~
@42946 = ~~
@42947 = ~Согнуть правое колено.~
@42948 = ~~
@42949 = ~Спрятать куб.~
@42950 = ~Неожиданно конечности игрушки возвращаются в исходную позицию, издав *щелчок*.~
@42951 = ~~
@42952 = ~Покрутить левую руку.~
@42953 = ~~
@42954 = ~Покрутить правую руку.~
@42955 = ~Расправить левое крыло.~
@42956 = ~Расправить правое крыло.~
@42957 = ~Согнуть левое колено.~
@42958 = ~~
@42959 = ~Согнуть правое колено.~
@42960 = ~~
@42961 = ~Спрятать куб.~
@42962 = ~Игрушка издаёт странный *хлопок* и начинает дрожать в твоих руках.~
@42963 = ~~
@42964 = ~Покрутить левую руку.~
@42965 = ~~
@42966 = ~Покрутить правую руку.~
@42967 = ~Расправить левое крыло.~
@42968 = ~Расправить правое крыло.~
@42969 = ~~
@42970 = ~~
@42971 = ~Согнуть правое колено.~
@42972 = ~~
@42973 = ~Спрятать куб.~
@42974 = ~Игрушка издаёт тихое *жужжание*.~
@42975 = ~~
@42976 = ~Покрутить левую руку.~
@42977 = ~~
@42978 = ~Покрутить правую руку.~
@42979 = ~~
@42980 = ~Расправить правое крыло.~
@42981 = ~~
@42982 = ~~
@42983 = ~Согнуть правое колено.~
@42984 = ~~
@42985 = ~Спрятать куб.~
@42986 = ~Игрушка тихо *хмыкает* и становится тёплой на ощупь.~
@42987 = ~Покрутить левую руку.~
@42988 = ~~
@42989 = ~~
@42990 = ~Покрутить правую руку.~
@42991 = ~~
@42992 = ~~
@42993 = ~~
@42994 = ~~
@42995 = ~Согнуть правое колено.~
@42996 = ~~
@42997 = ~Спрятать куб.~
@42998 = ~Слышится *вж-ж-ж*, потом *щелчок*, и вдруг у тебя в руках вспыхивает ослепительный белый свет…~
@42999 = ~«Чт!..»~
@43000 = ~Эта особа пристально смотрит на прикреплённый к стене металлический лист. За отчаянными попытками концентрации следуют взмахи руками и произнесение с выражением «волшебных слов»… безо всякого эффекта. Несмотря на это, упорная тренировка продолжается, о разговоре не стоит и заикаться.~
@43001 = ~Уйти.~
@43002 = ~У этой особы целая кипа бумаг и развёрнутых свитков; редкие перерывы проходят в их переборе и чтении некоторых отрывков вслух, сопровождаемом неловкими пассами рук. Когда ты подходишь ближе, взгляд поднимается на тебя: «Приветствую…»~
@43003 = ~«Приветствую… что это за место?»~
@43004 = ~«Я просто проходил мимо. Прощай».~
@43005 = ~«Сюда приходят для тренировки и обучения стремящиеся стать магами. Многие волшебники делали здесь свои первые шаги в Искусстве, проходили становление как колдуны».~
@43006 = ~«Где учитель?»~
@43007 = ~«Это всё, что я хотел узнать. Прощай».~
@43008 = ~«Я не знаю, куда ушла леди Торнкомб. Думаю, тебе стоит посмотреть в сенсориумах… она проводит там очень много времени… — начинающий маг понижает голос и хмурится. — Возможно, даже чересчур».~
@43009 = ~«Сенсориумах?»~
@43010 = ~«Это всё, что я хотел узнать. Прощай».~
@43011 = ~«Спроси о них у Сплинтера, стоящего прямо около входа в Фестхолл. Сам ты туда не пройдёшь, но он может тебя отвести».~
@43012 = ~«Это всё, что я хотел узнать. Прощай».~
@43013 = ~Эта особа пытается залезть в карманы набивного манекена, установленного на подставке и обвешанного множеством колокольчиков. При каждом неаккуратном прикосновении к манекену они громко звенят.~
@43014 = ~Уйти.~
@43015 = ~Воришка небрежно оглядывает обвешанные колокольчиками манекены, раскиданные по всему помещению и используемые для практических занятий. Когда ты подходишь достаточно близко, взгляд падает на тебя: «Хм?»~
@43016 = ~«Что это за место?»~
@43017 = ~«Не обращай внимания… просто проходил мимо. Прощай».~
@43018 = ~«Это зал для тренировки воров. Вон те куклы используются для упражнений по разрезанию сумок и обчистке карманов».~
@43019 = ~«Где учитель?»~
@43020 = ~«Это всё, что я хотел узнать. Прощай».~
@43021 = ~«Скорее всего, прямо сейчас шляется по району… что-то его расстроило, и он выбежал из Фестхолла, ругаясь на чём свет стоит. Его зовут Хэвлок, Эли Хэвлок. Он худой, среднего роста, с тёмными волосами, смуглой кожей и резкими чертами лица».~
@43022 = ~«Это всё, что я хотел узнать. Прощай».~
@43023 = ~Эта особа отрабатывает различные боевые приёмы на деревянном манекене. Кажется, о разговорах тут не может быть и речи.~
@43024 = ~Уйти.~
@43025 = ~Этот вояка тяжело дышит и весь блестит от пота, будто только что закончил какое-то особо трудное упражнение. Завидев твоё приближение, он поворачивается: «Да?»~
@43026 = ~«Что это за место?»~
@43027 = ~«Не бери в голову… просто проходил мимо. Прощай».~
@43028 = ~Он кивает в сторону тренировочных манекенов: «Зал для тренировки воинов».~
@43029 = ~«Где учитель?»~
@43030 = ~«Это всё, что я хотел узнать. Прощай».~
@43031 = ~«Кви-Сай? — он пожимает плечами, вытирая пот со лба. — Где-то в Фестхолле, скорее всего. Его ни с кем не спутаешь… кожа как серый камень».~
@43032 = ~«Это всё, что я хотел узнать. Прощай».~
@43033 = ~Он хмурится и на минуту задумывается. «Что ж, анархисты разбросаны по всему городу, гражданин. Пока они не нарушают закон, с ними ничего нельзя поделать».~
@43034 = ~«Я думал, они считаются опасным элементом, к которым нужно принимать меры, пока не натворили беды?»~
@43035 = ~«Их предводитель попросил меня убить офицера Гармониума Третьей Ступени Вортена».~
@43036 = ~«Я могу поручиться, что это они в ответе за убийство Третьей Ступени Вортена».~
@43037 = ~«Я могу поручиться, что это они в ответе за убийство Третьей Ступени Вортена».~
@43038 = ~«Ясно. Я хотел спросить о другом…»~
@43039 = ~«Мне пора идти. Прощай».~
@43040 = ~Он вздыхает: «Я согласен с такой точкой зрения, гражданин. Хотя лично я не одобряю преследование людей и рублю голов без всяких доказательств. Если ты дашь мне основание, я прослежу, чтобы с этими анархистами разделались. В противном случае у них есть право на свободу слова и собраний».~
@43041 = ~«Ясно. Я хотел спросить о другом…»~
@43042 = ~«Мне пора идти. Прощай».~
@43043 = ~Он озабоченно на тебя смотрит: «Это очень серьёзное обвинение, гражданин. Ты уверен, что хочешь сделать такое заявление?»~
@43044 = ~«Да».~
@43045 = ~«Нет, думаю, нет».~
@43046 = ~«Хорошо. Я прослежу, чтобы с анархистами разобрались. Отличная работа, гражданин», — он улыбается.~
@43047 = ~«Спасибо. Прощай».~
@43048 = ~Он пожимает плечами: «В таком случае обсуждать больше нечего».~
@43049 = ~«Ладно. Прощай».~
@43050 = ~«Откуда ты можешь об этом знать… если только ты сам не участвовал в этом деле? — он пристально смотрит на тебя некоторое время, затем продолжает. — Так как ты мой друг, я забуду, от кого это услышал. Между тем, я прослежу, чтобы с этими анархистами разделались. Всего хорошего, гражданин».~
@43051 = ~«Прощай».~
@43052 = ~«Прощай».~
@43053 = ~«Откуда ты можешь об этом знать… если только ты сам не участвовал в этом деле? — он пристально смотрит на тебя некоторое время, затем продолжает. — Я прослежу, чтобы с этими анархистами разделались, гражданин. Всего хорошего».~
@43054 = ~«Прощай».~
@43055 = ~«Спасибо за помощь. Может, я с тобой ещё увижусь… или кто-нибудь из моих друзей. Нас можно найти в любом месте».~
@43056 = ~«У меня к тебе вопросы…»~
@43057 = ~«Тогда прощай».~
@43058 = ~«У нас впереди ещё долгий путь, прежде чем попадём на склад. Что тебе нужно?»~
@43059 = ~«У меня пара вопросов…»~
@43060 = ~«Ничего».~
@43061 = ~Инженер смотрит на тебя с презрением: «Убирайся! У меня нет времени на таких, как ты!»~
@43062 = ~Напасть на неё.~
@43063 = ~Уйти.~
@43064 = ~Она безучастно смотрит на тебя, не говоря ни слова, ожидая прибытия охраны.~
@43065 = ~«У меня к тебе вопросы…»~
@43066 = ~«Прощай».~
@43067 = ~Она продолжает глазеть на тебя: «Прямо сейчас мне нечего тебе ответить. Может, когда ты вернёшься».~
@43068 = ~«Тогда прощай».~
@43069 = ~«Ну, ты придумал, как нам отсюда выбраться? Меня не выпустят в таком виде. Мне нужно как-то замаскироваться».~
@43070 = ~«Есть соображения, как будешь маскироваться?»~
@43071 = ~«Я нашёл одежду кузнеца. Надень её».~
@43072 = ~«Пока нет. У меня были к тебе ещё вопросы…»~
@43073 = ~«Нет, ещё нет. Прощай».~
@43074 = ~«Здесь не задерживают выходящих кузнецов. Если бы ты смог раздобыть для меня полный набор инструментов и запасные шмотки… но я не знаю, где всё это можно раздобыть. Постарайся больше никого не убивать, ладно? Я и так причинила немало проблем и не хочу, чтобы об этом стало известно по всему городу. Другими словами, не убивай кузнецов, чтобы забрать у них одежду — я в любом случае сомневаюсь, что она мне подойдёт».~
@43075 = ~«Я нашёл одежду кузнеца. Надень её».~
@43076 = ~«Хорошо. Посмотрим, что я смогу сделать. А пока ответь мне на кое-какие вопросы…»~
@43077 = ~«Ладно. Посмотрим, что тут можно сделать. До встречи».~
@43078 = ~«Я надену её, как только мы будем готовы выйти отсюда. Что ещё? Тебе придётся меня отсюда вывести».~
@43079 = ~«Хорошо, пошли».~
@43080 = ~~
@43081 = ~~
@43082 = ~«Мы пройдём через парадный вход, а затем отправимся на склад, где нас будут ждать мои друзья. Ты готов?»~
@43083 = ~«Пошли».~
@43084 = ~«Что ты хотел знать?»~
@43085 = ~«Расскажи мне о Революционной Лиге».~
@43086 = ~«Расскажи мне о Боготах».~
@43087 = ~«Зачем вам все эти разрушения?»~
@43088 = ~«Расскажи мне о себе».~
@43089 = ~«Что насчёт Сароса?»~
@43090 = ~«Ничего. Прощай».~
@43091 = ~Она щурит глаза, как будто оценивая тебя, и говорит: «Мы верим в то, что власть коррумпирована по своей природе. Мы существуем для того, чтобы уничтожать власть там, где она может появиться. Таким образом фракции Сигила — наша главная цель. Они монополизировали Город Дверей, город, который должен быть открыт для каждого, кто проходит мимо. Вместо этого они обрушиваются на тех, кто осмеливается говорить открыто, и умалчивают о тех, кто пляшет под их дудку. Властная структура Сигила должна быть разрушена!»~
@43092 = ~«Какова структура Революционной Лиги?»~
@43093 = ~«Как ты вообще примкнула к этим людям?»~
@43094 = ~«А почему бы не сотрудничать с системой, чтобы изменить её?»~
@43095 = ~«Как можно присоединиться к Революционной Лиге?»~
@43096 = ~«У меня другие вопросы…»~
@43097 = ~«Это всё, что я хотел знать. Прощай».~
@43098 = ~«Мой отец, Свободный Легионер, был убит за то, что не согласился со Стражем Судьбы. Убийцу так и не наказали. Моя мать требовала справедливости, но была арестована за беспорядки Твердоголовыми. Коррумпированный судья признал её виновной в нарушении спокойствия и создании анархии, так что она была казнена Убийцами Милосердия. Естественно, что я отправилась на поиски Анархистов: только у них есть ответы на все мои вопросы».~
@43099 = ~Покрутить правую руку.~
@43100 = ~«А почему бы не сотрудничать с системой, чтобы изменить её?»~
@43101 = ~«Как можно присоединиться к Революционной Лиге?»~
@43102 = ~«У меня другие вопросы…»~
@43103 = ~«Это всё, что я хотел знать. Прощай».~
@43104 = ~«С такой системой? Коррупция сожрёт тебя раньше, чем сможешь хоть на что-то повлиять. Эта система не заинтересована в чём бы то ни было, уменьшающем её власть. Такова природа людей: они хотят иметь власть и не хотят ею делиться, и неважно, кто пострадает в процессе. Скажешь слово против фракций — и ты труп быстрее, чем успеешь перевести дыхание. Гораздо лучше избавиться от всего этого и создать заново».~
@43105 = ~«Но при этом пострадает множество невинных».~
@43106 = ~«Как ты вообще примкнула к Анархистам?»~
@43107 = ~«Как можно присоединиться к Революционной Лиге?»~
@43108 = ~«У меня другие вопросы…»~
@43109 = ~«Это всё, что я хотел знать. Прощай».~
@43110 = ~Она на тебя смотрит с сомнением. «Присоединиться к нам? Хм-м. Ты сделал достаточно, чтобы впутаться, если вдруг когда-нибудь решишься обмануть нас, поэтому пользы от тебя нам в любом случае было бы больше, чем вреда, — она снова ненадолго прерывается в раздумьях. — Хорошо. Иди поговори с Своевольным Пенном в печатной мастерской. Передай ему мои слова: „Город должен гореть“. Он тебя поймёт». Её взгляд ожесточается: «Но я тебя предупреждаю: если *что-нибудь* со мной случится, эта фраза не будет стоить и двух медяков».~
@43111 = ~«„Город должен гореть“. Хорошо. У меня были ещё вопросы».~
@43112 = ~«„Город должен гореть“. Хорошо. Прощай».~
@43113 = ~Она усмехается. «Если бы тебя правда заботили невинные, ты не стал бы мне помогать. Как насчёт всех тех рабочих, которых убил ТЫ, когда уничтожил оружие в Кузнице? На любой войне страдают невинные — но если ты с нами, у них по крайней мере будет шанс оправиться. Под властью фракций они погибнут все».~
@43114 = ~«Как ты вообще примкнула к Анархистам?»~
@43115 = ~«Как можно присоединиться к Революционной Лиге?»~
@43116 = ~«У меня другие вопросы…»~
@43117 = ~«Это всё, что я хотел знать. Прощай».~
@43118 = ~«Мы разбиты на ячейки, численность каждой ячейки неизвестна. Люди в одной ячейке не знают людей из другой ячейки, так мы исключаем предательство. Конечно, иногда мы работаем над общими целями, но мы достаточно деморализуем ненавистные фракции, чтобы оно того стоило».~
@43119 = ~«Не думаешь, что из-за ваших групповых акций фракции становятся более воинственными и коррумпированными?»~
@43120 = ~«Как ты вообще примкнула к Анархистам?»~
@43121 = ~«Почему бы не сотрудничать с системой, чтобы изменить её?»~
@43122 = ~«Как можно присоединиться к Революционной Лиге?»~
@43123 = ~«У меня другие вопросы…»~
@43124 = ~«Это всё, что я хотел знать. Прощай».~
@43125 = ~«Нет. Их лицемерие видно невооружённым глазом, хотя бы, когда они пытаются уничтожить тех самых людей, которых поклялись защищать. Те, кто должен защищать законы Сигила, первыми нарушают их, когда им угрожает опасность. Мы и пытаемся показать людям, что всё это шито белыми нитками. Мы выступаем катализатором, а не причиной».~
@43126 = ~«Как ты вообще примкнула к Анархистам?»~
@43127 = ~«Почему бы не сотрудничать с системой, чтобы изменить её?»~
@43128 = ~«Как можно присоединиться к Революционной Лиге?»~
@43129 = ~«У меня другие вопросы…»~
@43130 = ~«Это всё, что я хотел знать. Прощай».~
@43131 = ~«Боготы? Ха. Остальные фракции хотя бы делают вид, что знают ответ на вопрос. Боготы ещё хуже: они становятся на пути у каждого, кто пытается постигнуть большую тайну, в то время как сами не имеют о ней никакого понятия. Собаки на сене, ничего больше. Хуже того, они загрязняют Нижний район, наполняя его этим смертоносным дымом, которых убивает пожилых и слабых. Они считают себя полезными, но правда в том, что несут они только смерть».~
@43132 = ~«Хорошо. У меня другие вопросы…»~
@43133 = ~«Ясно. Прощай».~
@43134 = ~«Затем, что старые порядки должны быть уничтожены. Уничтожением части штаб-квартиры фракции я помогаю людям потерять веру в Боготов. Уничтожением этого ужасного оружия я помогаю им потерять доверие к Боготам. Убийством управляющего я показываю остальным, что те, кто занимает высокое положение, и есть цель и никто не должен выступать в поддержку вышестоящих в коррумпированной системе, если не хотят стать следующими жертвами. Каждая из этих акций является символической. Ни одна из них не является разрушением ради разрушения. Тогда бы мы были ничем не лучше Стражей Судьбы».~
@43135 = ~«Кого-кого?»~
@43136 = ~«У меня другие вопросы…»~
@43137 = ~«Прощай».~
@43138 = ~«Стражей Судьбы. Группы людей, которые думают, что по причине распадания всего в этом мире на части их задача — не допустить усиления центра. Номинально мы в союзе с ними, но правда в том, что и они падут. В конце концов все они будут уничтожены».~
@43139 = ~«Хорошо. У меня другие вопросы…»~
@43140 = ~«Прощай».~
@43141 = ~«О себе? Мне не придётся долго рассказывать. Я поклялась, что собственными глазами увижу падение фракций, и прошла курс магической инженерии, что сделало меня ценной для любой фракции. До Боготов были ещё и другие, много других. У меня было больше масок, чем я могу припомнить, и больше имён, чем записано в книге мёртвых. Я даже не могу назвать тебе имена всех, кого я предала».~
@43142 = ~«Звучит впечатляюще. Ты этим счастлива?»~
@43143 = ~«Ясно. У меня другие вопросы».~
@43144 = ~«Должно быть, это очень весело. Прощай».~
@43145 = ~Она горько усмехается, затем коротко отвечает: «Счастлива? С каких это пор такая жизнь стала иметь отношение к счастью?»~
@43146 = ~«Если ты несчастна, почему бы тебе не прекратить этим заниматься?»~
@43147 = ~«Никогда. Счастье — это ложный идеал, созданный, чтобы оказывать влияние на слабых. Настоящего счастья не существует».~
@43148 = ~«Ты права. Забудь. У меня были другие вопросы…»~
@43149 = ~«Хорошая мысль. Прощай».~
@43150 = ~«Прекратить этим заниматься? И забыть про месть? Это определяет мою сущность. Это и есть я. Всё равно, что попросить тебя отрезать руку и остаться самим собой, — она оглядывает твои шрамы. — Хотя ты, вероятно, смог бы это провернуть».~
@43151 = ~«Так ты позволишь горечи и ненависти контролировать тебя?»~
@43152 = ~«Вероятно. У меня были другие вопросы».~
@43153 = ~«Возможно. Прощай».~
@43154 = ~«Это стало частью меня. Без этого я никто».~
@43155 = ~«Выбери ещё что-нибудь и стань большим, чем ты есть».~
@43156 = ~ударили~
@43157 = ~«Ну и лелей свою горечь, позволь ей управлять собой. Причини ещё больше страданий. Мне всё равно».~
@43158 = ~Серьезно Ранен~
@43159 = ~Умер~
@43160 = ~«Ладно. У меня были другие вопросы…»~
@43161 = ~- Цель Исчезла~
@43162 = ~- Оружие Исчезло~
@43163 = ~«Тогда прощай».~
@43164 = ~- Раунд Окончен~
@43165 = ~«Я… я не знаю как».~
@43166 = ~Эта дверь закрыта.~
@43167 = ~«Просто попробуй. Попробуй и узнаешь».~
@43168 = ~«Тогда можешь с тем же успехом себя убить, потому что нет смысла в жизни, если не можешь измениться».~
@43169 = ~«Тогда ладно. У меня были другие вопросы…»~
@43170 = ~«Тогда и не пытайся. Прощай».~
@43171 = ~«Согласна. Нас учат, что счастье — окончательная цель нашей борьбы, однако столь немногие его достигают… оно доступно только слабоумным и самодовольным, тем, кто не способен открыть глаза на ужасы мира вокруг. Лучше страдать, чем платить *такую* цену за счастье».~
@43172 = ~«Верно подмечено. У меня были другие вопросы…»~
@43173 = ~«Да. Прощай».~
@43174 = ~«Не должно быть всё равно. Апатия и есть то зло, против которого мы боремся. Всего хорошего».~
@43175 = ~«Прощай».~
@43176 = ~«Я подумаю над этим. Но ничего не гарантирую. Прощай, путник. Ты дал мне пищу для размышлений».~
@43177 = ~«Я надеюсь. Прощай».~
@43178 = ~«Я задумалась над этим и поняла, что хотя бы делаю доброе дело, в которое верю. Этого для меня достаточно. Прощай».~
@43179 = ~«Прощай».~
@43180 = ~Она презрительно на тебя смотрит и усмехается: «Что, передумал, или тебе от меня ещё что-нибудь понадобилось?»~
@43181 = ~«Передумал. Я убью его для тебя».~
@43182 = ~«У меня кое-какие вопросы…»~
@43183 = ~«Ни то ни другое. Забудь и прощай».~
@43184 = ~«У тебя уже был шанс. Неужели ты думаешь, что теперь я доверю тебе такое дело? Я так не думаю. Уйди с глаз моих».~
@43185 = ~«Тогда ответь на мои вопросы».~
@43186 = ~«Тогда прощай».~
@43187 = ~«Если ты не поможешь мне, почему я должна помогать тебе? Всего хорошего, сэр».~
@43188 = ~«Всего хорошего».~
@43189 = ~«Ты уже записал имя Сандоза в книгу мёртвых?»~
@43190 = ~«Да. Он мёртв».~
@43191 = ~«Пока нет. У меня кое-какие вопросы».~
@43192 = ~«Ещё нет. Прощай».~
@43193 = ~«Уж не решил ли ты взяться за работу?»~
@43194 = ~«Да, я это сделаю».~
@43195 = ~«Нет, я отказываюсь».~
@43196 = ~«Пока нет. У меня были ещё вопросы».~
@43197 = ~«Нет, ещё нет. Прощай».~
@43198 = ~«Я хочу, чтоб ты выполнил всего одно задание, и мы оставим Боготов с их неурядицами. Мне нужно, чтобы ты вывел меня из этого места. Охранникам нужно будет свалить на кого-то вину, и я не хочу, чтобы они выбрали тебя. Когда я исчезну, они подумают, что виновата я, а ты будешь вне подозрений. Что скажешь?»~
@43199 = ~«Дай мне время обдумать».~
@43200 = ~«Да. Я сделаю это. Что конкретно от меня нужно?»~
@43201 = ~«Нет. Мне кажется, ты пытаешься свалить всё на меня».~
@43202 = ~«Мне нужно выбраться из Кузницы. Ты мне поможешь? Я требую ответа НЕМЕДЛЕННО».~
@43203 = ~«Вот дьявол… ладно».~
@43204 = ~«Нет. Мне кажется, ты пытаешься свалить всё на меня».~
@43205 = ~«Я сказал, дай мне время. Прощай».~
@43206 = ~«Если не собираешься помогать мне выбраться, мне больше нечего тебе сказать».~
@43207 = ~«Ну ладно. Я помогу тебе выбраться».~
@43208 = ~«Нет. Не собираюсь».~
@43209 = ~~
@43210 = ~«В таком случае мне больше нечего тебе сказать».~
@43211 = ~«Тогда прощай».~
@43212 = ~«Ещё вопросы? Разве тебе не нужно кое о чём позаботиться?»~
@43213 = ~«Расскажи мне о себе».~
@43214 = ~«Почему я должен это делать?»~
@43215 = ~«Зачем мне это делать?»~
@43216 = ~«Что ты имеешь против Боготов?»~
@43217 = ~«Неважно. Прощай».~
@43218 = ~«Меня зовут Бедай-Лин. Я магический инженер; не маг — прошу не путать — а теоретик. И я намерена проследить, чтобы Боготам больше не представлялось случая использовать такое оружие или подписывать договор о поставке подобных средств войны».~
@43219 = ~«Зачем его убивать?»~
@43220 = ~«Зачем уничтожать машину?»~
@43221 = ~«Хорошо. Ответь ещё на вопрос…»~
@43222 = ~«Ясно. Прощай».~
@43223 = ~«Потому что договоры, которые Боготы подписывают со своими заказчиками, являются злом. Боготы позволяют себе притворяться, что их действия не будут иметь последствий. Что ж, они будут иметь последствия, и я покажу им, какие. Я сделаю так, чтобы человек, несущий ответственность за подписание договора, не прожил достаточно долго, чтобы подписать ещё один».~
@43224 = ~«Хорошо. Я всё сделаю».~
@43225 = ~«Не думаю, что хочу это делать».~
@43226 = ~«Хорошо. У меня другие вопросы…»~
@43227 = ~«Ясно. Прощай».~
@43228 = ~«Зачем? Затем, что это оружие — инструмент дьяволов… в буквальном смысле слова. Изверги собираются использовать его, чтобы посеять неисчислимые разрушения по всему мирозданию, и неважно, сколько у этой адской машины „мирных“ способов применения, ни один из них не оправдывает страданий, которые оружие причинит».~
@43229 = ~«А что насчёт рабочих?»~
@43230 = ~«Хорошо. У меня другие вопросы…»~
@43231 = ~«Ясно. Прощай».~
@43232 = ~«Да то, что они так же слепы, как и остальные фракции. Они вцепились в город железной хваткой, но даже не притворяются, что у них есть план. Их жизнеутверждающая философия на самом деле даже не утверждает жизнь. Пора бы угостить их собственной пилюлей».~
@43233 = ~«Ясно. У меня другие вопросы…»~
@43234 = ~«Хорошо. Прощай».~
@43235 = ~«Я слышала взрыв отсюда. Прекрасная работа. Заинтересован в новом задании?»~
@43236 = ~«Что в этот раз?»~
@43237 = ~«Почему тебя не уничтожил взрыв, как остальных работающих над проектом?»~
@43238 = ~«Фактол, Сандоз… я уверена, тебе ведь знакомо это имя? Именно он в ответе за разработку этой дьявольской машины. Именно он подписал договор и пообещал, что смертельное оружие будет изготовлено. Именно он в ответе за смерти остальных инженеров. Он должен умереть».~
@43239 = ~«Будет сделано».~
@43240 = ~«Нет. Достаточно людей уже погибло».~
@43241 = ~«Ты не хочешь этого делать? Очень жаль, потому что ты уже поставил себя на путь подобных деяний. Ты правда думаешь, ещё один труп что-то изменит? Подумай о том, что ты уже сделал и чего тебе будет стоить отказ. Ничего не изменится, если ты остановишься, но получится, что все предыдущие жертвы были напрасны. Ты действительно не хочешь исполнять это убийство или просто набиваешь себе цену?»~
@43242 = ~«Я убью его».~
@43243 = ~«Нет. Я не хочу его убивать».~
@43244 = ~«Хорошо. Его зовут Сандоз. Я думаю, тебе уже приходилось с ним встречаться. Он ничего не заподозрит. Не беспокойся о том, чтобы провернуть это незаметно: Сандоз достаточно буен, чтобы охрана не заметила небольшой драки. Просто возвращайся сюда, когда всё сделаешь, я дам тебе ещё одно задание — и всё на этом. Теперь приступай к делу!»~
@43245 = ~«Я передумал. Не хочу его убивать».~
@43246 = ~«Хорошо. Прощай».~
@43247 = ~Её глаза переполняет презрение. «Ты действительно слабее, чем я думала… и это явно поступок слабака. В таком случае прощай. И не смей больше со мной заговаривать», — она от тебя отворачивается.~
@43248 = ~«Ну и ладно. Прощай».~
@43249 = ~«Ты уже уничтожил смертоносное оружие?»~
@43250 = ~«Нет. Мне нужен жетон, чтобы пройти через двери».~
@43251 = ~«Нет. Я потерял жетон, необходимый для прохода через двери».~
@43252 = ~«Что насчёт рабочих?»~
@43253 = ~«Ещё нет. Но скоро уничтожу. Не расскажешь мне о его слабых местах?»~
@43254 = ~«Тебе нужен жетон? Поговори со смотрительницей кузницы… по-моему, её зовут Алисса Тилд. Или попробуй поговорить с парнем по имени Сарос. Как я понимаю, у него лёгкая рука…»~
@43255 = ~«Хорошо. Не расскажешь мне о слабых местах машины?»~
@43256 = ~«У меня другие вопросы…»~
@43257 = ~«Хорошо, так и поступлю. Прощай».~
@43258 = ~«Тогда тебе придётся найти, где он. Ещё можешь спросить у Сароса или Алиссы, смотрительницы кузницы. Если не получишь у них, тогда, возможно, тебе придётся прокладывать дорогу к машине с боем. Но я бы не рекомендовала».~
@43259 = ~«Хорошо. Не расскажешь мне о слабых местах машины?»~
@43260 = ~«У меня другие вопросы…»~
@43261 = ~«Хорошо. Прощай».~
@43262 = ~«Сконцентрируй все усилия на ударном механизме. Я рекомендую засунуть туда что-нибудь металлическое. Твёрдая сталь предмета будет искрить и вызовет искажения резонанса магического поля, что приведёт к самоуничтожению оружия. Когда засунешь кусок металла в механизм — уходи. У тебя будет около получаса до взрыва».~
@43263 = ~«А что насчёт рабочих?»~
@43264 = ~«У меня другие вопросы…»~
@43265 = ~«Хорошо. Прощай».~
@43266 = ~«А что насчёт них? Они рабы своей фракции, а фракция не будет оплакивать их смертей. Почему это тогда должно волновать тебя?»~
@43267 = ~«Мне не всё равно потому, что они невинны».~
@43268 = ~«У меня другие вопросы…»~
@43269 = ~«Ты права. Я вернусь с вестью о разрушении машины».~
@43270 = ~«Невинны? Ха. Только в такой коррумпированной организации можно назвать тех, кто обслуживает смертельные машины, „невинными“. Как смешно. — она прерывается, словно откашливаясь от желчи. — Так ты уничтожишь машину или нет?»~
@43271 = ~«Нет. Они не заслуживают смерти».~
@43272 = ~«Уничтожу. Я вернусь с вестью об успехе».~
@43273 = ~«Шанс у тебя уже был. Думаешь, теперь я доверю тебе такое дело? Я так не думаю. Убирайся с глаз долой».~
@43274 = ~«Просто ответь на мои вопросы».~
@43275 = ~«Тогда прощай».~
@43276 = ~«Тогда нам не о чём больше разговаривать. Не распускай об этом язык, и я никому не скажу о том, что ты замыслил предательство. Прощай. Не желаю с тобой больше разговаривать».~
@43277 = ~«Погоди! Я передумал!»~
@43278 = ~«Тогда прощай».~
@43279 = ~«Теперь ты Богот. Ты всё ещё этим счастлив?»~
@43280 = ~«Да».~
@43281 = ~«Нет, не очень».~
@43282 = ~«Я хотел задать тебе пару вопросов».~
@43283 = ~«Конечно. Прощай».~
@43284 = ~«Хорошо. Я рада, что ты счастлив своим выбором. Что я могу для тебя сделать?»~
@43285 = ~«У меня к тебе вопросы…»~
@43286 = ~«Спасибо, ничего. Прощай».~
@43287 = ~«Почему нет?»~
@43288 = ~«Это не то, что я думал».~
@43289 = ~«Потому что я начинаю понимать: это пустой титул».~
@43290 = ~«Просто я не удовлетворён».~
@43291 = ~«Вообще-то я думаю, меня это вполне устраивает».~
@43292 = ~«Что у тебя за вопросы?»~
@43293 = ~«Расскажи мне о Великой Кузнице».~
@43294 = ~«Расскажи, что ты знаешь об убийстве».~
@43295 = ~«Тильдон говорит, что ты — Анархист».~
@43296 = ~«Тильдон говорит, что ты Анархист и пытаешься свалить преступление на него».~
@43297 = ~«Расскажи мне о проекте, над которым вы работаете».~
@43298 = ~«Расскажи мне об остальных здесь».~
@43299 = ~«Кто ты?»~
@43300 = ~«Неважно. Забудь».~
@43301 = ~«Не всё в этой жизни так, как мы этого хотим, и неудовлетворённость преследует всех нас. Членство во фракции — это нематериальная награда. Подумай об этом и возвращайся как-нибудь, ладно?»~
@43302 = ~«Конечно. Но у меня кое-какие вопросы…»~
@43303 = ~«Конечно. Прощай».~
@43304 = ~«Можешь ли ты в таком случае сказать, что верен Боготам?»~
@43305 = ~Правда: «Да».~
@43306 = ~Ложь: «Да».~
@43307 = ~Правда: «Нет».~
@43308 = ~Ложь: «Нет».~
@43309 = ~«Думаю, это не твоего ума дело».~
@43310 = ~Она сдерживает зевок. «Ты можешь спросить о Кузнице кого угодно здесь и получишь тот же ответ. Почему ты думаешь, что я отвечу по-другому? Спроси лучше что-нибудь другое».~
@43311 = ~«Расскажи, что ты знаешь об убийстве».~
@43312 = ~«Тильдон говорит, что ты Анархист и пытаешься свалить преступление на него».~
@43313 = ~«Расскажи мне о проекте, над которым вы работаете».~
@43314 = ~«Расскажи мне об остальных здесь».~
@43315 = ~«Неважно. Забудь».~
@43316 = ~«Та-ак… я попросила охрану уйти ночью домой, поскольку работала в соседней комнате над одним чувствительным механизмом для проекта и мне не нужно было их присутствие, их загрязняющие психические эманации могли помешать очень важной работе. Лишь через некоторое время я обнаружила труп, когда вышла из комнаты. Так как у меня нет алиби, я понимаю, что попадаю под подозрение, и надеюсь, ты уже догадываешься, что я отказываюсь от дачи показаний под заклятьем. Хочу отметить, что причина отказа лишь в том, что это нарушит клятву секретности нашего проекта, которую я дала».~
@43317 = ~«Ясно. У меня другие вопросы».~
@43318 = ~«Думаю, я проверю это вместе с Келдором».~
@43319 = ~«Ясно. Прощай».~
@43320 = ~Она усмехается: «Анархист? Да ладно. Ты издеваешься. У тебя есть настоящие вопросы, или мне возвращаться к своей работе?»~
@43321 = ~«У меня другие вопросы».~
@43322 = ~«Возвращайся к работе. Прощай».~
@43323 = ~«Рассказать тебе о проекте, который мы жизнью поклялись защищать? Хм. Нет, не думаю. Не сейчас, во всяком случае. Я просто скажу, что это мощная штука и стоит затраченных нами усилий».~
@43324 = ~«Ладно. В таком случае ответь мне на другие вопросы…»~
@43325 = ~«Хорошо. Прощай».~
@43326 = ~«Остальные? У нас есть талантливый, но эксцентричный Нил Зандер; женщина-гитцерай Кел'лера; Тильдон Серый, чьё сердце менее сомнительно, чем его имя; управляющий Келдор; управляющий Сандоз; двое детей Сандоза; прорабы, кузнецы и многие другие. Все они рано или поздно проходят мимо меня, но, откровенно говоря, я не прикладывала усилий, чтобы получше их узнать. Либо они работают на меня, либо нет. И это, пожалуй, всё, что меня интересует. Я очень привязана к своей работе».~
@43327 = ~«Хорошо. У меня ещё вопросы…»~
@43328 = ~«Ясно. Прощай».~
@43329 = ~«Меня зовут Бедай-Лин. Я магический инженер; не маг — прошу не путать — а теоретик. И я намерена проследить, чтобы Боготам больше не представлялось случая использовать такое оружие или подписывать договор о поставке подобных средств войны».~
@43330 = ~«Хорошо. Ответь на другие вопросы…»~
@43331 = ~«Ясно. Прощай».~
@43332 = ~Она удовлетворённо улыбается: «Хорошо. Порази одно из слабых мест машины и возвращайся, чтобы дать мне знать».~
@43333 = ~«Какие у неё слабые места?»~
@43334 = ~«Я дам тебе знать, когда закончу. А пока у меня ещё вопросы…»~
@43335 = ~«Зачем тебе это нужно?»~
@43336 = ~«Кажется, я передумал. Лучше я выдам тебя».~
@43337 = ~«Конечно. Прощай».~
@43338 = ~«Можешь ли ты назвать себя неверным настолько, что при случае сможешь напасть на Богота?»~
@43339 = ~«Да, могу».~
@43340 = ~«Конечно нет!»~
@43341 = ~«Нет, не моего, — она отворачивается. — Прощай».~
@43342 = ~«Прощай».~
@43343 = ~«Разве ты не догадался? Я поклялась ложным именем и ложной личностью. Я не тот человек, что давал обет, поэтому свободна от него. Итак, теперь ты согласишься на новую работу или нет?»~
@43344 = ~«Что за работа?»~
@43345 = ~«Проверяй. Он подтвердит то, что я сказала: он брал с меня клятву и знает её силу».~
@43346 = ~«Хорошо. У меня другие вопросы…»~
@43347 = ~«Ладно. Прощай».~
@43348 = ~Искры гнева загораются в её глазах, но презрение сменяет гнев так быстро, что ты даже сомневаешься, не показалось ли. «Анархист? Да ладно. Ты издеваешься. Ещё шутки будут? У тебя есть настоящие вопросы, или я могу вернуться к своей работе?»~
@43349 = ~«Что означала эта вспышка гнева?»~
@43350 = ~«У меня ещё вопросы…»~
@43351 = ~«Возвращайся к своей работе. Прощай».~
@43352 = ~«В таком случае ты обратился по адресу, — она улыбается, её глаза озаряются. — Как бы тебе понравилось нанести удар и военной машине баатезу, и Боготам?»~
@43353 = ~«Что ты имеешь в виду?»~
@43354 = ~«Идея так себе».~
@43355 = ~«Он был полезной пешкой, но дело в том, что он был слишком связан личными предубеждениями, чтобы понять важность их уничтожения. Если он умрёт, то невелика потеря. Если выживет — тоже ничего. Я буду помнить его как мальчика, который сделал своё дело, но которому не хватало потенциала».~
@43356 = ~«Ладно. Ответь мне на другие вопросы».~
@43357 = ~«Как мило. Прощай».~
@43358 = ~«Хорошо. Прекрасно, что эта фракция не вскормила предателей. Могу я ещё чем-то тебе помочь?»~
@43359 = ~«У меня другие вопросы…»~
@43360 = ~«Нет, спасибо. Прощай».~
@43361 = ~Её губы затрагивает лёгкая улыбка. «А ты наблюдательный, не так ли? Разреши мне поставить вопрос так: как бы ты себя чувствовал, если бы тебе предъявили ложное обвинение? Мой гнев берёт начало отсюда и ниоткуда больше», — очень *похоже*, что она говорит правду…~
@43362 = ~«Я на это не куплюсь».~
@43363 = ~«Хорошо. У меня другие вопросы…»~
@43364 = ~«Ясно. Прощай».~
@43365 = ~«Тебе придётся, так как другого ответа ты от меня не получишь, — она резко отворачивается. — Прощай».~
@43366 = ~«Прощай».~
@43367 = ~«Я имею в виду, что в Кузнице разрабатывается оружие невероятной силы. Этот проект спонсируется баатезу — или дьяволами, если так удобнее их называть. Уничтожив его, ты не только ударишь по фракции, которую, по твоим словам, отверг, но и дашь пощёчину целой расе извергов. Что скажешь?»~
@43368 = ~«Я это сделаю».~
@43369 = ~«Нет. На такое я не пойду».~
@43370 = ~«Тогда ты для меня бесполезен. Не распускай язык, а я придержу свой. Прощай».~
@43371 = ~«Прощай».~
@43372 = ~«Что тебе нужно?»~
@43373 = ~«Расскажи мне о Великой Кузнице».~
@43374 = ~«Расскажи, что ты знаешь об убийстве».~
@43375 = ~«Тильдон говорит, что ты Анархист и пытаешься свалить преступление на него».~
@43376 = ~«Тильдон говорит, что ты Анархист и пытаешься свалить преступление на него».~
@43377 = ~«Расскажи мне о проекте, над которым вы работаете».~
@43378 = ~«Расскажи мне об остальных здесь».~
@43379 = ~«Кто ты?»~
@43380 = ~«Ничего. Забудь».~
@43381 = ~Ты видишь суровую женщину с огненно-красными волосами, собранными сзади в тугой хвост, который придаёт её лицу напряжённое, нервозное выражение. Она глубоко погружена в свои мысли. Когда ты подходишь, она поднимает взгляд и спрашивает: «Могу я чем-нибудь помочь?»~
@43382 = ~«Да, у меня кое-какие вопросы».~
@43383 = ~«Нет, прости. Прощай».~
@43384 = ~Этот стройный молодой человек подходит к тебе с озабоченным видом: «Тысяча извинений, сэр, но я ищу определённого человека и думаю, вы бы могли мне помочь…»~
@43385 = ~«Да? И как же?»~
@43386 = ~Этот пожилой мужчина с добродушным лицом бросает на тебя кратчайший из взглядов и возвращается к декламации.~
@43387 = ~Перебить поэта.~
@43388 = ~Эта пожилая женщина строгого вида, похоже, кого-то ищет. Когда ты подходишь, её глаза останавливаются на твоём лице: «Эй, вы… можно вас на пару слов?»~
@43389 = ~«Разумеется…»~
@43390 = ~Эта высокая стройная женщина порой отрывается от своего вина, чтобы осмотреть завсегдатаев и прохожих. Черты её лица элегантны и экзотичны, а глаза — цвета сияющего золота — сверкают при каждом взгляде.~
@43391 = ~«Приветствую…»~
@43392 = ~«Я бы хотел воспользоваться твоими целительскими способностями».~
@43393 = ~«Спасибо, ничего. Прощай».~
@43394 = ~«Я бы хотел воспользоваться твоими целительскими способностями».~
@43395 = ~«Забудь. Прощай».~
@43396 = ~«Я бы хотел воспользоваться твоими целительскими способностями. Я наслышан о тебе».~
@43397 = ~«Я бы хотел воспользоваться твоими целительскими способностями. Я наслышан о тебе».~
@43398 = ~Магазин сладостей Квелла~
@43399 = ~Леди Торнкомб~
@43400 = ~Швейная мастерская Гонкальвеса~
@43401 = ~Магазинчик странностей Вришики~
@43402 = ~Хранилище Чующих~
@43403 = ~Добыча Гаериена~
@43404 = ~Кости Ночи~
@43405 = ~«Эй, не трогай меня! Оставь меня в покое!»~
@43406 = ~«Я просто хотел… а, забудь».~
@43407 = ~«Тебя поймали, да? Очень жаль».~
@43408 = ~«Прощай».~
@43409 = ~«Благодарю за милосердие. Уж теперь-то я встану на путь истинный, ладно?»~
@43410 = ~«Конечно, Сарос. Ответишь мне на пару вопросов, хорошо?»~
@43411 = ~«Как скажешь. Прощай».~
@43412 = ~«Что ты выяснил? Не собираешься меня отпустить?»~
@43413 = ~«Тильдон говорит, что ты пытаешься подставить его, а шило подбросил, так как вы поссорились».~
@43414 = ~«Тильдон мне сказал, что ты и Бедай-Лин — Анархисты, и вы пытаетесь подставить его потому, что он не захотел вам помогать».~
@43415 = ~«Я выяснил достаточно для того, чтобы принять решение».~
@43416 = ~«Пока ничего. Однако у меня ещё вопросы».~
@43417 = ~«Ещё нет. До свидания».~
@43418 = ~«Конечно. Всё, что захочешь узнать…»~
@43419 = ~«Расскажи мне о себе».~
@43420 = ~«Расскажи мне о Великой Кузнице».~
@43421 = ~«Расскажи мне о Великой Кузнице».~
@43422 = ~«Расскажи мне об Анархистах».~
@43423 = ~«Расскажи мне о людях здесь».~
@43424 = ~«Прямо сейчас — ничего. Прощай».~
@43425 = ~«Ну смотри… мы с сестрой Сароссой выросли в Кузнице. Мой отец Сандоз — управляющий здесь, так что большую часть времени он проводил, работая на благо фракции и вербуя новых соратников. Моя сестра Саросса — навроде ведьмы, но своё дело знает. Она знает, как менять людей, чтобы они стали ближе к тому, кто они по натуре».~
@43426 = ~«Что ты имеешь в виду?»~
@43427 = ~«Что ты имеешь в виду?»~
@43428 = ~«Это я уже слышал. Можешь ответить на другие вопросы?»~
@43429 = ~«Спасибо. Прощай».~
@43430 = ~«Оставь меня в покое. Мой отец мёртв».~
@43431 = ~«У меня только пара вопросов».~
@43432 = ~«Хорошо. Прощай».~
@43433 = ~«Я же сказал, оставь меня!»~
@43434 = ~«Ладно, ладно. Счастливо».~
@43435 = ~«Я тут вырос. Я играл во дворе фабрики и облазил все бараки. Она воняет, она шумит, и люди могут быть такими… как люди, наверное… но всё равно это мой дом».~
@43436 = ~«Трогательно. Ответь ещё на пару вопросов…»~
@43437 = ~«Спасибо, Сарос. Счастливо».~
@43438 = ~«Они все мертвы. Все люди, с которыми я играл в детстве… они все погибли в том взрыве. Я привык думать, что Кузница — это мой дом, но сейчас она лишь причиняет боль. Не мог бы ты меня оставить?»~
@43439 = ~«Крепись, парень. У меня ещё вопросы».~
@43440 = ~«Прощай».~
@43441 = ~«Я не хотел бы об этом говорить. Думал, что они мне помогут и моя жизнь станет интереснее, а они вместо этого сдали меня. Понимаю, им приходится надеяться лишь на себя, когда весь мир против них… но я же просто хотел быть одним из них».~
@43442 = ~«Это разрушает один из основных столпов анархии, Сарос. Ты должен быть индивидуалистом».~
@43443 = ~«Это разрушает один из основных столпов анархии, Сарос. Ты должен быть индивидуалистом».~
@43444 = ~«Конечно. Ты ведь ещё ребёнок. Ты это выдержишь. Ответь ещё на кое-какие вопросы».~
@43445 = ~«Я понимаю. Ты это переживёшь. Счастливо».~
@43446 = ~Он пожимает плечами: «Они просто люди».~
@43447 = ~«Ты очень помог. Не ответишь ещё на пару вопросов?»~
@43448 = ~«Спасибо. Прощай».~
@43449 = ~«То есть, чтобы стать одним из них, я должен не хотеть быть одним из них?»~
@43450 = ~«По сути, да. Будучи самим собой, ты становишься чем-то большим, чем пешкой в чужих играх. Подумай об этом. Счастливо».~
@43451 = ~«Она может просто посмотреть на кого-нибудь и увидеть, что надо добавить, а что убрать. Не знаю, как она это делает. Мой отец всегда говорил, что это связано с её восхождением на новый уровень. Он говорил, что *она* — прирождённый Богот».~
@43452 = ~«Спасибо. У меня ещё вопрос…»~
@43453 = ~«Спасибо. Прощай».~
@43454 = ~«Ты это уже говорил! Не приходит в голову ничего нового? И вообще, почему ты продолжаешь повторять одно и то же снова и снова? Хочешь от меня чего-то ещё?»~
@43455 = ~«Думаю, нет. Прощай».~
@43456 = ~«Что ты хотел знать?»~
@43457 = ~«Тильдон говорит, что ты пытаешься подставить его, а шило подбросил, так как вы поссорились».~
@43458 = ~«Тильдон мне сказал, что ты и Бедай-Лин — Анархисты, и вы пытаетесь подставить его потому, что он не захотел вам помогать».~
@43459 = ~«Я выяснил достаточно для того, чтобы принять решение».~
@43460 = ~«Расскажи мне о себе».~
@43461 = ~«Расскажи мне о Великой Кузнице».~
@43462 = ~«Расскажи мне о Великой Кузнице».~
@43463 = ~«Расскажи мне об Анархистах».~
@43464 = ~«Расскажи мне о людях здесь».~
@43465 = ~«Пока больше ничего. Счастливо».~
@43466 = ~«Конечно он так скажет! Просто потому, что он виновен и хочет заставить тебя искать в другом месте! Я видел, как он убил того мужика! Естественно мы поссорились, но это же не значит, что я хочу его смерти. Ведь нельзя же арестовать человека лишь за то, что он полный пень. Его надо арестовать за убийство Авилдона! Передай ему, что у него нет доказательств!»~
@43467 = ~«Хорошо. У меня к тебе ещё вопросы».~
@43468 = ~«Хорошо. У меня к тебе ещё вопросы».~
@43469 = ~«Передам. Прощай».~
@43470 = ~Сарос бледнеет: «Она не имеет к этому никакого отношения. Я всё сделал сам. Правда такова: Тильдон толкнул Авилдона на механизмы. А я лишь подкинул шило, чтобы всем стало ясно, что он там был, ведь я лишь юноша и никто мне не поверит. Понятно? Я признаю, что подкинул шило. Но сделал это лишь для того, чтобы преступник был наказан».~
@43471 = ~«В таком случае я готов сообщить Келдору своё решение».~
@43472 = ~«Почему? Почему я не должен думать, что ты пытаешься отомстить ему за что-то другое?»~
@43473 = ~«Посмотрим. Прощай».~
@43474 = ~«И какое же твоё решение?» — похоже, он еле сдерживает слёзы.~
@43475 = ~«Ты узнаешь, когда я его оглашу».~
@43476 = ~«Мне страшно. Боюсь, ты решишь, что убийца — это я. Но ведь это не так!»~
@43477 = ~«Посмотрим. Пока ответь ещё на кое-какие вопросы…»~
@43478 = ~«Так оно и будет, если ты виновен. Счастливо».~
@43479 = ~«Сейчас мне кажется, что всё здесь не так… говорят, это жизнь преподносит очередное испытание, но… я не знаю…»~
@43480 = ~«Тогда ответь ещё на один вопрос…»~
@43481 = ~«Жизнь всегда сурова. Прощай».~
@43482 = ~«Я тут вырос. Я играл во дворе фабрики и облазил все бараки. Она воняет, она шумит, и люди могут быть такими же, как Тильдон… но всё равно это мой дом».~
@43483 = ~«Ясно. Ответь на другой вопрос…»~
@43484 = ~«Ясно. Прощай».~
@43485 = ~«Они… ну, ко мне пришли люди и сказали, что я именно тот человек, который им нужен, ведь я могу попасть куда угодно и никто даже не обратит на меня внимания… я и подумать не мог, что кто-то в результате умрёт. Я думал, что просто буду глазами и ушами. Но потом Тильдон толкнул Авилдона в механизмы и сказал, что заявит на меня… а я даже не знаю, кто был тот человек, что разговаривал со мной!»~
@43486 = ~«Разве не вы с Бедай-Лин подставили Тильдона? Он говорит именно так. И он, кстати, вполне уверен, что она замешана».~
@43487 = ~«Разве не вы с Бедай-Лин подставили Тильдона? Он говорит именно так. И он, кстати, вполне уверен, что она замешана».~
@43488 = ~«Они простые кузнецы и рабочие. Я думаю, это хорошо, но они все такие правильные и *скучные*. Им надо чуток оживиться. Навроде Чующих, например».~
@43489 = ~«Тебе нравятся Чующие, да?»~
@43490 = ~«Я понимаю, почему ты так думаешь. У меня были другие вопросы…»~
@43491 = ~«Спасибо, что уделил время. Прощай».~
@43492 = ~«Этот несчастный кузнец… я не могу в это поверить…»~
@43493 = ~«Не знаешь, что могло случиться? Или, может, есть что сообщить?»~
@43494 = ~«Это ужасно, погибнуть вот так, в чреве машины. У меня вопросы…»~
@43495 = ~«Не знаешь, что могло случиться? Или, может, есть что сообщить?»~
@43496 = ~«Кто тебе сказал? Смотритель? Она права. Я порой прихожу сюда по ночам, когда нет никого вокруг, — он осторожно осматривается и наклоняется к тебе. — Я видел Тильдона, крадущегося отсюда. Основная причина, почему я думаю, что это был именно он, — он кое-что уронил рядом с телом». Он протягивает тебе шило с надписью «Тильдон», вырезанной на деревянной рукоятке.~
@43497 = ~«Спасибо. Я непременно вернусь поговорить с тобой ещё раз».~
@43498 = ~«Спрашивай что угодно».~
@43499 = ~«Не знаешь, что могло случиться? Или, может, есть что сообщить?»~
@43500 = ~«Расскажи мне о себе».~
@43501 = ~«Расскажи мне о Великой Кузнице».~
@43502 = ~«Расскажи мне о Великой Кузнице».~
@43503 = ~«Расскажи мне о людях здесь».~
@43504 = ~«Пока больше ничего. Счастливо».~
@43505 = ~«Потому что… потому что… я не знаю, почему ты не должен. Но я клянусь… сходи и поговори с ним, скажи ему всё, что я сейчас сказал, а потом можешь принимать решение».~
@43506 = ~«Так и поступим. Оставайся здесь».~
@43507 = ~«Они умеют жить. Они всё о жизни знают. Совсем не как люди здесь. Те по-прежнему считают, что у всего есть благородная цель, но я её не вижу. Моя сестра говорит, что жизнь — это больше, чем одни лишь наши чувства, но я не представляю, с чего она это взяла, ведь окружающий мир она воспринимает именно чувствами. Я просто не могу понять, для чего это всё людям нужно».~
@43508 = ~«Кто твоя сестра?»~
@43509 = ~«Кто твоя сестра?»~
@43510 = ~«Хм. Ясно. У меня ещё вопросы…»~
@43511 = ~«Спасибо, что уделил время. Прощай».~
@43512 = ~«Саросса? Она может просто посмотреть на кого-нибудь и увидеть, что надо добавить, а что убрать. Не знаю, как она это делает. Мой отец всегда говорил, что это связано с её восхождением на новый уровень. Он говорил, что *она* — прирождённый Богот».~
@43513 = ~«Интересно. Позволь мне задать ещё пару вопросов…»~
@43514 = ~«Спасибо. Прощай».~
@43515 = ~«Я? Я Сарос. Я тут вырос. Привык бегать по Кузнице и играть где попало и с чем попало… мне здесь почти все нравятся, кроме Тильдона. Он всё твердит, что меня неправильно воспитали и что мой отец плохой родитель. Хотя всё, что я знаю о Тильдоне, — так это что он самый большой зануда, какого я встречал в жизни».~
@43516 = ~«Уверен, так и есть. У меня ещё пара вопросов».~
@43517 = ~«Понял. Прощай».~
@43518 = ~«Сейчас мне кажется, что всё здесь не так… говорят, это жизнь преподносит очередное испытание, но… я не знаю…»~
@43519 = ~«Тогда ответь ещё на один вопрос…»~
@43520 = ~«Жизнь всегда сурова. Счастливо».~
@43521 = ~«Я тут вырос. Я играл во дворе фабрики и облазил все бараки. Она воняет, она шумит, и люди могут быть такими, как Тильдон… но всё равно это мой дом».~
@43522 = ~«Ясно. Ответь на другой вопрос…»~
@43523 = ~«Ясно. Прощай».~
@43524 = ~«Они простые кузнецы и рабочие. Я думаю, это хорошо, но они все такие правильные и *скучные*. Им надо чуток оживиться. Навроде Чующих, например».~
@43525 = ~«Тебе нравятся Чующие, да?»~
@43526 = ~«Я понимаю, почему ты так думаешь. У меня были другие вопросы…»~
@43527 = ~«Спасибо, что уделил время. Прощай».~
@43528 = ~«Они умеют жить. Они всё о жизни знают. Совсем не как люди здесь. Те по-прежнему считают, что у всего есть благородная цель, но я её не вижу. Моя сестра говорит, что жизнь — это больше, чем одни лишь наши чувства, но я не представляю, с чего она это взяла, ведь окружающий мир она воспринимает именно чувствами. Я просто не могу понять, для чего это всё людям нужно».~
@43529 = ~«Кто твоя сестра?»~
@43530 = ~«Кто твоя сестра?»~
@43531 = ~«Хм. Ясно. У меня ещё вопросы…»~
@43532 = ~«Спасибо, что уделил время. Прощай».~
@43533 = ~~
@43534 = ~«Саросса? Она может просто посмотреть на кого-нибудь и увидеть, что надо добавить, а что убрать. Не знаю, как она это делает. Мой отец всегда говорил, что это связано с её восхождением на новый уровень. Он говорил, что *она* — прирождённый Богот».~
@43535 = ~«Интересно. Позволь мне задать ещё пару вопросов…»~
@43536 = ~«Спасибо. Прощай».~
@43537 = ~«Опять ты, а? Чего тебе надо?»~
@43538 = ~«Я просто хотел задать пару вопросов…»~
@43539 = ~«Ничего. Прощай».~
@43540 = ~Ты видишь подростка с волосами песочного цвета. Он как раз на границе детства и зрелости, и по его глазам видно, что он пытается быть взрослым, насколько возможно, но без малейшего понятия, как этого достичь. Другими словами, он выглядит невинным дитя. «Эй, незнакомец. Чем я могу помочь?»~
@43541 = ~«Ты мог бы ответить мне на пару вопросов…»~
@43542 = ~«Спасибо, ничем. Прощай».~
@43543 = ~«Вот потому-то гиты и не должны размножаться. Они постоянно так твердят, или верят в это, или „где найти пожирателя мозгов или гитиянки, чтобы убить“ и так далее и тому подобное. Не думаю, что им самим хоть чуть-чуть нравится подтыкать друг друга. Они становятся чокнутыми, или теряют по дороге остатки ума, или что-то ещё, оставаясь всё время настолько сосредоточенными, что даже забывают о чувстве юмора. Только и трещат, что о сосредоточении, и единстве умов, и доверии в обществе, но заметь, что раса сама разлетелась на куски, как только покончила с этими их разумососами. А теперь скажи ещё, что религия с идеологией не приведут к развалу планов».~
@43544 = ~Не успеваешь ты подойти к ней близко, как вмешивается Дак'кон: «Я бы хотел, чтобы ты меня выслушал».~
@43545 = ~«В чём дело, Дак'кон?»~
@43546 = ~«Нет. Лучше помолчи».~
@43547 = ~«Нет моей воли, чтобы мы говорили с этой женщиной».~
@43548 = ~«Почему нет?»~
@43549 = ~«Я тебя выслушал. Но мы всё равно с ней поговорим».~
@43550 = ~«Я тебя выслушал. Но мы всё равно с ней поговорим».~
@43551 = ~«Тогда не говори с ней».~
@43552 = ~«Тогда не говори с ней».~
@43553 = ~«Ладно. Тогда не будем».~
@43554 = ~«Благодарю».~
@43555 = ~«Не за что».~
@43556 = ~«Она *зерт*. Наши воли — скрещенные клинки. У нас нет ничего общего».~
@43557 = ~«Твоё желание понятно. Но мы всё равно с ней поговорим».~
@43558 = ~«Тогда не говори с ней».~
@43559 = ~«Ладно. Тогда не будем».~
@43560 = ~«Нет… — голос Дак'кона колеблется. — Нет моей *воли* так поступать».~
@43561 = ~«Дак'кон, это был приказ, а ты мой раб».~
@43562 = ~«Давай, Дак'кон».~
@43563 = ~«Ладно. Но помни, она ходит по самому краю».~
@43564 = ~Клинок Дак'кона глубоко врезается в её плоть, и она падает на землю, истекая кровью. Кровь кипит на острие его клинка, потом испаряется, оставляя чёрный след.~
@43565 = ~«Пошли».~
@43566 = ~Дак'кон вздыхает: «Сто лет Анарха, нет таких часов, что смогли бы измерить историю. Дело запутано, как корни Фри'хи, его разрешение почти невозможно; оно может никогда не прийти. Не суди меня слишком строго».~
@43567 = ~Дак'кон нервно переминается: «Я не могу заставить его говорить. Искренне хотел бы, но… его жизнь — это его жизнь».~
@43568 = ~«Группа гитиянки планирует нападение на крепость Вристигор в течение семи дней. Они уже в пути».~
@43569 = ~«Я ничего не скажу».~
@43570 = ~«Не в словах Зертимона недостаток убеждённости. Это их эхо было искажено».~
@43571 = ~«Твои слова — не слова Зертимона. Они обрамлены уловками и ненавистью, словно порождены разумом Гит».~
@43572 = ~Словно почуяв твоё намерение, Дак'кон говорит тебе, не отрывая взгляда от Кии'ны: «Назад, не вставай на пути наших клинков».~
@43573 = ~«Дак'кон, я приказываю тебе прекратить».~
@43574 = ~«Оставь её, Дак'кон».~
@43575 = ~Напасть на *зерта*.~
@43576 = ~Позволить им сражаться.~
@43577 = ~«Твой разум — разум Гит, Кии'на».~
@43578 = ~«Пошли, Дак'кон».~
@43579 = ~«Пошли, Дак'кон».~
@43580 = ~«Услышишь ли ты этого человека, когда он начнёт говорить?»~
@43581 = ~«Он путешествует со мной, Кии'на, последователь Зертимона. Он пришёл к тебе, чтобы услышать слова Зертимона, которые ты, как *зерт*, должна передавать. Ты его услышишь?»~
@43582 = ~«И ты закроешь разум для этих слов? *Познай* свои слова, прежде чем скажешь их, Кии'на, *зерт* Зертимона».~
@43583 = ~«Этого достаточно, — Дак'кон поворачивается к тебе и продолжает на твоём языке. — Она будет тебя учить».~
@43584 = ~Драться.~
@43585 = ~Бежать.~
@43586 = ~У этой женщины желтоватая кожа и суровые черты лица. Её тело покрыто татуировками, а на боку она носит длинный клинок. Глаза её — как две маленькие чёрные жемчужины. Они следят за каждым твоим движением.~
@43587 = ~«Приветствую, звучащий клинок».~
@43588 = ~«Приветствую».~
@43589 = ~«Тебе знакома крепость Вристигор?»~
@43590 = ~«Кто ты?»~
@43591 = ~«Что ты можешь рассказать об этом месте?»~
@43592 = ~«Извини, ошибся. Прощай».~
@43593 = ~У этой женщины желтоватая кожа и суровые черты лица. Её тело покрыто татуировками, а на боку она носит длинный клинок. Глаза её — как две маленькие чёрные жемчужины. Они следят за каждым твоим движением.~
@43594 = ~«Приветствую, звучащий клинок».~
@43595 = ~«Приветствую».~
@43596 = ~«Тебе знакома крепость Вристигор?»~
@43597 = ~«Кто ты?»~
@43598 = ~«Что ты можешь рассказать об этом месте?»~
@43599 = ~«Извини, ошибся. Прощай».~
@43600 = ~«Среди Народа… ты *известен* как друг. Но я тебя ещё не *знаю*. Ничем не могу тебе помочь».~
@43601 = ~«У меня всего лишь пара вопросов…»~
@43602 = ~«Тебе знакома крепость Вристигор?»~
@43603 = ~«Тогда, возможно, в другой раз. До свидания».~
@43604 = ~Её глаза блестят, когда она смотрит на тебя: «Услышь мои слова и *познай* мой разум: я не могу тебе помочь. Уходи».~
@43605 = ~«Тебе знакома крепость Вристигор?»~
@43606 = ~«Хорошо. Прощай».~
@43607 = ~«Я тебя ещё не *знаю*. *Знаю* только, что у меня нет для тебя слов».~
@43608 = ~«Тебе знакома крепость Вристигор?»~
@43609 = ~«Тогда прощай».~
@43610 = ~«Я тебя ещё не *знаю*. *Знаю* только, что у меня нет для тебя слов».~
@43611 = ~«Тебе знакома крепость Вристигор?»~
@43612 = ~«Тогда прощай».~
@43613 = ~Лёгкое напряжение проступает в её голосе: «Каким образом ты *познал* это название?»~
@43614 = ~«Группа гитиянки планирует нападение на крепость Вристигор в течение семи дней. Они уже в пути».~
@43615 = ~«Просто уличные слухи».~
@43616 = ~«Забудь об этом».~
@43617 = ~Её глаза бегают по твоему лицу. Ты чувствуешь, что она тебя изучает. «*Знай*, что ты заслужил благодарность народа гитцерай. Это не будет забыто. Закат солнца над Халдаром, путник. Я должна предупредить своих товарищей».~
@43618 = ~«Тогда удачи тебе и счастливо».~
@43619 = ~Её глаза ожесточаются: «Сообщи мне источник».~
@43620 = ~«Группа гитиянки планирует нападение на крепость Вристигор в течение семи дней. Они уже в пути».~
@43621 = ~«Ничего я не скажу».~
@43622 = ~«Глаз Вилкуара на тебя, если не скажешь!»~
@43623 = ~«Группа гитиянки планирует нападение на крепость Вристигор в течение семи дней. Они уже в пути».~
@43624 = ~«С какой стати я должен говорить?»~
@43625 = ~Она с шипением начинает выводить в воздухе перед тобой голубые узоры…~
@43626 = ~Драться.~
@43627 = ~Бежать.~
@43628 = ~У этой женщины желтоватая кожа и суровые черты лица. Её тело покрыто татуировками, на боку она носит длинный клинок. Глаза её — как две маленькие чёрные жемчужины. Они следят за твоим приближением. «Родич Зерчаи кланяется тебе. Я *знаю* твою мудрость и твою доброту. Скажи мне, чем могу помочь».~
@43629 = ~«И путник доволен. Надеюсь, ты сможешь ответить на кое-какие вопросы».~
@43630 = ~«У меня вопросы, на которые, надеюсь, ты сможешь ответить».~
@43631 = ~«Кто ты?»~
@43632 = ~«Извини, ошибся. Прощай».~
@43633 = ~«Говори. Я выслушаю тебя».~
@43634 = ~«Расскажи мне, в чём разница между гитиянки и гитцерай?»~
@43635 = ~«Расскажи мне, в чём разница между гитиянки и гитцерай?»~
@43636 = ~«Не могла бы ты обучить меня образным выражениям языка гитцерай?»~
@43637 = ~«Не могла бы ты научить меня Пути Зертимона?»~
@43638 = ~«Пока больше нет вопросов. Спасибо, что уделила время».~
@43639 = ~«Я Кии'на. Я *зерт*. Обучаю Пути Зертимона и веду Народ к их судьбе».~
@43640 = ~«Расскажи мне, в чём разница между гитиянки и гитцерай?»~
@43641 = ~«Расскажи мне, в чём разница между гитиянки и гитцерай?»~
@43642 = ~«Не могла бы ты обучить меня образным выражениям языка гитцерай?»~
@43643 = ~«Не могла бы ты научить меня Пути Зертимона?»~
@43644 = ~«Пока больше нет вопросов. Спасибо, что уделила время».~
@43645 = ~«Закат солнца над Халдаром, путник. Ты как Элезпа на горе, храбрый и отважный».~
@43646 = ~«Я пообедал за столом Торига. Счастливо». («Благодарю».)~
@43647 = ~«Благодарю тебя. Прощай».~
@43648 = ~«Приветствую, звучащий клинок».~
@43649 = ~«Приветствую. У меня ещё кое-какие вопросы…»~
@43650 = ~«Приветствую, Кии'на, и счастливо».~
@43651 = ~Она окидывает тебя *суровым* взглядом: «Гит была великой воительницей, освободившей нас от власти *иллитидских* рабовладельцев. Зертимон был её лейтенантом. Когда они освободили наш народ, Гит обратилась к Зертимону на Сожжённых Полях. Слова прозвучали, сталь прозвенела — и один народ распался на два. Те, кто остались верными суке-королеве, стали называться „гитиянки“. Те из нас, кто пошли по пути Зертимона, остались верны Народу и взяли имя „гитцерай“».~
@43652 = ~«И поэтому вы так сильно ненавидите друг друга?»~
@43653 = ~«Ясно. У меня другие вопросы…»~
@43654 = ~«Благодарю тебя. Прощай».~
@43655 = ~«Речь гитцерай основана на истории. Каждая вещь для нас — целая история, метафора — это грозное оружие, вдохновение на подвиги для нашего народа и противовес злым деяниям. Когда говорим о столе Торига, мы помним, что Ториг был известен своей гостеприимностью и доброжелательностью. Когда говорим о сердце Селканта, мы вспоминаем жестокую и злобную натуру Селканта. Понимаешь?»~
@43656 = ~«Да».~
@43657 = ~«Нет».~
@43658 = ~«В таком случае я не смогу научить тебя большему».~
@43659 = ~«Ладно. У меня другие вопросы…»~
@43660 = ~«Тогда прощай».~
@43661 = ~«Оба наши народа похожи на пенанских мулов: упрямые, слепые и беспокойные. У гитиянки к этому списку можно добавить ещё и „жестокие“. Они ненавидят нас за то, что мы достигли высот, которых им не понять».~
@43662 = ~«Ясно. У меня другие вопросы…»~
@43663 = ~«Ясно. Прощай».~
@43664 = ~Твоё обучение начинается:
Мудрец «написал книгу Анархов».
Обвиняя кого-либо в измене, помни «Глаз Вилкуара».
О щедрых говорят, что их «шкафы пусты».
Обычное приветствие включает в себя «Приветствую, звучащий клинок» и «Родич Зерчаи кланяется тебе», на которое нужно отвечать: «И путник доволен».
Твой ум наполняется и множеством других таких фраз.~
@43665 = ~«Спасибо, Кии'на. У меня ещё кое-какие вопросы…»~
@43666 = ~«Спасибо, Кии'на. Закат солнца над Халдаром». («Было очень приятно».)~
@43667 = ~«Я не могу. Ты слишком разделён, слишком… много в тебе человеческого… чтобы *познать* Путь».~
@43668 = ~«Ясно. У меня ещё кое-какие вопросы…»~
@43669 = ~«Спасибо, Кии'на. Счастливо».~
@43670 = ~У этой женщины желтоватая кожа и суровые черты лица. Её тело покрыто татуировками, а на боку она носит длинный клинок. Глаза её — как две маленькие чёрные жемчужины. Они следят за твоим приближением.~
@43671 = ~«Приветствую, звучащий клинок».~
@43672 = ~«Приветствую».~
@43673 = ~«Тебе знакома крепость Вристигор?»~
@43674 = ~«Кто ты?»~
@43675 = ~«Что ты можешь рассказать об этом месте?»~
@43676 = ~«Извини, ошибся. Прощай».~
@43677 = ~Она спокойно смотрит, как ты подходишь.~
@43678 = ~«Приветствую, звучащий клинок».~
@43679 = ~«Приветствую».~
@43680 = ~~
@43681 = ~~
@43682 = ~~
@43683 = ~~
@43684 = ~Она сама невозмутимость: «Я тебя… не *знаю*. Эта встреча не принесёт ничего хорошего ни мне, ни тебе. Прощай».~
@43685 = ~«Прощай».~
@43686 = ~«Ты мне *неизвестен*, однако приветствуешь меня так, как это делают мой народ. Неважно… я не могу ничем тебе помочь, путник. Прощай».~
@43687 = ~«Насквозь просоленная лодка поднимает паруса».~
@43688 = ~У этой женщины желтоватая кожа и суровые черты лица. Её тело покрыто татуировками, а на боку она носит длинный клинок. Глаза её — как две маленькие чёрные жемчужины. Когда вы приближаетесь, они следуют за каждым движением Дак'кона.~
@43689 = ~*Зерт* зло глазеет на Дак'кона, когда ты возвращаешься в его сопровождении. Она поворачивается к вам спиной, как будто подставляя свою спину под удар Дак'кона.~
@43690 = ~«Дак'кон, заруби её».~
@43691 = ~«Прекрати, Кии'на. Тебе знакома крепость Вристигор?»~
@43692 = ~«Тогда прощай».~
@43693 = ~Ты подходишь к ней, но она полностью игнорирует твоё присутствие. Дак'кон слегка кланяется, она не отвечает. Затем выпускает целую струю ругательств в адрес Дак'кона, он отвечает, не повышая голоса. Это приводит её в ещё большую ярость.~
@43694 = ~«Дак'кон, не переведёшь мне?»~
@43695 = ~«Что она сказала?»~
@43696 = ~«Спроси её, знает ли она крепость Вристигор».~
@43697 = ~Ждать.~
@43698 = ~«Пойдём отсюда».~
@43699 = ~«Как ты смеешь оскорблять Неразорванный Круг Зертимона, продолжая носить его у сердца? Ты не из числа Народа, предатель Шра'кт'лора! Анархи и *зерты* сказали своё веское слово, которому все обязаны подчиняться. Ты не имеешь право говорить со мной… как и с любым *зертом*».~
@43700 = ~Дак'кон прерывает её на полуслове холодным и вежливым поклоном. Она отворачивается от него и пристально смотрит на тебя: «Ты идёшь в тени у отверженного!»~
@43701 = ~«Пошли».~
@43702 = ~«Ему не нужно переводить для тебя. Я сама скажу тебе. Ты человек, на тебе рубашка из шрамов и крови, ты не имеешь права слышать священные слова Зертимона. Ты идёшь в тени у отверженного. И всё же он убедил меня позволить тебе услышать мои слова. Я *узнаю* твою волю».~
@43703 = ~«У меня всего лишь пара вопросов…»~
@43704 = ~«Тебе знакома крепость Вристигор?»~
@43705 = ~«Мне ничего не нужно. Прощай».~
@43706 = ~Она выглядит удивлённой и в то же время встревоженной. «Да, ударь, Дак'кон, позволь своему предательству выплеснуться из твоего сердца гитиянки», — она обнажает перед ним своё горло.~
@43707 = ~Она снова заговаривает с Дак'коном: «Ты готов убить меня ради того, кто не из Народа? Неужели его слова имеют больший вес, чем слова *зерта?* Ты поистине потерян, Дак'кон. Как такое могло случиться?»~
@43708 = ~«Ты сбился с пути истинного, Дак'кон. *Знай*, я надеюсь, что ты найдёшь себя. Мне тебя жаль. Прощай».~
@43709 = ~«Пошли, Дак'кон».~
@43710 = ~Она сурово на тебя смотрит: «Каким образом ты, кто идёт в тени отверженного, *познал* это название?»~
@43711 = ~«Группа гитиянки планирует нападение на крепость Вристигор в течение семи дней. Они уже в пути».~
@43712 = ~«Просто уличные слухи».~
@43713 = ~«Забудь об этом».~
@43714 = ~«*Знай*… *знай*, я очень благодарна… тебе и этому *зерту*. *Знай*, это не будет забыто, — она поворачивается к Дак'кону. — *Знай*, что это НЕ искупит твоей вины за падение Шра'кт'лора. Вердикт Анархов остаётся неизменным».~
@43715 = ~«Хм-м… прощай».~
@43716 = ~«Хм-м… прощай».~
@43717 = ~«Я должна *знать*, где ты слышал это название».~
@43718 = ~«Группа гитиянки планирует нападение на крепость Вристигор в течение семи дней. Они уже в пути».~
@43719 = ~«Разве я выразился неясно? Не собираюсь я ничего тебе говорить».~
@43720 = ~«Глаз Вилкуара! — она поворачивается к Дак'кону. — Заставь его сказать!»~
@43721 = ~«В таком случае вы оба умрёте», — её руки начинают плести в воздухе заклинания.~
@43722 = ~Драться.~
@43723 = ~Бежать.~
@43724 = ~Следует ещё одна короткая перепалка, затем женщина неожиданно перестаёт говорить с Дак'коном: «Я не услышу тебя. Ты услышишь меня, человек. Я не *знаю* тебя, но твои „украшения“ свидетельствуют о плохом. Твоё тело — книга, написанная на языке шрамов и крови, и ты идёшь в тени отверженного, который не *знает* Зертимона и не *знает* себя. Говори!»~
@43725 = ~«Приветствую, звучащий клинок».~
@43726 = ~«Приветствую».~
@43727 = ~«Тень отверженного? Что ты имеешь в виду?»~
@43728 = ~«Тень отверженного? Что ты имеешь в виду?»~
@43729 = ~«Группа гитиянки планирует нападение на крепость Вристигор в течение семи дней. Они уже в пути».~
@43730 = ~«Не расскажешь мне о различиях между гитцерай и гитиянки?»~
@43731 = ~«Не расскажешь мне о различиях между гитцерай и гитиянки?»~
@43732 = ~«Можешь обучить меня языку гитцерай?»~
@43733 = ~«Не могла бы ты научить меня Пути Зертимона?»~
@43734 = ~«Забудь. Прощай».~
@43735 = ~Она раздражённо шипит: «Твои любезности — как пыль. Знак скорби уже близко — время коротко, человек. Я *узнаю* твои вопросы, а затем моя воля, чтобы ты ушёл».~
@43736 = ~«Что ты имела в виду, сказав, что я иду в тени отверженного?»~
@43737 = ~«Что ты имела в виду, сказав, что я иду в тени отверженного?»~
@43738 = ~«Группа гитиянки планирует нападение на крепость Вристигор в течение семи дней. Они уже в пути».~
@43739 = ~«Не расскажешь мне о различиях между гитцерай и гитиянки?»~
@43740 = ~«Не расскажешь мне о различиях между гитцерай и гитиянки?»~
@43741 = ~«Можешь обучить меня языку гитцерай?»~
@43742 = ~«Не могла бы ты научить меня Пути Зертимона?»~
@43743 = ~«Забудь. Прощай».~
@43744 = ~«Ты путешествуешь с отверженным и не *знаешь* его истории? Он много говорит по любому поводу, но о своём прошлом так и не рассказал? Спроси его о Шра'кт'лоре, о падении великой крепости к ногам гитиянки, и узнай, что откроет тебе его сбившийся с пути ум. Спроси его, как он говорит словами Зертимона, но его *карач* — дымка».~
@43745 = ~«Сомнений в толковании слов Зертимона нет. Поколения *зертов* — как Самоцвет Рракмы, придерживаются одного мнения в этом вопросе. Твоя позиция — следствие разделённого разума. Сомнения — твои, они эхо твоего безверия».~
@43746 = ~«Лгать будешь мёртвым Шра'кт'лора в меняющемся хаосе, ибо ты видишь всё Глазом Вилкуара. Твой разум разделён, твой *карач* слаб!»~
@43747 = ~Встать на пути их клинков.~
@43748 = ~«Дак'кон, немедленно прекрати это».~
@43749 = ~«Оставь её, Дак'кон».~
@43750 = ~Напасть на *зерта*.~
@43751 = ~«Собака! Предательский пёс гитиянки!» — она замахивается на тебя мечом!~
@43752 = ~«Пришло время умереть, Кии'на».~
@43753 = ~Клинки обоих устремляются друг на друга в невероятном вихре движений!~
@43754 = ~Дак'кон неохотно опускает клинок. Минуту Кии'на недоумённо смотрит на него, затем её лицо искажает едкая ухмылка. «Наконец правда всплыла на поверхность. Твой ум не разделён. Ты… *раб* этого человека. Он говорит тебе с авторитетом Анарха, а ты его *слушаешь*».~
@43755 = ~«Его слова несут тяжесть твоих и облечены в форму Лимбо. Я не желаю слышать тебя, Дак'кон».~
@43756 = ~«Слова Зертимона не для ушей человека. Их умы не едины, и они приносят раздор, куда бы ни пришли. На этом человеке надета рубашка из шрамов и крови, и он путешествует с предателем. Сердце Вилкуара бьётся в твоей груди, если ты спрашиваешь, услышу ли я его».~
@43757 = ~«Я не услышу его. Пусть он услышит меня».~
@43758 = ~Женщина-гит поворачивается к тебе. Её чёрные глаза-жемчужины опасно сияют: «Я не *знаю* тебя, но твои „украшения“ свидетельствуют о плохом, человек. Твоё тело — книга, написанная на языке шрамов и крови, и ты идёшь в тени отверженного, который утверждает, что говорит словами самого Зертимона. Говори!»~
@43759 = ~«Приветствую, звучащий клинок».~
@43760 = ~«Приветствую».~
@43761 = ~«Тень отверженного? Что ты имеешь в виду?»~
@43762 = ~«Тень отверженного? Что ты имеешь в виду?»~
@43763 = ~«Группа гитиянки планирует нападение на крепость Вристигор в течение семи дней. Они уже в пути».~
@43764 = ~«Не расскажешь мне о различиях между гитцерай и гитиянки?»~
@43765 = ~«Не расскажешь мне о различиях между гитцерай и гитиянки?»~
@43766 = ~«Можешь обучить меня языку гитцерай?»~
@43767 = ~«Не могла бы ты научить меня Пути Зертимона?»~
@43768 = ~«Забудь. Прощай».~
@43769 = ~Она окидывает Дак'кона *суровым* взглядом. «Гит была великой воительницей, освободившей нас от власти *иллитидских* рабовладельцев. Зертимон был её лейтенантом. Когда они освободили наш народ, Гит обратилась к Зертимону на Сожжённых Полях. Слова прозвучали, сталь прозвенела — и один народ распался на два. Те, кто остались верными суке-королеве, стали называться „гитиянки“. Те из нас, кто пошли по пути Зертимона, остались верны Народу и взяли имя „гитцерай“. Наша ярость обусловлена предательством Гит».~
@43770 = ~«И поэтому вы так сильно ненавидите друг друга?»~
@43771 = ~«Ясно. У меня другие вопросы…»~
@43772 = ~«Благодарю тебя. Прощай».~
@43773 = ~«Оба наши народа похожи на пенанских мулов: упрямые, слепые и беспокойные. У гитиянки к этому списку можно добавить ещё и „жестокие“. Они ненавидят нас за то, что мы достигли высот, которых им не понять».~
@43774 = ~«Ясно. У меня другие вопросы…»~
@43775 = ~«Ясно. Прощай».~
@43776 = ~«Ач'али Утопшая! Спрашивай, и тебе ответят».~
@43777 = ~«Что ты имела в виду, сказав, что я иду в тени отверженного?»~
@43778 = ~«Что ты имела в виду, сказав, что я иду в тени отверженного?»~
@43779 = ~«Группа гитиянки планирует нападение на крепость Вристигор в течение семи дней. Они уже в пути».~
@43780 = ~«Не расскажешь мне о различиях между гитцерай и гитиянки?»~
@43781 = ~«Не расскажешь мне о различиях между гитцерай и гитиянки?»~
@43782 = ~«Можешь обучить меня языку гитцерай?»~
@43783 = ~«Не могла бы ты научить меня Пути Зертимона?»~
@43784 = ~«У меня больше нет вопросов. Счастливо».~
@43785 = ~«Если твой спутник не удосужился это сделать, я обучу тебя. Речь гитцерай основана на истории. Метафора — это грозное оружие, вдохновение на подвиги для нашего народа и противовес злым деяниям. Когда говорим о столе Торига, мы помним, что Ториг был известен своей гостеприимностью и доброжелательностью. Когда говорим о сердце Селканта, мы вспоминаем жестокую и злобную натуру Селканта. Понимаешь?»~
@43786 = ~«Да».~
@43787 = ~«Нет».~
@43788 = ~Твоё обучение продолжается:
Мудрец «написал книгу Анархов».
Обвинить кого-либо в предательстве — вспомнить о «Глазе Вилкуара».
О щедрых говорят, что их «шкафы пусты».
Обычные приветствия включают в себя «Приветствую, звучащий клинок» и «Родич Зерчаи кланяется тебе», на которые следует отвечать: «И путник доволен».
Твой ум наполняется и множеством других таких фраз.~
@43789 = ~«У меня ещё вопросы…»~
@43790 = ~«Спасибо. Прощай».~
@43791 = ~«В таком случае я не могу ничем помочь. Позволь тому, кто путешествует с тобой, сказать своё слово».~
@43792 = ~«У меня ещё кое-какие вопросы…»~
@43793 = ~«Возможно, я добьюсь ответов у него, потому что твои слова ничего не разъяснили. Прощай».~
@43794 = ~Её глаза ожесточаются: «Ты путешествуешь с тем, кто называет себя *зерт* и читает мне лекции по поводу морали, и просишь меня научить тебя Пути? Проси *его* научить тебя, потому что я не буду!»~
@43795 = ~~
@43796 = ~~
@43797 = ~~
@43798 = ~«Успокойся и ответь ещё на пару вопросов».~
@43799 = ~«Может, так и поступлю. Прощай».~
@43800 = ~«Снова пришёл досаждать мне? Что тебе нужно на сей раз?»~
@43801 = ~«Просто хотел задать пару вопросов…»~
@43802 = ~«Группа гитиянки планирует нападение на крепость Вристигор в течение семи дней. Они уже в пути».~
@43803 = ~«Ничего. Прощай».~
@43804 = ~Зерт скупо кланяется, когда ты подходишь. «*Знай*, что твои слова спасли нас от трагедии. Мы поклялись Клятвой Золотой Руки, человек. Ты сделал неудачный выбор спутника… — она бросает взгляд на Дак'кона, — но проявил себя как друг Народа. Я выслушаю тебя». Несмотря на свои слова, она явно не хочет иметь с тобой дел.~
@43805 = ~«Что ты можешь сказать о Дак'коне?»~
@43806 = ~«Что ты можешь сказать о Дак'коне?»~
@43807 = ~«Не расскажешь мне о различиях между гитцерай и гитиянки?»~
@43808 = ~«Не расскажешь мне о различиях между гитцерай и гитиянки?»~
@43809 = ~«Можешь обучить меня языку гитцерай?»~
@43810 = ~«Не могла бы ты научить меня Пути Зертимона?»~
@43811 = ~«У меня больше нет вопросов. Счастливо».~
@43812 = ~«Приветствую».~
@43813 = ~«Тебе знакома крепость Вристигор?»~
@43814 = ~«Кто ты?»~
@43815 = ~«Что ты можешь рассказать об этом месте?»~
@43816 = ~«Извини, ошибся. Прощай».~
@43817 = ~«Сомневаюсь. Прощай».~
@43818 = ~«Если бы вы только уделили мне минуточку внимания, сэр… это не займёт у вас больше пары мгновений…»~
@43819 = ~«Ладно… что там у тебя?»~
@43820 = ~«Оставь меня, парень. Прощай».~
@43821 = ~«Я посланник, сэр. Ищу человека, о котором говорят, что он бессмертен… человека со множеством шрамов, для которого смерть — просто обыденная неприятность. Вы предположительно соответствуете моему неточному описанию, сэр, и меня интересует, не вы ли тот самый человек?»~
@43822 = ~«Да, это я».~
@43823 = ~«Нет, это не я».~
@43824 = ~«И кто же хочет это знать?»~
@43825 = ~Он кивает, затем отвешивает глубокий поклон: «Тогда для вас сообщение, сэр: меня послала госпожа Джолми из Дома Сирма, женщина высокого положения. Госпожа Джолми встретит вас в Общественном Фестхолле, где она сделает вам предложение, о котором я ничего не знаю. Если вы захотите встретиться, то она в платье из зелёного шёлка с золотой каймой, а волосы её цвета голубой стали. Это конец моего сообщения, сэр… прощайте».~
@43826 = ~«Подожди… где этот Общественный Фестхолл?»~
@43827 = ~«Прощай».~
@43828 = ~«В северо-восточной части района Клерков, сэр. Это большое строение, его легко заметить. А теперь прощайте, сэр».~
@43829 = ~«Прощай».~
@43830 = ~«Очень жаль. Прощайте, сэр… приношу свои извинения за доставленное беспокойство. Счастливо».~
@43831 = ~«Прощай».~
@43832 = ~«Меня наняла богатая и знатная дама, Джолми Сирма, сэр».~
@43833 = ~«Я человек, которого ты ищешь».~
@43834 = ~«Что ж, видимо, ты ошибся».~
@43835 = ~Молодой посыльный отвешивает тебе вежливый полупоклон: «Мы встретились снова, сэр».~
@43836 = ~«Я хотел сказать, что я и есть человек, которого ты ищешь».~
@43837 = ~«Да… я просто проходил мимо. Прощай».~
@43838 = ~Перебить поэта.~
@43839 = ~Перебить поэта.~
@43840 = ~Уйти.~
@43841 = ~Твои выкрики чуть менее чем полностью состоят из слов «Поэзия — отстой!» вперемешку с презрительным свистом и привлекают пару недовольных взглядов… но не более того.~
@43842 = ~Уйти.~
@43843 = ~Ты перебиваешь и глумишься над поэтом, высмеивая его поэтический стиль, внешность и провозглашаемую им семейную жизнь. Ты привлекаешь несколько недовольных взглядов и короткий, злой взгляд самого поэта… но не более того.~
@43844 = ~Уйти.~
@43845 = ~Ты перебиваешь и глумишься над поэтом, высмеивая его поэтический стиль, внешность и провозглашаемую им семейную жизнь. В довершение всего ты прерываешь некоторые из его строк и завершаешь их собственными пошлыми рифмами. Это вызывает смешки собравшихся зевак и заставляет бедного старого поэта, изо всех сил старающегося не обращать на тебя внимания, скрежетать зубами.~
@43846 = ~Уйти.~
@43847 = ~Старый поэт бросает на тебя хмурый взгляд, прежде чем вернуться к декламации.~
@43848 = ~Ещё поглумиться над поэтом.~
@43849 = ~Ещё поглумиться над поэтом.~
@43850 = ~Ещё поглумиться над поэтом.~
@43851 = ~Уйти.~
@43852 = ~«Что тебе нужно?»~
@43853 = ~«Да… ты Джолми, верно? Я говорил с твоим посыльным».~
@43854 = ~«Нет, не сейчас. Прощай».~
@43855 = ~«Меня зовут Джолми, дворянка из дома Сирмы. Я ищу человека, который, как мне сказали, бессмертен… человека, всего покрытого шрамами, для которого смерть — всего лишь тривиальная неприятность. Судя по той информации, которую мне удалось собрать, вы вполне соответствуете описанию… вы и есть этот человек?»~
@43856 = ~«Да».~
@43857 = ~«Нет».~
@43858 = ~Она резко кивает: «В таком случае я благодарю вас за потраченное время. Прощайте».~
@43859 = ~«Погоди… у меня были вопросы…»~
@43860 = ~«Прощай».~
@43861 = ~Джолми качает головой: «Многие другие здесь с удовольствием ответят на ваши вопросы. Я попрошу вас найти себе кого-нибудь из них и не мешать моим поискам. Прощайте».~
@43862 = ~«Вообще-то я и *есть* человек, которого ты ищешь».~
@43863 = ~Уйти.~
@43864 = ~«Тогда я очень рада встрече с вами, — она отвешивает лёгкий поклон. — Я хочу сделать вам немного необычное предложение… хотя вы, признаться, тоже необычный человек. Я дам вам тысячу медяков… за разрешение убить вас. Вы готовы обговорить со мной этот вопрос?»~
@43865 = ~«Конечно, почему нет?»~
@43866 = ~«Конечно, почему нет?»~
@43867 = ~«Конечно, почему нет?»~
@43868 = ~«Но… зачем?»~
@43869 = ~«Нет, спасибо. Прощай».~
@43870 = ~Джолми и бровью не ведёт: «А почему бы и нет? Я думаю, это был бы довольно интересный опыт — заплатить кому-то за право убить его. Когда до меня впервые дошли слухи о вашем существовании, как я могла устоять? Так… каков ваш ответ? Стоит ли нам поподробнее обсудить этот вопрос?»~
@43871 = ~«Да, давай обсудим детали».~
@43872 = ~«Да, давай обсудим детали».~
@43873 = ~«Да, давай обсудим детали».~
@43874 = ~«Одну минуточку… от кого ты услышала обо мне?»~
@43875 = ~«На такое я не пойду. Прощай».~
@43876 = ~Джолми хмурится: «В Фестхолле можно услышать всякого рода вещи. Как можно вообще *не* интересоваться таким человеком, как вы? Ещё раз спрашиваю: вы примете моё предложение?»~
@43877 = ~«Да, давай обсудим детали».~
@43878 = ~«Да, давай обсудим детали».~
@43879 = ~«Да, давай обсудим детали».~
@43880 = ~«На такое я не пойду. Прощай».~
@43881 = ~После короткого обсуждения вы останавливаетесь на следующих условиях: Джолми заплатит тебе одну тысячу медяков, взамен ты позволишь ей вонзить кинжал тебе в сердце. Она подождёт, пока ты очнёшься, и тогда отдаст деньги.

«Значит, мы пришли к соглашению?»~
@43882 = ~~
@43883 = ~«Да… так и сделаем».~
@43884 = ~«Нет, я так не думаю. Прощай».~
@43885 = ~После короткого обсуждения вы останавливаетесь на следующих условиях: Джолми заплатит тебе полторы тысячи медяков; взамен ты позволишь ей вонзить кинжал тебе в сердце. Она подождёт, пока ты очнёшься, и тогда отдаст деньги.

«Значит, мы пришли к соглашению?»~
@43886 = ~«Да… так и сделаем».~
@43887 = ~«Нет, я так не думаю. Прощай».~
@43888 = ~После короткого обсуждения вы останавливаетесь на следующих условиях: Джолми заплатит тебе две тысячи медяков; взамен ты позволишь ей вонзить кинжал тебе в сердце. Она подождёт, пока ты очнёшься, и тогда отдаст деньги.

«Значит, мы пришли к соглашению?»~
@43889 = ~«Да… так и сделаем».~
@43890 = ~«Нет, я так не думаю. Прощай».~
@43891 = ~Всё заканчивается в одно мгновение… когда ты приходишь в себя, она уже протирает от крови и прячет кинжал. После того, как ты поднимаешься с пола Фестхолла, Джолми протягивает тебе несколько мешочков с медяками, а ты тем временем потираешь свою ноющую грудную клетку.

«Должна признать, что я немного разочарована. Ну что ж… деньги всё же потрачены не зря. Прощайте».~
@43892 = ~«Да… прощай».~
@43893 = ~Джолми окидывает тебя холодным взглядом: «Да?»~
@43894 = ~«Я человек, которого ты искала».~
@43895 = ~«У меня кое-какие вопросы…»~
@43896 = ~«Неважно… прощай».~
@43897 = ~Холодные глаза Джолми вспыхивают, когда она тебя узнаёт: «Так вы передумали насчёт моего предложения? Тысяча медяков за разрешение убить вас?»~
@43898 = ~«Да, давай обсудим детали».~
@43899 = ~«Да, давай обсудим детали».~
@43900 = ~«Да, давай обсудим детали».~
@43901 = ~«Сначала скажи мне, зачем тебе это надо».~
@43902 = ~«Нет, спасибо. Прощай».~
@43903 = ~Джолми обращает на тебя холодный взгляд; её глаза вспыхивают, когда она тебя узнаёт: «Да?»~
@43904 = ~«У меня вопросы, Джолми…»~
@43905 = ~«Я просто проходил мимо… прощай».~
@43906 = ~«Тьфу! — Анна ухмыляется над Морте. — Хорош истекать слюной, череп ты похотливый».~
@43907 = ~«Подлетишь хоть на волосок поближе, череп, и твои болтливые зубы разлетятся на мили вокруг!»~
@43908 = ~«Ух ты».~
@43909 = ~«Ты Немель? Мне сказали, что ты знаешь командное слово для этого графина».~
@43910 = ~«Немель? Тебя ищет твоя подруга Эльвин».~
@43911 = ~«Ты кого-то ищешь?»~
@43912 = ~«У меня кое-какие вопросы…»~
@43913 = ~«Мне ничего не нужно, Немель. Счастливо».~
@43914 = ~«Ух ты».~
@43915 = ~«Бог мой, что за пылкая маленькая девчонка! Умираешь от отсутствия внимания? Я могу поистекать слюной и на тебя, если ты ревнуешь…» — Морте летит по направлению к Анне, громко причмокивая…~
@43916 = ~Морте резко останавливается и отворачивается, невнятно бормоча ругательства.~
@43917 = ~«Ты Немель? Мне сказали, что ты знаешь командное слово для этого графина».~
@43918 = ~«Немель? Тебя ищет твоя подруга Эльвин».~
@43919 = ~«Ты кого-то ищешь?»~
@43920 = ~«У меня кое-какие вопросы…»~
@43921 = ~«Мне ничего не нужно, Немель. Счастливо».~
@43922 = ~«Да ладно тебе, шеф… уверен, мы *что-нибудь* придумаем, а? А?»~
@43923 = ~«Забудь об этом, Морте. Пошли».~
@43924 = ~«Приветствую».~
@43925 = ~«Приветствую».~
@43926 = ~Оставить женщину в покое.~
@43927 = ~Женщина поворачивается к тебе лицом, её фиолетовые глаза сверкают, как безупречные аметисты. Её речь льётся, словно мелодия; кажется, будто тихие, еле слышные звуки тысячи маленьких хрустальных колокольчиков сопровождают её голос. Каждое её слово задерживается в ушах, как будто те не хотят отпускать столь прекрасные звуки: «Немель повернулась к истерзанному шрамами, суровому незнакомцу. Она спросила, что ему от неё надобно».~
@43928 = ~«Ты Немель? Мне сказали, что ты знаешь командное слово для этого графина».~
@43929 = ~«Немель? Тебя ищет твоя подруга Эльвин».~
@43930 = ~«Ты кого-то ищешь?»~
@43931 = ~«У меня кое-какие вопросы…»~
@43932 = ~«На самом деле, ничего. Прощай».~
@43933 = ~Женщина поворачивается к тебе лицом, её фиолетовые глаза сверкают, как безупречные аметисты. Её речь льётся, словно мелодия; кажется, будто тихие, еле слышные звуки тысячи маленьких хрустальных колокольчиков сопровождают её голос. Каждое её слово задерживается в ушах, как будто те не хотят отпускать столь прекрасные звуки: «Немель повернулась к истерзанному шрамами, суровому незнакомцу. Она спросила, что ему от неё надобно».~
@43934 = ~Женщина поворачивается к тебе лицом, её фиолетовые глаза сверкают, как безупречные аметисты. Её речь льётся, словно мелодия; кажется, будто тихие, еле слышные звуки тысячи маленьких хрустальных колокольчиков сопровождают её голос. Каждое её слово задерживается в ушах, как будто те не хотят отпускать столь прекрасные звуки: «Немель повернулась к истерзанному шрамами, суровому незнакомцу. Она спросила, что ему от неё надобно».~
@43935 = ~Женщина даже движения не делает к графину, только говорит: «Немель взяла графин из рук незнакомца и стала вертеть его в руках. Видела ли она когда-нибудь что-либо подобное? Возможно… да, теперь она вспомнила. Она вернула графин, прошептав на ухо незнакомцу…»~
@43936 = ~«А…»~
@43937 = ~Ты понимаешь, что теперь тебе известно слово, «Нилденосай», хотя и уверен, что женщина ничего тебе на ухо не шептала, а просто сказала, что она так сделала. Она щурится на тебя: «Уйдёт ли сейчас незнакомец, удовлетворённый тем, что она ему сказала?»~
@43938 = ~«Не сейчас. Я нашёл Эльвин».~
@43939 = ~«Не сейчас. Тебя ищет твоя подруга Эльвин».~
@43940 = ~«Пока нет. Ты кого-то ищешь?»~
@43941 = ~«Нет… у меня были вопросы».~
@43942 = ~«Да, я ухожу. Прощай».~
@43943 = ~Губы Немель складываются в безупречную улыбку; она так и светится заразительным счастьем, которое окутывает тебя и мягко согревает. «Немель была очень рада услышать о своей подруге. Эльвин была где-то поблизости?»~
@43944 = ~«Она в другом кафе к востоку отсюда, на той стороне этой части района».~
@43945 = ~«Немель поблагодарила мужчину за прекрасные новости. Вскоре она пойдёт навестить свою давнюю подругу Эльвин. А сейчас она вознаградит незнакомца…»~
@43946 = ~«Нет, спасибо… мне не нужно никакого вознаграждения».~
@43947 = ~Дождаться от неё награды.~
@43948 = ~Немель дотрагивается указательным пальцем до губ и издаёт тихий звук: «Тс-с-с».~
@43949 = ~«Она близко придвинулась у незнакомцу, положила руку ему на грудь и поцеловала бледную кожу его щеки. Жизнь нахлынула в него с новой силой… это и было его вознаграждение».~
@43950 = ~Подождать.~
@43951 = ~Ожидая, ты вдруг ощущаешь лёгкое покалывание на щеке и груди. Это ощущение растекается по всему телу, и ты начинаешь чувствовать себя крепче, бодрее.~
@43952 = ~«Спасибо. У меня были кое-какие вопросы».~
@43953 = ~«Благодарю, Немель. Прощай».~
@43954 = ~«Немель выслушала вопросы незнакомца, но не смогла ответить ни на один из них. Ему придётся поискать ответы в другом месте».~
@43955 = ~«Но… я даже не успел спросить…»~
@43956 = ~«Тогда прощай».~
@43957 = ~Немель улыбается и медленно качает головой, твоё лицо отражается в её мерцающих глазах. «Расстроенный и смущённый, он наконец сдался. Было ясно, что эта женщина не знала ничего, что имело бы для него значение. А даже если и знала, он не смог убедить её поделиться с ним».~
@43958 = ~«Что? Нет… просто позволь мне кое-что спросить…»~
@43959 = ~«Тогда прощай».~
@43960 = ~Ты открываешь рот, но слова словно застревают в горле. Как ни стараешься, ты не можешь её ни о чём спросить. Немель грустно качает головой.~
@43961 = ~«Тогда прощай».~
@43962 = ~«„Где она может быть?“ — пожелала знать Немель. Её подруга, Эльвин, должна была встретить её здесь несколько дней назад, — женщина несчастно вздыхает, воздух вокруг неё становится холодным от грусти. — Как долго ей придётся бродить по этому огромному незнакомому городу, пока она не найдёт свою дорогую подругу?»~
@43963 = ~«Я помогу тебе найти подругу. Как она выглядит?»~
@43964 = ~«Я найду её для тебя. Не за просто так, конечно».~
@43965 = ~«Надеюсь, ты её найдёшь. Прощай».~
@43966 = ~Немель складывает в мольбе руки и склоняет голову: «Она была бы так рада услышать новости о своей подруге! Она рассказала доброму незнакомцу, как выглядит Эльвин, чтобы тот узнал её в случае, если встретит». В твоей голове складывается образ: женщина, похожая на Немель, но с золотыми глазами и волосами жгучего малинового цвета.~
@43967 = ~«Я уже встречал эту женщину».~
@43968 = ~«Я вернусь, если найду её. Счастливо».~
@43969 = ~Немель опускает глаза и медленно проговаривает: «Она знает, и незнакомец скоро узнает, что у неё ничего нет. Какую бы цену ни назвал незнакомец, она не сможет заплатить её».~
@43970 = ~«В таком случае я сделаю это бесплатно».~
@43971 = ~«Забудь. Прощай».~
@43972 = ~«Забудь. Прощай».~
@43973 = ~Женщина улыбается, приветствуя тебя. Её красота поражает ещё больше, чем при первой встрече. «Она снова встретила незнакомца. „Зачем, — пожелала знать она, — он снова пришёл?“»~
@43974 = ~«Немель… мне сказали, что ты знаешь командное слово для этого графина».~
@43975 = ~«Тебя ищет твоя подруга, Эльвин».~
@43976 = ~«Ты кого-то ищешь?»~
@43977 = ~«У меня кое-какие вопросы…»~
@43978 = ~«Просто мимо шёл. Прощай».~
@43979 = ~Женщина улыбается, приветствуя тебя. Её красота поражает ещё больше, чем при первой встрече. «Немель затаила дыхание, когда незнакомец приблизился к ней. „Нашёл ли он Эльвин?“ — пожелала знать она».~
@43980 = ~«Мне сказали, что ты знаешь командное слово для этого графина».~
@43981 = ~«Я нашёл Эльвин. Она тоже тебя искала».~
@43982 = ~«Пока я не нашёл её. Позволь задать пару вопросов…»~
@43983 = ~«Нет, просто мимо проходил. Прощай».~
@43984 = ~Немель смыкает руки в замок и склоняет голову. Когда она наконец поднимает глаза и улыбается тебе, волна удовольствия прокатывается по всему твоему телу, почти доводя до головокружения. «Немель ещё раз поблагодарила незнакомца; она просто хотела, чтобы он знал, как счастлива она была воссоединиться с Эльвин».~
@43985 = ~~
@43986 = ~Женщина рычит на тебя, её фиолетовые глаза вспыхивают искрами чистой ненависти. Она говорит, словно читает какую-то книгу: «„Ты — дурак“, — закричала она. „Как ты смеешь таким образом обращаться с дочерью Асахарма! Ты, пёс… — она злобно прищурила глаза, — …и как любой пёс, ты должен умереть!“» Затем делает маленький глоток вина из своей чашки и холодно смотрит на тебя.~
@43987 = ~«А?..»~
@43988 = ~Игнорировать её слова и напасть.~
@43989 = ~Ты сгибаешься к земле, воя в агонии… твои внутренности скручивает, и ты выплёвываешь огромные сгустки чёрной, дымящейся крови. Наконец ты, сотрясаясь, валишься на камни улицы, последние признаки жизни покидают твоё тело…~
@43990 = ~Погрузиться во тьму…~
@43991 = ~Этот красивый юноша кажется погружённым в свои мысли: его брови сдвинуты, губы хмуро поджаты.~
@43992 = ~«Приветствую…»~
@43993 = ~Оставь его наедине со своими мыслями.~
@43994 = ~Этот юноша всё ещё погружён в свои проблемы. Он приветствует тебя, когда ты приближаешься: «И вновь я раскланиваюсь. Ужели что-то от меня нужно?»~
@43995 = ~«У меня кое-какие вопросы…»~
@43996 = ~«Ничего, неважно. Прощай».~
@43997 = ~«И я приветствую тебя, почтенный. Какие нужды тебя привели ко мне?»~
@43998 = ~«У меня кое-какие вопросы…»~
@43999 = ~«Никакие, неважно. Прощай».~
@44000 = ~«Да?»~
@44001 = ~«Кто ты?»~
@44002 = ~«Напомни, кто ты?»~
@44003 = ~«Мне нужно поговорить с тобой о Джульетте».~
@44004 = ~«Мне нужно поговорить с тобой о Джульетте».~
@44005 = ~«Что ты здесь делаешь?»~
@44006 = ~«У меня пара вопросов по поводу этого места…»~
@44007 = ~«Что ты знаешь о Рейвел Клубок-Загадок?»~
@44008 = ~«Ничего, неважно. Прощай».~
@44009 = ~«Меня зовут Монтекки, фактотум Чующих».~
@44010 = ~«Фактотум?»~
@44011 = ~«Чующих?»~
@44012 = ~«У меня ещё вопросы…»~
@44013 = ~«Это всё, что я хотел узнать. Прощай».~
@44014 = ~«Поистине, почтенный. „Член фракции“, буде пожелаешь».~
@44015 = ~«Поистине, почтенный… „Общества Восприятия“. То сигильская фракция, почтенный… самая большая. Буде хочешь поболе знать о Чующих, поговори со Сплинтером. Найдёшь его прямо у входа в это зданье».~
@44016 = ~«Ты сказал „Чующих“?»~
@44017 = ~«У меня другие вопросы…»~
@44018 = ~«Это всё, что я хотел узнать. Прощай».~
@44019 = ~«Ты сказал „фактотум“?»~
@44020 = ~«У меня другие вопросы…»~
@44021 = ~«Это всё, что я хотел узнать. Прощай».~
@44022 = ~«Я работаю помощником одного из управляющих фракцией. Однако ж, ныне всё чаще нахожу, что один из странных жизненных путей завёл меня в тупик».~
@44023 = ~«И какой?..»~
@44024 = ~«Проблемы женского характера».~
@44025 = ~«Ясно. У меня другие вопросы…»~
@44026 = ~«Это всё, что я хотел узнать. Прощай».~
@44027 = ~«В чём конкретно состоит твоя проблема?»~
@44028 = ~«Ты женщина?»~
@44029 = ~«Ясно. У меня другие вопросы…»~
@44030 = ~«Это всё, что я хотел узнать. Прощай».~
@44031 = ~Юноша награждает тебя долгим взглядом: «Нет».~
@44032 = ~«В чём конкретно состоит твоя проблема?»~
@44033 = ~«В любом случае у меня ещё остались вопросы…»~
@44034 = ~«Это всё, что я хотел узнать. Прощай».~
@44035 = ~«Неведомо мне, что ей досаждает. Уж и развеселить её пытался. Ума не приложу, в чём может быть дело».~
@44036 = ~«Как у вас двоих складываются отношения?»~
@44037 = ~«Сочувствую. У меня ещё вопросы…»~
@44038 = ~«Удачи тебе. Прощай».~
@44039 = ~«Буде не считать скуки с досадой — всё прекрасно! Всё, что вращается круг нас, создаёт безмятежность… и семьи наши более чем довольны потенциальным единеньем. Её родня меня обожает. Всё как и положено».~
@44040 = ~«Хм. Возможно, в этом и состоит проблема: никаких проблем».~
@44041 = ~«Сочувствую. У меня ещё вопросы…»~
@44042 = ~«Надеюсь, всё у вас получится. Счастливо».~
@44043 = ~«Как сие возможно, чтобы отсутствие проблем было проблемой? Нижайше попрошу, изъясняйся поясней, почтенный».~
@44044 = ~«Возможно, она хочет придать вашим отношениям немного остроты».~
@44045 = ~«Возможно, она хочет придать вашим отношениям немного остроты».~
@44046 = ~«Неважно, у меня другие вопросы…»~
@44047 = ~«Забудь. Прощай».~
@44048 = ~«Откуда тебе ведомо, чего она желает?! — он начинает закипать. — Мы любим друг друга, любим вне зависимости от обстоятельств. Нам не нужна та низменная и отвратительная мишура, коя признак только зародившейся любви. Я вызываю тебя, почтенный, ибо ты есть подлый трус и глупец!»~
@44049 = ~«Полегче… успокойся».~
@44050 = ~«Ты глуп, если ввязываешься со мной в драку, но так и быть, я тебе её обеспечу…»~
@44051 = ~«Довольно обвинений, мальчишка. У меня ещё вопросы…»~
@44052 = ~«Придержи язык, или я его тебе вырву. Прощай».~
@44053 = ~«Я прошу прощенья… минутный гнев вызвал сии мои слова. Прими мои глубочайшие извинения, благородный сэр».~
@44054 = ~«Пустяки. Ничего страшного».~
@44055 = ~«Просто следи за своими эмоциями. Драка со мной была бы, вероятно, самой большой ошибкой в твоей жизни».~
@44056 = ~Проигнорировать его слова и уйти.~
@44057 = ~«Поистине любезен ты, почтенный».~
@44058 = ~«У меня кое-какие вопросы…»~
@44059 = ~«Мне пора идти».~
@44060 = ~«Я буду следить за собой, почтенный».~
@44061 = ~«У меня кое-какие вопросы…»~
@44062 = ~«Мне пора идти».~
@44063 = ~«О?» — он смотрит на тебя озадаченно, даже несколько подозрительно.~
@44064 = ~«Я случайно подслушал её разговор в Борделе. И знаешь, у неё роман».~
@44065 = ~«Я добиваюсь её любви. И требую, чтобы ты отказался от своих фальшивых притязаний, прежде чем я разнесу тебя на куски».~
@44066 = ~«Вообще-то не бери в голову. У меня другие вопросы…»~
@44067 = ~«Мы поговорим о ней позже. До свидания».~
@44068 = ~«Твои слова отдают ложью. Я требую предъявленья доказательств, прежде чем приму сие за истину».~
@44069 = ~«Я также нашёл эти письма… вот, прочти».~
@44070 = ~Ложь: «Я… видел, как она читала его письма».~
@44071 = ~«Поговорим об этом позже. До свидания».~
@44072 = ~«Нет. Я отказываюсь ставить во главу угла слова и обвинения… Я должен почувствовать тяжесть сих писем у себя на ладони, прежде чем дам оценку ситуации. Когда ты принесёшь мне эти письма, тогда и вернёмся к разговору на эту тему».~
@44073 = ~«Я вернусь, когда достану эти письма. Прощай».~
@44074 = ~Он берёт письма и начинает их читать. «Увы! То правда! Она нашла другого, кто пылко её любит. Ах, полагаю, боль в сердце — то судьба Чующего. Я должен уступить её другому поклоннику, принимая во внимание всю страстность его слов, а себе найти другую любовь».~
@44075 = ~«Погоди, это всё розыгрыш».~
@44076 = ~«В таком случае желаю удачи. Счастливо».~
@44077 = ~«А? Что сие значит?»~
@44078 = ~«Она пытается таким способом заставить тебя быть более страстным».~
@44079 = ~«Не бери в голову… счастливо».~
@44080 = ~«Но отчего же она просто не молвила сего мне?»~
@44081 = ~«Думаю, ей не пришло в голову».~
@44082 = ~«Может, ей так было проще».~
@44083 = ~«По-видимому, нет. Так как же следует поступить?»~
@44084 = ~«Отплатить ей тем же…»~
@44085 = ~«Отплатить ей тем же…»~
@44086 = ~«Я думаю, никак».~
@44087 = ~«Хорошо. Я пока воздержусь от ответных действий».~
@44088 = ~«Я надеюсь, всё образуется. Прощай».~
@44089 = ~«Как хочешь. Счастливо».~
@44090 = ~«Как же мне это сделать, почтенный?»~
@44091 = ~«Скажи, что тебе наскучили ваши отношения, что она тебе уже недостаточно интересна».~
@44092 = ~«Скажи, что у тебя роман».~
@44093 = ~«Я не уверен. Решай сам».~
@44094 = ~«Ты молвишь, что мне следует изобразить отсутствие интереса, дабы вызвать её интерес. Воистину, какова ирония. Я соглашусь на предложение. Посмотрим же, чем всё закончится».~
@44095 = ~«Удачи. Я надеюсь, у тебя всё получится. Счастливо».~
@44096 = ~«Мне пора идти. Счастливо».~
@44097 = ~«Удачи. Я надеюсь, у тебя всё получится. Счастливо».~
@44098 = ~«Мне пора идти. Счастливо».~
@44099 = ~«Такого рода совет может быть опасен, но это без сомнения побудит её задуматься о наших отношениях и бороться за них. Быть посему. Но как же сие содеять?»~
@44100 = ~«Я могу взять это на себя. Скажу, что встретил тебя с другой женщиной».~
@44101 = ~«Я не уверен. Решай сам».~
@44102 = ~«Хорошо. Да будет по-твоему».~
@44103 = ~«А с другой стороны, лучше я позволю тебе разобраться самому».~
@44104 = ~«Я обязательно скажу ей при следующей встрече. Счастливо».~
@44105 = ~«Я обязательно скажу ей при следующей встрече. Счастливо».~
@44106 = ~«Правда?»~
@44107 = ~«Право, мне нравится, как это звучит».~
@44108 = ~«Удачи. Я надеюсь, у тебя всё получится. Счастливо».~
@44109 = ~«Мне пора идти. Счастливо».~
@44110 = ~«Удачи. Я надеюсь, у тебя всё получится. Счастливо».~
@44111 = ~«Мне пора идти. Счастливо».~
@44112 = ~«Ладно… но что же тогда, почтенный?»~
@44113 = ~«Скажи, что тебе наскучили ваши отношения, что она тебе уже недостаточно интересна».~
@44114 = ~«Скажи, что у тебя роман».~
@44115 = ~«Я не уверен. Решай сам».~
@44116 = ~«Но… я мыслил, что мы можем говорить с ней о чём угодно».~
@44117 = ~«Возможно, это одна из тех тем, которые по природе своей редко затрагиваются любящими друг друга людьми».~
@44118 = ~«Ты мог ошибаться».~
@44119 = ~«Как же ты мне посоветуешь поступить, почтенный?»~
@44120 = ~«Отплатить ей тем же…»~
@44121 = ~«Отплатить ей тем же…»~
@44122 = ~«Я думаю, никак».~
@44123 = ~«Ты воспылал к ней любовью и посему желаешь со мной драться?»~
@44124 = ~«Да».~
@44125 = ~«Нет, я не люблю её. Но я бы за неё подрался».~
@44126 = ~Он некоторое время всматривается в тебя. «Я вижу, ты очень страстен в этом вопросе. Страсть произрастает из любви. Ты пылко любишь её, и я не могу лишить её такой любви, как твоя. С сего момента я не имею больше на неё никаких притязаний, ты можешь поступать как пожелаешь».~
@44127 = ~«Постой… это был розыгрыш».~
@44128 = ~«Хм… тогда ладно. Счастливо».~
@44129 = ~~
@44130 = ~«Розыгрыш? Как сие понимать?»~
@44131 = ~«Она хотела заставить тебя драться за неё».~
@44132 = ~«Не бери в голову… счастливо».~
@44133 = ~«О? Ужель она полагала мою любовь столь безграничной, что я буду ввязываться в потасовку с покрытым шрамами человеком твоего сложения? Возможно, она слегка переоценивает мою привязанность к ней. Так… что же теперь делать с сим розыгрышем?»~
@44134 = ~«Отплатить ей тем же…»~
@44135 = ~«Отплатить ей тем же…»~
@44136 = ~«Я думаю, ничего».~
@44137 = ~«Ах, но значит… тобою движет страсть. Страсть произрастает из любви. Ты пылко любишь её, и я не могу лишить её такой любви, как твоя. Я прекрасно знаю о её красоте, сдержанности и добродетели, ведаю, как она вдохновляет мужчин на благородство. С сего момента я не имею больше на неё никаких притязаний, ты можешь поступать как пожелаешь».~
@44138 = ~«Постой… это был розыгрыш».~
@44139 = ~«Хм… тогда ладно. Счастливо».~
@44140 = ~«Общественный Фестхолл? Тебе будет полезней потолковать со Сплинтером. Он прямо у главного входа сего зданья».~
@44141 = ~«У меня другие вопросы…»~
@44142 = ~«Это всё, что я хотел узнать. Прощай».~
@44143 = ~«Хм-м… легендарная ночная ведьма, да? Тебе следует поговорить с Квеллом, почтенный. Ему более иных известно о такого рода вещах. Он где-то в Фестхолле, хотя мне неведомо, где».~
@44144 = ~«У меня другие вопросы…»~
@44145 = ~«Это всё, что я хотел узнать. Прощай».~
@44146 = ~«Счастливо и тебе тоже, почтенный. А теперь меня ждут дела, буде доведётся встретиться вновь, мы ещё затронем сию тему», — Монтекки кланяется и уходит.~
@44147 = ~Уйти.~
@44148 = ~Оставить его в покое.~
@44149 = ~Мужчина будто и не замечает твоего присутствия. Он продолжает работать над вышивкой… когда он шьёт, кажется, будто дрожащие капельки света сверкают, а затем падают с кончика иголки на ткань.~
@44150 = ~«Уважаемый, ты меня слышишь?»~
@44151 = ~«Я сказал „приветствую“».~
@44152 = ~«Уважаемый, ты меня слышишь?»~
@44153 = ~«Я сказал „приветствую“».~
@44154 = ~Уйти.~
@44155 = ~Мужчина даже не отрывает глаз от своей работы и мерзко хмурится, отвечая: «Да, да… я не сомневаюсь, тебе что-то от меня нужно, и это *очень* срочно. Но не мог бы ты помолчать хоть минуточку…»~
@44156 = ~«У меня есть вопросы…»~
@44157 = ~Спокойно ждать.~
@44158 = ~Уйти.~
@44159 = ~~
@44160 = ~Он ухмыляется, но не отвечает.~
@44161 = ~«Я сказал: „У меня есть вопросы…“»~
@44162 = ~Спокойно ждать.~
@44163 = ~Его лицо заливается румянцем; он скрежещет зубами, но по-прежнему не опускается даже до такой малости, как взгляд на тебя. «Меня не *волнует*, есть ли у тебя вопросы! Теперь или помолчи, или будь добр *покинуть* мой магазин!»~
@44164 = ~«Отвечай на мои вопросы, *портной*… или наживёшь себе кучу проблем».~
@44165 = ~Спокойно ждать.~
@44166 = ~Уйти.~
@44167 = ~Он в ярости бросает свою работу и начинает кричать, брызгая слюной изо рта: «Да, тут будут ещё какие *проблемы*, когда придёт стража, чтобы разорвать тебя на кусочки! А теперь ВОН! ВОН! ВОН ИЗ МОЕЙ МАСТЕРСКОЙ! Пока я не позвал Гармониум!»~
@44168 = ~«Ты не *посмеешь* это сделать».~
@44169 = ~Уйти.~
@44170 = ~В конце концов он откладывает вышивку и смотрит на тебя. Прежде чем ты успеваешь что-то сказать, он берётся за другую вещь и начинает работать с ней. И снова будто маленькие цветные искорки летят от ткани, когда он шьёт.~
@44171 = ~«Послушай, у меня всего пара вопросов…»~
@44172 = ~«Отвечай на мои вопросы, *портной*… или наживёшь себе кучу проблем».~
@44173 = ~Подождать ещё немного.~
@44174 = ~Уйти.~
@44175 = ~Мужчина шумно вздыхает: «Несомненно, они у тебя есть. Ты был достаточно любезен, чтобы чуток тихо подождать… я уверен, ты не умрёшь, если попридержишь свой язык ещё пару минут…»~
@44176 = ~«Отвечай на мои вопросы, *портной*… или наживёшь себе кучу проблем».~
@44177 = ~Подождать ещё немного.~
@44178 = ~Уйти.~
@44179 = ~Наконец он завершает свою работу и опускает её вниз, переводя вопросительный взгляд на тебя: «Привет, я Гонкальвес. Так что там было от меня так нужно?»~
@44180 = ~«У меня вопросы…»~
@44181 = ~«Ничего, неважно. Прощай».~
@44182 = ~«Гм? Я надеюсь, они об одежде и тому подобных вещах. Я не намерен отвечать на вопросы, не касающиеся моего дела и моей мастерской, знаешь ли».~
@44183 = ~«Я хотел приобрести костюм Пыльного».~
@44184 = ~«Я хотел подобрать себе другой костюм».~
@44185 = ~«Что это за огоньки, когда ты шьёшь?»~
@44186 = ~«Какая-нибудь магическая одежда есть в продаже?»~
@44187 = ~~
@44188 = ~«Тогда прощай».~
@44189 = ~Пустой узел.~
@44190 = ~~
@44191 = ~~
@44192 = ~~
@44193 = ~~
@44194 = ~Пустой узел.~
@44195 = ~~
@44196 = ~~
@44197 = ~~
@44198 = ~«Это? Ничего особенного, сэр, просто немного Искусства, которое я иногда вплетаю в ткань, когда на меня находит фантазия. Вещи, в которые я добавляю немного очарования, — самые лучшие мои творения, и я редко их продаю».~
@44199 = ~«Какая-нибудь магическая одежда есть в продаже?»~
@44200 = ~«У меня другие вопросы…»~
@44201 = ~«Это всё, что я хотел узнать. Прощай».~
@44202 = ~Гонкальвес оглядывает тебя и хмурится: «Ничего, что бы подошло *тебе*, это уж точно».~
@44203 = ~«Я в любом случае хочу посмотреть, что у тебя есть».~
@44204 = ~«Тебе повезло, уважаемый… у меня как раз один имеется. Его цена — тридцать медяков».~
@44205 = ~«Беру».~
@44206 = ~«Хм… у меня столько нет. Но есть другие вопросы…»~
@44207 = ~«Вообще-то забудь. У меня другие вопросы…»~
@44208 = ~«Возможно, я ещё вернусь. Счастливо».~
@44209 = ~Гонкальвес достаёт из-под прилавка аккуратно сложенный комплект одежды: «Вот, сэр. Однако я должен предупредить: если это для маскарада в доме лорда Ирда, то уже многие будут наряжены Пыльными».~
@44210 = ~«Буду иметь в виду. Счастливо, Гонкальвес».~
@44211 = ~Гонкальвес кивает и понимающе улыбается: «Наряд Пыльного кажется в наши дни довольно банальным? Ну, по чистой случайности у меня есть костюм Боготов, если пожелаешь. Он будет стоить всего пятьдесят медяков».~
@44212 = ~«Беру».~
@44213 = ~«Хм… у меня столько нет. Но есть другие вопросы…»~
@44214 = ~«Вообще-то забудь. У меня другие вопросы…»~
@44215 = ~«Возможно, я ещё вернусь. Счастливо».~
@44216 = ~Гонкальвес достаёт из-под прилавка сложенный комплект одежды, тяжёлый кожаный фартук и рабочие ботинки: «Вот, сэр. Хорошо повеселиться на маскараде».~
@44217 = ~«Спасибо, Гонкальвес. Прощай».~
@44218 = ~Мужчина поднимает глаза от своей работы и, кажется, впервые видит Анну. Мягко поцокав, он качает головой: «Девочка, что за безумные ветра Пандемониума *заставили* тебя так одеться?»~
@44219 = ~Он показывает на наряд Анны: «Кожа, мисс. Совершенно непрактично. Акцент на линии бюста, особенно на *ох-какой-удобной* перекрёстной шнуровке корсажа. Твой наряд, *очевидно*, был сшит, чтобы вызывать гормональные всплески у мужчин, а не для того, чтобы тебе было удобно. Даже если ты что-то имеешь против моего вкуса и авторитета, как у вас, тифлингов, принято, это, в конечном счёте, просто вредно для тебя…»~
@44220 = ~Постараться вклиниться.~
@44221 = ~Позволить им продолжать разговор.~
@44222 = ~Гонкальвес продолжает распекать Анну. «И действительно, ты выглядишь больше готовой к занятиям в Фестхолле, чем… — он хмурится. — Кстати, ты ведь не Чующая, так ведь?»~
@44223 = ~Портной кивает: «Вот и я так не думаю. Вовсе нет. Почему бы тебе не позволить мне присмотреть для тебя что-нибудь более скромное…»~
@44224 = ~Постараться вклиниться.~
@44225 = ~Позволить им продолжать разговор.~
@44226 = ~«Как пожелаешь, леди, — портной переводит взгляд на тебя. — А теперь, уважаемый, раз уж мою работу так основательно и надолго прервали… я Гонкальвес. Что именно тебе от меня понадобилось?»~
@44227 = ~«У меня вопросы…»~
@44228 = ~«Ничего, неважно. Прощай».~
@44229 = ~Гонкальвес немедленно отрывается от своей работы и вежливо кланяется Падшей Грейс, она отвечает ему тем же. «Здравствуйте, леди Грейс. Чем я могу помочь на сей раз? Тот заказ практически выполнен…»~
@44230 = ~«Конечно! — Гонкальвес поворачивается к тебе. — Итак, сэр… что именно понадобилось от меня?»~
@44231 = ~«У меня вопросы…»~
@44232 = ~«Ничего, неважно. Прощай».~
@44233 = ~Портной всё ещё вышивает узоры на той же самой ткани, над которой трудился до этого. Кажется, он тебя совсем не замечает.~
@44234 = ~«Приветствую…»~
@44235 = ~Оставить его в покое.~
@44236 = ~Гонкальвес откладывает свою работу и кивает тебе: «Снова ты пришёл, уважаемый… хорошо. Чем я могу помочь?»~
@44237 = ~«У меня вопросы…»~
@44238 = ~«Просто проходил мимо, Гонкальвес. Прощай».~
@44239 = ~Ты видишь женщину средних лет. Её лицо покрыто морщинами заботы и сочувствия. Судя по виду, жизнь её была нелегка. «Могу я тебе чем-то помочь, незнакомец?»~
@44240 = ~Портной недовольно кривит лицо: «Я бы посоветовал *уйти*, любезный, пока я снова не вызвал стражу. Ни словами, ни делами тебе не загладить той обиды, которую ты мне нанёс. Вон!»~
@44241 = ~«Мне сказал… друг… что я могу найти здесь ячейку Анархистов. Пароль — „затмение“».~
@44242 = ~«Давай, зови стражу».~
@44243 = ~Уйти.~
@44244 = ~Морте подлетает к тебе и шепчет на ухо: «Чушь. По мне, так круто. А, шеф? Зырк-зырк, толк-толк…»~
@44245 = ~В ужасе Морте даже подпрыгивает: «Нет! Мужик, ты что *спятил*?! Ничего безумнее я не слышал!»~
@44246 = ~«Хренов мягкотелый увалень… — рычит Анна. — Эй, ты! Нам надоело ждать, так что лучше б ты…»~
@44247 = ~«Кто ты?»~
@44248 = ~«Что это за место?»~
@44249 = ~«Я ищу летающий и постоянно язвящий череп. Нигде такого не видела?»~
@44250 = ~Анна выглядит удивлённой: «А?» Её удивление быстро сменяется недовольством: «Что ты хочешь этим *сказать*?»~
@44251 = ~«Мне ничего не нужно. Прости. Счастливо».~
@44252 = ~Анна выглядит сконфуженной: «Не-а. Не-а, я не Чующая…»~
@44253 = ~«Не-а, мне нравится это. Меня не парит ни жара, ни холод, из-за моей крови, наверно. И следи за своим базаром по поводу тифлингов, ага?»~
@44254 = ~«Помочь что-нибудь найти?»~
@44255 = ~«Мне сказал… друг… что я могу найти здесь ячейку Анархистов. Пароль — „затмение“».~
@44256 = ~«Кто ты?»~
@44257 = ~«Что это за место?»~
@44258 = ~«Я ищу летающий и постоянно язвящий череп. Нигде не доводилось видеть?»~
@44259 = ~«Здравствуй, мастер Гонкальвес».~
@44260 = ~«Мне ничего не нужно. Прости. Счастливо».~
@44261 = ~«Я не требую спешки, мастер Гонкальвес; твоё мастерство требует времени, и нет сомнения в том, что все вещи, сделанные твоими руками, радуют глаз. На этот раз я пришла не по своему делу. Этот человек… — Падшая Грейс кланяется тебе, — …хотел на мгновение отвлечь тебя…»~
@44262 = ~«Так быстро вернулся? Кому-то уже разрушил планы?»~
@44263 = ~«Ещё нет. Просто нужны ответы на кое-какие вопросы».~
@44264 = ~«Тот офицер Гармониума? Он мёртв».~
@44265 = ~«Пока нет. Мне нужно кое-что спросить».~
@44266 = ~«Ещё нет. Мне нужно кое-что спросить».~
@44267 = ~«Я работаю над этим. Счастливо».~
@44268 = ~Она очень внимательно тебя осматривает и бормочет под нос что-то вроде «Нужно побыстрее его сменить…» Затем берёт себя в руки и смотрит тебе прямо в глаза: «Так ты один из нас, да? Докажи это».~
@44269 = ~«Как?»~
@44270 = ~«Я не должен ничего тебе доказывать».~
@44271 = ~«Человек, который дал мне эту информацию, — Своевольный Пенн. Он сказал, что тебе знакомо его имя».~
@44272 = ~«Я Лиена. Прораб этих двоих», — она показывает рукой на своих компаньонов.~
@44273 = ~«Что ты здесь делаешь?»~
@44274 = ~«Что это за место?»~
@44275 = ~«Мне сказал… друг… что я могу найти здесь ячейку Анархистов. Пароль — „затмение“».~
@44276 = ~«Спасибо. Прощай».~
@44277 = ~«Это склад. Я прораб. Здесь хранятся товары, отсюда получают товары… — она пожимает плечами. — Рассказывать особо не о чём».~
@44278 = ~«Мне сказал… друг… что я могу найти здесь ячейку Анархистов. Пароль — „затмение“».~
@44279 = ~«Ясно. Спасибо. Счастливо оставаться».~
@44280 = ~«Летающий череп? Извини. Не видела здесь ничего подобного. Если тебе нужен череп, я бы попробовала поискать в Костях Ночи — тебе, похоже, нравится ходить в шрамах, а Лотар тебе ещё добавит в коллекцию, это уж точно, как ненависть балоров к исчадиям ямы».~
@44281 = ~«Спасибо. Прощай».~
@44282 = ~«Ты достиг успеха в своём… деле? Мне нужен честный ответ, сейчас».~
@44283 = ~~
@44284 = ~Найти ангела, о котором говорила Рейвел.~
@44285 = ~Рейвел утверждала, что забрала у меня мою смертность. Но, РАЗУМЕЕТСЯ, сейчас она и понятия не имеет, где эта проклятая штука находится. Однако Рейвел сказала, что есть ангел, «дэв», который может знать, что именно случилось с моей смертностью. По словам Рейвел, я должен всего лишь покинуть её лабиринт и попаду в тюрьму, где и найду этого дэва.~
@44286 = ~Я нашёл ангела, о котором мне поведала Рейвел, «Триаса», заключённым в Керсте. Тяжело даже представить себе, что жители города могут так обращаться с ангелом… это и правда город головорезов и предателей. Хотя… не слишком-то сильно он отличается от ОСТАЛЬНЫХ мест, в которых я бывал.~
@44287 = ~Убить крысу-оборотня в подвале Финеаса.~
@44288 = ~Я пришёл в Управление по контролю за паразитами и болезнями, чтобы встретиться с Финеасом Т. Лортом. Он выглядел довольно обескураженным и бессвязно бормотал о том, что в его подвале завелась крыса-оборотень. Я согласился убить это существо за вознаграждение.~
@44289 = ~Я убил крысу-оборотня и получил награду от Финеаса. Награда была достаточно скудной, учитывая, через что я прошёл, выполняя поручение. Ну да ладно, деньги есть деньги.~
@44290 = ~По просьбе Нодда разыскать Амариссу.~
@44291 = ~Сборщик по имени Нодд попросил меня найти его сестру Амариссу и поговорить с ней. Он сказал, что она привлекательная молодая женщина, живущая где-то в Улье; у неё светлая кожа, чёрные волосы, и она всегда носит голубое. Я согласился ему помочь.~
@44292 = ~Я разыскал Амариссу, сестру Нодда, и сказал ему, где она бывает.~
@44293 = ~Я разыскал Амариссу, сестру Нодда, и сказал ему, где она бывает. Однако я солгал, что Амарисса — грязная шлюха. Он обезумел и набросился на меня.~
@44294 = ~Найти и вернуть Ухиру его «счастливый ножик».~
@44295 = ~Сборщик по имени Ухир сказал, что потерял в катакомбах под Сигилом свой «счастливый ножик»: всадил его в глаз упыря и сбежал. Если вдруг нож мне попадётся, возможно, стоит вернуть его хозяину.~
@44296 = ~Я нашёл и вернул Ухиру его «счастливый ножик».~
@44297 = ~Искать и убивать любых черепокрыс в Мёртвых Народах.~
@44298 = ~Харгримм сказал, что я должен убивать любых черепокрыс, каких здесь встречу.~
@44299 = ~Я сказал Харгримму, что нашёл и убил в пределах владений Мёртвых Народов нескольких черепокрыс. Он поблагодарил меня, но ничего больше.~
@44300 = ~Чёрная Роза требует убить Гнилого Уильяма.~
@44301 = ~~
@44302 = ~«Да. Он мёртв».~
@44303 = ~Правда: «Ещё нет».~
@44304 = ~Ложь: «Да. Он мёртв».~
@44305 = ~«Гм-м… напомни, что я должен был сделать?»~
@44306 = ~«Ты должен был убрать этого придурка из Гармониума Вортена. Сейчас же отправляйся и не трать моего времени!»~
@44307 = ~«Я просто хотел задать вопрос…»~
@44308 = ~«Тогда прощай».~
@44309 = ~Она отворачивается и принимается командовать своими подчинёнными, не обращая внимания на тебя.~
@44310 = ~«Тогда прощай».~
@44311 = ~«Прошу, не лги мне. Это означает, что ты не принимаешь во внимание мои источники, и делает тебя в моих глазах ещё более глупым. Иди и выполняй свою работу, сейчас же».~
@44312 = ~«Я просто хотел задать пару вопросов!»~
@44313 = ~«Ну хорошо. Я ещё вернусь».~
@44314 = ~«Хорошо, хорошо… он довольно близко подобрался к одной из наших операций, даже если сам этого не осознавал. Это должно сбить угнетателей в красной броне со следа после очередной жертвы, — её глаза блестят. — Ты прошёл проверку. Как бы то ни было, что тебе нужно?»~
@44315 = ~«Я хотел задать вопрос…»~
@44316 = ~«Место для ночлега».~
@44317 = ~«Я хотел приобрести кое-что особенное».~
@44318 = ~«Пока ничего. Счастливо».~
@44319 = ~«Что ты хотел знать?»~
@44320 = ~«Мне нужно место для ночлега».~
@44321 = ~«Я хотел приобрести кое-что особенное».~
@44322 = ~«Расскажи мне немного о вашей ячейке».~
@44323 = ~«Чего вы пытаетесь добиться?»~
@44324 = ~«Что привело тебя в Анархисты?»~
@44325 = ~«Что ты можешь рассказать о Революционной Лиге?»~
@44326 = ~«Думаю, больше ничего. Прощай».~
@44327 = ~«Поговори с Коналлом. У нас этим занимается он».~
@44328 = ~«Хорошо. Тогда ответь мне ещё на пару вопросов…»~
@44329 = ~«Спасибо».~
@44330 = ~Она широко раскрывает глаза: «У него очень высокое положение, знаешь ли. По крайней мере так говорят мои осведомители. Что тебе нужно?»~
@44331 = ~«Просто хочу получить ответы на вопросы…»~
@44332 = ~«Пока ничего. Просто хотел представиться. Счастливо».~
@44333 = ~«Вообще-то должен. В противном случае мы не можем точно знать, не купил ли ты этот пароль у какого-нибудь предателя и не очередной ли ты безмозглый болтун. Есть только один способ: ты доказываешь свою преданность. Иначе ты умираешь».~
@44334 = ~«Я докажу свою преданность».~
@44335 = ~«Так попробуй меня убить, если духу хватит».~
@44336 = ~«Ладно», — она подзывает свистом своим товарищей, и они немедленно нападают!~
@44337 = ~Драться.~
@44338 = ~Бежать.~
@44339 = ~«Есть такой офицер Гармониума по имени Вортен. Ты найдёшь его в Нижнем районе, недалеко от выхода в Улей. Устрани его и возвращайся сюда с новостями о своём успехе, — она уже было собирается отвернуться, но останавливается. — И не пытайся мне врать — у меня глаза *повсюду*».~
@44340 = ~«Я в деле».~
@44341 = ~«Забудь об этом. Сначала тебе придётся убить меня».~
@44342 = ~«Нас всего трое. Мы докладываем другому, чьё имя я не назову, но работаем мы самостоятельно. Иногда человек со стороны может привести к нам кого-то, и в зависимости от того, что нам известно об этом человеке, мы либо помогаем ему, либо нет. Коналл наш кладовщик, Отис наши мускулы, а я — мозги».~
@44343 = ~«Откуда вы знаете, кому можно доверять?»~
@44344 = ~«У меня были ещё вопросы…»~
@44345 = ~«Спасибо. Прощай».~
@44346 = ~«Мы пытаемся разрушить существующую систему, до основания сокрушить всю эту прогнившую структуру. Пусть мир достанется кротким, согласен? И сейчас».~
@44347 = ~«Хм. У меня ещё вопросы…»~
@44348 = ~«Ясно. Спасибо».~
@44349 = ~«Ты хочешь сказать, если не считать семей, расколотых милитаристскими действиями Гармониума? Если не считать моих друзей, чахнущих и умирающих от ужасного смога, извергаемого Боготами? Если не считать разрушающих души требований Обречённых и Чующих, потакающим своим желаниям удовольствий, в то время как другие страдают? О, никаких причин нет. Почему бы мне должно не нравиться такое положение вещей?»~
@44350 = ~«Хорошо. Можешь ответить ещё на пару вопросов?»~
@44351 = ~«Спасибо. Прощай».~
@44352 = ~«Ты и так уже слишком много знаешь, особенно для того, кто не часть нашей ячейки. Вот как это работает: мы разбиваемся на ячейки для того, чтобы одна группа не смогла уничтожить другую по неосторожности или при неудачном стечении обстоятельств. Иногда мы работаем над одним и тем же заданием, но по большей части мы — колючки в лапах угнетателей, которые в настоящее время правят Сигилом. Мы достаточно их стесняем, чтобы они воспринимали нас серьёзно».~
@44353 = ~«Но как же вы поддерживаете связь друг с другом? У вас есть организованная структура?»~
@44354 = ~«Звучит многообещающе… и опасно. У меня другие вопросы…»~
@44355 = ~«Спасибо. Прощай».~
@44356 = ~«Мы и не знаем. Поэтому доверяем только друг другу. Даже между собой мы стараемся быть осторожными. Полностью мы не доверяем никому. Это опасная игра, но необходимо играть по её правилам, если мы хотим достичь свободы».~
@44357 = ~«Если вы не можете доверять друг другу, как вы можете знать, к чему движетесь?»~
@44358 = ~«У меня были другие вопросы…»~
@44359 = ~«Спасибо. Прощай».~
@44360 = ~«В настоящее время у нас нет другой цели, кроме разрушения существующих паразитических порядков. Уничтожение коррупции стоит на первом месте. Выздоровление сможет начаться только тогда, когда мы удалим раковую опухоль на теле общества».~
@44361 = ~«Ясно. Тогда ответь мне на другой вопрос…»~
@44362 = ~«Спасибо. Прощай».~
@44363 = ~«У нас есть безопасные места, разбросанные по Великому Кольцу. Лучшее из них — по последним данным — это сильная ячейка в Керсте, городе-вратах в Карцери. Они, скорее всего, не проявят себя, пока не случится что-либо ДЕЙСТВИТЕЛЬНО существенное. Этот город полон предателей, и лучше всего не высовываться, когда народ так подозрителен».~
@44364 = ~«Спасибо. У меня другие вопросы».~
@44365 = ~«Спасибо. Прощай».~
@44366 = ~Ты видишь худого вороватого мужчину. Его длинные тонкие пальцы слегка подрагивают, и он избегает смотреть тебе прямо в глаза, когда говорит: «Ты меня напугал! Я… я никогда раньше тебя здесь не видел, незнакомец. Что… что от меня нужно?»~
@44367 = ~Этот грубого вида мужчина с жёлтой кожей окидывает тебя взглядом. Его глаза расширяются, и он выхватывает меч: «Собака! Любящая гитцерай собака!» Он бросается на тебя!~
@44368 = ~Атаковать.~
@44369 = ~Бежать.~
@44370 = ~«Мне сказал… друг… что я могу найти здесь ячейку Анархистов. Пароль — „затмение“».~
@44371 = ~«Кто ты?»~
@44372 = ~У этого мужчины грубая кожа бледно-жёлтого оттенка и худощавое, угловатое лицо. Нос у него маленький и высоко посаженный, а уши заострены на концах. Тело покрывают следы татуировок и шрамов. На нём одеты странные, броские кожаные доспехи, скорее всего, больше пригодные для украшения, чем для боя. Похожие на два маленьких чёрных камня глаза внимательно следят за твоим приближением. «Ты человек, ищущий свою память, — говорит он без всякого выражения. — Я могу тебе помочь».~
@44373 = ~«Что это за место?»~
@44374 = ~«Ничего. Прощай».~
@44375 = ~«Ты гитиянки, ведь так?»~
@44376 = ~Его неловкость тут же куда-то исчезает, и он становится очень деловитым: «Да. А он показал тебе секретное рукопожатие? Твоё магическое шифровальное кольцо? Ты знаешь секретный гимн ячейки? Хоть что-то из этого знаешь?» Он оглядывает тебя с головы до ног и говорит: «Очевидно, нет. В следующий раз, как насчёт того, чтобы я спрашивал у тебя пароль?» Он вздыхает: «Что тебе нужно?»~
@44377 = ~«Я бы хотел кое-чего приобрести».~
@44378 = ~«Кто ты?»~
@44379 = ~«Мне нужно место, где можно спрятаться».~
@44380 = ~«Приветствую, звучащий клинок».~
@44381 = ~«Я хочу задать вопрос о вашей ячейке».~
@44382 = ~«Чего вы пытаетесь добиться?»~
@44383 = ~«Почему ты стал Анархистом?»~
@44384 = ~«Наверное, ничего. Счастливо».~
@44385 = ~«Как ты это узнал?»~
@44386 = ~«Надеюсь тебе это понравится».~
@44387 = ~«Да, спасибо. Счастливо».~
@44388 = ~«Как ты можешь мне помочь?»~
@44389 = ~«Ты знаешь первое правило секретного революционера? — не дожидаясь твоего ответа, он говорит сам. — Это держать всё в *секрете*. Я не выдаю секретов, товарищ, неважно, *кто*, по твоим словам, прислал тебя сюда. Теперь, когда между нами всё ясно, что ещё тебе нужно?»~
@44390 = ~«Спасибо, но мне неинтересно. Прощай».~
@44391 = ~У этого мужчины грубая кожа бледно-жёлтого оттенка и худощавое, угловатое лицо. Нос у него маленький и высоко посаженный, а уши заострены на концах. Тело покрывают следы татуировок и шрамов. На нём одеты странные, броские кожаные доспехи, скорее всего, больше пригодные для украшения, чем для боя. Похожие на два маленьких чёрных камня глаза внимательно следят за твоим приближением. «Ты человек, ищущий свою память, — говорит он без всякого выражения. — Я могу тебе помочь».~
@44392 = ~«Ты гитиянки, ведь так?»~
@44393 = ~«Кто ты?»~
@44394 = ~«Приветствую, звучащий клинок».~
@44395 = ~«Я бы хотел кое-чего приобрести».~
@44396 = ~«Мне нужно место, где можно спрятаться».~
@44397 = ~«Чего вы пытаетесь добиться?»~
@44398 = ~«Как ты это узнал?»~
@44399 = ~«Почему ты стал Анархистом?»~
@44400 = ~«Наверное, ничего. Счастливо».~
@44401 = ~«Как ты можешь мне помочь?»~
@44402 = ~«Спасибо, но мне неинтересно. Прощай».~
@44403 = ~«Чего мы пытаемся добиться — это секрет. В этом весь смысл подпольной организации, ты со мной согласен? Поймёшь это, когда сам увидишь, а ты не увидишь этого ещё долгое время. Мы строим свои планы очень *осторожно*, понимаешь, о чём я говорю? Итак, об осторожности мы уже поговорили, что ещё тебе нужно?»~
@44404 = ~«Имею честь быть представителем этого народа, — говорит он ровным голосом. — Хочешь ли ты, чтобы я помог тебе вернуть память?»~
@44405 = ~«Кто или что ты?»~
@44406 = ~«Хм-м. Не сегодня, спасибо».~
@44407 = ~«Я Йи'минн. Я гитиянки-рыболов. Мой народ — бесспорный повелитель Астрального плана, куда приходят умирать боги и воспоминания умерших плавают, как листья в пруду. В мои обязанности входит изымать у мёртвых память и просматривать её в поисках информации. Я могу найти твою память. Тебе нужно только заплатить».~
@44408 = ~«Какова твоя цена?»~
@44409 = ~«Я бы хотел кое-чего приобрести».~
@44410 = ~«Мне это неинтересно. Прощай».~
@44411 = ~«Мне нужно место, где можно спрятаться».~
@44412 = ~«Я хочу задать вопрос о вашей ячейке».~
@44413 = ~Его лицо и мускулы вмиг напрягаются, а рука непроизвольно тянется за мечом. «Ты обратился ко мне на языке этих собак гитцерай. Это было неведение или оскорбление?»~
@44414 = ~«Почему ты стал Анархистом?»~
@44415 = ~«Наверное, ничего. Счастливо».~
@44416 = ~«Неведение».~
@44417 = ~«Оскорбление».~
@44418 = ~«Оглянись вокруг, пень. Ты видишь хоть одного свободного? Видишь хоть кого-нибудь, кому на горло не наступил кто-то другой? Помыкают даже теми, кто считает себя важными. Кто-то должен свергнуть систему».~
@44419 = ~«Разве ты не гитцерай?»~
@44420 = ~«И чем её заменить?»~
@44421 = ~«Звучит как довольно хорошая причина. Счастливо».~
@44422 = ~«Ни то ни другое».~
@44423 = ~«Не я это буду решать, пень. Я хорошо умею разрушать и оставлять другим собирать осколки. Я разрушаю для того, чтобы другие смогли творить. Каждому своё. Я оптимист: верю, что люди смогут сотворить что-то хорошее. Но, прежде чем они это сделают, мне придётся продолжить разрушение того, что есть».~
@44424 = ~«А кто решает, что хорошо? Почему ты считаешь себя таким особенным?»~
@44425 = ~«Ты выглядишь одним из таких. По долгу службы мы встречаем много тебе подобных».~
@44426 = ~«Отлично. Рад за тебя. Прощай».~
@44427 = ~«Я считаю себя особенным, потому что не сижу сложа руки, а делаю дело. То, что я борюсь за равенство, даёт мне право решать, что хорошо, что плохо. Пока не увижу, что к простому жителю Улья относятся так же, как к Золотому Лорду, я буду продолжать бороться».~
@44428 = ~«Хорошо. Это всё, что я хотел знать. Счастливо».~
@44429 = ~«Я Коналл. Я здесь работаю».~
@44430 = ~«И что это за место?»~
@44431 = ~«Мне сказал… друг… что я могу найти здесь ячейку Анархистов. Пароль — „затмение“».~
@44432 = ~«Кто или что ты?»~
@44433 = ~Он внимательно на тебя смотрит, пытаясь понять, не шутишь ли ты: «Это Хранилище Девятого Мира. Склад. Ты разве не прочитал вывеску у входа?»~
@44434 = ~«Оставь меня. Мне неинтересно твоё шарлатанство».~
@44435 = ~«Мне сказал… друг… что я могу найти здесь ячейку Анархистов. Пароль — „затмение“».~
@44436 = ~«Не очень внимательно. Кто ты?»~
@44437 = ~«Разве я не гитиянки? Разве мы не обитаем на полях Астрала? Я ловец исчезнувших воспоминаний. Я знаю, как заманить воспоминания. И знаю, как их поймать, — он замолкает и наклоняется к тебе с видом заговорщика. — Я знаю, как *восстановить* их. Всё, что тебе нужно, — это заплатить».~
@44438 = ~«Спасибо за ответ. Счастливо».~
@44439 = ~«Какова твоя цена?»~
@44440 = ~«Опять ты? Если тебе что-нибудь нужно, иди записывайся у головы на входе».~
@44441 = ~«Что ты можешь рассказать об Астральном плане?»~
@44442 = ~«Мне сказал… друг… что я могу найти здесь ячейку Анархистов. Пароль — „затмение“».~
@44443 = ~«Кто ты?»~
@44444 = ~«Что это за место?»~
@44445 = ~«Меня это не интересует. Прощай».~
@44446 = ~«Спасибо. Прощай».~
@44447 = ~«Помни о моём предложении, человек. Если захочешь вернуть свои воспоминания, найди меня. Запомни мои слова».~
@44448 = ~«У тебя неприятности? Что-нибудь нужно?»~
@44449 = ~«Я бы хотел кое-чего приобрести».~
@44450 = ~«Буду иметь в виду. Прощай».~
@44451 = ~«Мне нужно место, где можно спрятаться».~
@44452 = ~«Я хочу задать вопрос о вашей ячейке».~
@44453 = ~«Чего вы пытаетесь добиться?»~
@44454 = ~«Почему ты стал Анархистом?»~
@44455 = ~«Речь идёт об очень небольшой сумме. Цена договорная. Я прошу сто. Ты сам установишь цену воспоминаниям и соответственно мне заплатишь».~
@44456 = ~«Наверное, ничего. Счастливо».~
@44457 = ~«Звучит неплохо. Что я должен сделать?»~
@44458 = ~«Может, в другой раз. Прощай».~
@44459 = ~«Чтобы я зацепил на крючок твои воспоминания, мне нужны те, что принадлежат тебе теперь. Мне также нужно тихое место, где я смогу сконцентрироваться. Если ты последуешь за мной, мы придём в такое место и я снова сделаю тебя полноценным. Мы должны пойти одни, без сопровождения».~
@44460 = ~«Согласен. Пошли».~
@44461 = ~«Вероятно, не сейчас».~
@44462 = ~«Я чувствую ловушку, собака гитиянки. Твои *иллитидские* хозяева должны были держать тебя на цепи».~
@44463 = ~Без единого слова рыболов лёгким движением выхватывает своё оружие и бросается на тебя!~
@44464 = ~Драться.~
@44465 = ~Бежать.~
@44466 = ~«Теперь ты можешь умолять о прощении», — он стоит неподвижно, его глаза бегают по твоему телу.~
@44467 = ~«Я приношу свои извинения».~
@44468 = ~«Умолять? Тебя?»~
@44469 = ~«Что, не нравится, когда тебя называют гитцерай?»~
@44470 = ~«Совершенно исключено».~
@44471 = ~«Да, — он скалится. — Ты произнёс непростительное оскорбление. Но можешь умолять о прощении».~
@44472 = ~«Я приношу свои извинения».~
@44473 = ~«Что, не нравится, когда тебя называют гитцерай?»~
@44474 = ~«Совершенно исключено».~
@44475 = ~«Я — *гитиянки*. Я не имею ничего общего с этими собаками гитцерай. Ты можешь сказать то же самое про себя?»~
@44476 = ~Правда: «Я знаком с некоторыми гитцерай. Прекрасный народ».~
@44477 = ~Ложь: «Я знаком с некоторыми гитцерай. Прекрасный народ».~
@44478 = ~Правда: «Гитцерай для меня значат меньше, чем ничего».~
@44479 = ~Ложь: «Гитцерай для меня значат меньше, чем ничего».~
@44480 = ~Правда: «Гитцерай для меня значат меньше, чем ничего».~
@44481 = ~Ложь: «Гитцерай для меня значат меньше, чем ничего».~
@44482 = ~Ты видишь неповоротливого мужчину с тупым лицом и выпирающей челюстью. Его мускулы, однако, достойны кисти художника. Он неподвижно смотрит на тебя безжизненным взглядом: «Чё?»~
@44483 = ~«Так ты симпатизируешь этим собакам гитцерай? Стань же трупом!» — он выхватывает клинок и атакует!~
@44484 = ~Драться.~
@44485 = ~«Мне сказали, что здесь можно найти ячейку Анархистов. Пароль — „затмение“».~
@44486 = ~«Кто ты?»~
@44487 = ~«Что это за место?»~
@44488 = ~Бежать.~
@44489 = ~«Забудь. Прощай».~
@44490 = ~«Тогда забудь. Это как пыль. Давай сменим тему. Есть воспоминания, которые ты хочешь вернуть. Я могу это сделать. Нам нужно только договориться о цене».~
@44491 = ~«Какова твоя цена?»~
@44492 = ~«Сейчас мне это неинтересно».~
@44493 = ~Оскал не исчезает, а тело остаётся всё таким же напряжённым. «Ты говоришь, они для тебя ничто, хотя обратился ко мне их приветствием. Так где же правда?»~
@44494 = ~«Ты меня поймал. Я не считаю их плохими».~
@44495 = ~«Они для меня ничто. Я признаю своё невежество, свою ошибку и приношу извинения. Так лучше?»~
@44496 = ~«Вот и отлично. Кровь гитцерай как вода, их племя слабо. Давай поговорим о других вещах: есть воспоминания, которые ты хочешь вернуть. Я могу это сделать. Нам нужно только договориться о цене».~
@44497 = ~«Какова твоя цена?»~
@44498 = ~«Предлагаю пока отложить эту тему».~
@44499 = ~«Тут возможно только два варианта: из неведения или нарочно. Какой же из них?»~
@44500 = ~«Я сказал так из неведения».~
@44501 = ~«Это было оскорблением».~
@44502 = ~«Это не-место, пространство между пространствами, где единственное, что имеет значение, — разум. Там живёт мой народ. Когда кто-либо умирает, его душа улетает на Внешние планы. Проходя через Астральный план, души лишаются воспоминаний, и те остаются плавать в Серебряном море. Я знаю об этом море всё. Я помогу тебе восстановить память. Нам остаётся только договориться о цене».~
@44503 = ~«Какова твоя цена?»~
@44504 = ~«Ты ищешь свою память, ведь так, человек? Я могу её тебе вернуть. Твоя растерянность явно возрастает. Тебе нужно всего лишь заплатить небольшую цену за покой в своих мыслях».~
@44505 = ~«Предлагаю пока отложить эту тему».~
@44506 = ~«Какова твоя цена?»~
@44507 = ~«Расскажи мне больше о твоём народе».~
@44508 = ~«Не сегодня, спасибо. Прощай».~
@44509 = ~«Ты ищешь свою память, ведь так, человек? Я могу её тебе вернуть. Твоя растерянность явно возрастает. Тебе нужно всего лишь заплатить небольшую цену за покой в своих мыслях».~
@44510 = ~«Какова твоя цена?»~
@44511 = ~«Расскажи мне больше о твоём народе».~
@44512 = ~«Не сегодня, спасибо. Прощай».~
@44513 = ~«Ответ может содержаться в твоих потерянных воспоминаниях. Давай начнём, и ты узнаешь».~
@44514 = ~«Какова твоя цена?»~
@44515 = ~«Что это будет в себя включать?»~
@44516 = ~«Не думаю, что сейчас мне это нужно».~
@44517 = ~«Когда ты передумаешь — а ты передумаешь, человек, — возвращайся сюда».~
@44518 = ~«Ясно. Прощай».~
@44519 = ~У этого мужчины грубая кожа бледно-жёлтого оттенка и худощавое, угловатое лицо. Нос у него маленький и высоко посаженный, а уши заострены на концах. Тело покрывают следы татуировок и шрамов. На нём одеты странные, броские кожаные доспехи, скорее всего, больше пригодные для украшения, чем для боя. Похожие на два маленьких чёрных камня глаза внимательно следят за твоим приближением. Когда ты открываешь для разговора рот, он поднимает руку: «Я не буду тебя слушать, человек. Не говори с тем, кто из Народа».~
@44520 = ~«Ты о чём?»~
@44521 = ~«У меня вопросы…»~
@44522 = ~«Ваш „Народ“ — собаки, которые никогда не должны были сорваться с поводка своих *иллитидских* хозяев».~
@44523 = ~«Я просто хотел задать вопрос одному из почтенных гитиянки».~
@44524 = ~«Ну и ладно».~
@44525 = ~«Я сказал тебе не говорить со мной больше. Или до всех людей доходит так же медленно, как до тебя?»~
@44526 = ~«Я просто хочу получить ответы на кое-какие вопросы…»~
@44527 = ~«Ваш „Народ“ — собаки, которые никогда не должны были сорваться с поводка своих *иллитидских* хозяев».~
@44528 = ~«Я просто хотел задать вопрос одному из почтенных гитиянки».~
@44529 = ~«Тогда забудь».~
@44530 = ~Он смотрит на тебя равнодушно. Его губы сжимаются в тонкую линию.~
@44531 = ~«Ваш „Народ“ — собаки, которые никогда не должны были сорваться с поводка своих *иллитидских* хозяев».~
@44532 = ~«Тогда прощай».~
@44533 = ~Он замолкает на минуту и смотрит тебе прямо в глаза. «Я склонюсь перед твоей почтительностью, хотя мои знания могут оказаться для тебя водой».~
@44534 = ~«Не расскажешь мне о себе?»~
@44535 = ~«Не расскажешь мне о своём народе?»~
@44536 = ~«Не расскажешь мне о гитцерай?»~
@44537 = ~«Ну и ладно. Прощай».~
@44538 = ~«Я Йи'минн, рыболов. Я ловлю воспоминания мёртвых на Астральном плане».~
@44539 = ~«А можешь найти мои воспоминания?»~
@44540 = ~«Что ты можешь рассказать об Астральном плане?»~
@44541 = ~«Если ты почитаешь наш народ, как ты можешь ничего о нём не знать?»~
@44542 = ~«Я хочу узнать больше».~
@44543 = ~«Я просто хотел поговорить с тобой».~
@44544 = ~«Они наше отродье. Им остаётся только просить пощады. Их кровь жидкая, как вода, то же самое можно сказать про их ум, — он скалит зубы. — Это моя обязанность и удовольствие — совершать на них набеги и предавать изменников мучительной смерти».~
@44545 = ~«Мило. Можешь ответить на другие вопросы?»~
@44546 = ~«Тогда прощай».~
@44547 = ~«Ась?»~
@44548 = ~«Так кто ты?»~
@44549 = ~«Что это за место?»~
@44550 = ~«Мне сказали, что здесь можно найти ячейку Анархистов. Пароль — „затмение“».~
@44551 = ~«Забудь. Прощай».~
@44552 = ~«Не говори со мной. Говори с Лиеной», — он показывает толстой, как ствол дуба, рукой на женщину-прораба.~
@44553 = ~«Всего пару вопросов?»~
@44554 = ~«Хорошо. Прощай».~
@44555 = ~«НЕ ГОВОРИ СО МНОЙ!» — кажется, он немножко не в себе.~
@44556 = ~«Могу… за определённую плату».~
@44557 = ~«Ладно, ладно. Прощай».~
@44558 = ~«Какова твоя цена?»~
@44559 = ~«Я заплачу любую цену».~
@44560 = ~«Можем мы расплатиться иным способом?»~
@44561 = ~«Забудь. У меня другие вопросы».~
@44562 = ~«Забудь. Прощай».~
@44563 = ~«Это не-место, пространство между пространствами, где единственное, что имеет значение, — разум. Там живёт мой народ. Когда кто-либо умирает, его душа улетает на Внешние планы. Проходя через Астральный план, души лишаются воспоминаний, и те остаются плавать в Серебряном море».~
@44564 = ~«Ясно. Можешь ответить ещё на вопрос?»~
@44565 = ~«Спасибо. Прощай».~
@44566 = ~«Я уже ответил на твои вопросы. Не приходи ко мне больше».~
@44567 = ~«Тогда прощай».~
@44568 = ~«Больше я тебе ничего не скажу. Ты оказал мне почтение, и я отплатил той же монетой».~
@44569 = ~«Если так должно быть, прощай».~
@44570 = ~«Моя цена — две сотни монет, на меньшее я не согласен».~
@44571 = ~«Вот. Возьми деньги».~
@44572 = ~«Это слишком много. Может, ты ответишь на пару вопросов…»~
@44573 = ~«Забудь. Прощай».~
@44574 = ~Гитиянки кладёт деньги в карман. «Возвращайся через неделю, и у меня будут твои воспоминания. Не опоздай».~
@44575 = ~«Приветствую, почтенный гитиянки».~
@44576 = ~«Я бы хотел задать кое-какие вопросы…»~
@44577 = ~«Хорошо. Прощай».~
@44578 = ~«Прости. Кажется, я принял тебя за другого. Счастливо».~
@44579 = ~«Ты думал, что сможешь затуманить мои глаза своей примитивной ложью? Уходи. Я расплатился ответами за оказанное почтение и больше не желаю с тобой разговаривать».~
@44580 = ~«Хорошо. Прощай».~
@44581 = ~«Я не разговариваю с теми, кто не из Народа. Говори с Йи'минном, если хочешь общаться с нами», — он не отрывает от тебя глаз.~
@44582 = ~«У меня всего лишь пара вопросов…»~
@44583 = ~Надменное выражение лица гитиянки с прошлого паза стало ещё более мерзким. «Теперь, человек, сними свою маску и расскажи нам, что ты говорил и делал в стенах Сигила для этих собак гитцерай».~
@44584 = ~«Тогда прощай».~
@44585 = ~В мгновение ока меч оказывается у него в руках. «Поприветствовал меня так, как это делают собаки гитцерай, да? Проси прощения, или я сотру тебя в порошок».~
@44586 = ~«Разве мы не собирались искать мои воспоминания?»~
@44587 = ~«Просить прощения? У тебя? Не думаю».~
@44588 = ~«Я ничего не скажу».~
@44589 = ~«Мои извинения. Я думал, что ты гитцерай».~
@44590 = ~«Я просто помог избавиться от боли женщине-гитцерай».~
@44591 = ~«Я приношу свои извинения».~
@44592 = ~Он склоняет голову, но ни на дюйм не убирает руку от рукоятки меча.~
@44593 = ~«У меня к тебе кое-какие вопросы…»~
@44594 = ~«Всего лишь задал им несколько вопросов».~
@44595 = ~«Прощай».~
@44596 = ~«Я говорил неправду, чтобы сбить их с толку».~
@44597 = ~С шипением и резким вдохом он нападает!~
@44598 = ~«Единственный способ для тебя попасть на Астральный план — это в цепях, человек. У тебя есть только один шанс рассказать мне, что ты сделал для гитцерай в Сигиле».~
@44599 = ~Драться.~
@44600 = ~Бежать.~
@44601 = ~«Я ничего не скажу».~
@44602 = ~«Я не отвечаю на вопросы. Я рыцарь гитиянки. Мои слова — это мои действия. Говори с Йи'минном или не говори с гитиянки».~
@44603 = ~«Я просто помог избавиться от боли женщине-гитцерай».~
@44604 = ~«С Йи'минном? Хорошо. Где мне его найти?»~
@44605 = ~«Всего лишь задал им несколько вопросов».~
@44606 = ~«Я говорил неправду, чтобы сбить их с толку».~
@44607 = ~«Тогда ты умрёшь», — он вытахватывает своё оружие и атакует!~
@44608 = ~Драться.~
@44609 = ~~
@44610 = ~Позволить ему убить себя.~
@44611 = ~«Ты врёшь, как и собаки гитцерай, человек. Ты их прихвостень и предатель вместе с ними. Мы окажем тебе услугу, покончив с твоей жизнью», — он обнажает оружие.~
@44612 = ~Драться.~
@44613 = ~Позволить ему убить себя.~
@44614 = ~«Нет. Мы следили за тобой. Твои слова и стук твоего сердца выдают тебя. Приготовься к смерти».~
@44615 = ~Драться.~
@44616 = ~Позволить ему убить себя.~
@44617 = ~Клинок Йи'минна перерезает тебе горло, и ты падаешь на землю весь в крови. Гитиянки стоят над тобой и возобновляют разговор: «Он действительно ничего не знал, Ал-мидил?»~
@44618 = ~«Если ты считаешь, что наших знаний достаточно, тогда мы должны идти. Собирай воинов и давай присоединимся к нашему отряду в Лимбо».~
@44619 = ~У этого мужчины грубая кожа бледно-жёлтого оттенка и худощавое, угловатое лицо. Нос у него маленький и высоко посаженный, а уши заострены на концах. Тело покрывают следы татуировок и шрамов. На нём одеты странные, броские кожаные доспехи, скорее всего, больше пригодные для украшения, чем для боя. Похожие на два маленьких чёрных камня глаза внимательно следят за твоим приближением. Вы уже почти подходите к нему, но Дак'кон останавливается.~
@44620 = ~Гитиянки наблюдает за вашим приближением, но тебя он полностью игнорирует. «Дак'кон-причитающий-на-стенах-Шра'кт'лора… какой неожиданный сюрприз», — он обнажает оружие.~
@44621 = ~Когда вы отворачиваетесь, гитиянки, который всё время наблюдал за вами, окликает Дак'кона: «Ты повернулся ко мне спиной, Дак'кон-причитающий-на-стенах-Шра'кт'лора? Мы будем драться с тобой лицом к лицу, или у тебя на спине появится отметина трусости». Он обнажает своё оружие.~
@44622 = ~Гитиянки и Дак'кон немедленно начинают обмениваться ударами.~
@44623 = ~Помочь Дак'кону в бою.~
@44624 = ~Позволить им драться.~
@44625 = ~Когда Дак'кон кивает, гитиянки разражается грубым смехом: «Ты — раб этого человека, собака. Сначала предатель, затем раб».~
@44626 = ~«Тебе тоже стоит замолчать, или я вырву твой язык».~
@44627 = ~«Дак'кон, убей его».~
@44628 = ~Гитиянки кланяется и самодовольно улыбается Дак'кону: «Тогда нам нечего больше друг другу сказать. Я должен рассказать своему народу об твоём рабском положении. Им будет приятно узнать».~
@44629 = ~«Довольно разговоров. Я ищу свои воспоминания».~
@44630 = ~«Хватит. Дак'кон, убей его».~
@44631 = ~«Довольно. Прощай».~
@44632 = ~«Воспоминания? Я разыскиваю воспоминания, плавающие на Астральном плане. Буду рад тебе помочь… за определённую плату».~
@44633 = ~«Какова твоя цена?»~
@44634 = ~«Забудь. Мы уходим».~
@44635 = ~«Дак'кон, убей его».~
@44636 = ~«Моя цена — две сотни монет, на меньшее я не согласен».~
@44637 = ~«Вот. Возьми деньги».~
@44638 = ~«Боюсь, у меня столько нет. Нам пора идти».~
@44639 = ~«Забудь. Мы уходим».~
@44640 = ~«Вся мультивселенная — наше поле брани, собака. Никаких убежищ. Никакого мира. Сейчас ты умрёшь», — гитиянки атакует!~
@44641 = ~Напасть на гитиянки.~
@44642 = ~Позволить им сражаться.~
@44643 = ~«Уходите? Нет. Вы не уйдёте, пока я не получу сердце предателя Шра'кт'лора», — гитиянки атакует!~
@44644 = ~Напасть на гитиянки.~
@44645 = ~Позволить им сражаться.~
@44646 = ~«Тогда пошли со мной, оставь своего мальчика на побегушках здесь».~
@44647 = ~«И встретишься с предками, когда я закончу».~
@44648 = ~«Посмотрим, гитцерайская собака!» — гитиянки с яростью бросается на Дак'кона.~
@44649 = ~Напасть на гитиянки.~
@44650 = ~Позволить им сражаться.~
@44651 = ~«Я предостерегаю тебя от разговора с этим гитиянки».~
@44652 = ~«Что такое гитиянки?»~
@44653 = ~«Почему?»~
@44654 = ~«Гитиянки и гитцерай когда-то были одним народом. Мы были рабами *иллитидов*, пожирателей разума, которые забирали наши жизни, чтобы поддерживать свои. Одна из наших правительниц, королева-воительница Гит, привела нас к победе над *иллитидами*, и мы стали свободны. С тех пор мы ведём непрекращаемую войну с пожирателями разума. Однако были разногласия по поводу будущего нашего Народа. На Сожжённых Полях наш лидер, Зертимон, произнёс Пророчество Двух Небес, и была обнажена сталь. Одна раса распалась на две. Этот раскол нельзя преодолеть мирным путём».~
@44655 = ~«Мы всё равно поговорим с ним».~
@44656 = ~«Мы всё равно поговорим с ним».~
@44657 = ~«Тогда оставим эту затею. Пошли».~
@44658 = ~«*Знай*, что они заклятые враги Народа. Если мы обменяемся хоть словом, нам придётся обнажить клинки».~
@44659 = ~«Мы всё равно поговорим с ним».~
@44660 = ~«Тогда оставим эту затею. Пошли».~
@44661 = ~Дак'кон кивает.~
@44662 = ~Дак'кон кивает.~
@44663 = ~Дак'кон тоже обнажает клинок: «Йи'минн. Твоя кровь должна окропить камни улицы».~
@44664 = ~Встать между ними: «Стоять!»~
@44665 = ~Встать между ними: «Стоять!»~
@44666 = ~Напасть на гитиянки.~
@44667 = ~Напасть на гитиянки.~
@44668 = ~Позволить им сражаться.~
@44669 = ~Позволить им сражаться.~
@44670 = ~Дак'кон отвечает тебе, ни на секунду не отрывая глаз от своего противника: «Отступи и не вставай больше между нашими клинками».~
@44671 = ~«Не приказывай мне, Дак'кон, или я прикажу тебе убить себя».~
@44672 = ~«Оставь его, Дак'кон».~
@44673 = ~«Тогда действуй».~
@44674 = ~Дак'кон говорит гитиянки: «Йи'минн, это не место для сражения».~
@44675 = ~«Я *знаю* предательство гитиянки. В таком деле я буду его тенью».~
@44676 = ~«Тень нельзя убить, пока не убьют того, кто её отбрасывает. Так что я иду без страха».~
@44677 = ~Морте вращает глазами: «Дураков набежало…»~
@44678 = ~«О, ты гитиянки? Мне показалось, я почувствовал от тебя вонь иллитида. Или, возможно, это твоя слабая кровь».~
@44679 = ~«Прощай».~
@44680 = ~«Не испытывай моё терпение. Уходи. Сейчас».~
@44681 = ~«Я только хотел спросить…»~
@44682 = ~«Тогда прощай».~
@44683 = ~Он равнодушно смотрит на тебя: «Ищи его сам. Уходи. Перестань испытывать моё терпение».~
@44684 = ~«Тогда прощай».~
@44685 = ~У этого мужчины бледная жёлтая кожа и заострённые к кончикам уши. Его глаза похожи на чёрные камни, на нём одета гибкая кольчуга, искусно покрытая эмалью. Когда его глаза останавливаются на Дак'коне, в руках вмиг появляется клинок: «Гитцерай, собака! Подойди и отведай моего серебра!»~
@44686 = ~«Ты намерен встать между нами, человек? Тогда ты тоже умрёшь», — гитиянки бросается на тебя.~
@44687 = ~Драться.~
@44688 = ~Бежать.~
@44689 = ~Два гита набрасываются друг на друга.~
@44690 = ~Напасть на гитиянки.~
@44691 = ~Позволить им сражаться.~
@44692 = ~В руках Дак'кона тоже возникает клинок: «Сегодня ты встретишься со своими предками, гитиянки».~
@44693 = ~«Прекратите это!»~
@44694 = ~Позволить им сражаться.~
@44695 = ~«Его слова были словами врага Народа. Даже если это не так, мы выжгли его невежество мечом смерти. Давай оставим его здесь, пусть тело подбирают Сборщики. Мы собрали достаточно информации о собаках гитцерай для нашего похода. Не пройдёт и недели, как они потеряют ещё одну крепость. Стены Вристигора падут».~
@44696 = ~Ты видишь куб с двумя руками, двумя ногами и двумя маленькими крылышками по бокам. Спереди у куба живое лицо. Когда ты подходишь ближе, создание фокусирует на тебе свой взгляд.~
@44697 = ~«Приветствую».~
@44698 = ~Не обращать на него внимания.~
@44699 = ~Создание смотрит на тебя ничего не выражающими глазами: «Приветствую, искатель приключений. Добро пожаловать в Рубикон, конструкцию подземелья. Спасибо за выбор Рубикона для посещения подземелий. В Рубикон можно войти через эту дверь».~
@44700 = ~«Что такое Рубикон?»~
@44701 = ~«Что такое конструкция подземелья?»~
@44702 = ~«Неважно, мне нужно идти. Прощай».~
@44703 = ~Создание глазеет на тебя, не отвечая ни слова.~
@44704 = ~«Что такое конструкция подземелья?»~
@44705 = ~«Неважно, мне нужно идти. Прощай».~
@44706 = ~Создание моргает, но не подаёт никаких признаков того, что слышало твой вопрос.~
@44707 = ~«Что такое Рубикон?»~
@44708 = ~«Что такое Рубикон?»~
@44709 = ~«Неважно, мне нужно идти. Прощай».~
@44710 = ~Не обращать на него внимания.~
@44711 = ~«Приветствую», — произносит создание монотонным бесполым голосом.~
@44712 = ~«У меня вопрос…»~
@44713 = ~«Неважно, мне нужно идти. Прощай».~
@44714 = ~Создание продолжает безучастно смотреть на тебя: «Изложи свой вопрос».~
@44715 = ~«Кто ты?»~
@44716 = ~«Что ты такое?»~
@44717 = ~«Что это за место?»~
@44718 = ~«Что ты здесь делаешь?»~
@44719 = ~«Неважно, мне нужно идти. Прощай».~
@44720 = ~«Мы — модрон».~
@44721 = ~«Тебя зовут Модрон?»~
@44722 = ~«У меня другой вопрос…»~
@44723 = ~«Мне нужно идти. Прощай».~
@44724 = ~«Мы модрон. У нас нет имён. Мы модрон. Все, кого ты здесь видишь, — модрон. Мы одно целое».~
@44725 = ~«Хорошо. Вы все модроны, но как зовут *этого* модрона? Того, с кем я разговариваю».~
@44726 = ~«У меня другой вопрос…»~
@44727 = ~«Мне нужно идти. Прощай».~
@44728 = ~От модрона исходят спорадические щёлкающие звуки. На его лице появляется болезненное выражение. «Мы… я… — он отворачивается от тебя и щёлкающие звуки прекращаются. — Мы — модрон. У нас нет другой индивидуальности, кроме как модрон. У нас нет имён».~
@44729 = ~«Как же тогда отличить одного модрона от другого?»~
@44730 = ~«У меня другой вопрос…»~
@44731 = ~«Мне нужно идти. Прощай».~
@44732 = ~На минуту воцаряется молчание, пока модрон обдумывает твой вопрос. «Мы знаем. Мы модрон. Мы — часть целого. Как ты отличаешь ладонь, являющуюся частью руки, так и мы отличаем каждую часть целого».~
@44733 = ~«Ясно. У меня вопрос…»~
@44734 = ~«У меня другой вопрос…»~
@44735 = ~«Мне нужно идти. Прощай».~
@44736 = ~«Мы — модрон, мы — квадрон».~
@44737 = ~«Что такое модрон?»~
@44738 = ~«Что такое квадрон?»~
@44739 = ~«У меня другой вопрос…»~
@44740 = ~«Мне нужно идти. Прощай».~
@44741 = ~«Мы — модрон. Так идентифицируется наша раса».~
@44742 = ~«Тогда что такое квадрон?»~
@44743 = ~«У меня другой вопрос…»~
@44744 = ~«Мне нужно идти. Прощай».~
@44745 = ~«Внутри нашей расы мы именуемся как тип квадрон».~
@44746 = ~«Тогда что такое модрон?»~
@44747 = ~«У меня другой вопрос…»~
@44748 = ~«Мне нужно идти. Прощай».~
@44749 = ~«Рубикон, конструкция подземелья».~
@44750 = ~«Что это на самом деле такое?»~
@44751 = ~«У меня другой вопрос…»~
@44752 = ~«Мне нужно идти. Прощай».~
@44753 = ~Модрон хмурится и оглядывает комнату: «Мы должны знать… мы модрон. Мы — часть целого… мы… Информация недоступна. Адресуй свой вопрос к инженеру».~
@44754 = ~«Где мне найти инженера?»~
@44755 = ~«У меня другой вопрос…»~
@44756 = ~«Мне нужно идти. Прощай».~
@44757 = ~Модрон оглядывается: «Мы не знаем. Информация недоступна… Мы смущены…»~
@44758 = ~«У меня другой вопрос…»~
@44759 = ~«Мне нужно идти. Прощай».~
@44760 = ~«Ждём инструкций».~
@44761 = ~«Инструкций для чего?»~
@44762 = ~«У меня другой вопрос…»~
@44763 = ~«Мне нужно идти. Прощай».~
@44764 = ~Модрон смотрит на тебя пустым взглядом: «Инструкций по поводу того, какие задания следует выполнять».~
@44765 = ~«Задания? Чем вы вообще здесь занимаетесь?»~
@44766 = ~«У меня другой вопрос…»~
@44767 = ~«Мне нужно идти. Прощай».~
@44768 = ~Ты видишь куб с двумя руками, двумя ногами и двумя маленькими крылышками по бокам. Спереди у куба живое лицо. Когда ты подходишь ближе, создание фокусирует на тебе свой взгляд.~
@44769 = ~«Приветствую».~
@44770 = ~Не обращать на него внимания.~
@44771 = ~«Приветствую», — произносит создание монотонным бесполым голосом.~
@44772 = ~«У меня вопрос…»~
@44773 = ~«Неважно, мне нужно идти. Прощай».~
@44774 = ~Создание продолжает безучастно смотреть на тебя: «Изложи свой вопрос».~
@44775 = ~«Кто ты?»~
@44776 = ~«Что ты такое?»~
@44777 = ~«Что это за место?»~
@44778 = ~«Что это за место?»~
@44779 = ~«Что ты здесь делаешь?»~
@44780 = ~«Неважно, мне нужно идти. Прощай».~
@44781 = ~Создание долго смотрит на тебя, прежде чем ответить: «Неопределённо… существует путаница…»~
@44782 = ~«Что ты имеешь в виду? Разве ты не знаешь, кто ты такой?»~
@44783 = ~«У меня другой вопрос…»~
@44784 = ~«Мне нужно идти. Прощай».~
@44785 = ~«Нет… существует неопределённость… время от времени».~
@44786 = ~«Я тоже не помню, кто я такой».~
@44787 = ~«У меня другой вопрос…»~
@44788 = ~«Мне нужно идти. Прощай».~
@44789 = ~«Я симпатизирую тебе…» — оно протягивает руку и слегка дотрагивается до твоего плеча. Через пару секунд оно убирает руку.~
@44790 = ~«У меня другой вопрос…»~
@44791 = ~«Мне нужно идти. Прощай».~
@44792 = ~«Наша раса известна как модрон. Мы с плана порядка, Механуса».~
@44793 = ~«Что ты можешь рассказать о Механусе?»~
@44794 = ~«У меня другой вопрос…»~
@44795 = ~«Мне нужно идти. Прощай».~
@44796 = ~«Место законов… огромного количества законов. Очень структурированное…» — его голос постепенно затихает.~
@44797 = ~«У меня ещё вопрос…»~
@44798 = ~«Мне нужно идти. Прощай».~
@44799 = ~Оно оглядывается вокруг. «Симулятор подземелья. Однако в нерабочем состоянии. Сломан», — оно вздыхает.~
@44800 = ~«Что случилось?»~
@44801 = ~«Что такое симулятор подземелья?»~
@44802 = ~«У меня другой вопрос…»~
@44803 = ~«Мне нужно идти. Прощай».~
@44804 = ~«Точно не известно. Просто перестал работать».~
@44805 = ~«Что такое симулятор подземелья?»~
@44806 = ~«У меня другой вопрос…»~
@44807 = ~«Мне нужно идти. Прощай».~
@44808 = ~Модрон сердито смотрит на тебя, затем вздыхает: «Он симулирует подземелья. А что, по твоему мнению, должен делать симулятор подземелья?»~
@44809 = ~«Как он сломался?»~
@44810 = ~«У меня другой вопрос…»~
@44811 = ~«Мне нужно идти. Прощай».~
@44812 = ~Оно хмурится: «Ты должен знать, ты починил его».~
@44813 = ~«У меня другой вопрос…»~
@44814 = ~«Мне нужно идти. Прощай».~
@44815 = ~Оно прерывается. «Созерцаю… думаю… отвечаю на твои вопросы…» — оно хмурится.~
@44816 = ~«О чём ты думаешь?»~
@44817 = ~«У меня ещё вопрос…»~
@44818 = ~«Мне нужно идти. Прощай».~
@44819 = ~«В жизни много тайн…» — оно замолкает.~
@44820 = ~«У меня ещё вопрос…»~
@44821 = ~«Мне нужно идти. Прощай».~
@44822 = ~Ты видишь куб с двумя руками, двумя ногами и двумя маленькими крылышками по бокам. Спереди у куба живое лицо. Когда ты подходишь ближе, создание фокусирует на тебе свой взгляд.~
@44823 = ~«Приветствую».~
@44824 = ~Не обращать на него внимания.~
@44825 = ~Создание смотрит на тебя ничего не значащим взглядом.~
@44826 = ~«У меня вопросы…»~
@44827 = ~«Забудь, мне нужно идти. Прощай».~
@44828 = ~Оно продолжает глазеть на тебя, не отводя взгляда.~
@44829 = ~«Можешь ответить на пару вопросов?»~
@44830 = ~«Забудь, мне нужно идти. Прощай».~
@44831 = ~Бесстрастные глаза моргают и продолжают таращиться на тебя.~
@44832 = ~«Забудь, мне нужно идти. Прощай».~
@44833 = ~«Приветствую».~
@44834 = ~Не обращать на него внимания.~
@44835 = ~Он вздыхает. «Не хочу показаться грубым, но я на дежурстве и мне некогда отвечать на твои вопросы, — он прерывается. — Если тебе нужна информация, поговори с Эббом Скрипучие Колени».~
@44836 = ~«Кто такой Эбб Скрипучие Колени?»~
@44837 = ~«Где мне его найти?»~
@44838 = ~«У меня кое-какие вопросы…»~
@44839 = ~«Неважно. Прощай».~
@44840 = ~«Неважно. Прощай».~
@44841 = ~«Он мой старый друг. Кажется, сейчас он считает себя проводником, так что порасскажет тебе о чём угодно».~
@44842 = ~«Где мне его найти?»~
@44843 = ~«Неважно. Прощай».~
@44844 = ~Он на минуту задумывается. «Недавно я слышал, что он обосновался в баре „Горящий труп“. Ты найдёшь этот бар в Улье».~
@44845 = ~«Спасибо, прощай».~
@44846 = ~Ты видишь Третью Ступень Вортена, офицера Гармониума. Он слегка кивает тебе: «Ещё раз привет».~
@44847 = ~«У меня кое-какие вопросы…»~
@44848 = ~«Неважно, прощай».~
@44849 = ~Оставить её в покое.~
@44850 = ~«Ты чего-то *хочешь*… д-д-да? — она шепчет слово „да“ медленно, чувственно процеживая его между зубами. — Я могу помочь. Назови своё желание, и я осуществлю его».~
@44851 = ~«Я хочу *тебя*».~
@44852 = ~«Я хочу оружие власти».~
@44853 = ~«Мне нужны магические предметы».~
@44854 = ~«Мне нужны заклинания».~
@44855 = ~«Мне нужны знания. У меня кое-какие вопросы…»~
@44856 = ~«Я хочу вернуть свои воспоминания — все до единого».~
@44857 = ~«А у тебя найдётся хоть что-то, чего я хочу?»~
@44858 = ~«Может, как-нибудь в следующий раз. Счастливо».~
@44859 = ~Женщина не обращает внимания на Морте, её глаза направлены на тебя. Она улыбается, ожидая ответа.~
@44860 = ~«Я хочу *тебя*».~
@44861 = ~«Я хочу оружие власти».~
@44862 = ~«Мне нужны магические предметы».~
@44863 = ~«Мне нужны заклинания».~
@44864 = ~«Мне нужны знания. У меня кое-какие вопросы…»~
@44865 = ~«Я хочу вернуть свои воспоминания — все до единого».~
@44866 = ~«А у тебя найдётся хоть что-то, чего я хочу?»~
@44867 = ~«Может, как-нибудь в следующий раз. Счастливо».~
@44868 = ~Она облизывает губы и улыбается; ты чувствуешь покачивание своей грудной клетки, как будто кто-то запустил внутрь тебя руку и пытается вытащить внутренности. «Простой запрос. У меня тоже есть один для тебя: я прошу тебя сказать мне, объяснить, как именно ты меня хочешь. Позволь мне услышать твои мысли… *тогда* я назову тебе цену».~
@44869 = ~«Я оговорился… я не хочу тебя».~
@44870 = ~«Я хочу тебя. Разве этого недостаточно?»~
@44871 = ~Описать, как именно ты её хочешь.~
@44872 = ~Показать ей — физически — что ты её хочешь.~
@44873 = ~«Пожалуй, в другой раз. Прощай».~
@44874 = ~Её улыбка исчезает, она явно огорчена твоим ответом: «Уж не желаешь ли ты дразнить меня, путник? Желание — это не обычная эмоция… неужели ты *ничего* не хочешь?»~
@44875 = ~«Было ещё кое-что, чего я хотел…»~
@44876 = ~«Не сейчас. Прощай».~
@44877 = ~«Да? Ну же, давай… расскажи мне…»~
@44878 = ~«Я хочу *тебя*».~
@44879 = ~«Я хочу оружие власти».~
@44880 = ~«Мне нужны магические предметы».~
@44881 = ~«Мне нужны заклинания».~
@44882 = ~«Мне нужны знания. У меня кое-какие вопросы…»~
@44883 = ~«Я хочу вернуть свои воспоминания — все до единого».~
@44884 = ~«А у тебя найдётся хоть что-то, чего я хочу?»~
@44885 = ~«Может, как-нибудь в следующий раз. Счастливо».~
@44886 = ~Её улыбка ожесточается: «Ты должен выразить своё желание эмоциями и голосом, по-другому оно не будет иметь для меня никакого значения. Ты должен убедить меня, что действительно хочешь того, чем я могу поделиться. Иначе ты никогда не получишь этого».~
@44887 = ~Описать, как именно ты её хочешь.~
@44888 = ~Показать ей — физически — что ты её хочешь.~
@44889 = ~«Пожалуй, в другой раз. Прощай».~
@44890 = ~Ты пытаешься схватить её за плечи, но она ловко отступает назад и тебе удаётся поймать лишь воздух. «Недостаточно просто *хотеть* войти во дворец… просящий должен рассказать о своём желании, только тогда ворота откроются. Говори».~
@44891 = ~«Я хочу тебя. Разве этого недостаточно?»~
@44892 = ~Описать, как именно ты её хочешь.~
@44893 = ~«Пожалуй, в другой раз. Прощай».~
@44894 = ~Когда ты начинаешь говорить, её улыбка гаснет. Она наклоняется вперёд, внимательно слушая, её глаза буквально поглощают твои черты. Её присутствие заставляет тебя говорить больше обычного, через пару минут её ресницы трепетно закрываются и она делает короткий глубокий вдох. Неожиданно твоё желание начинает ослабевать… затем полностью исчезает, оставляя после себя лишь холодную пустоту. Она снова открывает глаза, улыбаясь; теперь она явно выглядит довольной.

«Что-то не так, путник? Ты больше не хочешь меня?..»~
@44895 = ~«Нет… нет, не хочу. Что ты со мной сделала?»~
@44896 = ~Она изображает недоумение: «Что ты имеешь в виду?» Несмотря на её невинный взгляд, ты уверен: случилось что-то неестественное. Она каким-то образом поглотила твоё желание — украла его для своей страшной коллекции желаний или же для трапезы, — и теперь оно исчезло… навсегда.

«Как же так? Может, ты хочешь чего-то ещё? Расскажи мне об этом…»~
@44897 = ~«Я… лучше нет. Прощай, Неудовлетворённое-Желание».~
@44898 = ~Она изучает твоё лицо: «Если ты действительно желаешь эти вещи, сначала удовлетвори моё требование: ты должен рассказать, как именно их хочешь. Расскажи мне о своём желании, и я назову цену».~
@44899 = ~«Я ошибся… мне не нужны такого рода вещи».~
@44900 = ~«Я их хочу… разве этого недостаточно?»~
@44901 = ~Описать своё желание.~
@44902 = ~«Пожалуй, в другой раз. Прощай».~
@44903 = ~Её улыбка гаснет. «Уж не желаешь ли ты дразнить меня, путник? Желание — это не обычная эмоция… неужели ты *ничего* не хочешь?» — она ждёт, снова изучая тебя.~
@44904 = ~«Было ещё кое-что, чего я хотел…»~
@44905 = ~«Не сейчас. Прощай».~
@44906 = ~Её улыбка ожесточается: «Ты должен выразить своё желание эмоциями и голосом, иначе оно ничего не будет для меня значить. Ты должен убедить меня, что действительно хочешь того, чем я могу поделиться, или твои желания не сбудутся».~
@44907 = ~«Я ошибся… мне не нужны такого рода вещи».~
@44908 = ~Описать своё желание.~
@44909 = ~«Пожалуй, в другой раз. Прощай».~
@44910 = ~Когда ты начинаешь говорить, её улыбка гаснет. Она наклоняется вперёд, внимательно слушая, её глаза буквально поглощают твои черты. Её присутствие заставляет тебя говорить больше обычного, через пару минут её ресницы трепетно закрываются и она делает короткий глубокий вдох. Неожиданно твоё желание начинает убывать… твоё *хочу* медленно покидает тебя, оставляя после себя лишь холодную пустоту. Она снова открывает глаза, когда ты прекращаешь говорить.

«Что случилось, путник? Ты больше не хочешь эти вещи?..»~
@44911 = ~«Нет… я имею в виду, да… что ты со мной сделала?»~
@44912 = ~Она изображает недоумение: «Что ты имеешь в виду?» Несмотря на её невинный взгляд, ты уверен: случилось что-то неестественное. Она каким-то образом поглотила часть твоего желания — украла его для своей страшной коллекции желаний или же для трапезы. Если бы ты не закончил говорить о желании, ты наверняка потерял бы его навеки.

«Как же так? Может, ты хочешь чего-то ещё? Расскажи мне об этом…»~
@44913 = ~«Я… лучше нет. Прощай, Неудовлетворённое-Желание».~
@44914 = ~Она хмурится и отводит глаза: «Знание… это та область, с которой я не желаю иметь дела. Наверняка ты хочешь чего-то *ещё*, любое *другое* желание, о котором можешь мне рассказать…»~
@44915 = ~«Да, было кое-что ещё, чего я хотел…»~
@44916 = ~«Может, в другой раз. Прощай».~
@44917 = ~«Нет, не думаю, что хочу делиться этим с тобой. Прощай».~
@44918 = ~«У меня найдётся всё, что ты можешь пожелать. А то немногое, чего нет, — я могу достать. Говори, чего ты хочешь…»~
@44919 = ~«*Есть* кое-что, чего я хочу…»~
@44920 = ~«Пожалуй, в другой раз. Прощай».~
@44921 = ~Она улыбается. «Многое можно забыть за жизнь… и ещё больше можно забыть в отдельные её периоды. Я *могу* тебе помочь, — она внимательно изучает тебя. — Объясни мне, как именно ты хочешь вернуть свои воспоминания. Расскажи мне о своих желаниях, и я назову цену».~
@44922 = ~«Я оговорился… не хочу возвращать свои воспоминания».~
@44923 = ~«Как докажешь, что сможешь вернуть их?»~
@44924 = ~«Я хочу вернуть их… разве этого недостаточно?»~
@44925 = ~Описать, как ты хочешь вернуть свои воспоминания.~
@44926 = ~«Может, в другой раз. Прощай».~
@44927 = ~Она кажется совершенно неподвижной, но неожиданно её рука касается твоего лба, а палец пробегает по виску: «Только это…» Ты чувствуешь, как туман у тебя в голове рассеивается, но ненадолго, хватает лишь, чтобы мельком взглянуть на память… прежде чем ты успеваешь сконцентрироваться, туман возвращается. «Только это. Только скажи мне, *почему* ты хочешь этого, расскажи мне о своём желании, и я назову цену…»~
@44928 = ~«Я оговорился… не хочу возвращать свои воспоминания».~
@44929 = ~«Я хочу вернуть их… разве этого недостаточно?»~
@44930 = ~Описать, как ты хочешь вернуть свои воспоминания.~
@44931 = ~«Может, в другой раз. Прощай».~
@44932 = ~Её улыбка ожесточается: «Ты должен выразить своё желание эмоциями и голосом, иначе оно не будет иметь для меня никакого значения. Ты должен убедить меня, что действительно хочешь того, чем я могу поделиться, или никогда не получишь этого».~
@44933 = ~«Как докажешь, что сможешь вернуть их?»~
@44934 = ~Описать, как ты хочешь вернуть свои воспоминания.~
@44935 = ~«Может, в другой раз. Прощай».~
@44936 = ~Когда ты начинаешь говорить, её улыбка гаснет. Она наклоняется вперёд, внимательно слушая, её глаза буквально поглощают твои черты. Её присутствие заставляет тебя говорить больше обычного, через пару минут её ресницы трепетно закрываются и она делает короткий глубокий вдох. Неожиданно твоё желание начинает убывать… твоё *хочу* медленно покидает тебя, оставляя после себя лишь холодную пустоту. Она открывает глаза, когда ты прекращаешь говорить.

«Что случилось, путник? Ты больше не хочешь вернуть воспоминания?..»~
@44937 = ~«Нет… я имею в виду, да… что ты со мной сделала?»~
@44938 = ~Ты видишь Неудовлетворённое-Желание. Когда ты подходишь к ней, она поворачивается и улыбается.~
@44939 = ~«Приветствую…»~
@44940 = ~«Я просто проходил мимо. Прощай».~
@44941 = ~Ты видишь Неудовлетворённое-Желание, которая, похоже, коллекционирует или питается желаниями других, убирая те из сознания навечно. Увидев тебя, она улыбается.~
@44942 = ~«У меня кое-какие вопросы…»~
@44943 = ~«Я просто проходил мимо. Прощай».~
@44944 = ~«Обожа-а-аю Фестхолл».~
@44945 = ~Строй~
@44946 = ~Легендарный Злодей~
@44947 = ~Эпический Злодей~
@44948 = ~Просто Злодей~
@44949 = ~Злодейский Отпрыск~
@44950 = ~Рыцарь Наживы~
@44951 = ~Негодяй~
@44952 = ~Чужак~
@44953 = ~Здоровяк~
@44954 = ~Герой~
@44955 = ~Эпический Герой~
@44956 = ~Легендарный Герой~
@44957 = ~Следовать~
@44958 = ~T~
@44959 = ~Сбор~
@44960 = ~4 и 2~
@44961 = ~3 на 2~
@44962 = ~Защита~
@44963 = ~Ты проверил свою бессмертность не на том существе, и твой герой уничтожен.~
@44964 = ~Строй~
@44965 = ~V~
@44966 = ~Клин~
@44967 = ~S~
@44968 = ~Линия~
@44969 = ~Ничего~
@44970 = ~Купить/Продать~
@44971 = ~Опознание~
@44972 = ~Украсть~
@44973 = ~«Эти ящики действительно тяжёлые!»~
@44974 = ~«Не могу дождаться, когда свалю отсюда!»~
@44975 = ~«Ох, моя больная спина!»~
@44976 = ~*Уф-ф*~
@44977 = ~*Ворчит*~
@44978 = ~«Хорошая работа!»~
@44979 = ~«Продолжай в том же духе!»~
@44980 = ~«Вот так. Приложи к этому усилия!»~
@44981 = ~«Ты действительно хорошо освоился!»~
@44982 = ~«Ты отлично работаешь!»~
@44983 = ~«Впечатляет!»~
@44984 = ~«Приложи к этому усилия!»~
@44985 = ~«Хватит прохлаждаться!»~
@44986 = ~«Тебе платят не за безделье!»~
@44987 = ~«Я хочу увидеть немного движения!»~
@44988 = ~«ШЕВЕЛИСЬ! ШЕВЕЛИСЬ! ШЕВЕЛИСЬ!»~
@44989 = ~Левая рука #985~
@44990 = ~Топор~
@44991 = ~Шкатулка с орнаментом~
@44992 = ~Рубин Моридора~
@44993 = ~Под текстом этой скверно пахнущей записки нарисована странная диаграмма. Похоже, она указывает загнуть уголки записки, чтобы их концы сходились в центре. Каждый уголок отмечен серией странных знаков: один знак в правом верхнем углу, два знака в правом нижнем углу, три знака в левом нижнем углу и вообще нет знаков в левом верхнем.~
@44994 = ~Загнуть правый верхний уголок к центру.~
@44995 = ~Загнуть правый нижний уголок к центру.~
@44996 = ~Загнуть левый нижний уголок к центру.~
@44997 = ~Загнуть левый верхний уголок к центру.~
@44998 = ~Убрать записку.~
@44999 = ~Ты загибаешь уголок внутрь, чтобы его кончик коснулся центра.~
@45000 = ~Загнуть правый верхний уголок к центру.~
@45001 = ~Загнуть правый нижний уголок к центру.~
@45002 = ~Загнуть правый нижний уголок к центру.~
@45003 = ~Загнуть левый нижний уголок к центру.~
@45004 = ~Загнуть левый верхний уголок к центру.~
@45005 = ~Загнуть левый верхний уголок к центру.~
@45006 = ~Развернуть записку и начать сначала.~
@45007 = ~Марта качает головой: «Больше ничего, ничего больше, а, Марта? Может, попробовать в другом месте, Марта?»~
@45008 = ~Развернуть записку и оставить её в покое.~
@45009 = ~«Д-д-давай попробуем желудок…»~
@45010 = ~«К-к-как насчёт грудной клетки?..»~
@45011 = ~«Пу… п-п… посмотри в кишках… ещё… один… раз…»~
@45012 = ~«Сы… с… слушай, а ты можешь вскрыть мой череп?»~
@45013 = ~«Ны… н-н… н-нет, у меня есть ещё вопросы…»~
@45014 = ~«Не… н-нет пок-ка. Прощай».~
@45015 = ~Загнув левый верхний уголок к центру, ты замечаешь, что верхний правый разворачивается сам по себе, принимая своё обычное положение.~
@45016 = ~Снова загнуть правый верхний уголок к центру.~
@45017 = ~Загнуть левый нижний уголок к центру.~
@45018 = ~Развернуть записку и убрать её.~
@45019 = ~Ты загибаешь левый нижний уголок к центру, секунду он держится, а затем другие два уголка разгибаются. Ничего не происходит.~
@45020 = ~Осмотреть записку ещё раз.~
@45021 = ~Убрать записку.~
@45022 = ~Как только ты загибаешь правый верхний угол к центру, левый нижний угол зеркально повторяет то же самое, пока все уголки не сходятся в центре. Через мгновение ты наблюдаешь, как уголки приподнимаются вверх, превращая записку в маленькую четырёхгранную бумажную пирамиду.~
@45023 = ~Отогнуть грани пирамиды.~
@45024 = ~Ты отгибаешь грани пирамиды, и бумага превращается в пыль. Внутри ты находишь маленькую треугольную серёжку. Она отражает свет и ярко сверкает.~
@45025 = ~Взять треугольную серёжку…~
@45026 = ~Морте громко вздыхает: «Да лан, шеф! Мы что, действительно здесь остаёмся?»~
@45027 = ~«Просто немного помолчи, Морте. Я хочу послушать».~
@45028 = ~Не обращать внимания на Морте, продолжать слушать.~
@45029 = ~«Ты прав, Морте, пошли отсюда».~
@45030 = ~Слушать дальше.~
@45031 = ~Покинуть лекционный зал.~
@45032 = ~Он говорит очень низким угрюмым голосом: «Сегодня я расскажу о силе мировоззрения и верований и о том, как они влияют на планы.

Сначала я раскрою понятие мировоззрения».~
@45033 = ~Слушать дальше.~
@45034 = ~Прекратить слушать и уйти.~
@45035 = ~«Мировоззрение — это отражение верований личности и того, каким образом она ведёт себя в соответствии с ними. По своей природе все существа можно разделить на три группы: добрые сердцем, злые сердцем и безразличные — или нейтральные. Каждый из этих основных типов характера преимущественно выражается тремя разными способами: в упорядоченной манере, в хаотической манере или в безразличной, нейтральной манере. Таким образом, существует девять основных видов мировоззрения».~
@45036 = ~Слушать дальше.~
@45037 = ~Прекратить слушать и уйти.~
@45038 = ~«Итак, девять видов мировоззрения: законопослушно-добрый, нейтрально-добрый и хаотично-добрый… законопослушно-нейтральный, истинно-нейтральный и хаотично-нейтральный… законопослушно-злой, нейтрально-злой и хаотично-злой.

Теперь я расскажу о власти мировоззрения и вероисповеданий, которые они порождают… о том, как божества черпают из них силы и как верования могут физически повлиять на окружение личности».~
@45039 = ~Слушать дальше.~
@45040 = ~Прекратить слушать и уйти.~
@45041 = ~«Божество должно иметь последователей, потому что именно их вера даёт ему силу и власть. Если произошли изменения и больше народа склоняется в вере в бога, то это божество получает больше силы.

И наоборот, когда никто не верит в божество — оно умирает, присоединяясь к трупам других богов, которые плавают в Астральном плане. Таким образом, божество можно убить, просто забыв о нём».~
@45042 = ~Слушать дальше.~
@45043 = ~Прекратить слушать и уйти.~
@45044 = ~«Однако более яркий пример влияния мировоззрения и верований можно увидеть в городах-вратах. Хотя сперва я должен дать определение термину „город-врата“».~
@45045 = ~Слушать дальше.~
@45046 = ~Прекратить слушать и уйти.~
@45047 = ~«Города-врата — это города во Внешних Землях, большой нейтральной области, в центре которой вращается Сигил. Они называются „города-врата“, потому что построены вокруг вечных врат — или порталов — в один из Внешних планов».~
@45048 = ~Слушать дальше.~
@45049 = ~Прекратить слушать и уйти.~
@45050 = ~«Каждый из этих Внешних планов имеет своё мировоззрение. Бездна — хаотично-злая. Баатор — законопослушно-злой. Механус — законопослушно-нейтральный. Гора Селестия — законопослушно-добрая. Внешние Земли же — истинно-нейтральные, не склоняющиеся ни в сторону закона, ни в сторону хаоса.

„Сдвиг“ наступает, когда имеется высокая концентрация веры в различные силы. Когда это случается, вся территория сдвигается — или отклоняется — в сторону плана, который отвечает новой вере».~
@45051 = ~Слушать дальше.~
@45052 = ~Прекратить слушать и уйти.~
@45053 = ~«В настоящее время у городов-врат верование обычно соответствует Внешнему плану, находящемуся по ту сторону портала. Но эта вера недостаточно сильна для того, чтобы город соскользнул с Внешних Земель в один из Внешних планов.

Например, город Рибкейдж граничит с порталом в законопослушно-злой план Баатор. Как и ожидается, жители Рибкейджа в большинстве своём законопослушно-злые, но мировоззрение города и его вера в целом недостаточно сильны, чтобы Рибкейдж соскользнул в Баатор».~
@45054 = ~Слушать дальше.~
@45055 = ~Прекратить слушать и уйти.~
@45056 = ~«Теперь допустим, что в Рибкейдже однажды вдруг возрастёт количество законопослушно-злых священников, пропагандирующих свою тёмную веру и обращающих многих граждан в веру их законопослушно-злого бога. Если такое случится, то существует немалая вероятность того, что город соскользнёт с нейтральных Внешних Земель и станет частью законопослушно-злого плана Баатор.

Подобным образом могут сдвинуться целые слои планов. Поэтому многие войны за веру — это вынужденные войны. Они являются инструментом, с помощью которого захватываются и удерживаются территории».~
@45057 = ~Слушать дальше.~
@45058 = ~Прекратить слушать и уйти.~
@45059 = ~«В этом и проявляется влияние веры и мировоззрения на структуру планов. Эта лекция окончена.

Да определит вера ваши поступки и изменит планы по вашему желанию. До свидания всем».~
@45060 = ~Уйти.~
@45061 = ~Этот худой, с резкими чертами лица мужчина с жёлтой кожей, покрытой татуировками, оглядывает комнату и всех слушателей своими равнодушными чёрными глазами. Кажется, он читает лекцию.~
@45062 = ~~
@45063 = ~Остаться на лекции.~
@45064 = ~~
@45065 = ~~
@45066 = ~~
@45067 = ~~
@45068 = ~~
@45069 = ~Труп не реагирует. Похоже, он слишком «далеко», чтобы отвечать на любые твои вопросы.~
@45070 = ~«Так… зачем ты ходишь по этому треугольнику?»~
@45071 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@45072 = ~Использовать на трупе «Разговор с мёртвыми».~
@45073 = ~«Приятно было пообщаться. Прощай».~
@45074 = ~Оставить труп в покое.~
@45075 = ~Оставить труп в покое.~
@45076 = ~Твоё первое впечатление от Мара — что ему необходима хорошая ванна, желательно подальше от любого существа с чувством обоняния. Ты практически можешь видеть зловещие жёлтые завихрения, которыми вонь исходит от его тела. Он неистово машет тебе руками в попытках добиться, чтобы ты подошёл поближе и поговорил с ним.~
@45077 = ~Подойти к этой особе и узнать, что ему нужно.~
@45078 = ~Я ещё один персонаж Йазона.~
@45079 = ~Правда?~
@45080 = ~Я один из персонажей Йазон.~
@45081 = ~Ты уже говорил об этом.~
@45082 = ~Я один из персонажей Йазон.~
@45083 = ~Уйти.~
@45084 = ~Я один из персонажей Йазон.~
@45085 = ~«Мне сказали доставить тебе эту коробочку».~
@45086 = ~Я один из персонажей Йазон.~
@45087 = ~Ну, если ты так говоришь.~
@45088 = ~«Хе. Похоже, кто-то забыл сказать этому бедолаге перестать следовать Правилу Трёх».~
@45089 = ~«Что ты имеешь в виду?»~
@45090 = ~~
@45091 = ~«У этих трупов мало чего осталось в котелках, поэтому они не могут выполнять больше одного задания… если им сказали что-то сделать, они будут продолжать делать это до тех пор, пока кто-нибудь не прикажет им прекратить. Этот бедолага, скорее всего, закончил выполнять какое-то задание, а ему забыли об этом сообщить».~
@45092 = ~«Кто отдаёт им приказания?»~
@45093 = ~«Ты что-то говорил о „Правиле Трёх“. Что ты имел под этим в виду?»~
@45094 = ~«Хорошо. Давай, пошли дальше».~
@45095 = ~«А? Ну, Правило Трёх — это один из „законов“ планов. О тех вещах, которые случаются трижды… или состоят из трёх частей… или о том, что всегда существует три альтернативы, и так далее, и тому подобное».~
@45096 = ~«Мне показалось, ты не особенно в это веришь».~
@45097 = ~~
@45098 = ~«Это просто запудривание мозгов. Если выбрать число — любое число — и постараться придать ему какой-то великий смысл, сразу можно найти множество совпадений».~
@45099 = ~«Ясно. Ранее ты говорил, что кто-то приказал этому трупу выполнять задание, а затем забыл сказать, чтобы тот остановился. Кто отдаёт трупам приказания?»~
@45100 = ~«Понятно. Я бы хотел поближе рассмотреть этого зомби…»~
@45101 = ~«Хорошо. Давай, пошли дальше».~
@45102 = ~«Или один из здешних смотрителей, или кто-то из некромантов, поднявших их из книги мёртвых. Скорее всего, один из смотрителей… в конце концов, именно им нужна дешёвая рабочая сила».~
@45103 = ~«Ясно. О чём там ты говорил до этого… о „Правиле Трёх“?»~
@45104 = ~«Понятно. Я бы хотел поближе рассмотреть этого зомби…»~
@45105 = ~«Хорошо. Давай, пошли дальше».~
@45106 = ~Оставить труп в покое.~
@45107 = ~Оставить труп в покое.~
@45108 = ~Ты осторожно протягиваешь руку и берёшь рулон бинтов из рук трупа. Труп, кажется, даже не замечает этого; он продолжает ходить и бинтовать тела.~
@45109 = ~Внимательно осмотреть труп ещё раз.~
@45110 = ~Оставить труп в покое.~
@45111 = ~Этот труп волочит ноги от плиты к плите, пытаясь бинтовать лежащих на них мертвецов. Он продолжает выполнять свои обязанности, даже несмотря на отсутствие бинтов. На его левом виске вырезан номер «396», губы плотно сшиты.~
@45112 = ~«Извини, что забрал у тебя те бинты. Просто мне они нужнее, чем этим телам».~
@45113 = ~«Извини, что забрал у тебя те бинты. Просто мне они нужнее, чем этим телам».~
@45114 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@45115 = ~Использовать на трупе «Разговор с мёртвыми».~
@45116 = ~«Приятно было пообщаться. Прощай».~
@45117 = ~Оставить труп в покое.~
@45118 = ~Заклинания~
@45119 = ~Напитки~
@45120 = ~Комнаты~
@45121 = ~Пожертвовать~
@45122 = ~«Хм-м. Возможно, здесь найдётся что-нибудь, чем можно вскрыть эти швы…»~
@45123 = ~Оставить труп в покое.~
@45124 = ~Труп безучастно таращит на тебя молочно-белые глаза.~
@45125 = ~Оставить труп в покое.~
@45126 = ~Труп не реагирует. Похоже, он слишком «далеко», чтобы отвечать на любые твои вопросы.~
@45127 = ~Оставить труп в покое.~
@45128 = ~На лбу этого трупа чернилами написан номер «1201». Потёки чернил покрывают его глаза, щёки и подбородок, создавая впечатление, что он плачет. Его нижняя челюсть болтается, а из уголка рта сочатся остатки гноя.~
@45129 = ~«Извини, что разрезал эти швы… мне просто нужно было посмотреть, что у тебя во рту».~
@45130 = ~«Извини, что разрезал эти швы… мне просто нужно было посмотреть, что у тебя во рту».~
@45131 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@45132 = ~Использовать на трупе «Разговор с мёртвыми».~
@45133 = ~«Приятно было пообщаться. Прощай».~
@45134 = ~Оставить труп в покое.~
@45135 = ~«Что ты можешь мне рассказать о здешних посетителях?»~
@45136 = ~«Гильтспур, да? Дай-ка я посмотрю», — он берёт у тебя рекламный листок и просматривает. Затем хмурится и говорит: «Хорошо. Скажи ему, что я вывешу. Ещё что-нибудь нужно?»~
@45137 = ~«Всего пара вопросов…»~
@45138 = ~«Больше ничего, спасибо. Прощай».~
@45139 = ~Драться.~
@45140 = ~Бежать.~
@45141 = ~У этого мужчины жёлтого оттенка кожа и резкие черты лица. Его тело покрывают татуировки и шрамы, а на груди висит длинный клинок. Глаза похожи на два маленьких чёрных камушка. При твоём приближении он кланяется: «Приветствую, звучащий клинок. Я *знаю* о твоей своевременной информации. Проси чего хочешь».~
@45142 = ~«Кто ты?»~
@45143 = ~«Можешь присоединиться ко мне?»~
@45144 = ~«Откуда у тебя столько шрамов?»~
@45145 = ~«Откуда у тебя татуировки?»~
@45146 = ~«Чем отличаются гитцерай от гитиянки?»~
@45147 = ~«Чем отличаются гитцерай от гитиянки?»~
@45148 = ~«Можешь научить меня своему языку?»~
@45149 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45150 = ~«Не могу. Я обязан служить своему народу».~
@45151 = ~«В чём состоит твоя служба?»~
@45152 = ~«Тогда я хочу задать тебе кое-какие вопросы».~
@45153 = ~«Задавай свои вопросы. Но не так, как это делала Ач'али-Утопшая. Задавай их конкретно и по сути дела».~
@45154 = ~«Кто ты?»~
@45155 = ~«Можешь присоединиться ко мне?»~
@45156 = ~«Откуда у тебя столько шрамов?»~
@45157 = ~«Откуда у тебя татуировки?»~
@45158 = ~«Чем отличаются гитцерай от гитиянки?»~
@45159 = ~«Чем отличаются гитцерай от гитиянки?»~
@45160 = ~«Можешь научить меня своему языку?»~
@45161 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45162 = ~Он почтительным жестом подносит руки к лицу, затем к груди. «Шрамы, украшающие моё лицо, — результат схваток в Ильзеншайн. Моя рракма была почти полностью уничтожена подлыми *иллитидами*. Шрам в верхней части туловища я получил в результате неудачного удара клинка гитиянки-вора, — он жестом головы указывает на твои шрамы: — Расскажи о происхождении твоих шрамов».~
@45163 = ~«Я не помню, как заработал большую часть из них».~
@45164 = ~«Они — результат многих битв, так что это слишком длинная история».~
@45165 = ~«В них нет ничего особенного. У меня другие вопросы…»~
@45166 = ~«В них нет ничего особенного. У меня другие вопросы…»~
@45167 = ~«Они повествуют об истории моего рода и придают мне силу и ум. Одна, сделанная Арья'рок с острова Печати, говорит о моём родственнике, Жи'ли'кай, который похоронил своих врагов в стенах Шра'кт'лора. Другая, вот здесь, была оставлена Феллом, дабусом-который-ходит, и говорит о нашем сражении плечом к плечу с Ро'чжи, когда мы бились с семью слаади на планах Лимбо до того, как восьмой навеки заставил Ро'чжи замолчать, — он жестом показывает на твои татуировки: — Расскажи о своих татуировках».~
@45168 = ~«Они говорят о том, чего я хочу достичь».~
@45169 = ~«Они свидетельствуют о препятствиях, которые я преодолел, и о моём забытом прошлом».~
@45170 = ~«Это обычные татуировки. Расскажи мне о Фелле».~
@45171 = ~«Это обычные татуировки. Расскажи мне о Фелле».~
@45172 = ~«Это обычные татуировки. У меня другие вопросы…»~
@45173 = ~«Это обычные татуировки. У меня другие вопросы…»~
@45174 = ~Он щурит глаза и сплёвывает: «Они стая лживых, падких на чужое добро, предательских собак, которым нельзя доверять. Если встретишь кого-то из них, вспомни уроки, которые преподало нам сердце Селканта и глаз Вилкуара, — и помни, что гитиянки ещё хуже».~
@45175 = ~«Что это за уроки?»~
@45176 = ~«Спасибо. У меня другие вопросы…»~
@45177 = ~«Спасибо. Прощай».~
@45178 = ~Он склоняется в лёгком поклоне: «Если бы не долг перед моим народом, я бы с удовольствием. Но, как у гостя за столом Торига, моя тарелка полна. Я не могу. Может, тебе стоит попросить кого-нибудь другого…»~
@45179 = ~«Всё равно спасибо. У меня пара других вопросов…»~
@45180 = ~«Всё равно спасибо. Прощай».~
@45181 = ~«Селкант и Вилкуар были известны своей жестокостью и предательством — и принадлежали они к народу гитцерай. Их деяния бледнеют на фоне гитиянки, самых бессердечных паразитов, из когда-либо бороздивших Серебряное море».~
@45182 = ~«У меня ещё вопросы…»~
@45183 = ~«Спасибо. Прощай».~
@45184 = ~На минуту он замолкает, и у тебя возникает чувство, что он не одобряет твой ответ: «Ач'али-Утопшая. Тогда задавай свои вопросы».~
@45185 = ~«Можешь присоединиться ко мне?»~
@45186 = ~«Откуда у тебя столько шрамов?»~
@45187 = ~«Откуда у тебя татуировки?»~
@45188 = ~«Чем отличаются гитцерай от гитиянки?»~
@45189 = ~«Как ты сюда попал?»~
@45190 = ~«Ясно. Далеко же тебя занесло от дома. Удачи тебе, и прощай».~
@45191 = ~«Чем отличаются гитцерай от гитиянки?»~
@45192 = ~«Можешь научить меня своему языку?»~
@45193 = ~«Я понял. Ты из бестолочей».~
@45194 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45195 = ~«Звучит как неплохое приключение. У меня к тебе другие вопросы».~
@45196 = ~«Удачи во всём. Тебе она пригодится. Прощай».~
@45197 = ~Его глаза горят гневом, он кланяется тебе и произносит: «Твои слова не делают тебе чести. А слушать их не делает чести мне. Нет моей воли продолжать разговор с тобой». На минуту он закрывает глаза, затем смотрит мимо тебя.~
@45198 = ~«Я просто хотел задать пару вопросов…»~
@45199 = ~«Тогда прощай».~
@45200 = ~Ударить его.~
@45201 = ~Выражение его лица слегка меняется — сложно сказать, выражает ли оно замешательство или презрение: «Как так может быть, что шрамы не повествуют о своём происхождении?»~
@45202 = ~«Это просто шрамы. Они есть у всех».~
@45203 = ~«Это просто шрамы. Они есть у всех».~
@45204 = ~«Я не помню их происхождение, как и вообще своё прошлое».~
@45205 = ~На минуту он задумывается, переваривая твои слова, затем произносит: «Тогда Плач Т'ча. Я скорблю о потере твоей памяти и прошлого».~
@45206 = ~«Спасибо. У меня пара других вопросов…»~
@45207 = ~«Спасибо. Прощай».~
@45208 = ~На минуту он задумывается, потом закрывает глаза и вновь кланяется: «Твои татуировки несут будущее в настоящее и помещают в центр. В таких татуировках присутствует мудрость Анархов. Твои истории замечены».~
@45209 = ~«Спасибо. Ты говорил о Фелле?»~
@45210 = ~«Спасибо. У меня другие вопросы…»~
@45211 = ~«Спасибо. Прощай».~
@45212 = ~Он закрывает глаза и кланяется: «Твои истории замечены, звучащий клинок».~
@45213 = ~«Как и твои. У меня другие вопросы…»~
@45214 = ~«У меня другие вопросы…»~
@45215 = ~«Как и твои. Прощай».~
@45216 = ~«Спасибо. Прощай».~
@45217 = ~«Дабус-который-ходит — мастер своего ремесла. Некоторые татуировки рассказывают истории. Другие гласят о духе. Татуировки, которые наносит на кожу Фелл, придают силу телу и уму в зависимости от истории».~
@45218 = ~«Где мне найти Фелла?»~
@45219 = ~«Какого рода силу?»~
@45220 = ~«Спасибо. У меня другие вопросы…»~
@45221 = ~«Спасибо. Прощай».~
@45222 = ~«Ты найдёшь его в Улье, на севере юго-восточной части. Направления в этом городе указаны плохо — следовать им всё равно что слушать бред Анарха, который не *знает* себя».~
@45223 = ~«Какую силу дают эти татуировки?»~
@45224 = ~«У меня другие вопросы…»~
@45225 = ~«Спасибо. Прощай».~
@45226 = ~«Татуировка Ро'чжи, того, кто убил семь слаади, даёт силу моим конечностям, когда я сталкиваюсь с неравным противником. Придаваемая сила зависит от опыта: расскажи Феллу свои истории, и татуировки дадут тебе силы, когда истории нанесены на плоть».~
@45227 = ~«Где мне его найти?»~
@45228 = ~«Спасибо. У меня другие вопросы…»~
@45229 = ~«Спасибо. Прощай».~
@45230 = ~Он склоняет голову: «Я Хайлкии'н, солдат гитцерай. Я здесь, чтобы собрать припасы. Я обнаружил, что город похож на Камень Три'иг'ор — часто восхваляемый, но ничего ценного из себя не представляющий».~
@45231 = ~«Чем отличаются гитцерай от гитиянки?»~
@45232 = ~«Чем отличаются гитцерай от гитиянки?»~
@45233 = ~«Можешь научить меня своему языку?»~
@45234 = ~«У меня другие вопросы…»~
@45235 = ~«Спасибо. Прощай».~
@45236 = ~Он склоняет голову: «Твоя доблесть замечена, звучащий клинок».~
@45237 = ~«Как и твоя. У меня другие вопросы…»~
@45238 = ~«У меня другие вопросы…»~
@45239 = ~«Как и твоя. Прощай».~
@45240 = ~«Спасибо. Прощай».~
@45241 = ~Хайлкии'н кланяется тебе: «Приветствую тебя, звучащий клинок».~
@45242 = ~«Приветствую. У меня кое-какие вопросы…»~
@45243 = ~«Нет, не стоит… я уже ухожу…»~
@45244 = ~«Тогда иди помоги ему! Иди помоги ему!»~
@45245 = ~«У меня есть глаза, разве я слеп?»~
@45246 = ~«Брока, у нас покупатель!»~
@45247 = ~«Приветствую. Прощай».~
@45248 = ~У этого мужчины жёлтого оттенка кожа и резкие черты лица. Его тело покрывают татуировки и шрамы, а на груди висит длинный клинок. Глаза похожи на два маленьких чёрных камушка. Он кланяется тебе: «Приветствую тебя, звучащий клинок. Я *знаю* о твоей помощи моему народу. Проси чего пожелаешь».~
@45249 = ~«Кто ты?»~
@45250 = ~«Можешь присоединиться ко мне?»~
@45251 = ~«Откуда у тебя столько шрамов?»~
@45252 = ~«Откуда у тебя татуировки?»~
@45253 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45254 = ~У этого мужчины жёлтого оттенка кожа и резкие черты лица. Его тело покрывают татуировки и шрамы, а на груди висит длинный клинок. Глаза похожи на два маленьких чёрных камушка. Он кланяется тебе: «Приветствую тебя, звучащий клинок. Я *знаю* о твоей помощи моему народу. Проси чего пожелаешь».~
@45255 = ~«Кто ты?»~
@45256 = ~«Можешь присоединиться ко мне?»~
@45257 = ~«Откуда у тебя столько шрамов?»~
@45258 = ~«Откуда у тебя татуировки?»~
@45259 = ~«Чем отличаются гитцерай от гитиянки?»~
@45260 = ~«Чем отличаются гитцерай от гитиянки?»~
@45261 = ~«Можешь научить меня своему языку?»~
@45262 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45263 = ~Хайлкии'н кланяется тебе: «Приветствую тебя, звучащий клинок».~
@45264 = ~«Приветствую. У меня кое-какие вопросы…»~
@45265 = ~«Приветствую. Прощай».~
@45266 = ~Хайлкии'н кланяется тебе: «Приветствую тебя, звучащий клинок».~
@45267 = ~«Приветствую. У меня кое-какие вопросы…»~
@45268 = ~«Приветствую. Прощай».~
@45269 = ~У этого мужчины жёлтого оттенка кожа и резкие черты лица. Его тело покрывают татуировки и шрамы, а на груди висит длинный клинок. Глаза похожи на два маленьких чёрных камушка. Он следит за твоим приближением и ждёт, когда ты заговоришь первым: «Я не *знаю* тебя… но имею волю говорить с тобой».~
@45270 = ~«Кто ты?»~
@45271 = ~«Откуда у тебя столько шрамов?»~
@45272 = ~«Откуда у тебя татуировки?»~
@45273 = ~«Чем отличаются гитцерай от гитиянки?»~
@45274 = ~«Чем отличаются гитцерай от гитиянки?»~
@45275 = ~«Можешь научить меня своему языку?»~
@45276 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45277 = ~Хайлкии'н спокойно смотрит, как ты приближаешься, и лаконично произносит: «Приветствую, путник».~
@45278 = ~«Приветствую. У меня кое-какие вопросы…»~
@45279 = ~«Приветствую. Прощай».~
@45280 = ~У этого мужчины жёлтого оттенка кожа и резкие черты лица. Его тело покрывают татуировки и шрамы, а на груди висит длинный клинок. Глаза похожи на два маленьких чёрных камушка. Когда вы подходите, он кланяется Дак'кону: «Весьма признателен, *зерт*».~
@45281 = ~«Его слова *известны* мне, *зерт*. Его деяния — нет. Его тень говорит о том, кто видал сражения и побеждал всех своих противников. Неужели мои глаза не могут видеть ничего, кроме безмолвной оболочки?»~
@45282 = ~«Я выслушаю его, *зерт*, — он поворачивается к тебе и ждёт твоих вопросов. — Задавай свои вопросы. Обращай их ко мне так, будто вопрошаешь свой разум».~
@45283 = ~«Кто ты?»~
@45284 = ~«Откуда у тебя столько шрамов?»~
@45285 = ~«Откуда у тебя татуировки?»~
@45286 = ~«Можешь научить меня своему языку?»~
@45287 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45288 = ~«Спрашивай».~
@45289 = ~«Кто ты?»~
@45290 = ~«Откуда у тебя столько шрамов?»~
@45291 = ~«Откуда у тебя татуировки?»~
@45292 = ~«Можешь научить меня своему языку?»~
@45293 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45294 = ~Он склоняет голову: «Я Хайлкии'н, солдат гитцерай. Я здесь, чтобы собрать припасы. Я обнаружил, что город похож на Камень Три'иг'ор — часто восхваляемый, но ничего ценного из себя не представляющий. Воздух здесь плох для нашего народа, а местные обитатели не *знают* себя. Они как пустые оболочки».~
@45295 = ~«Ясно. У меня другие вопросы…»~
@45296 = ~«Точно. Прощай».~
@45297 = ~Он почтительным жестом подносит руки к лицу, затем к груди. «Шрамы, украшающие моё лицо, — результат схваток в Ильзеншайн. Моя рракма была почти полностью уничтожена подлыми *иллитидами*. Шрам в верхней части туловища я получил в результате неудачного удара клинка гитиянки-вора, — он жестом головы указывает на твои шрамы: — Расскажи о происхождении твоих шрамов».~
@45298 = ~Выражение его лица слегка меняется — сложно сказать, выражает ли оно замешательство или презрение: «Как так может быть, что шрамы не повествуют о своём происхождении?»~
@45299 = ~«Это просто шрамы. Они есть у всех».~
@45300 = ~«Я не помню их происхождение, как и вообще своё прошлое».~
@45301 = ~Он бросает на Дак'кона нечитаемый взгляд; у тебя создаётся впечатление, что ты провалил некое испытание: «Хочешь *знать* что-то ещё?»~
@45302 = ~«Да».~
@45303 = ~Купить~
@45304 = ~Продать~
@45305 = ~Украсть~
@45306 = ~Снять~
@45307 = ~Пожертвовать~
@45308 = ~Крестьянин~
@45309 = ~«Нет. Прощай».~
@45310 = ~Торговец~
@45311 = ~На минуту он задумывается, переваривая твои слова, затем произносит: «Тогда Плач Т'ча. Я скорблю о потере твоей памяти и прошлого».~
@45312 = ~«Спасибо. Ответь мне на пару вопросов…»~
@45313 = ~Знатный человек~
@45314 = ~«Спасибо. Прощай».~
@45315 = ~Он склоняет голову: «Преклоняюсь перед твоей доблестью, звучащий клинок».~
@45316 = ~Королевская особа~
@45317 = ~«У меня другие вопросы…»~
@45318 = ~«Спасибо. Прощай».~
@45319 = ~«Они повествуют об истории моего рода и придают мне силу и ум. Одна, сделанная Арья'рок с острова Печати, говорит о моём родственнике, Жи'ли'кай, который похоронил своих врагов в стенах Шра'кт'лора. Другая, вот здесь, была оставлена Феллом, дабусом-который-ходит, и говорит о нашем сражении плечом к плечу с Ро'чжи, когда мы бились с семью слаади на планах Лимбо до того, как восьмой навеки заставил Ро'чжи замолчать, — он жестом показывает на твои татуировки: — Расскажи о своих татуировках».~
@45320 = ~«Они говорят о том, чего я хочу достичь».~
@45321 = ~«Они свидетельствуют о препятствиях, которые я преодолел, и о моём забытом прошлом».~
@45322 = ~«Это обычные татуировки. У меня другие вопросы…»~
@45323 = ~На минуту он задумывается, потом закрывает глаза и вновь кланяется: «Твои татуировки несут будущее в настоящее и помещают в центр. В таких татуировках присутствует мудрость Анархов. Твои истории замечены».~
@45324 = ~«Спасибо. Ты говорил о Фелле?»~
@45325 = ~«Спасибо. У меня другие вопросы…»~
@45326 = ~«Спасибо. Прощай».~
@45327 = ~Он закрывает глаза и кланяется: «Твои истории замечены, звучащий клинок».~
@45328 = ~«Спасибо. Ты говорил о Фелле?»~
@45329 = ~«У меня другие вопросы…»~
@45330 = ~«Спасибо. Прощай».~
@45331 = ~«Дабус-который-ходит — мастер своего ремесла. Некоторые татуировки рассказывают истории. Другие гласят о духе. Татуировки, которые наносит на кожу Фелл, придают силу телу и уму в зависимости от истории».~
@45332 = ~«Где мне найти Фелла?»~
@45333 = ~«Какого рода силу?»~
@45334 = ~«Спасибо. У меня другие вопросы…»~
@45335 = ~«Спасибо. Прощай».~
@45336 = ~«Ты найдёшь его в Улье, на севере юго-восточной части. Направления в этом городе указаны плохо — следовать им всё равно что слушать бред Анарха, который не *знает* себя».~
@45337 = ~«Какую силу дают эти татуировки?»~
@45338 = ~«У меня другие вопросы…»~
@45339 = ~«Спасибо. Прощай».~
@45340 = ~«Татуировка Ро'чжи, того, кто убил семь слаади, даёт силу моим конечностям, когда я сталкиваюсь с неравным противником. Придаваемая сила зависит от опыта: расскажи Феллу свои истории, и татуировки дадут тебе силы, когда истории нанесены на плоть».~
@45341 = ~«Где мне его найти?»~
@45342 = ~«Спасибо. У меня другие вопросы…»~
@45343 = ~«Спасибо. Прощай».~
@45344 = ~Он отвешивает лёгкий поклон: «С тобой путешествует несравненный мастер языка. Попроси его, возможно, он научит тебя».~
@45345 = ~«В любом случае спасибо. У меня пара других вопросов…»~
@45346 = ~«В любом случае спасибо. Прощай».~
@45347 = ~«Его слова *известны* мне, *зерт*, как и своевременные действия, касающиеся нашей крепости. Я выслушаю его».~
@45348 = ~«Кто ты?»~
@45349 = ~«Откуда у тебя столько шрамов?»~
@45350 = ~«Откуда у тебя татуировки?»~
@45351 = ~«Можешь научить меня своему языку?»~
@45352 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45353 = ~Хайлкии'н кланяется при твоём приближении: «Ты делаешь мне честь своим возвращением».~
@45354 = ~«Спасибо. У меня кое-какие вопросы…»~
@45355 = ~«Спасибо, но мне нужно идти. Прощай».~
@45356 = ~«Ты возвращаешься, *зерт*, вместе со своим человеком. Хочешь *знать* больше?»~
@45357 = ~«Да».~
@45358 = ~«Нет. Прощай».~
@45359 = ~«Я здесь, чтобы собрать припасы и вызвать подкрепление. Гитиянки в эти дни что-то расхрабрились. Мы готовимся к кровавой войне».~
@45360 = ~«Как увлекательно. Я бы хотел задать ещё пару вопросов».~
@45361 = ~«Ясно. Прощай».~
@45362 = ~«Он входит в число верных, — Дак'кон кланяется — Моя воля — дать тебе *знать*, что этот человек путешествует со мной. Выслушаешь ли ты его?»~
@45363 = ~«У меня кое-какие вопросы…»~
@45364 = ~«У меня кое-какие вопросы…»~
@45365 = ~«Твой вопрос близок к истине. Моя воля — дать тебе *знать*, что мы делим один путь. Выслушаешь ли ты его?»~
@45366 = ~«Спросить о шрамах считается знаком уважения — это показывает почтение к твоему прошлому».~
@45367 = ~«Я не помню, как заработал большую часть из них».~
@45368 = ~«Они — результат многих битв, так что это слишком длинная история».~
@45369 = ~«В них нет ничего особенного. У меня другие вопросы…»~
@45370 = ~Стеклянная бусина~
@45371 = ~Ржавый кинжал~
@45372 = ~План гробницы~
@45373 = ~ПЛАН ГРОБНИЦЫ
Вес: 0

Это план построенной на заказ гробницы. По верхнему краю гордо написаны слова «Спроектировано для Вечности».~
@45374 = ~<ITEMNAME> — <ITEMCOST> меди~
@45375 = ~Каждый отдыхает в гостинице в течение 8 часов и восстанавливает пункты здоровья в количестве <HP>. Заклинания успешно запомнены.~
@45376 = ~Аола~
@45377 = ~Аола~
@45378 = ~Шиландра~
@45379 = ~Ты видишь фигуру высокого существа, стоящего перед тобой. Нижняя часть его тела похожа на туловище козла. Однако прямо над передними ногами его фигура принимает более человеческие очертания, с торсом, руками и головой мужчины, покрытыми сверкающими доспехами. Глаза существа закрыты, скорее всего, оно спит.~
@45380 = ~Существо коротко фыркает, но глаза остаются закрытыми. Очевидно, оно не страдает бессонницей.~
@45381 = ~Получеловек, полукозёл всё ещё спит.~
@45382 = ~«Приветствую».~
@45383 = ~Не мешать ему спать.~
@45384 = ~Не мешать ему спать.~
@45385 = ~Не мешать ему спать.~
@45386 = ~«А как смотришь, если я куплю их у тебя?»~
@45387 = ~«А как смотришь, если я куплю у тебя имя и номер?»~
@45388 = ~Она смотрит на тебя, как на сумасшедшего: «Ты что, совсем спятил? Конечно я не продам своё имя!»~
@45389 = ~«А как смотришь, если я куплю у тебя имя и номер?»~
@45390 = ~«Потому что это моё имя, пень! Имена не продаются!»~
@45391 = ~«Почему нет?»~
@45392 = ~«Просто отдай мне имя и номер, или мне придётся их из тебя вытрясти. Поверь, тебе это не понравится».~
@45393 = ~«Хорошо, я ему передам. Но сперва ответь мне на пару вопросов…»~
@45394 = ~«Хорошо, я ему передам».~
@45395 = ~«Имя нельзя купить ни за какие деньги. Никакая сумма не может купить номер. Монеты — плохая замена личности. Несомненно, ты это понимаешь».~
@45396 = ~«Она предложила за них деньги».~
@45397 = ~«Да, понимаю. Я сделаю всё, что в моих силах. Прощай».~
@45398 = ~Браскен~
@45399 = ~Задержать дыхание и уйти.~
@45400 = ~Ты заранее задерживаешь дыхание из-за вони, приближаясь к Мару. «Ты окажешь Мару услугу, а? Коробку мине надо доставить».~
@45401 = ~«Я доставлю твою посылку».~
@45402 = ~«Зачем тебе надо доставить эту посылку?»~
@45403 = ~«Прощай».~
@45404 = ~Когда Мар замечает твоё приближение, в его глазах появляется дикий блеск. Высоким визгливым голосом он спрашивает: «Чиво те опять тут надо?! Не возвращайся, пока не доставишь коробку».~
@45405 = ~«Личность, которой предназначалась посылка, от меня сбежала. Что теперь?»~
@45406 = ~«Я избавился от коробки».~
@45407 = ~«Я убил демона из коробки».~
@45408 = ~«Я убил демона из коробки».~
@45409 = ~«Я открыл коробку, а оттуда появился изверг. Я убежал».~
@45410 = ~«Никому не нужна эта коробка. Забери её обратно».~
@45411 = ~«Я покинул Улей, и ничего не произошло».~
@45412 = ~«Прощай».~
@45413 = ~«Сумасшедший придурок! Ты сам себе подписал смертный приговор, открыв эту проклятую коробку! Беги, если знашь куда!» — Мар срывается с места и убегает.~
@45414 = ~«Прощай».~
@45415 = ~Ку'атраа~
@45416 = ~Ку'атраа~
@45417 = ~Власк~
@45418 = ~Власк~
@45419 = ~Этот многократно перештопаный труп, вяло переваливаясь, ходит между двумя плитами. Номер «506» вышит у него на лбу… и на шее… и на правой руке… на самом деле, этот труп покрыт таким огромным количеством швов, что его кожа похожа на причудливую карту улиц.~
@45420 = ~Осмотреть швы.~
@45421 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@45422 = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@45423 = ~«Приятно было пообщаться. Прощай».~
@45424 = ~Оставить труп в покое.~
@45425 = ~Труп смотрит в одну точку, ни на что не обращая внимания.~
@45426 = ~Труп не реагирует. Похоже, он слишком «далеко», чтобы отвечать на любые твои вопросы.~
@45427 = ~Швы покрывают труп, начиная с его рук, идут через всю грудную клетку, вверх по шее, к спутанной копне белых волос. Проследив за пересечениями швов, ты замечаешь иголку, воткнутую в лоб трупа… к иголке привязана нитка, которой зашита одна сторона черепа. Ты мог бы вытащить иголку, если бы было чем разрезать нитку.~
@45428 = ~Ты аккуратно разрезаешь нитку скальпелем, извлекаешь иголку и распускаешь стежки. При этом покрывающая лоб кожа отслаивается, обнажив белый как мел череп трупа, на котором, к твоему удивлению, вырезан номер «78».~
@45429 = ~Этот многократно перештопаный труп, вяло переваливаясь, ходит между двумя плитами. Хотя номер «506» вышит практически на всех частях его тела, кожа на лбу слегка отошла, открывая взору номер «78», вырезанный на лобной кости.~
@45430 = ~Передвигаясь от коробки к коробке, этот человек кажется полностью погружённым в процесс их подсчёта и записи результатов на кусок пергамента. Он выглядит недовольным, когда ты его прерываешь: «Что ещё? Разве ты не видишь, что я очень занят — провожу инвентаризацию? Иди надоедай кому-нибудь другому».~
@45431 = ~«Не хотел тебе мешать. Прощай».~
@45432 = ~«Опять ты! По-моему, я уже сказал не надоедать мне».~
@45433 = ~«Мне сказали доставить тебе эту коробочку».~
@45434 = ~«Не хотел тебе мешать. Прощай».~
@45435 = ~«Ну, и почему же ты сразу не сказал? Давай посмотрим, что у тебя есть. Я уверен, на это нужно будет составить опись».~
@45436 = ~~
@45437 = ~«Мар сказал отдать это тебе».~
@45438 = ~Когда ты протягиваешь ему шкатулку, выражение заинтересованности на лице Ку'атраа сменяется беспросветным ужасом: «Нет! Пожалуйста… убери её от меня!»~
@45439 = ~«Я не понимаю… почему ты боишься этой коробки?»~
@45440 = ~«Я сказал… забери её! Смерть… зло… пришлось од-дурачить Мара… не выдержал больше. Пожалуйста… унеси её Браскену… живёт на юго-западе… Улья… не я… не-е-е-ет!» — очевидно, даже вид шкатулки для него невыносим, так как он с воплем убегает из здания.~
@45441 = ~«Погоди! Что мне теперь… с ней… делать…»~
@45442 = ~Громким гулким голосом Браскен спрашивает: «Что именем Бездны ты делаешь в моём доме?! Уходи немедленно, пока я не сделал тебя ещё более уродливым».~
@45443 = ~«Меня попросили доставить тебе эту коробку».~
@45444 = ~~
@45445 = ~«Прощай».~
@45446 = ~«Что?! Опять ты! Если у тебя нет ко мне никакого дела, то лучше немедленно покинь мой дом».~
@45447 = ~«Меня попросили доставить тебе эту коробку».~
@45448 = ~«Прости, домом ошибся. Я уже ухожу».~
@45449 = ~«Вон отсюда, придурок! Я уже сказал о шкатулке Моридора всё, что знаю».~
@45450 = ~«Прощай».~
@45451 = ~«По Улью ходят слухи, что один крутой мужик убил демона, заключённого в шкатулке Моридора. Говорят, битва с демоном оставила множество ужасных шрамов на его теле. Этим мужиком, случаем, не ты был, а?»~
@45452 = ~«Конечно; кто ещё смог бы это сделать?»~
@45453 = ~Он разражается грохочущим смехом: «Твоё нахальство не уступает смелости! Мне это нравится. Ты станешь легендой, когда о твоих деяниях распространится молва. Позволь мне быть одним из первых, кто тебя поздравит. Заходи… давай выпьем вместе, чтобы ты рассказал мне о своей храбрости».~
@45454 = ~«С удовольствием разделю с тобой пару кружек».~
@45455 = ~«Может, в другой раз. У меня много дел. Прощай».~
@45456 = ~«Наш замечательный здоровяк вернулся. Не надумал выпить? Я хочу услышать о твоих героических деяниях».~
@45457 = ~«С удовольствием разделю с тобой пару кружек».~
@45458 = ~«Может, в другой раз. У меня много дел. Прощай».~
@45459 = ~После нескольких кружек, нескольких песен и шуток, Браскен начинает тебе необычайно нравиться. По правде говоря, в этот момент ты любишь весь мир. Вскоре Браскен падает на пол в пьяном оцепенении. Ты понимаешь, что пора уходить.~
@45460 = ~«Прощай».~
@45461 = ~«Ох, моя больная голова! Мне кажется, она никогда не пройдёт».~
@45462 = ~Оставить Браскена с его страданиями.~
@45463 = ~«Ну и почему ты мне сразу не сказал? Давай её сюда, и можешь быть свободен». Когда ты протягиваешь коробку Браскену, выражение его лица меняется от нетерпения к изумлению: «Не тут то было! Я не попадусь на эту удочку во второй раз. Забирай эту штуку и уходи».~
@45464 = ~«Я не понимаю, почему никто не хочет взять эту коробку? Сначала Ку'атраа, а теперь ты».~
@45465 = ~«Ты сказал, Ку'атраа? — Браскен разражается оглушающим хохотом. — Этот приятель и купил у меня шкатулку. Думал, верно, что покупает самую лучшую из моих вещей. Вообразил, что один только рубин стоит куда больше, чем он мне заплатил. Бедный парень так и не понял, во что ввязался, пока не стало слишком поздно».~
@45466 = ~«Да что такого ужасного в этой коробке?»~
@45467 = ~«Хочешь сказать, ты и вправду ничего не знаешь об оказавшейся у тебя шкатулке? Что ж, думаю, ничего страшного не случится, если я расскажу тебе. Во-первых, чтобы тебе в голову не приходили всякие дурацкие мысли, заключённое в шкатулке проклятие действует только на нынешнего её владельца, а владельцем шкатулки можно стать только по собственной воле».~
@45468 = ~«Получается, идея выкинуть шкатулку и ждать, пока кто-нибудь её подберёт, не прокатит… так что же в коробке?»~
@45469 = ~«Хороший вопрос. Эта шкатулка ходила по Улью с незапамятных времён. Много слухов ходит о ней. Как ты можешь себе представить, по прошествии времени правда о шкатулке искажалась от рассказчика к рассказчику».~
@45470 = ~«Продолжай».~
@45471 = ~«Я слышал много историй об этой шкатулке, все они говорят примерно об одном. Этой отвратительной вещи дали название „Шкатулка Моридора“, и считается, что владелец шкатулки умрёт, если он или кто-то другой её откроет. Что там внутри… а кто его знает? Одни говорят, что это древний дракон, в то время как другие — что это дьявольская душа самого Моридора. Нельзя сказать наверняка, но даже просто посмотрев на неё, можно понять, что это нечто злое, и надо быть дураком, чтобы открыть её».~
@45472 = ~«И что мне теперь с ней делать?»~
@45473 = ~«Я посоветую тебе сходить к Шиландре. Она живёт в северо-восточной части Улья. У неё я и „выиграл“ шкатулку. Кто знает, может, она в курсе, что с ней делать. Или поищи какого-нибудь безмозглого пня, который заберёт её у тебя. Тебе решать. Желаю удачи».~
@45474 = ~«Прощай».~
@45475 = ~«Новость разнеслась по всей округе! Поздравляю, ты разбил проклятие шкатулки Моридора. Должен признаться, я сомневался, что уродливый пень типа тебя сможет это сделать. Имей в виду, я всё равно думаю, что ты уродливей задницы баку… но преклоняюсь перед тем, что ты сделал. Заходи, выпей со мной и расскажи, как тебе это удалось».~
@45476 = ~«С удовольствием разделю с тобой пару кружек».~
@45477 = ~«Может, в другой раз. У меня много дел. Прощай».~
@45478 = ~Оставить труп в покое.~
@45479 = ~Оставить труп в покое.~
@45480 = ~Разрезать стежки скальпелем и достать нитку с иголкой.~
@45481 = ~«Хм. Может, здесь найдётся что-нибудь, чем можно перерезать нитку… я вернусь».~
@45482 = ~Внимательно осмотреть труп ещё раз.~
@45483 = ~Оставь труп в покое.~
@45484 = ~«Похоже, у тебя тут два разных номера, труп».~
@45485 = ~Изверг из шкатулки Моридора~
@45486 = ~Изверг из шкатулки Моридора~
@45487 = ~«Добро пожаловать в собор Аоскара. Ты пришёл преклониться перед Аоскаром вместе со мной? Можешь стать его вторым последователем».~
@45488 = ~«Я пришёл просить совета по поводу шкатулки и изверга в ней».~
@45489 = ~«А что, у Аоскара нет других последователей?»~
@45490 = ~«Расскажи мне об Аоскаре».~
@45491 = ~«Я хочу стать последователем Аоскара».~
@45492 = ~«Может, в другой раз. Прощай».~
@45493 = ~«Пропащая душа вернулась. Заходи, давай поблагодарим Аоскара и восславим твоё возвращение. Смею предположить, ты изменил своё решение по поводу вступления в паству».~
@45494 = ~«Я пришёл просить совета по поводу шкатулки и демона».~
@45495 = ~«Какую паству? Ты единственный, кого я здесь вижу».~
@45496 = ~«Похоже, у тебя тут два разных номера, труп».~
@45497 = ~«Расскажи мне об Аоскаре».~
@45498 = ~«Я хочу стать последователем Аоскара».~
@45499 = ~«Может, в другой раз. Прощай».~
@45500 = ~«Да ниспошлёт тебе Аоскар счастливых путешествий. Чем могу помочь?»~
@45501 = ~«Я хочу купить тот драгоценный камень, который ты взял из шкатулки Моридора».~
@45502 = ~«Похоже, у тебя тут два разных номера, труп».~
@45503 = ~«Расскажи мне об Аоскаре».~
@45504 = ~«А что, у Аоскара нет других последователей?»~
@45505 = ~~
@45506 = ~«Я хочу стать пследователем Аоскара».~
@45507 = ~«Что случилось? Минуту назад я стал последователем, а следующее, что помню — я застрял в каком-то „лабиринте“».~
@45508 = ~«Похоже, у тебя тут два разных номера, труп».~
@45509 = ~«Сейчас ничем. Прощай».~
@45510 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@45511 = ~«Ты вернулся! Прости моё удивление, впервые последователь вернулся ко мне. Большинство из них просто пропадают. Чем могу помочь?»~
@45512 = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@45513 = ~«Приятно было пообщаться. Прощай».~
@45514 = ~Оставить труп в покое.~
@45515 = ~Этот труп под номером «985» остановился как вкопанный; судя по состоянию его левой ноги похоже, что её изъела по самое колено какая-то могильная гниль или трупная плесень. Труп неустойчиво раскачивается взад-вперёд, пытаясь сохранять равновесие.~
@45516 = ~Толкнуть труп.~
@45517 = ~Толкнуть труп.~
@45518 = ~Попытаться помочь трупу удержать равновесие.~
@45519 = ~Попытаться помочь трупу удержать равновесие.~
@45520 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@45521 = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@45522 = ~«Приятно было пообщаться. Прощай».~
@45523 = ~Оставить труп в покое.~
@45524 = ~Труп отрешённо глазеет прямо вперёд. Он ничем не даёт понять, что услышал тебя.~
@45525 = ~Оставить труп в покое.~
@45526 = ~Труп не реагирует. Похоже, он слишком «далеко», чтобы отвечать на любые твои вопросы.~
@45527 = ~Оставить труп в покое.~
@45528 = ~Нога трупа с *хрустом* подкашивается, и он валится, словно срубленное дерево. Его туловище ударяется о каменный пол и разваливается на части, словно гнилая дыня, грязь и гной вытекают из образовавшейся полости. К твоему удивлению, никто как будто и не замечает падение трупа. И, что ещё более странно, нижняя часть левой ноги остаётся неподвижно стоять, как в почётном карауле. Через мгновение нога падает с сочным *шмяк*.~
@45529 = ~~
@45530 = ~Ты тянешься за левой рукой трупа, чтобы помочь ему устоять. Однако, когда ты хватаешь его руку, труп неожиданно ведёт вправо, и тебе приходится тянуть труп, вместо того чтоб поддерживать его…~
@45531 = ~Выглядит так, будто кто-то заменил левые руку и ногу трупа конечностями, оставшимися от других трупов. Левая нога его короче правой, но по крайней мере, труп теперь может стоять.~
@45532 = ~«Извини, что уронил тебя. Это получилось нечаянно».~
@45533 = ~«Извини, что уронил тебя. Это получилось нечаянно».~
@45534 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@45535 = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@45536 = ~«Приятно было пообщаться. Прощай».~
@45537 = ~Оставить труп в покое.~
@45538 = ~Ты тянешься за левой рукой трупа, чтобы помочь ему устоять. Однако, когда ты хватаешь его руку, труп неожиданно ведёт вправо, и тебе приходится тянуть труп, вместо того чтоб поддерживать его…~
@45539 = ~«Ой-ой…»~
@45540 = ~«Хм… шеф… может, ты не…»~
@45541 = ~Ты видишь громогласного мужчину с багровым лицом. Он буйствует и кричит так, будто вот-вот начнётся война, будто у него что-то в кишках застряло, будто… будто он слишком возбуждён, чтобы разговаривать нормальным тоном.~
@45542 = ~Ты видишь громогласного мужчину с багровым лицом. Он буйствует и кричит так, будто вот-вот начнётся война, будто у него что-то в кишках застряло, будто… будто он слишком возбуждён, чтобы разговаривать нормальным тоном.~
@45543 = ~Ты видишь громогласного мужчину с багровым лицом. Он буйствует и кричит так, будто вот-вот начнётся война, будто у него что-то в кишках застряло, будто… будто он слишком возбуждён, чтобы разговаривать нормальным тоном.~
@45544 = ~Ты видишь громогласного мужчину с багровым лицом. Он буйствует и кричит так, будто вот-вот начнётся война, будто у него что-то в кишках застряло, будто… будто он слишком возбуждён, чтобы разговаривать нормальным тоном. Быстрая манера говорить делает его речь сложной для понимания: «Вот ты, почтенный, да, ты! Кажется, тебе что-то нужно! Я ещё не знаю точно, что именно, но дай мне время, дай время, и я определю это не отходя от кассы! Тебе нужна комната? У меня есть комнаты! Тебе нужны продукты? У меня есть продукты!»~
@45545 = ~«Что ты продаёшь?»~
@45546 = ~«Сперва у меня к тебе кое-какие вопросы».~
@45547 = ~«Я хочу тебе кое-что продать».~
@45548 = ~«Спасибо за потраченное время, но… прощай».~
@45549 = ~Быстрая манера говорить делает его речь сложной для понимания: «Вот ты, почтенный, да, ты! Кажется, тебе что-то нужно! Я ещё не знаю точно, что именно, но дай мне время, дай время, и я определю это не отходя от кассы! Тебе нужна комната? У меня есть комнаты! Тебе нужны продукты? У меня есть продукты!»~
@45550 = ~«Что ты продаёшь?»~
@45551 = ~«Сперва у меня к тебе кое-какие вопросы».~
@45552 = ~«Я хочу тебе кое-что продать».~
@45553 = ~«Спасибо за потраченное время, но… прощай».~
@45554 = ~«Всё что угодно, приятель! Слова и время — это деньги, так что давай пошустрей!»~
@45555 = ~«Я ищу летающий череп. Его у меня украли. Не знаешь, где мне его найти?»~
@45556 = ~«Расскажи мне об этом Повелителе Костей…»~
@45557 = ~«Кто ты?»~
@45558 = ~«Что это за место? Что ты можешь рассказать об этом районе?»~
@45559 = ~«Что ты можешь рассказать о Боготах?»~
@45560 = ~«Не знаешь, есть тут какая-нибудь работа?»~
@45561 = ~«То объявление уже напечатано».~
@45562 = ~«Сообщение доставлено».~
@45563 = ~«Объявление вывешено в „Горящем трупе“».~
@45564 = ~«У тебя есть для меня ещё поручения?»~
@45565 = ~«Что ты продаёшь?»~
@45566 = ~«Я хочу тебе кое-что продать».~
@45567 = ~«Забудь. Прощай».~
@45568 = ~«В таком случае ты обратился к правильному человеку! Я покупаю, я продаю, я сдаю комнаты! Я могу достать для тебя всё что угодно! Что там у тебя?»~
@45569 = ~«У меня есть каменный лим-лим. Что ты можешь предложить взамен?»~
@45570 = ~«У меня есть каменный лим-лим. Что ты можешь предложить взамен?»~
@45571 = ~«Давай меняться».~
@45572 = ~«У тебя есть для меня ещё поручения?»~
@45573 = ~«То объявление уже напечатано».~
@45574 = ~«Сообщение доставлено».~
@45575 = ~«Объявление вывешено в „Горящем трупе“».~
@45576 = ~«У тебя есть для меня ещё поручения?»~
@45577 = ~«Похоже, пока ничего. Но у меня есть вопросы…»~
@45578 = ~«Прямо сейчас — ничего. Прощай».~
@45579 = ~«Ещё раз! Ещё раз! Ты ещё раз пришёл ко мне! Должно быть, есть что-то, что я могу для тебя сделать, а мой брат Деран не в состоянии, а? Ха!»~
@45580 = ~«Я хочу кое-что купить».~
@45581 = ~«У меня к тебе кое-какие вопросы».~
@45582 = ~«Я хочу поговорить о торговле».~
@45583 = ~«У тебя есть для меня поручения?»~
@45584 = ~«То объявление уже напечатано».~
@45585 = ~«Сообщение доставлено».~
@45586 = ~«Объявление вывешено в „Горящем трупе“».~
@45587 = ~«У тебя есть для меня ещё поручения?»~
@45588 = ~«Прощай».~
@45589 = ~Его лицо мрачнеет: «Я могу дать тебе секретный пароль и сказать, где его использовать. Как тебе такое?»~
@45590 = ~«Скажи пароль».~
@45591 = ~«Не мог бы ты взамен дать мне денег?»~
@45592 = ~«Пока мне ничего такого не нужно. Лучше ответь на кое-какие вопросы».~
@45593 = ~«Неинтересно. Прощай».~
@45594 = ~«Я могу дать за него 75 монет. Бери или уходи, приятель!»~
@45595 = ~«Беру. Ответь ещё на пару моих вопросов…»~
@45596 = ~«Спасибо, но откажусь. Ответь ещё на пару моих вопросов…»~
@45597 = ~«Беру. Прощай».~
@45598 = ~«Я ухожу. Прощай».~
@45599 = ~«Я пришёл просить совета по поводу шкатулки и демона».~
@45600 = ~«Я хочу купить у тебя тот драгоценный камень, который ты взял из шкатулки Моридора».~
@45601 = ~«Расскажи мне об Аоскаре».~
@45602 = ~«Что случилось? Минуту назад я стал последователем, а следующее, что помню — я застрял в каком-то „лабиринте“».~
@45603 = ~«Сейчас ничем. Прощай».~
@45604 = ~Аола, кажется, впал в глубокий транс. Время от времени он возносит хвалы Аоскару.~
@45605 = ~«Прощай».~
@45606 = ~Ты рассказываешь ему о своём затруднительном положении. Аола обдумывает ситуацию в течение нескольких минут, затем говорит: «Я, скромный последователь великого Аоскара, безусловно могу помочь тебе. Но сначала придётся передать шкатулку мне».~
@45607 = ~Отдать ему шкатулку.~
@45608 = ~Аола размещает шкатулку Моридора в сооружение из проволоки в форме пирамиды, затем начинает нашёптывать молитвы Аоскару. Знакомое мерцание портала наполняет стороны пирамиды. Затем Аола небрежным жестом запускает руку в портал и рывком открывает шкатулку Моридора.~
@45609 = ~Продолжить.~
@45610 = ~Ты вскрикиваешь, пытаясь его остановить, но уже слишком поздно. Практически сразу шкатулка начинает разлагаться, и тошнотворный дым заполняет пространство внутри пирамиды. Чувство беспредельного ужаса переполняет комнату, и ты сжимаешь всю волю в кулак, чтобы не сбежать из помещения.~
@45611 = ~Продолжить.~
@45612 = ~Ты замечаешь, что как только клубы дыма касаются стенок пирамиды, они немедленно исчезают, затянутые в воронки порталов. С исчезновением последней струйки дыма проходит и чувство ужаса. Аола несколько нервно улыбается тебе: «Узри силу Аоскара, Хранителя Врат!»~
@45613 = ~«Уверен, у изверга такой силы, для удержания которой потребовалось столько заклинаний, не будет особых проблем с возвращением. И когда он вернётся, искать он будет тебя…»~
@45614 = ~Он ловко выхватывает каменного лим-лима из твоих рук и шепчет на ухо: «Пароль — „затмение“. Он даст тебе доступ на склад Хранилища Девятого Мира. Там находятся Анархисты. Скажи им пароль, но не говори, кто тебе его сообщил!»~
@45615 = ~«Я это учёл. Видишь ли, каждая сторона пирамиды содержит портал на разные планы. В результате я рассеял его сущность по всей мультивселенной. Ведомо ли тебе, что существуют миры, где демонов считают чем-то вроде деликатеса?» — он тихонько смеётся, шарясь в остатках шкатулки. Наконец он извлекает драгоценный камень, что был в неё вделан: «Плата за мои услуги. Я пущу его на восстановление моего прекрасного собора».~
@45616 = ~«„Затмение“. Понял. У меня есть ещё вопросы…»~
@45617 = ~«Оставь себе камень, ты его более чем заслужил. Прощай».~
@45618 = ~«За многие годы у меня было много учеников. К сожалению, все они исчезли. Довольно обидно, вообще-то. Как только они проходят посвящение, я их больше не вижу. Недавно прошёл слух, что причина этого — сама Госпожа. Так никто теперь и не приходит. Ты первый, кто зашёл, уже прямо и не знаю за сколько времени».~
@45619 = ~«Я не боюсь; желаю стать последователем Аоскара».~
@45620 = ~«Расскажи мне об Аоскаре».~
@45621 = ~«Госпожа… не хочу с ней пересекаться. Пойду-ка я лучше своей дорогой. Прощай».~
@45622 = ~«„Затмение“. Понял. Прощай».~
@45623 = ~В голосе Аолы появляются нотки низкопоклонства: «Аоскар — Хранитель Врат. В Аоскаре заключена сила порталов, дверей и возможностей. Сигил, иначе известный как Город Дверей, был домом Аоскара, пока его не „выселила“ эта трижды проклятая Госпожа. Теперь здесь почти не осталось поклоняющихся Аоскару, поскольку Госпожа это запрещает. Но скоро всё изменится, когда я покажу людям мощь и величие Аоскара. И она не сможет пойти против воли людей!»~
@45624 = ~«Я хочу стать последователем Аоскара».~
@45625 = ~«Череп, а? Да ну? Ха! Я знаю тут только один рынок, на котором торгуют такого рода вещами! Но… — он понижает голос, — …я не могу тебе сказать, где он находится… если только не…»~
@45626 = ~«А что, у Аоскара нет других последователей?»~
@45627 = ~«Если только не что?»~
@45628 = ~«Забудь. Ответь мне ещё на некоторые вопросы…»~
@45629 = ~«Госпожа… не хочу с ней пересекаться. Пойду-ка я лучше своей дорогой. Прощай».~
@45630 = ~«Забудь. Прощай».~
@45631 = ~«Прекрасно! Так давно уже этого никто не просил». Аола заставляет тебя выполнить серию сложных ритуалов и говорит: «Теперь ты последователь Аоскара; иди и неси его слово жителям Сигила, так чтобы каждый мог узнать величие Аоскара!»~
@45632 = ~«Не могу тебе сказать, приятель, потому что это подвергнет опасности твою жизнь. Нет, почтенный, твоя жизнь, да и моя тоже, слишком ценны, чтобы рисковать ими ради такого пустякового любопытного факта!»~
@45633 = ~«Десять монет изменят твоё решение?»~
@45634 = ~«Прощай».~
@45635 = ~«К счастью для тебя, я его ещё не продал. И согласен отдать тебе за ничтожную цену в три сотни медяков».~
@45636 = ~«Беру».~
@45637 = ~«А что, если я отдам тебе всё содержимое моего кошелька?»~
@45638 = ~«Столько я не могу себе позволить».~
@45639 = ~«Это грабёж… столько я платить не буду».~
@45640 = ~«А если я начну тебе угрожать?»~
@45641 = ~«Да улыбнётся тебе Аоскар, бог порталов, дверей и „возможностей“».~
@45642 = ~«Забудь. Ответь мне ещё на кое-какие вопросы».~
@45643 = ~«Прощай».~
@45644 = ~«Тогда забудь. Прощай».~
@45645 = ~«Вот неудача-то. Уступить не могу. Может, подзаработаешь немного и вернёшься. Я буду более чем счастлив придержать камешек для тебя».~
@45646 = ~«Прощай».~
@45647 = ~«Это меняет дело, — говорит он. — Слушай, и слушай внимательно». Он наклоняется и громко шепчет тебе в ухо: «Только один человек из тех, кого я знаю, осмеливается заниматься такими вещами, и это не тот человек, с которым стоит шутки шутить! От него веет опасностью, и немногие отваживаются произнести его имя! Я говорю о…» Он замолкает и мелодраматично выдыхает: «…Лотаре, Повелителе Костей!»~
@45648 = ~«Мне на самом деле нужны эти деньги для восстановления собора. Ты точно не передумаешь?.. Поскольку я знаю, что на рынке получу как минимум столько же».~
@45649 = ~«Ладно, беру».~
@45650 = ~«Кто это?»~
@45651 = ~«Забудь об этом».~
@45652 = ~«Повелитель Костей! Владыка Костей Ночи, обладатель самой ужасной библиотеки по эту сторону от дома Сета! Черепа лежат на её полках, они шепчут свои секреты Лотару и тем, кто имел безрассудство встретиться с ними. Там можно много чего узнать… если только сразу не сойдёшь с ума!»~
@45653 = ~«Можно перейти к делу?»~
@45654 = ~«Звучит так, словно ты был куда-то отправлен. Только опытные последователи Аоскара и Госпожа могут делать такое. Это может объяснить исчезновение моих учеников. Мне необходимо всё обдумать. Пожалуйста, оставь меня».~
@45655 = ~«И где это место?»~
@45656 = ~«Чего он хочет от этих черепов?»~
@45657 = ~«Прощай».~
@45658 = ~«Спасибо. Ответь мне на пару вопросов…»~
@45659 = ~«Спасибо. Прощай».~
@45660 = ~Он прочищает глотку: «Прошу прощения за попытку сделать это более интересным. Просто люблю нагнетать атмосферу. Это по направлению к шпилю Сигила, там *может* быть обгорелый остов здания. *Возможно*, ты найдёшь там лестницу, сделанную из человеческих жил, — а может, просто из дерева — она ведёт вниз, вниз, вниз, вниз, к самому сердцу Сигила. И когда ты снова сойдёшь на землю… ты *можешь* столкнуться лицом к лицу с самим Лотаром!»~
@45661 = ~«Что он делает с черепами?»~
@45662 = ~«Спасибо. Ответь мне на пару вопросов…»~
@45663 = ~«Спасибо. Прощай».~
@45664 = ~«Это по направлению к шпилю Сигила, там *могут* быть развалины некоего здания. *Возможно*, ты найдёшь там лестницу из костей, она ведёт вниз, вниз, к самому сердцу Сигила, и лестница *может* привести тебя в Зал Черепов, где ты столкнёшься лицом к лицу с самим Лотаром!»~
@45665 = ~«Что он делает с черепами?»~
@45666 = ~«Спасибо. Ответь мне на пару вопросов…»~
@45667 = ~«Спасибо. Прощай».~
@45668 = ~«Говорят, мертвец не проболтается… но только не в обители Лотара. Там мёртвые открывают свои секреты готовому слушать! Больше мёртвых, больше баек, больше историй. А чем больше историй… ну, тем больше открывается глазу секретов из самого сердца мультивселенной!» — он поднимает для выразительности бровь.~
@45669 = ~::Вздох:: «Спасибо. У меня ещё пара вопросов…»~
@45670 = ~::Вздох:: «Спасибо. Прощай».~
@45671 = ~«Я? Я — Гильтспур, аукционер, к твоим услугам! Покупаю, продаю, оказываю услуги и занимаюсь трудоустройством!»~
@45672 = ~«Я бы хотел кое-что продать».~
@45673 = ~«Я хочу кое-что купить».~
@45674 = ~«А как насчёт пары вопросов?»~
@45675 = ~«Замечательно, спасибо. Прощай».~
@45676 = ~«Это? Это же Нижний район! Дом Боготов, место Великой Кузницы и центр всевозможных услуг! У нас есть всё, что тебе нужно!»~
@45677 = ~«Что ты можешь рассказать о Боготах?»~
@45678 = ~«Что ты можешь рассказать о Кузнице?»~
@45679 = ~«Ответь мне на другие вопросы…»~
@45680 = ~«Спасибо. Прощай».~
@45681 = ~«Эта группа близка моему сердцу. Они говорят, что мы все сами себе боги, что у нас в душе заложена потенциальная божественность. От нищего до короля — мы все носим бога в своём чреве! Что может быть лучше?»~
@45682 = ~«Гармониум».~
@45683 = ~«Анархисты».~
@45684 = ~«Чующие».~
@45685 = ~«Пыльные».~
@45686 = ~«Убийцы Милосердия».~
@45687 = ~«А, хороший выбор! Прекрасный ответ!» — он фыркает.~
@45688 = ~«Я хотел задать ещё пару вопросов…»~
@45689 = ~«Спасибо. Прощай».~
@45690 = ~«Для меня Кузница — всего лишь благоприятная возможность! Место, где каждый может испытать свой характер металлом, где души обретают мерило и закаляются в воде знания. Или раскалываются об наковальню истины! — на мгновение его голос понижается до нормального. — Так, по крайней мере, говорят Боготы».~
@45691 = ~«Что ты можешь рассказать о Боготах?»~
@45692 = ~«У меня есть пара других вопросов…»~
@45693 = ~«Спасибо. Прощай».~
@45694 = ~«Конечно, приятель! У меня есть для тебя небольшое поручение, если ты за него возьмёшься, разумеется! Оно позволит тебе заработать пятьдесят монет! Всё, что тебе нужно, — отнести это объявление в печатную мастерскую и попросить Своевольного Пенна напечатать для меня сотню копий! Вот! Возьми!» — он суёт тебе в руку мятый клочок бумаги.~
@45695 = ~«Хорошо. У меня ещё пара вопросов».~
@45696 = ~«Спасибо, наверное. Прощай».~
@45697 = ~«Напечатано? Колоссально! Я знал, что эта работа для такого человека, как ты! Вот, отнеси в Кузницу это сообщение для Келдора из Дуриана. Я уверен, он будет рад его получить, а ты будешь рад получить сотню по возвращении».~
@45698 = ~«Хорошо. У меня ещё пара вопросов».~
@45699 = ~«Спасибо, наверное. Прощай».~
@45700 = ~«Это было безусловно быстро, не так ли? Благодарствую, благодарствую, друг. И ещё одно задание для тебя за прекрасную сумму в две сотни! Просто отнеси это объявление Баркису в „Горящий труп“ и попроси повесить куда-нибудь. Он мой старый приятель, так что будет рад его видеть!»~
@45701 = ~«Хорошо. У меня ещё пара вопросов».~
@45702 = ~«Спасибо, наверное. Прощай».~
@45703 = ~«Тогда у меня больше нет для тебя работы, приятель. Моя тебе благодарность!» — он отворачивается к толпе и принимается распинаться перед ней.~
@45704 = ~«Я хотел задать ещё кое-какие вопросы…»~
@45705 = ~«Тогда прощай».~
@45706 = ~«Извини, приятель. У меня больше ничего нет… ты выполнил все мои поручения!» — он смеётся.~
@45707 = ~«Тогда, может, ответишь на пару вопросов…»~
@45708 = ~«Тогда спасибо. Прощай».~
@45709 = ~«О-о, аукцион! Может, нам тут удастся продать Анну».~
@45710 = ~«О-о, аукцион! Может, нам тут удастся продать Дак'кона».~
@45711 = ~«О-о, аукцион! Может, мы здесь найдём мне тело».~
@45712 = ~«Верно, Морте. Я обязательно спрошу».~
@45713 = ~«Тогда не стоит останавливаться».~
@45714 = ~«Наверное, это любовь. Это ведь любовь, верно, шеф?»~
@45715 = ~«Прекратите, вы оба. Мне нужно кое о чём тут спросить».~
@45716 = ~«Как скажешь, Морте. Оставим этого приятеля в покое».~
@45717 = ~В отличие от остальных Сборщиков, которых ты видел, этот прекрасно одет. «А-а, ещё один покойничек пришёл нас навестить. Прошу прощения за *беспорядок*, у моих коллег не было времени прибраться».~
@45718 = ~«Отсюда нет выхода…»~
@45719 = ~Власк тихо усмехается: «Снова ты! У нас с друзьями дела редко повторяются. Сразу перейду к делу: теперь цена за ключ — две сотни».~
@45720 = ~«Я вернулся тебя убить».~
@45721 = ~«Я бы тебе кишки-то повыпускала, череп, да только нечего уже выпускать».~
@45722 = ~«Возьми деньги».~
@45723 = ~«У меня столько нет».~
@45724 = ~«Да ладно, конечно, он есть. Дверь прямо вот там. Но тебе понадобится одна из этих штучек, чтобы активировать портал, — он показывает что-то вроде маленькой стеклянной бусины. — Давай обсудим цену».~
@45725 = ~«Лучше я просто тебя убью».~
@45726 = ~«Я слушаю…»~
@45727 = ~«Всё просто. Ты платишь нам с товарищами сотню медяков. Я даю тебе ключ к порталу».~
@45728 = ~«А что, если я не хочу платить?»~
@45729 = ~«Вот деньги. Давай ключ».~
@45730 = ~Дак'кон только сильнее поджимает губы, но ничего не отвечает.~
@45731 = ~«Брось, Морте. Мне нужно кое о чём тут спросить».~
@45732 = ~«У меня столько нет».~
@45733 = ~«Давай просто уйдём, ладно?»~
@45734 = ~«Тогда нам с друзьями придётся продать твоё тело Пыльным. Деньги мы получим в любом случае».~
@45735 = ~«Думаю, лучше я просто тебя убью».~
@45736 = ~«Вот деньги. Давай ключ».~
@45737 = ~«У меня столько нет».~
@45738 = ~«Мне с товарищами нравится иметь с тобой дело. Просто раздави бусинку, и портал будет активирован».~
@45739 = ~«Прощай».~
@45740 = ~«Жалость-то какая. Парни, приготовьте этого для Пыльных».~
@45741 = ~«Готовься к смерти…»~
@45742 = ~«Проклятие! На этот раз у меня почти получилось. Разве ты не знаешь, что прерывать мага в процессе произнесения заклинания опасно? Тебе повезло, что я всего лишь тренировалась. Ну, и чего ты хочешь?»~
@45743 = ~«Я бы хотел узнать побольше об этой коробочке».~
@45744 = ~«Извини, что побеспокоил. Прощай».~
@45745 = ~«Опять прервали! Даже у себя дома уединения не найти. Уходи, пожалуйста, пока я не вызвала охрану… или ещё хлеще, пока не опробовала то самое новое заклинание, с которым я тут игралась».~
@45746 = ~Этот тяжёлый додекаэдр размером с два твоих кулака выглядит необычайно знакомым. Его поверхность холодная и гладкая, но ты не можешь понять, сделан ли он из металла или камня. В нём чувствуется некоторая «напряжённость», почти неуловимая, словно он в любой момент готов взмыть в воздух.~
@45747 = ~Внимательно осмотреть додекаэдр.~
@45748 = ~«Я бы хотел узнать побольше об этой коробочке».~
@45749 = ~«Извини, что побеспокоил. Прощай».~
@45750 = ~«Ты уже и так потратил много моего времени. Пожалуйста, уходи».~
@45751 = ~Уйти.~
@45752 = ~«По Улью ходит слух, что это ты убил изверга, который был заключён в шкатулке Моридора. Полагаю, ты не подумал о том, чтобы собрать и сохранить его части?»~
@45753 = ~«Любопытно, чем ты занимаешься, если интересуешься такими вещами?»~
@45754 = ~«Эх… нет, я не догадался из сохранить».~
@45755 = ~«Ходят слухи, что ты уничтожил шкатулку Моридора. Думаю, тебя стоит поздравить. Обидно, правда, что я не смогу расшифровать те заклинания, которые удерживали изверга».~
@45756 = ~«Прощай».~
@45757 = ~Ты вынимаешь шкатулку Моридора для того, чтобы её осмотрела Шиландра. «А, да! Я очень хорошо помню эту шкатулку, когда-то я приобрела её. Что тебе угодно о ней знать?»~
@45758 = ~«От кого ты её получила?»~
@45759 = ~«Похоже, ты разбираешься в магии. Не можешь мне сказать, какие заклинания были на неё наложены?»~
@45760 = ~«Не знаешь предыстории этой шкатулки?»~
@45761 = ~«Что ещё ты хочешь знать?»~
@45762 = ~«Как тебе досталась шкатулка?»~
@45763 = ~«Похоже, ты разбираешься в магии. Не можешь мне сказать, какие заклинания были на неё наложены?»~
@45764 = ~«Не могла бы ты безопасно удалить заклинания со шкатулки?»~
@45765 = ~«Не знаешь предыстории этой шкатулки?»~
@45766 = ~«Есть ли достаточно безопасный способ уничтожить шкатулку Моридора, никому не повредив?»~
@45767 = ~«Хм-м… дай подумать. Я не припомню, от кого я её получила. Помню лишь, что пошла на рынок за компонентами к заклинаниям, когда некто предложил мне эту коробочку. Проверив шкатулку, я обнаружила на ней проклятие, но была заинтригована вплетёнными в неё заклинаниями, так что всё равно её приобрела».~
@45768 = ~«Но, если ты была так ею заинтригована, почему избавилась от неё?»~
@45769 = ~«Я бы хотел задать ещё вопрос…»~
@45770 = ~«Многие годы я изучала шкатулку и пыталась разгадать её секрет. На ней наложено заклинание, на него ещё заклинание, а на него ещё заклинание. К моему удивлению, я обнаружила, что все эти заклинания имеют одинаковую природу и предназначены для удержания извергов».~
@45771 = ~«Извергов? Хочешь сказать, в этой шкатулке заключены изверги…»~
@45772 = ~«Нет! Не изверги. Изверг. И судя по мощи и сложности системы заклинаний, он обладал огромными силами и положением в своих владениях».~
@45773 = ~«Я бы хотел задать ещё вопрос…»~
@45774 = ~«Ищешь способ избавиться от шкатулки, а? Это заклинание хуже всех остальных. Вообще-то, именно оно выкачивает энергию из владельца коробочки, чтобы снабжать ею собственно заклинание удержания. И это не самое худшее. Изверг внутри чует эту энергию и по ней, скорее всего, будет искать хозяина шкатулки, чтобы убить. Безвыходное положение для владельца. Или она иссушит тебя, выкачав всю энергию, или изверг вырвется и убьёт тебя».~
@45775 = ~«Понимаю. Если не возражаешь, я бы задал ещё кое-какие вопросы…»~
@45776 = ~«Я была молода и безрассудна. В своей неустанной погоне за знанием я сняла одно из заклинаний, не подумав о последствиях. Посмотри внимательно на шкатулку. Когда я её брала, она была как новая. Следы разложения — свидетельство того, что заклинания слабеют. Я поняла, что нахожусь в опасности и нельзя больше держать шкатулку у себя. Так что я устроила соревнования, чтобы от неё избавится».~
@45777 = ~«Соревнование?»~
@45778 = ~«Я бы хотел задать ещё вопрос…»~
@45779 = ~«О, это был самый ловкий способ избавиться от неё. Я просто пригласила всех громил Улья сражаться друг с другом, чтобы определить, кто же лучше. Громилы, они тем примечательны, что у них огромные мышцы и не много чего над ними, ну ты понял. Они слетелись как мухи на мёд. В качестве приза были деньги и шкатулка. Помнится, какой-то громила по имени Браскен выиграл соревнование».~
@45780 = ~«Я бы хотел задать ещё вопрос…»~
@45781 = ~«Единственное, что я смогла узнать про эту шкатулку, — её название. Её упоминают как „Шкатулку Моридора“. О том, кто такой этот Моридор, так же как и о происхождении шкатулки, мне ничего не известно».~
@45782 = ~«Я бы хотел задать ещё вопрос…»~
@45783 = ~«Я недостаточно сильна, чтобы сражаться или изгнать такое существо. Прошли годы с тех пор, как я была там в последний раз, но в центре аллеи Опасных Углов был собор. Священник оттуда или кто-то другой, владеющий силами из высшего источника, вероятно, поможет тебе».~
@45784 = ~«Ты мне очень помогла. Спасибо».~
@45785 = ~«Думаю, неискушённый в магии этого не поймёт. Определённые части являются компонентами для заклинаний. Если ты меня простишь, то я бы попрактиковалась ещё немного с тем заклинанием».~
@45786 = ~«Прощай».~
@45787 = ~«Мне больше нечего тебе сказать».~
@45788 = ~«Прощай».~
@45789 = ~Ты видишь слегка прихрамывающего тщедушного мужчину. В его голосе слышен почти комический акцент: «Силы и их небесные жилища, что такое?»~
@45790 = ~~
@45791 = ~«Наш клиент! Наш клиент! Микка! Наш клиент вернулся!»~
@45792 = ~~
@45793 = ~Тщедушный мужчина отвечает: «Конечно, твои глаза видят клиента! Они всегда видят клиента… клиента на УЛИЦЕ! У нас нет клиентов и никогда не будет. Бесполезно и безнадёжно надеяться на то…» Он запинается, его глаза загораются: «Микка! У нас клиент!»~
@45794 = ~~
@45795 = ~«Я ВИЖУ. Думаешь, я слепой? Конечно вижу. У меня есть глаза, разве нет? — он поворачивается к тебе. — Что мы можем сделать для тебя сегодня?»~
@45796 = ~«Поговорим о торговле».~
@45797 = ~«Не расскажешь мне об этом районе?»~
@45798 = ~«Не расскажешь мне о себе?»~
@45799 = ~«Кто она?»~
@45800 = ~«Что ты можешь рассказать о фракциях?»~
@45801 = ~«Спасибо, ничего. Прощай».~
@45802 = ~«Конечно, я готов! Я всегда готов! К любому клиенту, какой бы он ни был! — он прерывается, его глаза останавливаются на тебе. — Что мы можем сделать для тебя сегодня?»~
@45803 = ~«Поговорим о торговле».~
@45804 = ~«Не расскажешь мне об этом районе?»~
@45805 = ~«Не расскажешь мне о себе?»~
@45806 = ~«Кто она?»~
@45807 = ~«Что ты можешь рассказать о фракциях?»~
@45808 = ~«Спасибо, ничего. Прощай».~
@45809 = ~«А, хочешь узнать о районе? Я многое могу рассказать о нём. Здесь есть на что посмотреть…»~
@45810 = ~~
@45811 = ~«Я? Хочешь узнать обо мне? Микка, он хочет узнать обо мне».~
@45812 = ~~
@45813 = ~«Она? Она? Она моя любящая жена вот уже около сорока лет. Она — свет всей моей жизни и величайший…»~
@45814 = ~~
@45815 = ~«Фракции, да? Фракции? Микка, он хочет узнать о фракциях. У нас есть…»~
@45816 = ~~
@45817 = ~«Я собирался рассказать ему о рынке, но теперь расскажу о борделе, тебе назло! А потом расскажу о Фестхолле, и ни за что не упомяну о других достопримечательностях!»

Парочка пускается в перепалку, совершенно игнорируя тебя.~
@45818 = ~«Я хотел задать ещё пару вопросов…»~
@45819 = ~«Я бы хотел что-нибудь купить…»~
@45820 = ~«Тогда прощай».~
@45821 = ~Они так заняты ссорой, что совершенно не обращают на тебя никакого внимания. А магазин быстро заполняется их словами.~
@45822 = ~Уйти.~
@45823 = ~«Мне не достаёт честолюбия? Не достаёт честолюбия? Если бы у меня на шее не висела эта жена и эта жизнь, я бы хоть что-то из себя представлял! Но нет, вместо этого я хозяин магазина, а не великий искатель приключений…» — парочка пускается в перепалку, игнорируя тебя.~
@45824 = ~«Я хотел задать ещё пару вопросов…»~
@45825 = ~«Я бы хотел что-нибудь купить…»~
@45826 = ~«Тогда прощай».~
@45827 = ~«…если бы только она уже не пила! Она — одна из величайших пьяниц в Улье, сэр, и она такая уже многие ГОДЫ, поверь мне, ГОДЫ. Она выпила бы реку Океанус, будь в ней спирт, и ей всё было бы мало!»

Двое продолжают перебранку, совершенно игнорируя тебя.~
@45828 = ~«Я хотел задать ещё пару вопросов…»~
@45829 = ~«Я бы хотел что-нибудь купить…»~
@45830 = ~«Тогда прощай».~
@45831 = ~«Я верю только в одно — я верю, что эта жизнь дана мне в наказание за какую-то ужасную вещь, совершённую в прошлой жизни!»

Они разражаются кошмарной бранью и совершенно не замечают тебя.~
@45832 = ~«Я хотел задать ещё пару вопросов…»~
@45833 = ~«Я бы хотел что-нибудь купить…»~
@45834 = ~«Тогда прощай».~
@45835 = ~«Её вкусы идут только в одном направлении — как сделать её брюхо ещё толще. Её вкус изначально был у неё во рту, да и там его очень мало».~
@45836 = ~~
@45837 = ~Брока с мрачной иронией замечает: «А я бы спросил, как я могу не ценить такой прекрасный рот и такую фигуру, как эти? И правда, нет у меня ни вкуса, ни понимания…»~
@45838 = ~~
@45839 = ~«Действительно, трудно поверить! Все шансы насмарку, когда у меня могло быть самое прекрасное время в жизни!»~
@45840 = ~~
@45841 = ~«Захлопни пасть! Из меня мужчина куда лучше, чем ты будешь когда-либо! — он прерывается, ещё раз обдумывает свои слова и критически осматривает свою жену. — Может, и нет. Если честно, усы у тебя круче, чем у любого мужика на этом свете…»~
@45842 = ~~
@45843 = ~«Добро пожаловать в Хранилище Девятого Мира! Чем могу быть полезен в этот замечательный день, сигилец?»~
@45844 = ~«Что это за место?»~
@45845 = ~«Кто ты?»~
@45846 = ~«Я слышал, были какие-то проблемы при получении товара отсюда».~
@45847 = ~«У меня пара вопросов…»~
@45848 = ~«Дважды добро пожаловать в Хранилище Девятого Мира! Чем могу быть полезен в этот замечательный день, сигилец?»~
@45849 = ~«Что это за место?»~
@45850 = ~«Кто ты?»~
@45851 = ~«Я бы хотел кое-что положить на хранение».~
@45852 = ~«Я бы хотел кое-что забрать».~
@45853 = ~«Я слышал, были какие-то проблемы при получении товара отсюда».~
@45854 = ~«Прощай».~
@45855 = ~«Хранилище Девятого Мира с радостью служит хранилищем для Нижнего района и любых выходцев из Сигила! Наше кредо: „Когда и целого мира мало“! Мы предоставляем пространство для хранения тем, у кого и так всё забито под завязку. У нас конкурентоспособные цены! У нас образцовое обслуживание! А наша вежливость с клиентами известна на всех планах!»~
@45856 = ~«Кто ты?»~
@45857 = ~«Прощай».~
@45858 = ~«Я — голос Хранилища Девятого Мира. И я здесь для того, чтобы оказывать услуги вам, клиент. Сообщите, что вам угодно!»~
@45859 = ~«Я бы хотел кое-что положить на хранение».~
@45860 = ~«Я бы хотел кое-что забрать».~
@45861 = ~«Почему это место названо Хранилищем Девятого Мира?»~
@45862 = ~«Это место действительно такое огромное, как целый мир?»~
@45863 = ~«Ничего. Спасибо».~
@45864 = ~«Честно говоря, я не знаю! Думаю, владельцы просто решили, что это отличное название».~
@45865 = ~«Я бы хотел кое-что положить на хранение».~
@45866 = ~«Я бы хотел кое-что забрать».~
@45867 = ~«Это место действительно такое огромное, как целый мир?»~
@45868 = ~«А. Прощай».~
@45869 = ~«Нет, это просто маркетинговое преувеличение. Здесь действительно много места, но не настолько много».~
@45870 = ~«Я бы хотел кое-что положить на хранение».~
@45871 = ~«Я бы хотел кое-что забрать».~
@45872 = ~«Почему это место названо Хранилищем Девятого Мира?»~
@45873 = ~«А. Прощай».~
@45874 = ~«Прошу прощения! Кажется, на данный момент мы переполнены! Могу ли я ещё что-нибудь для вас сделать?»~
@45875 = ~«Я думал, тут предполагался гигантский склад».~
@45876 = ~«Я бы хотел кое-что забрать».~
@45877 = ~«У меня ещё кое-какие вопросы…»~
@45878 = ~«Нет. Прощай».~
@45879 = ~«Разумеется! Что могу для вас сделать?»~
@45880 = ~«Что это за место?»~
@45881 = ~«Кто ты?»~
@45882 = ~«Я бы хотел кое-что положить на хранение».~
@45883 = ~«Я бы хотел кое-что забрать».~
@45884 = ~«Почему это место названо Хранилищем Девятого Мира?»~
@45885 = ~«Это место действительно такое огромное, как целый мир?»~
@45886 = ~«Я слышал, были какие-то проблемы при получении товара отсюда».~
@45887 = ~«Ничего. Спасибо».~
@45888 = ~«Ну… да, — голова выглядит слегка смущённой. — Только у нас иссякло свободное место, и происходит что-то подозрительное, что именно — не знаю. Суть дела такова: мы больше не принимаем вещи на хранение».~
@45889 = ~«О. Тогда у меня кое-какие вопросы…»~
@45890 = ~«Ясно. Тогда прощай».~
@45891 = ~«И что именно вам нужно?»~
@45892 = ~«Большая сумка денег».~
@45893 = ~«Большая сумка денег».~
@45894 = ~«Я здесь, чтобы забрать подушку для гробовщика Хэмриса».~
@45895 = ~«Мне сказали, что я могу получить здесь планы гробницы».~
@45896 = ~«Мне сказали передать тебе, что я пришёл за ссудой».~
@45897 = ~«Мне сказали передать тебе, что я пришёл за ссудой. А ещё я оставил в дураках Пикита».~
@45898 = ~«Мне сказали передать тебе, что я оставил в дураках Пикита».~
@45899 = ~«Ничего. Однако у меня есть вопросы…»~
@45900 = ~«Ничего. Прощай».~
@45901 = ~«Да. Мои хозяева тоже очень этим интересуются. Я бы узнал, но я всего лишь большое заклинание, наложенное на голову! И я понятия не имею, что случилось со свободным местом. Мы открыты, если кто-нибудь спросит! Вы можете свободно забирать вещи. Просто спросите!»~
@45902 = ~«Тогда ладно. Я бы хотел кое-что забрать».~
@45903 = ~«Лучше я задам кое-какие вопросы».~
@45904 = ~«Спасибо, так и сделаю. Но позже. Прощай».~
@45905 = ~«Прощайте! В Хранилище Девятого Мира мы ценим ваши интересы. Пожалуйста, приходите ещё».~
@45906 = ~«Да, конечно».~
@45907 = ~«Прощай».~
@45908 = ~«Простите. Не будете ли вы любезны не нападать на голову?»~
@45909 = ~«Верно. У меня всего лишь пара вопросов…»~
@45910 = ~«Хорошо. Прощай».~
@45911 = ~«Прошу прощения, сэр! Эту вещь уже забрали! Не хотите ли получить что-нибудь другое?»~
@45912 = ~«Да».~
@45913 = ~«Нет. Просто ответь на пару вопросов».~
@45914 = ~«Нет. Прощай».~
@45915 = ~«У нас есть сумка с деньгами, как раз такая, как и описано, сэр! Мне нужно узнать от вас только одну вещь: сколько денег в ней было?»~
@45916 = ~Почему-то эта догадка кажется верной… «1123 монеты».~
@45917 = ~«Вот, забирайте, сэр! Спасибо за то, что обратились в Хранилище Девятого Мира! Могу я ещё чем-нибудь помочь?»~
@45918 = ~Почему-то эта догадка кажется верной… «1123 монеты».~
@45919 = ~Эта толстая женщина со сволочными глазами и гнусавым голосом вопит: «И что тут у нас? Клиент? Неужели мои глаза видят клиента?»~
@45920 = ~~
@45921 = ~«Мёртвый вернулся. Брока! Мёртвый вернулся!»~
@45922 = ~~
@45923 = ~Его партнёрша, тусклая женщина с резким голосом, кивает тебе и отвечает: «Это клиент, кретин, как я тебе и говорила, кажется, уже лет сто назад! Я говорила тебе, что у нас будут посетители, а ты мне не верил, и вот он! Ты к нему готов… к этому… ну… мёртво выглядящему мужчине?»~
@45924 = ~~
@45925 = ~«У меня есть глаза, сама не вижу, что ли? Я его вижу, вижу, кончай меня донимать, старый мешок с костями!» Она поворачивается к тебе и скрипит: «Что может старая Микка для тебя сделать?»~
@45926 = ~«Поговорим о торговле».~
@45927 = ~«Не расскажешь мне об этом районе?»~
@45928 = ~«Можешь рассказать о себе?»~
@45929 = ~«Кто он?»~
@45930 = ~Почему-то эта догадка кажется верной… «1123 монеты».~
@45931 = ~«Что ты можешь рассказать о фракциях?»~
@45932 = ~«Спасибо, ничего. Прощай».~
@45933 = ~«Это то, о чём я тебе и говорила! — она понижает голос и поворачивается к тебе. — Чем мы можем быть полезны?»~
@45934 = ~«Поговорим о торговле».~
@45935 = ~«Не расскажешь мне об этом районе?»~
@45936 = ~«Можешь рассказать о себе?»~
@45937 = ~Угадать: «1000 монет».~
@45938 = ~Угадать: «500 монет».~
@45939 = ~«Кто он?»~
@45940 = ~Угадать: «750 монет».~
@45941 = ~«Что ты можешь рассказать о фракциях?»~
@45942 = ~«Спасибо, ничем. Прощай».~
@45943 = ~Угадать: «331 монета».~
@45944 = ~«Я уверена, мой муж будет просто счастлив рассказать тебе про Фестхолл и бордель… — она хмыкает. — Но мои вкусы более благонравны…»~
@45945 = ~Угадать: «2112 монет».~
@45946 = ~~
@45947 = ~«Я? Я привязана, словно к якорю, к этому ломбарду и мужу, который меня совсем не ценит…»~
@45948 = ~«Прошу прощения, сэр! Должно быть, это не ваша сумка с материальными ценностями! Могу я ещё чем-нибудь помочь?»~
@45949 = ~~
@45950 = ~«Ответь ещё на кое-какие вопросы…»~
@45951 = ~«Он? Он Брока. Это мой муж, вот уже двадцать с лишним лет, хотя непонятно, как он с его непостоянной натурой за все эти годы не отбился…»~
@45952 = ~«Нет, спасибо. Прощай».~
@45953 = ~~
@45954 = ~«Подушку? Я, разумеется, пользуюсь подушкой… большой КАМЕННОЙ подушкой! Вот ваша подушка, господин Хэмрис, и хорошо вам на ней поспать! Могу я ещё чем-нибудь помочь?»~
@45955 = ~«Фракции? Фракции? Ха. Всё, что они сделали, — так это задавили наш несчастный магазин налогами почти насмерть. Нас доведут до Улья или ещё чего похуже и сделают из Броки мужика ещё никудышнее, чем он есть…»~
@45956 = ~~
@45957 = ~«Ответь ещё на пару вопросов…»~
@45958 = ~Микка встревает: «И первое, о чём ты вспомнишь, — это, без сомнения, бордель. Бордель для вас, для мужчин! Это всегда или бордель, или Фестхолл — и никогда не рынок или…»~
@45959 = ~«Нет, спасибо. Прощай».~
@45960 = ~~
@45961 = ~«Он просто вежлив. На самом деле ему плевать. Ты всё равно ничего толкового сказать не сможешь. Ты владелец ломбарда и останешься им до самой смерти, вот и всё, потому что тебе не достаёт честолюбия…»~
@45962 = ~«Планы гробницы? Вы не выглядите мёртвым, сэр, хотя это не моё дело, даже если вы и труп! Вот ваши планы, сэр! Могу я ещё что-нибудь вам предоставить?»~
@45963 = ~~
@45964 = ~«…величайший подарок в его жизни, разве не так? Понимаешь, я спасла его от той жизни, что запланировали его родители. А он пообещал забрать меня от всего этого, а взамен, какую жизнь он уготовил мне взамен? Скажу я тебе, этого более чем достаточно, чтобы запить…»~
@45965 = ~«Ответь ещё на кое-какие вопросы…»~
@45966 = ~~
@45967 = ~«У меня есть уши, я слышу всё, что он говорит. Брока не торгует с фракциями, ведь они знают, что он даже самому себе толком верить не может».~
@45968 = ~~
@45969 = ~«Достаточно, чтоб судить, сказала бы я. А ведь я тебе поверила и потеряла такое будущее, у меня ведь были варианты, а теперь…»

Парочка с головой погружается в целенаправленное издевательство друг над другом.~
@45970 = ~«Я хотел задать ещё пару вопросов…»~
@45971 = ~«Я бы хотел что-нибудь купить…»~
@45972 = ~«Тогда прощай».~
@45973 = ~«Я думала, женитьба хоть что-то исправит, но все надежды были тщетны. Эх!» — они снова погружаются в дебри спора, совершенно игнорируя тебя.~
@45974 = ~«Я хотел задать ещё пару вопросов…»~
@45975 = ~«Я бы хотел что-нибудь купить…»~
@45976 = ~«Тогда прощай».~
@45977 = ~«Разумеется, козлам на ферме теперь очень не хватает твоей нежности…» Брока багровеет, и они пускаются в очередную серию бесконечного спора. Их внимание приковано друг к другу, тебя они совершенно не замечают.~
@45978 = ~«Нет, спасибо. Прощай».~
@45979 = ~«Я хотел задать ещё пару вопросов…»~
@45980 = ~«Я бы хотел что-нибудь купить…»~
@45981 = ~«Тогда прощай».~
@45982 = ~Она бессвязно что-то бормочет, затем выдаёт такую тираду, что твои уши свёртываются в трубочку, а вскоре уже и Брока кричит не менее яростно. А на тебя им плевать.~
@45983 = ~«Я хотел задать ещё пару вопросов…»~
@45984 = ~«Ответь ещё на кое-какие вопросы…»~
@45985 = ~«Я бы хотел что-нибудь купить…»~
@45986 = ~«Нет, спасибо. Прощай».~
@45987 = ~«Тогда прощай».~
@45988 = ~Спор разгорается. Они полностью игнорируют тебя, а воздух в магазине тем временем понемногу густеет от их слов.~
@45989 = ~«Ну тогда я попозже зайду. Прощай».~
@45990 = ~«О-о! Один из моих секретных паролей! Вот ваши бумаги, сэр! Спасибо! Сделать для вас ещё что-нибудь?»~
@45991 = ~«Ответь ещё на пару вопросов…».~
@45992 = ~«Нет, спасибо. Прощай».~
@45993 = ~«Я, конечно, надеюсь на это, сэр, что бы это ни значило! Я всего лишь большая тупая каменная башка! Вот ваши бумаги, сэр! И вот ещё! Спасибо! Что ещё я могу для вас сделать?»~
@45994 = ~«Ответь ещё на пару вопросов…»~
@45995 = ~«Ничего. Прощай».~
@45996 = ~«Эй, смотрите! Ещё одна летающая голова».~
@45997 = ~[нет текста]~
@45998 = ~[нет текста]~
@45999 = ~[нет текста]~
@46000 = ~[нет текста]~
@46001 = ~[нет текста]~
@46002 = ~Безымянный Устал 4~ [NAM011]
@46003 = ~[нет текста]~
@46004 = ~Безымянный Заскучал 2~ [NAM013]
@46005 = ~Безымянный Умирает 3~ [NAM023]
@46006 = ~Безымянный Ранен 3~ [NAM026]
@46007 = ~Nameless One Location, Negative Material Plane (The Underworld) 1~ [NAM028]
@46008 = ~Безымянный Действие 1 1~ [NAM031]
@46009 = ~Безымянный Действие 2 1~ [NAM032]
@46010 = ~Безымянный Действие 3 1~ [NAM033A]
@46011 = ~[нет текста]~
@46012 = ~Эта старуха внимательно рассматривает тебя своими проницательными серыми глазами… сперва твоё лицо, затем руки и многочисленные татуировки: «Приветствую тебя, израненный. Пришёл поговорить с Элобрандой, да? Наверное, хочешь узнать свою судьбу за ничтожные пять монет?»~
@46013 = ~«Да… поведай мне мою судьбу…»~
@46014 = ~«Нет, но я хотел задать кое-какие вопросы…»~
@46015 = ~«Нет, спасибо. Прощай, Элобранда».~
@46016 = ~Элобранда кладёт монеты в кошелёк на поясе и берёт твои руки. Она внимательно изучает твои ладони, глубоко нахмурившись. После долгого молчания она говорит: «Знаешь, редкий ты парень, из тех, у кого нет судьбы. Такие люди скитаются по жизни как им угодно, создавая свою собственную судьбу. Мне нечего сказать о твоей судьбе, израненный… вообще нечего. А раз я ничего не могу сказать… вот твои монеты». Она возвращает тебе пять медяков.~
@46017 = ~«Я… понимаю. У меня кое-какие вопросы…»~
@46018 = ~«Тогда прощай».~
@46019 = ~«Я о мирских делах не разговариваю, израненный».~
@46020 = ~«Может, тогда ты поговоришь вот о чём: я прочитал тот свиток, и он оказался ловушкой».~
@46021 = ~«Тогда поведай мне мою судьбу…»~
@46022 = ~«В таком случае прощай».~
@46023 = ~«В таком случае прощай».~
@46024 = ~«Подожди минутку, израненный… — Элобранда касается твоей руки. — Моя мать однажды, давным-давно, дала мне… свиток, запечатанный воском. Его ей доверил человек в капюшоне и сказал, что однажды случайно явится мужчина навроде тебя и заберёт свиток. Вот… теперь я тебе его передаю».~
@46025 = ~«Что это?»~
@46026 = ~Элобранда хмуро мотает головой: «Я не знаю. Она поклялась никогда его не читать, и я подчинилась её просьбе не ломать печать. Тот человек очень щедро заплатил ей за хранение, но предупредил о кошмарных последствиях, если она его вскроет».~
@46027 = ~«Тогда спасибо. Прощай».~
@46028 = ~Ты видишь Элобранду, предсказательницу будущего. «Я снова приветствую тебя, израненный».~
@46029 = ~«Я прочёл тот свиток. Это была ловушка».~
@46030 = ~«У меня к тебе вопросы, Элобранда…»~
@46031 = ~«Я просто проходил мимо. Прощай».~
@46032 = ~Элобранда выглядит смущённой: «Я… я и не знаю, что сказать, израненный…»~
@46033 = ~«Можешь начать с того, как именно он к тебе попал».~
@46034 = ~«Действительно, *что* тут скажешь. Прощай».~
@46035 = ~«Как я и сказала тебе, израненный… его мне дала моя мать. А ей его пятьдесят лет назад дал человек в капюшоне, он хорошо ей заплатил, но пригрозил, чтобы не вздумала его вскрывать ни при каких обстоятельствах, — Элобранда вздыхает и отводит взгляд. — Она была колдуньей и сильной в Искусстве, но всё равно испугалась этого человека. Она сказала, что его глаза — а это было всё, что она смогла разглядеть — намекали на безумие, а плоть вокруг них была морщинистой и серой… навроде твоей. Больше я ничего о нём не знаю».~
@46036 = ~«Тогда узнаю сам. Прощай».~
@46037 = ~Этот молодой мускулистый «головорез» хоть и достаточно хорошо вооружён, чтобы быть опасным, но выглядит слишком чистым для простого уличного бандита. В одной руке у него большой топор, а в другой — стальная коробка. Когда ты приближаешься, он надувается и грозно на тебя смотрит: «Ты чего пялишься, „доходяга“? „Отвали“, пока я тебя не „ушиб“!»~
@46038 = ~~
@46039 = ~~
@46040 = ~~
@46041 = ~~
@46042 = ~Он свирепо смотрит на ножи Анны, но ничего не говорит.~
@46043 = ~«Ты что-то больно холёный для бандита».~
@46044 = ~«Успокойся… у меня всего лишь пара вопросов…»~
@46045 = ~Уйти.~
@46046 = ~«А ну „шкатулку“ закрой, кожеголовый! Это *моя* территория, и ты быстро её покинешь, если не хочешь, чтобы мои „кореша“ порвали тебя на части!»~
@46047 = ~~
@46048 = ~~
@46049 = ~~
@46050 = ~~
@46051 = ~Его лицо вспыхивает от злости, он в ярости скрежещет зубами: «Ну всё… ты „охрененно“ напросился сам! Хватайте его, „кореша“!» Он поднимает свой топор и бросается в атаку!~
@46052 = ~Драться.~
@46053 = ~Бежать.~
@46054 = ~Он поднимает бровь, пожимает плечами и смотрит на коробку. «Даже не знаю, я эту „хрень“ и открыть-то никак не могу… думал, там „херова“ говорящая голова, но я её уронил и она отрубилась. Надеялся продать её в магазинчик странностей, но и Вриш она „нахрен“ не нужна. А тебе? Сотня медных, и она твоя».~
@46055 = ~«Погоди, откуда она у тебя?»~
@46056 = ~«Это ведь голова от того тела в Фестхолле, верно?»~
@46057 = ~«Конечно, беру».~
@46058 = ~«Нет, спасибо. Прощай».~
@46059 = ~На мгновение выражение лица хулигана становится каким-то робким — выглядит довольно смешно, особенно если учесть его габариты. «Я… нашёл её. В любом случае это не твоё „собачье“ дело, „пидор“! Тебе надо или нет? Сотня монет, или я эту „хрень“ себе оставлю».~
@46060 = ~«Это ведь голова от того тела в Фестхолле, верно?»~
@46061 = ~«Конечно, беру».~
@46062 = ~«Нет, спасибо. Прощай».~
@46063 = ~Он злобно на тебя смотрит и кричит, слюна брызжет изо рта при каждом слове: «Ни „хрена“ такого не знаю! Какая вообще кому разница?! Я просто нашёл эту „грёбаную“ штуку… а что я нашёл, то моё. Она по праву моя! Хочешь? *Купи*. Сотня „медяков“, „пень“».~
@46064 = ~«Конечно, беру».~
@46065 = ~«А что, если мы на неё поспорим?»~
@46066 = ~«А как насчёт того, что я изобью тебя до потери чувств и заберу её?»~
@46067 = ~«Нет, спасибо. Прощай».~
@46068 = ~«Э-э?»~
@46069 = ~«Спор. Как насчёт такого: ты возьмёшь этот топор и ударишь меня куда захочешь. Если я после этого встану, то коробка моя… иначе можешь забрать что угодно с моего тела».~
@46070 = ~«Ладно. Я просто её куплю».~
@46071 = ~«Забудь. Я просто изобью тебя и заберу её».~
@46072 = ~«Неважно. Прощай».~
@46073 = ~Он скептически смотрит на топор, потом на тебя.~
@46074 = ~«Что, беспокоишься, не являюсь ли я „бессмертным созданием“, которому твой топор не может повредить? Просто *посмотри* на меня».~
@46075 = ~«Что, беспокоишься, не являюсь ли я „бессмертным созданием“, которому твой топор не может повредить? Просто *посмотри* на меня».~
@46076 = ~«Ладно. Я просто её куплю».~
@46077 = ~«Забудь. Я просто изобью тебя и заберу её».~
@46078 = ~«Неважно. Прощай».~
@46079 = ~Бандит погружает в тебя свой топор, лезвие проходит сквозь связки и кость в одном могучем ударе… вышибая из тебя дух.~
@46080 = ~Погрузиться во тьму…~
@46081 = ~Бандит погружает в тебя свой топор, лезвие проходит сквозь связки и кость в одном могучем ударе. Ты пошатываешься, сплёвываешь кровь и, выпрямившись, усмехаешься крепкому юнцу. Он потрясённо смотрит, как ты тянешься к нему за металлической коробкой.~
@46082 = ~«Я забираю эту коробку. До тебя так и не дошло, что я „бессмертное создание“ и твой топор мне не помеха, да? Какая жалость. Прощай».~
@46083 = ~Забрать коробку и оставить его ошарашенно стоять.~
@46084 = ~Громила выхватывает твои медяки и швыряет тебе коробку. «А теперь проваливай отсюда. Никаких больше „грёбаных“ разговоров, „пень“».~
@46085 = ~«Да-да, как скажешь. Прощай».~
@46086 = ~Уйти.~
@46087 = ~Молодой бандит нагло ухмыляется при твоём приближении: «Опять ты?! „Отвали“, „пень“!»~
@46088 = ~«Ты что-то больно холёный для бандита».~
@46089 = ~«Успокойся… у меня всего лишь пара вопросов…»~
@46090 = ~Уйти.~
@46091 = ~Молодой бандит нагло ухмыляется при твоём приближении: «Тряси своей „грёбаной“ „шкатулкой“ сколько угодно, „пень“. Я с тобой больше не „базарю“».~
@46092 = ~«Как скажешь. Прощай».~
@46093 = ~Уйти.~
@46094 = ~«„Доходяга“?! Во имя девяти планов Баатора, о чём таком ты говоришь, а, кретин? Доходяги тощие, изодранные и избитые Крепкоголовыми, ты, бестолочь, придурошный пень».~
@46095 = ~Анна громко фыркает, сотрясая головой: «Потрещи ещё, говнюк мелкий. Хотела бы я глянуть, сколько ты протянешь в Улье, если будешь греметь шкатулкой в таком духе…» Анна поворачивается к тебе: «Ну его, пошли. Толку от этого сопляка никакого».~
@46096 = ~~
@46097 = ~«Ты что-то больно холёный для бандита».~
@46098 = ~«Успокойся… у меня всего лишь пара вопросов…»~
@46099 = ~Уйти.~
@46100 = ~«Мне просто интересно, что у тебя в этой коробке».~
@46101 = ~«Нет, думаю, я тут ещё побуду».~
@46102 = ~«Ладно, я ухожу. Прощай».~
@46103 = ~«Я один из тех, кто готовит для тебя эти камни».~
@46104 = ~«Подожду, пока ты начнешь действовать, интересно!»~
@46105 = ~Этот гневного вида парень — скорее всего, не головорез, а просто прикидывается. Он ухмыляется при твоём приближении: «„Отвали“, „пень“! Можешь с „крутым корешем“ поговорить, а я с тобой „базар“ закончил».~
@46106 = ~«Хм… ладно. Прощай».~
@46107 = ~Уйти.~
@46108 = ~Этот подавленный маленький человечек снуёт туда-сюда по магазинчику странностей, протирая, записывая и расставляя предметы на места. От него исходит слабый запах лука. Когда ты приближаешься, он бросает на тебя нервный взгляд: «Прошу вас, сэр… я не могу с вами разговаривать. У меня море работы, да и госпожа не позволит…»~
@46109 = ~«У меня всего пара вопросов…»~
@46110 = ~«Тогда прощай».~
@46111 = ~«Простите, сэр, но я не могу. Прошу вас, оставьте меня, прежде чем хозяйка заметит, что я разговариваю с вами…»~
@46112 = ~«Хозяйка?»~
@46113 = ~«Тогда прощай».~
@46114 = ~Человечек кивает: «Да… госпожа Вришика. Я Стэндиш, её слуга… её раб. Я совершил преступление и был приговорён к продаже в рабство, затем меня приобрели в Нижнем районе, как и прочих её рабов… большая часть которых содержится в её особняке. А теперь, прошу… умоляю, не мешайте мне! Не мешайте, или она разозлится и безжалостно изобьёт меня!»~
@46115 = ~«Хорошо… прощай, Стэндиш».~
@46116 = ~Этот невысокий, учёного вида мужчина с нервной хмурой гримасой на лице осматривает тебя с головы до ног: «Приветствую. Я Финам. Прошу вашего прощения, но у меня почти нет времени для гостей, приглашённых или *нет*, так что, если у вас ко мне нет дела, я бы попросил вас уйти».~
@46117 = ~«У меня были вопросы…»~
@46118 = ~«Тогда прощай».~
@46119 = ~Финам хмуро глядит в твою сторону: «Снова решили посетить моё скромное жилище? Что вам от меня надо на этот раз?»~
@46120 = ~«У меня кое-какие вопросы…»~
@46121 = ~«Вообще-то ничего. Прощай».~
@46122 = ~«Я бы хотел, чтобы вы знали, сэр: я учёный лингвист. И хотя я с радостью отвечу на вопросы из области моей компетенции — языки и тому подобное — но в других вопросах помочь не смогу».~
@46123 = ~Разложить додекаэдр в страницу с «письменами» на ней и спросить, может ли он перевести.~
@46124 = ~«Тогда не бери в голову. Прощай».~
@46125 = ~Он берёт развёрнутый додекаэдр и внимательно его осматривает. «Это очень старый и давно умерший язык, почти никому не известный. Я уверен, что мой отец — лингвист, как и я, — знал этот язык, и он, по всей видимости, был единственным человеком в Сигиле, который его знал. Я узнаю язык из его записей, но перевести не могу».~
@46126 = ~«А у тебя сохранились те записи?»~
@46127 = ~«Всё равно спасибо. Прощай».~
@46128 = ~Финам качает головой: «Они вам ничем не помогут, если вы собираетесь перевести это… а те несколько книг, что были у него по этому языку, полагаю, исчезли примерно в то же время, когда убили моего отца».~
@46129 = ~«Твой отец был убит?»~
@46130 = ~«Это ужасно. Прощай, Финам».~
@46131 = ~Финам кивает: «Его задушили. Ушёл на урок — он давал частные уроки, чтобы оплатить свои исследования — а обнаружили его уже мёртвым, в одной из боковых зал Фестхолла. Убийцу так и не нашли. Это было… хм… около пятидесяти лет тому назад. Я тогда был всего лишь ребёнком».~
@46132 = ~«Так значит, он знал язык и мог бы ему обучить?»~
@46133 = ~«Обидно. Прощай, Финам».~
@46134 = ~«Конечно мог бы, если был бы жив. Говорят, он был замечательным учителем, — Финам печально вздыхает. — Я обладаю познаниями в языках, но у меня нет его терпения для работы с другими».~
@46135 = ~«А он… был погребён в Мортуарии?»~
@46136 = ~«Прощай, Финам».~
@46137 = ~«Да нет… его пепел хранится здесь», — он указывает на бронзовую урну, стоящую комоде за букетом пурпурных цветов. «А почему вы спрашиваете? — кривая улыбка ползёт по губам Финама. — Вы некроскоп? Можете говорить с мёртвыми?» Неожиданно он хмурится: «Я более не желаю об этом говорить. Вы должны меня извинить, сэр… прощайте».~
@46138 = ~«Прощай, Финам».~
@46139 = ~Кажется, этот молодой актёр слишком увлечён своим представлением, чтобы прерваться на разговор с тобой. Ты обращаешь внимание, что рядом с ним лежит фетровая шляпа с несколькими медными монетами. Порой прохожие кидают ему в шляпу медячок-другой.~
@46140 = ~Бросить монету в шляпу.~
@46141 = ~Украсть деньги из шляпы, когда никто не будет смотреть.~
@46142 = ~Украсть деньги из шляпы, когда никто не будет смотреть.~
@46143 = ~Уйти.~
@46144 = ~Твоя монета приземляется в шляпу с лёгким *дзынь*. Актёр, не прекращая представления, коротко кивает тебе в знак благодарности.~
@46145 = ~Украсть деньги из шляпы, когда никто не будет смотреть.~
@46146 = ~Украсть деньги из шляпы, когда никто не будет смотреть.~
@46147 = ~Уйти.~
@46148 = ~Во время особенно захватывающей части представления ты крадёшь из шляпы актёра около дюжины монет.~
@46149 = ~Тихо уйти.~
@46150 = ~Ты пытаешься стянуть монеты, но кто-то замечает и зовёт стражу!~
@46151 = ~Сбежать.~
@46152 = ~Кажется, этот молодой актёр слишком увлечён своим представлением, чтобы прерваться на разговор с тобой.~
@46153 = ~Уйти.~
@46154 = ~«Что это у тебя за кружка?»~
@46155 = ~«У меня кое-какие вопросы…»~
@46156 = ~«Привет и прощай».~
@46157 = ~Он делает ещё один глоток эля и печально качает головой: «Не-е, не… не найдёшь… здесь ответов… нету».~
@46158 = ~«Что-то не так?»~
@46159 = ~«А что это у тебя за кружка?»~
@46160 = ~«Тогда прощай».~
@46161 = ~Он вздыхает, отрыгивает в кружку и снова прикладывается к элю. «Ага, что-то не так, точно. Я взял и бросил… свою учёбу. Испортил последний эксперимент… моего наставник-ик-ика. И всё из-за этой дурацкой… выпивки! — он с омерзением смотрит на кружку в руках, но потом его лицо смягчается и он отхлёбывает ещё раз. — Всё пропало, абсолютно всё, из-за этого пьянства…»~
@46162 = ~«А почему ты не бросишь пить?»~
@46163 = ~«Если ты слишком слаб, чтобы остановиться, то это только твоя вина. Прощай».~
@46164 = ~«Как жалко. Прощай».~
@46165 = ~Он пожимает плечами и несчастно вздыхает: «Я просто… не могу. Я бы хотел, но не могу. Мне просто… *нужна* выпивка. Я стараюсь держаться, но порой желание… слишком сильно, и я не могу сопротивляться. Вот такой… тряпкой я стал!» — он опрокидывает в глотку остатки эля и окликает, чтобы принесли ещё.~
@46166 = ~«Есть кое-кто, с кем тебе следовало бы поговорить… Неудовлетворённое-Желание. Ты найдёшь её в Фестхолле. Поговори с ней о своей любви к выпивке… и вскоре обнаружишь, что больше не хочешь пить».~
@46167 = ~«Ясно. А что у тебя за кружка такая?»~
@46168 = ~«Если ты слишком слаб, чтобы остановиться, то это только твоя вина. Прощай».~
@46169 = ~«Как жалко. Прощай».~
@46170 = ~Его глаза озаряются. «Правда? Мне надо идти… поговорю с ней прямо сейчас. Благодарю… вас, сэр, — он прерывается и смотрит в свою пустую кружку. — Вот… я хотел бы предложить вам это. Мне она больше не нужна». Он протягивает тебе покрытую рунами пивную кружку.~
@46171 = ~«Спасибо… прощай».~
@46172 = ~«Эта? — он роняет взгляд на свою оловянную кружку. — Я её в кости выиграл. Она заколдована… и всё, что в неё налито… остывает. В моём случае… дешёвый эль». Он хмурится, трёт глаза и делает большой глоток.~
@46173 = ~«Что-то не так?»~
@46174 = ~«Это всё, что я хотел узнать. Прощай».~
@46175 = ~Наверху этого шкафчика стоит урна с пеплом и обугленными кусочками костей. На основании урны выгравировано: «Фин Андли — Любимый Муж, Отец и Знаток Ста Языков».~
@46176 = ~Воспользоваться своей способностью «Разговор с мёртвыми».~
@46177 = ~Уйти.~
@46178 = ~Прах слегка колеблется, словно от твоего дыхания. Далёкий голос шепчет откуда-то из урны: «Зачем, зачем меня вызвали в этот прах, такой холодный и серый, как сердце ведьмы?»~
@46179 = ~«Чтобы получить ответы на некоторые вопросы, призрак…»~
@46180 = ~«Просто так; прощай, призрак».~
@46181 = ~«Тогда спрашивай, чтобы я смог ответить и вернуться…»~
@46182 = ~«Кем ты был?»~
@46183 = ~Описать ему надписи из додекаэдра и спросить, не знает ли он такого языка.~
@46184 = ~«Неважно. Прощай».~
@46185 = ~«Я был Фином, лингвистом и учёным. Я был убит — убит! — своим собственным учеником… убит, чтобы я не смог обучить никого другого тому языку, которому обучил его. Это был язык уйо — один из самых редких во всей мультивселенной. Я не знал никого, кто бы на нём разговаривал, кроме меня и того моего проклятого ученика…»~
@46186 = ~Описать ему надписи из додекаэдра и спросить, не знает ли он такого языка.~
@46187 = ~«Это всё, что я хотел узнать. Прощай».~
@46188 = ~«Да, я знаю этот язык. Я был лингвистом и учёным. Я был убит — убит! — своим собственным учеником… убит, чтобы я не смог обучить никого другого тому языку, которому обучил его. Это был язык уйо — один из самых редких во всей мультивселенной. Я не знал никого, кто бы на нём разговаривал, кроме меня и того моего проклятого ученика…»~
@46189 = ~«Так ты можешь помочь мне изучить этот мёртвый язык?»~
@46190 = ~«Я могу, да… вообще-то, мне будет даже приятно сделать это, хотя бы просто для того, чтобы тот ученик не остался в выигрыше. Для начала скажи, на каких языках ты *уже* говоришь…»~
@46191 = ~Обучиться всему, чему тебя может научить призрак.~
@46192 = ~~
@46193 = ~По мере того, как призрак рассказывает тебе о забытом языке уйо, у тебя возникает странное головокружение, воспоминания… воспоминания об этом языке. Ты вспоминаешь буквы, слова, фразы, пока пелена, закрывавшая в твоём разуме язык, не спадает целиком — словно ветер от Шпиля разгоняет ядовитый смог Кузницы.~
@46194 = ~Продолжать…~
@46195 = ~Впрочем, в твоей памяти всплывает и ещё одно воспоминание… тёмное воспоминание. Почему-то его присутствие как-то тебя беспокоит и наполняет необъяснимым чувством вины…~
@46196 = ~Подавить память.~
@46197 = ~Позволить всплыть воспоминанию.~
@46198 = ~Наконец ты вспоминаешь самого Фина Андли. Вспоминаешь его мягкий голос, его добродушие и то, как он учил тебя древнему языку уйо. Ещё ты вспоминаешь свою покрытую шрамами грубую руку, сжимающуюся вокруг его хилого горла, ломающую его кадык. И всё это ради того, чтобы ни одна живая душа не узнала секрета твоего дневника — таинственного, покрытого волшебными ловушками додекаэдра с записями, сделанными на языке уйо. Умоляющие глаза лингвиста навсегда врезаются в твою память…~
@46199 = ~«Фин… должен тебе сказать… твоим убийцей был я».~
@46200 = ~«Думаю, что я понял достаточно. Спасибо, Фин, и прощай».~
@46201 = ~Какое-то время он молчит, слышен только тихий шелест пепла в урне. Когда дух заговаривает снова, его голос полон печали: «Но… почему… и зачем ты пришёл ко мне снова? Неужели *забыл* то, чему тебя научили?»~
@46202 = ~«Нет… то есть да. Это сложно объяснить, но, должно быть, тебя убило моё прежнее „я“. После каждой смерти я пробуждаюсь, словно после долгого сна… и забываю всё… кем я был и что делал…»~
@46203 = ~«Думаю, что понимаю… я чувствую твоё сожаление и прощаю тебя. Да пребудет с тобой мир, давний ученик, и будь в этой жизни добрее чем в той, в которой закончилась моя…»~
@46204 = ~«Спасибо, Фин. Прощай».~
@46205 = ~Похоже, дух несколько озадачен твоим несомненным знанием языка уйо: «Ты явно уже владеешь некоторыми основами языка, ученик…»~
@46206 = ~«Да… думаю, теперь я достаточно знаю язык. Спасибо, Фин, и прощай».~
@46207 = ~Убрать его.~
@46208 = ~При ближайшем рассмотрении ты понимаешь, что каждая сторона додекаэдра — пластина, которую можно поворачивать по и против часовой стрелки… похоже на головоломку или кодовый замок. Поскольку у каждой пятиугольной пластины пять возможных положений, то у додекаэдра не менее двухсот сорока четырёх миллионов ста сорока тысяч шестисот двадцати пяти «состояний». Попытка опробовать все комбинации займёт каждую секунду следующих семидесяти семи с лишним лет, но кроме того, тебе *может* просто повезти и ты найдёшь решение за считанные минуты…~
@46209 = ~Немного повертеть его.~
@46210 = ~Просто отложить.~
@46211 = ~По мере методичного вращения холодных серых граней додекаэдра ты чувствуешь странное ощущение у основания черепа. Руки начинают двигаться сами, выстраивая грани в каком-то одним им ведомом порядке. Ты это уже определённо делал… когда-то знал комбинацию… и, разумеется, ты вспоминаешь об *опасности*, заключённой в этом предмете. Однако простые ли это ловушки или что-то менее очевидное — ты вспомнить не можешь.~
@46212 = ~Продолжить работать с додекаэдром.~
@46213 = ~Продолжить работать с додекаэдром.~
@46214 = ~Продолжить работать с додекаэдром.~
@46215 = ~Ты быстро устанавливаешь первые четыре стороны в правильные позиции. Как только касаешься пятой, ты вспоминаешь о ловушке с выпрыгивающими лезвиями, которые ранят запястья и могут отхватить пальцы незадачливому взломщику. Ловушки получается избежать несколькими правильными поворотами. Ты определённо делаешь успехи в распутывании загадки предмета.~
@46216 = ~Продолжить работать с додекаэдром.~
@46217 = ~Продолжить работать с додекаэдром.~
@46218 = ~Продолжить работать с додекаэдром.~
@46219 = ~Отложить додекаэдр.~
@46220 = ~Избежав выпрыгивающих лезвий, ты медленно начинаешь вспоминать следующую серию поворотов. Приступая к девятой грани, ты вспоминаешь, что за ней таится вторая ловушка, она выпускает струи ядовитого газа, облаком едких испарений окутывающие любопытного воришку. Миновав ловушку с помощью нескольких аккуратных поворотов, ты понимаешь, что близок к открытию додекаэдра.~
@46221 = ~Продолжить работать с додекаэдром.~
@46222 = ~Продолжить работать с додекаэдром.~
@46223 = ~Продолжить работать с додекаэдром.~
@46224 = ~Отложить додекаэдр.~
@46225 = ~Избежав ловушки с ядовитым газом, ты начинаешь последнюю серию поворотов и уже собираешься поставить на место двенадцатый пятиугольник, когда замечаешь, что складывающиеся руны образуют заклинание, которое должно поразить несведущего любителя головоломок молнией. С помощью серии правильных поворотов ты обходишь ловушку, и внезапно додекаэдр в твоих руках с лёгким *щелчком* раскрывается…~
@46226 = ~Кажется, первые четыре стороны быстро оказываются в правильных позициях. Ты начинаешь поворачивать пятую, как вдруг скрытые между подвижными гранями острые, как бритва, лезвия впиваются тебе в запястья и чуть не отрезают несколько пальцев. Скрипя зубами от боли, ты тянешься за упавшим додекаэдром… и внезапно вспоминаешь, как можно было избежать этой примитивной ловушки.~
@46227 = ~Продолжить работать с додекаэдром.~
@46228 = ~Продолжить работать с додекаэдром.~
@46229 = ~Отложить додекаэдр.~
@46230 = ~Кажется, первые четыре стороны быстро оказываются в правильных позициях. Ты начинаешь поворачивать пятую, как вдруг скрытые между подвижными гранями острые, как бритва, лезвия впиваются тебе в запястья и отрезают несколько пальцев. Роняя окровавленный додекаэдр, ты сползаешь на землю от страшной боли и чувствуешь, как жизнь покидает тебя через обрубки пальцев… и вдруг вспоминаешь, как просто было обойти эту ловушку.~
@46231 = ~Погрузиться во тьму…~
@46232 = ~Избежав выпрыгивающих лезвий, ты медленно начинаешь вспоминать следующую серию поворотов. Как только ты поворачиваешь девятую грань, тебе в лицо бьют струи ядовитого газа, образуя облако едких испарений. Полуослепший, теряющий ориентацию и сотрясаемый мучительной рвотой, ты слишком поздно вспоминаешь, как можно было обойти эту ловушку.~
@46233 = ~Продолжить работать с додекаэдром.~
@46234 = ~Продолжить работать с додекаэдром.~
@46235 = ~Отложить додекаэдр.~
@46236 = ~Избежав выпрыгивающих лезвий, ты медленно начинаешь вспоминать следующую серию поворотов. Как только ты поворачиваешь девятую грань, тебе в лицо бьют струи ядовитого газа, образуя облако едких испарений. Сперва ты покачиваешься, полуослепший, теряющий ориентацию и сотрясаемый мучительной рвотой, и вдруг вспоминаешь, как можно было избежать ловушки. Затем падаешь бесформенной массой, скорчившись в агонии, последним усилием прижимая додекаэдр к своей груди в шрамах…~
@46237 = ~Избежав ловушки с ядовитым газом, ты начинаешь последнюю серию поворотов. Как только последний пятиугольник встаёт на место, скрытые внутри додекаэдра колдовские руны высвобождают небольшую бурю с магическими молниями. Дуги синих потрескивающих разрядов ползут вверх по твоим рукам, оставляя за собой дорожки чёрной сожжённой плоти.

Когда спазм мускулов проходит и ты собираешься подняться, в памяти вдруг всплывает, как можно было обойти эту ловушку. Ты производишь серию правильных поворотов, и с лёгким *щелчком* додекаэдр у тебя в руках раскрывается.~
@46238 = ~Избежав ловушки с ядовитым газом, ты начинаешь последнюю серию поворотов. Как только последний пятиугольник встаёт на место, скрытые внутри додекаэдра колдовские руны высвобождают небольшую бурю с магическими молниями. Дуги синих потрескивающих разрядов ползут вверх по твоим рукам, оставляя за собой дорожки чёрной сожжённой плоти. Падая в судорогах на землю, ты осознаёшь гениальную простоту обхода ловушки, но полученные повреждения несовместимы с жизнью — ты умираешь от болевого шока и обширного поражения нервной системы…~
@46239 = ~Додекаэдр раскрывается раз, другой и внезапно неведомым образом преобразуется в правильный прямоугольный брусок размером с большую книгу. На его поверхности выгравированы ряды причудливых символов. Шифр или язык кажутся знакомыми… но нет. Исследуя брусок дальше, ты обнаруживаешь, что поворот граней, оказавшихся наверху, открывает доступ к другим «страницам». Ты наконец понимаешь, что додекаэдр — нечто вроде книги или дневника.~
@46240 = ~«Хм-м… лучше его спрятать, пока я не научусь читать на этом языке».~
@46241 = ~Ты поднимаешь холодный серый додекаэдр, чтобы хорошенько его осмотреть, не забывая о выпрыгивающих лезвиях, поджидающих неосторожного исследователя.~
@46242 = ~Ещё поработать с додекаэдром.~
@46243 = ~Ещё поработать с додекаэдром.~
@46244 = ~Ещё поработать с додекаэдром.~
@46245 = ~Отложить додекаэдр.~
@46246 = ~Ты поднимаешь холодный серый додекаэдр, чтобы хорошенько его осмотреть, не забывая о том, как обойти ловушки с выпрыгивающими лезвиями и ядовитым газом, поджидающие неосторожного исследователя.~
@46247 = ~Ещё поработать с додекаэдром.~
@46248 = ~Ещё поработать с додекаэдром.~
@46249 = ~Ещё поработать с додекаэдром.~
@46250 = ~Отложить додекаэдр.~
@46251 = ~Ты поднимаешь холодный серый додекаэдр, чтобы хорошенько его осмотреть, не забывая о том, как обойти его различные смертельные ловушки, поджидающие неосторожного исследователя.~
@46252 = ~Раскрыть его.~
@46253 = ~Отложить додекаэдр.~
@46254 = ~Ты поднимаешь холодный серый додекаэдр, чтобы хорошенько его изучить, не забывая о том, как обойти его различные смертельные ловушки, поджидающие неосторожного исследователя. Зная мёртвый язык уйо, ты наконец можешь прочитать его содержимое…~
@46255 = ~Раскрыть и прочитать додекаэдр.~
@46256 = ~Отложить додекаэдр.~
@46257 = ~Такое ощущение, что это дневник, который вела… одна из твоих предыдущих инкарнаций, к тому же не совсем здравомыслящая. Здесь совсем немного связных кусков.~
@46258 = ~Пролистать дневник.~
@46259 = ~Убрать дневник.~
@46260 = ~Ты поднимаешь холодный серый додекаэдр — зашифрованный и защищённый тремя ловушками твоей предыдущей инкарнацией.~
@46261 = ~Открыть дневник и прочитать.~
@46262 = ~Убрать дневник.~
@46263 = ~О чём ты хочешь прочитать?~
@46264 = ~Прочитать о «шепчущих тенях».~
@46265 = ~Прочитать о девушке-призраке.~
@46266 = ~Прочитать о том, как спрятать что-либо в собственном теле.~
@46267 = ~Прочитать какие-то параноидальные тирады.~
@46268 = ~Прочитать о «проклятых» татуировках.~
@46269 = ~Прочитать о снах и Рейвел.~
@46270 = ~Прочитать об опасности имён.~
@46271 = ~Прочитать об убийстве в Фестхолле.~
@46272 = ~Прочитать об убийстве того, кто пытался тебе помочь.~
@46273 = ~Прочитать таинственный ответ неизвестных голов.~
@46274 = ~Прочитать кое-что о наследстве.~
@46275 = ~«Шёпот не от того, что тени ДВИЖУТСЯ. Они ГОВОРЯТ-СГОВАРИВАЮТСЯ-ПЕРЕГОВАРИВАЮТСЯ друг с другом. Я понимаю кое-что из их разговоров».~
@46276 = ~Прочитать что-нибудь ещё.~
@46277 = ~Убрать дневник.~
@46278 = ~«Книга говорит мне, шепчет разное. Она говорит мне: избегай девушку-призрака, избегай её. Я НЕ ЗНАЮ ЕЁ, а она меня МУЧАЕТ!»~
@46279 = ~Прочитать что-нибудь ещё.~
@46280 = ~Убрать дневник.~
@46281 = ~«И вот я ПРОГЛОТИЛ это, надеясь, что оно ЗАСТРЯНЕТ в моих КИШКАХ. Когда мне будет нужно, кто-нибудь поможет мне ВЫТАЩИТЬ его».~
@46282 = ~Прочитать что-нибудь ещё.~
@46283 = ~«Я узнал, что МОЯ ЖИЗНЬ МНЕ НЕ ПРИНАДЛЕЖИТ. Я НЕ позволю тебе завладеть моей жизнью…»

«ТЫ получишь мою жизнь только через мой ТРУП…»

«Это ТЫ УМРЁШЬ. Если она не достанется МНЕ, то не достанется и НИКОМУ!»

«ТЫ В ОТВЕТЕ ЗА ПРЕДАТЕЛЬСТВО ПЛОТИ. Я НЕ ДОПУЩУ, ЧТОБЫ ТЫ ПРОЖИЛ МОЮ ЖИЗНЬ!»~
@46284 = ~Убрать дневник.~
@46285 = ~Прочитать что-нибудь ещё.~
@46286 = ~Убрать дневник.~
@46287 = ~«Проклятые ТАТУИРОВКИ не сходят с моей КОЖИ! Я пытался выжечь их огнём — НЕУДАЧНО, неудачно! Я пытаюсь ПРИКРЫТЬ себя, но всё время чувствую, что люди ЧИТАЮТ мою ПЛОТЬ, читают меня как КНИГУ! Когда они СМОТРЯТ на меня, Я ХОЧУ ВЫРВАТЬ ИМ ГЛАЗА, выдернуть их из глазниц и РАЗДАВИТЬ ПЯТКОЙ…»~
@46288 = ~Прочитать что-нибудь ещё.~
@46289 = ~Убрать дневник.~
@46290 = ~«ПОЧЕМУ МНЕ НЕ СНЯТСЯ СНЫ?!»

«Я использовал кубок Семира, чтобы вызвать СОН НАЯВУ. И увидел ВЕДЬМУ. Она ИСКУШАЛА меня, УГРОЖАЛА мне ТЕНЯМИ! Я никогда не ВИДЕЛ её, а она пришла во СНЕ. НЕ ХОЧУ больше видеть сны. Я всегда должен быть НАЧЕКУ. Я РАЗБИЛ КУБОК».

«Она говорит, что она из МОГУЩЕСТВЕННЫХ, что ПОДЧИНИТ меня, НАЙДЁТ МЕНЯ. Убирайся, ВЕДЬМА! Держись от меня ПОДАЛЬШЕ! Оставь меня в ПОКОЕ! Я не хочу иметь с тобой НИЧЕГО общего!»~
@46291 = ~Продолжить чтение этой части дневника.~
@46292 = ~Прочитать что-нибудь ещё.~
@46293 = ~Убрать дневник.~
@46294 = ~«Бойся ИМЁН. ИМЕНА имеют власть над личностью. ИМЕНА могут использоваться ДРУГИМИ как ОРУЖИЕ. Это ЛОВУШКА, с помощью которой за тобой СЛЕДЯТ-ИЩУТ-ОХОТЯТСЯ сквозь планы. Оставайся БЕЗЫМЯННЫМ и будешь в БЕЗОПАСНОСТИ».~
@46295 = ~Прочитать что-нибудь ещё.~
@46296 = ~Убрать дневник.~
@46297 = ~«Я пошёл в Фестхолл искать в его залах следы своего ЛОЖНОГО Я. Так БРОСАЛОСЬ В ГЛАЗА, что те, кого я не ЗНАЛ, ФАЛЬШИВКИ, ПРИГЛАСИЛИ меня к себе, обращались со мной как с ДРУГОМ, показали МОЮ КОМНАТУ, спрашивали, в чём я НУЖДАЮСЬ. Пришлось сдерживать себя, чтобы не броситься на них. Это было бы преждевременно. В первую очередь мне нужно было ЗАЩИТИТЬ свою ЛИЧНОСТЬ. Я нашёл того, кто знал редкий язык уйо, обучился у него всему, а затем УБИЛ его. Потом пошёл в сенсориум и приготовился ЗАКОНЧИТЬ дело. Скоро, скоро…»~
@46298 = ~Прочитать что-нибудь ещё.~
@46299 = ~Убрать дневник.~
@46300 = ~«Он НИЧЕГО не смог сделать. Воспоминания УШЛИ, сказал он, и НИКОГДА не вернутся. Он говорит/лжёт и настаивает на своей лжи! ЛЖИ! Он говорит, что с каждой смертью моё сознание СЛАБЕЕТ! ЛОЖЬ! Он сидел тут, ТЕРЯЯ моё ДОВЕРИЕ с каждой минутой.

Он сказал, что всего лишь через ЕЩЁ ТРИ СМЕРТИ, ЕЩЁ ТРИ ЖИЗНИ я обрету потерянную память, но что я — Я САМ — УМРУ после смерти. УМРУ! Как бессмертный может УМЕРЕТЬ?! Он не смог ответить — значит, он БЕСПОЛЕЗЕН. Я ЗАРЕЗАЛ его, чтобы ни одна инкарнация больше не смогла воспользоваться его БЕСПОЛЕЗНОСТЬЮ».~
@46301 = ~«И ОТВРАТИТЕЛЬНЫЕ ГОЛОВЫ сказали:

„ТЫ был РАЗДЕЛЁН. ТЫ — ОДИН из МНОГИХ. (Один, состоящий из МНОГИХ?) Ты носишь много ИМЁН, каждое оставило шрамы на твоём теле…“»~
@46302 = ~Прочитать что-нибудь ещё.~
@46303 = ~Убрать дневник.~
@46304 = ~Продолжить чтение этой части дневника.~
@46305 = ~Прочитать что-нибудь ещё.~
@46306 = ~Убрать дневник.~
@46307 = ~«ПОТЕРЯВШИЙСЯ
БЕССМЕРТНЫЙ
КОНЕЦ ИНКАРНАЦИЙ
ЧЕЛОВЕК ТЫСЯЧИ СМЕРТЕЙ
ПРИГОВОРЁННЫЙ К ЖИЗНИ
НЕУПОКОЕННЫЙ
ОДИН ИЗ МНОГИХ
ПЛЕНЁННЫЙ ЖИЗНЬЮ
ВЛЕКУЩИЙ ТЕНЕЙ
ИЗРАНЕННЫЙ
ПРИНОСЯЩИЙ СТРАДАНИЯ
ЙЕМЕТ»~
@46308 = ~Продолжить чтение этой части дневника.~
@46309 = ~Прочитать что-нибудь ещё.~
@46310 = ~Убрать дневник.~
@46311 = ~«ТЫ — РАЗБИТОЕ зеркало, чьи осколки разбросаны по всей истории».

«ТОЛЬКО ОДИН ОСКОЛОК важен. Обрети его, и твоя ЖИЗНЬ снова станет твоей. Заплатив назначенную цену, ты получишь шанс. Иначе ты ОБРЕЧЁН…»~
@46312 = ~Продолжить чтение этой части дневника.~
@46313 = ~Прочитать что-нибудь ещё.~
@46314 = ~Убрать дневник.~
@46315 = ~«ТЫ ПОТЕРЯЛ ТО, ЧТО НИКОГДА НЕ ДОЛЖНО БЫТЬ ОТДЕЛЕНО ОТ ЧЕЛОВЕКА. ТВОЯ СМЕРТНОСТЬ ПОКИНУЛА ТЕБЯ. ПОТЕРЯНА. ОНА СУЩЕСТВУЕТ, НО ТЫ ДОЛЖЕН НАЙТИ ЕЁ, ПОКА НЕ ПОТЕРЯЛ И РАЗУМ».~
@46316 = ~Прочитать что-нибудь ещё.~
@46317 = ~Убрать дневник.~
@46318 = ~«Её голос отдавал злыми КОГТЯМИ, ПАУЧЬИМИ когтями, которые ВГРЫЗАЛИСЬ в мой мозг, и мне было нужно, чтобы она ПОКИНУЛА мой РАЗУМ. ПРОЧЬ! ПРОЧЬ, ведьма!»

«Она была МИФОМ, СКАЗКОЙ, которая в одиночку БРОСИЛА ВЫЗОВ ГОСПОЖЕ БОЛИ! Как можно БОРОТЬСЯ с МИФОМ? У меня нет ОРУЖИЯ. Мне нужно оружие, чтобы УБИТЬ её, когда она НАЙДЁТ МЕНЯ. Мне нужна СТРАТЕГИЯ для победы, когда она ПРИДЁТ ЗА МНОЙ. Я должен ПЛАНИРОВАТЬ и ДУМАТЬ — тогда я смогу ПОБЕДИТЬ её».~
@46319 = ~Прочитать что-нибудь другое.~
@46320 = ~Убрать дневник.~
@46321 = ~Погрузиться во тьму…~
@46322 = ~Когда ты подходишь, лицо его перекашивает от волнения: «Спасиб, хоть один остановился. Мине звать Мар, и я тя прошу об услуге».~
@46323 = ~«Я слушаю».~
@46324 = ~«Прощай».~
@46325 = ~«Короче, позарез надо! Эту вот коробку надо доставить, а то мине точно башку оторвут! А я, как назло, сильно ногу подвернул. Ты б не занёс, а?»~
@46326 = ~«Я доставлю для тебя коробку».~
@46327 = ~«Нет».~
@46328 = ~Мар медленно достаёт из укромного местечка в своих лохмотьях маленькую коробочку. На краткий миг тень сожаления мелькает на его лице… потом исчезает, и он смотрит на тебя, протягивая коробку. В момент, когда вы оба касаетесь коробки, её окружает лёгкое мерцание. Слышен вздох облегчения, когда Мар препоручает её твоим заботам.~
@46329 = ~«Что теперь?»~
@46330 = ~«Надо доставить это Ку'атраа. Обычно он торчит где-то в юго-восточной части Улья. А, и не говори потом, что я тя не предупреждал: короче, НЕ ВЗДУМАЙ ЕЁ ОТКРЫВАТЬ! И не вздумай умотать с ней из Улья. Ну, давай!»~
@46331 = ~«Я вернусь, когда доставлю коробку. Прощай».~
@46332 = ~Когда ты прерываешь беседу, эта особа поворачивается и учтиво кивает: «Простите, любезный, но вы не дали мне закончить мысль. Если не возражаете… прощайте». Беседующие отвешивают тебе вежливый полупоклон и возвращаются к своим делам.~
@46333 = ~Уйти.~
@46334 = ~Джарим~
@46335 = ~Джарим~
@46336 = ~Мягкий голос этого мужчины дополняет его спокойное и изысканное поведение: «Приветствую. Полагаю, вы пришли воспользоваться одним из камней чувств?»~
@46337 = ~«Да».~
@46338 = ~Записка Гильтспура~
@46339 = ~Рекламная листовка Гильтспура~
@46340 = ~Зеркало с клыками~
@46341 = ~Порванная записка от Фарода~
@46342 = ~Татуировка предателя~
@46343 = ~Татуировка спасителя~
@46344 = ~Татуировка сказочника~
@46345 = ~Татуировка пожирающего вредителей~
@46346 = ~Татуировка чувства~
@46347 = ~Татуировка Чующего~
@46348 = ~Татуировка мошенника~
@46349 = ~Рекламка Гильтспура~
@46350 = ~РЕКЛАМНАЯ ЛИСТОВКА ГИЛЬТСПУРА
Вес: 1

Эту рекламную листовку Гильтспур попросил доставить Баркису в бар «Горящий труп». Она одна из тех, которые для него напечатал Пенн. Гильтспур, должно быть, сильно нуждается в посыльных, раз обещал заплатить за это двести монет.~
@46351 = ~ЗЕРКАЛО С КЛЫКАМИ
Вес: 1

Эта маленькая пудреница из посеребрённого стекла с расходящимися от краёв широкими клыками. Выглядит весьма ценной… вот только ты не отражаешься в её зеркальце.~
@46352 = ~ПОРВАННАЯ ЗАПИСКА ОТ ФАРОДА
Вес: 0

Эта записка с разодранными краями получена от Фарода. В ней содержится следующий текст:

— Бойся ТЕНей
— Бойся мест, где ночь ЖИВёт
— Они ждут
— Там не Природная Темнота
— Только теНИ~
@46353 = ~ТАТУИРОВКА ПРЕДАТЕЛЯ
Особенности:
   Сила: +1
   Интеллект: +1
Вес: 0

Эта татуировка описывает поражение Триаса Предателя, и то, как ты нанёс смертельный удар порочному дэву. Она олицетворяет собой силу, понадобившуюся для победы над дэвом, и тонкость ума, необходимую для того, чтобы перехитрить его.~
@46354 = ~ТАТУИРОВКА СПАСИТЕЛЯ
Особенности:
   Мудрость: +2
   Харизма: +1
   Удача: +1
Вес: 0

Эта татуировка рассказывает о спасении Триаса Предателя: о том, как ты отговорил его от пути зла и склонил к мольбе о прощении. Она отражает твою мудрость, умение убеждать и несёт на себе благословение Триаса.~
@46355 = ~ТАТУИРОВКА СКАЗОЧНИКА
Особенности:
   Харизма: +1
   Знание легенд: +5
Вес: 0

Услышав однажды истории Ивес, ты можешь использовать эту татуировку, чтобы черпать из неё некоторые знания и опыт. Татуировка не только помогает узнать кое-что о найденных неопознанных предметах, но и делает тебя более интересным для других, будто бы они каким-то образом уже ЗНАЮТ о множестве историй, которыми ты можешь поделиться.~
@46356 = ~ТАТУИРОВКА ЧУВСТВА
Особенности:
   Урон от всех видов атак: +1
   Урон от всех физических атак: +5%
THAC0: +1
Вес: 0
Доступно: Чующим

Эта татуировка усиливает чувства; как следствие, носитель может использовать свои усиленные ощущения для обнаружения уязвимых мест противника и нанесения ему больших повреждений. К сожалению, татуировка также увеличивает болевую чувствительность владельца, так что он получает больше повреждений от физических атак.~
@46357 = ~РЕКЛАМКА ГИЛЬТСПУРА
Вес: 1

Это образец рекламы, который Гильтспур попросил тебя доставить Своевольному Пенну для тиражирования. Самая обыкновенная реклама аукционной деятельности Гильтспура:

«ЭЙ, ВЫ ВСЕ! БЕГОМ НА АУКЦИОН ГИЛЬТСПУРА!»

И тому подобное. Текста немного, но вся его личность видна как на ладони.~
@46358 = ~~
@46359 = ~«Да».~
@46360 = ~«Нет, но у меня были вопросы…»~
@46361 = ~«Нет. Прощай».~
@46362 = ~Мужчина кивает: «Это общественный сенсориум, в комнатах которого находятся записыватели или камни чувств. Каждый камень содержит переживание — или ряд переживаний, — которое вы можете пережить как своё. Это бесплатно для Чующего в свободное время, тогда как посетители должны немного заплатить. Вы удовлетворены ответом?»~
@46363 = ~«Почти. Я бы хотел прямо сейчас воспользоваться одним из камней».~
@46364 = ~«Почти. Я бы хотел прямо сейчас воспользоваться одним из камней».~
@46365 = ~«Нет…»~
@46366 = ~«Вполне. Прощай».~
@46367 = ~«Тогда я ничем не могу вам помочь. Если, конечно, вы не хотите воспользоваться одним из наших камней…»~
@46368 = ~«Да, хочу».~
@46369 = ~«Да, хочу».~
@46370 = ~«Нет, спасибо. Прощай».~
@46371 = ~Мужчина улыбается и рассказывает тебе о некоторых переживаниях из числа многих доступных в настоящее время.

«Интересует что-нибудь из этих?»~
@46372 = ~«Интересует „неизбежная боль“».~
@46373 = ~«Интересует „нежная любовь“».~
@46374 = ~«Интересует „тоска зелёная“».~
@46375 = ~«Интересует „чудо из чудес“».~
@46376 = ~«Интересует „жгучее нетерпение“».~
@46377 = ~«Интересует „руки опускаются“».~
@46378 = ~«Интересует „сверхъестественная страсть“».~
@46379 = ~«А ещё что-нибудь есть?»~
@46380 = ~«Не сейчас. Прощай».~
@46381 = ~Мужчина кивает и описывает ещё несколько доступных переживаний.

«Интересует что-нибудь из этих?»~
@46382 = ~«Интересует „психоз“».~
@46383 = ~«Интересует „мучительная ревность“».~
@46384 = ~«Интересует „лютая ненависть“».~
@46385 = ~«Интересует „чистая радость“».~
@46386 = ~«Интересует „пьянящий страх“».~
@46387 = ~«Интересует „беспощадное уничтожение“».~
@46388 = ~«Интересует „сплошное расстройство“».~
@46389 = ~«Нельзя ли поподробнее о предыдущих?»~
@46390 = ~«А ещё?»~
@46391 = ~«Не сейчас. Прощай».~
@46392 = ~Мужчина с улыбкой кивает и расписывает тебе остаток доступных переживаний.

«Интересует что-нибудь из этих?»~
@46393 = ~«Интересует „безумное сожаление“».~
@46394 = ~«Интересует „потрясение и закипающая жажда мести“».~
@46395 = ~«Интересует „медленно надвигающийся ужас“».~
@46396 = ~«Интересует „неописуемое разочарование“».~
@46397 = ~«Интересует „невероятно важный секрет“».~
@46398 = ~«Интересует „ликантропия“».~
@46399 = ~«О каких переживаниях ты говорил перед этим?»~
@46400 = ~«Не сейчас. Прощай».~
@46401 = ~«Здесь больше дюжины стандартных переживаний и шесть более… экстравагантных. Пользование стандартным камнем стоит десять медяков, необычные — по пятьдесят. Хотите узнать о стандартных или экстравагантных переживаниях?»~
@46402 = ~«Расскажи о стандартных…»~
@46403 = ~«Расскажи об экстравагантных…»~
@46404 = ~«Нет, спасибо. Прощай».~
@46405 = ~Мужчина улыбается и рассказывает тебе о некоторых переживаниях из числа многих доступных в настоящее время.

«Интересует что-нибудь из этих?»~
@46406 = ~«Интересует „неизбежная боль“».~
@46407 = ~«Интересует „нежная любовь“».~
@46408 = ~«Интересует „тоска зелёная“».~
@46409 = ~«Интересует „чудо из чудес“».~
@46410 = ~«Интересует „жгучее нетерпение“».~
@46411 = ~«Интересует „руки опускаются“».~
@46412 = ~«Интересует „сверхъестественная страсть“».~
@46413 = ~«Расскажи о других…»~
@46414 = ~«Постой, а что за экстравагантные?»~
@46415 = ~«Не сейчас. Прощай».~
@46416 = ~Мужчина кивает и описывает ещё несколько доступных переживаний.

«Интересует что-нибудь из этих?»~
@46417 = ~«Интересует „психоз“».~
@46418 = ~«Интересует „мучительная ревность“».~
@46419 = ~«Интересует „лютая ненависть“».~
@46420 = ~«Интересует „чистая радость“».~
@46421 = ~«Интересует „пьянящий страх“».~
@46422 = ~«Интересует „беспощадное уничтожение“».~
@46423 = ~«Интересует „сплошное расстройство“».~
@46424 = ~«Стой… опиши ещё раз предыдущие…»~
@46425 = ~«Можешь рассказать о чём-нибудь действительно экстравагантном?»~
@46426 = ~«Не сейчас. Прощай».~
@46427 = ~Мужчина кивает, улыбается и описывает более изысканные переживания.

«Интересует что-нибудь из этих?»~
@46428 = ~«Интересует „безумное сожаление“».~
@46429 = ~«Интересует „потрясение и закипающая жажда мести“».~
@46430 = ~«Интересует „медленно надвигающийся ужас“».~
@46431 = ~«Интересует „неописуемое разочарование“».~
@46432 = ~«Интересует „невероятно важный секрет“».~
@46433 = ~«Интересует „ликантропия“».~
@46434 = ~«А о стандартных не расскажешь?»~
@46435 = ~«Не сейчас. Прощай».~
@46436 = ~«Прекрасный выбор. Этот камень находится в одной из больших комнат, третьей против часовой стрелки от лестницы. Он оранжево-красный».~
@46437 = ~«Спасибо. Прощай».~
@46438 = ~«Замечательно. Этот камень находится в одной из больших комнат, второй против часовой стрелки от лестницы. Он фиолетового цвета».~
@46439 = ~«Спасибо. Прощай».~
@46440 = ~«Чудесно. Этот камень находится в одной из больших комнат, первой против часовой стрелки от лестницы. Он пурпурно-синего цвета».~
@46441 = ~«Спасибо. Прощай».~
@46442 = ~«Хорошо. Этот камень находится в одной из маленьких комнат, первой по часовой стрелке от лестницы. Он жёлто-зелёного цвета».~
@46443 = ~«Спасибо. Прощай».~
@46444 = ~«Хороший выбор. Этот камень находится в одной из маленьких комнат, второй по часовой стрелке от лестницы. Он голубого цвета».~
@46445 = ~«Спасибо. Прощай».~
@46446 = ~«Хороший выбор. Этот камень находится в одной из маленьких комнат, третьей по часовой стрелке от лестницы. Он фиолетового цвета».~
@46447 = ~«Спасибо. Прощай».~
@46448 = ~«Хороший выбор. Этот камень находится в одной из маленьких комнат, четвёртой по часовой стрелке от лестницы. Он жёлто-зелёного цвета».~
@46449 = ~«Спасибо. Прощай».~
@46450 = ~«Хороший выбор. Этот камень находится в одной из маленьких комнат, пятой по часовой стрелке от лестницы. Он оранжево-красного цвета».~
@46451 = ~«Спасибо. Прощай».~
@46452 = ~«Хороший выбор. Этот камень находится в одной из маленьких комнат, шестой по часовой стрелке от лестницы. Он фиолетового цвета».~
@46453 = ~«Спасибо. Прощай».~
@46454 = ~«Хороший выбор. Этот камень находится в одной из маленьких комнат, седьмой по часовой стрелке от лестницы. Он голубого цвета».~
@46455 = ~«Спасибо. Прощай».~
@46456 = ~«Надеюсь, переживание вам понравилось? Могу я ещё что-нибудь для вас сделать?»~
@46457 = ~«Я бы хотел попробовать что-нибудь ещё».~
@46458 = ~«Я бы хотел попробовать что-нибудь ещё».~
@46459 = ~«У меня кое-какие вопросы…»~
@46460 = ~«Ничего. Прощай».~
@46461 = ~«А мине больше не волнует. Коробка к те магически прилипла до тех пор, пока не доставишь. Я б те советовал доставить её кому-нибудь! И не подходи к мине больше с этой штукой!»~
@46462 = ~Похоже, придётся разбираться самому. Не упоминал ли Ку'атраа, кому ещё можно её отдать?~
@46463 = ~Что же в этой грёбаной коробке…~
@46464 = ~Мар в ужасе отскакивает: «Нет! Ни в жись к этой проклятой коробке не прикоснусь! Убери её от мине! Сам её взял. Вот и таскайся с ней или отдай кому, мине не колышет. Я те так скажу: скорей я сдохну, чем с ней опять встряну! Иди отсюда!»~
@46465 = ~«Ничего-ничего, вот избавлюсь от коробки, поговорим. Прощай».~
@46466 = ~«Не о чём мине с тобой говорить».~
@46467 = ~«Прощай».~
@46468 = ~«Твои слова мине аж душу греют. Прежде чем убивать мине за то, что втравил тя в эту фигню, позволь мине объяснить…»~
@46469 = ~«Ты труп, приятель».~
@46470 = ~«Я слушаю. Объясняйся».~
@46471 = ~«Короче говоря, фигня в том, что эта коробка тут болталась спокон веку. Байка такова, что тут какая-то братва рубилась, а когда закончили, в коробке оказался заключён немеряный демон. Другие трепали, её сотворил злобный маг — чтоб люди помучались. В общем, никто точно не знает, откуда она взялась. Но хозяин коробки помрёт, если её откроют».~
@46472 = ~«Почему бы хозяину просто не засунуть её куда подальше, чтобы никто не нашёл?»~
@46473 = ~«И слушать эту ерунду не хочу. Мне-то что с того?»~
@46474 = ~«Ага, вроде бы просто, да хрена там. Как жить, если задницу в любой момент поджарить могут? Кто угодно свихнётся — всё время следить, где эта долбаная коробка».~
@46475 = ~«А я при чём?»~
@46476 = ~«Во-первых, я тя тут раньше не видел. Типа, мине был нужен бестолковый пень вроде тя, который бы *принял* коробку и стал новым хозяином. Здесь-то я никому б её не всучил ни за какие деньги. Во-вторых, если б ты на неё как следует посмотрел, заметил бы, что магия на ней слабеет. Как хозяину, мине надо было избавиться от неё побыстрее. Кроме того, если кто-то мог её унести отсюда в другой мир, так это ты».~
@46477 = ~«Хочешь поговорить о переходе в другой мир? По делу продолжай, или на своей шкуре узнаешь, каково там».~
@46478 = ~«Я явно выбрал здоровяка из неробкого десятка. Наверняка это не причинило такому, как ты, серьёзных неудобств. Позволь предложить те это оружие и немного медяков за хлопоты. Всё, что у мине есть… и так уж совпало, всё, что дала мине эта крыса Ку'атраа, чтоб я забрал у него коробку».~
@46479 = ~ «Если я убью тебя, то получу то же самое».~
@46480 = ~«Давай и проваливай».~
@46481 = ~«Народ тута будет крепче спать, раз ты уничтожил эту проклятую коробку. Спасиб ещё раз!»~
@46482 = ~«Рад был помочь. Прощай».~
@46483 = ~«Грёбаный придурок! Говорил я те не уходить из Улья. Вали отсюда быстрей, оно идёт за тобой!» — Мар убегает.~
@46484 = ~«Ну и ладно».~
@46485 = ~«Ты открыл коробку и всё ещё жив, раз мине об этом рассказываешь! Э-э… блин, я говорил те не открывать проклятую штуку. Мы так не договаривались, так что фиг я те заплачу. Уйди с глаз моих».~
@46486 = ~«Прощай».~
@46487 = ~«Прощай».~
@46488 = ~«Я ж предупреждал тя не уходить из Улья с этой коробкой. Странно, что демон ещё не порвал тя в клочья. Если ты за платой, то хрен те! Уговор был коробку доставить, а не демонов мочить».~
@46489 = ~«Прощай».~
@46490 = ~«Не о чём мине больше с тобой говорить».~
@46491 = ~«Прощай».~
@46492 = ~~
@46493 = ~Осмотреть частные объявления.~
@46494 = ~~
@46495 = ~~
@46496 = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@46497 = ~Оставить труп в покое.~
@46498 = ~«ТРЕБУЕТСЯ: Трудоспособная личность, желающая расследовать дело чрезвычайной важности для фракции Пыльных. Предлагаем хорошую оплату после выполнения задачи. Заинтересованным обращаться к Посвящённому Норочи, бар „Собиратели пыли“».~
@46499 = ~«Бар „Собиратели пыли“?»~
@46500 = ~Зомби тотчас же рывком поднимает левую руку вверх и указывает ей на здание перед тобой к западу. В следующий миг рука падает обратно с глухим БУХ.~
@46501 = ~Обследовать труп.~
@46502 = ~Обследовать труп.~
@46503 = ~Просмотреть другие записки.~
@46504 = ~Использовать на трупе «Разговор с мёртвыми».~
@46505 = ~Оставить труп в покое.~
@46506 = ~Обследовать труп.~
@46507 = ~Обследовать труп.~
@46508 = ~Просмотреть другие записки.~
@46509 = ~Использовать на трупе «Разговор с мёртвыми».~
@46510 = ~«Э-э… спасибо».~
@46511 = ~Ты видишь худого как палка мужчину в грязном чёрном одеянии. Его жёсткие чёрные волосы окружают голову шипастой короной, мертвенно-бледная кожа обтягивает череп. Он хмуро смотрит в стакан и что-то бормочет себе под нос.~
@46512 = ~Ты видишь худого как палка Пыльного в грязном чёрном одеянии. Его жёсткие чёрные волосы окружают голову шипастой короной, мертвенно-бледная кожа обтягивает череп. Он хмуро смотрит в стакан и что-то бормочет себе под нос.~
@46513 = ~Ты видишь Норочи. Он почёсывает себе лицо прядью собственных волос. Ты невольно думаешь, что ему бы пошли дреды.~
@46514 = ~Пыльный отрывает глаза от выпивки, моргает, затем обводит тебя с головы до ног изучающим взглядом. Закончив, он берёт прядь своих торчащих шипами волос и показывает на себя: «Норочи. Посвящённый. Пыльный. Страж».~
@46515 = ~Норочи трясёт головой и возвращается к выпивке.~
@46516 = ~Норочи проводит пальцем по насупленным бровям: «Проблемы, да».~
@46517 = ~Пыльный оглядывает тебя с головы до ног. «Много проблем имею я. Можешь помочь ты. Мавзолей пробуждается, мёртвые ходят, мёртвые встревожены, Пыльные встревожены. Найди, что нежить тревожит, и медяки заплачу я».~
@46518 = ~Норочи кивает: «Найти его не могу я. Очень Пыльным важно это».~
@46519 = ~Норочи опять кивает: «Сделай проблемы мои проблемами своими, и медяки заплачу я. Найди не-Пыльного, разберись с ним и вернись. Норочи подождёт».~
@46520 = ~Озабоченные морщины на лице Норочи разглаживаются при твоих словах. «Благодарю я, — он залезает в свои одежды, вынимает маленький мешочек и передаёт тебе. — Медяки. Сотня».~
@46521 = ~Озабоченные морщины на лице Норочи разглаживаются при твоих словах. «Благодарю я, — он залезает в свои одежды, вынимает маленький мешочек и передаёт тебе. — Медяки. Две сотни».~
@46522 = ~Озабоченные морщины на лице Норочи разглаживаются при твоих словах. «Благодарю я», — он залезает в свои одежды, вынимает увесистый мешочек и передаёт тебе. «Медяки. Три сотни. И… — он снова лезет в одежды и бросает тебе рулон бинтов, — …мне кажется, ты больше нуждаешься в перевязке, чем я».~
@46523 = ~«Эморик послал тебя ко мне… — он изучает тебя секунду, вздыхает и показывает на себя. — Норочи — Пыльный. Страж. Служу интересам Пыльных, защищаю интересы Пыльных, защищаю *репутацию* Пыльных». Мужчина снова вздыхает: «В Улье много воров. Есть один, который носит одежды Пыльного, но не Пыльный он».~
@46524 = ~Норочи кивает. «Мавзолей за мемориалом Пыльных. Иди на север и запад от чёрного памятника, подойди к арке и очерти полукруг над своим сердцем, вот так, этим пальцем делается, — он покачивает указательным пальцем правой руки. — В мавзолей попадёшь ты».~
@46525 = ~Норочи вздыхает и дёргает себя за прядь волос: «Пыльные дают обет не входить в мавзолей. Дают обет мёртвым. Нельзя. Только не-Пыльный войти может».~
@46526 = ~«Приветствую».~
@46527 = ~«Норочи?»~
@46528 = ~Оставить его в покое.~
@46529 = ~«Приветствую».~
@46530 = ~«Норочи?»~
@46531 = ~Оставить его в покое.~
@46532 = ~«Я выяснил, что случилось в мавзолее. Мёртвые снова спят».~
@46533 = ~«Я выяснил, что случилось в мавзолее. Мёртвые снова спят».~
@46534 = ~«Я выяснил, что случилось в мавзолее. Мёртвые снова спят».~
@46535 = ~«Я нашёл… не-Пыльного. Больше он не будет шарить по карманам в этом городе».~
@46536 = ~«Я нашёл… не-Пыльного. Больше он не будет шарить по карманам в этом городе».~
@46537 = ~«Я нашёл… не-Пыльного. Больше он не будет шарить по карманам в этом городе».~
@46538 = ~«Я нашёл… не-Пыльного. Он мёртв, и это несколько мешает ему шарить по карманам».~
@46539 = ~«Я нашёл… не-Пыльного. Он мёртв, и это несколько мешает ему шарить по карманам».~
@46540 = ~«Я нашёл… не-Пыльного. Он мёртв, и это несколько мешает ему шарить по карманам».~
@46541 = ~~
@46542 = ~~
@46543 = ~~
@46544 = ~~
@46545 = ~«Ты кажешься озабоченным… Норочи».~
@46546 = ~«Вообще-то я пришёл по объявлению».~
@46547 = ~«Эморик сказал мне поговорить с тобой».~
@46548 = ~«Могу я задать тебе вопрос?»~
@46549 = ~«Неважно. Прощай».~
@46550 = ~«Какие-то проблемы? Ты выглядишь озабоченным».~
@46551 = ~«Подожди. Эморик сказал мне поговорить с тобой».~
@46552 = ~~
@46553 = ~«Что не так?»~
@46554 = ~«Эморик сказал мне поговорить с тобой».~
@46555 = ~~
@46556 = ~«Отлично. Где этот мавзолей?»~
@46557 = ~«Ну, не знаю, смогу ли тебе помочь. Эморик просил меня поговорить с тобой о другом деле».~
@46558 = ~«Нет, спасибо. Прощай».~
@46559 = ~«Не беспокойся, я уже нашёл его. Больше он не провернёт этот фокус».~
@46560 = ~«Не беспокойся, я уже нашёл его. Больше он не провернёт этот фокус».~
@46561 = ~«Не беспокойся, я уже нашёл его. Больше он не провернёт этот фокус».~
@46562 = ~«Не беспокойся, я его уже нашёл и избавил от страданий».~
@46563 = ~«Не беспокойся, я его уже нашёл и избавил от страданий».~
@46564 = ~~
@46565 = ~~
@46566 = ~~
@46567 = ~~
@46568 = ~«Прекрасно. Я вернусь, когда найду этого… „Не-Пыльного“. Прощай».~
@46569 = ~«Я выяснил, что случилось в мавзолее. Мёртвые снова спят».~
@46570 = ~«Я выяснил, что случилось в мавзолее. Мёртвые снова спят».~
@46571 = ~«Я выяснил, что случилось в мавзолее. Мёртвые снова спят».~
