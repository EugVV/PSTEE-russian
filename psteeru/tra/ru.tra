@28155 = ~«Прости, оговорился. Я имел в виду всего лишь пятьдесят».~
@28156 = ~«Прости, оговорился. Я имел в виду всего лишь пятьдесят».~
@28157 = ~«Прощай».~
@28158 = ~Эта привлекательная женщина внимательно следит за выступлением двух актёров.~
@28159 = ~Женщина поворачивается к тебе, но её внимание по-прежнему поглощено игрой актёров. Она тихо говорит: «Приятная встреча, сэр. Давно смотрите выступление? Актёр, что слева, неплох. А его партнёру не мешало бы подрепетировать, нет?»~
@28160 = ~Женщина лишь кивает в ответ и возвращается к просмотру представления.~
@28161 = ~Она хмурится и говорит шёпотом: «Сэр, пожалуйста, соблюдайте приличия — я смотрю представление. Прощайте».~
@28162 = ~Она всё так же говорит шёпотом, но в её тоне появляется угроза: «Я прошу вас хранить молчание, сэр, или покинуть это место. Иначе мне придётся позвать стражу».~
@28163 = ~Женщина приветственно кивает, но жестом требует молчания.~
@28164 = ~«Приветствую…»~
@28165 = ~Оставить женщину в покое.~
@28166 = ~«Я не уверен».~
@28167 = ~«Да, он играет так себе».~
@28168 = ~«Нет, вообще-то он неплох».~
@28169 = ~«Да неважно… у меня кое-какие вопросы…»~
@28170 = ~«У меня кое-какие вопросы…»~
@28171 = ~Уйти.~
@28172 = ~«Всего лишь пара вопросов…»~
@28173 = ~Уйти.~
@28174 = ~«Прекрасно, зови».~
@28175 = ~Уйти.~
@28176 = ~«У меня кое-какие вопросы…»~
@28177 = ~Этот джентльмен внимательно следит за выступлением двух актёров.~
@28178 = ~«Приветствую…»~
@28179 = ~Мужчина поворачивается к тебе, но его внимание по-прежнему поглощено игрой актёров. Он тихо говорит: «Да, я тоже вас приветствую. Итак, что вы думаете? Актёр справа, по-моему, неплох. А тому, что слева, не мешало бы больше репетировать, верно?»~
@28180 = ~«Я не уверен».~
@28181 = ~«Хм-м-м». Мужчина возвращается к просмотру представления.~
@28182 = ~«У меня кое-какие вопросы…»~
@28183 = ~Он хмурится и говорит шёпотом: «Не сейчас, я смотрю представление. Прощайте, сэр».~
@28184 = ~«Всего лишь пара вопросов…»~
@28185 = ~Он не повышает голос, но в тоне появляется угроза: «Нет. Оставьте меня, сэр. Иначе я буду вынужден позвать стражу».~
@28186 = ~«Прекрасно, зови».~
@28187 = ~Уйти.~
@28188 = ~Уйти.~
@28189 = ~Уйти.~
@28190 = ~«Да, он играет так себе».~
@28191 = ~«Нет, вообще-то он неплох».~
@28192 = ~«Да неважно… у меня кое-какие вопросы…»~
@28193 = ~Оставить мужчину в покое.~
@28194 = ~Мужчина приветственно кивает, но жестом требует от тебя молчания.~
@28195 = ~«У меня кое-какие вопросы…»~
@28196 = ~Привлекательная женщина внимательно слушает выступление поэта.~
@28197 = ~«Приветствую…»~
@28198 = ~Женщина поворачивается к тебе, но её внимание по-прежнему приковано к поэту. Она тихо произносит: «Потише, прошу вас». Затем кивает в сторону поэта: «Не классика, разумеется, но *потенциал* у приятеля имеется».~
@28199 = ~«Я не уверен».~
@28200 = ~Женщина медленно кивает, но не отрывает взгляда от поэта.~
@28201 = ~«У меня кое-какие вопросы…»~
@28202 = ~Она хмурится и шёпотом говорит: «Не время, сэр. Пожалуйста, уважайте поэта и храните молчание… прощайте».~
@28203 = ~«Всего лишь пара вопросов…»~
@28204 = ~Она не повышает голоса, но говорит почти угрожающе: «Не место и не время для вопросов. Оставьте меня, или я позову стражу».~
@28205 = ~«Прекрасно, зови».~
@28206 = ~Уйти.~
@28207 = ~Уйти.~
@28208 = ~Уйти.~
@28209 = ~«Да ну, как поэт он так себе».~
@28210 = ~Это джентльмен внимательно слушает выступление старого поэта.~
@28211 = ~«Приветствую…»~
@28212 = ~Оставить мужчину в покое.~
@28213 = ~Мужчина поворачивается к тебе, но его внимание всё ещё приковано к поэту. Он тихо произносит: «И я вас приветствую». На мгновение он замолкает, затем продолжает: «Не самая лучшая поэзия, что я слышал в своей жизни, но и явно не худшая, как думаете?»~
@28214 = ~«Я не уверен».~
@28215 = ~«Да ну, как поэт он так себе».~
@28216 = ~«Да, он неплохой поэт».~
@28217 = ~«Неважно. У меня кое-какие вопросы…»~
@28218 = ~«Хм-м». Мужчина кивает, но продолжает глазеть на старого поэта.~
@28219 = ~«У меня кое-какие вопросы…»~
@28220 = ~Уйти.~
@28221 = ~Он хмурится и шёпотом говорит: «Нет, сэр, не сейчас. Я слушаю поэзию. Прощайте, сэр».~
@28222 = ~«Всего лишь пара вопросов…»~
@28223 = ~Уйти.~
@28224 = ~Он говорит так же тихо, но в голосе слышны нотки угрозы: «Помолчите или уходите, сэр, иначе я буду вынужден позвать стражу».~
@28225 = ~«Прекрасно, зови».~
@28226 = ~Уйти.~
@28227 = ~Мужчина кивает в знак приветствия, но жестом призывает хранить молчание.~
@28228 = ~«У меня кое-какие вопросы…»~
@28229 = ~Перед тобой сногсшибательная женщина с золотыми волосами, одетая в лазурно-фиолетовое платье, два элегантных крыла охватывают её плечи. Она осматривает помещение с лёгкой улыбкой… она, несомненно, самая красивая женщина, какую ты когда-либо видел.~
@28230 = ~«Приветствую…»~
@28231 = ~Игнорировать женщину с крыльями и изучить здание.~
@28232 = ~~
@28233 = ~Падшая Грейс поворачивается к тебе и слегка улыбается: «Чем могу помочь?»~ [FFG002]
@28234 = ~«У меня вопросы. Я хотел тебя спросить…»~
@28235 = ~«Прости, что потревожил. Прощай».~
@28236 = ~«Да?»~
@28237 = ~«Так кто ты?»~
@28238 = ~«Эти крылья у тебя на спине… кто ты?»~
@28239 = ~«Эти крылья у тебя на спине… кто ты?»~
@28240 = ~«Эти крылья у тебя на спине… кто ты?»~
@28241 = ~«Позволь спросить, леди Грейс, эти крылья у тебя на спине… ты не человек, так ведь?»~
@28242 = ~«Позволь спросить, леди Грейс, эти крылья у тебя на спине… ты не человек, так ведь?»~
@28243 = ~«Позволь спросить, леди Грейс, эти крылья у тебя на спине… ты не человек, так ведь?»~
@28244 = ~«Что это за место?»~
@28245 = ~«Я тут в поисках помощи. Возможно, мне поможешь ты?»~
@28246 = ~«Можешь рассказать мне о местных девушках?»~
@28247 = ~«Можешь рассказать мне о Чующих?»~
@28248 = ~«Не расскажешь мне о ночной ведьме по имени Рейвел?»~
@28249 = ~«Можешь ещё раз рассказать мне о ночной ведьме по имени Рейвел?»~
@28250 = ~«Не расскажешь мне о Кровавой Войне?»~
@28251 = ~«Я поговорил с девятью студентками… но не могу найти десятую».~
@28252 = ~«Не хотела бы ты присоединиться ко мне в моих странствиях?»~
@28253 = ~«Не хотела бы ты присоединиться ко мне в моих странствиях?»~
@28254 = ~«Не хотела бы ты присоединиться ко мне в моих странствиях?»~
@28255 = ~«Не хотела бы ты присоединиться ко мне в моих странствиях?»~
@28256 = ~Женщина поворачивается к тебе, когда ты к ней обращаешься. Она окидывает тебя взглядом, и ты замечаешь, что глаза у неё того же лазурного цвета, что и платье. «Приятная встреча, странник, — она поднимает руку, чтобы убрать назад непослушную прядь золотых волос. — Чем я могу помочь?»~ [FFG004]
@28257 = ~«Кто ты?»~
@28258 = ~«Пока ничем. Прощай».~
@28259 = ~«Меня зовут Падшая Грейс, — она изучает тебя. — Ты новичок в Сигиле, не так ли?»~
@28260 = ~«Да. Так заметно?»~
@28261 = ~«Нет, подозреваю, я тут уже далеко не в первый раз».~
@28262 = ~«Падшая Грейс… какое любопытное имя».~
@28263 = ~«Это не то, что я сейчас хочу обсуждать. Прощай».~
@28264 = ~«Я Падшая Грейс, — она легко улыбается. — Разве ты меня уже забыл?»~
@28265 = ~«Госпожа Грейс, ты можешь не бояться быть мной забытой. Поверь, тебя забыть невозможно».~
@28266 = ~«Госпожа Грейс, ты можешь не бояться быть мной забытой. Поверь, тебя забыть невозможно».~
@28267 = ~«Нет, вовсе нет».~
@28268 = ~«Падшая Грейс… какое любопытное имя».~
@28269 = ~«Нет, конечно. Могу я задать пару вопросов?»~
@28270 = ~«Может быть. Прощай».~
@28271 = ~Падшая Грейс мрачнеет, по очереди окидывая вас обоих взглядом: «Я не хотела никого обидеть. Прости мне моё поддразнивание».~
@28272 = ~«Никто и не обиделся, в извинениях нет необходимости, леди. Могу я тебя кое о чём спросить?»~
@28273 = ~«И всё же я, пожалуй, удалюсь. Прощай, леди Грейс».~
@28274 = ~Она негромко смеётся, потом примирительно улыбается: «Хорошо, я тебя прощаю».~
@28275 = ~«Падшая Грейс… какое любопытное имя».~
@28276 = ~«Могу я задать ещё пару вопросов?»~
@28277 = ~«Я должен идти. Прощай».~
@28278 = ~Она слегка улыбается: «Не так сильно, как ты думаешь. Ты довольно неплохо держишься».~
@28279 = ~«Что это за место?»~
@28280 = ~«Я должен идти. Прощай».~
@28281 = ~Она кивает: «Рада, что тебе понравилось. Однако я думаю, ты пришёл сюда не для комплиментов. Чем я могу помочь?»~
@28282 = ~«Что это за место?»~
@28283 = ~«Сегодня ничем. Прощай».~
@28284 = ~«Это *Бордель Безумной Интеллектуальной Страсти*, — минуту она изучает тебя. — Судя по вопросу, тебе не доводилось здесь бывать?»~
@28285 = ~«„Бордель Безумной Интеллектуальной Страсти“? А какого рода этот бордель?»~
@28286 = ~«„Бордель Безумной Интеллектуальной Страсти“? А какого рода этот бордель?»~
@28287 = ~«Нет, я так не думаю. Прощай».~
@28288 = ~«Это Бордель Безумной Интеллектуальной Страсти».~
@28289 = ~«„Бордель Безумной Интеллектуальной Страсти“? А какого рода этот бордель?»~
@28290 = ~«„Бордель Безумной Интеллектуальной Страсти“? А какого рода этот бордель?»~
@28291 = ~«О, ясно. Могу я задать ещё пару вопросов?»~
@28292 = ~«О, ясно. Могу я задать ещё пару вопросов?»~
@28293 = ~«Как любопытно. Спасибо за информацию. Прощай».~
@28294 = ~«Я основала бордель с целью дать тем чувственным страстям, что поражают разум, иные пути выражения, нежели плотские. Ведь разговор и состязание в словесном искусстве может принести огромное удовольствие».~
@28295 = ~«Я уверяю, это не так. Пройдись по борделю, посмотри сам».~
@28296 = ~«Так это бордель… без секса?»~
@28297 = ~«Не могу не спросить, а зачем тебе понадобилось основывать такое заведение?»~
@28298 = ~«Может, и пройдусь. Но сначала я хотел бы задать пару вопросов».~
@28299 = ~«Хорошо, так и поступлю. Прощай».~
@28300 = ~«Я основала бордель с целью дать тем чувственным страстям, что поражают разум, иные пути выражения, нежели плотские. Ведь разговор и состязание в словесном искусстве может принести огромное удовольствие».~
@28301 = ~«Так это бордель… без секса?»~
@28302 = ~«Не могу не спросить, а зачем тебе понадобилось основывать такое заведение?»~
@28303 = ~«Ясно. Могу я задать пару вопросов?»~
@28304 = ~«Спасибо за объяснения, но мне пора идти. Прощай».~
@28305 = ~«Исключительно психологического толка. Не сомневайся, это очень стимулирует».~
@28306 = ~«Не могу не спросить, а зачем тебе понадобилось основывать такое заведение?»~
@28307 = ~«Могу я задать ещё пару вопросов?»~
@28308 = ~«Возможно, мне стоит пройтись по борделю. До свидания».~
@28309 = ~Падшая Грейс поднимает бровь: «Странный вопрос». Она хмурится: «Не думаю, что у меня вообще когда-либо такое спрашивали. По крайней мере, напрямую».~
@28310 = ~«Прости меня, я не хотел быть столь прямолинейным. Простое любопытство».~
@28311 = ~«Так… зачем?»~
@28312 = ~«Ну, довольно странно для суккуба основывать подобное заведение… это же должно быть противно вашей природе».~
@28313 = ~«Могу я задать ещё пару вопросов?»~
@28314 = ~«Возможно, мне стоит пройтись по борделю. До свидания».~
@28315 = ~«О, нет необходимости извиняться, я рада обсудить подобный вопрос, если пожелаешь».~
@28316 = ~«Хотелось бы послушать».~
@28317 = ~«Довольно странно для суккуба основывать подобное заведение… это же должно быть противно вашей природе».~
@28318 = ~«Не сейчас. Могу я задать другой вопрос?»~
@28319 = ~«В другой раз. Мне нужно идти. Прощай».~
@28320 = ~«Быть может, ответ на твой вопрос отчасти лежит в философии Общества Восприятия, членом которого я являюсь. Мы верим, что каждый должен на собственном опыте познать мультивселенную настолько, насколько возможно».~
@28321 = ~«И поэтому ты организовала своё заведение?»~
@28322 = ~«Ясно, я уже всё понял. Могу я задать другой вопрос?»~
@28323 = ~«Возможно, мне стоит пройтись по борделю. До свидания».~
@28324 = ~«Бордель был создан для того, чтобы удовлетворить потребности даже самого искушённого интеллектуала. Он призван стимулировать разум, повышать понимание себя и других, создавать новые пути *познания* окружающих. Он для тех, кто ищет чего-то большего, нежели пустое удовлетворение похоти — этого добра полно и в Улье, и в Нижнем районе».~
@28325 = ~«Я бы не назвал это пустым… ну, то есть, я понимаю. Думаю, здесь должны быть очень особенные женщины».~
@28326 = ~«Ясно. Значит, это заведение поддерживает только интеллектуальное удовлетворение, а не… хм-м… ну, в общем, удовлетворение *другого* рода. Получается, что и женщины здесь должны быть особыми».~
@28327 = ~«Могу я задать ещё пару вопросов?»~
@28328 = ~«Возможно, мне стоит пройтись по борделю. До свидания».~
@28329 = ~«Женщины здесь стремятся стать Чующими. Они приходят сюда в поиске наставлений, чтобы быть готовыми вступить во фракцию. К тому же большинство из них имеют врождённые способности к языкам, достаточные, чтобы растопить лёд даже самого стойкого индивидуума».~
@28330 = ~«Чующими?»~
@28331 = ~~
@28332 = ~«Ясно. То есть дамочки тут тренируются, можно сказать?»~
@28333 = ~«Могу я задать ещё пару вопросов?»~
@28334 = ~«Возможно, мне стоит пройтись по борделю. До свидания».~
@28335 = ~Она отвешивает лёгкий поклон: «Да, членами Общества Восприятия. Наша фракция верит, что каждый должен на собственном опыте познать мультивселенную настолько, насколько возможно».~
@28336 = ~«И девочки здесь учатся быть Чующими?»~
@28337 = ~«Ясно, я уже всё понял. Могу я задать пару вопросов о другом?»~
@28338 = ~«Возможно, мне стоит пройтись по борделю. До свидания».~
@28339 = ~«Не всем это удаётся, конечно, но пробуют многие… Им рады здесь — и они могут многому научиться».~
@28340 = ~«Ясно. То есть это что-то вроде школы?»~
@28341 = ~«Могу я задать ещё пару вопросов?»~
@28342 = ~«Возможно, мне стоит пройтись по борделю самому. До свидания».~
@28343 = ~«Да. Я надеюсь, что обучаясь искусству языка и его тонкостям, посетители и ученики могут глубже познать самих себя. И нет здесь иных границ, кроме уровня владения языком. Пробуждать чувства в других с помощью речи — это высокое и великое искусство».~
@28344 = ~«Ясно. Могу я задать вопрос о другом?»~
@28345 = ~«Возможно, мне стоит пройтись по борделю самому. До свидания».~
@28346 = ~[нет текста]~
@28347 = ~«Твоя спутница права. Я действительно из младших танар'ри, суккуб, если точнее, — она тихо вздыхает. — Боюсь, нас на Нижних планах развелось уж слишком много, и везде мы думаем только о себе. Большинство из нас тратит своё время на то, чтобы соблазнять смертных разнообразными плотскими утехами».~
@28348 = ~«А ты?..»~
@28349 = ~«Ясно. Могу я задать другой вопрос?»~
@28350 = ~«Я должен идти. Прощай».~
@28351 = ~«Да. Мне пора идти. Прощай».~
@28352 = ~«Чующие — это фракция Сигила, которая целиком посвящает себя жизненному опыту. Без опыта, без восприятия мы слепы перед мультивселенной. Таким образом, Чующие ищут столько опыта, сколько возможно. И только с пришедшим опытом открывается истина мультивселенной».~
@28353 = ~«Интересная философия. Могу ли я присоединиться к Чующим?»~
@28354 = ~«Ясно. Могу я задать другой вопрос?»~
@28355 = ~«Может, и так. В любом случае мне пора идти. Прощай».~
@28356 = ~Она улыбается: «Чтобы присоединиться, нужно всего лишь учиться у самой жизни».~
@28357 = ~«Я хотел сказать, что заинтересован в присоединении к фракции».~
@28358 = ~«Ясно. Могу я задать другой вопрос?»~
@28359 = ~«Хорошо. Мне пора идти. Прощай».~
@28360 = ~«Конечно… прости моё поддразнивание, — Грейс кивает. — Если хочешь присоединиться к Чующим, тебе следует навести справки в Общественном Фестхолле. Там наверняка смогут помочь».~
@28361 = ~«Ясно. Могу я задать другой вопрос?»~
@28362 = ~«Спасибо, туда я и отправлюсь. Прощай».~
@28363 = ~«Что ж… — её губ касается лёгкая улыбка. — Это довольно прямолинейно».~
@28364 = ~«Я стараюсь честно оглашать свои намерения. Ты кажешься мне очень милой и хорошо осведомлённой в отношении планов. Иметь такого знающего компаньона было бы приятно».~
@28365 = ~«Я стараюсь честно оглашать свои намерения. Ты кажешься мне очень милой и хорошо осведомлённой в отношении планов. Иметь такого знающего компаньона было бы приятно».~
@28366 = ~«Именно так».~
@28367 = ~«Я хочу сказать, насколько волнующим может быть это место?..»~
@28368 = ~«Ты Чующая. И, конечно же, есть предел тому, что ты можешь постигнуть в этом месте».~
@28369 = ~«Тогда забудь о моей просьбе. Могу я вместо этого кое-что спросить?»~
@28370 = ~«Тогда позволь принести извинения. Мне пора идти. Прощай».~
@28371 = ~«Я ценю твою прямоту. Но позволь отплатить своей собственной: что я от приобрету от путешествий с тобой?»~
@28372 = ~«Хочешь сказать, тебе неинтересно путешествие с потерявшим память бессмертным, обшаривающим планы?»~
@28373 = ~«Леди Грейс, я намереваюсь проникнуть в такие места, в которых никто не бывал… а может, никогда и не будет. Разве тебя это не интересует?»~
@28374 = ~«И насколько волнующим может быть это место?»~
@28375 = ~«Ты Чующая. И, конечно же, есть предел тому, что ты можешь постигнуть в этом месте».~
@28376 = ~«Забудь о моём предложении. Могу я задать вопрос?»~
@28377 = ~«Забудь о моём предложении. Пожалуй, я пойду. Прощай».~
@28378 = ~«О, мне *крайне* интересно! — на её губах играет лёгкая улыбка. — Такое предложение интригует. Ты не ошибся, сделав его мне».~
@28379 = ~«Значит, ты *отправишься* путешествовать со мной?»~
@28380 = ~«Если желаешь, чтобы я присоединилась, то поставлю одно условие. У меня есть десять студенток. Ты должен обойти Бордель и поговорить с ними всеми, после чего вернуться со своими мыслями. Тогда мы и решим, пойду я с тобой или нет».~
@28381 = ~«Я уже поговорил с ними… но тут всего девять студенток. Мне не удалось найти десятую».~
@28382 = ~«Хорошо, но могу ли я сперва задать пару вопросов?»~
@28383 = ~«Хорошо, тогда я пойду поговорю с ними. Вернусь, когда закончу».~
@28384 = ~«Конечно интересует, — она обхватывает подбородок и на миг задумывается. — Хотя…»~
@28385 = ~«Хочешь сказать, тебе неинтересно путешествие с потерявшим память бессмертным, обшаривающим планы?»~
@28386 = ~«И насколько волнующим может быть это место?»~
@28387 = ~«Ты Чующая. И, конечно же, есть предел тому, что ты можешь постигнуть в этом месте».~
@28388 = ~«Неважно. Могу я задать пару вопросов?»~
@28389 = ~«Подумай об этом, а я вернусь попозже. До свидания».~
@28390 = ~«Я думаю, ты будешь удивлён. Если уж убеждаешь меня отправиться с тобой в путь, то мне нужны более веские доводы».~
@28391 = ~«Хочешь сказать, тебе неинтересно путешествие с потерявшим память бессмертным, обшаривающим планы?»~
@28392 = ~«Неважно. Могу я задать пару вопросов?»~
@28393 = ~«Ладно, поищу более веских доводов. До встречи».~
@28394 = ~[нет текста]~
@28395 = ~«Помощь? И какая же помощь тебе нужна?»~
@28396 = ~«Я потерял память… и, таким образом, самого себя».~
@28397 = ~«Не бери в голову. Могу я задать пару вопросов?»~
@28398 = ~«Пожалуй, поговорим об этом в другой раз. Прощай».~
@28399 = ~«У тебя амнезия? — Падшая Грейс выглядит расстроенной. — Какой ужас! Есть предположения о том, что могло случиться?»~
@28400 = ~«Нет… по крайней мере в памяти ничего не сохранилось. Я очнулся на плите в Мортуарии, а до этого момента у меня в голове просто темнота».~
@28401 = ~«Не бери в голову. Могу я задать пару вопросов?»~
@28402 = ~«Пожалуй, поговорим об этом в другой раз. Прощай».~
@28403 = ~«Ты очнулся в Мортуарии?»~
@28404 = ~«Думаю, Пыльные по ошибке приняли меня за мёртвого… или я действительно был мёртв… или что-то ещё. Всё, что мне известно, — я довольно быстро регенерирую. Возможно, я бессмертен, но и в этом не уверен».~
@28405 = ~«Думаю, Пыльные по ошибке приняли меня за мёртвого… или я действительно был мёртв… или что-то ещё. Всё, что мне известно, — я довольно быстро регенерирую. Возможно, я бессмертен, но и в этом не уверен».~
@28406 = ~«Не бери в голову. Могу я задать пару вопросов?»~
@28407 = ~«Пожалуй, поговорим об этом в другой раз. Прощай».~
@28408 = ~Падшая Грейс оглядывает тебя с удвоенным интересом. «Эти шрамы на теле, — она протягивает к тебе руку. — Можно?»~
@28409 = ~«М-м… конечно».~
@28410 = ~«Да».~
@28411 = ~«По правде говоря, я не хочу обсуждать это прямо сейчас. Могу я задать пару вопросов?»~
@28412 = ~«Пожалуй, поговорим об этом в другой раз. Прощай».~
@28413 = ~Падшая Грейс лёгким движением проводит пальцем по твоей груди: по краям шрамов, по изгибам перекрывающих шрамы татуировок. Она кажется восхищённой: «Эти шрамы выглядят так, будто накапливались несколько жизней».~
@28414 = ~«Явно так и было… хотя некоторые из них совсем недавние».~
@28415 = ~«По правде говоря, я не хочу обсуждать это прямо сейчас. Могу я задать кое-какие вопросы?»~
@28416 = ~«Пожалуй, поговорим об этом в другой раз. Прощай».~
@28417 = ~Падшая Грейс отступает назад. «Некоторые из этих ран безусловно смертельны… для обычного человека, — она постукивает пальцами по подбородку, задумавшись. — Что ты собираешься делать теперь?»~
@28418 = ~«Вернуть воспоминания и свою жизнь. Я перерою планы и самого себя, пока не докопаюсь до истины».~
@28419 = ~«Вернуть воспоминания и свою жизнь. Я перерою планы и самого себя, пока не докопаюсь до истины».~
@28420 = ~«Не знаю. Сейчас я просто ищу зацепки о том, кто я и что со мной произошло».~
@28421 = ~«Ничего. Если есть ответы на мои вопросы, они придут ко мне… рано или поздно».~
@28422 = ~«По правде говоря, я не хочу обсуждать это прямо сейчас. Могу я задать пару вопросов?»~
@28423 = ~«Пожалуй, поговорим об этом в другой раз. Прощай».~
@28424 = ~Падшая Грейс всё ещё думает, теребя подбородок. «Должна сказать, мне ещё не приходилось встречать человека, который потерял бы себя в буквальном смысле, — она поднимает брови. — Прости, но твоё положение меня действительно интригует».~
@28425 = ~«Что ж, я рад, что *ты* так думаешь».~
@28426 = ~«Так и есть».~
@28427 = ~«„Интригует“? Пугает, я бы сказал. Мне не нравится не знать кто я, что я сделал, кто мои враги и кто друзья».~
@28428 = ~«По правде говоря, я не хочу обсуждать это прямо сейчас. Могу я задать пару вопросов?»~
@28429 = ~«Пожалуй, поговорим об этом в другой раз. Прощай».~
@28430 = ~«Я обидела тебя бестактными словами, — Падшая Грейс качает головой. — Если позволишь, приношу свои извинения».~
@28431 = ~«Извинения приняты».~
@28432 = ~«Пустяки, я вовсе не обиделся».~
@28433 = ~«По правде говоря, я не хочу обсуждать это прямо сейчас. Могу я задать пару вопросов?»~
@28434 = ~«Пожалуй, поговорим об этом в другой раз. Прощай».~
@28435 = ~Падшая Грейс кивает: «Если это способно помочь, ты всегда можешь нанести визит в Бордель. Некоторые из наших учениц весьма сведущи в словесных искусствах. Быть может, их слова станут искрой, что прольёт свет в твоей памяти».~
@28436 = ~«Возможно, так и поступлю. Могу я сперва задать пару вопросов?»~
@28437 = ~«Спасибо. Наверное, пойду поговорю с ними. Прощай».~
@28438 = ~«Кровавая Война — это конфликт между баатезу и танар'ри, который бушует на Нижних планах. Они решают между собой вопрос, должно ли зло быть хаотичным или же законопослушным, — Падшая Грейс ненадолго замолкает. — Этой войны лучше избегать во что бы то ни стало. Пусть баатезу и танар'ри бьются головами, оставив остальные планы в покое… или хотя бы в относительном покое».~
@28439 = ~«В относительном покое?»~
@28440 = ~«А людей они используют?»~
@28441 = ~«И как долго всё это продолжается?»~
@28442 = ~«А тебе в ней приходилось участвовать?»~
@28443 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@28444 = ~«Ясно. Спасибо за информацию. Прощай».~
@28445 = ~«Ну, война настолько масштабная, что большинство рас в неё вовлечены вопреки желанию. А игнорировать её зачастую так же опасно, как и участвовать».~
@28446 = ~«А людей они используют?»~
@28447 = ~«И как долго всё это продолжается?»~
@28448 = ~«А тебе в ней приходилось участвовать?»~
@28449 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@28450 = ~«Ясно. Спасибо за информацию. Прощай».~
@28451 = ~«Да, время от времени. В Кровавой Войне участвует множество людей-наёмников. Иногда они — солдаты, иногда — пушечное мясо, а иногда — и просто закуска для извергов».~
@28452 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@28453 = ~«И как долго всё это продолжается?»~
@28454 = ~«А тебе в ней приходилось участвовать?»~
@28455 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@28456 = ~«Ясно. Спасибо за информацию. Прощай».~
@28457 = ~«Согласно записям хроник, Кровавая Война продолжается с тех пор, когда баатезу впервые встретились с танар'ри. Это было очень, *очень* давно — мне даже неизвестно человеческое слово, которое бы выражало такой большой период, — Падшая Грейс качает головой. — Боюсь, ни баатезу, ни танар'ри неспособны взять верх в этой бесконечной войне».~
@28458 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@28459 = ~«А людей они используют?»~
@28460 = ~«А тебе в ней приходилось участвовать?»~
@28461 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@28462 = ~«Ясно. Спасибо за информацию. Прощай».~
@28463 = ~«Нет. А вот моя мать участвовала. Суккубы обычно соблазняют смертных и затаскивают их души в Бездну для создания новых танар'ри, которые будут умирать на Кровавой Войне».~
@28464 = ~«Твоя мать служила на Кровавой Войне?»~
@28465 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@28466 = ~«А людей они используют?»~
@28467 = ~«И как долго всё это продолжается?»~
@28468 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@28469 = ~«Ясно. Спасибо за информацию. Прощай».~
@28470 = ~«Да. Она была из лучших, соблазнила великое множество смертных мужчин. Теперь она живёт в Бездне, зарабатывает продажей своих детей в рабство».~
@28471 = ~«Ты… была продана в рабство своей матерью?»~
@28472 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@28473 = ~«А людей они используют?»~
@28474 = ~«И как долго всё это продолжается?»~
@28475 = ~«Эти вопросы не причиняют тебе беспокойства?»~
@28476 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@28477 = ~«Ясно. Спасибо за информацию. Прощай».~
@28478 = ~«На некоторое время. Мне удалось завоевать себе свободу в соревновании по импровизации. Это было давным-давно».~
@28479 = ~«И кому она тебя продала?»~
@28480 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@28481 = ~«А людей они используют?»~
@28482 = ~«И как долго всё это продолжается?»~
@28483 = ~«Эти вопросы не причиняют тебе беспокойства?»~
@28484 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@28485 = ~«Ясно. Спасибо за информацию. Прощай».~
@28486 = ~«Она продала меня баатезу. Думаю, она надеялась, что они меня убьют. Несмотря на её обширные познания, она немногое знает об их культуре».~
@28487 = ~«Она продала тебя заклятым врагам танар'ри?»~
@28488 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@28489 = ~«А людей они используют?»~
@28490 = ~«И как долго всё это продолжается?»~
@28491 = ~«Эти вопросы не причиняют тебе беспокойства?»~
@28492 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@28493 = ~«Ясно. Спасибо за информацию. Прощай».~
@28494 = ~«Да, — Падшая Грейс резко выпрямляется. — Ты хотел узнать что-то ещё?»~
@28495 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@28496 = ~«А людей они используют?»~
@28497 = ~«И как долго всё это продолжается?»~
@28498 = ~«Эти вопросы не причиняют тебе беспокойства?»~
@28499 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@28500 = ~«Ясно. Спасибо за информацию. Прощай».~
@28501 = ~«О нет, вовсе нет. Тебе следует знать, что Кровавая Война лежит в основе множества событий на планах. Очень важно понимать, чем она является и какое место занимает».~
@28502 = ~«Так ты говоришь, пока война продолжается, для остальной части планов возможен „относительный покой“?»~
@28503 = ~«А людей они используют?»~
@28504 = ~«И как долго всё это продолжается?»~
@28505 = ~«А тебе в ней приходилось участвовать?»~
@28506 = ~«У меня вопросы, не связанные с Кровавой Войной».~
@28507 = ~«Ясно. Спасибо за информацию. Прощай».~
@28508 = ~«Мне знакомо это имя, — Падшая Грейс на мгновение замолкает. — Слухи о ней роятся в изобилии, и большинство склонно считать её вымыслом, однако я думаю, что она действительно существовала и наделала большого шуму в Клетке, когда была здесь». Она выглядит озадаченной: «А почему ты спрашиваешь?»~
@28509 = ~«Я намерен её найти».~
@28510 = ~«И что ещё ты о ней знаешь?»~
@28511 = ~«Неважно. У меня другие вопросы…»~
@28512 = ~«Просто так. Спасибо за информацию. Прощай».~
@28513 = ~Грейс поднимает бровь: «Правда? Я вынуждена спросить: зачем?»~
@28514 = ~«Мне нужна от неё кое-какая информация».~
@28515 = ~«Неважно. У меня другие вопросы…»~
@28516 = ~«Просто так. Спасибо за информацию. Прощай».~
@28517 = ~«И больше спросить не у кого?»~
@28518 = ~«Подозреваю, только Рейвел знает то, что мне нужно».~
@28519 = ~«Неважно. У меня другие вопросы…»~
@28520 = ~«Я не знаю, но собираюсь выяснить. Пока».~
@28521 = ~Грейс легонько касается твоей руки: «Поразмысли хорошенько: если Рейвел до сих пор существует, тогда она чрезвычайно могущественна и коварна. Если хоть доля слухов о ней — правда, то она не просто воплощение зла, она обогатила само понятие зла новым смыслом. Её поиски — не то, за что стоит браться необдуманно».~
@28522 = ~«Я понимаю».~
@28523 = ~«Понимаю. Известно ли тебе ещё что-нибудь о Рейвел?»~
@28524 = ~«Ясно. Могу я задать другой вопрос?»~
@28525 = ~«Знаю. Но всё же я должен её найти. Спасибо за информацию. Прощай».~
@28526 = ~«Что ж, мне никогда не доводилось встречаться с живой легендой. Вот это была бы экскурсия! — она улыбается. — Ты никогда не пробовал заняться чем-нибудь скучным?»~
@28527 = ~«Стараюсь воздерживаться… знаешь ещё что-нибудь о Рейвел?»~
@28528 = ~«По возможности избегаю. Можно мне задать парочку вопросов о другом?»~
@28529 = ~«Может, в других инкарнациях, но как знать. Пока».~
@28530 = ~«Она была одной из ведьм Серой Пустоши и верила, что обладает силами и коварством, превосходящими всё известное её сёстрам. Она появилась в Сигиле давно и принесла такое зло, что оно, согласно легендам, грозило самому существованию Клетки. Теперь же она просто персонаж из сказки, — Грейс прерывается. — Я думаю, Госпожа Боли обошлась с ней, как обходилась со всеми, кто когда-либо угрожал Сигилу».~
@28531 = ~«Как?»~
@28532 = ~«Что такое Серая Пустошь?»~
@28533 = ~«Может о ней знать кто-нибудь ещё?»~
@28534 = ~«Могу я задать вопрос о другом?»~
@28535 = ~«Ясно. Спасибо за информацию. Прощай».~
@28536 = ~«Скорее всего, Рейвел была отправлена в лабиринт. Одну из тюрем Госпожи».~
@28537 = ~«Лабиринт? Что это?»~
@28538 = ~«Что такое Серая Пустошь?»~
@28539 = ~«Может о ней знать кто-нибудь ещё?»~
@28540 = ~«Могу я задать вопрос о другом?»~
@28541 = ~«Ясно. Спасибо за информацию. Прощай».~
@28542 = ~«План разложения, который фактически лежит „между“ Баатором и Бездной. Там часто проходят сражения Кровавой Войны».~
@28543 = ~«Что ты знаешь о судьбе Рейвел?»~
@28544 = ~«Может о ней знать кто-нибудь ещё?»~
@28545 = ~«Могу я задать вопрос о другом?»~
@28546 = ~«Ясно. Спасибо за информацию. Прощай».~
@28547 = ~«Возможно, о ней больше знает кто-нибудь в Фестхолле».~
@28548 = ~«Что ты знаешь о судьбе Рейвел?»~
@28549 = ~«Что такое Серая Пустошь?»~
@28550 = ~«Могу я задать вопрос о другом?»~
@28551 = ~«Ясно. Спасибо за информацию. Прощай».~
@28552 = ~Падшая Грейс поднимает бровь: «Неужели?»~
@28553 = ~«Да… но это слишком долгая история, возможно, дольше, чем мне известно. Меня гораздо больше интересует это место».~
@28554 = ~«Да, но я расскажу об этом как-нибудь в другой раз. Мне пора идти. Прощай».~
@28555 = ~Она кивает: «Я рада, что тебе нравится. Я и сама его люблю».~
@28556 = ~«А что именно оно значит?»~
@28557 = ~«Могу я задать вопрос о другом?»~
@28558 = ~«Поговорим позже. До свидания».~
@28559 = ~«Значение имён — очень сложная тема. Тут можно многое сказать, а о многом лучше промолчать. Я думаю, эту историю стоит отложить на другой раз».~
@28560 = ~«Падшая Грейс — твоё настоящее имя?»~
@28561 = ~«Ну хорошо. Могу я задать вопрос о другом?»~
@28562 = ~«Тогда прости, что побеспокоил. Прощай».~
@28563 = ~«Возможно, — на её губах играет лёгкая улыбка. — А может быть, и нет. Есть имена, которые дают, а есть и те, которые заслуживают. Кто скажет, какие из них настоящие? Не я».~
@28564 = ~«Ну хорошо. Могу я задать вопрос о другом?»~
@28565 = ~«Тогда прости, что побеспокоил. Прощай».~
@28566 = ~«Путешествовать с тобой? — губ Падшей Грейс касается лёгкая улыбка. — Это довольно прямолинейно». На слова твоих компаньонов она не обращает внимания.~
@28567 = ~«Я стараюсь честно оглашать свои намерения. Ты кажешься мне очень милой и хорошо осведомлённой в отношении планов. Иметь такого знающего компаньона было бы приятно».~
@28568 = ~«Именно так».~
@28569 = ~«Я хочу сказать, насколько волнующим может быть это место?..»~
@28570 = ~«Ты Чующая. И, конечно же, есть предел тому, что ты можешь постигнуть в этом месте».~
@28571 = ~«Тогда забудь о моей просьбе. Могу я вместо этого кое-что спросить?»~
@28572 = ~«Тогда позволь принести извинения. Мне пора идти. Прощай».~
@28573 = ~«Путешествовать с тобой? — губ Падшей Грейс касается лёгкая улыбка. — Это довольно прямолинейно». На слова Анны она не обращает внимания.~
@28574 = ~«Я стараюсь честно оглашать свои намерения. Ты кажешься мне очень милой и хорошо осведомлённой в отношении планов. Иметь такого знающего компаньона было бы приятно».~
@28575 = ~«Я стараюсь честно оглашать свои намерения. Ты кажешься мне очень милой и хорошо осведомлённой в отношении планов. Иметь такого знающего компаньона было бы приятно».~
@28576 = ~«Именно так».~
@28577 = ~«Я хочу сказать, насколько волнующим может быть это место?..»~
@28578 = ~«Ты Чующая. И, конечно же, есть предел тому, что ты можешь постигнуть в этом месте».~
@28579 = ~«Тогда забудь о моей просьбе. Могу я вместо этого кое-что спросить?»~
@28580 = ~«Тогда позволь принести извинения. Мне пора идти. Прощай».~
@28581 = ~«Путешествовать с тобой? — губ Падшей Грейс касается лёгкая улыбка. — Это довольно прямолинейно». На слова Морте она не обращает внимания.~
@28582 = ~«Я стараюсь честно оглашать свои намерения. Ты кажешься мне очень милой и хорошо осведомлённой в отношении планов. Иметь такого знающего компаньона было бы приятно».~
@28583 = ~«Именно так».~
@28584 = ~«Я хочу сказать, насколько волнующим может быть это место?..»~
@28585 = ~«Ты Чующая. И, конечно же, есть предел тому, что ты можешь постигнуть в этом месте».~
@28586 = ~«Тогда забудь о моей просьбе. Могу я вместо этого кое-что спросить?»~
@28587 = ~«Тогда позволь принести извинения. Мне пора идти. Прощай».~
@28588 = ~«И ты не можешь найти десятого ученика? Как забавно».~
@28589 = ~«Думаю, десятый ученик — это я. В этом случае я поговорил со всеми из них».~
@28590 = ~«Думаю, десятый ученик — это я. В этом случае я поговорил со всеми из них».~
@28591 = ~«Я видел под Борделем десять камней, и один был пуст… так что, думаю, проституток здесь всего девять. Тогда десятый ученик — это я. В этом случае я поговорил со всеми из них».~
@28592 = ~«Я думаю, десятый ученик — Луис… по-своему, конечно».~
@28593 = ~«Не скажешь, где мне найти десятого ученика?»~
@28594 = ~«Возможно, одного я проглядел. Могу я задать ещё вопрос?»~
@28595 = ~«Поищу внимательнее, надеюсь, десятый от меня не скроется. До свидания».~
@28596 = ~Она кивает: «Хорошо. И что ты думаешь по этому поводу?»~
@28597 = ~«Мы с тобой должны покинуть это место и исследовать планы. Здесь для нас ничего неизведанного уже нет».~
@28598 = ~«Ученик где-то здесь… возможно, тебе следует поискать внимательнее».~
@28599 = ~«Думаю, десятый ученик — это я. В этом случае я поговорил со всеми из них».~
@28600 = ~«Думаю, десятый ученик — это я. В этом случае я поговорил со всеми из них».~
@28601 = ~«Думаю, десятый ученик — это я. В этом случае я поговорил со всеми из них».~
@28602 = ~«Я думаю, десятый ученик — Луис… по-своему, конечно».~
@28603 = ~«Возможно, одного я проглядел. Могу я задать ещё вопрос?»~
@28604 = ~«Так и поступлю, надеюсь, десятый от меня не скроется. До свидания».~
@28605 = ~Грейс соединяет указательные и большие пальцы обеих рук, образуя грубый круг. «Говорят, сила Госпожи позволяет взять кусочки Сигила… — ты с удивлением наблюдаешь, как призрачные подобия её пальцев отрываются от рук и начинают вращаться в воздухе, образуя небольшой кружок, — …и создать лабиринт».~
@28606 = ~«Продолжай…»~
@28607 = ~«Ясно. Не расскажешь мне больше о плане, откуда родом Рейвел… о Серой Пустоши?»~
@28608 = ~«Думаю, я понял. Может о Рейвел знать кто-нибудь ещё?»~
@28609 = ~«Неважно. Могу я спросить кое о чём другом?»~
@28610 = ~«Ясно. Это всё, что я хотел узнать. Прощай».~
@28611 = ~Небольшой призрачный кружок висит в воздухе и начинает медленно вращаться. «И кусочек Сигила превращается в тюрьму, из которой просто нет выхода. Это может случиться в любой момент, идёшь ли ты по улице или проходишь через дверь… — она хлопает ладонями, — …и вдруг ты где-то в другом месте». Внезапно в центре призрачного круга ты видишь намёк на движение, как будто там кто-то бежит.~
@28612 = ~«Продолжай…»~
@28613 = ~«Ясно. Не расскажешь мне больше о плане, откуда родом Рейвел… о Серой Пустоши?»~
@28614 = ~«Думаю, я понял. Может о Рейвел знать кто-нибудь ещё?»~
@28615 = ~«Неважно. Могу я спросить кое о чём другом?»~
@28616 = ~«Ясно. Это всё, что я хотел узнать. Прощай».~
@28617 = ~Грейс продолжает, маленький призрачный лабиринт отражается в её глазах. «Говорят, есть порталы, которые выводят из любого лабиринта, но их сложно найти. Возможно, они оставлены для того, чтобы дать узнику надежду. Или мучить его, — призрачный лабиринт в её глазах тает. — А может, и то и другое».~
@28618 = ~«Ясно. Не расскажешь мне больше о плане, откуда родом Рейвел… о Серой Пустоши?»~
@28619 = ~«Думаю, я понял. Может о Рейвел знать кто-нибудь ещё?»~
@28620 = ~«Неважно. Могу я спросить кое о чём другом?»~
@28621 = ~«Ясно. Это всё, что я хотел узнать. Прощай».~
@28622 = ~Анна рядом с тобой шипит: «Хс-с-с! Ты кому это тут красивыми словечками мозги полоскаешь? Совсем нюх потерял, а?»~
@28623 = ~«Анна, просто помолчи минутку… я тут кое с кем говорю, хорошо?»~
@28624 = ~«Я всего лишь сказал комплимент, чтобы она простила мою грубость. Успокойся, Анна».~
@28625 = ~Анна сплёвывает: «Ты просто разыгрываешь из себя галантного болвана, и ты дурак дважды, поскольку выделываешься перед извергом! Готовишься в курятник отправиться, ага?»~
@28626 = ~«Она — демон, суккуб и никто больше! Всего лишь хочет затащить твою душу на один из Нижних планов и всё, болван!»~
@28627 = ~Анна ожесточается и вполголоса бормочет: «Кому ты говоришь идти с нами, а? Нам не нужно отребье вроде неё, никому из нас!»~
@28628 = ~Анна ожесточается и вполголоса бормочет: «Кому ты говоришь идти с нами, а? Нам не нужно отребье вроде неё, никому из нас!»~
@28629 = ~«Тебе б лучше захлопнуть шкатулку, череп, а не то так тресну, что зубы у шпиля собирать придётся!»~
@28630 = ~«Звучит глуповато».~
@28631 = ~«Она танар'ри… суккуб, шеф».~
@28632 = ~«Задвинься, демонёныш! — Морте щёлкает зубами. — Я ЗА то, чтобы суккуб шла с нами… а вот *ты*, видят силы, так же приятна, как колючка в кишечнике».~
@28633 = ~«Эй, погоди! *Я* тут лучше всех осведомлён о планах! Это моя работа, шеф!»~
@28634 = ~«Сдаётся мне, двое сведущих о планах для нашей славной компании — отличная находка. А кроме того, я ещё сказал „милой“, Морте».~
@28635 = ~«Возможно, милой на вид! А по МНЕ, так просто какая-то девчонка показала немного гладкой кожи, и вот ты уже бежишь за ней, высунув язык, — Морте умолкает. — Не то чтобы я особенно протестовал, просто посчитал нужным упомянуть».~
@28636 = ~«Принято, Морте. Послушай… госпожа Грейс, прости, если я немного прямолинеен, но не отказалась бы ты попутешествовать с нами?»~
@28637 = ~«То, что мой израненнный компаньон хотел сказать, ДВОЕ из нас… кстати, я — Морте, прошу извинить грубость моего товарища, который нас не представил… так вот, двое из нас были бы СЧАСТЛИВЫ видеть тебя в своей компании. Для суккубов у нас ВСЕГДА найдётся место…»~
@28638 = ~Назад в игру~
@28639 = ~На самом деле стереть сохранённую игру?~
@28640 = ~Стереть~
@28641 = ~Готово~
@28642 = ~Название игры содержит недопустимые символы, нельзя использовать следующие: . , ? : \< \> | * / \\ "~
@28643 = ~Название игры неправильное. Перепишите название.~
@28644 = ~Перезаписать~
@28645 = ~Сохра-
нить~
@28646 = ~Игра успешно сохранена~
@28647 = ~Пусто~
@28648 = ~Загру-
зить~
@28649 = ~СОХРАНЕНИЕ~
@28650 = ~Женщина кивает в знак приветствия, но жестом призывает помолчать.~
@28651 = ~Под каким именем сохранить игру?~
@28652 = ~ЗАГРУЗИТЬ~
@28653 = ~Оставить женщину в покое.~
@28654 = ~«Да, по-моему, он неплохой поэт».~
@28655 = ~«Неважно. У меня кое-какие вопросы…»~
@28656 = ~«У меня кое-какие вопросы…»~
@28657 = ~«Только побыстрее, покрытый шрамами. Я не могу ждать тебя весь день».~
@28658 = ~Лотар холодно смотрит на тебя в упор, а потом делает небольшое движение, и ты вдруг начинаешь исчезать.~
@28659 = ~«Ты пришёл, чтобы вернуть себе пустомелю? Мне надоело его бесконечное нытьё».~
@28660 = ~Взгляд Лотара становится суровым. «Ты всё равно получишь его назад, — взмахом руки Лотар освобождает Морте, тот тут же исчезает с полки. — Найдёшь его наверху, недалеко от входа в мои владения». Он отворачивается: «Прощай».~
@28661 = ~Взмахом руки Лотар освобождает Морте, тот тут же исчезает с полки. «Найдёшь его наверху, недалеко от входа в мои владения, — он отворачивается. — Прощай».~
@28662 = ~«Я вижу, ты вернулся. Принёс мне череп?»~
@28663 = ~«Тогда я советую найти его, если ещё тешишь себя надеждой узнать то, что хочешь, и вернуть себе общество своего болтливого псевдомимира».~
@28664 = ~«Итак? Ты принёс нужный мне череп взамен твоего?» — Лотар криво усмехается.~
@28665 = ~«Тогда иди. Я бы не советовал возвращаться, пока не найдёшь его».~
@28666 = ~«Что бы это могло значить? Это захоронение настолько хорошо защищено от всяческого проникновения и наблюдения через магический кристалл, что представляет проблему даже для меня! Должно же быть какое-то объяснение этого, и… — он выговаривает слова медленно и злобно. — ТЫ мне его предоставишь. Пройди через портал в пещерах внизу и найди ответ».~
@28667 = ~«Снова ты? — старик слегка пошатывается, пристально глядя на тебя. — Что тебе нужно от старого Лотара теперь? Я уже ответил на все твои вопросы. Предупреждаю, я не собираюсь тратить на тебя весь день». Его тяжёлый взгляд падает на тебя, словно кувалда.~
@28668 = ~«Я вижу, ты вернулся. Принёс мне череп?»~
@28669 = ~«Тогда я бы посоветовал тебе вернуться в катакомбы и найти себе новый, м-м?»~
@28670 = ~«Итак? Ты нашёл череп, которым расплатишься за мои ответы на вопросы?»~
@28671 = ~«А! Посетитель! Что привело тебя в мою скромную обитель без приглашения?»~
@28672 = ~«Но ты же не думаешь, что можешь войти в Кости Ночи без приглашения и так просто выйти отсюда? Мальчик мой, я торгую здесь ответами и, клянусь силами, я получу один от тебя, или твоя голова будет украшать мою полку в числе прочих».~
@28673 = ~«У тебя есть всего один шанс ответить мне до того, как я сам вырву ответ из твоего оскаленного черепа».~
@28674 = ~Глаза старика сверкают, и он нараспев произносит замысловатую фразу из таинственных слов. Твоё тело стискивает боль. Тьма окутывает тебя…~
@28675 = ~Вспышка света и дым на мгновение ослепляют тебя, а затем перед тобой оказывается сморщенный старик: «Похоже, у нас гости, череп?»~
@28676 = ~«За все ответы, за все заклинания есть цена. В твоём случае… — старик на мгновение замолкает. — Черепа — вот моя валюта. Я задаю им вопросы, а мёртвые отвечают. Мёртвые накапливают много знаний за свою жизнь. Чем ценнее череп, тем больше вопросов я могу задать и тем могущественней заклинания, которые я смогу сколдовать для тебя».~
@28677 = ~Глаза Лотара сверкают опасным светом: «Это была не просьба».~
@28678 = ~«Даю тебе последний шанс, кусок рубленного мяса, перед тем как я решу забрать взамен ТВОЙ череп».~
@28679 = ~Старик игнорирует Морте: «Привет тебе, путник. Кем ты себя возомнил, что являешься в скромную обитель Лотара без приглашения?»~
@28680 = ~«Похитил? Твоего друга? Я такими делами не занимаюсь. Где этот твой друг?»~
@28681 = ~«Похитил? Твоего друга? Я такими делами не занимаюсь. Где этот твой друг?»~
@28682 = ~«Можешь пройти или через Дом Мысли, который контролируется черепокрысами, или же через Мёртвые Народы, которые охраняют толпы ходячих мёртвых. Затем минуешь сырые владения Затопленных Народов и найдёшь захоронение этого безымянного господина. У закалённого… приключенца… вроде тебя… не должно быть с этим никаких трудностей. Сдвинь этот диван и пройди в катакомбы через портал у восточной стены пещер внизу. Портал останется активным и позволит тебе вернуться тем же путём. Как только принесёшь мне череп, я отвечу на твои вопросы».~
@28683 = ~«М-м? Да? И что же это?»~
@28684 = ~«Ты хочешь этот болтливый череп, лишённый всякого изящества и манер? Хорошо, вот тебе справедливая сделка: принеси мне более ценный череп, — отвечает он. — Я не собираюсь разбазаривать то, что и так принадлежит мне».~
@28685 = ~ПУСТОЙ УЗЕЛ ДОЛОЖИТ КОЛИНУ, ЕСЛИ ПОПАДЁТСЯ ТЕБЕ~
@28686 = ~«Сдвинь диван в центре комнаты и пройди в катакомбы через портал у восточной стены пещер внизу. Портал останется активным и позволит тебе вернуться тем же путём. В катакомбах много черепов. Один из самых ценных находится в скрытой усыпальнице Пыльных за Затопленными Народами. Принеси мне его — мои ручные крысы-оборотни не смогли это сделать — и твой друг к тебе вернётся. Возможно, я даже отвечу на некоторые твои вопросы».~
@28687 = ~«У тебя есть моё слово. Этого вполне достаточно. Конечно, если тебе нужен твой дружок…»~
@28688 = ~«Твоё невежество просто поразительно. Ты поистине знаешь очень мало об очень малом. Итак, принеси мне другой череп в обмен на этот или можешь попрощаться со своим другом».~
@28689 = ~Руки Лотара сжимаются на посохе. «Этот череп МОЙ. Если будешь и дальше настаивать, то я и твой заберу!»~
@28690 = ~«Череп говорит мудро. Прислушайся к нему».~
@28691 = ~Лотар поднимает череп и тщательно его изучает. «Тьфу! Этот ничего не стоит. Он не может сообщить мне ничего нового. Мне нужен по-настоящему ценный череп, чтобы оправдать трату на тебя моего времени. Исчезни!»~
@28692 = ~Глаза Лотара горят яростью: «Убиваешь моих слуг, да? Дай мне череп». Он тщательно осматривает череп и говорит: «Я чую через его кость запах предательства. Осторожный проныра, но всё же недостаточно осторожный, м-м? Я вытащу из него его секреты. Не беспокойся, я узнаю причину его двуличия». Он скрещивает пальцы в магическом жесте: «Твой приятель будет ожидать тебя наверху, откуда ты вошёл ко мне. У тебя есть ко мне вопросы?»~
@28693 = ~Лотар берёт череп и критически его осматривает. «Харгримм, говоришь? Лидер Мёртвых Народов? Он знает много и скажет много. Это хорошая сделка, — он скрещивает пальцы в магическом жесте. — Твой приятель будет ожидать тебя наверху, откуда ты вошёл ко мне. У тебя есть ко мне вопросы?»~
@28694 = ~Лотар берёт у тебя голову Тухлой Мэри, сдирает с неё излишки плоти и внимательно изучает. «Предводительница зомби Мёртвых Народов, говоришь? Этого будет достаточно, — он скрещивает пальцы в магическом жесте. — Твой приятель будет ожидать тебя наверху, откуда ты вошёл ко мне. У тебя есть ко мне вопросы?»~
@28695 = ~Лотар берёт у тебя голову Акасты, сдирает с неё излишки плоти и внимательно изучает. «Королева упырей? Этого будет достаточно, — он скрещивает пальцы в магическом жесте. — Твой приятель будет ожидать тебя наверху, откуда ты вошёл ко мне. У тебя есть ко мне вопросы?»~
@28696 = ~Лотар берёт у тебя голову Соэго и внимательно осматривает, особое внимание уделяя зубам. «Миссионер Пыльных и шпион, м-м? Этого будет достаточно, — он скрещивает пальцы в магическом жесте. — Твой приятель будет ожидать тебя наверху, откуда ты вошёл ко мне. У тебя есть ко мне вопросы?»~
@28697 = ~Лотар берёт у тебя череп Безмолвного Короля и мягко покачивает его в руках: «Безмолвный Король, да? Это просто великолепно!» Он тихо шепчет черепу: «Ты расскажешь мне все свои секреты, мой новый друг». Он скрещивает пальцы в магическом жесте: «Твой приятель будет ожидать тебя наверху, откуда ты вошёл ко мне. У тебя есть ко мне вопросы?»~
@28698 = ~Лотар берёт череп и критически его осматривает: «Харгримм, говоришь? Лидер Мёртвых Народов? Он знает много и скажет много. Это хорошая сделка. У тебя есть ко мне вопросы?»~
@28699 = ~Лотар берёт у тебя голову Тухлой Мэри, сдирает с неё излишки плоти и внимательно изучает: «Предводительница зомби Мёртвых Народов, говоришь? Этого будет достаточно. У тебя есть ко мне вопросы?»~
@28700 = ~Лотар берёт у тебя голову Акасты, сдирает с неё излишки плоти и внимательно изучает: «Королева упырей? Этого будет достаточно. У тебя есть ко мне вопросы?»~
@28701 = ~Лотар берёт у тебя голову Соэго и внимательно осматривает, особое внимание уделяя зубам: «Миссионер Пыльных и шпион, м-м? Этого будет достаточно. У тебя есть ко мне вопросы?»~
@28702 = ~Лотар берёт у тебя череп Безмолвного Короля и мягко покачивает его в руках: «Безмолвный Король, да? Это просто великолепно! У тебя есть ко мне вопросы?» Он тихо шепчет черепу: «Ты расскажешь мне все свои секреты, мой новый друг».~
@28703 = ~«Твоя смертность — или душа, если так будет угодно, которая позволяет жить и умирать, — похищена у тебя. Она была магическим образом отторгнута от тебя ночной ведьмой по имени Рейвел Клубок-Загадок. Твоя смертность — ключ к твоему существованию. Ты найдёшь ответы на все свои вопросы, когда вновь обретёшь её».~
@28704 = ~«Это побочный эффект того, что ты потерял свою смертность».~
@28705 = ~«Рейвел Клубок-Загадок — загадка даже в сравнении с другими ночными ведьмами. Некоторые называют её безумной, другие же считают, что она просто играет в игры, правила которых недоступны пониманию окружающих. Она — зло. Великое зло. Даже изверги в сравнении с ней покажутся божьими агнцами. Слава силам, сейчас она вне всякой досягаемости: Госпожа Боли заточила её в свой лабиринт».~
@28706 = ~«Лабиринты подобны карманным измерениям: просто небольшие пространства между планами. Чтобы войти, понадобится найти портал и ключ к нему. Я не знаю, где дверь и ключ. Возможно, тебе придётся встретиться с некоторыми из своих старых знакомых. Можешь даже не сомневаться, что они у тебя есть. Они и сами найдут тебя. И молись, чтобы они приняли тебя хорошо. Возможно, ответы на свои вопросы ты сможешь найти в Фестхолле».~
@28707 = ~«Я не давал тебе позволения говорить, череп! — зловещие звуки его голоса приводят Морте в ступор. — Покрытый шрамами, если хочешь вернуть себе череп, ты должен достать мне более ценный череп из катакомб под нами. Этот уже мой, так что торга не будет. Либо принимай предложение, либо нет».~
@28708 = ~«Она придумывала игры и головоломки, решала проблемы, которые не требовали решения. Она решила, что Сигил — или Клетка — это самая большая головоломка из всех, и она обязана распутать её, используя для этого армии демонов. Без сомнения, Рейвел нарушила бы равновесие в городе, просто превратив его в большой склеп. Стоит восхвалить все силы, какие только есть, что у неё ничего не вышло».~
@28709 = ~«Шеф, ты тут, спасибо силам. Вытащи меня отсюда!»~
@28710 = ~«Те паразиты крысы-оборотни притащили меня сюда! Ну же, шеф… вытащи меня! Это место просто ужасно!»~
@28711 = ~«Я не могу! Я устал! Давай, вытащи меня, пока…»~
@28712 = ~«Не шути так, шеф… нам надо убираться отсюда, пока…»~
@28713 = ~«О-о… нет! — яростно шепчет тебе Морте. — НЕ СТОИТ раздражать этого типа, шеф… он упрячет тебя в книгу мёртвых быстрее, чем моргнуть успеешь».~
@28714 = ~В разговор вступает Морте. Его голос звучит напугано, жалко и очень почтительно. Очевидно, по мнению Морте, Лотар не тот, кому стоит переходить дорогу: «Он имеет в виду меня. Просто дайте мне уйти, господин, и всё пойдёт своим чередом. Как вода под Дитчем, а?»~
@28715 = ~В разговор вступает Морте: «Он имеет в виду меня. Просто дайте мне уйти, господин, и всё пойдёт своим чередом. Как вода под Дитчем, а?»~
@28716 = ~«Для меня этого вполне достаточно, шеф! Всё-таки именно мне тут торчать. Предложение принято, а? Просто достань череп и возвращайся за мной, ладно?»~
@28717 = ~«Шеф, нет! Он тебя просто размажет! — голос Морте сильно дрожит от страха. — Он один из главных тузов во всей долбаной Клетке!»~
@28718 = ~«Шеф, не надо! Брось!»~
@28719 = ~«Что ты тут делаешь?»~
@28720 = ~«Зачем?»~
@28721 = ~«Я работаю над этим, Морте. Скоро всё будет в порядке».~
@28722 = ~«Почему бы тебе просто не слететь оттуда?»~
@28723 = ~«Не знаю, ты так уютно там смотришься, среди других черепов».~
@28724 = ~«Хорошо. Лотар, я вернусь за ним. Прощай».~
@28725 = ~«А для МЕНЯ — нет, Морте. Я буду за него сражаться, Лотар».~
@28726 = ~«Ему же хуже. Отдай череп мне, Лотар».~
@28727 = ~«Ладно. Я за ним ещё приду, Лотар».~
@28728 = ~«Просто хотел поболтать ещё».~
@28729 = ~~
@28730 = ~«Расскажи мне о Рейвел Клубок-Загадок».~
@28731 = ~«Почему я бессмертен?»~
@28732 = ~«Почему я бессмертен?»~
@28733 = ~«Почему я потерял память?»~
@28734 = ~~
@28735 = ~«Постой…»~
@28736 = ~«Нет, можешь его оставить».~
@28737 = ~«Да. Отдай мне его».~
@28738 = ~«Спасибо, шеф, я просто очень тебе благодарен». Его голос окрашен сарказмом. «Я тут пока сидел, научился одной интересной штучке».~
@28739 = ~«Правда? Это в твоём духе, шеф. Хорошая идея. Ты условно прощён. Только не повторяй это снова».~
@28740 = ~«Почему-то я не особенно тебе верю. Давай забудем, как будто этого не было вовсе. Пошли».~
@28741 = ~«Спасибо, шеф. Давай поскорей уберёмся отсюда! — Морте прерывается. — О, кстати, шеф, у тех парней головы и правда в порядке были. Они научили меня кое-каким колкостям».~
@28742 = ~~
@28743 = ~«Точно. Рад видеть тебя снова».~
@28744 = ~«Прости, друг. Я просто блефовал».~
@28745 = ~«Прости, друг. Я просто блефовал».~
@28746 = ~«Конечно, Морте. Пошли».~
@28747 = ~«Отлично».~
@28748 = ~«Морте, я просто блефовал, поверь».~
@28749 = ~«Пошли».~
@28750 = ~Кандриан рассказал мне о плане Карцери — Величайшей Тюрьме планов. Он поведал, что единственный способ сбежать из тюрьмы — оказаться сильнее тюремщика. Кроме того, он сказал, что узы этого плана крепче уз плоти.~
@28751 = ~Кандриан рассказал мне о какой-то головоломке из кубов посреди Лимбо, которая выглядела островком порядка в бурлящем море хаоса.~
@28752 = ~Кандриан рассказал мне о своём путешествии на Негативный материальный план, в место, где энергия бытия сходит на нет.~
@28753 = ~После того, как Кандриан вывел Ингресс из Сигила, он передал мне её прощальный подарок — танцующие зубы. Восхитительно.~
@28754 = ~Я поговорил с Кандрианом об Ингресс, и он сказал, что сопроводит её домой. Он велел передать ей, чтобы она его подождала, после чего мы должны встретиться с ним в «Горящем трупе».~
@28755 = ~«Расскажи мне об основных правилах».~
@28756 = ~Кви-Сай, мастер боевых искусств Фестхолла, отказался тренировать меня со словами, что я слишком слаб. Может, стоит вернуться к нему позже, набравшись сил.~
@28757 = ~«У меня есть человеческий череп».~
@28758 = ~«У меня есть череп крысы-оборотня».~
@28759 = ~«У меня есть череп Харгримма, скелета-священника Мёртвых Народов».~
@28760 = ~«У меня есть череп Тухлой Мэри, предводительницы зомби Мёртвых Народов».~
@28761 = ~«У меня есть череп Акасты, лидера мятежных упырей».~
@28762 = ~«У меня есть череп крысы-оборотня Соэго, миссионера Пыльных».~
@28763 = ~«У меня есть череп Безмолвного Короля, владыки Мёртвых Народов».~
@28764 = ~«У меня есть череп Мантуока».~
@28765 = ~«Хорошо, я вернусь».~
@28766 = ~«В гробнице не было черепа, Лотар».~
@28767 = ~«Ещё нет».~
@28768 = ~«Хорошо».~
@28769 = ~«У меня нет ответа. Откуда мне знать?»~
@28770 = ~«Я бы хотел получить ответы ещё на кое-какие вопросы».~
@28771 = ~«Просто хотел поболтать ещё».~
@28772 = ~«Спасибо, ничего. Прощай».~
@28773 = ~«У меня есть человеческий череп».~
@28774 = ~«У меня есть череп Мантуока».~
@28775 = ~«У меня есть череп Харгримма, скелета-священника Мёртвых Народов».~
@28776 = ~«У меня есть череп Тухлой Мэри, предводительницы зомби Мёртвых Народов».~
@28777 = ~«У меня есть череп Акасты, лидера мятежных упырей».~
@28778 = ~«У меня есть череп крысы-оборотня Соэго, миссионера Пыльных».~
@28779 = ~«У меня есть череп Безмолвного Короля, владыки Мёртвых Народов».~
@28780 = ~«У меня есть череп крысы-оборотня».~
@28781 = ~Настройки видео~
@28782 = ~«Ладно, ладно».~
@28783 = ~«В гробнице не было черепа, Лотар».~
@28784 = ~«Ещё нет».~
@28785 = ~«Кто ты?»~
@28786 = ~«Что это за место?»~
@28787 = ~«Кто ты?»~
@28788 = ~«Хочу посмотреть, как ты попытаешься, старик».~
@28789 = ~«Торгуешь ответами? Тогда скажи мне, кто я? И почему я бессмертен?»~
@28790 = ~НАСТРОЙКИ ВИДЕО~
@28791 = ~«Я так не думаю. Прощай».~
@28792 = ~«Тогда я пришёл сюда для того, чтобы купить ответы».~
@28793 = ~«И у тебя есть только один шанс сдохнуть самому до того, как я тебя убью».~
@28794 = ~«Акх…»~
@28795 = ~«И?»~
@28796 = ~Его губы искривляет отвратительная усмешка: «*Воры* и *воровство* будут всегда! Я участвовал в пяти кампаниях на Войне Лжи как оперативный разведчик. Разведчик — вот моё звание… *разведчик*. Я учу методам скрытности и шпионажа, а не простому воровству».~
@28797 = ~«А я говорю, забудь об этом».~
@28798 = ~«Ладно-ладно. Принесу я тебе череп».~
@28799 = ~«Ну так попробуй, Лотар».~
@28800 = ~«Ладно, не злись. Принесу я череп».~
@28801 = ~«Ты похитил моего друга. Отдай его обратно, сейчас же».~
@28802 = ~«Ты похитил моего друга. Отдай его обратно, сейчас же».~
@28803 = ~«Прости, уважаемый, но у тебя, похоже, есть кое-что, принадлежащее мне».~
@28804 = ~«Я был там и не нашёл в склепе никакого тела».~
@28805 = ~«Я вернусь».~
@28806 = ~«Череп, который принадлежит мне, лежит на той полке».~
@28807 = ~«Мой друг Морте находится на той полке».~
@28808 = ~~
@28809 = ~«Начнём с того, что он никогда не был твоим… или вообще чьим-либо…»~
@28810 = ~«Он мой».~
@28811 = ~«И где мне найти более ценный череп?»~
@28812 = ~«Хорошо. И где мне найти более ценный?»~
@28813 = ~«Он мой».~
@28814 = ~«Начнём с того, что он никогда не был твоим».~
@28815 = ~Ингресс замолкает. «Моя… хотеть идти. Хотеть УХОДИТЬ из этого места».~
@28816 = ~Ингресс ничего не говорит, просто кивает, а зубы её стучат друг об друга.~
@28817 = ~Ингресс настороженно смотрит, как ты приближаешься. «Кан-дри-а?»~
@28818 = ~Кви-Сай, инструктор боевых искусств Фестхолла, обучил меня мастерскому владению молотом. Теперь я специалист в этом оружии.~
@28819 = ~Кви-Сай, мастер боевых искусств Фестхолла, рассказал мне о «Пути Камня». Хотя я существо из плоти и большая часть этой странной философии ко мне неприменима, я всё же могу использовать её для того, чтобы сделать своё тело менее уязвимым в бою.~
@28820 = ~Кви-Сай, мастер боевых искусств Фестхолла, пытался обучить меня «Пути Камня». Однако эта философия чересчур чужда мне и слишком сложна для постижения.~
@28821 = ~Яннис раздражал меня при нашей последней встрече, так что пришлось его немного придушить, пока он не замолк.~
@28822 = ~Яннис раздражал меня при нашей последней встрече, так что пришлось его немного придушить, пока он не замолк. Вместе с этим убийством пришло некоторое прояснение памяти… но недостаточно сильное, чтобы уловить. Одно очевидно — мне приходилось душить других и раньше.~
@28823 = ~Мне удалось обмануть одноухого тифлинга-головореза, и он отдал мне вилку Нестора. Говорил, что его преследуют духи и жаловался на какие-то голоса в голове… М-да, он столь же безумен, как и старик.~
@28824 = ~Я встретил одноухого тифлинга, прячущегося в тенях около большой арки на севере Улья. Что-то в его глазах подсказало мне, что он не тот, с кем можно шутки шутить.~
@28825 = ~Я вернул Нестору вилку. Похоже, вилка была своего рода ключом от портала. Когда она оказалась в его руках, Нестор смог вернуться туда, откуда прибыл. Интересно, сколько времени бедняга прозябал в Сигиле без возможности вернуться домой?~
@28826 = ~Я забрал наследство Дейонарры у её нервного отца. Его тон мне не понравился — лучше бы ему следить за языком, а не то он окончит свои дни точно так же, как и его дочь.~
@28827 = ~Я забрал наследство Дейонарры у её отца.~
@28828 = ~Я забрал своё наследство у адвоката Янниса из района Клерков. Среди вещей обнаружилась какая-то странная квитанция… она выглядит очень старой. Яннис говорит, что это «расписка из Кузницы». Это значит, что я имел какие-то дела с Боготами. По словам Янниса, эта расписка даст мне доступ в Великую Кузницу в Нижнем районе.~
@28829 = ~Яннис сказал, что единственный способ разорвать договор с Пыльными — это уничтожить его.~
@28830 = ~Очевидно, Яннис — адвокат. Он даёт консультации, занимается делами о наследстве и представляет дела в суде.~
@28831 = ~Я встретил мужчину по имени Яннис, который работает в районе Клерков. У меня чувство, что этого человека я откуда-то знаю, но не понимаю, откуда.~
@28832 = ~Маг по имени Квелл сказал, что ключом к порталу, ведущему в лабиринт Рейвел, может быть часть самой Рейвел, как это ни странно звучит.~
@28833 = ~В частном сенсориуме Фестхолла я встретил с мага по имени Квелл. Он продаёт разного рода магический шоколад, каждая плитка которого заряжена каким-то магическим эффектом. Эффект проявляется после того, как шоколад съеден.~
@28834 = ~Я сказал Ингресс, что Кандриан придёт и проводит её обратно домой. Я встречусь с ним в «Горящем трупе» чтобы убедиться, что всё прошло нормально.~
@28835 = ~Обезумевшая Ингресс настолько боится любого места, которое МОЖЕТ оказаться порталом, что живёт как собака, прямо на улицах города. У меня нет к ней ни капли симпатии… но всё же если я встречу опытного путешественника по планам, который знает портал, доставивший Ингресс сюда, то я вернусь к ней и расскажу об этом.~
@28836 = ~Ингресс в западне из-за боязни порталов… её печальный опыт путешествий по планам оставил ей ужас перед *всем*, что может быть похожим на портал. Если бы мне удалось найти здесь опытного путешественника по планам, то, быть может, я смог бы попробовать вернуть её домой.~
@28837 = ~Ингресс переместилась в этот город через одну из дверей на её родном плане… она случайно открыла портал, напевая мелодию на поляне около двух засохших деревьев, упавших друг на друга. Ингресс прошла через портал и с тех пор не может найти дорогу обратно.~
@28838 = ~Ингресс предупредила меня о «дверях», которые находятся повсюду в городе. Она утверждает, что дверью может оказаться любое ограниченное пространство — рама картины, арка, ниша, окно… любой объект, через который можно пройти, может оказаться порталом, если к нему приблизиться, имея при себе ключ. А ключом может быть всё, что угодно — физическое или не физическое: гвоздь, трижды пришедшая в голову мысль, стеклянная роза, эмоция… всё что угодно может открыть дверь-портал, ведущий неведомо куда.~
@28839 = ~Я встретил искалеченную женщину по имени Ингресс в городе за пределами Мортуария. Она была ужасно напугана. Нет сомнений, что полученные ей раны сильно отразились на её рассудке.~
@28840 = ~«Прости, что побеспокоил тебя, Ингресс. Желаю удачи».~
@28841 = ~«Его имя Кандриан. Он должен скоро прийти и помочь… доверься ему, хорошо?»~
@28842 = ~«Я вернусь в бар „Горящий труп“, встречусь с Кандрианом и удостоверюсь, что всё в порядке. Будь сильной, Ингресс».~
@28843 = ~«Нет, я не Кандриан… он должен прийти и помочь тебе, а я встречусь с ним позже, в баре „Горящий труп“, и выясню, как у тебя дела. Будь сильной, Ингресс».~
@28844 = ~«Нет, я не Кандриан… Кандриан просто взял и помер. К счастью, это означает, что ты и Кандриан однажды встретитесь. Прощай».~
@28845 = ~*Вздох*~
@28846 = ~«Почему я охраняю сломанную машину?»~
@28847 = ~«Что за пустая трата времени».~
@28848 = ~«Что за пустая трата времени».~
@28849 = ~«Многовато для оружия».~
@28850 = ~«БОГОТЫ ЗНАЮТ, ЧТО ДЕЛАЮТ»~
@28851 = ~«ПЫЛЬНЫЕ ДУМАЮТ, ЧТО ЖИЗНЬ — ЭТО ШУТКА»~
@28852 = ~«ОНИ ПРОСТО ПОЛНЫ СОМНЕНИЙ»~
@28853 = ~«Хорошо. Я вернусь, и ты отдашь мне Морте. До встречи».~
@28854 = ~«Хорошо. Где мне достать другой череп, который будет для тебя ценным?»~
@28855 = ~«Просто верни его назад. Он мой».~
@28856 = ~«Хорошо, но как мне найти более ценный череп?»~
@28857 = ~«Я так не думаю. Верни его назад или в полной мере насладишься последствиями».~
@28858 = ~«Ладно, ладно».~
@28859 = ~«У меня много вопросов».~
@28860 = ~«У меня много вопросов».~
@28861 = ~«У меня много вопросов».~
@28862 = ~«У меня много вопросов».~
@28863 = ~«У меня много вопросов».~
@28864 = ~«У меня много вопросов».~
@28865 = ~«У меня много вопросов».~
@28866 = ~«У меня много вопросов».~
@28867 = ~«У меня много вопросов».~
@28868 = ~«У меня много вопросов».~
@28869 = ~«У меня много вопросов».~
@28870 = ~«Расскажи мне об этой Рейвел».~
@28871 = ~«Кто это?»~
@28872 = ~«Я потерял свою смертность? Что это значит?»~
@28873 = ~«Я потерял свою смертность? Что это значит?»~
@28874 = ~«Она заточена в лабиринте? И как же мне её найти?»~
@28875 = ~«Что она натворила?»~
@28876 = ~«Ясно, спасибо. Прощай, Лотар».~
@28877 = ~«А что Рейвел натворила?»~
@28878 = ~«Спасибо, Лотар. Прощай».~
@28879 = ~~
@28880 = ~«Начнём с того, что он никогда не был твоим… или вообще чьим-либо…»~
@28881 = ~«Он мой».~
@28882 = ~«И где мне найти более ценный череп?»~
@28883 = ~«Тогда я найду её и силой заставлю вернуть мою смертность. Прощай».~
@28884 = ~Спасбросок успешен: против смерти~
@28885 = ~Спасбросок успешен: против жезлов~
@28886 = ~Спасбросок успешен: против превращения~
@28887 = ~Спасбросок успешен: против дыхания~
@28888 = ~Спасбросок успешен: против заклинания~
@28889 = ~Спасбросок провален: против жезлов~
@28890 = ~Спасбросок провален: против магии~
@28891 = ~Спасбросок провален: против превращения~
@28892 = ~Спасбросок провален: против дыхания~
@28893 = ~Спасбросок провален: против заклинания~
@28894 = ~Спасбросок провален: против смерти~
@28895 = ~Исцеление:~
@28896 = ~Грейс отвечает поклоном и улыбкой: «Вы очень добры, сэр».~
@28897 = ~Статуя не реагирует.~
@28898 = ~Статуя не реагирует.~
@28899 = ~Ты прикасаешься к статуе и обнаруживаешь, что хотя надетая на ней одежда и выглядит похожей на камень, но она скорее из серой ткани, а «кожа» холодна и тверда, как гранит.~
@28900 = ~Статуя никак не реагирует на твой вопрос.~
@28901 = ~«Статуя» двигается — слегка, почти незаметно, но она определённо кивает.~
@28902 = ~«Статуя» столь же молчалива, как и всегда.~
@28903 = ~По-прежнему нет ответа.~
@28904 = ~Глаза статуи открываются, и она пристально на тебя смотрит своими холодными серыми глазами. Она говорит тяжеловесно, как будто два камня трутся друг об друга: «Твоё терпение… замечено. Кви-Сай теперь… поговорит… с тобой».~
@28905 = ~Глаза статуи открываются, и она пристально на тебя смотрит своими холодными серыми глазами. Она говорит тяжеловесно, как будто два камня трутся друг об друга: «Твоё терпение… замечено. Кви-Сай теперь… поговорит… с тобой».~
@28906 = ~Как только ты начинашь думать, что тебя не слышали, он отвечает: «Спрашивай».~
@28907 = ~Через некоторое время статуя говорит: «Спрашивай».~
@28908 = ~«Меня зовут… Кви-Сай».~
@28909 = ~«Кви-Сай… размышляет. Кви-Сай… также тренирует… других в искусстве… боя».~
@28910 = ~Он осматривает тебя с головы до ног, с низким скрежетом поворачивая голову. Наконец он с *треском* отрывает от своего пальца ноготь. «Кви-Сай хочет посмотреть… как ты сломаешь этот камень», — он протягивает тебе осколок живого камня.~
@28911 = ~Как ты ни стараешься, сломать камень не удаётся. «Кви-Сай находит тебя… неприспособленным… слишком слабым… для тренировки искусству боя», — он отбирает у тебя каменную пластинку, кладёт её в рот и с неприятным хрустом пережёвывает.~
@28912 = ~С большим трудом, но тебе всё-таки удаётся сломать осколок камня пополам. Он забирает у тебя кусочки, после чего кладёт их в рот и медленно, с неприятным хрустом пережёвывает. «Кви-Сай находит тебя вполне… приемлемым для обучения. Однако скажи… зачем… тебе подготовка?»~
@28913 = ~«Кви-Сай не находит… нужды… в драке».~
@28914 = ~«Кви-Сай хочет сказать… что есть много способов… победить. Кто-то может… украсть оружие противника… чтобы лишить его… защиты».~
@28915 = ~«Кви-Сай не видит… нужды. Ты не смог убедить Кви-Сая… в ином. Наверное, тебе стоит поговорить… с учителем воров, здесь… неподалёку. Он может предоставить тебе другую… точку зрения по этому вопросу».~
@28916 = ~Спустя какое-то время он кивает: «Кто-то может… спрятаться. Если кто-то невидим… то на него нельзя напасть. Он становится… неуязвимым».~
@28917 = ~После паузы он кивает: «Могучие заклинания… могут уничтожить противника… быстрее… чем любой клинок».~
@28918 = ~Он слегка улыбается, вызывая низкий скрежет в горле: «Кви-Сай находит тебя… приемлемым для обучения. Встреть Кви-Сая… в зале тренировок».~
@28919 = ~Как только ты пытаешься ударить статую, глаза у той мигом открываются и каменная рука крепко хватает тебя за запястье. Пронзая тебя взглядом холодных серых глаз, «статуя» произносит с каменным скрежетом: «Зачем… ты пытаешься… ударить Кви-Сая?»~
@28920 = ~Он медленно кивает, нахмурившись: «Ты… прощён. Хотя… я нахожу тебя недостаточно… терпеливым».~
@28921 = ~«Кви-Сай не собирался… кого-либо дурачить. Кви-Сай… находит тебя… нетерпеливым… и грубым».~
@28922 = ~Он снова закрывает глаза и умолкает.~
@28923 = ~«Кви-Сай из расы… которую называют… принцы камня. Кви-Сай… генаси земли».~
@28924 = ~Он с гордостью кивает: «Отец Кви-Сая… создание стихии земли… дао. Мать… человеческая женщина… знатного сословия. Вот что значит… генаси земли».~
@28925 = ~«Ничего».~
@28926 = ~«Это Фестхолл. Если нужно знать больше… найди других… спроси их».~
@28927 = ~Статуя стоит на прежнем месте, как обычно недвижна и молчалива.~
@28928 = ~«Статуя» стоит на прежнем месте, как обычно недвижна и молчалива.~
@28929 = ~«Кви-Сай приветствует тебя».~
@28930 = ~«Не… разговаривай. Иди… в тренировочный зал».~
@28931 = ~Он встречает тебя холодным гранитным взглядом: «Ты пришёл сюда… чтобы Кви-Сай тренировал тебя?»~
@28932 = ~«А ты… воин по профессии?»~
@28933 = ~«Кви-Сай знаток… всех видов оружия, не специалист… ни в одном… но мастер во многих. Чему бы ты хотел… научиться у Кви-Сая?»~
@28934 = ~«Ты не можешь больше учиться… пока. Возвращайся к… Кви-Саю… когда станешь… более опытным».~
@28935 = ~«Тогда Кви-Сай будет… учить тебя».~
@28936 = ~«Кви-Сай… польщён… что ты его… ученик. Ты очень быстро… учишься».~
@28937 = ~После оценки твоих умений он покачивает головой: «Кви-Сай находит тебя уже искусным в этом… виде боя. Кви-Сай не может… научить большему. Если хочешь… ещё чему-то научиться… найди Корура в Нижнем районе».~
@28938 = ~«Кви-Сай будет учить тебя… искусству боя… кулаками. Это то, чему ты… хочешь научиться?»~
@28939 = ~«Кви-Сай будет учить тебя… искусству боя… клинками. Это то, чему ты… хочешь научиться?»~
@28940 = ~«Кви-Сай будет учить тебя… искусству боя… булавами. Это то, чему ты… хочешь научиться?»~
@28941 = ~«Кви-Сай будет учить тебя… искусству боя… топорами. Это то, чему ты… хочешь научиться?»~
@28942 = ~«Кви-Сай будет учить тебя… искусству боя… большим молотом. Это то, чему ты… хочешь научиться?»~
@28943 = ~После проверки твоих умений он издаёт низкий рокочущий звук: «Кви-Сай находит, что ты… способен ещё многому научиться… в обращении с большим молотом».~
@28944 = ~«Кви-Сай должен тебе сказать… что как только ты станешь мастером… молота… тебе будет закрыт путь… к мастерству в другом оружии. Ты… согласен?»~
@28945 = ~Кви-Сай слегка кривит рот: «Тогда Кви-Сай не может… ничему научить тебя».~
@28946 = ~Левая бровь Кви-Сай очень медленно ползёт вверх: «Желаешь ли ты… оставить свою профессию, чтобы ступить… на путь воина?»~
@28947 = ~«Кви-Сай размышляет… о Пути Камня».~
@28948 = ~Кви-Сай кивает: «Философия. Метод… вести бой. Кви-Сай ищет способ достичь… неуязвимости».~
@28949 = ~«Да. Сейчас… Путь пока ещё… несовершенен. Но Кви-Сай… однажды закончит его. Кви-Сай… знает это».~
@28950 = ~Кви-Сай кивает: «Никто не спрашивал… Кви-Сай может поделиться… знанием Пути. Кви-Сай поделится… им прямо сейчас». Он начинает свой рассказ, медленно и старательно подбирая слова…~
@28951 = ~После долгих часов рассказа Кви-Сая и множества вопросов, которые ты задаёшь ему, до тебя начинает медленно доходить сущность философии Пути Камня. Отныне ты можешь использовать эти знания для того, чтобы улучшить свой класс защиты и гораздо эффективнее отражать удары противника.~
@28952 = ~Ты слушаешь Кви-Сая на протяжении нескольких часов и задаёшь великое множество вопросов, но всё равно не понимаешь Пути Камня. Его концепция кажется тебе слишком сложной и чуждой для постижения.~
@28953 = ~«Приветствую?..»~
@28954 = ~«Приветствую?..»~
@28955 = ~«Маг по имени Салабеш говорил, здесь есть человек из камня. Это ты?»~
@28956 = ~«Приветствую… ты Кви-Сай?»~
@28957 = ~Прикоснуться к статуе.~
@28958 = ~Уйти.~
@28959 = ~«Маг по имени Салабеш говорил, здесь есть человек из камня. Это ты?»~
@28960 = ~Прикоснуться к статуе.~
@28961 = ~Уйти.~
@28962 = ~«М-м… шеф? Тебе ведь приходилось раньше видеть статуи, верно? Знаешь, что они не говорят?»~
@28963 = ~«Ну… э-э… хм-м-м. Подловил, шеф».~
@28964 = ~«Может, она просто слишком натуралистична местами, а, шеф?»~
@28965 = ~«Конечно, шеф. Я так и подумал».~
@28966 = ~Морте закатывает глаза и изображает подступающую рвоту: «О силы, нет! Только не ещё один пень с базаром… как… у этого!»~
@28967 = ~«Задумайся-ка, Морте: ты ведь сам летающий и говорящий череп, а возможность живых статуй отрицаешь».~
@28968 = ~«Маг по имени Салабеш говорил, здесь есть человек из камня. Это ты?»~
@28969 = ~«Может быть, и так. Я просто хочу его потрогать».~
@28970 = ~Уйти.~
@28971 = ~«Маг по имени Салабеш говорил, здесь есть человек из камня. Это ты?»~
@28972 = ~«Именно, Морте. Я просто хочу его потрогать».~
@28973 = ~Уйти.~
@28974 = ~«Это был риторический вопрос, Морте».~
@28975 = ~«Маг по имени Салабеш говорил, здесь есть человек из камня. Это ты?»~
@28976 = ~Ударить статую.~
@28977 = ~Уйти.~
@28978 = ~«У меня вопросы о тебе…»~
@28979 = ~«У меня вопросы об этом месте».~
@28980 = ~«Что ты знаешь о Рейвел Клубок-Загадок?»~
@28981 = ~«Поговорим позже. Прощай».~
@28982 = ~«Хм. Зачем кому-то одевать статую?»~
@28983 = ~«Хм. Зачем кому-то одевать статую?»~
@28984 = ~«Маг по имени Салабеш говорил, здесь есть человек из камня. Это ты?»~
@28985 = ~Ударить статую.~
@28986 = ~Уйти.~
@28987 = ~«Маг по имени Салабеш говорил, здесь есть человек из камня. Это ты?»~
@28988 = ~Ударить статую.~
@28989 = ~Уйти.~
@28990 = ~«Хорошо. У меня вопросы…»~
@28991 = ~«Я так и думал. Прощай».~
@28992 = ~«Эй? Можно кое о чём спросить?»~
@28993 = ~«Хм. Тогда пока».~
@28994 = ~Подождать.~
@28995 = ~Продолжить ждать.~
@28996 = ~Сдаться и уйти.~
