@50177 = ~«Что он сказал, Дак'кон?»~
@50178 = ~«Что он сказал, Грейс?»~
@50179 = ~«Он говорит, что он „дабус“, — Грейс делает паузу. — Редко встретишь дабуса, у которого вообще было бы имя… по крайней мере то, что мы могли бы назвать именем. Кажется, они более склонны использовать символы».~
@50180 = ~«Можешь задать ему другой вопрос?»~
