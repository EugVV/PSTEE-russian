@22087 = ~Похороненная
деревня~
@22088 = ~Двор Фарода~
@22089 = ~Мортуарий — 1-й этаж~
@22090 = ~Мортуарий — 2-й этаж~
@22091 = ~Мортуарий — 3-й этаж~
@22092 = ~Бар «Собиратели пыли»~
@22093 = ~Склеп~
@22094 = ~Мавзолей~
@22095 = ~Аллея Опасных Углов~
@22096 = ~Центр контроля за паразитами~
@22097 = ~Подвал центра контроля за паразитами~
@22098 = ~Небольшое жилище~
@22099 = ~Улица Протяжных Вздохов~
@22100 = ~Бар «Горящий труп»~
@22101 = ~Логово головорезов~
@22102 = ~Мастерская татуировщика Фелла~
@22103 = ~Нижний район~
@22104 = ~Внутри Осадной Башни~
@22105 = ~Она моргает, затем кивает: «А, эта рыба… она очень странная, ага. Немногие о ней слыхали, и совсем мало кому она по вкусу… сложно убить, и даже убитая она как живая. Не очень-то хочется есть то, что всё ещё извивается».~
@22106 = ~«Ага… но если будут чернила, тебе ж придётся их в чём-то нести, так? У тя есть чашка или кубок?»~
@22107 = ~Она кивает и сдёргивает рыбу с шеста… как только она её хватает, та дёргается, затем начинает извиваться, пока торговка выжимает её как тряпку. Наконец из жабр рыбы начинает сочиться чёрно-синяя сукровица. Когда твоя кружка почти полна, торговка ослабляет хватку и бросает дёргающуюся рыбу в мешок рядом с собой.~
@22108 = ~«Ты слышала о *брогота-фин*? Мне сказали, что её жаберную кровь можно использовать в качестве чернил».~
@22109 = ~«Ты слышала о *брогота-фин*? Мне сказали, что её жаберную кровь можно использовать в качестве чернил».~
@22110 = ~Кузница~
@22111 = ~Зал Боготов~
@22112 = ~«Ты слышала о *брогота-фин*? Мне сказали, что её жаберную кровь можно использовать в качестве чернил».~
@22113 = ~Рынок~
@22114 = ~Ломбард~
@22115 = ~Лавка гробовщика~
@22116 = ~«Ты слышала о *брогота-фин*? Мне сказали, что её жаберную кровь можно использовать в качестве чернил».~
@22117 = ~Разрушенный дом~
@22118 = ~Кости Ночи~
@22119 = ~Типография~
@22120 = ~«У тебя она есть?»~
@22121 = ~Товарный склад~
@22122 = ~Квартиры Боготов~
@22123 = ~Литейный цех оружейников~
@22124 = ~«Отлично, я схожу и поищу — а потом вернусь».~
@22125 = ~Район Клерков~
@22126 = ~«Отлично, я схожу и поищу — а потом вернусь».~
@22127 = ~«Хм-м. Или кружка… может, кто-то из торговцев продаёт. До свидания».~
@22128 = ~Фестхолл~
@22129 = ~«Спасибо и прощай».~
@22130 = ~Публичный сенсориум~
@22131 = ~Частный сенсориум~
@22132 = ~Бордель~
@22133 = ~Подвал Борделя~
@22134 = ~Дом адвоката~
@22135 = ~Галерея искусств~
@22136 = ~«Да, у меня кое-какие вопросы…»~
@22137 = ~Магазинчик странностей~
@22138 = ~Лабиринт Рейвел~
@22139 = ~Портной~
@22140 = ~Аптека~
@22141 = ~Керст~
@22142 = ~Тюрьма~
@22143 = ~«Я принёс кружку. Можно в неё налить чернил из рыбы?»~
@22144 = ~Таверна «Врата предателей»~
@22145 = ~Зернохранилище~
@22146 = ~Подземелье Керста~
@22147 = ~Пропавший Керст~
@22148 = ~Карцери~
@22149 = ~«Я принёс кружку. Можно в неё налить чернил из рыбы?»~
@22150 = ~Администрация Керста~
@22151 = ~Товарный склад Керста~
@22152 = ~Баатор~
@22153 = ~«Я принёс кружку. Можно в неё налить чернил из рыбы?»~
@22154 = ~Колонна Черепов~
@22155 = ~Внешние Земли~
@22156 = ~Дом Фьюлла~
@22157 = ~«Я принёс кружку. Можно в неё налить чернил из рыбы?»~
