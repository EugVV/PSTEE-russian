@50191 = ~«Это всё, что я хотел знать. Прощай».~
@50192 = ~«Что он сказал, Грейс?»~
@50193 = ~«Он говорит, что выполняет свои обязанности, — она поворачивается к тебе. — Большую часть времени они чинят и разбирают участки города. Они местные смотрители во многих отношениях».~
@50194 = ~«Можешь задать ему другой вопрос?»~
@50195 = ~«Это всё, что я хотел знать. Прощай».~
