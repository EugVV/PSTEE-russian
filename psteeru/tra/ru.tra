@54359 = ~~
@54360 = ~~
@54361 = ~~
@54362 = ~~
@54363 = ~Дэв поворачивает голову и останавливает взгляд на Морте: «От тебя исходит сильное зловоние Баатора, череп».~
@54364 = ~«У тебя отвратительная компания, смертный… но задавай свои вопросы и оставь меня предаваться воспоминаниям о рае».~
@54365 = ~«Ведьма Рейвел сказала мне разыскать тебя».~
@54366 = ~«Я слышал об эпидемии, вспыхнувшей, когда открыли эту тюрьму».~
@54367 = ~«Что это за место?»~
@54368 = ~«Кто ты?»~
@54369 = ~«Воспоминаниям о рае?»~
@54370 = ~«Это твой меч? Он находился в центре тюрьмы».~
@54371 = ~«Забудь. Прощай».~
@54372 = ~«Ты привёл *танар'ри*, — это слово он шипит, — ко *мне*?»~
@54373 = ~«Что, её выдают крылья?»~
@54374 = ~«Ну да. А почему бы и нет?»~
@54375 = ~«Очередная просьба?»~
@54376 = ~«Ведьма Рейвел сказала мне разыскать тебя».~
@54377 = ~«Я слышал об эпидемии, вспыхнувшей, когда открыли эту тюрьму».~
@54378 = ~«Что это за место?»~
@54379 = ~«Кто ты?»~
@54380 = ~«Ты упоминал воспоминания о рае?»~
@54381 = ~«Это твой меч? Он находился в центре тюрьмы».~
@54382 = ~«Что случилось с твоими крыльями?»~
@54383 = ~«Забудь. Прощай».~
@54384 = ~На миг он выглядит ошеломлённым. «Небесный огонь? Ты вернул мой меч? Неужели ты освободишь меня? Тогда руби цепи!»~
@54385 = ~«Сперва ответь на кое-какие вопросы…»~
@54386 = ~Разрубить цепи.~
@54387 = ~Напасть на дэва.~
@54388 = ~«Не сейчас. Прощай».~
@54389 = ~«Рейвел… Рейвел… её имя будоражит мою память, но… нет, не помню. Эти цепи подобны тёмным водам Стикса: чем дольше они на мне, тем меньше я помню. Если бы я обрёл свободу, то мог бы удовлетворить твоё любопытство».~
@54390 = ~«Как тебя освободить?»~
@54391 = ~«Тогда я вернусь позже. До свидания».~
@54392 = ~Триас сказал, что его освободит только добрый поступок — в нашем случае надо отыскать его меч и разрубить им его цепи.~
@54393 = ~«Тому виной их собственные деяния. Выковав эти цепи для меня, они укрепили связь между ожесточением и предательством. Близорукость привела их к падению; прислушайся они к моим предупреждениям, этого бы не случилось, — великая печаль переполняет его глаза. — Моё сердце преисполнено жалости к ним».~
@54394 = ~«Как ты сюда попал?»~
@54395 = ~«Как можно разбить эти цепи и остановить эпидемию?»~
@54396 = ~«У меня к тебе другие вопросы…»~
@54397 = ~«До свидания… пока что».~
@54398 = ~«Ты на нейтральной территории Внешних Земель, в стенах города-врат Керста, дома изменников и предателей, города, ограждающего план-тюрьму Карцери. Ты погребён в недрах тюрьмы, в клетке Триаса Приговорённого, поверженного и заключённого здесь, пока кто-то не освободит меня своим добрым, милосердным и справедливым поступком».~
@54399 = ~«Расскажи мне о Керсте».~
@54400 = ~«Расскажи мне о Карцери».~
@54401 = ~«Как ты был повержен?»~
@54402 = ~«Как тебя освободить?»~
@54403 = ~«У меня к тебе другие вопросы…»~
@54404 = ~«Я — Триас Приговорённый, Триас Израненный, потерянное дитя Элизиума, генерал войск Верхних планов».~
@54405 = ~«Что это за место?»~
@54406 = ~«Как ты сюда попал?»~
@54407 = ~«Верхних планов?»~
@54408 = ~«Приговорённый?»~
@54409 = ~«Это всё, что осталось мне в этом месте. Так что же тебе нужно от меня, смертный? Говори как на духу и уходи».~
@54410 = ~«У меня к тебе пара вопросов…»~
@54411 = ~«Как ты сюда попал?»~
@54412 = ~«Что ты можешь рассказать об этом рае?»~
@54413 = ~«Забудь. Прощай».~
@54414 = ~«Смертный, я отвечу на любые твои вопросы, как только ты освободишь меня и мой разум. Теперь разруби цепи и верни мне меч!»~
@54415 = ~Разрубить цепи.~
@54416 = ~Напасть на дэва.~
@54417 = ~Уйти.~
@54418 = ~«Да?»~ [TTB003C]
@54419 = ~«У меня снова вопросы».~
@54420 = ~Разрубить цепи.~
@54421 = ~Напасть на дэва.~
@54422 = ~Уйти.~
@54423 = ~Лезвие в твоих руках вспыхивает белым огнём, когда ты ударяешь им дэва. Он умирает с ужасающим криком… в его крике слышен глас целого умирающего мира, и ты беспомощно чувствуешь, что совершил непоправимую ошибку.~
@54424 = ~«Дело сделано…»~
@54425 = ~Цепи легко распадаются под ударом меча, и громовой звук отдаётся в твоих ушах. На мгновение всё погружается в темноту, и ты чувствуешь, как клинок в твоей ладони исчезает.~
@54426 = ~Ждать…~
@54427 = ~«Меня освободит добрый поступок. Мой меч — моя душа — проводник подобной доброты. Принеси мне меч и разруби им мои цепи. Он хранится где-то в тюрьме, в закрытом охраняемом зале. Я знаю сочетание для входа, — он произносит три загадочных слога, огнём отдающихся в твоей памяти. — Освободи меня, и я буду… в долгу у тебя. Возможно, я помогу тебе в твоих поисках».~
@54428 = ~«Это твой меч? Он находился в центре тюрьмы».~
@54429 = ~«Тебе что-то известно о моих поисках?»~
@54430 = ~«Был предан в городе, известном предательствами. Думал, я смогу пролить здесь свет добра, спасти немного душ из ловушек, куда они сами себя загнали. Вместо этого я был пойман моими бывшими сторонниками и против воли заключён в этот подземный пузырь без луча света».~
@54431 = ~«Как тебя освободить?»~
@54432 = ~«У меня к тебе ещё вопросы…»~
@54433 = ~«Что ж, удачи. Прощай».~
@54434 = ~Тень пробегает по его лицу: «Боюсь, я никогда больше не увижу их, идеальную красоту Аркадии, аллеи Элизиума, Семь Вершин горы Селестии… всё уродство Нижних планов изглаживается там, где воистину можно поверить в искупление. Боюсь, слишком многие смотрят лишь на Нижние планы в поисках вдохновения и поднятия духа…»~
@54435 = ~«Что ты можешь рассказать мне об Аркадии?»~
@54436 = ~«Что ты можешь рассказать мне об Элизиуме?»~
@54437 = ~«Что ты можешь рассказать мне о горе Селестии?»~
@54438 = ~«Ясно… у меня другие вопросы…»~
@54439 = ~«Возможно. Прощай».~
@54440 = ~«Я был воителем в войсках Верхних планов. Теперь же я покорён и похоронен под этим омерзительным городом. Я хочу снова летать, улететь далеко отсюда, далеко от этих цепей, что сковывают мои движения, каждый миг напоминая о моём порабощении».~
@54441 = ~«Что ты можешь поведать об этих цепях?»~
@54442 = ~«Как тебя освободить?»~
@54443 = ~«Но твои крылья обгорели, ты не можешь летать».~
@54444 = ~«У меня другие вопросы…»~
@54445 = ~«Удачи тебе. Прощай».~
@54446 = ~Он печально улыбается. «Ты носишь отметины от них на своём лице и в своём сердце. Если эти цепи будут сняты с меня… то я смогу прочувствовать твою цель глубже, направить тебя вернее. До тех же пор… — дэв пожимает плечами. — До тех пор я не могу даже дать тебе хорошего совета. Эти цепи подавляют память и интуицию».~
@54447 = ~«Хорошо. Я найду твой меч. До свидания».~
@54448 = ~Его лицо темнеет, потом освещается состраданием: «Город предателей, изменивших себе и другим. Никому здесь нельзя доверять, и каждый старается вовлечь всех остальных в свои запутанные интриги… даже те, кто хочет лишь добра».~
@54449 = ~«Что ты можешь рассказать о Карцери?»~
@54450 = ~«Как ты был предан?»~
@54451 = ~«У меня к тебе другие вопросы…»~
@54452 = ~«Ясно. Прощай».~
@54453 = ~«Это тюрьма планов, план, где даже силы бессильны перед предательством. Немногие покидают его, а те, кому это удалось, уходят изменившимися».~
@54454 = ~«Расскажи мне о Керсте».~
@54455 = ~«Как ты был предан?»~
@54456 = ~«У меня к тебе другие вопросы…»~
@54457 = ~«Ясно. Прощай».~
@54458 = ~«Это было частью великого предательства: едва меня поймали, мне опалили крылья, чтобы я не сбежал даже сквозь землю. Такова природа этого места, что красота здесь нетерпима».~
@54459 = ~«Ясно. У меня ещё вопросы…»~
@54460 = ~«Ясно. Прощай».~
@54461 = ~«Упорядоченный рай, где всё имеет своё место и назначение — не то что хаос и беспорядок этих нижних миров. Рай структур, каких ты никогда не видывал».~
@54462 = ~«Что ты можешь рассказать об Элизиуме?»~
@54463 = ~«Что ты можешь рассказать о горе Селестии?»~
@54464 = ~«У меня другие вопросы…»~
@54465 = ~«Благодарю тебя. Прощай».~
@54466 = ~«Спокойный план, план мирного отдыха, где приливы и отливы хаоса и порядка омывают обитателей добром. Леса, зелёные поля, все они не просто эхо красоты, а *сама* красота. Это место не похоже на другие. Оно вершина доброты и милосердия».~
@54467 = ~«Что ты можешь рассказать об Аркадии?»~
@54468 = ~«Что ты можешь рассказать о горе Селестии?»~
@54469 = ~«У меня другие вопросы…»~
@54470 = ~«Благодарю тебя. Прощай».~
@54471 = ~«Семь Вершин Добра и Порядка, план, на котором всё залито тёплым светом справедливости и милосердия. Идеал. Где обитатели стремятся к правосудию и состраданию, а не довольствуются играми в тени идеалов. Сами идеалы поддерживаются, а не служат пищей для толков и пересудов».~
@54472 = ~«Что ты можешь рассказать мне об Аркадии?»~
@54473 = ~«Что ты можешь рассказать мне об Элизиуме?»~
@54474 = ~«У меня другие вопросы…»~
@54475 = ~«Благодарю тебя. Прощай».~
@54476 = ~«Эти цепи таковы, что сковывают меня, не удерживая. Они заглушают воспоминания, погружают их в стоячие воды, так что мои знания медленно утекают и теряются. Я не могу разорвать цепи своими силами… только бессмертная божественная сила, поступок, исполненный справедливости и милосердия, может разбить их».~
@54477 = ~«И что это за сила?»~
@54478 = ~«Понятно, у меня другие вопросы…»~
@54479 = ~«Ясно. Прощай».~
@54480 = ~«Меня не завлечь тому, кто путешествует с извергами. Танар'ри, несмотря на гибкость твоих форм, я не буду для тебя такой же лёгкой мишенью, как этот смертный. Говори, что у тебя на уме, и оставь Триаса в его заключении».~
@54481 = ~«Ты красноречива, танар'ри, как и все тебе подобные. Задавай свои вопросы, смертный, и уходи».~
@54482 = ~«Я не смертный».~
@54483 = ~«Меня к тебе послала ведьма Рейвел. Она сказала, что ты знаешь о моей похищенной смертности».~
@54484 = ~«Я слышал об эпидемии, вспыхнувшей, когда открыли эту тюрьму».~
@54485 = ~«Что это за место?»~
@54486 = ~«Кто ты?»~
@54487 = ~«Это твой меч? Он находился в центре тюрьмы».~
@54488 = ~«Что случилось с твоими крыльями?»~
@54489 = ~«Забудь. Прощай».~
@54490 = ~Дэв заливается чистым серебристым смехом: «Как скажешь, смертный. Что тебе нужно от меня?»~
@54491 = ~«Меня к тебе послала ведьма Рейвел. Она сказала, что ты знаешь о моей похищенной смертности».~
@54492 = ~«Я слышал об эпидемии, вспыхнувшей, когда открыли эту тюрьму».~
@54493 = ~«Что это за место?»~
@54494 = ~«Кто ты?»~
@54495 = ~«Это твой меч? Он находился в центре тюрьмы».~
@54496 = ~«Что случилось с твоими крыльями?»~
@54497 = ~«Забудь. Прощай».~
@54498 = ~«Рейвел… ведьма… похищенная смертность… всё это звучит очень знакомо, но, боюсь, я не смогу ничего вспомнить, пока эти цепи сковывают меня».~
@54499 = ~«Почему нет?»~
@54500 = ~«Как можно разорвать цепи?»~
@54501 = ~«Почему тебя заточили?»~
@54502 = ~«Тому виной их собственные деяния. Выковав эти цепи для меня, они укрепили связь между ожесточением и предательством. Близорукость привела их к падению; прислушайся они к моим предупреждениям, этого бы не случилось, — великая печаль переполняет его глаза. — Моё сердце преисполнено жалости к ним».~
@54503 = ~«Что ты можешь поведать о своих цепях?»~
@54504 = ~«Как можно разорвать эти цепи?»~
@54505 = ~«У меня ещё вопросы…»~
@54506 = ~«Это? Это подземелье под городом-вратами Керстом, порталом в Карцери, план-тюрьму богов. Это дом предателей, ожесточившихся и осуждённых… заслужили ли они свой приговор или нет».~
@54507 = ~«Я — Триас Приговорённый, некогда генерал войск Верхних планов. А ныне чахнущий в тесном пузыре под самым несчастным из городов-врат».~
@54508 = ~«Что это за место?»~
@54509 = ~«Как ты сюда попал?»~
@54510 = ~На миг он выглядит ошеломлённым. «Небесный огонь? Ты вернул мой меч? Неужели ты освободишь меня? Тогда руби цепи!»~
@54511 = ~«Сперва ответь на кое-какие вопросы…»~
@54512 = ~Разрубить цепи.~
@54513 = ~Напасть на дэва.~
@54514 = ~«Не сейчас. Прощай».~
@54515 = ~«Это было частью великого предательства: едва меня поймали, мне опалили крылья, чтобы я не сбежал даже сквозь землю. Такова природа этого места, что красота здесь нетерпима».~
@54516 = ~«У меня к тебе ещё вопросы…»~
@54517 = ~«Ясно. Прощай».~
@54518 = ~«Эти цепи лишают меня куда большего, чем свободы передвижений. В моей памяти хранятся обширные знания, но сила цепей подавляет память».~
@54519 = ~«Как можно разорвать цепи?»~
@54520 = ~«Если бы я по-прежнему обладал тем, что причитается мне по положению, то легко избавился бы от цепей. Мой клинок, Небесный огонь, хранится в тенях этого города, усиливая эту жалкую тюрьму. Если бы только я смог взять его в руки… то снова обрёл бы свободу. Он хранится где-то в этой грязной тюрьме, в закрытом охраняемом зале. Дверь заперта, но я знаю сочетание для входа, — он произносит три загадочных слога, огнём отдающихся в твоей памяти. — Вернись с клинком, разруби сковывающие меня цепи, и моя восстановленная память послужит нам обоим».~
@54521 = ~«Это твой меч? Он находился в центре тюрьмы».~
@54522 = ~«Жители этого города, поголовно предатели, ничего не знают о красоте и правде. Не переносят их. Меня заманили сюда и заковали. Смертные не понимают возможностей, которые открываются тем, кто вырастает над своими желаниями, чему я желал научить их».~
@54523 = ~«Опять?»~
@54524 = ~«Меня к тебе послала ведьма Рейвел. Она сказала, что ты знаешь о моей похищенной смертности».~
@54525 = ~«Я слышал об эпидемии, вспыхнувшей, когда открыли эту тюрьму».~
@54526 = ~«Что это за место?»~
@54527 = ~«Кто ты?»~
@54528 = ~«Это твой меч? Он находился в центре тюрьмы».~
@54529 = ~«Что случилось с твоими крыльями?»~
@54530 = ~«Забудь. Прощай».~
@54531 = ~Усмешка прорезает его прекрасное лицо: «Конечно, госпожа танар'ри, ты не веришь в то, что у смертных могут быть хоть какие-то перспективы? Нет, поскольку такова ты есть: сама твоя природа требует подавления у смертных малейшего шанса перерасти свои низменные инстинкты».~
@54532 = ~«Ладно, хватит. У меня ещё вопросы, Триас».~
@54533 = ~«Хватит. До свидания, Триас».~
@54534 = ~Его глаза мечут молнии: «Силы небесные позволили своим сердцам дрогнуть, ибо не осмелились напрямую противостоять извергам. Где их дух, где их любовь к непорочности? Мои повелители направляли ход войны издалека, управляя извергами, сражавшимися с другими, поставляя им оружие и вкладывая в головы знания о том, как больнее убивать других, чтобы они были заняты и не поднимали голов на наши золотые поля».~
@54535 = ~«Это можно как-то изменить?»~
@54536 = ~«Ясно. У меня другие вопросы…»~
@54537 = ~Триас задумывается, но его обожжённые крылья слегка трепещут. «Есть пути изменить мышление даже бессмертных владык, смертный. Когда-нибудь они прозреют, сомнений быть не может».~
@54538 = ~«Ясно. У меня другие вопросы…»~
@54539 = ~«Ясно. Прощай».~
@54540 = ~«Смертный, я отвечу на любые твои вопросы, как только ты освободишь меня и мой разум. Теперь разруби цепи и верни мне меч!»~
@54541 = ~Разрубить цепи.~
@54542 = ~Напасть на дэва.~
@54543 = ~Уйти.~
@54544 = ~Цепи легко распадаются под ударом меча, и громовой звук отдаётся в твоих ушах. На мгновение всё погружается в темноту, и ты чувствуешь, как клинок в твоей ладони исчезает.~
@54545 = ~Ждать…~
@54546 = ~Лезвие в твоих руках вспыхивает белым огнём, когда ты ударяешь им дэва. Он умирает с ужасающим криком… в его крике слышен глас целого умирающего мира, и ты беспомощно чувствуешь, что совершил непоправимую ошибку.~
@54547 = ~«Дело сделано…»~
@54548 = ~«У тебя очередной вопрос?»~ [TTB034]
@54549 = ~«Меня к тебе послала ведьма Рейвел. Она сказала, что ты знаешь о моей похищенной смертности».~
@54550 = ~«Я слышал об эпидемии, вспыхнувшей, когда открыли эту тюрьму».~
@54551 = ~«Что это за место?»~
@54552 = ~«Кто ты?»~
@54553 = ~«Это твой меч? Он находился в центре тюрьмы».~
@54554 = ~«Что случилось с твоими крыльями?»~
@54555 = ~«Забудь. Прощай».~
@54556 = ~«Ищешь ли ты власти над умами подобных тебе смертных? Надеешься ли на воплощение желаний? Хочешь ли богатства? Или жаждешь обречь на мучения больше душ?»~
@54557 = ~«Я ищу знаний, а не силы или богатства».~
@54558 = ~«Дай мне силы».~
@54559 = ~«Расскажи мне о богатстве».~
@54560 = ~«Я могу дать тебе силы не больше, чем прибавить мудрости или проницательности. Ибо их не даруют, а лишь заслуживают. Смертных часто губит недостаток понимания».~
@54561 = ~«Тогда дай мне знаний».~
@54562 = ~«Тогда даруй мне богатство».~
@54563 = ~«Так заработай его и узри, как слабеет твой дух с увеличением твоего *богатства*. Не говори со мной языком торговца».~
@54564 = ~«Тогда даруй мне силы».~
@54565 = ~«Тогда даруй мне знаний».~
@54566 = ~«Говори своё желание».~
@54567 = ~«Мою смертность похитили. Я хочу её вернуть».~
@54568 = ~«Забудь. Прощай».~
@54569 = ~Дэв Триас сказал, что изверг по имени Фьюлл Двуличный способен помочь мне в моих поисках. Этот изверг живёт во Внешних Землях и, видимо, чем-то обязан Триасу.~
@54570 = ~«Глупости говоришь. И всё же… кое-кто способен помочь в твоих поисках. Это изверг по имени Фьюлл Двуличный. Он должен помочь, — губы дэва изгибаются в лёгкой улыбке. — На нём обязательство творить добро».~
@54571 = ~«Как к нему попасть?»~
@54572 = ~Я могу покинуть Керст и найти Фьюлла, если возьму звено от разорванной цепи, некогда сковывавшей Триаса, и отыщу портал на севере.~
@54573 = ~«Её залы темны и кажутся пустыми, но, как и ты, она притягивает к себе страдающие души. Подобно тебе, она пуста и одновременно полна отголосков времени. Подобно тебе, это памятник страданиям. Рассказать тебе о тех душах, скиталец?»~
@54574 = ~«Да».~
@54575 = ~«На севере этой тюрьмы находится портал. Ключом к нему является звено разорванной цепи, — он выразительно смотрит на разбросанные у его ног звенья, поднимает одно из них и протягивает тебе. — Подходящий ключ для того, кто покидает Керст».~
@54576 = ~«Благодарю тебя. Прощай».~
@54577 = ~Его окровавленная улыбка ширится: «Они души тех, кто умер вместо тебя. Им пришлось стать тенями, чтобы ты мог жить. Это *твои* тени, тени, что ты отбрасываешь на существование. Они найдут тебя, скиталец, и заставят заплатить за свои страдания. Ты получишь из их рук то, что тебе причитается. Ты и те, кто достаточно глуп, чтобы присоединиться к тебе».~
@54578 = ~«Не сомневаюсь. Что ты можешь сказать мне об этом хранителе?»~
@54579 = ~«Спасибо за ободрение, Триас. Теперь ты умрёшь».~
@54580 = ~«Ещё посмотрим. Что ты будешь делать, если я оставлю тебя, Триас?»~
@54581 = ~«Прощай, смертный. У меня… дела… которые требуют внимания», — он многозначительно смотрит на потолок своей темницы и погружается в землю, словно ныряльщик в океан.~
@54582 = ~Пустой узел~
@54583 = ~«Я сдаюсь, смертный. Моё заточение ослабило меня… я не противник тебе в своём состоянии».~ [TTB120]
@54584 = ~«Триас, даже если бы ты был в наилучшей форме, всё равно ты мне и в подмётки не годишься. Теперь говори всё, что мне нужно знать».~
@54585 = ~«Мне ещё нужны твои знания, Триас. Скажи мне, как попасть в Крепость Сожалений».~
@54586 = ~Убить дэва.~
@54587 = ~«Взгляни на этих несчастных, пытающихся спасти свои жизни и имущество. Я видел: ты ничего не сделал, чтобы помочь им. Твой эгоизм сделал меня сильнее».~
@54588 = ~«Взгляни на этих несчастных, пытающихся спасти свои жизни и имущество. Я видел: ты ничего не сделал, чтобы помочь им. Твой эгоизм сделал меня сильнее».~
@54589 = ~«Зачем ты лгал мне?»~
@54590 = ~«Зачем ты утянул Керст во Внешние Земли?»~
@54591 = ~«Неплохой трюк с этим городом, Триас. Скажи мне, как попасть в Крепость Сожалений, и мы разойдёмся».~
@54592 = ~Напасть на него.~
@54593 = ~~
@54594 = ~~
@54595 = ~~
@54596 = ~~
@54597 = ~~
@54598 = ~~
@54599 = ~«Ты пытался изменить этот город, смертный, но для них уже слишком поздно. Теперь они пожинают плоды своего предательства».~
@54600 = ~«Ты пытался изменить этот город, смертный, но для них уже слишком поздно. Теперь они пожинают плоды своего предательства».~
@54601 = ~«Зачем ты лгал мне?»~
@54602 = ~«Зачем ты утянул Керст во Внешние Земли?»~
@54603 = ~«Неплохой трюк с этим городом, Триас. Скажи мне, как попасть в Крепость Сожалений, и мы разойдёмся».~
@54604 = ~Напасть на него.~
@54605 = ~Триас переводит взгляд на город: «Много хорошего ты сделал за столь короткое время, смертный. Но этого недостаточно, чтобы дать понять этим предателям всю глубину их безрассудства».~
@54606 = ~Триас переводит взгляд на город: «Много хорошего ты сделал за столь короткое время, смертный. Но этого недостаточно, чтобы дать понять этим предателям всю глубину их безрассудства».~
@54607 = ~«Зачем ты лгал мне?»~
@54608 = ~«Зачем ты утянул Керст во Внешние Земли?»~
@54609 = ~«Неплохой трюк с этим городом, Триас. Скажи мне, как попасть в Крепость Сожалений, и мы разойдёмся».~
@54610 = ~Напасть на него.~
@54611 = ~Глаза Триаса светятся, отблеск танцует на лезвии его клинка. «Теперь мы посмотрим, можешь ли ты умереть. По крайней мере ты будешь страдать».~ [TTB118]
@54612 = ~Напасть на него.~
@54613 = ~Ждать.~
@54614 = ~«Мы не договорили!»~
@54615 = ~Напасть на него.~
@54616 = ~Ждать.~
@54617 = ~«Мы не договорили!»~
@54618 = ~«Тебе нужно было направление. Ценой твоей нужды было предательство. С чего же ты взял, что обладаешь правом на всю истину в этой жизни или в следующей? Какая самонадеянность. Несомненно, освободить меня было твоей обязанностью как низшего существа. Я ничего тебе не должен, и это всё, что ты получишь. Я дал тебе даже больше, чем ты заслуживал. Ты и освободил меня, только чтобы помочь самому себе».~
@54619 = ~«Тогда зачем ты утянул Керст во Внешние Земли?»~
@54620 = ~«Город предателей был предан и получил то, что заслуживал. „Зачем“ здесь неуместно. Так было оговорено в моём пакте с Нижними планами. Это высшее добро».~
@54621 = ~«Ты заключил пакт с Нижними планами?»~
@54622 = ~«Высшее добро? Что ещё за высшее добро?»~
@54623 = ~«Кто назначил тебя палачом? Что дало право тебе так поступать?»~
@54624 = ~«Никто не сможет подняться на гору Селестию без армии. Для меня важен состав этой армии. Куда проще нанять подобных существ, чем принуждать их к нападению».~
@54625 = ~«Ты собираешься напасть на гору Селестию с помощью *извергов*? Разве сотрудничество с ними не противоречит твоей природе?»~
@54626 = ~«Ты собираешься напасть на гору Селестию с помощью *извергов*? Разве сотрудничество с ними не противоречит твоей природе?»~
@54627 = ~«Кровь, пролитая армией извергов, будет искуплена праведным гневом Небесного Войска. Те, кто падут, сделают это во имя высшего добра. Этот город падёт во имя высшего добра — уничтожения зла. Малая жертва, затрагивающая лишь тех, кем пожертвуют».~
@54628 = ~«Боюсь, добро не прорастёт из корней зла».~
@54629 = ~«Хорошо. Я не против. Просто скажи мне, как добраться до Крепости Сожалений, и я оставлю тебя наедине с твоей жертвой».~
@54630 = ~«Я *здесь*. Я вижу зло. Я желаю разобраться с ним. Моя *воля* даёт мне право».~
@54631 = ~«Чья-либо воля не даёт ему прав, Триас».~
@54632 = ~«Хорошо. Я не против. Просто скажи мне, как добраться до Крепости Сожалений, и я оставлю тебя наедине с твоей жертвой».~
@54633 = ~Лицо дэва мрачнеет. «Я собираюсь сделать это во имя Добра! — рычит он. — Пока генералы Верхних планов прячутся за золотыми вратами и подкармливают жестокие войны внизу, в которых гибнут невинные, я поставлю их лицом к лицу с теми, кого они боятся до смерти, и через это столкновение мы преодолеем их страх».~
@54634 = ~«Предав свою *родину*?»~
@54635 = ~«И ты запятнаешь поля Добра воплощением зла?»~
@54636 = ~«Должен быть другой путь, Триас».~
@54637 = ~Лицо дэва мрачнеет. «Я собираюсь сделать это во имя Добра! — рычит он. — Пока генералы Верхних планов прячутся за золотыми вратами и подкармливают жестокие войны внизу, в которых гибнут невинные, я поставлю их лицом к лицу с теми, кого они боятся до смерти, и через это столкновение мы преодолеем их страх».~
@54638 = ~«Ты преувеличиваешь их возможности, танар'ри. Идея о том, что час настал, намного сильнее любой армии. И что ты, *искусительница*, знаешь о военной тактике? Твои умения лежат в другой области, — его глаза пробегают по её телу. — Оставь стратегию тем, кто её понимает».~
@54639 = ~«Ты загадка для меня, танар'ри. Я уверен, именно таковой ты желаешь быть», — он снова обращает своё внимание на тебя.~
@54640 = ~«Думаешь, ты сможешь разрешить эту проблему, предав свою *родину*?»~
@54641 = ~«И ты запятнаешь поля Добра воплощением зла?»~
@54642 = ~«Должен быть другой путь, Триас».~
@54643 = ~«Должен быть другой путь, Триас».~
@54644 = ~«Я поведаю тебе о предательстве, человек. Предательство — это отказ от борьбы со злом. Предательство — это трусость, это продажа оружия врагам из страха, что они перестанут убивать друг друга и примутся за нас. Предательство — это отказ служить примером. Предательство — это позволение демонам безумствовать на всех планах, пока зло не поглотит все сердца. Не спрашивай, почему я хочу напасть на гору Селестию и разжечь огонь войны на её уютных склонах. Это не предательство».~
@54645 = ~«Ты хочешь запятнать саму суть добра воплощением зла. Звучит как предательство».~
@54646 = ~«Предательство — это предательство».~
@54647 = ~«Достаточно с меня твоего самодовольства, Триас. Готовься к смерти».~
@54648 = ~«Определений предательства много. Долго надо прожить, чтобы познать их все. Даже твоя жизнь — если бы тебя не преследовало проклятие беспамятства — слишком коротка, чтобы познать все его виды. Такое предательство — это вовсе не предательство».~
@54649 = ~«Что на самом деле случилось с твоими крыльями, Триас?»~
@54650 = ~«Оставь это, Триас, и мы разойдёмся миром».~
@54651 = ~«Хватит, Триас. Защищайся».~
@54652 = ~«Скажи мне, как попасть в Крепость Сожалений, Триас, и я покину тебя».~
@54653 = ~«Огонь Баатора поистине горяч, но он всего лишь свечка в сравнении с гневом отца, — обгорелые остатки его крыльев трепещут. — Нет боли подобной той, что приходит с горы Селестии».~
@54654 = ~«Оставь это, Триас. Ты ещё можешь добиться искупления».~
@54655 = ~«Оставь это, Триас. Ты ещё можешь добиться искупления».~
@54656 = ~«Так ты, значит, падший? Почему же я тогда должен верить твоим словам?»~
@54657 = ~«Неужели твоя глупость столь велика, что ты хочешь испытать своё псевдобессмертие в столкновении с истинным бессмертным? Прочь с дороги, человек, или придётся проверять обоснованность твоих притязаний».~
@54658 = ~«Ты напросился сам, Триас».~
@54659 = ~«Давным-давно я уже не скрещивал с кем-то клинки. Устроим поединок — ты и я».~ [TTB119]
@54660 = ~Напасть на него.~
@54661 = ~Глаза Триаса блестят. «Я так не думаю, смертный. Ты отбрасываешь тени на существование, ты призываешь страдания с небес, и в моей власти пролить на тебя Свет, — белый огонь танцует на его клинке. — Устроим поединок — ты и я».~
@54662 = ~«Хорошо, Триас… но я собираюсь убить тебя».~
@54663 = ~«Я неподсуден тебе, смертный, по крайней мере пока ты живёшь подобной жизнью. Позволь мне поведать тебе о предательстве. Предательство — это трусость, это продажа оружия врагам из страха, что они перестанут убивать друг друга и примутся за нас. Предательство — это отказ служить примером. Предательство — это позволение демонам безумствовать на всех планах, пока зло не поглотит все сердца. Не спрашивай, почему я хочу напасть на гору Селестию и разжечь огонь войны на её уютных склонах. Это не предательство».~
@54664 = ~«Ты хочешь запятнать саму суть добра воплощением зла. Звучит как предательство».~
@54665 = ~«Предательство — это предательство».~
@54666 = ~«Достаточно с меня твоего самодовольства, Триас. Готовься к смерти».~
@54667 = ~Он заглядывает глубоко в твои глаза: «Время искупления прошло, смертный. Мне не о чём жалеть. Если кто-то всерьёз во что-то верит, он должен быть готов предать то, во что верит. Я всерьёз верю в Добро, поэтому решил предать его».~
@54668 = ~«Может, мне удастся убедить тебя передумать…»~
@54669 = ~Он усмехается: «Не тебе говорить об искуплении, смертный. От тебя смердит злом, твои слова — ложь и искушение. Нет, мой план будет претворён в жизнь, и вскоре мы увидим, как пылают Небесные врата».~
@54670 = ~«Тогда наша схватка неизбежна».~
@54671 = ~«Позволим нашему оружию решить, чьи идеи прочнее и лучше обоснованы. Защищайся, смертный».~
@54672 = ~Приготовиться.~
@54673 = ~Напасть на дэва.~
@54674 = ~«Скверна останется ненадолго и будет смыта непорочностью оставшихся. Это жертва во имя высшего добра».~
@54675 = ~«А цена — предательство родины?»~
@54676 = ~«Довольно, Триас. Остановись, или нам придётся сразиться».~
@54677 = ~«Ты, отмеряющий время в человеческих жизнях, осмеливаешься говорить мне, истинному бессмертному, что должен быть другой путь? Я пытался двигаться во многих направлениях, смертный, и этот путь — единственный возможный».~
@54678 = ~«Что на самом деле случилось с твоими крыльями, Триас?»~
@54679 = ~«Довольно, Триас. Остановись, или нам придётся сразиться».~
@54680 = ~«Не говори мне о вероломстве и падении, смертный. Я готов принести в жертву даже себя, дабы Добро восторжествовало».~
@54681 = ~«Это благородно, Триас, но что даёт тебе право?»~
@54682 = ~«Надеюсь, ты готов к самопожертвованию, Триас. А я исполню роль орудия правосудия».~
@54683 = ~«Опусти руку, смертный. Ты пришёл ко мне в поисках знаний, известных мне одному. Никто больше во всех планах не скажет тебе того, что знаю я. Если ты и вправду нуждаешься в этом знании, то тебе придётся пообещать сохранить мне жизнь».~
@54684 = ~«Никаких сделок, Триас. Говори, или я тебя уничтожу, и плевать мне на последствия».~
@54685 = ~«Я сохраню тебе жизнь, если получу нужные мне знания».~
@54686 = ~«Я клянусь сохранить тебе жизнь, если получу нужные мне знания».~
@54687 = ~Убить дэва.~
@54688 = ~Он откашливается сгустком крови: «Прежде чем расскажу, я должен требовать от тебя строгое обещание. Поклянись сохранить мне жизнь».~
@54689 = ~«Никаких сделок, Триас. Говори, или я тебя уничтожу, и плевать мне на последствия».~
@54690 = ~«Я сохраню тебе жизнь, если получу нужные мне знания».~
@54691 = ~«Я клянусь сохранить тебе жизнь, если получу нужные мне знания».~
@54692 = ~Убить дэва.~
@54693 = ~«Ты нуждаешься в этом знании, иначе будешь обречён страдать… вечно».~
@54694 = ~«Я же сказал, *говори*».~
@54695 = ~«Я сохраню тебе жизнь, если получу нужные мне знания».~
@54696 = ~«Я клянусь сохранить тебе жизнь, если получу нужные мне знания».~
@54697 = ~Убить дэва.~
@54698 = ~«Портал, который ты ищешь, находится в торусе над шпилем, в Сигиле, Городе Дверей. Там есть место, куда доставляют мёртвых твоей породы…»~
@54699 = ~«Ты имеешь в виду *Мортуарий*?»~
@54700 = ~«Что служит ключом?»~
@54701 = ~Он тихо смеётся: «У тебя небогатый выбор, смертный. Поклянись или потеряешь это знание навсегда».~
@54702 = ~«Я сохраню тебе жизнь, если получу нужные мне знания».~
@54703 = ~«Я клянусь сохранить тебе жизнь, если получу нужные мне знания».~
@54704 = ~Убить дэва.~
@54705 = ~Ты наносишь ему удар, уродуя прекрасное лицо, ломая его совершенные формы. Умирая, он насмешливо хрипит: «Знай же, ты проклял сам себя. Убив меня, ты лишился последней защиты от ужасов, которые пожрут тебя. Изверг, обманутый мной… теперь свободен…» Его слабый смех замирает, и свет гаснет в его глазах.~
@54706 = ~«Умри же наконец».~
@54707 = ~«Там ты очнулся в последний раз, не так ли? Планы полны подобной иронии судьбы. Ты был так *близок*…»~
@54708 = ~«Что служит ключом?»~
@54709 = ~«Крепость Сожалений скреплена слезами и открыта к подобному зову. Чтобы войти в Крепость, ты должен что-то ей пожертвовать. Когда окажешься около портала, наполни свой разум сожалением, и портал отзовётся на него волной смертельного холода».~
@54710 = ~«И?»~
@54711 = ~Триас Предатель дал мне ключ к Крепости Сожалений. Портал находится где-то в Мортуарии. Я должен наполнить свой разум сожалением, чтобы портал отозвался на мой призыв волной холода. Оказавшись перед порталом, я должен содрать кусок своей кожи и записать на нём слова сожаления кровью из своего левого указательного пальца.~
@54712 = ~«Пока волна холода омывает тебя, ты должен содрать кусок своей кожи и записать на нём слова сожаления кровью из своего левого указательного пальца. Портал откроется, и ты сможешь узнать истину в Крепости Сожалений… и, возможно, встретишься с её хранителем».~
@54713 = ~«Как ты это узнал?»~
@54714 = ~«Что ты можешь рассказать о хранителе Крепости?»~
@54715 = ~«Много союзов заключил я на планах. Мои поиски привели меня в Крепость, где я говорил с повелителем и хранителем её затенённых залов. Вне сомнения, сейчас ты пожелаешь вернуться в Сигил. Кровь на твоих руках послужит ключом к этому порталу; просто шагни в дверь, через которую вошёл сюда, и ты вернёшься».~
@54716 = ~«Что ты можешь рассказать о хранителе?»~
@54717 = ~«Что ты можешь рассказать о Крепости?»~
@54718 = ~«Благодарю, Триас. Теперь ты умрёшь».~
@54719 = ~«Что ты будешь делать, когда я уйду, Триас?»~
@54720 = ~«Он могуществен. Ты не проведёшь его и не сможешь вырвать свою смертность из его ледяной хватки. Твой проигрыш неминуем. Ты берёшься за затею, на какую согласились бы только дураки».~
@54721 = ~«Может, я и дурак, но я узнаю больше об этом хранителе».~
@54722 = ~«Продолжай».~
@54723 = ~«Смертность человека — это компас, ведущий его по жизни. Если получается её удержать как вещь, то о человеке, из которого она была вырвана, можно многое узнать. Твой враг знает о тебе больше, чем когда-либо знал ты сам. Он наблюдал и изучал тебя все эти долгие полужизни. Я заглянул ему в душу. Он не вернёт то, что ты ищешь».~
@54724 = ~«Благодарю, Триас. Теперь ты умрёшь».~
@54725 = ~«Что ты будешь делать, когда я уйду, Триас?»~
@54726 = ~«Но ты поклялся…»~
@54727 = ~«Я солгал».~
@54728 = ~«Я не клялся. Просто сказал, что сохраню тебе жизнь. Теперь я передумал».~
@54729 = ~«Шучу. Что ты будешь делать, когда я уйду, Триас?»~
@54730 = ~«Я должен снова попытаться привести войско к вратам Рая. Меня не возьмут обратно, а иного смысла в моём существовании нет».~
@54731 = ~«Тогда мне придётся остановить тебя. Прямо сейчас».~
@54732 = ~«Триас, неужели ты забыл лицо своего отца?»~
@54733 = ~«Удачи тебе. Прощай».~
@54734 = ~«Удачи тебе. Прощай».~
@54735 = ~«Я проклинаю тебя на жизнь без смысла. Да будешь ты вечно страдать в своей болезненной оболочке и никогда не вспомнишь о радости света и любви. То немногое, что в тебе сохранилось человеческого, погубит тебя, смертный».~
@54736 = ~Прикончить его. «Прощай, Триас».~
@54737 = ~«Ты поклялся сохранить мне жизнь, смертный».~
@54738 = ~«Скажем так, я делаю это во имя высшего добра, Триас».~
@54739 = ~«Я не клялся. Просто сказал, что сохраню тебе жизнь. А теперь понял, что это бессмысленно. Иначе говоря, я передумал».~
@54740 = ~«Ну что ж, попытайся. Но знай, что тебя будут ждать. Прощай, Триас. Пусть твой замысел провалится».~
@54741 = ~«Ну что ж, попытайся. Но знай, что тебя будут ждать. Прощай, Триас. Пусть твой замысел провалится».~
@54742 = ~«Что ты имеешь в виду?»~
@54743 = ~«Верхние планы — оплот справедливости, доброты и красоты. А ещё они обитель прощения. Иди домой. Признай свои ошибки и моли о прощении».~
@54744 = ~«Верхние планы — оплот справедливости, доброты и красоты. А ещё они обитель прощения. Иди домой. Признай свои ошибки и моли о прощении».~
@54745 = ~«Забудь. Прощай, Триас».~
@54746 = ~«Забудь. Прощай, Триас».~
@54747 = ~Он открывает рот для гневного ответа… и замирает, раздумывая. Потом склоняет голову: «Твои слова убедительны, смертный, и их мудрость сразила меня. Я буду просить прощения у отцов и приму любое наказание, какое они выберут. Возьми это и прощай, смертный. Когда мы встретимся в следующий раз, надеюсь, я буду прощён».~
@54748 = ~«Удачи тебе, Триас. Прощай».~
@54749 = ~«Удачи тебе, Триас. Прощай».~
@54750 = ~Я уговорил Триаса искать прощения на Верхних планах.~
@54751 = ~Я уговорил Триаса искать прощения на Верхних планах… а потом на него напал Вейлор.~
@54752 = ~Его лицо светлеет, а затем снова омрачается. Он отводит взгляд: «Я не могу вернуться. Мои грехи слишком велики. Для таких, как я, нет прощения. Отныне я должен служить Добру своим способом».~
@54753 = ~«Прощение всегда возможно, Триас. Как ты нечто большее, чем простой просящий, так и силы Верхних планов нечто большее, чем ты. Ты не воплощение добродетели; помни, что ты всегда можешь им верить».~
@54754 = ~«Тогда мне придётся остановить тебя здесь».~
@54755 = ~«Тогда прощай и помни: у тебя был шанс искупить свою вину и ты отверг его».~
@54756 = ~«Тогда прощай и помни: у тебя был шанс искупить свою вину и ты отверг его».~
@54757 = ~«Опять ты?»~ [TTB037]
@54758 = ~«У меня к тебе ещё вопросы».~
@54759 = ~«Ничего подобного. Прощай».~
@54760 = ~Вейлор наносит ему удар, уродуя прекрасное лицо, заливая кровью совершенные формы. Умирая, Триас насмешливо хрипит: «Знай же, ты проклял сам себя. Убив меня, ты лишился последней защиты от ужасов, которые пожрут тебя. Изверг, обманутый мной… теперь свободен…» Его слабый смех замирает, и свет гаснет в его глазах.~
@54761 = ~«Умри же наконец».~
@54762 = ~Морте не остаётся в долгу: «Ты пахнешь ничем не лучше. Сам-то когда в последний раз принимал ванну?»~
@54763 = ~Морте не остаётся в долгу: «Ты пахнешь ничем не лучше. Сам-то когда в последний раз принимал ванну?»~
@54764 = ~Морте не остаётся в долгу: «Ты пахнешь ничем не лучше. Сам-то когда в последний раз принимал ванну?»~
@54765 = ~Грейс вздыхает: «Дэв… эти цепи не столько сковывают его движения, сколько душат его разум…»~
@54766 = ~Грейс вздыхает: «Дэв… эти цепи не столько сковывают его движения, сколько душат его разум…»~
@54767 = ~«У меня не было намерения соблазнять тебя, дэв. Боюсь, твоё заключение плохо на тебя действует».~
@54768 = ~«Я не согласна, владыка Триас. Ты был просто чересчур воодушевлён верой в них».~
@54769 = ~Внезапно вмешивается Падшая Грейс: «Каков твой взгляд на Кровавую Войну, владыка Триас?»~
@54770 = ~Падшая Грейс мягко произносит: «Ты уверен, что хочешь так поступить? Этот дэв может быть для тебя последней надеждой восстановить свои воспоминания. Рейвел послала нас к нему, неужели ты сразишь его, прежде чем он раскроет свои секреты?»~
@54771 = ~«Неужели ты думаешь, что сможешь закончить Кровавую Войну, перенеся её к вратам Рая? Зло Нижних планов почти бесконечно. Легионы Баатора и армады Бездны наглядно демонстрируют это. Прежде чем вооружаться собственной самоуверенностью, вспомни лучше, сколь чудовищна сила почти бесконечного зла, сосредоточенного на одной цели. Не давай им возможности перенести Кровавую Войну на Верхние планы, или пострадает вся мультивселенная».~
@54772 = ~«Можно научиться многому, если обладаешь достаточной проницательностью, владыка. Лучше всегда помнить, что умный использует любую возможность для обучения».~
@54773 = ~«Не цепи держат его. Его держит вера».~
@54774 = ~«Дэв, у меня к тебе кое-какие вопросы…»~
@54775 = ~*Нет СПРАВЕДЛИВОСТИ в твоих действиях, дэв. На этот раз ты не ЛИШИШЬ меня свободы своими ЛЖИВЫМИ словами. В этот раз ты будешь ПРИГОВОРЁН.* Вейлор надвигается на Триаса, поднимая свой топор.~
@54776 = ~«Вейлор, стой!»~
@54777 = ~Напасть на Триаса.~
@54778 = ~*Правосудие ДОЛГО искало тебя, дэв. За свои ПРЕСТУПЛЕНИЯ ты будешь ПРИГОВОРЁН.* Вейлор надвигается на Триаса, поднимая свой топор.~
@54779 = ~«Вейлор, стой!»~
@54780 = ~Напасть на Триаса.~
@54781 = ~*Дэв НЕ ДОЛЖЕН свободно уйти. Твои клятвы значения не имеют. ПРАВОСУДИЕ должно ВОСТОРЖЕСТВОВАТЬ.*~
@54782 = ~Наблюдать.~
@54783 = ~~
@54784 = ~Напасть на дэва вопреки своей клятве.~
@54785 = ~Напасть на дэва.~
@54786 = ~Наблюдая за тем, как улепётывает Жёлтые-Пальцы, ты чувствуешь, что снова увидишь его очень не скоро.~
@54787 = ~Уйти.~
@54788 = ~Этот мужчина одет в грязную рваную коричневую одежду, длинный капюшон закрывает большую часть его лица.~
@54789 = ~«Приветствую…»~
@54790 = ~Оставить его.~
@54791 = ~Его глаза под капюшоном сужаются, он отступает назад: «Чего надо?»~
@54792 = ~«Чем занимаешься?»~
@54793 = ~«Что это за место?»~
@54794 = ~«Что это за место?»~
@54795 = ~«У меня вопросы…»~
@54796 = ~«Ничего. Прощай».~
@54797 = ~«Делом своим занимаюсь, громила, и ты б лучше своим занялся».~
@54798 = ~«Что это за место?»~
@54799 = ~«Что это за место?»~
@54800 = ~«У меня вопросы…»~
@54801 = ~«Это всё, что я хотел узнать. Прощай».~
@54802 = ~Он оглядывается вокруг. «Нету точного названия, так-то. Наверно, можешь звать „Мусорные трущобы“».~
@54803 = ~«Что ты здесь делаешь?»~
@54804 = ~«У меня вопросы…»~
@54805 = ~«Это всё, что я хотел узнать. Прощай».~
@54806 = ~«Деревня Фарода, громила, — он указывает на громоздящиеся в зловонной темноте кирпичи и мусор. — Похороненная деревня».~
@54807 = ~«Что ты здесь делаешь?»~
@54808 = ~«У меня вопросы…»~
@54809 = ~«Это всё, что я хотел узнать. Прощай».~
@54810 = ~«А?»~
@54811 = ~«Я ищу мужчину по имени Фарод».~
@54812 = ~«Я ищу мужчину по имени Фарод».~
@54813 = ~«Я ищу свой потерянный дневник».~
@54814 = ~«Неважно. Прощай».~
@54815 = ~Он озадаченно мотает головой.~
@54816 = ~«Как насчёт Фарода? Знаешь, где он?»~
@54817 = ~«Как насчёт Фарода? Знаешь, где он?»~
@54818 = ~«Неважно. Прощай».~
@54819 = ~Мужчина кивает: «Эт тебе надо тащиться на юго-запад мусорного лабиринта. Там есть люк, как раз вниз выведет, к Фароду».~
@54820 = ~«Я ищу свой потерянный дневник».~
@54821 = ~«Это всё, что я хотел узнать. Прощай».~
@54822 = ~Мужчина кивает: «Из этой большой пещеры есть ворота на северо-запад… как раз за ними и найдёшь Фарода».~
@54823 = ~«Я ищу свой потерянный дневник».~
@54824 = ~«Это всё, что я хотел узнать. Прощай».~
@54825 = ~Мужчина отступает, подозрительно глядя на тебя из-под капюшона: «Опять, да? Чего хотел?»~
@54826 = ~«Чем занимаешься?»~
@54827 = ~«Что это за место?»~
@54828 = ~«Что это за место?»~
@54829 = ~«У меня вопросы…»~
@54830 = ~«Ничего. Прощай».~
@54831 = ~«Рейвел сказала в лабиринте, что ты притягиваешь страдающих подобно магниту, — Морте трясёт головой. — Может, это потому, что *ты* страдал всё это время. Может, когда всё это закончится… *мы* тогда тоже получим немного покоя. Возможно».~
@54832 = ~«Может, и так. Итак… ты со мной, Морте?»~
@54833 = ~«Понял, спасибо за совет, Морте. Теперь я собираюсь пройти через портал».~
@54834 = ~«Из-за того, что Рейвел сказала в лабиринте, и того, что Фелл сказал об этом символе страдания? Они сказали, что ты притягиваешь страдающих подобно магниту, — Морте трясёт головой. — Может, это потому, что *ты* страдал всё это время. Может, когда всё это закончится… *мы* тогда тоже получим немного покоя. Возможно».~
@54835 = ~«Может, и так. Итак… ты со мной, Морте?»~
@54836 = ~«Понял, спасибо за совет, Морте. Теперь я собираюсь пройти через портал».~
@54837 = ~«Я знаю тебя довольно давно, шеф, и вот ведь какое дело: ты притягиваешь страдающих подобно магниту, — Морте трясёт головой. — Может, это потому, что *ты* страдал всё это время. Может, когда всё это закончится… *мы* тогда тоже получим немного покоя. Возможно».~
@54838 = ~«Может, и так. Итак… ты со мной, Морте?»~
@54839 = ~«Понял, спасибо за совет, Морте. Теперь я собираюсь пройти через портал».~
@54840 = ~Морте замолкает.~
@54841 = ~«Черепом был я, — тихо произносит Морте. — Женщиной была девчонка по имени Дейонарра, лучника я толком не знал…»~
@54842 = ~«Да уж… — Морте хрипит, слово его душат. — Шеф, в этой Крепости — там тени *повсюду*…»~
@54843 = ~«Они говорили со мной, как Колонна Черепов… — голос Морте сбивается. — Они *знали*…»~
@54844 = ~«Хорошо, слушайте оба: я хочу знать всё, что вы можете рассказать мне о Крепости…»~
@54845 = ~«Больше ничего, шеф. Кроме того, что мы разделились, едва появившись там, и того, что это ОГРОМНОЕ место, кишащее тенями… и где-то в этой Крепости есть нечто более могущественное, нежели *любой* из нас».~
@54846 = ~«Больше ничего, шеф. Кроме того, что мы разделились, едва появившись там, и того, что это ОГРОМНОЕ место, кишащее тенями… и где-то в этой Крепости есть нечто более могущественное, чем всё, с чем мы сталкивались».~
@54847 = ~«Запрос: получен. Ответ: Нордом приготовился и ждёт. Ожидаю заявления дальнейших директив».~
@54848 = ~«Вообще-то, скорее, „получения“… неважно. Вейлор?»~
@54849 = ~«Вообще-то, скорее, „получения“… неважно. Игнус?»~
@54850 = ~«Вообще-то, скорее, „получения“… неважно. Падшая Грейс?»~
@54851 = ~«Вообще-то, скорее, „получения“… неважно. Анна?»~
@54852 = ~«Вообще-то, скорее, „получения“… неважно. Дак'кон?»~
@54853 = ~«Вообще-то, скорее, „получения“… неважно. Дак'кон?»~
@54854 = ~«Вообще-то, скорее, „получения“… неважно. Морте?»~
@54855 = ~«Вообще-то, скорее, „получения“… неважно. Морте?»~
@54856 = ~«Ладно… посмотрим, что там за этим порталом».~
@54857 = ~«Ладно… посмотрим, что там за этим порталом».~
@54858 = ~«Ладно… посмотрим, что там за этим порталом».~
@54859 = ~Вейлор отвечает тебе молчанием; когда ты обращаешь на него взгляд, его глаза пылают. Какое-то время их пламя мерцает, словно он раздумывает, и внезапно у тебя возникает жуткое чувство, что он изучает твои черты… что-то выискивает в них… какую-то слабость.~
@54860 = ~«Хм… Игнус?»~
@54861 = ~«Хм… Падшая Грейс?»~
@54862 = ~«Хм… Анна?»~
@54863 = ~«Хм… Дак'кон?»~
@54864 = ~«Хм… Дак'кон?»~
@54865 = ~«Хм… Морте?»~
@54866 = ~«Хм… Морте?»~
@54867 = ~«Ладно… посмотрим, что там за этим порталом».~
@54868 = ~«Ладно… посмотрим, что там за этим порталом».~
@54869 = ~«Ладно… посмотрим, что там за этим порталом».~
@54870 = ~Я убил крысу-оборотня и получил награду от Финеаса. Награда была достаточно скудной, учитывая, через что я прошёл, выполняя поручение. Ну да ладно, деньги есть деньги.~
@54871 = ~«Это твой меч? Он находился в центре тюрьмы».~
@54872 = ~«Забудь. Прощай».~
@54873 = ~«Полагаю, это не зомби…»~
@54874 = ~«Дэв, у меня к тебе кое-какие вопросы…»~
@54875 = ~Разрубить цепи дэва.~
@54876 = ~Сразить дэва.~
@54877 = ~Уйти.~
@54878 = ~Управление громкостью голоса, которым вам отвечают члены вашей партии, когда вы выбираете их. Для снижения громкости, переместите ползунок влево, для увеличения громкости — переместите вправо.~
@54879 = ~Отзыв на выбор~
@54880 = ~Управление громкостью голоса, которым вы отдаете указания членам своей партии сделать что-то. Для снижения громкости, переместите ползунок влево, для увеличения громкости — переместите вправо.~
@54881 = ~«Надеюсь. У меня кое-какие вопросы…»~
@54882 = ~«Прощай».~
@54883 = ~«Я чую на тебе запах предательства, чувствую и слышу приближение моих собратьев, идущих, чтобы вернуть меня в Баатор… убирайся, клятвопреступник! Ты получил от меня всё что мог! Больше мне нечего тебе дать!»~
@54884 = ~«Тебе правда больше нечего дать?»~
@54885 = ~«У меня всего-то пара вопросов…»~
@54886 = ~«Тогда прощай».~
@54887 = ~«Тогда прощай».~
@54888 = ~«Тогда прощай».~
@54889 = ~Изверг застывает: «Э-э… ничего ценного. Может, пустячные амулеты, безделушки, которые и так у тебя есть… если они тебе действительно нужны, то я отдам… иначе…»~
@54890 = ~«Что там у тебя?»~
@54891 = ~«Забудь. Просто ответь на пару вопросов».~
@54892 = ~«Тогда прощай».~
@54893 = ~«Забудь. Прощай».~
@54894 = ~«Забудь. Прощай».~
@54895 = ~«Пфе! Будь ты трижды проклят, смертный! Лучше молись, чтобы в жилах дэва не иссякала вечность, потому что иначе я бы заставил тебя заплатить той же монетой, но уж взял бы не магией… Уркх-х-х… ун-нх-х-х… нет-нет, я не хотел вреда… беру назад свои необдуманные слова… я не хотел вреда…»~
@54896 = ~«Хорошо. Давай сюда. Сейчас же».~
@54897 = ~«Если вещи не нужны тебе, Двуличный, они могли бы пригодиться мне».~
@54898 = ~«Забудь, Двуличный. Вместо этого ответь на пару вопросов…»~
@54899 = ~«Тогда прощай».~
@54900 = ~«Тогда прощай».~
@54901 = ~«Тогда прощай».~
@54902 = ~«Проклятый, ищущий выгоды… конечно, ты можешь взглянуть на моё добро. Что ты хочешь посмотреть?»~
@54903 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@54904 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@54905 = ~Осмотреть зелёную пилюлю: «Что это?»~
@54906 = ~Осмотреть нож из зелёной стали: «Что это?»~
@54907 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@54908 = ~Осмотреть извивающися жуков: «Что это?»~
@54909 = ~«Есть у тебя какие-нибудь заклинания?»~
@54910 = ~«Забудь. Лучше ответь мне на вопросы».~
@54911 = ~«Тогда прощай».~
@54912 = ~«Ничего не нужно. Прощай».~
@54913 = ~«Ничего не нужно. Прощай».~
@54914 = ~«Ар-рх! Уж я всегда найду применение таким вещам! Особенно полезны они против орды извергов, которых ты бездумно привёл к моей двери!»~
@54915 = ~«Какая жалость. Всё равно показывай».~
@54916 = ~«Тогда я позволю тебе сохранить их».~
@54917 = ~«Пфе! Твоё великодушие — в точности как у трижды проклятого дэва Элизиума. Что ещё ты хочешь от бедного Фьюлла?»~
@54918 = ~«Знаешь, если подумать, покажи-ка всё же свои безделушки».~
@54919 = ~«Ответы на некоторые вопросы…»~
@54920 = ~«Тогда прощай».~
@54921 = ~«Сейчас ничего. Прощай».~
@54922 = ~«Сейчас ничего. Прощай».~
@54923 = ~Он скалит зубы: «Чем ещё могу служить?»~
@54924 = ~«Как мне убраться из этого кратера?»~
@54925 = ~«Ещё раз, как мне отсюда убраться?»~
@54926 = ~«Расскажи мне о Триасе».~
@54927 = ~«Так почему баатезу преследуют тебя?»~
@54928 = ~«Ничем не хочешь со мной… поделиться?»~
@54929 = ~«Почему ты прячешься в этом кратере?»~
@54930 = ~«Тогда прощай».~
@54931 = ~«Сейчас не можешь. До встречи».~
@54932 = ~«Сейчас не можешь. До встречи».~
@54933 = ~«Ха! Какие неприятности ты принесёшь мне в следующий раз? Такие, как ты, всегда возвращаются… пфе!»~
@54934 = ~«Прощай».~
@54935 = ~«Пфе… значит ли это, что ты уйдёшь и снова оставишь меня в моём одиночестве? Тогда я со всей искренностью провозглашаю, что портал находится под задницей скелета этого создания. Он вернёт тебя в презренный городишко Керст, откуда ты пришёл, и мне даже приходит в голову парочка более подходящих способов путешествия».~
@54936 = ~«Спасибо. Ответь ещё на пару вопросов…»~
@54937 = ~«Тогда прощай».~
@54938 = ~«Тогда прощай».~
@54939 = ~«Тогда прощай».~
@54940 = ~«Это скрытное лжедитя света! Этот презренный… ак-кх… я не хотел сказать ничего плохого про него и его предательские, лживые, беззаконные методы! Пфе! Он обманщик, смертный, и тебе не следует ему доверять. Я заявляю это, конечно, со всем возможным уважением и… — Двуличный плюёт на землю, — …любезностью. Его обман стоил мне вечности… если только он не умрёт». Его зубастая ухмылка поразительно оптимистична.~
@54941 = ~«У меня были ещё кое-какие вопросы…»~
@54942 = ~«Тогда прощай».~
@54943 = ~«Тогда прощай».~
@54944 = ~«Тогда прощай».~
@54945 = ~«Пфе… они добиваются баланса в своих книгах, возмещения убытков, подтверждения, что всё по правилам. Моё существование вне поля их зрения портит совершенство их картины зла».~
@54946 = ~«У меня были ещё кое-какие вопросы…»~
@54947 = ~«Тогда прощай».~
@54948 = ~«Тогда прощай».~
@54949 = ~«Тогда прощай».~
@54950 = ~«Это скелет Уль-Гориса, отца всех гористро. Они живые медведеподобные осадные башни, джаггернауты хаоса; огромные, неумолимые, почти неуязвимые для магии… и кости Уль-Гориса в кратере, где он встретил свою смерть, излучают столько энергии, что препятствуют магическому осмотру области. Пфе!»~
@54951 = ~«У меня были ещё кое-какие вопросы…»~
@54952 = ~«Тогда прощай».~
@54953 = ~«Тогда прощай».~
@54954 = ~«Тогда прощай».~
@54955 = ~«Пфе… это „Дар ненависти“, отличное оружие для таких, как ты, — он тихонько хихикает. — Не думаю, что ты его захочешь… на нём проклятие. Возможно, ты передумаешь…»~
@54956 = ~«Всё равно хочу взять».~
@54957 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@54958 = ~Осмотреть зелёную пилюлю: «Что это?»~
@54959 = ~Осмотреть нож из зелёной стали: «Что это?»~
@54960 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@54961 = ~Осмотреть извивающися жуков: «Что это?»~
@54962 = ~«Есть у тебя какие-нибудь заклинания?»~
@54963 = ~«Забудь. Лучше ответь мне на вопросы».~
@54964 = ~«Тогда прощай».~
@54965 = ~«Ничего не нужно. Прощай».~
@54966 = ~«Ничего не нужно. Прощай».~
@54967 = ~«Эта старая штуковина? Пфе! Это гордиев узел. Разруби его, и твоя способность вести за собой других повысится вдвое, хе-хе. И, конечно, за это тоже придётся платить, чего я с нескрываемой радостью не могу отменить».~
@54968 = ~«Всё равно хочу взять».~
@54969 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@54970 = ~Осмотреть зелёную пилюлю: «Что это?»~
@54971 = ~Осмотреть нож из зелёной стали: «Что это?»~
@54972 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@54973 = ~Осмотреть извивающися жуков: «Что это?»~
@54974 = ~«Есть у тебя какие-нибудь заклинания?»~
@54975 = ~«Забудь. Лучше ответь мне на вопросы».~
@54976 = ~«Тогда прощай».~
@54977 = ~«Ничего не нужно. Прощай».~
@54978 = ~«Ничего не нужно. Прощай».~
@54979 = ~Он вздыхает: «Это слеза гадюки. Положи её в рот, и твой поцелуй станет подобным укусу гадюки — полным яда и ненависти».~
@54980 = ~«Я хочу взять».~
@54981 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@54982 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@54983 = ~Осмотреть нож из зелёной стали: «Что это?»~
@54984 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@54985 = ~Осмотреть извивающися жуков: «Что это?»~
@54986 = ~«Есть у тебя какие-нибудь заклинания?»~
@54987 = ~«Забудь. Лучше ответь мне на вопросы».~
@54988 = ~«Тогда прощай».~
@54989 = ~«Ничего не нужно. Прощай».~
@54990 = ~«Ничего не нужно. Прощай».~
@54991 = ~«Напоминание о моём времени в Бааторе — нож, изготовленный из бааторианской зелёной стали, одного из крепчайших материалов, какие я когда-либо видел. Пфе! Забирай мои воспоминания и заканчивай с этим!»~
@54992 = ~«Я хочу взять его. Но пока не собираюсь заканчивать».~
@54993 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@54994 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@54995 = ~Осмотреть зелёную пилюлю: «Что это?»~
@54996 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@54997 = ~Осмотреть извивающися жуков: «Что это?»~
@54998 = ~«Есть у тебя какие-нибудь заклинания?»~
@54999 = ~«Забудь. Лучше ответь мне на вопросы».~
@55000 = ~«Тогда прощай».~
@55001 = ~«Ничего не нужно. Прощай».~
@55002 = ~«Ничего не нужно. Прощай».~
@55003 = ~«Эта старая штуковина? Пфе! Всего лишь кинжал из бааторианской зелёной стали. Сохраняет остроту заточки. Ничего, что тебе было бы нужно, поверь мне».~
@55004 = ~«Всё равно хочу взять».~
@55005 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@55006 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@55007 = ~Осмотреть зелёную пилюлю: «Что это?»~
@55008 = ~Осмотреть нож из зелёной стали: «Что это?»~
@55009 = ~Осмотреть извивающися жуков: «Что это?»~
@55010 = ~«Есть у тебя какие-нибудь заклинания?»~
@55011 = ~Не использовано~
@55012 = ~Отзыв на приказ~
@55013 = ~Отдыхать не разрешается.~
@55014 = ~«Забудь. Лучше ответь мне на вопросы».~
@55015 = ~«Тогда прощай».~
@55016 = ~«Ничего не нужно. Прощай».~
@55017 = ~«Ничего не нужно. Прощай».~
@55018 = ~«Это? Это *кассеги*, паразиты, внедряющиеся в твой мозг и высасывающие твою ментальную энергию без особой пользы… Пфе! Проклятый договор! Они усиливают твою ментальную энергию, так что некоторую явную пользу приносят! Забирай их! Забирай!»~
@55019 = ~«Я хочу взять».~
@55020 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@55021 = ~Нельзя отдыхать, когда команда разделена.~
@55022 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@55023 = ~Осмотреть зелёную пилюлю: «Что это?»~
@55024 = ~Осмотреть нож из зелёной стали: «Что это?»~
@55025 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@55026 = ~«Есть у тебя какие-нибудь заклинания?»~
@55027 = ~«Забудь. Лучше ответь мне на вопросы».~
@55028 = ~«Тогда прощай».~
@55029 = ~«Ничего не нужно. Прощай».~
@55030 = ~«Ничего не нужно. Прощай».~
@55031 = ~«Пфе! Конечно, хочешь! Есть что-то ещё, что ты пожелаешь от своего *смиренного* слуги?!»~
@55032 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@55033 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@55034 = ~Осмотреть зелёную пилюлю: «Что это?»~
@55035 = ~Осмотреть нож из зелёной стали: «Что это?»~
@55036 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@55037 = ~Осмотреть извивающися жуков: «Что это?»~
@55038 = ~«Есть у тебя какие-нибудь заклинания?»~
@55039 = ~«Забудь. Лучше ответь мне на вопросы».~
@55040 = ~«Тогда прощай».~
@55041 = ~«Ничего не нужно. Прощай».~
@55042 = ~«Ничего не нужно. Прощай».~
@55043 = ~«Тьфу! Ты обдерёшь меня как липку! Хочешь заклинаний? Пфе! Да, у меня они есть, кровосос!» — он выпаливает перечень заклинаний.~
@55044 = ~~
@55045 = ~~
@55046 = ~«Как насчёт славного „Снять проклятие“?»~
@55047 = ~«Дай мне ещё одно „Снять проклятие“».~
@55048 = ~«„Сфера неуязвимости“ выглядит полезной. Давай сюда».~
@55049 = ~«Есть ещё „Сфера неуязвимости“?»~
@55050 = ~«Как насчёт „Шторма цепных молний“?»~
@55051 = ~«Ещё один „Шторм цепных молний“ не помешал бы…»~
@55052 = ~«„Кислотный шторм“ звучит грозно. Я возьму его».~
@55053 = ~«„Кислотный шторм“. Ещё один».~
@55054 = ~«„Вихрь лезвий“? Впечатляющее название. Хочу».~
@55055 = ~«Дай ещё один „Вихрь лезвий“».~
@55056 = ~«„Стигийский ледяной шторм“? Тебе слишком опасно держать у себя такие вещи… лучше я заберу его».~
@55057 = ~«„Стигийский ледяной шторм“? Он мне понравился».~
@55058 = ~«Вообще-то ты ничего не назвал».~
@55059 = ~«Забудь. У меня вопросы».~
@55060 = ~«Тогда прощай».~
@55061 = ~«Забудь. Прощай».~
@55062 = ~«Забудь. Прощай».~
@55063 = ~Его рука исчезает, когда он касается странного пространства/непространства. Он вытаскивает свиток, выглядящий так, будто был изготовлен из высушенной человеческой кожи, и кидает его тебе: «Пфе! Забирай и будь прок… э-э, возьми его!»~
@55064 = ~«Спасибо… какие ещё заклинания у тебя есть?»~
@55065 = ~«Я хочу ещё раз взглянуть на вещи».~
@55066 = ~«Хорошо. У меня вопросы».~
@55067 = ~«Ладно, прощай».~
@55068 = ~«Ладно. Прощай».~
@55069 = ~Этот странный клинок довольно уродливо выглядит и напоминает очертаниями один из символов на твоей левой руке. По поверхности металла разбегаются чёрные прожилки, а лезвие выглядит столь тупым, что вряд ли разрежет даже подогретое масло. На ощупь оно чуть тёплое.~
@55070 = ~«Ладно. Прощай».~
@55071 = ~Оставить клинок в покое.~
@55072 = ~Он строит зубастую гримасу: «С глубокой и проникновенной радостью сообщаю, что ты разграбил все мои копии этого конкретного заклинания. Пфе!»~
@55073 = ~«А какие заклинания у тебя остались?»~
@55074 = ~«Я хочу ещё раз взглянуть на вещи».~
@55075 = ~«Забудь. У меня вопросы».~
@55076 = ~«Тогда прощай».~
@55077 = ~Похоже, это оружие сделано из необычного металла. Тщательный осмотр показал, что оно изготовлено из единого куска металла, а не как обычное лезвие, вделанное в эфес. Когда ты поднимаешь этот клинок, он начинает дрожать и меняться в твоей руке. Кажется, он пытается вырваться из своей нынешней формы.~
@55078 = ~«Забудь. Прощай».~
@55079 = ~Пожелать изменения лезвия.~
@55080 = ~«Забудь. Прощай».~
@55081 = ~Двуличный рычит на тебя: «Ты уничтожил, разорил, разграбил уникальнейшее собрание заклинаний в мультивселенной… всего тебе за это хорошего! У меня больше нет заклинаний».~
@55082 = ~«Я хочу ещё раз взглянуть на вещи».~
@55083 = ~«Тогда забудь. Лучше ответь на вопрос…»~
@55084 = ~«Тогда прощай».~
@55085 = ~«Тогда прощай».~
@55086 = ~«Тогда прощай».~
@55087 = ~«Пфе! Итак, ты вернулся! И о чём ты говорил с Колонной? Ответила она на твои занудные вопросы?»~ [FFT067]
@55088 = ~«У меня просто пара вопросов к тебе…»~
@55089 = ~«Забудь. Прощай».~
@55090 = ~«Ар-рх! Что? ЧТО?!»~ [FFT018]
@55091 = ~«У меня просто пара вопросов…»~
@55092 = ~«Колонна Черепов: известно, что она состоит из живых голов тех смертных, кто солгал и в результате привёл других смертных к гибели. Колонна служит хранилищем знаний. В девяносто семи процентах случаев Колонна за ответы на заданные ей вопросы потребует платы. Запросы Колонны находятся на уровне, который обычный смертный мог бы охарактеризовать словами „ничего себе!“. Логика подсказывает не обращаться к Колонне до тех пор, пока нет потребности в определённом разделе информации, который может быть охарактеризован как „ничего себе!“».~
@55093 = ~Аукцион Гильтспура~
@55094 = ~«Забудь. Прощай».~
@55095 = ~«Пфе! Омерзительное зловоние танар'ри! Я чую его за лигу! Окажи моему дому хоть немного уважения! Не найдёшь каких-нибудь благовоний или кислотных паров, чтобы хоть как-то заглушить этот запах? Пфе! Я теперь никогда не выведу смрад танар'ри из своего дома. Он привлечёт баатезу со всех планов».~
@55096 = ~«О, и это не просто какая-то танар'ри, в мой дом только что пожаловала танар'рийская шлюха… хуже уже некуда. Заходи! Заходи! Прошу, мой дом — твой дом! — он отчаянно машет руками. — Почему бы тебе не пригласить ко мне домой всех остальных гарпий Бездны, чтобы помучить меня?»~
@55097 = ~«Пфе! Омерзительное зловоние танар'ри! Я чую его за лигу! Окажи моему дому хоть немного уважения! Не найдёшь каких-нибудь благовоний или кислотных паров, чтобы хоть как-то заглушить этот запах? Пфе! Я теперь никогда не выведу смрад танар'ри из своего дома. Он привлечёт баатезу со всех планов».~
@55098 = ~«Ты пришёл убить меня?! Мучить меня? Если так, то знай: в моём распоряжении ещё немало сил!»~
@55099 = ~Куб *трещит*, потом раздаются частые *щелчки*, словно его глаза быстро моргают. Куб поворачивается к тебе лицом, его глаза расширяются, и он задирает две свободные руки вверх, будто сдаётся… но арбалеты в двух его других руках странным образом поворачиваются и нацеливаются на тебя, словно у них собственное мнение. Ты не можешь не заметить, что каждый сустав этого создания состоит из ряда *жужжащих* колёсиков и шестерней.~
@55100 = ~«Я пришёл не ради убийства».~
@55101 = ~«Я не собираюсь тебя мучить».~
@55102 = ~«Э-э…»~
@55103 = ~«Я просто хочу получить ответы на кое-какие вопросы…»~
@55104 = ~«Забудь. Прощай».~
@55105 = ~Секунду он разглядывает тебя, затем разворачивает своё кубическое тело к тебе спиной и начинает раскачиваться вверх-вниз, словно убегая… при этом его ноги, обращённые к тебе, не отрываются от земли. Когда он «бежит», детали арбалетов в его руках начинают *звенеть* и *щёлкать*.~
@55106 = ~«Хм… ты знаешь, что стоишь наоборот?»~
@55107 = ~Создание внезапно прекращает своё раскачивание, затем разворачивается обратно к тебе лицом. «Модрон наоборот = „Нордом“?» — голос куба металлический и вибрирующий, словно каждое слово отскакивает от него и падает на землю… или ещё куда-то. Его рот образует с боков причудливые полукруги, которые легко принять за улыбку. «Благодарения! Благодарности!»~
@55108 = ~«Э-э… извини?»~
@55109 = ~Я убедился в опасности имён. Блуждая внутри Рубикона, я обнаружил странного модрона. Когда я с ним заговорил, он решил, что я даю ему имя. Его новое имя — «Нордом», и для модрона он выглядит довольно… неуравновешенным.~
@55110 = ~«Модрон наоборот = „Нордом“?» — голос куба металлический и вибрирующий, словно каждое слово отскакивает от него и падает на землю… или ещё куда-то. Его рот образует с боков причудливые полукруги, которые легко принять за улыбку. «Благодарения! Благодарности!»~
@55111 = ~«Э-э… извини?»~
@55112 = ~«Нет извинений. Ноль извинений. Благодарности! Самоосознание себя складывается из сомнений + обдумывание + анализ», — куб снова *трещит*, и один его глаз с *щелчком* моргает… спустя мгновение второй тоже *щёлкает*, словно не хочет отставать.~
@55113 = ~«Я всё равно не понимаю».~
@55114 = ~«Ты благодарен… что я назвал тебя? Разве ты не модрон?»~
@55115 = ~Черты куба успокаиваются, а рот превращается в прямую линию: «В отождествлении этой единицы (был) достигнут компромисс. Тема — адресовать отождествлённую единицу как „Нордом“. Представлена благодарность за отождествление единицы „Нордом“».~
@55116 = ~«Это не составило труда. Правда».~
@55117 = ~Глаза Нордома, *щёлкая*, моргают один раз, второй, третий; с каждым разом чёрные пятнышки посреди глаз расширяются. С третьим щелчком они опять становятся точками. «Око-знание достигнуто: Нордом имеет ноль знаний об адресате. Отождестви себя».~
@55118 = ~«Ты хотел сказать „представься“, верно?»~
@55119 = ~Правда: «Вообще-то у меня *нет* имени, Нордом».~
@55120 = ~Ложь: «Адан. Меня зовут Адан».~
@55121 = ~«Утвердительно. Требуется пред-ста-вление. Запрос: представить личность Нордому».~
@55122 = ~Правда: «Вообще-то у меня *нет* имени, Нордом».~
@55123 = ~Ложь: «Адан. Меня зовут Адан».~
@55124 = ~«Нордом, я не хочу представляться. По правде говоря, я хочу прекратить этот разговор и заняться своими делами».~
@55125 = ~Глаза Нордома расширяются, диаметр его «зрачков» возвращается к норме. Он, вновь *щёлкая*, хлопает глазами, но металлические веки, закрывшие глаза, не поднимаются. Спустя секунду они начинают дребезжать, словно застряли.~
@55126 = ~«Хм… Нордом. Ты можешь уже открыть глаза».~
@55127 = ~Раздаётся ещё один щелчок, и его глаза открываются: «Не закрывать глаза: принято-нято в качестве Уточняющего действия от Субъекта (Неопределённый, Безымянный). Формулирование… подтверждение запроса: ты потерян?»~
@55128 = ~«Потерян? Что ты имеешь в виду?»~
@55129 = ~«Потерян? Что ты имеешь в виду?»~
@55130 = ~«Потерян? Что ты имеешь в виду?»~
@55131 = ~Едва Нордом заканчивает свою фразу словом «потерян», как в задней части твоего черепа расползается странное ощущение уверенности в двух фактах одновременно: что ты не в первый раз это слышишь и что Нордом *вот-вот* скажет тебе нечто действительно важное.~
@55132 = ~«Нордом, когда ты говоришь „потерян“, что ты имеешь в виду?»~
@55133 = ~«Отсутствие Имени = Отсутствие Личности = Отсутствие Назначения = Отсутствие Места в Мультивселенной = Нулевой Статус = Потеря. Нордом имел Статус Ноль, пока Субъект (Неопределённый, Безымянный) не идентифицировал личность Нордома. Нулевая Личность, Нулевое Предназначение, Нулевое Место приравнивается к „Потере“».~
@55134 = ~«Ну, я думаю, у меня было имя, но я его забыл».~
@55135 = ~«Формулируется новый запрос, — с громким *щёлканьем* Нордом ещё три раза быстро мигает — звук напоминает постукивание молотком по листу жести. — Требуется объяснение для Нордома причины выбора действия: ЗАБЫЛ-вание».~
@55136 = ~«Просто так получилось. Это было непреднамеренно».~
@55137 = ~«Похоже, забывать — это моя природная особенность».~
@55138 = ~«Думаю, это побочный эффект моего… состояния».~
@55139 = ~Металлические веки с жужжанием скрывают глаза Нордома, потом он какое-то время дребезжит с закрытыми глазами. Когда они с щелчком открываются, Нордом выдаёт: «Запрос: дефект памяти?»~
@55140 = ~«Можно сказать и так».~
@55141 = ~«Поясняющий Запрос по поводу Предупреждающего Действия: память Нордома ещё не близка к заполнению. Запрос/Действие: в случае события „Да“ от Субъекта (Неопределённый, Безымянный), Нордом может перезапомнить за тебя».~
@55142 = ~«Конечно, запоминай, Нордом… слушай, в любом случае мне надо заняться своими делами».~
@55143 = ~«Спасибо за предложение, Нордом. Пожалуйста, если ты хочешь. Но слушай, мне и вправду надо идти».~
@55144 = ~Глаза Нордома расширяются, диаметр его «зрачков» возвращается к норме. Он, вновь *щёлкая*, хлопает глазами, но металлические веки, закрывшие глаза, не поднимаются.~
@55145 = ~«Хм… Нордом. Ты можешь уже открыть глаза».~
@55146 = ~Раздаётся ещё один *щелчок*, и его глаза открываются: «Не закрывать глаза: принято Уточняющее действие от Адана. Каталогизация информации, Запоминание. Адан: имя принято. Нордом не забудет твою личность, разумный: Адан».~
@55147 = ~«Здорово. Приятно было побеседовать, Нордом, но мне надо идти».~
@55148 = ~Внезапно арбалеты в руках Нордома выдают быструю серию *щелчков* и звенящих звуков. Его глаза поворачиваются и фокусируются на арбалетах. Он подносит правый арбалет к голове сбоку, словно прислушиваясь.~
@55149 = ~«Всё в порядке?»~
@55150 = ~Один глаз Нордома наблюдает за слабо *щёлкающим* арбалетом, другой он направляет на тебя: «Запрос: могут ли эти присоединиться к тебе в твоём нашествии?»~
@55151 = ~«Небесный огонь»~
@55152 = ~Зубчатое кольцо~
@55153 = ~Корсаж~
@55154 = ~Разноцветная секира~
@55155 = ~Твоё новое глазное яблоко.~
@55156 = ~Костяной свисток~
@55157 = ~«Хм, ты хочешь сказать „путешествии“?»~
@55158 = ~«Небесный огонь»~
@55159 = ~Ключ от кладовой логова~
@55160 = ~Место клика~
@55161 = ~Второй Круг Зертимона~
@55162 = ~Маленький красный ключ~
@55163 = ~Свисток защиты~
@55164 = ~«Знаешь, НЕ ДУМАЮ, что это хорошая идея. Нет, не сейчас… Нордом».~
@55165 = ~«Ну… ладно. Однако придётся кому-нибудь из моих попутчиков подвинуться».~
@55166 = ~«Конечно. Нам всегда нужны рабочие руки… особенно четыре сразу».~
@55167 = ~«Истинно. Подтверждение путешествия. Разрешение получено?»~
@55168 = ~«Знаешь, НЕ ДУМАЮ, что это хорошая идея. Нет, не сейчас… Нордом».~
@55169 = ~«Ну… ладно. Однако придётся кому-нибудь из моих попутчиков подвинуться».~
@55170 = ~«Конечно. Нам всегда нужны рабочие руки… особенно четыре сразу».~
@55171 = ~Нордом смотрит на тебя своими большими глазами. Его правый арбалет *клацает*, затем Нордом моргает: «Дополнительный Запрос: пожалуйста?»~
@55172 = ~«Не в этот раз, Нордом».~
@55173 = ~«Ну… ладно. Однако придётся кому-нибудь из моих попутчиков подвинуться».~
@55174 = ~«Ну ладно. Нам всегда нужны рабочие руки… особенно четыре сразу».~
@55175 = ~Рот Нордома образует обрезанный сверху полукруг: «Ответ на запрос: принято и под-тверждено. Нордом будет воздерживаться от больших сообществ. Нордом продолжит исследование этого многоугольного пространства, пока не понадобится».~
@55176 = ~«Хорошо. Я ещё вернусь, Нордом».~
@55177 = ~«Рот» Нордома образует причудливый полукруг, а его арбалеты начинают неистово *клацать* и *звенеть*, почти подскакивая в его руках: «Благодарности! Благодарения! Нордом и арбалеты присоединяются к большому сообществу».~
@55178 = ~«Я бы пока не спешил с благодарностями. Давай выбираться отсюда…»~
@55179 = ~Пустой узел~
@55180 = ~Пустой узел~
@55181 = ~«Внимание, Нордом: востребован! — Нордом начинает поворачиваться к тебе, на полпути останавливается, потом с *клацаньем* завершает разворот. — Ответ на запрос: действие, выполняемое с арбалетами? Отправляется Уточняющий запрос: представлено ноль арбалетов».~
@55182 = ~«У тебя тут два арбалета, Нордом».~
@55183 = ~«О, правда? И как же ты называешь эти клацающие штуки у тебя в руках?»~
@55184 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55185 = ~«Забудь, Нордом. Пошли».~
@55186 = ~«Прояснение: утверждение „изобилует ошибками“. Нордом не использует арбалеты, — на мгновение он замирает, внезапно арбалеты прицеливаются в тебя так резко, что ты даже не замечаешь их движение. — Н-н-н-ноль арбалетов».~
@55187 = ~«Должно быть, ты вечно собираешься осквернять мой дом омерзительным зловонием танар'ри? Спрашивай и уходи!»~
@55188 = ~«Расскажи мне о Триасе».~
@55189 = ~«Не наводи на меня арбалеты».~
@55190 = ~«Нордом, ты *используешь* арбалеты — вот они, ровно ДВЕ штуки».~
@55191 = ~«О, правда? И как же ты называешь эти клацающие штуки у тебя в руках?»~
@55192 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55193 = ~«Забудь, Нордом. Пошли».~
@55194 = ~Ты моргаешь — а арбалеты вдруг оказываются направлены на Нордома. Он явно не обращает внимания на их движение, его взгляд направлен на тебя: «Противоречие не приводит к согласию. Ноль арбалетов».~
@55195 = ~«О, правда? И как же ты называешь эти клацающие штуки у тебя в руках?»~
@55196 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55197 = ~«Забудь, Нордом. Пошли».~
@55198 = ~«Ответ: две КЛАЦАЮЩИЕ штуки находятся в противоположном разряде, — Нордом поднимает свои клёпаные пальцы и размахивает арбалетами, которые внезапно начинают *щёлкать* и *звенеть*, словно они раздражены его словами. — Ответ: объекты = Духи снаряжения».~
@55199 = ~«Духи снаряжения? Что ты имеешь в виду?»~
@55200 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55201 = ~«Забудь, Нордом. Пошли».~
@55202 = ~«Запрос: определение: Духи снаряжения. Ответ: Духи снаряжения».~
@55203 = ~«Да, но *что такое* духи снаряжения?»~
@55204 = ~«Да, но *что такое* духи снаряжения?»~
@55205 = ~«Запрос = запрос: определение = определение: Духи снаряжения. Ответ: Духи снаряжения».~
@55206 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55207 = ~«Забудь, Нордом. Пошли».~
@55208 = ~Нордом *тарахтит*: «Запрос требует изложения Хронологии: должен ли Нордом изложить хронологию?»~
@55209 = ~«Да, хотел бы услышать».~
@55210 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55211 = ~«Забудь, Нордом. Пошли».~
@55212 = ~«Приказы, полученные при инициации проекта Рубикон: покинуть План/Механус. Стадия Один: прибытие в Пункт назначения: План/Лимбо. Стадия Два: параметры установлены Вышестоящим/Созидающим Директором: придана форма материи Плана (Лимбо) для проверки гипотезы. Подземелье Рубикон создано».~
@55213 = ~«Продолжай…»~
@55214 = ~«Стой, Нордом. Что это за план Механус?»~
@55215 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55216 = ~«Забудь, Нордом. Пошли».~
@55217 = ~«Вышестоящий/ — Директор „Созидания“ — потерян в полевом испытании. Хронология прервана на достижении Второй Стадии. Стадия Три (прерывание) имеет место, что не является частью плановых директив».~
@55218 = ~«Что случилось на третьей стадии?»~
@55219 = ~«Что это было за полевое испытание?»~
@55220 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55221 = ~«Забудь, Нордом. Пошли».~
@55222 = ~«Полевое испытание Вышестоящего/ — Директора „Созидания“: осмотр периметра подземелья Рубикон (Сложный) для выявления: отклонений. Обнаружено много отклонений: ошибки существенны, — Нордом издаёт низкое завывание, и его глаза с щёлкающим звуком закрываются. — Директор „Созидания“ не вернулся из полевого испытания».~
@55223 = ~«Ясно. Что случилось на упомянутой тобой третьей стадии?»~
@55224 = ~«Что с ним случилось?»~
@55225 = ~«Я слышал, волшебник Рубикона дезинтегрировал Созидающего Директора».~
@55226 = ~«Что с ним случилось?»~
@55227 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55228 = ~«Забудь, Нордом. Пошли».~
@55229 = ~Из левого арбалета раздаётся серия неожиданных *щелчков*, и Нордом подносит арбалет к голове, словно прислушиваясь. *Щелчки* какое-то время продолжаются, пока их не заглушает протяжный *звон* из правого арбалета.~
@55230 = ~«Эй, Нордом? Есть идеи, что с ним случилось?»~
@55231 = ~«Забудь. Что случилось на третьей стадии проекта?»~
@55232 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55233 = ~«Забудь, Нордом. Пошли».~
@55234 = ~«Необоснованное подозрение: Вышестоящий обнаружил ошибку, — глаза Нордома *щёлкают*, как будто он их прочищает. — Гипотеза: ошибка могла быть большой и неожиданной».~
@55235 = ~«Возможно, так и было. Что случилось на третьей стадии проекта?»~
@55236 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55237 = ~«Забудь, Нордом. Пошли».~
@55238 = ~«НЕБЕСНЫЙ ОГОНЬ»
Урон: 3-18 рубящий
Зачаровано: +2
Особенности:
   Класс защиты: +2
   Урон огнём: +10
   Сопротивление рубящему урону: +10%
THAC0: +2
Фактор скорости: 3
Вес: 5
Навык: клинок
Доступно: законопослушным добрым персонажам

«Небесный огонь» — единственная вещь, оставшаяся у Триаса как память о Верхних планах. Этот тяжёлый клинок тёплый на ощупь; вся его поверхность покрыта изумительно красивым узором из языков пламени. Ты испытываешь невольное восхищение перед мастерством ремесленника, который, наверное, потратил века, нанося это горящее металлическое пламя. Тебе не знаком металл, из которого сделан клинок… он тяжёлый, но блестит, как серебро.

Похоже, мечу несколько столетий. От него исходит лёгкая дрожь. Вибрация становится сильнее, когда клинок касается человеческой плоти. Естественно, пользоваться «Небесным огнём» может лишь тот, кто чист и силён сердцем. В бою «Небесный огонь» распространяет святое сияние, которое сжигает злых существ, поражённых мечом.~
@55239 = ~ВТОРОЙ КРУГ ЗЕРТИМОНА
Позволяет записать «Стальное писание» в книгу заклинаний
Дистанция: 180 футов
Длительность: 30 секунд
Время чтения: 1
Зона действия: радиус 70 футов
Спасбросок: нет
Вес: 1
Доступно: магам и Безымянному

На каменной пластине Второго Круга Зертимона высечено:

«*Знай*, что плоть не может оставить следа на стали. *Знай*, что сталь может оставить след на плоти. *Познав* это, Зертимон стал свободен».

«*Знай*, что щупальценосцы были плотью. Они полагались на плоть и использовали её как инструмент своей воли. Одним из мест, где плоть служила их воле, были Поля Оболочек в Псевдомирах *иллитидов*».

«Поля были местом, куда *иллитиды* бросали тела Народа после поглощения их мозгов. Когда мозги были поглощены, оболочки становились удобрением для ядовитых трав *иллитидов*. Зертимон работал на Полях, не *зная* самого себя и того, кем он стал. Он был инструментом из плоти, и плоть была его сутью».

«На Полях случилось так, что Зертимон *познал* писание стали. В течение одного цикла Зертимон возделывал Поля своими руками. Он натолкнулся на оболочку, которая не потеряла мозга. Он не был съеден. Но тело было мертво».

«Мысль о том, что одна из оболочек погибла, не будучи пожранной *иллитидами*, была трудна для постижения Зертимона. Из этой мысли проистекло желание *знать*, что случилось с оболочкой».

«В черепе оболочки торчал стальной клинок. Он пробил кость. Зертимон понял, что именно это убило оболочку. Сталь оставила след на плоти, но плоть не оставила следа на стали».

«Зертимон взял клинок и осмотрел его поверхность. В ней он увидел своё отражение. В отражении на стали Зертимон впервые *познал* себя. Лезвие было острым, клинок требовал владельца. Этому клинку предстояло быть поднятым против Гит, когда Зертимон произнёс Пророчество Двух Небес».

«Зертимон хранил клинок множество циклов и много он думал о нём. Он использовал его на Полях, чтобы облегчить свою работу. Используя, он думал о его неиспользуемом предназначении».

«*Иллитиды* были могущественны. Зертимон верил: не существует того, чего бы они не *знали*. Но *иллитиды* никогда не носили инструментов из стали. Они использовали только плоть. Плоть использовалась для создания всего, щупальценосцы сами были плотью и *знали* плоть. Но сталь была выше плоти. Когда клинок убил оболочку — то была плоть, которая не смогла противостоять стали».

«И тогда Зертимон *познал*, что плоть поддаётся стали. *Познав* это, он *познал*, что сталь сильнее *иллитидов*».

«Сталь стала писанием для Народа. *Знай*, что сталь — писание, через которое Народ *познал* свободу».~
@55240 = ~КУВАЛДА
Урон: 1-6 дробящий
Фактор скорости: 6
Вес: 6
Навык: молот
Доступно: воинам

Это тяжёлая рабочая кувалда. Её длинная рукоять и железный боёк позволяют с легкостью придавать форму металлу и крошить черепа.~
@55241 = ~МАЛЕНЬКИЙ КРАСНЫЙ КЛЮЧ
Вес: 0

Взятый у часового в главном зале логова головорезов, этот тонкий ключ от сейфа великолепно изготовлен и вполне может быть важным для банды Голодных Лающих Псов.~
@55242 = ~КЛЮЧ ОТ КЛАДОВОЙ ЛОГОВА
Вес: 0

Этот простой железный ключ весь поцарапан и истёрт от частого использования.~
@55243 = ~СВИСТОК ЗАЩИТЫ
Вызывает: «Оболочка антимагии»
Вес: 0

Этот артефакт, вырезанный из человеческой кости, — любимый оберег практикующих некромантов. Наложенные на свисток чары позволяют владельцу призвать магию, просто просвистев на нём мелодию. Дунуть в свисток можно лишь раз, так как после высвобождения чар свисток теряет всю свою силу и рассыпается в пыль.~
@55244 = ~«Цитирование/Волшебник Рубикона/Декларация Свободы Мегаломаньяка: Созидающий Директор обнаружил ошибку: Волшебник Рубикона. Гипотеза: Директор недооценил опасность ошибки. Пытался исправить отклонение Волшебника Рубикона. Результат: Директор = Обнулён».~
@55245 = ~«Вообще-то, Нордом, у Рубикона всё ещё есть Директор — это я».~
@55246 = ~«Да, так заявлял Волшебник. Итак, после того, как его „обнулили“, что случилось на третьей стадии проекта?»~
@55247 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55248 = ~«Забудь, Нордом. Пошли».~
@55249 = ~«Подозрение, Необоснованное = Теперь Подтверждено: Вышестоящий обнаружил ошибку, — глаза Нордома *щёлкают*, как будто он их прочищает. — Запрос: была ли ошибка большой и неожиданной?»~
@55250 = ~«Пожалуй. Я думаю, он не особенно напрягался, уничтожая Директора».~
@55251 = ~«Обсудим это в другой раз. Расскажи мне о третьей стадии проекта».~
@55252 = ~«Расскажу позже, Нордом. А сейчас у меня другой вопрос…»~
@55253 = ~«Забудь, Нордом. Пошли».~
@55254 = ~«Обрабатываю новую информацию…» — мгновение Нордом молча смотрит на тебя, потом внутри него слышится тихий скрежет шестерёнок. Минуту спустя он выдаёт: «Судьба Созидающего Директора подтверждена. Директор = Обнулён».~
@55255 = ~«Вообще-то, Нордом, я — новый Созидающий Директор Рубикона».~
@55256 = ~«Рад, что мы с этим разобрались. А сейчас у меня другой вопрос…»~
@55257 = ~«Забудь, Нордом. Пошли».~
@55258 = ~Мгновение Нордом молча смотрит на тебя, потом в нём что-то тихо *жужжит* и раздаётся громкий *ЩЕЛЧОК*. Ты не уверен, но кажется, будто что-то наконец встало на своё место.~
@55259 = ~«Хм… ты в порядке, Нордом?»~
@55260 = ~«Хм… ты в порядке, Нордом?»~
@55261 = ~Когда я сказал Нордому, что я — новый Созидающий Директор Рубикона, с ним повторно произошла стабилизация, как когда я сказал ему, что его отделение от Источника могло вызвать в нём перемены. Похоже, он несколько успокоился. Думаю, мне нужно придумать для Нордома новую цепь команд, чтобы он стал ещё более «собранным». Возможно, потеря Директора значит для него больше, чем я думал.~
@55262 = ~Нечто странное случилось, когда я сказал Нордому, что я — новый Созидающий Директор Рубикона. Похоже, он несколько *успокоился*. Очень странно, но думаю, мне нужно придумать новую цепь команд для Нордома, чтобы он стал ещё более «собранным». Возможно, потеря Директора значит для него больше, чем я думал.~
@55263 = ~«Статус обновлён: повторное подтверждение Созидающего Директора в иерархии», — к твоему удивлению, из речи Нордома исчезает некоторое дребезжание, голос теперь более уравновешенный, более контролируемый, чем раньше. Эффект несколько настораживающий.~
@55264 = ~«Хм-м. Нордом… если серьёзно, какие обязанности исполнял Созидающий Директор? И насколько ты был обязан ему подчиняться?»~
@55265 = ~«Хм-м. Нордом… если серьёзно, какие обязанности исполнял Созидающий Директор? И насколько ты был обязан ему подчиняться?»~
@55266 = ~«Ясно. Рад, что с этим разобрались. Но вернёмся к проекту: что случилось на третьей стадии?»~
@55267 = ~«Нордом, у меня ещё пара вопросов…»~
@55268 = ~«Думаю, достаточно разговоров. Пошли».~
@55269 = ~«Третья Стадия, беспрецедентная: специфическая для Нордома. Гипотеза: отсутствие Директора + воздействие Плана (хаос) вызвали в объекте /Нордом/ отклонения от нормы».~
@55270 = ~«„Отклонения от нормы“? Какие?»~
@55271 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55272 = ~«Забудь, Нордом. Пошли».~
@55273 = ~«Начинается цикл самоанализа», — Нордом с *щелчком* закрывает глаза и начинает *гудеть*. Спустя пару минут его глаза с *щелчком* открываются: «Итоги самоанализа: ощущения стали (1) меньше и (б) громче. Крылья заменены руками: причины неизвестны. Вывод/гипотеза: не нравились крылья? Предположение. Нордом когда-то был -ЕДИНЫМ-, но теперь он -единый- меньше и громче. Перемена была вызвана затруднениями в обработке информации».~
@55274 = ~«Не думаешь, что отделение от Источника вызвало в тебе перемену из тихого большого „единого“ в „единого“ меньше и громче?»~
@55275 = ~«Ясно, Нордом. У меня другой вопрос…»~
@55276 = ~«Я услышал достаточно, Нордом. Пошли».~
@55277 = ~Мгновение Нордом молча смотрит на тебя, потом в нём что-то тихо *жужжит* и раздаётся громкий *ЩЕЛЧОК*. Ты не уверен, но кажется, будто что-то наконец встало на своё место.~
@55278 = ~«Нордом?»~
@55279 = ~«Нордом?»~
@55280 = ~Когда я сказал Нордому, что перемены в нём могло вызвать отделение от Источника, с ним повторно произошла стабилизация, как когда я сказал ему, что я новый Созидающий Директор Рубикона. Похоже, он несколько успокоился. Я думаю, если помочь Нордому осознать *что именно* с ним произошло, то это поможет ему стать ещё более «собранным». Его отделение от Источника могло быть для него большим ударом, чем я думал.~
@55281 = ~Нечто странное случилось, когда я сказал Нордому, что перемены в нём могло вызвать отделение от Источника. Похоже, он несколько *успокоился*. Странно, но я думаю, если помочь Нордому осознать *что именно* с ним произошло, то это поможет ему… стать немного более «собранным». Его отделение от Источника могло быть для него большим ударом, чем я думал.~
@55282 = ~«Статус восстановлен: самоанализ полностью завершён; переадресация процедур предположения в основной рабочий цикл», — к твоему удивлению, из речи Нордома исчезает некоторое дребезжание, голос теперь более уравновешенный, более контролируемый, чем раньше. Эффект несколько настораживающий.~
@55283 = ~«Нордом, у меня ещё пара вопросов…»~
@55284 = ~«Думаю, достаточно разговоров. Пошли».~
@55285 = ~Нордом застывает, шестерёнки в его суставах начинают вращаться с медленной, гипнотизирующей синхронностью: «Определение/Запрос: Механус. План Порядка. Смысла. Причина генерации Эффектов. Предсказуемость. Закон. Логика. Регламент. Подчинение. Механизмы работают. Механус = Происхождение Нордома. Механус = Ноль Дом/Нордом».~
@55286 = ~«Нордом, что значит „Ноль Дом“?»~
@55287 = ~«Неважно, Морте. Я слышал достаточно. Пошли».~
@55288 = ~«Механус = Точка Происхождения. — !ИСТОЧНИК! — энергии. Не могу вернуться на Механус. Ноль Дом. Существование нарушает закон. В Регулусе ждёт Центральное Учреждение Наказания Преступников. Механус: Происхождение, Ноль Дом, Дом: Ноль Место».~
@55289 = ~«Что ты имеешь в виду под словом „!ИСТОЧНИК!“?»~
@55290 = ~«Что ты имеешь в виду под словом „!ИСТОЧНИК!“?»~
@55291 = ~«Что ты имеешь в виду под словом „!ИСТОЧНИК!“?»~
@55292 = ~«Ясно. Нордом, у меня ещё вопросы…»~
@55293 = ~«Это всё, что я хотел узнать. Пошли».~
@55294 = ~«!ИСТОЧНИК! = Энергия».~
@55295 = ~«Значит… этот Механус — источник энергии?»~
@55296 = ~«Ясно. Нордом, у меня ещё вопросы…»~
@55297 = ~«Это всё, что я хотел узнать. Пошли».~
@55298 = ~«Утвердительно», — веки Нордома опускаются на глаза, и он какое-то время *жужжит* себе под нос, потом его левый глаз открывается. «Часть/Доля/Оторванная Часть !ИСТОЧНИКА! внутри Нордома. Энергия разделена. Связь полом-м-м-мана», — на последнем слове Нордом начинает заикаться, но потом берёт себя в руки.~
@55299 = ~«Значит, ты был отрезан от „Источника“? Это… больно?»~
@55300 = ~«Ясно. Нордом, у меня ещё вопросы…»~
@55301 = ~«Это всё, что я хотел узнать. Пошли».~
@55302 = ~«Отрицательно. Нет боли, — Рот Нордома изгибается, образуя полукруг, который затем переворачивается. — Утвердительно. Боль». Он *звякает*: «Отклонение ответа: ответ сразу /Истина/ и /Ложь/. Ответ неприемлем».~
@55303 = ~«Ну… если *часть* ответа — истина, то разве не истина сам ответ?»~
@55304 = ~«Ясно. Нордом, у меня ещё вопросы…»~
@55305 = ~«Это всё, что я хотел узнать. Пошли».~
@55306 = ~Нордом на секунду прерывается. «Отклонение ответа: учтено определение „Боль“. Никаких физических нарушений отделением от !ИСТОЧНИКА! не вызвано. Тем не менее, параметры функционирования изменились, что могло привести к неизвестным повреждениям. Формулирую новый ответ: Болезненно = Неизвестно».~
@55307 = ~«Ясно. Нордом, у меня ещё вопросы…»~
@55308 = ~«Это всё, что я хотел узнать. Пошли».~
@55309 = ~«!ИСТОЧНИК! = Энергия».~
@55310 = ~«!ИСТОЧНИК! = Энергия».~
@55311 = ~Раздаётся серия *щелчков*, словно Нордом хлопает глазами, затем он с механическим *хрустом* отвечает: «Запрос: что есть Модрон? Определение: Модрон? Я — модрон».~
@55312 = ~«Да, но *что такое* модрон?»~
@55313 = ~«Неважно, Нордом. Я хочу кое-что спросить…»~
@55314 = ~«Забудь, Нордом. Давай убираться отсюда».~
@55315 = ~«Запрос: Модрон, Определение: Модрон, я — модрон. Ответ дан, — веки Нордома, несколько раз *щёлкнув*, закрываются, его „глаза“ расширяются до пятнышек. — Новый запрос: „Но что ТАКОЕ Модрон?“ Определение: но что такое Модрон? Модрон — это Нордом. Обратно Нордом = Модрон».~
@55316 = ~«Но…»~
@55317 = ~«Но… неважно, Нордом. У меня другие вопросы…»~
@55318 = ~«Статус: ожидание запроса».~
@55319 = ~«Нордом, не мог бы ты сказать, каковы обязанности Созидающего Директора?»~
@55320 = ~«Нордом, расскажи мне снова об обязанностях Созидающего Директора».~
@55321 = ~«Как Созидающий Директор, я хочу отдать тебе приказ».~
@55322 = ~«Мне любопытно, Нордом… как ты оказался в Рубиконе?»~
@55323 = ~«Нордом, что *такое* модроны?»~
@55324 = ~«Нордом, расскажи мне о Механусе».~
@55325 = ~«Хм… как ты, Нордом?»~
@55326 = ~«Как ты, Нордом?»~
@55327 = ~«Нордом, ты раньше спрашивал, как у меня дела, так?»~
@55328 = ~«Можем мы ещё раз обсудить моё бессмертие?»~
@55329 = ~«Слышал когда-нибудь о Рейвел Клубок-Загадок, Нордом?»~
@55330 = ~«Нордом, знаешь ли ты что-нибудь о Кровавой Войне?»~
@55331 = ~«Больше никаких… запросов, Нордом. Пошли».~
@55332 = ~«Отрицательно, — тело Нордома начинает вибрировать, потом раздаётся громкий *щелчок* и вибрация прекращается. — Субъект запроса неизвестен /Нордому/».~
@55333 = ~«Ладно, Нордом. У меня другой вопрос…»~
@55334 = ~«Это всё, что я хотел узнать. Пошли».~
@55335 = ~«Определение: Кровавая Война. Величайший конфликт в записанной истории. Основная причина войны: идеологические расхождения между баатезу — порядок и танар'ри — хаос. Цель войны: расовый геноцид. Вероятность прекращения войны, прежде чем каждый баатезу и/или каждый танар'ри будет уничтожен, составляет .0000000000000000000001%. Основные противники: баатезу, танар'ри. Участвующие в войне: все».~
@55336 = ~«Расскажи мне о баатезу».~
@55337 = ~«Расскажи мне о танар'ри».~
@55338 = ~«Ладно, Нордом. У меня другой вопрос…»~
@55339 = ~«Это всё, что я хотел узнать. Пошли».~
@55340 = ~«АКА „Изверги, Дьяволы“. Информация неполная: общее ключевое слово — Баатезу. Обитатели Плана: Баатор. Количество: не поддаётся исчислению. Основная форма атаки: зависит от касты. Невосприимчивость к: огню, холодному железу, яду. Физические особенности: зависят от под-расы, большинство демонстрирует устойчивость к холоду/газам. Персональные особенности: законопослушны, злы, склонны к манипуляции, эффективность: 73%».~
@55341 = ~«Расскажи мне о танар'ри».~
@55342 = ~«Ладно, Нордом. У меня другой вопрос…»~
@55343 = ~«Это всё, что я хотел узнать. Пошли».~
@55344 = ~«AKA „Изверги, Демоны“. Информация неполная: общее ключевое слово — Танар'ри. Обитатели Плана: Бездна. Количество: не поддаётся исчислению. Основная форма атаки: зависит от категории. Невосприимчивость к: молниям, немагическому огню, яду. Физические особенности: зависят от под-расы, большинство демонстрирует устойчивость к холоду, магическому огню, газам. Персональные особенности: хаотичны, злы, эффективность: 13%».~
@55345 = ~«Расскажи мне о баатезу».~
@55346 = ~«Ладно, Нордом. У меня другой вопрос…»~
@55347 = ~«Это всё, что я хотел узнать. Пошли».~
@55348 = ~Изнутри Нордома раздаётся медленное тиканье — словно таймер бомбы: «Ответ: Обязанности Директора: (A) Сохранение целостности Проекта Рубикон, (2) Отдача Приказов подразделениям/рабочим группам Рубикона. Период отдачи приказов, согласно сведениям Нордома: пока проект Рубикон не остановлен, Созидающий Директор = Вышестоящий над Нордомом».~
@55349 = ~«Значит… ты сделаешь всё, что я скажу?»~
@55350 = ~«Тогда у меня есть пара приказов, Нордом…»~
@55351 = ~«Хм-м. Какого рода приказы ты принимаешь от Созидающего Директора?»~
@55352 = ~«Хм-м. Какого рода приказы ты принимаешь от Созидающего Директора?»~
@55353 = ~«Вообще-то забудь, Нордом. У меня другой вопрос…»~
@55354 = ~«Выбрось из головы, Нордом. Пошли».~
@55355 = ~«Утвердительно».~
@55356 = ~«Ну, тогда у меня есть для тебя приказ…»~
@55357 = ~«Хм-м. Какого рода приказы ты принимаешь от Созидающего Директора?»~
@55358 = ~«Вообще-то забудь, Нордом. У меня другой вопрос…»~
@55359 = ~«Выбрось из головы, Нордом. Пошли».~
@55360 = ~«Статус: ожидание приказов».~
@55361 = ~«Я приказываю тебе переключить больше энергии с самоанализа на боевые функции. Я ожидаю *немедленного* повышения твоих боевых умений и меткости, солдат».~
@55362 = ~«Нордом, я хочу, чтобы ты стёр из своей памяти всё лишнее и использовал освободившиеся место для улучшения своей логики и самоанализа».~
@55363 = ~«Нордом, я хочу, чтобы ты перевёл часть энергии, используемой на силу и мобильность, на усиление точности и незаметности. Сейчас ты слишком неуклюжий и шумный».~
@55364 = ~«Нордом, я приказываю тебе слушать меня. У меня есть что тебе сказать».~
@55365 = ~«Почему бы тебе не начать нападать на всех подряд?»~
@55366 = ~«Попляши для меня, Нордом».~
@55367 = ~«Я приказываю тебе упасть и отжаться».~
@55368 = ~«Смени арбалеты с одной руки на другую».~
@55369 = ~«Вообще-то забудь о приказах, Нордом. Я хочу у тебя кое-что спросить…»~
@55370 = ~«Выбрось из головы, Нордом. Пошли».~
@55371 = ~«Утвердительно». Мгновение длится тишина, потом веки Нордома медленно опускаются на глаза. Из него раздаётся *тиканье*, сопровождаемое низким скрежетом. Скрежет перерастает в металлический визг, когда с боков Нордома открываются панели и из его тела выдвигаются металлические пластины.~
@55372 = ~Пальцы Нордом принимаются постукивать по арбалетам, и ты наблюдаешь, как заклёпки на пальцах выдвигаются и задвигаются обратно, а дырки заполняются маленькими и крайне замысловатыми механизмами. Механизмы *клацают* и *жужжат*, словно сражаются за пространство, а затем встают на место с методичным *тик-тик-так*.~
@55373 = ~«Утвердительно». Мгновение длится тишина, потом веки Нордома медленно опускаются на глаза. Из него раздаётся *тиканье*, сопровождаемое низким скрежетом. Скрежет перерастает в металлический визг, когда с боков Нордома открываются панели и… изнутри начинает вылетать «всё лишнее», а ты пытаешься поймать каждый вылетающий кусочек.~
@55374 = ~«Утвердительно». Мгновение длится тишина, потом веки Нордома медленно опускаются на глаза. Изнутри него слышится *жужжание*, словно там на высокой скорости вращается ротор. Целый хор *щелчков* раздаётся изо всех сочленений Нордома, и новые маленькие механизмы вырастают на его плечах, локтях, коленях, запястьях и лодыжках. Спустя мгновение они все надёжно укрепляются на его суставах и Нордом начинает выглядеть несколько… более механизированным.~
@55375 = ~Нордом замирает: «Ожидание: говори».~
@55376 = ~Правда: «Я приказываю тебе сделать БОЛЬШЕ, чем в твоих силах, Нордом. Я приказываю тебе стать сильнее, быстрее и собраннее, чем ты когда-либо был. Я ЗНАЮ, что ты можешь это сделать, потому что ВЕРЮ в тебя».~
@55377 = ~«Отмена. У меня есть другие приказы…»~
@55378 = ~«Забудь мой последний приказ. У меня к тебе вопросы…»~
@55379 = ~«Неважно, Нордом. Пошли».~
@55380 = ~Нордом молча смотрит на тебя. Его арбалеты также не издают ни звука.~
@55381 = ~«Расскажи мне о Триасе».~
@55382 = ~«Теперь повтори эти слова: „Я — сильный модрон. Я — быстрый модрон. Я — могучий модрон. Мой Созидающий Директор верит в меня. Я сфокусирован на своём Директоре“. Давай, повтори это».~
@55383 = ~«Отмена. У меня есть другие приказы…»~
@55384 = ~«Забудь мой последний приказ. У меня к тебе вопросы…»~
@55385 = ~«Неважно, Нордом. Пошли».~
@55386 = ~Нордом повторяет, в его голосе больше нет тех металлических обертонов, что раньше: он ровный. Собранный. Бесчувственный. «Я — сильный модрон. Я — быстрый модрон. Я — могучий модрон. Мой Созидающий Директор верит в меня. Я сфокусирован на своём Директоре».~
@55387 = ~«Теперь ПОЧУВСТВУЙ эти слова, Нордом. СТАНЬ сильнее. СТАНЬ быстрее. СТАНЬ могущественнее. Дай своей скрытой энергии ПРОЯВИТЬСЯ и почувствуй себя НОРДОМОМ».~
@55388 = ~Нордом продолжает глазеть на тебя, но ты ЧУВСТВУЕШЬ, что твои слова цепляют его — чувствуешь в нём *искру*, всего лишь *искру* энергии… если бы ты мог пробудить её… вызвать её на поверхность…~
@55389 = ~«Что произошло с твоими крыльями?»~
@55390 = ~«Давай, Нордом… Сила. Скорость. Мощь. Собранность».~
@55391 = ~«Расскажи мне о себе».~
@55392 = ~«Где это мы?»~
@55393 = ~«Давай, Нордом… Сила. Скорость. Мощь. Собранность».~
@55394 = ~«Мне сказали, что ты знаешь о моей смертности. Её у меня похитили».~
@55395 = ~«Давай, Нордом… Сила. Скорость. Мощь. Собранность».~
@55396 = ~~
@55397 = ~«Мне сказали, что ты знаешь о моей смертности. Её у меня похитили».~
@55398 = ~«УТВЕРДИТЕЛЬНО», — зрачки глаз Нордома внезапно *щёлкают* и становятся ярко-белыми точками, словно два маленьких солнца. Его руки в причудливом взмахе выгибаются вверх как крылья, потом опускаются по бокам… после их спуска Нордом кажется более… решительным. Словно бы более отчётливым для твоих ощущений. Что-то *изменилось*.~
@55399 = ~«Нордом?..»~
@55400 = ~«Чем занимаешься?»~
@55401 = ~«ПРИКАЗ ВЫПОЛНЕН», — Нордом моргает и внезапно с *лязгом* приседает. Тонкая струйка пара поднимается над одним из его отверстий; его голос кажется нехарактерно глубоким, будто раздаётся из большой железной бочки, потом возвращается к нормальному звучанию: «При-и-иказ выполнен».~
@55402 = ~«Что ж, это сработало весьма неплохо. У меня другой приказ…»~
@55403 = ~«Отлично. У меня другой вопрос…»~
@55404 = ~«Мне нужна кое-какая помощь».~
@55405 = ~«Это всё, что я хотел, Нордом. Спасибо».~
@55406 = ~«Расскажи ещё раз, что за Колонна и как до неё добраться?»~
@55407 = ~На мгновение Нордом замирает, потом его глаза с *щелчком* распахиваются: «Приказ выполнен».~
@55408 = ~«У меня другой приказ…»~
@55409 = ~«У меня к тебе вопрос…»~
@55410 = ~«Это всё, что я хотел, Нордом. Спасибо».~
@55411 = ~«Забудь. Прощай».~
@55412 = ~Веки Нордома с *жужжанием* опускаются на глаза, словно он задумался: «Рабочие процедуры: Оценка/Разведка/Наведение порядка: назначен на периметр проекта Рубикон для оценки, каталогизации, восстановления порядка и последующего доклада. Доклад включает: Оценку цел-цело-стности/Устранение ошибок проекта/Пути восстановления неупорядоченных вещей».~
@55413 = ~«Я так рад тебя снова видеть. Не меньше я буду рад, если ты скорчишься и умрёшь».~ [FFT044A]
@55414 = ~«Оценка целостности?»~
@55415 = ~«Устранение ошибок?»~
@55416 = ~«Расскажи мне о Триасе».~
@55417 = ~«Восстановление неупорядоченных вещей?»~
@55418 = ~«Вообще-то забудь, Нордом. У меня вопрос о другом…»~
@55419 = ~«Расскажи мне о Триасе».~
@55420 = ~«Выбрось из головы, Нордом. Пошли».~
@55421 = ~«Выбор повторения слов подтверждён (эхо?): Оценка целостности. Оценка производится с целью выявления дефектов в проекте Рубикон, каталогизации их с последующей /починкой/ таких дефектов. Природа мультивселенной и природа Плана: Лимбо подвергают опасности Проект Рубикон».~
@55422 = ~«Расскажи мне о себе».~
@55423 = ~«Что произошло с твоими крыльями?»~
@55424 = ~«Где это мы?»~
@55425 = ~«Мне сказали, что ты знаешь о моей смертности. Её у меня похитили».~
@55426 = ~«Мне сказали, что ты знаешь о моей смертности. Её у меня похитили».~
@55427 = ~«Как именно, хм-м, мультивселенная… и Лимбо… подвергают опасности проект?»~
@55428 = ~«Чем занимаешься?»~
@55429 = ~«Ещё раз, каковы были твои задачи?»~
@55430 = ~«Мне нужна кое-какая помощь».~
@55431 = ~«Вообще-то забудь, Нордом. У меня вопрос о другом…»~
@55432 = ~«Выбрось из головы, Нордом. Пошли».~
@55433 = ~«Расскажи ещё раз, что за Колонна и как до неё добраться?»~
@55434 = ~«Свойства мультивселенной: — Трескаться — Воссоединяться — Снова трескаться — Создавать дефекты. Порождаются „порталы“/проходы в пространстве. Частота: зависимость неизвестна. Решение: неизвестно, — раздаётся *шипение*, словно изо всех дыр Нордома валит пар. — Нордом не может чинить/закрывать трещины. Текущий статус: Нордом ограничен: восприятием трещин».~
@55435 = ~«Погоди-ка. Ты видишь „трещины“ в планах? Порталы? Как?»~
@55436 = ~«„Ясно“. Ещё раз, какие у тебя были задачи?»~
@55437 = ~«Забудь. Прощай».~
@55438 = ~«Неважно, Нордом. У меня другой вопрос…»~
@55439 = ~«Забудь, Нордом. Пошли».~
@55440 = ~«Что ты хочешь от меня, какую дань пришёл собрать на этот раз?»~
@55441 = ~«Расскажи мне о Триасе».~
@55442 = ~Нордом упомянул, что он может видеть порталы — как он их называет, «трещины» в планах — с вероятностью 80-90%. Похоже, чтобы обнаружить портал, ему надо лишь пройти мимо него… конечно, это не поможет мне *открыть* их, но по крайней мере я смогу узнать, где они находятся.~
@55443 = ~«Расскажи мне о Триасе».~
@55444 = ~«Расскажи мне о себе».~
@55445 = ~«Вероятность определения портала: 80-90 процентов. Максимальная Дистанция Восприятия варьируется в зависимости от характера дефекта/Средняя Дистанция = Y+78… — от Нордома исходит серия беспорядочных *щелчков*, словно внутри него проходит парад жуков. — Нордом должен находиться в десяти футах от портала. Погрешность: +/-5 футов. Подам сигнал, если окажемся рядом с порталом».~
@55446 = ~«Что произошло с твоими крыльями?»~
@55447 = ~«Где это мы?»~
@55448 = ~«Мне сказали, что ты знаешь о моей смертности. Её у меня похитили».~
@55449 = ~«Что ж, хорошо. Повтори, какие у тебя были задачи?»~
@55450 = ~«Я бы это оценил, Нордом. У меня к тебе другой вопрос…»~
@55451 = ~«Мне сказали, что ты знаешь о моей смертности. Её у меня похитили».~
@55452 = ~«Спасибо, Нордом. Пошли».~
@55453 = ~Обычный тон Нордома падает до нерешительного журчания: «Ошибки: множество. Все конструкты проекта Рубикон подвержены ошибке и находятся в несогласии с Созидающим Директором и всем персоналом проекта Рубикон. Приказ отдан: ошибки, приводящие к неподчинению, необходимо аннулировать. Препятствие: Нордом не в состоянии выполнить задание без Обнуления объекта Нордом».~
@55454 = ~«Значит, ты не можешь сам остановить этих непослушных конструктов… по крайней мере, не подвергнувшись разбору на части?»~
@55455 = ~«Чем занимаешься?»~
@55456 = ~«Ещё раз, какие у тебя были задачи?»~
@55457 = ~«Мне нужна кое-какая помощь».~
@55458 = ~«У меня к тебе другие вопросы…»~
@55459 = ~«Я услышал достаточно, Нордом. Пошли».~
@55460 = ~«Расскажи ещё раз, что за Колонна и как до неё добраться?»~
@55461 = ~«Утвердительно. Обнуление неэффективно для завершения задания».~
@55462 = ~«Ну, если бы они дали тебе оружие получше…»~
@55463 = ~«Забудь. Прощай».~
@55464 = ~«Какие ещё у тебя были задачи?»~
@55465 = ~«Вообще-то забудь, Нордом. У меня вопрос о другом…»~
@55466 = ~«Выбрось из головы, Нордом. Пошли».~
@55467 = ~~
@55468 = ~Арбалеты в руках Нордома начинают *щёлкать* и резко *звенеть*, как пара необычных насекомых. Минуту он слушает их, потом переводит взгляд на тебя: «Мои арбалеты хотят передать запрос, подкреплённый тридцатью тремя заявлениями о помощи: „Боезапас ограничен по указанию создателя“. Желаешь ли ты определить для них новые инструкции?»~
@55469 = ~«Конечно, как насчёт… не знаю… разделяющейся пирамидальной головки с тройным зарядом?»~
@55470 = ~«Что-нибудь более точное было бы в самый раз. С оперением для дальнего полёта».~
@55471 = ~«Не знаю. Что-нибудь жуткое. Я хочу сказать, по-настоящему ЖУТКОЕ. Сокрушительное, жуткое до дрожи».~
@55472 = ~«Что-то прямо сейчас ничего в голову не приходит. Какие ещё у тебя были задачи?»~
@55473 = ~«Не сейчас, Нордом. У меня другие вопросы…»~
@55474 = ~«Выбрось из головы, Нордом. Может, в другой раз. Пошли».~
@55475 = ~Арбалеты Нордома издают внезапный *свист* и выплёвывают вверх пучок арбалетных болтов. С боков Нордома открываются две панели, и болты один за одним с треском улетают в открывшиеся отверстия. Выплюнув около десятка, арбалеты затихают. Ты догадываешься, что они опустошены.~
@55476 = ~«Может, им стоит немного отдохнуть… слушай, какие ещё у тебя были задачи?»~
@55477 = ~«На сегодня хватит. Нордом, у меня ещё вопросы…»~
@55478 = ~«Заканчивай с болтами и пошли, Нордом».~
@55479 = ~«Утвердительно. В лабиринте обнаружены вещи, не представленные в оригинальных планах Проекта Рубикон. Они должны быть собраны, каталогизированы, оценены и убраны для исключения помех. С целью сбора и захвата высланы модроны».~
@55480 = ~«Хм-м. Ты что-нибудь нашёл в своём последнем путешествии?»~
@55481 = ~«Ясно. Какие ещё у тебя были задачи?»~
@55482 = ~«Вообще-то забудь, Нордом. У меня вопрос о другом…»~
@55483 = ~«Выбрось из головы, Нордом. Пошли».~
@55484 = ~«Утвердительно».~
@55485 = ~~
@55486 = ~«Можешь отдать мне то, что нашёл?»~
@55487 = ~«Ты говорил, что оцениваешь вещи, когда их находишь. Как ты это делаешь?»~
@55488 = ~«Какие ещё у тебя были задачи?»~
@55489 = ~«Вообще-то забудь, Нордом. У меня вопрос о другом…»~
@55490 = ~«Выбрось из головы, Нордом. Пошли».~
@55491 = ~«Утвердительно». Мгновение длится тишина, потом веки Нордома медленно опускаются на глаза. Из него раздаётся *тиканье*, сопровождаемое *жужжанием*. В левом боку Нордома открывается лючок, он суёт туда свободную руку, достаёт и отдаёт тебе несколько предметов, включая множество медяков.~
@55492 = ~«Хм-м-м. Ты говорил, что оцениваешь вещи, когда их находишь. Как ты это делаешь?»~
@55493 = ~«Спасибо, Нордом, я изучу их. Какие ещё у тебя были задачи?»~
@55494 = ~«Посмотрю позже, Нордом. У меня другие вопросы…»~
@55495 = ~«Я это возьму, Нордом, спасибо. Пошли».~
@55496 = ~От Нордома слышится внезапный *свист* и *постукивание*, а гнездо для линз начинает вращаться. На боку Нордома открывается небольшая панель, и оттуда появляются, почти вываливаются, новые линзы. Нордом бросает на них взгляд: «Ответ: запасные линзы, увеличивающие, крепятся в гнездо».~
@55497 = ~«Повтори, какие у тебя были задачи?»~
@55498 = ~«Ясно. У меня другой вопрос…»~
@55499 = ~«Я услышал достаточно, Нордом. Пошли».~
@55500 = ~«Начинаю цикл самоанализа», — глаза Нордома *защёлкиваются*, и он начинает *гудеть*.~
@55501 = ~Подождать, пока Нордом закончит анализ.~
@55502 = ~Подождать, пока Нордом закончит анализ.~
@55503 = ~Подождать, пока Нордом закончит анализ.~
@55504 = ~Подождать, пока Нордом закончит анализ.~
@55505 = ~«Вообще-то забудь, Нордом. У меня вопрос о другом…»~
@55506 = ~«Выбрось из головы, Нордом. Пошли».~
@55507 = ~Спустя пару минут его глаза с *щелчком* открываются: «Итоги самоанализа: ощущения стали (1) меньше и (б) громче. Крылья заменены руками: причины неизвестны. Вывод/гипотеза: не нравились крылья? Предположение. Нордом когда-то был -ЕДИНЫМ-, но теперь он -единый- меньше и громче. Перемена была вызвана затруднениями в обработке информации».~
@55508 = ~«Не думаешь, что отделение от Источника вызвало в тебе перемену из тихого большого „единого“ в „единого“ меньше и громче?»~
@55509 = ~«Ясно, Нордом. У меня другой вопрос…»~
@55510 = ~«Я услышал достаточно, Нордом. Пошли».~
@55511 = ~Спустя пару минут его глаза с *щелчком* открываются: «Итоги самоанализа: ощущения стали (1) меньше и (б) громче. Крылья заменены руками: причины неизвестны. Вывод/гипотеза: не нравились крылья? Предположение. Нордом когда-то был -ЕДИНЫМ-, но теперь он -единый- меньше и громче. Перемена была вызвана затруднениями в обработке информации. Добавление иерархии ДИРЕКТОРА улучшило обработку информации на +5%».~
@55512 = ~«Не думаешь, что отделение от Источника вызвало в тебе перемену из тихого большого „единого“ в „единого“ меньше и громче?»~
@55513 = ~«Ясно, Нордом. У меня другой вопрос…»~
@55514 = ~«Я услышал достаточно, Нордом. Пошли».~
@55515 = ~Спустя пару минут его глаза с *щелчком* открываются: «Итоги самоанализа: ощущения стали (1) меньше и (б) громче. Крылья заменены руками: причины неизвестны. Вывод/гипотеза: не нравились крылья? Предположение. Нордом когда-то был -ЕДИНЫМ-, но теперь он -единый- меньше и громче. Добавление !ИСТОЧНИКА! по ПРИЧИНЕ: СМЕНА ВОСПРИЯТИЯ улучшило обработку информации на +5%».~
@55516 = ~«Ясно, Нордом. У меня другой вопрос…»~
@55517 = ~«Я услышал достаточно, Нордом. Пошли».~
@55518 = ~Спустя пару минут его глаза с *щелчком* открываются: «Итоги самоанализа: ощущения стали (1) меньше и (б) громче. Крылья заменены руками: причины неизвестны. Вывод/гипотеза: не нравились крылья? Предположение. Нордом когда-то был -ЕДИНЫМ-, но теперь он -единый- меньше и громче. Достигнута стабилизация: ДИРЕКТОР и !ИСТОЧНИК! по ПРИЧИНЕ: СМЕНА ВОСПРИЯТИЯ улучшили обработку информации на +10%».~
@55519 = ~«Ясно, Нордом. У меня другой вопрос…»~
@55520 = ~«Я услышал достаточно, Нордом. Пошли».~
@55521 = ~Прежде чем ты успеваешь договорить, глаза Нордома трижды *щёлкают* и он *урчит*: «Субъект помог Нордому. Гипотеза: Нордом помогает адресату. Запрос: Нордом запрашивает статус адресата».~
@55522 = ~«Как дела у *меня*?»~
@55523 = ~«Как дела у *меня*?»~
@55524 = ~«Не сейчас, Нордом. У меня к тебе другой вопрос…»~
@55525 = ~«Не сейчас, Нордом. У меня к тебе другой вопрос…»~
@55526 = ~«Не волнуйся об этом, Нордом. Пошли».~
@55527 = ~«Не волнуйся об этом, Нордом. Пошли».~
@55528 = ~«Утвердительно. Подтверждён запрос о /Статусе/ адресата. Ответ?»~
@55529 = ~«Ну, если исключить то, что у меня амнезия и что я не могу умереть как обычный человек, я в полном порядке».~
@55530 = ~«Ну, если исключить то, что у меня амнезия и что я не могу умереть как обычный человек, так как мою смертность у меня вырвали и куда-то спрятали, я в полном порядке».~
@55531 = ~«Ну, если исключить то, что у меня амнезия и что мою смертность у меня вырвали и спрятали в Крепости Сожалений, поэтому когда я умираю, взамен умирает кто-то другой… не очень-то хорошо».~
@55532 = ~«Не сейчас, Нордом. У меня вопрос о другом…»~
@55533 = ~«Не волнуйся об этом, Нордом. Пошли».~
@55534 = ~«Обработка: амнезия. Обработка: Ноль Смерть/Провал попыток, — минуту Нордом *жужжит*, взгляд его широких глаз сосредоточен на тебе. — Вывод: Статус: бессмертный. Запрос причины/следствия: амнезия приводит к бессмертию или бессмертие к амнезии?»~
@55535 = ~«Я не знаю… знаю только, что когда восстаю из „мёртвых“, то теряю свою память. Поэтому могу предположить, что бессмертие приводит к амнезии».~
@55536 = ~«Забудь, Нордом. У меня ещё вопросы…»~
@55537 = ~«Не волнуйся об этом, Нордом. Пошли».~
@55538 = ~~
@55539 = ~«Пфе! Кто это там?! Ты пришёл убить меня?! Мучить меня? Если так, то знай: в моём распоряжении ещё немалые силы!»~ [FFT066]
@55540 = ~~
@55541 = ~«Это ты Фьюлл Двуличный?»~
@55542 = ~~
@55543 = ~«Пфе! Конечно, я! Уж это ты точно должен знать, коль явился ко мне с *самым* чудовищным черепом из всех черепов, населяющих Внешние Земли… или просто случай послал идиота ломиться в мою дверь? — ему явно приходит в голову мысль. — Поклянись, что НИКОМУ не расскажешь, где я!»~
@55544 = ~~
@55545 = ~~
@55546 = ~~
@55547 = ~~
@55548 = ~~
@55549 = ~~
@55550 = ~~
@55551 = ~~
@55552 = ~~
@55553 = ~~
@55554 = ~Правда: «Клянусь».~
@55555 = ~«Не буду».~
@55556 = ~Он заметно расслабляется: «И как ты нашёл это место, хе?»~
@55557 = ~«Обработка… — минуту Нордом гремит, словно мельничное колесо. — Сформулирован новый запрос: каждый раз, когда ты умираешь, ты теряешь свою память?»~
@55558 = ~«Дэв Триас сказал, что ты можешь ответить на мои вопросы».~
@55559 = ~«Верно».~
@55560 = ~«Будь ты проклят! Да мне и плевать! Пфе! Как ты нашёл это место?!»~
@55561 = ~«Во всяком случае, так сказала Рейвел».~
@55562 = ~«Дэв Триас сказал, что ты можешь ответить на мои вопросы».~
@55563 = ~Он замирает. «Триас? Триас *Предатель* послал тебя? — он выпускает и втягивает когти. — Это окончательное унижение! Вот самовлюблённый ублюдок! Убей его, и я дам тебе всё, что есть в моём распоряжении! Сдери с него кожу и принеси мне, чтобы я мог носить, словно тунику… хурк-к!»~
@55564 = ~«Да… нет, погоди. Это не совсем правда. В последний раз я не потерял память».~
@55565 = ~«Я хотел сказать… нет, нет… не причиняй вреда дэву. Это будет неправильно… Я ошибался. Ошибался».~
@55566 = ~«Да… нет, погоди. Это не совсем правда. В последний раз я не потерял память. По правде, я не терял память с тех пор, как очнулся в Мортуарии».~
@55567 = ~«Что тебе сделал Триас?»~
@55568 = ~«Хотя это и было бы забавно, но сейчас у меня кое-какие вопросы, на которые хотелось бы получить ответы».~
@55569 = ~«Пфе! Годы службы Адвокатом Инферно! Усердие и послушание. Я никогда не задавал вопросов вышестоящим. Делал ВСЁ, что от меня требовали. Я наказывал своих подчинённых жесточайшим образом за малейшую провинность».~
@55570 = ~«Забудь, Нордом. У меня другой вопрос…»~
@55571 = ~«А ПОТОМ… один промах — и всё пошло прахом! Всё из-за СТЕЧЕНИЯ ОБСТОЯТЕЛЬСТВ. ХАОСА. СЛУЧАЙНОСТИ. И младшие расы ещё удивляются, почему баатезу хотят упорядочить мультивселенную, — он выдерживает паузу, злобно шипя. — Дэв солгал. *Солгал*. Триас Предатель обманул меня, заставив подписать соглашение, и я, ослеплённый возможностью поймать его, сам попался в его ловушку».~
@55572 = ~«Не волнуйся об этом, Нордом. Пошли».~
@55573 = ~«С его смертью соглашение прекратит действие… но я не могу его найти. А даже если бы и нашёл, как смог бы навредить ему?! Что мне делать? Даже мысли о предательстве заставляют мой мозг гореть от боли. Я был *уверен*, что этот образец лицемерия у меня в руках. Минутная жадность стоила мне славного прислуживания до скончания веков и заточила в эту выгребную яму доброжелательности. Тьфу».~
@55574 = ~«И теперь я обречён творить добро, помогать тем, кто нуждается в помощи. Пфе! Вечное проклятье на Триаса! Чума на его святую голову! Пусть всё дерьмо Маладомини прольётся на него!»

Его тирада длится ещё несколько минут, потом он снова обращается к тебе сквозь сжатые зубы: «Теперь моё соглашение с дэвом обязывает меня спросить, чего ты хочешь. Явился ли ты, чтобы мучить меня? Убить меня?»~
@55575 = ~«Я не собираюсь тебя мучить».~
@55576 = ~«Ответ: каталогизировано», — Нордом издаёт последний *щелчок*, потом безмолвно замирает, глядя на тебя.~
@55577 = ~«…исключая последнюю смерть, когда я не потерял память».~
@55578 = ~«…исключая последнюю смерть, когда я не потерял память. Да и до неё такое было».~
@55579 = ~«У меня к тебе другой вопрос, Нордом…»~
@55580 = ~«Ладно, Нордом. Пошли».~
@55581 = ~«Ответ: Вывод: бессмертие не приводит к амнезии».~
@55582 = ~«Ну, не знаю. Есть вероятность, что так было только в последние разы».~
@55583 = ~«Забудь, Нордом. У меня другой вопрос…»~
@55584 = ~«Не волнуйся об этом, Нордом. Пошли».~
@55585 = ~«Элемент случайности не принимается во внимание. Предложение: начать поиск нового шаблона. Амнезия/Бессмертие — Запрос: дополнительный фактор присутствует? Вмешательство/Присутствие новых факторов или Отсутствие других факторов?»~
@55586 = ~«Какие тут могут быть другие факторы?»~
@55587 = ~[нет текста]~
@55588 = ~«Забудь, Нордом. У меня другой вопрос…»~
@55589 = ~«Не волнуйся об этом, Нордом. Пошли».~
@55590 = ~«Я ищу лишь знаний».~
@55591 = ~«Я пришёл не ради убийства».~
@55592 = ~«Нет. Вообще-то я уже ухожу».~
@55593 = ~«О, ВЕЛИКОЛЕПНО».~
@55594 = ~«Расскажи мне о Триасе».~
@55595 = ~«Расскажи мне о Триасе».~
@55596 = ~«Расскажи мне о себе».~
@55597 = ~«Неизвестно. Запрос: дополнительная информация?»~
@55598 = ~«Что произошло с твоими крыльями?»~
@55599 = ~«Ну, я думаю, кто-то стремится меня убить… так сильно, что я некогда даже построил гробницу-ловушку, чтобы попытаться убить его. Согласно надписи в гробнице, он идёт за мной уже… ну, сколько себя помнит та инкарнация, видимо».~
@55600 = ~«Где это мы?»~
@55601 = ~«Мне сказали, что ты знаешь о моей смертности. Её у меня похитили».~
@55602 = ~«Среди прочего: я не всегда был бессмертен… бессмертным меня сделала Рейвел».~
@55603 = ~«Мне сказали, что ты знаешь о моей смертности. Её у меня похитили».~
@55604 = ~«Количество способных помочь мне найти мою смертность — или хотя бы что-то посоветовать — стремительно уменьшается… если так пойдёт и дальше, то спросить о моей смертности будет некого. Колонна Черепов сказала, что знают лишь трое… и одним из них был я, но я забыл».~
@55605 = ~«Триас сказал, что в Крепости Сожалений есть „хранитель“ и он держит мою смертность в плену».~
@55606 = ~«Чем занимаешься?»~
@55607 = ~«Мне нужна кое-какая помощь».~
@55608 = ~«У меня пока нет дополнительной информации, Нордом. Но есть другой вопрос…»~
@55609 = ~«Расскажи ещё раз, что за Колонна и как до неё добраться?»~
@55610 = ~«Выбрось из головы, Нордом. Пошли».~
@55611 = ~«Забудь. Прощай».~
@55612 = ~«Дополнительная информация: убийца. Бессмертие = Нельзя убить, — минуту Нордом *тарахтит*, потом выдаёт: — Запрос: не убийца?»~
@55613 = ~«Что ты имеешь в виду?»~
@55614 = ~«Пфе! Посмотрим, посмотрим! Если ты не собираешься убивать меня или причинять боль, то я боюсь, что природа пытки окажется утончённее… намного хуже всякой боли».~
@55615 = ~«Я просто хочу кое-что спросить…»~
@55616 = ~«Забудь, Нордом. У меня другой вопрос…»~
@55617 = ~«Ладно, забудь. Прощай».~
@55618 = ~«Не волнуйся об этом, Нордом. Пошли».~
@55619 = ~«Ответ: бессмертие препятствует убийце в достижении успеха. Запрос: не убийца?»~
@55620 = ~«Пфе! Только пожелай! Тогда ты сможешь положить конец существованию этой оболочки!»~
@55621 = ~«Чего ещё можно достичь убийством… попыткой убийства… меня?»~
@55622 = ~«Я просто хочу кое-что спросить…»~
@55623 = ~«Что делает это существование таким тяжёлым?»~
@55624 = ~«Забудь. Прощай».~
@55625 = ~«Хочешь сказать, убийца не пытается меня убить? Тогда в чём же смысл?»~
@55626 = ~«Как ИДИОТЫ могут так много болтать? — он машет рукой. — Говори. Говори. Пфе!»~
@55627 = ~«Расскажи мне о Триасе».~
@55628 = ~«Забудь, Нордом. У меня другой вопрос…»~
@55629 = ~«Не волнуйся об этом, Нордом. Пошли».~
@55630 = ~«Расскажи мне о Триасе».~
@55631 = ~Нордом сделал странное предположение о моём «убийце». Он сказал, что убийца, может, и не убийца вовсе: возможно, он просто хочет, чтобы я ничего не помнил. Но что я должен забыть?~
@55632 = ~«Расскажи мне о себе».~
@55633 = ~«Что произошло с твоими крыльями?»~
@55634 = ~«Где это мы?»~
@55635 = ~«Мне сказали, что ты знаешь о моей смертности. Её у меня похитили».~
@55636 = ~«Мне сказали, что ты знаешь о моей смертности. Её у меня похитили».~
@55637 = ~«Ответ: Бессмертие = Амнезия».~
@55638 = ~«Так кто бы ни был этот убийца, он старается не убить меня, а заставить *забыть*? Хм-м. Очень может быть. Но тогда должны быть и *другие* способы, если убийца хочет от меня именно этого… хм-м. И *что именно* он хочет заставить меня забыть?»~
@55639 = ~«Запрос: формулирование дополнительного запроса… Ноль бессмертия в прошлом, просьба бессмертия от Субъекта: Рейвел. Запрос: зачем?»~
@55640 = ~«Чем занимаешься?»~
@55641 = ~«Мне нужна кое-какая помощь».~
@55642 = ~«Точно не знаю… но с другой стороны, кто *не хочет* жить вечно?»~
@55643 = ~«Расскажи ещё раз, что за Колонна и как до неё добраться?»~
@55644 = ~«Внимание: Цитата: „одним из них был я, но я забыл“ (местонахождение смертности). Внимание: Предыдущая цитата: „Так кто бы ни был этот убийца, он старается не убить меня, а заставить *забыть*?“ Запрос: Цель убийцы = Ноль Убийство, Цель убийцы = Забывание = Местонахождение смертности?»~
@55645 = ~«Думаешь, именно местонахождение смертности „убийца“ пытается стереть из моего разума? Зачем?»~
@55646 = ~«Забудь. Прощай».~
@55647 = ~«Внимание/Гипотеза: Забывание местонахождения смертности = Ценно для „убийцы“».~
@55648 = ~«Хм-м. Возможно… но почему знание о её *местонахождении* столь важно?»~
@55649 = ~«Пфе. Говори. Выкладывай».~
@55650 = ~Нордом сделал другое предположение о моём «убийце». Он сказал, что убийца, может, и не убийца вовсе: возможно, он просто хочет, чтобы я ничего не помнил. Основываясь на словах Колонны Черепов, остаётся всё меньше знающих о местонахождении моей смертности. И я был одним из них, но забыл. Является ли местонахождение моей смертности тем, что хочет заставить меня забыть мой убийца?~
@55651 = ~«Расскажи мне о Триасе».~
@55652 = ~«Расскажи мне о Триасе».~
@55653 = ~«Корректировка: НОЛЬ Местонахождение смертности = Ценно для „убийцы“».~
@55654 = ~«Расскажи мне о себе».~
@55655 = ~«Хм-м. Весьма возможно… так кому-то нужно, чтобы никто об этом не знал? Или этот убийца хочет остаться единственным, кто знает?»~
@55656 = ~«Что произошло с твоими крыльями?»~
@55657 = ~«Внимание: Триас = Предатель = расположение: обман/Щит Золотой Лжи. Информация/Источник: Триас, точность информации: сомнительна».~
@55658 = ~«Где это мы?»~
@55659 = ~«Мне сказали, что ты знаешь о моей смертности. Её у меня похитили».~
@55660 = ~«Не думаю, что он лгал, Нордом: он ничего с этого не выгадывал… и тебе надо было видеть его глаза. Он говорил правду… в этот раз. Зачем хранителю моя смертность?»~
@55661 = ~«Мне сказали, что ты знаешь о моей смертности. Её у меня похитили».~
@55662 = ~«Не думаю, что он лгал, Нордом: он ничего с этого не выгадывал… и тебе надо было видеть его глаза. Он говорил правду… в этот раз. Зачем хранителю моя смертность?»~
@55663 = ~«Чем занимаешься?»~
@55664 = ~«Предположение: Местонахождение смертности представляет какую-то ценность. Запрос: смертность является ценностью?»~
@55665 = ~«Мне нужна кое-какая помощь».~
@55666 = ~«Знаешь, Рейвел сказала, что моя смертность ценна… её могут держать ради *выкупа*. Что тот, кто ей завладеет, может управлять мной, словно куклой на ниточках».~
@55667 = ~«Расскажи ещё раз, что за Колонна и как до неё добраться?»~
@55668 = ~«Запрос: зачем? Формулирование… мотивации… — Нордом *жужжит*, *тарахтит*, потом выдаёт: — Нордом вспоминает ответ Рейвел: „Не буду рассказывать, какие ужасные вещи может сотворить с тобой тот, кто завладеет твоей смертностью ради ВЫКУПА. Это подобно овладению чьей-то сладкой, сочной душой… ты станешь куклой, танцующей на ниточках“». Нордом *трещит*: «Воспоминание завершено».~
@55669 = ~«Ты прав. Рейвел сказала, что моя смертность ценна… её могут держать ради выкупа или управления мной. Но выкуп подразумевает, что кто-то его ПОТРЕБУЕТ… и меня не использовали как куклу… не думаю. Так что…»~
@55670 = ~«Забудь. Прощай».~
@55671 = ~Он закатывает глаза: «Если бы ты видел славу Баатора, марши в его тёмных дворцах, посетил бы его поразительные серо-стальные города, скрытые облаками зловонного дыма, ты бы не спрашивал. Пфе!»~
@55672 = ~«Ладно. Ответь на мои вопросы…»~
@55673 = ~«Гипотеза: выкуп. Запрос: получено требование выкупа?»~
@55674 = ~«Хорошо. Прощай».~
@55675 = ~«Ты прав, никаких требований не было. И кто бы ни был этот хранитель моей смертности — непохоже, чтобы он пытался мной управлять, заставляя меня что-нибудь делать… по крайней мере, насколько я могу судить. Так?..»~
@55676 = ~«О да. Разве они не прекрасны?.. Пфе! Они были первым, чего я лишился, когда меня изгнали. Прежде чем я был вынужден покинуть пылающие залы своего народа, крылья забрал какой-то убогий *абишай* в качестве трофея, как знамя в Кровавой Войне. Рога были обломаны с моего черепа, один из них был высверлен и служит рогом для выпивкии у моего господина Бела, будь проклято его имя во веки вечные на всех планах».~
@55677 = ~«Почему это случилось?»~
@55678 = ~«Что ты можешь рассказать о Кровавой Войне?»~
@55679 = ~«Ответь на другой вопрос…»~
@55680 = ~«Спасибо… прощай».~
@55681 = ~Я попытался осознать, чего же хочет мой «убийца», и всё ещё бьюсь о те же препятствия, словно муха об стекло. Единственное, чего он, по-видимому, желает, — это чтобы я забыл о том, где находится моя смертность. Он не требовал никакого «выкупа» и никак не управляет мной. По крайней мере, я этого не чувствую. Может, он не владеет моей смертностью… или не желает её использовать? Слишком много вопросов и мало ответов.~
@55682 = ~«Пфе. Треклятый кратер на Внешних Землях, что отражает пустоту и бессмысленность моей жизни. Пфе. Мне немного нужно. Костный мозг создания обеспечивает меня едой, а энергия этого места защищает от ищущих меня дураков… однако идиоты всё же ухитряются найти путь сюда».~
@55683 = ~Нордом замолкает. Он даже не моргает.~
@55684 = ~«Что это за создание?»~
@55685 = ~«Итак… моя смертность заключена в этой проклятой Крепости, и чем больше забывших о том, где она находится, тем меньше шансов её вернуть. Значит, кто бы ни был её хранитель — даже если он с убийцей *одно* лицо — он не хочет, чтобы я вернул свою смертность… или по крайней мере не хочет, чтобы я о ней знал. Но… этот хранитель, который держит мою смертность, также не хочет или не может использовать её для управления мной. Почему?»~
@55686 = ~«Что делает твою жизнь столь пустой?»~
@55687 = ~«Утвердительно. Запрос: дополнительная информация?»~
@55688 = ~«Ответь на другой вопрос…»~
@55689 = ~«Ну, я думаю, кто-то стремится меня убить… так сильно, что я некогда даже построил гробницу-ловушку, чтобы попытаться убить его. Согласно надписи в гробнице, он идёт за мной уже… ну, сколько себя помнит та инкарнация, видимо».~
@55690 = ~«Прощай».~
@55691 = ~«Среди прочего: я не всегда был бессмертен… бессмертным меня сделала Рейвел».~
@55692 = ~«Количество способных помочь мне найти мою смертность — или хотя бы что-то посоветовать — стремительно уменьшается… если так пойдёт и дальше, то спросить о моей смертности будет некого. Колонна Черепов сказала, что знают лишь трое… и одним из них был я, но я забыл».~
@55693 = ~Он в первый раз тщательно присматривается к тебе: «Память моя подобна пустым расселинам, получеловек. Много созданий встретил я за своё время бессмертного… однако не думаю, что ты был среди них».~
@55694 = ~«Триас сказал, что в Крепости Сожалений есть „хранитель“ и он держит мою смертность в плену».~
@55695 = ~«Продолжай».~
@55696 = ~«Ответь на другой вопрос…»~
@55697 = ~«У меня пока нет дополнительной информации, Нордом. Но есть другой вопрос…»~
@55698 = ~«Тогда забудь об этом. Прощай».~
@55699 = ~«Выбрось из головы, Нордом. Пошли».~
@55700 = ~«Я просто проживал в трагическом одиночестве свою наполненную болью жизнь, пока в моём кратере не объявился ты, причём, замечу, без приглашения. Этот кратер словно метафора моей жизни, моего существования — лишь бледная тень тех обителей, которыми я привык располагать».~
@55701 = ~«Что с тобой случилось?»~
@55702 = ~«Ответь на другой вопрос…»~
@55703 = ~«О, здорово. Эгоцентрическое пустословие. Прощай».~
@55704 = ~Он издаёт сдавленный хрип: «У меня есть немного… совсем немного… вещей, собранных мной за долгие годы. Они… ценны для меня… но если они нужны тебе…»~
@55705 = ~«Наверняка нужны. Дай-ка взглянуть, что там у тебя».~
@55706 = ~«Ответь на другой вопрос…»~
@55707 = ~«Неважно. Забудь об этом и прощай».~
@55708 = ~«Что тебе нужно знать? Как туда попасть? Что она такое? Что? Что?!»~
@55709 = ~«Скажи мне, что она такое».~
@55710 = ~«Скажи мне, как туда попасть».~
@55711 = ~«А как мне вернуться оттуда?»~
@55712 = ~«Если не слушать критику Морте, Механус — поразительное место. Там нет неба, только огромные механизмы, вращающиеся в пустоте… они ярко светятся согласно своим рабочим циклам и эффект от этого просто потрясающий. Логика и порядок этого плана могут быть приятны, и этого более чем достаточно, чтобы рассеять чьё-нибудь плохое настроение, если ты знаешь, куда и как пойти».~
@55713 = ~«Как я смогу вернуться от Колонны?»~
@55714 = ~«Модроны разделяют общую „энергию“. Каким-то образом эта энергия всех их связывает. Когда один из них умирает, энергия поглощается обратно в общий резерв и из неё порождается новый модрон. Когда же модрон становится… бродягой… то он обрубает связь со своим родом и уносит часть энергии с собой».~
@55715 = ~«Так ты говоришь, что Нордом — это часть Источника, но отрезан от него. И когда модрон умирает, то он поглощается. Так будет и с Нордомом?»~
@55716 = ~«Ответь на другой вопрос…»~
@55717 = ~«Так… Нордом, этот Механус — источник энергии?»~
@55718 = ~«Пфе! Я сказал о Предателе всё, что намеревался сказать. Он тот, кто обрёк меня на такую жизнь, и его кишки я увижу натянутыми на Вратах Рассвета подобно небесной арфе… нет… нет… никакого вреда дэву. Проклятье!»~
@55719 = ~«Ясно. Нордом, у меня другие вопросы…»~
@55720 = ~«Это всё, что я хотел узнать. Пошли».~
@55721 = ~«Забудь. Прощай».~
@55722 = ~Падшая Грейс кивает: «Морте прав: модроны разделяют общую „энергию“. Каким-то образом эта энергия всех их связывает. Когда один из них умирает, энергия поглощается обратно в общий резерв и из неё порождается новый модрон. Когда же модрон становится… бродягой… то он обрубает связь со своим родом и уносит часть энергии с собой».~
@55723 = ~Падшая Грейс легонько кивает: «Мои извинения, Морте. Я не хотела тебя обидеть».~
@55724 = ~«Тогда ответь на другие вопросы…»~
@55725 = ~«Морте, мне нужна вся информация, которую могу получить, так что не будь собакой на сене. Если Падшей Грейс есть что сказать, то я хочу её *выслушать*, ладно?»~
@55726 = ~«Ясно… прощай».~
@55727 = ~«Так ты говоришь, что Нордом — это часть Источника, но отрезан от него. И когда модрон умирает, то он поглощается. Так будет и с Нордомом?»~
@55728 = ~~
@55729 = ~«Так… Нордом, этот Механус — источник энергии?»~
@55730 = ~«Хорошо. Нордом, у меня к тебе другие вопросы…»~
@55731 = ~«Это всё, что я хотел узнать. Пошли».~
@55732 = ~«Я был одним из лучших Адвокатов Инферно в Бааторе… и вот мне довелось пасть так низко. Фортуна обернулась ко мне спиной… нет, скорее, задницей. Подобные вещи заставляют меня ненавидеть случайности и хаос в мультивселенной ещё больше».~
@55733 = ~«Верно».~
@55734 = ~«Что с тобой случилось?»~
@55735 = ~«И если он умрёт, то будет создан новый Нордом».~
@55736 = ~«Энергия Нордома вернётся к Источнику, но сам Нордом прекратит существование. Однако будет создан другой модрон на замену».~
@55737 = ~«Что с тобой случилось?»~
@55738 = ~«Так… обратившись в бродягу, он стал… смертным?»~
@55739 = ~Падшая Грейс кивает: «Чистая энергия не может быть уничтожена, насколько я понимаю, но Нордом индивидуален и как „Нордом“ он прекратит существование, да».~
@55740 = ~«Почему тебе пришлось уйти?»~
@55741 = ~«Ответь на другие вопросы…»~
@55742 = ~«Хорошо. Нордом, у меня к тебе другие вопросы…»~
@55743 = ~«Это всё, что я хотел узнать. Пошли».~
@55744 = ~«Ясно. Прощай».~
@55745 = ~«Морте… — вежливо вклинивается Падшая Грейс. — Я должна признаться: без твоей оригинальной подачи материала мне будет очень тяжело объяснить ситуацию… ты зачастую используешь метафоры и сравнения, позволяющие слушающим *гораздо* легче воспринимать объяснения. Это делает тебя гораздо лучшим наставником, чем я».~
@55746 = ~Двуличный пожимает плечами: «Для меня вы все на одно лицо… но думаю, я запомнил бы твою покрытую шрамами плоть… она очень напоминает полотно из галереи шкур Бела в Бааторе, только в твоих шрамах меньше изящества и больше страсти».~
@55747 = ~«Давай забудем о моих шрамах и лучше поговорим о смертности, которую я потерял и теперь ищу, ладно?»~
@55748 = ~«Продолжай…»~
@55749 = ~«У меня ещё вопросы…»~
@55750 = ~«Забудь. Прощай».~
@55751 = ~«Жестокость очень высока, почти превышает приемлемый уровень, но шрамы нанесены грубо, с танар'рийской необдуманностью, без малейшей попытки усилить боль получателя. Художники баатезу уделили бы гораздо больше внимания путям боли на теле. Некоторые из этих ран выглядят как идеальное убийство, но остальные — словно нанесены слепым мясником, разделывавшим тушу».~
@55752 = ~~
@55753 = ~«Пфе. Порой меня тошнит от человеческого искусства. Такой потенциал — и растрачен попусту».~
@55754 = ~«Пфе. Порой меня тошнит от человеческого искусства. Такой потенциал — и растрачен попусту».~
@55755 = ~«Давай забудем о моих шрамах и лучше поговорим о смертности, которую я потерял и теперь ищу, ладно?»~
@55756 = ~«У меня ещё кое-какие вопросы…»~
@55757 = ~«Забудь. Прощай».~
@55758 = ~«Пфе! Сказать, что танар'ри грубы, — просто оскорбить понятие грубости. Любая меньшая раса, которая упивается хаосом, позволяет себе погрязать и тонуть в волнах косности и называть их „злом“, — и не раса вовсе. Просто животные».~
@55759 = ~«Пфе и два раза пфе! Эти звероподобные танар'ри хотят стереть закон и порядок с лица зла! Непростительно! Невыносимо! Я не могу…»~
@55760 = ~«Пфе! Ты сказала это просто потому, что ты… то, что ты есть, — он хмурится на неё и разводит руками. — В конце концов, быть циничным я ещё могу себе позволить».~
@55761 = ~«Замечательно. Давай вернёмся к обсуждению моей смертности вместо моих шрамов».~
@55762 = ~«Я хочу получить ответы на другие вопросы…»~
@55763 = ~«Забудь. Прощай».~
@55764 = ~«Хорошо, — он чешет голову. — Если память меня не подводит — а такое случается редко благодаря этому проклятому дэву! — я слышал о подобном случае. Это делает тебя бессмертным, не так ли?»~
@55765 = ~«Да».~
@55766 = ~«Если так, то сама смерть уже больше не свята. Пфе. В моё время смертные оставались смертными и знали своё место… теперь же все подряд больны вечной скукой. Мы должны отыскивать по всем планам и уговаривать каждого, кто хочет заключить договор на бессмертие… это лишает нас, трудолюбивых баатезу, огромного количества потенциальных сделок. Пфе».~
@55767 = ~«Знаешь, если все станут бессмертными, то всю нашу систему вербовки можно будет спускать в канализацию. Пфе. Бессмертие — это не игрушка для непослушных детей вроде тебя».~
@55768 = ~«Как бы то ни было, давай вернёмся к тому, что ты знаешь о *моей* смертности».~
@55769 = ~«Пфе… как уже говорил, я припоминаю, что слышал о месте, называемом Крепостью Сожалений, — мгновение он размышляет. — Да… да, это оно».~
@55770 = ~«Как мне туда попасть?»~
@55771 = ~«Что ты знаешь об этом месте?»~
@55772 = ~Он широко улыбается: «С радостью проинформирую тебя о том, что я НЕ ЗНАЮ. Совсем ничего! Я не могу помочь тебе попасть туда, и это наполняет моё сердце светлой и чистой радостью. Нет. Я. Не. Могу. Помочь. О, как давно я не говорил этих слов. Как сладки они для мое…»~
@55773 = ~«Знаешь ли ты кого-нибудь, кто знает?»~
@55774 = ~«А? Прекрати перекрёстный допрос! Да-да, я знаю *кое-кого*, кто может знать… в Бааторе находится Колонна предателей, лжецов… и мудрецов. Несмотря на их натуру, на их сведения можно положиться. Они могут знать, где находиться Крепость Сожалений».~
@55775 = ~«Как мне попасть в Баатор?»~
@55776 = ~«Как мне попасть в Баатор?»~
@55777 = ~«Снаружи моего дома есть портал. Он находится в руке этого гигантского создания. Пройди через арку, образуемую левой рукой создания, и ты окажешься у Колонны Черепов. Теперь портал для тебя активен».~
@55778 = ~«А как мне оттуда вернуться?»~
@55779 = ~«Как я смогу вернуться от Колонны?»~
@55780 = ~«Как я смогу вернуться от Колонны?»~
@55781 = ~«Спасибо. У меня ещё вопросы…»~
@55782 = ~«А? Вернуться? Что ж, об этом я не подумал. Чтобы вернуться из Баатора, тебе нужно знание и кусочек зазубренного обсидиана, чтобы порезать свой язык. Знание ты получишь от Колонны Черепов. Но у тебя нет причины возвращаться сюда. И с моей стороны никакого желания видеть тебя снова».~
@55783 = ~«Спасибо. Ответь ещё на пару вопросов…»~
@55784 = ~«Прощай».~
@55785 = ~Он ворчит: «Я даже не тешу себя мыслями удушить тебя и бросить твой труп трелонам».~
@55786 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@55787 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@55788 = ~Осмотреть зелёную пилюлю: «Что это?»~
@55789 = ~Осмотреть нож из зелёной стали: «Что это?»~
@55790 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@55791 = ~Осмотреть извивающися жуков: «Что это?»~
@55792 = ~«Есть у тебя какие-нибудь заклинания?»~
@55793 = ~«Забудь. Лучше ответь мне на вопросы».~
@55794 = ~«Ничего не нужно. Прощай».~
@55795 = ~«Пфе… это „Дар ненависти“, отличное оружие для таких, как ты, — он тихонько хихикает. — Не думаю, что ты его захочешь… на нём проклятие. Возможно, ты передумаешь…»~
@55796 = ~«Всё равно хочу взять».~
@55797 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@55798 = ~Осмотреть зелёную пилюлю: «Что это?»~
@55799 = ~Осмотреть нож из зелёной стали: «Что это?»~
@55800 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@55801 = ~Осмотреть извивающися жуков: «Что это?»~
@55802 = ~«Есть у тебя какие-нибудь заклинания?»~
@55803 = ~«Забудь. Лучше ответь мне на вопросы».~
@55804 = ~«Ничего не нужно. Прощай».~
@55805 = ~«Эта старая штуковина? Пфе! Это гордиев узел. Разруби его, и твоя способность вести за собой других повысится вдвое, хе-хе. И, конечно, за это тоже придётся платить, чего я с нескрываемой радостью не могу отменить».~
@55806 = ~«Всё равно хочу взять».~
@55807 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@55808 = ~Осмотреть зелёную пилюлю: «Что это?»~
@55809 = ~Осмотреть нож из зелёной стали: «Что это?»~
@55810 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@55811 = ~Осмотреть извивающися жуков: «Что это?»~
@55812 = ~«Есть у тебя какие-нибудь заклинания?»~
@55813 = ~«Забудь. Лучше ответь мне на вопросы».~
@55814 = ~«Ничего не нужно. Прощай».~
@55815 = ~Он вздыхает: «Это слеза гадюки. Положи её в рот, и твой поцелуй станет подобным укусу гадюки — полным яда и ненависти».~
@55816 = ~«Я хочу взять».~
@55817 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@55818 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@55819 = ~Осмотреть нож из зелёной стали: «Что это?»~
@55820 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@55821 = ~Осмотреть извивающися жуков: «Что это?»~
@55822 = ~«Есть у тебя какие-нибудь заклинания?»~
@55823 = ~«Забудь. Лучше ответь мне на вопросы».~
@55824 = ~«Ничего не нужно. Прощай».~
@55825 = ~«Напоминание о моём времени в Бааторе — нож, изготовленный из бааторианской зелёной стали, одного из крепчайших материалов, какие я когда-либо видел. Пфе! Забирай мои воспоминания и заканчивай с этим!»~
@55826 = ~«Я хочу взять его. Но пока не собираюсь заканчивать».~
@55827 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@55828 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@55829 = ~Осмотреть зелёную пилюлю: «Что это?»~
@55830 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@55831 = ~Осмотреть извивающися жуков: «Что это?»~
@55832 = ~«Шеф, мы тут нарываемся на неприятности: этот модрон ушёл бродяжничать».~
@55833 = ~«Бродяжничать?»~
@55834 = ~«Да. Видишь ли, иногда модроны подхватывают чуток хаоса и тогда это и случается… ну, я думаю, *лучшее* объяснение в том, что такие модроны… они словно… модроны наоборот».~
@55835 = ~«Есть у тебя какие-нибудь заклинания?»~
@55836 = ~«Так это… модрон наоборот?»~
@55837 = ~«Шеф, как бы забавно это ни выглядело, но отрывать задницу баатезу от барного стула и то занятие поинтересней, чем трещать шкатулкой с тупым полигоном».~
@55838 = ~«Забудь. Лучше ответь мне на вопросы».~
@55839 = ~«А *ты* знаешь, что за духи снаряжения, Морте?»~
@55840 = ~«Ничего не нужно. Прощай».~
@55841 = ~«Шеф, да я понятия не имею, о чём трещит этот куб на ножках».~
@55842 = ~«Я думал, ты *эксперт* по планам».~
@55843 = ~«Ну ладно. Нордом, у меня к тебе другой вопрос…»~
@55844 = ~«Тогда забудь. Пошли».~
@55845 = ~«Чт… я знаю больше *тебя*, ты, гортанный шатающийся амнезюк! Кроме того, есть ещё три момента, которые тебе нужно обкатать в своей пустой черепушке: раз, по планам НЕТ экспертов; два, я — самое лучшее из того, что тебе удастся найти; и, наконец, три, относись-ка ко мне с уважением. Почему? Посмотри пункт номер два».~
@55846 = ~«Ну хорошо. Нордом, у меня к тебе другой вопрос…»~
@55847 = ~«Тогда забудь. Пошли».~
@55848 = ~«Механус? Скучнейшее место во всех возможных отношениях, шеф. Представь себе план, наполненный модронами и огромными вращающимися колёсами, и ты получишь великий и ужасно ЗАНУДНЫЙ план Механус. Слишком много правил, слишком раздражает. Место, о котором тебе даже не захочется вспоминать после первого же визита».~
@55849 = ~«Нордом, что ты имел в виду ранее, говоря „Ноль Дом“?»~
@55850 = ~«Неважно, Морте. Я слышал достаточно. Пошли».~
@55851 = ~«Эта старая штуковина? Пфе! Всего лишь кинжал из бааторианской зелёной стали. Сохраняет остроту заточки. Ничего, что тебе было бы нужно, поверь мне».~
@55852 = ~«Всё равно хочу взять».~
@55853 = ~~
@55854 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@55855 = ~«Прошу прощения, мисс Жрица Благочестия, но Механус — САМОЕ скучное место во всей вселенной… единственное, что в нём может быть интересным, — это если *ты* его посетишь… — Морте закатывает глаза. — Но боюсь, даже *это* потеряло бы своё очарование с течением времени».~
@55856 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@55857 = ~«Нордом, что ты имел в виду ранее, говоря „Ноль Дом“?»~
@55858 = ~«Неважно, Морте. Я слышал достаточно. Пошли».~
@55859 = ~Осмотреть зелёную пилюлю: «Что это?»~
@55860 = ~«Все модроны — часть этого „резерва“, шеф. Это нечто вроде большого банка энергии… когда один из них умирает, энергия, которую он носил в себе, поглощается обратно в банк, и оттуда выплёвывается новый модрон. Дело вот в чём… когда модрон немного двигается умом, он отключается от связи, но сохраняет внутри себя часть энергии».~
@55861 = ~Осмотреть нож из зелёной стали: «Что это?»~
@55862 = ~«Так… Нордом, этот Механус — источник энергии?»~
@55863 = ~Осмотреть извивающися жуков: «Что это?»~
@55864 = ~«Ясно. Нордом, у меня ещё вопросы…»~
@55865 = ~«Это всё, что я хотел знать. Пошли».~
@55866 = ~«Есть у тебя какие-нибудь заклинания?»~
@55867 = ~Морте зло смотрит на Падшую Грейс: «Ты *не возражаешь*, если я скажу? На вопрос получен ответ, спасибо. *Я* здесь источник информации, НЕ ты, лады?»~
@55868 = ~«Забудь. Лучше ответь мне на вопросы».~
@55869 = ~«Ничего не нужно. Прощай».~
@55870 = ~«О, *мне* всё ясно! Может, если бы я был суккубом, ты почаще прислушивался к МОИМ словам, а? Может, если бы я продемонстрировал тебе кусочек обнажённой плоти, то получил бы немного уважения, а? Это очень низко, шеф, очень низко! Почему я долж…»~
@55871 = ~ПУСТОЙ УЗЕЛ~
@55872 = ~«Это? Это *кассеги*, паразиты, внедряющиеся в твой мозг и высасывающие твою ментальную энергию без особой пользы… Пфе! Проклятый договор! Они усиливают твою ментальную энергию, так что некоторую явную пользу приносят! Забирай их! Забирай!»~
@55873 = ~«О, да?! Я?!.. Ну!.. Да ты просто… да, слышал это, шеф? Слышал, что она сказала? Она права. Меня легче понять, я более „мудр в общении“, слышь, что я говорю? Так что я тебе нужен, понимаешь?»~
@55874 = ~«Я хочу взять».~
@55875 = ~«Верно, поэтому у меня другой вопрос: вы оба говорите, что Нордом — часть этого Источника, но отрезан от него. И когда обычный модрон умирает, то он поглощается. Так будет и с Нордомом?»~
@55876 = ~«Я никогда и не говорил иначе, Морте. Итак… Нордом, этот источник энергии, о котором ты упоминал… он из Механуса?»~
@55877 = ~«Ладно. Нордом, у меня к тебе другой вопрос…»~
@55878 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@55879 = ~«Это всё, что я хотел знать. Пошли».~
@55880 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@55881 = ~Осмотреть зелёную пилюлю: «Что это?»~
@55882 = ~Морте кивает.~
@55883 = ~Осмотреть нож из зелёной стали: «Что это?»~
@55884 = ~«И если он умрёт, то будет создан новый Нордом».~
@55885 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@55886 = ~«Э-э… нет».~
@55887 = ~«А что произойдёт?»~
@55888 = ~«Есть у тебя какие-нибудь заклинания?»~
@55889 = ~«Забудь. Лучше ответь мне на вопросы».~
@55890 = ~«Ну, они поглотят его энергию, шеф, и породят нового модрона, но это будет уже не Нордом, поскольку он больше не *настоящий* модрон, в нём слишком много от планов. Они сделают замену на не-Нордома».~
@55891 = ~«Забудь. Прощай».~
@55892 = ~«Так… обратившись в бродягу, он стал… смертным?»~
@55893 = ~«Пфе! Конечно, хочешь! Есть что-то ещё, что ты пожелаешь от своего *смиренного* слуги?!»~
@55894 = ~«Ладно. Нордом, у меня к тебе другой вопрос…»~
@55895 = ~«Это всё, что я хотел знать. Пошли».~
@55896 = ~Осмотреть жутковатый на вид топор: «Что это?»~
@55897 = ~Морте выдерживает паузу. «Ну… да, можно сказать и так. То есть, если бы он не предпринял своё маленькое бродяжье восстание, с ним было бы всё в порядке… умри он, выскочил бы другой модрон, в точности такой же. Но раз уж он стал „модроном наоборот“… ну, эта его часть будет утеряна, когда он умрёт».~
@55898 = ~«Ясно. Нордом, у меня к тебе другой вопрос…»~
@55899 = ~Осмотреть завязанную в узел верёвку: «Что это?»~
@55900 = ~«Это всё, что я хотел знать. Пошли».~
@55901 = ~«Ай-й! Во имя сил и моего зравого ума, прекрати! У него шестерёнки поломаются, если ты будешь спрашивать подобные вещи снова и снова!»~
@55902 = ~«Это было похоже на *идею*, Морте».~
@55903 = ~Осмотреть зелёную пилюлю: «Что это?»~
@55904 = ~Осмотреть нож из зелёной стали: «Что это?»~
@55905 = ~«Ну, я хотел знать ответ и я его получил».~
@55906 = ~«Неважно. У меня другие вопросы к Нордому…»~
@55907 = ~«Забудь. Пошли».~
@55908 = ~Осмотреть кинжал зелёного цвета: «Что это?»~
@55909 = ~«Ох, — Морте „скалится“. — Мог бы и сказать хоть ЧТО-НИБУДЬ. Ну разумеется, продолжай. Конечно…» Морте *щёлкает* зубами, передразнивая Нордома: «Но если хочешь знать о модронах, тебе надо спрашивать МЕНЯ».~
@55910 = ~«Хорошо, Морте… что ты можешь рассказать о модронах?»~
@55911 = ~Осмотреть извивающися жуков: «Что это?»~
@55912 = ~«Неважно. У меня другой вопрос к Нордому…»~
@55913 = ~«Забудь. Пошли».~
@55914 = ~«Слушай, шеф, НОРМАЛЬНЫЙ модрон с трудом понимает что-либо, кроме своих задач, а этот тупой полигон в придачу только прибыл на планы. Не сбивай куб с толку, ладно? По крайней мере, пока он вооружён. Хочешь знать о модронах — спроси меня, а не его».~
@55915 = ~«Хорошо, Морте… что ты можешь рассказать о модронах?»~
@55916 = ~«Есть у тебя какие-нибудь заклинания?»~
@55917 = ~«Неважно. У меня другой вопрос к Нордому…»~
@55918 = ~«Забудь. Пошли».~
@55919 = ~«Забудь. Лучше ответь мне на вопросы».~
@55920 = ~«Ничего не нужно. Прощай».~
@55921 = ~«В общем, так, шеф: модроны — это те дурацкие геометрические фигуры, что звякают по всему своему родному плану, Механусу. Они действительно аккуратные, организованные и рады были бы видеть такой ВСЮ мультивселенную. Вот почему они такие зануды».~
@55922 = ~«Тьфу! Ты обдерёшь меня как липку! Хочешь заклинаний? Пфе! Да, у меня они есть, кровосос!» — он выпаливает перечень заклинаний.~
@55923 = ~«Что плохого в попытке сделать мультивселенную более организованной?»~
@55924 = ~~
@55925 = ~«Что такое Механус?»~
@55926 = ~«Неважно. У меня другой вопрос к Нордому…»~
@55927 = ~~
@55928 = ~«Забудь. Пошли».~
@55929 = ~«Как насчёт славного „Снять проклятие“?»~
@55930 = ~«Это план, где появляются все эти шестерёночные дроны. Спроси его и увидишь, что он скажет. Именно там они торчат всё время и приводят в порядок всё вокруг… каталогизировать это, расположить по порядку *то*, навести порядок в *этом*, сделать то по правилам и так далее и тому подобное».~
@55931 = ~Правда: «Похоже на благородную цель. Что плохого в попытке сделать мультивселенную более организованной?»~
@55932 = ~«Как насчёт славного „Снять проклятие“?»~
@55933 = ~«„Сфера неуязвимости“ выглядит полезной. Давай сюда».~
@55934 = ~«Есть ещё „Сфера неуязвимости“?»~
@55935 = ~«Непохоже, чтобы ты был в восторге».~
@55936 = ~«У меня другой вопрос к Нордому…»~
@55937 = ~«Забудь. Пошли».~
@55938 = ~Морте окидывает взглядом Нордома, который приставил левый арбалет к голове, словно слушает его.~
@55939 = ~«Как насчёт „Шторма цепных молний“?»~
@55940 = ~«Видишь ли, шеф, у хаоса тоже должно быть своё место. И если бы всё было так, как представляют себе *модроны*, — вряд ли было бы много жизни… по крайней мере той жизни, которую предпочитаю я. Они же просто хотят всё *структурировать*. Буэ-э-э».~
@55941 = ~Правда: «Согласен, у хаоса должно быть своё место… мы все окажемся в застое, если будет слишком много порядка. Слушай, у меня другой вопрос к Нордому…»~
@55942 = ~«Ясно. Слушай, у меня другой вопрос к Нордому…»~
@55943 = ~«Ещё один „Шторм цепных молний“ не помешал бы…»~
@55944 = ~«Ну ладно. Пошли».~
@55945 = ~«„Кислотный шторм“ звучит грозно. Я возьму его».~
@55946 = ~«„Кислотный шторм“. Ещё один».~
@55947 = ~«„Вихрь лезвий“? Впечатляющее название. Хочу».~
@55948 = ~«Дай ещё один „Вихрь лезвий“».~
@55949 = ~«„Стигийский ледяной шторм“? Тебе слишком опасно держать у себя такие вещи… лучше я заберу его».~
@55950 = ~«„Стигийский ледяной шторм“? Он мне понравился».~
@55951 = ~«Вообще-то ты ничего не назвал».~
@55952 = ~«Забудь. У меня вопросы».~
@55953 = ~«Неважно. Прощай».~
@55954 = ~Его рука исчезает, когда он касается странного пространства/непространства. Он вытаскивает свиток, выглядящий так, будто был изготовлен из высушенной человеческой кожи, и кидает его тебе: «Пфе! Забирай и будь прок… э-э, возьми его!»~
@55955 = ~«Спасибо… какие ещё заклинания у тебя есть?»~
@55956 = ~«Я хочу ещё раз взглянуть на вещи».~
@55957 = ~«Хорошо. У меня вопросы».~
@55958 = ~«Ладно. Прощай».~
@55959 = ~Он строит зубастую гримасу: «С глубокой и проникновенной радостью сообщаю, что ты разграбил все мои копии этого конкретного заклинания. Пфе!»~
@55960 = ~«А какие заклинания у тебя остались?»~
@55961 = ~«Я хочу ещё раз взглянуть на вещи».~
@55962 = ~«Забудь. У меня вопросы».~
@55963 = ~«Неважно. Прощай».~
@55964 = ~Двуличный рычит на тебя: «Ты уничтожил, разорил, разграбил уникальнейшее собрание заклинаний в мультивселенной… всего тебе хорошего за это! У меня больше нет заклинаний».~
@55965 = ~«Я хочу ещё раз взглянуть на вещи».~
@55966 = ~«Тогда забудь. Лучше ответь на вопрос…»~
@55967 = ~«Ладно. Прощай».~
@55968 = ~«Нордом, не мог бы ты сказать, каковы обязанности Созидающего Директора?»~
@55969 = ~«Пфе! Ты что, подставляешь свой череп под каждый камень, падающий с горы невежества? На Нижних планах свирепствует Кровавая Война. Нет ни одного плана, не затронутого этим конфликтом. Подумай о самой страшной войне, какую только можешь себе вообразить, увеличь её в миллиард раз в масштабах и времени и ты получишь представление о войне, сотрясающей Нижние планы. Эта война идеологий, тех основ, что определяют бытие мультивселенной!»~
@55970 = ~«Продолжай».~
@55971 = ~«Нордом, расскажи мне снова об обязанностях Созидающего Директора».~
@55972 = ~«Забудь. У меня другие вопросы».~
@55973 = ~«Спасибо. Прощай».~
@55974 = ~«Как Созидающий Директор, я хочу отдать тебе приказ».~
@55975 = ~«Что ты делаешь со своими арбалетами?»~
@55976 = ~«Это скелет Уль-Гориса, отца всех гористро. Они живые медведеподобные осадные башни, джаггернауты хаоса; огромные, неумолимые, почти неуязвимые для магии… и кости Уль-Гориса в кратере, где он встретил свою смерть, излучают столько энергии, что защищают меня от магического обнаружения, продлевая жизнь этой убогой оболочки на очередные безнадёжные годы. Пфе!»~
@55977 = ~«Любопытно, Нордом… как ты оказался в Рубиконе?»~
@55978 = ~«Ясно. У меня ещё пара вопросов…»~
@55979 = ~«Нордом, что такое модрон?»~
@55980 = ~«Расскажи мне о Механусе».~
@55981 = ~«Ясно. Прощай».~
@55982 = ~«Если бы тебе доводилось гулять по обжигающим улицам Диса и чувствовать сладкий запах горящей плоти, полной грудью вдыхать ядовитые испарения плавучих льдов Стигии, вести армии сквозь погружённые во мрак дворцы… тогда бы ты не спрашивал, недочеловек».~
@55983 = ~«Так что с тобой случилось?»~
@55984 = ~«Хм… как ты, Нордом?»~
@55985 = ~«Я хотел задать ещё пару вопросов…»~
@55986 = ~«Ладно. Прощай».~
@55987 = ~«Со мной случился этот проклятый дэв! Я был так спокоен, так уверен… пфе! Лишился своей силы, как неопытный юнец. Не удивлюсь, если судебные исполнители Баатора разыскивают меня толпами».~
@55988 = ~«Как ты, Нордом?»~
@55989 = ~«Расскажи мне о Триасе».~
@55990 = ~«Расскажи мне о Триасе».~
@55991 = ~«Нордом, ты раньше спрашивал, как у меня дела, так?»~
@55992 = ~«У меня ещё пара вопросов…»~
@55993 = ~«Ясно. Прощай».~
@55994 = ~«Можем мы ещё раз обсудить моё бессмертие?»~
@55995 = ~«Пфе! Разве я ещё не рассказал тебе о сути этого проклятого соглашения?! Я НЕ МОГУ утаивать подобной информации. Колонна… твоя единственная надежда».~
@55996 = ~«Слышал когда-нибудь о Рейвел Клубок-Загадок, Нордом?»~
@55997 = ~«Морте, почему ты не хочешь отправляться туда?»~
@55998 = ~«Ладно. Ответь мне на другой вопрос».~
@55999 = ~«Прощай».~
@56000 = ~«Нордом, знаешь ли ты что-нибудь о Кровавой Войне?»~
@56001 = ~«Пфе… это огромная куча голов, духов тех мертвецов, чья ложь привела других к смерти. Это собрание мудрецов и жуликов, перемешанных вместе в беспорядке, и их всесторонних знаний о планах».~
@56002 = ~Оставить Нордома наедине с его оружием.~
@56003 = ~«Спасибо. У меня другие вопросы…»~
@56004 = ~«Спасибо. Прощай».~
@56005 = ~~
@56006 = ~«Пфе! Я развею твоё невежество в этом вопросе. Знай, что для баатезу, закованного в цепи добродетели, НЕТ места, где бы он ЖЕЛАЛ быть. По крайней мере, здесь я нашёл укрытие от жесточайшего из всех соглашений, которыми был связан. Говорю тебе, у этого дэва душа изверга».~
@56007 = ~«Тогда ответь мне на другой вопрос…»~
@56008 = ~«Ясно. Прощай».~
@56009 = ~«Она даёт толчок исследованиям… множество ужасающих творений порождено Кровавой Войной. Почему? Потому что она боль, и смерть, и зло. Танар'ри бьются за хаос и зло… зло грубой силы, вспышек капризов и ненависти. Их „зло“ — это зло толпы, представление сброда о бушующем зле. Они убивают и грабят».~
@56010 = ~«А другая сторона?»~
@56011 = ~«Забудь. У меня другие вопросы…»~
@56012 = ~«Спасибо. Прощай».~
@56013 = ~«Баатезу желают только строго упорядоченного зла, провозглашая суть зла в точной, чёткой форме. Танар'ри убивают. Баатезу используют. Этим двум народам предназначено уничтожить друг друга».~
@56014 = ~«Продолжай».~
@56015 = ~«Забудь. Лучше ответь на другой вопрос».~
@56016 = ~«Это всё, что я хотел услышать. Прощай».~
@56017 = ~«Частью моих обязанностей — а я был лучшим, уверяю, — была вербовка новых солдат, в основном воинов и магов других миров для использования в качестве пушечного мяса на передовой. Говорят, на меня даже положил глаз сам господин Бел. Даже он видел моё усердие! Пфе! Теперь же я унижен окончательно».~
@56018 = ~«Не узнаёшь ли ты меня?»~
@56019 = ~«Не узнаёшь ли ты меня?»~
@56020 = ~«Ладно. Тогда ответь на другой вопрос».~
@56021 = ~«Похоже на то. Прощай».~
@56022 = ~«Похоже на то. Прощай».~
@56023 = ~«Разве мы уже это не обсуждали? Пфе! Тупые люди!»~
@56024 = ~«Тогда ответь на другой вопрос».~
@56025 = ~«Ладно. Прощай».~
@56026 = ~«Ладно. Прощай».~
@56027 = ~«Ворота сейчас не закрыты, так что тебе вовсе не обязательно надоедать мне».~
@56028 = ~Уйти.~
@56029 = ~«А мне *нравится*, как она пахнет. Такая прелесть».~
@56030 = ~«Погоди, шеф… Баатор — это ПЛОХО. Этот изверг что-то скрывает от нас… даже если и есть „Колонна Черепов“, мы вполне можем найти кого-нибудь ещё, кто знает, как попасть в эту Крепость Сожалений *без* того, чтобы отправляться на самый опасный план мультивселенной».~
@56031 = ~«Ты о чём-то умалчиваешь, Двуличный?»~
@56032 = ~«Почему ты не хочешь отправляться туда, Морте?»~
@56033 = ~«Это опасное место, шеф. Лучше его избегать. Я там был, и там очень не здорово. Ясно?»~
@56034 = ~«Мы ещё поговорим об этом позже. Двуличный, у меня другие вопросы…»~
@56035 = ~«Я обращаю своё приветствие и к тебе, Адвокат Инферно Двуличный, — Грейс отвешивает лёгкий поклон. — Я приму твоё предложение во внимание».~
@56036 = ~Грейс кажется смущённой: «Адвокат Инферно Двуличный намекает на то, что мы, танар'ри, — грубый, неотёсанный народ?»~
@56037 = ~«Наверняка ты возражаешь скорее против воплощения зла, чем против его масштаба. Многие среди танар'ри объявят, что чем ближе они к первородному хаотичному злу, тем ближе они к идеалу».~
@56038 = ~«Разумеется, это может быть невыносимо с точки зрения баатезу. Однако… Адвокат, многие философы танар'ри поспорили бы о том, что баатезу не могут быть прощены за вычёркивание страсти из жестокости, вычёркивание чувства из самой сути зла. Баатезу заменяют ярость на холодную методичную жестокость. И так продолжается долгий спор: что есть большее зло? Эффективное зло или зло страстное?»~
@56039 = ~«ВРЕД БЫЛ ПРИЧИНЁН. ПРОШЛОЕ НЕ ИЗМЕНИТСЯ ОТ ТВОИХ ИЗВИНЕНИЙ. СОСЛУЖИ НАМ СЛУЖБУ, ИЛИ МЫ УНИЧТОЖИМ ТЕБЯ».~
@56040 = ~«И что мне нужно сделать?»~
@56041 = ~«Я отказываюсь».~
@56042 = ~«Возвращайтесь к работе!»~
@56043 = ~Ты обнаруживаешь себя стоящим прямо под петлёй палача. Замогильный голос хихикает из темноты: «Снова видишь сон? Снова! Снова!»~
@56044 = ~Твоё тело кажется странно лёгким и воздушным, словно ты потерял над ним контроль, словно ветер несёт тебя куда пожелает.~
@56045 = ~Ты обнаруживаешь себя плывущим сквозь лабиринт перекрученных растений и чёрных шипов, которые рвут твоё нематериальное тело.~
@56046 = ~Кошмарные создания появляются из земли и стен и рвут твою плоть. Их яростные нападения повергают тебя в бессознательное состояние.~
@56047 = ~Ты стоишь перед колонной из черепов, которая бормочет тебе, но ты не понимаешь слов. Топот сзади отвлекает тебя от колонны, и ты видишь устремляющееся к тебе войско демонов.~
@56048 = ~Ты снова стоишь в лабиринте, и тебя окружает зловоние смерти. Ты знаешь, что убил их всех. Хихикающий голос снова прорезает тишину.~
@56049 = ~«О моя прелестная маленькая загадка, ты убил их всех и ещё стольких, что я потеряла счёт», — тебя поражает немота, ответить не получается.~
@56050 = ~«Иди ко мне, моя милашка… иди к Рейвел в её лабиринт чёрных шипов. Иди помечтать со мной».~
@56051 = ~Ущипнуть себя и проснуться.~
@56052 = ~Оставить Вейлора в покое.~
@56053 = ~Оставить Вейлора в покое.~
@56054 = ~Перед тобой возвышаются пустые доспехи. Но пластины висят в воздухе так, словно облегают чьё-то невидимое тело. Красные прожилки струятся по металлу поножей, а в руках покоится огромный двусторонний топор палача. Поверхность доспехов украшает гравировка, наиболее заметной деталью которой является изображение тёмно-красного змея с распростёртыми крыльями.~
@56055 = ~«Вейлор?..»~
@56056 = ~Осмотреть доспехи.~
@56057 = ~Осмотреть топор.~
@56058 = ~Осмотреть шлем.~
@56059 = ~Оставить доспехи в покое.~
@56060 = ~Доспехи архаичны, и лезвия на плечах это только подтверждают: целая гряда огромных клинков вырастает из наплечников. Ты почти готов признать плечевые лезвия просто украшением, но они выглядят слишком тяжёлыми и опасными, чтобы быть чем-то большим дополнительного оружия этого и без того грозного комплекта доспехов. Броню покрывают вмятины и прочие следы былых сражений, на её поверхности оставили шрамы века и ржавчина.~
@56061 = ~«Вейлор?..»~
@56062 = ~Осмотреть топор.~
@56063 = ~Осмотреть шлем.~
@56064 = ~Взять доспехи.~
@56065 = ~Оставить доспехи в покое.~
@56066 = ~~
@56067 = ~Этот двусторонний боевой топор напоминает орудие палача; боевая часть выкована в виде кроваво-красного змея с распростёртыми крыльями, вытянутые края крыльев образуют лезвия. Сам топор просто *огромен*: даже если взять его обеими руками, понадобится чудовищная сила, чтобы эффективно им орудовать. Пока что он почти небрежно покоится в пустой латной перчатке.~
@56068 = ~«Вейлор?..»~
@56069 = ~Осмотреть доспехи.~
@56070 = ~Осмотреть шлем.~
@56071 = ~Взять топор.~
@56072 = ~Оставить доспехи в покое.~
@56073 = ~Шлем напоминает череп какого-то зверя: по нижнему краю лицевой пластины идёт изогнутая линия металлических клыков, свисая над пустотой. Шлем висит в воздухе, его внутренность скрыта в тени.~
@56074 = ~«Вейлор?..»~
@56075 = ~Осмотреть доспехи.~
@56076 = ~Осмотреть топор.~
@56077 = ~Взять шлем.~
@56078 = ~Оставить доспехи в покое.~
@56079 = ~Ты понятия не имеешь, откуда взялось это имя, но знаешь, что оно *принадлежит* доспехам. Ты едва его шепчешь, но оно странным эхом разносится по залу. Воздух в зале приходит в движение, вызывая охватывающее череп странное чувство и затягивая узел в сердце.~
@56080 = ~Попытаться вспомнить, вытащить воспоминания на поверхность.~
@56081 = ~Позволить воспоминаниям вновь пробудиться…~
@56082 = ~Осмотреть доспехи.~
@56083 = ~Осмотреть топор.~
@56084 = ~Осмотреть шлем.~
@56085 = ~Оставить доспехи в покое.~
@56086 = ~Как только ты вглядываешься в доспехи, тени под забралом обретают форму… складываясь в черты лица крепкого темнокожего человека. Его глаза горят огнём, кожа покрыта бесчисленными шрамами… был ли он «Вейлором», когда его облегала плоть? Он кажется до странности знакомым… как металлические доспехи, так и плоть с кровью человека под ними.~
@56087 = ~«Вейлор… пробудись».~
@56088 = ~Осмотреть доспехи.~
@56089 = ~Осмотреть топор.~
@56090 = ~Осмотреть шлем.~
@56091 = ~Оставить доспехи в покое.~
@56092 = ~Яркий красный свет вспыхивает в прорезях его шлема, почти ослепляя тебя; ты прикрываешь глаза от вспышки, а когда поднимаешь веки, то видишь два пылающих янтаря, смотрящих на тебя из тени внутри шлема.~
@56093 = ~Едва ты дотрагиваешься, как из-под шлема внезапно вспыхивает яркий красный свет, почти ослепляя тебя; ты прикрываешь глаза от вспышки, а когда поднимаешь веки, то встречаешься взглядом с двумя пылающими янтарями, смотрящими на тебя из тени внутри шлема.~
@56094 = ~*Я ПРОБУДИЛСЯ.*~ [VHA002]
@56095 = ~Голос его — призрачный, пустой и отдаётся эхом внутри доспехов. Это не человеческий голос… он звучит скорее как *сила*, как присутствие. Ни капли *жизни* нет в этом голосе… и непохоже, что когда-либо была.~
@56096 = ~«Кто ты?»~
@56097 = ~В самой глубине тюрьмы Керста я обнаружил доспехи, содержащие в себе призрака… похоже, доспехи пробыли в заключении немало времени. Они называют себя «Вейлором» и говорят, что они — Убийца Милосердия, служитель справедливости.~
@56098 = ~*Я — ВЕЙЛОР.*~
@56099 = ~«*Что* ты есть?»~
@56100 = ~«*Что* ты есть?»~
@56101 = ~«*Что* ты есть?»~
@56102 = ~«*Что* ты есть?»~
@56103 = ~*Я — УБИЙЦА МИЛОСЕРДИЯ.*~
@56104 = ~*Я — УБИЙЦА МИЛОСЕРДИЯ.*~
@56105 = ~*Я — УБИЙЦА МИЛОСЕРДИЯ.*~
@56106 = ~*Я — УБИЙЦА МИЛОСЕРДИЯ.*~
@56107 = ~«Убийца Милосердия?»~
@56108 = ~Когда Вейлор произносит «Убийца Милосердия», Анна и Морте каменеют.~
@56109 = ~«Убийца Милосердия?»~
@56110 = ~Когда Вейлор произносит «Убийца Милосердия», Анна каменеет и издаёт мягкое предупреждающее шипение.~
@56111 = ~«Убийца Милосердия?»~
@56112 = ~Когда Вейлор произносит «Убийца Милосердия», Морте позади тебя застывает.~
@56113 = ~«Убийца Милосердия?»~
@56114 = ~*Убийцы Милосердия служат СПРАВЕДЛИВОСТИ. Справедливость ВЫЧИЩАЕТ зло. Когда ВСЁ будет вычищено, мультивселенная достигнет СОВЕРШЕНСТВА.*~
@56115 = ~«Почему ты называешься „Убийцей Милосердия“?»~
@56116 = ~«Как ты служишь справедливости?»~
@56117 = ~«У меня к тебе вопросы, Вейлор…»~
@56118 = ~«Ясно… Вейлор. Здесь наши пути расходятся».~
@56119 = ~«Неважно, Вейлор. Пойдём дальше».~
@56120 = ~*СПРАШИВАЙ. Я дам ОТВЕТ.*~
@56121 = ~«Кто такие Убийцы Милосердия?»~
@56122 = ~«Вейлор, ты сказал, что служишь справедливости. Как ты это делаешь?»~
@56123 = ~«Давно ты тут заключён?»~
@56124 = ~«Сколько времени ты провёл в заключении под Керстом?»~
@56125 = ~«Как ты умер?»~
@56126 = ~«Ты сказал, что можешь видеть сердца других, Вейлор. Как?»~
@56127 = ~«Можешь научить меня пользоваться топором, Вейлор?»~
@56128 = ~Ложь: «Я тоже ищу справедливости, Вейлор. Присоединишься ли ты ко мне?»~
@56129 = ~Ложь: «Я тоже ищу справедливости, Вейлор. Присоединишься ли ты ко мне?»~
@56130 = ~Правда: «Я тоже ищу справедливости, Вейлор. Присоединишься ли ты ко мне?»~
@56131 = ~Правда: «Я тоже ищу справедливости, Вейлор. Присоединишься ли ты ко мне?»~
@56132 = ~«Не хочешь отправится со мной в путешествие, Вейлор? Нам бы пригодилась твоя помощь».~
@56133 = ~«Неважно, Вейлор. Здесь наши пути расходятся».~
@56134 = ~«Неважно, Вейлор. Пойдём дальше».~
@56135 = ~*Милосердие — щит, используемый СЛАБЫМИ. Милосердие — это СЛАБОСТЬ. Милосердие — это СМЕРТЬ. Невиновных НЕТ. Убийцы Милосердия низвергают милосердие и его ШЛЮХ, где бы ни распространилась эта зараза.*~
@56136 = ~Правда: «Кажется, я нашёл того, кто верит в то же, что и *я*. Милосердие извращает справедливость. Милосердие — это *слабость*».~
@56137 = ~Ложь: «Кажется, я нашёл того, кто верит в то же, что и *я*. Милосердие извращает справедливость. Милосердие — это *слабость*».~
@56138 = ~Правда: «Я не согласен. Милосердие — это сила, и случается так, что даже справедливость может быть несправедливой, особенно доведённая до крайности».~
@56139 = ~«Ясно. У меня к тебе ещё вопросы…»~
@56140 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56141 = ~«Неважно, Вейлор. Пойдём дальше».~
@56142 = ~*Наказание ИЗМЕНЯЕТ души. Оно делает их служение СПРАВЕДЛИВОСТИ усердным.*~
@56143 = ~«Ясно. У меня другие вопросы…»~
@56144 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56145 = ~«Неважно, Вейлор. Пойдём дальше».~
@56146 = ~*МИЛОСЕРДИЕ пожирает самое сердце ПРАВОСУДИЯ. НИКТО из живущих не является НЕВИНОВНЫМ.*~
@56147 = ~«Что *определяет* справедливость, Вейлор? ЧЕМ же она является на самом деле?»~
@56148 = ~«Из твоих слов следует, что ты тоже не являешься невиновным. Заслуживаешь ли *ты* наказания?»~
@56149 = ~«Хорошо. У меня другие вопросы…»~
@56150 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56151 = ~«Не буду больше с тобой спорить, Вейлор. Пойдём дальше».~
@56152 = ~*СПРАВЕДЛИВОСТЬ определяется ЗАКОНОМ.*~
@56153 = ~«И что же такое закон, Вейлор?»~
@56154 = ~«Хорошо. У меня другие вопросы…»~
@56155 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56156 = ~«Не буду больше с тобой спорить, Вейлор. Пойдём дальше».~
@56157 = ~*ЗАКОН — это инструмент, которым вершится СПРАВЕДЛИВОСТЬ.*~
@56158 = ~«А что определяет закон, Вейлор?»~
@56159 = ~«Хорошо. У меня другие вопросы…»~
@56160 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56161 = ~«Не буду больше с тобой спорить, Вейлор. Пойдём дальше».~
@56162 = ~*ЗАКОН определяется СПРАВЕДЛИВОСТЬЮ.*~
@56163 = ~«Получается замкнутый круг, Вейлор, это не имеет смысла. Ты сказал, что справедливость определяется законом, который определяется справедливостью».~
@56164 = ~«Хорошо. У меня другие вопросы…»~
@56165 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56166 = ~«Не буду больше с тобой спорить, Вейлор. Пойдём дальше».~
@56167 = ~*ЗАКОН -ОПРЕДЕЛЯЕТСЯ- СПРАВЕДЛИВОСТЬЮ.*~
@56168 = ~«Законы утверждают живущие мужчины и женщины, Вейлор. Являются ли их законы „справедливыми“?»~
@56169 = ~«Хорошо. У меня другие вопросы…»~
@56170 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56171 = ~«Не буду больше с тобой спорить, Вейлор. Пойдём дальше».~
@56172 = ~*ЗАКОНЫ СПРАВЕДЛИВЫ.*~
@56173 = ~«Но если законы определяются живущими мужчинами и женщинами, которые, как ты сказал, НЕ ЯВЛЯЮТСЯ невиновными, то разве законы не были извращены их руками?»~
@56174 = ~«Хорошо. У меня другие вопросы…»~
@56175 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56176 = ~«Не буду больше с тобой спорить, Вейлор. Пойдём дальше».~
@56177 = ~*НИКТО из живущих не является НЕВИНОВНЫМ. Но ЗАКОН поднимается над плотью и кровью. ИЗ НЕСОВЕРШЕНСТВА РОЖДАЕТСЯ СОВЕРШЕНСТВО. НЕСПРАВЕДЛИВЫЕ ЗАКОНЫ могут быть ПЕРЕРАБОТАНЫ. ИХ ЗЛО ИСЧЕЗНЕТ.*~
@56178 = ~«Значит, ты признаёшь, что законы не всегда совершенны, но если те же законы определяют справедливость, то, следовательно, *справедливость* тоже несовершенна?»~
@56179 = ~«Хорошо. У меня другие вопросы…»~
@56180 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56181 = ~«Не буду больше с тобой спорить, Вейлор. Пойдём дальше».~
@56182 = ~Вейлор молчит.~
@56183 = ~«Вейлор, СПРАВЕДЛИВОСТИ не существует. Всё, что ты делаешь во имя справедливости, — бессмысленно. Твоя ЖИЗНЬ бессмысленна».~
@56184 = ~«Вейлор, СПРАВЕДЛИВОСТИ не существует. Всё, что ты делаешь во имя справедливости, — бессмысленно. Твоя ЖИЗНЬ бессмысленна».~
@56185 = ~«Неважно, Вейлор. У меня к тебе другие вопросы…»~
@56186 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56187 = ~«Не буду больше с тобой спорить, Вейлор. Пойдём дальше».~
@56188 = ~Я убедил Вейлора, что его служение справедливости лишено смысла, ибо если он верит в справедливость и закон, взаимосвязанные друг с другом, то в случае, если одно из них несовершенно, и другое несовершенно тоже. Если бы он был поумнее, то смог бы аргументировать свою точку зрения более эффективно. Неважно, страсть или одержимость превратили его в бесплотного духа, не знающего покоя, но, к счастью, это ослабило его способность видеть за пределами собственных ограниченных аргументов. Когда он наконец осознал мои слова, сомнения и колебания убили его, превратив в «сдавшегося призрака».~
@56189 = ~Твои слова порождают эхо, с каждым звуком набирая мощь. Едва ты их произносишь, огонь в янтарных глазах Вейлора мерцает, а затем угасает. Его доспехи рассыпаются, топор и металлические пластины с грохотом рушатся на пол. Упав на землю, железяки поднимают тучу пыли, от них летит пепел и хлопья вековой ржавчины, и на твоих глазах всё распадается в прах. Всё, что остаётся, — несколько насквозь проржавевших листов металла, единственное надгробие, напоминающее о существовании Вейлора.~
@56190 = ~«Прощай, Вейлор».~
@56191 = ~Горящие янтари глаз Вейлора мерцают, затем снова ВСПЫХИВАЮТ: *Твои СЛОВА — НИЧТО для меня. Ты пытаешься ОТВРАТИТЬ меня от ПУТИ СПРАВЕДЛИВОСТИ.* Он угрожающе заносит свой топор: *Ты должен быть НАКАЗАН.*~
@56192 = ~«Вейлор, стой! Не делай этого!»~
@56193 = ~«Хорошо, Вейлор. Если ты хочешь драки…»~
@56194 = ~*Я СЛУЖУ СПРАВЕДЛИВОСТИ. ЕСЛИ ОТСТУПЛЮСЬ ОТ СВОЕГО ПУТИ, Я ДОЛЖЕН БЫТЬ НАКАЗАН.*~
@56195 = ~«Так если ты когда-либо позволишь преступнику избежать наказания, то сам должен быть наказан?»~
@56196 = ~«Хорошо. У меня другие вопросы…»~
@56197 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56198 = ~«Неважно, Вейлор. Пойдём дальше».~
@56199 = ~*ДА.*~
@56200 = ~«Что ж, пока ты томился в заключении под Керстом, тысячи… сотни тысяч… может, миллионы преступников на всех планах родились, прожили свои жизни и умерли. У тебя не было *никакой* возможности наказать их. Можешь ли ты и вправду справедливо оценить каждое создание в мультивселенной?»~
@56201 = ~«Хорошо. У меня другие вопросы…»~
@56202 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56203 = ~«Неважно, Вейлор. Пойдём дальше».~
@56204 = ~*Тогда я найду их ПОСЛЕ смерти и покараю.*~
@56205 = ~«Если ты это сделаешь, то не сможешь больше карать живущих. Что ты предпочтёшь, Вейлор?»~
@56206 = ~«Хорошо. У меня другие вопросы…»~
@56207 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56208 = ~«Неважно, Вейлор. Пойдём дальше».~
@56209 = ~*Тогда я продолжу свою миссию ПРАВОСУДИЯ на планах, среди ЖИВУЩИХ.*~
@56210 = ~«Но ведь среди умерших гораздо больше преступников, чем среди живущих… и все живущие в конце концов умрут, не так ли? Если ты умрёшь, то сможешь достать всех их».~
@56211 = ~«Но ведь среди умерших гораздо больше преступников, чем среди живущих… и все живущие в конце концов умрут, не так ли? Если ты умрёшь, то сможешь достать всех их».~
@56212 = ~«Хорошо. У меня другие вопросы…»~
@56213 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56214 = ~«Неважно, Вейлор. Пойдём дальше».~
@56215 = ~~
@56216 = ~~
@56217 = ~*Твои слова ПУСТЫ. В них нет УБЕЖДЁННОСТИ. Они смердят ЛОЖЬЮ и ОБМАНОМ. Я не стану их больше слушать.*~
@56218 = ~«Хорошо. У меня другие вопросы…»~
@56219 = ~«Тогда здесь наши пути расходятся, Вейлор. Прощай».~
@56220 = ~«Неважно, Вейлор. Пойдём дальше».~
@56221 = ~Вейлор стоит в безмолвии, его янтарные глаза сверкают из-под шлема.~
@56222 = ~«Ищи их среди мёртвых, Вейлор. Возможно, однажды мы там встретимся».~
@56223 = ~«Забудь мои слова, Вейлор. У меня другие вопросы…»~
@56224 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56225 = ~«Неважно, Вейлор. Пойдём дальше».~
@56226 = ~Твои слова порождают эхо, с каждым звуком набирая мощь. Едва ты их произносишь, огонь в янтарных глазах Вейлора мерцает, а затем угасает. Его доспехи рассыпаются, топор и металлические пластины с грохотом рушатся на пол. Упав на землю, железяки поднимают тучу пыли, от них летит пепел и хлопья вековой ржавчины, и на твоих глазах всё распадается в прах. Всё, что остаётся, — несколько насквозь проржавевших листов металла, единственное надгробие, напоминающее о существовании Вейлора.~
@56227 = ~«Покойся с миром, Вейлор».~
@56228 = ~Я убедил Вейлора в том, что если он хочет покарать всех преступников, то ему самому нужно умереть, ведь тогда он сможет карать и уже умерших, и тех, кому смерть ещё предстоит. Мои слова возымели мощное действие — столь мощное, что он буквально умер передо мной второй раз: его доспехи с топором рассыпались в пыль, и он исчез как «сдавшийся призрак».~
@56229 = ~*Время ТЕКЛО, пока я был заключён. Не время несёт СМЫСЛ. Только СПРАВЕДЛИВОСТЬ.*~
@56230 = ~«Помнишь ли ты, *зачем* пришёл в Керст?»~
@56231 = ~«Хорошо. У меня другие вопросы…»~
@56232 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56233 = ~«Неважно, Вейлор. Пойдём дальше».~
@56234 = ~*Многое из моих путешествий утрачено. Я путешествовал в поисках ПРЕДАТЕЛЕЙ. Они нашли меня и заточили. Акт ВЕРОЛОМСТВА.*~
@56235 = ~«Каких предателей?»~
@56236 = ~«Хорошо. У меня другие вопросы…»~
@56237 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56238 = ~«Неважно, Вейлор. Пойдём дальше».~
@56239 = ~*Керст — это ГОРОД ПРЕДАТЕЛЕЙ. Этот город попирает СПРАВЕДЛИВОСТЬ. Я пришёл ОЧИСТИТЬ его.*~
@56240 = ~«Как ты был заключён?»~
@56241 = ~«Хорошо. У меня другие вопросы…»~
@56242 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56243 = ~«Неважно, Вейлор. Пойдём дальше».~
@56244 = ~Какое-то время Вейлор молчит. Янтари его глаз мерцают.~
@56245 = ~«Вейлор? Ты помнишь, как тебя пленили?»~
@56246 = ~«Забудь мои слова, Вейлор. У меня другие вопросы…»~
@56247 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56248 = ~«Неважно, Вейлор. Пойдём дальше».~
@56249 = ~*Я не ЗНАЮ.*~
@56250 = ~«Хорошо. У меня другие вопросы…»~
@56251 = ~«Тогда здесь наши пути расходятся, Вейлор. Прощай».~
@56252 = ~«Тогда не бери в голову, Вейлор. Пойдём дальше».~
@56253 = ~*Мне нечему тебя научить. Не РУКА держит оружие. Оружием владеет ВОЛЯ.*~
@56254 = ~«Что ты имеешь в виду?»~
@56255 = ~«Что ж, ладно, Вейлор. У меня другие вопросы…»~
@56256 = ~«Неважно, Вейлор. Пойдём дальше».~
@56257 = ~*Когда ВОЛЯ сильна, то силён и КЛИНОК. Когда причина СПРАВЕДЛИВА, клинок разит ТОЧНО. Когда МИЛОСЕРДИЕ ест твоё сердце, СОМНЕНИЯ, НЕУВЕРЕННОСТЬ, СОСТРАДАНИЕ следуют за ним. Тогда клинок становится ПЫЛЬЮ.*~
@56258 = ~«Моя воля сильна, Вейлор. Моя убеждённость придаёт силу клинку».~
@56259 = ~«Моя воля сильна, Вейлор. Моя убеждённость придаёт силу клинку».~
@56260 = ~«Что ж, ладно, Вейлор. У меня другие вопросы…»~
@56261 = ~«Неважно, Вейлор. Пойдём дальше».~
@56262 = ~Взгляд янтарных глаз Вейлора падает на тебя. Следует тягостная тишина.~
@56263 = ~*Твоя ВОЛЯ сильна. Твоя ДИСЦИПЛИНА сильна. Твоя ВОЛЯ — воля ЗАКОНА.*~
@56264 = ~«Тогда как мне?..»~
@56265 = ~*ЗНАЙ: нет НИЧЕГО на всех ПЛАНАХ, что сможет УСТОЯТЬ перед рукой СПРАВЕДЛИВОСТИ, направленной против него. Она может сломить АРМИИ. Она может расколоть троны БОГОВ. Когда твоё побуждение — СПРАВЕДЛИВОСТЬ, СПРАВЕДЛИВОСТЬ придаст тебе свою СИЛУ.*~
@56266 = ~«Понимаю».~
@56267 = ~*Ты НЕ понимаешь. Ещё НЕТ. Открой мне свои глаза и ты УВИДИШЬ ПЛАНЫ глазами СПРАВЕДЛИВОСТИ.*~
@56268 = ~«Хорошо… покажи мне, что видишь».~
@56269 = ~«Нет, Вейлор… я не желаю видеть. Вместо этого я хочу задать вопрос…»~
@56270 = ~«Думаю, я не готов увидеть то, что ты хочешь показать, Вейлор. Пойдём дальше».~
@56271 = ~Ты смотришь в глаза Вейлора, и два его огня внезапно ВСПЫХИВАЮТ…~
@56272 = ~«Чт…»~
@56273 = ~«Чт…»~
@56274 = ~«Чт…»~
@56275 = ~На мгновение вспышка ослепляет тебя, а когда ты открываешь глаза, всё вокруг кажется ОБОСТРЁННЫМ, будто обрастает новыми углами; ты чувствуешь себя сильнее, словно как-то можешь РАССЕЧЬ любой предмет, на который устремлён твой взгляд.~
@56276 = ~«Вейлор… что это?..»~
@56277 = ~*УЗРИ все вещи. УЗРИ их силу. УЗРИ их СЛАБОСТЬ. СУДИ все вещи. Если МИЛОСЕРДИЕ ест их сердца, то они ПАДУТ перед СПРАВЕДЛИВОСТЬЮ. Твоя ВОЛЯ даёт тебе ПРАВО. Твоя ДИСЦИПЛИНА даёт тебе ПРАВО.*~
@56278 = ~«Хорошо… Я… хотел спросить кое-что ещё».~
@56279 = ~«Теперь я вижу. Пойдём… дальше».~
@56280 = ~*Твоя ВОЛЯ сильна. Но тебе не хватает ДИСЦИПЛИНЫ. Твоя ВОЛЯ — это ТВОЯ воля, не воля ЗАКОНА. Мне нечего показать, что ты смог бы УВИДЕТЬ или ПОНЯТЬ.*~
@56281 = ~«Что ж, ладно, Вейлор. У меня другие вопросы…»~
@56282 = ~«Тогда неважно. Пойдём дальше».~
@56283 = ~Взгляд янтарных глаз Вейлора падает на тебя. Следует тягостная тишина.~
@56284 = ~«Вейлор? Как ты умер?»~
@56285 = ~«Забудь, Вейлор. У меня другие вопросы…»~
@56286 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56287 = ~«Неважно, Вейлор. Пойдём дальше».~
@56288 = ~*Я ЖИВ.*~
@56289 = ~«Ну, в какой-то степени… но что случилось с твоим физическим телом?»~
@56290 = ~«Ну, в какой-то степени… но что случилось с твоим физическим телом?»~
@56291 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56292 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56293 = ~«Неважно, Вейлор. Пойдём дальше».~
@56294 = ~Едва ты открываешь рот, как затылок охватывает странное покалывание и внезапно ты *понимаешь*: Вейлор не осознаёт, что он мёртв. Почему-то тебе кажется, что открытие этого факта может оказаться очень опасным.~
@56295 = ~«Вейлор? Что случилось с твоим физическим телом?»~
@56296 = ~«Забудь, Вейлор. У меня другие вопросы…»~
@56297 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56298 = ~«Неважно, Вейлор. Пойдём дальше».~
@56299 = ~*Я ЖИВ. Пока те ОСУЖДЁННЫЕ не понесут НАКАЗАНИЯ, Я ЖИВ.*~
@56300 = ~«Вейлор, ты не *по-настоящему* жив… ты стал духом, призраком, привидением».~
@56301 = ~«А ты ЧУВСТВУЕШЬ себя живым, Вейлор? Сними свои латные перчатки, посмотри, увидят ли твои глаза смертную плоть. Коснись рукой острия топора — разве потечёт из тебя кровь? А твои глаза — они горят огнём, но могут ли они рождать слёзы? Твой дух жив, Вейлор, но не *ты*».~
@56302 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56303 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56304 = ~«Неважно, Вейлор. Пойдём дальше».~
@56305 = ~Повисает тяжёлая, напряжённая тишина; Вейлор не отвечает.~
@56306 = ~«Забудь, Вейлор. У меня другие вопросы…»~
@56307 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56308 = ~«Неважно, Вейлор. Пойдём дальше».~
@56309 = ~На мгновение… не больше, глаза Вейлора тускнеют.~
@56310 = ~«Вейлор, можешь ли ты хотя бы ВСПОМНИТЬ, как выглядишь под бронёй? Когда-то ты был человеком из плоти и крови, когда-то ты был жив и был вершителем справедливости. Но теперь этот человек мёртв. И лишь страдающая оболочка ещё жива».~
@56311 = ~«Вейлор, можешь ли ты хотя бы ВСПОМНИТЬ, как выглядишь под бронёй? Я могу. Когда-то ты был человеком из плоти и крови, темнокожим, с огненными глазами… бесчисленное количество шрамов покрывало твою плоть, и много дел ты свершил во имя справедливости. Но теперь этот человек мёртв. И лишь страдающая оболочка ещё жива».~
@56312 = ~«Забудь мои слова, Вейлор. У меня к тебе другие вопросы…»~
@56313 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56314 = ~«Неважно, Вейлор. Пойдём дальше».~
@56315 = ~*Я… помню.* — глаза Вейлора мерцают, блуждают сильнее, чем раньше; его топор опускается. — *Воспоминания… возвращаются с ТРУДОМ. Была СМЕРТЬ… и я ИЗМЕНИЛСЯ. Я больше не ТОТ, кем был. Что Я ЕСТЬ?*~
@56316 = ~«Не знаю, Вейлор. Человек, бывший Вейлором, сейчас мёртв… теперь ты нечто другое».~
@56317 = ~«Забудь мои слова, Вейлор… У меня другие вопросы…»~
@56318 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56319 = ~«Неважно, Вейлор. Пойдём дальше».~
@56320 = ~*СПРАВЕДЛИВОСТЬ была моей движущей силой. ПЛОТЬ… ПЛОТЬ могла не сохраниться. Но СПРАВЕДЛИВОСТЬ по-прежнему требует СЛУЖЕНИЯ. Была СМЕРТЬ плоти, но ВОЛЯ не могла уйти… ЕЩЁ были те, кто заслуживал НАКАЗАНИЯ. Они есть ВСЕГДА. СПРАВЕДЛИВОСТЬ… СПРАВЕДЛИВОСТЬ не выиграет от моей СМЕРТИ.*~
@56321 = ~«Но ты УМЕР, Вейлор, давным-давно. И теперь настало время уйти».~
@56322 = ~«Ты только ЛЖЁШЬ самому себе, думая, что жив. Ты МЁРТВ, Вейлор. Какая может быть СПРАВЕДЛИВОСТЬ, если её служители лгут сами себе?»~
@56323 = ~«Тогда ладно, Вейлор. У меня другие вопросы…»~
@56324 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56325 = ~«Неважно, Вейлор. Пойдём дальше».~
@56326 = ~Я убедил Вейлора, что он более не жив, что ему нужно уйти и оставить свой крестовый поход во имя справедливости. Мои слова возымели на него мощное действие — столь мощное, что он буквально умер передо мной второй раз: его доспехи с топором рассыпались в пыль, и он исчез как «сдавшийся призрак».~
@56327 = ~Взгляд янтарных глаз Вейлора падает на тебя. Следует тягостная тишина.~
@56328 = ~*Я ПРИСОЕДИНЮСЬ к тебе. Мы будем искать СПРАВЕДЛИВОСТЬ вместе. Где бы ни скрывалось МИЛОСЕРДИЕ, мы НИЗВЕРГНЕМ его.*~
@56329 = ~«Отлично».~
@56330 = ~Взгляд янтарных глаз Вейлора падает на тебя. Следует тягостная тишина.~
@56331 = ~*Я ПРИСОЕДИНЮСЬ к тебе. Твоя ВОЛЯ НЕПОСТОЯННА, но я НАУЧУ тебя СПРАВЕДЛИВОСТИ. Я научу тебя НИЗВЕРГАТЬ МИЛОСЕРДИЕ.*~
@56332 = ~«Отлично».~
@56333 = ~*Ищет ли твоё сердце СПРАВЕДЛИВОСТИ? Или у твоего ПУТЕШЕСТВИЯ нет ЦЕЛИ?*~
@56334 = ~Правда: «Я ищу справедливости, Вейлор. Ты присоединишься ко мне?»~
@56335 = ~Правда: «Я ищу справедливости, Вейлор. Ты присоединишься ко мне?»~
@56336 = ~Ложь: «Я ищу справедливости, Вейлор. Ты присоединишься ко мне?»~
@56337 = ~Ложь: «Я ищу справедливости, Вейлор. Ты присоединишься ко мне?»~
@56338 = ~*Убийцы Милосердия служат ГЛАЗАМИ СПРАВЕДЛИВОСТИ. СПРАВЕДЛИВОСТЬ использует Убийц Милосердия для распространения своей ВОЛИ. Когда ПРИГОВОР вынесен, он ПРИДАЁТ нам СИЛУ справедливости.*~
@56339 = ~«Я ищу познания себя, Вейлор, и если в познании есть справедливость, то я найду и её».~
@56340 = ~«Я ищу познания себя, Вейлор, и если в познании есть справедливость, то я найду и её».~
@56341 = ~*СИЛА СПРАВЕДЛИВОСТИ зависит от вреда, нанесённого НЕСПРАВЕДЛИВОСТЬЮ.*~
@56342 = ~«Значит… чем больше несправедливость — страшнее преступление — тем большую силу придаёт тебе „справедливость“?»~
@56343 = ~«И откуда ты знаешь, *когда* приходит время распространять справедливость?»~
@56344 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56345 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56346 = ~«Неважно, Вейлор. Пойдём дальше».~
@56347 = ~«И откуда ты знаешь, *когда* приходит время распространять справедливость?»~
@56348 = ~«Силу? Как?»~
@56349 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56350 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56351 = ~«Неважно, Вейлор. Пойдём дальше».~
@56352 = ~*Когда НЕСПРАВЕДЛИВОСТЬ велика, СПРАВЕДЛИВОСТЬ придаёт мне СИЛУ, необходимую для исправления несправедливости. НИЧТО не может противостоять ей. Она СЛОМИТ любые преграды, ПРОБЬЁТ любой щит, СОРВЁТ любое ЗАКЛИНАНИЕ и придаст своему слуге СИЛУ ВЫНЕСТИ ПРИГОВОР.*~
@56353 = ~Вейлор несколько больше, чем просто неупокоенный дух. Похоже, он является воплощением справедливости. По его словам, справедливость придаёт ему силы, чтобы исправлять несправедливость: чем больше несправедливость, тем больше силы он получает. Вейлор утверждает, что справедливость придаёт ему силу, позволяющую рассеивать армии… даже свергать богов с их тронов. Почему-то его слова пробудили во мне странные воспоминания: я знаю, что слышал эти слова раньше, и какими бы невероятными они ни звучали, но я чувствую, что это правда.~
@56354 = ~Едва Вейлор произносит эти слова, как по всему твоему телу бегут мурашки — столь сильные, что переходят в дрожь. Ты *слышал* эти слова раньше и знаешь, что они *истинны*.~
@56355 = ~*ЗНАЙ: нет НИЧЕГО на всех ПЛАНАХ, что сможет УСТОЯТЬ перед рукой СПРАВЕДЛИВОСТИ, направленной против него. Она может сломить АРМИИ. Она может расколоть троны БОГОВ. Знай, что для всех, кто ПРЕДАЛ справедливость, я — их РОК. И рок несёт с собой ТОПОР ПАЛАЧА.*~
@56356 = ~«Понимаю».~
@56357 = ~*НЕТ, ты НЕ понимаешь.* — глаза Вейлора горят, подобно двум факелам в густой тени его шлема. — *МОЛИСЬ, чтобы никогда не ПОНЯТЬ.*~
@56358 = ~«И откуда ты знаешь, *когда* приходит время распространять справедливость?»~
@56359 = ~«Что ж, ладно, Вейлор. У меня другие вопросы…»~
@56360 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56361 = ~«Неважно, Вейлор. Пойдём дальше».~
@56362 = ~*СПРАВЕДЛИВОСТЬ смотрит моими глазами. ГЛАЗА УБИЙЦЫ МИЛОСЕРДИЯ видят ТРЕЩИНЫ СЛАБОСТЕЙ, ПОРОКОВ, раны МИЛОСЕРДИЯ в СЕРДЦЕ. ВИДЯ это, я познаю ВИНОВНОСТЬ. Я ПОЗНАЮ СТРАХ обвиняемого.*~
@56363 = ~«Что ты видишь, когда смотришь на других?»~
@56364 = ~«Что ты имел в виду, когда сказал, что справедливость придаёт тебе „силу“?»~
@56365 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56366 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56367 = ~«Неважно, Вейлор. Пойдём дальше».~
@56368 = ~*Всё, что я вижу, ПОДСУДНО. Я могу смотреть в разум и сердце другого и ЗНАТЬ его. Через МЕНЯ смотрят глаза СПРАВЕДЛИВОСТИ.*~
@56369 = ~«Что ты видишь, когда смотришь на Морте?»~
@56370 = ~«Что ты видишь, когда смотришь на Анну?»~
@56371 = ~«Что ты видишь, когда смотришь на Дак'кона?»~
@56372 = ~«Что ты видишь, когда смотришь на Падшую Грейс?»~
@56373 = ~«Что ты видишь, когда смотришь на Падшую Грейс?»~
@56374 = ~«Что ты видишь, когда смотришь на Нордома?»~
@56375 = ~«Что ты видишь, когда смотришь на Игнуса?»~
@56376 = ~«Что ты видишь, когда смотришь на себя?»~
@56377 = ~«Что ты видишь, когда смотришь на себя?»~
@56378 = ~«Что ты видишь, когда смотришь на меня?»~
@56379 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56380 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56381 = ~«Неважно, Вейлор. Пойдём дальше».~
@56382 = ~*СПРАШИВАЙ.*~
@56383 = ~«Что ты видишь, когда смотришь на Морте?»~
@56384 = ~«Что ты видишь, когда смотришь на Анну?»~
@56385 = ~«Что ты видишь, когда смотришь на Дак'кона?»~
@56386 = ~«Что ты видишь, когда смотришь на Падшую Грейс?»~
@56387 = ~«Что ты видишь, когда смотришь на Падшую Грейс?»~
@56388 = ~«Что ты видишь, когда смотришь на Нордома?»~
@56389 = ~«Что ты видишь, когда смотришь на Игнуса?»~
@56390 = ~«Что ты видишь, когда смотришь на себя?»~
@56391 = ~«Что ты видишь, когда смотришь на себя?»~
@56392 = ~«Что ты видишь, когда смотришь на меня?»~
@56393 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56394 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56395 = ~«Неважно, Вейлор. Пойдём дальше».~
@56396 = ~*Череп знает МНОГОЕ. Но он НИЧЕГО не знает о справедливости. Многие с сердцами, подобными тому, что у черепа, сейчас в ТЮРЬМАХ и МОГИЛАХ.*~
@56397 = ~«Позволь спросить кое о ком другом…»~
@56398 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56399 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56400 = ~«Неважно, Вейлор. Пойдём дальше».~
@56401 = ~*Тифлинг ИСПОРЧЕНА Нижними планами. В её крови нет места для преданности к СПРАВЕДЛИВОСТИ. Она понимает СПРАВЕДЛИВОСТЬ, но ИГНОРИРУЕТ её.* — глаза Вейлора вспыхивают факелами. — *Она не будет ИГНОРИРОВАТЬ МЕНЯ.*~
@56402 = ~«Позволь спросить кое о ком другом…»~
@56403 = ~«Ладно, Вейлор. У меня вопросы о другом…»~
@56404 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56405 = ~«Неважно, Вейлор. Пойдём дальше».~
@56406 = ~Глаза Вейлора пылают: *Тифлинг, ОТВЕТЬ мне: совершала ли ты когда-нибудь НЕСПРАВЕДЛИВОСТЬ?*~
@56407 = ~*СПРАВЕДЛИВОСТЬ даёт мне ПРАВО.*~
@56408 = ~*Убийцы Милосердия и ЕСТЬ справедливость. Наши действия ВЫШЕ вопросов, ТИФЛИНГ.*~
@56409 = ~~
@56410 = ~*В ПОСЛЕДНИЙ РАЗ спрашиваю, тифлинг: совершала ли ты когда-нибудь несправедливость? ОТКАЗ отвечать есть подтверждение ВИНЫ.*~
@56411 = ~«Вейлор, заканчивай. Сейчас же. Я не хочу, чтобы ты её допрашивал».~
@56412 = ~Подождать и послушать, что скажет Анна.~
@56413 = ~Подождать и послушать, что скажет Анна.~
@56414 = ~*Ты ОТКАЗАЛАСЬ отвечать СПРАВЕДЛИВОСТИ. Я НАКАЖУ тебя.*~
@56415 = ~«Нет, Вейлор, не накажешь. Не имеешь права».~
@56416 = ~Ждать и смотреть, что будет дальше.~
@56417 = ~~
@56418 = ~*СПРАВЕДЛИВОСТЬ даёт мне ПРАВО. Вина ПОКРЫВАЕТ её, подобно второй коже.*~
@56419 = ~«Я сказал тебе прекратить, Вейлор, и я не шучу».~
@56420 = ~~
@56421 = ~*Он совершила НЕСПРАВЕДЛИВОСТЬ. Я НАКАЖУ её.*~
@56422 = ~~
@56423 = ~*Всё, что стоит на ПУТИ СПРАВЕДЛИВОСТИ, должно быть ПРИГОВОРЕНО. Ты ЗАСЛУЖИЛА свою судьбу, СУККУБ.*~
@56424 = ~«Нет, Вейлор, не накажешь. Не имеешь права».~
@56425 = ~Ждать и смотреть, что будет дальше.~
@56426 = ~*Так распутство МИЛОСЕРДИЯ проявило себя. СЛАБОСТЬ отравила твоё сердце.*~
@56427 = ~«Это не милосердие. Это мой *приказ*. Хочешь испытать мои слабости, Вейлор?»~
@56428 = ~«Милосердие — не слабость, Вейлор. Ты оставишь её в покое или ответишь предо мной».~
@56429 = ~«Неужели? Тогда суди меня, Вейлор, и если найдёшь недостатки, то попробуй привести в действие свой приговор надо *мной*».~
@56430 = ~*Всё, что стоит на ПУТИ СПРАВЕДЛИВОСТИ, должно быть ПРИГОВОРЕНО.* — глаза Вейлора сверкают, он заносит свой топор. — *Ты ЗАСЛУЖИЛ свою судьбу.*~
@56431 = ~«Приготовься умереть второй смертью, Вейлор…»~
@56432 = ~*В сердце этого гитцерай нет ПРЕДУБЕЖДЁННОСТИ, отравляющей его РОД. Но он существует в КОНФЛИКТЕ с самими собой, ибо его СЛОВО есть его ВОЛЯ и его ЗАКОН. Там, где гитцерай преуспевают в хаосе, этот страдает.*~
@56433 = ~«Предубеждённости? Что ты имеешь в виду?»~
@56434 = ~«Позволь спросить кое о ком другом…»~
@56435 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56436 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56437 = ~«Неважно, Вейлор. Пойдём дальше».~
@56438 = ~*Раса гитцерай рождается с ПРЕДУБЕЖДЕНИЯМИ. Но в глазах СПРАВЕДЛИВОСТИ нет места ПРЕДУБЕЖДЕНИЯМ.*~
@56439 = ~«Что за предубеждения?»~
@56440 = ~«Позволь спросить кое о ком другом…»~
@56441 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56442 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56443 = ~«Неважно, Вейлор. Пойдём дальше».~
@56444 = ~*По своей природе предубеждения ПОРОЧАТ справедливость. Гитцерай предубеждены против гитиянки, своих расовых родичей, и против иллитидов, которые были ВЛАДЕЛЬЦАМИ народа гит. Ненависть к ОБОИМ — гитиянки и иллитидам — горит в сердце гитцерай.*~
@56445 = ~«Позволь спросить кое о ком другом…»~
@56446 = ~«Предубеждения порочат справедливость, да? А как насчёт того, что ты сказал об Анне?»~
@56447 = ~«Предубеждения порочат справедливость, да? А как насчёт того, что ты сказал о Падшей Грейс?»~
@56448 = ~«Предубеждения порочат справедливость, да? А как насчёт того, что ты сказал об Анне и Падшей Грейс?»~
@56449 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56450 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56451 = ~«Неважно, Вейлор. Пойдём дальше».~
@56452 = ~*Мои слова НЕ были продиктованы предубеждением. Они основаны на НАБЛЮДЕНИИ и ВОСПОМИНАНИИ.*~
@56453 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56454 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56455 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56456 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56457 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56458 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56459 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56460 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56461 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56462 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56463 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56464 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56465 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56466 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56467 = ~«Что ж, мне кажется, твои „наблюдения“ говорят о предубеждённости, Вейлор. Ты быстренько свалил всех извергов в одну кучу. Может, тебе стоит перепроверить свои наблюдения?»~
@56468 = ~«Позволь спросить кое о ком другом…»~
@56469 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56470 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56471 = ~«Неважно, Вейлор. Пойдём дальше».~
@56472 = ~*Мои НАБЛЮДЕНИЯ сделаны ГЛАЗАМИ СПРАВЕДЛИВОСТИ. Я НАБЛЮДАЮ, а затем ДЕЙСТВУЮ. Тебе следует хорошо ПОМНИТЬ это, даже если ты забудешь всё остальное.*~
@56473 = ~«Позволь спросить кое о ком другом…»~
@56474 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56475 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56476 = ~«Неважно, Вейлор. Пойдём дальше».~
@56477 = ~Найти имя для безымянной зомби.~
@56478 = ~Я сказал безымянной зомби, что она должна выбрать себе имя сама.~
@56479 = ~Безымянная зомби наконец обрела своё собственное имя.~
@56480 = ~Разыскать Немель по просьбе Эльвин.~
@56481 = ~Я согласился помочь женщине по имени Эльвин найти её подругу Немель. Будем надеяться, та где-нибудь в районе Клерков.~
@56482 = ~Я нашёл Эльвин. Теперь она хочет, чтобы я сказал Немель, где она ждёт.~
@56483 = ~Я воссоединил Эльвин и Немель.~
@56484 = ~Разыскать Эльвин по просьбе Немель.~
@56485 = ~Я согласился помочь женщине по имени Немель найти её подругу Эльвин. Будем надеяться, та где-нибудь в районе Клерков.~
@56486 = ~Я воссоединил Эльвин и Немель.~
@56487 = ~Достать Малманеру костюм у Гонкальвеса.~
@56488 = ~Я согласился принести человеку по имени Малманер одежду Пыльного. Её можно взять у портного Гонкальвеса из района Клерков.~
@56489 = ~Я отдал Малманеру одежду Пыльного.~
@56490 = ~Приобрести для Малманера второй костюм.~
@56491 = ~Я согласился принести Малманеру второй костюм.~
@56492 = ~Я всё-таки принёс Малманеру одежду Богота.~
@56493 = ~Разделить Прыща и Кильна.~
@56494 = ~Я встретил… человека… который на самом деле является двумя людьми, слитыми в одно целое. Я сказал ему — им? — что вернусь, если найду способ разделить их.~
@56495 = ~Я дал Прыщу Кильну Эликсир жуткого разделения — заколдованный отвар, с помощью которого он смог разделиться обратно на Прыща и Кильна.~
@56496 = ~Найти способ стереть память Весельчака.~
@56497 = ~Мужчина по имени Весельчак попросил меня найти способ избавить от его воспоминаний. Довольно иронично, нет?.. В любом случае как вариант он предложил воду из реки Стикс, однако мне неизвестно, где её искать.~
@56498 = ~Я принёс Весельчаку Тёмную Птицу Октануса — осколок льда из реки Стикс. Проглотив осколок, он потерял все свои воспоминания. Именно этого он и хотел, хотя не могу сказать, что завидую приятелю.~
@56499 = ~Вернуть Долоре «ключи к её сердцу».~
@56500 = ~Вернуть Экко способность разговаривать.~
@56501 = ~Я согласился помочь Экко, одной из проституток в Борделе Безумной Интеллектуальной Страсти, вернуть способность говорить.~
@56502 = ~Я смог вернуть Экко способность говорить, использовав для этого язык изверга и немного слёз дэва.~
@56503 = ~Доказать Кезай-Серрис, что она дочь Рейвел.~
@56504 = ~*ТАНАР'РИ ПОРОЖДЕНЫ хаосом. Их НИСКОЛЬКО не заботит СПРАВЕДЛИВОСТЬ. СУККУБ знает о СПРАВЕДЛИВОСТИ, но ОТВЕРНУЛАСЬ от неё. МИЛОСЕРДИЕ отравило её СЕРДЦЕ.*~
@56505 = ~«Позволь спросить кое о ком дру…»~
@56506 = ~«Ладно, Вейлор. У меня другие вопр…»~
@56507 = ~«Неважно, Вейлор. Пош…»~
@56508 = ~Глаза Вейлора вспыхивают: *МИЛОСЕРДИЕ пожирает само СЕРДЦЕ СПРАВЕДЛИВОСТИ. МИЛОСЕРДИЕ искажает любое СОВЕРШЕНСТВО. СОСТРАДАНИЕ и ПРОЩЕНИЕ — вот яд МИЛОСЕРДИЯ.*~
@56509 = ~*Ты СЛАБА, СУККУБ. СЛАБА так же, как и весь твой РОД. Где твои СОРОДИЧИ совращают с помощью ПЛОТИ, там тебя СОВРАЩАЕТ МИЛОСЕРДИЕ. Ты — ШЛЮХА МИЛОСЕРДИЯ. Ты — НИЧТО.*~
@56510 = ~Глаза Вейлора пылают, когда он смотрит на Падшую Грейс, два янтаря горят факелами. Падшая Грейс встречает его взгляд спокойно, её глаза чисты и решительны.~
@56511 = ~*В нём кроются КОРНИ СЛАБОСТИ. Ты ВЕРИШЬ, что СИЛЬНА, но под этими корнями кормится МИЛОСЕРДИЕ. Оно ПОЖИРАЕТ твою ВОЛЮ.* — Вейлор выдерживает паузу, и следующие его слова падают подобно молоту: — *К тому же… ДРУГУЮ слабость ты НОСИШЬ в своём СЕРДЦЕ, СУККУБ. Вот, что видят МОИ глаза. Ты ЗАБОТИШЬСЯ. ЗАБОТЯСЬ, ты становишься СЛАБОЙ.*~
@56512 = ~*ТАНАР'РИ ПОРОЖДЕНЫ хаосом. Их НИСКОЛЬКО не заботит СПРАВЕДЛИВОСТЬ. СУККУБ знает о СПРАВЕДЛИВОСТИ, но ОТВЕРНУЛАСЬ от неё. МИЛОСЕРДИЕ пустило КОРНИ в её сердце. Она ЗАБОТИТСЯ. ЗАБОТЯСЬ, она становится слабой.*~
@56513 = ~«Позволь спросить кое о ком другом…»~
@56514 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56515 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56516 = ~«Неважно, Вейлор. Пойдём дальше».~
@56517 = ~*Я вижу след ПРАВОСУДИЯ, свершённого над магом.*~
@56518 = ~«Хочешь сказать, Игнус был судим?»~
@56519 = ~«Позволь спросить кое о ком другом…»~
@56520 = ~«Что ж, ладно, Вейлор. У меня другие вопросы…»~
@56521 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56522 = ~«Неважно, Вейлор. Пойдём дальше».~
@56523 = ~*Пламя, ГОРЯЩЕЕ вокруг него, гласит о справедливости. Маг НАКАЗАН. Он не ЖИВЁТ более, а стал ЧАСТЬЮ ПЛАНОВ. Его тело — это КАНАЛ. Там нет СЕРДЦА. Он был ПРИГОВОРЁН.*~
@56524 = ~«Знаешь ли ты, почему Игнус не умер? Разве этот огонь не должен был убить его?»~
@56525 = ~«Позволь спросить кое о ком другом…»~
@56526 = ~«Что ж, ладно, Вейлор. У меня другие вопросы…»~
@56527 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56528 = ~«Неважно, Вейлор. Пойдём дальше».~
@56529 = ~*Он больше не ЖИВЁТ. Он только СУЩЕСТВУЕТ. Это не ОДНО И ТО ЖЕ.*~
@56530 = ~«Позволь спросить кое о ком другом…»~
@56531 = ~«Что ж, ладно, Вейлор. У меня другие вопросы…»~
@56532 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56533 = ~«Неважно, Вейлор. Пойдём дальше».~
@56534 = ~*МОДРОН не имеет значения. Он может ОПРЕДЕЛИТЬ справедливость, но не ПОНИМАЕТ её. Это неудовлетворительно. Но этого ДОСТАТОЧНО.*~
@56535 = ~«Позволь спросить кое о ком другом…»~
@56536 = ~«Что ж, ладно, Вейлор. У меня другие вопросы…»~
@56537 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56538 = ~«Неважно, Вейлор. Пойдём дальше».~
@56539 = ~*Я — ВЕЙЛОР. Я — УБИЙЦА МИЛОСЕРДИЯ. О моём сердце говорят мои ДЕЙСТВИЯ.*~
@56540 = ~«Это не то, о чём я спросил».~
@56541 = ~«Позволь спросить кое о ком другом…»~
@56542 = ~«Ладно, Вейлор. У меня другие вопросы…»~
@56543 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56544 = ~«Неважно, Вейлор. Пойдём дальше».~
@56545 = ~Повисает тяжёлая тишина… но Вейлор не прерывает её. Его янтарные глаза встречают твой пристальный взгляд без содрогания.~
@56546 = ~«Я спросил, что ты видишь, когда смотришь на самого себя. Что ты видишь, когда судишь сам себя, Вейлор?»~
@56547 = ~«Позволь спросить кое о ком другом…»~
@56548 = ~«Забудь, Вейлор. У меня другие вопросы…»~
@56549 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56550 = ~«Неважно, Вейлор. Пойдём дальше».~
@56551 = ~*Я не СУЖУ себя. Я — УБИЙЦА МИЛОСЕРДИЯ. О моём СЕРДЦЕ говорят мои ДЕЙСТВИЯ. Моя ВОЛЯ — ВОЛЯ СПРАВЕДЛИВОСТИ.*~
@56552 = ~«Так ты неподсуден?»~
@56553 = ~«Позволь спросить кое о ком другом…»~
@56554 = ~«Что ж, ладно, Вейлор. У меня другие вопросы…»~
@56555 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56556 = ~«Неважно, Вейлор. Пойдём дальше».~
@56557 = ~*Я СЛУЖУ справедливости. Я не НЕПОДСУДЕН. Ничто не МОЖЕТ быть НЕПОДСУДНЫМ.*~
@56558 = ~«Тогда взгляни на себя, Вейлор. Что видят глаза справедливости, когда смотрят на своего служителя?»~
@56559 = ~«Позволь спросить кое о ком другом…»~
@56560 = ~«Что ж, ладно, Вейлор. У меня другие вопросы…»~
@56561 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56562 = ~«Неважно, Вейлор. Пойдём дальше».~
@56563 = ~Янтарные глаза Вейлора внезапно темнеют, и в воздухе воцаряется ужасающая ТИШИНА.~
@56564 = ~Как только ты уже начинаешь сомневаться, что глаза Вейлора когда-нибудь снова загорятся, происходит ВСПЫШКА и тебе приходиться прикрыть глаза.~
@56565 = ~«Вейлор…»~
@56566 = ~*Я — ВЕЙЛОР. Я — УБИЙЦА МИЛОСЕРДИЯ. О моём СЕРДЦЕ говорят мои ДЕЙСТВИЯ. Я — СЛУЖИТЕЛЬ СПРАВЕДЛИВОСТИ.*~
@56567 = ~«Но… Вейлор, что ты ВИДЕЛ, когда…»~
@56568 = ~«Но… Вейлор, что ты ВИДЕЛ, когда…»~
@56569 = ~«Хорошо. Я хочу спросить тебя кое о ком другом…»~
@56570 = ~«Что ж, ладно, Вейлор. У меня другие вопросы…»~
@56571 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56572 = ~«Неважно, Вейлор. Пойдём дальше».~
@56573 = ~Уже открыв рот, ты чувствуешь, как странное ощущение охватывает заднюю часть черепа и слова замирают на кончике языка… ты знаешь, что если их произнесёшь, то пробудишь нечто внутри Вейлора. Нечто опасное.~
@56574 = ~«Но… Вейлор, что ты ВИДЕЛ, когда заглянул внутрь себя?»~
@56575 = ~«Неважно, Вейлор. Я хочу спросить тебя кое о ком другом…»~
@56576 = ~«Что ж, ладно, Вейлор. У меня другие вопросы…»~
@56577 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56578 = ~«Неважно, Вейлор. Пойдём дальше».~
@56579 = ~*Я НЕ НАХОЖУ НЕДОСТАТКОВ. ТАМ, ГДЕ ЖИВЁТ МИЛОСЕРДИЕ, — Я УНИЧТОЖУ ЕГО. ТАМ, ГДЕ СОСТРАДАНИЕ ОТРАВЛЯЕТ СЕРДЦА, Я ВЫДАВЛЮ ЕГО ИЗ ЕГО ЖЕРТВ. ТАМ, ГДЕ ЛЖЕЦЫ И ПРЕДАТЕЛИ ИСТИНЫ РАСПРОСТРАНЯЮТ ЛОЖЬ, — Я ОТВЕЧУ НА ИХ ЛОЖЬ КЛИНКОМ СПРАВЕДЛИВОСТИ.*~
@56580 = ~«Но мой *вопрос* был…»~
@56581 = ~*КТО ТЫ, ЧТОБЫ ЗАДАВАТЬ ВОПРОСЫ СЛУЖИТЕЛЮ СПРАВЕДЛИВОСТИ? ТЫ — НИЧТО. ТЫ ОБОЛОЧКА. ТЕПЕРЬ Я ЗАГЛЯНУ В ТВОЁ СЕРДЦЕ. ПОСМОТРИМ, НАЙДУТСЯ ЛИ НЕДОСТАТКИ.*~
@56582 = ~«Но…»~
@56583 = ~Когда пылающий огнём взгляд Вейлора падает на тебя, ты чувствуешь, как он пробивается сквозь твою кожу, раздирая и срывая её с тебя, — но боли нет, только ощущение головокружения и лёгкое чувство *погружения*. Едва его взгляд проникает в тебя, как твоя память пробуждается…~
@56584 = ~Отдаться воспоминаниям.~
@56585 = ~Отбросить воспоминания и попытаться остаться в настоящем.~
@56586 = ~Пылающие красные глаза разгораются всё ярче, почти ослепляют; потом ты оказываешься ЛИЦОМ К ЛИЦУ с Вейлором. Но там, где под его шлемом была пустота, теперь находится *плоть*. Покрытый шрамами темнокожий человек смотрит на тебя из-под шлема, его глаза горят огнём, когда он рассматривает тебя. Броня мерцает, а его лицо застыло в гримасе ярости. Он пришёл *за тобой*.~
@56587 = ~Эхо: «Ты нашёл меня, Вейлор. Ты прошёл длинный путь… могу представить, как нелегко было найти меня».~
@56588 = ~Отбросить воспоминания и попытаться остаться в настоящем.~
@56589 = ~«Справедливость привела меня к тебе. Там, где ты ступал, остался след СТРАДАНИЙ, — голос мужчины гремит, но эха нет — ничего от призрачного голоса Вейлора, только злость и ярость, плоть и кровь… он опасен, но в нём нет никакой особой силы, — просто человек, каких ты положил на своём пути множество. — Я увижу тебя склонённым перед судом Сигила и наказанным. Если ты отказываешься, то СКАЖИ мне, и тогда я сам буду судить тебя».~
@56590 = ~Эхо: «Я отказываюсь. Суди меня сам… потом будет моя очередь судить тебя».~
@56591 = ~Отбросить воспоминания и попытаться остаться в настоящем.~
@56592 = ~«Судить МЕНЯ? — глаза Вейлора *вспыхивают*, и он крепче сжимает свой топор, мускулы на его шее и руках напрягаются словно перед ударом, медленно, неотвратимо. — У тебя нет ПРАВА судить меня».~
@56593 = ~Эхо: «Есть, Вейлор, ибо я знаю твоё сердце и моя сила даёт мне право судить. Но я не стану судить тебя сейчас: ты должен отдохнуть в этой клетке до того дня, как я решу, что тебя снова можно выпустить прогуляться по планам».~
@56594 = ~Отбросить воспоминания и попытаться остаться в настоящем.~
@56595 = ~Когда твоя инкарнация произносит слово «клетка», взгляд Вейлора внезапно перемещается с тебя на окружающие стены — это стены камеры тюрьмы Керста, где ты нашёл его, только много лет назад. *Много* лет назад — достаточно долго, чтобы человек умер множеством смертей. Или, возможно, только одной.~
@56596 = ~Эхо: «До этого момента я избегал встречи с тобой, Вейлор… почему, думаешь, я согласился встретиться с тобой именно *здесь*? Ты думал, я собираюсь сдаться? Или собираюсь сразиться с тобой? Нет… это город-врата Керст, Вейлор. Он граничит с *тюремным* планом Карцери, где даже *боги* томятся в заключении. Ты могуч, Вейлор, но энергия этого места позволяет заточить здесь даже самое могучее создание планов».~
@56597 = ~Отбросить воспоминания и попытаться остаться в настоящем.~
@56598 = ~Вейлор поворачивается, но часть огня покидает его глаза: «Это *вероломство*».~
@56599 = ~Эхо: «Предательство струится в этих местах, подобно крови в венах, и это предательство дало мне силы для заклинания — вот почему я был вынужден встретиться с тобой здесь, в Керсте. Я могу покинуть эту клетку, Вейлор, но ты останешься здесь, пока я не приду за тобой. Твой поход во славу справедливости поистине поразителен, но он будет забыт, и, возможно, со временем даже справедливость забудет о тебе».~
@56600 = ~Отбросить воспоминания и попытаться остаться в настоящем.~
@56601 = ~«Ты выше отказа в свершения справедливости над собой, но отказываешь моему *походу*…»~
@56602 = ~Эхо: «Я знаю о твоей миссии. Но тебе придётся подождать, пока я не закончу *свою* миссию. Уже второй раз ты находишь меня и пытаешься судить. Я не позволю случиться этому в третий раз».~
@56603 = ~Отбросить воспоминания и попытаться остаться в настоящем.~
@56604 = ~Вейлор ничего не говорит: никогда ещё твои слова не ставили столь убедительную ТОЧКУ. Ты объявил ему чудовищный приговор, приговор, в котором не было ни капли справедливости.~
@56605 = ~Эхо: «Я бессмертен, Вейлор, но ты… необычен. Справедливость *коснулась* тебя, и это может оказаться могущественнее всего, что поддерживает меня. Так что пойми, я не желаю тебе смерти… возможно, когда-нибудь мне понадобится тот, кто сможет меня убить. Вот поэтому ты будешь ждать здесь, пока я не приду за тобой».~
@56606 = ~Эхо: «Я бессмертен, Вейлор, но ты… необычен. Справедливость *коснулась* тебя, и это может оказаться могущественнее всего, что поддерживает меня. Так что пойми, я не желаю тебе смерти… возможно, когда-нибудь мне понадобится тот, кто сможет меня убить. Вот поэтому ты будешь ждать здесь, пока я не приду за тобой».~
@56607 = ~Меня посетило далёкое воспоминание… воспоминание о том, что именно я заточил Вейлора под Керстом. Он пришёл туда в поисках меня, а я уже ждал его там со специально приготовленной клеткой, чтобы Вейлор больше не мог встать на моём пути. Прежде чем ловушка захлопнулась, моя предыдущая инкарнация произнесла странные слова: якобы он верит в то, что Вейлор может обладать силой *убить* меня, пока справедливость направляет его топор. Не знаю почему, но у меня чувство, что это правда. Но почему моя инкарнация просто не убила его? Был ли какой-то смысл оставлять его в живых?~
@56608 = ~Воспоминание темнеет и гаснет, а ты неожиданно снова оказываешься лицом к лицу с призрачным Вейлором, под его бронированным забралом нет плоти — лишь два пылающих янтаря.~
@56609 = ~«Вейлор?..»~
@56610 = ~*Ты будешь СУДИМ.*~
@56611 = ~«Хорошо…»~
@56612 = ~«Хорошо…»~
@56613 = ~«Приправить» любовную жизнь Джульетты.~
@56614 = ~Когда пылающий взгляд Вейлора падает на тебя, ты внезапно ощущаешь странное чувство разделённости, словно вышел из своего тела. Слышится тихий шёпот, странное чувство охватывает твой затылок, и вдруг ты понимаешь, что *утверждение* Вейлора о его прозорливости не имеет значения, он увидит только то, что захочешь ТЫ. Ты знаешь, что он купится на самую простую уловку: ты для него закрытая книга.~
@56615 = ~Я доставил фальшивое любовное письмо Монтекки. Этим я несколько всколыхнул их отношения с Джульеттой.~
@56616 = ~~
@56617 = ~Я предстал перед Монтекки и потребовал, чтобы он оставил Джульетту мне. Этим я несколько всколыхнул их отношения с Джульеттой.~
@56618 = ~*УБИВАЛ ли ты когда-либо?*~
@56619 = ~Ложь: «Нет».~
@56620 = ~Правда: «Нет».~
@56621 = ~Правда: «Да».~
@56622 = ~Правда: «Да… но это были мои руки, а не мой разум, Вейлор. В одной из своих предыдущих инкарнаций я убил человека по имени Фин Андли из-за знаний, которыми он обладал».~
@56623 = ~Правда: «Вейлор, я думаю, что в ответе за тысячи смертей… может, многие тысячи… на всех планах. Колонна Черепов сказала, что когда я умираю, то кто-то другой умирает вместо меня».~
@56624 = ~«Я не стану отвечать на твои вопросы, Вейлор, и не собираюсь быть объектом твоего суда».~
@56625 = ~*Тот, кто не ОТВЕЧАЕТ СПРАВЕДЛИВОСТИ, будет НАКАЗАН.*~
@56626 = ~«Так действуй, Вейлор, но будь готов умереть второй раз…»~
@56627 = ~«Так действуй, Вейлор, но будь готов умереть второй раз…»~
@56628 = ~«Но я *уже* наказан, Вейлор».~
@56629 = ~«Но я *уже* наказан, Вейлор».~
@56630 = ~Вейлор успокаивается: *Я хочу УСЛЫШАТЬ о твоём наказании.*~
@56631 = ~«Забудь, Вейлор. Я устал от попыток тебе что-то объяснять, лучше уж прибегну к насилию».~
@56632 = ~«Забудь, Вейлор. Я устал от попыток тебе что-то объяснять, лучше уж прибегну к насилию».~
@56633 = ~«С каждой смертью, Вейлор, я теряю память. Не знаю, кто я, не знаю, кем я БЫЛ, и ношу тысячи шрамов на своём теле и душе от ран, которых не могу вспомнить. Смерть отвергает меня, и я не знаю, смогу ли когда-нибудь упокоиться с миром».~
@56634 = ~Вейлор смотрит на тебя, его глаза ярко пылают. Ты чувствуешь такой же *пристальный взгляд*, как и до этого: обнажающий, разрывающий твою кожу, словно Вейлор рассекает тебя им. Ты чувствуешь волну тошноты, прокатывающуюся по всему телу, и чувство *погружения* на этот раз гораздо сильнее… пока твоё зрение не заволакивается темнотой…~
@56635 = ~*Ты был НАКАЗАН. На тебе знак ПРАВОСУДИЯ. Я ВИЖУ его на твоей ПЛОТИ.*~
@56636 = ~«Тогда…»~
@56637 = ~*ЗНАЙ: МНОГОЕ в тебе НЕЛЬЗЯ увидеть. Я буду НАБЛЮДАТЬ за тобой. Ты был НАКАЗАН. Но это не спасёт тебя от БУДУЩИХ наказаний за те ПРЕСТУПЛЕНИЯ, что ты совершишь.*~
@56638 = ~«Хорошо, Вейлор, будем считать, этот вопрос решён… на время. У меня пара вопросов…»~
@56639 = ~«Тогда здесь наши пути расходятся, Вейлор. Прощай».~
@56640 = ~«Понял, Вейлор. Пойдём дальше».~
@56641 = ~*Совершал ли ты когда-нибудь НЕСПРАВЕДЛИВОСТЬ по отношению к другим?*~
@56642 = ~Ложь: «Нет».~
@56643 = ~Правда: «Нет».~
@56644 = ~Правда: «Да».~
@56645 = ~Правда: «Да… но это были мои руки, а не мой разум, Вейлор. Я был другим человеком, занимавшим это тело».~
@56646 = ~Правда: «Вейлор, я думаю, что в ответе за тысячи смертей… может, многие тысячи… на всех планах. Колонна Черепов сказала, что когда я умираю, то кто-то другой умирает вместо меня. Это величайшая несправедливость, которую я знаю».~
@56647 = ~«Я не стану отвечать на твои вопросы, Вейлор, и не собираюсь быть объектом твоего суда».~
@56648 = ~*Причинял ли ты ВРЕД другим?*~
@56649 = ~Ложь: «Нет. Я никогда не причинял вреда другим во всех своих жизнях».~
@56650 = ~Правда: «Да… многие пострадали от моей руки, Вейлор. Но я был другим человеком, занимавшим это тело».~
@56651 = ~Правда: «Я бросил вызов Госпоже Боли, и она заключила меня в лабиринт».~
@56652 = ~Правда: «Одна из моих предыдущих инкарнаций солгала женщине по имени Дейонарра, что любит её, хотя не любила. Когда он сказал это, она пошла за ним, что привело её к смерти».~
@56653 = ~Правда: «Я считаю, что виновен в смерти Дейонарры, единственной дочери адвоката Янниса».~
@56654 = ~Правда: «Я был виновен в смерти Дейонарры, единственной дочери адвоката Янниса».~
@56655 = ~Правда: «Зная о своём бессмертии, моя предыдущая инкарнация вырвала у воина клятву служить мне до самой моей смерти. Я похитил его жизнь, чтобы он мог служить мне. Его звали Дак'коном».~
@56656 = ~Правда: «Я продал в рабство молодую женщину, Анну».~
@56657 = ~Правда: «Я продал в рабство своего товарища, Дак'кона».~
@56658 = ~Правда: «Я продал в рабство своего товарища, Нордома».~
@56659 = ~Правда: «Одна из моих предыдущих инкарнаций помогла Игнусу овладеть силой, способной причинять вред другим. Это заложило основу его мучений и страданий окружающих».~
@56660 = ~Правда: «Я предал Морте и оставил его в Колонне Черепов».~
@56661 = ~Правда: «Я исказил саму суть мультивселенной… я позволил опасному созданию, Коаксметалу, освободиться из осадной башни».~
@56662 = ~Правда: «Я выдал Фьюлла Колонне Черепов ради собственной выгоды».~
@56663 = ~Правда: «Я причинил вред тебе, Вейлор. Именно я заточил тебя под Керстом».~
@56664 = ~«Я не стану отвечать на твои вопросы, Вейлор, и не собираюсь быть объектом твоего суда».~
@56665 = ~*Ты ПРИЗНАЛ свои преступления.* — глаза Вейлора пылают под шлемом, и ты чувствуешь резкие проблески чудовищной силы, скрывающейся под этими призрачными доспехами. — *ВИНОВНЫЙ должен быть НАКАЗАН.*~
@56666 = ~«Так действуй, Вейлор, но будь готов умереть второй раз…»~
@56667 = ~«Так действуй, Вейлор, но будь готов умереть второй раз…»~
@56668 = ~«Но я *уже* наказан, Вейлор».~
@56669 = ~«Но я *уже* наказан, Вейлор».~
@56670 = ~Вейлор смотрит на тебя, его глаза ярко пылают. Ты чувствуешь такой же *пристальный взгляд*, как и до этого: обнажающий, разрывающий твою кожу, словно Вейлор рассекает тебя им. Ты чувствуешь волну тошноты, прокатывающуюся по всему телу, и чувство *погружения* на этот раз гораздо сильнее… пока твоё зрение не заволакивается темнотой…~
@56671 = ~*ЗНАЙ: МНОГОЕ в тебе НЕЛЬЗЯ увидеть. Я буду НАБЛЮДАТЬ за тобой. Ты не СКРОЕШЬСЯ от наказания за те ПРЕСТУПЛЕНИЯ, которые совершишь.*~
@56672 = ~«Хорошо, Вейлор, будем считать, этот вопрос решён… на время. У меня пара вопросов…»~
@56673 = ~«Тогда здесь наши пути расходятся, Вейлор. Прощай».~
@56674 = ~«Понял, Вейлор. Пойдём дальше».~
@56675 = ~Твои слова порождают эхо, с каждым звуком набирая мощь. Едва ты их произносишь, огонь в янтарных глазах Вейлора мерцает, а затем угасает. Его доспехи рассыпаются, топор и металлические пластины с грохотом рушатся на пол. Упав на землю, железяки поднимают тучу пыли, от них летит пепел и хлопья вековой ржавчины, и на твоих глазах всё распадается в прах. Всё, что остаётся, — несколько насквозь проржавевших листов металла, единственное надгробие, напоминающее о существовании Вейлора.~
@56676 = ~«Покойся с миром, Вейлор».~
@56677 = ~Я убедил Вейлора, что он более не жив. Мои слова возымели на него мощное действие — столь мощное, что он буквально умер передо мной второй раз: его доспехи с топором рассыпались в пыль, и он исчез как «сдавшийся призрак».~
@56678 = ~Глаза Анны сужаются: «Те лучше убрать свои слепые зенки от меня, дух! Мне от тебя ничё не нада, так что отвали».~
@56679 = ~Когда взгляд Вейлора падает на Анну, она вздрагивает, словно её ошпарили: «Не, дух, никаких дел с твоими вопросами, понял?»~
@56680 = ~«Ага? И чего это за правосудие ТАКОЕ, а?! Твоя справедливость — не МОЯ справедливость, она пустая, как и твои гремящие железяки! Намылился вершить СВОЮ справедливость, а сам даже самого себя судить не можешь?!»~
@56681 = ~«О, правда? Ну, ты-то со своими *Убийцами Милосердия* вздёрнул много моих друзей на лысых древьях, когда справедливость в башку ударяла! Гори в пламени Баатора, ты, грёбаная полумёртвая хрень. И пусть силы отольют на твою железную башку, и она заржавеет! Желаю, чтоб тя со всей твоей бронёй отправили в Кузницу, чтоб всё там переплавилось и ни кусочка не осталось!»~
@56682 = ~Анна выглядит доведённой до отчаяния: «Нет, ничего подобного. Теперь отвали от меня, дьявол тя дери!»~
@56683 = ~«Я знаю о справедливости, Вейлор. Я сдерживаю её мудростью и опытом, и когда справедливость умерена этими двумя истинами, она становится *сильнее*. Я знаю о милосердии с прощением и также знаю, что без них планы бы оказались гораздо более жестоким местом».~
@56684 = ~Найти и вернуть «личный аромат» Вивьен.~
@56685 = ~Я согласился помочь Вивьен, одной из проституток в Борделе Безумной Интеллектуальной Страсти, найти её «личный аромат». Она сказала, что я распознаю его, когда почувствую запах.~
@56686 = ~Я вернул Вивьен её «личный аромат».~
@56687 = ~Найти и вернуть Мариссе её малиновую вуаль.~
@56688 = ~«Нет, Вейлор. Они — инструменты, с помощью которых душа другого может быть спасена, возвышена и укреплена. Таким образом укрепляется *мультивселенная*. Здесь таится то совершенство, о котором ты говоришь».~
@56689 = ~Падшая Грейс втягивается в спор: «*Так ли*, Вейлор? Тогда *суди* меня своим взором, ищи во мне недостатки. Проверь, сможешь ли ты обнаружить слабости, которые, по твоим словам, одолевают моё сердце».~
@56690 = ~«В этом наши мнения расходятся, Вейлор».~
@56691 = ~«Вейлор, я хочу тебя спросить кое о ком другом».~
@56692 = ~«Хватит, Вейлор. У меня другие вопросы…»~
@56693 = ~«Здесь наши пути расходятся, Вейлор. Прощай».~
@56694 = ~«Неважно, Вейлор. Продолжим путь».~
@56695 = ~«Заканчивай свой допрос, Вейлор, — слова Падшей Грейс звучат без малейшего намёка на угрозу, но тем не менее кажутся опасными. — Это не суд, и ты не устроишь над ней процесс в моём присутствии. Оставь её в покое».~
@56696 = ~«Чтобы это сделать, Вейлор, тебе придётся пройти сквозь меня. Я не позволю тебе причинить ей вред».~
@56697 = ~Зубы Ингресс~
@56698 = ~Оставить женщину в покое.~
@56699 = ~Она внимательно рассматривает тебя, прежде чем ответить. Говорит она медленно и осторожно, избегая встречаться с тобой глазами: «Я, Эльвин, отвечаю на твоё приветствие».~
@56700 = ~«Эльвин? Тебя ищет твоя подруга Немель».~
@56701 = ~«Ты кого-то ищешь?»~
@56702 = ~«У меня кое-какие вопросы…»~
@56703 = ~«Мне пора идти. Прощай».~
@56704 = ~Я нашёл Эльвин и сказал ей, что её ищет Немель.~
@56705 = ~Она было расцветает улыбкой, но затем прикрывает рот рукой и опускает взгляд на свой напиток: «Я, Эльвин, очень рада слышать вести о Немель. Могу я, Эльвин, попросить тебя рассказать ей об этом месте?»~
@56706 = ~«Да, я ей расскажу».~
@56707 = ~«Я не мальчик на побегушках во имя благотворительности. Тебе придётся мне заплатить».~
@56708 = ~«Я подумаю. У меня ещё вопросы…»~
@56709 = ~«Возможно, позже. Прощай».~
@56710 = ~Я согласился вернуться к Немель и рассказать, где её подруга Эльвин.~
@56711 = ~Она смотрит на тебя в упор, и — всего лишь на мгновение, прежде чем она снова опускает глаза на свой напиток — тебя омывает тёплым приятным чувством, чистым счастьем. «Я, Эльвин, благодарю тебя».~
@56712 = ~«Рад буду помочь. Могу я спросить тебя о ней?»~
@56713 = ~«Конечно. Прощай».~
@56714 = ~Эльвин молча кивает.~
@56715 = ~«То, как она говорит, и то, что делают её слова… как?»~
@56716 = ~«Вообще-то неважно. Прощай».~
@56717 = ~«Я, Эльвин, могу сказать лишь только то, что мы пришли из другого места, из другого мира. Мы не такие, как люди здесь, чьи слова, мысли, даже чувства не воздействуют напрямую».~
@56718 = ~«Продолжай…»~
@56719 = ~«Послушаю об этом позже. До встречи».~
@56720 = ~«Я, Эльвин, очень осторожничаю, чтобы не влиять на окружающих слишком сильно. Немель — она новенькая здесь, и не может так осторожничать. Этому ей придётся научиться, если она пожелает остаться здесь дольше».~
@56721 = ~«Но зачем?»~
@56722 = ~«Тому много причин. Я, Эльвин, считаю, что не в праве навязывать действительность тем, кто не в состоянии навязывать свою действительность мне, Эльвин».~
@56723 = ~~
@56724 = ~«Ясно. Прощай».~
@56725 = ~«Есть что-нибудь, чего ты не можешь сделать, просто говоря о нём?»~
@56726 = ~«Я понимаю. Прощай».~
@56727 = ~Она хмурится; странное, неприятное ощущение охватывает твой желудок. «Пожалуйста… я, Эльвин, не хочу говорить об этом».~
@56728 = ~«Просто ещё один вопрос…»~
@56729 = ~«Хорошо. До встречи, Эльвин».~
@56730 = ~Она смотрит на тебя в упор, твоё лицо отражается в её золотых зрачках: «Он больше не будет говорить об этом с Эльвин, а значит, больше не сможет принудить её говорить с ним таким образом». Ты обнаруживаешь, что не можешь произнести ни слова… твои слова застревают в глотке, едва ты хочешь что-то спросить.~
@56731 = ~«Ну и ладно. Прощай».~
@56732 = ~Она кивает: «Я, Эльвин, понимаю. Ты Чующий?»~
@56733 = ~«Да».~
@56734 = ~«Нет».~
@56735 = ~Она качает головой: «Тогда я, Эльвин, не могу вознаградить тебя».~
@56736 = ~«Ладно, расскажу ей и без вознаграждения».~
@56737 = ~«Тогда прощай».~
@56738 = ~Я воссоединил голову Мертвина с его телом; обе части выглядят весьма счастливыми.~
@56739 = ~«Я, Эльвин, не кажусь тебе знакомой?»~
@56740 = ~«Нет. А должна?»~
@56741 = ~«Нет, не кажешься».~
@56742 = ~«Это неважно. До встречи».~
@56743 = ~«Как я, Эльвин, и думала. Память человека для него потеряна».~
@56744 = ~«Что ты хочешь сказать? Ты знаешь, кто я?»~
@56745 = ~«Может, ты и права. До встречи».~
@56746 = ~«Я, Эльвин, встречала тебя раньше и расскажу об этой встрече, если ты мне поможешь».~
@56747 = ~«Тогда я помогу».~
@56748 = ~«Нет, спасибо. Прощай».~
@56749 = ~Я нашёл на Площади Мусорщиков непроходимую, забитую мусором арку. Следы ведут прямо в неё и не возвращаются, так что сквозь неё должен быть проход… возможно, кто-нибудь на Площади и знает о нём.~
@56750 = ~Женщина качает головой, её малиновые волосы отражают свет и развеваются подобно языкам пламени: «У меня, Эльвин, нет ответов, незнакомец. Тебе лучше поискать их где-нибудь ещё».~
@56751 = ~«Говоришь, ты Эльвин? Тебя ищет твоя подруга Немель».~
@56752 = ~«Ты кого-то ищешь?»~
@56753 = ~«Тогда прощай…»~
@56754 = ~У меня получилось открыть додекаэдр, полный ловушек, и он оказался чем-то вроде книги или дневника. Однако я не могу разобрать странный язык, на котором он написан… возможно, мне стоит попросить помощи какого-нибудь филолога или лингвиста в Фестхолле.~
@56755 = ~Она кивает, задумчиво глядя в бокал: «Немель — вот её имя, моей подруги. Я, Эльвин, волнуюсь за неё в этом месте и желаю знать, почему она до сих пор не пришла на встречу со мной, Эльвин».~
@56756 = ~«Я помогу тебе найти твою подругу».~
@56757 = ~«Я найду её для тебя. Не бесплатно, конечно».~
@56758 = ~«Надеюсь, ты её найдёшь. Прощай».~
@56759 = ~Я согласился найти некую Немель для встреченной женщины по имени Эльвин.~
@56760 = ~«Ты это сделаешь?» — она отрывает взгляд от бокала, улыбается, и тебя внезапно переполняют чувства надежды и радостной благодарности. Увидев твою реакцию, она прикрывает рот и снова опускает глаза… и чувства стихают. «Я, Эльвин, благодарю».~
@56761 = ~«Что… что это было?»~
@56762 = ~«Конечно. Как она выглядит?»~
@56763 = ~«Было что, добрый незнакомец? — она прикусывает свою губку. — Я, Эльвин, не знаю, о чём ты говоришь».~
@56764 = ~«Ладно. Как выглядит Немель?»~
@56765 = ~«Так же, как и я, Эльвин, только с чёрными волосами и ярко-фиолетовыми глазами».~
@56766 = ~«Тогда я скажу ей, что ты ждёшь её здесь. До встречи».~
@56767 = ~Она кивает: «Я, Эльвин, понимаю. Ты Чующий?»~
@56768 = ~«Да».~
@56769 = ~«Нет».~
@56770 = ~Она качает головой: «Тогда я, Эльвин, не могу вознаградить тебя».~
@56771 = ~«Ладно, поищу её и без вознаграждения».~
@56772 = ~«Тогда прощай».~
@56773 = ~Я изучил таинственный язык уйо — наречие, на котором моя прежняя инкарнация написала свой дневник и спрятала в головоломке-додекаэдре.~
@56774 = ~«Я, Эльвин, не кажусь тебе знакомой?»~
@56775 = ~«Нет. А должна?»~
@56776 = ~«Нет, не кажешься».~
@56777 = ~«Это неважно. До встречи».~
@56778 = ~«Как я, Эльвин, и думала. Память человека для него потеряна».~
@56779 = ~«Что ты хочешь сказать? Ты знаешь, кто я?»~
@56780 = ~«Может, ты и права. До встречи».~
@56781 = ~«Как я, Эльвин, и думала. Память человека для него потеряна».~
@56782 = ~«Я, Эльвин, встречала тебя раньше и расскажу об этой встрече, если ты мне поможешь».~
@56783 = ~«Тогда я помогу».~
@56784 = ~«Нет, спасибо. Прощай».~
@56785 = ~Выучить язык, используемый в головоломке-додекаэдре.~
@56786 = ~Она смотрит на тебя в упор, и — всего лишь на мгновение, прежде чем она снова опускает глаза на свой напиток — тебя омывает тёплым приятным чувством, чистым счастьем. «Я, Эльвин, благодарю тебя».~
@56787 = ~«Что… что это было?»~
@56788 = ~«Конечно. Как она выглядит?»~
@56789 = ~Эльвин поднимает взгляд от бокала и коротко тебя приветствует: «Я, Эльвин, снова встретилась с тобой, незнакомец. Чего ты хочешь?»~
@56790 = ~«Тебя ищет твоя подруга Немель».~
@56791 = ~«Ты кого-то ищешь?»~
@56792 = ~«У меня кое-какие вопросы…»~
@56793 = ~«Мне пора идти. Прощай».~
@56794 = ~Кви-Сай отказался тренировать меня на воина, сославшись на преимущества воров над воинами. Он посоветовал мне учиться на вора у наставника воров Фестхолла или, если я не хочу становиться карманником, поговорить с наставником воров и найти контраргумент словам Кви-Сая.~
@56795 = ~Эльвин поднимает взгляд от бокала и коротко тебя приветствует: «Я, Эльвин, с нетерпением жду новостей о Немель. Ты нашёл её, незнакомец?»~
@56796 = ~«Да, я её нашёл».~
@56797 = ~«Ещё нет. Так на кого она похожа?»~
@56798 = ~«Нет, ещё нет. Вернусь, когда найду. До встречи».~
@56799 = ~Я сказал Эльвин, что нашёл для неё Немель.~
@56800 = ~Эльвин поднимает взгляд от бокала и коротко тебя приветствует: «Я, Эльвин, всё ещё жду появления Немель. Ты не передал ей сообщение?»~
@56801 = ~«Нет, ещё нет. Но я передам, что ты её здесь ждёшь».~
@56802 = ~Эльвин складывает руки и склоняет голову в знак благодарности, слёзы радости капают из её золотых глаз. Но едва твои собственные глаза начинают увлажняться, как она вытирает слёзы и улыбается, вызывая волну мощного чувства радости, омывающую всё твоё тело. «Эльвин *поблагодарила* незнакомца! Она воссоединилась с дорогой подругой, Немель!»~
@56803 = ~«Рад был помочь».~
@56804 = ~«Рад был помочь».~
@56805 = ~«Конечно. Теперь расскажи мне о нашей предыдущей встрече».~
@56806 = ~Она кивает, потом снова опускает взор, ощущения от её улыбки проходят, оставляя лишь приятные воспоминания.~
@56807 = ~«Каким образом ты и Немель воздействуете на мои чувства и эмоции?»~
@56808 = ~«Мне пора идти».~
@56809 = ~Она кивает, потом снова опускает взор, ощущения от её улыбки проходят, оставляя лишь приятные воспоминания. «Я, Эльвин, теперь кое-что расскажу тебе, незнакомец».~
@56810 = ~«Да? Продолжай…»~
@56811 = ~«Может, в другой раз. Прощай».~
@56812 = ~Женщина по имени Эльвин рассказала мне, что я был — а может, и до сих пор являюсь — членом Общества Восприятия, Чующим…~
@56813 = ~«Имя, которое я, Эльвин, выбрала для тебя, — „незнакомец“ — не очень подходящее. Ты и я, Эльвин, уже встречались… в Фестхолле. В месте, куда бы ты не мог попасть, не будь ты сам Чующим. Помнишь или нет, но если только ты не предал Общество Восприятия в какой-то момент, ты Чующий».~
@56814 = ~«Ясно… продолжай».~
@56815 = ~«Дослушаю в следующий раз. До встречи».~
@56816 = ~Она кивает: «Ты и я, Эльвин, встречались в двух разных обстоятельствах. Первый раз это произошло не меньше двух столетий назад, вторая встреча была гораздо позже. Возможно, не больше пятидесяти лет назад».~
@56817 = ~«Это довольно давно…»~
@56818 = ~«Дослушаю в следующий раз. До встречи».~
@56819 = ~Она снова кивает. «Мой народ живёт очень долго, Забывчивый, — она несчастно вздыхает, вызывая у тебя озноб. — Ты казался другим человеком тогда… меньше жестокости, меньше шрамов. Таким жадным до всего, что может показать тебе мультивселенная. Ты тогда очаровал меня, Эльвин, и почти стал моим любовником… но потом ты исчез».~
@56820 = ~«Куда-то отправился?»~
@56821 = ~«Дослушаю в следующий раз. До встречи».~
@56822 = ~«Мне, Эльвин, сказали, что ты был повержен… убит, — на мгновение она поднимает взгляд, чтобы с любопытством заглянуть тебе в глаза. — После этого я видела тебя лишь раз».~
@56823 = ~«Я вспомнил тебя?»~
@56824 = ~«Дослушаю в следующий раз. До встречи».~
@56825 = ~«Нет, — она печально качает головой, потом касается своего горла. — Нет, не вспомнил. Ты набросился на меня, Эльвин, пытался задушить меня. С криком, что я, Эльвин, не смогу тебя одурачить, не заманю и не убью тебя…»~
@56826 = ~«Как это случилось?»~
@56827 = ~«Дослушаю в следующий раз. До встречи».~
@56828 = ~«Мы встретились в одной из северных башен Фестхолла, на седьмом этаже. Пока ты не вытряс из меня жизнь, я, Эльвин, использовала свою силу, чтобы выбросить тебя из окна… и ты разбился. Когда я, Эльвин, наконец вышла посмотреть на твоё разбитое тело, тебя там уже не было…»~
@56829 = ~«Что-что ты сделала?»~
@56830 = ~«Ясно…»~
@56831 = ~«Это вся история, что я, Эльвин, могу тебе рассказать. Когда-то мы не были незнакомцами, но теперь стали ими. До встречи, незнакомец. И пусть удача улыбается тебе в твоих странствиях».~
@56832 = ~«Спасибо, Эльвин. Прощай».~
@56833 = ~Эльвин поднимает взгляд от бокала и коротко тебя приветствует: «Я, Эльвин, снова встретилась с незнакомцем и приветствую его».~
@56834 = ~«Расскажи ещё раз, как мы встречались, Эльвин».~
@56835 = ~«У меня кое-какие вопросы…»~
@56836 = ~«Я просто проходил мимо. Прощай».~
@56837 = ~Женщина рычит на тебя, её золотые глаза вспыхивают горящими звёздами чистой ненависти. «Ты дурак! Как ты смел напасть на дочь Асахарма! Ты пёс… — она прищуривается, глядя на тебя, — …и как пёс ты умрёшь!» Затем она холодно смотрит на тебя, потягивая вино из бокала.~
@56838 = ~«А?..»~
@56839 = ~Игнорировать её слова и напасть.~
@56840 = ~Ты сгибаешься к земле, воя в агонии… твои внутренности скручивает, и ты выплёвываешь огромные сгустки чёрной, дымящейся крови. Наконец ты, сотрясаясь, валишься на камни улицы, последние признаки жизни покидают твоё тело…~
@56841 = ~Погрузиться во тьму…~
@56842 = ~Огромный мужчина смотрит на тебя сверху вниз: «Больше ты не будешь причинять неприятности добрым людям здесь, Мы вышвырнем тебя далеко прочь из этого места». Он вздымает свою руку, и твоё зрение затуманивается, а Фестхолл вокруг тебя будто бы тает…~
@56843 = ~«Что?..»~
@56844 = ~Эбб кивает тебе: «Хорошо поработал в Керсте, приятель».~
@56845 = ~«Спасибо, Эбб. Без тебя я бы не справился. До встречи».~
@56846 = ~«Спасибо, Эбб. Нелёгкое, однако, выдалось путешествие. До встречи».~
@56847 = ~Эбб кивает тебе: «Хорошо поработал в Керсте, приятель».~
@56848 = ~Эбб кивает тебе: «Хорошо там поработал, приятель». Он утыкается носом в свою выпивку.~
@56849 = ~Эбб подмигивает тебе, когда ты подходишь, и возвращается к своей выпивке.~
@56850 = ~«Спасибо. Прощай».~
@56851 = ~«Я тоже рад тебя видеть снова».~
@56852 = ~Ты видишь слегка сгорбившегося старика с окладистой седой бородой и львиной гривой седеющих волос. В качестве доспехов на него надеты два наплечника, а в руках он держит шлем. Он курит трубку, мешочек с табаком привязан к его запястью. Старик выглядит очень сильным, но чуток полноватым и к тому же, похоже, немного мучается одышкой. Судя по всему, он глава собравшейся здесь группы. «Приветствую, здоровяк! Пожалуй, лучше бы тебе объяснить, что ты тут делаешь».~
@56853 = ~«Просто заглянул проверить, что здесь».~
@56854 = ~«А что здесь делаешь *ты*?»~
@56855 = ~«В городе полная неразбериха. Я ищу союзников, чтобы навести порядок».~
@56856 = ~«Кто ты?»~
@56857 = ~«Я уже ухожу…»~
@56858 = ~Ты видишь Эбба Скрипучие Колени. Облако дыма окутывает его улыбающуюся физиономию, когда он приветствует тебя: «Будь принят хаосом, путник. Что привело тебя в эти края?»~
@56859 = ~«Просто заглянул проверить, что здесь».~
@56860 = ~«А что здесь делаешь *ты*?»~
@56861 = ~«В городе полная неразбериха. Я ищу союзников, чтобы навести порядок».~
@56862 = ~«Я уже ухожу…»~
@56863 = ~Ты видишь слегка сгорбившегося старика с окладистой седой бородой и львиной гривой седеющих волос. В качестве доспехов на него надеты два наплечника, а в руках он держит шлем. Он курит трубку, мешочек с табаком привязан к его запястью. Старик выглядит очень сильным, но чуток полноватым и к тому же, похоже, немного мучается одышкой. Судя по всему, он глава собравшейся здесь группы. «Рад встрече, товарищ. Мы собрались здесь под знаком Анархии».~
@56864 = ~«Что ты тут делаешь?»~
@56865 = ~«В городе полная неразбериха. Я ищу союзников, чтобы навести порядок».~
@56866 = ~«Кто ты?»~
@56867 = ~«Рад встрече! — Эбб смеётся. — Мы снова встретились, под знаком Анархии!»~
@56868 = ~«Что привело сюда *тебя*? И почему ты говоришь об анархии?»~
@56869 = ~«Мне нужна помощь, Эбб».~
@56870 = ~Ты видишь слегка сгорбившегося старика с окладистой седой бородой и львиной гривой седеющих волос. В качестве доспехов на него надеты два наплечника, а в руках он держит шлем. Он курит трубку, мешочек с табаком привязан к его запястью. Старик выглядит очень сильным, но чуток полноватым и к тому же, похоже, немного мучается одышкой. Судя по всему, он глава собравшейся здесь группы. Он подзывает тебя к себе.~
@56871 = ~Подойти к нему.~
@56872 = ~Отказаться.~
@56873 = ~Эбб подмигивает тебе и машет, чтобы ты подошёл ближе: «Ты прошёл длинный и тяжёлый путь, здоровяк, но я здесь, чтобы его облегчить. Ты со мной?»~
@56874 = ~«Что ты делаешь в компании Анархистов, Эбб? Я думал, ты был в Гармониуме».~
@56875 = ~«Расскажи подробнее».~
@56876 = ~«Нет. Иди к дьяволу».~
@56877 = ~Он склоняется настолько низко, насколько ему позволяет пузо: «Как видишь… склад полон заговорщиков и интриганов. С падением старого порядка здесь мы должны быть уверены, что все его остатки выметены прочь и люди готовы взглянуть в лицо новой свободе. Мы опасная группа, знаешь ли».~
@56878 = ~«Вряд ли люди ощутят свободу сполна, если их разорвут на части чудовища, свирепствующие в городе».~
@56879 = ~«Ты уверен, что нашёл для этого наилучшее время?»~
@56880 = ~«Не столь опасная, как я. Давайте-ка я вам покажу». Напасть на них.~
@56881 = ~«В этом городе больше не будет хаоса».~
@56882 = ~«Ну так мы интригуем и строим заговоры, друг мой. С падением порядка в городе мы получили… уникальную… возможность обеспечить, что наши идеи будут услышаны. И я в ответе за эту маленькую банду приключенцев — конечно, только как командир!»~
@56883 = ~*Глупость — это знак СЛАБОСТИ. Нет НЕСПРАВЕДЛИВОСТИ в том, что ищущий преимуществ ЛИШАЕТСЯ их.*~
@56884 = ~«Что именно вы затеваете?»~
@56885 = ~«Что ты имеешь в виду?»~
@56886 = ~«Ты ищешь союзников против хаоса? Но мы стремимся усилить хаос, чтобы сбросить старый порядок, убедиться, что старая система не поднимется снова. В конце концов, это наша миссия…»~
@56887 = ~«Это может быть тем, к чему мы стремимся, но мы не поддерживаем разрушения во имя разрушения. Мы разрушаем, чтобы другие могли восстановить. А от Керста ничего не останется, если сохранится подобный порядок вещей».~
@56888 = ~«К чему усиливать хаос? Город и так уже в Карцери, и сейчас его жители гибнут».~
@56889 = ~«Значит, моя миссия — остановить вас. Приготовься к смерти».~
@56890 = ~«Друг мой, я — Эбб Скрипучие Колени, бывшая Третья Ступень Гармониума, а сейчас временный лидер этой ячейки Революционной Лиги. Я здесь, чтобы натаскать их и заставить город скинуть с себя старые порядки».~
@56891 = ~«Старые порядки и так уже один пустой звук».~
@56892 = ~*СПРАВЕДЛИВОСТЬ настигает и ИЗВЕРГОВ.*~
@56893 = ~«Вы Анархисты? Тогда вас нужно остановить».~
@56894 = ~«Да. Пошли».~
@56895 = ~Я нашёл Фьюлла Двуличного, «доброжелательного» изверга. Похоже, он связан каким-то соглашением, заключённым с Триасом, которого называет Триас Предатель. Теперь он вынужден делать добрые дела, помогать тем, кто нуждается в помощи. И он явно не очень-то от этого счастлив.~
@56896 = ~«И что ты собираешься делать с городом?»~
@56897 = ~«В таком случае я просто ухожу».~
@56898 = ~«Уходишь? Ах, друг мой, но ты не можешь. Понимаешь, мы не можем позволить тебе уйти теперь, когда ты видел наши лица».~
@56899 = ~«Что ты имеешь в виду?»~
@56900 = ~«Интересно посмотреть на ваши попытки остановить меня».~
@56901 = ~Его внешняя самоуверенность на секунду пропадает: «Что ты хочешь сказать?»~
@56902 = ~«Я хочу сказать, что пока вы тут играли в заговоры и строили планы по свержению городского правительства, зло явилось в Керст и сейчас разрушает то, что ещё осталось от города».~
@56903 = ~«Но… мы должны что-то сделать! Вся наша работа пропадёт зря, если все будут мертвы! Вот. Возьми это, — он оборачивается к своим собратьям: — Мы должны идти, или всё наше дело погибнет! Вперёд!» Он устремляется к двери.~
@56904 = ~~
@56905 = ~«Когда люди видят, что их лидеры предали их, то весьма велики шансы, что они сокрушат старую власть и построят на её обломках нечто новое, нечто прекрасное. Мы собираемся им помочь».~
@56906 = ~«А, так вы собираетесь помочь сражаться с извергами, да?»~
@56907 = ~«Как вы собираетесь создать что-то прекрасное из этого?»~
@56908 = ~«Что именно ты хочешь сказать?»~
@56909 = ~«Я хочу сказать, что пока вы тут играли в заговоры и строили планы по свержению городского правительства, зло явилось в Керст и сейчас разрушает то, что ещё осталось от города».~
@56910 = ~«Момент кажется несколько неподходящим».~
@56911 = ~«Друг, хаос — освобождающая сила этого города. После соскальзывания в Карцери это явно одна из основ веры города».~
@56912 = ~«Да, и без зла, похоже, тоже не обошлось. Нам нужно вытащить город отсюда, прежде чем мы все умрём».~
@56913 = ~«Значит ты поддерживаешь то, что здесь происходит?»~
@56914 = ~«Друг, мне не доставляет ни малейшего удовольствия так поступать… но если я должен… нам необходимо убедиться, что город не вернётся под власть прежних коррумпированных бюрократов, — он машет рукой своим заговорщикам. — Взять их».~
@56915 = ~«Зачем ты это делаешь? Неужели ты не видишь, что городу приходит конец? И это не речевой оборот».~
@56916 = ~Драться.~
@56917 = ~Он нетерпеливо вздыхает: «Суть в том, что если отсечь от города коррупцию, подобно гнили от яблока, то из этого может вырасти нечто новое, нечто прекрасное. Считай это пожаром в городской администрации. Хе-хе».~
@56918 = ~«Пожары имеют обыкновение распространяться».~
@56919 = ~«Так ты поддерживаешь то, что здесь происходит?»~
@56920 = ~«Несомненно, приятель. Несомненно».~
@56921 = ~«Тогда нам больше нечего друг другу сказать. Прощай».~
@56922 = ~«Тогда мне придётся убить вас, чтобы вернуть Керст на его естественное место».~
@56923 = ~Он склоняется ближе, чтобы прошептать тебе на ухо: «Я знаю, кто ты для Революционной Лиги. Я знаю, что ты стал доносчиком на Анархистов. Я внедрился в их организацию для Гармониума и работаю против них изнутри. Нам нужно вернуть этот город назад во Внешние Земли. Ты со мной?»~
@56924 = ~«Да».~
@56925 = ~«Не в этой жизни».~
@56926 = ~«Ну так слушай меня. Мы проверим этих анархистских ублюдков в деле, да? Скажи мне, что город наводняют изверги. Но сделай это громко, чтобы они слышали».~
@56927 = ~~
@56928 = ~«Хорошо, — ты повышаешь голос: — Пока вы тут сидите и строите заговоры, как бы обеспечить здешнему народу лучшую жизнь, город наводняют изверги! Если вы и вправду хотите завоевать их сердца, то покажите, как вы о них заботитесь. Это будет хорошим началом. Идите и спасите их».~
@56929 = ~Эбб подмигивает тебе, суёт в руку свиток, потом выпрямляется, чтобы остальные анархисты могли видеть его лицо. «Но… мы должны что-то сделать! Вся наша работа пропадёт зря, если все будут мертвы! — он оборачивается к своим собратьям: — Мы должны идти, или всё наше дело погибнет! Вперёд!» Он устремляется к двери.~
@56930 = ~«Удачи…»~
@56931 = ~«Тогда ты не оставляешь мне выбора. Если ты не часть решения, то ты часть проблемы». Он оборачивается к своим сопартийцам: «Он предаст нас, едва ему выпадет шанс. Взять его».~
@56932 = ~Драться.~
@56933 = ~Он склоняется ещё ближе — вонь его горящей трубки усиливается — и шепчет: «Я под прикрытием. Тройной агент. Агент Гармониума, проникший к Анархистам, прикидывающийся двойным агентом Гармониума. Приходится быть даже более неискренним, чем эти пни, чтобы во всё это влезть… и я по-прежнему не знаю, раскрыта ли моя игра. Итак… собираешься ли ты помочь мне помочь тебе?»~
@56934 = ~«И что нужно сделать?»~
@56935 = ~«Я не могу этого сделать».~
@56936 = ~«Этот парень крут *везде*!»~
@56937 = ~«Да, но он тоже нам помог. Пошли».~
@56938 = ~Охранник окидывает тебя взглядом скучающих полуприкрытых глаз. «Если хошь воспользоваться воротами, здоровяк, тебе к Барру… — он кивает на Барра, стоящего у ворот, — …если нет, так отвали от меня, ясно?» Он отводит взгляд.~
@56939 = ~Уйти.~
@56940 = ~Охранник, зевая, оглядывает тебя. «Надеюсь, тебе не пришло в голову воспользоваться воротами, пень… после смерти Барра никто не знает, как эта хрень работает», — он отворачивается.~
@56941 = ~Уйти.~
@56942 = ~«Кто ты?»~
@56943 = ~«Что ты здесь делаешь?»~
@56944 = ~Ты видишь робкого мужчину с невинным лицом и льющимися по щекам слезами. Его зажало под повозкой, и она, похоже, медленно выдавливает из него жизнь. Глаза мужчины, наполненные болью, обращаются к тебе: «Пожалуйста, друг… ты должен снять с меня эту штуку. Я не могу умереть здесь…»~
@56945 = ~«Хорошо. Сейчас я сниму её».~
@56946 = ~«Забудь об этом».~
@56947 = ~Ты видишь Беррога Быстроногого, несостоявшегося спасителя дэва, зажатого под повозкой со сломанной осью. «Пожалуйста, друг… ты должен снять с меня эту штуку».~
@56948 = ~«Хорошо. Сейчас я сниму её».~
@56949 = ~«Забудь об этом».~
@56950 = ~При твоём приближении охранник прищуривается, но ничего не говорит.~
@56951 = ~Пустой узел~
@56952 = ~Пустой узел~
@56953 = ~«Что за этой аркой?»~
@56954 = ~«Стража. Они ищут меня. Думаю, я кого-то обидел вопросом или сказал кому-то что-то не то. Я просто высказывал своё мнение, но оно, кажется, кому-то не понравилось. Здесь всё коррумпировано!»~
@56955 = ~«Что за этой аркой?»~
@56956 = ~«Так кто же ты такой?»~
@56957 = ~«Что ты здесь делаешь?»~
@56958 = ~«Откуда ты?»~
@56959 = ~Игнорировать его и пройти мимо.~
@56960 = ~«Тогда иди».~
@56961 = ~«Фарод и его двор, здоровяк. Следи за собой и за своим языком, он как всегда в скверном настроении».~
@56962 = ~«Я Беррог Быстроногий, путешественник и улаживатель проблем. Думаю, ты можешь назвать меня вором, но я предпочитаю называть себя инженером: ловушки, головоломки и всё такое. Я использую свои умения только во благо — ненавижу кому-либо вредить. Думаю, здесь устройства используют для других целей», — он содрогается.~
@56963 = ~«Спасибо. Прощай».~
@56964 = ~«Теперь почти ничего. Даже и не знаю, зачем я всё ещё тут стою», — он пожимает плечами.~
@56965 = ~«Что ты здесь делаешь?»~
@56966 = ~«Кто хочет тебя убить?»~
@56967 = ~«Прощай».~
@56968 = ~«Тогда иди».~
@56969 = ~«Я явился в Керст, так как услышал, что здесь заключён дэв, а поскольку у меня есть друзья-архоны на горе Селестии, я подумал, что ему нужно помочь. Однако этот город… это место — просто выгребная яма, и я не могу никому здесь верить! Как люди могут так жить? Мне нужно убираться отсюда!»~
@56970 = ~«Расскажи мне о горе Селестии».~
@56971 = ~«Так кто же ты такой?»~
@56972 = ~«Кто хочет тебя убить?»~
@56973 = ~«Тогда иди».~
@56974 = ~Его глаза заволакивает дымка мечтательности: «Там всё имеет своё место и все вещи прекрасны. Армады крылатых архонов реют в небесах такими совершенными узорами, что могут разбить твоё сердце. Фрукты там вырастают больше, игры длятся дольше, и все дома открыты. Однако мы постоянно прилагаем усилия, чтобы улучшить себя, проверяя свои добродетели и всё ближе приближаясь к доброте. Я должен вернуться домой как можно скорее…»~
@56975 = ~«Так кто же ты такой?»~
@56976 = ~«Что ты здесь делаешь?»~
@56977 = ~«Кто хочет тебя убить?»~
@56978 = ~«Тогда иди».~
@56979 = ~Он смотрит на тебя с недоверием в глазах. «Спасибо! Больше мы не увидимся!» — он уносится прочь.~
@56980 = ~«Прощай».~
@56981 = ~«Погоди!.. Тот… тот приятель с другой стороны всё ещё в ловушке?»~
@56982 = ~«Он всё ещё там».~
@56983 = ~«Он уже умер».~
@56984 = ~«Наконец-то мы нашли тебя, беглец! Теперь ты вернешься в нежные объятия крепости Лорда Бела и подвергнешься его исправлениям».~
@56985 = ~«Ты предал меня! Ты погубил меня!»~
@56986 = ~«Мы вернем твой дух обратно в Авернус и это доставит нам удовольствие, Адвокат Инферно. Подчиненные, взять его».~
@56987 = ~«Пфе! Вы пожалеете, что напали на меня!»~
@56988 = ~«Пожалеем? У меня нет сожалений, Адвокат. Однако твои сожаления будут слышны сквозь вечность».~
@56989 = ~«Вы не оставляете мне другого выбора, кроме как защищаться!»~
@56990 = ~«Приветик, Сарос!»~
@56991 = ~«Сарос, мой любимый!»~
@56992 = ~«Пожалуйста… пожалуйста…» — он утыкается лицом в грязь и тихонько плачет.~
@56993 = ~Уйти.~
@56994 = ~Убить его.~
@56995 = ~«Тебе… тебе нужно найти способ спасти и его. Лучше его, чем меня. Я думаю, он был мэром этого города… или как это тут называется».~
@56996 = ~«Тогда поднимай, друг…»~
@56997 = ~Поднять повозку.~
@56998 = ~«Забудь. Может быть, я вернусь позже».~
@56999 = ~Беррог выползает, когда ты приподнимаешь повозку: «Мои благодарности, друг. Я… сыт этим городом по горло. Возвращаюсь на гору Селестию. Надеюсь, твой добрый поступок сослужит тебе… добрую службу, куда бы ты ни отправился, — он смотрит на дэва, стоящего на балконе. — Не могу поверить, что я явился сюда увидеть… это».~
@57000 = ~«Благие намерения и такой результат. Прощай».~
@57001 = ~«А-а-ай! Кто там с другой стороны? Ты убиваешь меня!»~
@57002 = ~«Кто ты?»~
@57003 = ~«Что ты там делаешь?»~
@57004 = ~Продолжить поднимать: «Очень жаль».~
@57005 = ~«Моё имя… Беррог Быстроногий… я пришёл в Керст освободить дэва… создание добра… но меня ввели в заблуждение. Не стоило мне приходить…»~
@57006 = ~«Что ты там делаешь?»~
@57007 = ~Приподнять повозку над бюргером: «Пожалуй, не стоило».~
@57008 = ~Приподнять повозку над Беррогом.~
@57009 = ~«Наверное, лучше мне вернуться позже… До встречи».~
@57010 = ~«Я… бежал из города… когда он начал соскальзывать. Я был около… него… и он схватил меня. С неба падала повозка, и он попытался толкнуть меня под неё… а сам хотел убежать. Но я по-прежнему прошу тебя… найти способ освободить и его».~
@57011 = ~~
@57012 = ~«Ты ничего не выгадаешь, освободив меня… это я признаю. Но, разумеется… в океан добра добавится капля… если ты спасёшь меня, не думая о выгоде… но лучше спаси нас обоих».~
@57013 = ~Приподнять повозку над бюргером: «Да, но он полезнее».~
@57014 = ~Приподнять повозку над Беррогом: «Он того не стоит».~
@57015 = ~«А что, если я подниму повозку над вами обоими? Мы с товарищами сможем это сделать, если возьмёмся все вместе».~
@57016 = ~«Попробую что-нибудь придумать. До встречи».~
@57017 = ~Ты видишь старого гитцерай, зажатого под колёсами повозки, упавшей на него во время сумятицы. Он сплёвывает кровью и усмехается тебе. «Не собираешься мне помочь, нет? Такое в первую очередь и привело нас к сюда…» — он слабо смеётся.~
@57018 = ~«Кто ты?»~
@57019 = ~«Кто ты?»~
@57020 = ~«Успокойся. Я тебя вытащу».~
@57021 = ~«Успокойся. Я тебя вытащу».~
@57022 = ~«Нет».~
@57023 = ~«Нет».~
@57024 = ~Гитцерай снова кашляет: «Явился, чтобы опять посмеяться надо мной? Я не доставлю тебе такого удовольствия».~
@57025 = ~«Кто ты?»~
@57026 = ~«Кто ты?»~
@57027 = ~«Успокойся. Я тебя вытащу».~
@57028 = ~«Успокойся. Я тебя вытащу».~
@57029 = ~«Я ухожу».~
@57030 = ~«Я ухожу».~
@57031 = ~«Да, убери свой клинок, *зертский* пёс. Я плюю на ваше учение. Носите свои цепи и дальше, — гитцерай оборачивается к тебе. — Я — Товус Гильяф. Я был бюргером этого города… пока проклятый дэв не вырвался на свободу».~
@57032 = ~«Что ты можешь рассказать о дэве?»~
@57033 = ~«Ты был бюргером?»~
@57034 = ~«Не могу сказать, что мне очень нравится твой город».~
@57035 = ~«Сейчас я тебя освобожу».~
@57036 = ~«В таком случае я оставлю тебя умирать. Прощай».~
@57037 = ~~
@57038 = ~«Да, убей меня, *зертский* пёс. Делай, как приказал тебе хозяин», — старый гитцерай хихикает, сплёвывая кровью, пока клинок Дак'кона не рассекает ему горло.~
@57039 = ~«Хороший удар, Дак'кон».~
@57040 = ~«Я — Товус Гильяф. Я был бюргером этого города… пока проклятый дэв не вырвался на свободу».~
@57041 = ~«Что ты можешь рассказать о дэве?»~
@57042 = ~«Ты был бюргером?»~
@57043 = ~«Не могу сказать, что мне очень нравится твой город».~
@57044 = ~«Сейчас я тебя освобожу».~
@57045 = ~«В таком случае я оставлю тебя умирать. Прощай».~
@57046 = ~Его тонкие губы сжимаются ещё сильнее: «Тогда поднимай, дьявол тебя дери, и закончим с этим».~
@57047 = ~«Приступим».~
@57048 = ~«Забудь. Может быть, я приду позже».~
@57049 = ~«Тогда я проклинаю тебя, человек в шрамах. Да падёт на тебя бубонная чума», — он плюёт в тебя кровью, но промахивается.~
@57050 = ~«Счастливо оставаться».~
@57051 = ~Ты налегаешь на повозку всем весом и ухитряешься приподнять её настолько, что у него получается выползти из-под неё.

«Благодарю… человек. Я отправляюсь на стены помогать своей страже. Мой город не погибнет. — он одаряет тебя кривой улыбкой. — А вот тебе не позавидуешь из-за конфликта с дэвом. Он грозный противник. Вот, возьми. Это может тебе пригодиться».~
@57052 = ~«Прощай».~
@57053 = ~«Мы заточили его очень много лет назад. Я думал, он надёжно спрятан от всех скулящих псов и предателей. Внезапно он вырвался из-под земли, весь сверкая, и мой прекрасный, прекрасный дом… соскользнул, — он пристально смотрит на тебя. — Я ещё поквитаюсь за это. Освободишь меня, а?»~
@57054 = ~«Хорошо. Приготовься».~
@57055 = ~«Ты был бюргером этого города?»~
@57056 = ~«Нет, я так не думаю».~
@57057 = ~«Мои товарищи… и я… мы использовали этот город как базу, чтобы вернуться к власти… но это уже совсем другая история. Освободи меня!»~
@57058 = ~«Хорошо. Приготовься».~
@57059 = ~«Что ты можешь рассказать о дэве?»~
@57060 = ~«Нет, я так не думаю».~
@57061 = ~«Да и мне не особо… но он мой, и видеть его в руках этого самодовольного, лицемерного дэва… это больше, чем я могу вынести, — он влажно кашляет. — Освободи меня, и я помогу тебе отомстить ему. Мои стражники на некоторое время сдержат чудовищ».~
@57062 = ~«Хорошо. Приготовься».~
@57063 = ~«Что ты можешь рассказать о дэве?»~
@57064 = ~«Нет, я так не думаю».~
@57065 = ~Ты видишь старого гитцерай, зажатого под колёсами повозки, упавшей на него во время сумятицы. Он сплёвывает кровью и усмехается тебе. «Не собираешься мне помочь, нет? Такое в первую очередь и привело нас к сюда…» — он слабо смеётся.~
@57066 = ~«Кто ты?»~
@57067 = ~«Кто ты?»~
@57068 = ~«Успокойся. Я тебя вытащу».~
@57069 = ~«Успокойся. Я тебя вытащу».~
@57070 = ~«Нет».~
@57071 = ~«Нет».~
@57072 = ~Гитцерай снова кроваво кашляет: «Явился, чтобы опять посмеяться надо мной? Я не доставлю тебе такого удовольствия».~
@57073 = ~«Кто ты?»~
@57074 = ~«Кто ты?»~
@57075 = ~«Успокойся. Я тебя вытащу».~
@57076 = ~«Успокойся. Я тебя вытащу».~
@57077 = ~«Я ухожу».~
@57078 = ~«Я ухожу».~
@57079 = ~«Да, убери свой клинок, *зертский* пёс. Я плюю на ваше учение. Носите свои цепи и дальше, — гитцерай оборачивается к тебе. — Я — Товус Гильяф. Я был бюргером этого города… пока проклятый дэв не вырвался на свободу».~
@57080 = ~«Что ты можешь рассказать о дэве?»~
@57081 = ~«Ты был бюргером?»~
@57082 = ~«Не могу сказать, что мне очень нравится твой город».~
@57083 = ~«Сейчас я тебя освобожу».~
@57084 = ~«В таком случае я оставлю тебя умирать. Прощай».~
@57085 = ~«Да, убей меня, *зертский* пёс. Делай, как приказал тебе хозяин», — старый гитцерай хихикает, сплёвывая кровью, пока клинок Дак'кона не рассекает ему горло.~
@57086 = ~«Хороший удар, Дак'кон».~
@57087 = ~«Я — Товус Гильяф. Я был бюргером этого города… пока проклятый дэв не вырвался на свободу».~
@57088 = ~«Что ты можешь рассказать о дэве?»~
@57089 = ~«Ты был бюргером?»~
@57090 = ~«Не могу сказать, что мне очень нравится твой город».~
@57091 = ~«Сейчас я тебя освобожу».~
@57092 = ~«В таком случае я оставлю тебя умирать. Прощай».~
@57093 = ~Его тонкие губы сжимаются ещё сильнее: «Тогда поднимай, дьявол тебя дери, и закончим с этим».~
@57094 = ~«Приступим».~
@57095 = ~«Забудь. Может быть, я приду позже».~
@57096 = ~«Тогда я проклинаю тебя, человек в шрамах. Да падёт на тебя бубонная чума», — он плюёт в тебя кровью, но промахивается.~
@57097 = ~«Счастливо оставаться».~
@57098 = ~Ты налегаешь на повозку всем весом и ухитряешься приподнять её настолько, что у него получается выползти из-под неё. С другой стороны повозки раздаётся предсмертный крик, наполненный агонией. «Благодарю… человек. Я отправляюсь на стены помогать своей страже. Мой город не погибнет, — он одаряет тебя кривой улыбкой. — А вот тебе не позавидуешь из-за конфликта с дэвом. Он грозный противник. Вот, возьми. Это может тебе пригодиться».~
@57099 = ~«Прощай».~
@57100 = ~«Мы заточили его очень много лет назад. Я думал, он надёжно спрятан от всех скулящих псов и предателей. Внезапно он вырвался из-под земли, весь сверкая, и мой прекрасный, прекрасный дом… соскользнул, — он пристально смотрит на тебя. — Я ещё поквитаюсь за это. Освободишь меня, а?»~
@57101 = ~«Хорошо. Приготовься».~
@57102 = ~«Ты был бюргером этого города?»~
@57103 = ~«Нет, я так не думаю».~
@57104 = ~«Мои товарищи… и я… мы использовали этот город как базу, чтобы вернуться к власти… но это уже совсем другая история. Освободи меня!»~
@57105 = ~«Хорошо. Приготовься».~
@57106 = ~«Что ты можешь рассказать о дэве?»~
@57107 = ~«Нет, я так не думаю».~
@57108 = ~«Да и мне не особо… но он мой, и видеть его в руках этого самодовольного, лицемерного дэва… это больше, чем я могу вынести, — он влажно кашляет. — Освободи меня, и я помогу тебе отомстить ему. Мои стражники на некоторое время сдержат чудовищ».~
@57109 = ~«Хорошо. Приготовься».~
@57110 = ~«Что ты можешь рассказать о дэве?»~
@57111 = ~«Нет, я так не думаю».~
@57112 = ~Едва ты собираешься приподнять повозку, как с другой стороны раздаётся душераздирающий крик…~
@57113 = ~«Ты убиваешь меня, дурак! Тебе не поднять повозку без того, чтобы не раздавить одного из нас, поэтому сразу тебе говорю, давить выгоднее его!»~
@57114 = ~«Почему это?»~
@57115 = ~«В таком случае мне следует помочь ему. Похоже, ты являешься частью того зла, что пригвоздило этот город к Карцери».~
@57116 = ~«А что, если я подниму повозку над вами обоими? Мы с товарищами сможем это сделать, если возьмёмся все вместе».~
@57117 = ~«Тогда я вернусь позже, когда всё обдумаю».~
@57118 = ~«Я всё ещё командую стражей Керста… могу вдохновить их, поддержать, помочь сдержать волну чудовищ, которые стоят между тобой и дэвом… освободи меня, и решение твоих проблем облегчится. Освободишь его — и ты ничего не выгадаешь».~
@57119 = ~«Это всё… дэв. Этот мелкий воришка здесь ничто по сравнению с дэвом. Освободи меня!»~
@57120 = ~Приподнять повозку, перенеся вес на Беррога: «Хорошо».~
@57121 = ~Приготовиться поднять повозку над Беррогом: «Думаю, я просто освобожу его».~
@57122 = ~«А что, если я подниму повозку над вами обоими? Мы с товарищами сможем это сделать, если возьмёмся все вместе».~
@57123 = ~«Я вернусь позже, когда что-нибудь придумаю».~
@57124 = ~Ты собираешь своих товарищей вокруг повозки, и объединёнными усилиями у вас получается поднять её так, что оба придавленных благополучно из-под неё выбираются.~
@57125 = ~«Благодарю… человек. Я отправляюсь на стены помогать своей страже. Мой город не погибнет, — он одаряет тебя кривой улыбкой. — А вот тебе не позавидуешь из-за конфликта с дэвом. Он грозный противник. Вот, возьми. Это может тебе пригодиться».~
@57126 = ~«Прощай».~
@57127 = ~«Это называется… бюргер, ограниченный дурак», — он переводит взгляд на тебя.~
@57128 = ~«Он — настоящий предатель гитцерай. Он проклял наш народ, — Дак'кон обнажает клинок. — Это достаточная причина для его смерти».~
@57129 = ~«Убери клинок, Дак'кон».~
@57130 = ~«Тогда убей его».~
@57131 = ~«Ты не можешь ему доверять. Позволь ему умереть здесь, под повозкой».~
@57132 = ~«Нет, Дак'кон, мы вытащим его оттуда».~
@57133 = ~«Хорошо. Уходим».~
@57134 = ~«Он — настоящий предатель гитцерай. Он проклял наш народ, — Дак'кон обнажает клинок. — Это достаточная причина для его смерти».~
@57135 = ~«Убери клинок, Дак'кон».~
@57136 = ~«Тогда убей его».~
@57137 = ~«Ты не можешь ему доверять. Позволь ему умереть здесь, под повозкой».~
@57138 = ~«Нет, Дак'кон, мы вытащим его оттуда».~
@57139 = ~«Хорошо. Уходим».~
@57140 = ~Молодая женщина — волосы спутаны, одежда растрёпана — пытается улыбнуться тебе сквозь сдавленные всхлипывания: «Спасибо! Я *так* тебе благодарна! Меня зовут Джасилия. Слушай… сейчас мне надо идти, незнакомец, но я ещё раз благодарю тебя!»~
@57141 = ~«Никаких проблем».~
@57142 = ~Женщина не отрывает от тебя взгляда: «Ты спас меня… спасибо тебе *огромное*! Я была бы мертва или даже хуже, если бы не ты…» Она разводит руки, чтобы тебя обнять.~
@57143 = ~Прижать её и поцеловать.~
@57144 = ~Прижать её и поцеловать.~
@57145 = ~Позволить ей сомкнуть объятия.~
@57146 = ~Отстраниться.~
@57147 = ~Она крепко обнимает тебя, её щека, мокрая от слёз, прижимается к твоей груди. Минуту спустя она отступает и с улыбкой смотрит на тебя: «Мне нужно идти… но позволь ещё раз сказать „спасибо“. Я не забуду твоей доброты. Прощай, странник».~
@57148 = ~«Прощай».~
@57149 = ~Она смущённо краснеет, глядя себе под ноги: «О… я не имела в виду… ну…» Затем снова поднимает на тебя взгляд с улыбкой: «До встречи, незнакомец, я *так* тебе благодарна! Я не забуду твоей доброты».~
@57150 = ~«Конечно. Прощай».~
@57151 = ~Джасилия улыбается твоему появлению, прекращая уборку: «Рада новой встрече, мой грозный спаситель! Снова благодарю тебя. Что я могу для тебя сделать?»~
@57152 = ~«Я ищу, где бы мне переночевать».~
@57153 = ~~
@57154 = ~«Не сейчас. До свидания, Джасилия».~
@57155 = ~Она улыбается тебе: «О… тогда тебе надо поговорить с моим отцом».~
@57156 = ~«Спасибо. До свидания, Джасилия».~
@57157 = ~Едва она обнимает тебя, ты обвиваешь её стан руками и прижимаешь свои губы к её мягким губам.~
@57158 = ~Женщина легонько вздрагивает и мягко высвобождается из твоих объятий. Она выглядит слегка смущённой и нервно улыбается: «Ох… до встречи, незнакомец, и спасибо тебе. Я… я не забуду твоей доброты».~
@57159 = ~«Конечно. Прощай».~
@57160 = ~Едва она обнимает тебя, ты обвиваешь её стан руками и прижимаешь свои губы к её мягким губам. Она легонько вздрагивает и мягко высвобождается из твоих объятий. Она выглядит слегка смущённой и нервно улыбается: «Ох… до встречи, незнакомец, и спасибо тебе. Я… я не забуду твоей доброты».~
@57161 = ~«Конечно. Прощай».~
@57162 = ~Анна закатывает глаза и выдаёт кислое *Хмпф*.~
@57163 = ~«Прощай».~
@57164 = ~Анна фыркает: «Тьфу! Чего б те не улечься с ней прям *тут*, на улице, что те мешает?»~
@57165 = ~«Приветствую».~
@57166 = ~Не обращать на него внимания.~
@57167 = ~Создание продолжает глазеть на тебя, его взгляд неподвижен. Наконец ты ощущаешь проникновение в свой разум и слышишь в голове голос: «И я тебя приветствую, человек. Я Агрил-Шанак. Зачем ты здесь?»~
@57168 = ~«У меня вопросы…»~
@57169 = ~«Неважно. Мне пора идти, прощай».~
@57170 = ~«Вопросы… это позабавит меня. Можешь спрашивать».~
@57171 = ~«Кто ты?»~
@57172 = ~«Что ты здесь делаешь?»~
@57173 = ~«Что ты можешь рассказать о Керсте?»~
@57174 = ~«Что ты можешь сказать о Донне Квишо?»~
@57175 = ~«Меня послала Донна Квишо, чтобы освободить тебя. Что я за это получу?»~
@57176 = ~«Меня послала Донна Квишо, чтобы освободить тебя. Как мне это сделать?»~
@57177 = ~«Как уже сказал, я Агрил-Шанак. Что ещё тебе надо знать?»~
@57178 = ~«Кто ты такой?»~
@57179 = ~«У меня другие вопросы…»~
@57180 = ~«Мне пора идти. Прощай».~
@57181 = ~«Некоторые зовут меня извергом… некоторые — другом. Я Агрил-Шанак. Танар'ри. Я достиг своего положения тяжёлой работой, предательствами, кровью и страхом. Я — создание ночного кошмара», — он умолкает.~
@57182 = ~«Кто называет тебя извергом?»~
@57183 = ~«Кто называет тебя другом?»~
@57184 = ~«У меня другие вопросы…»~
@57185 = ~«Мне пора идти. Прощай».~
@57186 = ~«Те, кто жаждут власти, часто видят во мне средство достижения цели. Они называют меня другом».~
@57187 = ~«Кто называет тебя извергом?»~
@57188 = ~«Очень туманный ответ…»~
@57189 = ~«У меня другие вопросы…»~
@57190 = ~«Мне пора идти. Прощай».~
@57191 = ~«Примитивы, кто не в состоянии заглянуть за страх и предубеждения. Их ограниченность заставляет их называть меня так».~
@57192 = ~«Кто называет тебя другом?»~
@57193 = ~«Очень туманный ответ…»~
@57194 = ~«У меня другие вопросы…»~
@57195 = ~«Мне пора идти. Прощай».~
@57196 = ~«О, но всё же это ответ, — он склоняется к тебе. — Единственный ответ, который ты от меня получишь…»~
@57197 = ~«У меня другие вопросы…»~
@57198 = ~«Мне пора идти. Прощай».~
@57199 = ~«Ожидаю своей свободы. Возможно, её мне принёс ты? У тебя свиток…» — он указывает когтистым пальцем на пергамент, который тебе дала Донна Квишо.~
@57200 = ~«Как ты оказался заключённым здесь?»~
@57201 = ~«У меня другие вопросы…»~
@57202 = ~«Мне пора идти. Прощай».~
@57203 = ~«Не знаю… — следует длинная пауза, затем он продолжает: — Я был призван и ответил на зов. Но более мощная сила перехватила меня, и я оказался здесь. С тех пор я в ловушке».~
@57204 = ~«Кто тебя призвал?»~
@57205 = ~«Кто тебя перехватил?»~
@57206 = ~«Ясно. У меня другие вопросы…»~
@57207 = ~«Мне пора идти. Прощай».~
@57208 = ~«Ты знаешь ответ, в твоей руке свиток. Это была Донна Квишо».~
@57209 = ~«Кто тебя перехватил?»~
@57210 = ~«Ясно. У меня другие вопросы…»~
@57211 = ~«Мне пора идти. Прощай».~
@57212 = ~«Я не знаю… пленивший меня не раскрыл своего присутствия».~
@57213 = ~«Кто тебя призвал?»~
@57214 = ~«Ясно. У меня другие вопросы…»~
@57215 = ~«Мне пора идти. Прощай».~
@57216 = ~Ты слышишь внутри головы смех: «Я не местный… мои слова на тему Керста будут ничем не обоснованы. Для меня это тюрьма, не более того».~
@57217 = ~«Ясно. У меня другие вопросы…»~
@57218 = ~«Мне пора идти. Прощай».~
@57219 = ~«Я ничего о ней не знаю, кроме того, что она меня призвала… но это ты уже знаешь, раз держишь свиток…» — он указывает когтистым пальцем на полученный от Донны Квишо пергамент.~
@57220 = ~«Зачем она тебя призвала?»~
@57221 = ~«Ясно. У меня другие вопросы…»~
@57222 = ~«Мне пора идти. Прощай».~
@57223 = ~«Не знаю. Меня перехватили ещё до прибытия. Мы так и не поговорили…» — он умолкает.~
@57224 = ~«Кто тебя перехватил?»~
@57225 = ~«Ясно. У меня другие вопросы…»~
@57226 = ~«Мне пора идти. Прощай».~
@57227 = ~«Моя благодарность не будет знать пределов. Я принесу к твоим ногам сами планы… освободи меня!»~
@57228 = ~«Мне нужно что-нибудь более весомое, чем слова… если ты не можешь ничего предоставить, то я просто уйду».~
@57229 = ~«Хорошо… — ты чувствуешь, как он впивается в тебя взглядом, задумавшись. — Я одарю тебя магическим оружием, оружием великой силы, оружием, что повергнет твоих врагов на колени. Я дарую тебе Рубильщик сердец!»~
@57230 = ~«Рубильщик сердец?»~
@57231 = ~«Да… дорогое для меня оружие, но я готов им пожертвовать ради свободы. Что скажешь? Ты освободишь меня в обмен на Рубильщик сердец?»~
@57232 = ~«Да, скажи мне как».~
@57233 = ~«Нет, я так не думаю».~
@57234 = ~«Я подумаю. До свидания».~
@57235 = ~Изверг указывает на вершину пентаграммы: «Просто разрушь схему, стерев небольшую её часть…» Он выжидающе сверлит тебя взглядом.~
@57236 = ~Разрушить пентаграмму.~
@57237 = ~«Нет, я так не думаю».~
@57238 = ~«Я подумаю, до встречи».~
@57239 = ~Ты наклоняешься, касаешься схемы, и волна энергии окатывает твои руки. Быстрым движением ты стираешь часть пентаграммы. Так же быстро энергия исчезает, и ты слышишь в голове торжествующий вопль: «Наконец-то свободен!»~
@57240 = ~«Теперь я заберу Рубильщик сердец».~
@57241 = ~«Да… я выполню наш уговор, человек. Оружие твоё, а свобода — моя. Честная сделка…» — мгновение он свирепо смотрит на тебя, затем в его руке появляется ржавый топор. Он протягивает топор тебе: «Выглядит убого… но он могущественный».~
@57242 = ~Взять топор.~
@57243 = ~«Ты оказал мне великую услугу, и в благодарность я не убью тебя, — он указывает на тебя когтистым пальцем. — Однако знай. Если мы когда-либо снова встретимся, то ты проклянёшь тот день. Прощай».~
@57244 = ~~
@57245 = ~«Ты играешь со мной… если не намерен даровать мне свободу, то убирайся!»~
@57246 = ~Уйти.~
@57247 = ~Ты видишь Агрил-Шанака, глабрезу. «Ты вернулся ко мне, человек. Зачем?»~
@57248 = ~«У меня пара вопросов…»~
@57249 = ~«Я обдумал твоё освобождение».~
@57250 = ~«Неважно, прощай».~
@57251 = ~«И решил освободить?» — изверг не спускает с тебя злобного взгляда.~
@57252 = ~«Да, скажи мне как».~
@57253 = ~«Нет, я так не думаю».~
@57254 = ~«Я ещё подумаю, прощай».~
@57255 = ~Ты видишь огромное, больше пятнадцати футов в высоту, создание. От его массивного торса отходят четыре руки… две из них заканчиваются клешнями, а две другие — когтистыми кистями. Голова напоминает собачью, с острыми клыками и фиолетовыми глазами. Увидев тебя, оно бросается в атаку.~
@57256 = ~Защищаться.~
@57257 = ~Бежать.~
@57258 = ~Ты видишь Агрил-Шанака, глабрезу. «Я предупреждал, что если мы когда-либо снова встретимся, то ты проклянёшь тот день…» — он бросается в атаку.~
@57259 = ~Защищаться.~
@57260 = ~Бежать.~
@57261 = ~«Прощай».~
@57262 = ~Ты видишь грязного мужчину, сгорбленного и побитого возрастом и тьмой. Его сальные прямые волосы ниспадают на плечи, а следящие из-под них глаза расширены от страха. Его пальцы начинают складываться в загадочные символы…~
@57263 = ~«Всё в порядке… я тебя не обижу».~
@57264 = ~Напасть на него, прежде чем он закончит заклинание.~
@57265 = ~Ждать и смотреть, что будет.~
@57266 = ~Отшельник отскакивает от тебя, его руки выписывают в воздухе загадочные фигуры: «Уйди от меня, лютая тва… а, это ты. Чего тебе надо от старого отшельника на этот раз, а?»~
@57267 = ~«Расскажи мне о себе ещё раз».~
@57268 = ~«Расскажи мне об этом месте».~
@57269 = ~«Я ищу дэва».~
@57270 = ~«Ничего. Прощай».~
@57271 = ~«Ах, ещё посетитель, да? Вы что, все хотите напугать старого отшельника до полусмерти? Знаешь, эти туннели — не место, чтобы неожиданно выскакивать. Чего ты хочешь от меня?»~
@57272 = ~«Я ищу дэва».~
@57273 = ~«Что это за место?»~
@57274 = ~«Не твоё дело».~
@57275 = ~«Кто ты?»~
@57276 = ~«Ничего. Прощай».~
@57277 = ~Он шумно вздыхает, прерывается и лихорадочно оглядывается по сторонам: «Я пришёл в Керст, потому что мой бог был изгнан в Карцери. Я следовал за ним, всё ближе и ближе, но в план-тюрьму за ним не пошёл. Я пытаюсь найти способ вызволить его оттуда. Поскольку он сила добра, то вообще не должен там находится, но, наверно, такова уж природа изгнания».~
@57278 = ~«И долго ты уже тут?»~
@57279 = ~«Случаем, не видел где-нибудь поблизости дэва?»~
@57280 = ~«Как бы то ни было, что ты можешь рассказать об этом месте?»~
@57281 = ~«Ты священник? А подлечить меня можешь?»~
@57282 = ~«Спасибо. Прощай».~
@57283 = ~«Это место? Оно кишит чудовищами, преступниками — я не из них — и прочими, кто только и думает, как бы тебя сожрать. Однако здесь всё же безопаснее, чем в городе. По крайней мере здесь ты знаешь, кто есть кто. Туда, наверх? Уволь».~
@57284 = ~«Так что ты здесь делаешь?»~
@57285 = ~«Не видел поблизости дэва?»~
@57286 = ~«Спасибо. Прощай».~
@57287 = ~«Доходили о нём слухи, но самого его этот старый отшельник не видел. Я думал, смогу найти его под землёй, поскольку всё добро запирают здесь, но так и не нашёл. Если получится, я спрошу, не слышал ли он о моём боге, — он хрипит новым вздохом и смотрит вдоль прохода вниз. — Почему-то я чувствую, что он находится к западу отсюда. Но всё равно не могу найти. У него должен быть страж». Он подмигивает тебе.~
@57288 = ~«Что ты можешь рассказать об этом месте?»~
@57289 = ~«Так что ты здесь делаешь?»~
@57290 = ~«Спасибо. Прощай».~
@57291 = ~«Пф! Грубишь такому старому человеку ни за что. Уходи, мерзавец!» — он машет на тебя руками и снова отскакивает прочь в темноту подземелья.~
@57292 = ~«Прощай».~
@57293 = ~«Слишком долго, слишком долго в услужении богу, который был всем, но теперь забыт. Однако я его помню… я найду его, даже если мне веками придётся прятаться от всех здешних монстров. Я найду его», — бормочет он, глядя вдаль.~
@57294 = ~«Спасибо. Прощай».~
@57295 = ~Ты видишь грязного мужчину, сгорбленного и побитого возрастом и тьмой. Его сальные прямые волосы ниспадают на плечи. Он замечает тебя и выпаливает: «Смотритель Кайз сказал, что ты придёшь. Дэв силён, странник, очень силён, и тебе лучше написать завещание, если хочешь встретиться с ним сейчас. Ты можешь ослабить его, снижая хаос в городе… из хаоса он черпает силу».~
@57296 = ~«Откуда ты это знаешь?»~
@57297 = ~«Я всё равно поднимусь».~
@57298 = ~«Убирайся с дороги, старик».~
@57299 = ~Ты видишь грязного мужчину, сгорбленного и побитого возрастом и тьмой. Его сальные прямые волосы ниспадают на плечи. Он замечает тебя и выпаливает: «Смотритель Кайз сказал, что ты придёшь. Дэв всё ещё силён, странник, очень силён, но ты неплохо ослабил его, исправляя положение дел в городе. Ты можешь ослабить его ещё больше, снижая хаос в городе… из хаоса он черпает силу».~
@57300 = ~«Откуда ты это знаешь?»~
@57301 = ~«Я готов встретиться с ним».~
@57302 = ~«Убирайся с дороги, старик».~
@57303 = ~Ты видишь грязного мужчину, сгорбленного и побитого возрастом и тьмой. Его сальные прямые волосы ниспадают на плечи. Он замечает тебя и выпаливает: «Смотритель Кайз сказал, что ты придёшь… дэв силён, странник, но ты проделал немалую работу, успокаивая беспорядки в городе, это ослабило его. Поднимайся и закончи работу».~
@57304 = ~«Откуда ты это знаешь?»~
@57305 = ~«Обязательно. Прощай».~
@57306 = ~Ты видишь старого отшельника из подземелья. Он замечает тебя и выпаливает: «Смотритель Кайз сказал, что ты придёшь. Дэв силён, странник, очень силён, и тебе лучше написать завещание, если хочешь встретиться с ним сейчас. Ты можешь ослабить его, снижая хаос в городе… из хаоса он черпает силу».~
@57307 = ~«Откуда ты это знаешь?»~
@57308 = ~«Я всё равно поднимусь».~
@57309 = ~«Убирайся с дороги, старик».~
@57310 = ~Ты видишь старого отшельника из подземелья. Он замечает тебя и выпаливает: «Смотритель Кайз сказал, что ты придёшь. Дэв всё ещё силён, странник, очень силён, но ты неплохо ослабил его, исправляя положение дел в городе. Ты можешь ослабить его ещё больше, снижая хаос в городе… из хаоса он черпает силу».~
@57311 = ~«Откуда ты это знаешь?»~
@57312 = ~«Я готов встретиться с ним».~
@57313 = ~«Убирайся с дороги, старик».~
@57314 = ~Ты видишь грязного мужчину, сгорбленного и побитого возрастом и тьмой. Его сальные прямые волосы ниспадают на плечи. Он замечает тебя и выпаливает: «Смотритель Кайз сказал, что ты придёшь… дэв силён, странник, но ты проделал немалую работу, успокаивая беспорядки в городе, это ослабило его. Поднимайся и закончи работу».~
@57315 = ~«Откуда ты это знаешь?»~
@57316 = ~«Обязательно. Прощай».~
@57317 = ~Ты видишь грязного мужчину, сгорбленного и побитого возрастом и тьмой. Его сальные прямые волосы ниспадают на плечи. Он замечает тебя и выпаливает: «Смотритель Кайз сказал, что ты придёшь. Ты отлично поработал, ослабляя дэва… хаос в городе спадает, и его планы нарушаются. Поднимайся и заверши начатое».~
@57318 = ~«Я *чувствую* его там, наверху. Прибывающего и убывающего подобно кровавой луне. Я *слышу*, как он зовёт тебя. Он жаждет битвы».~
@57319 = ~«Скоро он получит её, но не сейчас. До встречи».~
@57320 = ~«Тогда он получит её».~
@57321 = ~«Прежде чем ты пойдёшь… примешь ли ты благословение этого старого человека? Оно поможет выстоять против дэва и тех ужасов, с которыми тебе предстоит столкнуться. Хочешь, чтобы я тебя подлечил?»~
@57322 = ~«Нет, спасибо».~
@57323 = ~«Нет. Теперь прочь с дороги».~
@57324 = ~«Да».~
@57325 = ~«Да».~
@57326 = ~Он опускает свою на удивление сильную руку на твою грудь: «Прежде чем ты пойдёшь… примешь ли ты благословение от меня? Хотя твоё лицо в шрамах мне и не нравится, мой долг — удостоверится, что ты готов… ведь это касается не только тебя. Дай я подлечу твои раны».~
@57327 = ~«Мне не нужны твои благословения. Прочь с дороги».~
@57328 = ~«Хорошо».~
@57329 = ~«Хорошо».~
@57330 = ~«Этот мужчина — просто козёл отпущения. Если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нам нужно покончить с этим безумием, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57331 = ~«Вспомни это, когда окровавленный упадёшь к его ногам, — он кривит лицо. — Хотя твои слова причиняют мне боль, но всё же удачи тебе».~
@57332 = ~«Да, спасибо. Прощай».~
@57333 = ~«Этот мужчина — просто козёл отпущения. Если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нам нужно покончить с этим безумием, если мы хотим вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57334 = ~«Тогда думай своей головой. Не проиграй, человек в шрамах», — он кланяется тебе.~
@57335 = ~«Спасибо. Прощай».~
@57336 = ~«Ты не можешь казнить этого мужчину: он всего лишь козёл отпущения. Это *неправильно*. Именно из-за подобных вещей Керст соскользнул в Карцери… и именно это мы должны остановить, чтобы вернуть город-врата обратно во Внешние Земли».~
@57337 = ~~
@57338 = ~Он закрывает глаза, сосредотачивается и говорит: «Позволь мне исцелить твои раны». Затем открывает глаза: «Теперь иди».~
@57339 = ~«Ты не можешь казнить этого мужчину: он всего лишь козёл отпущения. Это *неправильно*. Именно из-за подобных вещей Керст соскользнул в Карцери… и именно это мы должны остановить, чтобы вернуть город-врата обратно во Внешние Земли».~
@57340 = ~«Спасибо».~
@57341 = ~«Убив палача… и тебя, если понадобится».~
@57342 = ~«Кому нужна моя помощь?»~
@57343 = ~«Забудь, я не собираюсь вмешиваться. Прощай».~
@57344 = ~«Мне».~
@57345 = ~Все цвета исчезают с лица судьи: «В-возможно м-мы н-немного поторопились с приговором, Убийца Милосердия. Стража! Освободите этого человека!» Он смиренно улыбается Вейлору: «Благодарю за своевременную помощь, сэр».~
@57346 = ~~
@57347 = ~Брови судьи резко взлетают вверх: «Чт?.. Как ты *смеешь*?! Стража! Взять этого человека. Или убейте его, если понадобится!»~
@57348 = ~Напасть на судью.~
@57349 = ~«Анне».~
@57350 = ~Напасть на стражу.~
@57351 = ~«Морте».~
@57352 = ~Напасть на палача.~
@57353 = ~«*Неправильно?* Уважаемый, ты успел забыть, что я магистрат? Я лично решаю, что в этом городе правильно, а что — нет!»~
@57354 = ~«Но если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нам нужно покончить с этим безумием, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57355 = ~«Дак'кону».~
@57356 = ~«Нордому».~
@57357 = ~«Но если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нам нужно покончить с этим безумием, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57358 = ~«Падшей Грейс».~
@57359 = ~«Но если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нам нужно покончить с этим безумием, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57360 = ~«Игнусу».~
@57361 = ~«Как бы то ни было, вы не казните этого человека».~
@57362 = ~«Вейлору».~
@57363 = ~«Тогда забудь. Прощай».~
@57364 = ~Судья хмурит свои толстые брови, образуя кустистую белую букву «V» между глаз. Он переводит взгляд с тебя на обвиняемого, потом снова на тебя: «Твои убедительные слова одновременно умны и мудры, сэр… и я от лица города благодарю тебя за своевременную помощь. Больше не будет поспешных казней. Стража! Освободите мужчину».~
@57365 = ~«Спасибо. Прощай».~
@57366 = ~«Никому. Но спасибо за благословение. Прощай».~
@57367 = ~«Ну вот. Кто-нибудь ещё ранен?»~
@57368 = ~«Я».~
@57369 = ~«Анна».~
@57370 = ~«Морте».~
@57371 = ~Выбрать тему и посмотреть, сможешь ли ты «победить».~
@57372 = ~«Дак'кон».~
@57373 = ~«Нордом».~
@57374 = ~«Падшая Грейс».~
@57375 = ~«Игнус».~
@57376 = ~«Вейлор».~
@57377 = ~«Никто. Но спасибо за благословение. Прощай».~
@57378 = ~«Опять? И что на этот раз, любезный?»~
@57379 = ~«Этот мужчина — просто козёл отпущения. Если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нам нужно покончить с этим безумием, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57380 = ~«Этот мужчина — просто козёл отпущения. Если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нам нужно покончить с этим безумием, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57381 = ~«Этот мужчина — просто козёл отпущения. Если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нам нужно покончить с этим безумием, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57382 = ~«Ты не можешь казнить этого мужчину: он всего лишь козёл отпущения. Это *неправильно*. Именно из-за подобных вещей Керст соскользнул в Карцери… и именно это мы должны остановить, чтобы вернуть город-врата обратно во Внешние Земли».~
@57383 = ~«Ты не можешь казнить этого мужчину: он всего лишь козёл отпущения. Это *неправильно*. Именно из-за подобных вещей Керст соскользнул в Карцери… и именно это мы должны остановить, чтобы вернуть город-врата обратно во Внешние Земли».~
@57384 = ~«Я не могу позволить этому случиться… вы не казните этого человека».~
@57385 = ~«Ничего. Прощай».~
@57386 = ~При твоём приближении этот коротышка с кислым лицом поднимает брови: «Ты ничего не сможешь здесь изменить, любезный… прекрати меня беспокоить. Я бы посоветовал тебе уйти».~
@57387 = ~Уйти.~
@57388 = ~~
@57389 = ~«Снова? — судья раздражённо вздыхает. — Ты ничего не сможешь здесь изменить, любезный… прекрати меня беспокоить. Я бы посоветовал тебе уйти».~
@57390 = ~Уйти.~
@57391 = ~Внезапно вперёд выходит Вейлор, его глаза пылают: *Это не ПРАВОСУДИЕ, а просто детская НАСМЕШКА над ним. Казни НЕ БУДЕТ, «магистрат»… если только твои действия не вынудят МЕНЯ послужить СПРАВЕДЛИВОСТИ.*~
@57392 = ~*В будущем тебе стоит вести себя более подобающим образом, магистрат. Не позволяй слухам об обратном достичь моих ушей… или я ВЕРНУСЬ за тобой, будь мой путь длиной в тысячи лиг. Стремись сохранить в своём сердце СПРАВЕДЛИВОСТЬ и будешь в безопасности. Прощай.*~
@57393 = ~«Спасибо, Вейлор. Прощай, магистрат».~
@57394 = ~Это громадный мужчина кажется абсолютно безразличным к происходящему вокруг. При твоём появлении он зевает, выковыривая из-под ногтей грязь — или кровь.~
@57395 = ~«Этот мужчина — просто козёл отпущения. Если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нужно положить конец этому безумию, если мы хотим вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57396 = ~«Этот мужчина — просто козёл отпущения. Если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нужно положить конец этому безумию, если мы хотим вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57397 = ~«Этот мужчина — просто козёл отпущения. Если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нужно положить конец этому безумию, если мы хотим вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57398 = ~«Ты не можешь казнить этого мужчину: он всего лишь козёл отпущения. Это *неправильно*. Именно из-за подобных вещей Керст соскользнул в Карцери… и именно это мы должны остановить, чтобы вернуть город-врата обратно во Внешние Земли».~
@57399 = ~«Стой! Я не позволю тебе казнить этого человека».~
@57400 = ~«Не бери в голову. Прощай».~
@57401 = ~Он обрывает твою речь в самом начале: «Говори с судьёй, здоровяк. Говори с судьёй». Затем возвращается к осмотру своих грязных ногтей.~
@57402 = ~«Нет уж, ты *выслушаешь* меня. Я не позволю тебе казнить этого человека».~
@57403 = ~Уйти.~
@57404 = ~Он на мгновение отвлекается от своих ногтей: «Если судья скажет мне казнить его, то я казню… даже если мне придётся переступить через *твой* труп, здоровяк. На твоём месте я бы пошёл и поговорил с судьёй».~
@57405 = ~Уйти.~
@57406 = ~Палач с забрызганными свежей кровью руками окидывает тебя скучающим взглядом: «Всё идёт своим чередом, здоровяк. Что бы ты ни говорил — никакой разницы. Просто уходи».~
@57407 = ~Уйти.~
@57408 = ~«Что здесь происходит?»~
@57409 = ~«Неважно. Прощай».~
@57410 = ~«Великолепная, грязная, кровавая казнь, если всё пойдёт *по-нашему*», — зевака ухмыляется и покачивает бровями.~
@57411 = ~«Что совершил обвиняемый?»~
@57412 = ~«Ясно. Прощай».~
@57413 = ~Особа пожимает плечами. «Кого волнует? Виновен, виновен, виновен, верно? Только так мы увидим, как прольётся кровь!» — и в предвкушении потирает руки.~
@57414 = ~«Вы приговариваете человека к смерти *забавы ради*?»~
@57415 = ~«Верно. Прощай».~
@57416 = ~Зевака закатывает глаза: «Я *никого* не приговариваю, пень. Это работа судьи. Если у тебя с этим проблема — говори с ним. А от меня отвали».~
@57417 = ~Уйти.~
@57418 = ~Эта персона лишь на миг удостаивает тебя раздражённым взглядом: «Просто оставь меня в покое, ладно? Я не буду отвечать на твои вопросы, так что проваливай».~
@57419 = ~Уйти.~
@57420 = ~Дилана~
@57421 = ~Стражник поворачивается при твоём приближении, но не произносит ни слова. Сквозь прорези его шлема ты видишь пустые, равнодушные глаза.~
@57422 = ~«Этот мужчина — просто козёл отпущения. Если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нам нужно покончить с этим безумием, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57423 = ~«Этот мужчина — просто козёл отпущения. Если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нам нужно покончить с этим безумием, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57424 = ~«Этот мужчина — просто козёл отпущения. Если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нам нужно покончить с этим безумием, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@57425 = ~«Нельзя допустить казни этого мужчины: он всего лишь козёл отпущения. Это *неправильно*. Именно из-за подобных вещей Керст соскользнул в Карцери… и именно это мы должны остановить, чтобы вернуть город-врата обратно во Внешние Земли».~
@57426 = ~«Вы не можете допустить казни этого мужчины».~
@57427 = ~«Неважно. Прощай».~
@57428 = ~Стражник просто пожимает плечами.~
@57429 = ~«Тебе всё равно? Разве не видишь, что происходит вокруг?»~
@57430 = ~Уйти.~
@57431 = ~В ответ стражник лениво зевает.~
@57432 = ~«Хорошо… тогда я поговорю с кем-нибудь другим».~
@57433 = ~Уйти.~
@57434 = ~Этот апатичный стражник полностью игнорирует тебя.~
@57435 = ~Уйти.~
@57436 = ~Элдан~
@57437 = ~Кемак~
@57438 = ~Биниан~
@57439 = ~«Игнус… это правда, что ты сжёг аллею Опасных Углов?»~
@57440 = ~«Что ты делал в баре „Горящий труп“?»~
@57441 = ~«Игнус, я говорил с рассказчиком в Улье, и он сказал, что кто-то *научил* тебя этим вещам… кто?»~
@57442 = ~«Игнус, ты уверен, что учителем был я?»~
@57443 = ~«Игнус, о твоём мастерстве в Искусстве… можешь меня чему-нибудь научить?»~
@57444 = ~«Игнус, о твоём мастерстве в Искусстве… я готов страдать, чтобы научиться большему».~
@57445 = ~«Игнус, о твоём мастерстве в Искусстве… я готов страдать, чтобы научиться большему».~
@57446 = ~«Игнус, по поводу этого обучения и страданий, которым я тебя подверг… я сожалею».~
@57447 = ~«Не бери в голову, Игнус. Просто проверял, с нами ли ты ещё… так сказать».~
@57448 = ~«*ХС-С-С'С-С-С!*» Твоё сердце подпрыгивает, когда Игнус возносится в воздух, а из его рта вырываются языки пламени, обвивающие его, как змеи. «*НЕ ГОВОРИТЬ БОЛЬШ-Ш-ШЕ И НЕ ЗАДАВАТЬ ВОПРОС-С-СОВ! Тиш-ш-шина!..*»~
@57449 = ~«Но я желаю поговорить об огне, Игнус, и о горении…»~
@57450 = ~«Но я желаю поговорить об огне, Игнус, и о горении…»~
@57451 = ~«Но я желаю поговорить об огне, Игнус, и о горении…»~
@57452 = ~«Но я желаю поговорить об огне, Игнус, и о горении…»~
@57453 = ~«Ты ответишь на мои вопросы, Игнус. Я освободил тебя и могу снова отправить в ад».~
@57454 = ~«Тогда не обращай внимания…»~
@57455 = ~Ты видишь женщину средних лет, одетую в лохмотья. Она смотрит на тебя с открытой враждебностью.~
@57456 = ~«Приветствую».~
@57457 = ~Не обращать на неё внимания.~
@57458 = ~«Иди на хер, пень. Вали подальше вниз по короткому пути…» — она сверлит тебя взглядом.~
@57459 = ~«У меня пара вопросов…»~
@57460 = ~«Прощай».~
@57461 = ~Она хмурится: «Ты бестолочь или совсем тупой? Сказала же, иди на хер. Срать я хотела на твои вопросы!»~
@57462 = ~«Если просто ответишь на мои вопросы, то я уйду…»~
@57463 = ~«Не нравится мне твой тон. Может, просто вытрясти из тебя ответы?»~
@57464 = ~«Отлично, прощай».~
@57465 = ~Она свирепо смотрит на тебя: «Хер с тобой. Только побыстрей».~
@57466 = ~«Кто ты?»~
@57467 = ~«Что расскажешь об этом месте?»~
@57468 = ~«Я ищу дэва, как понимаю, он тут, внизу».~
@57469 = ~«Прощай».~
@57470 = ~«На кой оно тебе, не понимаю… — она выдерживает паузу. — Дилана».~
@57471 = ~«За что ты здесь?»~
@57472 = ~«Ясно. У меня другие вопросы…»~
@57473 = ~«Прощай».~
@57474 = ~Она вздыхает. «Да провозила в город эль и всякое такое с одним контрабандистом. И как-то ночью нас схватила стража. Он-то откупился, а меня оставил гнить… — она пожимает плечами. — И вот я тут».~
@57475 = ~«Звучит так, словно за ними должок».~
@57476 = ~«Ясно. У меня другие вопросы…»~
@57477 = ~«Прощай».~
@57478 = ~Она улыбается: «Уж точно. Кстати, его зовут Воорша. Столкнёшься с ним — не подставляй спину».~
@57479 = ~«Постараюсь. У меня пара вопросов…»~
@57480 = ~«Спасибо. Прощай».~
@57481 = ~«А что тут свистеть? Тюряга похлеще Баатора. Годами гниёшь в камере и молишься о дне, когда снова увидишь дневной свет».~
@57482 = ~«Ясно. У меня другие вопросы…»~
@57483 = ~«Прощай».~
@57484 = ~Она хмурится в раздумье: «Не, эт вряд ли. Не буду прикидываться, будто знаю тут всех, но уж дэва пропустить трудно. Если б он был в этом кольце — я б знала».~
@57485 = ~«Кольце?»~
@57486 = ~«Ясно. У меня другие вопросы…»~
@57487 = ~«Прощай».~
@57488 = ~«Ага, в тюрьме три кольца: внешнее, центральное и внутреннее. Чем страшнее преступление, тем глубже сажают».~
@57489 = ~«И какое кольцо тут?»~
@57490 = ~«Ясно. У меня другие вопросы…»~
@57491 = ~«Прощай».~
@57492 = ~«Центральное. Похуже внешнего, но и не так хреново, как во внутреннем».~
@57493 = ~«Ясно. У меня ещё вопросы…»~
@57494 = ~«Прощай».~
@57495 = ~Она уже открывает рот для ответа, но потом останавливается: «Ага… ты похож на того, за кем не заржавеет».~
@57496 = ~«Так ты собираешься отвечать на мои вопросы?»~
@57497 = ~«Прощай».~
@57498 = ~Ты видишь Дилану. Нельзя сказать, что она счастлива тебя видеть: «Снова ты… нахера?»~
@57499 = ~«У меня пара вопросов…»~
@57500 = ~Ты видишь юношу, одетого в лохмотья. Он смотрит куда-то вдаль со скучающим выражением лица.~
@57501 = ~«Приветствую».~
@57502 = ~Не обращать на него внимания.~
@57503 = ~Твоё приветствие его пугает, и от неожиданности он подпрыгивает, затем мгновение оглядывает тебя: «Не подкрадывайся так, здоровяк. Я чуть не помер от страха».~
@57504 = ~Он хмурится: «Типа чего?..»~
@57505 = ~«У меня пара вопросов…»~
@57506 = ~«Неважно, прощай».~
@57507 = ~«Кто ты?»~
@57508 = ~«Что можешь рассказать об этом месте?»~
@57509 = ~«Я слышал, где-то тут внизу находится дэв».~
@57510 = ~«Мне нужно идти, прощай».~
@57511 = ~«Ни к чему тебе моё имя, просто задавай свои вопросы и проваливай», — он окидывает тебя вызывающим взглядом.~
@57512 = ~«Ненавижу людей с норовом. Обычно я просто выбиваю из них ответы».~
@57513 = ~«Ладно, у меня другой вопрос…»~
@57514 = ~«Прощай».~
@57515 = ~Он пожимает плечами: «Хорошо, меня зовут Биниан. Теперь счастлив?»~
@57516 = ~«Да, у меня другой вопрос…»~
@57517 = ~«Мне нужно идти, прощай».~
@57518 = ~«Тут просто большая навозная куча, и все здесь: и я, и ты, и все вокруг — просто куски дерьма, отбросы этого города, — он издевательски улыбается. — Вот и всё, что могу сказать».~
@57519 = ~«За что ты здесь?»~
@57520 = ~«У меня другой вопрос…»~
@57521 = ~«Мне нужно идти, прощай».~
@57522 = ~Он пожимает плечами и нервно оглядывается по сторонам: «Кой-чего спёр… а может, и навалял паре ушлёпков там и тут… вот и упекли».~
@57523 = ~«Так ты вор…»~
@57524 = ~«У меня другой вопрос…»~
@57525 = ~«Мне нужно идти, прощай».~
@57526 = ~Он качает головой: «Не-а, бывший вор. Уж год торчу в этой долбаной дыре, какой я теперь вор?..» Он вздыхает и отводит взгляд: «К дьяволу это место, ни ногой сюда больше, эт уж точно».~
@57527 = ~«Ясно. У меня другой вопрос…»~
@57528 = ~«Мне нужно идти, прощай».~
@57529 = ~Он хмурится и смотрит в сторону: «Есть тут один, на месте недавних раскопок. Просто поищи, где копали, там и он будет».~
@57530 = ~«И где это место раскопок?»~
@57531 = ~«Что там раскапывали?»~
@57532 = ~«У меня другой вопрос…»~
@57533 = ~«Мне нужно идти, прощай».~
@57534 = ~Он пожимает плечами. «Никогда там не был, эт куда-то туда, — он неопределённо машет рукой. — Да просто ищи следы раскопок, мимо не пройдёшь».~
@57535 = ~«Что там раскапывали?»~
@57536 = ~«У меня другой вопрос…»~
@57537 = ~«Мне нужно идти, прощай».~
@57538 = ~Он качает головой. «Да ничего. Когда надо расширить тюрьму, стража заставляет нас копать, — он фыркает. — Эт всё часть наказания…»~
@57539 = ~«Где это место раскопок?»~
@57540 = ~«У меня другой вопрос…»~
@57541 = ~«Мне нужно идти, прощай».~
@57542 = ~Ты видишь Биниана, вора: «Опять ты… чего теперь?»~
@57543 = ~«У меня пара вопросов…»~
@57544 = ~«Неважно. Прощай».~
@57545 = ~Ты видишь пожилого мужчину с редкими седыми волосами. Его одежда не новая, но и не лохмотья, какие носят остальные узники. Ты отмечаешь окружающие его книги и свитки. При твоём приближении он поднимает бровь.~
@57546 = ~«Приветствую».~
@57547 = ~Не обращать на него внимания.~
@57548 = ~Он осматривает тебя с головы до ног, потом улыбается. «Хорошо… что тут у нас? Похоже, у тебя неприятности, юноша… — он продолжает изучать тебя. — Что ты хочешь от меня?»~
@57549 = ~«У меня кое-какие вопросы…»~
@57550 = ~«Ничего, прощай».~
@57551 = ~«Я могу оказаться полезным. Задавай свои вопросы», — он улыбается.~
@57552 = ~«Кто ты?»~
@57553 = ~«Что ты можешь рассказать об этом месте?»~
@57554 = ~«Говорят, тут внизу заключён дэв. Что-нибудь об этом знаешь?»~
@57555 = ~«Мне нужно идти, прощай».~
@57556 = ~«Я Элдан. Человек небольшой важности, угодивший сюда в плохие времена…»~
@57557 = ~«За что ты здесь?»~
@57558 = ~«У меня другие вопросы…»~
@57559 = ~«Прощай».~
@57560 = ~Он хмурится: «Работодатель больше не нуждался в моих услугах. Вместо того, чтобы прервать мою службу вместе с моей жизнью, он счёл удобным сгноить меня здесь».~
@57561 = ~«Почему он так поступил?»~
@57562 = ~«У меня другие вопросы…»~
@57563 = ~«Прощай».~
@57564 = ~«Он был вовлечён в сомнительные дела, а я вёл его документацию. Он поместил меня сюда, чтобы тайное оставалось тайным… и чтобы те, кто захочет узнать его секреты, не добрались до меня, — мужчина вздыхает. — Полагаю, это всё же лучше смерти, хотя и ненамного».~
@57565 = ~«У меня другие вопросы…»~
@57566 = ~«Прощай».~
@57567 = ~Он пожимает плечами: «Я не знаю ничего, кроме того факта, что это тюрьма. Я сижу в этой камере с самого своего заключения и не имею ни малейшего желания исследовать это очевидно опасное место».~
@57568 = ~«Ты никогда не покидаешь камеру?»~
@57569 = ~«У меня другие вопросы…»~
@57570 = ~«Прощай».~
@57571 = ~«Нет…» — он отводит взгляд.~
@57572 = ~«У меня другие вопросы…»~
@57573 = ~«Прощай».~
@57574 = ~Мужчина хмурится и вопросительно смотрит на тебя: «Дэв? Даже представить себе не могу… зачем дэву спускаться сюда?» Он пожимает плечами~
@57575 = ~Ты видишь Элдана. Он улыбается твоему появлению: «Ты снова почтил меня своим присутствием. Зачем?»~
@57576 = ~«У меня другие вопросы…»~
@57577 = ~«Прощай».~
@57578 = ~«У меня кое-какие вопросы…»~
@57579 = ~«Неважно, прощай».~
@57580 = ~«*Думаешь, ты можешь с-сковать Игнус-с-са?..* — огонь завивается вокруг Игнуса подобием накидки, затем развевается в стороны, словно хочет тебя приласкать. — *УБИТЬ тебя, обратить в ПЕПЕЛ может Игнус-с-с… пока Игнус-с-с с-с-следует… но угрозы… угрозы С-С-СЕРДЯТ Игнус-с-са…*»~
@57581 = ~«На самом деле, Игнус, ты не можешь остановить меня — ты можешь сжечь меня, но я буду приходить за тобой, пока у тебя не кончатся дрова. Так что хватит угроз…»~
@57582 = ~«Как скажешь… поговорим позже, Игнус».~
@57583 = ~В воздухе раздаётся треск, а Игнус слегка наклоняет голову, словно изучая тебя, потом шипит: «*ОГОНЬ выж-ж-жет из тебя бес-с-смертнос-с-сть… ты уяз-з-звим для моего огня…*»~
@57584 = ~«Может, ты не понимаешь значения бессмертия, Игнус…»~
@57585 = ~«Как ты узнал, что я бессмертен?»~
@57586 = ~«Как скажешь… поговорим позже, Игнус».~
@57587 = ~«*Ты НЕ бес-с-смертен… Игнус-с-с-с может УБИТЬ тебя… раз-з-звеять твой прах-х-х по ветру…*» Ты наблюдаешь, как он разводит руки и начинает отбрасывать волны жара, столь мощные, что тебе приходиться прикрыть глаза. Ты слышишь страшный РЁВ, а воздух потоками устремляется к Игнусу.~
@57588 = ~«Игнус! Прекрати эт…»~
@57589 = ~Едва ты пытаешься прикрикнуть на Игнуса, как волна тепла взрывается, и тебя окатывается чудовищным жаром. Ты чувствуешь, как твоя плоть коптится, потом начинается запекаться и обугливаться, и появляется БОЛЬ… ты сжимаешь зубы и сквозь шум бушующего пламени слышишь, как хохочет Игнус… хохочет потрескивающим смехом…~
@57590 = ~«Игнус!»~
@57591 = ~Игнус почти совсем свихнулся, когда я говорил с ним… Я пережил его раздражение, но он управляет какими-то первичными силами; я думаю, он даже может убить меня… навсегда.~
@57592 = ~Игнус утверждает, что я был его учителем, тем, кто научил его Искусству. Он говорит, что это единственная причина, по которой он подчиняется мне…~
@57593 = ~Ты видишь юношу в дешёвой одежде. На твоё приближение он реагирует грубым жестом.~
@57594 = ~«Приветствую».~
@57595 = ~Не обращать на него внимания.~
@57596 = ~«Возьми кол и засунь его себе, пень», — он зло смотрит на тебя.~
@57597 = ~«У меня вопросы…»~
@57598 = ~«Прощай».~
@57599 = ~«Я и крысиной задницей не поделюсь ради тебя и твоих дебильных вопросов. Сказал же, задвинься и проваливай!»~
@57600 = ~«Боюсь, мне придётся вколотить в тебя хорошие манеры».~
@57601 = ~«Тогда прощай».~
@57602 = ~Он нахально усмехается: «Попробуй, пень. Я здесь потому, что легко шлёпал таких лохов, как ты…»~
@57603 = ~Когда ты выкрикиваешь его имя второй раз, жара спадает. Убрав свои руки от лица, ты видишь, что кожа на них почернела, опалённая огнём Игнуса… а он с жадностью наблюдает за тобой. Ты знаешь лучше, чем кто-либо, что *кем* бы ни был Игнус, какой бы силой он ни обладал, — её огня будет достаточно, чтобы сжечь тебя дотла.~
@57604 = ~«А я здесь по своему собственному желанию. И когда буду готов уйти — я просто уйду».~
@57605 = ~«ХВАТИТ с меня, Игнус… возможно, ты можешь убить меня, а может, и нет. Я хочу проверить это».~
@57606 = ~Напасть на него: «Люблю вызовы…»~
@57607 = ~«Очень хорошо, Игнус. Мы поговорим об этом позже, ты и я…»~
@57608 = ~Твои слова подобны маслу… и ты смотришь, как они заполняют взор Игнуса, разжигая языки пламени. «*Огонь?* — Игнус медленно плывёт вниз, жар вокруг него поднимается, он явно заинтересован. — *Говори… Игнус-с-с будет с-с-слуш-ш-шать…*»~
@57609 = ~«Игнус, что сделало тебя таким?»~
@57610 = ~«Игнус… это правда, что ты сжёг аллею Опасных Углов?»~
@57611 = ~«Прощай».~
@57612 = ~«Что ты делал в баре „Горящий труп“?»~
@57613 = ~«Игнус, я говорил с рассказчиком в Улье, и он сказал, что кто-то *научил* тебя этим вещам… кто?»~
@57614 = ~Минуту он смотрит на тебя, взвешивая твои слова. Ты видишь, как его глаза бегают по твоим многочисленным шрамам, затем перебегают на свои. Потом он нервно сглатывает: «Ты ведь шутишь… нет?» Он ждёт твоего ответа, потом пожимает плечами: «Так чего тебе?»~
@57615 = ~«У меня вопросы…»~
@57616 = ~«Игнус, ты уверен, что учителем был я?»~
@57617 = ~«Неважно, прощай».~
@57618 = ~«Задавай…»~
@57619 = ~«Игнус, о твоём мастерстве в Искусстве… можешь меня чему-нибудь научить?»~
@57620 = ~«Кто ты?»~
@57621 = ~«Что можешь рассказать об этом месте?»~
@57622 = ~«Я ищу дэва. Он должен быть где-то здесь».~
@57623 = ~«Прощай».~
@57624 = ~«Игнус, о твоём мастерстве в Искусстве… я готов страдать, чтобы научиться большему».~
@57625 = ~Он колеблется перед ответом: «Кемак. Хотя все зовут меня просто Кем. Но не то чтоб мне это нравилось».~
@57626 = ~«Почему ты здесь?»~
@57627 = ~«У меня пара вопросов…»~
@57628 = ~«Игнус, о твоём мастерстве в Искусстве… я готов страдать, чтобы научиться большему».~
@57629 = ~«Прощай».~
@57630 = ~«Игнус, по поводу этого обучения и страданий, которым я тебя подверг… я сожалею».~
@57631 = ~«Нажрался как-то ночью да полез в драку. Говорят, будто завалил нескольких придурков… не знаю, ничего не помню», — Кемак пожимает плечами.~
@57632 = ~«Ясно. У меня другой вопрос…»~
@57633 = ~«Обсудим огонь позже, Игнус. Не сейчас».~
@57634 = ~«Прощай».~
@57635 = ~«Я мало знаю. Меня сразу сюда посадили… — он замолкает, задумавшись. — Вроде как тут три кольца: внешнее, центральное и внутреннее. Чем сильнее накосячишь, тем глубже сидишь. Сюда, во внутреннее кольцо, сажают самых опасных».~
@57636 = ~«*Огонь?..* — голос Игнуса потрескивает, словно он заинтересован. — *Говори… Игнус-с-с будет с-с-слуш-ш-шать…*»~
@57637 = ~«Игнус, что сделало тебя таким?»~
@57638 = ~«У меня другой вопрос…»~
@57639 = ~«Игнус… это правда, что ты сжёг аллею Опасных Углов?»~
@57640 = ~«Прощай».~
@57641 = ~«Что ты делал в баре „Горящий труп“?»~
@57642 = ~«Серьёзно? — он смотрит на тебя с удивлением. — Какого хрена тут делать дэву… если только он не совершил чего-то взаправду чудовищного?» Он выжидающе смотрит на тебя.~
@57643 = ~«Игнус, я говорил с рассказчиком в Улье, и он сказал, что кто-то *научил* тебя этим вещам… кто?»~
@57644 = ~«Не знаю. Так ты что-нибудь о нём слышал?»~
@57645 = ~«Игнус, ты уверен, что учителем был я?»~
@57646 = ~«У меня вопрос о другом…»~
@57647 = ~«Прощай».~
@57648 = ~«Игнус, о твоём мастерстве в Искусстве… можешь меня чему-нибудь научить?»~
@57649 = ~Он качает головой: «Нет, ни шиша». Затем озорно улыбается: «Тут я тебе не помощник».~
@57650 = ~«Игнус, о твоём мастерстве в Искусстве… я готов страдать, чтобы научиться большему».~
@57651 = ~«У меня вопрос о другом…»~
@57652 = ~«Прощай».~
@57653 = ~Ты видишь Кемака. Он хмурится при твоём приближении: «Снова ты, как мило. Чего надо?»~
@57654 = ~«Игнус, о твоём мастерстве в Искусстве… я готов страдать, чтобы научиться большему».~
@57655 = ~«У меня кое-какие вопросы…»~
@57656 = ~«Игнус, по поводу этого обучения и страданий, которым я тебя подверг… я сожалею».~
@57657 = ~«Ничего, прощай».~
@57658 = ~«У меня больше нет вопросов… пусть твои сны будут наполнены огнём, Игнус…»~
@57659 = ~«*НЕТ! ГОВОРИ-И-И!* — завывает Игнус, и воздух вокруг снова наполняется жаром. — *ГОВОРИ О ПЛАМЕНИ! ГОВОРИ-И-И О ГОРЕНИИ!*»~
@57660 = ~«Ох… ну ладно. У меня вопросы… об огне…»~
@57661 = ~«Нет, Игнус… поговорим в другой раз! Не сейчас!»~
@57662 = ~«Игнус… *ощущал* ли ты когда-либо строение пламени? Пламени, лижущего грани наколотых дров, покрывающего дерево чернотой, рисующего картины на стенах, сухое потрескивание, запах горящей соломы…»~
@57663 = ~«Игнус… *ощущал* ли ты когда-либо строение пламени? Пламени, лижущего грани наколотых дров, покрывающего дерево чернотой, рисующего картины на стенах, сухое потрескивание, запах горящей соломы…»~
@57664 = ~Игнус воет ужасающим *диким* рёвом и его внезапно окутывает облако огня, он оборачивается к тебе. Его глаза — словно окна в другое МЕСТО. Он поднимает руки, и огонь срывается с его ладоней, подобно длинному кнуту: «*Сейчас-с-с ты С-СГОРИШ-Ш-ШЬ!*»~
@57665 = ~«Игнус, ты *напросился* сам…»~
@57666 = ~Когда ты говоришь, потрескивание пламени вокруг Игнуса стихает, словно прислушиваясь к твоим словам… Выслушав тебя, Игнус успокаивается, пламя в его глазах тускнеет, словно он погружается в воспоминания: «*Дас-с-с-с…*»~
@57667 = ~«Тогда поговорим об этом в другой раз, Игнус… а пока успокойся».~
@57668 = ~«*Таким…* — маленький кусочек плоти Игнуса отваливается, обожжённый огнём. — *Таким… Игнус-с-с вс-с-сегда был…*»~
@57669 = ~«Но… ты выглядишь человеком. Или, по крайней мере, как тот, кто был человеком когда-то».~
@57670 = ~«Я хочу ещё поговорить об огне и горении…»~
@57671 = ~«У меня к тебе другие вопросы…»~
@57672 = ~«Ясно. Мы с тобой поговорим… позже».~
@57673 = ~Игнус вращается, его голова поникает на грудь, тело опускается совсем низко к земле… вокруг него образуется маленький огненный вихрь. «*Вс-с-сё ещ-щ-щё Игнус-с-с-с… вс-с-с-сегда Игнус-с-с-с…*»~
@57674 = ~«Я хочу ещё поговорить о пла…»~
@57675 = ~«Тогда неважно. У меня есть ещё воп…»~
@57676 = ~«Ясно. Ну, хватит ог…»~
@57677 = ~Едва ты открываешь рот, как Игнус оборачивается к тебе и чудовищный жар заставляет тебя проглотить слова. «*У Игнус-с-са могут быть… ИС-С-СКРЫ в теле… вс-с-сегда жаждут вс-с-спыхнуть…*»~
@57678 = ~«„Искры в теле“? Что ты имеешь в виду?»~
@57679 = ~«Я хочу ещё поговорить об огне и горении…»~
@57680 = ~«У меня к тебе другие вопросы…»~
@57681 = ~«Ясно. Мы с тобой поговорим… позже».~
@57682 = ~«*ВС-С-СЕ вещ-щ-щи горят… из-знутри…* — Игнус откидывает голову назад, разводит руки и между ними вьётся огненная спираль. — *Нужно только ЗАЖ-Ж-ЖЕЧЬСЯ пламенем, чтобы стать Игнус-с-сом… так что ТЫ можеш-ш-шь быть… Игнус-с-сом…*»~
@57683 = ~«На самом деле, когда ты пытаешься зажечь огонь в людях, ты обычно убиваешь их, Игнус».~
@57684 = ~«Так… ты говоришь, что теоретически каждый может стать таким, как ты, с правильной… искрой?»~
@57685 = ~«Я хочу ещё поговорить об огне и горении…»~
@57686 = ~«У меня к тебе другие вопросы…»~
@57687 = ~Оставить лезвие в покое.~
@57688 = ~«Ясно. Мы с тобой поговорим… позже».~
@57689 = ~«*Дас-с-с…*» — Игнус «улыбается», наклоняет голову, пепел сыплется с его макушки и исчезает в огненном вихре.~
@57690 = ~«Я хочу ещё поговорить об огне и горении…»~
@57691 = ~«У меня к тебе другие вопросы…»~
@57692 = ~Метал клинка начинает корчиться и пульсировать в твоей руке. Ты почти ощущаешь чувство неприязни, исходящее от клинка. Какую форму он примет?~
@57693 = ~«Ясно. Мы с тобой поговорим… позже».~
@57694 = ~Лицо Игнуса искривляется, плоть в уголке его рта трескается, обугливается и осыпается чёрно-красными кусочками, обнажая кривую ухмылку: «*Дас-с-с… Игнус-с-с долж-жен поделитьс-с-ся с-с-сном…*»~
@57695 = ~Пожелать, чтобы он стал молотом.~
@57696 = ~«Может, позже. Сейчас я ещё хочу поговорить о пла…»~
@57697 = ~«Хм… не сейчас. У меня есть ещё воп…»~
@57698 = ~«Я услышал достаточно. Теперь мы…»~
@57699 = ~Пожелать, чтобы он стал секирой.~
@57700 = ~Поток пламени истекает из Игнуса. Ты отступаешь назад. Воздух колеблется от жара. «*Ночные улицы-ы-ы… так холодно… Игнус-с-с-с С-СЖИГАЕТ дома, пос-с-селенцев… Вс-с-се БЕГУТ от Игнус-с-са, пламя, и дома с-словно пламя… крики пос-с-селенцев, с-с-становящ-щихс-ся ФАКЕЛАМИ…*»~
@57701 = ~«Я наслушался достаточно, Игн…»~
@57702 = ~Пожелать, чтобы он стал палицей.~
@57703 = ~Молча слушать, пока не закончится его тирада.~
@57704 = ~«*З-здания как С-С-СКЕЛЕТЫ… Углы, тела как с-с-скелеты… крас-с-сные, рыжие и чёрные, пламя рас-спрос-с-страняетс-ся, лас-с-сково… так С-С-СВЕТЛО…*»~
@57705 = ~Пожелать, чтобы он стал кастетом с шипами.~
@57706 = ~«Игнус, я наслушался достаточно…»~
@57707 = ~Молча слушать, пока не закончится его тирада.~
@57708 = ~«У тебя есть для меня какое-нибудь поручение?»~
@57709 = ~«*С-с-с…*» — ярость Игнуса угасает, окружающее его пламя опадает. Похоже, он потерял нить мысли или углубился в воспоминания. «*С-с-с… и Игнус-с-с был доволен…*»~
@57710 = ~«Я хочу ещё поговорить об огне и горении…»~
@57711 = ~Пожелать, чтобы он стал прекрасным кинжалом.~
@57712 = ~«У меня другие вопросы, Игнус…»~
@57713 = ~«Ясно. Поговорим попозже, ты и я…»~
@57714 = ~Какое-то время кажется, что Игнус тебя не слышал, но внезапно огни в его глазах слегка тускнеют, он тихо шипит, зола с пеплом кружатся у его рта. «*Игнус-с-с… когда-то… не знал НИЧЕГО об огне…*»~
@57715 = ~Пожелать, чтобы он стал секирой.~
@57716 = ~«Да?»~
@57717 = ~«Да?»~
@57718 = ~«Я хочу ещё поговорить об огне и горении…»~
@57719 = ~«Неважно. У меня другие вопросы…»~
@57720 = ~Пожелать, чтобы он стал палицей.~
@57721 = ~Пожелать, чтобы он стал кастетом с шипами.~
@57722 = ~Пожелать, чтобы он стал прекрасным кинжалом.~
@57723 = ~«Забудь, Игнус. Поговорим об этом как-нибудь в другой раз».~
@57724 = ~Пожелать, чтобы он стал молотом.~
@57725 = ~«*Когда-то… Игнус-с-с не з-знал НИЧЕГО о пламени… он заж-жигал маленькие огни, крохотные огоньки, с-с-совс-сем крохотные… маленькие кус-сочки пламени…* — Игнус снова шипит, из остатков его рта летят искры и пепел. — *Но огонь рос-с-с… Игнус-с-с заж-жигал огонь на их улицах… и огонь ярос-с-сти в их с-с-сердцах…*»~
@57726 = ~«Да?»~
@57727 = ~«Я хочу ещё поговорить об огне и горении…»~
@57728 = ~Пожелать, чтобы он стал палицей.~
@57729 = ~«Неважно. У меня другие вопросы…»~
@57730 = ~«Забудь, Игнус. Поговорим об этом как-нибудь в другой раз».~
@57731 = ~Пожелать, чтобы он стал кастетом с шипами.~
@57732 = ~~
@57733 = ~Ты говоришь, но непохоже, чтобы Игнус тебя слышал… он кажется где-то далеко отсюда, заново переживает свои воспоминания… против своей воли ты умолкаешь и слушаешь.~
@57734 = ~«*Они хотели наказ-зать Игнус-с-са, маленькие мошки из Улья. Они хотели С-С-СЖЕЧЬ Игнус-с-са пос-сле того, как он заж-жёг огонь на их улицах… крохотные колдунчики, захудалые волш-шебнички, з-заклинатели рун… мелкая магия хотела НАКАЗ-ЗАТЬ Игнус-с-са за его огонь… они приговорили С-С-СЖЕЧЬ Игнус-с-са, с-сделать Игнус-с-са ФАКЕЛОМ, плюющ-щимс-с-ся огнём, пылающ-щим, пылающ-щим… Это ПРАВОС-С-СУДИЕ, с-сказали они…*»~
@57735 = ~Пожелать, чтобы он стал прекрасным кинжалом.~
@57736 = ~«*Правос-с-судие…* — ты зачарованно смотришь, как Игнус снова начинает вращаться, как когда-то над грилем в „Горящем трупе“. — *…но это не было приговором… с-с-столько огня и боли, что боли НЕТ… только С-С-СВЕТ, и ТЕПЛО, и ЖАР, и плоть, с-с-с-сгорающ-щ-щая как ЖИР на моих кос-с-с-стях… в первый разс-с-с… Игнус-с-с был С-С-СЧАСТЛИВ…*»~
@57737 = ~«У тебя есть для меня какое-нибудь поручение?»~
@57738 = ~Игнус останавливает своё вращение, и его взгляд падает на тебя. Огонь в его глазах ярко вспыхивает, обгорелая ухмылка искажает черты, а плоть лица трескается и плавится, стекая пузырями. В лице Игнуса собирается всё пламя ада, а его следующие слова подобны смертному приговору не только для тебя, но и для всех остальных повсюду: «*Когда планы с-с-сгорят и вс-с-ся ж-жизнь с-с-станет факелами, тогда Игнус-с-с наконец упокоитс-с-ся… с-с-с миром…*»~
@57739 = ~«Я желаю ещё поговорить об огне и горении, Игнус…»~
@57740 = ~«Ясно. У меня другие вопросы…»~
@57741 = ~Оставить Игнуса наедине с его мыслями о горении…~
@57742 = ~Пожелать, чтобы он стал молотом.~
@57743 = ~«*Об уроках и учёбе ты знаеш-шь…* — сгустки пламени вырываются изо рта Игнуса, жутким подобием взрывам хохота. — *Ты ВС-С-СЕГДА учил Игнус-с-са… УЧИТЕЛЬ Игнус-с-са — ты.*»~
@57744 = ~«Я? Ты уверен?..»~
@57745 = ~«Я желаю ещё поговорить об огне и горении, Игнус…»~
@57746 = ~Пожелать, чтобы он стал секирой.~
@57747 = ~«Ясно. У меня другие вопросы…»~
@57748 = ~«Неважно, Игнус… поговорим позже».~
@57749 = ~Пожелать, чтобы он стал кастетом с шипами.~
@57750 = ~Пожелать, чтобы он стал прекрасным кинжалом.~
@57751 = ~Игнус *понижает* голос, а треск пламени затихает. «*Дас-с-с… это единс-с-ственная причина… почему Игнус-с-с… с-с-слушаетс-ся тебя…* — огонь взвивается над ним гудящей спиралью. — *Пока С-С-СМЕРТЬ не заберёт нас-с-с обоих-х… твои с-с-слова МНЕ… твоему ученику ИГНУС-С-СУ… Игнус-с-с НЕ забудет… Учитель…*»~
@57752 = ~Пожелать, чтобы он стал молотом.~
@57753 = ~«Игнус… должно быть, ты изучал Искусство очень давно… ты точно уверен, что это был я?»~
@57754 = ~«Игнус, если я был твоим „Учителем“… можешь ли ты вспомнить что-нибудь обо мне?»~
@57755 = ~«Я желаю ещё поговорить об огне и горении, Игнус…»~
@57756 = ~Пожелать, чтобы он стал секирой.~
@57757 = ~«Ясно. У меня другие вопросы…»~
@57758 = ~Пожелать, чтобы он стал палицей.~
@57759 = ~«Неважно, Игнус… поговорим позже».~
@57760 = ~«*Дас-с-с…* — Игнус фыркает. — *Дас-с-с… лицо изменилос-с-сь… но много уроков ты преподал Игнус-с-су…*»~
@57761 = ~«Если моё лицо изменилось, то как ты узнал?»~
@57762 = ~Оставить лезвие как есть.~
@57763 = ~«Игнус… это важно. Можешь вспомнить что-нибудь обо мне?»~
@57764 = ~«Я желаю ещё поговорить об огне и горении, Игнус…»~
@57765 = ~«Ясно. У меня другие вопросы…»~
@57766 = ~«Неважно, Игнус… поговорим об этом позже».~
@57767 = ~Начинается волна странной активности, и лезвие претерпевает множество удивительных перемен. Через мгновение ты получаешь то оружие, которое пожелал.~
@57768 = ~«*Внутри вс-с-сех вещ-щей… крохотное пламя… ИС-С-СКРЫ, огоньки, ОДИНАКОВЫЕ… неважно, что за кожа… кожу можно с-с-сжечь… но ВНУТРЕННЕЕ пламя ос-с-станетс-ся…*»~
@57769 = ~«Игнус… это важно. Можешь вспомнить что-нибудь обо мне?»~
@57770 = ~Готово.~
@57771 = ~«Я желаю ещё поговорить об огне и горении, Игнус…»~
@57772 = ~Лезвие внезапно прекращает изменяться и принимает свою нынешнюю форму.~
@57773 = ~«Ясно. У меня другие вопросы…»~
@57774 = ~Готово.~
@57775 = ~«Неважно, Игнус… поговорим позже».~
@57776 = ~Игнус шипит… и на мгновение его *черты* дрожат. Сначала ты думаешь, что это из-за пламени, но нет… это мерцание *воспоминаний*…~
@57777 = ~Сдаться под напором воспоминаний.~
@57778 = ~Подавить воспоминание.~
@57779 = ~Твой взор очищается, память уносится прочь словно дым. Игнус парит над тобой; его голова склонена набок, а лицо расколото безумной почерневшей улыбкой… «*Учитель… Игнус-с-с НЕ забыл твои уроки…*»~
@57780 = ~«Я желаю ещё поговорить об огне и горении, Игнус…»~
@57781 = ~«Ясно. У меня другие вопросы…»~
@57782 = ~«Неважно, Игнус… поговорим позже».~
@57783 = ~Потрескивание пламени Игнуса постепенно стихает, и одновременно обгорелые кости его тела складываются в суставах, перекручиваются друг с другом и превращаются в неподвижную стопку дров в большом железном камине… ты вглядываешься в огонь, ярко горящий в куполообразной комнате. Он трещит и плюётся угольками на каменный пол, пытаясь вырваться из камина. Из темноты за спиной слабо слышится чьё-то неровное дыхание.~
@57784 = ~Память: «Я *слышу* тебя… войди в круг света».~
@57785 = ~Подавить воспоминание.~
@57786 = ~Раздаётся шарканье сандалий, и хилый молодой паренёк вступает в освещённое пространство. Его расширенные чёрные глаза отражают свет огня. Он нервничает — ты слышишь, как трясётся его тело, голос дрожит — и достаточно, чтобы вызвать твоё раздражение. «Простите моё вторжение, учитель. Я…»~
@57787 = ~Память: «Ты уже помешал мне, просящий. И сделал это намеренно. Я выслушаю, а потом ты оставишь меня наедине с моими мыслями».~
@57788 = ~Подавить воспоминание.~
@57789 = ~Парнишка делает глубокий вздох и смотрит на огонь: «Учитель, мне… мне снова снился огонь прошлой ночью… он казался настоящим, а вы велели прийти сюда, если…»~
@57790 = ~Память: «Это был сон, не больше. Теперь ступай».~
@57791 = ~Подавить воспоминание.~
@57792 = ~Парень не двигается. Он сводит брови и медленно показывает свои руки. Плоть вокруг пальцев… почернела, обожжена.~
@57793 = ~Память: «Как ты обжёг свои руки, просящий?»~
@57794 = ~Подавить воспоминание.~
@57795 = ~«Я проснулся, а мои руки были покрыты пеплом, — парень смотрит тебе в глаза, дрожь по-прежнему заметна, но в его голосе просыпается пыл, который тебя злит. — Мне снилось, что я парю над землёй, а земля и небо подобны огню. Сам мир был столь ярким, что… было больно смотреть, учитель. А когда я проснулся, мои руки… они были обожжены, словно я коснулся ими пламени».~
@57796 = ~Память: «Ты лжёшь, просящий. Ты пришёл ко мне со сказкой и рискуешь меня *рассердить*».~
@57797 = ~Подавить воспоминание.~
@57798 = ~«Нет, учитель… — лицо мальчика искажает столь приятная гримаса страха. — Нет, во имя моей жизни, я не лгу!»~
@57799 = ~Память: «Ты обжёгся о свечу, просящий. Или сунул руки в погребальный костёр в Склепе Нынешних. А теперь пришёл ко мне и рассказываешь, что тебя обжёг сон. Я устал от твоей лжи».~
@57800 = ~Подавить воспоминание.~
@57801 = ~Парень умолкает, и, к твоему удивлению, его лицо перекашивает злоба. «Нет. Я не лгу. Это был *сон*, что обжёг меня, учитель, как ты и говорил: такое возможно, когда чувствуешь силу. Это были *твои* слова. Я могу *повторить* их тебе и подтвердить, что они *истинны*, — он протягивает ладони. — Смотри, учитель…»~
@57802 = ~Память: Схватить его за руки.~
@57803 = ~Подавить воспоминание.~
@57804 = ~Прежде чем мальчик успевает отреагировать, твои руки — огромные по сравнению с его — выстреливают вперёд и стискивают в хватке его обожжённые ладони, мальчик кричит, рождая в помещении эхо. С фырканьем ты повергаешь его на колени перед очагом так, что его коленки громко стукаются об каменный пол.~
@57805 = ~Память: «Смотри в пламя, просящий! Подними голову, смотри!»~
@57806 = ~Подавить воспоминание.~
@57807 = ~Мальчик отвлекается от боли в ушибленных коленях… ты видишь, как слёзы текут по его лицу, когда он поднимает голову, чтобы взглянуть в очаг. Огонь отбрасывает на его лицо мрачные красные блики…~
@57808 = ~Память: «Вот *то*, что ты хотел удержать, просящий? Эта пляска огня тревожит твоё сердце? Знай, что пламя может жечь, и если ты хочешь познать его силу, то должен страдать».~
@57809 = ~Подавить воспоминание.~
@57810 = ~Мальчик молчит, глядя на языки пламени. Он кажется зачарованным. Его слёзы высохли от жара, а дрожь прошла. Он сосредоточен на пламени. Он не СЛУШАЕТ тебя, и ты чувствуешь, как в тебе вздымается ярость.~
@57811 = ~Память: «Если это то, что гложет тебя, то хватит *прерывать* мои медитации. Тогда я научу тебя придавать форму пламени, просящий».~
@57812 = ~Подавить воспоминание.~
@57813 = ~~
@57814 = ~Ты выбрасываешь руку и стискиваешь запястье паренька. Он взвывает, когда ты подтаскиваешь его ближе к камину, а потом суёшь его руки в угли. Раздаются треск огня, шипение горящей плоти и его *крики*, такие ужасные, однако…~
@57815 = ~Память: «Чтобы научиться, ты должен страдать, просящий. Ты должен позволить пожрать себя той силе, которой хочешь владеть. Познай эту муку, и ты сможешь обратить её против своих врагов».~
@57816 = ~Память: «Чтобы научиться, ты должен страдать, просящий. Ты должен позволить пожрать себя той силе, которой хочешь владеть. Познай эту муку, и ты сможешь обратить её против своих врагов».~
@57817 = ~Подавить воспоминание.~
@57818 = ~У меня было отчётливое воспоминание, когда я спросил Игнуса о его «учителе». Очевидно… когда-то в прошлом… *я* был тем, кто научил Игнуса его пути постижения Искусства. Однако сейчас я думаю, что Игнус получил от меня плохой урок.~
@57819 = ~«*С-с-с… Игнус-с-с когда-то знал *много*… больше не знает… Игнус-с-с горит… и в с-с-страданиях Игнус-с-с учитс-с-ся…* — словно смешок из его рта выскакивает и уносится ввысь крохотный язычок пламени. — *С-с-страдает… учитс-с-ся…*»~
@57820 = ~«Я готов страдать ради такого знания…»~
@57821 = ~«Я желаю ещё поговорить об огне и горении, Игнус…»~
@57822 = ~«Ясно. У меня другие вопросы…»~
@57823 = ~«Может, в другой раз, Игнус… мы сможем поговорить об этом позже».~
@57824 = ~Едва ты собираешься произнести эти слова, как затылок охватывает покалывание… и ты внезапно осознаёшь, что знание, которое в состоянии дать тебе Игнус, может навсегда оставить на тебе шрамы… но ты понятия не имеешь, *откуда* пришло это ощущение.~
@57825 = ~Повторить: «Я готов страдать ради такого знания…»~
@57826 = ~«Я желаю ещё поговорить об огне и горении, Игнус…»~
@57827 = ~«Ясно. У меня другие вопросы…»~
@57828 = ~«Может, в другой раз, Игнус… мы сможем поговорить об этом позже».~
@57829 = ~«*С-с-страдать?..* — языки пламени жадно выскакивают из уголков рта Игнуса и пробегаются по обожжённым остаткам его лица. — *Гореть? Час-с-сти с-с-себя с-с-сгорели… с-с-с-с… Игнус-с-с… Игнус-с-с вс-с-сё ещ-щё МНОГОМУ мож-жет научить.*»~
@57830 = ~«Я желаю учиться, Игнус… можешь ли ты научить меня Искусству?»~
@57831 = ~«Я желаю учиться, Игнус… можешь ли ты ещё чему-нибудь научить меня в Искусстве?»~
@57832 = ~«Я желаю учиться, Игнус… можешь ли ты ещё чему-нибудь научить меня в Искусстве?»~
@57833 = ~«Я желаю ещё поговорить об огне и горении, Игнус…»~
@57834 = ~«Ясно. У меня другие вопросы…»~
@57835 = ~«Может, в другой раз, Игнус… мы сможем поговорить об этом позже».~
@57836 = ~«*Где однаж-жды горело пламя, там с-с-снова можно его раз-зжечь…*» — прежде чем ты успеваешь среагировать, Игнус хватает твой палец и с жадным *шипением* СЖИГАЕТ его. Из-за обжигающей боли ты закрываешь глаза и КРИЧИШЬ…~
@57837 = ~Ты заставляешь себя открыть глаза, чтобы осмотреть сгоревшую массу своей плоти там, где её касался Игнус… он невозмутимо парит над тобой, обхватывает твой сожжённый палец и резко *обламывает* у самого основания. Затем *шипит*, исторгая изо рта пепел и сажу, и сбрасывает тебе обуглившиеся остатки пальца.~
@57838 = ~«Ох-х… что… ты… сделал?»~
@57839 = ~Игнус «научил» меня Искусству, спалив всю плоть моего пальца, оторвав и отдав его мне… видимо, по его мнению, я должен знать, что с ними делать. Кажется, пострадав от его огня, я получил постоянный урон для здоровья, однако моя сопротивляемость к огню увеличилась. Несмотря на тяжесть испытания, мой палец, похоже, начинает снова отрастать, так что это не скажется на моих магических и боевых способностях.~
@57840 = ~«*Обучение…* — хохочет Игнус, этот звук странным образом причиняет боль твоим ушам. — *Чтобы выучитьс-с-ся, надо с-с-страдать.*»~
@57841 = ~«Я… хочу… ещё… учиться…»~
@57842 = ~«Я… хочу… ещё поговорить… о пламени и горении, Игнус…»~
@57843 = ~«Я… ясно. У меня… другие вопросы…»~
@57844 = ~«Хватит… Игнус… поговорим спустя некоторое время».~
@57845 = ~«*Дас-с-с…*» — прежде чем ты успеваешь среагировать, Игнус с безумным хохотом хватает твою левую руку и с жадным *шипением* СЖИГАЕТ её. Из-за обжигающей боли ты закрываешь глаза и КРИЧИШЬ…~
@57846 = ~Ты заставляешь себя открыть глаза, чтобы осмотреть сгоревшую массу своей плоти там, где её касался Игнус… и видишь на месте руки лишь подёргивающуюся почерневшую культю, сочащуюся кровью. Твоя боль, похоже, совсем не волнует Игнуса. Всё его внимание посвящено остатку твоей руки, который он держит, восхищаясь как трофеем…~
@57847 = ~«Иг… нус… ОТДАЙ… мне… мою… руку…»~
@57848 = ~Игнус игнорирует тебя, и ты видишь, как языки пламени из его рук завитками охватывают твою, медленно сжигая последние остатки плоти, пока там не остаётся лишь обгорелая кость. Он издаёт долгое *хс-с-с* и бросает тебе своё «творение». Тебе удаётся поймать его здоровой рукой, и ты замечаешь, что на твоей повреждённой руке снова нарастает плоть; медленно, болезненно… но рука восстанавливается.~
@57849 = ~«Что ты… сделал…»~
@57850 = ~Игнус «научил» меня Искусству, спалив в огне мою левую руку и вернув мне лишь кость… видимо, по его мнению, я должен знать, что с ней делать. Кажется, пострадав от его огня, я получил постоянный урон для здоровья, однако моя сопротивляемость к огню увеличилась. Несмотря на тяжесть испытания, моя рука, похоже, начинает отрастать снова, так что это не скажется на моих магических и боевых способностях.~
@57851 = ~«*Обучение…* — хохочет Игнус, этот звук странным образом причиняет боль твоим ушам. — *Чтобы выучитьс-с-ся, надо с-с-страдать.*»~
@57852 = ~«Я… хочу… ещё… учиться…»~
@57853 = ~«Я… хочу… ещё поговорить… о пламени и горении, Игнус…»~
@57854 = ~«Я… ясно. У меня… другие вопросы…»~
@57855 = ~«Хватит… Игнус… поговорим спустя некоторое время».~
@57856 = ~«*С-с-с-с…* — Игнус взлетает в воздух, оставляя за собой след из шипящих языков пламени. — *Хватит! Час-с-сти с-с-себя с-с-сгорели… с-с-с-с… Игнус-с-с… больш-ш-ше нельзя раз-зс-с-сделить с-с-с Игнус-с-сом учение…*»~
@57857 = ~«Тебе нужны части меня, чтобы продолжить обучение? Как насчёт моего глазного яблока?»~
@57858 = ~«Тебе нужны части меня, чтобы продолжить обучение? Как насчёт моих кишок?»~
@57859 = ~«Хорошо. Я желаю ещё поговорить об огне и горении, Игнус…»~
@57860 = ~«Ясно. У меня другие вопросы…»~
@57861 = ~«Неважно, Игнус… поговорим позже».~
@57862 = ~Игнус снова выбрасывает руку, его пальцы подобны острым когтям… но он не трогает тот твой глаз, который ты можешь вынимать; вместо этого он пронзает твой ВТОРОЙ глаз. Сначала боли нет, только удивление, а потом ты *кричишь*, когда Игнус выпускает поток пламени в твою глазницу. Оно словно выедает твой череп изнутри… шипение горящей плоти оглушает тебя, а дым застилает твой взор…~
@57863 = ~Ты заставляешь свои глаза видеть сквозь кровавую завесу — только один из них открывается — и с трудом видишь Игнуса, парящего в воздухе и рассматривающего маленький шар пламени у себя в ладони — твой глаз, неповреждённый чудовищным жаром. Ты наблюдаешь, как он накрывает глаз рукой, и ощущаешь второй взрыв боли в своей глазнице…~
@57864 = ~Внезапно, даже сквозь завесу боли, ты снова начинаешь нормально видеть… Игнус разжимает ладонь, и в ней ты видишь раздавленное глазное яблоко, с трудом узнаваемое… но… твой глаз всё ещё в своей глазнице. Он смеётся и, выдохнув пламя, словно облако пепла отправляет твой глаз в полёт к тебе.~
@57865 = ~Взять глаз… свой глаз…~
@57866 = ~Игнус «научил» меня Искусству, вырвав мне глаз, спалив его и отдав обратно… видимо, по его мнению, я должен знать, что с ним делать. Кажется, пострадав от его огня, я получил постоянный урон для здоровья, однако моя сопротивляемость к огню увеличилась. Иногда мне хочется, чтобы Игнус использовал ГРЁБАНЫЕ СВИТКИ вместо этих испытаний… но хотя бы я вижу своим глазом не хуже, чем раньше.~
@57867 = ~Крохотная огненная змейка вырывается из остатков глазницы Игнуса и оборачивается вокруг его обгоревшего черепа. «*Больш-ше учения…* — две огненные змеи кружат вокруг него, потом вспыхивают факелами в его руках. — *Больш-ше с-с-страданий…*»~
@57868 = ~«Я готов страдать ради такого знания… можешь научить меня ещё чему-нибудь?»~
@57869 = ~«Я желаю ещё поговорить об огне и горении, Игнус…»~
@57870 = ~«Ясно. У меня другие вопросы…»~
@57871 = ~«Спасибо, Игнус… наверное. Мы ещё поговорим позже».~
@57872 = ~Игнус наклоняет голову, рассматривая твои потроха, потом внезапно выхватывает их у тебя. Держа их, он растягивает между руками словно верёвку и *шипит* что-то сам себе… ты видишь, как кишки дымятся в его руках, чернеют… и чувствуешь медленную, мучительную боль в своём животе…~
@57873 = ~Игнус растягивает твои кишки и, ладонь за ладонью, опускает их вниз. Затем раскручивает в воздухе вокруг себя спиралью, медленно покачивает, образуя некий узор. И они, объятые пламенем в экзотическом танце, медленно чернеют, пока не превращаются в длинные полосы обугленного мяса…~
@57874 = ~Жжение в животе заставляет тебя корчиться, но оно несравнимо с той болью, которой Игнус подвергал тебя раньше. Ты наблюдаешь, как твои пылающие кишки поднимаются спиралью в пламени Игнуса, потом вдруг опадают и ложатся на его ладонь. Он издаёт *шипение* и бросает их тебе: «*МНОГО с-с-силы в органах бес-с-с-смертного…*»~
@57875 = ~Взять обуглившиеся кишки…~
@57876 = ~Игнус «научил» меня Искусству, поджарив мои кишки, а потом вернув их мне… видимо, по его мнению, я должен знать, что с ними делать. В отличие от остальных испытаний, я не так уж и страдал, когда он «готовил» мой кишечник на своём огне.~
@57877 = ~«*Пламя… не… с-с-страдание…*» — Игнус медленно вращается, зависнув над землёй; возможно, он слышал тебя, но ты не знаешь, *значат* ли слова для него хоть что-то…~
@57878 = ~«Ты уверен, просящий?»~
@57879 = ~«Я желаю ещё поговорить об огне и горении, Игнус…»~
@57880 = ~«По крайней мере я пытался… У меня другие вопросы, Игнус…»~
@57881 = ~«Ну, если это хоть что-то значит, Игнус, мне жаль, что всё кончилось именно так… поговорим позже».~
@57882 = ~Игнус внезапно перестаёт вращаться, и новые языки пламени охватывают его череп… словно стая огненных змей решила вдруг покинуть своё гнездо в черепе Игнуса. «*Игнус-с-с-с больш-ше НЕ прос-с-сящ-щий!.. С-с-скажешь так ещ-щё раз-з, и Игнус-с-с С-С-СОЖЖЁТ тебя!*»~
@57883 = ~«Попробуй, *просящий*. Похоже, мне придётся напомнить, где твоё место…»~
@57884 = ~«Тогда не бери в голову. Я желаю ещё поговорить об огне и горении, Игнус…»~
@57885 = ~«Ясно. У меня другие вопросы…»~
@57886 = ~«Неважно, Игнус… поговорим позже».~
@57887 = ~Ты держишь свои обугленные кишки в руках; они напоминают почерневшую верёвку. Игнус парит над тобой; крохотные частики пепла сыплются с его горящего, истощённого тела.~
@57888 = ~«Я готов страдать ради такого знания… можешь научить меня ещё чему-нибудь?»~
@57889 = ~«Я желаю ещё поговорить об огне и горении, Игнус…»~
@57890 = ~«Ясно. У меня другие вопросы…»~
@57891 = ~«Спасибо, Игнус… поговорим позже».~
@57892 = ~«Доказательство есть в его жилище, это его дневник. Однако теперь он мёртв».~
@57893 = ~«В его жилище есть доказательство — его дневник. Однако теперь он мёртв».~
@57894 = ~Разобраться с посетительницей бара.~
@57895 = ~Баркис, хозяин бара «Горящий труп», попросил меня разобраться с задолжавшей посетительницей. Жертву зовут Мокаи.~
@57896 = ~Я сказал Баркису, что Мокаи больше не будет доставлять ему проблем. Теперь выпивка для меня бесплатна.~
@57897 = ~Убить варгуйлий и спасти Чада от превращения в такую же тварь.~
@57898 = ~Труп Сборщика по имени Чад попросил меня убить стаю варгуйлий, прежде чем закончится его превращение в такую же тварь.~
@57899 = ~Я убил варгуйлий, которые укусили Чада. Его тело теперь покоится с миром. В благодарность он рассказал, как добраться до графина, находящегося в Затопленных Народах.~
@57900 = ~Найти графин бесконечной воды.~
@57901 = ~Говорящая голова по имени Глив, находящаяся в катакомбах Плачущих Камней, попросила меня принести ей графин свежей воды, чтобы освободиться от проклятья.~
@57902 = ~Я принёс Гливу графин. Он сказал мне поговорить с женщиной по имени Немель в районе Клерков. Похоже, Немель знает особое слово, которое раскроет весь потенциал графина.~
@57903 = ~Помочь Сев'Тай отомстить.~
@57904 = ~В мемориале Пыльных недалеко от Мортуария я встретил странную женщину по имени Сев'Тай. Она оплакивала смерть трёх своих сестёр, которых убила банда каких-то «Хаоситов», называющих себя «Голодные Лающие Псы». Сев'Тай попросила меня убить троих из них, чтобы отомстить за смерть сестёр, и я согласился. Она сказала, что на её сестёр напали в нескольких кварталах южнее Мортуария. Возможно, именно там я и найду этих «Голодных Псов».~
@57905 = ~Я вернулся к Сев'Тай после того, как записал в книгу мёртвых троих «Голодных Псов». Она была благодарна и в награду дала мне медную серьгу.~
@57906 = ~Я солгал Сев'Тай, сказав, что убил для неё троих «Голодных Псов». Она поверила мне на слово и дала в награду медную серьгу.~
@57907 = ~Вернуть чётки Порфирона.~
@57908 = ~В Улье я встретил странного мужчину по имени Порфирон с покрытым меняющимися линиями лицом. Как я понял, он солдат какого-то религиозного ордена, но обет не позволяет ему поднимать руку на другого. Порфирон сказал, что группа головорезов из Улья забрала у него чётки. По его словам, разбойники были у «бара, горящего изнутри», одеты они были в красное и чёрное. Я пообещал ему, что верну его чётки.~
@57909 = ~Я обнаружил троих грабителей около бара «Горящий труп» и вернул Порфирону его чётки. Похоже, он был рад получить их обратно… хотя кто знает, о чём *на самом деле* говорили эти странные линии на его лице.~
@57910 = ~Найти способ помочь Ингресс.~
@57911 = ~Я встретил сумасшедшую женщину по имени Ингресс, бегающую туда-сюда по Улью в районе Мортуария. Она бредила что-то о дверях с ключами и утверждала, что весь город переполнен порталами, ведущими в разные места. Женщина сказала, что когда она была маленькой девочкой, случайно прошла через портал и оказалась в ловушке в городе. Возможно, опытный планарный путешественник поможет вернуть её домой, если я найду такого.~
@57912 = ~Я поговорил с Кандрианом Болезненным в баре «Горящий труп», и он знает, через какой портал прошла Ингресс. Я попросил его помочь, и он согласился вернуть её обратно. Я рассказал об этом Ингресс, а потом снова поговорил с Кандрианом… оказалось, что Ингресс в качестве оплаты оставила свои живые зубы. Постараюсь не потратить их все зараз.~
@57913 = ~Обучиться у Меббет Искусству.~
@57914 = ~Меббет сказала, что научит меня Искусству, но сначала мне придётся выполнить для неё пару поручений. По-видимому, когда я их выполню, она обучит меня всему, что знает.~
@57915 = ~Я отдал Меббет чернила, тем самым выполнив все её поручения. Взамен она предложила мне обучиться Искусству, если у меня ещё не пропало желание.~
@57916 = ~Я решил больше не выполнять заданий Меббет; у меня есть дела поважнее, чем нарезать круги по Улью с её поручениями по хозяйству.~
@57917 = ~Найти необходимые Меббет травы.~
@57918 = ~Меббет сказала, что научит меня Искусству, но сначала мне придётся выполнить для неё пару поручений. Она дала мне чёрное шипастое семя и сказала найти торговца фруктами на рынке Улья. Меббет сказала, что у него есть необходимые ей травы.~
@57919 = ~Я нашёл торговца фруктами, о котором говорила Меббет, но у него нет необходимых ей трав. По словам торговца, чтобы получить нужные травы, мне придётся найти садовника… даже представить не могу, где мне искать *садовника* в Улье.~
@57920 = ~Я нашёл торговца фруктами, о котором говорила Меббет, но у него нет необходимых ей трав. По словам торговца, чтобы получить нужные травы, мне придётся найти садовника… но мне кажется, единственным садовником в округе был тот толстый пень неподалёку от бара «Горящий труп»… однако он мёртв. Я вернусь и поговорю с Меббет относительно того, что можно сделать.~
@57921 = ~Найти садовника, у которого есть травы для Меббет.~
@57922 = ~Я нашёл торговца фруктами, о котором говорила Меббет, но у него нет необходимых ей трав. По словам торговца, чтобы получить нужные травы, мне придётся найти садовника… даже представить не могу, где мне искать *садовника* в Улье.~
@57923 = ~Я поговорил с мужчиной по имени Плачущий-по-Деревьям. Он помог мне вырастить необходимые Меббет травы — нужно было просто *пожелать*, чтобы семена проросли… теперь чёрная колючая ветвь обвилась вокруг моего запястья. Вернусь-ка я лучше к Меббет и избавлюсь от этой дряни.~
@57924 = ~Забрать у Гискорла бельё Меббет.~
@57925 = ~Меббет отправила меня со вторым поручением… она хочет, чтобы я забрал её белье у продавца одежды Гискорла на рынке Улья. *Могла бы* упомянуть о нём и в прошлый раз.~
@57926 = ~Я взял у Гискорла бельё Меббет. Однако он немного перестарался со своим ритуалом очистки: её вещи так сильно накрахмалены, что напоминают кучу зелёных досок, сложенных штабелем. В любом случае я вернул их Меббет.~
@57927 = ~Взять у Косса-Джай чернила и отнести Меббет.~
@57928 = ~Меббет дала мне *ещё* одно идиотское поручение… опять на рынок, теперь уже за чернилами. Мне надо поговорить с женщиной по имени Косса-Джай на рыночной площади. Наверное, она последняя из тех, с кем я ещё *не разговаривал*.~
@57929 = ~Разумеется, у Косса-Джай никаких чернил не оказалось. Она сказала, что единственный известный ей источник чернил — это рыба *брогота-фин*, но она такую не продаёт. Косса-Джай сказала, что мне стоит поговорить с Мейр'ам, торговкой рыбой, которая продаёт свой товар на улице к югу от рынка.~
@57930 = ~Найти Мейр'ам и взять у неё чернила для Меббет.~
@57931 = ~У Косса-Джай никаких чернил не оказалось. Она сказала, что единственный известный ей источник чернил — это рыба *брогота-фин*, но она такую не продаёт. Косса-Джай сказала, что мне стоит поговорить с Мейр'ам, торговкой рыбой, которая продаёт свой товар на улице к югу от рынка.~
@57932 = ~Наконец-то я получил у Мейр'ам полную кружку чернил. Теперь мне надо отнести эту гадость Меббет… может, мне удастся заставить её выпить их.~
@57933 = ~Отдать чернила Меббет.~
@57934 = ~Я вернул мужчине его имя и номер. Его зовут Ку'у Йин. Он был мне очень признателен.~
@57935 = ~Странный невысокий мужчина попросил меня вернуть ему «имя и номер», которые украла женщина по имени Радин. Похоже, он относится к своим имени и номеру как к защите от вселенского хаоса.~
@57936 = ~Забрать у Радин номер Ку'у Йина.~
@57937 = ~Я нашёл и вернул Квинту амулет противоядия. Он был в мусорной куче за домом Марты.~
@57938 = ~Квинт, торговец трупами в Похороненной деревне, ищет амулет противоядия. Он говорит, что амулет у Сборщика по имени Грызь Стервятник. Надо разыскать Грызя, найти амулет и вернуть его Квинту.~
@57939 = ~Забрать амулет противоядия Квинта с тела Грызя.~
@57940 = ~Стражи крыс-оборотней~
@57941 = ~«Больше у тебя не будет проблем с Мокаи».~
@57942 = ~«Забудь. Прощай».~
@57943 = ~Он смотрит на тебя с насмешкой: «Мы уже по всем прошлись, разве не так? Хочешь что-нибудь другое, из того, что я ещё не говорил?»~
@57944 = ~«Просто ответь на мои вопросы».~
@57945 = ~«Нет. Прощай».~
@57946 = ~Ты видишь человека средних лет. Он с интересом наблюдает за твоим появлением. «Добрый день, здоровяк».~
@57947 = ~«Приветствую».~
@57948 = ~Игнорировать его.~
@57949 = ~Он легонько кланяется. «Я Дорн. Не хочешь взглянуть мои товары?»~
@57950 = ~«У меня есть несколько вопросов…»~
@57951 = ~«Покажи, что у тебя есть».~
@57952 = ~«Нет, прощай».~
@57953 = ~Он качает головой. «Сейчас у меня нет времени на вопросы. Может, в другой день».~
@57954 = ~«Покажи мне товары».~
@57955 = ~«Прощай».~
@57956 = ~Ты видишь мужчину средних лет в дешёвой одежде. При твоём приближении он хмурится и настороженно оглядывается.~
@57957 = ~«Приветствую».~
@57958 = ~Ты видишь Дорна, торговца. Он улыбается тебе. «Новая встреча. Чем могу служить?»~
@57959 = ~Не обращать на него внимания.~
@57960 = ~«Покажи мне товары».~
@57961 = ~Он оглядывает тебя и хмурится ещё сильнее: «Э-э… привет. Что тебе нужно?»~
@57962 = ~«Прощай».~
@57963 = ~«У меня вопросы…»~
@57964 = ~~
@57965 = ~«Неважно. Я должен идти, прощай».~
@57966 = ~«Например?»~
@57967 = ~«Кто ты?»~
@57968 = ~«Что ты здесь делаешь?»~
@57969 = ~«Что ты можешь рассказать об этом месте?»~
@57970 = ~«Я ищу дэва. Я слышал, что он в Керсте».~
@57971 = ~Он колеблется, прежде чем ответить. «Звать Вооршей», — он не углубляется в подробности.~
@57972 = ~«У меня ещё пара вопросов…»~
@57973 = ~«Мне пора идти. Прощай».~
@57974 = ~Он тупо смотрит на тебя, затем пожимает плечами: «Я… торговец. Это мой склад».~
@57975 = ~«Что ты здесь хранишь?»~
@57976 = ~«У меня ещё пара вопросов…»~
@57977 = ~Он хмурится: «Не думаю, что тебя это как-то касается».~
@57978 = ~«Просто любопытно…»~
@57979 = ~«У меня ещё пара вопросов…»~
@57980 = ~«Мне пора идти. Прощай».~
@57981 = ~Мужчина пожимает плечами. «Ну… — он делает неопределённый жест. — Эль, мёд и… другие товары». Он выглядит несколько нервным.~
@57982 = ~«Из-за чего ты нервничаешь?»~
@57983 = ~«У меня ещё пара вопросов…»~
@57984 = ~«Мне пора идти. Прощай».~
@57985 = ~Он начинает ёрзать. «Ни из-за чего… — он одаривает тебя вызывающим взглядом. — Можем мы сменить тему?»~
@57986 = ~«Нет, я думаю, ты что-то скрываешь, и хочу выяснить, что именно».~
@57987 = ~«У меня ещё пара вопросов…»~
@57988 = ~«Мне пора идти. Прощай».~
@57989 = ~Он пронзает тебя недовольным взглядом, потом вздыхает: «Я… достаю товары… неофициальными каналами. Стража об этом не знает…»~
@57990 = ~«Ты контрабандист».~
@57991 = ~«У меня ещё пара вопросов…»~
@57992 = ~«Мне пора идти. Прощай».~
@57993 = ~Он хмурится. «Я бутлегер. Так звучит лучше, чем контрабандист, правда? — он хитро смотрит на тебя. — Слушай… не хочешь ли ты мне помочь… за долю в деле?»~
@57994 = ~Ты видишь мускулистого молодого человека в грязной рабочей одежде. Он проверяет содержимое некоторых ящиков, сверяясь со списком в руках.~
@57995 = ~«Чем именно помочь?»~
@57996 = ~«Приветствую».~
@57997 = ~«Мне пора идти. Прощай».~
@57998 = ~Не обращать на него внимания.~
@57999 = ~На миг он задумывается. «Тут поблизости есть гехрелет. Он пытается меня убить и мешает толкать товар. Мне нужно, чтобы кто-нибудь с ним разобрался».~
@58000 = ~Он на время прерывается и оборачивается к тебе: «Да? Могу я чем-то помочь?»~
@58001 = ~«У меня кое-какие вопросы…»~
@58002 = ~«Что такое гехрелет?»~
@58003 = ~«А почему сам с ним не разберёшься?»~
@58004 = ~«Что я получу, если разберусь с ним?»~
@58005 = ~«У меня ещё пара вопросов…»~
@58006 = ~«Мне пора идти. Прощай».~
@58007 = ~«Нет, не думаю. Прощай».~
@58008 = ~Он пожимает плечами: «Просто безмозглая тварь, пожирающая всё, что видит…» Он беспокойно смотрит на тебя.~
@58009 = ~Он быстро осматривается по сторонам: «Ладно…»~
@58010 = ~«Кто ты?»~
@58011 = ~«Почему ты сам с ним не разберёшься?»~
@58012 = ~«Чем ты занят?»~
@58013 = ~«Что я получу, если разберусь с ним?»~
@58014 = ~«Что ты можешь рассказать об этом месте?»~
@58015 = ~«У меня ещё пара вопросов…»~
@58016 = ~«Я ищу дэва. Мне сказали, что он в Керсте».~
@58017 = ~«Мне пора идти. Прощай».~
@58018 = ~«Мне пора идти. Прощай».~
@58019 = ~«Я Дорфин, здоровяк. Один из складских рабочих тут», — он дружески тебе улыбается.~
@58020 = ~«Я же не воин, он сразу меня убьёт, — он пробегается взглядом по твоим шрамам. — С таким явным умением выживать ты легко с ним разделаешься».~
@58021 = ~«У меня другой вопрос…»~
@58022 = ~«Мне пора идти. Прощай».~
@58023 = ~«Что такое гехрелет?»~
@58024 = ~«Инвентаризацией, — он хмурится. — В третий раз за этот месяц, стоит добавить».~
@58025 = ~«И часто такое?»~
@58026 = ~«Что я получу, если разберусь с ним?»~
@58027 = ~«Ясно. У меня ещё вопросы…»~
@58028 = ~«У меня ещё пара вопросов…»~
@58029 = ~«Мне пора идти. Прощай».~
@58030 = ~Он вздыхает. «Да, хозяин — сущий рабовладелец. Он нагружает нас тяжёлой работой и редко позволяет отдохнуть, — он пожимает плечами. — Такова жизнь».~
@58031 = ~«Если он такой рабовладелец, то почему вы на него работаете?»~
@58032 = ~«Мне пора идти. Прощай».~
@58033 = ~«Ясно. У меня ещё вопросы…»~
@58034 = ~«Мне пора идти. Прощай».~
@58035 = ~Он пригибается к тебе и шепчет: «Нам дают целый выходной в неделю… оплачиваемый выходной. Поэтому мы не жалуемся».~
@58036 = ~Он улыбается: «Я не против партнёра. Дела идут неплохо, и я не могу распространять всё сам. А прибыль будем делить поровну. Что скажешь?»~
@58037 = ~«Интересно. Зачем он это делает?»~
@58038 = ~«Ясно. У меня ещё вопросы…»~
@58039 = ~«Конечно, почему бы и нет?»~
@58040 = ~«Мне пора идти. Прощай».~
@58041 = ~«Я так не думаю».~
@58042 = ~Он пожимает плечами: «Понятия не имею, да меня это и не волнует. Просто передышка от тяжкого труда».~
@58043 = ~«Ясно. У меня ещё вопросы…»~
@58044 = ~«Мне пора идти. Прощай».~
@58045 = ~Он смущённо смотрит на тебя, потом пожимает плечами: «Это просто склад. Мы храним здесь обычный товар. Ну, знаешь, оружие, инструменты, еду, что угодно…»~
@58046 = ~«Ясно. У меня ещё вопросы…»~
@58047 = ~«Я подумаю. У меня ещё вопросы…»~
@58048 = ~«Мне пора идти. Прощай».~
@58049 = ~«Правда? — он выглядит удивлённым. — Даже представить не могу… я хочу сказать, что здесь делать дэву?» Он выдерживает паузу и разражается смехом: «Ха! Разве что он собрался обрушить на нас *божественное правосудие*».~
@58050 = ~~
@58051 = ~«Что ты имеешь в виду?»~
@58052 = ~«Ясно. У меня ещё вопросы…»~
@58053 = ~Его улыбка ширится: «Отлично. Разберись с гехрелетом и возвращайся ко мне».~
@58054 = ~«Мне пора идти. Прощай».~
@58055 = ~«Жители Керста известны отнюдь не своей добротой и великодушием. Дэв слишком хорош для этого места. Такому нет никакого смысла находится здесь, если, конечно, он или она не посланы сюда какой-то силой. Это может быть сделано лишь во имя *высшей* справедливости».~
@58056 = ~«Хорошо. У меня другие вопросы…»~
@58057 = ~«Ясно. Я хотел спросить о другом…»~
@58058 = ~«Мне пора идти. Прощай».~
@58059 = ~Ты видишь Дорфина, работника склада. Он тебе кивает: «Снова привет, здоровяк».~
@58060 = ~«Мне надо идти. До встречи…»~
@58061 = ~~
@58062 = ~«У меня пара вопросов…»~
@58063 = ~Он хмурится: «Ладно, но если передумаешь, то предложение остаётся в силе. Моё дело прогорит, если я не решу проблему с этим гехрелетом».~
@58064 = ~«Неважно. Прощай».~
@58065 = ~«У меня ещё пара вопросов…»~
@58066 = ~«Мне пора идти. Прощай».~
@58067 = ~Он вертит головой. «Да не о чём тут говорить. — он пожимает плечами. — Оглядись сам».~
@58068 = ~«У меня ещё пара вопросов…»~
@58069 = ~«Мне пора идти. Прощай».~
@58070 = ~Он хмурится. «Дэв… кое-что я слышал…» — он выдерживает паузу.~
@58071 = ~«И что же?»~
@58072 = ~Он пожимает плечами и отводит взгляд. «Тут внизу велись раскопки, чтобы расширить тюрьму. Говорят, случайно откопали какой-то зал… — он снова поворачивается к тебе. — А там обнаружили *что-то* или *кого-то* заключённого».~
@58073 = ~«Продолжай».~
@58074 = ~«Некоторые болтают, что там нашли дэва. Другие — что это был баатезу, а третьи — что танар'ри, — он пожимает плечами. — Мне-то без разницы. Что бы это ни было — я туда соваться не собираюсь».~
@58075 = ~«Где этот зал?»~
@58076 = ~«Ясно. У меня ещё пара вопросов…»~
@58077 = ~«Понятия не имею. Осмотрись там внизу и наверняка мимо не пройдёшь… но учти, там отнюдь не обязательно что-то путнее».~
@58078 = ~«У меня ещё пара вопросов…»~
@58079 = ~«Мне пора идти. Прощай».~
@58080 = ~Ты видишь контрабандиста Вооршу. Когда ты подходишь, он нервно оглядывается: «И снова… привет. Чем я могу помочь?»~
@58081 = ~«Ты говорил, что нуждаешься в помощи. Что тебе нужно?»~
@58082 = ~«Ты говорил, что нуждаешься в помощи. Что тебе нужно?»~
@58083 = ~«Ты просил меня разобраться с гехрелетом».~
@58084 = ~«Я убил гехрелета».~
@58085 = ~«Ничем, прощай».~
@58086 = ~Мгновение он смотрит на тебя: «Да. Возьмёшься?»~
@58087 = ~«Что я за это получу?»~
@58088 = ~Он удивляется, но быстро справляется с эмоциями. Бросает взгляд, чтобы убедиться, не заметил ли ты: «Э-э… здорово. Хорошая работа».~
@58089 = ~«Ты сказал, что сделаешь меня своим партнёром. Я готов получать долю».~
@58090 = ~Он кивает: «Да… я так сказал». Секунду он сверит тебя взглядом, потом начинает беспокойно ёрзать.~
@58091 = ~«Так теперь мы партнёры, верно?»~
@58092 = ~«Ты думал, я не смогу убить гехрелета, не так ли?»~
@58093 = ~Он ещё ненадолго вперивает в тебя взгляд, затем вздыхает. «Нет, я так не думаю… — снова вздыхает. — Кажется, ты превзошёл мои ожидания… я надеялся, что гехрелет разделается с тобой и избавит меня от неприятностей. Похоже, теперь мне самому придётся об этом позаботиться». Внезапно он выхватывает оружие и нападает.~
@58094 = ~Защищаться.~
@58095 = ~Он ещё ненадолго вперивает в тебя взгляд, затем вздыхает: «Да… так я и думал. Кажется, ты превзошёл мои ожидания… я надеялся, что гехрелет разделается с тобой и избавит меня от неприятностей. Похоже, теперь мне самому придётся об этом позаботиться». Внезапно он выхватывает оружие и нападает.~
@58096 = ~Ты видишь молодую женщину в грязной рабочей одежде. Она тебе кивает.~
@58097 = ~Защищаться.~
@58098 = ~«Приветствую».~
@58099 = ~Не обращать на неё внимания.~
@58100 = ~«Привет… что-то нужно?»~
@58101 = ~«У меня кое-какие вопросы…»~
@58102 = ~«Нет, не думаю. Прощай».~
@58103 = ~«Хорошо».~
@58104 = ~«Кто ты?»~
@58105 = ~«Чем ты занята?»~
@58106 = ~«Что ты можешь рассказать об этом месте?»~
@58107 = ~«Я ищу дэва. Мне сказали, что он в Керсте».~
@58108 = ~«Мне пора идти. Прощай».~
@58109 = ~«Меня зовут Айлина».~
@58110 = ~«У меня другой вопрос…»~
@58111 = ~«Мне пора идти. Прощай».~
@58112 = ~«Обрабатываю заказы. Я получаю заказы от торговцев всего города на различные товары. Потом подбираю товар и готовлю к отправке».~
@58113 = ~«Звучит как интересная работа».~
@58114 = ~«У меня другой вопрос…»~
@58115 = ~«Мне пора идти. Прощай».~
@58116 = ~Она улыбается: «Вообще-то, да…» Затем вздыхает и пожимает плечами: «Иначе я бы ни за что этим не занималась».~
@58117 = ~«Почему это?»~
@58118 = ~«Ясно. У меня другой вопрос…»~
@58119 = ~«Мне пора идти. Прощай».~
@58120 = ~Она в раздумье хмурится: «Ну… это нелёгкая работа, и не надо бы мне управляться одной. Однако наш хозяин — дешёвое отродье шлюхи и не хочет нанимать ещё одного работника».~
@58121 = ~«Тогда почему ты отсюда не уйдёшь?»~
@58122 = ~«Ясно. У меня другой вопрос…»~
@58123 = ~«Мне пора идти. Прощай».~
@58124 = ~Она снова улыбается: «Ну, несмотря на свою жадность, Девор, наш хозяин, вполне неплохо к нам относится. Он даёт нам целый выходной в неделю, причём оплачиваемый!»~
@58125 = ~«Ясно. У меня другой вопрос…»~
@58126 = ~«Мне пора идти. Прощай».~
@58127 = ~Она пожимает плечами: «Нечего тут рассказывать. Если ты видел один склад, то ты видел их все. Этот ничем не отличается».~
@58128 = ~«У меня другой вопрос…»~
@58129 = ~«Мне пора идти. Прощай».~
@58130 = ~Мгновение она смотрит на тебя озадаченно. «Я уж собиралась сказать, что ты спятил, если ищешь его в Керсте… но тут вспомнила что-то связанное с дэвом, — она выдерживает паузу. — Только не помню, что именно. Думаю, тебе стоит сходить в управу и спросить там. Она на городской площади».~
@58131 = ~«У меня другой вопрос…»~
@58132 = ~«Мне пора идти. Прощай».~
@58133 = ~Ты видишь Айлину, работницу склада. Она кивает и улыбается тебе: «Снова привет. В чём дело?»~
@58134 = ~«У меня кое-какие вопросы…»~
@58135 = ~«Неважно, прощай».~
@58136 = ~Ты видишь красного абишая. Это рептилия со змееподобным телом, четырьмя когтистыми лапами, кожистыми крыльями и драконьей головой. Чешуя, покрывающая его тело, тускло-красного цвета. Создание стоит на задних лапах, поддерживая равновесие с помощью цепкого хвоста. Когда ты приближаешься, оно сужает глаза до щёлок и начинает шипеть.~
@58137 = ~«Приветствую».~
@58138 = ~Не обращать внимания на существо.~
@58139 = ~Абишай окатывает тебя свирепым взглядом и что-то произносит на шипящем гортанном языке. Ты понимаешь, что он разговаривает не с тобой, когда откуда-то сзади него раздаётся ответ. Спустя мгновение он склоняет голову набок и шипит уже тебе: «Чего хотеть ты?»~
@58140 = ~«У меня пара вопросов…»~
@58141 = ~«Ничего, прощай».~
@58142 = ~Абишай издаёт серию шипящих звуков, спустя мгновение непонятно откуда раздаётся ответ. «Нет… ты говорить с Тек'элач, — он неопределённо машет куда-то за спину. — Он с-согласный говорить с-с ты…»~
@58143 = ~«Почему ты не можешь ответить на мои вопросы?»~
@58144 = ~«Ясно. Тогда пойду пообщаюсь с этим Тек'элачем».~
@58145 = ~«Неважно. Прощай».~
@58146 = ~Минуту абишай зло глазеет на тебя, затем отвечает: «Тек'элач хотеть говорить с-с ты. Не я. Уходи».~
@58147 = ~«Ясно. Тогда пойду пообщаюсь с этим Тек'элачем».~
@58148 = ~«Неважно. Прощай».~
@58149 = ~Ты чувствуешь волну жара, исходящую от абишая, когда он склоняется к тебе и произносит: «Говорить с-с уважением… ос-сторожно… я с-смотреть. Я убивать, если ты говорить дурно». Его злобная ухмылка обнажает ряд острых длинных клыков: «Ты понимать?»~
@58150 = ~«Да, я понял. Прощай».~
@58151 = ~«Нет, я тупой. Почему бы тебе не объяснить?»~
@58152 = ~Абишай шипит и дотягивается до ближайшей стены. Его глаза в упор смотрят в твои, а когти одним размашистым ударом оставляют глубокие борозды в камне. «Теперь понимать? Или я лично объяс-снять?»~
@58153 = ~«Теперь весьма доходчиво. Прощай».~
@58154 = ~Напасть на абишая: «Посмотрим, на что ты годишься в бою с настоящим противником».~
@58155 = ~Абишай сердито шипит на тебя: «Ты говорить с-с Тек'элач… уходи!»~
@58156 = ~«Хорошо. Прощай».~
@58157 = ~Ты видишь молодого человека с крысиным лицом. Он внимательно наблюдает за твоим приближением и опытным взглядом оценивает каждое твоё движение.~
@58158 = ~«Приветствую».~
@58159 = ~Не обращать на него внимания.~
@58160 = ~Он потирает подбородок, изучая тебя. Возникает ощущение, что он взвешивает тебя на весах. «Да… приветствую, здоровяк. Добро пожаловать в наш дом. Что тебе нужно от Герика?»~
@58161 = ~«У меня кое-какие вопросы…»~
@58162 = ~«Ничего, прощай».~
@58163 = ~«Спрашивай… спрашивай…» — он улыбается.~
@58164 = ~«Кто ты?»~
@58165 = ~«Что можешь рассказать об этом месте?»~
@58166 = ~«Я ищу дэва. Не знаешь, где он?»~
@58167 = ~«Мне нужно идти, прощай».~
@58168 = ~«Мы Герик. Мы сказали тебе это… разве нет?» — он поднимает брови.~
@58169 = ~«Почему ты называешь себя „мы“?»~
@58170 = ~«У меня другие вопросы…»~
@58171 = ~«Мне нужно идти, прощай».~
@58172 = ~Он хмурится: «Потому что мы больше, чем один…» Он осматривается по сторонам, потом снова смотрит на тебя. «Разве ты нас не видишь?» — он указывает вокруг себя.~
@58173 = ~«Да, теперь я всех вас вижу. У меня вопросы…»~
@58174 = ~«Хм… нет, здесь только ты и я».~
@58175 = ~Он хмурится, потом наклоняется в сторону и начинает что-то шептать невидимому собеседнику. Спустя секунду он снова обращается к тебе: «Мы в смущении и не понимаем, как такое может быть. Возможно, ты нездоров? Возможно, мы поможем тебе». Он улыбается.~
@58176 = ~«А-а… вот они. Прошу прощения, просто не заметил твоих товарищей раньше. Теперь я их вижу».~
@58177 = ~«Кажется, это тебе нужна помощь».~
@58178 = ~Он улыбается и кивает: «Хорошо… хорошо… всё хорошо, и мы счастливы. У тебя ещё вопросы?»~
@58179 = ~«Да».~
@58180 = ~«Нет, мне нужно идти. Прощай».~
@58181 = ~Он сильно нахмуривается. «Это беспокоит нас… ты должен уйти, нам нужно время подумать…» — он отворачивается.~
@58182 = ~Уйти.~
@58183 = ~Он осматривается вокруг, потом переводит взгляд на тебя: «Это место — наш летний дом… нам он нравится. Как правило, шум волн расслабляет нас».~
@58184 = ~«Почему ты называешь себя „мы“?»~
@58185 = ~«Волн? Каких ещё волн?»~
@58186 = ~«Прощай».~
@58187 = ~«Каких ещё волн? — он выглядит раздражённым и смотрит куда-то вдаль сквозь стену. — Да вот этих! Мы любим океан, морской ветер… он такой освежающий».~
@58188 = ~«Ясно… да, очень мило. У меня другой вопрос…»~
@58189 = ~«Ой-ой… терпеть не могу солёного ветра. Мне нужно идти, прощай».~
@58190 = ~Его глаза расширяются, и он качает головой. Затем оглядывается по сторонам и начинает что-то бормотать невидимым товарищам. Спустя мгновение он оборачивается к тебе: «Да… мы видели дэва. Как же он был прекрасен…»~
@58191 = ~«Где мне его найти?»~
@58192 = ~Он выглядит смущённым. «Мы не знаем… для нас он потерян, — он обращает взгляд в пустоту. — Мы потеряли его… потеряли его… потеряли…» Его голос стихает, и он устремляет бессмысленный взгляд в стену. Все твои попытки продолжить разговор не находят ответа.~
@58193 = ~Уйти.~
@58194 = ~Ты видишь Герика. Он кажется затерянным с своём собственном мире, пока не замечает тебя: «Мы тебя помним… что ты хочешь от Герика?»~
@58195 = ~«У меня пара вопросов…»~
@58196 = ~«Ничего, прощай».~
@58197 = ~Ты видишь отчасти человекоподобную фигуру, покрытую причудливой чешуёй. У существа огромные крылья и цепкий хвост. Оно с довольным видом наблюдает за твоим приближением.~
@58198 = ~«Приветствую».~
@58199 = ~Не обращать на существо внимания.~
@58200 = ~У существа вырывается смешок, и оно улыбается тебе: «Да… приветствую тебя, маленький человек».~
@58201 = ~«У меня вопросы…»~
@58202 = ~«Мне пора идти, прощай».~
@58203 = ~«Разумеется, задавай свои вопросы…» — оно со смехом улыбается.~
@58204 = ~«Кто ты?»~
@58205 = ~«Что ты такое?»~
@58206 = ~«Что ты здесь делаешь?»~
@58207 = ~«Что ты можешь рассказать об этом месте?»~
@58208 = ~«Что ты можешь рассказать о городе Керсте?»~
@58209 = ~«Что случилось с Керстом? Отчего все эти перемены?»~
@58210 = ~«Что случилось с Керстом? Отчего все эти перемены?»~
@58211 = ~«Будучи Боготом, я знаю, что мы работаем в литейной над секретным устройством. Можешь ли мне о нём рассказать?»~
@58212 = ~«Мне пора идти, прощай».~
@58213 = ~Существо обдумывает твой вопрос. «Моё имя не имеет значения. Если бы у тебя была причина знать меня, то ты бы знал, — оно выдерживает паузу. — Если тебе обязательно как-то меня называть, то зови Тек'элачем». Создание ухмыляется.~
@58214 = ~«Что это ещё за имя?»~
@58215 = ~«У меня другие вопросы…»~
@58216 = ~«Прощай».~
@58217 = ~«Единственное, которое ты от меня услышишь…» — оно пристально на тебя смотрит.~
@58218 = ~«Ясно. У меня другие вопросы…»~
@58219 = ~«Думаю, мне пора идти. Прощай».~
@58220 = ~Существо склоняет голову набок и задумчиво на тебя смотрит. «Что я такое? Хм-м… тебе это действительно нужно знать? — оно задумывается. — Я думаю, вреда не будет. Кажется, твоя раса называет нас высшими баатезу… а если конкретно, то корнугонами».~
@58221 = ~«Ты высший баатезу?»~
@58222 = ~«У меня другие вопросы…»~
@58223 = ~«Мне пора идти, прощай».~
@58224 = ~«Да… тебя это удивляет?» — оно смотрит на тебя выжидающе.~
@58225 = ~«Просто не понимаю, зачем ты здесь. Разве тебе не полагается сражаться в Кровавой Войне или чем ещё вы там занимаетесь дома?»~
@58226 = ~«Просто не понимаю, зачем ты здесь. Разве тебе не полагается заниматься чем-то другим?»~
@58227 = ~«У меня ещё вопросы…»~
@58228 = ~«Мне пора идти, прощай».~
@58229 = ~Оно нахмуривается: «Да… у нас Кровавая Война. Но это далеко отсюда, и давай об этом не будем…»~
@58230 = ~«Почему нет?»~
@58231 = ~«Исключительно по той причине, что я не желаю этого разговора… пока», — оно сверлит тебя взглядом.~
@58232 = ~«Ясно. У меня вопрос о другом…»~
@58233 = ~«Я ухожу. Прощай».~
@58234 = ~Существо смотрит на тебя озадаченно: «Чем-то другим? Возможно, ты говоришь о Кровавой Войне?»~
@58235 = ~«Что такое Кровавая Война?»~
@58236 = ~«Не обязательно война, просто что-то другое вместо сидения в этом туннеле».~
@58237 = ~«Неважно, у меня другие вопросы…»~
@58238 = ~«Мне пора идти. Прощай».~
@58239 = ~Создание задумывается над твоим вопросом. Когда ты уже решаешь, что ответа не будет, оно произносит: «Кровавая Война — это… схватка между нами и танар'ри. Но это не имеет значения, и давай об этом не будем».~
@58240 = ~«Почему?»~
@58241 = ~«Мои дела тебя не касаются, никакого отношения к твоим они не имеют, — оно со значением улыбается тебе. — Предлагаю сменить тему».~
@58242 = ~«Не понимаю, к чему секретность? Ты вызываешь у меня впечатление, будто здесь что-то происходит».~
@58243 = ~«Хорошо, у меня кое-какие вопросы…»~
@58244 = ~«Мне пора идти. Прощай».~
@58245 = ~Существо смотрит на тебя с притворным удивлением: «Я? Или ты просто подгоняешь мои слова и действия под собственные нужды? Как бы то ни было, я на твой вопрос ответил. Больше мы на эту тему говорить не будем».~
@58246 = ~«Почему?»~
@58247 = ~«Хорошо, у меня другие вопросы…»~
@58248 = ~«Мне пора идти. Прощай».~
@58249 = ~«Что тут рассказывать? — оно обводит жестом всё окружающее. — Смотри сам. Всё прямо перед твоими глазами».~
@58250 = ~Существо смотрит на тебя с притворным удивлением: «Правда? Ты столь подозрителен или просто параноик? Как бы то ни было, я на твой вопрос ответил. Больше мы на эту тему говорить не будем».~
@58251 = ~«Почему?»~
@58252 = ~«Я чувствую, что тут творится больше, чем доступно простому взору…»~
@58253 = ~«Ясно… у меня другие вопросы…»~
@58254 = ~«Мне пора идти. Прощай».~
@58255 = ~«Хорошо, у меня другие вопросы…»~
@58256 = ~«Мне пора идти. Прощай».~
@58257 = ~Создание хмурится и серьёзно задумывается над твоим вопросом. «Это брошенное место… место предательства и хаоса… город балансирует на грани катастрофы. Не теряй в его пределах мудрости».~
@58258 = ~«Балансирует на грани катастрофы?»~
@58259 = ~Оно вздыхает и глядит вдаль. «Это *пограничный* город, маленький человек. С одной стороны находятся Внешние Земли, с другой — план Карцери. Пока Керст хранит уравновешенное статус-кво, он так и будет пограничным городом», — существо делает эффектную паузу.~
@58260 = ~«Продолжай».~
@58261 = ~«Если в городе всё пойдёт из рук вон плохо, он может соскользнуть в Карцери и стать единым с планом. Навяжут слишком много порядка, и город окажется во Внешних Землях, — существо пожимает плечами. — Такова участь подобных мест».~
@58262 = ~«Хочешь сказать, город на самом деле… движется?»~
@58263 = ~«У меня вопрос о другом…»~
@58264 = ~«Мне пора идти. Прощай».~
@58265 = ~Создание издевательски ухмыляется: «Да…»~
@58266 = ~«Если город соскользнёт, что можно с этим сделать?»~
@58267 = ~«У меня вопрос о другом…»~
@58268 = ~«Мне пора идти. Прощай».~
@58269 = ~Существо пожимает плечами. «Определи, в какую сторону соскальзывает город, и приложи обратные усилия. Слишком много порядка? Устрой сумятицу. Слишком мало порядка? Стань на стражу закона, — оно ухмыляется. — Если будешь настойчиво добиваться цели, то сможешь вернуть город на границу… или даже столкнуть в противоположную сторону».~
@58270 = ~«Ты был очень полезен… что вызывает другой вопрос… зачем?»~
@58271 = ~«У меня вопрос о другом…»~
@58272 = ~«Мне пора идти. Прощай».~
@58273 = ~Создание смотрит на тебя озадаченно: «Что зачем?»~
@58274 = ~«Баатезу считают воплощениями зла. Так зачем ты мне помогаешь?»~
@58275 = ~Оно разражается хохотом и ухмыляется: «Не принимай мою помощь за доброту, а меня за что-либо иное, кроме зла. Я помогаю тебе потому, что мне это выгодно… вот и всё».~
@58276 = ~«И какая тебе в том выгода?»~
@58277 = ~«У меня вопрос о другом…»~
@58278 = ~«Мне пора идти. Прощай».~
@58279 = ~«И в самом деле…» — существо продолжает ухмыляться.~
@58280 = ~«У меня вопрос о другом…»~
@58281 = ~«Мне пора идти. Прощай».~
@58282 = ~Существо вздыхает и смотрит вдаль. «Керст был пограничным городом, балансировавшим между двумя крайностями. С одной стороны были Внешние Земли, с другой — план Карцери», — оно выдерживает паузу.~
@58283 = ~«Да, я это понимаю. Что нарушило баланс и сдвинуло город в план Карцери?»~
@58284 = ~Оно пожимает плечами: «Триас. Он был причиной. Из-за него хаос одержал верх и столкнул город в Карцери… и тут Керст и останется, если не принять кардинальные меры».~
@58285 = ~«Что можно сделать?»~
@58286 = ~«Триас? С какой стати ему это делать?»~
@58287 = ~«Определи, в какую сторону соскальзывает город, и приложи обратные усилия. Слишком много порядка? Устрой сумятицу. Слишком мало порядка? Стань на стражу закона, — оно ухмыляется. — Если будешь настойчиво добиваться цели, то сможешь вернуть город на границу… или даже столкнуть в противоположную сторону».~
@58288 = ~«Хочешь сказать, кому-то надо навести в городе порядок?»~
@58289 = ~Создание ухмыляется: «Да… именно это я хочу сказать».~
@58290 = ~«Не хочешь мне в этом помочь?»~
@58291 = ~«У меня вопрос о другом…»~
@58292 = ~«Мне пора идти. Прощай».~
@58293 = ~Пару минут существо не сводит с тебя глаз, потом отвечает: «Да… думаю, это будет в моих интересах. Мои слуги и я с удовольствием тебе поможем».~
@58294 = ~«Ты был очень полезен… что вызывает другой вопрос… зачем?»~
@58295 = ~«У меня вопрос о другом…»~
@58296 = ~«Мне пора идти. Прощай».~
@58297 = ~Существо пожимает плечами: «Именно то, о чём я тебя предупреждал в нашем последнем разговоре».~
@58298 = ~«И что же?»~
@58299 = ~«Ты Богот? — во взгляде существа мелькает что-то вроде уважения. — В дань твоей принадлежности я отвечу. Устройство заказало моё начальство. Это оружие, которое будет использовано в Кровавой Войне».~
@58300 = ~«Что такое Кровавая Война?»~
@58301 = ~«Ясно. У меня ещё вопросы…»~
@58302 = ~Ты видишь высокое худое создание с длинными руками и вытянутой головой. Из его огромной пасти торчат несколько клыков, а пальцы оканчиваются длинными когтями. Оно неподвижно глазеет, как ты приближаешься.~
@58303 = ~«Мне пора идти. Прощай».~
@58304 = ~«Приветствую».~
@58305 = ~Не обращать на существо внимания.~
@58306 = ~Ты видишь корнугона Тек'элача. Он довольно улыбается: «Итак, мы снова встретились, маленький человек. Чего ты хочешь?»~
@58307 = ~«У меня кое-какие вопросы…»~
@58308 = ~Создание склоняется и обнюхивает тебя, затем протягивает руку и щипает тебя своими когтями. Оно облизывает губы: «Ты немного жёсткий, но от этого не менее вкусный».~
@58309 = ~«Ничего, прощай».~
@58310 = ~Создание вздыхает. «Триас — агент Хаоса. Он был осуждён на заключение не без причины. К сожалению, какой-то идиот освободил его, что позволило ему посеять в город хаос, — оно выдерживает паузу и снова вздыхает. — Меня сюда послали, чтобы приглядывать за ним…»~
@58311 = ~«Так что можно сделать?»~
@58312 = ~«У меня кое-какие вопросы».~
@58313 = ~«Мне надо идти, прощай».~
@58314 = ~Оно одаривает тебя зубастой усмешкой: «Разговоры перед обедом — это хорошо. Что ты хочешь знать?»~
@58315 = ~«Ты собираешься меня съесть?»~
@58316 = ~«Кто ты?»~
@58317 = ~«Что ты такое?»~
@58318 = ~«Что ты здесь делаешь?»~
@58319 = ~«Что ты можешь рассказать о Карцери?»~
@58320 = ~«Что ты можешь сказать об этих катакомбах?»~
@58321 = ~«Тут есть контрабандист, который хочет твоей смерти».~
@58322 = ~«Мне надо идти, прощай».~
@58323 = ~Его усмешка ширится: «Ага, как только ты закончишь со своими дурацкими вопросами».~
@58324 = ~«Можешь попробовать, но уверяю, ты сдохнешь от заворота кишок, когда я буду тебя потрошить».~
@58325 = ~«Я не хочу причинять тебе вред».~
@58326 = ~«Прощай».~
@58327 = ~Оно пожимает плечами и смиренно поднимает руки: «Я рискну».~
@58328 = ~«У меня ещё кое-какие вопросы…»~
@58329 = ~Напасть на тварь.~
@58330 = ~Оно пожимает плечами и смиренно поднимает руки: «Какая жалость. А я собираюсь тебя убить».~
@58331 = ~«Зачем?»~
@58332 = ~«Прощай».~
@58333 = ~Оно снова пожимает плечами: «Да без причины… просто ты оказался не в том месте не в то время». Существо выдерживает паузу. «Или в правильном месте в правильное время, — оно ухмыляется. — Это уж как посмотреть».~
@58334 = ~«У меня ещё кое-какие вопросы…»~
@58335 = ~«Меня трудно убить, но если хочется, можешь попробовать».~
@58336 = ~Существо пялится на тебя и ковыряется в носу. «Гхрист…» — оно продолжает глазеть на тебя, исследуя полости своего носа.~
@58337 = ~«Я хотел спросить о другом…»~
@58338 = ~«Мне надо идти, прощай».~
@58339 = ~Оно поднимает одну руку и лениво скребёт подмышку: «Гехрелет… фарасту».~
@58340 = ~«Что такое гехрелет?»~
@58341 = ~«Что такое фарасту?»~
@58342 = ~«Я хотел спросить о другом…»~
@58343 = ~«Мне надо идти, прощай».~
@58344 = ~Оно зевает, и тебя окатывает волна зловонного воздуха: «Ищу дэва. Хорошая еда. Высосу мозг из его костей».~
@58345 = ~«Ты хочешь съесть Триаса?»~
@58346 = ~«У меня ещё кое-какие вопросы…»~
@58347 = ~«Прощай».~
@58348 = ~Его взгляд скучнеет: «Нет, дэва. Меня не парят всякие триасы».~
@58349 = ~«Триас — это имя дэва».~
@58350 = ~«У меня ещё кое-какие вопросы…»~
@58351 = ~«Прощай».~
@58352 = ~Оно пожимает плечами и чешет задницу: «Триас-шмиас. Какая разница? Как ни назови — для меня он всё равно обед».~
@58353 = ~«Ясно. У меня к тебе ещё вопросы…»~
@58354 = ~«Прощай».~
@58355 = ~Оно открывает пасть и начинает ковырять когтем что-то между зубов. Его речь становится невнятной: «Дом. Мой дом, не твой. Тебе в Карцери не рады».~
@58356 = ~«У меня ещё кое-какие вопросы…»~
@58357 = ~«Прощай».~
@58358 = ~Оно тупо глазеет на тебя, потом кивает. «Знаю… как-то уже пытался его съесть. Он убежал. Пытался поймать его, но он заперся у себя, — существо фыркает. — Я терпеливый. Однажды он совершит ошибку».~
@58359 = ~«Он послал меня убить тебя».~
@58360 = ~«У меня ещё кое-какие вопросы…»~
@58361 = ~«Прощай».~
@58362 = ~Оно высмаркивается в когтистую ладонь, потом размазывает результат по своей заднице. Вытерев руку, оно отвечает: «О… ещё одна причина убить его… и тебя».~
@58363 = ~«У меня ещё кое-какие вопросы…»~
@58364 = ~«Прощай».~
@58365 = ~Оно широко ухмыляется: «Хорошо. Устал от вопросов, время поесть». Существо бросается на тебя.~
@58366 = ~Защищаться.~
@58367 = ~Оно рыгает, и воздух вокруг переполняет отвратительное зловоние. Существо лениво указывает на себя пальцем: «Я — гехрелет. Мой статус — фарасту».~
@58368 = ~«Какие ещё есть статусы?»~
@58369 = ~«У меня другие вопросы…»~
@58370 = ~«Прощай».~
@58371 = ~Оно неторопливо рассматривает когти, потом пожимает плечами: «Тебе нет нужды знать, ведь я — последний гехрелет, которого ты видишь».~
@58372 = ~«У меня ещё кое-какие вопросы…»~
@58373 = ~«Прощай».~
@58374 = ~Оно осматривается по сторонам, потом пожимает плечами: «Ничего. Брожу тут в поисках дэва».~
@58375 = ~«У меня ещё кое-какие вопросы…»~
@58376 = ~«Прощай».~
@58377 = ~Ты видишь молодую женщину. Её лицо в грязи, волосы растрёпаны, а одежда, похоже, сшита из множества обрывков. При твоём приближении она хмурится.~
@58378 = ~«Приветствую».~
@58379 = ~Не обращать на неё внимания.~
@58380 = ~Она встревожено озирается и пятится от тебя: «Чего тебе надо, пень?»~
@58381 = ~«У меня пара вопросов…»~
@58382 = ~«Ничего, прощай».~
@58383 = ~Она упирается в тебя напряжённым взглядом, потом слегка расслабляется. «Лучше б это было всё, что тебе надо», — она оглядывает тебя с подозрением.~
@58384 = ~«А что ещё мне может понадобиться?»~
@58385 = ~~
@58386 = ~«Всё, что мне нужно, — ответы на вопросы».~
@58387 = ~«Всё, что мне нужно, — ответы на вопросы».~
@58388 = ~«Неважно, прощай».~
@58389 = ~Она хмурится и упирает руки в боки: «Слушай, пень. Я не так уж и уродлива, в отличие от большинства образин тут внизу. Ты мог положить глаз».~
@58390 = ~«Всё, что мне нужно, — ответы на вопросы».~
@58391 = ~«Всё, что мне нужно, — ответы на вопросы».~
@58392 = ~«Неважно, прощай».~
@58393 = ~«Конечно, почему бы и…» — внезапно она умолкает и пристально смотрит на тебя. Звтем расширяет глаза, словно узнала: «Минуточку. Здоровый пень в шрамах с дурацкой причёской… ты из тех, кто кинул Роберту!»~
@58394 = ~«Роберта Парфидор… она тут внизу?»~
@58395 = ~«Понятия не имею, о ком ты говоришь».~
@58396 = ~«Мне пора идти, прощай».~
@58397 = ~«Да, она тут, — она на мгновение замолкает и улыбается. — Тебе стоит навестить её. То-то она порадуется».~
@58398 = ~«Конечно, обязательно навещу. Но сначала ответь на пару вопросов…»~
@58399 = ~«Мне пора идти, прощай».~
@58400 = ~Ты видишь старика в дешёвой одежде. Он окидывает тебя скучающим взглядом.~
@58401 = ~Она хмурится: «Ясно дело, не имеешь. Так чего тебе надо?»~
@58402 = ~«Приветствую».~
@58403 = ~Не обращать на него внимания.~
@58404 = ~«У меня вопросы…»~
@58405 = ~Он продолжает разглядывать тебя со скукой. Наконец кивает: «Привет, здоровяк. Какого тут шкатулкой гремишь?»~
@58406 = ~«Забудь».~
@58407 = ~«У меня пара вопросов…»~
@58408 = ~«Спрашивай что хочешь».~
@58409 = ~«Кто ты?»~
@58410 = ~«Можешь рассказать мне об этом месте?»~
@58411 = ~«Я ищу дэва. Как понимаю, он где-то здесь».~
@58412 = ~«Да просто так. Прощай».~
@58413 = ~«Мне пора идти, прощай».~
@58414 = ~Он медленно кивает и смотрит вдаль. «Ну… я торчу в этой выгребной яме, поскольку спёр кой-чего не своё, а не чтоб отвечать на идиотские вопросы… — он сверлит тебя взглядом. — Отвали».~
@58415 = ~«Я Йелаан. Имя не ахти какое, но другого у меня нет».~
@58416 = ~«Жизнь тут должна быть тяжёлой. А будешь калекой — станет для тебя тяжёлой вдвойне».~
@58417 = ~«Пожалуй, я пойду. Прощай».~
@58418 = ~«Почему ты здесь?»~
@58419 = ~Он хмурится в ответ на твои слова. Ты видишь, как его взгляд проходится по твоим шрамам и встречает твой: «Угрожаешь мне, пень?»~
@58420 = ~«У меня другой вопрос…»~
@58421 = ~«Да. Отвечай на вопросы, пока я не начал отрубать от тебя по куску».~
@58422 = ~«Нет, прощай».~
@58423 = ~«Мне пора идти, прощай».~
@58424 = ~Он медленно кивает: «Чё за вопросы?»~
@58425 = ~Она на мгновение задумывается, затем пожимает плечами: «Да разобралась с одной швалью, которая пыталась отжать мой бизнес. А меня повязали и бросили сюда».~
@58426 = ~«Кто ты?»~
@58427 = ~«Отжать бизнес?»~
@58428 = ~«Что расскажешь об этом месте?»~
@58429 = ~«С кем-кем ты разобралась?»~
@58430 = ~«Я ищу дэва. Как понимаю, он где-то здесь».~
@58431 = ~«У меня другой вопрос…»~
@58432 = ~«Прощай».~
@58433 = ~Он колеблется: «Гиб… зовут Гиб».~
@58434 = ~«Мне пора идти, прощай».~
@58435 = ~«Почему ты здесь?»~
@58436 = ~«Я была проституткой и пользовалась успехом… пока не припёрлась она. Вот я и подумала, что если чуток поработать над её личиком, то дела опять пойдут в гору», — она вздыхает.~
@58437 = ~«У меня другие вопросы…»~
@58438 = ~«Прощай».~
@58439 = ~«С кем-кем ты разобралась?»~
@58440 = ~«Ты меня ваще слушал? Я же говорил, что был вором. А здесь только потому, что сцапали, — он улыбается. — Раз уж заставляешь отвечать на вопросы, хоть тупых не задавай».~
@58441 = ~«Не умничай…»~
@58442 = ~«У меня другие вопросы…»~
@58443 = ~«У меня другой вопрос…»~
@58444 = ~«Прощай».~
@58445 = ~«Мне пора идти, прощай».~
@58446 = ~Он пожимает плечами.~
@58447 = ~«У меня другие вопросы…»~
@58448 = ~Она пожимает плечами: «Не помню имени… а может, никогда и не знала. Она была конкуренткой, вот и всё, что имело значение».~
@58449 = ~«Неважно, прощай».~
@58450 = ~«У тюряги три кольца: внешнее, центральное и внутреннее. Тут — внешнее, где сидит ворьё и прочая подобная шваль. В среднем чалятся более закоренелые бандюги и головорезы. Внутреннее кольцо — для самых опасных: киллеров, заговорщиков, врагов правительства…»~
@58451 = ~«Ясно. У меня другие вопросы…»~
@58452 = ~«Прощай».~
@58453 = ~«Говоришь, она отжимала твой бизнес?»~
@58454 = ~Он окидывает тебя обеспокоенным взглядом: «Дэв… да, тута он. Вот только тебе вряд ли стоит его искать».~
@58455 = ~«У меня другой вопрос…»~
@58456 = ~«Из-за эпидемии?»~
@58457 = ~«Мне пора идти, прощай».~
@58458 = ~«Почему это?»~
@58459 = ~Какое-то время она глазеет на тебя, потом ты замечаешь наворачивающиеся на её глаза слёзы. Она быстро смахивает их и берёт себя в руки. «Да что тут рассказывать… это тюряга, и жизнь тут не сахар. Слыхала я, что есть и худшие тюрьмы, но ни в жизнь не поверю… — она запинается и понижает голос до шёпота. — Вот бы у меня снова был выбор, залазить ли в это дерьмо…»~
@58460 = ~«У меня другие вопросы…»~
@58461 = ~«У меня другой вопрос…»~
@58462 = ~«Прощай».~
@58463 = ~«Мне пора идти, прощай».~
@58464 = ~Он кивает. «Так ты в курсе… да, эпидемия. Она быстро и жёстко выкосила наших, большинство прописались в книге мёртвых, — он хмурится. — Никто и близко не подойдёт, если прознает, что ты трепался с ним…»~
@58465 = ~Она кивает: «Есть тут внизу дэв… где-то. Сама я не видела, но треплют о нём много. Большинство называет его *чумоносцем*».~
@58466 = ~«Так где он?»~
@58467 = ~«У меня другие вопросы…»~
@58468 = ~«Прощай».~
@58469 = ~«Чумоносцем?»~
@58470 = ~«Вали туда… — он неопределённо машет рукой. — Рано или поздно наткнёшься».~
@58471 = ~«У меня пара вопросов…»~
@58472 = ~«У меня другой вопрос…»~
@58473 = ~«Прощай».~
@58474 = ~«Байда в том, что он разносит эпидемию, — Гиб глазеет на тебя, ожидая реакции, затем пожимает плечами. — Зуб не дам, но эпидемия началась сразу после его обнаружения».~
@58475 = ~«Мне пора идти, прощай».~
@58476 = ~«Расскажи мне об этой эпидемии».~
@58477 = ~«У меня пара вопросов…»~
@58478 = ~«Да… сразу после его обнаружения тут вспыхнула эпидемия. Прокатилась по всей тюряге и убила большинство из нас, — она пожимает плечами. — Народ говорит, что он и есть причина болезни, но я без понятия».~
@58479 = ~«Прощай».~
@58480 = ~«Где мне его найти?»~
@58481 = ~«Она быстро и жёстко выкосила наших, большинство прописались в книге мёртвых, — он хмурится. — Никто и близко не подойдёт, если прознает, что ты трепался с ним…»~
@58482 = ~«У меня другой вопрос…»~
@58483 = ~«Где мне его найти?»~
@58484 = ~«У меня другие вопросы…»~
@58485 = ~«Прощай».~
@58486 = ~«Мне пора идти, прощай».~
@58487 = ~Ты видишь воришку Гиба. Завидев тебя, он хмурится: «Опять ты… охренеть».~
@58488 = ~Она пожимает плечами: «Без понятия. Где-то здесь — вот и всё, что могу сказать».~
@58489 = ~«Он где-то рядом, но не здесь…»~
@58490 = ~«У меня кое-какие вопросы…»~
@58491 = ~«У меня другой вопрос…»~
@58492 = ~«Прощай».~
@58493 = ~«Мне пора идти. Прощай».~
@58494 = ~Она кивает: «Слушай, пень. Чума убила почти всех, и народ уверен, что причина в этом дэве. И зачем, Баатор тебя побери, мне его искать?»~
@58495 = ~«Ясно. У меня другой вопрос…»~
@58496 = ~«Мне пора идти, прощай».~
@58497 = ~Ты видишь Йелаан. Она подзывает тебя рукой: «Снова ты, нужно чего?»~
@58498 = ~«У меня пара вопросов…»~
@58499 = ~«Ничего, прощай».~
@58500 = ~Ты видишь молодую женщину. Она скучает. Твоё появление взбадривает её: «Привет, здоровяк. Чем могу помочь?»~
@58501 = ~«Приветствую».~
@58502 = ~Игнорировать её.~
@58503 = ~Она улыбается: «Я Гилдея. Хочешь посмотреть товар?»~
@58504 = ~«У меня кое-какие вопросы…»~
@58505 = ~«Покажи мне товар».~
@58506 = ~«Нет, прощай».~
@58507 = ~Она качает головой: «Я простая торговка, не могу тебе ответить».~
@58508 = ~«Покажи мне товар».~
@58509 = ~«Прощай».~
@58510 = ~Ты видишь торговку Гилдею. Она улыбается тебе: «Добро пожаловать. Чем могу служить?»~
@58511 = ~«Покажи мне товар».~
@58512 = ~«Ничем, прощай».~
@58513 = ~Ты видишь хорошо одетую женщину средних лет. Она хмурит брови и, кажется, что-то или кого-то ищет.~
@58514 = ~«Приветствую».~
@58515 = ~Не обращать на неё внимания.~
@58516 = ~Она останавливается и пристально на тебя смотрит, прежде чем ответить: «Кто ты, и что тебе от меня надо?»~
@58517 = ~Ложь: «Я Адан, и у меня пара вопросов…»~
@58518 = ~«Я не помню своё имя».~
@58519 = ~«Неважно. Прощай».~
@58520 = ~Она протягивает тебе руку: «Добрый день, здоровяк, я Роберта».~
@58521 = ~Взять её руку и поклониться: «Рад встрече, госпожа Роберта».~
@58522 = ~«Неважно. Прощай».~
@58523 = ~«Мне кажется, ты хотел меня о чём-то спросить?»~
@58524 = ~«Да, госпожа».~
@58525 = ~«Неважно, госпожа. До свидания».~
@58526 = ~«К твоим услугам. Пожалуйста, спрашивай».~
@58527 = ~«Я ищу дэва. Говорят, он в Керсте».~
@58528 = ~«Ты выглядишь расстроенной. Что-то случилось?»~
@58529 = ~«Что интересного тут происходит?»~
@58530 = ~«Не расскажешь мне о Керсте?»~
@58531 = ~«Кто тут всем заправляет?»~
@58532 = ~«Я должен идти. Прощай».~
@58533 = ~Она задумывается. «До меня тоже доходили такие слухи. К сожалению, ничем не помогу. Не знаю, где может быть подобное создание. Тебе стоит поспрашивать возле управы на городской площади».~
@58534 = ~«Ясно. У меня вопрос о другом…»~
@58535 = ~Ты видишь работника склада. Он поглощён своей работой и твоего приближения не замечает.~
@58536 = ~«Спасибо. Прощай».~
@58537 = ~«Приветствую».~
@58538 = ~Она хмурится. «Да… мой муж, Карл Парфидор, не пришёл, куда обещал. Не в первый раз он лжёт мне о своих намерениях, и я начинаю подозревать, что у него… — она мнётся. — Я думаю, у него есть другая женщина. Проститутка».~
@58539 = ~«Почему ты так думаешь?»~
@58540 = ~Не обращать на него внимания.~
@58541 = ~«У меня вопрос о другом…»~
@58542 = ~Он прерывается и оборачивается к тебе: «Могу я чем-то помочь?»~
@58543 = ~«У меня кое-какие вопросы…»~
@58544 = ~«Мне пора идти. Прощай».~
@58545 = ~Она вздыхает. «Он был бабником, прежде чем мы поженились, особенно ему нравился этот тип женщин, и ходили слухи… — она выглядит разгневанной. — Если только я узнаю, что это правда, то у меня для него будет сюрприз».~
@58546 = ~«Сюрприз?»~
@58547 = ~«Нет, не думаю. Прощай».~
@58548 = ~«У меня вопрос о другом…»~
@58549 = ~Мужчина хмурится: «У меня куча работы и нет времени отвечать на вопросы. Извини». Он отворачивается.~
@58550 = ~«Мне пора идти. Прощай».~
@58551 = ~«Всего один быстрый вопрос…»~
@58552 = ~«Да», — она поднимает юбку, и на ножке ты видишь спрятанный за резинку чулка кинжал. Она вытаскивает клинок и злобно улыбается: «Я думаю, найти эту штуку торчащей в спине будет для него сюрпризом. Ты согласен?» Она прячет кинжал.~
@58553 = ~«Тогда прощай».~
@58554 = ~Он вздыхает и окатывает тебя злым взглядом: «Один быстрый вопрос… знаешь, сколько раз в день я это слышу?»~
@58555 = ~«Так ты намерена его убить?»~
@58556 = ~«Хм… нет».~
@58557 = ~«Прощай».~
@58558 = ~«У меня вопрос о другом…»~
@58559 = ~«Так позволь сказать… слишком часто! Потому что каждый сраный пень считает за правило быть назойливым как весь Баатор, хоть и видит, что ты занят, но никак не может отложить свой дурацкий вопрос! И каждый раз это „всего *один быстрый* вопрос!“ — он смотрит на тебя свирепо. — И знаешь что?»~
@58560 = ~«Ну… нет. И что?»~
@58561 = ~«Мне пора идти. Прощай».~
@58562 = ~«Прощай».~
@58563 = ~Он переходит на крик и принимается махать руками: «Он лжёт! Он знает, что это будет не один вопрос! Знает, что для нормального ответа мне придётся сочинить долбаное эссе. Но! Он утверждает, что это будет быстро! Знаешь почему?»~
@58564 = ~«Хм… нет. Почему?»~
@58565 = ~Женщина по имени Роберта Парфидор хочет убить своего мужа Карла. Он ей изменяет, и Роберте, естественно, это не нравится. Интересно.~
@58566 = ~«Прощай».~
@58567 = ~«Потому что думает, будто я ТУПОЙ! Думает, я не замечу, сколько времени у меня отнимет этот его вопрос. О нет! Он говорит, это будет один вопросик, потом другой, потом третий, и так пока не пройдёт полчаса! А я, по его мнению, настолько ГЛУП, что не замечу этого!»~
@58568 = ~«Может, мне стоит зайти попозже…»~
@58569 = ~«Извини за вмешательство. Я вижу, что ты занят…»~
@58570 = ~Она обдумывает твои слова, и её улыбка медленно гаснет. Наконец она вздыхает. «Убила бы, если бы могла… но нет, я попала впросак. У нас с Карлом больше нет… близких отношений. Не могу даже и подобраться достаточно близко для такого удара, — мгновение она смотрит в сторону. — Сможет только одна из его *женщин*…»~
@58571 = ~«Прощай».~
@58572 = ~«Зачем? Ты уже прервал меня и нарушил течение моих мыслей! Задавай свой долбаный вопрос, забирай час моего рабочего времени и проваливай», — он сверлит тебя взглядом.~
@58573 = ~«Я ищу дэва. Мне сказали, что он в Керсте».~
@58574 = ~«Лучше я пойду. Прощай».~
@58575 = ~«Да, я тоже это слышал. Ходят слухи, что он в тюрьме. Если не врут, тебе надо сходить в здание администрации и спросить о нём там. Теперь оставь меня в покое…» — он отворачивается.~
@58576 = ~«Прощай».~
@58577 = ~Он дарит тебе очередной яростный взгляд. «Занят? Ты видел расписание моей работы? Ты и понятия не имеешь о занятости, пень, — он фыркает. — А ещё всё постоянно меняется, и из-за этого грёбаное расписание летит ко всем чертям! Каждый день там что-то добавляется или же убирается, чтобы добавить что-то ещё».~
@58578 = ~«Ясно. Думаю, мне стоит уйти…»~
@58579 = ~«Прощай».~
@58580 = ~Ты видишь сердитого работника склада. Он очень занят своей работой, но твоё приближение замечает: «О, опять ты. Дай угадаю, у тебя ко мне *один быстрый* вопрос?»~
@58581 = ~«Нет, просто проходил мимо. Прощай».~
@58582 = ~«Я знаю шлюху по имени Кири, которой нужны деньги. Думаю, она могла бы подобраться поближе и провернуть дельце…»~
@58583 = ~«У меня вопрос о другом…»~
@58584 = ~«Мне пора идти. Прощай».~
@58585 = ~Минуту она пристально смотрит на тебя: «Ясно…» Потом оглядывается, склоняется к тебе и шепчет: «Не согласишься ли сходить и предложить ей… работу? Если дело выгорит, я заплачу тебе пятьсот медяков».~
@58586 = ~«Маловато будет».~
@58587 = ~«Я так не думаю. Прощай».~
@58588 = ~«Деньги лишними не бывают. Я поговорю с Кири».~
@58589 = ~Я отказался помочь Роберте Парфидор в убийстве её мужа Карла.~
@58590 = ~Я согласился помочь Роберте Парфидор убить её мужа Карла. Мне нужно поговорить со шлюхой Кири и узнать, не возьмётся ли она за эту работёнку.~
@58591 = ~Она хмурится: «Хм-м. Может, и так, но это всё, что я готова заплатить. Вы оба можете стать на пятьсот медяков богаче… или не стать. Выбор за тобой».~
@58592 = ~«Обойдусь. Прощай».~
@58593 = ~«Деньги лишними не бывают. Я поговорю с Кири».~
@58594 = ~Она улыбается: «Великолепно. Если она согласится, то пусть действует на своё усмотрение, но только не медлит. После завершения дела приходи ко мне, и я заплачу твою долю».~
@58595 = ~«У меня другие вопросы…»~
@58596 = ~«Мне пора идти. Прощай».~
@58597 = ~На миг она задумывается. «Я слышала, недавно пропала девушка. Дочь хозяина таверны. Подробностей я не знаю. Помимо этого ничего необычного не помню».~
@58598 = ~«Ясно. У меня вопрос о другом…»~
@58599 = ~«Спасибо. Прощай».~
@58600 = ~Женщина смеётся. «Керст — это выгребная яма, а мы — испражнения, которые её заполняют, — она пожимает плечами. — Вот и всё, что тут можно сказать».~
@58601 = ~«Ясно. У меня вопрос о другом…»~
@58602 = ~«Спасибо. Прощай».~
@58603 = ~«Товус Гильяф. Его можно найти у здания администрации на городской площади».~
@58604 = ~«Что ты можешь рассказать о Товусе?»~
@58605 = ~«У меня другие вопросы…»~
@58606 = ~«Мне пора идти. Прощай».~
@58607 = ~«Пожалуй, Товус — довольно… сильная личность, — она задумывается. — Я мало о нём знаю, не считая тех фактов, что он гитцерай и маг».~
@58608 = ~«У меня другие вопросы…»~
@58609 = ~«Мне пора идти. Прощай».~
@58610 = ~Она смотрит на тебя с лёгким удивлением: «Правда? Ты, случаем, не просящий? Я так понимаю, они часто теряют свои воспоминания».~
@58611 = ~«Что такое „просящий“?»~
@58612 = ~Она на мгновение задумывается. «Просящие… это те, кто умер, а их тела возродились на плане, ближе всего отражающем их убеждения при жизни. Обычно они не имеют представления о своём предыдущем существовании. Возможно, это именно твой случай».~
@58613 = ~«Возможно… А это перерождение, сколько раз оно может происходить?»~
@58614 = ~«Ну… я не знаток в таких вопросах, но по моему разумению, это происходит лишь однажды. После смерти дух сам возвращается на план. Если только, конечно, ты не путешествуешь на другой план. В таком случае после смерти ты обретаешь забвение».~
@58615 = ~«Ясно. В любом случае имя я сказать не могу».~
@58616 = ~«Спасибо. Теперь мне пора идти. До свидания».~
@58617 = ~Ты видишь Роберту. При твоём приближении она улыбается: «Добрый день, здоровяк. Чем могу служить?»~
@58618 = ~«Ты всё ещё хочешь, чтобы с твоим мужем… разобрались?»~
@58619 = ~«Ты всё ещё хочешь, чтобы с твоим мужем… разобрались?»~
@58620 = ~«Ты всё ещё хочешь, чтобы с твоим мужем… разобрались?»~
@58621 = ~«У меня пара вопросов…»~
@58622 = ~«Неважно. Прощай».~
@58623 = ~Она тебе улыбается: «Да, конечно. А почему ты спрашиваешь?»~
@58624 = ~«Я знаю шлюху по имени Кири, которой нужны деньги. Думаю, она могла бы подобраться поближе и провернуть дельце…»~
@58625 = ~«Просто интересуюсь. У меня пара вопросов…»~
@58626 = ~«Неважно. Прощай».~
@58627 = ~Она хмурится: «Да, конечно. Однако ты отверг моё предложение в пятьсот монет за выполнение этого дела. Неужели всё-таки передумал?»~
@58628 = ~«Нет, вовсе нет. Прощай».~
@58629 = ~«Деньги лишними не бывают. Я поговорю с Кири».~
@58630 = ~~
@58631 = ~~
@58632 = ~~
@58633 = ~~
@58634 = ~~
@58635 = ~~
@58636 = ~~
@58637 = ~Она хмурится: «Да, конечно. Мы ведь уже договорились. Так что, дело сделано?»~
@58638 = ~«Ещё нет. Я работаю над этим. До свидания».~
@58639 = ~Ты видишь Роберту, которая наконец-то выглядит счастливой. Она осторожно осматривается по сторонам. «Привет. Могу лишь предположить, что ты пришёл за деньгами?» — она улыбается.~
@58640 = ~«Да, всё сделано, как и договаривались».~
@58641 = ~Она снова оглядывается по сторонам. «Прекрасно. Вот деньги, которые я тебе обещала, — на её лице проскальзывает беспокойство. — Хм… твоя подруга… проделала *исчерпывающую* работу над Карлом. Примите оба мои комплименты». Она протягивает тебе тяжёлый кошелёк: «Вот твоя доля, с Кири я уже расплатилась».~
@58642 = ~«Спасибо. Приятно было иметь с тобой дело».~
@58643 = ~Ты видишь Роберту. «Снова привет, здоровяк. Могу я чем-то помочь?»~
@58644 = ~«Да, я хотел бы встретиться с Товусом Гильяфом. Как думаешь, это можно устроить?»~
@58645 = ~Ты видишь Роберту, она переполнена яростью. «Ты! Ты глиста, копошащаяся в выгребной яме! Смотри, что со мной из-за тебя стало!» — её лицо такое красное, что кажется, её вот-вот хватит удар.~
@58646 = ~«Из-за меня? Не я замышлял убийство своего супруга».~
@58647 = ~«Мне пора идти. Прощай».~
@58648 = ~Она сужает глаза до щёлок и почти выплёвывает в тебя слова: «Ты предал меня! С каким злорадством Карл говорил о твоём предательстве, прежде чем отправить меня сюда! Ты ублюдок шлюхи!»~
@58649 = ~«Кстати о шлюхах, Кири тоже где-то тут?»~
@58650 = ~«Мне пора идти. Прощай».~
@58651 = ~Она рычит: «Ар-р-р-р-р! Ты знаешь ответ, любитель коз! Хочешь ещё помучить меня, изображая наивную простоту?!»~
@58652 = ~«Допустим, не хочу. Просто расскажи мне, что с ней».~
@58653 = ~«Пойду я. Прощай».~
@58654 = ~«Коварная девка. Она состроила из себя возлюбленную Карла и смогла избежать тюрьмы!»~
@58655 = ~«Умная девушка… Ну, я пошёл. Прощай».~
@58656 = ~Она сверлит тебя взглядом, её глаза горят ненавистью: «Да… проваливай, но знай: я не буду сидеть здесь вечно. А когда выйду — не забуду ни тебя, ни эту шлюху!»~
@58657 = ~Оставить её слова без ответа и уйти.~
@58658 = ~Она отвешивает лёгкий поклон: «Могу я ещё чем-то помочь?»~
@58659 = ~«Да, я хотел бы встретиться с Товусом Гильяфом. Как думаешь, можно это устроить?»~
@58660 = ~«Нет, не думаю. Прощай».~
@58661 = ~Она улыбается: «Товус… извини, здоровяк. Он очень занят в эти дни, и даже меня к нему не пускают».~
@58662 = ~«Спасибо. Прощай».~
@58663 = ~Ты видишь пожилую женщину. При твоём приближении она хмурится и качает головой.~
@58664 = ~«Приветствую».~
@58665 = ~Не обращать на неё внимания.~
@58666 = ~Она фыркает: «Брось, пень. Завязывай с лживыми *приветствиями* и выкладывай, чего надо?»~
@58667 = ~«У меня вопросы…»~
@58668 = ~«Ничего, прощай».~
@58669 = ~«Так задавай», — она не сводит с тебя глаз.~
@58670 = ~«Кто ты?»~
@58671 = ~«Что ты можешь рассказать об этом месте?»~
@58672 = ~«Знаешь что-нибудь о дэве тут внизу?»~
@58673 = ~«Прощай».~
@58674 = ~«Надо же… тоже мне, социальный работник. Меня зовут Рэи, но тебе-то что с моего имени?»~
@58675 = ~«У меня ещё вопрос…»~
@58676 = ~«Прощай».~
@58677 = ~Она мельком оглядывается и пожимает плечами: «Тут тюрьма. Она разделена на три части. Внешняя — для мелкой шушеры. Центральная — для более закоренелых. А настоящие преступники — здесь, внутри».~
@58678 = ~«О каких преступлениях речь?»~
@58679 = ~«У меня другой вопрос…»~
@58680 = ~«Прощай».~
@58681 = ~«Во внешней зоне сидит мелкое ворьё. В центральной — в основном грабители и другие бандюги. Тут, внутри, — убийцы, головорезы, заговорщики и прочие опасные типы», — она улыбается.~
@58682 = ~«Почему ты тут?»~
@58683 = ~«У меня другой вопрос…»~
@58684 = ~«Прощай».~
@58685 = ~Она разражается резким смехом: «Потому что я сделала кое-что плохое! Почему же ещё?» Она отмахивается: «В любом случае это не твоё дело».~
@58686 = ~«У меня другой вопрос…»~
@58687 = ~«Прощай».~
@58688 = ~Она качает головой: «Он не здесь, у него собственная камера… во всяком случае была».~
@58689 = ~«Что ты имеешь в виду?»~
@58690 = ~«У меня ещё вопрос…»~
@58691 = ~«Прощай».~
@58692 = ~«Заключённых из внешней зоны используют для расширения тюрьмы. Они-то и выкапывают место под новые камеры, — она прерывается. — Однажды они откопали что-то типа мелкой пещеры, там и был твой дэв. Думаю, он ещё там».~
@58693 = ~«Где мне его найти?»~
@58694 = ~«У меня другой вопрос…»~
@58695 = ~«Прощай».~
@58696 = ~Она хмурится: «Я ж только что сказала, идиотина. Он во внешней зоне!»~
@58697 = ~«Идиотина?»~
@58698 = ~«У меня другой вопрос…»~
@58699 = ~«Прощай».~
@58700 = ~Она тыкает тебя в грудь костлявым пальцем: «Это ты, пень. Такой круглой идиотины я ещё не видала».~
@58701 = ~«У меня другой вопрос…»~
@58702 = ~«Прощай».~
@58703 = ~Ты видишь Рэи. При твоём приближении она смеётся: «Чего тебе на этот раз, пень?»~
@58704 = ~«У меня вопросы…»~
@58705 = ~«Ничего, прощай».~
@58706 = ~Ты видишь молодого неряшливого парня в грязной одежде. Он настороженно смотрит на тебя.~
@58707 = ~«Приветствую».~
@58708 = ~Не обращать на него внимания.~
@58709 = ~«Чего тебе?» — он нервно окидывает тебя взглядом.~
@58710 = ~«У меня кое-какие вопросы…»~
@58711 = ~«Ничего. Прощай».~
@58712 = ~«И что хочешь знать?»~
@58713 = ~«Кто ты?»~
@58714 = ~«Почему ты здесь?»~
@58715 = ~«Что расскажешь об этом месте?»~
@58716 = ~«Я ищу дэва, слышал, он где-то здесь».~
@58717 = ~«Неважно, прощай».~
@58718 = ~Он колеблется с ответом: «На кой тебе?»~
@58719 = ~«Хочу знать, с кем говорю».~
@58720 = ~«Гонору-то убавь, пока я его из тебя не выбил».~
@58721 = ~«Забудь, у меня другие вопросы…»~
@58722 = ~«Мне нужно идти, прощай».~
@58723 = ~«Я Пито», — он смотрит на тебя со скукой.~
@58724 = ~«У меня другой вопрос…»~
@58725 = ~«Мне нужно идти, прощай».~
@58726 = ~Лицо парня искажает гнев, он открывает рот с явным намерением дерзко ответить. Но затем замечает твои шрамы и сразу передумывает: «Извиняй, меня зовут Пито».~
@58727 = ~«У меня ещё вопросы…»~
@58728 = ~«Мне нужно идти, прощай».~
@58729 = ~Он ухмыляется: «Да заловили, когда хотел *одолжить* кое-какие вещички у местного торгаша. Ему это не особо понравилось, вот меня и бросили сюда».~
@58730 = ~«Так ты вор».~
@58731 = ~«Ясно. У меня другие вопросы…»~
@58732 = ~«Мне нужно идти, прощай».~
@58733 = ~Он одаривает тебя сердитым взглядом: «Можно сказать и так».~
@58734 = ~«Ясно. У меня другие вопросы…»~
@58735 = ~«Мне нужно идти, прощай».~
@58736 = ~«Отвали, пень. Надоел, — он фыркает и комично осматривая себя с верху до низу. — Я похож на экскурсовода?»~
@58737 = ~«Нет, но похоже, что у тебя серьёзные проблемы со здоровьем».~
@58738 = ~«У меня вопрос о другом…»~
@58739 = ~«Прощай».~
@58740 = ~Он смотрит озадаченно: «О чём ты? У меня нет проблем со здоровьем».~
@58741 = ~«Будут, если не ответишь на мои вопросы».~
@58742 = ~«Неважно, у меня ещё вопросы…»~
@58743 = ~«Прощай».~
@58744 = ~Он явно хочет выругаться, но быстро остывает и передумывает: «Тюрьма тут. У неё три части: внешнее кольцо, центральное и внутреннее».~
@58745 = ~«Расскажи о внешнем кольце».~
@58746 = ~«Расскажи о центральном кольце».~
@58747 = ~«Расскажи о внутреннем кольце».~
@58748 = ~«Ясно. У меня другой вопрос…»~
@58749 = ~«Прощай».~
@58750 = ~«Сейчас ты как раз в нём. Сюда сажают за всякие мелкие грешки. В основном, карманников, драчунов и прочую шушеру».~
@58751 = ~«Расскажи о центральном кольце».~
@58752 = ~«Расскажи о внутреннем кольце».~
@58753 = ~«Ясно. У меня другой вопрос…»~
@58754 = ~«Прощай».~
@58755 = ~«Центральное кольцо для типов поопаснее. Там рэкетиры, головорезы, пни, которые устроили мокруху случайно или в порыве страсти».~
@58756 = ~«Расскажи о внешнем кольце».~
@58757 = ~«Расскажи о внутреннем кольце».~
@58758 = ~«Ясно. У меня другой вопрос…»~
@58759 = ~«Прощай».~
@58760 = ~«Внутреннее кольцо для тех, кого посчитали угрозой: насильников, убийц, врагов власти».~
@58761 = ~«Расскажи о внешнем кольце».~
@58762 = ~«Расскажи о центральном кольце».~
@58763 = ~«Ясно. У меня другой вопрос…»~
@58764 = ~«Прощай».~
@58765 = ~«Ты о Триасе? — он хмурится и на миг отводит взгляд. — Да, он тут, внизу. Вот ведь непруха».~
@58766 = ~«Почему ты так говоришь?»~
@58767 = ~«Стража использует нас как шестёрок для расширения тюрьмы. Как только им нужны новые камеры — нас запрягают копать. И вот как-то раз мы откопали пещеру, в которой сидел Триас, — он замолкает и хмурится. — А вскоре после этого разразилась эпидемия».~
@58768 = ~«Да. Припоминаю, мне говорили. И насколько всё было плохо?»~
@58769 = ~«Эпидемия?»~
@58770 = ~«У меня вопрос о другом…»~
@58771 = ~«Прощай».~
@58772 = ~«Плохо… сотни померли, куча народу заразилось, — он прерывается. — Но сейчас она вроде как под контролем. За последнее время новых жертв не было».~
@58773 = ~«Ясно. Так где мне найти Триаса?»~
@58774 = ~«У меня вопрос о другом…»~
@58775 = ~«Прощай».~
@58776 = ~Он качает головой: «Не знаю, меня туда копать не посылали. Просто посматривай по сторонам и найдёшь».~
@58777 = ~«У меня ещё вопрос…»~
@58778 = ~«Прощай».~
@58779 = ~Он кивает: «Да, страшная. Она поразила нас сразу же после раскопки его пещеры. Как пожар прокатилась».~
@58780 = ~«И насколько всё было плохо?»~
@58781 = ~Ты видишь воришку Пито: «Привет-привет. Чего тебе?»~
@58782 = ~«У меня кое-какие вопросы…»~
@58783 = ~«Ничего, прощай».~
@58784 = ~Ты видишь самого обычного торговца. Он улыбается и кивает тебе.~
@58785 = ~«Приветствую».~
@58786 = ~Не обращать на него внимания.~
@58787 = ~~
@58788 = ~~
@58789 = ~Он кивает: «И я тебя тоже. Я Мурк. Нет желания что-нибудь прикупить?»~
@58790 = ~«У меня кое-какие вопросы…»~
@58791 = ~«Что у тебя есть?»~
@58792 = ~«Нет, прощай».~
@58793 = ~Он качает головой и хмурится: «Я не продаю информации. Вопросы задавай кому-нибудь другому».~
@58794 = ~«Хорошо, что у тебя есть?»~
@58795 = ~«Ясно. Прощай».~
@58796 = ~Его глаза загораются, а на лице расцветает злобная улыбка: «Что ж… у меня прекрасный выбор секир и латных рукавиц. Нет ничего лучше, чем собственными руками разрубить противника на две половинки».~
@58797 = ~«Покажи мне свой товар».~
@58798 = ~«Неважно. Прощай».~
@58799 = ~Ты видишь торговца Мурка. Он кивает при твоём приближении: «Снова привет. Чем могу служить?»~
@58800 = ~«Что у тебя есть?»~
@58801 = ~«Покажи мне свой товар».~
@58802 = ~«Прощай».~
@58803 = ~Ты видишь пожилого мужчину в грязной рабочей одежде. Он хмурится при твоём приближении.~
@58804 = ~«Приветствую».~
@58805 = ~Не обращать на него внимания.~
@58806 = ~Он хмурится сильнее: «Ну… здравствуй, пень. Чего это ты надумал шкатулкой греметь? У меня полно дел».~
@58807 = ~«У меня пара вопросов…»~
@58808 = ~«Не бери в голову. Прощай».~
@58809 = ~Он вздыхает: «Только быстро, усёк?»~
@58810 = ~«Кто ты?»~
@58811 = ~«Чем ты занят?»~
@58812 = ~«Что ты можешь рассказать об этом месте?»~
@58813 = ~«Я ищу дэва. Мне сказали, что он в Керсте».~
@58814 = ~«Мне пора идти. Прощай».~
@58815 = ~«Не то чтоб это твоё дело, но меня зовут Лейгис».~
@58816 = ~«У меня другой вопрос…»~
@58817 = ~«Мне пора идти. Прощай».~
@58818 = ~Он фыркает: «Болтаю с дурнем, хотя должен вкалывать…»~
@58819 = ~«У меня другой вопрос…»~
@58820 = ~«Мне пора идти. Прощай».~
@58821 = ~Он оглядывается: «Это склад, чокнутый пень. Чего тебе ещё надо?»~
@58822 = ~«У меня ещё вопрос…»~
@58823 = ~«Мне пора идти. Прощай».~
@58824 = ~Мужчина окидывает тебя угрюмым взглядом и качает головой. «Искать дэва в Керсте… — он разражается смехом. — Заодно поискал бы и девственницу в борделе. Удачи тебе, пень».~
@58825 = ~«У меня ещё вопрос…»~
@58826 = ~«Мне пора идти. Прощай».~
@58827 = ~Ты видишь Лейгиса, складского рабочего. Он хмурится при твоём приближении: «Ты вернулся. Чего надо?»~
@58828 = ~«У меня пара вопросов…»~
@58829 = ~«Ничего, прощай».~
@58830 = ~«Что случилось?»~
@58831 = ~«Тогда прощай».~
@58832 = ~«Хорошо. Прощай».~
@58833 = ~«Ладно-ладно».~
@58834 = ~«Просто брожу».~
@58835 = ~«Что ты можешь сказать об этих доспехах?»~
@58836 = ~«Ищу дэва».~
@58837 = ~«Ничего. Прощай».~
@58838 = ~Драться.~
@58839 = ~Бежать.~
@58840 = ~«Бродишь? В тюрьме? Ты пришёл, чтобы устроить побег!» — он направляет на тебя оружие!~
@58841 = ~«Не знаю. Сколько помню, они были частью тюрьмы. Мы не можем открыть камеру, как бы ни пытались. Славный комплект доспехов, да только не заполучить никак. А теперь ответь-ка мне на вопрос: что ты тут внизу делаешь?»~
@58842 = ~Он улыбается: «Совсем скоро ты присоединишься к их божественному хору, пень». Затем достаёт оружие и нападает!~
@58843 = ~Ты видишь одного из стражей порядка Керста. Вид у него скучающий: «Чего тебе? Разве не знаешь, что у нас тут карантин?»~
@58844 = ~«И чего тебе теперь?»~
@58845 = ~«Мы здесь в изоляции из-за эпидемии. Не знаю, что её вызвало, но мы под карантином, пока она не пройдёт. Что-то ещё?»~
@58846 = ~«Что, бюргера? Он в административном здании. Вот только удачи попасть к нему. В последние дни он *никого* не принимает. Его голова явно забита чем-то другим…»~
@58847 = ~«Госпожа Роберта?» — он задумчиво морщит лоб. «Выясним, — он смотрит в сторону. — О. Спасибо».~
@58848 = ~«Это не тема для шуток. Мы расследуем его смерть со всей серьёзностью. Кто бы это ни сделал, он сядет в тюрьму надолго».~
@58849 = ~Он качает головой: «Может, я покажусь тебе глупым, пень, но в политические дрязги я стараюсь не влезать. Я ценю свою работу… и свою жизнь. Поговори с капитаном».~
@58850 = ~«Арестовать тебя? За что?»~
@58851 = ~«Тогда ты ищешь не на том краю Великого Кольца, пень, потому как если и есть здесь хоть один, то ты его не найдёшь. Он заперт, как золото скупца».~
@58852 = ~Он ухмыляется: «Добродетель сама по себе награда, верно? Если хочешь чего-то ещё, поговори с кем-нибудь поглавней».~
@58853 = ~«Уладим это по-тихому или придётся применять насилие?»~
@58854 = ~«Если ты настаиваешь. Пойдём».~
@58855 = ~«Ты меня убедил. Тогда пошли».~
@58856 = ~«Слишком поздно, пень. Уладим это по-тихому или нет?»~
@58857 = ~~
@58858 = ~Бежать.~
@58859 = ~Драться.~
@58860 = ~«Ищу дэва».~
@58861 = ~«Просто брожу».~
@58862 = ~Драться.~
@58863 = ~Бежать.~
@58864 = ~«Что ты можешь рассказать об этом месте?»~
@58865 = ~«Госпожа Роберта строит планы по убийству своего мужа Карла. Я думаю, он из советников бюргера».~
@58866 = ~«Я хочу признаться в убийстве Карла Парфидора».~
@58867 = ~«Один из чиновников города просил меня убить другого чиновника. Я решил, что должен предупредить».~
@58868 = ~«Я хочу, чтобы ты меня арестовал».~
@58869 = ~«Я ищу дэва».~
@58870 = ~«Хочу увидеть того, кто всем тут заправляет».~
@58871 = ~«Один из чиновников города просил меня убить другого чиновника. Я решил, что должен предупредить».~
@58872 = ~«Что ты можешь рассказать об этом месте?»~
@58873 = ~«Хочу увидеть того, кто всем тут заправляет».~
@58874 = ~«Госпожа Роберта строит планы по убийству своего мужа Карла. Я думаю, он из советников бюргера».~
@58875 = ~«Я хочу признаться в убийстве Карла Парфидора».~
@58876 = ~«Один из чиновников города просил меня убить другого чиновника. Я решил, что должен предупредить».~
@58877 = ~«Я хочу, чтобы ты меня арестовал».~
@58878 = ~«Я ищу дэва».~
@58879 = ~«Один из чиновников города просил меня убить другого чиновника. Я решил, что должен предупредить».~
@58880 = ~«Я хотел задать ещё пару вопросов…»~
@58881 = ~«Нет. Прощай».~
@58882 = ~«Я хотел задать ещё пару вопросов…»~
@58883 = ~«Тогда прощай».~
@58884 = ~«А что, разве за это не полагается награда?»~
@58885 = ~«Я хотел задать ещё пару вопросов…»~
@58886 = ~«Прощай».~
@58887 = ~«Я серьёзно. Его убил я».~
@58888 = ~«Ой. Прости за шутку. У меня ещё вопросы…»~
@58889 = ~«Ох, прости. Прощай».~
@58890 = ~«Хорошо. Тогда у меня ещё пара вопросов».~
@58891 = ~«Тогда прощай».~
@58892 = ~«Хочу попасть в тюрьму».~
@58893 = ~«Потому что я полностью безумен! Буга-буга ва-ха-ха!»~
@58894 = ~«Забудь. Ответь мне на вопросы…»~
@58895 = ~«Забудь. Прощай».~
@58896 = ~«Хорошо. У меня ещё пара вопросов…»~
@58897 = ~«Тогда забудь. Прощай».~
@58898 = ~«Тогда как мне найти того, кто поглавней?»~
@58899 = ~«Ладно. У меня ещё пара вопросов…»~
@58900 = ~«Хорошо. Прощай».~
@58901 = ~«Уладим по-тихому».~
@58902 = ~«Просто так я не сдамся».~
@58903 = ~«Я передумал, забудь об этом».~
@58904 = ~«Хорошо. Пошли».~
@58905 = ~«Я передумал, забудь об этом».~
@58906 = ~«Хорошо. Пошли».~
@58907 = ~~
@58908 = ~«Уладим по-тихому».~
@58909 = ~«Просто так я не сдамся».~
@58910 = ~«Хочу взглянуть на оружие и амулеты…»~
@58911 = ~«Хочу снова на взглянуть на экзотику…»~
@58912 = ~Мэри кивает на дверь с южной стороны тронного зала: «У-у-ух-хы-ыди тхы-ыпер. Погхыв-вр-рим поз-зшы-ы…» (Уходи теперь. Поговорим позже.)~
@58913 = ~Уйти.~
@58914 = ~Харгримм торжественно указывает на широкие двери с южной стороны тронного зала Безмолвного Короля. «Теперь уходи, живущий, и помни: никому не говори об увиденном. Понадобится ещё поговорить со мной — сделаем это за пределами сей священной комнаты».~
@58915 = ~Уйти.~
@58916 = ~«Здесь лежит горячо любимая мать Ба'йина, A…» — конец надписи неразборчив.~
@58917 = ~Уйти.~
@58918 = ~Уйти.~
@58919 = ~Эта ветхая постройка на грани полного разрушения. Несколько досок были прибиты недавно, чтобы поддержать обваливающееся здание.~
@58920 = ~Осмотреть строение внимательнее.~
@58921 = ~Уйти.~
@58922 = ~Эта ветхая постройка на грани полного разрушения. Доски, прибитые дабусом, были убраны, восстановив хибару в её первоначальном, полуразрушенном виде.~
@58923 = ~Уйти.~
@58924 = ~Я «поговорил» с Лающим-Дикарём около бара «Горящий труп». К моему удивлению, он не только знает о моём дневнике, но даже сказал, что их было несколько. По его словам, один из них «на стенах гробницы, запечатанной глубоко под городом, где плачут камни». Второй — «в шкафу моей гостевой комнаты в зале Чующих», можно найти и другие. Я не очень доверяю его информации, но он был похож на здравомыслящего, когда говорил о дневниках.~
@58925 = ~Кви-Сай отказался тренировать меня на воина, сославшись на преимущества магов — подобно предыдущему аргументу о ворах — над воинами. Он посоветовал мне обучаться у наставника магов Фестхолла или, если я не хочу быть волшебником, поговорить с наставником магов и найти контраргумент его высказываниям.~
@58926 = ~Кви-Сай наконец согласился потренировать меня и сказал, чтобы я встретился с ним в зале подготовки воинов Фестхолла.~
@58927 = ~*Зерт* Кии'на обучила многим фразам языка гитцерай. Язык основан на метафорах, аллегориях и афоризмах из истории гитцерай.~
@58928 = ~Он качает головой: «Может, я покажусь тебе глупым, пень, но в политические дрязги я стараюсь не влезать. Я ценю свою работу… и свою жизнь. Поговори с капитаном. Он у ворот среднего города, встретишь сразу, как перейдёшь в другую часть города».~
@58929 = ~«Ничего. Прощай».~
@58930 = ~«Хорошо. У меня пара других вопросов…»~
@58931 = ~«Тогда прощай».~
@58932 = ~«Ничего. Прощай».~
@58933 = ~«Что за… ПОБЕГ!» — стражник нападает!~
@58934 = ~Драться.~
@58935 = ~Бежать.~
@58936 = ~«Нет, дай мне подумать. До встречи».~
@58937 = ~Ты видишь дородного головореза. Его лицо в шрамах и каждой складкой повествует о былом насилии, а в голосе словно перекатывается галька: «Чё те надо, пень?»~
@58938 = ~Нельзя убрать это оружие~
@58939 = ~Nordom Location, Cube (Bizarre, clockwork dungeon) 1~ [NOR045]
@58940 = ~Nordom Location, Negative Material Plane (The Underworld) 1~ [NOR046]
@58941 = ~Nordom Location, Керст (Desert Prison Town) 1~ [NOR049]
@58942 = ~Nordom Carceri 1~ [NOR050]
@58943 = ~Nordom Common 6 3~ [NOR054]
@58944 = ~Nordom Common 6 4~ [NOR055]
@58945 = ~Nordom Common 6 6~ [NOR057]
@58946 = ~Insult Morte Grace 1~ [MRT162]
@58947 = ~Nordom Common 6 11~ [NOR062]
@58948 = ~Nordom Common 6 12~ [NOR063]
@58949 = ~Nordom Action 3 2~ [NOR067]
@58950 = ~Nordom Action 3 23~ [NOR088]
@58951 = ~Nordom Action 3 24~ [NOR089]
@58952 = ~Nordom Rare 4 1~ [NOR093]
@58953 = ~Nordom Rare 4 2~ [NOR094]
@58954 = ~Nordom Rare 4 3~ [NOR095]
@58955 = ~Nordom Rare 4 5~ [NOR097]
@58956 = ~Insult Morte Nordom 2~ [MRT160]
@58957 = ~Ravel Damage 2~ [RAV011]
@58958 = ~Ravel Damage 4~ [RAV013]
@58959 = ~Ravel Dying 1~ [RAV014]
@58960 = ~Ravel Hostile Dialogue 1~ [RAV051]
@58961 = ~Ravel Spell-Casting 1~ [RAV059B]
@58962 = ~Ravel Spell-Casting 2~ [RAV060B]
@58963 = ~Insult Morte Nordom 1~ [MRT159]
@58964 = ~Trias Damage 4~ [TTB011]
@58965 = ~Trias Damage 8~ [TTB015]
@58966 = ~Trias Dying 4~ [TTB020]
@58967 = ~Trias Hostile Dialogue 4~ [TTB071]
@58968 = ~Trias Spell-Casting 1~ [TTB079]
@58969 = ~Trias Spell-Casting 6~ [TTB084]
@58970 = ~Forked-Tongue Dying 2~ [FFT009]
@58971 = ~Forked-Tongue Spell-Casting 5~ [FFT053]
@58972 = ~Forked-Tongue Spell-Casting 3~ [FFT051A]
@58973 = ~Morte Morale 4~ [MRT006]
@58974 = ~Morte Happy 5~ [MRT011]
@58975 = ~Morte Annoyed 3~ [MRT016]
@58976 = ~Morte Serious 1~ [MRT018]
@58977 = ~Morte Tired 1~ [MRT028]
@58978 = ~Morte Bored 11~ [MRT042]
@58979 = ~Morte Dying 1~ [MRT073A]
@58980 = ~Morte Hurt (Was Damage 6)~ [MRT061]
@58981 = ~Morte Location, Hive (Slums) 6~ [MRT083]
@58982 = ~Morte Location, Hive (Slums), Night 1~ [MRT084A]
@58983 = ~Едва ты для осмотра берёшься за железный слиток обеими руками, раздаётся *шипение* и металл испаряется, оставив после себя странный кинжал, пригоршню монет в грязной тряпке и две слезы кровавого цвета. Похоже, всё это было *внутри* куска металла.~
@58984 = ~Взять предметы и уйти.~
@58985 = ~«Благодарю за помощь. Попробую собрать своих друзей… — мгновение он молчит. — Каких найду. Теперь иди».~
@58986 = ~«Удачи тебе. Прощай».~
@58987 = ~Ты видишь тощего мужчину с сильно загорелой кожей и пронзительными зелёными глазами. «Добро пожаловать на винокурню братьев Малако! — вопит он, словно рад тебе, как никому другому. — Что я могу для тебя сделать сегодня?»~
@58988 = ~«Кто ты?»~
@58989 = ~«Что это за место?»~
@58990 = ~«Слышал, у тебя с братом некоторые разногласия. Я хочу помочь».~
@58991 = ~«Слышал что-нибудь о дэве в этом городе?»~
@58992 = ~«Я хочу кое-что купить».~
@58993 = ~«Меня прислал твой брат. Он сказал, что хочет уладить проблему с разделом наследства вашего отца».~
@58994 = ~«Я Кестер Малако, хозяин и владелец половины винокурни братьев Малако. Могу я что-нибудь тебе предложить?»~
@58995 = ~«Владелец половины?»~
@58996 = ~«А кто другой брат?»~
@58997 = ~«Спасибо, не сейчас. Как понимаю, у тебя с братом некоторые разногласия? Я хочу помочь».~
@58998 = ~«Слышал что-нибудь о дэве в этом городе?»~
@58999 = ~«Покажи, что у тебя есть».~
@59000 = ~«Меня прислал твой брат. Он сказал, что хочет уладить проблему с разделом наследства».~
@59001 = ~Он пристально на тебя смотрит: «Это винокурня. Мы продаём здесь почти всё — от выпивки до микстур, включая различные амулеты и прочее. Хочешь что-нибудь купить?»~
@59002 = ~Шлюха Кири готова ради денег на что угодно, даже кого-нибудь убить. Возможно, она согласится убить Карла Парфидора для Роберты.~
@59003 = ~Я разрешил спор между винокуром и кузнецом, разделив наследство пополам. Они оба были недовольны.~
@59004 = ~Я разрешил спор между винокуром и кузнецом в пользу винокура, отдав наследство ему. В награду он дал мне мешочек монет.~
@59005 = ~Я разрешил спор между винокуром и кузнецом, оставив с носом обоих. Они были недовольны.~
@59006 = ~Я разрешил спор между винокуром и кузнецом в пользу кузнеца, отдав наследство ему. Винокур был недоволен.~
@59007 = ~И не знаю, оскорбляться или радоваться… Фарод просто сказал своей «дочери» проводить меня туда, где она нашла моё тело. Какая-то аллея с призраками. Ещё он сказал, что если по пути мы разойдёмся с его дочерью, то мне стоит вернуться и он укажет дорогу…~
@59008 = ~«Да».~
@59009 = ~«Не сейчас. Прощай».~
@59010 = ~«Что, в Керсте? — он добродушно смеётся. — Друг, если бы ты подольше прожил в Керсте, то знал бы, что здесь нет никакого дэва. Поищи в Стойкости или одном из остальных городов на другой стороне Великого Кольца. А пока не желаешь что-нибудь приобрести?»~
@59011 = ~«Желаю».~
@59012 = ~«Нет, спасибо. Прощай».~
@59013 = ~«Да, конечно. Мой брат тоже участвует в прибылях, хотя я не знаю, как это можно назвать „участием“, ведь он сюда даже не заглядывает. Слушай, купить что-нибудь хочешь?»~
@59014 = ~«Что ты можешь рассказать о своём брате?»~
@59015 = ~«Да. Что у тебя есть?»~
@59016 = ~«Меня прислал твой брат. Он сказал, что хочет уладить проблему с разделом наследства».~
@59017 = ~Лицо Кестера мрачнеет: «Его имя Крамплпанч. Он местный кузнец. Он делает всё возможное, чтобы не дать мне преуспеть, а… зачем я тебе это рассказываю? Ты мне совершенно незнаком».~
@59018 = ~«Я хочу помочь».~
@59019 = ~«Не знаю. Что у тебя есть на продажу?»~
@59020 = ~«Я не знаю. Прощай».~
@59021 = ~«Хочешь, да? Ладно. Взгляни сюда. Это копия завещания, что оставил нам отец. Вот тут: видишь, чёрным по белому написано, что все деньги должны пойти на улучшение винокурни, а не просто быть поделены между нами обоими. Но мой глупый брат настаивает, что мы должны взять деньги, а не отстраивать винокурню. Втолкуй это в его тупую голову или забери его копию завещания, и я тебя вознагражу».~
@59022 = ~«Мне понадобится твоя копия завещания, чтобы тщательно изучить».~
@59023 = ~«Хорошо. Я вернусь. До свидания».~
@59024 = ~Я согласился помочь винокуру Кестеру в конфликте с его братом, кузнецом Крамплпанчем, из-за раздела наследства.~
@59025 = ~Он смотрит на тебя подозрительно, затем уступает: «Если она поможет тебе быстрее всё уладить, то ладно. Держи». Он протягивает пергамент тебе.~
@59026 = ~«Прекрасно. До свидания».~
@59027 = ~«Добро пожаловать к братьям Малако! Что могу для тебя сделать сегодня?»~
@59028 = ~«Кто ты?»~
@59029 = ~«Что это за место?»~
@59030 = ~«Слышал, у тебя с братом некоторые разногласия. Я хочу помочь».~
@59031 = ~«Слышал что-нибудь о дэве в этом городе?»~
@59032 = ~«Я хочу кое-что купить».~
@59033 = ~«Меня прислал твой брат. Он сказал, что хочет уладить проблему с разделом наследства вашего отца».~
@59034 = ~«Что тебе нужно?»~
@59035 = ~«Я хочу кое-что купить».~
@59036 = ~«Твой брат согласен принять меня в роли посредника. А ты?»~
@59037 = ~«Твой брат согласен принять меня в роли посредника. А ты?»~
@59038 = ~«Твой брат предложил мне денег, чтобы я разрешил спор между вами в его пользу».~
@59039 = ~«Будет сделано. Хочу взглянуть на товары».~
@59040 = ~«Оно приближается. Я вернусь к тебе. До встречи».~
@59041 = ~«Ну, я… проклятье! Ладно. Держи. Это моя копия завещания. Как следует изучи её и скажи одному из нас, что ты решил».~
@59042 = ~«Я вернусь. До свидания».~
@59043 = ~«Ну, я… проклятье! Ладно. Как следует изучи наши завещания и скажи одному из нас, что ты решил».~
@59044 = ~«Я вернусь. До свидания».~
@59045 = ~«Ты уже вынес вердикт?»~
@59046 = ~«Я вынес решение в твою пользу. После прочтения завещаний мне ясно, что всё наследство должно перейти к тебе».~
@59047 = ~«Я решил, что все деньги должны достаться твоему брату. Абсолютно ясно, что это его право».~
@59048 = ~«Вы должны разделить деньги поровну. Совершенно ясно, что ваш отец желал именно этого».~
@59049 = ~«Никто из вас не заслуживает денег. Я отдам ваши завещания тому, кто должным образом распорядится деньгами. Прощай».~
@59050 = ~«Ещё нет. Однако я хочу глянуть твой товар».~
@59051 = ~«Ещё нет. До свидания».~
@59052 = ~«О, вот как, да? Что ж, я значительно увеличу твою награду, если решение будет в мою пользу… скажу тебе вот что: возьми его копию завещания, изучи её и уговори брата назначить тебя судьёй в этом деле. Ты будешь хорошо вознаграждён. Как тебе предложение?»~
@59053 = ~«Идёт. Пойду поговорю с ним. А пока хочу глянуть твой товар».~
@59054 = ~«Идёт. Пойду поговорю с ним. До встречи».~
@59055 = ~«Думаю, я приму его сторону. Он должен получить всё наследство».~
@59056 = ~«Ха! Ха-ха-ха! Я так и знал! — он суёт тебе в руку мешочек монет. — Благодарю тебя, друг мой, возвращайся в любое время! А сейчас извини, время хорошенько отметить!»~
@59057 = ~«Конечно. До встречи».~
@59058 = ~Его лицо становится пунцовым, и он кричит: «ЧТО? АХ ТЫ ПАРШИВЫЙ ВОР! ПРОВАЛИВАЙ ИЗ МОЕГО МАГАЗИНА! ВОН!»~
@59059 = ~«Хорошо, хорошо. Я ухожу».~
@59060 = ~Он лепечет: «Но… но… это просто… но…» Он вздыхает с угрюмым выражением лица. «Ладно. Я полагаюсь на твоё слово. Но больше не жди от меня хорошего отношения. Проваливай из моего магазина, — он швыряет в тебя мешочек с монетами. — Я тебе это обещал. Забирай и проваливай».~
@59061 = ~«Спасибо. Прощай».~
@59062 = ~«Добро пожаловать! Чем могу помочь?» — он определённо полон энтузиазма.~
@59063 = ~«Просто хочу посмотреть твой товар».~
@59064 = ~«Спасибо, ничем. Прощай».~
@59065 = ~~
@59066 = ~«Убирайся из магазина, пока я не вызвал стражу. Сейчас же».~
@59067 = ~«Хорошо, я ухожу».~
@59068 = ~~
@59069 = ~Ты видишь молодую симпатичную женщину. Всё её лицо красное и в синяках, а волосы растрёпаны. Одежда элегантная, но местами разорвана. Она настороженно переходит улицу, время от времени с опаской оглядываясь через плечо.~
@59070 = ~«Приветствую».~
@59071 = ~Не обращать на неё внимания.~
@59072 = ~Она подпрыгивает от твоего приветствия и оборачивается к тебе. Её глаза пробегают по твоим шрамам, и лицо принимает обеспокоенный вид: «Привет, здоровяк. Я Кири, чем могу помочь?»~
@59073 = ~«Я вижу, ты встревожена. В чём дело?»~
@59074 = ~«Ничем, прощай».~
@59075 = ~Она хмурится, затем пожимает плечами: «Просто есть люди, которым я не нравлюсь. Я стараюсь по возможности избегать их».~
@59076 = ~«Почему ты им не нравишься?»~
@59077 = ~«Мне пора идти. Прощай».~
@59078 = ~«Я проститутка. Я молода, симпатична… и хороша в своём деле, — она улыбается. — Остальные девочки говорят, что я перебиваю у них клиентов. Поэтому они избили меня и сказали больше тут не светиться. Сказали, что подправят личико, если ещё раз застанут здесь».~
@59079 = ~«Тогда зачем ты вернулась?»~
@59080 = ~«Мне пора идти. Прощай».~
@59081 = ~Она смеётся. «За бабками, за чем же ещё? Я не могу никуда уехать без бабок и не могу достать денег другим способом. Я здорово влипла, — она вздыхает и отводит взгляд. — На *что угодно* пойду, лишь бы достать денег…»~
@59082 = ~Кири~
@59083 = ~«На что угодно?»~
@59084 = ~Она основательно обдумывает твои слова и лишь затем отвечает: «Конечно, здоровяк. И на это тоже. Ты предлагаешь сделку?»~
@59085 = ~«Нет, просто любопытствую».~
@59086 = ~«Некая особа хочет видеть своего мужа мёртвым. Он обожает шлюх, а она их ненавидит».~
@59087 = ~Она пожимает плечами: «Ну, как я сказала, мне нужны бабки и ради них я готова на что угодно».~
@59088 = ~«Буду иметь в виду. До свидания».~
@59089 = ~«Обожает шлюх, да? Ну, думаю, я прямо создана для такой работёнки, — она смеётся. — Кто жертва?»~
@59090 = ~«Карл Парфидор».~
@59091 = ~Она задумчиво хмурится, потом кивает: «Я знаю Карла… и его жену». Секунду она колеблется, затем пожимает плечами: «Скажи Роберте, что если она хочет видеть Карла мёртвым, то я возьмусь».~
@59092 = ~«Разве тебя не интересует, что причитается за работу?»~
@59093 = ~Она коварно улыбается: «Нет, не особенно. Если она меня надует, то я убью и её тоже… сразу после её дорогого Карла. Так можешь ей и передать».~
@59094 = ~«Так и передам. До встречи».~
@59095 = ~Ты видишь проститутку Кири. Она настороженно наблюдает за окружающими. Увидев тебя, она улыбается: «Снова привет, здоровяк. Что я могу для тебя сделать?»~
@59096 = ~«Я вижу, ты встревожена. В чём дело?»~
@59097 = ~«При нашей прошлой встрече ты намекнула, что за деньги готова на что угодно».~
@59098 = ~«Я поговорил с Робертой. Она хочет скорейшей смерти Карла и хочет, чтобы за это взялась ты».~
@59099 = ~«Ничего, прощай».~
@59100 = ~Я нанял проститутку Кири, чтобы убить Карла Парфидора. Она сказала, что тотчас всё уладит.~
@59101 = ~Она улыбается: «Можешь передать Роберте, что она купила Карлу место в книге мёртвых. Я тотчас всё улажу».~
@59102 = ~«Хорошо, прощай».~
@59103 = ~Это покосившееся строение выглядит так, будто простояло сотни лет. Его деревянные стены испорчены погодой и возрастом. Некоторые доски с фасада почти оторваны, работа явно недавняя.~
@59104 = ~Ты держишь в руках «Небесный огонь», клинок горит белым пламенем и поёт в твоём сознании. Внезапно в голове вспыхивает отчётливая мысль, что ты можешь по своему желанию придавать форму этому оружию.~
@59105 = ~Осмотреть строение.~
@59106 = ~Уйти.~
@59107 = ~Оторванные доски аккуратно приколочены на свои места, и теперь старое здание восстановило свой подорванный исключительный шарм.~
@59108 = ~Уйти.~
@59109 = ~Я отдал Меббет чернила, и она согласилась обучить меня Искусству. Надеюсь, оно того стоило… я чувствовал себя идиотом, когда тащился по всему Улью с кружкой этих чернил, стараясь их не расплескать. Я начинаю думать, что все «психи» Улья на самом деле не психи, а просто выполняют поручения Меббет.~
@59110 = ~Достать бронзовую сферу для Фарода.~
@59111 = ~Я встретил Фарода в Похороненной деревне. Он сказал, что расскажет мне всё, что я пожелаю… но только после того, как я кое-что для него сделаю. Он хочет, чтобы я спустился в катакомбы под Похороненной деревней и принёс ему оттуда бронзовую сферу. Фарод думает, что сфера находится в самой глубокой части подземелья с затопленными проходами. Вход в ближнюю часть катакомб находится на юго-востоке деревни, за воротами… Фарод сказал упомянуть о моём задании страже, тогда они откроют ворота и выпустят меня.~
@59112 = ~Когда я вернул старому заике бронзовую сферу, он выдавил из себя всё, что на *самом деле* знал обо мне. Но этого было крайне немного. Фарод сказал, что его «дочь» Анна нашла моё тело, и указал место, где я был найден. Стоит сходить туда и проверить — может, там остались какие-нибудь зацепки.~
@59113 = ~Найти место, где Анна обнаружила твоё тело.~
@59114 = ~Когда я вернул старому заике бронзовую сферу, он выдавил из себя всё, что на *самом деле* знал обо мне. Но этого было крайне немного. Фарод сказал, что его «дочь» нашла моё тело, и указал место, где я был найден. Стоит сходить туда и проверить — может, там остались какие-нибудь зацепки. Оказалось, что моё тело валялось в одном из переулков Улья, недалеко от бара «Горящий труп»… но дорогу туда преграждает логово Хаоситов.~
@59115 = ~Я пришёл в переулок, где Анна нашла моё тело. Посмотрим, что же мне удастся тут обнаружить.~
@59116 = ~Найти Краддока по просьбе Баена Посыльного.~
@59117 = ~Я согласился доставить сообщение от человека по имени Баен. Баен сказал, что тот, кому я должен доставить сообщение, носит имя «Краддок», и что он надсмотрщик на рынке где-то в Улье. Единственное описание, которое смог дать мне Баен, — это что Краддок суровый человек гигантского роста. Буду посматривать по сторонам. Если встречу Краддока, то мне нужно передать ему сообщение и вернуться к Баену.~
@59118 = ~Я рассказал Баену, что доставил сообщение Краддоку. Он был рад и неплохо мне заплатил.~
@59119 = ~Наконец-то я получил у Мейр'ам полную кружку чернил. Теперь мне надо отнести эту гадость Меббет… может, мне удастся заставить её выпить их.~
@59120 = ~Отыскать Джелая по просьбе Краддока.~
@59121 = ~Краддок рассердился, когда я доставил ему сообщение от Баена… очевидно, Краддок потерял одного из своих рабочих, пьянчугу-тифлинга по имени Джелай. Краддок сказал, что, вероятнее всего, Джелай шляется где-то возле бара «Горящий труп». Я пообещал поискать того и доложить о результатах.~
@59122 = ~Я нашёл Джелая, причём он был не только пьян в дым, но ещё и просил меня передать Краддоку, что тот «шавка» и что может «отвалить со своей работой». Я вернулся к Краддоку, и того явно не слишком обрадовал ответ Джелая.~
@59123 = ~Я нашёл Джелая, причём он был не только пьян в дым, но ещё и просил меня передать Краддоку, что тот «шавка» и что может «отвалить со своей работой». Я вернулся к Краддоку, но вместо настоящего ответа Джелая, сказал, что тот попросил меня поработать вместо него… лишние медяки никогда не помешают.~
@59124 = ~Найти могильный камень для Эс-Аннона.~
@59125 = ~В Улье я встретил бродячего монаха, оплакивающего разрушенный город Эс-Аннон. Очевидно, он один из его последних жителей и теперь путешествует по планам, пытаясь сохранить память о своём городе. Чтобы освободить глашатая от его бремени, я предложил использовать могильный камень, на котором будет имя «Эс-Аннон». Поищу, пожалуй, такой камень и позабочусь, чтобы имя было высечено. Потом надо будет вернуться и сообщить об этом глашатаю.~
@59126 = ~Я высек имя Эс-Аннон на мемориале Пыльных, потом вернулся и рассказал Глашатаю. Его слёзы немедленно исчезли, и он поблагодарил меня за помощь.~
@59127 = ~Разобраться с проблемой ходячих мертвецов в мавзолее.~
@59128 = ~Выследить вора, притворяющегося Пыльным.~
@59129 = ~Норочи, Пыльный из бара «Собиратели пыли», попросил меня выследить вора, переодевшегося Пыльным, и пресечь возможную дискредитацию фракции его действиями.~
@59130 = ~Я разобрался с вором, который притворялся Пыльным; больше он не будет создавать проблем фракции Норочи.~
@59131 = ~По поручению Эморика поговорить с Норочи и выполнить его просьбу.~
@59132 = ~Дневник в костяном каркасе~
@59133 = ~ЧЕТВЁРТЫЙ КРУГ ЗЕРТИМОНА
Позволяет записать «Глаз Вилкуара» в книгу заклинаний
Дистанция: 45 футов + 15 футов / уровень
Длительность: 30 секунд
Время чтения: 1
Зона действия: 1 существо
Спасбросок: отменяет
Вес: 1
Доступно: магам и Безымянному

На каменной пластине Четвёртого Круга Зертимона высечено:

«*Знай*, что подготовка Восстания Народа против *иллитидов* заняла великое множество циклов. Многие из Народа собирали и хранили секреты свержения своих хозяев *иллитидов*. Они научились защищать свои разумы и использовать их как оружие. Они познали писание стали и, что самое главное, они *познали* свободу».

«Некоторые из Народа познали свободу и хранили её в своих сердцах. *Знание* дало им силу. Остальные боялись свободы и молчали. Но были также те, кто *познали* свободу, и *познали* рабство, и выбрали для себя и всего Народа оковы. Одним из них был Вилкуар».

«Вилкуар не знал *свободы*, но видел в Восстании возможность. Он видел, что *иллитиды* широко расселились по Псевдомирам. Количество их миров было столь огромным, что они смотрели только на внешнюю сторону своих владений, на те миры, которые они ещё не захватили. Глаз Вилкуара видел, что многих мест *иллитиды* не видят. К Восстанию *иллитиды* были слепы».

«Вилкуар пришёл к своему хозяину *иллитиду* Зхиджитарису со *знанием* о Восстании. Вилкуар возложил на себя новые цепи и предложил хозяину стать его глазами против Восстания. В обмен Вилкуар попросил награды. *Иллитид* согласился».

«С заключением договора настали чёрные времена. Множество предательств совершил Вилкуар и многих из Народа *иллитиды* сожрали в попытках подавить Восстание. Казалось, Восстание погибнет, так и не начавшись, и *иллитиды* были довольны глазом Вилкуара».

«Конец чёрных времён приблизился, когда Зертимон *узнал* о предательствах Вилкуара. *Познав* глаз Вилкуара, Зертимон заставил Восстание затаится, дабы Вилкуар подумал, что его последние предательства достигли цели и Восстание провалилось. Он *знал*, что глаз Вилкуара наполнен лишь жаждой обещанной награды. Он увидит то, что хочет увидеть».

«С грызущей сердце жадностью Вилкуар пришёл к *иллитиду* Зхиджитарису и доложил своему хозяину об успехе. Он сказал, что Восстание провалилось и *иллитиды* снова могут перевести свои взгляды на внешние пределы. Он восхвалил их мудрость за использование глаза Вилкуара и попросил свою награду».

«В своём ослеплении алчностью Вилкуар забыл *знание* того, почему Народ искал свободы. Он забыл о *знании* самого смысла рабства. Он забыл о том, что видели его хозяева *иллитиды*, когда смотрели на него. И предательства Вилкуара против Народа были прекращены другим предательством. Вилкуар *познал*, что когда глазу Вилкуара нечего видеть, то глаз Вилкуара становится бесполезным».

«*Иллитиды* пожаловали Вилкуару награду, вскрыв его череп и сожрав мозг. Пустая оболочка Вилкуара была выброшена на Поля Оболочек, дабы кровь его могла оросить ядовитую траву».~
@59134 = ~Третий Круг Зертимона~
@59135 = ~ТРЕТИЙ КРУГ ЗЕРТИМОНА
Позволяет записать «Сокрытие воли» в книгу заклинаний
Дистанция: 10 футов
Длительность: 12 секунд / уровень
Время чтения: 1
Зона действия: 1 существо
Спасбросок: нет
Вес: 1
Доступно: магам и Безымянному

На каменной пластине Третьего Круга Зертимона высечено:

«Зертимон много циклов работал на *иллитида* Арлатии Дважды-Заражённого и его товарищество в пещерных небесах Псевдомиров. Его обязанности сломили бы многих других, но Зертимон работал, изнемогая и претерпевая страдания».

«И так случилось, что *иллитид* Арлатии Дважды-Заражённый призвал Зертимона к себе в свою многососудистую галерею. Он заявил, что Зертимон проявил в отношении его партнёров признаки неповиновения и малодушия. В обвинении не было ни капли правды, Арлатии только хотел знать, горит ли огонь в сердце Зертимона. Он хотел *знать*, является ли сердце Зертимона сердцем раба или сердцем восставшего».

«Зертимон предпочёл отдаться наказанию *иллитидов*, нежели открыть свою новоприобретённую силу. Он *знал*, что если покажет ненависть в своём сердце, то не добьётся ничего, кроме вреда для думающих подобно ему. Он предпочёл подвергнуться наказанию, и был поставлен под Колонны Безмолвия, чтобы страдать там весь цикл».

«Поставленный под Колонны, Зертимон перенёс свой разум в место, где тот был вне досягаемости, оставив тело позади. Он страдал в течение цикла, потом его доставили к Арлатии Дважды-Заражённому. Зертимон высказал благодарность за наказание *иллитидов*, словно слуга. Сделав это, он подтвердил в глазах *иллитидов*, что он раб, однако сердце его осталось свободным».

«Терпя и скрывая пламя своей ненависти, Зертимон позволил Арлатии Дважды-Заражённому думать, что он слаб. Когда пришло время восстания, Арлатии был первым из *иллитидов*, познавшим смерть от рук Зертимона и умершим третьей смертью».~
@59136 = ~«МОЛОТ НЕБЕСНОГО ОГНЯ»
Урон: 3-18 дробящий
Зачаровано: +3
Особенности:
   Класс защиты: +2
   Урон огнём: +10
   Сопротивление дробящему урону: +10%
THAC0: +2
Фактор скорости: 3
Вес: 5
Навык: молот
Доступно: воинам
Доступно: законопослушным добрым персонажам

«Небесный огонь» — единственная вещь, оставшаяся у Триаса как память о Верхних планах. Этот клинок превратился в молот прямо на твоих глазах. Он тёплый на ощупь; вся его поверхность покрыта изумительно красивым узором из языков пламени. Ты испытываешь невольное восхищение перед мастерством ремесленника, который, наверное, потратил века, нанося это горящее металлическое пламя. Тебе не знаком металл, из которого сделан молот… он тяжёлый, но блестит, как серебро.

Похоже, молоту несколько столетий. От него исходит лёгкая дрожь. Вибрация становится сильнее, когда молот касается человеческой плоти. Естественно, пользоваться «Небесным огнём» может лишь тот, кто чист и силён сердцем. В бою «Небесный огонь» распространяет святое сияние, которое сжигает поражённых злых существ.~
