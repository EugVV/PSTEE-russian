@24705 = ~«Может, у меня получится…»~
@24706 = ~«Может, у меня получится…»~
@24707 = ~«Может, у меня получится…»~
@24708 = ~При твоём приближении этот труп останавливается и безучастно на тебя смотрит. У него на лбу вырезан номер «782», а губы плотно сшиты. От тела исходит слабый запах формальдегида.~
@24709 = ~«Я ищу ключ… у тебя его, случайно, нет?»~
@24710 = ~Труп не отвечает.~
@24711 = ~«Неважно. Прощай».~
@24712 = ~«Я ищу ключ… у тебя его, случайно, нет?»~
@24713 = ~Осмотреть труп, нет ли у него ключа.~
@24714 = ~«Было приятно пообщаться. Прощай».~
@24715 = ~Похоже, нужный тебе ключ как раз у этого трупа. Он крепко зажат в левой руке: большой и указательный палец сомкнулись в мёртвой хватке. Видимо, придётся отрубить руку, чтобы взять ключ.~
@24716 = ~«Мне нужен этот ключ, труп… похоже, недолго тебе осталось…»~
@24717 = ~Оставить труп в покое.~
@24718 = ~«Я хотел бы поговорить с тобой о торговце Заке».~
@24719 = ~Женский труп смотрит на тебя пустыми глазами. На лбу у неё вырезан номер «916», губы плотно сшиты. От тела исходит лёгкий запах формалина.~
@24720 = ~«Так… чем занимаемся в последнее время?»~
@24721 = ~Труп продолжает пялиться на тебя.~
@24722 = ~«Тогда прощай».~
@24723 = ~«Что не так, Анна?»~
@24724 = ~«В чём проблема?»~
@24725 = ~«Тогда пойдём».~
@24726 = ~«Я спрошу снова… в чём проблема?»~
@24727 = ~«Фелл?»~
@24728 = ~«Тогда пойдём».~
@24729 = ~«Анна, никто не причинит тебе вреда, пока я рядом. Скажи мне, что такое „дабус“?»~
@24730 = ~«Что такое „дабус“?»~
@24731 = ~«Анна, никто не причинит тебе вреда, пока я рядом. Теперь расскажи, что с ним не так?»~
@24732 = ~«Думаю, будет лучше, если мы выясним этот вопрос прямо сейчас».~
@24733 = ~«Тогда пойдём».~
@24734 = ~«Ну ладно… но Фелл — тоже дабус. Так что с ним не так?»~
@24735 = ~«Тогда прощай».~
@24736 = ~«Тогда прощай».~
@24737 = ~«Так… чем занимаемся в последнее время?»~
@24738 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@24739 = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@24740 = ~Этот труп не отвечает. Кажется, она находится слишком далеко отсюда, чтобы ответить.~
@24741 = ~«Тогда прощай».~
@24742 = ~«Тогда прощай».~
@24743 = ~«Тогда прощай».~
@24744 = ~«Приятно было пообщаться. Прощай».~
@24745 = ~Оставить труп в покое.~
@24746 = ~«Приятно было поговорить. Прощай».~
@24747 = ~Оставить труп в покое.~
@24748 = ~«Приятно было поговорить. Прощай».~
@24749 = ~Оставить труп в покое.~
@24750 = ~Этот труп не отвечает. Кажется, она находится слишком далеко отсюда, чтобы ответить.~
@24751 = ~«Анна, я просто хочу задать Феллу пару вопросов. И мы тут же уйдём».~
@24752 = ~«Ясно. Хорошо, пойдём».~
@24753 = ~«„Её“?»~
@24754 = ~«„Её“? Ты имеешь в виду Госпожу Боли?»~
@24755 = ~«Анна, я просто хочу задать Феллу пару вопросов. И мы тут же уйдём».~
@24756 = ~«Ясно. Хорошо, пойдём».~
@24757 = ~«Сначала я бы поговорил с Феллом».~
@24758 = ~«Хорошо, пойдём».~
@24759 = ~«Сначала я бы поговорил с Феллом».~
@24760 = ~«Ясно. Хорошо, пойдём».~
@24761 = ~«*Успокойся* уже… ничего не случится. Сейчас я поговорю с Феллом, и не хотел бы, чтобы ты мешала».~
@24762 = ~Клятва: «Анна, никто не причинит тебе вреда, пока я рядом. Обещаю. Я просто хочу быстренько поговорить с ним».~
@24763 = ~Солгать, чтобы заткнуть её: «Анна, никто не причинит тебе вреда, пока я рядом. Обещаю. Я просто хочу быстренько поговорить с ним».~
@24764 = ~«Ну ладно, ладно. Мы уходим».~
@24765 = ~«Вот и ладно».~
@24766 = ~«Хорошо».~
@24767 = ~«А согласна?»~
@24768 = ~«А согласна?»~
@24769 = ~«Тогда давай».~
@24770 = ~«Тогда давай».~
@24771 = ~«Неважно. Пошли отсюда».~
@24772 = ~«Ясно. Тогда просто попытаюсь поговорить с ним сам…»~
@24773 = ~«Ладно. Уходим».~
@24774 = ~«Спроси его, кто он такой».~
@24775 = ~«Спроси его, кто он такой».~
@24776 = ~«Спроси его, кто он такой».~
