@13349 = ~Рабочий кузни~
@13350 = ~«Хм-м-м… наверное, я ошибся», — Мортаи качает головой. «Ну ладно, неважно. Чем Мортаи Могильщик может тебе помочь? Возможно, ты… — он цокает языком, — …желаешь подписать *договор*?»~
@13351 = ~«Договор? Ну, это всего лишь простая сделка», — из глубин своих необъятных одежд Мортаи достаёт четвертушку пыльного пергамента и гусиное перо. «Я даю тебе пятьдесят монет. За это — после твоей смерти — фракция Пыльных может забрать себе твои останки, — он улыбается, его голос снова начинает клокотать. — В любом случае какое применение ты им найдёшь?»~
@13352 = ~«Договор? Ну, это всего лишь простая сделка», — из глубин своих необъятных одежд Мортаи достаёт четвертушку пыльного пергамента и гусиное перо. «Обычно это стоит пятьдесят… но тебе я дам сотню. За это — после твоей смерти — фракция Пыльных может забрать себе твои останки, — он улыбается, его голос снова начинает клокотать. — В любом случае какое применение ты им найдёшь?»~
@13353 = ~Мортаи разводит руками, словно не знает: «Какое это имеет значение? Когда ты умрёшь, тебе будет совершенно неважно».~
@13354 = ~«Ну, если ты *должен* знать, скорее всего, *ничего* с твоим телом не сделается, а мы, Пыльные, зря потратили эти деньги! Какие мы идиоты! — Мортаи изображает лёгкую улыбку, затем говорит с виноватым видом. — Но… *изредка* бывает, что… рабочие в Мортуарии нуждаются в замене… и тогда нам может понадобиться твоё тело».~
@13355 = ~«Ах, но ведь никакого вреда и никакой боли… — Мортаи поднимает палец, подчёркивая важность мысли. — И никакой опасности. В обмен на деньги, которые ты можешь потратить в *этой* жизни, ты просто должен отдать нам то, что тебе в любом случае после смерти не нужно». Мортаи бьёт себя в грудь: «Я сам подписал такой договор, если уж тебе интересно… После смерти мне *моё* тело не понадобится».~
@13356 = ~«Но я могу помочь тебе! Могу! — кричит тебе в спину Мортаи умоляющим голосом. — Возвращайся, если будешь нуждаться в деньгах, и Мортаи сможет помочь… всё в обмен на твою подпись».~
@13357 = ~«Конечно, конечно… — кивает Мортаи. — С удовольствием отвечу на любые твои вопросы…»~
@13358 = ~Мортаи качает головой: «Не знаю я ни о каком дневнике». Он улыбается: «Я имею дело с документацией совсем *другого* рода…»~
@13359 = ~Мортаи хмурится. «Он один из этих Сборщиков, да? Я мало о нём знаю… по-моему, его мимоходом упоминал Посвящённый Эморик, — Мортаи оглядывается вокруг. — Эморик должен быть где-то тут в баре… по-моему, обычно его можно найти в дальнем конце, во главе стола».~
@13360 = ~«Превосходно! Превосходно! — Мортаи вне себя от радости… со слабой улыбкой он выкладывает перед тобой пыльный лист пергамента и гусиное перо. — Ты *не пожалеешь*». Он тычет пальцем в три места на странице: «Подпишись здесь, здесь и здесь, и по рукам!»~
@13361 = ~Улыбка Мортаи становится холодной: «Я верю, что ты не хотел меня оскорбить, уважаемый».~
@13362 = ~Ты берёшь перо в руку и начинаешь выводить свою подпись на пергаменте… перо при соприкосновении с пергаментом издаёт какой-то странный *скрежет*, как будто ты пишешь кинжалом по стали.~
@13363 = ~Пытаясь подписать документ, однако, ты замечаешь, что под пером пергамент как будто прогибается… как ты ни стараешься, расписаться не получается. Словно договор превращается из пыльного куска пергамента в нечто… живое?~
@13364 = ~Подняв голову, чтобы заговорить с Мортаи, ты вдруг видишь вместо его лица ухмыляющийся череп. Остальные посетители бара, кажется, остановились, шум смолк, все замерли, как статуи. Мортаи открывает рот, и из черепа вырываются клубы пыли.~
@13365 = ~Мёртвая голова со скрежетом произносит слова, пыль вырывается изо рта…

  *Подпиши*

  *Но помни… за всё надо платить*

  *И что может изменить природу человека?*

Слова произносятся как будто каким-то нестройным, мёртвым хором: пять, десять, двадцать, сто голосов — старые, молодые, женские, мужские, отчаянные, спокойные, истеричные…~
@13366 = ~Выговорив эти слова, ты внезапно чувствуешь слабость и следующее, что ты слышишь, — это голос Мортаи, нормальный голос, его рука лежит на твоём плече. «Уважаемый, ты в порядке? — он натянуто смеётся. — Я уж подумал, ты в осадок выпал…»~
@13367 = ~Время как будто перевело дух и восстановило своё течение… бар снова выглядит обычным, а у Мортаи нормальная голова, а не жуткий череп. Внутри своего черепа ты чувствуешь странное давление, как будто что-то отчаянно рвётся наружу, но не может вырваться. Та мёртвая голова, которая говорила пылью… как будто ты вспомнил сразу дюжину обрывков воспоминаний, и все они переплелись в один образ… и ты знаешь, откуда-то знаешь, что каждый голос, которым говорила мёртвая голова, принадлежал *кому-то*… давно умершему.~
@13368 = ~Мортаи снимает руку с твоего плеча… похоже, он больше беспокоился о потере клиента, чем о твоём состоянии. Бросив взгляд на пыльный пергамент на столе, ты понимаешь, что уже не в первый раз царапаешь пером своё имя на договоре… и, может быть, не первый раз именно на таком договоре.~
@13369 = ~Вновь коснувшись пером пергамента, ты чувствуешь волнующую слабость, а в твоей голове поднимается волна мыслей и воспоминаний…~
@13370 = ~Ты царапаешь «X» в трёх местах договора, которые указал Мортаи. Как только ты ставишь последнюю пометку, руки Мортаи взлетают, как два крыла: левая рука посыпает пергамент песком, чтобы просушить чернила, а правая высыпает тебе в руки поток монет… всего пятьдесят.~
@13371 = ~Ты царапаешь «X» в трёх местах договора, которые указал Мортаи. Как только ты ставишь последнюю пометку, руки Мортаи взлетают, как два крыла: левая рука посыпает пергамент песком, чтобы просушить чернила, а правая высыпает тебе в руки поток монет… всего сто.~
@13372 = ~Мортаи выглядит настороженным: «Боюсь, ничего нельзя поделать. Договор подписан, вступил в силу и обязателен к исполнению».~
@13373 = ~Мортаи трясёт головой. «Теперь это уже вопрос соблюдения закона, — он постукивает по подбородку, голос его начинает клокотать. — Для другого я, быть может, и захотел бы разорвать договор, но твой… судя по твоему виду, он скоро вступит в силу».~
@13374 = ~Мортаи говорит ледяным тоном, его глаза оценивают тебя: «Если обнажишь здесь оружие, ты не доживёшь до того, чтобы пустить его в ход. Здесь есть стражи, которых ты не в состоянии даже *увидеть*. И даже если тебе удастся уйти, Пыльные позаботятся о том, чтобы тебя постигло наказание. Так что не произноси таких глупых угроз в моём присутствии».~
@13375 = ~«Разумеется. О ком из посетителей ты хотел бы узнать?»~
@13376 = ~«Не посвящённый, а сплошная головная боль, — в клокотании голоса Мортаи слышится неодобрение. — Он ищет смерти со страстью, *более чем* недостойной Пыльных».~
@13377 = ~«О, да, — хмурится Мортаи. — Излишние страсти, излишние эмоции мешают достичь Истинной Смерти. Страстность противоречит философии нашей фракции».~
@13378 = ~«Истинная Смерть — это состояние мирного забвения, к которому стремятся все Пыльные… и помогают остальным достичь его, — он клокочет неодобрительно. — Всё, привязывающее душу к этой жизни, — чуждо нашей фракции независимо от того, страсти или чувства образуют эти привязанности. Видишь ли… страсти как бы сажают душу на привязь, мешая ей достичь Истинной Смерти…» Он качает головой: «Очень, очень плохо».~
@13379 = ~«Проблемная посвящённая. Я слыхал, что недавно она заболела, и… это её изменило. Теперь она испытывает горечь и гнев, а слова веры Пыльных произносит не так убеждённо, как прежде. Боюсь, что горечь — та страсть, из-за которой она рискует потерять своё положение в нашей фракции».~
@13380 = ~«Уважаемый Посвящённый Четвёртого круга. *Очень* мудрый человек, — Мортаи изучает тебя с лёгким беспокойством. — Какое у тебя дело к нему, могу ли я поинтересоваться? Возможно, я смогу помочь тебе».~
@13381 = ~«Уважаемый Посвящённый Четвёртого круга. *Очень* мудрый человек. Освободился от привязанностей и страстей этой жизни…» — он кивает в знак одобрения.~
@13382 = ~Мортаи явно выглядит расстроенным: «Нет-нет, добрый сэр! Он не предложит тебе и половины моей цены. Это будут… просто… *жалкие гроши* в сравнении с тем, что предложу тебе я! Продумай, прежде чем принять поспешное решение!»~
@13383 = ~«Я… — голос Мортаи клокочет. — Я предлагаю тебе семьдесят пять… сто монет, уважаемый! Много, много больше, чем любой другой Пыльный».~
@13384 = ~Глаза Мортаи становятся ледяными. «Тот, с монетами вместо глаз? Его *глаза* ясно показывают, зачем он здесь, — он описывает полукруг над сердцем. — Может, он и носит наши одежды, но я бы *никогда* не подписал с ним Посмертный Договор. Медь заменила ему душу, а для меня это означает исключительную страсть к деньгам. Он Пыльный только по названию».~
@13385 = ~Мортаи неодобрительно клокочет: «Да, но намного лучше подписать договор со мной, а не с этим жадным чудовищем. Жадность — это убийственная страсть, знаешь ли, а уж для Пыльных — вдвойне убийственная».~
@13386 = ~Мортаи сверлит тебя холодным взглядом: «Тогда это означало бы преступное деяние. Тебя бы арестовали, и тогда, по закону, твой Посмертный Договор вступил бы в силу намного *раньше*, чем тебе хотелось бы».~
@13387 = ~Лицо Мортаи резко бледнеет… ты и подумать не мог, что для Пыльного такое возможно. Секунду он что-то шипит, как бы не зная, что же делать. «Ты…» — он вдруг поворачивается, трижды хлопает в ладоши, и весь бар пронизывает могучий порыв ветра…~
@13388 = ~«Да, но намного лучше подписать договор со мной, а не с этим жадным чудовищем. Жадность — это убийственная страсть, знаешь ли, а уж для Пыльных — вдвойне убийственная. Не утруждай себя разговором с этим Медноглазым, добрый сэр… лучше иметь дело со мной».~
@13389 = ~Мортаи хмурится, затем смотрит в складки одежды. «Как правило, я не храню документы при себе, но может быть… — он извлекает стопку бумаг и листает их. — Нет, у меня его нет. Мне сходить за ним в одну из задних комнат?»~
@13390 = ~Мортаи хмурится. Он выглядит озадаченным. «Может быть… — на миг он задумывается. — Однако я не помню этого имени».~
@13391 = ~Мортаи выглядит настороженным: «Боюсь, это невозможно. Договор подписан, вступил в силу и обязателен к исполнению».~
@13392 = ~Мортаи качает головой: «Как неприятно… но теперь это вопрос соблюдения закона, а не привязанностей сердца».~
@13393 = ~Мортаи некоторое время обдумывает сказанное; похоже, ты загнал его в угол. «Я не могу. Это вопрос соблюдения закона, мой друг… а кроме того, на подписавшего договор ложится обязательство преодолеть свои чувства и стремиться к достижению Истинной Смерти. Я не мо…»~
@13394 = ~Мортаи вздыхает и поднимает ладони в умиротворяющем жесте: «Слушай, всё не *так*, как ты пытаешься изобразить…»~
@13395 = ~Мортаи секунду глядит на тебя, открывает рот, закрывает его и открывает снова. «Во имя девяти преисподних… подожди меня здесь, — он понижает голос до шепота. — И закрой свою шкатулку на замок». С яростной гримасой он удаляется.~
@13396 = ~Через несколько секунд Мортаи возвращается. В руках у него пыльный кусок пергамента, который он вручает тебе: «Вот!» Он презрительно фыркает: «Всё для спокойствия души этого человека… теперь уходи и не раздражай меня больше своими проповедями!»~
@13397 = ~Мортаи трясёт головой: «Теперь это вопрос соблюдения закона, а не тема для обсуждения».~
@13398 = ~Мортаи говорит ледяным тоном, его глаза оценивают тебя: «Если ты заберёшь этот договор, ты не выйдешь отсюда живым. Здесь есть стражи, которых ты не в состоянии даже *увидеть*. И даже если тебе удастся уйти, Пыльные позаботятся о том, чтобы тебя постигло наказание. Так что не произноси таких глупых угроз в моём присутствии».~
@13399 = ~Мортаи секунду глядит на тебя, открывает рот, закрывает его и открывает снова. «Во имя девяти преисподних… — он лезет куда-то в свои одежды, достаёт договор и вручает его тебе. — Вот!» Он презрительно фыркает: «Всё для спокойствия души этого человека… теперь убирайся».~
@13400 = ~Мортаи говорит ледяным тоном, его глаза оценивают тебя: «Если обнажишь здесь оружие, ты не доживёшь до того, чтобы пустить его в ход. Здесь есть стражи, которых ты не в состоянии даже *увидеть*. И даже если тебе удастся уйти, Пыльные позаботятся о том, чтобы тебя постигло наказание. Так что не произноси таких глупых угроз в моём присутствии».~
@13401 = ~(NULL NODE)~
@13402 = ~Мортаи лезет в складки одежды, достаёт договор и показывает его тебе: «Вот, уважаемый… Ангияр стал намного богаче от одной подписи». Ты рассматриваешь договор; он выглядит настоящим… и очень официальным.~
@13403 = ~«Да, пока их не доставят в Мортуарий. Я подписал много договоров за свою жизнь, много договоров… в том числе и собственный. Такая проблема таскать их все в Мортуарий».~
@13404 = ~Мортаи кивает, когда ты собираешься уйти. «Хм-м-м…» — на его лице появляется странное выражение.~
@13405 = ~Мортаи хмурится: «Прости меня, но я *должен* снова спросить… ты уверен, что мы не встречались раньше?»~
@13406 = ~«Хм-м-м, — Мортаи качает головой. — Ладно, неважно».~
@13407 = ~«Да, прощай, прощай… — Мортаи изучает тебя, пока ты уходишь, и ты слышишь, как он бормочет себе под нос. — Что-то с этим типом…»~
@13408 = ~«А… — Мортаи хмурится при твоём появлении, голос его клокочет. — Опять ты… пришёл, чтобы заставить меня расторгнуть ещё несколько договоров во имя фракции Пыльных?» Он хмурится, затем вздыхает: «Ну, неважно, неважно, что было, то было…» Он натягивает свою старую улыбку и кивает тебе: «Чем могу помочь?»~
@13409 = ~«А, путешественник! — Мортаи улыбается, завидев тебя. — Снова встретились… чем я могу помочь тебе в этот чудный сигильский день?» Он выглядит обнадёженным: «Быть может, ты пришёл заключить договор?»~
@13410 = ~«А, путешественник! — Мортаи улыбается, завидев тебя. — Снова встретились… чем я могу помочь тебе в этот чудный сигильский день?»~
@13411 = ~«Жажду?! Я… — Мортаи поднимает брови, затем вежливо откашливается. — Уважаемый… ты хочешь заключить договор или нет? Если нет…»~
@13412 = ~«Подожди секундочку…» — он встаёт из-за стола и удаляется.~
@13413 = ~«Вот, уважаемый… Ангияр… очень мрачный тип, скор был на подпись… — он понижает голос. — А теперь *намного* более богатый тип». Ты рассматриваешь договор; он выглядит настоящим… и очень официальным.~
@13414 = ~Мортаи убирает договор, и ты замечаешь, что он прячет его в складки одежды, а не уносит в скрытую комнату. Мортаи щёлкает языком: «Ты получил ответы на свои вопросы о договоре?»~
@13415 = ~Рассматривая документ, ты быстро отворачиваешься от Мортаи… но когда ты пытаешься подменить договор, Мортаи кашляет: «Уважаемый… я бы был осторожен с этим документом. Если я обнаружу, что он пропал, я буду вынужден принять меры». Его голос клокочет, он делает пальцами манящее движение: «Будь так добр, верни договор…»~
@13416 = ~Рассматривая документ, ты быстро отворачиваешься от Мортаи и подменяешь договоры. Кажется, он ничего не заметил.~
@13417 = ~«Приветствую».~
@13418 = ~Игнорировать его.~
@13419 = ~«Может быть. Ты уверен, что это был я?»~
@13420 = ~«Нет, по крайней мере… я тебя не помню».~
@13421 = ~«Неважно. Мне надо идти».~
@13422 = ~«Договор?»~
@13423 = ~«Договор?»~
@13424 = ~«Мортаи Могильщик? Ты тот самый Пыльный, который подписал договор с Ангияром?»~
@13425 = ~«Не сегодня, спасибо. Прощай».~
@13426 = ~«Что Пыльные сделают с телом?»~
@13427 = ~«Пятьдесят монет за мой труп? Замечательно, я подпишу».~
@13428 = ~«Спасибо, не надо. Но я хотел задать тебе несколько вопросов…»~
@13429 = ~«Не думаю, что ты можешь мне помочь. Прощай».~
@13430 = ~«Что Пыльные сделают с телом?»~
@13431 = ~«Сто монет за мой труп? Замечательно, я подпишу».~
@13432 = ~«Спасибо, не надо. Но я хотел задать тебе несколько вопросов…»~
@13433 = ~«Не думаю, что ты можешь мне помочь. Прощай».~
@13434 = ~«Для меня это важно».~
@13435 = ~«Замечательно, я подпишу».~
@13436 = ~«Спасибо, не надо. Но я хотел задать тебе несколько вопросов…»~
@13437 = ~«Не думаю, что ты можешь мне помочь. Прощай».~
@13438 = ~«То есть меня оживят как труп и заставят работать в Мортуарии? Это не есть хорошо».~
@13439 = ~«Замечательно, я подпишу».~
@13440 = ~«Спасибо, не надо. Но я хотел задать тебе несколько вопросов…»~
@13441 = ~«Не думаю, что ты можешь мне помочь. Прощай».~
@13442 = ~«Хм-м-м… и правда. Замечательно, я подпишу».~
@13443 = ~«Я это обдумаю. Сейчас я хотел спросить о другом…»~
@13444 = ~«Ну, я предпочёл бы покоиться с миром, и по целому ряду причин. Не думаю, что ты можешь мне помочь. Прощай».~
@13445 = ~«Расскажи мне ещё раз о договоре».~
@13446 = ~«Расскажи мне ещё раз о договоре».~
@13447 = ~«Я хотел бы подписать договор, о котором ты говорил».~
@13448 = ~«Я хотел бы расторгнуть договор, который заключил с тобой».~
@13449 = ~«Это ты заключил Посмертный Договор с Ангияром?»~
@13450 = ~«Могу я увидеть тот договор, который ты заключил с Ангияром?»~
@13451 = ~«Не расскажешь мне о некоторых здешних посетителях?»~
@13452 = ~«Ты не видел недавно дневник? Я свой дневник потерял».~
@13453 = ~«Я ищу мужчину по имени Фарод. Ты его не видел?»~
@13454 = ~«Больше вопросов нет. Прощай».~
@13455 = ~«Ты имеешь в виду тот договор, о котором упоминал? Что насчёт него?»~
@13456 = ~«Ты имеешь в виду тот договор, о котором упоминал? Что насчёт него?»~
@13457 = ~«Как ты уже говорил. У меня другие вопросы…»~
@13458 = ~«Это всё, что я хотел узнать. Прощай».~
@13459 = ~«Посвящённый Эморик?»~
@13460 = ~«Посвящённый Эморик?»~
@13461 = ~«А. У меня другие вопросы…»~
@13462 = ~«Это всё, что я хотел узнать. Прощай».~
@13463 = ~Подписать здесь, здесь и здесь.~
@13464 = ~Подписать здесь, здесь и здесь.~
@13465 = ~«Знаешь… ты проявляешь больше эмоций, чем остальные Пыльные, которых я встречал».~
@13466 = ~«Знаешь… ты проявляешь больше эмоций, чем остальные Пыльные, которых я встречал».~
@13467 = ~«Забудь. У меня другие вопросы…»~
@13468 = ~«Не бери в голову. Не думаю, что ты можешь мне помочь. Прощай».~
@13469 = ~«Нет конечно. Дай я подпишу договор».~
@13470 = ~«Нет конечно. Дай я подпишу договор».~
@13471 = ~«Это проблема?»~
@13472 = ~«Я не хотел никого оскорбить… но, кажется, ты уж очень жаждешь заключить со мной договор. А для Пыльного такая жажда кажется мне странной».~
@13473 = ~«Прошу прощения. У меня кое-какие вопросы…»~
@13474 = ~«Я не хотел никого оскорбить… но не думаю, что ты можешь мне помочь. Прощай».~
@13475 = ~Продолжать подписывать…~
@13476 = ~«Э-э… Мортаи? Что с этим договором?»~
@13477 = ~«Мортаи?..»~
@13478 = ~«Природу человека?..»~
@13479 = ~Попытаться прийти в себя…~
@13480 = ~«Подожди секундочку… сейчас я приду в норму».~
@13481 = ~Закончить подписывать договор.~
@13482 = ~Закончить подписывать договор.~
@13483 = ~«На самом деле, Мортаи… пожалуй, я подожду его подписывать. Сперва у меня кое-какие вопросы…»~
@13484 = ~«Не думаю, что ты можешь мне помочь… прощай».~
@13485 = ~Подавить наплыв воспоминаний, подписать договор…~
@13486 = ~Подавить наплыв воспоминаний, подписать договор…~
@13487 = ~Поддаться воспоминаниям.~
@13488 = ~«На самом деле, Мортаи… пожалуй, я подожду его подписывать. Сперва у меня кое-какие вопросы…»~
@13489 = ~«Не думаю, что ты можешь мне помочь… прощай».~
@13490 = ~«Ну вот, с этим разобрались, теперь у меня есть пара вопросов…»~
@13491 = ~«Наша сделка заключена… прощай».~
@13492 = ~«Ну вот, с этим разобрались, теперь у меня есть пара вопросов…»~
@13493 = ~«Наша сделка заключена… прощай».~
@13494 = ~«Я могу каким-то образом разорвать этот договор?»~
@13495 = ~Блеф: «У меня такое предложение: ты отдаёшь мой договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13496 = ~Правда: «У меня такое предложение: ты отдаёшь мой договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13497 = ~«Неважно. У меня другие вопросы…»~
@13498 = ~«Я просто полюбопытствовал. Прощай».~
@13499 = ~Блеф: «А как насчёт такого: ты отдаёшь мой договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13500 = ~Правда: «А как насчёт такого: ты отдаёшь мой договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13501 = ~«Тогда ладно. У меня другие вопросы…»~
@13502 = ~«Тогда прощай».~
@13503 = ~«Я рискну… готовься к смерти».~
@13504 = ~«Забудь. У меня другие вопросы…»~
@13505 = ~«Неважно. Прощай».~
@13506 = ~«Можешь рассказать мне об Ожидающем-Смерть?»~
@13507 = ~«Можешь рассказать мне о Сере?»~
@13508 = ~«Можешь рассказать мне о Посвящённом Эморике?»~
@13509 = ~«Можешь рассказать мне о Посвящённом Эморике?»~
@13510 = ~«Можешь рассказать мне о старике Медноглазом?»~
@13511 = ~«Вообще-то, забудь. Я никого из них по именам не знаю. У меня другие вопросы…»~
@13512 = ~«Вообще-то, забудь. У меня другие вопросы…»~
@13513 = ~«Вообще-то, забудь. У меня другие вопросы…»~
@13514 = ~«А Пыльным не позволяется переживать страсти?»~
@13515 = ~«У меня другие вопросы…»~
@13516 = ~«Прощай».~
@13517 = ~«Истинная Смерть?»~
@13518 = ~«Истинная Смерть?»~
@13519 = ~«У меня другие вопросы…»~
@13520 = ~«Прощай».~
@13521 = ~«У меня другие вопросы…»~
@13522 = ~«Ясно. Очень поучительно. Прощай».~
@13523 = ~«А Пыльным не позволяется переживать страсти?»~
@13524 = ~«У меня другие вопросы…»~
@13525 = ~«Прощай».~
@13526 = ~«Ну, я подумываю заключить договор с Эмориком».~
@13527 = ~Ложь: «Ну, я подумываю заключить договор с Эмориком».~
@13528 = ~«Я так не думаю. Однако у меня ещё кое-какие вопросы…»~
@13529 = ~«Не думаю, что ты можешь мне помочь. Прощай, Мортаи».~
@13530 = ~«А Пыльным не позволяется переживать страсти?»~
@13531 = ~«Ясно. У меня ещё кое-какие вопросы…»~
@13532 = ~«Спасибо за информацию. Прощай, Мортаи».~
@13533 = ~«А сколько предложишь ты?»~
@13534 = ~«Я подумаю. У меня другие вопросы…»~
@13535 = ~«Не думаю, что ты можешь мне помочь. Прощай».~
@13536 = ~«Ну ладно, я заключу договор с тобой».~
@13537 = ~«Я подумаю. У меня другие вопросы…»~
@13538 = ~«Не думаю, что ты можешь мне помочь. Прощай».~
@13539 = ~«А Пыльным не позволяется переживать страсти?»~
@13540 = ~«О, он тоже предлагает заключать договоры?»~
@13541 = ~«Хочешь сказать, что я могу заключить Посмертный Договор с ним?»~
@13542 = ~«Ясно. У меня ещё кое-какие вопросы…»~
@13543 = ~«А Пыльным не позволяется переживать страсти?»~
@13544 = ~«Ну, я уже подписал договор с ним. И что ты будешь с этим делать?»~
@13545 = ~«Спасибо за информацию. Прощай, Мортаи».~
@13546 = ~«А что было бы, если бы я подписал договор с ним?»~
@13547 = ~«Ясно. У меня другие вопросы…»~
@13548 = ~«Спасибо за информацию. Прощай, Мортаи».~
@13549 = ~«Ясно. У меня другие вопросы…»~
@13550 = ~«Спасибо за информацию. Прощай, Мортаи».~
@13551 = ~«Ну и ладно. Приготовься к смерти…»~
@13552 = ~«А Пыльным не позволяется переживать страсти?»~
@13553 = ~«Ясно. Однако у меня ещё кое-какие вопросы…»~
@13554 = ~«Не думаю, что ты можешь мне помочь. Прощай, Мортаи».~
@13555 = ~«Если можно, я хотел бы на него взглянуть».~
@13556 = ~«Не совсем так. Я хотел бы разорвать этот договор».~
@13557 = ~«Ты хранишь договоры здесь, в этом заведении?»~
@13558 = ~«Нет, не сейчас. У меня пара вопросов…»~
@13559 = ~«Просто проверял, ты это или не ты. Не беспокойся».~
@13560 = ~«Я хотел бы разорвать этот договор».~
@13561 = ~«Этот договор у тебя с собой?»~
@13562 = ~«Могу я ещё раз посмотреть на договор Ангияра?»~
@13563 = ~«Неважно. У меня другие вопросы…»~
@13564 = ~«Я просто полюбопытствовал. Прощай».~
@13565 = ~«Из-за этого договора у него вся жизнь пошла кувырком».~
@13566 = ~«Из-за этого договора у него вся жизнь пошла кувырком. Он страдает… возможно, он даже не сможет достичь Истинной Смерти, раз у него в душе такая каша».~
@13567 = ~«Могу я каким-то образом разорвать этот договор?»~
@13568 = ~Блеф: «У меня такое предложение: ты отдаёшь этот договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13569 = ~Правда: «У меня такое предложение: ты отдаёшь этот договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13570 = ~«Неважно. У меня другие вопросы…»~
@13571 = ~«Я просто полюбопытствовал. Прощай».~
@13572 = ~«Из-за этого договора человек страдает… возможно, он даже не сможет достичь Истинной Смерти, раз у него в душе такая каша».~
@13573 = ~«Есть хоть *какой-нибудь* способ разорвать этот договор с тобой?»~
@13574 = ~Блеф: «У меня такое предложение: ты отдаёшь этот договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13575 = ~Правда: «У меня такое предложение: ты отдаёшь этот договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13576 = ~«Неважно. У меня другие вопросы…»~
@13577 = ~«Я просто полюбопытствовал. Прощай».~
@13578 = ~«То есть ты лишишь его Истинной Смерти ради куска пергамента?»~
@13579 = ~«Могу я каким-то образом разорвать этот договор?»~
@13580 = ~Блеф: «У меня такое предложение: ты отдаёшь этот договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13581 = ~Правда: «У меня такое предложение: ты отдаёшь этот договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13582 = ~«Неважно. У меня другие вопросы…»~
@13583 = ~«Я просто полюбопытствовал. Прощай».~
@13584 = ~«Очевидно, ты оскорбляешь философию Пыльных, обрекая душу человеческую ради куска бумаги. Другие члены фракции знают о таком твоём отношении? Если ещё нет, то скоро узнают».~
@13585 = ~«Очевидно, ты оскорбляешь философию Пыльных, обрекая душу человеческую ради куска бумаги. Другие члены фракции знают о таком твоём отношении? Если ещё нет, то скоро узнают».~
@13586 = ~«Могу я каким-то образом разорвать этот договор?»~
@13587 = ~Блеф: «У меня такое предложение: ты отдаёшь этот договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13588 = ~Правда: «У меня такое предложение: ты отдаёшь этот договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13589 = ~«Неважно. У меня другие вопросы…»~
@13590 = ~«Я просто полюбопытствовал. Прощай».~
@13591 = ~Подождать…~
@13592 = ~«Я ухожу… покамест. Прощай, Мортаи».~
@13593 = ~Блеф: «А как насчёт такого: ты отдаёшь этот договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13594 = ~Правда: «А как насчёт такого: ты отдаёшь этот договор прямо сейчас, или я расправляюсь с тобой на месте».~
@13595 = ~«Но из-за этого договора у него вся жизнь пошла кувырком».~
@13596 = ~«Но из-за этого договора у него вся жизнь пошла кувырком. Он страдает… возможно, он даже не сможет достичь Истинной Смерти, раз у него в душе такая каша».~
@13597 = ~«Что ж, ладно. У меня другие вопросы…»~
@13598 = ~«Тогда прощай».~
@13599 = ~«И всё же я рискну. Попробуй меня остановить».~
@13600 = ~Отдать договор Мортаи.~
@13601 = ~«Я ухожу… покамест. Прощай, Мортаи».~
@13602 = ~«Я рискну… готовься к смерти».~
@13603 = ~«Из-за этого договора у него вся жизнь пошла кувырком».~
@13604 = ~«Из-за этого договора у него вся жизнь пошла кувырком. Он страдает… возможно, он даже не сможет достичь Истинной Смерти, раз у него в душе такая каша».~
@13605 = ~«Есть какой-нибудь другой способ разорвать этот договор?»~
@13606 = ~«Забудь. У меня другие вопросы…»~
@13607 = ~«Тогда забудем».~
@13608 = ~Прикинувшись, что изучаешь договор, подменить его фальшивым, затем отдать Мортаи.~
@13609 = ~Прикинувшись, что изучаешь договор, подменить его фальшивым, затем отдать Мортаи.~
@13610 = ~Прикинувшись, что изучаешь договор, подменить его фальшивым, затем отдать Мортаи.~
@13611 = ~«Хорошо… кажется, всё как положено».~
