@61821 = ~~
@61822 = ~После долгой паузы скелет отвечает: «Ты должен *научиться* слушать, вот и всё».~
@61823 = ~«Ясно. А ты не видел где-нибудь здесь небольшой бронзовой сферы?»~
@61824 = ~«Тогда, наверное, я поговорю с ней снова. Прощай, Харгримм».~
@61825 = ~«Я хочу поговорить с тобой о Тухлой Мэри… тебе не кажется, что понять её трудновато?»~
@61826 = ~«Я хочу поговорить с тобой о Тухлой Мэри… как ты её понимаешь?»~
@61827 = ~Языки пламени окутывают горло Игнуса и танцуют на его черепе. Его обуглившиеся губы расходятся, и он говорит скрипучим голосом: «*Я… жду*».~ [IGN148]
@61828 = ~«Игнус, мне нужна твоя помощь».~
@61829 = ~«Игнус, мне нужна твоя помощь».~
@61830 = ~«Игнус, мне нужна твоя помощь».~
@61831 = ~«Игнус, мне нужна твоя помощь».~
@61832 = ~«Игнус, мне нужна твоя помощь».~
@61833 = ~«Игнус, мне нужна твоя помощь».~
@61834 = ~«Э-э… ясно. Тогда прощай».~
@61835 = ~При твоём приближении Игнус издаёт протяжное, трескучее шипение. «*Я с-с-с нетерпением жду, когда пойду путём пламени*».~ [IGN149]
@61836 = ~«Игнус, мне нужна твоя помощь».~
@61837 = ~«Игнус, мне нужна твоя помощь».~
@61838 = ~«Игнус, мне нужна твоя помощь».~
@61839 = ~«Игнус, мне нужна твоя помощь».~
@61840 = ~«Игнус, мне нужна твоя помощь».~
@61841 = ~«Игнус, мне нужна твоя помощь».~
@61842 = ~«Э-э… ясно. Тогда прощай».~
@61843 = ~Раздаётся треск поджаривающейся плоти, затем Игнус издаёт длинное, низкое шипение: «*Как скажеш-шь*».~ [IGN106]
@61844 = ~«Пошли».~
@61845 = ~Зубы Игнуса стучат, а из горла вырывается поток искр: «*Огни долж-жны ох-хватить улицы*».~ [IGN077]
@61846 = ~«Пошли».~
@61847 = ~Когда Игнус кивает головой, из его горла вырываются хлопья пепла: «*Игнус повинуетс-с-ся…*»~ [IGN101]
@61848 = ~«Пошли».~
@61849 = ~Голос Игнуса низкий, и, когда он говорит, пламя охватывает его обгорелые черты: «*Я пойду путём пламени с-с-с тобой*».~ [IGN151]
@61850 = ~«Пошли».~
@61851 = ~Изо рта Игнуса вырывается язык пламени, подобный змее, затем рассеивается шипящим дымом, оставив после себя только хлопья пепла: «*Дас-с-с*».~ [IGN191A]
@61852 = ~«Пошли».~
@61853 = ~Зубы вставлены~ [MRT582D]
@61854 = ~Зубы вставлены~ [MRT582E]
@61855 = ~«Игнус, мне нужна твоя помощь».~
@61856 = ~«Игнус, мне нужна твоя помощь».~
@61857 = ~«Игнус, мне нужна твоя помощь».~
@61858 = ~«Игнус, мне нужна твоя помощь».~
@61859 = ~«Игнус, мне нужна твоя помощь».~
@61860 = ~«Э-э… ясно. Тогда прощай».~
@61861 = ~Зубы удалены~ [MRT582C]
@61862 = ~Зубы удалены~ [MRT582D]
@61863 = ~Зубы удалены~ [MRT582E]
@61864 = ~На чертежах отмечено, что гробница защищена множеством ловушек, но точное их расположение не указано. Однако на одном листе ты видишь примечание, которое гласит, что в каждой комнате установлена особо смертоносная ловушка. В самом низу надпись, сделанная другой рукой. Похоже на твой почерк.~
@61865 = ~Готово.~
@61866 = ~В чертежах было бы больше толку в самой гробнице. Тогда ты мог бы непосредственно сравнить план и реальность.~
@61867 = ~Закрыть.~
@61868 = ~«Ловушка установлена. Теперь нужно только дождаться, когда мой мучитель ступит на пол между её барьерами. Однако мне, похоже, нужен способ вытащить оттуда труп и не попасть в ловушку самому… хм-м. Возможно, какая-нибудь магия, которая переносила бы труп обратно к началу…»~
@61869 = ~Прочитать надпись.~
@61870 = ~Закрыть.~
@61871 = ~Morte Location, Clerk's Ward (Upper Class Part Town) 2~ [MRT089]
@61872 = ~Morte Location, Lower Ward (Industrial Part Town) 3~ [MRT094]
