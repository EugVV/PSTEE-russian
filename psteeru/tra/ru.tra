@24564 = ~Голова этого трупа болтается на плечах из стороны в сторону… судя по углу наклона шеи, видимо, этого человека повесили. На боковой части головы нарисован номер «825».~
@24565 = ~«Я ищу ключ… у тебя его, случайно, нет?»~
@24566 = ~Труп смотрит в землю и не отвечает.~
@24567 = ~«Неважно. Прощай».~
@24568 = ~«Я ищу ключ… у тебя его, случайно, нет?»~
@24569 = ~«Так… что-нибудь интересненькое происходит?»~
@24570 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@24571 = ~Труп никак не реагирует. Похоже, он слишком «далеко», чтобы отвечать на любые твои вопросы.~
@24572 = ~Оставить труп в покое.~
@24573 = ~Использовать на трупе «Разговор с мёртвыми».~
@24574 = ~Осмотреть труп, нет ли на нём ключа.~
@24575 = ~Судя по виду, этот ходячий труп мёртв уже несколько лет. Кожа с его лба содрана, обнажая белый как мел череп. Кто-то выбил номер «569» на открывшейся кости.~
@24576 = ~«Я ищу ключ… у тебя его, случайно, нет?»~
@24577 = ~Труп таращит на тебя глаза в молчании.~
@24578 = ~«Неважно. Прощай».~
@24579 = ~«Я ищу ключ… у тебя его, случайно, нет?»~
@24580 = ~«Так… что-нибудь интересненькое происходит?»~
