@23005 = ~В шутку: «О великая Госпожа Боли, богиня Сигила! Услышь мои мольбы и помоги мне в час нужды».~
@23006 = ~Спрятать куклу.~
@23007 = ~«Ой-ой… ты просто милая маленькая Госпожа Боли, не так ли? Да-да, ути-пусеньки!»~
@23008 = ~Искренне: «О великая Госпожа Боли, богиня Сигила! Услышь мои мольбы и помоги мне в час нужды».~
@23009 = ~В шутку: «О великая Госпожа Боли, богиня Сигила! Услышь мои мольбы и помоги мне в час нужды».~
@23010 = ~Спрятать куклу.~
@23011 = ~«Фелл говорит, что она не миф».~
@23012 = ~Грейс читает символы, и голос её становится мрачнее: «Фелл говорит, что Рейвел в одном из лабиринтов Госпожи».~
@23013 = ~Грейс читает символы, и голос её становится мрачнее: «Фелл говорит, что воля Рейвел не совпала с волей Госпожи, и Рейвел была наказана. Помещена в один из лабиринтов Госпожи». Грейс поворачивается к тебе: «Ты знаешь, что такое лабиринты?»~
@23014 = ~Грейс соединяет указательные и большие пальцы обеих рук, образуя грубый круг. «Говорят, сила Госпожи позволяет взять кусочки Сигила… — ты с удивлением наблюдаешь, как призрачные подобия её пальцев отрываются от рук и начинают вращаться в воздухе, образуя небольшой кружок. — …И создать лабиринт».~
@23015 = ~Небольшой призрачный кружок висит в воздухе и начинает медленно вращаться. «И кусочек Сигила превращается в тюрьму, из которой просто нет выхода. Это может случиться в любой момент, идёшь ли ты по улице или проходишь через дверь… — она хлопает ладонями, — …и вдруг ты где-то в другом месте». Внезапно в центре призрачного круга ты видишь намёк на движение, как будто там кто-то бежит.~
@23016 = ~Грейс продолжает, маленький призрачный лабиринт отражается в её глазах. «Говорят, есть порталы, которые выводят из любого лабиринта, но их сложно найти. Возможно, они созданы для того, чтобы давать узнику надежду. Или мучить его, — призрачный лабиринт в её глазах тает. — А может, и то, и другое».~
@23017 = ~Грейс внимательно изучает символы. «Фелл говорит, что Рейвел пыталась „вскрыть Клетку“, — Грейс поворачивается к тебе. — Клетка — второе название Сигила». Грейс хмурится в раздумьи: «Не понимаю, зачем бы ей пытаться делать подобное… может быть, она хотела пробить брешь в стенах Сигила».~
@23018 = ~«Фелл не знает, как её можно найти. Он предостерегает нас от поисков, потому что… — Грейс изучает последнюю группу символов. — Фелл говорит, что Рейвел находится под „присмотром Госпожи“».~
@23019 = ~Грейс изучает символы и озабоченно хмурится: «Фелл убеждает нас не искать Рейвел. Он говорит, что у неё чёрное сердце. И если она ещё жива, то попытается навредить тебе… всем нам».~
@23020 = ~Грейс читает символы по мере их появления: «Фелл говорит, что эта рука точно твоя. А татуировки — его работа». Она прерывается и изучает последнюю группу символов. «Он говорит, татуировки повествуют о тех временах, когда ты делил дорогу с четырьмя другими…»~
@23021 = ~Грейс читает кружащиеся символы и её голос становится просто замогильным: «Разумы четырёх, которые тут описаны, это: та, кто любила безответной любовью… тот, что был слеп, но всё же видел… тот, кто… был приручён и, видимо, последний… раб, чьи слова были для него цепями…» Грейс замолкает, а символы образуют звенья и затем соединяются в цепь…~
@23022 = ~Грейс мягко говорит: «Страдание». Она изучает ребус, затем отворачивается, как будто ей больно. «Фелл говорит, — она вздыхает. — что плоть помнит страдание, даже когда забывает разум». Она поднимает голову и встречается с тобой взглядом. Её глаза странного лазурного оттенка, словно наполнены слёзами и печалью. «Фелл говорит, что руна работает как магнит, притягивает к тебе страдающие души».~
@23023 = ~«На руке старые татуировки, которые Фелл практически забыл. Он говорит, что теперь может перерисовать их, если ты пожелаешь».~
@23024 = ~«Фелл говорит, что не он нанёс эти татуировки, — Грейс на миг задумывается. — Он мог бы рассказать тебе о некоторых из них, если ты захочешь».~
@23025 = ~«Фелл говорит, что символы на спине сделаны аккуратной рукой — это указания для разума, который себя забыл. А вот на плече…» Неожиданно все символы вокруг Фелла гаснут, кроме одного.~
@23026 = ~Грейс хмурится: «Фелл говорит: „Тени“».~
@23027 = ~Грейс хмурится. «Фелл говорит, что множество теней пришло за тобой, устроили засаду и бросили тело умирать, — она снова окидывает символы взглядом. — Но он не знает, почему».~
@23028 = ~Грейс кажется загипнотизированной натянутыми на рамы кусками кожи вокруг. Но всё же отвлекается для перевода символов. «Это его галерея, — её голос почтителен, полон уважения. — Он говорит, что ты его холст, что он одновременно восхищается тобой и сочувствует тебе».~
@23029 = ~«Он говорит, знак страдания лежит на твоей плоти, — Грейс почти переходит на шёпот. — Трагедии и потери накладываются на этот знак. Он говорит, ты пережил большую боль».~
@23030 = ~Грейс слегка кивает, почти бессознательно, и продолжает переводить: «Фелл говорит, что восхищается тобой, поскольку ты не сдаёшься перед потерями, хотя они до сих пор цепями опутывают тебя». Грейс поворачивается к тебе: «Он восхищён твоей силой».~
@23031 = ~«Фелл говорит, что потери, которые ты вынес, покрывают и эту жизнь, и все твои прошлые жизни, — голос Грейс становится тише, а её глаза светятся, как заколдованные. — Он говорит, ты сбрасываешь жизни, как змея шкуры. И ты познаёшь жизни так, как только может человек».~
@23032 = ~«Фелл хочет предупредить тебя о том… — Грейс изучает следующую серию символов. — Он хочет предупредить тебя, что каждая из твоих жизней „порождает тени бытия“». Похоже, она обдумывает это, затем продолжает: «Он говорит, что ты должен посетить место, где эти тени пребывают в безумии, и шрамы сожалений покрывают землю».~
@23033 = ~«Фелл говорит, что ты не должен „ничего подписывать“, — Грейс поднимает брови. — Но не говорит, почему».~
@23034 = ~«Фелл спрашивает, чувствуешь ли ты себя целым. Или… так или иначе нецелым».~
@23035 = ~«Фелл говорит, что ты сильный человек, который многое перенёс, — Грейс поворачивается к тебе. — К его следующим словам я полностью присоединяюсь: держись веры. Так ты вновь станешь целым».~
@23036 = ~Грейс мягко говорит: «Страдание». Она изучает символ, затем отворачивается, как будто ей больно. «Фелл говорит… — она вздыхает. — Что плоть помнит страдание, даже когда забывает разум». Она поднимает голову и встречается с тобой взглядом. Её глаза странного лазурного оттенка, словно наполнены слёзами и печалью. «Фелл говорит, что руна работает как магнит, притягивает к тебе страдающие души».~
@23037 = ~«Приветствую, Фелл».~
@23038 = ~«Анна… что не так?»~
@23039 = ~«Прости, что потревожил. Прощай».~
@23040 = ~«Хм… приветствую».~
@23041 = ~«Анна… что не так?»~
@23042 = ~«Прости, что потревожил. Прощай».~
@23043 = ~Завязать разговор и попытаться перевести, что говорит Фелл.~
@23044 = ~Завязать разговор и попытаться перевести, что говорит Фелл.~
@23045 = ~Заговорить с Феллом и попытаться понять его язык.~
@23046 = ~«Фелл, можно посмотреть, какие татуировки у тебя есть?»~
@23047 = ~«У меня к тебе вопросы…»~
@23048 = ~«У меня к тебе вопросы…»~
@23049 = ~«Морте, можешь переводить для меня?»~
@23050 = ~«Морте, можешь переводить для меня?»~
@23051 = ~«Морте, можешь переводить для меня?»~
@23052 = ~«Морте, можешь переводить для меня?»~
@23053 = ~«Анна, можешь переводить для меня?»~
@23054 = ~«Дак'кон, можешь переводить для меня?»~
@23055 = ~«Грейс, можешь переводить для меня?»~
@23056 = ~«Неважно. Прости, что побеспокоил. Прощай».~
@23057 = ~Завязать разговор и попытаться перевести, что говорит существо.~
@23058 = ~Завязать разговор и попытаться перевести, что говорит существо.~
@23059 = ~Заговорить с существом и попытаться понять его язык.~
@23060 = ~«У меня к тебе вопросы…»~
@23061 = ~«У меня к тебе вопросы…»~
@23062 = ~«Морте, можешь переводить для меня?»~
@23063 = ~«Морте, можешь переводить для меня?»~
@23064 = ~«Морте, можешь переводить для меня?»~
@23065 = ~«Морте, можешь переводить для меня?»~
@23066 = ~«Анна, можешь переводить для меня?»~
@23067 = ~«Дак'кон, можешь переводить для меня?»~
@23068 = ~«Грейс, можешь переводить для меня?»~
@23069 = ~Игнорировать дабуса и обследовать салон.~
@23070 = ~«Приветствую».~
@23071 = ~«Приветствую».~
@23072 = ~«Приветствую».~
@23073 = ~«Приветствую».~
@23074 = ~Игнорировать существо и обследовать салон.~
@23075 = ~Завязать разговор и попытаться перевести, что говорит дабус.~
@23076 = ~Завязать разговор и попытаться перевести, что говорит дабус.~
@23077 = ~Заговорить с дабусом и попытаться понять его язык.~
@23078 = ~«У меня к тебе вопросы…»~
@23079 = ~«Морте, можешь переводить для меня?»~
@23080 = ~«Морте, можешь переводить для меня?»~
@23081 = ~«Морте, можешь переводить для меня?»~
@23082 = ~«Морте, можешь переводить для меня?»~
@23083 = ~«Анна, можешь переводить для меня?»~
@23084 = ~«Дак'кон, можешь переводить для меня?»~
@23085 = ~«Грейс, можешь переводить для меня?»~
@23086 = ~«Прости, я тебя не понимаю».~
@23087 = ~«Э-э… прощай».~
@23088 = ~«Может, ты поможешь мне…»~
@23089 = ~«Просто хотел попрактиковаться в ребусах. Прощай».~
@23090 = ~«Морте, можешь перевести мне, что он говорит?»~
@23091 = ~«Морте, можешь перевести мне, что он говорит?»~
@23092 = ~«Морте, можешь перевести мне, что он говорит?»~
@23093 = ~«Морте, можешь перевести мне, что он говорит?»~
@23094 = ~«Анна, можешь перевести мне, что он говорит?»~
@23095 = ~«Дак'кон, можешь перевести мне, что он говорит?»~
@23096 = ~«Падшая Грейс, можешь перевести мне, что он говорит?»~
@23097 = ~«Прости, я тебя не понимаю».~
@23098 = ~«Э-э… прощай».~
@23099 = ~Уйти.~
@23100 = ~«Э-э… прощай».~
@23101 = ~«Кто ты?»~
@23102 = ~«Кто ты?»~
@23103 = ~«Что это за место?»~
@23104 = ~«Что это за место?»~
@23105 = ~«Фелл, похоже, я тебя знаю».~
@23106 = ~«Фелл, похоже, я тебя знаю».~
@23107 = ~«Фелл, похоже, я тебя знаю».~
@23108 = ~«Фелл, похоже, я тебя знаю».~
@23109 = ~«Ты сказал, что видел меня раньше, Фелл… не знаешь, как я умер?»~
@23110 = ~«Ты сказал, что видел меня раньше, Фелл… не знаешь, как я умер?»~
@23111 = ~«Фелл, что тебе известно о Рейвел?»~
@23112 = ~«Фелл, что тебе известно о Рейвел?»~
@23113 = ~«Не ты ли делал татуировки на этой найденной отрубленной руке, Фелл?»~
@23114 = ~«Не ты ли делал татуировки на этой найденной отрубленной руке, Фелл?»~
@23115 = ~«Можешь что-нибудь рассказать о татуировках на моём теле?»~
@23116 = ~«Можешь что-нибудь рассказать о татуировках на моём теле?»~
@23117 = ~«Могу я посмотреть, что у тебя за татуировки?»~
@23118 = ~«Могу я посмотреть, что у тебя за татуировки?»~
@23119 = ~«Неважно. Прощай».~
@23120 = ~«Что он сказал, Анна?»~
@23121 = ~«Что он сказал, Дак'кон?»~
@23122 = ~«Что он сказал, Грейс?»~
@23123 = ~«Что он сказал, Анна?»~
@23124 = ~«Что он сказал, Дак'кон?»~
@23125 = ~«Что он сказал, Грейс?»~
@23126 = ~«Фелл, похоже, я тебя знаю».~
@23127 = ~«У меня есть другой вопрос…»~
@23128 = ~«Это всё, что я хотел узнать. Прощай».~
@23129 = ~«Что он сказал, Анна?»~
@23130 = ~«Что он сказал, Дак'кон?»~
@23131 = ~«Что он сказал, Грейс?»~
@23132 = ~«Фелл, похоже, я тебя знаю».~
@23133 = ~«У меня есть другой вопрос…»~
@23134 = ~«Это всё, что я хотел узнать. Прощай».~
@23135 = ~«Что он сказал, Анна?»~
@23136 = ~«Что он сказал, Дак'кон?»~
@23137 = ~«Что он сказал, Грейс?»~
@23138 = ~«Что он сказал, Анна?»~
@23139 = ~«Что он сказал, Дак'кон?»~
@23140 = ~«Что он сказал, Грейс?»~
@23141 = ~«Могу я посмотреть, что у тебя за татуировки?»~
@23142 = ~«У меня есть другой вопрос…»~
@23143 = ~«Это всё, что я хотел узнать. Прощай».~
@23144 = ~«Что он сказал, Анна?»~
@23145 = ~«Что он сказал, Дак'кон?»~
@23146 = ~«Что он сказал, Грейс?»~
@23147 = ~«Могу я посмотреть, что у тебя за татуировки?»~
@23148 = ~«У меня есть другой вопрос…»~
@23149 = ~«Это всё, что я хотел узнать. Прощай».~
@23150 = ~«Что он сказал, Анна?»~
@23151 = ~«Что он сказал, Дак'кон?»~
@23152 = ~«Что он сказал, Грейс?»~
@23153 = ~«Что он сказал, Анна?»~
@23154 = ~«Что он сказал, Дак'кон?»~
@23155 = ~«Что он сказал, Грейс?»~
@23156 = ~«Ты знаешь, кто я?»~
@23157 = ~«Ясно. У меня есть другой вопрос, Фелл».~
@23158 = ~«Я услышал достаточно. Прощай».~
@23159 = ~Игнорировать женщину и обследовать комнату.~
@23160 = ~Пожилая женщина поворачивается и пристально на тебя смотрит… ты замечаешь, что покрывающие её кожу серые пятна захватывают также и лицо. У неё тонкие седые волосы, а глаза словно гранитные камушки. При виде тебя она хмурится: «И кто же ты таков, хм-м-мн?»~
@23161 = ~«Я путешественник».~
@23162 = ~«Да я и сам толком не знаю, кто я».~
@23163 = ~Ложь: «Меня звать Аданом. А ты кто?»~
@23164 = ~Ложь: «Меня звать Аданом. А ты кто?»~
@23165 = ~«Прости, что потревожил. Прощай».~
@23166 = ~Заслышав шаги, Меббет оборачивается к тебе и окидывает скептическим взглядом: «Твой путь снова привёл тебя сюда, не так ли, дитя?..»~
@23167 = ~«Я отыскал на рынке торговца фруктами».~
@23168 = ~«Я вернулся с травами, которые ты просила… а теперь тебя не затруднит убрать эти долбаные колючки с моего запястья?»~
@23169 = ~«Я принёс твои постиранные вещи… хотя сдаётся мне, Гискорл немного перестарался со своим очистительным ритуалом».~
@23170 = ~«Да, у меня к тебе кое-какие вопросы…»~
@23171 = ~«Да, мне нужно лечение».~
@23172 = ~«Я пришёл купить у тебя снадобий и амулетов…»~
@23173 = ~«Можно мне отдохнуть здесь?»~
@23174 = ~«Нет, просто мимо пробегал. Прощай».~
@23175 = ~«Вот как? И *откуда* же ты двинулся в путь?»~
@23176 = ~«Из царства смерти и обратно, полагаю».~
@23177 = ~«Из Мортуария в Улей, а потом сюда».~
@23178 = ~«Откуда-то неподалёку… вообще, всех мест уже и не упомню».~
@23179 = ~«Не имеет значения. Прощай».~
@23180 = ~Женщина сплёвывает… дважды… потом проводит над сердцем полукруг: «Осторожней с тем, что говоришь, дитя… и молись, чтоб одну из сил смерти не оскорбили твои слова».~
@23181 = ~«Ясно… а ты кто?»~
@23182 = ~«Буду иметь в виду. Прощай».~
@23183 = ~«Ха! Бледнолицые из Мортуария, вечно в заботах, чтоб мертвяки лежали по своим местам! Тьфу! Дураки и Пылюки — два слова, а смысл один». Внезапно лицо женщины становится пустым, а глаза закатываются.~
@23184 = ~«Ты в порядке?»~
@23185 = ~«Э-э… прости за беспокойство. Прощай».~
@23186 = ~Женщина начинает бормотать, в её голосе слышна насмешка: «Моя Пыльный. Моя хотеть умереть, ибо жизнь — фальшивка». Её глаза возвращаются к нормальному состоянию, и она фыркает: «Пылюки! Ничегошеньки не понимают…» Она тычет пальцем в тебя: «Если ты сбежал от этой жизни, дитя, едва ли тебе есть куда податься».~
@23187 = ~«Ясно… а ты кто?»~
@23188 = ~«Прости, что потревожил. Прощай».~
@23189 = ~«А-а-а… — она кивает сама себе. — Блуждал-блуждал и решил-таки прийти к моим дверям, да?» Она фыркает: «Счастье-то какое».~
@23190 = ~«Кто ты?»~
@23191 = ~«Прости, что потревожил. Прощай».~
@23192 = ~«Так ты не знаешь себя, дитя? — она щурится, а затем указывает пальцем на твою грудь. — Все эти рисунки и рваные шрамы… тяжко было, видать, собрать тебя воедино, да?»~
@23193 = ~«Наверное… кто ты?»~
@23194 = ~«Я должен идти. Прощай».~
@23195 = ~Она лукаво хихикает и двигает бровями. «Неужто не слыхал про старую Меббет, бабку-повитуху с Площади? Вообще ничего? — старушка прищуривается и понижает голос. — Ну вот, теперь услыхал — ведь *я* и есть Меббет».~
@23196 = ~«Ты повитуха? Чем именно ты занимаешься?»~
@23197 = ~«Вправляю кости, сбиваю больным кашель, вытаскиваю орущих упирающихся младенцев, одежду чиню при случае, делаю снадобья, собираю травы и всё такое прочее, — она косится на тебя, изучая твои шрамы. — Снадобья не нужны?»~
@23198 = ~«Снадобья?»~
@23199 = ~«Нет, спасибо. Мне пора идти. Прощай».~
@23200 = ~«Ага, на вид — так ты прям нуждаешься в снадобьях. Купить не хочешь, а?.. — она снова окидывает взглядом шрамы, покрывающие всё твоё тело, затем пожимает плечами. — Хм-м… или поздновато уже спрашивать?»~
@23201 = ~«Вообще-то, лечение мне бы *не помешало*…»~
@23202 = ~«Вообще-то, лечение нам бы *не помешало*…»~
@23203 = ~«Мне пока не нужны снадобья, но они могли бы пригодиться позже. Можно посмотреть, что у тебя в наличии?»~
@23204 = ~«На самом деле, мне нужно место для отдыха. Не возражаешь, если я посплю здесь?»~
@23205 = ~«Не сейчас. Но у меня пара вопросов…»~
@23206 = ~«Ясно. Мне пора идти. Прощай».~
@23207 = ~Меббет кивает: «Ну хорошо». Она тянется к высушенным травам на своём поясе, отрывает листья от стебля и растирает в своих мозолистых ладонях. Маленькие частички пыли и пыльцы поднимаются из её рук. Меббет что-то бормочет себе под нос и сдувает пыль в твоём направлении…~
@23208 = ~Глубоко вдохнуть.~
@23209 = ~Глубоко вдохнуть.~
@23210 = ~Серая пыльца кружит по комнате, ты вдыхаешь её полной грудью… и мгновение спустя чувствуешь себя странным образом посвежевшим.~
@23211 = ~«Спасибо, Меббет. Пока не ушёл, у меня есть ещё вопросы…»~
@23212 = ~«Спасибо, Меббет… чувствую себя отлично. Прощай».~
@23213 = ~Серая пыльца кружит по комнате, обволакивая тебя и твоих товарищей. Ты вдыхаешь её полной грудью… и мгновение спустя спустя чувствуешь себя странным образом посвежевшим.~
@23214 = ~«Спасибо, Меббет. Пока не ушёл, у меня есть ещё вопросы…»~
@23215 = ~«Спасибо, Меббет… чувствую себя отлично. Прощай».~
@23216 = ~«Хочешь чего-нибудь ещё, дитя?»~
@23217 = ~«На самом деле, да… можно посмотреть, что у тебя есть на продажу?»~
@23218 = ~«Нет, но у меня другие вопросы…»~
@23219 = ~«Не сегодня, Меббет… спасибо. И прощай».~
@23220 = ~«Я продаю разного рода настойки, припарки, зелья и подобную дребедень… — она пожимает плечами. — Кроме того, если найдёшь какую-нибудь подозрительную штуку и не сможешь с ней разобраться, неси к Меббет… ничего не обещаю, дитя, но выяснить, что это за вещица, я попробую».~
@23221 = ~«Ясно. Тогда можно посмотреть, что у тебя есть на продажу?»~
@23222 = ~«Хорошо. У меня другие вопросы…»~
@23223 = ~«Это всё, что я хотел узнать. Прощай».~
@23224 = ~«Тогда давай, спрашивай».~
@23225 = ~«Не знаешь кого-нибудь по имени Фарод?»~
@23226 = ~«У меня пропал дневник. Есть идеи, где я мог бы его найти?»~
@23227 = ~«Меббет, ты слышала про кого-нибудь по имени „Рейвел“?»~
@23228 = ~«Мне бы подлечиться…»~
@23229 = ~«Меббет, что ты здесь продаёшь?»~
@23230 = ~«Можно купить у тебя немного снадобий?»~
@23231 = ~«Можно мне здесь отдохнуть?»~
@23232 = ~«Я нашёл на рынке торговца фруктами».~
@23233 = ~«Я вернулся с травами, которые ты просила… а теперь тебя не затруднит убрать эти долбаные колючки с моего запястья?»~
@23234 = ~«Я принёс твои постиранные вещи… хотя сдаётся мне, Гискорл немного перестарался со своим очистительным ритуалом».~
@23235 = ~«Я нашёл Косса-Джай. Чернил у неё не оказалось, но у другой торговки есть рыба, которая содержит в себе чернила. Проблема в том, что мне не во что их налить».~
@23236 = ~«Вот чернила, которые ты просила».~
@23237 = ~«Меббет, ты ведьма?»~
@23238 = ~«Меббет, я хочу обучиться Искусству».~
@23239 = ~«Меббет, я бы хотел поменять профессию и сосредоточиться на изучении магии».~
@23240 = ~~
@23241 = ~~
@23242 = ~«Больше вопросов нет. Прощай».~
@23243 = ~«Фарод?! Этот… этот… тьфу! — Меббет плюёт… дважды… и рисует в воздухе полукруг над сердцем. — Этот упырище! Чего тебе может быть надо от такого типа?»~
@23244 = ~«Мне просто надо разыскать его. Не знаешь, где он?»~
@23245 = ~«Неважно. У меня другие вопросы…»~
@23246 = ~«Ничего, неважно. Мне нужно идти. Прощай».~
@23247 = ~«Он не *на* Площади Мусорщиков — это всё, что я могу сказать… чтоб добраться до логова этого паука, тебе надо искать путь *под* Площадью, — она снова сплёвывает. — Даже от разговоров о нём мерзкий вкус во рту, вот».~
@23248 = ~«Он под Площадью?»~
@23249 = ~«Ясно. У меня другие вопросы…»~
@23250 = ~«Это всё, что я хотел узнать. Прощай».~
@23251 = ~Она тыкает пальцем в пол. «Ага, он закопался под теми кучами мусора, он и его свита, и выкопать его оттуда будет непросто, — она трясёт головой. — Ты лучше оставь эту затею, дитя».~
@23252 = ~«Мне нужно найти его. Как мне туда спуститься?»~
@23253 = ~«Ясно. У меня другие вопросы…»~
@23254 = ~«Это всё, что я хотел узнать. Прощай».~
@23255 = ~Я решил оставить себе «счастливый» нож Ухира. Похоже, хозяин ножа не слишком этому обрадовался.~
@23256 = ~Меббет хмурится, а затем вздыхает. «Слыхала я, Фарод свил себе гнездо за какими-то воротами. Они где-то здесь, на Площади… нужно просто отыскать. Ты поспрошай других, кто бродит тут поболе старушки Меббет».~
@23257 = ~«Ясно. У меня другие вопросы…»~
@23258 = ~«Это всё, что я хотел узнать. Прощай».~
@23259 = ~Меббет задумывается. «Нет, ничего такого я не видела. Если б он был на Площади — в чём я сомневаюсь, ведь народ тут нечасто шатается с книгами, — скорее всего, его бы уже украли или продали. А что, он тебе был важен? Или он волшебная штукенция, вся такая светящаяся и искрящаяся магией, а? Если так, то тебе его уже никогда не найти».~
@23260 = ~«Может, и так. У меня другие вопросы…»~
@23261 = ~«Я начинаю думать, что едва ли когда-нибудь увижу его снова. Прощай».~
@23262 = ~«Тьфу! — Меббет шипит и осеняет себя полукругом над сердцем. — Даже не заикайся о ней! Не называй это имя в *моём* присутствии!» Она тычет в тебя пальцем: «Зло, зло! Только назови, и зло постучится в твою дверь».~
@23263 = ~«Что ты о ней знаешь?»~
@23264 = ~«Тогда неважно. У меня другие вопросы…»~
@23265 = ~«Прошу прощения, не хотел тебя обидеть. Прощай».~
@23266 = ~«О Рейвел? Тьфу! Выдумка и страшилка для детишек, — она понижает голос, словно предупреждает тебя. — Послушай, дитя: НЕ БЫЛО никакой Рейвел, не было ВООБЩЕ… а даже если и *была*, тебе не стоит трепаться об этом в Клетке».~
@23267 = ~«Меббет, мне нужно знать всё, что можешь рассказать. Это важно».~
@23268 = ~«Ладно, забудь. У меня другие вопросы…»~
@23269 = ~«Прошу прощения, не хотел тебя обидеть. Прощай».~
@23270 = ~Меббет хмурится… похоже, она не хочет пересекаться с твоим пристальным взглядом. «Плохие… плохие вещи таятся в этом имени… — она снова смотрит на тебя. — Испорченное ведьмино сердце Рейвел скрывает много злых, чёрных теней. Коварство и злоба сплелись в нём, как клубок змей. Больше и говорить не о чём. Оставь, оставь!»~
@23271 = ~«Меббет, ты знаешь, где она сейчас? Я должен её найти».~
@23272 = ~«Ладно, забудь. У меня другие вопросы…»~
@23273 = ~«Прошу прощения, не хотел тебя обидеть. Прощай».~
@23274 = ~«Как найти ведьму из сказки?! Меббет не знает! — она шипит. — А *если бы* даже и знала, то разве сказала бы тебе? Не-е, ты захотел бы найти её, а я не могу и мысли такой допустить, не могу…» Она выглядит убитой горем. «Но дитя… если тебе правда так нужно знать, если это съедает тебя изнутри… ну ладно, тогда я расскажу тебе».~
@23275 = ~«Прошу тебя, Меббет… я должен её разыскать».~
@23276 = ~«Ладно, забудь. У меня другие вопросы…»~
@23277 = ~«Знаешь, мне нужно знать не настолько сильно. Прощай».~
@23278 = ~Меббет предложила мне поговорить с мудрецами в Фестхолле, расположенном в районе Клерков. У них можно попробовать узнать, как отыскать вход в лабиринт Рейвел.~
@23279 = ~«Рейвел…» — Меббет вздыхает. «Рейвел, жестокая Рейвел, заключённая Госпожи, да-да, в тюрьме, в лабиринте… говорят, её поместили туда так давно, о-очень давно… но разыскивать её? Меббет не знает пути», — она снова вздыхает. «Попробуй спросить в Фестхолле, что в районе Клерков. Кто-нибудь из серобородых, быть может, поведает тебе об этой тайне…»~
@23280 = ~«А что-нибудь ещё о Рейвел знаешь?.. Что мне нужно знать перед тем, как разыщу её?»~
@23281 = ~«Спасибо… посмотрим, что мне удастся выяснить. Но сначала у меня другие вопросы…»~
@23282 = ~«Тогда пойду, поговорю с ними. Прощай».~
@23283 = ~«Дитя… — голос Меббет звучит устало и надломленно, — …если ты ищешь на планах зло… тебе не надо далеко ходить». Она кашляет: «Ведьмы знают про ведьм, сила знает о силе… но *никто* не знает всей черноты и коварства Рейвел. Хорошо подготовься и держи глаза открытыми. Верь себе, но не доверяй ей, слышишь?»~
@23284 = ~«Анна, что он сказал?»~
@23285 = ~«Так и сделаю. Спасибо, Меббет».~
@23286 = ~Меббет вздыхает. «Я никому не желаю зла, кроме неё. Я рада, что её больше нет, да-да, и воздух в Клетке стал чище. И снова скажу я тебе, дитя… оставь прошлое гнить там, где оно есть. Не буди его, не буди».~
@23287 = ~«Я запомню твоё предупреждение. У меня другие вопросы…»~
@23288 = ~«Что он сказал, Дак'кон?»~
@23289 = ~«Прости, Меббет. Я должен отыскать Рейвел. Прощай».~
@23290 = ~«Если бы меня попросили рассказать сказку… — Меббет говорит медленно, тщательно подбирая слова, — …этот рассказ начинался бы с одной серой *сестры*, жившей на планах, а если точнее, на полях Серых Пустошей. Пустоши эти были весьма себе тихим местом, очень спокойным, и именно тишина взрастила семена недовольства в сердце Рейвел».~
@23291 = ~«Да?..»~
@23292 = ~«Думаю, я услышал достаточно. У меня другие вопросы…»~
@23293 = ~«Я должен идти. Прощай».~
@23294 = ~«Всегда хотела обо всём знать *почему*, и *отчего*, и *а что если*. Всегда хотела быть на шаг впереди всех остальных, — Меббет вздыхает. — И может…»~
@23295 = ~«Что может?..»~
@23296 = ~«Думаю, я услышал достаточно. У меня другие вопросы…»~
@23297 = ~«Я должен идти. Прощай».~
@23298 = ~«И может, Рейвел, прекрасная в своей силе, коварстве и жестокости, пришла в этот город, в эту Клетку, просто горевшую суетой и мыслями, поскольку именно здесь люди стремились к разному, лишь бы только *познать*».~
@23299 = ~Слушать.~
@23300 = ~«Думаю, я услышал достаточно. У меня другие вопросы…»~
@23301 = ~«Я должен идти. Прощай».~
@23302 = ~«Но знаний было *недостаточно* для сил Рейвел, столь многие… столь многие пострадали, и Клетка, этот город, затрещала от нужд и желаний ведьмы. Таким злом… — она проводит полукруг над сердцем. — Таким злом была Рейвел… у меня просто не хватает слов передать. Она была изгнана, заточена в лабиринт…»~
@23303 = ~Слушать.~
@23304 = ~«Думаю, я услышал достаточно. У меня другие вопросы…»~
@23305 = ~«Я должен идти. Прощай».~
@23306 = ~«И быть может, лабиринт тот тоже был тихим, как её маленькая хижина на Серых Пустошах. И быть может, тишина и спокойствие прокрались в душу Рейвел и теперь уже не были ей неприятны. И может, жестокая Рейвел со всей своей чернотой и коварством была наконец довольна, — Меббет вздыхает. — Быть может, именно так заканчивается история Рейвел. Кто знает?»~
@23307 = ~«Безусловно. У меня другие вопросы…»~
@23308 = ~«Спасибо за рассказ, Меббет, но мне пора идти. Прощай».~
@23309 = ~«Сказал же не говорить со мной», — крыса-оборотень по-прежнему на тебя не смотрит.~
@23310 = ~«Тебе что, пойти некуда? Не сюда куда-нибудь?» — голос крысы-оборотня вялый и беззаботный.~
@23311 = ~«О, назад на путь истинный, да? — Меббет сухо хихикает. — Хорошо, давай посмотрим, что ты забыл и что помнишь…»~
@23312 = ~«Ладно…»~
@23313 = ~Я партнер Шаддеуса по преступному бизнесу. Мы запираем тебя! Ну ты и тупица.~
@23314 = ~Меббет научила меня Искусству, так что теперь я стою на пути изучения магии… Если я снова захочу переквалифицироваться в вора или воина, то мне нужно будет найти соответствующего учителя.~
@23315 = ~Пожалуйста, выпустите меня, или я никогда не закончу игру!~
@23316 = ~Меббет хмурится, затем кивает: «Да, ты весьма неплохо помнишь основы Искусства. Отныне ты снова идёшь по пути магии — больше ты не воин и не вор, пока снова не переучишься у подходящего наставника».~
@23317 = ~«Спасибо, Меббет. У меня были кое-какие вопросы…»~
@23318 = ~«Буду иметь в виду. Прощай, Меббет».~
@23319 = ~Меббет качает головой… похоже, не без печали. «Я научила тебя всему, чему могла, дитя… то немногое ценное, что осталось без упоминания, тебя не заинтересует. Я горжусь тобой, да-да. Ты станешь могущественным чародеем, да-да».~
@23320 = ~«Спасибо, Меббет. У меня были кое-какие вопросы…»~
@23321 = ~«Ты была хорошим учителем. Прощай, Меббет».~
@23322 = ~Похоже, Меббет больше не может научить меня ничему новому в области Искусства. Для расширения моих магических познаний придётся поискать других, более искушённых учителей.~
@23323 = ~Меббет тебя разглядывает. «Хочешь узнать, чему ещё я смогу тебя обучить? Давай посмотрим, что ты уже знаешь и чему ты уже обучен… и найдётся ли у тебя свободное место в черепушке, дитя…»~
@23324 = ~«Ладно…»~
@23325 = ~«Ладно…»~
@23326 = ~Меббет сказала, что мне нужно набраться больше опыта, прежде чем она сможет научить меня чему-либо в области Искусства.~
@23327 = ~Меббет качает головой: «Тебе нужно больше времени, чтоб поработать над собой. Возвращайся, когда наберёшься больше опыта, тогда и посмотрим, можно ли научить тебя чему-нибудь новому».~
@23328 = ~«Хорошо. Но у меня к тебе ещё вопросы…»~
@23329 = ~Ты успеваешь разглядеть только панику на измождённом лице Сборщика перед тем, как тот разворачивается и убегает.~
@23330 = ~«Я вернусь, когда подучусь. Прощай, Меббет».~
@23331 = ~«Ухир, постой… блин».~
@23332 = ~Меббет кивает: «Да, ты вырос, обучился, как мне кажется. Я могу ещё немного поучить тебя, да-да… ещё один из моих рецептов…»~
@23333 = ~Заклинание 1: Устрашение~
@23334 = ~Заклинание 2: Друзья~
@23335 = ~«Э-э… ну, меня малость покусал упырь там, ниже, када я искал всякое барахло для продажи».~
@23336 = ~Заклинание 3: Умиротворение~
@23337 = ~«Ниже?»~
@23338 = ~Заклинание 4: Захват~
@23339 = ~Заклинание 5: Кровавый мост~
@23340 = ~«У меня к тебе ещё кое-какие вопросы».~
@23341 = ~Заклинание 6: Раздражение~
@23342 = ~«Ясно. Прощай».~
@23343 = ~Она кивает: «Конечно, дитя. Там в углу свалены одеяла, они могут тебе пригодиться…»~
@23344 = ~«Зовут Ухир, ага, — он сплёвывает. — Как будто тут внизу это что-то значит».~
@23345 = ~«Это твой нож с вырезанным именем „УХИР“?»~
@23346 = ~«Отлично, спасибо».~
@23347 = ~«Хорошо. У меня к тебе ещё кое-какие вопросы».~
@23348 = ~«Ясно. Прощай».~
@23349 = ~Он кивает, но ничего не говорит.~
@23350 = ~«Кто ты?»~
@23351 = ~«Чем занимаешься?»~
@23352 = ~«Ты весь в бинтах. Что случилось?»~
@23353 = ~«Забудь. Прощай».~
@23354 = ~«Жду, када заживут раны, потом отправлюсь в очередную вылазку. Я разыскиваю там, ниже, разные шмотки на продажу».~
@23355 = ~«Ниже?»~
@23356 = ~«Отлично, спасибо».~
@23357 = ~«У меня другие вопросы…»~
@23358 = ~«Отлично, спасибо».~
@23359 = ~«Это всё, что я хотел знать. Прощай».~
@23360 = ~Ты просыпаешься со свежими силами. Меббет прибирается в хижине, но, услышав, как ты поднимаешься, она поворачивается к тебе. «Проснулся, а? Спал как убитый, — она улыбается. — Сны не снились?»~
@23361 = ~«Хм… знаешь, мне вообще никогда не снятся сны».~
@23362 = ~Меббет пожимает плечами: «Ничего странного. Большинство снов застенчивы, они улетают, когда веки спящего открываются».~
@23363 = ~«Нет, непохоже, что я их забываю… я не думаю, что *вообще* их вижу. Это как-то… неправильно».~
@23364 = ~Меббет обдумывает твои слова, затем снова пожимает плечами: «Сны могут возвеличить, но лежат они низко, как и многое. Быть может, без них тебе даже лучше».~
@23365 = ~«Быть может… но я так не думаю».~
@23366 = ~Он кивает: «Внизу, в катакомбах, где все трупаки. Скажи… ты не собираешься туда как-нибудь?»~
@23367 = ~Когда я спал в хижине Меббет, я внезапно понял, что мне не снятся сны. Непохоже, что я их забываю… думаю, они мне *вообще* не снятся. Это кажется… неправильным. Надо бы хорошенько проверить это дело, как выпадет возможность.~
@23368 = ~«Возможно. А что?»~
@23369 = ~Меббет фыркает: «Ну, снятся или не снятся — я не могу изменить природу человека. Выспался-то хоть хорошо?»~
@23370 = ~«Забудь. У меня к тебе ещё кое-какие вопросы…»~
@23371 = ~«Быть может. Прощай».~
@23372 = ~Ухир кивает: «Спасиб ещё раз, мужик, что вернул мой счастливый ножик».~
@23373 = ~«Конечно. Прощай».~
@23374 = ~Ухир смотрит с опаской, как пёс, который боится, что у него украдут еду: «А? Опять? Чаво надо?»~
@23375 = ~«Мне нужны ответы».~
@23376 = ~«Ничего. Прощай».~
@23377 = ~Этот мужчина среднего возраста с кислым выражением лица при виде тебя тянется к поясу… но не найдя там оружия, просто пятится. Под его одеянием Сборщика ты видишь замотанные грязными бинтами голени и предплечья. «Чаво надо?»~
@23378 = ~«Ответы на кое-какие вопросы…»~
@23379 = ~«Ничего. Прощай».~
@23380 = ~«Просто я потерял свой счастливый ножик!» — он сердито шмыгает носом и топает ногой. «Он был со мной много лет, вот тут…» — он показывает пустые ножны на поясе.~
@23381 = ~«И что с ним произошло?»~
@23382 = ~«Какая жалость. Но у меня к тебе ещё кое-какие вопросы…»~
@23383 = ~«Надеюсь, ты его найдёшь. Прощай».~
@23384 = ~«Я лазал по катакомбам и там нарвался на упыря! Думал, пропаду: они обычно в одиночку не ходят. Он укусил меня в лицо, а я закрылся руками и всадил ему ножик в глаз. Упырь упал и укусил меня за ногу, так я отбросил этого говнюка и сбежал».~
@23385 = ~«А вот этот ножик, на котором вырезано „УХИР“, случайно, не твой?»~
@23386 = ~«Ну и дела! Я принесу тебе твой ножик, если увижу его внизу».~
@23387 = ~«Надеюсь, ты найдёшь свой ножик. У меня ещё кое-какие вопросы».~
@23388 = ~«Как уже говорил, я принесу его тебе, если найду. А пока у меня пара вопросов».~
@23389 = ~«Спорим, упырь тоже недоволен. Прощай».~
@23390 = ~«Правда? Было б здорово, ага. Там моё имя вырезано на рукоятке…»~
@23391 = ~«Рад буду помочь. А пока у меня ещё кое-какие вопросы…»~
@23392 = ~«Видишь ли, я ничего не делаю бесплатно».~
@23393 = ~«Мне пора идти. Прощай».~
@23394 = ~Ухир хмурится: «Я бы дал, что есть, но это немного. Смотри сам, мужик… я не осыплю тебя сокровищами».~
@23395 = ~«Ладно. Но у меня к тебе ещё кое-какие вопросы…»~
@23396 = ~«Поговорим, когда ножик будет у меня. Прощай».~
@23397 = ~Ухир косится на тебя: «Случаем, не нашёл мой ножик?»~
@23398 = ~«Да, нашёл… вот он».~
@23399 = ~«Нашёл».~
@23400 = ~Ложь: «Нет… не нашёл. Прощай».~
@23401 = ~«Нет пока. Ещё раз, где ты его потерял?»~
@23402 = ~«Ещё нет. Прощай».~
@23403 = ~Ухир берёт нож и нежно его поглаживает. «А, ты вернулся! Мой счастливый ножик… спасиб, мужик. А *ты*! — он назидательно обращается к ножу, потряхивая его. — Больше никогда не ныкайся от меня!» Он с улыбкой засовывает клинок обратно в ножны.~
@23404 = ~«Прощай, Ухир».~
@23405 = ~«Всё, что у меня есть, — эта горстка меди, мужик… — он протягивает дюжину монет или около того. — Достаточно?»~
@23406 = ~«Вполне достаточно. Держи ножик».~
@23407 = ~«Да не надо мне денег, Ухир… забирай его так».~
@23408 = ~«Хм-м. Тогда я просто оставлю его себе. Прощай».~
@23409 = ~Глаза Ухира округляются от удивления: «Это ж мой счастливый ножик!»~
@23410 = ~«Вот, забирай. Он твой по праву».~
@23411 = ~«Если хочешь получить обратно, я могу его продать».~
@23412 = ~«Славный нож… я оставлю его себе, Ухир. Прощай».~
@23413 = ~«Да, спасибо. У меня появились вопросы…»~
@23414 = ~«Думаю, да. Ну, мне пора идти. Прощай».~
@23415 = ~Ты просыпаешься со свежими силами. Меббет прибирается в хижине, но, услышав, как ты поднимаешься, она поворачивается к тебе. «Проснулся, а? Хорошо выспался?»~
@23416 = ~«Да, спасибо. У меня появились вопросы…»~
@23417 = ~«Думаю, да. Ну, мне пора идти. Прощай».~
@23418 = ~Меббет разглядывает тебя. «Я ничего не скажу о том, кто я. А вдруг ты так сильно хочешь об этом знать, чтоб преследовать старую женщину и распускать про неё сплетни?»~
@23419 = ~«Я хочу обучиться магии. Можешь меня научить?»~
@23420 = ~«Забудь. У меня другие вопросы…»~
@23421 = ~«Не бери в голову. Мне пора идти. Прощай».~
@23422 = ~Меббет смеётся: «Тьфу! Я не учитель, не наставница вроде тех, что в Фестхолле сидят! Поищи себе кого-нибудь другого, кто раскроет тебе эти тайны… со старой Меббет это будет просто пустая трата времени, да-да».~
@23423 = ~«Я не согласен. Думаю, ты многому можешь меня научить».~
@23424 = ~«Тогда забудь. У меня другие вопросы…»~
@23425 = ~«Я должен идти. Прощай».~
@23426 = ~Меббет пристально на тебя смотрит: «О, неужто? И *зачем* ты хочешь учиться подобным вещам?»~
@23427 = ~Правда: «Я просто хочу знать».~
@23428 = ~Правда: «Мне нужно разгадать загадку — кто я?»~
@23429 = ~Правда: «Мне нужна сила».~
@23430 = ~Меббет усмехается. «Это тебе не букварь и не свод законов… это *Искусство*, дитя. Я бы научила, но тебе нельзя будет забивать голову ничем другим».~
@23431 = ~«У меня на то личные причины».~
@23432 = ~«Неважно. У меня другие вопросы…»~
@23433 = ~«Не бери в голову… мне пора идти. Прощай».~
@23434 = ~«Уже уходим. Спасибо».~
@23435 = ~«Я понимаю. Так ты научишь меня?»~
@23436 = ~~
@23437 = ~~
@23438 = ~Через миг Меббет кивает. «Искусство может помочь, а может и не помочь. Тебе не стоит рассчитывать, что оно решит все твои проблемы, — она вздыхает. — Дитя, скорее всего, оно добавит в твою голову кучу новых вопросов…»~
@23439 = ~«Я понимаю. Так ты научишь меня?»~
@23440 = ~~
@23441 = ~~
@23442 = ~«Тьфу! Дурное желание, ведь на лестнице Искусства всегда будут новые ступени и всегда найдётся кто-то или что-то выше и лучше тебя. И они преподадут *тебе* жестокие уроки, если будешь зарываться».~
@23443 = ~«Я понимаю. Но всё равно, ты обучишь меня?»~
@23444 = ~~
@23445 = ~~
@23446 = ~«Вот как? Ну, раз у тебя свои причины, то у меня своё *знание*. Я не буду обучать того, кто таится от учителя… только зло идёт по такому пути».~
@23447 = ~Правда: «Ладно, я хочу познать Искусство из-за своего стремления к знаниям».~
@23448 = ~Правда: «Я хочу изучить Искусство, потому что хочу понять, кто я такой».~
@23449 = ~Правда: «Я хочу обучиться Искусству, потому что мне нужна сила».~
@23450 = ~«Не бери в голову. У меня другие вопросы…»~
@23451 = ~«Тогда забудь. Прощай».~
@23452 = ~«Ну ладно… — она фыркает. — Если ты по-прежнему хочешь учиться, то у меня для тебя ещё одно задание. Я забыла сказать в прошлый раз, чтоб ты принёс одну вещь. Возвращайся на площадь торговцев и найди там торговца одеждой по имени Гискорл. Забери у него мои тряпки, которые он должен был постирать — я оставила их ему довольно давно».~
@23453 = ~«Ясно… слушай, у меня к тебе кое-какие вопросы…»~
@23454 = ~«Могла бы об этом и *раньше* упомянуть… хорошо, я скоро вернусь».~
@23455 = ~«Пойду заберу. Прощай».~
@23456 = ~«Тьфу! — Меббет качает головой. — Ты б лучше петь учился, а не магии. Песни более красивы. Магия — скучная, затасканная штука, которую бессмысленно используют все кому не лень… хмпф-ф-ф». Она косится на тебя: «Я поучу тебя… но сначала сделай кое-что для *меня*, слышишь?»~
@23457 = ~«Что, например?»~
@23458 = ~«Мои ноги уже не так хороши, чтоб бегать по Сигилу, и мои поручения потребуют *побегать* от тебя. Мне нужно, чтоб ты принёс мне кое-каких трав с рынка… это к шпилю, на юго-восток отсюда. Вот образец…» — она достаёт из кармана чёрное семя и бросает его тебе.~
@23459 = ~Осмотреть семя.~
@23460 = ~Ты крутишь чёрное семячко в руках… и чувствуешь лёгкий укус, на подушечке большого пальца появляется капелька крови — семя всё покрыто маленькими шипами, словно зубами. Меббет фыркает: «Поосторожнее с ним… покажи его одному из торговцев фруктами на рынке — они должны знать нужную тебе траву».~
@23461 = ~«Хорошо. Но перед уходом я бы хотел задать пару вопросов…»~
@23462 = ~«Хорошо. Я вернусь, когда у меня будет трава».~
@23463 = ~«Да? Ты достал травы, о которых я просила?»~
@23464 = ~«Пока нет, Меббет. Он сказал, что не может помочь… мне нужно найти садовника».~
@23465 = ~«Пока нет, Меббет. Он сказал, что не может помочь… мне нужно найти садовника».~
@23466 = ~«Нет, но я хотел кое-что спросить…»~
@23467 = ~«Я всё ещё работаю над этим. Прощай».~
@23468 = ~Меббет вздыхает: «Нет, ничегошеньки нельзя доверить». Она ворчит: «Что ж, неважно, дитя, неважно. Попробую уговорить прорасти одно из моих старых семян, хотя это займёт время. Думаю, у меня ещё осталось одно или два…»~
@23469 = ~«Вот и хорошо…»~
@23470 = ~Это гниющий женский труп трясёт головой и тоскливо стонет. Однако при твоём приближении она поворачивается и протягивает к тебе руки, как будто моля о помощи.~
@23471 = ~Меббет попросила меня забрать постиранное бельё у торговца одеждой по имени Гискорл на рынке. И почему она не сказала об этом сразу, когда я ходил туда за травами?~
@23472 = ~Меббет ворчит: «Вечные отсрочки… в старые добрые времена люди предпочитали иметь ингредиенты, а не оправдания…»~
@23473 = ~«Так что мне делать?»~
@23474 = ~«Может, и так. В любом случае у меня кое-какие вопросы…»~
@23475 = ~«Ладно, я продолжу поиски. Прощай».~
@23476 = ~Меббет вздыхает: «Найти садовника, полагаю». Она покусывает губу.~
@23477 = ~«Где?»~
@23478 = ~«Хорошо. Слушай, у меня вопросы…»~
@23479 = ~«Ладно, попробую найти. Прощай».~
@23480 = ~Меббет хмурится. «Я уже много циклов не вылазила из своей хижины, дитя. Понятия не имею, где может быть садовник… но если хочешь постичь Искусство, тебе нужно научиться упорству, так что *ищи*. Наверняка хоть один где-нибудь в Улье найдётся».~
@23481 = ~«Хорошо… но пока я не ушёл, у меня кое-какие вопросы».~
@23482 = ~«Хорошо, поищу…»~
@23483 = ~«Может, Плачущий-по-Деревьям поможет мне… Прощай».~
@23484 = ~«Вот как? — Меббет оглядывает шипы вокруг твоего запястья. — Если так, значит *подумай*, что она убрана».~
@23485 = ~Так и поступить.~
@23486 = ~Скрипя и потрескивая, чёрные шипастые ветви распутываются с твоего запястья и собираются в клубок веток и шипов, выглядит как гнездо мёртвых чёрных змей. Меббет фыркает: «Ну-ка придумай рамку или что-то вроде того, с лучшей формой и меньшим количеством углов».~
@23487 = ~Меббет попросила меня забрать постиранное бельё у торговца одеждой по имени Гискорл на рынке. И почему она не сказала об этом сразу, когда я ходил туда за травами?~
@23488 = ~Попытаться представить шар из шипов в виде картинной рамки.~
@23489 = ~Представить шар из шипов в виде картинной рамки.~
@23490 = ~Сосредоточиться на колючем шаре и представить его в виде картинной рамки.~
@23491 = ~Зомби тихо воет в ответ: «Гнху-у-у-у… фн-ну-у-ух-х?» С каждым выдохом вонь гниющего мяса наполняет воздух.~
@23492 = ~«Сту-у-ух-х… м-м-ма-а-а-у-у-ухр-р?» Ты не можешь понять, о чём она, но похоже, она что-то тебя спрашивает.~
@23493 = ~Зомби тихо воет в ответ. Только твоё умение разговаривать с мёртвыми позволяет её понять: «И-и-имя-а-а-а? Зна-а-аешь м-моё-о-о и-и-им-м-мя-а?»~
@23494 = ~«З-за-абы-ы-ыла-а и-и-им-мя-а… м-моё-о-о и-и-им-мя-а!» Её мутные глаза наполняются чёрной, слизистой жидкостью — только так может плакать труп.~
@23495 = ~Труп медленно кивает. «М-моя-а-а м-мо-о-оги-и-ил-ла-а… — она указывает на юг. — Ката-ако-о-омбы-ы-ы с-с во-одо-о-ой…»~
@23496 = ~«С-сунду-у-ук… ко-ол-лю-у-учи-ий с-су-унду-у-ук приви-и-инче-ен-н к по-олу… ря-а-адо-ом с-с мое-ей моги-и-и-илой…»~
@23497 = ~Она показывает тебе свои гниющие руки. Как раз в этот момент один ноготь отваливается и с тихим стуком падает на плиты пола. «Гн-ни-ию-у-у-у… с-ско-о-о-оро ничего-о-о не-е оста-а-ан-нетс-ся-а-а… ничего-о-о, то-олько ко-о-ости и и-и-имя-а…»~
@23498 = ~Она стоит и молча на тебя смотрит.~
@23499 = ~Она качает головой, пятясь, словно испугана: «Но… н-не-е-ет…»~
@23500 = ~Она прерывается, положив руки на щёки. Кусает себя за нижнюю губу.~
@23501 = ~«Но… кто-о-о? Како-о-ое и-и-имя-а?» — она кажется ошарашенной, сбитой с толку.~
@23502 = ~Она спокойно стоит некоторое время, уставившись в пол. Внезапно она поднимает голову: «Ты-ы-ы… и-и-имя-а? Н-на-азовё-о-ошь м-меня-а-а-а?»~
@23503 = ~Представить шар из шипов в виде картинной рамки.~
@23504 = ~Ты придумываешь ей имя, но как только собираешься произнести, зомби тебя прерывает и придвигается ближе, складывая ладони у уха рупором. Ты шепчешь ей имя… труп кивает, затем улыбается: «Да-а-а… с-спа-аси-и-ибо-о…»~
@23505 = ~Сосредоточиться на колючем шаре и представить его в виде картинной рамки.~
@23506 = ~«Ка-а-ак тогда-а ты-ы-ы чу-увствуеш-шь себя-а-а це-ел-лым?»~
@23507 = ~Зомби просто тихо качает головой.~
@23508 = ~Следует длинная пауза. «А-а-а-а? — пожимает плечами зомби, одно плечо поднимается несколько выше другого. — Спрос-си-и-и Мэ-э-эри, Ту-у-ух-хлую Мэ-э-эри».~
@23509 = ~«О-он-на-а-а ве-едё-о-от на-а-ас. С-сле-еди-и-ит з-за-а н-на-а-ами».~
@23510 = ~Когда зомби тебя видит, в мёртвых глазах мелькает искра узнавания: «А-а-а-а-а». Она протягивает к тебе гниющие руки, будто бы моля о помощи.~
@23511 = ~Когда зомби тебя видит, в мёртвых глазах мелькает искра узнавания: «М-моё-о-о и-и-имя-а… ты-ы-ы н-наш-шё-о-ол м-моё-о и-и-имя-а?»~
@23512 = ~Труп радостно бросается к тебе, когда замечает: «И-и-им-мя-а! Я вы-ы-ыбр-рала-а и-и-имя-а…»~
@23513 = ~«Ле-е-ейша-а-а…»~
@23514 = ~Труп шаркает к тебе, улыбаясь: «С-спа-аси-и-ибо-о… по-омо-о-ог м-мне-е-е с-с м-мои-и-им и-имене-ем…»~
@23515 = ~«Н… н… не-е-е-ет… — зомби сжимает свою трясущуюся голову в руках. — Н-не-е мо-о-оже-ет бы-ы-ыть…»~
@23516 = ~Эта женщина-зомби уставилась в пустоту, её челюсть болтается.~
@23517 = ~Труп не издаёт ни звука… она тебя не узнаёт.~
@23518 = ~«Приветствую…»~
@23519 = ~«Приветствую…»~
@23520 = ~Оставить зомби в покое.~
@23521 = ~«У меня вопросы…»~
@23522 = ~«Мне пора идти. Прощай».~
@23523 = ~«Я тебя не понимаю. Прощай».~
@23524 = ~«Нет… это причина твоего горя?»~
@23525 = ~«Нет. А что, должен?»~
@23526 = ~«Нет. Но у меня вопросы…»~
@23527 = ~«Нет. Мне пора уходить. Прощай».~
@23528 = ~«Могу я помочь тебе вновь обрести имя?»~
@23529 = ~«Почему бы тебе просто не выбрать новое имя?»~
@23530 = ~«Почему для тебя это так важно?»~
@23531 = ~«Очень жаль. У меня остались вопросы…»~
@23532 = ~«Надеюсь, ты его найдёшь. Прощай».~
@23533 = ~«Но как я её узнаю?»~
@23534 = ~«Тогда пойду поищу. Прощай».~
@23535 = ~Ты на секунду концентрируешься и пытаешься представить себе картинную рамку… из шара слышится скрип и треск, и ты открываешь глаза: он превратился в странноватый куб с колючками наружу. Любой, кто рискнул бы его поднять, изрезал бы себе руку в клочья.~
@23536 = ~«Э-э…»~
@23537 = ~«Возможно, я разыщу его. Прощай».~
@23538 = ~Меббет фыркает: «Может, стоит попробовать ещё раз?»~
@23539 = ~«Почему бы тебе просто не выбрать новое имя?»~
@23540 = ~Перевести дыхание, сосредоточиться и попробовать ещё раз.~
@23541 = ~Ветвистый шар скрипит, его побеги связываются и скручиваются, пока не образуют грубую картинную рамку в две ладони шириной.~
@23542 = ~«Как тебе это?»~
@23543 = ~«Почему для тебя это так важно?»~
@23544 = ~Меббет некоторое время критически смотрит на рамку, затем кивает: «Вполне квадратно». Она поднимает её и внимательно разглядывает: «Сойдёт… сойдёт».~
@23545 = ~«Тогда пойду поищу. Прощай».~
@23546 = ~«Это всё, что ты хотела?»~
@23547 = ~«Возможно, я разыщу его. Прощай».~
@23548 = ~Ветвистый шар скрипит, его побеги связываются и скручиваются, пока не образуют грубую картинную рамку в две ладони шириной. Почти бессознательно ты представляешь себе колючки убранными назад, чтобы рамку было легко повесить на стену.~
@23549 = ~«Как тебе это?»~
@23550 = ~Ветвистый шар скрипит, его побеги связываются и скручиваются, пока не образуют грубую картинную рамку в две ладони шириной. Почти бессознательно ты представляешь себе колючки убранными назад, чтобы рамку было легко повесить на стену… и напоследок передвигаешь оставшиеся шипы внутрь, чтобы можно было браться за края.~
@23551 = ~«Как тебе это?»~
@23552 = ~Меббет секунду смотрит на рамку, затем хихикает: «Ха! Вполне квадратно, да-да! Хорошая работа, дитя, хорошая работа». Она поднимает рамку и внимательно разглядывает: «Прекрасно подойдёт».~
@23553 = ~«Это всё, что ты хотела?»~
@23554 = ~«Ага, ну, этого достаточно… — она фыркает. — Да, но я забыла тебе сказать кое-что, когда отправляла в прошлый раз. Так что тебе придётся сходить на рынок ещё раз… найди там торговца одеждой Гискорла. Он должен был постирать кое-какие мои тряпки, и уже очень давно».~
@23555 = ~«Возможно, я поищу его. Прощай».~
@23556 = ~«Ясно… слушай, у меня были кое-какие вопросы…»~
@23557 = ~«У меня самого нет имени. Уверен, что и ты обойдёшься».~
@23558 = ~«Могла бы об этом и *раньше* упомянуть… хорошо, я скоро вернусь».~
@23559 = ~«Пойду принесу. Прощай».~
@23560 = ~«Могу я помочь тебе найти его?»~
@23561 = ~Она берёт у тебя из рук стопку до зелени накрахмаленных тряпок и критически их осматривает. «По крайней мере, не рваные, — она вздыхает. — И не мятые».~
@23562 = ~«Что с этим торговцем одеждой Гискорлом? У него руки все в шрамах, и выглядит он… заторможенным».~
@23563 = ~Меббет всё ещё крутит одежду в руках, тыкая её пальцем: «Знаешь, дитя, бывает, что ты горишь Искусством, а бывает, что Искусство поджаривает тебя».~
@23564 = ~«Так с ним именно это и случилось?»~
@23565 = ~Меббет цокает языком: «Быть может. Есть такие, кому Искусство — как воздух. Они шляются вокруг в островерхих шляпах, воняя трубками… а ещё есть скрытные волшебники, затронутые планами бродяги, гадалки, полупрорицатели и бабки-повитухи, балующиеся с Искусством… у них это выходит тяжелее всего».~
@23566 = ~Зомби попросила меня найти её имя. Она сказала, что имя написано на её могильной плите, той, что рядом с «колючим сундуком», привинченным к полу. Плита же находится в катакомбах Затопленных Народов, это юго-западнее Мёртвых Народов, где я её встретил.~
@23567 = ~«И Гискорл один из них?»~
@23568 = ~Меббет кивает: «Да… так говорят. В некотором смысле он остался, каким был. Сохраняет старые привычки и ритуалы, да». Она кладёт затвердевшие тряпки, те с глухим *стуком* ударяются об пол. «Ладно, а теперь последнее, чего я от тебя хочу, дитя…»~
@23569 = ~«Надеюсь, в этот раз мне не придётся снова бежать на рынок, Меббет».~
@23570 = ~«Конечно. Что тебе нужно?»~
@23571 = ~«О? А что, если придётся, дитя?!» — Меббет выпрямляется и пристально на тебя смотрит. Даже в полный рост она едва достигает твоих плеч.~
@23572 = ~«Меббет, без конца бегать на рынок за всеми этими вещами — пустая трата времени. Особенно если учесть, что ты могла подумать обо всём сразу, а не посылать меня в одно и то же место *три* раза».~
@23573 = ~«Почему бы тебе просто не выбрать новое имя?»~
@23574 = ~«Я просто хочу сказать, что если ты не можешь удержать в голове всё, что нужно на рынке, едва ли ты сможешь научить меня многому о магии».~
@23575 = ~«Не бери в голову. Так чего ты хочешь?»~
@23576 = ~«Ясно. У меня были вопросы…»~
@23577 = ~Меббет надувается, её лицо краснеет, как свёкла: «О, неужто? Ты правда так думаешь? Если так, то ступай отсюда! Знаешь что? Я не собираюсь тратить своё время на просветление твоей ослиной башки!»~
@23578 = ~«Нет, я выполню поручение… просто скажи: что ещё мне придётся оттуда тащить?»~
@23579 = ~«Надеюсь, ты его найдёшь. Прощай».~
@23580 = ~«Ну ладно, ладно. Зря я так сказал. Так что тебе нужно?»~
@23581 = ~«Ну и ладно, я ухожу. Прощай».~
@23582 = ~«Тогда я продолжу поиски. Прощай».~
@23583 = ~«Только одно: мне нужно немного чернил, чтоб заносить рецепты в одну из моих поваренных книг. Ты принесёшь мне немного от одной из торговок — звать её Косса-Джай».~
@23584 = ~«Хорошо, Пойду поищу её. Но сначала у меня были вопросы…»~
@23585 = ~«Ладно… уже иду. До свидания».~
@23586 = ~«Ты поняла? Ты можешь выбрать новое имя».~
@23587 = ~Меббет дала мне *ещё* одно идиотское поручение… опять идти на рынок, теперь уже за чернилами. Она сказала поговорить на рыночной площади с женщиной по имени Косса-Джай. Наверное, та последняя из торговцев, с кем я *ещё* не разговаривал.~
@23588 = ~«Неужели не видишь, как ты изменилась? Разве твоё старое имя всё ещё подходит?»~
@23589 = ~«И что, не можешь попросить чашку, или ковшик, или кружку у какого-нибудь другого торговца?»~
@23590 = ~«Могу. Я попрошу, только позволь сначала задать тебе пару вопросов…»~
@23591 = ~«Да, видишь? Отбрось же своё старое имя, давай. Стань кем-нибудь другим».~
@23592 = ~«Наверное, смогу… о, ну, я пошёл. Прощай».~
@23593 = ~«Какое угодно. Любое».~
@23594 = ~«Выбери сама. Прощай».~
@23595 = ~Меббет берёт из твоих рук кружку и нюхает её. «Превосходные чернила, свеженькие, да… — она кивает тебе. — Прекрасно, дитя. Всё, о чём я просила. Теперь я снова спрошу тебя: после всего, что ты видел, хочешь ли ты по-прежнему учиться магии?»~
@23596 = ~«Всего, что я видел? О чём ты?»~
@23597 = ~«Да, хочу».~
@23598 = ~«Да. То есть все твои поручения были испытанием меня на стойкость, так ведь?»~
@23599 = ~Придумать ей имя.~
@23600 = ~«Да. То есть все твои поручения были испытанием меня на стойкость, так ведь?»~
@23601 = ~«Нет, думаю, Искусство не по мне. Прощай, Меббет».~
@23602 = ~«Я думаю, было бы лучше, если бы ты выбрала сама. Прощай».~
@23603 = ~«Не за что. У меня остались вопросы…»~
@23604 = ~Меббет улыбается, затем кивает: «Да… быть может, дитя, быть может».~
@23605 = ~«И это ещё не всё: ты знала, кого я должен был встретить, выполняя каждое поручение, так?»~
@23606 = ~«Не за что. Прощай».~
@23607 = ~«Хорошо. Я всё ещё хочу учиться Искусству».~
@23608 = ~Правда: «Может, ты и права, но я думаю, что потерял больше, чем имя».~
@23609 = ~Меббет опять кивает, на этот раз медленнее: «Быть может, дитя, быть может… если и так, что твои чувства сказали тебе о них?»~
@23610 = ~Ложь: «С именем или без, но я чувствую себя цельным».~
@23611 = ~«Плачущий-по-Деревьям показал, что мои мысли влияют на мир вокруг меня. Гискорл научил, что ритуал — пустая трата сил, если его предназначение не осознаётся. Мейр'ам помогла усвоить мысль, что неважно, как много ты, по твоему мнению, знаешь — всегда можно чему-то научиться у других».~
@23612 = ~Секунду Меббет хранит молчание, потом медленно подходит к тебе и касается щеки. «Ох, дитя… — она вздыхает. — Однажды ты многого добьёшься в колдовстве, да-да. Ты понимаешь в нём, но… пришёл за помощью к старой Меббет, да. Чему повитуха может обучить такого, как ты?»~
@23613 = ~«Многому, Меббет. Я хочу узнать всё, чему ты можешь научить».~
@23614 = ~«Из того, что ты видел… ты чему-нибудь научился?»~
@23615 = ~«Я научился, что должен примириться с кучей беготни, если хочу чего-то от тебя получить».~
@23616 = ~«Ну, кое-чему. Впрочем, ничего такого, что действительно достойно упоминания… кроме того, что я хочу изучать Искусство».~
@23617 = ~«Могу я помочь тебе найти имя?»~
@23618 = ~«Почему бы тебе просто не выбрать новое имя?»~
@23619 = ~Меббет смеётся: «Вот так и с Искусством, дитя, так и с Искусством. Много беготни ради него, и зачастую она кажется совершенно бессмысленной. Зная это, ты по-прежнему хочешь учиться?»~
@23620 = ~«У меня другие вопросы…»~
@23621 = ~«Да».~
@23622 = ~«Надеюсь, ты его найдёшь. Прощай».~
@23623 = ~Похоже, Меббет всецело поглощена обработкой рамки из чёрных ветвей, которую ты ей сделал… она выравнивает края и подрезает некоторые колючки на веточках. Внезапно она замечает тебя и откладывает рамку в сторону: «Да, дитя?»~
@23624 = ~«Я принёс твои постиранные вещи… хотя сдаётся мне, Гискорл немного перестарался со своим очистительным ритуалом».~
@23625 = ~«Я продолжу поиски. Прощай».~
@23626 = ~«У меня к тебе вопросы…»~
@23627 = ~«Мне бы подлечиться…»~
@23628 = ~«Можно у тебя купить немного снадобий?»~
@23629 = ~«Можно мне здесь отдохнуть?»~
@23630 = ~«Сегодня вопросов нет. Прощай».~
@23631 = ~«Расскажи мне о… Тухлой Мэри».~
@23632 = ~Меббет ковыряется в груде зеленовато-лимонного накрахмаленного тряпья, которое ты забрал у Гискорла… кажется, она нарочно треплет края, чтобы как-то разделить тряпки. Заслышав твои шаги, она оборачивается: «Да, дитя?»~
@23633 = ~«Я нашёл Косса-Джай. Чернил у неё не оказалось, но у другой торговки есть рыба, которая содержит в себе чернила. Проблема в том, что мне не во что их налить».~
@23634 = ~«Наверно, так и сделаю. Прощай».~
@23635 = ~«Вот чернила, которые ты просила».~
@23636 = ~«У меня к тебе вопросы…»~
@23637 = ~«Это всё, что я хотел узнать. Прощай».~
@23638 = ~«Мне бы подлечиться…»~
@23639 = ~«Что ты продаёшь, Меббет?»~
@23640 = ~«Приветствую…»~
@23641 = ~«Можно у тебя купить немного снадобий?»~
@23642 = ~«Можно мне здесь отдохнуть?»~
@23643 = ~«Просто заскочил проверить, как ты».~
@23644 = ~«Итак, ты выбрал путь… — Меббет прерывается. — Ну, сначала о главном: просто иметь способности к Искусству недостаточно. Тебе потребуется способ дать им цель, обычно это „заклинания“. Заклинания обычно находятся в книге. Так что Искусство потребует от тебя жертвы в виде книги или чего-то вроде того, чтоб записывать заклинания. Читать-то умеешь?»~
@23645 = ~«Приветствую…»~
@23646 = ~Оставить зомби в покое.~
@23647 = ~«Не знаю».~
@23648 = ~«Да».~
@23649 = ~«Тогда давай проверим, прочитай-ка мне это», — Меббет протягивает тебе маленькую потрёпанную карточку… она похожа на рецепт.~
@23650 = ~Правда: «Я нашёл могилу, но имя… стёрлось. Не прочитать».~
@23651 = ~Изучить рецепт.~
@23652 = ~Изучить рецепт.~
@23653 = ~Ложь: «Да, тебя зовут… э-э…»~
@23654 = ~Написанное в рецепте плывёт у тебя перед глазами, каждый символ ускользает от взгляда, когда ты пытаешься разобрать его. Почти инстинктивно ты расслабляешь глаза, позволяя им охватить всю страницу… и символы внезапно складываются в слова: в рецепте содержатся ингредиенты, их количество… похоже, это малое предсказание.~
@23655 = ~«Нет… но почему бы тебе просто не выбрать новое имя?»~
@23656 = ~«Ещё нет. Почему для тебя это так важно?»~
@23657 = ~«Ещё нет, но у меня вопросы…»~
@23658 = ~«Нет, но я продолжу поиски».~
@23659 = ~Я сказал безымянной зомби, что имя на её могиле невозможно прочитать… она обезумела от горя.~
@23660 = ~Я солгал безымянной зомби, что прочитал имя на её могиле, и дал ей то, что придумал сам. Она была довольна.~
@23661 = ~«Вот как? И какое ты выбрала?»~
@23662 = ~«Замечательно, я рад за тебя. У меня были вопросы…»~
@23663 = ~«Это хорошо. Я должен идти… прощай».~
@23664 = ~Безымянная зомби в конце концов приняла мой совет и выбрала себе имя «Лейша».~
@23665 = ~«Интересно… по-моему, подходит. У меня были вопросы…»~
@23666 = ~«Это хорошо. Прощай, Лейша».~
@23667 = ~«Не за что. У меня вопросы…»~
@23668 = ~«Не за что. Прощай».~
@23669 = ~«Почему бы тебе просто не выбрать новое имя?»~
@23670 = ~«Мои извинения… прощай».~
@23671 = ~«У меня вопросы…»~
@23672 = ~Оставить её в покое.~
@23673 = ~Оставить её в покое.~
@23674 = ~«Это малое предсказание, верно? Выглядит как заклинание, позволяющее видеть „природу“ предмета… понять, заколдован он или нет».~
@23675 = ~Как ни странно, написанное в рецепте плывёт у тебя перед глазами, каждый символ ускользает от взгляда, когда ты пытаешься разобрать его.~
@23676 = ~Изучить символы и попытаться их расшифровать.~
@23677 = ~«Я сдаюсь, Меббет… что здесь написано?»~
@23678 = ~Ты сосредоточенно изучаешь символы. Однако как бы ты ни концентрировался, написанное в рецепте ускользает от твоего внимания, скручивается и извивается, как клубок змей. Твои глаза болят от попыток проследить за движениями символов.~
@23679 = ~Продолжить изучать символы, пытаясь разгадать их значение.~
@23680 = ~«Я сдаюсь, Меббет… что здесь написано?»~
@23681 = ~Ты продолжаешь изучать символы ещё несколько минут, Меббет молча наблюдает за тобой.~
@23682 = ~Продолжить изучать символы, пытаясь разгадать их значение.~
@23683 = ~«Я сдаюсь, Меббет… что здесь написано?»~
@23684 = ~Уже готовый сдаться и прекратить попытки, ты расслабляешь глаза и смотришь на страницу целиком… и тут же символы складываются в слова: рецепт перечисляет ингредиенты и их количество — это какое-то из малых предсказаний.~
@23685 = ~«Это ведь малое предсказание, правда? Похоже, из тех, что позволяют видеть „природу“ предмета… понять, заколдован он или нет».~
@23686 = ~Меббет выпучивает глаза. «Кто ты, чтоб так разыгрывать старую Меббет?! Ты что, изверг?»~
@23687 = ~«В чём дело-то?»~
@23688 = ~«Нет… ну, насколько я знаю. А что не так?»~
@23689 = ~«Некоторые меня так называют, но обычно за глаза. Я сказал что-то не то?»~
@23690 = ~Меббет дала мне испытание… небольшой рецепт, малое волшебство, записанное на языке Искусства. Я смог разобрать его без обучения. Когда-то в прошлом, наверное, я был обучен чтению магии.~
@23691 = ~«Ну… не ожидала я, да…» — она кивает на рецепт, потом выхватывает его из твоей руки. «Видишь ли, он написан на языке *Искусства*. Если ты ещё не колдуешь, смыслу для тебя там будет не больше, чем в перекрученном словесном фарше, — она щёлкает пальцами. — Но ясно как день, смысл ты уловил верно. Может, объяснишь старой Меббет, как так вышло?»~
@23692 = ~«Да я и сам не понимаю… просто *знал*, что там написано».~
@23693 = ~«Полагаю, когда-то я знал, но забыл… а эти символы просто воскресили мою память».~
@23694 = ~«Или у тебя природный дар, а может… неважно, неважно, ты просто сберёг себе кучу времени обучения, да-да, — Меббет прочищает горло. — А я-то искала кого-нибудь, кто помог бы разобраться с хозяйственными делами, да…»~
@23695 = ~«Может, и к лучшему…»~
@23696 = ~«Если тебе нужна помощь в чём-либо — только попроси… это самое меньшее, чем я могу отплатить за своё обучение».~
@23697 = ~«Тьфу! Чтоб ты подумал, что я тебя использую… — она хмурится. — Ну, ты вполне хорошо читаешь заклинания, но это не принесёт тебе особой пользы без книги, куда их можно записать…»~
@23698 = ~«А у тебя есть такая?»~
@23699 = ~«А у тебя есть такая?»~
@23700 = ~«Нет-нет, не беспокойся об этом… — она хмурится. — Ну, ты вполне хорошо читаешь заклинания, но это не принесёт тебе особой пользы без книги, куда их можно записать…»~
@23701 = ~«А у тебя есть такая?»~
@23702 = ~«А у тебя есть такая?»~
@23703 = ~Меббет оглядывает свою хижину и замечает сделанную тобой рамку из чёрных колючек. Она осторожно поднимает её и разглядывает: «Это подойдёт».~
@23704 = ~«Это? Это же просто рамка».~
@23705 = ~Меббет оглядывает свою хижину и замечает сделанную тобой рамку из чёрных колючек, висящую на стене. Она осторожно снимает её и разглядывает: «Это подойдёт».~
@23706 = ~«Это? Это же просто рамка».~
@23707 = ~«Ах, но ведь и ты тоже, дитя… — не выпуская из рук рамки, она поднимает одну из накрахмаленных тряпок, принесённых тобой от Гискорла, с усилием отрывает кусок зеленоватой накрахмаленной плёнки, которая колышется в воздухе, словно тончайшая ткань. — Что бы там Гискорл ни использовал при стирке, оно работает с обычной тканью лучше, чем дубение, растягивание и обработка камнями. Не могу позволить себе пергамент, не могу…»~
@23708 = ~«Пергамент?..»~
@23709 = ~Она берёт накрахмаленную пленку и натягивает её на рамку из чёрных колючек, цепляя края ткани за шипы вокруг рамы, пока не получается что-то вроде небольшого зеленовато-чёрного полотна художника. «Чего-то не хватает…»~
@23710 = ~«Ну, тут нужно что-нибудь нарисовать».~
@23711 = ~Она кивает: «Да, или написать…» Меббет берёт полученную от тебя кружку чернил и ставит её рядом с собой. Она окунает ноготь в кружку, потом извлекает, бормоча что-то себе под нос, и начинает царапать на рамке символы, один за другим, продолжая своё бормотание.~
@23712 = ~Ждать…~
@23713 = ~«Всё готово», — Меббет встаёт и вытирает испачканный в чернилах ноготь об одежду. Она наклоняет голову, разглядывая лежащую перед ней странную обрамлённую страницу. «Страница для твоей книги заклинаний, вот», — Меббет жестом показывает, что ты должен её взять.~
@23714 = ~Взять её…~
@23715 = ~«В твоей книге заклинаний есть рецепты… или „заклинания“, если хочешь так называть. Однако пока они там, они всего лишь слова, — она стучит себя по голове. — Искусство требует от тебя вытащить заклинания из книги и засунуть в свой чердак… то бишь в голову, чтоб высвободить их силу».~
@23716 = ~«Продолжай…»~
@23717 = ~«Меббет, думаю, основы я понял. Прощай».~
@23718 = ~«Ты заполняешь ими чердак, когда изучаешь, *запоминаешь* их. Но обычно для этого тебе надо отдохнуть. Есть вопросы?»~
@23719 = ~«Нет, Меббет».~
@23720 = ~«Да… объясни ещё раз».~
@23721 = ~«Меббет, думаю, основы я понял. Прощай».~
@23722 = ~«О, нет вопросов, а? Брось, они у тебя *должны* быть! Неужто уже всё знаешь о запоминании заклинаний, а? Да ты смекалистый! Конечно, больше тебе не нужно всей этой болтовни Меббет — только время своё драгоценное переводить… ты уже великий колдун!»~
@23723 = ~«Прости меня, Меббет. Я имел в виду, нет вопросов к уже сказанному. Пожалуйста, объясни, как запоминать заклинания».~
@23724 = ~«Твоё отношение выводит меня из себя, Меббет…»~
@23725 = ~«Меббет, думаю, основы я понял. Прощай».~
@23726 = ~«Хм-мф. Ну ладно. Вот тебе наука, как запоминать заклинания: *до* того, как уснёшь, выбери из книги нужные тебе заклинания. А когда проснёшься с утра, они будут мухами жужжать в твоей голове, готовые вырваться наружу».~
@23727 = ~«Сколько заклинаний я смогу использовать?»~
@23728 = ~«Меббет, думаю, основы я понял. Прощай».~
@23729 = ~«Я буду относиться, как захочу, дитя, да-да, а ты будешь разинув рот слушать, если хочешь познать тайны Искусства!»~
@23730 = ~«Прости меня, Меббет. Пожалуйста, объясни, как запоминать заклинания».~
@23731 = ~«Если ты *закончила* лекцию, то продолжай».~
@23732 = ~«Ты сможешь использовать только одно, ну или два заклинания, пока снова не отдохнёшь… ты ещё не созрел, и места на чердаке у тебя немного. Так что используй их с умом, пока не наберёшься опыта в Искусстве. Когда твоя сила вырастет, места на чердаке у тебя будет больше».~
@23733 = ~«Хорошо… продолжай…»~
@23734 = ~«Меббет, думаю, основы я понял. Прощай».~
@23735 = ~«Читать ты можешь только те заклинания, которые запомнил. Если хочешь колдануть дважды, запомнить заклинание надо… сколько раз?»~
@23736 = ~«Один раз».~
@23737 = ~«Два раза».~
@23738 = ~«Э-э…»~
@23739 = ~«Меббет, думаю, основы я понял. Прощай».~
@23740 = ~«Два раза! Чтоб прочитать заклинание *дважды*, и запомнить его придётся *дважды*».~
@23741 = ~«Понял. Как я могу получить больше заклинаний?»~
@23742 = ~«Меббет, думаю, основы я понял. Прощай».~
@23743 = ~Меббет кивает: «Да, два раза, правильно».~
@23744 = ~«Как я могу получить больше заклинаний?»~
@23745 = ~«Меббет, думаю, основы я понял. Прощай».~
@23746 = ~Меббет обучила меня основам Искусства. Она говорит, что перед отдыхом я должен выбрать заклинания для запоминания из своей книги заклинаний. Если мне нужно использовать одно и то же заклинание несколько раз, то и запоминать его придётся несколько раз. Всякий раз после отдыха я буду просыпаться на следующее утро с заклинаниями в памяти, готовыми к произнесению. Она сказала, что сначала я смогу запоминать совсем мало заклинаний, пока не стану более опытным в Исскусстве. Я могу разыскать других учителей в Сигиле и поучиться заклинаниям у них тоже.~
@23747 = ~Меббет пожимает плечами: «Раскрой глаза и уши — даже простой народ может научить мелкой магии. Бывают ещё свитки, рецепты, книги и даже более странные вещи с записанными заклинаниями. Наткнёшься на такое — просто внимательно изучи и скопируй заклинание в свою книгу, если оно тебе надо».~
@23748 = ~«Уяснил».~
@23749 = ~«Меббет, думаю, основы я понял. Прощай».~
@23750 = ~«Я могу показать тебе и ещё кой-чего из заклинаний, когда вернёшься, поднабравшись опыта на планах».~
@23751 = ~«Я был бы очень признателен. Спасибо».~
@23752 = ~«Меббет, думаю, основы я понял. Прощай».~
@23753 = ~«Пока ты не ушёл, дитя, вот тебе кой-какая магия, чтоб разжечь аппетит… — Меббет роется в своём платье, затем извлекает три маленьких рецепта и передаёт тебе. — Ты должен скопировать их в свою книгу, чтоб они попали на твой чердак как можно скорее…»~
@23754 = ~«Спасибо, Меббет».~
@23755 = ~«Ну ладно, дитя, хватит здесь околачиваться. Такой как ты всегда найдёт себе занятие поважнее, чем сидеть тут и слушать бредни старой Меббет».~
@23756 = ~«Перестань, Меббет, вовсе ты не старая».~
@23757 = ~«Ты не такая уж и старая».~
@23758 = ~«Да, и правда. Я уже провёл тут слишком много времени».~
@23759 = ~Меббет дала мне три «рецепта», которые, как она сказала, я должен перенести в свою книгу. Она сказала, что я должен осмотреть их в своих вещах, а затем «скопировать» в книгу заклинаний.~
@23760 = ~«Тьфу, подхалим! Да баатезу, услышав тебя, повесится от зависти! Прочь отсюда!»~
@23761 = ~«Спасибо за всё, Меббет».~
@23762 = ~«Прощай, Меббет».~
@23763 = ~«У тебя все задатки, чтоб стать одним из этих чопорных зазнаек-чародеев, — Меббет фыркает. — И всё же… я желаю тебе удачи, дитя. Я желаю тебе удачи».~
@23764 = ~«Прощай».~
@23765 = ~«Тьфу! Ещё поблагодари меня за то, что не свернула тебе учёбой мозги набекрень! Адова прорва кретинов сгинула, вытворяя с Искусством то, чего с ним вытворять не положено. Всё, проваливай!»~
@23766 = ~«Прощай».~
@23767 = ~Когда ты входишь, Меббет поднимает взгляд, её лицо мертвенно-бледно… она выглядит больной. Ты видишь, что морщины превратили каждую складку её лица в трещину, а её серые глаза моргают, как будто им трудно на тебе сфокусироваться.~
@23768 = ~«Я так и думал, что ты ещё можешь быть тут, Меббет».~
@23769 = ~«Разве ты ещё не умерла, „Меббет“?»~
@23770 = ~«Меббет… ты *знаешь*, что ты была Рейвел?»~
@23771 = ~«Да…» — она слабо улыбается, а её голос скрипит, будто продираясь через слои пыли. Когда она говорит, слова звучат как эхо: «Так и есть… но ненадолго…»~
@23772 = ~«Меббет… ты *знаешь*, что ты была Рейвел?»~
@23773 = ~«Не-а… — она слабо улыбается. — Жива… но ненадолго…»~
@23774 = ~«Меббет… ты *знаешь*, что ты была Рейвел?»~
@23775 = ~Она глубоко вздыхает… слова выходят медленно, голос клокочет в горле: «Быть может… Меббет забывала себя много раз… мне снилось, что я была кем-то другим…» Каждое слово даётся ей тяжелее предыдущего, как будто века давят на них своим весом. Её тело слегка покачивается, словно хочет *расслабиться* и освободиться.~
@23776 = ~«Как ты можешь не знать, кто ты такая?»~
@23777 = ~«А как *ты* можешь не знать себя? — Меббет облизывает губы. — Многие вещи… даже частички себя… проваливаются в трещины памяти, тени забытых вещей, эти обрывки памяти, бывают плохие… бывают хорошие».~
@23778 = ~«Но зачем, Меббет? Зачем маскировка, если ты могла бы снова быть Рейвел?»~
@23779 = ~«Здесь, в этой хижине, я занималась починкой вещей и людей: вправляла кости, принимала роды… всё такое. И была этим довольна», — она вздыхает. «Что касается той *другой*, этой Рейвел… — она снова облизывает губы. — Думаю… ты со мной согласишься, что некоторые вещи спокойнее просто не помнить».~
@23780 = ~«Я не был уверен, что ты будешь здесь после случившегося…»~
@23781 = ~Меббет кивает, движения у неё вымученные. «Да, яхонтовый мой… — она морщится, вдыхая воздух. — Встретить тебя здесь… это как эхо. Мало времени осталось… эти нитки, эти Узелки… они развязываются, пока мы говорим».~
@23782 = ~«Тебе больно?»~
@23783 = ~Она кивает. «Да… но ирония в том, что ранит больнее всего… — она слабо улыбается. — Добрый поступок, трижды оплаченный… так распорядились планы, что он будет стоить мне жизни». Она тихо смеётся: «Но я не жалею…»~
@23784 = ~«У меня вопросы, Меббет. Я должен знать, кто это с тобой *сделал*. Можешь ска…»~
@23785 = ~Она поднимает руку, призывая к тишине: «Яхонтовый мой… я прошу тебя послушать меня, в последний раз…»~
@23786 = ~«Меббет, у нас мало *времени*…»~
@23787 = ~Да~
@23788 = ~«Хорошо…»~
@23789 = ~Нет~
@23790 = ~У этого упыря на лице огромный шрам, один его глаз полностью вытек. Несмотря на очевидную свежесть раны, похоже, она не причиняет жутко вонючему созданию никакого беспокойства. Ты замечаешь грязный нож, заткнутый за его пояс… на ручке вырезаны буквы «УХИР».~
@23791 = ~«Приветствую…»~
@23792 = ~«Бриллиантовый мой…» — она вздыхает. «Всё, чего я хотела, — освободить Госпожу из её Клетки… а всё, чего я хотела для тебя — *жизни*… а что до моей дочери, я… — она снова вздыхает. — На планах говорят… что добро ведьмы хуже… её злобы и отравляет всё, к чему прикасается…»~
@23793 = ~«Думаю, мы видели тому подтверждение».~
@23794 = ~«Я сожалею, что всё так обернулось. Если бы я только мог тебя спасти, я…»~
@23795 = ~«Думаю, мы видели тому подтверждение».~
@23796 = ~«Я сожалею, что всё так обернулось. Если бы я только мог тебя спасти, я…»~
@23797 = ~Она еле заметно улыбается: «Я не жалею о том, что случилось, яхонтовый мой…» Её улыбка угасает: «И тебе не стоит». Её глаза подёргиваются, взгляд теряет направление. «И… я… не могу здесь… больше оставаться».~
@23798 = ~«Скатертью дорожка, Рейвел. Пусть место потемнее станет твоим новым домом».~
@23799 = ~«Прощай, Рейвел».~
@23800 = ~«Я умираю…» — она моргает слезящимися глазами. «Мой конец… приходит со всех направлений времени, все нитки Рейвел развязаны…» — она кашляет. «Но… — её серые глаза задерживаются на тебе. — Быть может, не всё потеряно… одно из моих чёрных семян из лабиринта… ты ведь принёс его с собой?»~
@23801 = ~«Принёс. Держи».~
@23802 = ~«У меня оно есть, но я тебе не дам».~
@23803 = ~«Ах… — она осторожно берёт семячко и вставляет в свои седеющие волосы. — Так сослужена служба Союзу Колец…» С блуждающим взглядом она поднимает руку и приглашает тебя подойти ближе.~
@23804 = ~Шагнуть ближе и преклонить колено.~
@23805 = ~«Нет… какую бы маску ты ни носила, ты Рейвел, и я тебе не верю. Меббет я оплакиваю. Тебя — нет».~
@23806 = ~Она кивает и, похоже, хочет что-то сказать, но просто улыбается и закрывает глаза.~
@23807 = ~«Прощай».~
@23808 = ~«Э-э… можно мне взять этот кинжал, что у тебя за поясом?»~
@23809 = ~Она шепчет что-то на грани дыхания, потом охватывает твою голову ладонями и почти неощутимо целует тебя в лоб. Ты закрываешь глаза, когда её губы касаются твоей кожи…~
@23810 = ~«Пусть планы будут добры к тебе, Меббет».~
@23811 = ~Оставить упыря в покое.~
@23812 = ~Упырь сужает глаза и рычит на тебя. Из его пасти выкатывается язык, по крайней мере в две ладони длиной…~
@23813 = ~«Э-э… можно мне взять этот кинжал, что у тебя за поясом?»~
@23814 = ~«Ты… Ухир?»~
@23815 = ~«У меня вопросы…»~
@23816 = ~«М-да, я пойду, пожалуй. Счастливо оставаться».~
@23817 = ~Упырь не спускает с тебя голодного взгляда. Он сжимает и разжимает когтистые кулаки, словно борется с желанием прыгнуть на тебя и сожрать.~
@23818 = ~«Э-э… можно мне взять этот кинжал, что у тебя за поясом?»~
@23819 = ~«Успокойся и отвечай на мои вопросы».~
@23820 = ~«Тогда прощай».~
@23821 = ~Упырь шипит на тебя: «Молчать, мясо! Не говорить! Я не с-слушать мясо-тварь! Я слышу только твоё сердце, кровь в твоих мясных жилах, сладкую, восхитительную кровь… вкусное, жирное мясо-сердце… — слюна капает из его пасти на пыльные камни пола. — МОЛЧАТЬ!»~
@23822 = ~«Э-э… можно мне взять этот кинжал, что у тебя за поясом?»~
@23823 = ~«Тогда прощай».~
@23824 = ~У этого упыря на лице огромный шрам, один его глаз полностью вытек. Ты замечаешь грязный нож, заткнутый за его пояс. Когда ты приближаешься, он шипит: «Прочь! Ходи прочь! Я *не говорить* с мясо-тварь, я *не слушать*, мясо! ХОДИ!»~
@23825 = ~«Э-э… можно мне взять этот кинжал, что у тебя за поясом?»~
@23826 = ~Уйти.~
@23827 = ~Упырь смотрит на нож, чешет голову, словно в раздумье, как он туда попал. Наконец он поворачивается к тебе с хитрой зубастой ухмылкой… «Мясо хотеть нож? Мясо торговать, да…»~
@23828 = ~«Как насчёт этих крысиных хвостов?»~
@23829 = ~«Как насчёт этих крысиных хвостов?»~
@23830 = ~«Я могу дать тебе медяк…»~
@23831 = ~«Но у меня нет денег».~
@23832 = ~«Отдай его, упырь… пока я не забрал сам».~
@23833 = ~«Тогда забудь. Прощай».~
@23834 = ~Упырь трясёт головой, потом показывает на свой рот: «Нет, нет… еда, мясо, да…» Его длинный серый язык вываливается наружу, истекая мерзкой слюной.~
@23835 = ~«Тогда я вернусь и принесу тебе что-нибудь поесть».~
@23836 = ~Я нашёл упыря, у которого нож Ухира. Он хочет еды в обмен на клинок… возможно, я найду что-нибудь здесь, например крысу, и накормлю его.~
@23837 = ~Упырь разглядывает их критически. «Вкусные, да, но малые. Больше, мясо… больше! Голодный!»~
@23838 = ~«Тогда я принесу ещё».~
@23839 = ~«Да, да!» — упырь жадно хватает их и пожирает. Облизав когтистые пальцы дочиста, он бросает тебе нож Ухира.~
@23840 = ~«Э-э… спасибо. Прощай».~
@23841 = ~«Хс-с-ст! Ты мясо, вкусное, красное, свежее мясо — не враг! Мясо хотеть нож? Мясо делать обмен!»~
@23842 = ~«Как насчёт этих крысиных хвостов?»~
@23843 = ~«Как насчёт этих крысиных хвостов?»~
@23844 = ~~
@23845 = ~«Я могу дать тебе медяк…»~
@23846 = ~«Но у меня нет денег».~
@23847 = ~«Тогда забудь. Прощай».~
@23848 = ~У этого упыря на лице огромный шрам, один его глаз полностью вытек. Несмотря на очевидную свежесть раны, похоже, она не причиняет жутко вонючему созданию никакого беспокойства.~
@23849 = ~«Приветствую…»~
@23850 = ~Оставить упыря в покое.~
@23851 = ~У этого упыря на лице огромный шрам, один его глаз полностью вытек. Когда ты приближаешься, он шипит: «Прочь! Ходи прочь! Я *не говорить* с мясо-тварь, я *не слушать*, мясо! ХОДИ!»~
@23852 = ~Уйти.~
@23853 = ~«Что он сказал, Грейс?»~
@23854 = ~«Ты знаешь, кто я?»~
@23855 = ~«Ясно. У меня есть другой вопрос…»~
@23856 = ~«Я услышал достаточно. Прощай».~
@23857 = ~«Тебе не кажется, что понять её трудновато?»~
@23858 = ~«Харгримм сказал, что мне нужно *научиться* слушать тебя… не знаешь, что он имел в виду?»~
@23859 = ~Эта скучающая крыса-оборотень, похоже, рада любому поводу разогнать тоску: «Чё ты хочешь, мясо?»~
@23860 = ~«Я хочу выйти».~
@23861 = ~«Просто поговорить с тобой».~
@23862 = ~«Ничего. Забудь».~
@23863 = ~«Да ну? И чё ты нам дашь такого, что мы забьём на Мантуока и рискнём разозлить других крыс, а?»~
@23864 = ~«Ваши жизни. Если выпустите меня, я позволю вам жить».~
@23865 = ~«Ваши жизни. Если выпустите меня, я позволю вам жить».~
@23866 = ~«Обещание, что об этом никто не узнает… а может быть, обещание кой-каких монет позднее».~
@23867 = ~«Да как они узнают?»~
@23868 = ~«Как насчёт медяков?»~
@23869 = ~«Подумай сам: я несомненно опасен для тебя, однако разговариваю с тобой как с равным. Думаешь, эти стены меня удержат, если я твёрдо решу выбраться? Без всяких угроз я советую: отпустить меня в твоих же интересах».~
@23870 = ~«Всё равно я отсюда когда-нибудь выберусь, и тогда здесь будет довольно грязно».~
@23871 = ~«Знаешь, нечего мне дать, если хорошо подумать».~
@23872 = ~Раймон внимательно оглядывает тебя с головы до ног. Заметив жестокость в твоих глазах и размер мускулов, он очень осторожно отпирает и распахивает для тебя дверь. Сам отходит в сторону и избегает встречаться с тобой глазами.~
@23873 = ~«Спасибо, приятель».~
@23874 = ~«Пока».~
@23875 = ~Он по-прежнему избегает смотреть в глаза: «Пожалуйста, не тронь меня, кореш… просто работа у меня такая».~
@23876 = ~«Ещё подумаю. Прощай».~
@23877 = ~Он окидывает тебя взлядом и усмехается: «Думаешь, сможешь достать меня? Поищи-ка другой выход сначала!»~
@23878 = ~«А если я пообещаю, что об этом никто не узнает… а может, и немного монет позднее?»~
@23879 = ~«Почему бы тебе просто не выпустить меня?»~
@23880 = ~«Что если я дам тебе немного монет?»~
@23881 = ~«Подумай сам: я несомненно опасен для тебя, однако разговариваю с тобой как с равным. Думаешь, эти стены меня удержат, если я твёрдо решу выбраться? Без всяких угроз я советую: отпустить меня в твоих же интересах».~
@23882 = ~«Всё равно я отсюда когда-нибудь выберусь, и тогда здесь будет довольно грязно».~
@23883 = ~«Я подумаю над выходом. Прощай».~
@23884 = ~«А чё, звучит неплохо. В любом случае насрать мне на Мантуока, — он отпирает дверь, распахивает её и шагает в сторону. — Теперь иди отсюда, пока я ещё могу сделать вид, что тебя не видел».~
@23885 = ~«Вот и молодец. Прощай».~
@23886 = ~«Вот чего… чё-то кошелёк у тебя очень приятно звякает. Сотня монет оттуда — наверняка можешь себе позволить — и ты свободен».~
@23887 = ~«Договорились».~
@23888 = ~«Забудь».~
@23889 = ~«Тогда бросай сюда через решётку, а я тебя выпущу. И пока не спросил, да, тебе придётся поверить мне на слово, а, Шаддеус?» — он ухмыляется своему напарнику.~
@23890 = ~«Хорошо. Держи».~
@23891 = ~«У меня столько нет…»~
@23892 = ~«Забудь».~
@23893 = ~Он тщательно пересчитывает монеты. Когда наконец убеждается, что вся сумма на месте, он открывает тебе дверь: «Теперь уматывай отсюда!»~
@23894 = ~«Хорошо, хорошо».~
@23895 = ~«Тогда ты не выйдешь отсюда, сечёшь?» — он хихикает, отстукивая зубами, и отворачивается.~
@23896 = ~«Проклятье…»~
@23897 = ~«Просто поговорить, а? Ну, со стариной Раймоном у тебя базара не будет, эт уж точно!» — он отворачивается от тебя.~
@23898 = ~«Тогда я хотел бы обсудить перспективы своего выхода отсюда».~
@23899 = ~«Не очень-то и хотелось».~
@23900 = ~Он усмехается. «Хочешь, чтоб я тебе поверил? — он дёргает усами. — Попробуй ещё разок».~
@23901 = ~«Если выпустишь меня немедленно, я позволю тебе жить».~
@23902 = ~«Если выпустишь меня немедленно, я позволю тебе жить».~
@23903 = ~«Как насчёт медяков?»~
@23904 = ~«Подумай сам: я несомненно опасен для тебя, однако разговариваю с тобой как с равным. Думаешь, эти стены меня удержат, если я твёрдо решу выбраться? Без всяких угроз я советую: отпустить меня в твоих же интересах».~
@23905 = ~«Всё равно я отсюда когда-нибудь выберусь, и тогда здесь будет довольно грязно».~
@23906 = ~«Забудь».~
@23907 = ~«Чё ты опять хочешь, пустоголовый?»~
@23908 = ~«Хочу поговорить с тобой».~
@23909 = ~«Хочу обсудить свои перспективы выхода».~
@23910 = ~«Ничего. Забудь».~
@23911 = ~«И чё ты до сих пор тут делаешь, пень? Вали отсюда!» — он наклоняет голову и избегает смотреть в глаза.~
@23912 = ~«Хорошо».~
@23913 = ~«Чё за… ШАДДЕУС! БЕЙ ЕГО!» — обе крысы-оборотня нападают на тебя.~
@23914 = ~Драться.~
@23915 = ~«Не говори со мной. Говори с Раймоном», — крыса-оборотень избегает твоего взгляда.~
@23916 = ~«Здоровый дядька, а? А ну-ка брысь, пока Раймон не расхрабрился и не позвал подмогу», — эта крыса-оборотень как-то странно беспечна.~
@23917 = ~Он пожимает плечами.~
@23918 = ~«Ой, во имя… думаю, ты щас умрёшь, пень…»~
@23919 = ~Лишив жизни своего товарища, крысу-оборотня, этот приятель смотрит прямо на Анну: «Анна, это Шаддеус. Я выпущу тебя. Не могу видеть тебя в клетке. Если вернёшься в деревню, помяни меня добрым словом и скажи, что зло идёт этим путём. Не могу сказать, какое, но… ты просто должна знать».~
@23920 = ~«Ага, щас, — он берёт ключи с тела Раймона, отпирает дверь и распахивает её для вас. — Уходите, щас же». Он быстро кивает и ускакивает прочь.~
@23921 = ~«Удивляешься, почему я это сделал, а? Я вообще-то человек из Похороненной деревни. Шаддеус меня звали. Я не хочу быть крысой-оборотнем и не считаю, что должен отвернуться от людей, раз у меня эта болезнь. Уходи. Щас же», — он отпирает дверь, распахивает её для тебя и ускакивает прочь.~
@23922 = ~ПОДУШКА СНОВ
Вес: 1

Эта маленькая, украшенная вышивкой подушка для гроба из заведения гробовщика.~
@23923 = ~КЛЕТКА СНОВ
Вес: 0

Это изящная клетка для птиц, украшенная лезвиями, которую ты получил от голема Коаксметала. Тебе нужно отнести её Нилу Зандеру для использования в Построителе Снов.~
@23924 = ~КЛЮЧ СНОВ
Вес: 0

Это простое чёрное пёрышко, которое используется для управления Построителем Снов в Великой Кузнице.~
@23925 = ~ФЛАКОН СНОВ
Вес: 0

Этот флакон содержит кусочки твоей кожи и немного крови для заправки Построителя Снов Нила Зандера.~
@23926 = ~МОЛИТВЕННЫЕ ЧЁТКИ
Вес: 1

Это ожерелье для молитвы из красных и чёрных бусин. Паутина чёрных линий, обвивающая края этих чёток, распускается странными узорами, которые ты не можешь разобрать.~
@23927 = ~УГОЛЬНЫЙ АМУЛЕТ
Особенности:
   Сопротивление огню: +50%
   Сопротивление магическому огню: +25%
Вес: 0

Этот кусочек угля — обгорелая кость какого-то существа, похожая на палец или коготь. Множество символов нацарапано на поверхности кости… символы едва заметны, разобрать их невозможно.

Этот угольный амулет временно защищает владельца от огня и сильного жара. Для использования его надо разломить пополам, обе половинки растолочь в порошок, который затем втереть в кожу над сердцем.~
@23928 = ~«Ох, Шад, знаешь, как мы все за тебя переживали, а? Как жалко, что ты здесь, — она смотрит на него с большим сочувствием, чем ты когда-либо замечал в её глазах. — Выпусти нас, а потом давай, вали отсюда. Поговаривают, старина Бампи собрался устраивать какую-то месть крысам».~
@23929 = ~«Ты имеешь на это право».~
@23930 = ~«Пожалуйста, Шад».~
@23931 = ~«Хорошо».~
@23932 = ~«Ладно».~
@23933 = ~«Ладно».~
@23934 = ~«Думаю, есть. Прощай».~
@23935 = ~«А если я припугну ТЕБЯ?»~
@23936 = ~«Тогда я ухожу».~
@23937 = ~Напасть на него.~
@23938 = ~«Тогда прощай».~
@23939 = ~«Думаю, ты можешь попытаться».~
@23940 = ~«Спасибо, Шаддеус. Прощай».~
@23941 = ~Крыса-оборотень шипит: «Челове-е-ек! С-с-сдох-хни!» Она бросается на тебя.~
@23942 = ~Крыса-оборотень шипит: «Челове-е-ек! С-с-сдох-хни!» Она бросается на тебя.~
@23943 = ~Крыса-оборотень шипит на тебя, но сдерживает в себе явное желание напасть. Вместо этого она крадучись отступает назад, не отрывая от тебя глаз.~
@23944 = ~Человекоподобная крыса стучит зубами и трясёт головой, когда ты пытаешься поговорить с ней. Она явно утратила желание говорить с людьми.~
@23945 = ~Крыса-оборотень шипит: «Челове-е-ек! С-с-сдох-хни!» Она бросается на тебя.~
@23946 = ~Драться.~
@23947 = ~Бежать.~
@23948 = ~Драться.~
@23949 = ~Бежать.~
@23950 = ~«Тогда прощай».~
@23951 = ~«Тогда прощай».~
@23952 = ~Драться.~
@23953 = ~Бежать.~
@23954 = ~Этот труп Сборщика с песочными волосами покрыт отвратительного вида укусами. Шея мертвеца всё ещё извивается, будто пытается освободиться от тела.~
@23955 = ~«Итак, ты пришёл, — скелет поворачивается, чтобы взглянуть на массивный трон. — То, что ты видишь, есть конец нашей культуры».~
@23956 = ~«Да».~
@23957 = ~«Никто не должен знать, что Король издаёт лишь молчание».~
@23958 = ~Харгримм вперяет взгляд в тени. «Он перестал говорить с нами давным-давно, ибо променял на трижды проклятую Истинную Смерть, — следы гнева и отчаяния проскальзывают в его голосе. — Он бросил нас здесь страдать среди живущих! Мы стали… жертвой… для всех, кто живёт».~
@23959 = ~«Он молчит, ибо покинул это место. Он бросил нас ради Истинной Смерти… и оставил лишь пустую оболочку там, где он был».~
@23960 = ~«Он правит, потому что должен».~
@23961 = ~«Мы толкуем желания Безмолвного Короля, опираясь на то, что он молвил много лет назад. Это нелегко… — голос Харгримма звучит устало; он словно сгибается под тяжестью своей невидимой ноши. — Много вопросов, много вопросов у меня для него».~
@23962 = ~«Мэри и я говорим с Безмолвным Королём. Мы правим вместо него».~
@23963 = ~«Я хотел бы сохранить то, что мы создали. Я не хочу умирать».~
@23964 = ~«Если наш собственный народ узнает сие… или Акаста раскроет наш обман… или Многие-как-Один, коллективный мозг черепокрыс… всё, что мы здесь создали, будет разрушено. Только эта оболочка и держит внутренних и внешних врагов в страхе. Если правда станет известна, наша маленькая цивилизация обернётся пылью».~
@23965 = ~«Я не могу заставить тебя молчать. Но я просил бы озаботиться не только о себе и задуматься, что случится, если ты расскажешь об увиденном здесь».~
@23966 = ~Минуту Харгримм молчит. «Ты можешь покинуть это место. Иди сейчас… но я заклинаю тебя: держи своё слово».~
@23967 = ~«Это… интересно».~
@23968 = ~Труп Чада говорит замогильным голосом: «Чего ты хочешь, друг?»~
@23969 = ~«Так где, ты говорил, тот графин?»~
@23970 = ~«Я бы хотел узнать, где та штука, о которой ты говорил».~
@23971 = ~«Расскажи мне о себе».~
@23972 = ~«Расскажи мне о других Сборщиках».~
@23973 = ~«Что ты можешь рассказать о катакомбах?»~
@23974 = ~«Да, собственно, ничего. Прощай».~
@23975 = ~«А-ай, ладно, — он прерывается. — Чего ты хочешь?»~
@23976 = ~«Так где, ты говорил, тот графин?»~
@23977 = ~«Я бы хотел узнать, где та штука, о которой ты говорил».~
@23978 = ~«Расскажи мне о себе».~
@23979 = ~«Расскажи мне о других Сборщиках».~
@23980 = ~«Что ты можешь рассказать о катакомбах?»~
@23981 = ~«Да, собственно, ничего. Прощай».~
@23982 = ~«Тебе надо просочиться мимо трупаков или крыс в Затопленные Народы. Окажешься там — шагай по главному коридору и пропусти три прохода слева. Как пройдёшь под аркой — смотри первый поворот налево. Он в арке, ближайшей к задней стене. Я не знаю командного слова… но пару глотков ты себе нацедишь. Всё ясно, друг?»~
@23983 = ~«Думаю, да. Однако у меня другие вопросы…»~
@23984 = ~«Думаю, да. Прощай».~
@23985 = ~«Хорошо, вот тебе мой сказ: есть причина, почему Затопленные Народы так называются. Есть волшебная бутылка, из которой вода никогда не перестаёт течь. Это графин, спрятанный в катакомбах Затопленных Народов. Заполучишь его — и всегда будешь со свежей водой».~
@23986 = ~«Ну хорошо. Где это?»~
@23987 = ~«У меня к тебе другие вопросы…»~
@23988 = ~«Спасибо. Прощай».~
@23989 = ~«Я? Я Чад. Раньше был художником. Деньги, слава, уважение, женщины… а потом всё это рухнуло. Присоединился к команде Фарода и стал одним из лучших расхитителей катакомб; мог спереть что-нибудь из-под носа у самой королевы упырей. Затем… затем я обнаглел окончательно и начал строить планы на одно из подземных укреплений — то, что я называю *серьёзными* катакомбами — и превратился в пищу для варгуйлий. Да и сам почти стал варгуйльей. Только силой воли удерживаюсь в своём уме. Хорошо, что ты пришёл».~
@23990 = ~«Ясно. У меня были другие вопросы…»~
@23991 = ~«Действительно хорошо. Прощай».~
@23992 = ~«Хе… нас довольно много. Однако Грызь был лучшим — после меня, конечно».~
@23993 = ~«Грызь тоже мёртв».~
@23994 = ~«У меня другие вопросы».~
@23995 = ~«Конечно. Прощай».~
@23996 = ~«Правда? — его голос заметно оживляется. — Ну, теперь хотя бы не будет вонять, что он лучше меня».~
@23997 = ~«Да, скорее всего, не будет. Ответишь на другие вопросы?»~
@23998 = ~«Я бы особо не рассчитывал. Прощай».~
@23999 = ~«Что я могу рассказать о катакомбах? Монстры так и кишат, и если ты не дурак, то не будешь здесь прохлаждаться. Берёшь, что тебе надо, и сваливаешь. Слишком много тут ловушек и тварей, с которыми лучше вообще не встречаться. Мой тебе совет: уматывай, пока не поздно».~
@24000 = ~«Просто ответь на пару вопросов…»~
@24001 = ~«Я подумаю».~
@24002 = ~Шея трупа всё ещё извивается, когда ты подходишь. «Не нашёл ещё ту, которая меня уделала?» — спрашивает труп.~
@24003 = ~«Ещё нет. Я занимаюсь этим. Сначала мне нужны кое-какие ответы».~
@24004 = ~«Ещё нет. Я работаю над этим».~
@24005 = ~«Быстрее, пень! Я не знаю, как долго ещё моя шея выдержит это растяжение…»~
@24006 = ~«Скажи, что я получу в награду?»~
@24007 = ~«Расскажи мне о себе».~
@24008 = ~«Расскажи мне о катакомбах».~
@24009 = ~«Повтори, что тебе от меня надо?»~
@24010 = ~«Ладно, ладно. Не переживай так».~
@24011 = ~«Я обещал сказать тебе… как найти… эгм-м… волшебный предмет, который, по-моему, может пригодиться…»~
@24012 = ~«Хорошо, хорошо. Ответь на пару вопросов, если не сложно…»~
@24013 = ~«Я в деле. Прощай».~
@24014 = ~«Смотри… моя голова почти оторвалась… мне правда не до болтовни прямо сейчас… спроси меня… позже».~
@24015 = ~«Повтори, что тебе от меня надо?»~
@24016 = ~«Чего ты от меня хочешь?»~
@24017 = ~«Хотя бы скажи, чего ты хочешь?»~
@24018 = ~«Видишь… эту… шею?» — шея у него растягивается и сжимается, как пружина. «Меня укусила долбаная варгуйлья. Я мёртв и… вынужден удерживать свою голову, если не хочу быть… одной из тех адовых… тварей, — разговор даётся ему с усилием. — Ты должен убить варгуйлий дальше по коридору… всех их… это спасёт меня».~
@24019 = ~«Что я получу в награду?»~
@24020 = ~«Да легко».~
@24021 = ~Ты замечаешь, что шея Чада выглядит лучше… больше она не вытягивается, пытаясь оторваться от туловища. «Спасибо, друг… по крайней мере теперь я знаю, что не стану навеки варгуйльей… Ты хочешь награду сейчас?»~
@24022 = ~«Скажи мне».~
@24023 = ~«Нет. Ответь на кое-какие вопросы».~
@24024 = ~«В оплату… ты получишь… указания, как найти… мощный магический предмет… зрение мёртвого говорит мне… что тебе может пригодиться…»~
@24025 = ~«Что это?»~
@24026 = ~«Уже иду».~
@24027 = ~«Я подумаю. Прощай».~
@24028 = ~«Найди их и… тогда я скажу. Не раньше».~
@24029 = ~«Прекрасно. Я пошёл».~
@24030 = ~«Я подумаю. Прощай».~
@24031 = ~Этот труп Сборщика с песочными волосами покрыт отвратительного вида укусами. Шея мертвеца всё ещё извивается, будто пытается освободиться от тела. Говорит он с усилием: «Эй… я Чад… нужна твоя помощь…»~
@24032 = ~«Что с тобой случилось?»~
@24033 = ~«Что ты можешь сказать о катакомбах?»~
@24034 = ~«Расскажи мне о себе».~
@24035 = ~«Где мы?»~
@24036 = ~«Нет. Прощай».~
@24037 = ~Каменное лицо молчит. Струйка чистой воды бежит из уголка его глаза, былая гримаса на лице стёрлась.~
@24038 = ~«Глив, мне нужны ещё ответы…»~
@24039 = ~«Ну и ладно».~
@24040 = ~«Ну и ладно».~
@24041 = ~Лицо остаётся молчаливым и бесстрастным.~
@24042 = ~«Ну и ладно».~
@24043 = ~«Ну и ладно».~
@24044 = ~Неподвижные глаза Глива, кажется, так и тянутся в твою сторону, когда ты приближаешься. «Ты… уже решил… нужен ли тебе… ответ?»~
@24045 = ~«Да, дай его мне».~
@24046 = ~«Нет, ещё нет. Сначала ответь на другие мои вопросы».~
@24047 = ~«Нет, ещё нет. Прощай, Глив».~
@24048 = ~«Найди… женщину по имени… Немель. Она проживает… в районе Клерков… в Верхнем Сигиле. Я не знаю… где точно… Желаю удачи… в твоём задании… бессмертный», — голос стихает с каждым словом.~
@24049 = ~«Спасибо, Глив. У меня есть ещё вопросы».~
@24050 = ~«Спасибо, Глив. Прощай».~
@24051 = ~«Что… ты хотел… узнать?»~
@24052 = ~«Расскажи мне о себе. Как ты дошёл до жизни такой?»~
@24053 = ~«Что ты можешь рассказать об окружающих нас катакомбах?»~
@24054 = ~«А знаешь, я предпочту услышать ответ, который ты мне обещал».~
@24055 = ~«Напомни, что ты от меня хочешь?»~
@24056 = ~«Я принёс тебе графин».~
@24057 = ~«Ничего. Прощай».~
@24058 = ~«Когда-то я был… уважаемым лидером… моей общины… в Нижнем районе. Мелкий лорд… хотел увеличить свою силу… ценой моих людей… друзей… и родственников… и я с друзьями выступал… против него».~
@24059 = ~«И что потом?»~
@24060 = ~«Знаешь что? Не бери в голову. Ответь на другие вопросы».~
@24061 = ~«Забудь. Прощай».~
@24062 = ~«А потом… он захватил нас… одного за другим… и заковал наш дух и чувства… в эти кричащие лица… под Дитч… куда стекается… вся грязь Сигила. И затем… он пустил сточные воды сверху… течь сквозь наши рты… и носы… и глаза».~
@24063 = ~«Могу я чем-нибудь помочь?»~
@24064 = ~«Ясно. У меня другие вопросы…»~
@24065 = ~«Любопытно. Прощай».~
@24066 = ~«Кошмар какой. Прощай».~
@24067 = ~«Я обречён… оставаться здесь… пока свежая вода… не коснётся моих губ… Есть… магический графин с водой… в… Затопленных Народах. Принеси его мне… и дай попробовать воду… а я расскажу тебе… кое о ком… кто поможет открыть… его полный потенциал… и ты никогда… не будешь нуждаться в воде».~
@24068 = ~«Где этот графин?»~
@24069 = ~«Интересно. Ответь мне на другие вопросы».~
@24070 = ~«Ясно. Прощай».~
@24071 = ~«Я… не знаю. Был… художник по имени… Чад, часто посещавший… эти туннели. Он знал. Найди его… может, он тебе скажет».~
@24072 = ~«А как мне попасть в Затопленные Народы?»~
@24073 = ~«Хорошо. Ответь мне на другие вопросы».~
@24074 = ~«Я найду его. Прощай».~
@24075 = ~«Я найду его. Прощай».~
@24076 = ~«Я посмотрю, что смогу сделать. Прощай».~
@24077 = ~«Вода… свежая вода… из магического графина… в Затопленных Народах…»~
@24078 = ~«И как мне туда попасть?»~
@24079 = ~«Понял. Ответь на другие вопросы».~
@24080 = ~«Понял. Прощай».~
@24081 = ~«Через Мёртвые Народы… где мёртвые ходят… и правят… или через Дом Мысли… где Многие-как-Один держит бразды… И то и другое… рискованно».~
@24082 = ~«Мёртвые Народы?»~
@24083 = ~«Многие-как-Один?»~
@24084 = ~«Понял. У меня были другие вопросы…»~
@24085 = ~«Понял. Прощай».~
@24086 = ~«Мёртвые… достигли жизни… своим путём. Они правят… частью этих… катакомб. Борются с… Многими-как-Один… за власть над этими… туннелями».~
@24087 = ~«Расскажи мне ещё о катакомбах».~
@24088 = ~«Расскажи мне о Многих-как-Один».~
@24089 = ~«Дай мне ещё кое-какие ответы…»~
@24090 = ~«Спасибо, Глив. Прощай».~
@24091 = ~«Ты слышал… о черепокрысах? Когда они собираются… они становятся сильнее… общий мозг. Они и их слуги… крысы-оборотни… хотят править… этими туннелями. Они воюют с… Мёртвыми Народами».~
@24092 = ~Минуту Харгримм молчит. «И снова я не могу заставить тебя хранить молчание. Но должен знать, скажешь ты им или нет».~
@24093 = ~«Приношу тебе свою благодарность. Ты можешь уйти с миром сейчас, если пожелаешь. Двери с южной стороны тронного зала».~
@24094 = ~Точка отсчёта.~
@24095 = ~«Король должен быть живым, пока он сидит на троне. Другого не дано. Если некто сидит на троне… — тон Харгримма становится ещё более зловещим, — …он не может покинуть его».~
@24096 = ~«Соэго был бы плохим королём. Он слишком любит свой голос, чтобы хранить молчание. И такое положение на троне отобрало бы у него Истинную Смерть. Сие было бы таким же святотатством, как и попытка отобрать у нас жизнь, которой мы обладаем».~
@24097 = ~«Однажды сев на трон, его уже не покинуть. Смерть… Истинная Смерть… единственное избавление от трона Безмолвного Короля».~
@24098 = ~«Как я и думал, — Харгримм вздыхает, облако пыли вырывается при выдохе. — Итак… я по-прежнему хочу знать, расскажешь ли ты об истинной сущности Безмолвного Короля или нет».~
@24099 = ~Харгримм кивает и указывает на трон: «Так принимай свой трон, о Безмолвный Король…»~
@24100 = ~Скелет-священник печально качает головой. «Боюсь, мы не сможем позволить сего, живущий. Да благоволит мне Безмолвный Король в битве…»~
@24101 = ~«Расскажи мне о Мёртвых Народах».~
@24102 = ~«Расскажи мне ещё о катакомбах».~
@24103 = ~«У меня другие вопросы…»~
@24104 = ~«Дол-л-лг-г». (Долго.)~
@24105 = ~«Спасибо, Глив. Прощай».~
@24106 = ~Тухлая Мэри говорит тяжёлым голосом: «К-кык-ки йяа-а». (Как и я.)~
@24107 = ~«Ых-хы». (Да.)~
@24108 = ~«Катакомбы были прорыты… века назад… для погребения городских мёртвых… которые не желали… заботливой опёки Пыльных. Они стали… отвергнутыми землями… где обитают едва видимые монстры… где люди рыскают… как падальщики среди падальщиков. Многие-как-Один патрулируют эти туннели… и многих сумели повернуть против… их природы. Мёртвые Народы… тоже рыскают… охраняя от… грабительских набегов… людей… что сюда приходят».~
@24109 = ~Тухлая Мэри издаёт слабый булькающий звук.~
@24110 = ~«Что ты имеешь в виду?»~
@24111 = ~«Расскажи мне о Мёртвых Народах».~
@24112 = ~«Это и есть Безмолвный Король?»~
@24113 = ~«Расскажи про Многих-как-Один».~
@24114 = ~Молча ждать, когда он продолжит.~
@24115 = ~«У меня ещё кое-какие вопросы».~
@24116 = ~«Спасибо, Глив. Прощай».~
@24117 = ~«Как долго это продолжается?»~
@24118 = ~Искра жизни появляется в монотонном голосе Глива: «Ты принёс его? Вылей немного… воды из него… на мои губы… и я скажу… что обещал… тебе сказать».~
@24119 = ~«Почему он не говорит?»~
@24120 = ~«Давай».~
@24121 = ~«Тогда почему он правит?»~
@24122 = ~«Подожди. У меня к тебе другие вопросы».~
@24123 = ~Чистая вода из графина проливается на каменные губы, смывая ту мерзость, которая извергалась из отверстий. Ты наблюдаешь, как вода Дитча медленно исчезает вовсе, её грязный поток сменяется чистой, свежей водой. Глив стонет в экстазе. Через некоторое время он спрашивает: «Тебе нужен ответ сейчас или позже?»~
@24124 = ~«Если это так… как же он правит?»~
@24125 = ~«Дай мне его сейчас».~
@24126 = ~«Тогда кто правит на самом деле?»~
@24127 = ~«Позже. У меня были к тебе вопросы».~
@24128 = ~«Позже. Прощай, Глив».~
@24129 = ~«Как долго это продолжается?»~
@24130 = ~«Я буду… держать себя… в сознании… пока ты не вернёшься… за своим ответом…»~
@24131 = ~«Тогда почему он правит?»~
@24132 = ~«Хорошо. Теперь ответь на кое-какие вопросы».~
@24133 = ~«Если это так… как же он правит?»~
@24134 = ~«Тогда кто на самом деле управляет Мёртвыми Народами?»~
@24135 = ~«Но если он мёртв… как?»~
@24136 = ~«Тогда кто на самом деле управляет Мёртвыми Народами?»~
@24137 = ~«Хорошо. Прощай».~
@24138 = ~«Ты нашёл… графин, о котором… я тебе говорил?»~
@24139 = ~«Почему он до сих пор правит?»~
@24140 = ~«Ещё нет».~
@24141 = ~«Кто правит здесь на самом деле?»~
@24142 = ~«Да».~
@24143 = ~«Почему ты не скажешь своему народу правду?»~
@24144 = ~«Умоляю тебя… пожалуйста, найди его… и облегчи мои страдания».~
@24145 = ~«Сделаю всё возможное. Между тем, у меня ещё вопросы…»~
@24146 = ~«Посмотрим. Ответь мне на пару вопросов…»~
@24147 = ~«Я стараюсь. Прощай».~
@24148 = ~«Возможно. Прощай».~
@24149 = ~«Ты вернулся… чем я обязан… такой чести?»~
@24150 = ~«Продолжай…»~
@24151 = ~«Мне нужны ответы на некоторые вопросы».~
@24152 = ~Клятва: «Я хочу всего лишь уйти, Харгримм. Позволь мне это, и я обещаю молчать».~
@24153 = ~«Хороший вопрос. Прощай».~
@24154 = ~Дать лживое обещание: «Я хочу всего лишь уйти, Харгримм. Позволь мне это, и я обещаю молчать».~
@24155 = ~Когда ты проходишь мимо одного из искажённых каменных лиц на стене, оно взывает к тебе скрипучим голосом, звучащим, словно скрежет булыжников: «Бессмертный… выслушай меня. Я… Глив. Я хочу… поговорить с тобой».~
@24156 = ~«Твой народ должен знать. Если твоя цивилизация разрушена, да будет так».~
@24157 = ~«Как ты узнал, что я бессмертен?»~
@24158 = ~«Что ты хотел сказать?»~
@24159 = ~«Почему бы вам не посадить на трон нового короля?»~
@24160 = ~«Я так не думаю».~
@24161 = ~«Я вижу… пылающий ореол… в твоей ауре. Я вижу… многие вещи по полёту… пыли в этих туннелях. Ты потерял… что-то существенное… и это уберегает тебя… от сладких объятий смерти».~
@24162 = ~«Что ты хотел мне сказать?»~
@24163 = ~«Это всё хорошо и прекрасно, но…»~
@24164 = ~«Спасибо. Прощай».~
@24165 = ~«Слушай: это место содержит… большую опасность для тебя. Предательство ждёт тебя… на поверхности… а твой путь… долог и извилист. В конце концов… ты найдёшь… что искал… но вряд ли… этому обрадуешься».~
@24166 = ~«Я скажу им».~
@24167 = ~«Ты что-то вроде предсказателя?»~
@24168 = ~«Может, ты ответишь на мои вопросы…»~
@24169 = ~«Ясно. Возможно, я вернусь».~
@24170 = ~«Предсказатель? Нет… я наблюдатель. Вот и всё».~
@24171 = ~«В таком случае, может, ответишь на мои вопросы?..»~
@24172 = ~«Вот и всё? Тогда забудь. Прощай».~
@24173 = ~~
@24174 = ~«Знаешь, шеф, меня уже начинало тошнить от его… постоянных… пауз… в любом случае… хорошо… что он заткнулся… наконец».~
@24175 = ~«Очень смешно, Морте. Пойдём».~
@24176 = ~«Шеф, на кой ляд нам бесконечный запас воды? Где огонь, а?»~
@24177 = ~«Он может понадобиться позднее, Морте. Идём».~
@24178 = ~«Так поступить будет правильно, Морте».~
@24179 = ~«Правильно? Если ты забыл, шеф, у тебя своих забот полон рот! Но эй, что бы ты ни задумал, ты тут главный. Тьфу…»~
@24180 = ~«Спасибо за разрешение, Морте. Пойдём».~
@24181 = ~Правда: «Я не скажу им».~
@24182 = ~Ложь: «Я не скажу им».~
@24183 = ~«Спасибо. Прощай».~
@24184 = ~~
@24185 = ~«Что насчёт Соэго?»~
@24186 = ~«Я стану вашим королём, если вы примете меня».~
@24187 = ~Клятва: «Я хочу всего лишь уйти, Харгримм. Позволь мне это, и я обещаю молчать».~
@24188 = ~Дать лживое обещание: «Я хочу всего лишь уйти, Харгримм. Позволь мне это, и я обещаю молчать».~
@24189 = ~«Твой народ должен знать. Если твоя цивилизация разрушена, да будет так».~
@24190 = ~«Тогда я стану вашим королём, если вы примете меня».~
@24191 = ~Клятва: «Я хочу всего лишь уйти, Харгримм. Позволь мне это, и я обещаю молчать».~
@24192 = ~Дать лживое обещание: «Я хочу всего лишь уйти, Харгримм. Позволь мне это, и я обещаю молчать».~
@24193 = ~«Твой народ должен знать. Если твоя цивилизация разрушена, да будет так».~
@24194 = ~«Да. Я согласен…»~
@24195 = ~«В таком случае — нет».~
@24196 = ~Клятва: «Я хочу всего лишь уйти, Харгримм. Позволь мне это, и я обещаю молчать».~
@24197 = ~Дать лживое обещание: «Я хочу всего лишь уйти, Харгримм. Позволь мне это, и я обещаю молчать».~
@24198 = ~«Твой народ должен знать. Если твоя цивилизация разрушена, да будет так».~
@24199 = ~«Подожди… лучше я откажусь».~
@24200 = ~Взойти на трон.~
@24201 = ~Драться.~
@24202 = ~Бежать.~
@24203 = ~«Ты знаешь, что Безмолвный Король — всего лишь обычный скелет?»~
@24204 = ~«Ты знаешь, что Безмолвный Король — всего лишь обычный скелет?»~
@24205 = ~«Ты знаешь, что Безмолвный Король — всего лишь обычный скелет?»~
@24206 = ~«Безмолвный Король мёртв, и уже давно. *Нет* больше Безмолвного Короля».~
@24207 = ~«Сделай небольшое количество текста и небольшое число ответов».~
@24208 = ~«Нет, пока ничего. Вернёмся в главное меню».~
@24209 = ~«Просто проверял, как у тебя дела».~
@24210 = ~БОЛЬШОЙ ТЕКСТ, ОТВЕТЫ: «Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка. Работа, работа и нет игрушек. У мелкого Джима голова как подушка».~
@24211 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24212 = ~«Покажи мне небольшой текст и немного ответов».~
@24213 = ~«Покажи мне ещё раз небольшой текст и много ответов».~
@24214 = ~«Вернись в главное меню».~
@24215 = ~«Это всё, что я хотел».~
@24216 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24217 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24218 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24219 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24220 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24221 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24222 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24223 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24224 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24225 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24226 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24227 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24228 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24229 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24230 = ~«Покажи мне ещё раз большой текст и много ответов».~
@24231 = ~НЕБОЛЬШОЙ ТЕКСТ И НЕМНОГО ОТВЕТОВ. «Вот оно».~
@24232 = ~«Покажи небольшой текст и немного ответов».~
@24233 = ~«Вернись в меню Гарднера».~
@24234 = ~НЕБОЛЬШОЙ ТЕКСТ И МНОГО ОТВЕТОВ. «Вот оно».~
@24235 = ~«Покажи небольшой текст и много ответов».~
@24236 = ~«Покажи большой текст и много ответов».~
@24237 = ~«Покажи небольшой текст и немного ответов».~
@24238 = ~«Вернись в главное меню».~
@24239 = ~«Всё ясно, спасибо. До встречи».~
@24240 = ~«Покажи небольшой текст и много ответов».~
@24241 = ~«Покажи небольшой текст и много ответов».~
@24242 = ~«Покажи небольшой текст и много ответов».~
@24243 = ~«Покажи небольшой текст и много ответов».~
@24244 = ~«Покажи небольшой текст и много ответов».~
@24245 = ~«Покажи небольшой текст и много ответов».~
@24246 = ~«Покажи небольшой текст и много ответов».~
@24247 = ~«Покажи небольшой текст и много ответов».~
@24248 = ~«Покажи небольшой текст и много ответов».~
@24249 = ~«Покажи небольшой текст и много ответов».~
@24250 = ~«Покажи небольшой текст и много ответов».~
@24251 = ~«Покажи небольшой текст и много ответов».~
@24252 = ~«Покажи небольшой текст и много ответов».~
@24253 = ~«Покажи небольшой текст и много ответов».~
@24254 = ~«Покажи небольшой текст и много ответов».~
@24255 = ~«Что он сказал, Анна?»~
@24256 = ~«Что он сказал, Дак'кон?»~
@24257 = ~«Что он сказал, Грейс?»~
@24258 = ~«Что он сказал, Анна?»~
@24259 = ~«Что он сказал, Дак'кон?»~
@24260 = ~«Что он сказал, Грейс?»~
@24261 = ~«Почему нет?»~
@24262 = ~«Ясно. У меня есть другой вопрос…»~
@24263 = ~«Забудь… вернусь, когда добуду переводчика получше. Прощай».~
@24264 = ~«Что он сказал, Анна?»~
@24265 = ~«Что он сказал, Дак'кон?»~
@24266 = ~«Что он сказал, Грейс?»~
@24267 = ~«Почему нет?»~
@24268 = ~«Возможно, ты ответишь ещё на один вопрос…»~
@24269 = ~«Разговор окончен. Прощай».~
@24270 = ~Фелл сказал, что знает меня, но не может рассказать мою «историю». Но самым странным была причина. По его словам, не скажет он потому, что «не может изменить природу человека».~
@24271 = ~«Что он сказал, Анна?»~
@24272 = ~«Что он сказал, Дак'кон?»~
@24273 = ~«Что он сказал, Грейс?»~
@24274 = ~Фелл расшифровал значение татуировок на моей старой руке… по его словам, они говорят о четырёх, некогда путешествовавших со мной. Эти четверо были: «одна, любящая того, кто не любил», «один, кто не видел того, что видят другие, но видел то, что остальные не видят», «один приручённый и связанный долгом» и «один, кто был рабом в цепях слов». Он сказал, что они претерпели не меньше страданий, чем я, и что я притягиваю страдающие души.~
@24275 = ~«Что он сказал, Анна?»~
@24276 = ~«Что он сказал, Дак'кон?»~
@24277 = ~«Что он сказал, Грейс?»~
@24278 = ~«Ясно. У меня есть другой вопрос…»~
@24279 = ~«Забудь… вернусь, когда добуду переводчика получше. Прощай».~
@24280 = ~«Что он сказал, Анна?»~
@24281 = ~«Что он сказал, Дак'кон?»~
@24282 = ~«Что он сказал, Грейс?»~
@24283 = ~«„Природу человека“? Что это значит?»~
@24284 = ~«Ясно. У меня есть другой вопрос…»~
@24285 = ~«Я услышал достаточно. Прощай».~
