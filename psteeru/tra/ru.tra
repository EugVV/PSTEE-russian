@25466 = ~«Это всё, что я хотел узнать. Прощай».~
@25467 = ~«Хорошо».~
@25468 = ~«Ладно. Я имею в виду… э-э… постараюсь больше ничего не подписывать».~
@25469 = ~«Ладно. Я имею в виду… э-э… постараюсь больше ничего не подписывать».~
