@27152 = ~«Дай мне ещё совет».~
@27153 = ~«Хорошо. У меня другие вопросы».~
@27154 = ~«Достаточно».~
@27155 = ~«Тогда вот вам мой совет, владыка: избегайте любви в привычном понимании. Любовь обязана быть жестокой, чтобы стать выше простой сентиментальности».~
@27156 = ~«Дай мне ещё совет».~
@27157 = ~«Дай мне ещё совет».~
@27158 = ~«Хорошо. У меня другие вопросы».~
@27159 = ~«Достаточно».~
@27160 = ~Ты чувствуешь невольную усмешку в уголках своих губ, но тебе удаётся её подавить. «Тогда вот вам мой совет, владыка: отделите себя от недалёких дураков и слабаков мыслью о своём предназначении. Это даст вам власть идти туда, куда остальные попросту побоятся».~
@27161 = ~«Дай мне ещё совет».~
@27162 = ~«Хорошо. У меня другие вопросы».~
@27163 = ~«Достаточно».~
