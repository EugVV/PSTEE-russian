@40387 = ~Предмет иммунитета +2~
@40388 = ~Маскировка сброшена~
@40389 = ~«Ты стремишься стать… Чующей?»~
@40390 = ~«Не сейчас. У меня ещё один вопрос…»~
@40391 = ~«Может быть. Прощай».~
@40392 = ~«У меня вопрос о другом…»~
@40393 = ~«Это всё, что я хотел узнать. Прощай».~
@40394 = ~«У меня вопрос о другом…»~
@40395 = ~«Это всё, что я хотел узнать. Прощай».~
@40396 = ~«Неважно. У меня другой вопрос…»~
@40397 = ~«Забудь об этом, Джульетта. Прощай».~
@40398 = ~«Десятая проститутка — кто она?»~
@40399 = ~«Неважно. У меня другой вопрос…»~
@40400 = ~«Забудь об этом, Джульетта. Прощай».~
@40401 = ~«Тогда у меня другой вопрос…»~
@40402 = ~«В таком случае прощай».~
@40403 = ~«Что-то не так, Джульетта?»~
@40404 = ~«У меня пара вопросов…»~
@40405 = ~«Я просто проходил мимо, Джульетта. Прощай».~
@40406 = ~«Пока что никаких. До свидания».~
@40407 = ~«Неважные, на самом деле. Его сердце было разбито, и он решил уступить место твоему „новому возлюбленному“».~
@40408 = ~«Монтекки собирался уступить тебя твоему „новому возлюбленному“, и мне пришлось сказать ему, что это розыгрыш. Не знаю, что он теперь будет делать».~
@40409 = ~«Мне показалось, что Монтекки это мало заинтересовало… я помню, как он сказал, что „в любом случае уже устал от всего этого“».~
@40410 = ~«Я отдал ему письма, но… не заметил никакой ответной реакции. Думаю, тебе стоит самой поговорить с ним».~
@40411 = ~«Кажется, Монтекки это мало заинтересовало… я помню, как он сказал, что у него тоже есть любовница».~
@40412 = ~«Я отдал ему письма, но… не заметил никакой ответной реакции. Думаю, тебе стоит самой поговорить с ним».~
@40413 = ~«Хватит слёзы разводить… я хочу получить ответы на свои вопросы, в конце концов — сделка есть сделка».~
@40414 = ~«Мне очень стыдно, что всё так вышло. Поговорим в другой раз, Джульетта. До свидания».~
@40415 = ~Тихо уйти.~
@40416 = ~~
@40417 = ~~
@40418 = ~«Так как он теперь всё знает, вы можете открыто поговорить о том, что оба думаете по поводу ваших отношений».~
@40419 = ~«Это было твоё решение. Я выполнил свою часть договора. А теперь хочу получить ответы на свои вопросы…»~
@40420 = ~«Я не уверен. У меня всё ещё есть к тебе вопросы…»~
@40421 = ~«Не знаю. Прощай».~
@40422 = ~«Конечно. А теперь я хочу получить ответы на свои вопросы…»~
@40423 = ~«Конечно. У меня всё ещё есть к тебе вопросы…»~
@40424 = ~«Рад был помочь. Прощай».~
@40425 = ~~
@40426 = ~«Возможно. В любом случае я выполнил обещанное… а теперь хочу получить ответы на свои вопросы».~
@40427 = ~«Возможно. У меня всё ещё есть к тебе вопросы…»~
@40428 = ~«Может, и так. Прощай, Джульетта».~
@40429 = ~«Почему бы тебе просто не *поговорить* с ним об этом? Вам нужно открыто обсудить ваши отношения, прежде чем что-либо придумывать».~
@40430 = ~«Возможно. В любом случае я выполнил обещанное… а теперь хочу получить ответы на свои вопросы».~
@40431 = ~«Возможно. У меня всё ещё есть к тебе вопросы…»~
@40432 = ~«Может, и так. Прощай, Джульетта».~
@40433 = ~«Пока что никаких. До свидания».~
@40434 = ~«Неважные, на самом деле. Его сердце было разбито, и он решил уступить тебя мне».~
@40435 = ~«Монтекки собирался уступить тебя мне, поэтому пришлось сказать ему, что это розыгрыш. Не знаю, что он теперь будет делать».~
@40436 = ~«Кажется, Монтекки это совсем не заинтересовало…»~
@40437 = ~«Я выдвинул свои требования, но… не заметил никакой ответной реакции. Однако он не хотел со мной драться. Думаю, тебе стоит самой поговорить с ним».~
@40438 = ~«Кажется, Монтекки это совсем не заинтересовало…»~
@40439 = ~«Я выдвинул свои требования, но… не заметил никакой ответной реакции. Думаю, тебе стоит самой поговорить с ним».~
@40440 = ~«Нет, не намерен».~
@40441 = ~«Нет, не намерен. Я помню его слова, что он „в любом случае уже устал от всего этого“».~
@40442 = ~«Нет, не намерен. Я помню, он сказал, что у него тоже есть любовница».~
@40443 = ~«Джульетта, у меня пара вопросов».~
@40444 = ~«Просто проходил мимо. Прощай, Джульетта».~
@40445 = ~«Да, есть…»~
@40446 = ~«Нет, просто проходил мимо. Прощай, Джульетта».~
@40447 = ~«Правда? Интересно. У меня ещё вопрос…»~
@40448 = ~«Ясно… это всё, что я хотел узнать. Прощай, Джульетта».~
@40449 = ~«У меня вопрос о другом…»~
@40450 = ~«Это всё, что я хотел узнать. Прощай».~
@40451 = ~Фигура отвечает медленно, убийственным тоном, её голос звучит как скрежет кинжала по камню: «Да? Пришёл поговорить с Мариссой, не так ли? Довольно грубо с твоей стороны проникать в тёмную комнату и так врываться в мой закуток… грубо и безрассудно». Ты слышишь тихий шелест, звучащий как лёгкий бриз… или как шипение змей.~
@40452 = ~«Мои извинения… я не знал наверняка, есть ли здесь кто-то».~
@40453 = ~«У меня кое-какие вопросы…»~
@40454 = ~«Тогда прощай».~
@40455 = ~Женщина издаёт тихое *хм*: «Но ведь эта комната выглядит так, словно в ней кто-то *есть*, не так ли? В таком случае ты уже уходишь?»~
@40456 = ~«Чуть позже… у меня кое-какие вопросы».~
@40457 = ~«Да… прощай».~
@40458 = ~«Неужели задашь? — слышен тихий шипящий звук; когда женщина снова говорит, её голос источает сарказм. — O-o, не могу дождаться…»~
@40459 = ~«Спрашивай».~
@40460 = ~«Я нашёл твою малиновую вуаль…»~
@40461 = ~«Я нашёл твою малиновую вуаль…»~
@40462 = ~«Почему ты всё время прячешься за ширмой?»~
@40463 = ~«Почему ты всё время прячешься за ширмой?»~
@40464 = ~«Почему тут так темно?»~
@40465 = ~«Почему тут так темно?»~
@40466 = ~«Что ты здесь делаешь?»~
@40467 = ~«Можешь рассказать мне об этом месте?»~
@40468 = ~Слышно тихое шипение: «Потому что я потеряла кое-что своё, и потому что ко мне на порог пожаловал кое-кто незваный».~
@40469 = ~«Можешь превратить, скажем, лим-лима в статуэтку?»~
@40470 = ~«Можешь превратить, скажем, лим-лима в статуэтку?»~
@40471 = ~«Можешь превратить, скажем, лим-лима в статуэтку?»~
@40472 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@40473 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@40474 = ~«Мне сказали, тебя недавно видели выходящей из покоев Вивьен… это как-нибудь связано с тем, что у неё украли „личный аромат“?»~
@40475 = ~«Мне сказали, тебя недавно видели выходящей из покоев Вивьен… это как-нибудь связано с тем, что у неё украли „личный аромат“?»~
@40476 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@40477 = ~«Знаешь что-нибудь о Рейвел Клубок-Загадок?»~
@40478 = ~«Я уже говорил с девятью проститутками… ты не знаешь, где десятая ученица?»~
@40479 = ~«Вообще-то неважно. Прощай».~
@40480 = ~«Что ты потеряла?»~
@40481 = ~«Я хочу спросить о другом…»~
@40482 = ~«Тогда я пойду. Прощай».~
@40483 = ~«Мою вуаль… мою малиновую вуаль. Случаем, не видел её где-нибудь?»~
@40484 = ~«Нет… а для чего она? Это всего лишь обычная вуаль?»~
@40485 = ~«Нет. У меня пара вопросов…»~
@40486 = ~«Нет, не видел. Прощай».~
@40487 = ~Марисса тихо вздыхает: «Нет, не совсем. Она помогала мне в общении… то есть в общении лицом к лицу».~
@40488 = ~«Зачем тебе прятать своё лицо?»~
@40489 = ~«У меня ещё вопрос…»~
@40490 = ~«Это всё, что я хотел узнать. Прощай».~
@40491 = ~«Довольно этих неразумных вопросов! Какой же ты надоедливый! Чего ты на самом деле *хочешь*?»~
@40492 = ~«Просто получить ответы на кое-какие вопросы…»~
@40493 = ~«Ничего. Прощай».~
@40494 = ~«Чтобы предотвратить любые нежелательные… и неловкие… случаи. Итак, чего ты хочешь?»~
@40495 = ~«Хочу, чтобы ты вышла на свет».~
@40496 = ~«Просто получить ответы на кое-какие вопросы…»~
@40497 = ~«Ничего. Прощай».~
@40498 = ~«Сижу здесь наедине со своими мыслями. Слушаю твою речь. Тишина в обоих случаях — буквально, а затем образно — оглушающая».~
@40499 = ~«Почему у тебя такое ужасное расположение духа?»~
@40500 = ~«Мне интересно услышать твои мысли…»~
@40501 = ~«У меня ещё вопрос…»~
@40502 = ~«Это всё, что я хотел узнать. Прощай».~
@40503 = ~«O, я так не думаю. Сейчас ты найдёшь их весьма нелестными. Чего ты на самом деле *хочешь*?»~
@40504 = ~«Почему у тебя такое ужасное расположение духа?»~
@40505 = ~«Просто получить ответы на кое-какие вопросы…»~
@40506 = ~«Ничего. Прощай».~
@40507 = ~«Ты действительно желаешь, чтобы я вышла из-за этой ширмы на свет и поговорила с тобой лицом к лицу? — Марисса смеётся, слышен шелест скользящей чешуи. — Нет, я так не думаю. Темнота меня устраивает, и я уверена, тебя тоже».~
@40508 = ~«Почему здесь так темно?»~
@40509 = ~«Пожалуйста, выйди на свет…»~
@40510 = ~«Тогда у меня другой вопрос…»~
@40511 = ~«В таком случае прощай».~
@40512 = ~«Нет. И никакие твои „пожалуйста“ меня не убедят. Итак, чего ты на самом деле *хочешь*? Наверняка пришёл сюда не только для того, чтобы *увидеть* меня».~
@40513 = ~«Я *действительно* хочу посмотреть, как ты выглядишь…»~
@40514 = ~«Тогда у меня другой вопрос…»~
@40515 = ~«В таком случае прощай».~
@40516 = ~«Тебе не стоит этого хотеть».~
@40517 = ~«O, но я хочу».~
@40518 = ~«Тогда у меня другой вопрос…»~
@40519 = ~«В таком случае прощай».~
@40520 = ~«А как выглядишь *ты*? Темнота скрывает нас обоих. Сыграем в игру? Мне ужасно скучно. Попробую угадать… ты человеческое существо мужского пола?»~
@40521 = ~«Да».~
@40522 = ~«Думаю, да…»~
@40523 = ~«Никаких игр. У меня вопрос…»~
@40524 = ~«Я сейчас не в настроении играть. Прощай».~
@40525 = ~«Ты… ранен в горло?»~
@40526 = ~«Да».~
@40527 = ~«Я не вижу, но полагаю, да».~
@40528 = ~«Довольно игр. У меня вопрос…»~
@40529 = ~«Я сейчас не в настроении играть. Прощай».~
@40530 = ~«Ты „думаешь“? Как ты можешь не знать?»~
@40531 = ~«Это довольно сложно».~
@40532 = ~«Я действительно не имею чёткого представления о том, кто я такой».~
@40533 = ~«Забудь. У меня вопрос…»~
@40534 = ~«Неважно. Прощай, Марисса».~
@40535 = ~«Правда? Должно быть, понять это слишком сложно для такого простого ума, как мой».~
@40536 = ~«Я действительно не имею чёткого представления о том, кто я такой».~
@40537 = ~«Забудь. У меня вопрос…»~
@40538 = ~«Неважно. Прощай, Марисса».~
@40539 = ~«Правда? Это почти… интересно…» — слышно шипение в темноте.~
@40540 = ~«Хм… опиши мне себя».~
@40541 = ~Правда: «Я высокий, мускулистый, весь покрыт шрамами».~
@40542 = ~Ложь: «Я высокий, атлетически сложенный… очень красивый…»~
@40543 = ~«Ты первая, Марисса».~
@40544 = ~«Прости, но нет. У меня вопрос…»~
@40545 = ~«Я не в настроении. Прощай».~
@40546 = ~«Правда? Хм-м-м… — она на минуту замолкает. — Как ты получил столько шрамов? Постой… неважно. Я не желаю знать».~
@40547 = ~«Теперь опиши мне себя».~
@40548 = ~«Хорошо. У меня был вопрос…»~
@40549 = ~«Прекрасно. Прощай, Марисса».~
@40550 = ~«O, правда? Подойди сюда — *очень* близко ко мне, чтобы мы смогли увидеть друг друга…» — кажется, тихое шипение исходит от неё самой…~
@40551 = ~Подойти к ней ближе.~
@40552 = ~Остаться на месте.~
@40553 = ~Ты приближаешься настолько, что твоё лицо почти касается Мариссы, и щуришься, чтобы лучше её разглядеть. Черты её лица прекрасны, кожа бледная и ровная, но её волосы — клубок извивающихся, шипящих змей. Глаза Мариссы — бриллиантового голубого цвета — кажутся немного странными, пока ты не понимаешь, что это искусные татуировки на её закрытых веках. «Ты готов к сюрпризу?» — спрашивает она, губы искривляются в ядовитой усмешке…~
@40554 = ~Отвернуться.~
@40555 = ~«Конечно, удиви меня».~
@40556 = ~«Может, эпитет в обмен на эпитет? Я начну со „стройная“. Ты должен назвать эпитет о себе».~
@40557 = ~«Высокий».~
@40558 = ~«Мускулистый».~
@40559 = ~«Израненный».~
@40560 = ~«Нет… никаких игр. У меня к тебе вопрос…»~
@40561 = ~«Я сейчас не в настроении играть. Прощай».~
@40562 = ~«М-м-м… хм-м. Я бы сказала… бледная».

Вы обмениваетесь эпитетами до тех пор, пока она не описывает себя как стройную, красивую женщину с раздвоенным языком, бледной кожей, причёской, состоящей из извивающихся змей, и горящими глазами… которые, как ты понял, она должна держать закрытыми.~
@40563 = ~«Ты изверг?»~
@40564 = ~«По описанию… ты очень экзотично выглядишь, Марисса».~
@40565 = ~Марисса беспечно смеётся, звук смеха сопровождается лёгким шипением: «Нет, вряд ли… хотя я и обладаю силами, которые можно *назвать* демоническими. Например, мой взгляд превращает живые создания в камень. Из плоти — в статую, не моргнув и глазом…»~
@40566 = ~«Живые создания в камень? А можешь превратить, скажем, лим-лима в статуэтку?»~
@40567 = ~«Живые создания в камень? А можешь превратить, скажем, лим-лима в статуэтку?»~
@40568 = ~«Живые создания в камень? А можешь превратить, скажем, лим-лима в статуэтку?»~
@40569 = ~«Наверное, мешает иногда».~
@40570 = ~«Наверное, мешает иногда».~
@40571 = ~«Наверное, мешает иногда».~
@40572 = ~«Интересно. У меня вопрос…»~
@40573 = ~«Ясно. Мне пора идти. Прощай, Марисса».~
@40574 = ~«Ты так думаешь? Должно быть, из-за этого-то я и сижу тут одна, в темноте, за ширмой прячусь», — хотя ты и не можешь видеть Мариссу, но уверен, что она усмехается. Неожиданно она вздыхает: «Если бы мне только знать, куда пропала моя малиновая вуаль. Ты её, случайно, не видел?»~
@40575 = ~«Нет… а для чего она? Это всего лишь обычная вуаль?»~
@40576 = ~«Нет. У меня были вопросы…»~
@40577 = ~«Нет, не видел. Прощай».~
@40578 = ~«Ты так думаешь? Должно быть, из-за этого-то я и сижу тут одна, в темноте, за ширмой прячусь», — хотя ты и не можешь видеть Мариссу, но уверен, что она усмехается. Неожиданно она вздыхает: «Если бы мне только знать, куда пропала моя малиновая вуаль».~
@40579 = ~«Твоя вуаль у меня с собой, Марисса…»~
@40580 = ~«Твоя вуаль у меня с собой, Марисса…»~
@40581 = ~«У меня вопрос…»~
@40582 = ~«До свидания, Марисса».~
@40583 = ~«С моей малиновой вуалью я могу ходить где угодно и не бояться, что это произойдёт, так что не так уж всё и ужасно».~
@40584 = ~«У меня вопрос…»~
@40585 = ~«До свидания, Марисса».~
@40586 = ~«Тогда не будешь ли ты так любезен дать её мне?»~
@40587 = ~«Конечно. Вот она…»~
@40588 = ~«Сперва дай мне что-нибудь взамен…»~
@40589 = ~Ты протягиваешь перед собой малиновую вуаль и чувствуешь, как её забирают из твоих рук: «Ах. Да, так намного лучше». Когда Марисса открывает глаза, перед тобой загораются две сияющие красным огнём точки: «Так вот как ты выглядишь… наверное, лучше бы мне было оставить глаза закрытыми».~
@40590 = ~«Следи за своим раздвоенным языком, Марисса».~
@40591 = ~«У меня вопрос…»~
@40592 = ~«Прощай, Марисса».~
@40593 = ~«Даже не думай начинать».~
@40594 = ~«У меня вопрос…»~
@40595 = ~«Прощай, Марисса».~
@40596 = ~«Конечно… истинный *наёмник*. Ладно… протяни руку, вот моё запястье… на нём нащупаешь золотой браслет. Бери, он твой. Уверяю, от него тебе будет больше пользы, чем от вуали».~
@40597 = ~«Вообще-то… забудь. Вот, просто возьми свою вуаль».~
@40598 = ~Взять браслет.~
@40599 = ~Ты аккуратно снимаешь браслет с тонкой ручки Мариссы…~
@40600 = ~Марисса беспечно смеётся, звук смеха сопровождается лёгким шипением: «О, да. Так и есть. А мой малейший взгляд превращает живые создания в камень… из плоти — в статую, не моргнув и глазом».~
@40601 = ~«Живые создания в камень? А можешь превратить, скажем, лим-лима в статуэтку?»~
@40602 = ~«Живые создания в камень? А можешь превратить, скажем, лим-лима в статуэтку?»~
@40603 = ~«Живые создания в камень? А можешь превратить, скажем, лим-лима в статуэтку?»~
@40604 = ~«Наверное, мешает иногда».~
@40605 = ~«Наверное, мешает иногда».~
@40606 = ~«Наверное, мешает иногда».~
@40607 = ~«Интересно. У меня вопрос…»~
@40608 = ~«Ясно. Пожалуй, я пойду. Прощай, Марисса».~
@40609 = ~Марисса описывает себя как стройную, красивую женщину с раздвоенным языком, бледной кожей, причёской, состоящей из извивающихся змей, и горящими глазами… которые, как ты понял, она должна держать закрытыми.~
@40610 = ~«Ты изверг?»~
@40611 = ~«По описанию… ты очень экзотично выглядишь, Марисса».~
@40612 = ~«Ты сомневаешься в моей оценке? Неужели ты не таков, каким себя описал?»~
@40613 = ~Подойти к ней ближе.~
@40614 = ~«Ладно… я высокий, мускулистый и весь покрыт шрамами».~
@40615 = ~«Просто забудь об этом. У меня вопрос…»~
@40616 = ~«А знаешь, не бери в голову. Прощай».~
@40617 = ~«Нет, я не в настроении. Уверена, какая-нибудь из девочек будет счастлива рассказать тебе о маленькой школе мадам Грейс для начинающих Чующих… найди одну из них».~
@40618 = ~«Чующих?»~
@40619 = ~«Не сейчас. У меня ещё вопрос…»~
@40620 = ~«Может, так и поступлю. Прощай».~
@40621 = ~«Да-да… маленькая глупая группа, посвятившая свою жизнь набору опыта. Мне совсем не надо становиться Чующей, чтобы *быть* Чующей… тем более что я уже получила доступ в Фестхолл и, если мне надоедят его сенсориумы, я просто пойду своей дорогой».~
@40622 = ~«Расскажи мне о сенсориумах».~
@40623 = ~«У меня вопрос о другом…»~
@40624 = ~«Это всё, что я хотел узнать. Прощай».~
@40625 = ~«Это залы, где хранятся чувства в так называемых камнях чувств. Залов всего два: общественный сенсориум в Фестхолле, открытый для всех, и сенсориум Чующих, открытый только для членов Общества Восприятия».~
@40626 = ~«У меня вопрос о другом…»~
@40627 = ~«Это всё, что я хотел узнать. Прощай».~
@40628 = ~«Я не знаю… но если и правда — я не удивлюсь. Во имя Геры, ты только *посмотри* на девочку! Спроси Джульетту, когда-то они были подругами… пока не появился Монтекки».~
@40629 = ~«У меня вопрос о другом…»~
@40630 = ~«Это всё, что я хотел узнать. Прощай».~
@40631 = ~«Я много времени провожу тут, в своих апартаментах, но, думаю, даже *я* бы узнала, появись тут десятая ученица. Пока такой нет».~
@40632 = ~«У меня вопрос о другом…»~
@40633 = ~«Это всё, что я хотел узнать. Прощай».~
@40634 = ~«Нет. А надо? — ты слышишь из темноты раздражённый вздох. — Спроси Ивес. Она собирает всякие разные истории, может быть, и расскажет тебе что-нибудь полезное».~
@40635 = ~«Неважно. У меня другой вопрос…»~
@40636 = ~«Забудь, что я спрашивал. Прощай».~
@40637 = ~«Нет, не имею ни малейшего представления».~
@40638 = ~«У меня вопрос о другом…»~
@40639 = ~«Мне пора идти. Прощай».~
@40640 = ~Марисса ничего не говорит, из темноты слышно лишь рассерженное шипение. «Да, я пробиралась к Вивьен и брала кое-что из её парфюмерии… хотя не знаю, кто тут этого не делал. Если ты настаиваешь на том, что я взяла её „*личный* аромат“, ну… можешь обнюхать тут всё вокруг. Уверяю, у меня ты его не найдёшь».~
@40641 = ~«У меня вопрос о другом…»~
@40642 = ~«Это всё, что я хотел узнать. Прощай».~
@40643 = ~Холодный суровый голос Мариссы с шипением доносится из тьмы: «Вернулся! Надеюсь, в этот раз у тебя веский повод? Или ещё больше бессмысленных вопросов?»~
@40644 = ~«Вообще-то я принёс тебе малиновую вуаль…»~
@40645 = ~«Вообще-то я принёс тебе малиновую вуаль…»~
@40646 = ~«Ещё немного „бессмысленных“ вопросов, Марисса».~
@40647 = ~«Просто проходил мимо. Прощай».~
@40648 = ~Алые глаза Мариссы светятся во тьме. «Да?» — лёгкое шипение сопровождает её вопрос.~
@40649 = ~«У меня вопросы, Марисса…»~
@40650 = ~«Неважно, просто проходил мимо. Прощай».~
@40651 = ~Ты отводишь свой взгляд, как только Марисса открывает глаза; боковым зрением ты замечаешь источаемый ими холодный красный свет. «Эх… — вздыхает она разочарованно. — Ты отвернулся! И на самом деле ты выглядишь *совсем* не так, как говорил… какая жалость. Можешь уже на меня смотреть, я снова закрыла глаза».~
@40652 = ~«У меня был вопрос…»~
@40653 = ~«Ну и ладно… я уже ухожу. Прощай».~
@40654 = ~Внезапно глаза Мариссы распахиваются, омывая тебя холодным красным светом… это последнее, что видят твои глаза, поскольку они — да и всё остальное у тебя — навсегда превращаются в камень.~
@40655 = ~«А-а-а-а…»~
@40656 = ~Марисса долго молчит и лишь потом отвечает: «Сперва это было из-за того, что я потеряла малиновую вуаль… но теперь… я не знаю. Может, я уже привыкла общаться так со своими клиентами, мне даже всё больше нравится. Порой мне кажется, что я устану от всего этого и рискну снова выйти в город, но пока… мне и здесь вполне комфортно».~
@40657 = ~«У меня вопрос о другом…»~
@40658 = ~«Это всё, что я хотел узнать. Прощай, Марисса».~
@40659 = ~Марисса ничего не говорит, из темноты слышно лишь рассерженное шипение. «Да, я пробиралась к Вивьен и брала кое-что из её парфюмерии… хотя не знаю, кто тут этого не делал. Если ты настаиваешь на том, что я взяла её „*личный* аромат“, ну… можешь обнюхать тут всё вокруг. Уверяю, у меня ты его не найдёшь. С таким же успехом он может быть у того, кто взял мою малиновую вуаль».~
@40660 = ~«У тебя украли вуаль?»~
@40661 = ~«У меня вопрос о другом…»~
@40662 = ~«Это всё, что я хотел узнать. Прощай».~
@40663 = ~«Да… „Экко“. Когда-то я знала одну Экко, но имя той писалось несколько иначе. Об этой девушке я ничего не знаю. Спроси Долору. Я слышала, она дружит с прежним любовником Экко».~
@40664 = ~«У меня вопрос о другом…»~
@40665 = ~«Это всё, что я хотел узнать. Прощай».~
@40666 = ~«Думаю, могла бы… будь у тебя лим-лим и будь я в настроении. А настроение у меня *могло* бы быть, будь у меня моя малиновая вуаль… но я не знаю, где она. Ты её нигде, случайно, не видел?»~
@40667 = ~«Нет… а для чего она? Это всего лишь обычная вуаль?»~
@40668 = ~«Нет. У меня пара вопросов…»~
@40669 = ~«Нет, не видел. Прощай».~
@40670 = ~«Думаю, могла бы… будь тебя лим-лим и будь я в настроении. А настроение у меня *могло* бы быть, будь у меня моя малиновая вуаль».~
@40671 = ~«У меня вопрос о другом…»~
@40672 = ~«Это всё, что я хотел узнать. Прощай».~
@40673 = ~«Думаю, могла бы… а зачем? У тебя что, есть с собой лим-лим?»~
@40674 = ~«Да».~
@40675 = ~«Нет, сейчас нет».~
@40676 = ~«А знаешь, не бери в голову. У меня к тебе вопрос».~
@40677 = ~«Забудь, что я спрашивал, Марисса… прощай».~
@40678 = ~«Тогда давай сюда…» — Марисса берёт маленькое счастливое существо из твоих рук… оно радостно щебечет — «Пийо! Пийо!» — не зная об уготованной ему судьбе.~
@40679 = ~С жуткой вспышкой болезненно-красного света весёлое щебетание лим-лима прерывается и сменяется тревожной тишиной. Марисса кладёт тебе в руки лим-лима — теперь просто кусок холодного тяжёлого камня.~
@40680 = ~«Благодарю, Марисса. У меня был вопрос…»~
@40681 = ~«Спасибо, Марисса. Прощай».~
@40682 = ~«Ну, в таком случае вопрос остаётся открытым, — она громко вздыхает. — Я не совсем понимаю, зачем вообще ты меня об этом спрашивал».~
@40683 = ~«У меня вопрос о другом…»~
@40684 = ~«Это всё, что я хотел узнать. Прощай».~
@40685 = ~Морте тихонько шепчет: «Ух ты… жуткая девчонка».~
@40686 = ~«Прошу прощения, леди… я не знал наверняка, есть ли здесь кто-то».~
@40687 = ~«У меня вопросы, леди…»~
@40688 = ~«Тогда всего хорошего, леди».~
@40689 = ~«Неважно, я просто проходил мимо. Прощай».~
@40690 = ~Этот серьёзного вида мужчина, похоже, всё ещё пытается что-то разгадать. Когда ты объявляешься рядом, он прерывает ход мысли и обращает на тебя взгляд: «Да?»~
@40691 = ~«У меня кое-какие вопросы…»~
@40692 = ~«Неважно, я просто проходил мимо. Прощай».~
@40693 = ~Он выглядит слегка раздражённым, но ничего не говорит.~
@40694 = ~«Кажется, ты чем-то обеспокоен…»~
@40695 = ~«Что ты здесь делаешь?»~
@40696 = ~«Что можешь рассказать мне об этом месте?»~
@40697 = ~«Знаешь что-нибудь о молчаливой проститутке?»~
@40698 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@40699 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@40700 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@40701 = ~«Знаешь что-нибудь о Рейвел Клубок-Загадок?»~
@40702 = ~«Я поговорил всего с девятью проститутками… не знаешь, где десятая ученица?»~
@40703 = ~«Вообще-то неважно. Прощай».~
@40704 = ~Мужчина хмурится: «Нет, не то чтобы „обеспокоен“… я просто пытаюсь придумать способ выиграть у Долоры».~
@40705 = ~«У кого?»~
@40706 = ~«Да, она достойный соперник».~
@40707 = ~«Надо бы мне сыграть против неё самому».~
@40708 = ~«У меня другой вопрос…»~
@40709 = ~«Это всё, что я хотел узнать. Прощай».~
@40710 = ~«Долора — одна из местных проституток. Приятная, образованная, интеллигентная… и с острым, как лезвие бритвы, умом. Если любите испытания — попробуйте обыграть её в стратегическую игру».~
@40711 = ~«Значит, ты у неё ни разу не выигрывал?»~
@40712 = ~«У меня другой вопрос…»~
@40713 = ~«Это всё, что я хотел узнать. Прощай».~
@40714 = ~Он качает головой и хмурится: «Обычно я играл против Вивьен и решил, что играю довольно неплохо… но потом столкнулся с Долорой. У меня сильное подозрение, что Вивьен просто позволяла мне выигрывать, но я никогда у неё об этом не спрашивал прямо».~
@40715 = ~«У меня другой вопрос…»~
@40716 = ~«Это всё, что я хотел узнать. Прощай».~
@40717 = ~«Отдыхаю после оглушительного поражения, которое мне устроила Долора. Но мне кажется, на этот раз я почти победил её, так что я пытаюсь придумать выигрышную стратегию для следующего поединка».~
@40718 = ~«Кто такая Долора?»~
@40719 = ~«Надо бы мне сыграть против неё самому».~
@40720 = ~«У меня другой вопрос…»~
@40721 = ~«Это всё, что я хотел узнать. Прощай».~
@40722 = ~Он кивает: «Ещё что-нибудь, или?..»~
@40723 = ~«Да, у меня ещё вопрос…»~
@40724 = ~«Нет, это всё. Прощай».~
@40725 = ~«Послушайте, у меня и так есть над чем подумать. Так что, если вы не возражаете…»~
@40726 = ~«Погоди… позволь ещё кое о чём тебя спросить…»~
@40727 = ~«Тогда извини, что побеспокоил. Прощай».~
@40728 = ~«Хорошо. Прощай».~
@40729 = ~«Ничего».~
@40730 = ~«У меня другой вопрос…»~
@40731 = ~«Тогда прощай».~
@40732 = ~«Рейвел, говорите? Никогда не спрашивал её об этом. Может, вам стоит попробовать».~
@40733 = ~«У меня другой вопрос…»~
@40734 = ~«Тогда прощай».~
@40735 = ~«Наверно, так и сделаю. Прощай».~
@40736 = ~«Нет. Я не разговаривал с Вивьен в последнее время, даже и не знал о пропаже. Обидно, вокруг неё *всегда* витали самые эротичные ароматы…»~
@40737 = ~«У меня другой вопрос…»~
@40738 = ~«Это всё, что я хотел узнать. Прощай».~
@40739 = ~«Нет. Ещё что-нибудь?»~
@40740 = ~«У меня другой вопрос…»~
@40741 = ~«Тогда прощай».~
@40742 = ~«Нет, — мужчина ухмыляется, затем вздыхает. — Ну, да. Она ночная ведьма, Госпожа отправила её в один из своих лабиринтов. И ещё — она главный герой более чем сотни страшных сказок для детей… но я готов поспорить, что это не та информация, которую вы ищете».~
@40743 = ~«У меня другой вопрос…»~
@40744 = ~«Всё равно спасибо. Прощай».~
@40745 = ~Он качает головой: «Нет, я так понял, их тут только девять».~
@40746 = ~«У меня другой вопрос…»~
@40747 = ~«Тогда прощай».~
@40748 = ~Это странное кубическое создание кажется настолько же машиной, насколько органическим существом. Когда ты подходишь, оно молча глазеет на тебя широкими немигающими глазами. На лице не отражается и намёка на эмоции.~
@40749 = ~«Приветствую…»~
@40750 = ~Оставить создание в покое.~
@40751 = ~Модрон молча смотрит на тебя.~
@40752 = ~«У меня кое-какие вопросы…»~
@40753 = ~«У меня кое-какие вопросы…»~
@40754 = ~Оставить его в покое.~
@40755 = ~Его металлический дрожащий голос больше похож на странную музыку какого-то изувеченного инструмента, чем на речь: «Отвечаю на твоё приветствие». Раздаётся лёгкий *щелчок*, и существо мигает. В воздухе повисает неловкая пауза.~
@40756 = ~«У меня кое-какие вопросы…»~
@40757 = ~«У меня кое-какие вопросы…»~
@40758 = ~«Объекту следует идентифицировать себя».~
@40759 = ~«Но… мои вопросы…»~
@40760 = ~«Неважно, кто я такой».~
@40761 = ~Ложь: «Я… Адан».~
@40762 = ~«Не знаю, кто я такой».~
@40763 = ~«Забудь… прощай».~
@40764 = ~«Выяснение наименования объекта имеет более высокий приоритет. Вопросы, задаваемые объектом, имеют низкий приоритет. Объекту следует идентифицировать себя».~
@40765 = ~«Неважно, кто я такой».~
@40766 = ~Ложь: «Я… Адан».~
@40767 = ~«Не знаю, кто я такой».~
@40768 = ~«Забудь… прощай».~
@40769 = ~«Мнение объекта о важности его наименования считается несущественным. Мы полагаем наименование объекта важным; таким образом, для любых целей и намерений наименование является важным».~
@40770 = ~Ложь: «Я… Адан».~
@40771 = ~«Не знаю, кто я такой».~
@40772 = ~«Забудь… прощай».~
@40773 = ~Создание слегка наклоняется вперёд, затем назад. Остаётся непонятным, был ли это поклон или кивок головой. «Мы идентифицируем себя модроны, тип квадрон, крылатый вариант; ответ объекту Адан».~
@40774 = ~«Теперь у меня вопросы…»~
@40775 = ~«Мне пора идти. Прощай».~
@40776 = ~«Мы желаем знать, почему».~
@40777 = ~«Это неважно, серьёзно…»~
@40778 = ~«Я ничего о себе не знаю. Просто не могу вспомнить».~
@40779 = ~Ложь: «Я… Адан».~
@40780 = ~«Забудь… прощай».~
@40781 = ~«У любого предмета должно быть имя; все предметы должны быть идентифицированы. Мы находим ответ неудовлетворительным, но достаточным на данный момент, — существо прерывается и мигает тебе. — Мы идентифицируем себя модроны, тип квадрон, крылатый вариант; ответ объекту».~
@40782 = ~«Теперь у меня вопросы…»~
@40783 = ~«Мне пора идти. Прощай».~
@40784 = ~«Объект свободен задавать любые вопросы».~
@40785 = ~«Не знаешь, что это за маленькое кубическое игрушечное существо?»~
@40786 = ~«Что ты здесь делаешь?»~
@40787 = ~«Что можешь рассказать мне об этом месте?»~
@40788 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@40789 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@40790 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@40791 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@40792 = ~«Знаешь что-нибудь о Рейвел Клубок-Загадок?»~
@40793 = ~«Я поговорил всего с девятью проститутками… не знаешь, где десятая ученица?»~
@40794 = ~«Вообще-то неважно. Прощай».~
@40795 = ~«Наша цель здесь — наблюдение».~
@40796 = ~«За чем вы наблюдаете?»~
@40797 = ~«Я хочу спросить о другом…»~
@40798 = ~«Это всё, что я хотел узнать. Прощай».~
@40799 = ~«Мы наблюдаем за одним из сотрудников учреждения».~
@40800 = ~«За кем вы наблюдаете?»~
@40801 = ~«Я хочу спросить о другом…»~
@40802 = ~«Это всё, что я хотел узнать. Прощай».~
@40803 = ~«Как было заявлено раньше, мы наблюдаем за одним из сотрудников учреждения».~
@40804 = ~«Да, но за кем *именно* вы наблюдаете?»~
@40805 = ~«Я хочу спросить о другом…»~
@40806 = ~«Это всё, что я хотел узнать. Прощай».~
@40807 = ~«Объект нашего наблюдения носит имя Долора».~
@40808 = ~«Зачем вам за ней следить?»~
@40809 = ~«Я хочу спросить о другом…»~
@40810 = ~«Это всё, что я хотел узнать. Прощай».~
@40811 = ~«Нас не проинформировали о цели — или целях — вследствие которых мы производим текущие наблюдения. Команда нашего старшего пентадрона является достаточной причиной для выполнения поставленной задачи; по существу, цель или цели не имеют значения».~
@40812 = ~«Я хочу спросить о другом…»~
@40813 = ~«Это всё, что я хотел узнать. Прощай».~
@40814 = ~«Здание расположено в части Сигила, известной как район Клерков. Мы не можем дать точных координат, поскольку поверхность Сигила меняется с невыясненными пока временными промежутками. Само здание известно как Бордель Безумной Интеллектуальной Страсти. Согласно распространённой точке зрения, оно служит языковой школой. Ученики школы, как правило, женщины, на определённой стадии — мы ещё не определили, на какой, так как стадия меняется от ученицы к ученице — становятся членами Общества Восприятия».~
@40815 = ~«Общества Восприятия?»~
@40816 = ~«Я хочу спросить о другом…»~
@40817 = ~«Это всё, что я хотел узнать. Прощай».~
@40818 = ~«Мы приведём краткое обобщение фактов: Общество Восприятия определяется как фракция, основным положением веры которой является то, что лишь с разнообразным опытом приходит истинное понимание мультивселенной и её секретов».~
@40819 = ~«Я хочу спросить о другом…»~
@40820 = ~«Это всё, что я хотел узнать. Прощай».~
@40821 = ~«Данный объект носит имя „Экко“. Мы не имеем другой информации по указанному объекту».~
@40822 = ~«Я хочу спросить о другом…»~
@40823 = ~«Это всё, что я хотел узнать. Прощай».~
@40824 = ~«Даже гипотетически предположив, что мы знаем, о какой Рейвел идёт речь, мы по-прежнему не можем с уверенностью утверждать, была ли она матерью Кезай».~
@40825 = ~«Какой Рейвел? А их что, много?»~
@40826 = ~«Я хочу спросить о другом…»~
@40827 = ~«Это всё, что я хотел узнать. Прощай».~
@40828 = ~«Мы не можем утверждать этого, но необходимо учитывать, что известно не менее 11032 бесконечных планов, из которых как минимум 3701 населены разумными существами, которые используют для обращения друг к другу имена. Таким образом, в любой момент времени может существовать бесконечное число особей с таким именем».~
@40829 = ~«Я хочу спросить о другом…»~
@40830 = ~«Это всё, что я хотел узнать. Прощай».~
@40831 = ~«Нет. Если объект в настоящий момент не осуществляет поисковые действия, мы бы предложили методический подход, заключающийся в опросе всех находящихся в этом здании».~
@40832 = ~«Я хочу спросить о другом…»~
@40833 = ~«Тогда я продолжу расспросы. Прощай».~
@40834 = ~«Мы не знаем существа или предмета, носящего такое наименование».~
@40835 = ~«Я хочу спросить о другом…»~
@40836 = ~«Тогда прощай».~
@40837 = ~«Нет. Мы не предпринимали попыток систематизировать всех обитателей данного здания, эта задача не входит в наши намерения».~
@40838 = ~«Я хочу спросить о другом…»~
@40839 = ~«Тогда прощай».~
@40840 = ~Модрон — его внешний вид совпадает с предметом в твоих руках во всех деталях, кроме размера — мигает один раз, затем ещё дважды и наконец произносит: «Предмет является портальным кубом. Пользователь должен разместить конечности портального куба в соответствующей конфигурации, тогда куб начнёт функционировать. После активации портальный куб транспортирует пользователя в то место, на которое он был настроен в процессе своего создания».~
@40841 = ~«И какова же соответствующая конфигурация для этого куба?»~
@40842 = ~«И куда этот куб отправит пользователя?»~
@40843 = ~«Мы не располагаем данной информацией. Более девяноста семи процентов всех портальных кубов функционируют в различающихся режимах. Мы не присутствовали при создании данного куба и не имеем инструкций по его использованию. Если объект имеет желание использовать портальный куб, ему следует определить эти параметры экспериментальным путём».~
@40844 = ~«Я хочу спросить о другом…»~
@40845 = ~«Тогда прощай».~
@40846 = ~«Да ладно, шеф! Мы тут в доме с самыми сексуальными девчонками в этой части мультивселенной, а ты собрался трепаться с *модронами*?»~
@40847 = ~«Что ты о них можешь сказать, Морте?»~
@40848 = ~Игнорировать Морте, приветствовать модрона.~
@40849 = ~«Извини, Морте, но я хочу поговорить с модроном».~
@40850 = ~«Хорошо, пойдём, Морте».~
@40851 = ~Морте издаёт звук крайнего отвращения: «А что тут скажешь? Маленькие надоедливые часовые жучки… всегда заняты тем, что несут порядок и закон в мультивселенную. Не *добро*, а именно… *порядок*. Может, просто забудем о них и пойдём поболтаем с дамочками?»~
@40852 = ~Игнорировать Морте, приветствовать модрона.~
@40853 = ~«Извини, Морте, но я хочу поговорить с модроном».~
@40854 = ~«Хорошо, пойдём, Морте».~
@40855 = ~Морте громко вздыхает: «Ладно, как хочешь. Но не говори потом, что я тебя не предупреждал. Скорее всего, ты от них ничего путного не добьёшься, шеф… разговор с ними — вещь крайне странная».~
@40856 = ~«Приветствую…»~
@40857 = ~Оставить её в покое.~
@40858 = ~Голос женщины глубокий и чувственный: «И *тебе* мои приветствия, сэр». Её горящие глаза блуждают по твоему лицу: «Я Кезай-Серрис. Итак, скажи мне, что я могу для тебя сделать, м-м?»~
@40859 = ~«Кезай? Ты дочь Рейвел?»~
@40860 = ~«Ну, а что ты обычно делаешь для клиентов?»~
@40861 = ~«У меня кое-какие вопросы…»~
@40862 = ~«Спасибо, ничего. Прощай».~
@40863 = ~Кезай от души смеётся, обнажая зубы вполне достаточной длины, чтобы назвать их клыками. Она встряхивает головой и улыбается Морте: «Весьма искренне, но всё же… что я могу для тебя сделать?»~
@40864 = ~«Кезай? Ты дочь Рейвел?»~
@40865 = ~«Ну, а что ты обычно делаешь для клиентов?»~
@40866 = ~«У меня кое-какие вопросы…»~
@40867 = ~«Спасибо, ничего. Прощай».~
@40868 = ~Кезай выгибает брови дугой. «Дразнишь, да? Хм! — она тебе улыбается, сузив горящие красным светом глаза. — Вернёшься, когда захочешь поговорить, м-м?»~
@40869 = ~Уйти.~
@40870 = ~«Разговариваю, конечно! Как правило, о снах, частенько об эротических… но не всегда! — Кезай подмигивает тебе, улыбаясь. — Итак! Ты расскажешь мне свой? Не стесняйся, я, знаешь ли, слышала всякое. И меня уже вряд ли чем-то можно удивить, а я так люблю узнавать сны людей. Мы даже можем обменяться ими, если хочешь, но ты начинаешь первым».~
@40871 = ~«Мои сны никогда уже не будут прежними после того, как я увидел тебя…»~
@40872 = ~«Мои сны никогда уже не будут прежними после того, как я увидел тебя, моя леди…»~
@40873 = ~«Если честно, у меня очень редко бывают сны. Уже долгое время мне вообще ничего не снится».~
@40874 = ~«У меня… не бывает снов, по правде говоря».~
@40875 = ~«Нет… лучше я воздержусь».~
@40876 = ~«Я бы с удовольствием, но у меня мало времени».~
@40877 = ~Кезай обиженно надувает губы, потом пожимает плечами: «Как хочешь! Я подожду, когда ты передумаешь…»~
@40878 = ~«Погоди… У меня были вопросы…»~
@40879 = ~«Хорошо. Прощай».~
@40880 = ~«Неужели? — Кезай улыбается и встряхивает головой. — Ну же, давай… позволь мне услышать нечто настоящее! О чём твои сны, м-м?»~
@40881 = ~«Если честно, у меня очень редко бывают сны. Уже долгое время мне вообще ничего не снится».~
@40882 = ~«У меня… не бывает снов, по правде говоря».~
@40883 = ~«Я бы не хотел об этом говорить».~
@40884 = ~«Я бы с радостью рассказал, но слишком мало времени».~
@40885 = ~«*Неужели*? — Кезай улыбается, её горящие красные глаза проходятся по тебе ещё раз. — Ты выглядишь очень диким, знаешь? Скажи, ты груб с любовницами? В смысле, во время *акта*… применяешь ли силу?»~
@40886 = ~«Ты имеешь в виду „насилие“?»~
@40887 = ~«Зачем тебе это знать?»~
@40888 = ~«Нет, вообще-то я достаточно нежен».~
@40889 = ~«Да, наверное».~
@40890 = ~«Только если им это нравится».~
@40891 = ~«Вообще, это зависит от настроения».~
@40892 = ~«Я… честно говоря, не знаю».~
@40893 = ~«Ни в коем случае! — Кезай сердито выдыхает. — Некоторые всё делают очень *медленно* и *чувственно*… а некоторые более прямолинейны, грубы и импульсивны, понимаешь? И мне просто было интересно, к какой группе относишься *ты*».~
@40894 = ~«Зачем тебе это знать?»~
@40895 = ~«Вообще-то я достаточно нежен».~
@40896 = ~«Знаешь, наверное, я немного грубоват».~
@40897 = ~~
@40898 = ~~
@40899 = ~«Я груб, только когда женщине это нравится».~
@40900 = ~«Вообще, это зависит от настроения».~
@40901 = ~«Я… честно говоря, не знаю».~
@40902 = ~Кезай пожимает плечами: «Я любопытна… и люблю разговаривать о любви во всех её проявлениях. Многие стесняются об этом говорить, но это очень важно, особенно с партнёром — так будет лучше для обоих! И я надеюсь, что мои клиенты найдут силы поговорить со своими любимыми, если, конечно, они уже этого не сделали. Итак, ты мне не ответил…»~
@40903 = ~«Вообще-то я достаточно нежен».~
@40904 = ~«Полагаю, что я несколько груб».~
@40905 = ~«Я груб, только когда женщине это нравится».~
@40906 = ~«Вообще, это зависит от настроения».~
@40907 = ~«Я… честно говоря, не знаю».~
@40908 = ~Кезай с улыбкой кивает: «Я ожидала, что ты так и скажешь. Сама я грубовата… мне нравится брать приступом и особенно я люблю кусаться! У меня острые зубы, так что приходиться быть осторожной. Порой меня заносит, и я пускаю кровь, знаешь ли».~
@40909 = ~«Острые зубы, говоришь?»~
@40910 = ~«Я бы не стал возражать…»~
@40911 = ~«Со мной этот номер *не пройдёт*…»~
@40912 = ~«Да уж… ну, у меня вопрос…»~
@40913 = ~«Ясно. Пойду-ка я лучше. Прощай».~
@40914 = ~«Скорее всего, бродила по Внешним Землям. Но это ведь был риторический вопрос, правда?» — она подмигивает Морте и снова поворачивается к тебе.~
@40915 = ~«Острые зубы, говоришь?»~
@40916 = ~«Думаю, я не стал бы возражать против укусов…»~
@40917 = ~«Со мной номер с укусами *не пройдёт*…»~
@40918 = ~«У меня пара вопросов, Кезай…»~
@40919 = ~«Пойду-ка я лучше. Прощай».~
@40920 = ~Кезай кивает. «М-м-хм, это уж точно. Хочешь посмотреть? Вот…» — она слегка приоткрывает рот и проводит фиолетовым языком по нижним зубам; её зубы вполне достаточной длины, чтобы назвать их клыками.~
@40921 = ~«Думаю, я не стал бы возражать против укусов…»~
@40922 = ~«Со мной номер с укусами *не пройдёт*, особенно такими зубками…»~
@40923 = ~«Ясно. У меня пара вопросов, Кезай…»~
@40924 = ~«Пойду-ка я лучше. Прощай».~
@40925 = ~Кезай смеётся: «Хотя сомневаюсь, что даже я смогла бы прокусить такую толстую шкуру, как у тебя. Она у тебя хоть что-то чувствует?»~
@40926 = ~«К сожалению, нет. Рубцы от шрамов очень толстые».~
@40927 = ~«Мне бы не хотелось об этом говорить».~
@40928 = ~«О, это прискорбно. У тебя *столько* шрамов… — Кезай внимательно вглядывается в твоё лицо. — Даже твои губы, даже веки… скажи, у тебя везде шрамы? Ну, ты понимаешь… *везде*?»~
@40929 = ~«Вообще-то нет. Кое-какие части у меня остались нетронутыми, наверное, случайно».~
@40930 = ~«Мне бы не хотелось об этом говорить».~
@40931 = ~«Вот и хорошо! — Кезай весело смеётся, но затем прикидывается серьёзной и упирает руки в боки. — Ты ведь мне так и не *рассказал* о своих снах. Давай же, выкладывай!»~
@40932 = ~«Если честно, у меня очень редко бывают сны. Уже долгое время мне вообще ничего не снится».~
@40933 = ~«У меня… не бывает снов, по правде говоря».~
@40934 = ~«Я бы не хотел об этом говорить».~
@40935 = ~«Я бы с радостью рассказал, но слишком мало времени».~
@40936 = ~«Вот видишь? Вот почему так важно говорить о таких вещах, особенно с любимым человеком. Первый раз может быть намного лучше, если обсудить акт заранее… кроме того, ведь об этом так весело говорить, а?» — Кезай широко улыбается, её глаза сверкают, словно два рубина.~
@40937 = ~«Да, тут я соглашусь».~
@40938 = ~«Нет, это всё слишком личное, чтобы относиться так легко».~
@40939 = ~«Я бы на самом деле не хотел это обсуждать».~
@40940 = ~Кезай кивает, явно погружённая в думы: «Слушай… ты ведь мне так и не *рассказал* о своих снах. Давай же, выкладывай!»~
@40941 = ~«Если честно, у меня очень редко бывают сны. Уже долгое время мне вообще ничего не снится».~
@40942 = ~«У меня… не бывает снов, по правде говоря».~
@40943 = ~«Я бы не хотел об этом говорить».~
@40944 = ~«Я бы с радостью рассказал, но слишком мало времени».~
@40945 = ~Кезай обиженно надувает губы, потом пожимает плечами: «Если тебе неудобно об этом говорить, ладно. Но, скажу я тебе, не стоит так же стесняться своей любовницы. Эти вещи нужно обсуждать, особенно перед актом, понимаешь? Так будет лучше для вас обоих».~
@40946 = ~«Буду иметь в виду».~
@40947 = ~«Я думаю, тебе не стоит соваться не в свои дела».~
@40948 = ~В ответ она просто улыбается: «Слушай… ты ведь мне так и не *рассказал* о своих снах. Давай же, выкладывай!»~
@40949 = ~«Если честно, у меня очень редко бывают сны. Уже долгое время мне вообще ничего не снится».~
@40950 = ~«У меня… не бывает снов, по правде говоря».~
@40951 = ~«Я бы не хотел об этом говорить».~
@40952 = ~«Я бы с радостью рассказал, но слишком мало времени».~
@40953 = ~Кезай ухмыляется и закатывает свои огненно-красные глаза: «*Ты* пришёл ко *мне*, знаешь ли. Если подобные вещи тебя раздражают, никто не запрещает тебе оставить меня и поговорить с другой женщиной».~
@40954 = ~«Не сейчас, у меня кое-какие вопросы…»~
@40955 = ~«Так, наверное, и сделаю. Прощай».~
@40956 = ~Кезай удивлённо выгибает бровь: «Правда? Как грустно! Даже извергам и дэвам снятся сны, знаешь ли. Ты *уверен*, что их нет?»~
@40957 = ~«Совершенно точно. Никаких снов, вообще».~
@40958 = ~«Хм. Очень необычно! Я даже и не знаю, что сказать…»~
@40959 = ~«Ну, у меня были кое-какие вопросы…»~
@40960 = ~«Ничего страшного. Счастливо, Кезай».~
@40961 = ~«Вообще ничего? Правда? Как странно! Даже извергам и дэвам снятся сны, знаешь ли. Так о чём эти твои редкие сны?» — Кезай наклоняется к тебе, с нетерпением ожидая ответа.~
@40962 = ~«Это скорее кошмары, чем сны. Видения о лабиринте из чёрных шипов… о ночной ведьме по имени Рейвел…»~
@40963 = ~«Я бы не хотел это обсуждать».~
@40964 = ~Кезай в течение какого-то времени не подаёт голоса. «О? О… кошмары. Ясно… печально, на самом деле печально…»~
@40965 = ~«С тобой всё в порядке? Ты выглядишь неожиданно смущённой…»~
@40966 = ~«Да, наверное. У меня вопросы…»~
@40967 = ~«Ничего страшного. Счастливо, Кезай».~
@40968 = ~«Я в порядке, в полном порядке. Но всё равно спасибо», — Кезай улыбается тебе.~
@40969 = ~«В таком случае у меня к тебе пара вопросов…»~
@40970 = ~«Тогда я пойду. Счастливо, Кезай».~
@40971 = ~Кезай моргает своими красными глазами в ожидании твоего вопроса.~
@40972 = ~«Кезай, я говорил с Кимази. Она сказала, что вы с ней единокровные сёстры и что твоей матерью была Рейвел».~
@40973 = ~«Ты, случайно, не дочь Рейвел?»~
@40974 = ~«Кто ты?»~
@40975 = ~«Если ты не возражаешь, можно ли мне узнать, кто ты?»~
@40976 = ~«Кто ты?»~
@40977 = ~«Если ты не возражаешь, можно ли мне узнать, кто ты?»~
@40978 = ~«Что ты здесь делаешь?»~
@40979 = ~«Можешь рассказать мне об этом месте?»~
@40980 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@40981 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@40982 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@40983 = ~«Ты что-нибудь знаешь о Рейвел Клубок-Загадок?»~
@40984 = ~«Я уже говорил с девятью проститутками… ты не знаешь, где десятая ученица?»~
@40985 = ~«Вообще-то неважно. Прощай».~
@40986 = ~Кезай качает головой. «Что, неужели не видишь?» — она придвигается поближе, её пышный бюст почти упирается в тебя. «Женщина! — она поднимает бровь. — Вижу, мой ответ тебя не удовлетворил… я — затронутая планами, вообще-то. И это всё, что тебе нужно знать».~
@40987 = ~«Кезай, я говорил с Кимази. Она сказала, что вы с ней единокровные сёстры и что твоей матерью была Рейвел».~
@40988 = ~«Ты дочь Рейвел?»~
@40989 = ~«У меня вопрос о другом…»~
@40990 = ~«Это всё, что я хотел узнать. Прощай».~
@40991 = ~Кезай качает головой. «Что, неужели не видишь?» — она придвигается поближе, её пышный бюст почти упирается в тебя. «Женщина!» — она поднимает бровь. «Вижу, мой ответ тебя не удовлетворил… я — затронутая планами, вообще-то, как и эта твоя подруга, — Кезай указывает на Анну. — И это всё, что тебе нужно знать».~
@40992 = ~«Кезай, я говорил с Кимази. Она сказала, что вы с ней единокровные сёстры и что твоей матерью была Рейвел».~
@40993 = ~«Ты дочь Рейвел?»~
@40994 = ~«У меня вопрос о другом…»~
@40995 = ~«Это всё, что я хотел узнать. Прощай».~
@40996 = ~«Отвечаю на твои вопросы, по-видимому, — она подмигивает. — Но на самом деле я ученица мадам Грейс. Как и все проститутки в Борделе».~
@40997 = ~«Ученица?»~
@40998 = ~«У меня вопрос о другом…»~
@40999 = ~«Это всё, что я хотел узнать. Прощай».~
@41000 = ~«Совершенно верно. Бордель — это что-то вроде школы для женщин, которые решили стать Чующими. Мадам Грейс учит нас тонкостям языка, чтобы мы могли лучше понимать себя и тех, кто нас окружает. Это позволяет наиболее полно прочувствовать планы, верно ведь?»~
@41001 = ~«Расскажи мне о Чующих».~
@41002 = ~«У меня вопрос о другом…»~
@41003 = ~«Это всё, что я хотел узнать. Прощай».~
@41004 = ~«Общество Восприятия считает, что мультивселенную можно понять, только прочувствовав её на собственном опыте… и чем больше у тебя опыта, тем ближе ты к пониманию загадки мультивселенной. Интригующе, а? По-моему, я родилась для этого. Я просто *хочу* знать всё на свете».~
@41005 = ~«У меня вопрос о другом…»~
@41006 = ~«Это всё, что я хотел узнать. Прощай».~
@41007 = ~«Разумеется. Бордель Безумной Интеллектуальной Страсти — фактически школа для женщин, которые решили стать Чующими. Мадам Грейс учит нас тонкостям языка, чтобы мы могли лучше понимать себя и тех, кто нас окружает. Это позволяет наиболее полно прочувствовать планы, верно ведь?»~
@41008 = ~«Расскажи мне о Чующих».~
@41009 = ~«У меня вопрос о другом…»~
@41010 = ~«Это всё, что я хотел узнать. Прощай».~
@41011 = ~«Нет, не знаю, — Кезай хмурится. — Большинство женщин здесь считают её жеманной, но со мной она вполне мила… похвалила как-то мои глаза… и от неё всегда так приятно пахнет! Надеюсь, она найдёт свой „личный аромат“. Попробуй спросить о нём Ненни, она ухитряется быть везде одновременно, так что могла чего-нибудь видеть».~
@41012 = ~«У тебя на самом деле изумительные глаза».~
@41013 = ~«У тебя на самом деле изумительные глаза».~
@41014 = ~«У меня вопрос о другом…»~
@41015 = ~«Это всё, что я хотел узнать. Прощай».~
@41016 = ~«Ну спасибо! Их свечение можно видеть в темноте, знаешь ли… странно ведь, нет? — она прерывается, чтобы посмотреть на тебя. — У тебя тоже славные глаза… такие тёмные и загадочные! В них столько силы».~
@41017 = ~«Спасибо, Кезай. У меня ещё один вопрос…»~
@41018 = ~«Спасибо. Счастливо, Кезай».~
@41019 = ~Кезай-Серрис пожимает плечами и возвращает взор на тебя.~
@41020 = ~«Хм. Нет, не видела с тех пор, как Марисса носила её в последний раз… но Ненни могла что-то видеть, спроси у неё. Наверное, это даже хорошо… Марисса не выйдет из своей комнаты без вуали, и мы будем избавлены от её языка… нам остаётся ругаться с одной только Кимази, — Кезай хмыкает. — Хотя Кимази, пожалуй, похуже будет».~
@41021 = ~«Почему?»~
@41022 = ~«У меня вопрос о другом…»~
@41023 = ~«Это всё, что я хотел узнать. Прощай».~
@41024 = ~«Марисса — надменная и суровая, но Кимази… она ожесточённая, злобная женщина. В каждом её слове — желчь, а поведением она напоминает балора. Я не понимаю, *как* кому-то может понравиться с ней разговаривать. Серьёзно сомневаюсь, что внешность оправдывает её беспощадный, ядовитый язык, но тем не менее у неё есть свои клиенты».~
@41025 = ~«У меня вопрос о другом…»~
@41026 = ~«Это всё, что я хотел узнать. Прощай».~
@41027 = ~«Нет. Ничего».~
@41028 = ~«Ты уверена? Кажется, ты вдруг расстроилась…»~
@41029 = ~«У меня вопрос о другом…»~
@41030 = ~«Это всё, что я хотел узнать. Прощай».~
@41031 = ~Её глаза сужаются в красные щёлки: «Конечно уверена! И не спрашивай больше об этом».~
@41032 = ~«Хорошо. Позволь спросить о другом…»~
@41033 = ~«Тогда прощай».~
@41034 = ~«Десятая? — Кезай поджимает губы и задумчиво похлопывает по ноге. — Нет… нас только девять. Здесь всегда только девять проституток, если только мадам Грейс не совершила кардинальных изменений, о которых я не знаю».~
@41035 = ~«У меня вопрос о другом…»~
@41036 = ~«Это всё, что я хотел узнать. Прощай».~
@41037 = ~Внезапно Кезай обнажает зубы, её глаза превращаются в пылающие малиновые щели: «Что?! Где ты такое услышал?»~
@41038 = ~«Экко сказала».~
@41039 = ~«Всего лишь слухи и ничего более».~
@41040 = ~«Какая нелепость! Думаю, уж я-то бы *знала*, если бы эта злая ведьма была моей матерью! А теперь довольно об этом».~
@41041 = ~«А кто тогда твоя мать?»~
@41042 = ~«Хорошо. Позволь спросить о другом…»~
@41043 = ~«Тогда прощай».~
@41044 = ~«Я не знаю, доволен? Меня вырастил отец, её я никогда не знала. Но неужели я, по-твоему, *выгляжу* как ночная ведьма?!»~
@41045 = ~«Ну… эта кожа… и эти глаза… да и зубы, наверное, тоже…»~
@41046 = ~«Нет-нет, конечно же, нет».~
@41047 = ~Кезай-Серрис буквально испепеляет тебя взглядом: «Возможно, поговорим *позже*, а сейчас я больше не в настроении. Прощай».~
@41048 = ~«Прощай».~
@41049 = ~Кезай скалится, её глаза пылают злобой: «Это… это… дьявол, как же я ненавижу эту женщину! Как ты вообще *поверил* в такой вздор?»~
@41050 = ~«Она сказала, что ты это отрицаешь, хотя можешь и не знать. Ещё сказала, что ты можешь спросить отца… и что он тебе наверняка скажет».~
@41051 = ~Кезай молча смотрит на тебя некоторое время. «Дай мне минуту», — она отворачивается и начинает что-то тихонько нашёптывать… воздух вокруг неё слегка мерцает и наполняется медным запахом, похожим на запах тёплой крови…~
@41052 = ~Терпеливо ждать.~
@41053 = ~Попробовать подслушать, что она говорит.~
@41054 = ~Ты наклоняешься в сторону Кезай, пытаясь разобрать её бормотание.

«Хогхазаненел, Изгнанный Принц Итхага, Маркиз Кровавых Теней, отец мой, услышь меня, я взываю к тебе…»~
@41055 = ~Слушать дальше.~
@41056 = ~Прекратить подслушивать.~
@41057 = ~«Да, любимый отец, это я, Кезай-Серрис. Прошу тебя ответить на один мой вопрос, я задаю его тебе снова и снова…»~
@41058 = ~Слушать дальше.~
@41059 = ~Прекратить подслушивать.~
@41060 = ~«Да, любимый отец. Мне надоело, когда меня спрашивают, а сама я не знаю ответа. Ты *должен* сказать мне… больше я ни о чём не прошу. Скажи мне, умоляю…»~
@41061 = ~Слушать дальше.~
@41062 = ~Прекратить подслушивать.~
@41063 = ~«Д-да… да, любимый отец, я понимаю. Спасибо тебе… прощай…»~
@41064 = ~«Ну? И что он тебе сказал?»~
@41065 = ~Отклониться назад и сделать вид, словно ты ничего не слышал.~
@41066 = ~Кезай какое-то время продолжает неподвижно стоять спиной, наконец поворачивается к тебе. «Не хочу верить, что эта злая ведьма могла быть моей матерью. Я живу на свете уже давно и не старею, вот только… тревожные сны, иногда, — она вздрагивает. — Но всё же… я не хочу быть наследницей того зла, что она породила, и не хочу попасть на глаза Госпожи, как моя мать. Она ведь творила такое зло!»~
@41067 = ~«Не могла бы ты рассказать мне о ней?»~
@41068 = ~«Мне надо, чтобы ты дала мне свою частицу, Кезай».~
@41069 = ~«Не волнуйся об этом, Кезай, ты совершенно непохожа на Рейвел. Счастливо».~
@41070 = ~«Я слышала, что она задавала людям невозможные загадки. Загадки, на которые могла ответить лишь она сама. Ответивших неправильно она пожирала или развешивала в своём саду кошмаров в качестве примера для других. Тех немногих, что избежали подобной судьбы, она преследовала в снах, загоняла их, словно лошадей, ломала их волю и бросала души в унылое забвение Серой Пустоши…»~
@41071 = ~«Продолжай…»~
@41072 = ~«Мне надо, чтобы ты дала мне свою частицу, Кезай».~
@41073 = ~«Всё хорошо… можешь больше мне ничего не говорить. Счастливо, Кезай».~
@41074 = ~«Говорят, её магия переходила пределы всего, что можно себе представить. Это были образы, сотканные из кошмара и материи. Камень гнулся перед её волей, словно глина; законы планов пали бы перед ней, и из ничего она творила иллюзии… а из иллюзий сплеталась реальность, которая могла убивать, ужасать и превращать в ничто».~
@41075 = ~«Продолжай…»~
@41076 = ~«Мне надо, чтобы ты дала мне свою частицу, Кезай».~
@41077 = ~«Всё хорошо… можешь больше мне ничего не говорить. Счастливо, Кезай».~
@41078 = ~«Она была повелительницей всех Тёмных Искусств, повелительницей и великим мастером. Она натравила теней на Старейшину, который осмелился прочесть ей отрывок из законов Сигила. Они сожрали его всего, кроме языка, пальцев и плоти лица. Она наизнанку вывернула Убийц Милосердия и разрушила дома тех, кто ей не угодил. Её слову подчинялась ужасная, ужасная сила».~
@41079 = ~«Продолжай…»~
@41080 = ~«Мне надо, чтобы ты дала мне свою частицу, Кезай».~
@41081 = ~«Всё хорошо… можешь больше мне ничего не говорить. Счастливо, Кезай».~
@41082 = ~«Она могла изменять свою форму, словно вода, и пользовалась этим для развлечения и кражи знаний. Она была монстром, как и всё, что выходило из Серой Пустоши».~
@41083 = ~«Продолжай…»~
@41084 = ~«Мне надо, чтобы ты дала мне свою частицу, Кезай».~
@41085 = ~«Всё хорошо… можешь больше мне ничего не говорить. Счастливо, Кезай».~
@41086 = ~«Наконец, она грозилась открыть Клетку и позволить ярости планов пройтись по городу, подобно волне. К счастью, она не преуспела. Она существовала лишь для зла…»~
@41087 = ~«Продолжай…»~
@41088 = ~«Мне надо, чтобы ты дала мне свою частицу, Кезай».~
@41089 = ~«Всё хорошо… можешь больше мне ничего не говорить. Счастливо, Кезай».~
@41090 = ~«Я не знаю, мертва ли она… но теперь точно знаю, что она была моей матерью, — Кезай сутулится, голова её поникает. — О, если бы у меня были слёзы, чтобы излить свою печаль!»~
@41091 = ~Попробовать утешить её.~
@41092 = ~Попробовать утешить её.~
@41093 = ~Попробовать утешить её.~
@41094 = ~«Мне надо, чтобы ты дала мне свою частицу, Кезай».~
@41095 = ~«Не волнуйся об этом, Кезай, ты совершенно непохожа на Рейвел. Счастливо».~
@41096 = ~Она встревожено смотрит на тебя: «Прости?»~
@41097 = ~«Ключ к порталу в лабиринт Рейвел — кусочек её самой, а у тебя её кровь. Вполне подходит».~
@41098 = ~«Неважно. Прощай».~
@41099 = ~«Просто… просто оставь меня. Я буду в порядке. Мне просто нужно время подумать об этом, вот и всё».~
@41100 = ~«Хорошо, но… мне нужна твоя частица».~
@41101 = ~«Не волнуйся об этом, Кезай, ты совершенно непохожа на Рейвел. Счастливо».~
@41102 = ~«Спасибо… спасибо за попытку… со мной всё будет в порядке. Мне просто нужно время подумать об этом, вот и всё».~
@41103 = ~«Не хотел бы об этом говорить сейчас… но мне очень нужна твоя частица, Кезай».~
@41104 = ~«Не волнуйся об этом, Кезай, ты совершенно непохожа на Рейвел. Счастливо».~
@41105 = ~Внезапно она падает в твои объятия, её тело сотрясается в беззвучных рыданиях. Некоторое время Кезай просто стоит, вцепившись в тебя… но потом так же внезапно отстраняется: «Спасибо, но… со мной всё будет в порядке. Мне просто нужно время подумать, вот и всё».~
@41106 = ~«Не хотел бы об этом говорить сейчас… но мне очень нужна твоя частица, Кезай».~
@41107 = ~«Не волнуйся об этом, Кезай, ты совершенно непохожа на Рейвел. Счастливо».~
@41108 = ~Кезай проглатывает комок. «Ты намерен её найти? — удивление сменяется опаской. — Что… что тебе надо от меня?»~
@41109 = ~«Лучше всего кровь. Капля или две, этого вполне хватит».~
@41110 = ~Она кивает: «Но… как ты её возьмёшь с собой? У тебя есть кусок ткани, что-нибудь вроде носового платка?»~
@41111 = ~«Да… вот…»~
@41112 = ~«Нет».~
@41113 = ~Кезай берёт платок и осторожно прокусывает клыком кончик пальца. Дав нескольким каплям крови впитаться в платок, она возвращает его тебе: «Знаешь, а ведь ты подвергаешь себя опасности. Даже если истории о моей матери сильно преувеличены, всё равно она ужасно сильна и она — абсолютное зло. Удачи тебе».~
@41114 = ~«Да, мне уже говорили. Спасибо и прощай».~
@41115 = ~Кезай вздыхает и оглядывается: «Думаю, где-нибудь в Борделе хоть один найдётся. Принеси его мне, когда найдёшь, ладно? Тогда я дам тебе крови».~
@41116 = ~«Хорошо, я вернусь с платком. До встречи».~
@41117 = ~Когда ты подходишь, Кезай-Серрис тепло улыбается, убирая завиток волос со своих ярких алых глаз: «Что ж, снова приветствую… что я могу для тебя сделать, м-м?»~
@41118 = ~«Кезай? Ты дочь Рейвел?»~
@41119 = ~«Зависит от того… что ты обычно делаешь».~
@41120 = ~«У меня кое-какие вопросы…»~
@41121 = ~«Спасибо, ничего. Прощай».~
@41122 = ~Когда ты подходишь, Кезай-Серрис тепло улыбается, убирая завиток волос со своих ярких алых глаз: «Не волнуйся, я не умею долго расстраиваться. Что я могу для тебя сделать, м-м?»~
@41123 = ~«Кезай? Ты дочь Рейвел?»~
@41124 = ~«Зависит от того… что ты обычно делаешь».~
@41125 = ~«У меня кое-какие вопросы…»~
@41126 = ~«Спасибо, ничего. Прощай».~
@41127 = ~Когда ты подходишь, Кезай-Серрис тепло улыбается, убирая завиток волос со своих ярких алых глаз: «Что ж, снова приветствую… могу я что-нибудь для тебя сделать, м-м?»~
@41128 = ~«Да… я принёс платок…»~
@41129 = ~«Зависит от того… что ты обычно делаешь».~
@41130 = ~«У меня кое-какие вопросы…»~
@41131 = ~«Спасибо, ничего не нужно. Прощай».~
@41132 = ~«Да, это Экко. Она такая милая, но не разговаривает. Похоже, однажды она сказала что-то такое, что послужило причиной трагедии… и поэтому никогда не заговорит снова, — Кезай пожимает плечами и улыбается. — Довольно интересная история, хоть я и не знаю, правда ли это. Попробуй спросить Долору… я видела, как она разговаривала с бывшим любовником Экко ещё в те времена, когда Экко говорила».~
@41133 = ~«У меня другой вопрос…»~
@41134 = ~«Это всё, что я хотел узнать. Прощай».~
@41135 = ~«Что угодно! — выкрикивает Морте. — Можешь делать со мной что угодно!»~
@41136 = ~«Я прям рыдаю… где ты была, девочка, когда у меня было *тело*?!»~
@41137 = ~«Тьфу, — Анна ухмыляется, закатывая глаза. — Идиот».~
@41138 = ~Не обращать внимания на комментарии Анны.~
@41139 = ~«Не обращай внимания, Кезай».~
@41140 = ~«Анна, прошу тебя… это всего лишь комплимент».~
@41141 = ~«Не огорчайся, Анна… ты ничем не хуже».~
@41142 = ~Анна холодно на тебя смотрит, но ничего не говорит.~
@41143 = ~«И чё ты *этим* хотел сказать, бабник хренов?! Ты чё, думаешь, я *ревную* к этой болтливой девке? Придурок!» — Анна плюёт и отворачиватся.~
@41144 = ~«Тс-с-с… небольшой совет, шеф. Я бы вёл себя здесь тихо — без необходимости не стоит записывать лишние трупы в книгу мёртвых… особенно женские. К тому же их убийство может привлечь здешних смотрителей».~
@41145 = ~«Не помню, чтобы ты упоминал об этом раньше… *кто* такие эти смотрители?»~
@41146 = ~«Эти трупы… откуда они все взялись?»~
@41147 = ~«Почему тебя так заботят женские трупы?»~
@41148 = ~«Ладно… я… постараюсь не забыть».~
@41149 = ~«Они называют себя „Пыльными“. Их невозможно не узнать: это такие ребята в сером с лицами как у покойников. Толпа мерзких поклонников смерти с промытыми мозгами: они верят, что все должны умереть… и чем раньше, тем лучше».~
@41150 = ~«Странно… какое Пыльным дело до того, что я отсюда сбегу?»~
@41151 = ~«Ты чё, не слушаешь меня, а? Пыльные считают, что ВСЕ должны умереть, и лучше раньше, чем позже. Как думаешь, трупам веселее быть в книге мёртвых или вне её?»~
@41152 = ~«А трупы, которые здесь есть… откуда они все взялись?»~
@41153 = ~«Ты вроде упоминал, что мне не стоит вредить *женским* трупам. Почему?»~
@41154 = ~«Ладно… я… постараюсь не забыть».~
@41155 = ~«Смерть посещает планы каждый день, шеф. Эти увальни — всё, что осталось от тех несчастных, которые продали свои тела смотрителям после смерти».~
@41156 = ~«Просвети меня… *кто* эти смотрители?»~
@41157 = ~«Ты вроде упоминал, что мне не стоит вредить *женским* трупам. Почему?»~
@41158 = ~«Ладно… я… постараюсь не забыть».~
@41159 = ~«Чт?.. Ты *серьёзно*? Слушай, шеф, эти девки — последний шанс для пары крутых парней вроде нас. Мы должны быть *галантными*… не кромсать их ради ключей, не разбирать на органы и всё такое».~
@41160 = ~«Последний шанс? Ты вообще *о чём* говоришь?»~
@41161 = ~«Шеф, ОНИ померли, и МЫ тоже мертвы… ясно, куда я клоню? А? А?»~
@41162 = ~«Нет… вообще-то, нет».~
@41163 = ~«Надеюсь, ты не *всерьёз*?»~
@41164 = ~«Шеф, у нас тут шикарная возможность наметилась с этими хромающими дамами. В конце концов, мы *все* хоть раз были мертвы, так? Нам есть о чём порассказать, а эти девушки просто обожают парней с таким опытом смерти, как у нас».~
@41165 = ~«Погоди… разве не ты говорил минуту назад, что я *не* мёртв?»~
@41166 = ~«Ну ладно, ладно. Может, *ты* и не помер, шеф, но *я* — уж наверняка. И пока я здесь, не отказался бы разделить гробик, например, вон с той штучкой, которая маленько посвежее, — Морте пощёлкивает челюстями в предвкушении. — Конечно, тут приоритет принадлежит местным смотрителям, но непохоже…»~
@41167 = ~«А напомни-ка мне, кто эти смотрители?»~
@41168 = ~«Но откуда появились все эти трупы?»~
@41169 = ~«Хорошо… постараюсь не забыть».~
@41170 = ~«Послушай, шеф. Очевидно, что после твоего последнего танца со смертью ты немного сбит с толку… так что у меня для тебя два совета: во-первых, если у тебя есть вопросы — *задавай* их, ладно?»

^NПРИМЕЧАНИЕ. <SPEAKTO>^-~
@41171 = ~«Ладно… если будут вопросы, я тебя спрошу».~
@41172 = ~«Во-вторых, если ты хоть *наполовину* такой забывчивый, каким кажешься, — начни вести записи. Как только тебе попадётся то, что *может* оказаться важным, запиши это, чтобы не забыть».~
@41173 = ~«Если бы у меня был тот дневник, которому *полагалось* быть, я бы так и делал».~
@41174 = ~«Ну так заведи новый, шеф. Ничего ещё не потеряно. Тут полно чернил и пергамента, так что можно взять… попользоваться».~
@41175 = ~«Хм-м. Ладно. Хуже от этого не будет… заведу новый».~
@41176 = ~«Записывай в него все свои перемещения. Если ты когда-нибудь начнёшь забывать важные вещи, навроде того, кто ты такой, или, что более важно, кто *я* такой… всегда сможешь освежить память».

^NПРИМЕЧАНИЕ. Чтобы воспользоваться дневником, нужно нажать кнопку дневника в быстром меню. Дневник обновляется автоматически в процессе игры.^-~
@41177 = ~«Хорошо… понял. Пошли».~
@41178 = ~«Что тебя гложет, шеф?»~
@41179 = ~«Можешь ещё раз прочитать, что вытатуировано у меня на спине?»~
@41180 = ~«Напомни, что это за место?»~
@41181 = ~«Это здание просто огромно… кто за ним присматривает?»~
@41182 = ~«Повтори ещё раз, кто смотрители этого места?»~
@41183 = ~«Эти трупы… откуда они все взялись?»~
@41184 = ~«Ты вроде упоминал, что мне не стоит вредить *женским* трупам. Почему?»~
@41185 = ~«Как мне использовать эти бинты?»~
@41186 = ~«Прямо сейчас ничего, Морте. Просто проверял, со мной ли ты ещё».~
@41187 = ~«Прямо сейчас ничего, Морте. Просто проверял, со мной ли ты ещё».~
@41188 = ~«Кхм, *да ладно*, шеф. Только не говори, что ты уже всё забыл».~
@41189 = ~«Мне просто надо освежить память, вот и всё».~
@41190 = ~«Неважно. У меня другие вопросы…»~
@41191 = ~«Ладно, забудь. Пойдём».~
@41192 = ~«Ладно, забудь. Пойдём».~
@41193 = ~«Готов поспорить, мне придётся слышать ЭТО много раз, — Морте кашляет, делая вид, что прочищает горло. — Та-ак, посмотрим…

„Я знаю, ты чувствуешь себя так, будто нахлебался мутных вод Стикса, но тебе нужно СОБРАТЬСЯ. Среди твоих вещей должен быть ДНЕВНИК, который прольёт немного света на это тёмное дело. ФАРОД расскажет тебе оставшуюся часть истории, если, конечно, он ещё не попал в книгу мёртвых“».~
@41194 = ~«Фарод… хм-м-м. Продолжай».~
@41195 = ~«Неважно. У меня другие вопросы…»~
@41196 = ~«Ладно. Я уже всё вспомнил. Пошли».~
@41197 = ~«Ладно. Я уже всё вспомнил. Пошли».~
@41198 = ~«Сейчас-сейчас, погоди, — Морте на секунду останавливается. — Ага, вот он, последний кусок…

„Не потеряй свой дневник, иначе мы снова погрузимся в воды Стикса. И что бы ты ни делал, НИКОГДА никому НЕ говори, КТО ты или ЧТО с тобой случилось, а то они устроят тебе скорое паломничество в крематорий. Делай, как я говорю: ПРОЧТИ дневник, а потом НАЙДИ Фарода“».~
@41199 = ~«А когда я очнулся, со мной не было дневника?»~
@41200 = ~«Неважно. У меня другие вопросы…»~
@41201 = ~«Ладно. Я уже всё вспомнил. Пошли».~
@41202 = ~«Нет… ты был раздет полостью. Как я уже говорил, похоже, тебе придётся обойтись тем дневником, что у тебя на спине».~
@41203 = ~«Ладно. Я уже всё вспомнил. Пошли».~
@41204 = ~«И ты точно не знаешь никого по имени Фарод?»~
@41205 = ~«И верно. У меня другие вопросы…»~
@41206 = ~«Ну ладно, пошли».~
@41207 = ~«Ну ладно, пошли».~
@41208 = ~«Не-а. Хотя, какой-нибудь пень должен знать, где его можно найти. Можно поспрашивать… ПОСЛЕ того, как выберемся отсюда».~
@41209 = ~«Прежде чем мы тронемся, я хотел бы ещё кое-что спросить…»~
@41210 = ~«Ну ладно, пошли».~
@41211 = ~«Ну ладно, пошли».~
@41212 = ~«Оно называется „Мортуарий“… большое чёрное сооружение с архитектурным очарованием беременной паучихи».~
@41213 = ~«Уяснил. У меня другие вопросы…»~
@41214 = ~«Это всё, что я хотел знать. Спасибо».~
@41215 = ~«Это всё, что я хотел знать. Спасибо».~
@41216 = ~«Они называют себя „Пыльными“. Их невозможно не узнать: это такие ребята в сером с лицами как у покойников. Толпа мерзких поклонников смерти с промытыми мозгами: они верят, что все должны умереть… и чем раньше, тем лучше».~
@41217 = ~«Странно… какое Пыльным дело до того, что я отсюда сбегу?»~
@41218 = ~«Уяснил. У меня другие вопросы…»~
@41219 = ~«Понятно. Буду осторожен».~
@41220 = ~«Понятно. Буду осторожен».~
@41221 = ~«Ты чё, не слушаешь меня, а? Пыльные считают, что ВСЕ должны умереть, и лучше раньше, чем позже. Как думаешь, трупам веселее быть в книге мёртвых или вне её?»~
@41222 = ~«Уяснил. У меня другие вопросы…»~
@41223 = ~«Ладно… я… постараюсь не забыть».~
@41224 = ~«Ладно… я… постараюсь не забыть».~
@41225 = ~«Ну так… просто *используй* их. От потери крови помогает и вообще».

^NПРИМЕЧАНИЕ. <BANDAGES2>^-~
@41226 = ~«Уяснил. У меня другие вопросы…»~
@41227 = ~«Спасибо. Думаю, что смогу с этим справиться».~
@41228 = ~«Спасибо. Думаю, что смогу с этим справиться».~
@41229 = ~«Смерть посещает планы каждый день, шеф. Эти увальни — всё, что осталось от тех несчастных, которые продали свои тела смотрителям после смерти».~
@41230 = ~«Уяснил. У меня другие вопросы…»~
@41231 = ~«Ладно… я… постараюсь не забыть».~
@41232 = ~«Ладно… я… постараюсь не забыть».~
@41233 = ~«Чт?.. Ты *серьёзно*? Слушай, шеф, эти девки — последний шанс для пары крутых парней вроде нас. Мы должны быть *галантными*… не кромсать их ради ключей, не разбирать на органы и всё такое».~
@41234 = ~«Последний шанс? Ты вообще *о чём* говоришь?»~
@41235 = ~«Неважно, у меня есть ещё несколько вопросов…»~
@41236 = ~«Ладно… я… постараюсь не забыть».~
@41237 = ~«Шеф, ОНИ померли, и МЫ тоже мертвы… ясно, куда я клоню? А? А?»~
@41238 = ~«Нет… вообще-то, нет».~
@41239 = ~«Надеюсь, ты не *всерьёз*?»~
@41240 = ~«Неважно, у меня есть ещё несколько вопросов…»~
@41241 = ~«Я уже достаточно услышал. Пошли».~
@41242 = ~«Шеф, у нас тут шикарная возможность наметилась с этими хромающими дамами. В конце концов, мы *все* хоть раз были мертвы, так? Нам есть о чём порассказать, а эти девушки просто обожают парней с таким опытом смерти, как у нас».~
@41243 = ~«Погоди… разве не ты говорил минуту назад, что я *не* мёртв?»~
@41244 = ~«Неважно, у меня есть ещё несколько вопросов…»~
@41245 = ~«Я уже достаточно услышал. Пошли».~
@41246 = ~«Ну ладно, ладно. Может, *ты* и не помер, шеф, но *я* — уж наверняка. И пока я здесь, не отказался бы разделить гробик, например, вон с той штучкой, которая маленько посвежее, — Морте пощёлкивает челюстями в предвкушении. — Конечно, тут приоритет принадлежит местным смотрителям, но непохоже…»~
@41247 = ~«У меня к тебе есть другие вопросы, Морте…»~
@41248 = ~«Я уже достаточно услышал. Пошли».~
@41249 = ~«Димтри, ты слышишь? Я вроде с тобой разговариваю».~
@41250 = ~«Я знал, что ты вернёшься, шеф! Наконец понял, что я тебе нужен, а?»~
@41251 = ~«Да… пошли».~
@41252 = ~«Не сейчас, Морте».~
@41253 = ~«Пф. Что ж, не знаю, как долго я ещё буду здесь ждать, так что даю тебе один ПОСЛЕДНИЙ шанс. Ты точно уверен, что тебе не нужны мой быстрый ум и мудрые советы?»~
@41254 = ~«Морте, но у тебя же нет НИ того, НИ другого».~
@41255 = ~«Ну хорошо, я передумал. Идём».~
@41256 = ~«Не сейчас, Морте. Возможно, позже».~
@41257 = ~«Пытаешься меня обидеть, шеф? Я что-то не так сказал? Или это из-за отсутствия у меня рук? В чём же дело?»~
@41258 = ~«Ну хорошо, я передумал. Идём».~
@41259 = ~«Дело вовсе не в этом. Просто прямо сейчас мне не нужна твоя компания. Прощай, Морте».~
@41260 = ~«Ну что ж, я не собираюсь ждать ВЕЧНО, так что лучше бы тебе поскорее вернуться, если передумаешь».~
@41261 = ~«Так и сделаю. Прощай, Морте».~
@41262 = ~«Силы всевышние. Да тут просто весь АД в одной книге».~
@41263 = ~«Что это?»~
@41264 = ~«Попробую угадать… думаю, это книга, в которую они записывают имена всех несчастных доходяг, попадающих сюда».~
@41265 = ~«А моё имя там может быть?»~
@41266 = ~«Э-э… ну… *возможно*. Чтобы узнать наверняка, тебе надо бы потрещать шкатулкой с этим летучим Пыльным. Правда, по-моему, это не очень хорошая идея».~
@41267 = ~«Ну, мне нужны ответы. Так что я пойду поговорю с ним».~
@41268 = ~«Что-то ты сегодня очень тихий, Димтри!»~
@41269 = ~«Наверно, это самый красивый гроб из всех, что я делал, да, Димтри?»~
@41270 = ~«Ты лучший друг на свете, Димтри».~
@41271 = ~к мудрости получено за счёт специализации.~
@41272 = ~к удаче получено за счёт специализации.~
@41273 = ~к телосложению получено за счёт специализации.~
@41274 = ~к силе получено за счёт специализации.~
@41275 = ~Нет~
@41276 = ~к ловкости получено за счёт специализации.~
@41277 = ~<GAMEDAYS> день (дней) и <HOUR> часа (ов).~
@41278 = ~Время, проведённое в группе:~
@41279 = ~Любимое заклинание:~
@41280 = ~Любимое оружие:~
@41281 = ~Всего убито:~
@41282 = ~Голос женщины — мягкий, спокойный, без интонаций — создаёт отчётливое чувство «отдалённости», он словно ей не принадлежит: «Приветствую… меня называют Долора. Могу я чем-то служить?»~
@41283 = ~Она моргает и прикладывает руку к сердцу, слегка склонив голову: «Я могу достаточно квалифицировано дискутировать на любые научные и просто учёные темы, если пожелаете. Также я хорошо разбираюсь в стратегических играх. Если вы хотите во что-либо сыграть — у меня есть принадлежности для некоторых таких игр».~
@41284 = ~Долора не кажется ни заинтригованной, ни поражённой и отвечает тем же тоном: «Тогда вы ошиблись насчёт назначения этого заведения: Бордель удовлетворяет желания в области мозга, а не в области поясницы. В любом случае могу заверить: партнёром я была бы самым что ни на есть неудовлетворительным».~
@41285 = ~«Просто такова моя природа. Позвольте мне продемонстрировать», — она тянется к твоей руке…~
@41286 = ~Долора проводит по твоему предплечью тыльной стороной своей ладони, её кожа — гладкая и сухая, но холодна, как сталь. От этого прикосновения по твоей коже бегут мурашки, а волосы на руке встают дыбом. «Не пытайтесь меня спрашивать, кто я такая, поскольку отвечу я то же самое: такова моя природа».~
@41287 = ~Ты отдёргиваешь руку, прежде чем она успевает до неё дотронуться. «Да будет так. Я просто хотела проиллюстрировать своё утверждение, я бы не причинила вам вреда».~
@41288 = ~Долора кивает: «Верно. Я не книга, не учитель и не стремлюсь чему-либо научить моих клиентов. Но если у вас есть стоящая тема для обсуждения, например… пятнадцать фракций и их влияние на сигильскую политику, наиболее эффективные боевые стратегии для завоевания Ахерона, смысл самого существования… тогда я буду рада избрать противоположную точку зрения и принять участие в дискуссии».~
@41289 = ~Всего за пару минут разговора Долора с лёгкостью разбивает все твои аргументы. Её контраргументы отметают все твои жалкие попытки защитить свою позицию, кажущуюся теперь такой наивной. При этом она не проявляет никакого видимого наслаждения от своих побед и просто предлагает: «Если хотите, мы можем снова обсудить ту же тему… в этот раз я могу защищать вашу точку зрения, если пожелаете».~
@41290 = ~Долора кивает: «Мадам Грейс дала мне инструкции не жалеть никого, а другой ученице — наоборот, позволять клиенту победить после долгих дебатов. Таково было желанием мадам Грейс, чтобы я предоставляла клиентам опыт иного рода».~
@41291 = ~Ты пытаешься изо всех сил, но тщетно: Долора легко и непринуждённо разбивает все твои аргументы своей железной логикой. При этом она не проявляет никакого видимого наслаждения от своих побед и просто предлагает: «Если хотите, мы можем снова обсудить ту же тему… в этот раз я могу защищать вашу точку зрения, если пожелаете».~
@41292 = ~Ты выбираешь тему, и вы начинаете. Сперва ты неплохо держишься… но твои позиции становятся всё слабее и слабее по мере того, как Долора разбивает один твой аргумент за другим своей железной логикой. При этом она не проявляет никакого видимого наслаждения от своих побед и просто предлагает: «Если хотите, мы можем снова обсудить ту же тему… в этот раз я могу защищать вашу точку зрения, если пожелаете».~
@41293 = ~Ты выбираешь тему, и вы начинаете… дебаты длятся долго, вы обмениваетесь аргументами и контраргументами, методично пытаясь найти слабое место в чужой позиции. В ходе разговора у тебя появляется странное чувство… воспоминание, всплывающее на поверхность…~
@41294 = ~Несмотря на твоё отчаянное сопротивление, у Долоры в конечном итоге получается одержать верх в споре… её железная логика сминает твою самую блестящую аргументацию. При этом никакой радости от победы она не проявляет, просто кивает в знак одобрения: «Вы — один из самых искусных полемистов, отрицать это невозможно. Я чувствую, что, имей вы время для раздумий, я бы вас не превзошла».~
@41295 = ~Долора кивает: «Если хотите, мы можем снова обсудить ту же тему… в этот раз я могу защищать вашу точку зрения, если пожелаете».~
@41296 = ~Ты выбираешь тему, и вы начинаете… дискуссия затягивается, вы обмениваетесь аргументами и контраргументами, методично пытаясь подорвать позицию оппонента. Несмотря на твоё отчаянное сопротивление, у Долоры в конечном итоге получается одержать верх в споре… её железная логика сминает твою самую блестящую аргументацию. При этом никакой радости от победы она не проявляет, просто кивает в знак одобрения: «Вы — один из самых искусных полемистов, отрицать это невозможно. Я чувствую, что, имей вы время для раздумий, я бы вас не превзошла».~
@41297 = ~Ты выбираешь тему, и вы начинаете… дебаты длятся долго, вы обмениваетесь аргументами и контраргументами, методично пытаясь найти слабое место в чужой позиции. В ходе разговора у тебя появляется странное чувство… воспоминание, всплывающее на поверхность…~
@41298 = ~В конечном итоге тебе удаётся переспорить Долору, несмотря на её отчаянное сопротивление и железную логику. Она просто кивает в знак одобрения: «Вы — один из самых искусных полемистов, отрицать это невозможно. Но я чувствую, что, имей я время для раздумий, вам не удалось бы меня превзойти».~
@41299 = ~Ты выбираешь тему, и вы начинаете… дискуссия затягивается, вы обмениваетесь аргументами и контраргументами, методично пытаясь подорвать позицию оппонента. В конечном итоге тебе удаётся переспорить Долору, несмотря на её отчаянное сопротивление и железную логику. Она просто кивает в знак одобрения: «Вы — один из самых искусных полемистов, отрицать это невозможно. Но я чувствую, что, имей я время для раздумий, вам не удалось бы меня превзойти».~
@41300 = ~«Конечно. Есть что-то конкретное, во что вы желаете сыграть?»~
@41301 = ~«Вот, позвольте показать вам одну», — Долора достаёт тонкую лакированную коробочку, которая раскрывается в небольшую доску, расчерченную квадратами. В коробочке лежат полированные каменные фигурки… половина из них белая, половина — чёрная. «У этой игры множество имён. Должна ли я объяснить правила?»~
@41302 = ~Долора объясняет тебе правила игры: как перемещаются фигуры, каковы условия выигрыша. Чем-то игра кажется тебе неуловимо знакомой. «Правила просты, не так ли? Но в самой игре заключена большая сложность. Нужно много времени для практики. Ну что, сыграем?»~
@41303 = ~Несмотря на твою уверенность в том, что ты играл раньше, результаты неважные… Долора выигрывает очень быстро и с такой лёгкостью, что это даже смешно. Однако она не показывает ни тени улыбки или злорадства, просто спокойно убирает доску со стола: «Боюсь, ни время, ни практика вам не помогут: похоже, вы просто не улавливаете суть подобных игр».~
@41304 = ~Долора кивает: «Мадам Грейс дала мне инструкции не подыгрывать, в то время как другая её ученица будет всегда оставлять противникам надежду на победу. Таково было желание мадам Грейс, чтобы я предоставляла клиентам опыт иного рода — скорее настоящее испытание, чем приятное утешение для самолюбия».~
@41305 = ~Несмотря на твою уверенность в том, что ты играл раньше, Долора легко выигрывает. Однако она не показывает ни тени улыбки или злорадства, просто спокойно убирает доску со стола: «Похоже, вы неплохо поняли суть игры. И со временем можете стать искусным игроком».~
@41306 = ~По ходу игры ты понимаешь, что явно играл в неё раньше. Но даже лучшие твои комбинации не выдерживают напор стратегического гения Долоры… положение постепенно становиться всё хуже и хуже, пока ты не терпишь окончательное поражение. Однако она не показывает ни тени улыбки или злорадства, просто спокойно убирает доску со стола: «Вы глубоко проникли в суть игры. Со временем вы можете стать одним из лучших».~
@41307 = ~Доля убийств группы:~
@41308 = ~Доля опыта группы:~
@41309 = ~~
@41310 = ~По ходу игры ты понимаешь, что явно играл в неё раньше. Ты вспоминаешь различные уловки и стратегии, которые помогали тебе в прошлом, опробуешь ради победы все известные тебе хитрости. Внезапно тебя посещает странное чувство… воспоминание, всплывающее на поверхность…~
@41311 = ~Всю игру Долора одну за одной блокирует все твои комбинации, кроме разве самых хитрых. Несмотря на все твои усилия, в конце концов ты проигрываешь её холодной, расчётливой стратегии. Однако она не показывает ни тени улыбки или злорадства, просто спокойно убирает доску со стола: «Вы блестяще играете. Уверена, со временем вы можете стать настоящим мастером».~
@41312 = ~По ходу игры ты понимаешь, что явно играл в неё раньше. Ты вспоминаешь различные стратегии ведения игры, опробуешь все ходы и приёмы, которые помогали тебе в прошлом. Но Долора по-прежнему одну за одной блокирует все твои комбинации, кроме разве самых хитрых. Несмотря на все твои усилия, в конце концов ты проигрываешь её холодной, расчётливой стратегии. Однако она не показывает ни тени улыбки или злорадства, просто спокойно убирает доску со стола. «Вы блестяще играете. Уверена, со временем вы можете стать настоящим мастером».~
@41313 = ~По ходу игры ты понимаешь, что явно играл в неё раньше. Ты вспоминаешь различные уловки и стратегии, которые помогали тебе в прошлом, опробуешь ради победы все известные тебе хитрости. Внезапно тебя посещает странное чувство… воспоминание, всплывающее на поверхность…~
@41314 = ~Долора играет великолепно, блокирует все твои комбинации, кроме разве самых хитрых, но в конечном итоге твои ложные атаки и досконально просчитанные манёвры превосходят её умело выстроенную стратегию. Она одобрительно кивает и убирает доску: «Вы блестящий игрок, я бы даже сказала — мастер. Я высоко оцениваю ваше умение».~
@41315 = ~По ходу игры ты понимаешь, что явно играл в неё раньше. Ты вспоминаешь различные стратегии ведения игры, опробуешь все ходы и приёмы, которые помогали тебе в прошлом. Долора играет великолепно, блокирует все твои комбинации, кроме разве самых хитрых, но в конечном итоге твои ложные атаки и досконально просчитанные манёвры превосходят её умело выстроенную стратегию. Она одобрительно кивает и убирает доску: «Вы блестящий игрок, я бы даже сказала — мастер. Я высоко оцениваю ваше умение».~
@41316 = ~Долора опускает глаза и издаёт звук, который можно принять за печальный вздох: «Я могу обслужить вас как клиента, но не хочу в настоящий момент отвечать на ваши вопросы… приношу свои извинения, но вам лучше смириться с этим на некоторое время».~
@41317 = ~Она поднимает глаза и встречается с твоими. И снова тебя поражает её гладкая бледная кожа и холодная глубина её серебристых глаз. «Нет… нет, боюсь, что нет. Мои проблемы носят личный характер. Думаю, в своё время всё придёт в норму».~
@41318 = ~«Уверена? — Долора замолкает, словно задумалась. — Нет. Моя первая любовь, Весельчак, по-прежнему владеет ключами к моему сердцу. И пока он ими владеет, я не могу полюбить другого. Это и является причиной моей меланхолии».~
@41319 = ~Долора качает головой: «Я не могу покидать это место. Причины этого глубоко личные, и я не намерена делиться ими с незнакомцем, даже с тем, кто был добр ко мне. Достаточно сказать, что сама отыскать Весельчака я не в силах».~
@41320 = ~Долора кивает, лёгкий намёк на улыбку появляется на её губах. Она слегка склоняет голову: «Если вы отыщете и побеседуете с Весельчаком, я буду вам необычайно признательна. Он один из членов Общества Восприятия, так что вы можете спросить о нём в Фестхолле».~
@41321 = ~«Я владею несколькими ювелирными украшениями, которые мне однажды подарили. Если этого достаточно, то я охотно вознагражу вас ими. Весельчак — член Общества Восприятия, так что вы можете спросить о нём в Фестхолле».~
@41322 = ~Холодные стальные глаза Долоры при твоём появлении на мгновение вспыхивают: «Приветствую. Могу я чем-то служить?»~
@41323 = ~При виде тебя глаза Долоры вспыхивают: «Вы нашли его? Он согласился вернуть ключи от моего сердца?»~
@41324 = ~Мгновение Долора молча смотрит на тебя. «Где они?»~
@41325 = ~«Наконец-то… — когда она берёт ключи из твоих рук, её рука касается твоей… её кожа сухая, но холодная на ощупь, словно сталь. — Это мне очень поможет. Благодарю вас».~
@41326 = ~Долора кивает и достаёт пару браслетов из сумочки на боку: «Теперь они ваши, вы их заслужили».~
@41327 = ~При виде тебя глаза Долоры вспыхивают: «Ключи от моего сердца… вы нашли то, что потеряли?»~
@41328 = ~«Разумеется. Я отвечу, на что смогу».~
@41329 = ~Долора моргает: «Весельчак никогда не рассказывал мне о моей конструкции. Я знаю о внутреннем устройстве своего тела так же мало, как вы — об устройстве своего. Внешне я обычная женщина во всех отношениях… кроме фактуры и температуры кожи. Это удовлетворило ваше любопытство?»~
@41330 = ~«Для меня их работа такая же загадка, как и для большинства людей. Когда я очутилась в этом месте, я не только не понимала эмоций, но и не имела своих собственных. А теперь у меня есть… чувства… хотя я ещё только начинаю их понимать».~
@41331 = ~«Я могу лишь предположить, что Весельчак создал ключи для предотвращения моего побега до конца его эксперимента. Теперь, когда они у меня, я свободна развиваться и обзаводиться собственными эмоциями».~
@41332 = ~«Я, как и остальные женщины здесь, ученица мадам Грейс. Она обучает нас способам ведения диалога и вербальному общению. Начав своё обучение с подготовки к ритуалам инициации, большинство учениц продолжат свою деятельность, став членами Общества Восприятия».~
@41333 = ~«Я много учусь. Это мне нравится, да», — на мгновение она улыбается, выражение бледного лица при этом кажется неловким, словно для неё это что-то чуждое.~
@41334 = ~«Лучше всего поискать ответы на такие вопросы у мадам Грейс. Она разъяснит вам гораздо лучше, чем смогу я».~
@41335 = ~«Да, могу. Бордель Безумной Интеллектуальной Страсти — это школа, проститутки в ней обучаются искусству ведения диалога и вербальному общению. Я бы порекомендовала обратиться к владелице учреждения, мадам Грейс, если вам требуется более детальное объяснение».~
@41336 = ~«Я предполагаю, что вы имеете в виду её „личный аромат“, который, по её утверждению, был у неё украден одной из местных проституток. Я не знаю, у кого он сейчас находится. Однако вы можете спросить об этом Ненни, поскольку она видит многое из того, что здесь происходит».~
@41337 = ~«Вивьен использует некоторые аспекты Искусства, чтобы создавать, изменять и улучшать обонятельные свойства объектов, живых или мёртвых. Возможно, похититель также знает какие-то секреты этого мастерства. Однако её аромат должен находиться на объекте, а не на похитителе, иначе Вивьен узнала бы того по запаху».~
@41338 = ~Долора качает головой: «Я не видела вуаль Мариссы с тех пор, как она последний раз выходила в ней из своей комнаты. Это было какое-то время тому назад». Она на секунду закрывает глаза, затем продолжает: «Ненни видит многое из того, что здесь происходит. Вы поступите правильно, если поговорите с ней о тех вещах, которые вас интересуют».~
@41339 = ~«Я знаю, что она являлась — или является, если она всё ещё жива, — ведьмой огромной силы и абсолютного зла. Госпожа Боли изгнала её в межпространственную тюрьму за преступления, совершённые против города Сигила. Будет лучше, если вы поговорите с Ивес: она знает великое множество историй и, скорее всего, сможет рассказать вам и о Рейвел».~
@41340 = ~В твоей голове начинает формироваться образ огромного зала… обширное пространство, заполненное элитой общества в дорогих одеждах… идёт официальный приём. Перед тобой стоит безупречно одетый коротышка, на шее у него висит золотой медальон, украшенный символом, который ты смутно припоминаешь как «Знак Одного». Вы оба стоите в кругу зрителей, которые следят за дебатами.~
@41341 = ~«Но… но это невозможно!» — говорит человечек, вид у него при этом озадаченный.

«О, но это так, — вспоминаешь ты свой ответ. — Я привёл несколько бесспорных утверждений и множество примеров. Вы просто не существуете».

«Но… вы не можете! Если я это допущу, то… то…»~
@41342 = ~«Да. Вы прекратите существовать».

И безо всякой вспышки, без звука и дыма — вообще без какого-либо сопровождения — коротышка просто исчезает.~
@41343 = ~Зрители *охают* и *ахают*, некоторые аплодируют… в своих воспоминаниях ты отвешиваешь энергичный поклон и направляешься к выходу с лёгкой довольной улыбкой на губах.

Внезапно ты осознаёшь, что Долора внимательно на тебя смотрит: «Вы хорошо себя чувствуете? Мы могли бы закончить нашу дискуссию в другой раз, если пожелаете…»~
@41344 = ~Сцена дымящегося поля битвы заполняет твой разум… ты на большом холме, возвышающемся над полем, следишь за схваткой, сидя верхом на огромном четырёхногом животном. Звуки рога доносят твои распоряжения до войск внизу.~
@41345 = ~Ты видишь, что твои силы разделены, войска разбегаются во все стороны, в то время как враг прорывается к своей конечной цели на холме — к военачальнику противника, к тебе.~
@41346 = ~«Глупцы, — думаешь ты, губы твои складываются в злобную усмешку. — Мои рыцари пойдут вниз с холма и моментально их остановят… а в это время мои „отступающие“ войска развернутся и сожмут их с флангов! О, мой список скоро пополнит ещё одна победа…»

Внезапно ты осознаёшь, что Долора внимательно на тебя смотрит: «Вы хорошо себя чувствуете? Мы могли бы продолжить игру в другой раз, если пожелаете…»~
@41347 = ~Она качает головой: «Боюсь, вы ошибаетесь. Если это только не последнее пополнение, здесь нет десятой ученицы».~
@41348 = ~Лицо Долоры светлеет, когда она тебя замечает: «Приветствую. Могу я чем-то служить?»~
@41349 = ~«До меня тоже доходили такие слухи, но никакой точной информации. Возможно, другая женщина сможет дать ответ, если не сама Кезай. Спросите Джульетту… она и Кезай когда-то были хорошими друзьями, прежде чем Джульетта встретила Монтекки».~
@41350 = ~«Да. Её имя Экко. Её голос — да и все прочие средства общения — были похищены и уничтожены. Однажды Экко своими речами увела у полубогини Парамиши любовника. В запале ревности Парамиша вырвала у Экко голос, поместила его в хрустальный сосуд и бросила в пасть мегогаламдраги. Голос Экко навсегда для неё потерян, только другой, новый голос, может вновь вернуть ей способность общаться. Я знаю это, так как однажды лично говорила с любовником Парамиши».~
@41351 = ~Вы заканчиваете игру с тем же результатом, что и прежде.

«Самая лучшая игра. Ещё раз?»~
@41352 = ~Оставить её в покое.~
@41353 = ~«И чем же ты можешь мне служить, Долора?»~
@41354 = ~«Не совсем, но у меня кое-какие вопросы…»~
@41355 = ~«Нет, просто захотел увидеться. Счастливо».~
@41356 = ~«Я надеялся на что-то более „физическое“…»~
@41357 = ~«Дискутировать, ты сказала?»~
@41358 = ~«Может, сыграем в игру?»~
@41359 = ~«Могу я просто задать пару вопросов?»~
@41360 = ~«Могу я просто задать пару вопросов?»~
@41361 = ~«А знаешь, пойду-ка я лучше. Прощай».~
@41362 = ~«О? Почему ты так считаешь?»~
@41363 = ~«Ты упомянула дискуссию?»~
@41364 = ~«Может, тогда сыграем в игру?»~
@41365 = ~«В таком случае у меня к тебе пара вопросов…»~
@41366 = ~«В таком случае у меня к тебе пара вопросов…»~
@41367 = ~«Тогда прощай».~
@41368 = ~Позволить прикоснуться к себе.~
@41369 = ~Отстраниться от неё.~
