@24879 = ~«Это всё, что я хотел узнать. Прощай».~
@24880 = ~«Это всё, что я хотел узнать. Прощай».~
@24881 = ~«Я хочу задать ему ещё один вопрос…»~
@24882 = ~«Это всё, что я хотел узнать. Прощай».~
@24883 = ~«Буду иметь в виду. У меня к нему другой вопрос…»~
@24884 = ~«Думаю, нашим путям суждено пересечься. Прощай».~
@24885 = ~«Что за татуировки?»~
@24886 = ~«Что за татуировки?»~
@24887 = ~«Что за татуировки?»~
@24888 = ~«Я хочу задать ему ещё один вопрос…»~
@24889 = ~«Это всё, что я хотел узнать. Прощай».~
@24890 = ~«Ладно… я бы хотел посмотреть все татуировки, которые он может предложить».~
@24891 = ~«Я хочу задать ему ещё один вопрос…»~
@24892 = ~«Это всё, что я хотел узнать. Прощай».~
@24893 = ~«Не расскажет ли он что-нибудь о них?»~
@24894 = ~«Не расскажет ли он что-нибудь о них?»~
@24895 = ~«Не расскажет ли он что-нибудь о них?»~
@24896 = ~«Я хочу задать ему ещё один вопрос…»~
@24897 = ~«Это всё, что я хотел узнать. Прощай».~
@24898 = ~«Что за символ на моём плече?»~
@24899 = ~«Что за символ на моём плече?»~
@24900 = ~«Что за символ на моём плече?»~
@24901 = ~«Я хочу задать ему ещё один вопрос…»~
@24902 = ~«Это всё, что я хотел узнать. Прощай».~
@24903 = ~«Эй… ты в порядке? Я думал, ты точно трупак».~
@24904 = ~«Чт?.. Кто ты?»~
@24905 = ~«Я уверен, ты можешь сказать тысячу умных вещей, Морте, но мне нужно, чтобы ты заткнулся и присоединился ко мне СЕЙЧАС ЖЕ».~
@24906 = ~«Э-э… кто я? Может, с *тебя* начнём? Кто ты?»~
@24907 = ~«Я… не знаю. Я не помню».~
@24908 = ~«Я спросил тебя *первым*, череп».~
@24909 = ~«Ты не помнишь своё *имя*? Хе. Что ж, в следующий раз, когда захочешь провести ночь в этом городишке, поменьше налегай на выпивку. Меня звать Морте. Я тоже здесь в ловушке».~
@24910 = ~«В ловушке?»~
@24911 = ~«Ага, а я спросил тебя вторым. Как тебя зовут?»~
@24912 = ~«Я… не знаю. Я не помню».~
@24913 = ~«Ты первый, череп. Последний раз спрашиваю».~
@24914 = ~«Тс-с-с… а ты выглядишь крепче, чем мокрая верёвка. Ну ладно, *я* тут буду хорошим парнем. Звать Морте. А ты кто?»~
@24915 = ~«Я… не знаю. Я не помню».~
@24916 = ~«Ага, и пока ты ещё не размял ноги, рассказываю: я ломился во все двери, эта комната заперта надёжнее пояса целомудрия».~
@24917 = ~«Мы заперты… где? Что это за место?»~
@24918 = ~«Оно называется „Мортуарий“… большое чёрное сооружение с архитектурным очарованием беременной паучихи».~
@24919 = ~«„Мортуарий“? Э-э… я что, умер?»~
@24920 = ~«Насколько я могу видеть, нет. Правда, у тебя куча шрамов… как будто какой-то пень расписал тебя ножом. Ещё одна причина поскорее смыться, пока этот садист не вернулся закончить свою работу».~
@24921 = ~«Как мы можем отсюда выйти?»~
@24922 = ~«Ну, все двери заперты, так что нам нужен ключ. Разве что у кого-нибудь из местных ходячих трупов он есть».~
@24923 = ~«Ходячих трупов?»~
@24924 = ~«Ага, хозяева Мортуария используют мёртвые тела как дешёвую рабочую силу. Покойнички тупые, как камни, но они безвредны и не станут нападать на тебя первыми».~
@24925 = ~«А другого пути нет? Я не хочу убивать их только ради ключа».~
@24926 = ~«Так я должен напасть на один из трупов и отобрать ключ?»~
@24927 = ~«Ты что, боишься их этим огорчить? Они МЕРТВЫ. Кроме того, есть и положительный момент: если ты перебьёшь трупаков, они хотя бы отдохнут, пока хозяева снова не поднимут их работать».~
@24928 = ~«Что ж, ладно… я завалю одного из них и добуду ключ».~
@24929 = ~«Ну, перед нападением тебе нужно вооружиться. По-моему, на какой-то из полок я видел скальпель».

^NПРИМЕЧАНИЕ. Стоит поискать на полках оружие, которым можно атаковать зомби.^-~
@24930 = ~«Ладно, я поищу».~
@24931 = ~«И последнее: эти трупы медленные, как черепахи, но удар кого-нибудь из них будет равносилен для тебя поцелую тарана. Если почувствуешь, что трупак тебя побеждает, не забывай, что ты можешь БЕГАТЬ, а они — нет. Используй эту возможность, чтобы держаться на расстоянии, если тебе потребуется подлечиться».

^NПРИМЕЧАНИЕ. <RUNAWAY> Если персонаж сильно ранен и может умереть, можно использовать бег, чтобы держаться от зомби на расстоянии, пока он не будет снова готов к бою.^-~
@24932 = ~«Хорошо. Спасибо за совет».~
@24933 = ~Я начал записывать свои переживания, чтобы сохранять свежую голову и с надеждой хоть немного разобраться в том, что происходит. Я проснулся в месте под названием «Мортуарий»… похоже, это что-то типа морга. Не знаю, кто я, что здесь делаю и как сюда попал. Первое, что я обнаружил, когда очнулся, был некий болтливый череп по имени Морте. Он сказал, что мы заперты и что один из шаркающих по комнате трупов должен иметь ключ. Он предложил мне полазить по здешним полкам в поисках скальпеля, а потом втыкать его в один из трупов, пока тот не «умрёт».~
