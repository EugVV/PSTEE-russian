@284   = ~Труп продолжает пялиться на тебя.~
@285   = ~Оставить труп в покое.~
@286   = ~Скелет поворачивается к тебе. На лбу у него высечен номер, ряд его костей — в основном, челюсти и суставы — соединены между собой кожаными ремнями. Чёрный рабочий халат накинут поверх его тела.~
@287   = ~«Никак не пойму, зачем тебе халат? Скрывать-то под ним вроде уже нечего».~
@288   = ~«Прошу прощения, ты не видел здесь других скелетов?»~
@289   = ~«Прошу прощения, ты не видел здесь других скелетов?»~
@290   = ~Скелет не отвечает.~
@291   = ~«Рад был поговорить, Костяшка. Будь здоров».~
@292   = ~Перед тобой гигантский скелет в богато украшенных бронзовых доспехах. Доспехи прикреплены к его костям, а на нагруднике вырезан ряд замысловатых символов. Интересно, откуда взялся этот скелет; ты не слышал о людях такого размера. У него в руках огромный клинок, который, похоже, весит как средняя повозка.~
@293   = ~«Не возражаешь, если я немного подержу этот клинок? Ты, должно быть, уже устал его держать».~
@294   = ~Этот бледнолицый мужчина одет в длинные тёмные одежды. От него немного пахнет плесенью. Выражение лица у него отсутствующее, он выглядит поглощённым своими заботами.~
@295   = ~«Приветствую».~
@296   = ~«Приветствую».~
@297   = ~Оставить его в покое.~
@298   = ~Кажется, Пыльная тебя не замечает. Должно быть, она приняла тебя за одного из мёртвых рабочих.~
@299   = ~«Приветствую».~
@300   = ~Кажется, Пыльный тебя не замечает. Должно быть, он принял тебя за одного из мёртвых рабочих.~
@301   = ~«Приветствую».~
@302   = ~«Приветствую».~
@303   = ~«Кто ты?»~
@304   = ~«Что это за место?»~
@305   = ~«У меня кое-какие вопросы…»~
@306   = ~Оставить его в покое.~
@307   = ~Пыльный подпрыгивает от неожиданности, затем резко поворачивается в твою сторону. Он выглядит потрясённым — у тебя, должно быть, отличная маскировка.~
@308   = ~«Приветствую».~
@309   = ~Пыльный делает шаг назад, затем трижды звонко хлопает в ладоши. В ответ в Мортуарии начинает звонить большой железный колокол.~
@310   = ~Воспользоваться неожиданностью и сломать ему шею, прежде чем он закричит.~
@311   = ~Большой гехрелет~
@312   = ~«У меня кое-какие вопросы…»~
@313   = ~«Ну и ладно…»~
@314   = ~Этот бледнолицый мужчина одет в длинные тёмные одежды. От него немного пахнет плесенью. Выражение лица у него отсутствующее, он выглядит поглощённым своими заботами.~
@315   = ~«Приветствую».~
@316   = ~«Кто ты?»~
@317   = ~«Что это за место?»~
@318   = ~«Кто ты?»~
@319   = ~«У меня кое-какие вопросы…»~
@320   = ~Оставить его в покое.~
@321   = ~Пыльный медленно поднимает голову и поворачивается к тебе: «Ты потерялся?»~
@322   = ~«Да».~
@323   = ~«Нет».~
@324   = ~«Нет, я не потерялся. У меня пара вопросов…»~
@325   = ~«Прощай».~
@326   = ~«Я позову стражу, чтобы тебя проводили к выходу. Подожди минутку».~
@327   = ~Сломать ему шею, прежде чем он закричит.~
@328   = ~Сломать ему шею, прежде чем он закричит.~
@329   = ~Быстро уйти.~
@330   = ~«Если ты не потерялся, что тогда тебе здесь надо?»~
@331   = ~«Тебя это не касается».~
@332   = ~«Я очнулся на одной из плит в вашей препарационной».~
@333   = ~«Я здесь, чтобы кое с кем увидеться».~
@334   = ~«Я был здесь на похоронах, но кажется, произошла ошибка».~
@335   = ~«Боюсь, касается. Может, стража развяжет тебе язык», — Пыльный отступает в сторону; кажется, он собирается позвать стражу.~
@336   = ~«Шуточки любишь? Может, хочешь поделиться ими со стражей?» — Пыльный отступает в сторону; кажется, он собирается позвать стражу.~
@337   = ~Быстро уйти.~
@338   = ~«И с кем же?»~
@339   = ~Уйти.~
@340   = ~«Не сталкивался ещё с Голодными Псами? Я б на твоём месте избегал этих воющих, пакостных сволочей… ублюдки херовы!»~
@341   = ~Уйти.~
@342   = ~«С Дхаллом».~
@343   = ~«С Дхаллом».~
@344   = ~Сломать ему шею, прежде чем он закричит.~
@345   = ~«Дхалл в приёмной на этом этаже. Должен предупредить… Дхалл очень занят своими делами и не совсем здоров. Если у тебя не срочное дело, я бы его не беспокоил».~
@346   = ~«Скорее всего, Дхалл в приёмной на втором этаже. Он очень занят и не совсем здоров. Если у тебя не срочное дело, я бы его не беспокоил».~
@347   = ~«Хорошо. Спасибо за информацию».~
@348   = ~«Хорошо. Спасибо за информацию».~
@349   = ~«Дейонарра? Какая-то женщина погребена в поминальной зале на первом этаже. Может, это она?»~
@350   = ~«Дейонарра? Какая-то женщина погребена в северо-западной поминальной зале. Может, это она?»~
@351   = ~«Полагаю, Соэго около главных ворот на первом этаже. Он исполняет обязанности гида в часы антипика».~
@352   = ~«Вероятнее всего. Спасибо».~
@353   = ~«Вероятнее всего. Спасибо».~
@354   = ~«Очень хорошо. Спасибо».~
@355   = ~«Полагаю, Соэго около главных ворот. Он исполняет обязанности гида в часы антипика».~
@356   = ~«Очень хорошо. Спасибо».~
@357   = ~«Кого хоронят? Возможно, служба идёт где-то в другом зале Мортуария».~
@358   = ~Сломать ему шею, прежде чем он закричит.~
@359   = ~«Ты не понял… ошибка в том, что похоронить собирались МЕНЯ».~
@360   = ~«Может быть. А где эти другие службы проходят?»~
@361   = ~«Можешь показать мне, где здесь выход?»~
@362   = ~«Несколько похоронных залов расположены по периметру Мортуария. Они находятся вдоль стен на первом и втором этажах. Ты знаешь имя покойного?»~
@363   = ~«Нет».~
@364   = ~«Да».~
@365   = ~«Тогда тебе стоит спросить у одного из гидов возле парадного входа. Они смогут тебе помочь».~
@366   = ~«Ладно. Спасибо».~
@367   = ~Пыльный ждёт.~
@368   = ~«Это имя мне не знакомо. Спроси у одного из гидов возле парадного входа… Они смогут направить тебя лучше, чем я».~
@369   = ~«Прости… я оговорился. Я не знаю, как зовут покойного».~
@370   = ~«Её зовут Дейонарра».~
@371   = ~Ложь: «Звать… э-э, Адан».~
@372   = ~Ложь: «Звать… э-э, Адан».~
@373   = ~Наклониться вперёд, будто ты хочешь что-то прошептать, и свернуть ему шею.~
@374   = ~«Ясно. Но что тогда тебе здесь надо?»~
@375   = ~«Тебя это не касается».~
@376   = ~«Я очнулся на одной из плит в вашей препарационной».~
@377   = ~«Я здесь, чтобы кое с кем увидеться».~
@378   = ~«Я был здесь на похоронах, но кажется, произошла ошибка».~
@379   = ~Убежать.~
@380   = ~«Отлично. Я так и сделаю. Прощай».~
@381   = ~Он медленно поворачивается, и его глаза загораются при виде твоих одежд: «Приветствую, посвящённый».~
@382   = ~Оставить его в покое.~
@383   = ~«Кто ты?»~
@384   = ~«Что это за место?»~
@385   = ~Ты видишь сурового вида человека в чёрных одеждах. Он с подозрением смотрит на тебя.~
@386   = ~Пыльный хмурится, когда ты проходишь мимо… как будто хочет тебя окликнуть, но потом передумывает. Твоя манера держаться убедила его придержать язык.~
@387   = ~Пройти мимо.~
@388   = ~«Приветствую».~
@389   = ~«Приветствую».~
@390   = ~«Приветствую».~
@391   = ~«У меня кое-какие вопросы…»~
@392   = ~Оставить его в покое.~
@393   = ~«Я хочу задать тот же вопрос. Твоё лицо мне незнакомо. Кто ты?»~
@394   = ~«Это Мортуарий… — Пыльный смотрит на тебя какое-то время, как будто переваривая твои слова. — Как, говоришь, твоё имя?»~
@395   = ~~
@396   = ~~
@397   = ~~
@398   = ~«Дневник? Ничего подобного не видел».~
@399   = ~Ложь: «Звать… э-э, Адан».~
@400   = ~Пыльный терпеливо ждёт продолжения.~
@401   = ~«Можешь показать мне выход?»~
@402   = ~«Не знаешь кого-нибудь по имени Фарод?»~
@403   = ~«Я потерял дневник. Ты его не видел?»~
@404   = ~«Ничего страшного. Извини за беспокойство».~
@405   = ~«Ты можешь просто выйти через парадный вход. Он на первом этаже».~
@406   = ~«У меня другие вопросы…»~
@407   = ~«Спасибо. Прощай».~
@408   = ~«Это имя… — Пыльный замолкает на минуту. — Это имя звучит *знакомо*… Кажется, припоминаю одного Сборщика с этим именем. Писарь Дхалл должен его знать».~
@409   = ~«Сборщика?»~
@410   = ~«Дхалл?»~
@411   = ~«У меня другие вопросы…»~
@412   = ~«Сборщики… они собирают тех, кто умер на улицах Сигила, и доставляют в Мортуарий… — Пыльный замолкает, затем хмурится. — Ты не здешний. Кто ты?»~
@413   = ~«Я новопосвящённый. Прости моё невежество».~
@414   = ~«Дхалл — один из самых уважаемых членов нашей фракции. Думаю, нет никого, кто бы размышлял больше о сущности Истинной Смерти или заслуживал её больше его. Он может поделиться своей мудростью. Если ты ещё не познакомился, советую это сделать, как только представится возможность. Не надолго он задержится в тени этого существования».~
@415   = ~«*Не надолго задержится в тени этого существования*?»~
@416   = ~«Где я могу найти Дхалла?»~
@417   = ~«Где я могу найти Дхалла?»~
@418   = ~«У меня другие вопросы…»~
@419   = ~Кивает: «Дхалл болен. Он стар даже по меркам гитцерай. Смерть, без сомнения, последует за его изнурительной болезнью. Ему по-настоящему повезло».~
@420   = ~«По меркам гитцерай?»~
@421   = ~«Что значит *гитцерай*?»~
@422   = ~«Повезло?»~
@423   = ~«Ясно. У меня другие вопросы…»~
@424   = ~«Спасибо, что уделил мне время. Я должен идти».~
@425   = ~«Спасибо, что уделил мне время. Прощай».~
@426   = ~«Скорее всего, Дхалл в приёмной на втором этаже. Я бы не отнимал слишком много его времени — он очень занят… а большую часть свободного времени у него отнимает изнурительная болезнь».~
@427   = ~«Дхалл в приёмной в северо-западном углу этого этажа. Должен предупредить… Дхалл очень занят… а большую часть свободного времени у него отнимает изнурительная болезнь».~
@428   = ~«Дхалл болен?»~
@429   = ~«Спасибо, что уделил мне время. Я должен идти. Прощай».~
@430   = ~«Дхалл болен?»~
@431   = ~«Спасибо, что уделил мне время. Я должен тебя покинуть. Прощай».~
@432   = ~«Да, гитцерай живут гораздо дольше людей».~
@433   = ~«Что значит *гитцерай*?»~
@434   = ~~
@435   = ~«Гитцерай… — Пыльный замолкает, затем хмурится, внимательно тебя разглядывая. — Ты не здешний. Кто ты?»~
@436   = ~«Я новопосвящённый. Прости моё невежество».~
@437   = ~«Почему это Дхаллу повезло? Разве он не любим всеми?»~
@438   = ~«О. У меня другие вопросы…»~
@439   = ~«Ему повезло в том, что он достигнет Истинной Смерти. Не должен будет больше влачить эту тень существования».~
@440   = ~«Спасибо, что уделил мне время. Прощай».~
@441   = ~«А… это хорошо?»~
@442   = ~«Ясно. Вот уж действительно повезло. У меня другие вопросы…»~
@443   = ~«Ясно. Ладно, я должен идти. Прощай».~
@444   = ~Пыльный кивает: «Да». Он хмурится, затем внимательно на тебя смотрит: «Ты не здешний. Кто ты?»~
@445   = ~«Я новопосвящённый. Прости моё невежество».~
@446   = ~«Я… здесь новичок. Пытаюсь… сориентироваться».~
@447   = ~«Ты не один из нас, не так ли? Что ты здесь делаешь? Ты из Анархистов? Или шпион другой фракции? Стража! Стража!»~
@448   = ~«Дьявол!»~
@449   = ~«Ш-ш! Я не могу отвечать тебе при таком шуме!»~
@450   = ~Ложь: «Звать… э-э, Адан».~
@451   = ~«У меня другие вопросы…»~
@452   = ~«Я должен идти. Прощай».~
@453   = ~Ходячий труп глазеет на тебя отсутствующим взглядом. На лбу у него вырезан номер «821», а губы плотно сшиты. Лёгкий запах формальдегида исходит от его тела.~
@454   = ~«Так… что-нибудь интересненькое происходит?»~
@455   = ~«Так… что-нибудь интересненькое происходит?»~
@456   = ~«Я знаю, что ты не зомби. Ты никого тут не одурачишь».~
@457   = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@458   = ~«Приятно было пообщаться. Прощай».~
@459   = ~Оставить труп в покое.~
@460   = ~Странно, но твоя способность не работает на этом трупе.~
@461   = ~Ткнуть ему в глаз.~
@462   = ~Оставить труп в покое.~
@463   = ~От тычка в глаз труп приглушённо взвизгивает и судорожно прикрывает лицо руками. Он начинает еле слышно бормотать, как тебе кажется, непристойности.~
@464   = ~«Ты не зомби! Кто же ты?»~
@465   = ~«Почему ты замаскировался под труп?»~
@466   = ~Быстро уйти.~
@467   = ~Как только ты собираешься уходить, «зомби» что-то бубнит… похоже, он пытается что-то сказать, но это затруднительно с зашитыми губами: «Фто ТЫ? Фто тее нао?»~
@468   = ~«Я хочу выбраться отсюда. Не поможешь мне?»~
@469   = ~«Кто ты?»~
@470   = ~«Отвечай, кто ты такой, или я позову стражу».~
@471   = ~Как только ты собираешься уходить, зомби издаёт слабое подобие рычания. «Ничео не говои офо МНЕ. Моучи. Ничео не говои Пыльникам, — он подносит палец к губам. — Ф-ф-ф-ф». Затем подносит его к горлу: «Или уфнёшь нафегда. Ты ФЛЫШИШЬ мея?»~
@472   = ~Ложь: «Я искал тебя».~
@473   = ~«Вопросы здесь задаю *я*, *зомби*. Отвечай, кто ты, или я сделаю эту маскировку реальностью».~
@474   = ~«Прости за беспокойство… кто бы ты ни был. Прощай».~
@475   = ~«Ты что, УГРОЖАЕШЬ мне? Ну, смотри… готовься к смерти».~
@476   = ~Ложь: «Я бы и *мысли* не допустил рассказывать о тебе Пыльным».~
@477   = ~Правда: «Я обещаю, что ничего не скажу о тебе Пыльным».~
@478   = ~«Как скажешь. Ты занимайся своими делами, а я — своими».~
@479   = ~Как только ты обращаешься к зомби, он удивлённо моргает: «Э-э? Фто?»~
@480   = ~«Ты не зомби?! Кто ты?»~
@481   = ~«Почему ты замаскировался под труп?»~
@482   = ~Быстро уйти.~
@483   = ~«Зомби» пытается ответить, несмотря на зашитые губы; у него очень необычное полуиспуганное-полугневное выражение лица: «Фто ТЫ? Фто те нао?»~
@484   = ~«Я хочу выбраться отсюда. Не поможешь мне?»~
@485   = ~«Кто ты?»~
@486   = ~«Отвечай, кто ты такой, или я позову стражу».~
@487   = ~Ложь: «Я искал тебя».~
@488   = ~«Вопросы здесь задаю *я*, *зомби*. Отвечай, кто ты, или я сделаю эту маскировку реальностью».~
@489   = ~«Извини за беспокойство… кто бы ты ни был. Прощай».~
@490   = ~Кажется, зомби тебя не расслышал. Он осматривает тебя с ног до головы, а затем хмурится. «Фто ты фдесь делаефь? — он подозрительно щурится. — Фпионифь за Пыльниками?»~
@491   = ~«Нет. Я пытаюсь сбежать».~
@492   = ~«Я не шпион. Так получилось, что я здесь застрял. Не поможешь мне выбраться?»~
@493   = ~Ложь: «Да, я шпионю за… Пыльниками».~
@494   = ~Ложь: «Да, я шпионю за… Пыльниками».~
@495   = ~«Почему бы тебе не рассказать, что ТЫ здесь делаешь, пока я не позвал стражу».~
@496   = ~«Почему бы тебе не рассказать, что ТЫ здесь делаешь, пока я не позвал стражу».~
@497   = ~Огни Элизиума~
@498   = ~ИНФЕРНАЛЬНАЯ СФЕРА
Дистанция: 50 футов
Длительность: особая
Время чтения: 1
Зона действия: 1 существо
Спасбросок: отменяет

Вызывается пламенно-красная сфера, которая ослабляет и замедляет противника.

Заклинатель призывает большой магический огненный шар, который затем можно бросить в цель. Используется обычный бросок атаки заклинателя с улучшением +3. Шар наносит 1-6 урона и на 10 секунд налагает штраф -1 к силе и ловкости противника.~
@499   = ~ЛИТАНИЯ ПРОКЛЯТИЙ
Дистанция: 50 футов
Длительность: 10 секунд за уровень
Время чтения: 0
Зона действия: 1 существо (не нежить)
Спасбросок: отменяет

Морте может использовать весь набор своих насмешек на противнике, отвлекая того и снижая способности к защите и атаке. Враг получает штрафы к атаке и урону.

Заклинание не действует на нежить. Сопротивление магии не влияет на это заклинание, но объект чар делает спасбросок против заклинания, чтобы избежать эффекта. Пока цель находится под влиянием «Литании проклятий», она получает -2 к броскам атаки, -2 к классу защиты и -2 к броскам урона.

Этой особой способностью может пользоваться только Морте.~
@500   = ~Ты видишь труп мужчины с выдолбленным на черепе номером «331». Его глаза и губы крепко зашиты, а в горле зияет большая дыра. Он *ужасно* воняет.~
@501   = ~Труп молча смотрит вперёд невидящими глазами.~
@502   = ~«Так… что-нибудь интересненькое происходит?»~
@503   = ~«Так… что-нибудь интересненькое происходит?»~
@504   = ~«Шт-ш… — зомби с непривычки неуклюже ворочает языком, его голос звучит обеспокоено. — Кто здесь?! Отвечай!»~
@505   = ~«Тогда прощай».~
@506   = ~«Хакария?»~
@507   = ~«Ты меня не видишь?»~
@508   = ~Импровизировать: «Это я. Ты не узнаёшь мой голос?»~
@509   = ~«Слеп я в смерти, как был слеп при жизни… теперь отвечай. Кто ты?»~
@510   = ~Импровизировать: «Это я. Ты не узнаёшь мой голос?»~
@511   = ~«Кто ты?»~
@512   = ~«Чт… ты!» — зомби выглядит ошеломлённым, но радостным. «Клянусь взглядом Госпожи… — в его голосе слышится удивление. — Разве ты не *мёртв*, здоровяк?»~
@513   = ~«Мортуарий, здоровяк. А ты не знал, что ли?»~
@514   = ~«Так трудно скинуть эту грязную пелену и увидеть старого дурака Хакарию? Это я, здоровяк. Благословенны будь силы, я не надеялся снова тебя увидеть… но ты тоже изменился, насколько могут судить мои уши… ты снова делаешь неправильный выбор? — Хакария хрипит сквозь дыру в горле. — Или ты тоже мёртв?»~
@515   = ~«Кто ты?»~
@516   = ~«Что ты здесь делаешь?»~
@517   = ~«Что это за место?»~
@518   = ~«Не могу долго говорить. Я должен идти. Прощай».~
@519   = ~«Кто ты?»~
@520   = ~«Ты не получишь ответа сегодня, труп. Прощай».~
@521   = ~«Хакария?»~
@522   = ~«Ты не получишь ответа сегодня, труп. Прощай».~
@523   = ~«Что довело тебя до такого состояния?»~
@524   = ~«Что ты можешь рассказать о Мортуарии?»~
@525   = ~«Что ты можешь рассказать о моей предыдущей жизни?»~
@526   = ~«Что ты можешь рассказать о моих прежних товарищах?»~
@527   = ~«Я должен идти. Прощай».~
@528   = ~«Да?»~
@529   = ~Он понижает голос, как будто пристыжен: «Трудно идти по твоим стопам, здоровяк, и много ужасных вещей я видел. Я пил и совсем отупел от этого. Однажды, когда был в стельку пьян, я продал своё тело Пыльным. Судьба решила меня добить, когда я был на дне, и вскоре я умер».~
@530   = ~«Определёно»~
@531   = ~«У меня другие вопросы…»~
@532   = ~«Машина»~
@533   = ~«Место смерти, где правят Мёртвые… однако кое-что здесь не правильно…»~
@534   = ~«Например?»~
@535   = ~«Я открою тебе секрет: здесь есть зомби, который только притворяется, но не является зомби. Мне плевать на причину, но это странно».~
@536   = ~«У меня к тебе другие вопросы…»~
@537   = ~«У меня нет больше времени для разговоров с тобой. Прощай».~
@538   = ~«Что-нибудь ещё?»~
@539   = ~«Какой это зомби?»~
@540   = ~«Интересно. У меня другие вопросы…»~
@541   = ~«Кое-что ещё. Этот старый гитцерай… который следит за препарационной… Дхалл. Он не раз спасал тебя от кремации. Тебе повезло иметь такого друга».~
@542   = ~«Как именно Дхалл меня спасал?»~
@543   = ~«Я знаю. У меня другие вопросы…»~
@544   = ~«У меня нет больше времени для разговоров с тобой. Прощай».~
@545   = ~«Я услышал достаточно. Прощай».~
@546   = ~«У меня нет больше времени для разговоров с тобой. Прощай».~
@547   = ~«Даже если бы мои глаза позволили мне видеть, я ничего не понимаю в цифрах. Вот как ты узнаешь его, здоровяк: его голос не похож на голос зомби… он не отвечает так же, как другие».~
@548   = ~«Ты заметил ещё что-нибудь странное в Мортуарии?»~
@549   = ~«Пойду поищу этого зомби. Прощай».~
@550   = ~«Он просто откладывал твою кремацию, пока ты внезапно не исчезал с плиты. Не знаю, зачем ему это».~
@551   = ~«Часы»~
@552   = ~«Интересно. У меня другие вопросы…»~
@553   = ~«Я должен идти. Прощай».~
@554   = ~«Хм. Интересно. У меня другие вопросы…»~
@555   = ~«Он думал, что необходимо предотвратить… чтобы… я… я не могу точно вспомнить, почему это было необходимо».~
@556   = ~«Ясно. Интересно, *было* ли это необходимо. Мне нужно обсудить это с Дхаллом… прощай».~
@557   = ~«Хм… подозрительно. У меня другие вопросы…»~
@558   = ~Он понижает голос, как будто пристыжен: «Когда наши пути разошлись, здоровяк, во мне уже оставалось мало жизни. Трудно идти по твоим стопам, и много ужасных вещей я видел. Я пил и совсем отупел от этого. Однажды, когда был в стельку пьян, я продал своё тело Пыльным. Судьба решила меня добить, когда я был на дне, и вскоре я умер».~
@559   = ~«У меня другие вопросы…»~
@560   = ~«Я должен идти. Прощай».~
@561   = ~«Почему? Ты забыл себя?»~
@562   = ~«В каком-то смысле… да».~
@563   = ~«Нет… я лишь хотел убедиться, тот ли ты, кем называешься».~
@564   = ~«Неважно. У меня другие вопросы…»~
@565   = ~«Я должен идти. Прощай».~
@566   = ~«Что ж… ты был странным, вечно всех подозревал и за чем-то следил… у таких, как ты, достаточно врагов по жизни. И нельзя отрицать, что любой, кто мешал тебе, заканчивал на чёрных страницах книги мёртвых».~
@567   = ~«Ещё ты мог быть дьявольски жестоким… как когда заставил меня подписать тот договор или когда оставил того плачущего ребёнка в Авернусе. С таким же успехом с нами мог всё это время ходить балор. Никто из нас даже и подумать не мог отлынивать при тебе, сынок».~
@568   = ~«В своём сердце ты смотрел на происходящее с тобой как на захват территории во время войны: всё для тебя было сражением, и ты был самым жестоким ублюдком, какого я когда-либо встречал. Ничего больше не имело значения, кроме решения этой задачи. Тебя нисколько не волновали ни бедная Дейонарра с её рыданиями и уговорами, ни гит, предупреждающий тебя о твоих методах, а бедный Хакария просто пытался держаться, когда мы громили планы. Ты был настолько крут, как будто не мог умереть, но мы были всего лишь смертными. Сейчас, я полагаю, мы все уже в книге мёртвых… или местечко там выделено, что уж говорить».~
@569   = ~«Что-нибудь ещё? Любые подробности…»~
@570   = ~«У меня другие вопросы…»~
@571   = ~«Я должен идти. Прощай».~
@572   = ~«Я… понял. Что ещё? Всё, что ты скажешь, может мне помочь».~
@573   = ~«Неважно. У меня другие вопросы…»~
@574   = ~«Я должен идти. Прощай».~
@575   = ~«Построитель Снов»~
@576   = ~«Дейонарра?»~
@577   = ~«„Гит“? Что ты имеешь в виду?»~
@578   = ~«У меня другие вопросы…»~
@579   = ~«Ясно. Я должен идти. Прощай, Хакария».~
@580   = ~«Ну, что такого я могу сказать для подтверждения своей личности… теперь, видишь ли, я уже не всё помню. Как насчёт этого… помнишь, когда мы пробивали себе путь по Авернусу и нарвались в той червивой дыре на шайку абишаев?»~
@581   = ~Ложь: «Да».~
@582   = ~«Нет».~
@583   = ~«Что ж, я рад, что один из нас это помнит, потому как я-то уж точно нет. Кто ты, здоровяк, и что надеешься откопать в воспоминаниях мертвеца?»~
@584   = ~«Я надеюсь найти себя. Хакария. Я правда забыл, кто я такой, но уверен, что ты меня знал. Что ты мне можешь рассказать о моей прошлой жизни?»~
@585   = ~Страж ворот Пыльных~
@586   = ~«Забудь об этом. У меня есть несколько вопросов».~
@587   = ~«Ничего… Я должен идти. Прощай, Хакария».~
@588   = ~«Хм-м-м. Может, это случилось и не так, как я помню. Вот ещё: помнишь, когда Дейонарра почти прописала себя в книге мёртвых, пытаясь остановить тебя от входа в Керст?»~
@589   = ~«Пёстрой мы были компанией… полумертвец, который не мог записать себя в книгу мёртвых, даже если пытался — настолько уродливый, что все силы смерти не брали его, причитающая дочь адвоката, гит-изгнанник, летающий череп с языком шакала и полуспятивший слепой лучник — я».~
@590   = ~«Нет, не совсем… но это ничего; я уверен, что ты знал меня. Можешь мне рассказать о моей предыдущей жизни?»~
@591   = ~«Неважно… у меня другие вопросы».~
@592   = ~«Мне надо идти. Прощай, Хакария».~
@593   = ~«Гит?»~
@594   = ~«Причитающая дочь адвоката?»~
@595   = ~«Летающий череп?»~
@596   = ~«Ты был слепым лучником?»~
@597   = ~«Не знаешь, что случилось с моим дневником?»~
@598   = ~«Неважно. У меня другие вопросы…»~
@599   = ~«Мне надо идти. Прощай, Хакария».~
@600   = ~«Хмурый гит… недружелюбный и молчаливый, как и все они. Не доверял я этому гиту, ни капельки не доверял. Видишь ли, здоровяк, этих тощих гитов волнуют только две вещи: не попадать в рабство и убивать кальмароголовых иллитидов. Всё остальное — просто ниже их достоинства, и он совершенно не замечал никого из нас, кроме тебя».~
@601   = ~«Почему это?»~
@602   = ~«О других моих компаньонах…»~
@603   = ~«У меня другие вопросы…»~
@604   = ~«Хм. Интересно. Спасибо, Хакария».~
@605   = ~«Это одна из тех тайн, о которых я ничего не знаю, здоровяк. Может, ты мне поведаешь?»~
@606   = ~«Я ничего о себе не знаю. У меня другие вопросы…»~
@607   = ~«Может, мне лучше поискать ответы. Прощай, Хакария».~
@608   = ~«Эта вздорная девчонка-которая-хочет-стать-воином, она бы последовала за тобой в Баатор и назад, клянусь силами, она так забила себе голову мыслью о тебе, что никаким другим мыслям места не осталось. Обо мне и гите не думала вообще. Её дикое сердце было отравлено тобой, о да, будто свихнулась. Я не понимаю, что женщины находили в тебе, но сердца их закипали. Она была кем-то вроде богатейки из района Клерков, и тебе было что-то от неё надо, единственной ценой было то, чтобы она пошла с тобой».~
@609   = ~«И что мне было от неё надо?»~
@610   = ~«О других моих компаньонах…»~
@611   = ~«Я услышал достаточно. Прощай, Хакария».~
@612   = ~«Да, о ком?»~
@613   = ~«Гит».~
@614   = ~«У меня другие вопросы…»~
@615   = ~«„Причитающая дочь адвоката“».~
@616   = ~«Летающий череп».~
@617   = ~«Ты… был… слепым лучником?»~
@618   = ~«Неважно. У меня другие вопросы…»~
@619   = ~«Я услышал достаточно. Прощай, Хакария».~
@620   = ~«Этот череп сквернословил не в меру и вечно нарывался на драку, о да! Всегда язвил и высмеивал моё состояние».~
@621   = ~Пьяный маг~
@622   = ~«О других моих компаньонах…»~
@623   = ~«У меня другие вопросы…»~
@624   = ~«Я услышал достаточно. Прощай, Хакария».~
@625   = ~«Этот альбом, который ты сшил из кусков своей собственной плоти, и в котором было больше страниц, чем я видел в своей жизни?! Ну и хорошо, что ты потерял эту премерзкую книжицу! Она ужасно воняла, и ты постоянно писал в ней. Как будто боялся, что её кто-нибудь вдруг может забрать… ты писал в ней, пока кожа не облезала с твоих пальцев, и мне было интересно, не собираешься ли ты всю свою черепушку через перо излить. Иногда мы задерживались на целые дни, пока ты писал. Я ненавидел эту дьявольскую книгу. Казалось, она держит тебя за сердце, и держит не по-доброму. Последний раз я её видел у тебя, здоровяк. Если её у тебя нет — я понятия не имею, где на планах она может быть».~
@626   = ~«Об этих моих компаньонах…»~
@627   = ~«У меня другие вопросы…»~
@628   = ~«Спасибо за информацию. Прощай, Хакария».~
@629   = ~«Звучит знакомо… но если ты тот, кто я думаю, тогда… кто… — зомби замолкает на минуту. — Кто я?»~
@630   = ~«Я… — зомби замолкает, — …моё имя… покинуло меня. Я… не могу больше вспомнить, кто я».~
@631   = ~«Хакария?»~
@632   = ~«Твоё имя мне не известно. Может, я вернусь, если я найду его. Прощай».~
@633   = ~«Тогда прощай, Хакария».~
@634   = ~«Хакария?»~
@635   = ~«Твоё имя мне не известно. Может, я вернусь, если я найду его. Прощай».~
@636   = ~«Прощай».~
@637   = ~«Что довело тебя до такого состояния?»~
@638   = ~«Что ты мне можешь рассказать о Мортуарии?»~
@639   = ~«Что ты мне можешь рассказать о моей предыдущей жизни?»~
@640   = ~«Что ты мне можешь рассказать о моих прежних товарищах?»~
@641   = ~«Мне надо идти. Прощай, Хакария».~
@642   = ~«Ты кое-что оставил, когда покинул нас, здоровяк… ты оставил Дак'кона без хозяина, а черепа без друга. Я? Ты что-то вонзил в меня, оно так и не вышло при жизни. Заставляло мою кровь холодеть, эта штука сидела в моей груди, как кусок свинца».~
@643   = ~«Я… я не знаю. Но это как-то изменило меня. Изменило изнутри. Я уже умирал, когда ты засадил это в меня, так что это меня уже не сильно волновало».~
@644   = ~«Оно спрятано очень глубоко, но я подозреваю, где оно. Без скальпеля и моих указаний, ты это не вынешь. У тебя есть скальпель?»~
@645   = ~«Что это?»~
@646   = ~«У меня другие вопросы…»~
@647   = ~«Да».~
@648   = ~«Мне надо идти. Прощай, Хакария».~
@649   = ~«Можно мне забрать это?»~
@650   = ~«О моих компаньонах…»~
@651   = ~«У меня другие вопросы…»~
@652   = ~«Мне надо идти. Прощай, Хакария».~
@653   = ~«Нет… но я могу просто порвать швы».~
@654   = ~«Что ж, возвращайся, когда добудешь его, и мы сможем полюбопытствовать, что там».~
@655   = ~«У меня другие вопросы…»~
@656   = ~«Пойду поищу. Прощай, Хакария».~
@657   = ~«Тогда вскрой меня на полкисти под грудиной и поищи там».~
@658   = ~Сделать это.~
@659   = ~«Неважно, Хакария… у меня другие вопросы…»~
@660   = ~«Сейчас не могу, я должен идти. Прощай, Хакария».~
@661   = ~«Немного левее… ещё немного…» Твоя рука что-то нащупывает.~
@662   = ~Ты достаёшь печень зомби. «Во имя взгляда Госпожи! Мои извинения, здоровяк… я думал, эти Пыльные повынимали у нас все органы, прежде чем вычеркнуть из книги мёртвых. Попробуй ещё. Может, оно справа».~
@663   = ~Достать.~
@664   = ~Попробовать снова.~
@665   = ~«Так, всё верно… теперь немного правее и назад… ещё немного… — ты нащупываешь что-то твёрдое и холодное, немного большее, чем ожидал. — Думаю, это то что надо. Доставай».~
@666   = ~Достать.~
@667   = ~Ты держишь почерневший предмет размером с кулак, который кажется очень тяжёлым для своего размера. «Точно, это то, что надо. Уф. Я думал, будет больше. Это… что это? Похоже на… сердце».~
@668   = ~«Да, я тоже так думаю. Спасибо, Хакария. У меня другие вопросы…»~
@669   = ~«Похоже, то, что надо. Теперь мне пора. Прощай, Хакария».~
@670   = ~«Прежде чем ты уйдёшь, не окажешь мне небольшую услугу, здоровяк?»~
@671   = ~«Слишком много уже у меня этих заданий и услуг… мне пора, Хакария. Прощай».~
@672   = ~«Какую?»~
@673   = ~Он понижает голос, как будто пристыжен: «Я наделал кое-каких ошибок, некоторые слишком серьёзны. Одной из самых серьёзных было подписать этот договор Пыльных. Если бы у меня крыша не съехала от бухла, я бы никогда так не сделал. Я сожалею об этой ошибке и надеюсь, что ты её исправишь».~
@674   = ~Вернет~
@675   = ~«Как?»~
@676   = ~«Слишком много уже у меня этих заданий и услуг… мне пора, Хакария. Прощай».~
@677   = ~«Насколько я понимаю, это тело долго протянет… а для меня каждый день слишком долог. Не мог бы ты опять меня выпотрошить, здоровяк… по старой памяти? Мысль провести годы здесь, в Мортуарии, с этими белолицыми, не слишком привлекательна. Не мог бы ты придумать, как опять записать меня в книгу мёртвых, где моё истинное место?»~
@678   = ~Ты потрошишь его, и Хакария с глухим стуком падает на пол. Слабое шипение исходит из тела, грудь вздымается, а затем, со слабым потрескиванием, труп затихает.~
@679   = ~«Если ты так хочешь…»~
@680   = ~«Хакария. Я не убью тебя снова. Прощай».~
@681   = ~«Покойся с миром, Хакария».~
@682   = ~«Что ж, тогда забудь. Полагаю, я больше тебе не нужен».~
@683   = ~«Что ж, здоровяк, я полагаю, будь ты мёртв, ты не стал бы это отрицать. Иначе как ты можешь говорить со мной? Твой голос чист, как нож…»~
@684   = ~Уйти.~
@685   = ~«Это долгая история… но нет, я не мёртв».~
@686   = ~«Что ты здесь делаешь?»~
@687   = ~«Что это за место?»~
@688   = ~«Я не могу больше говорить, Хакария. Прощай».~
@689   = ~«Что ты здесь делаешь?»~
@690   = ~«У меня есть несколько вопросов…»~
@691   = ~«Мне надо идти. Прощай, Хакария».~
@692   = ~«Я чернорабочий в самом безжизненном месте. Случись так, что я прошёл бы Вечную Границу — я попал бы на план, который назвал бы домом. Но большая часть моей души была промотана, и вот я здесь».~
@693   = ~«Скажи, каково это — быть зомби?»~
@694   = ~«Это честная работа… — швы на рту Хакарии расходятся, и плоть вокруг его губ расплывается в улыбке, — …и мне на неё плевать».~
@695   = ~«У меня есть несколько вопросов…»~
@696   = ~«Мне надо идти. Прощай, Хакария».~
@697   = ~«У меня другие вопросы…»~
@698   = ~«Тогда прощай, Хакария».~
@699   = ~Уйти.~
@700   = ~«Никаких. Я солгал».~
@701   = ~Уйти.~
@702   = ~Ложь: «Твоё имя будит страстные мысли, хотя их смысл неясен. Может, если бы ты рассказала мне больше…»~
@703   = ~«Приветствую?..»~
@704   = ~Ждать.~
@705   = ~Уйти, прежде чем дух примет чёткие очертания.~
@706   = ~Её глаза медленно открываются, и она какое-то время растерянно моргает, словно не понимая, где находится. Дух медленно оглядывается, затем замечает тебя. Её лицо внезапно искривляется: «Ты! Что *тебя* сюда привело?! Снова пришёл посмотреть на дело рук своих? Может, даже мёртвой я способна принести тебе какую-то пользу?..» Её голос срывается на хрип: «…„Любовь моя“».~ [DEN001]
@707   = ~«Кто ты?»~
@708   = ~«„Любовь моя“? Я тебя знаю?»~
@709   = ~«„Любовь моя“? Я тебя знаю?»~
@710   = ~Дух складывает руки в мольбе: «Как же так может быть, или какой-то вор крадёт моё имя из твоей памяти? Ты не *помнишь* меня, Любовь моя?» Дух разводит руками. «Подумай… — в её голос возвращается отчаяние, — …имя *Дейонарра* должно всколыхнуть в тебе воспоминания».~
@711   = ~«Нет, прости. Я потерял свою память».~
@712   = ~Ложь: «Да… да, имя *звучит* знакомо».~
@713   = ~«Мне *кажется*, в памяти что-то всколыхнулось… расскажи мне больше. Возможно, твои слова прогонят тени из моей головы, Дейонарра».~
@714   = ~«Мне *кажется*, в памяти что-то всколыхнулось… расскажи мне больше. Возможно, твои слова прогонят тени из моей головы, Дейонарра».~
@715   = ~Дейонарра снова материализуется… в этот раз её лицо наполнено отчаянием, а руки распростёрты, как будто она к чему-то стремится. По мере того, как она проявляется, отчаяние на лице сменяется гневом: «Ты снова пришёл! Зачем ты продолжаешь меня мучить?»~ [DEN002]
@716   = ~Дейонарра снова материализуется… в этот раз её лицо наполнено отчаянием, а руки распростёрты, как будто она к чему-то стремится. По мере того, как она проявляется, отчаяние на лице сменяется облегчением: «Любовь моя… ты вернулся ко мне! Может так быть, что к тебе вернулись воспоминания?»~ [DEN003A]
@717   = ~«Тогда всё так, как я и опасалась. Я действительно для тебя потеряна… и что было однажды для тебя неудобством, теперь является оправданием для отказа от меня, как и от памяти обо мне!»~
@718   = ~«Мне *кажется*, в памяти что-то всколыхнулось… расскажи мне больше. Возможно, твои слова прогонят тени из моей головы, Дейонарра».~
@719   = ~«Мне *кажется*, в памяти что-то всколыхнулось… расскажи мне больше. Возможно, твои слова прогонят тени из моей головы, Дейонарра».~
@720   = ~«„Неудобство“? „Отказ от тебя“? Я не знаю тебя, дух… у меня нет больше памяти. Скажи мне… кто ты? Что ты знаешь обо мне?»~
@721   = ~«Если я когда-то отказался от тебя, то, видимо, придётся это сделать опять. Прощай, дух».~
@722   = ~«Да… — в её глазах загорается надежда. — Какие воспоминания всколыхнуло моё имя?»~
@723   = ~«Я не уверен… но чувствую, как память немного проясняется, когда мы говорим. Расскажи мне больше. Возможно, твои слова прогонят теней из моей головы, Дейонарра».~
@724   = ~«Я не уверен… но чувствую, как память немного проясняется, когда мы говорим. Расскажи мне больше. Возможно, твои слова прогонят теней из моей головы, Дейонарра».~
@725   = ~Лицо Дейонарры искажает маска гнева: «Ты прокажённая собака! Предатель моего сердца! Я бы прокляла тебя, да только муки преследуют тебя в каждом воплощении и без моего проклятья! Изыди!» Она скрещивает руки и закрывает глаза.~
@726   = ~«О, наконец-то судьба смилостивилась! Даже смерть не может изгнать меня из твоих мыслей, Любовь моя! Разве ты не видишь? Твоя память должна вернутся! Скажи, как я могу помочь тебе, и я помогу!»~
@727   = ~Безымянный~
@728   = ~Анна~
@729   = ~«Ты знаешь, кто я?»~
@730   = ~«Можешь сказать мне, где я?»~
@731   = ~«Я должен выбраться из этого места. Не поможешь мне?»~
@732   = ~«Я должен выбраться из этого места. Не поможешь мне?»~
@733   = ~«Что ты желаешь знать?»~
@734   = ~«Кто ты?»~
@735   = ~«Можешь сказать мне, кто я?»~
@736   = ~«Можешь сказать мне, где я?»~
@737   = ~«Я должен выбраться из этого места. Не поможешь мне?»~
@738   = ~«Я должен выбраться из этого места. Не поможешь мне?»~
@739   = ~«Ты тот, кто одновременно благословлён и проклят, Любовь моя. И ты тот, кто никогда не покидает моих мыслей и моего сердца».~
@740   = ~«„Благословлён и проклят“? Что ты имеешь в виду?»~
@741   = ~«У меня к тебе другие вопросы…»~
@742   = ~«Я должен идти. Прощай, Дейонарра».~
@743   = ~«Где ты? Во имя сил… ты здесь, со мной, Любовь моя… как в те времена, когда мы оба были живы. Ныне Вечная Граница разделяет нас».~
@744   = ~«„Вечная Граница“?»~
@745   = ~«У меня к тебе другие вопросы…»~
@746   = ~«Я должен идти. Прощай, Дейонарра».~
@747   = ~«Ну и ладно…»~
@748   = ~«Природа твоего проклятья должна быть очевидна, Любовь моя. Посмотри на себя, — она указывает на тебя. — Смерть тебя не принимает. Воспоминания тебя покинули. Не задумывался, почему?»~
@749   = ~«На самом деле я всё ещё пытаюсь прийти в себя. Что ещё ты можешь рассказать обо мне?»~
@750   = ~«У меня другие вопросы…»~
@751   = ~«Помимо воспоминаний… допустим, смерть меня не принимает… но почему это проклятие?»~
@752   = ~Дейонарра выглядит опечаленной: «Этот барьер тебе никогда не переступить, Любовь моя. Барьер между твоей жизнью и тем, что осталось от моей…»~
@753   = ~«Ясно. Может, ты ответишь на другие вопросы…»~
@754   = ~«Проверка запасов»~
@755   = ~«Я должен идти. Прощай, Дейонарра».~
@756   = ~«Погоди… Я много узнала, пока путешествовала с тобой, Любовь моя. И то, что ты потерял, — я сохранила. Я раскрыла тебе не всё, что знаю. Я вижу ясно… тогда как ты ищешь в потёмках проблеск мысли».~
@757   = ~«Что бы ты ни знала, это может подождать. Прощай».~
@758   = ~«Что ты можешь сказать хоть сколько-нибудь мне интересное?»~
@759   = ~«И что такое ты видишь, чего не вижу я?»~
@760   = ~~
@761   = ~«Я должен идти. Прощай, Дейонарра».~
@762   = ~Дейонарра кажется растерянной, затем её тон меняется, а голос почти умоляет: «Я… не хотела вымогать с тебя клятву, Любовь моя. Просто я так долго ждала, когда ты воссоединишься со мной под…»~
@763   = ~«Если ты не хотела вымогать с меня клятву, Дейонарра, так не делай этого. Теперь скажи мне своё видение, и не будем больше возвращаться к клятвам и обещаниям».~
@764   = ~«Я должен идти, Дейонарра. Прощай».~
@765   = ~«Мне так много нужно узнать. У меня к тебе вопросы…»~
@766   = ~«У меня к тебе вопросы…»~
@767   = ~«Ещё не совсем. Прощай, Дейонарра».~
@768   = ~«Что это было за видение, о котором ты говорила?»~
@769   = ~«Время ослабляет хватку, пока холод забвения медленно поглощает нас, Любовь моя. Проблески вещей пока грядущих заполоняют мои видения. Я вижу тебя, Любовь моя. Я вижу тебя таким, какой ты сейчас, и…» — Дейонарра замолкает.~
@770   = ~«Почему ты замолчала? Твоя речь утомила тебя?»~
@771   = ~«Что? Что ты видишь?»~
@772   = ~«Мне неинтересны видения будущего. Прощай».~
@773   = ~«Я вижу то, с чем тебе предстоит столкнуться в будущем. Всё начинается отсюда и проходит сквозь планы. Мне рассказать о том, что я вижу?»~
@774   = ~«Расскажи».~
@775   = ~«Я не хочу знать. Будущее само откроется… со временем».~
@776   = ~«Ты всегда был таким, Любовь моя. Ты уже не обращаешь внимание на призывы смерти. Будет ли время следующим, что ты отвергнешь?» — она закрывает глаза и исчезает, оставляя лишь шелест эфира.~
@777   = ~«Сперва мне необходимо обещание. Обещание, что ты вернёшься. Что найдёшь способ меня спасти или воссоединиться со мной».~
@778   = ~«Мне трудно поверить, что женщина, которую я когда-то любил, вымогает у меня клятву с обещанием откровенности. Ты не веришь в меня, Дейонарра?»~
@779   = ~«Цена такого обещания слишком высока».~
@780   = ~Ложь: «Клянусь, я найду способ спасти тебя или воссоединиться с тобой».~
@781   = ~«Я не буду давать таких обещаний, призрак! Не дразни меня будущим… говори или исчезни!»~
@782   = ~«Я… сделаю, что смогу».~
@783   = ~Дейонарра скрещивает руки на груди. «Действительно, Любовь моя. Однако цена бессмертия, очевидно, была не слишком высокой. Честность выше твоих возможностей?»~
@784   = ~«Любовь моя, вот что видят мои глаза, освобождённые от оков времени…»~ [DEN020]
@785   = ~«Ты встретишь трёх врагов, но ни один из них не будет опаснее тебя во времена твоего расцвета. Это духи зла, добра и нейтральности, порождённые и связанные законами планов».~ [DEN021]
@786   = ~Ждать, когда она продолжит.~
@787   = ~Ждать, когда она продолжит.~
@788   = ~«Ты придёшь в тюрьму, выстроенную из скорби и сожалений, где даже тени сходят с ума. Там тебя попросят принести ужасную жертву, Любовь моя. Чтобы обрести покой, ты должен уничтожить то, что держит тебя в живых, тем самым потеряв бессмертие».~ [DEN022]
@789   = ~«„Уничтожить то, что держит меня в живых“?»~
@790   = ~«Я должен идти. Прощай, Дейонарра».~
@791   = ~«Я не подвергаю сомнению твою способность восставать из мёртвых. Я думаю, каждое новое воплощение ослабляет твои мысли и память. Ты говоришь, что потерял память. Возможно, это побочный эффект бесчисленных смертей? Если так, что ещё ты потеряешь в последующих смертях? Если потеряешь рассудок, то не будешь даже способным осознать, что ты бессмертен. И тогда ты будешь по-настоящему обречён».~
@792   = ~«Я должен идти. Прощай, Дейонарра».~
@793   = ~Дейонарра приходит в бешенство: «Так уходи, как не одну сотню раз прежде! Ты приходишь только помучить меня?! Покинь меня и не возвращайся!» Она закрывает глаза и исчезает, оставляя лишь шелест эфира.~
@794   = ~Уйти.~
@795   = ~«Я помню, однажды ты заявил, что любишь меня и будешь любить, пока смерть не заберёт нас обоих. Я верила в это, но не догадывалась, кем ты был… чем ты был».~
@796   = ~«У меня другие вопросы…»~
@797   = ~«И чем же?»~
@798   = ~«Прощай, Дейонарра».~
@799   = ~«Раньше мы уже говорили о твоей истиной природе, — лицо Дейонарры принимает отстранённое выражение. — Не будем возвращаться к этому снова».~
@800   = ~«Ладно… у меня другие вопросы…»~
@801   = ~«Ты утверждаешь, что знаешь меня, но, похоже, очень мало знаешь о моей истинной сущности. Прощай, Дейонарра».~
@802   = ~«Ты утверждаешь, что знаешь меня, но, похоже, очень мало знаешь о моей истинной сущности. Прощай, Дейонарра».~
@803   = ~Уйти.~
@804   = ~«Мне трудно поверить, что женщина, которую я когда-то любил, вымогает у меня клятву с обещанием откровенности. Ты не веришь в меня, Дейонарра?»~
@805   = ~Ложь: «Клянусь, я найду способ спасти тебя или воссоединиться с тобой».~
@806   = ~«Я не буду давать таких обещаний, призрак! Не дразни меня будущим… говори или исчезни!»~
@807   = ~«Я… сделаю, что смогу».~
@808   = ~Клятва: «Клянусь, я найду способ спасти тебя или воссоединиться с тобой».~
@809   = ~«Я знаю, что ты должен умереть… пока ещё можешь. Круг *должен* замкнуться, Любовь моя. Ты не предназначен для этой жизни. Ты должен найти то, что у тебя забрали, и пойти дальше, в земли мёртвых».~ [DEN023]
@810   = ~«„Пока ещё могу“?»~
@811   = ~«У меня другие вопросы…»~
@812   = ~«„Бесчисленные смерти“? Как долго это продолжается?»~
@813   = ~«Прощай, Дейонарра».~
@814   = ~«Точно я не скажу. Знаю только, что продолжается это достаточно долго».~
@815   = ~«У меня другие вопросы…»~
@816   = ~«Прощай, Дейонарра».~
@817   = ~«Порталы — это дыры в реальности, ведущие во внешние и внутренние планы… если бы ты смог найти правильный ключ, ты смог бы сбежать через один из них».~
@818   = ~«У меня другие вопросы…»~
@819   = ~«Ключ?»~
@820   = ~«Прощай, Дейонарра».~
@821   = ~Дейонарра замолкает на мгновенье, как будто пытается вспомнить: «Порталы откроются, когда у тебя будет правильный „ключ“. К сожалению, этими ключами может быть всё что угодно… эмоция, кусок дерева, кинжал из посеребрённого стекла, кусок одежды, напеваемая мелодия… Боюсь, лишь Пыльные знают ключи, с помощью которых ты смог бы покинуть их залы, Любовь моя».~
@822   = ~Прежде чем Морте заканчивает тираду, писарь заходится безудержным кашлем. Через некоторое время приступ кашля проходит, и дыхание писаря возвращается к своему обычному неровному похрипыванию.~
@823   = ~«Тогда я спрошу одного из них. Прощай, Дейонарра».~
@824   = ~«Ясно. У меня другие вопросы…»~
@825   = ~Опыт от убийств:~
@826   = ~Не успевает Морте договорить, серые глаза писаря щурятся в твою сторону. «Груз прожитых лет тяжело давит на меня, Беспокойный… — он опускает перо, — …но я ещё не начал считать глухоту одним из своих недугов».~
@827   = ~«„Беспокойный“? Ты меня знаешь?»~
@828   = ~Остатки тела накрыты окровавленными тряпками. Исходящее от трупа зловоние практически невыносимо.~
@829   = ~«Тебе знакома женщина, похороненная в мемориальном зале внизу? Думаю, в прошлом она путешествовала с тобой… — кажется, Дхалл снова собирается закашлять, но ему удаётся восстановить дыхание. — Я ошибаюсь?»~
@830   = ~«Да. Он отлично замаскировался».~
@831   = ~«Да. Он отлично замаскировался».~
@832   = ~Дхалл пристально на тебя смотрит: «Ты уверен?»~
@833   = ~«Я…» — Дхалл прерывается на очередной приступ кашля. Спустя минуту или две он восстанавливает дыхание достаточно, чтобы говорить: «Я… немедленно извещу стражу».~
@834   = ~«Нет, вообще-то, если задуматься, мне это просто показалось. У меня другие вопросы…»~
@835   = ~«Приветствую».~
@836   = ~«Спасибо. У меня другие вопросы…»~
@837   = ~«Отлично. Прощай».~
@838   = ~Этот писарь выглядит очень старым… его кожа морщиниста и отдаёт желтизной, словно старый пергамент. У него костлявое лицо с угольно-серыми глазами и длинная белая борода, ниспадающая по одеждам, подобно водопаду. Дыхание его неровное и прерывистое, но даже периодически пробивающийся кашель не замедляет работу пера.~
@839   = ~«Приветствую».~
@840   = ~«Знаю ли я тебя? Я… — голос писаря наполняется горечью. — Я *никогда* не знал тебя, Беспокойный. Не больше, чем ты знал себя сам». Он на мгновение замолкает. «Ведь ты забыл, не так ли?»~
@841   = ~Его серые глаза сверкают, когда он отрывает взгляд от книги. «Я подозревал, что ты имеешь отношение к беспорядкам в Мортуарии. Это… — он слегка кашляет, затем восстанавливает своё неровное дыхание. — Для тебя это не лучший способ войти в следующую жизнь».~
@842   = ~«Я просто защищал себя. У меня ещё есть вопросы, прежде чем я удалюсь…»~
@843   = ~«Я лишь дал им то, чего они сами хотели. Не вижу в этом преступления. У меня есть несколько вопросов…»~
@844   = ~Писарь перестаёт царапать в книге и поднимает взгляд. Его глаза — как два гвоздя, загнанные в череп. «Итак… — говорит он устало, как будто уже много раз повторял эти слова. — Ты пробудился от дрёмы и вернулся в свой сон». Он продолжает более почтительно: «Приветствую тебя, Беспокойный… снова».~
@845   = ~«„Беспокойный“? Ты знаешь меня?»~
@846   = ~«Как я попал сюда?»~
@847   = ~«Мы — Пыльные, фракция тех, кто признаёт иллюзорность этой жизни. Мы ждём следующей жизни и помогаем другим на их пути».~
@848   = ~«Истинная Смерть — это небытие. Состояние без причин, без чувств, без страсти, — Дхалл кашляет, затем восстанавливает неровное дыхание. — Состояние чистоты».~
@849   = ~«Разве это хуже, чем оставаться в тени того, что когда-то было жизнью? Я думаю, нет».~
@850   = ~«Дневник? Если он представляет хоть какую-то ценность, то он, скорее всего, в руках Фарода».~
@851   = ~«Ты должен понимать. Для нас, Пыльных, сам факт твоего существования — богохульство. Многие из нашей фракции распорядились бы предать тебя кремации… если бы узнали о твоих страданиях».~
@852   = ~«Хорошо. Что ты хочешь знать?»~
@853   = ~«А почему ты думаешь, что эта жизнь *настоящая*? Загляни внутрь себя. Разве ты не чувствуешь какую-то опустошённость? — Дхалл качает головой. — Это чистилище. Здесь есть только горе. Нужда. Муки. Это не те элементы, что составляют „жизнь“. Они — часть той клетки, что держит нас в этой тени».~
@854   = ~«Ты знаешь, что здесь в восточных комнатах есть некто, замаскированный под зомби?»~
@855   = ~«Как я попал сюда?»~
@856   = ~Засохшая кровь покрывает поверхность плиты.~
@857   = ~«Что это за место?»~
@858   = ~«Не подскажешь мне, как отсюда выбраться?»~
@859   = ~«Ты в Мортуарии, Беспокойный. Снова ты… пришёл…» — Дхалл закашливается, не успев закончить фразу. Через мгновение он успокаивается и его дыхание возвращается к своему обычному неровному похрипыванию: «…это зал ожидания для тех, кто должен покинуть тень этой жизни».~
@860   = ~«*Беспокойный*?»~
@861   = ~«Расскажи мне о Мортуарии».~
@862   = ~«Тень этой жизни?»~
@863   = ~«Снова?.. Я здесь не в первый раз?»~
@864   = ~«Как я попал сюда?»~
@865   = ~«У меня другие вопросы…»~
@866   = ~«Прощай, Дхалл».~
@867   = ~Когда ты собираешься уходить, Дхалл говорит: «Знай, я не завидую тебе, Беспокойный. Раз за разом возрождаться — это проклятие, которое я не смог бы перенести. Тебе придётся ужиться с этим. Однажды твой жизненный путь вновь приведёт тебя сюда…» Дхалл кашляет, из его горла вырывается рычащий звук: «Таков путь всех существ из плоти и костей».~
@868   = ~«Несомненно, они здесь, но я не знаю ни их имён, ни где они лежат. Подобные тебе оставляют за собой дорогу, по которой многие идут, но немногие выживают, — Дхалл указывает вокруг тебя. — Все мёртвые поступают сюда. Некоторые из них, должно быть, когда-то путешествовали вместе с тобой».~
@869   = ~Повязки, покрывающие это тело, пропитаны кровью. Несмотря на то, что трупу на вид уже несколько дней, кровь всё ещё сочится из его ран.~
@870   = ~«Где та женщина, которую ты упомянул?»~
@871   = ~«Я не нахожу изъянов в твоих рассуждениях. Однако у меня другие вопросы…»~
@872   = ~«Тогда я поищу их. Может, они прояснят мою память. Прощай».~
@873   = ~«Я не уверен, что она достигла Истинной Смерти. Прощай, Дхалл».~
@874   = ~«Ясно. Прощай, Дхалл».~
@875   = ~«Хм-м… парадные врата — это самый очевидный выход, но там никого не пропускают, кроме Пыльных… — Дхалл снова закашливается, затем продолжает: — У одного из гидов рядом с парадным входом есть ключ к вратам, но вряд ли он откроет их для тебя, если только ты не будешь крайне убедительным».~
@876   = ~«Ясно. У меня другие вопросы…»~
@877   = ~«Тогда прощай, Дхалл».~
@878   = ~«Да, *снова*. Тебя доставляли сюда много раз, Беспокойный. Глядя на твои раны, я надеялся, что этот раз будет последним. — он вздыхает. — Когда же ты откажешься от своих страстей и покинешь эту тень жизни?»~
@879   = ~«Расскажи мне побольше о Мортуарии».~
@880   = ~«*Беспокойный*?»~
@881   = ~«Раны?»~
@882   = ~Исходящее от трупа зловоние в прямом смысле вызывает тошноту. Кто-то вскрыл грудную клетку тела, но ещё не удалил внутренние органы.~
@883   = ~«Тень жизни?»~
@884   = ~«Ты будешь делать то, что всегда делал, Беспокойный. Искать этого хитрожопого придурка Червеголового и просить его вернуть то, что принадлежит тебе. Затем ты возобновишь свои поиск без цели, пытаясь выполнить невыполнимые задания, собрать бессмысленные вещи, затем будешь вновь сражён и попадёшь к нам. Сохрани время и поговори со мной сейчас, чтобы нам не пришлось возобновлять этот разговор, когда ты снова потеряешь память».~
@885   = ~Дхалл презрительно фыркает, будто находит эти воспоминания отвратительными. «Твоя заплесневелая колесница доставила тебя в Мортуарий, Беспокойный. Ты мог бы вообразить себя королевской особой, увидев количество гниющих и зловонных подданных на доставившей тебя повозке».~
@886   = ~«Меня привезли сюда в повозке?»~
@887   = ~«Расскажи мне побольше о Мортуарии».~
@888   = ~«У меня другие вопросы…»~
@889   = ~«Прощай, Дхалл».~
@890   = ~«Да… твоё тело было где-то в середине горы трупов, источающей миазмы, — Дхалл снова сильно закашливается, затем наконец переводит дыхание. — Твоим „сенешалем“, как всегда, выступал Фарод, который был рад за несколько медяков сбросить твоё тело в кучу около ворот Мортуария».~
@891   = ~«Кто этот Фарод?»~
@892   = ~«Звучит так, будто ты не очень любишь Фарода».~
@893   = ~«Расскажи мне побольше о Мортуарии».~
@894   = ~«У меня другие вопросы…»~
@895   = ~«Он… сборщик мёртвых, — Дхалл переводит дыхание, затем продолжает. — В нашем городе есть люди, которые собирают тела тех, кто прошёл по пути Истинной Смерти, и доставляют их нам для подобающего погребения».~
@896   = ~~
@897   = ~«Где я могу найти этого „Фарода“?»~
@898   = ~«Звучит так, будто ты не очень любишь Фарода».~
@899   = ~«Расскажи мне побольше о Мортуарии».~
@900   = ~«Если всё пойдёт своим чередом, Беспокойный, то скорее он найдёт тебя и доставит сюда снова, чем ты обнаружишь ту гнилую яму, в которой он сейчас затаился».~
@901   = ~Оттенок предупреждения слышится в голосе Дхалла: «Не ищи Фарода, Беспокойный. Я уверен, что всё снова пойдёт по кругу, ты не станешь мудрее, а Фарод вновь обогатится на несколько медяков. Прими смерть, Беспокойный. Не повторяй круг своих несчастий!»~
@902   = ~«Тем не менее я должен его найти».~
@903   = ~«Расскажи мне побольше о Мортуарии».~
@904   = ~«Ясно. У меня другие вопросы…»~
@905   = ~«Расскажи мне побольше о Мортуарии».~
@906   = ~«Я *должен* его найти. Ты знаешь, где он?»~
@907   = ~«У меня другие вопросы…»~
@908   = ~Дхалл на мгновенье умолкает. Когда он заговаривает вновь, кажется, будто делает это неохотно: «Я не знаю, в какой сточной канаве сейчас затаился Фарод, но мне представляется, что его можно найти где-то за воротами Мортуария, в Улье. Возможно, там кто-нибудь знает, где его найти».~
@909   = ~«Не расскажешь мне побольше о Мортуарии?»~
@910   = ~«Звучит так, будто ты не очень любишь Фарода».~
@911   = ~«Расскажи мне побольше о Мортуарии».~
@912   = ~(Должностное лицо.)~
@913   = ~«У меня другие вопросы…»~
@914   = ~«Я слишком мало знаю о тебе, Беспокойный. Немного больше знаю о тех, кто когда-то путешествовал с тобой и кто теперь лежит в наших владениях. — Дхалл вздыхает. — Прошу тебя, Беспокойный, не предлагай больше никому присоединиться к тебе: по твоему пути следуют несчастья. Пусть твоё бремя будет только твоим».~
@915   = ~Дхалл вздыхает: «Говорят, есть души, которые никогда не познают Истинную Смерть. Смерть изгнала их, и их имена никогда не будут вписаны в книгу мёртвых. Твоё пробуждение после смерти… предполагает, что ты одна из таких душ. Само твоё существование неприемлемо для нашей фракции».~
@916   = ~«Забудь. Я должен идти. Прощай».~
@917   = ~«„Неприемлемо“? Похоже, я нахожусь не в лучшем положении».~
@918   = ~«Ясно. Расскажи мне побольше о Мортуарии».~
@919   = ~«У меня другие вопросы…»~
@920   = ~«Я услышал достаточно. Прощай, Дхалл».~
@921   = ~«Кто-то ещё путешествовал со мной ранее? Они здесь?»~
@922   = ~«У меня другие вопросы…»~
@923   = ~«Прощай, Дхалл».~
@924   = ~«Несправедливо навязывать тебе нашу веру насильно. Ты должен отказаться от этой тени жизни по собственной воле, а не по принуждению, — Дхалл, кажется, вот-вот вновь закашляется, но ему с некоторыми усилиями удаётся сдержаться. — И покуда я остаюсь на своём посту, я буду защищать твоё право на поиски собственной правды».~
@925   = ~«Хорошо. У меня другие вопросы…»~
@926   = ~Судя по зловонию, сюда выкидывают внутренности выпотрошенных трупов.~
@927   = ~«Какова твоя должность?»~
@928   = ~«Расскажи мне побольше о Мортуарии».~
@929   = ~«Я составляю каталог тех, кто попал в наши залы, Беспокойный, — Дхалл закашливается, затем приходит в себя. — Только я вижу лица тех, кто лежит на наших плитах. Я буду хранить тайну твоего существования».~
@930   = ~«Я писарь, составитель каталога всех оболочек, попадающих в Мортуарий, — Дхалл снова кашляет, затем глубоко вздыхает. — Пока поток мёртвых проходит через Мортуарий, я должен оставаться на своём посту».~
@931   = ~«Ты сказал, что я здесь не в первый раз. Тогда почему Пыльные меня не узнают?»~
@932   = ~«Расскажи мне побольше о Мортуарии».~
@933   = ~«Ясно. У меня другие вопросы…»~
@934   = ~«Я близок к Истинной Смерти, Беспокойный. Уже скоро я пересеку Вечную Границу и обрету покой, который искал. Я устал от этой смертной сферы… — Дхалл неровно вздыхает. — Для такого, как я, на планах больше нет чудес».~
@935   = ~«Вечная Граница?»~
@936   = ~«Ты уверен? Может, я как-нибудь могу тебе помочь?»~
@937   = ~«У меня другие вопросы…»~
@938   = ~«Я не хочу ни жить вечно, ни жить снова, Беспокойный. Я этого не вынесу».~
@939   = ~«Она *говорила* с тобой? — Голос Дхалла падает до шёпота. — Тебя *лихорадит*, Беспокойный? Она достигла Истинной Смерти и ушла туда, где недосягаема для тебя».~
@940   = ~«Ты Пыльный. Но, похоже, не выступаешь за моё убийство. Почему?»~
@941   = ~Дхалл замолкает в раздумьях. «Весьма вероятно. Ты что-то потерял… что-то особенно ценное? — он хмурится и понижает голос. — Фарод не стал бы делать исключений ни для чего, разве только оно вживлено в твоё тело. Хотя и это иногда не останавливает его жадную натуру».~
@942   = ~«Я потерял дневник».~
@943   = ~«Хм. Не знаешь, где мне найти Фарода?»~
@944   = ~«У меня другие вопросы…»~
@945   = ~Дхалл пальцем описывает полукруг в воздухе перед собой. «Это плохой знак, Беспокойный. Молюсь, чтобы тебе этот разговор только привиделся… и всё же боюсь, что нет».~
@946   = ~«Может, и привиделось. У меня есть ещё вопросы».~
@947   = ~«Возможно, мы ещё поговорим об этом чуть позже. Прощай, Дхалл».~
@948   = ~«Где мне найти Фарода?»~
@949   = ~«Ясно. У меня другие вопросы…»~
@950   = ~«Сюда доставляют умерших в Сигиле для погребения или кремации. Наша обязанность как Пыльных — уход за мёртвыми, за теми, кто покинул эту тень жизни и пошёл по пути Истинной Смерти, — голос Дхалла беспокойно понижается. — У тебя, должно быть, были слишком серьёзные раны, если ты не узнаёшь это место. Это почти твой дом».~
@951   = ~«Тень жизни?»~
@952   = ~Это белое как мел тело было полностью обескровлено и обработано жидкостью для бальзамирования. Аккуратный шов проходит по груди трупа.~
@953   = ~«Истинная Смерть?»~
@954   = ~«Пыльные?»~
@955   = ~«Сигил?»~
@956   = ~«Раны?»~
@957   = ~«Да, тень. Видишь ли, Беспокойный, эта жизнь… ненастоящая. Твоя жизнь, моя жизнь — лишь тени, отражения того, что когда-то было настоящей жизнью. „Жизнью“, что предрешена нам *после* смерти. Здесь же мы пребываем… в западне. В клетке. До тех пор, пока не сможем достичь Истинной Смерти».~
@958   = ~«Истинная Смерть?»~
@959   = ~«Почему ты думаешь, что эта жизнь ненастоящая?»~
@960   = ~«Прощай, Дхалл».~
@961   = ~«Да, раны, что украшают твоё тело… по виду — и гораздо меньшее их количество отправило бы человека по пути Истинной Смерти, однако похоже, что многие из них уже зажили, — Дхалл заходится в кашле, затем успокаивает дыхание. — Но это только поверхностные раны».~
@962   = ~«Есть те, кого я уважаю, Беспокойный, — Дхалл тяжело закашливается, затем приходит в себя. — Фарод к ним не относится. Он носит свою дурную репутацию, как будто это большая честь, и позволяет себе забирать вещи мёртвых. Он — рыцарь наживы, подлец низшего сорта».~
@963   = ~«„Рыцарь наживы“?»~
@964   = ~«Не знаешь, где мне найти Фарода?»~
@965   = ~«Ясно. У меня другие вопросы…»~
@966   = ~«Рыцарь наживы… — Дхалл кашляет, — …вор. Все те, кого Фарод приносит к нашим стенам, лишены даже малейшего имущества, каковым обладали при жизни. Фарод берёт всё, что только может вырвать из их окоченевших пальцев».~
@967   = ~«Мог ли Фарод взять что-нибудь и у *меня*?»~
@968   = ~«Не знаешь, где мне найти Фарода?»~
@969   = ~«Ясно. У меня другие вопросы…»~
@970   = ~«Сигил — это наш прекрасный город, Беспокойный».~
@971   = ~«Расскажи мне побольше о Мортуарии».~
@972   = ~«Ясно. У меня другие вопросы…»~
@973   = ~«Беспокойный — такое же хорошее определение, как и любые другие… — Дхалл переводит дыхание. — Нечто держит тебя здесь, не так ли? Нечто, что должно быть решено, какая-то страсть, которая должна быть погашена, прежде чем ты сможешь достичь Истинной Смерти?»~
@974   = ~«Истинная Смерть?»~
@975   = ~«Расскажи мне побольше о Мортуарии».~
@976   = ~«У меня другие вопросы…»~
@977   = ~«Прощай, Дхалл».~
@978   = ~Дхалл поднимает взгляд, когда ты подходишь. «Итак. Ты вернулся…» — Дхалл переводит дыхание, затем тяжело закашливается. Через минуту кашель проходит, и к нему возвращается его хриплое дыхание: «…приветствую тебя снова, Беспокойный».~
@979   = ~«У меня есть ещё вопросы, Дхалл».~
@980   = ~«Не бери в голову. Прощай».~
@981   = ~«Она говорила со мной, Дхалл. Её дух был здесь».~
@982   = ~«Возможно, мне и показалось. У меня есть ещё вопросы…»~
@983   = ~«Граница между тенью этой жизни и Истинной Смертью».~
@984   = ~«Тень этой жизни?»~
@985   = ~«Истинная Смерть?»~
@986   = ~«Эй, шеф. Ты в порядке? Притворяешься трупом или просто пудришь мозги Пыльникам? Я уж было подумал, что ты совсем дал дуба».~
@987   = ~«Ты кто?»~
@988   = ~Глубоко вздохнуть и проигнорировать заговоривший с тобой череп.~
@989   = ~Игнорировать череп и исследовать комнату.~
@990   = ~«Я? — похоже, череп возмущён. — Может, лучше *ты* начнёшь, разрисованный? Кто ты?»~
@991   = ~Игнорировать череп и исследовать комнату.~
@992   = ~«Я… не знаю».~
@993   = ~«Я первый спросил».~
@994   = ~Игнорировать череп и исследовать комнату.~
@995   = ~«Я не знаю… никак не могу вспомнить».~
@996   = ~«О, так *теперь* ты хочешь снова поговорить с Морте, а?»~
@997   = ~«Не знаешь, кто ты? Хе! *Мог* бы просто сказать: „Отвали, дурная башка“. Ну ладно, всё нормально… притворяешься дурнем. Хорошо, сделаю вид, что мне плевать. Я Морте. Приветствую, рад видеть и всё такое».~
@998   = ~«Где я, Морте?»~
@999   = ~«Не можешь *вспомнить*? Весёленькая ночка выдалась, ага? Надеюсь, никого не зашиб. Меня звать Морте. Привет, рад знакомству и всё такое, — он на миг прерывается. — Слушай, я *должен* спросить: ты один из этих Чующих, которые себя так увечат, или кто-то другой так тебя отделал, что остались эти шрамы?»~
@1000  = ~«Чующих?»~
@1001  = ~«Шрамы?»~
@1002  = ~Игнорировать Морте и исследовать комнату.~
@1003  = ~«Ага, а я спросил вторым. Так как тебя зовут?»~
@1004  = ~«Я… не знаю».~
@1005  = ~«Я не знаю… не могу вспомнить».~
@1006  = ~«Не знаешь, как я могу отсюда выбраться?»~
@1007  = ~«Ты первый, череп».~
@1008  = ~«Мужик, да ты тугой, как мокрая верёвка. Ладно, ладно… среди нас двоих *я* буду хорошим парнем. Я Морте. Морте Зубоскал. А какому имени не повезло иметь такого владельца как ты?»~
@1009  = ~«Я… не знаю».~
@1010  = ~«Я не знаю… никак не могу вспомнить».~
@1011  = ~Игнорировать Морте и исследовать комнату.~
@1012  = ~«Ты в дыре, которая называется Мортуарий… это такое большое чёрное сооружение с архитектурным очарованием беременной паучихи».~
@1013  = ~«„Мортуарий“? Я мёртв?»~
@1014  = ~«Ну, этого я не знаю… но Мортуарий — это единственная похожая на морг штука, которую ты сможешь найти в этих краях. Сюда тащат всех мертвецов, хоронят их, сжигают. А если тебе *действительно* повезёт, то вернёшься к жизни в качестве раба. Не самое лучшее место на планах. На твоём месте, я бы откопал ближайший выход и удрал бы, пока ещё в состоянии ходить».~
@1015  = ~«Как мне отсюда выбраться?»~
@1016  = ~«Прости… „Мортуарий“? Что это за место?»~
@1017  = ~«„Вернёшься к жизни в качестве раба“?»~
@1018  = ~«Пока ещё в состоянии ходить?»~
@1019  = ~«Говоришь, сюда собирают всех мертвецов? Я попал сюда так же?»~
@1020  = ~Игнорировать Морте и исследовать комнату.~
@1021  = ~Он выдерживает паузу. «Полагаю, да. Может, какой-то придурок посчитал тебя трупаком и подкинул сюда. Твоё тело и *меня* одурачило… может, тебе следует найти пня, который тебя сюда притащил, и задать вопросы *ему*, а? — Морте кивает. — Неплохо соображаешь для недавнего трупа… рад, что твоя твои мозги ещё на месте».~
@1022  = ~«О да. Это очаровательная жизнь… только надо обрабатывать формальдегидом и пришивать свои конечности, когда они отваливаются, а так — просто рай».~
@1023  = ~«Э-э… как я и сказал, Мортуарий. Ты в порядке, шеф? Не очень хорошо выглядишь».~
@1024  = ~«Шеф, я видел, как ты сползал со своей плиты. Ты выглядел, как с большого похмелья, если понимаешь, о чём я».~
@1025  = ~«Ты не знаешь, кто такие Чующие? Ох, ну тебе и доста-алось! Это группа любителей приключений, которые хотят испробовать на себе всё, что только могут предложить планы, включая даже… э-э, не бери в голову. Что насчёт этих шрамов?»~
@1026  = ~«Кажется, какой-то бандит разрисовал тебя ножиком. Ты весь в шрамах… они даже на спине, кроме… — он замолкает. — Гляди-ка, приятель, у тебя сзади прямо галерея татуировок. И там что-то написано…»~
@1027  = ~«Шрамов?»~
@1028  = ~«Забудь. У меня другие вопросы…»~
@1029  = ~«Зачем кому-то понадобилось тащить меня сюда?»~
@1030  = ~«У меня другие вопросы…»~
@1031  = ~«Некоторые собирают по улицам трупы и продают их здесь за медяки. Не слишком хороший способ сводить концы с концами, но когда живёшь в самом отстойнике планов, выбор, на самом деле, не велик».~
@1032  = ~«За что продают?»~
@1033  = ~«Неважно. У меня другие вопросы…»~
@1034  = ~«Э-э… это деньги. Разве там, откуда ты взялся, их нет?»~
@1035  = ~«Я не помню, откуда я».~
@1036  = ~«Забудь. У меня другие вопросы…»~
@1037  = ~Он выдерживает паузу. «Не знаю. Ты *говоришь* со мной… здешние ходячие мертвецы обычно этого не делают. Насколько я понимаю, Пылюки ошиблись, и ты не был мёртв. Ты подписывал какой-нибудь договор, не помнишь? В смысле, они обычно заполняют кучу официальных бумажек, прежде чем вычеркнуть кого-либо из книги мёртвых».~
@1038  = ~«Э-э… договор? Нет, не помню, чтобы я что-либо подписывал. Я… многое не помню».~
@1039  = ~«Книга мёртвых?»~
@1040  = ~«Официальных бумажек?»~
@1041  = ~«Забудь. У меня другие вопросы…»~
@1042  = ~«Да, „книга мёртвых“. Знаешь такую? Хм, наверно, нет. Ладно, забудь о „книге мёртвых“. Ты жив, значит, ты не в ней».~
@1043  = ~«Ага, ты же не хочешь сломать всю систему? Закон — основа Сигила, ты не можешь даже облегчиться, пока не заполнишь кое-какие бумажки».~
@1044  = ~«Всеми богами и их матерями, *ты* явно не в себе. Есть хоть какие-нибудь идеи, откуда ты? Может, у народа Бестолковых пропал их король? Ты что, показал какому-нибудь богу кукиш или всегда был таким несведущим?»~
@1045  = ~«Шеф, у меня нет никаких грёбаных мыслей по этому поводу. Но ты круто притворялся мёртвым. Пока ты там лежал, я не видел, чтобы у тебя шевелилась грудь, моргали глаза… ничего. Ты что, перепил? Я угадал?»~
@1046  = ~«Что ж, *это* — хороший вопрос. Время бежит, шеф. Пыльные найдут тебя и попытаются с помощью крематория решить твои „проблемы“ с оживанием. А если ты будешь продолжать строить из себя мертвеца, то тоже рано или поздно попадёшь в печку. Не очень-то выбор, а? Так что будем делать?»~
@1047  = ~«Пыльные?»~
@1048  = ~«Я… сбегу».~
@1049  = ~«Я объясню ситуацию этим… Пыльным».~
@1050  = ~«Так что же мне делать?»~
@1051  = ~«Может, ты мне скажешь? Кажется, у тебя уже есть ответ».~
@1052  = ~«О, *хорошая* мысль, шеф! Почему *я* об этом не подумал? Как ты сбежишь, а? Я дам тебе подсказку: нам необходимо сотрудничество».~
@1053  = ~«Интересно. Продолжай».~
@1054  = ~«Забудь. У меня другие вопросы…»~
@1055  = ~«Как по мне, тебе явно нужно отсюда выбраться. Я-то могу позволить себе ждать. Единственная опасность для *меня* — умереть от скуки. Мы могли бы протянуть друг другу руку помощи».~
@1056  = ~~
@1057  = ~«Договорились».~
@1058  = ~«Продолжай…»~
@1059  = ~«У тебя нет рук. Как *ты* можешь мне помочь?»~
@1060  = ~«Забудь. У меня другие вопросы…»~
@1061  = ~«Может, ты так и не считаешь, но я могу помочь тебе выбраться отсюда, и ты мне можешь помочь в том же. У меня нет рук, так что я в затруднительном положении. У тебя непорядок в черепушке, а у меня громадный жизненный опыт, и я знаю, как тебя отсюда вытащить. Давай сотрудничать — две головы лучше, чем одна. По рукам, приятель?»~
@1062  = ~«Договорились. У меня нехорошее чувство, что судьбой нам назначено путешествовать вместе, Морте».~
@1063  = ~«Забудь. У меня другие вопросы…»~
@1064  = ~«О, *отличная* мысль, шеф! Почему *я* до этого не додумался? — в его голосе слышится издёвка. — „Господин Пыльный, тут такое дело, я умер и очнулся на плите в вашем маленьком Мортуарии. Не могли бы вы мне помочь?“ Они тебе точно помогут. Они посмотрят на тебя пару секунд, позовут стражу и отправят в персональную печь».~
@1065  = ~«Звучит немного чересчур… зачем им это делать?»~
@1066  = ~«Ну что ж, их страже надо быть очень крутой, чтобы меня взять».~
@1067  = ~«Забудь. У меня другие вопросы…»~
@1068  = ~«Доверься мне… неважно, каким крутым ты себя считаешь или что ты им скажешь, — они тебя схватят. Ты недостаточно силён, чтобы пробиться сквозь стены гробницы или пережить жар плана Огня. Уже само твоё воскрешение после смерти насторожит местных смотрителей. Не будь идиотом».~
@1069  = ~«Ну и каков твой план?..»~
@1070  = ~«Неважно. У меня другие вопросы…»~
@1071  = ~«Судьба может испоганить всё, что тебе дорого. Слушай, шеф. Обрати внимание, как часто слова „плохое“ и „судьба“ встречаются в одном предложении, и ты поймёшь одну из маленьких жизненных тайн. Лучше всего послать судьбу куда подальше; *всегда* есть выбор, не предусмотренный судьбой».~
@1072  = ~«Ладно, давай-ка уже свалим отсюда. Двери заперты, так что нам нужен ключ. По всей вероятности, он есть у одного из ходячих трупов в этой комнате».~
@1073  = ~«Буду иметь в виду».~
@1074  = ~«Хватит болтать. Каков твой план?»~
@1075  = ~«Кто ты?»~
@1076  = ~«Где я?»~
@1077  = ~«Не знаешь, как я могу отсюда выбраться?»~
@1078  = ~«Как я попал сюда?»~
@1079  = ~«Ходячих трупов?»~
@1080  = ~«Как я попал сюда?»~
@1081  = ~Игнорировать Морте и исследовать комнату.~
@1082  = ~«Пыльные? Они приглядывают за этим местом. Ты их не пропустишь… они одержимы всем чёрным, а их лица — как трупное окоченение. Называют себя „Пыльными“ и делают вид, что они фракция, на деле всего лишь куча мерзких сектантов смерти с мозгами набекрень. Избегай их».~
@1083  = ~«Так как мне отсюда выбраться?»~
@1084  = ~«Неважно. У меня другие вопросы…»~
@1085  = ~Игнорировать Морте и исследовать комнату.~
@1086  = ~Игнорировать Морте и исследовать комнату.~
@1087  = ~Игнорировать Морте и исследовать комнату.~
@1088  = ~«И что там написано?»~
@1089  = ~«Неважно. У меня другие вопросы…»~
@1090  = ~Игнорировать Морте и исследовать комнату.~
@1091  = ~«Да? И какие же?»~
@1092  = ~«Кто ты?»~
@1093  = ~«Где я?»~
@1094  = ~«Как я попал сюда?»~
@1095  = ~«Как мне отсюда выбраться?»~
@1096  = ~Игнорировать Морте и исследовать комнату.~
@1097  = ~«Я не знаю… не могу ничего вспомнить».~
@1098  = ~«Неважно. У меня другие вопросы…»~
@1099  = ~Игнорировать Морте и исследовать комнату.~
@1100  = ~«Ты *ничего* не помнишь? Да ладно мне это дерьмо танар'ри грузить. Ты серьёзно?»~
@1101  = ~«Да».~
@1102  = ~«Неважно. У меня другие вопросы…»~
@1103  = ~Игнорировать Морте и исследовать комнату.~
@1104  = ~«Всеми богами и их матерями… что ж, шеф, скорее всего, твоя память просто потонула где-то у тебя в черепушке. Чуть-чуть удачи — и вскоре она всплывёт, уж поверь мне. Остаётся надеяться, что ты никому не навредил и не нахватался проблем с законом… Кстати говоря, ты один из этих Чующих, которые себя увечат, или кто-то другой оставил тебе эти шрамы?»~
@1105  = ~«Чующих?»~
@1106  = ~«Шрамы?»~
@1107  = ~«У меня другие вопросы…»~
@1108  = ~Игнорировать Морте и исследовать комнату.~
@1109  = ~«С какой радости я здесь? Я мёртв?»~
@1110  = ~«И *как* я выгляжу? Насколько серьёзны шрамы?»~
@1111  = ~«Неважно. У меня другие вопросы…»~
@1112  = ~Игнорировать Морте и исследовать комнату.~
@1113  = ~«А я с какой радости здесь? Я мёртв?»~
@1114  = ~«Как я выгляжу? Шрамы серьёзные?»~
@1115  = ~«Неважно. У меня другие вопросы…»~
@1116  = ~Игнорировать Морте и исследовать комнату.~
@1117  = ~«Похоже на указания… — Морте кашляет, делая вид, что прочищает горло. — Давай поглядим. Начинается с…»

«Я знаю, ты чувствуешь себя так, будто нахлебался мутных вод Стикса, но тебе нужно собраться. Среди твоих вещей должен быть ДНЕВНИК, который прольёт немного света на это тёмное дело. ФАРОД расскажет тебе оставшуюся часть истории, если, конечно, он ещё не попал в книгу мёртвых.

Не потеряй этот дневник, иначе мы снова погрузимся в воды Стикса. Что бы ты ни делал, НИКОГДА никому НЕ говори, КТО ты или ЧТО с тобой случилось, иначе они устроят тебе скорое паломничество в крематорий. Сделай, как я сказал: ПРОЧТИ дневник, а затем НАЙДИ Фарода».~
@1118  = ~«Неудивительно, что спина так болит. Знаешь кого-нибудь по имени Фарод?»~
@1119  = ~«Не видел у меня дневник, когда я здесь лежал?»~
@1120  = ~«Не знаешь, как я могу отсюда выбраться?»~
@1121  = ~«У меня другие вопросы…»~
@1122  = ~Игнорировать Морте и исследовать комнату.~
@1123  = ~«Нет… тебя обобрали до нитки, когда ты попал сюда. И вообще, у тебя и так уже вроде целый дневник на спине написан».~
@1124  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@1125  = ~«Как мне отсюда выбраться?»~
@1126  = ~«Неважно. У меня другие вопросы…»~
@1127  = ~Игнорировать Морте и исследовать комнату.~
@1128  = ~«Такого не знаю. И вообще, круг знакомых у меня невелик. Хотя наверняка мы натолкнёмся на какого-нибудь дурня, который знает, где найти этого парня… как только выберемся отсюда».~
@1129  = ~«У меня был дневник, когда я здесь лежал?»~
@1130  = ~«Как мне отсюда выбраться?»~
@1131  = ~«Неважно. У меня другие вопросы…»~
@1132  = ~Игнорировать Морте и исследовать комнату.~
@1133  = ~«Неужели я мёртв? И поэтому здесь?»~
@1134  = ~«Насколько плохо я выгляжу?»~
@1135  = ~«Неважно. У меня другие вопросы…»~
@1136  = ~Игнорировать Морте и исследовать комнату.~
@1137  = ~Игнорировать Морте и исследовать комнату.~
@1138  = ~Игнорировать Морте и исследовать комнату.~
@1139  = ~«Я не знаю… не могу ничего вспомнить».~
@1140  = ~«Неважно. У меня другие вопросы…»~
@1141  = ~Игнорировать Морте и исследовать комнату.~
@1142  = ~Игнорировать Морте и исследовать комнату.~
@1143  = ~Игнорировать Морте и исследовать комнату.~
@1144  = ~Игнорировать Морте и исследовать комнату.~
@1145  = ~Игнорировать Морте и исследовать комнату.~
@1146  = ~Игнорировать Морте и исследовать комнату.~
@1147  = ~«Нет, спасибо. От твоей трескотни голова раскалывается. Я найду способ выбраться отсюда».~
@1148  = ~Игнорировать Морте и исследовать комнату.~
@1149  = ~Игнорировать Морте и исследовать комнату.~
@1150  = ~Игнорировать Морте и исследовать комнату.~
@1151  = ~«Что это за официальные… бумажки… о которых ты упомянул?»~
@1152  = ~«У меня другие вопросы…»~
@1153  = ~Игнорировать Морте и исследовать комнату.~
@1154  = ~«Что ты говорил о „книге мёртвых“?»~
@1155  = ~«Неважно. У меня другие вопросы…»~
@1156  = ~Игнорировать Морте и исследовать комнату.~
@1157  = ~«Тогда прощай».~
@1158  = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@1159  = ~Этот труп не отвечает. Кажется, он находится слишком далеко отсюда, чтобы ответить.~
@1160  = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@1161  = ~Оставить труп в покое.~
@1162  = ~Этот скелет не отвечает. Кажется, он слишком далеко отсюда, чтобы ответить на твои вопросы.~
@1163  = ~Оставить скелет в покое.~
@1164  = ~«Никак не пойму, зачем тебе халат? Скрывать-то под ним вроде уже нечего».~
@1165  = ~«Давно тут стоишь? Очень давно?»~
@1166  = ~Кажется, этот скелет слишком давно мёртв, чтобы отвечать на твои вопросы. Или так, или его голова слишком высоко, чтобы тебя слышать.~
@1167  = ~Осторожно осмотреть гигантского скелета.~
@1168  = ~«Что это за место?»~
@1169  = ~«У меня кое-какие вопросы…»~
@1170  = ~Оставить её в покое.~
@1171  = ~Пыльная подпрыгивает от неожиданности, затем резко поворачивается в твою сторону. Она выглядит потрясённой — у тебя, должно быть, отличная маскировка.~
@1172  = ~Воспользоваться неожиданностью и сломать ей шею, прежде чем она закричит.~
@1173  = ~Большой гехрелет~
@1174  = ~«У меня кое-какие вопросы».~
@1175  = ~Быстро уйти.~
@1176  = ~Пыльная делает шаг назад, затем трижды звонко хлопает в ладоши. В ответ в Мортуарии начинает звонить большой железный колокол.~
@1177  = ~Эта бледнолицая женщина одета в длинные тёмные одежды. От неё немного пахнет плесенью. Выражение лица у неё отсутствующее, она выглядит поглощённой своими заботами.~
@1178  = ~Пыльная медленно поднимает голову и поворачивается к тебе: «Ты потерялся?»~
@1179  = ~«Я позову стражу, чтобы тебя проводили к выходу. Подожди минутку».~
@1180  = ~«Если ты не потерялся, что тогда тебе здесь надо?»~
@1181  = ~«Боюсь, касается. Может, стража развяжет тебе язык», — Пыльная отступает в сторону; кажется, она собирается позвать стражу.~
@1182  = ~«Шуточки любишь? Может, хочешь поделиться ими со стражей?» — Пыльная отступает в сторону; кажется, она собирается позвать стражу.~
@1183  = ~«И с кем же?»~
@1184  = ~«Дхалл в приёмной на этом этаже. Должна предупредить… Дхалл очень занят своими делами и не совсем здоров. Если у тебя не срочное дело, я бы его не беспокоила».~
@1185  = ~«Скорее всего, Дхалл в приёмной на втором этаже. Он очень занят и не совсем здоров. Если у тебя не срочное дело, я бы его не беспокоила».~
@1186  = ~«Дейонарра? Какая-то женщина погребена в поминальной зале на первом этаже. Может, это она и есть?»~
@1187  = ~«Дейонарра? Какая-то женщина погребена в северо-западной поминальной зале. Может, это она и есть?»~
@1188  = ~«Полагаю, Соэго около главных ворот на первом этаже. Он исполняет обязанности гида в часы антипика».~
@1189  = ~«Полагаю, Соэго около главных ворот. Он исполняет обязанности гида в часы антипика».~
@1190  = ~«Кого хоронят? Возможно, служба идёт где-то в другом зале Мортуария».~
@1191  = ~«Несколько похоронных залов расположены по периметру Мортуария. Они находятся вдоль стен на первом и втором этажах. Ты знаешь имя покойного?»~
@1192  = ~«Тогда тебе стоит спросить у одного из гидов возле парадного входа. Они смогут тебе помочь».~
@1193  = ~Пыльная ждёт.~
@1194  = ~«Ясно. Но что тогда тебе здесь надо?»~
@1195  = ~«Это имя мне не знакомо. Спроси у одного из гидов возле парадного входа… Они смогут направить тебя лучше, чем я».~
@1196  = ~Эта бледнолицая женщина одета в длинные тёмные одежды. От неё немного пахнет плесенью. Выражение лица у неё отсутствующее, она выглядит поглощённой своими заботами.~
@1197  = ~Она медленно поворачивается, и её глаза загораются при виде твоих одежд. «Приветствую, посвящённый».~
@1198  = ~«Я хочу задать тот же вопрос. Твоё лицо мне незнакомо. Кто ты?»~
@1199  = ~«Это Мортуарий… — Пыльная смотрит на тебя какое-то время, как будто переваривая твои слова. — Как, говоришь, твоё имя?»~
@1200  = ~Пыльная терпеливо ждёт продолжения.~
@1201  = ~«Ты можешь просто выйти через парадный вход. Он на первом этаже».~
@1202  = ~«Это имя… — Пыльная замолкает на минуту. — Это имя звучит *знакомо*… Кажется, припоминаю одного Сборщика с этим именем. Писарь Дхалл должен его знать».~
@1203  = ~«Сборщики… они собирают тех, кто умер на улицах Сигила, и доставляют в Мортуарий… — Пыльная замолкает, затем хмурится. — Ты не здешний. Кто ты?»~
@1204  = ~«Дхалл — один из самых уважаемых членов нашей фракции. Думаю, нет никого, кто бы размышлял больше о сущности Истинной Смерти или заслуживал её больше его. Он может поделиться своей мудростью. Если ты ещё не познакомился, советую это сделать, как только представится возможность. Не надолго он задержится в тени этого существования».~
@1205  = ~Пыльная кивает: «Дхалл болен. Он стар даже по меркам гитцерай. Смерть, без сомнения, последует за его изнурительной болезнью. Ему по-настоящему повезло».~
@1206  = ~«Дхалл в приёмной в северо-западном углу этого этажа. Должна предупредить… Дхалл очень занят… а большую часть свободного времени у него отнимает изнурительная болезнь».~
@1207  = ~«Скорее всего, Дхалл в приёмной на втором этаже. Я бы не отнимала слишком много его времени — он очень занят… а большую часть свободного времени у него отнимает изнурительная болезнь».~
@1208  = ~«Да, гитцерай живут гораздо дольше людей».~
@1209  = ~«Гитцерай… — Пыльная замолкает, затем хмурится, внимательно тебя разглядывая. — Ты не здешний. Кто ты?»~
@1210  = ~«Ему повезло в том, что он достигнет Истинной Смерти. Не должен будет больше влачить эту тень существования».~
@1211  = ~Пыльная кивает: «Да». Она хмурится, затем внимательно на тебя смотрит: «Ты не здешний. Кто ты?»~
@1212  = ~«Ты не один из нас, не так ли? Что ты здесь делаешь? Ты из Анархистов? Или шпион другой фракции? — Пыльная отступает в сторону. — Стража! Стража!»~
@1213  = ~«Дневник? Ничего подобного не видела».~
@1214  = ~Эта бледнолицая женщина одета в длинные тёмные одежды. От неё немного пахнет плесенью. Выражение лица у неё отсутствующее, она выглядит поглощённой своими заботами.~
@1215  = ~Прежде чем Пыльная успевает произнести хоть слово, твои руки смыкаются у неё на висках, и ты резко поворачиваешь её голову влево.~
@1216  = ~Слышится хруст, и Пыльная обмякает у тебя в руках.~
@1217  = ~К твоему удивлению, действие было инстинктивным, как будто ты раньше делал это много раз… эта мысль вызывает волнение в памяти, но слишком слабое, чтобы что-либо уловить.~
@1218  = ~Ты недостаточно быстр, и Пыльная уворачивается, когда ты нападаешь на неё. Отступая назад, она трижды звонко хлопает в ладоши. В ответ в Мортуарии начинает звонить большой железный колокол.~
@1219  = ~Ты наклоняешься, чтобы «прошептать» ей, Пыльная тоже наклоняется. Как только позволяет момент, твои руки оказываются у неё на висках, и ты резко поворачиваешь её голову влево.~
@1220  = ~Пыльная выглядит настороженной. Похоже, она собирается что-то сказать, затем слегка трясёт головой и возвращается к своим делам.~
@1221  = ~Пыльная внимательно тебя изучает: «Ты не один из нас, не так ли? Что ты здесь делаешь? Ты из Анархистов? Или шпион другой фракции? Это может заинтересовать стражу…»~
@1222  = ~Пыльная кивает, затем возвращается к своим делам.~
@1223  = ~Пыльная хмурится: «Это имя мне незнакомо».~
@1224  = ~Пыльная по-прежнему хмурится, но слегка кивает: «Ладно. Чем могу быть полезна, посвящённый?»~
@1225  = ~«Ну и ладно…»~
@1226  = ~«Приветствую».~
@1227  = ~«Кто ты?»~
@1228  = ~«Что это за место?»~
@1229  = ~«У меня кое-какие вопросы…»~
@1230  = ~Оставить её в покое.~
@1231  = ~«Да».~
@1232  = ~«Нет».~
@1233  = ~«Нет, я не потерялся. У меня пара вопросов…»~
@1234  = ~«Прощай».~
@1235  = ~Сломать ей шею, прежде чем она закричит.~
@1236  = ~Сломать ей шею, прежде чем она закричит.~
@1237  = ~Быстро уйти.~
@1238  = ~Ждать.~
@1239  = ~«Тебя это не касается».~
@1240  = ~«Я очнулся на одной из плит в вашей препарационной».~
@1241  = ~«Я здесь, чтобы кое с кем увидеться».~
@1242  = ~«Я был здесь на похоронах, но кажется, произошла ошибка».~
@1243  = ~Быстро уйти.~
@1244  = ~Сломать ей шею, прежде чем она закричит.~
@1245  = ~Сломать ей шею, прежде чем она закричит.~
@1246  = ~«Тогда зови их. Я бы хотел с ними встретиться».~
@1247  = ~Сломать ей шею, прежде чем она закричит.~
@1248  = ~Сломать ей шею, прежде чем она закричит.~
@1249  = ~«Тогда зови их. Я бы хотел с ними встретиться».~
@1250  = ~Это вас не касается.~
@1251  = ~«Тебя это не касается».~
@1252  = ~«Да, его зовут „Смерть-Имён“. Прощай».~
@1253  = ~«С Дхаллом».~
@1254  = ~Уйти.~
@1255  = ~«С Дхаллом».~
@1256  = ~Мемориальный зал~
@1257  = ~Большой зал~
@1258  = ~«Я здесь, чтобы навестить Дейонарру».~
@1259  = ~«Хорошо. Спасибо за информацию».~
@1260  = ~«Хорошо. Спасибо за информацию».~
@1261  = ~«Вероятнее всего. Спасибо».~
@1262  = ~«Вероятнее всего. Спасибо».~
@1263  = ~«Очень хорошо. Спасибо».~
@1264  = ~«Очень хорошо. Спасибо».~
@1265  = ~«Ты не поняла… ошибка в том, что похоронить собирались МЕНЯ».~
@1266  = ~«Может быть. А где эти другие службы проходят?»~
@1267  = ~«Можешь показать мне, где здесь выход?»~
@1268  = ~«Нет».~
@1269  = ~«Да».~
@1270  = ~«Ладно. Спасибо».~
@1271  = ~«Прости… я оговорился. Я не знаю, как зовут покойного».~
@1272  = ~«Её зовут Дейонарра».~
@1273  = ~Ложь: «Звать… э-э, Адан».~
@1274  = ~Ложь: «Звать… э-э, Адан».~
@1275  = ~Наклониться вперёд, будто ты хочешь что-то прошептать, и свернуть ей шею.~
@1276  = ~Наклониться вперёд, будто ты хочешь что-то прошептать, и свернуть ей шею.~
@1277  = ~Убежать.~
@1278  = ~«Тебя это не касается».~
@1279  = ~«Я очнулся на одной из плит в вашей препарационной».~
@1280  = ~«Я здесь, чтобы кое с кем увидеться».~
@1281  = ~«Я был здесь на похоронах, но кажется, произошла ошибка».~
@1282  = ~Убежать.~
@1283  = ~«Отлично. Я так и сделаю. Прощай».~
@1284  = ~«Приветствую».~
@1285  = ~Оставить её в покое.~
@1286  = ~«Кто ты?»~
@1287  = ~«Что это за место?»~
@1288  = ~«У меня кое-какие вопросы…»~
@1289  = ~Оставить её в покое.~
@1290  = ~Ложь: «Звать… э-э, Адан».~
@1291  = ~Ложь: «Звать… э-э, Адан».~
@1292  = ~«Моё имя тебя не касается. Я должен идти. Прощай».~
@1293  = ~«Моё имя тебя не касается. Я должен идти. Прощай».~
@1294  = ~Ложь: «Звать… э-э, Адан».~
@1295  = ~Ложь: «Звать… э-э, Адан».~
@1296  = ~«Моё имя тебя не касается. Я должен идти. Прощай».~
@1297  = ~«Моё имя тебя не касается. Я должен идти. Прощай».~
@1298  = ~«Можешь показать мне выход?»~
@1299  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@1300  = ~«Я потерял дневник. Ты его не видела?»~
@1301  = ~«Только поверхностные раны? Что ты имеешь в виду?»~
@1302  = ~«Расскажи мне побольше о Мортуарии».~
@1303  = ~«Ладно. У меня другие вопросы…»~
@1304  = ~«Да будет так. Прощай, Дхалл».~
@1305  = ~«Расскажи мне побольше о Мортуарии».~
@1306  = ~«Слушай, *зомби*, вопросы здесь задаю я. Скажи мне, что ты здесь делаешь, или я сделаю эту маскировку реальностью».~
@1307  = ~«Я не буду больше тебя мучить. Прощай».~
@1308  = ~«Нет. Прощай… Дейонарра».~
@1309  = ~«Ещё не совсем. Прощай, Дейонарра».~
@1310  = ~«Я должен идти, Дейонарра. Прощай».~
@1311  = ~«Если я когда-то отказался от тебя, то, видимо, вынужден это сделать опять. Прощай, дух».~
@1312  = ~«Я должен идти, Дейонарра. Прощай».~
@1313  = ~«Ну и ладно…»~
@1314  = ~«Пока никак, Дейонарра, хотя я вернусь. Прощай».~
@1315  = ~«Можешь снять проклятие, которое ты на меня наложила?»~
@1316  = ~«Я должен идти. Прощай, Дейонарра».~
@1317  = ~«Нет! Нет!..»~
@1318  = ~«Я должен идти. Прощай, Дейонарра».~
@1319  = ~«Я должен идти. Прощай, Дейонарра».~
@1320  = ~«Прощай, Дейонарра».~
@1321  = ~«Прощай, Дейонарра».~
@1322  = ~«Тогда прощай, Дейонарра».~
@1323  = ~«Тогда прощай, Дейонарра».~
@1324  = ~«Прощай, Дейонарра».~
@1325  = ~«Прощай, Дейонарра».~
@1326  = ~«Тогда я спрошу одного из них. Прощай, Дейонарра».~
@1327  = ~«Кто ты?»~
@1328  = ~«Ничего страшного. Извини за беспокойство».~
@1329  = ~«У меня другие вопросы…»~
@1330  = ~«Спасибо. Прощай».~
@1331  = ~«Сборщика?»~
@1332  = ~Быстро уйти.~
@1333  = ~Ждать.~
@1334  = ~«Дхалл?»~
@1335  = ~Наклониться вперёд, будто ты хочешь что-то прошептать, и свернуть ему шею.~
@1336  = ~Убежать.~
@1337  = ~Ложь: «Звать… э-э, Адан».~
@1338  = ~«У меня другие вопросы…»~
@1339  = ~«Ш-ш! Я не могу отвечать тебе при таком шуме!»~
@1340  = ~Использовать на скелете свою способность «Разговор с мёртвыми».~
@1341  = ~Внимательно осмотреть скелет.~
@1342  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@1343  = ~«Приятно было пообщаться. Прощай».~
@1344  = ~Оставить труп в покое.~
@1345  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@1346  = ~«Приятно было пообщаться. Прощай».~
@1347  = ~Оставить труп в покое.~
@1348  = ~«Слушай, *зомби*, вопросы здесь задаю я. Скажи мне, что ты здесь делаешь, или я сделаю эту маскировку реальностью».~
@1349  = ~«Я должен идти. Прощай».~
@1350  = ~Он изучает тебя более внимательно: «Ты фпион? Ты иф яфейки?»~
@1351  = ~А?~
@1352  = ~«Ячейки?»~
@1353  = ~Бандит-тифлинг~
@1354  = ~«Я знаю, что ты не зомби. Ты никого тут не одурачишь».~
@1355  = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@1356  = ~Гхрист~
@1357  = ~«Приятно было пообщаться. Прощай».~
@1358  = ~Оставить труп в покое.~
@1359  = ~Ложь: «Да… я искал тебя. Рад, что наконец-то нашёл».~
@1360  = ~Ложь: «Да… но я не могу сейчас много об этом говорить, если ты меня понимаешь. Каково *твоё* поручение здесь?»~
@1361  = ~Ложь: «Да… но я не могу много об этом говорить прямо сейчас. Что ты здесь делаешь?»~
@1362  = ~«Э-э, сейчас у меня нет времени на разговоры… может, в другой раз».~
@1363  = ~Он изучает тебя более внимательно: «Ты фпион? Ты иф яфейки?»~
@1364  = ~«Мне надо идти. Прощай, Хакария».~
@1365  = ~«Мне надо идти. Прощай, Хакария».~
@1366  = ~«Похоже, то, что надо. Теперь мне пора. Прощай, Хакария».~
@1367  = ~«Сейчас не могу, я должен идти. Прощай, Хакария».~
@1368  = ~«Мне надо идти. Прощай, Хакария».~
@1369  = ~«Мне надо идти. Прощай, Хакария».~
@1370  = ~«Спасибо за информацию. Прощай, Хакария».~
@1371  = ~«Я услышал достаточно. Прощай, Хакария».~
@1372  = ~«Я услышал достаточно. Прощай, Хакария».~
@1373  = ~«Я услышал достаточно. Прощай, Хакария».~
@1374  = ~«Может, мне лучше поискать ответы. Прощай, Хакария».~
@1375  = ~«Хм. Интересно. Спасибо, Хакария».~
@1376  = ~«Мне надо идти. Прощай, Хакария».~
@1377  = ~«Мне надо идти. Прощай, Хакария».~
@1378  = ~«Ничего… Мне нужно идти. Прощай, Хакария».~
@1379  = ~«Ясно. Я должен идти, прощай, Хакария».~
@1380  = ~«Я должен идти. Прощай».~
@1381  = ~«Я должен идти. Прощай».~
@1382  = ~«Я должен идти. Прощай».~
@1383  = ~«Я должен идти. Прощай».~
@1384  = ~«Ясно. Интересно, *было* ли это необходимо. Мне нужно обсудить это с Дхаллом… прощай».~
@1385  = ~«Я должен идти. Прощай».~
@1386  = ~«Пойду поищу этого зомби. Прощай».~
@1387  = ~«У меня нет больше времени для разговоров с тобой. Прощай».~
@1388  = ~«У меня нет больше времени для разговоров с тобой. Прощай».~
@1389  = ~«У меня нет больше времени для разговоров с тобой. Прощай».~
@1390  = ~«Я услышал достаточно. Прощай».~
@1391  = ~«Мне надо идти. Прощай, Хакария».~
@1392  = ~«Я должен идти. Прощай».~
@1393  = ~«Я не могу больше говорить, Хакария. Прощай».~
@1394  = ~«Не могу долго говорить. Я должен идти. Прощай».~
@1395  = ~«Спасибо, что уделила мне время. Прощай».~
@1396  = ~«Я новопосвящённый. Прости моё невежество».~
@1397  = ~«Я… здесь новичок. Пытаюсь… сориентироваться».~
@1398  = ~«Да ладно, э-э… что в имени? Храни веру, посвящённая».~
@1399  = ~«Если ты не можешь мне помочь, тогда я найду кого-нибудь, кто сможет. Прощай».~
@1400  = ~Главные ворота~
@1401  = ~Недостаточно места на диске. Вы не можете дальше играть в Planescape: Torment.~
@1402  = ~ИГРАТЬ В PLANESCAPE~
@1403  = ~Готово~
@1404  = ~законопослушный добрый~
@1405  = ~законопослушный нейтральный~
@1406  = ~законопослушный злой~
@1407  = ~Пыльный хмурится, когда ты проходишь мимо, затем обращается к тебе: «Эй, там, что тебе здесь нужно?»~
@1408  = ~«Мне нужно только покинуть это место. Я не хочу причинять неприятности».~
@1409  = ~«Похоже, я заблудился в этих залах. Здесь есть какие-нибудь гиды, которые указывают дорогу посетителям?»~
@1410  = ~«Похоже, я… потерялся».~
@1411  = ~«Это моё личное дело. Займись-ка лучше своими СОБСТВЕННЫМИ, Пыльный».~
@1412  = ~Наклониться к нему, будто собираешься что-то прошептать, и свернуть ему шею.~
@1413  = ~Наклониться к нему, будто собираешься что-то прошептать, и свернуть ему шею.~
@1414  = ~Пыльный хмурится и говорит скептическим тоном: «Здесь есть гиды, которые могут указать тебе выход. Не слоняйся по Мортуарию без сопровождения».~
@1415  = ~«Спасибо за помощь. Пойду поищу гида».~
@1416  = ~«Я буду слоняться там, где мне захочется… займись лучше своими делами, Пыльный».~
@1417  = ~«Ты действительно выглядишь потерянным, — глаза Пыльного сужаются, а рука опускается на кинжал. — Подожди-ка здесь, пока я позову стражу, чтобы она тебя вывела». Похоже, он действительно собирается позвать их.~
@1418  = ~Сломать ему шею, прежде чем он закричит.~
@1419  = ~Этот бледнолицый мужчина одет в длинные тёмные одежды. От него немного пахнет плесенью. Выражение лица у него отсутствующее, он выглядит поглощённым своими заботами.~
@1420  = ~«Приветствую».~
@1421  = ~«Приветствую».~
@1422  = ~«Приветствую».~
@1423  = ~«Приветствую».~
@1424  = ~Оставить его в покое.~
@1425  = ~Прежде чем Пыльный успевает произнести хоть слово, твои руки смыкаются у него на висках, и ты резко поворачиваешь его голову влево.~
@1426  = ~«Я не могу позволить тебе поднять тревогу…»~
@1427  = ~Слышится хруст, и Пыльный обмякает у тебя в руках.~
@1428  = ~«Лучше уж ты, чем я, Пыльник».~
@1429  = ~«Лучше уж ты, чем я, Пыльник».~
@1430  = ~К твоему удивлению, действие было инстинктивным, как будто ты раньше делал это много раз… эта мысль вызывает волнение в памяти, но слишком слабое, чтобы что-либо уловить.~
@1431  = ~Ты видишь устало выглядящего человека в выцветшем чёрном одеянии. В глаза бросается необычайная бледность его худощавого лица, и вообще он выглядит так, будто давно не спал: плечи ссутулены, под налитыми кровью глазами большие мешки. Кажется, он не обращает на тебя внимания… должно быть, принял за одного из трупов-рабочих.~
@1432  = ~«Приветствую».~
@1433  = ~«Кто ты?»~
@1434  = ~«Что это за место?»~
@1435  = ~«У меня пара вопросов…»~
@1436  = ~Оставить его в покое.~
@1437  = ~Пыльный резко поворачивает голову, когда ты к нему обращаешься: «Про… прости? Ты говоришь со мной?»~
@1438  = ~«Да, с тобой. У меня есть несколько вопросов…»~
@1439  = ~«Нет, не с тобой».~
@1440  = ~Стоять молча и почти не дышать.~
@1441  = ~Стоять молча и почти не дышать.~
@1442  = ~Быстро уйти.~
@1443  = ~«Во имя сил!» — Пыльный подпрыгивает, затем внимательно на тебя смотрит. Ты замечаешь, что его глаза не налиты кровью, а просто слегка покраснели. «Любезный, ты просто вырываешь из меня нелестное признание: из тебя получился невероятно правдоподобный зомби», — он слегка кивает. «Я Соэго. Могу я поинтересоваться, что ты тут делаешь… — он бросает взгляд на твои шрамы, — …в таком виде?»~
@1444  = ~«Не твоё дело».~
@1445  = ~«Я и сам не знаю. Я очнулся на одной из плит наверху, и мои воспоминания… немного туманны».~
@1446  = ~«Я заплутал в этих стенах и не могу найти выход. Ты мне не поможешь?»~
@1447  = ~«Я пытаюсь выбраться отсюда».~
@1448  = ~«Мне нужно было изменить внешность».~
@1449  = ~Пыльный какое-то время изучает тебя, затем трясёт головой. «Снова видения… — он вздыхает и протирает глаза. — Эти заклинания для снятия жара действуют всё хуже…»~
@1450  = ~«Это не видение. У меня есть несколько вопросов…»~
@1451  = ~Сломать ему шею, пока он отвлёкся.~
@1452  = ~Сломать ему шею, пока он отвлёкся.~
@1453  = ~«У меня кое-какие вопросы».~
@1454  = ~Тихо уйти.~
@1455  = ~Пыльный внимательно смотрит на тебя, затем наклоняется… его губы расходятся, обнажая ряд грязных острых зубов, и он начинает по-крысиному обнюхивать тебя.~
@1456  = ~«Э-э… какого дьявола ты меня обнюхиваешь?»~
@1457  = ~«Послушай, у меня к тебе вопросы…»~
@1458  = ~Сломать ему шею, пока он наклонился.~
@1459  = ~Сломать ему шею, пока он наклонился.~
@1460  = ~Быстро уйти.~
@1461  = ~Когда ты собираешься уходить, Пыльный тихо шипит, затем наклоняется и обнюхивает тебя. «Во имя сил!» — Пыльный отступает, его глаза расширяются. Ты замечаешь, что глаза у него не налиты кровью, а просто слегка покраснели. «Любезный, ты просто вырываешь из меня нелестное признание: из тебя получился невероятно правдоподобный зомби, — он слегка кивает. — Я Соэго. Могу я поинтересоваться, что ты тут делаешь… в таком виде?»~
@1462  = ~«Не твоё дело».~
@1463  = ~«Я и сам не знаю, что тут делаю. Я очнулся на одной из плит наверху, и мои воспоминания… немного туманны».~
@1464  = ~«Я заплутал в этих стенах и не могу найти выход. Ты мне не поможешь?»~
@1465  = ~«Пытаюсь выбраться отсюда».~
@1466  = ~«Мне нужно было изменить внешность».~
@1467  = ~«У меня правда нет на это времени. Прощай».~
@1468  = ~«О, боюсь, как раз *моё*», — глаза Соэго вспыхивают красными огоньками, а уголки губ слегка подёргиваются, как будто от неприязни. «Может… — он усмехается, демонстрируя ряд грязных острых зубов. — Может, мне позвать стражу? Да… думаю, именно это я и сделаю».~
@1469  = ~«Подожди минутку! Я потерялся… просто заплутал в этих залах и, похоже, не могу найти выход. Ты мне не поможешь?»~
@1470  = ~«Стой! Не зови стражу! Я просто хочу отсюда выбраться… не поможешь мне?»~
@1471  = ~Сломать ему шею, прежде чем он закричит.~
@1472  = ~Сломать ему шею, прежде чем он закричит.~
@1473  = ~«Что ж, зови свою стражу. С нетерпением жду встречи».~
@1474  = ~«Серьёзно? — Пыльный внимательно изучает тебя. — Выглядишь так, будто над тобой *хорошенько* поработали. Я не знаю, как ты пережил такую боль… тебе и *сейчас* больно? Похоже на то».~
@1475  = ~«И всё же как я сюда попал?»~
@1476  = ~«У меня нет на это времени. Прощай».~
@1477  = ~Соэго кивает, а уголки его губ подёргиваются: «Ну… да, конечно. Эти залы *могут* сбить посетителей с толку. Хотя никакого вреда ты не причинил, но тебе не разрешается находиться в Мортуарии после девяти ударов колокола. Позволь, я открою для тебя парадный вход».~
@1478  = ~«Спасибо».~
@1479  = ~«Спасибо».~
@1480  = ~Соэго тянется к своему поясу, обшаривает его некоторое время, затем шипит: «Ключ!» Его глаза наливаются кровью, губы расходятся в гневе… выражение лица становится почти животным. «Кто-то украл ключ! — он поворачивается к тебе и рычит. — Ты! Наверняка это сделал ты!»~
@1481  = ~Блеф: «Э-э… погоди! Зачем бы мне просить тебя открыть, если бы я его украл?»~
@1482  = ~Ложь: «О чём ты говоришь?! Я не имею к этому никакого отношения!»~
@1483  = ~Сломать ему шею, прежде чем он закричит.~
@1484  = ~Сломать ему шею, прежде чем он закричит.~
@1485  = ~«А если даже и я? Что ты мне сделаешь?»~
@1486  = ~Соэго снимает с пояса большой ключ и идёт к воротам. Ты не можешь не заметить его необычной походки… он идёт, согнувшись вперёд, будто пытается удержать равновесие.~
@1487  = ~«Странная у него походка».~
@1488  = ~Подождать, пока он откроет ворота.~
@1489  = ~Добравшись до ворот, Соэго поворачивает ключ в замке. Спустя секунду из замка раздаётся скрип… звук разносится по всему главному залу, отражаясь от мраморного пола.~
@1490  = ~Подождать его возвращения.~
@1491  = ~«Готово. Парадный вход теперь не заперт, но ты не сможешь войти снова».~
@1492  = ~«Могу я задать пару вопросов, прежде чем уйду?»~
@1493  = ~«Спасибо, Соэго. Я ухожу».~
@1494  = ~«Выбраться отсюда? — Соэго хмурится. — А как ты сюда попал?»~
@1495  = ~«Я был здесь на похоронах, отдавал дань уважения. Уже собирался уходить… но что-то заплутал здесь. Не поможешь мне найти выход?»~
@1496  = ~«По правде говоря, и сам не знаю».~
@1497  = ~«По правде говоря, и сам не знаю».~
@1498  = ~«Я очнулся на одной из плит наверху, и мои воспоминания… немного туманны».~
@1499  = ~«У меня нет на это времени. Прощай».~
@1500  = ~Соэго щёлкает языком: «Как любопытно». Он снова изучает тебя: «Возможно, ты один из контрактников?»~
@1501  = ~«Э-э, „контрактников“?»~
@1502  = ~«У меня правда нет на это времени. Прощай».~
@1503  = ~Когда ты собираешься уходить, Пыльный прекращает принюхиваться и тихо шипит: «Во имя сил!» Пыльный отступает, его глаза расширяются. Ты замечаешь, что глаза у него не налиты кровью, а просто слегка покраснели. «Любезный, ты просто вырываешь из меня нелестное признание: из тебя получился невероятно правдоподобный зомби, — он слегка кивает. — Я Соэго. Могу я поинтересоваться, что ты тут делаешь… в таком виде?»~
@1504  = ~«Не твоё дело».~
@1505  = ~«Я и сам не знаю, что тут делаю. Я очнулся на одной из плит наверху, и мои воспоминания… немного туманны».~
@1506  = ~«Я заплутал в этих стенах и не могу найти выход. Ты мне не поможешь?»~
@1507  = ~~
@1508  = ~«Я пытаюсь отсюда выбраться».~
@1509  = ~«Мне нужно было изменить внешность».~
@1510  = ~«У меня правда нет на это времени. Прощай».~
@1511  = ~«Понятно…» — глаза Соэго вспыхивают красными огоньками, а уголки губ слегка подёргиваются, как будто от неприязни. «Может… — он усмехается, демонстрируя ряд грязных острых зубов. — Может мне позвать стражу? Да… думаю, именно это я и сделаю».~
@1512  = ~«Подожди минутку! Я потерялся… просто заплутал в этих залах и, похоже, не могу найти выход. Ты мне не поможешь?»~
@1513  = ~«Стой! Не зови стражу! Я просто хочу отсюда выбраться… не поможешь мне?»~
@1514  = ~Сломать ему шею, прежде чем он закричит.~
@1515  = ~Сломать ему шею, прежде чем он закричит.~
@1516  = ~«Что ж, зови свою стражу. С нетерпением жду встречи».~
@1517  = ~Когда ты собираешься уходить, Соэго гневно шипит… затем вдруг успокаивается и поднимает руку. «Нет-нет. Боюсь, ты не можешь уйти. Что-то здесь не так. Думаю, лучше мы это сразу выясним… — уголки его губ слегка подёргиваются, а глаза сверкают, — …возможно, поможет стража. Да… вероятно, мне следует позвать её».~
@1518  = ~«Подожди минутку! Я потерялся… просто заплутал в этих залах и, похоже, не могу найти выход. Ты мне не поможешь?»~
@1519  = ~«Вы не поняли… ошибка в том, что похоронить собирались МЕНЯ».~
@1520  = ~«Стой! Не зови стражу! Я просто хочу отсюда выбраться… не поможешь мне?»~
@1521  = ~Сломать ему шею, прежде чем он закричит.~
@1522  = ~Сломать ему шею, прежде чем он закричит.~
@1523  = ~«Что ж, зови свою стражу. С нетерпением жду встречи».~
@1524  = ~Соэго делает шаг назад, затем трижды звонко хлопает в ладоши. В ответ в Мортуарии начинает звонить большой железный колокол.~
@1525  = ~«Ну и ладно…»~
@1526  = ~Прежде чем он успевает произнести хоть слово, твои руки смыкаются у него на висках, и ты резко поворачиваешь его голову влево.~
@1527  = ~~
@1528  = ~«Я не могу позволить тебе поднять тревогу…»~
@1529  = ~Ты слышишь *треск* ломающейся шеи… но вместо того, чтобы обмякнуть, Пыльный издаёт сдавленный крик и вырывается!~
@1530  = ~«Что?!..»~
@1531  = ~«Что?!..»~
@1532  = ~Пыльный шокирован не меньше тебя; его глаза становятся дикими, из горла раздаётся бульканье… ты уверен, что сломал ему шею, ведь его голова повёрнута под неестественным углом, но он всё ещё жив! Пока ты смотришь на него в оцепенении, он трижды слабо хлопает в ладоши. В ответ в Мортуарии начинает звонить большой железный колокол.~
@1533  = ~«Ну и ладно…»~
@1534  = ~Должно быть, *что-то* насторожило Пыльного… прежде чем ты успеваешь схватить его, он отскакивает назад, в глазах вспыхивает красный огонёк, а зубы обнажаются в оскале. Шипя, он трижды звонко хлопает в ладоши. В ответ в Мортуарии начинает звонить большой железный колокол.~
@1535  = ~«Ну и ладно…»~
@1536  = ~Ты видишь одного из стражников Керста. Он окровавлен и еле переводит дыхание. «Некогда говорить. Ты не занят, так что можешь помочь… с защитой», — он машет рукой, прогоняя тебя.~
@1537  = ~Что ж, теперь, когда ты упомянул это, мне стало дерьмово.~
@1538  = ~«Случилось то, что какой-то придурок кого-то выпустил и мы вдруг оказались в Карцери, вынужденные драться за свои жизни. Теперь проваливай отсюда и сделай что-нибудь полезное».~
@1539  = ~«Разве я не сказал тебе заняться своими делами? Повторяю! Бегом!»~
@1540  = ~«Во имя Девяти Кругов Ада, что ты здесь делаешь?»~
@1541  = ~«Ни с места!» — стражник атакует!~
@1542  = ~Перед тобой человек в старой драной одежде. Когда ты приближаешься, он обходит тебя и продолжает путь.~
@1543  = ~Человек игнорирует тебя, ускоряя шаг.~
@1544  = ~Он поворачивается, бегло бросает взгляд направо и налево от тебя, будто пытаясь понять, есть ли с тобой кто-то ещё, а затем достаёт кинжал: «Иди-ка ты лучше, куда шёл, или мигом получишь эту штуку промеж рёбер!»~
@1545  = ~Перед тобой человек в старой драной одежде. Когда ты подходишь ближе, он останавливается и пристально на тебя смотрит.~
@1546  = ~«У тя *проблемы*, пень?.. Или ты их *ищешь*? — он плюёт тебе под ноги. — Вали своей дорогой, пока шрамов не добавили».~
@1547  = ~Он ухмыляется: «Ясно дело, хочешь, да только у меня нет ответов для таких, как ты. Пошёл на!»~
@1548  = ~«Эй! Погоди минутку!»~
@1549  = ~«Приветствую…»~
@1550  = ~Оставить его в покое.~
@1551  = ~«Сэр?»~
@1552  = ~«Эй! Погоди минутку!»~
@1553  = ~Оставить его в покое.~
@1554  = ~«Успокойся. Я просто хочу задать пару вопросов…»~
@1555  = ~Напасть на него.~
@1556  = ~«Тогда прощай».~
@1557  = ~Он ухмыляется: «Ясно дело, хочешь, да только у меня нет ответов для таких, как ты. Пошёл на!»~
@1558  = ~Напасть на него.~
@1559  = ~«Тогда прощай».~
@1560  = ~«Приветствую».~
@1561  = ~Оставить его в покое.~
@1562  = ~«Успокойся. Я просто хочу задать пару вопросов…»~
@1563  = ~Напасть на него.~
@1564  = ~«Тогда прощай».~
@1565  = ~Напасть на него.~
@1566  = ~«Тогда прощай».~
@1567  = ~Ты видишь человека в лохмотьях. Когда ты подходишь к нему ближе, он внезапно останавливается и начинает испуганно оглядываться.~
@1568  = ~«Эй, ты там! Погоди минутку!»~
@1569  = ~«Приветствую».~
@1570  = ~Оставить его в покое.~
@1571  = ~Человек выглядит испуганным и делает шаг назад. «Э-э? Чё те надо, здоровяк? — его голос дрожит, похоже, он напуган твоими шрамами. — У меня ничё нет, точно, а мои лохмотья не стоят усилий».~
@1572  = ~«Успокойся. Я не собираюсь тебя грабить. У меня пара вопросов…»~
@1573  = ~«Беги — и я обещаю, далеко не убежишь. У меня вопросы…»~
@1574  = ~«Ничего. Прощай».~
@1575  = ~«Э-э? — он не очень-то рад тебя видеть. — Чё те *ещё* надо, здоровяк?»~
@1576  = ~«У меня пара вопросов…»~
@1577  = ~«Ничего. Прощай».~
@1578  = ~Он держится на безопасной дистанции, глаза бегают, будто он ожидает появления чего-то из теней. «Вопросы, говоришь?.. И… э-э… чё за вопросы?»~
@1579  = ~«Можешь рассказать мне о Сигиле?»~
@1580  = ~«Можешь рассказать мне об этом… городе?»~
@1581  = ~«Можешь рассказать мне об этих трущобах?»~
@1582  = ~«Можешь рассказать мне об Улье?»~
@1583  = ~«Можешь рассказать мне о Госпоже Боли?»~
@1584  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@1585  = ~«Я потерял дневник. Не видел ничего такого?»~
@1586  = ~«Э… — он осторожно глядит на тебя, его брови озадаченно поднимаются. — Чё ты хочешь знать об Улье, здоровяк?»~
@1587  = ~«Почему он зовётся Ульем?»~
@1588  = ~«Что здесь есть интересного?»~
@1589  = ~«Ничего. У меня другие вопросы…»~
@1590  = ~«Ничего. Прощай».~
@1591  = ~«Э-э… чё за вопросы?»~
@1592  = ~«Можешь рассказать мне об этом… городе?»~
@1593  = ~«Можешь рассказать мне о Сигиле?»~
@1594  = ~«Можешь рассказать мне об этих трущобах?»~
@1595  = ~«Можешь рассказать мне об Улье?»~
@1596  = ~«Можешь рассказать мне о Госпоже Боли?»~
@1597  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@1598  = ~«Я потерял дневник. Не знаешь, где я могу найти его? Ничего подобного не видел?»~
@1599  = ~Он выглядит озадаченным. «Я… не знаю, — похоже, он испуган, что не знает ответа. — Месиво улиц, толпы людей, типа».~
@1600  = ~«Что здесь есть интересного?»~
@1601  = ~«Ясно. У меня другие вопросы…»~
@1602  = ~«Ладно, тогда прощай».~
@1603  = ~«Ну… э-э… как сказать. Зависит от того, чё считаешь интересным, мужик».~
@1604  = ~«Я хочу хорошо провести время».~
@1605  = ~«Я хочу хорошо провести время».~
@1606  = ~«Я ищу работу».~
@1607  = ~«Я ищу одного типа по имени Фарод».~
@1608  = ~«Я ищу свой потерянный дневник. Ты, случайно, не знаешь, где я могу его найти?»~
@1609  = ~«Забудь. У меня другие вопросы…»~
@1610  = ~«Ну… — он облизывает губы. — Есть тут бар „Горящий труп“… и бар Пыльных… но по тебе не скажешь, что ты будешь пить с Пыльниками… остальные места здесь просто опасны, так что гляди в оба».~
@1611  = ~«Где находятся все эти заведения?»~
@1612  = ~«Тут есть опасные места?»~
@1613  = ~«„Пыльные“?»~
@1614  = ~«У меня другие вопросы…»~
@1615  = ~«Ясно. Спасибо за информацию. Прощай».~
@1616  = ~«Ну, „Горящий труп“ в нескольких кварталах прямо… э-э… на юг от Мортуария, а бар Пыльных совсем рядом от Мортуария, на юго-западе».~
@1617  = ~«Да повсюду в Улье, как только стемнеет. Тут неподалёку аллея Опасных Углов… Если не хошь попасть в книгу мёртвых, те лучше б держаться оттуда подальше».~
@1618  = ~«Почему эта аллея „Опасных Углов“ так опасна?»~
@1619  = ~«У меня другие вопросы…»~
@1620  = ~«Спасибо за информацию. Прощай».~
@1621  = ~Он задумывается. «Очень редко… э-э… найдёшь тут честную работу, здоровяк. Можешь поохотиться на мозговых паразитов и доставить их в главное управление по паразитам за несколько медяков. Но связываться с ними всё же довольно опасно. Также можешь собирать по Улью трупы и доставлять их в Мортуарий за медяшки».~
@1622  = ~«Прямо за рынком Улья. Иди к шпилю — это на юго-запад от Мортуария — три-четыре квартала, и ты упрёшься. Крысоловы суетятся прямо у входа, вряд ли пропустишь».~
@1623  = ~«Где это управление?»~
@1624  = ~«Мозговые паразиты?»~
@1625  = ~«Собирать трупы?»~
@1626  = ~«У меня другие вопросы…»~
@1627  = ~«Ясно. Спасибо за информацию. Прощай».~
@1628  = ~«Ну да, Пыльные заплатят за любого трупака, которого ты доставишь к их воротам. Не так много, но достаточно для Сборщиков, чтобы сводить концы с концами… а уж трупов тут всегда хватает».~
@1629  = ~«Где это управление, о котором ты говорил?»~
@1630  = ~«Что ты говорил о каких-то „мозговых паразитах“?»~
@1631  = ~«„Пыльные“?»~
@1632  = ~«А ещё какая-нибудь работа есть в Улье?»~
@1633  = ~«Сборщики?»~
@1634  = ~«Ага, мерзкие маленькие грызуны», — он обнажает свои зубы, прямо как крыса. Выглядит довольно по-идиотски. «По одиночке они — ничто… только когда мозговые паразиты собираются в стаи, они сильно умнеют. Чем их больше, тем умнее. Они становятся почти как люди… — он трясёт головой. — Ни один здравомыслящий человек не хочет, чтобы это происходило. Опасно для здоровья, так сказать».~
@1635  = ~«Ага… Пыльные… бледнолицые мертвецы, всегда угрюмые и никакого чувства юмора. Они очищают улицы от мёртвых, собирая их в Мортуарии. Это их работа в Сигиле, в основном потому, что никто больше этим заниматься не хочет».~
@1636  = ~«У меня другие вопросы…»~
@1637  = ~«Ясно. Спасибо за информацию. Прощай».~
@1638  = ~«А ещё какая-нибудь работа есть в Улье?»~
@1639  = ~«Каких именно?»~
@1640  = ~«Как насчёт Пыльных…»~
@1641  = ~«Хаоситы… звучит интересно».~
@1642  = ~«Индепы?»~
@1643  = ~«Неважно. У меня другие вопросы…»~
@1644  = ~«Забудь о том, что я спрашивал. Прощай».~
@1645  = ~«И чё ты хочешь узнать о Сигиле?»~
@1646  = ~«Что *это* за место?»~
@1647  = ~«*Где* этот Сигил?»~
@1648  = ~«Вообще-то у меня другие вопросы…»~
@1649  = ~«Неважно. Прощай».~
@1650  = ~«Город. Город Дверей, Клетка. Место, куда ведут и откуда выводят все двери. К тому же центр планов и место, куда всё отовсюду стекается. Говорят, именно здесь все так или иначе заканчивают свой путь».~
@1651  = ~«У меня другие вопросы…»~
@1652  = ~«„Город Дверей“?»~
@1653  = ~«Спасибо за информацию. Прощай».~
@1654  = ~«Э-э… видишь ли, здоровяк, этот город… — он хмурится, как будто борясь с собственными словами. — В городе множество разных дверей попрятано… и… видишь ли, эти двери…» Он снова хмурится, затем вздыхает.~
@1655  = ~«Дай-ка я встряхну своими мозгами, чтобы до тебя вернее дошло. Значит, слухай: по всему Сигилу разбросаны „двери“, но они не всегда выглядят как двери. Это скорей порталы, сечёшь? И они могут быть *где угодно*… в оконной раме… э-э, в картинной рамке, в арке… под столом… или между ног у статуи…»~
@1656  = ~«И… ты говоришь, всё это двери?»~
@1657  = ~«Двери?..»~
@1658  = ~«Так, я гляжу, это займёт немало времени. У меня другие вопросы…»~
@1659  = ~«Неважно. Прощай».~
@1660  = ~Он снова хмурится: «Дверями… порталами может быть что угодно с замкнутой формой. Никогда не скажешь, где они… если только у тебя нет ключа. Ты ведь так сюда попал, здоровяк? Через дверь?»~
@1661  = ~«Ясно. У меня другие вопросы…»~
@1662  = ~«Спасибо за информацию. Прощай».~
@1663  = ~«Почему ты так считаешь?»~
@1664  = ~«Э-э… ну, ты вроде как не местный, ага?»~
@1665  = ~«Неважно. Прощай».~
@1666  = ~«О каких „ключах“ ты говоришь?»~
@1667  = ~«Так в городе много разных дверей… а куда они ведут?»~
@1668  = ~«Может быть… послушай, у меня другие вопросы…»~
@1669  = ~«Неважно. Прощай».~
@1670  = ~«К каждой двери есть свой ключ, сечёшь? Как правило, ты даже не *поймёшь*, что где-то рядом дверь, если у тебя нету ключа. Если ключ есть — тогда дверь открывается, и ты, типа, можешь пройти сквозь неё, попытать счастья. Фишка в том, чуешь, что дверями может быть чё угодно. Так вот, такая же байда с ключами. Это может быть мотивчик, который ты себе напеваешь рядом с дверью, какая-то мысль, действие или, может, вещь какая, типа куска стекла, камня, сломанного зуба… чё угодно».~
@1671  = ~«А куда все эти двери ведут?»~
@1672  = ~«Ты спрашивал, не пришёл ли я через одну из таких дверей. Почему ты так думаешь?»~
@1673  = ~«Звучит очень запутано».~
@1674  = ~«Ты привыкнешь к таким вещам».~
@1675  = ~«Ты спрашивал, не пришёл ли я через одну из таких дверей. Почему ты так думаешь?»~
@1676  = ~«А куда все эти двери ведут?»~
@1677  = ~Он пожимает плечами. «Двери могут вести *куда угодно*, мужик. Некоторые даже не выводят в одно и тоже место дважды, — он вздыхает. — Видишь ли, такова уж природа этих дверей, что они могут завести куда угодно на планах… *куда угодно*. Прикол в том, что их так адски много, очень трудно найти дверь, которая ведёт куда тебе нужно».~
@1678  = ~«Говоришь, от этих дверей есть „ключи“?..»~
@1679  = ~«Ты спросил, не пришёл ли я через одну из таких дверей. Почему ты так думаешь?»~
@1680  = ~«Центр планов, так сказать. Не знаю по личному опыту, — он пожимает плечами. — но я так понимаю, все места касаются этого… так или иначе. Не весь Сигил такой ужасный, как ты видишь тут».~
@1681  = ~«У меня другие вопросы…»~
@1682  = ~«Неважно. Прощай».~
@1683  = ~«Хозяйка Сигила? Ты чё, не *слыхал* о ней? Да ты прям блаженный или бестолочь… э-э, в смысле, ты точно мало знаешь о Сигиле», — он тихо усмехается. «Слова Госпожи — закон в Сигиле, — он задумывается на мгновение. — Только вот много она не говорит. Вообще хранит мёртвое молчание».~
@1684  = ~«Чё ты потерял? — он выглядит озадаченным. — Понятия не имею, где такое можно найти, здоровяк».~
@1685  = ~Он осторожно на тебя смотрит: «Не хочу много о ней говорить, мужик… не стоит пересекать её тень или, там, петь ей хвалы, сечёшь? Давай больше не будем об этом. Трепаться о ней — не дело, точно говорю».~
@1686  = ~«Интересный закон».~
@1687  = ~«Что ещё ты мне можешь рассказать об этой Госпоже?»~
@1688  = ~«Ясно. У меня другие вопросы…»~
@1689  = ~«Неважно. Прощай».~
@1690  = ~«Обитель Пыльных. Мрачное место. Не хочу его видеть, даже когда меня запишут в книгу мёртвых».~
@1691  = ~«Стервятники. Множество их обитает на Площади Мусорщиков. Собирают мёртвых, обирают с них всё мало-мальски ценное, а потом продают тела Пыльным в Мортуарий».~
@1692  = ~«Ясно. У меня другие вопросы…»~
@1693  = ~«Неважно. Прощай».~
@1694  = ~«У меня другие вопросы…»~
@1695  = ~«Ясно. Прощай».~
@1696  = ~«Зачем они это делают?»~
@1697  = ~«У меня другие вопросы…»~
@1698  = ~«А ещё какая-нибудь работа есть в Улье?»~
@1699  = ~«Пыльные платят тем, кто приносит им мёртвых, вычищая улицы и аллеи, это типа упрощает Пыльным жизнь — не приходится самим тела собирать. Много трупов в Улье, каждый день».~
@1700  = ~«У меня другие вопросы…»~
@1701  = ~«А ещё какая-нибудь работа есть в Улье?»~
@1702  = ~«Это имя я не знаю. Кто он?»~
@1703  = ~«Он Сборщик, я думаю».~
@1704  = ~«Понял, спасибо. У меня другие вопросы…»~
@1705  = ~«Ладно, сам попытаюсь выяснить. У меня другие вопросы…»~
@1706  = ~«Понял. Прощай».~
@1707  = ~Он задумывается. «Ну, тогда, скорее всего, он обитает на Площади Мусорщиков. Глянь там… только днём, ага. Ночью это не особо приятное место».~
@1708  = ~«А где находится эта площадь?»~
@1709  = ~«У меня другие вопросы…»~
@1710  = ~«Спасибо за предупреждение. Прощай».~
@1711  = ~«Несколько кварталов отсюда — топай на запад от Мортуария так далеко, как сможешь, и попадёшь прямо туда. Только осторожней там… Сборщики не всегда ждут, чтобы тело умерло, прежде чем его забрать, сечёшь, а?»~
@1712  = ~«Место воров и бандитов, здоровяк. Не ходи туда, если не хочешь, чтоб следующим местом твоего посещения был Мортуарий. Эта аллея — место пожарища. Когда-то она была улицей, пока однажды какой-то спятивший маг не спалил её ночью. Говорят, его поймали и тоже сожгли, в отместку, так сказать, а тело выставили на обозрение в „Горящем трупе“. Это Улей, чувак».~
@1713  = ~«Э-э… — он облизывает губы, когда ты собираешься уходить. — Здоровяк, может, ты…» Он изучает тебя какое-то время. «Может, поделишься несколькими медяками с тем, кто тебе помог, а? Не все тут это сделают для тебя… ну, чтоб хватило промочить горло после всей этой болтовни? А?»~
@1714  = ~«Нет».~
@1715  = ~«Я оставлю тебя в живых. Как тебе это?»~
@1716  = ~«Это справедливо». Дать ему медяк.~
@1717  = ~Дать пять медных монет.~
@1718  = ~Дать десять медных монет.~
@1719  = ~Он выглядит разочарованным. «А, ну… мир круглый, здоровяк…» — ворчит он себе под нос, когда уходит.~
@1720  = ~Уйти.~
@1721  = ~Уйти.~
@1722  = ~Он выглядит ошарашенным и поднимает руки: «Не, не, ничего, здоровяк! Я о погоде, не вру! Ничего о тебе!» Он готов бежать.~
@1723  = ~«*Что* ты сказал?»~
@1724  = ~Напасть на него.~
@1725  = ~Дать ему убежать.~
@1726  = ~«Э-э… ну, за мной не пропадёт, — он с опаской улыбается. — Мир тогда». Он быстро уходит.~
@1727  = ~Напасть на него.~
@1728  = ~Дать ему убежать.~
@1729  = ~Он оглядывается, нет ли вокруг кого-нибудь, кто видел деньги, затем прячет медяки в складках своей одежды: «Спасибочки, здоровяк! Пусть тень Госпожи пройдёт мимо тебя!»~
@1730  = ~«Погоди-ка… Госпожи? Что ты имеешь в виду?»~
@1731  = ~«У меня другие вопросы…»~
@1732  = ~«Спасибо. Прощай».~
@1733  = ~«У меня другие вопросы…»~
@1734  = ~Наследство Кестера~
@1735  = ~Дабус~
@1736  = ~Шлюха~
@1737  = ~Тифлинг~
@1738  = ~Дабус~
@1739  = ~Гитцерай-горожанин~
@1740  = ~Шлюха~
@1741  = ~Гитцерай~
@1742  = ~Пьяная шлюха~
@1743  = ~Пьяная шлюха~
@1744  = ~Горожанин Керста, женщина~
@1745  = ~Девица в беде~
@1746  = ~Девица в беде~
@1747  = ~Кристалл~
@1748  = ~Флис~
@1749  = ~Головорез Улья~
@1750  = ~Житель Улья~
@1751  = ~Испуганный житель Улья~
@1752  = ~Злой житель Улья~
@1753  = ~Головорез Улья~
@1754  = ~Ты видишь человека, который немного смущённо оглядывает строения вокруг. Кажется, он заблудился и что-то про себя бормочет.~
@1755  = ~«Приветствую».~
@1756  = ~Пройти мимо.~
@1757  = ~Похоже, ему полегчало. «*Наконец-то*! Прошу прощения, добрый господин, я, похоже, заблудился в этом лабиринте улиц…» — он неловко хихикает. «Боюсь, этот район города мне немного… — он тревожно озирается, — …незнаком. Местные жители не особо желают помогать прохожим». Он с надеждой смотрит на тебя: «Могу я рассчитывать на вашу помощь?»~
@1758  = ~«Зависит от того, что за помощь тебе нужна».~
@1759  = ~«Конечно. Куда ты хочешь попасть?»~
@1760  = ~«Ты сам по себе. На твоём месте, я бы поскорее выбирался отсюда».~
@1761  = ~«У меня сейчас нет времени тебе помогать… прощай».~
@1762  = ~«Я ищу дом моей тёти Маргариты. Она вроде как живёт в доме недалеко от Мортуария, но расположение улиц, кажется, изменилось со времени моего последнего визита… вы не знаете о доме, про который я говорю?»~
@1763  = ~Ложь: «Знаю. Я укажу тебе дорогу… за деньги».~
@1764  = ~Правда: «Боюсь, я никогда не слышал об этом месте».~
@1765  = ~«Я не могу тебе помочь. Прощай».~
@1766  = ~«Ах, это, разумеется, справедливо. Из последнего, что я слышал, её дом рядом с Мортуарием, — его глаза сужаются, как бы изучая тебя. — Вы точно знаете, где он находится?»~
@1767  = ~Тень~
@1768  = ~Большая тень~
@1769  = ~Тень~
@1770  = ~Покрытый-Пеплом~
@1771  = ~Большая тень~
@1772  = ~Перо для письма~
@1773  = ~Отмычки~
@1774  = ~Ключ от препарационной~
@1775  = ~Ключ от препарационной~
@1776  = ~КЛЮЧ ОТ ПРЕПАРАЦИОННОЙ
Вес: 0

Головка этого бронзового ключа была закручена вокруг себя несколько раз так, что ключ теперь напоминает винт. Если верить Морте, этот ключ открывает одну из дверей в препарационной.

^NПРИМЕЧАНИЕ. Для открытия двери достаточно иметь в вещах нужный ключ. Иногда он может исчезнуть после применения… это сделано для того, чтобы освободить место в рюкзаке для более важных вещей, когда ключ больше не нужен.^-~
@1777  = ~Ключ от главных ворот Мортуария~
@1778  = ~Ключ от главных ворот Мортуария~
@1779  = ~КЛЮЧ ОТ ГЛАВНЫХ ВОРОТ МОРТУАРИЯ
Вес: 0

Это большой незамысловатый железный ключ. По какой-то причине, его безрадостный внешний вид напоминает тебе о Мортуарии.

^NПРИМЕЧАНИЕ. Для открытия двери достаточно иметь в вещах нужный ключ. Иногда он может исчезнуть после применения… это сделано для того, чтобы освободить место в рюкзаке для более важных вещей, когда ключ больше не нужен.^-~
@1780  = ~Ключ от комнаты для бальзамирования~
@1781  = ~Ключ от комнаты для бальзамирования~
@1782  = ~Ты видишь высокое существо с копной белых волос. Его кожа зеленоватого оттенка, изо лба торчат два козлиных рога. Оно одето в длинные ниспадающие одежды и, похоже, плывёт над землёй.~
@1783  = ~«Приветствую».~
@1784  = ~«Приветствую».~
@1785  = ~«Приветствую».~
@1786  = ~Существо поворачивается к тебе, и вокруг его головы появляется ряд символов. Символы слабо светятся и просто… парят в воздухе.~
@1787  = ~Дабус спокойно ждёт, его руки спрятаны в рукава. Над головой появляется ряд символов, затем они исчезают, и появляется знак вопроса.~
@1788  = ~Перед тобой молодой Пыльный с щетиной на подбородке и тёмными кругами под глазами. Он с угрюмым выражением глазеет на стену.~
@1789  = ~Ты видишь Ожидающего-Смерть. Кажется, он не подозревает о твоём присутствии.~
@1790  = ~Ты видишь крупного мужчину с тёмной кожей и угрюмым выражением лица. На нём одежды Пыльных, он смотрит на тебя неподвижным взглядом.~
@1791  = ~«Приветствую».~
@1792  = ~::Чешет затылок::~
@1793  = ~«Я вернусь с распиской!»~
@1794  = ~Этот маленький иссохший человек кажется ещё меньше из-за своих огромных одежд Пыльного; они смотрятся так, будто были специально подобраны скрывать его размеры. Хотя по виду ему уже далеко за девяносто, он необычайно энергичен… непрестанно ёрзает, а его глаза мечутся по бару, как у птицы.~
@1795  = ~Глаза человека вспыхивают, когда он замечает тебя, и он слегка кивает в приветствие. «Привет и рад встрече, путешественник. Ты выглядишь так, будто только что оказался в Сигиле… — он прерывается. — Прости, мы не встречались раньше? Твоё лицо кажется немного знакомым».~
@1796  = ~Когда ты подходишь, пожилая женщина оборачивается и пристально на тебя смотрит. «Ба, глядите-ка кто пришёл окликнуть Сере сегодня… любимый сын смерти, — она оглядывает тебя сверху донизу, затем недоверчиво трясёт головой. — Во имя всех сил и их матерей, парень… из какого *склепа* ты выполз?»~
@1797  = ~«Ни из какого склепа я не выползал».~
@1798  = ~Эта медная монета была «обточена»… большая часть меди состругана, но сделавший это несомненно постарался, чтобы она всё ещё выглядела как обычная монета. А из стружки, по-видимому, хотели сделать другую монету. Она ничего не стоит.~
@1799  = ~Кто ты? Что ты делаешь на нашей территории?~
@1800  = ~Ты видишь спокойную, собранную женщину. У неё чёткие, ярко выраженные черты лица. Голос её низкий и уверенный: «Я — Кристалл, лидер Ангелов-Лезвий. Ты находишься в нашем доме. Что тебе от меня надо?»~
@1801  = ~Эта приземистая пожилая женщина выглядит так, будто она полностью выцвела: всё, начиная от волос, шали и заканчивая платьем, выдержано в серых тонах. Единственные проблески цвета исходят от нескольких пучков трав, привязанных к её поясу. Когда она двигается, пучки трав издают странное *свш-ш-ш*, напоминающее звук метущей метлы.~
@1802  = ~«Приветствую».~
@1803  = ~Старая Меббет~
@1804  = ~Бабка-повитуха~
@1805  = ~Этот мужчина одет в грязную рваную коричневую одежду, длинный капюшон закрывает большую часть его лица.~
@1806  = ~Ладно. Я приду позже.~
@1807  = ~Назад в Похороненную деревню~
@1808  = ~Проход на Площадь Мусорщиков~
@1809  = ~Ты видишь устало выглядящую женщину, одетую в тугой кожаный корсаж и леггинсы. Её облаком окружает запах дешёвой косметики, а лицо покрыто обильным слоем пудры. Завидев тебя, она улыбается: «Почему бы тебе не остановиться и не поболтать со мной, милый?»~
@1810  = ~Женщина жеманно смотрит на тебя. «Ты щас похож на красавчика, который что-то *потерял*. Может, я помогу тебе найти это, здоровяк?» — она слегка улыбается.~
@1811  = ~Монумент похож на один из тех, что были рядом с Мортуарием. На нём тоже нет никаких опознавательных знаков.~
@1812  = ~«А? — она выглядит озадаченной. — Ты о чём?»~
@1813  = ~Её тон становится деловым: «Ага, красавчик, теперь стоит поговорить о гонораре за находку».~
@1814  = ~«Пара медяков за *взгляд* на потерянное, и десять — чтоб взаправду найти».~
@1815  = ~«Думаю, ты найдёшь, что искал. Пошли за мной, красавчик».~
@1816  = ~Женщина улыбается: «Не хватает медяков, а? Не волнуйся, красавчик… вернёшься, когда кошелёк потяжелеет».~
@1817  = ~Женщина вмешивается: «За мимира заплатишь вдвое… как и за любого другого выродка».~
@1818  = ~«Какая удача! Возможно, то, что мы потеряли, найдётся у тебя в постели, мисс».~
@1819  = ~«Может, ты и поможешь мне найти то, что я потерял, мисс».~
@1820  = ~«Вообще-то, я потерял дневник».~
@1821  = ~«Ничего я не потерял, но у меня есть вопросы…»~
@1822  = ~«Я должен идти. Прощай».~
@1823  = ~«Чтоб у тебя от сифилиса кишки усохли! Воняешь, как козопас, и одет так же модно, но в два раза уродливей!»~
@1824  = ~Женщина неодобрительно на тебя смотрит. «Я тебе не гид… — она хмурится, затем сводит два пальца вместе. — *Разве что* у тебя найдутся медяки, чтоб заплатить за моё время».~
@1825  = ~«Десять медяков. За серьёзный базар возьму больше».~
@1826  = ~«Твоя потеря. Когда устанешь терять и захочешь кой-чё найти, красавчик, — приходи ко мне».~
@1827  = ~«Вот и ладно», — она прячет медяки в кулак, где они сразу же исчезают. «А теперь…»~
@1828  = ~«Спрашивай, красавчик».~
@1829  = ~Её глаза подозрительно сужаются: «Город? Что о нём?»~
@1830  = ~«Имеешь в виду, что такое Сигил? — она пожимает плечами, затем оглядывается. — Это город у тебя под ногами, он везде вокруг тебя, — женщина улыбается. — Он махом проглатывает посетителей, ага».~
@1831  = ~«В центре планов, говорят, — она фыркает. — Если ты веришь этой фигне».~
@1832  = ~Она ухмыляется. «Ну так, красавчик, по словам серобородых, учёных, начальников и всяких прочих любителей потрещать шкатулкой, планы вроде как тянутся бесконечно, — она стучит себе по лбу. — И кто скажет, где этот „центр“?»~
@1833  = ~Она кладёт руки на бедра и надувает губы: «Зависит от твоих интересов, здоровяк».~
@1834  = ~«Я уже сделала тебе предложение, красавчик, и это хорошая цена. Не знаю, где ещё ты получишь такое же удовольствие, как со мной».~
@1835  = ~Она смеётся: «Это ты *меня* спрашиваешь? Что, подумываешь устроиться в нашу сестринскую общину, а?» Она почти захлёбывается от смеха… издаваемый звук похож на визг пьяной гарпии. В конце концов смех отступает, и она глубоко вздыхает: «Ты… ты забавный, ага».~
@1836  = ~Похоже, это покрытое пеплом дерево многое перенесло с тех пор, как его сюда пересадили.~
@1837  = ~Она понимающе улыбается: «Я просто… „обслуживаю“… фракции, красавчик. Я не имею с ними дел».~
@1838  = ~«Пыльные не ведут себя как Пыльные в моих объятиях, красавчик, — она усмехается. — Эти долбанутые так много говорят о смерти, но со мной они много не говорят, сечёшь?»~
@1839  = ~«Понятия не имею, где такое найти, красавчик. Глянь… где-нибудь ещё, — она улыбается. — Я знаю кой-какие места, с которых можешь начать».~
@1840  = ~«Фарод? Ну, *это* из самых серьёзных вопросов. Если хочешь знать о нём — это будет в три раза дороже».~
@1841  = ~Она пересчитывает твои монеты, затем пожимает плечами и убирает их: «Что ты хочешь знать о старом Фароде?»~
@1842  = ~Она пожимает плечами: «Поговаривают, он босс у Сборщиков. Целую армию подчинённых имеет».~
@1843  = ~«Ну, никто точно не знает, но если бы *меня* спросили, красавчик, я бы указала на Площадь Мусорщиков».~
@1844  = ~«Начальник, не подкинешь немного медяков… у меня… э-э… давненько уже ничего не было».~
@1845  = ~«Ну… я думаю, тебе это не повредит…»~
@1846  = ~«Я даже не хочу спрашивать, как ты собираешься это делать».~
@1847  = ~«Видишь ли… нам действительно надо идти, Морте. Прощай, мисс».~
@1848  = ~«Ага, большая старая куча тряпья и мусора в трёх кварталах на запад от Мортуария… все Сборщики кучкуются там. Поговаривают, и у Фарода тоже там логово».~
@1849  = ~«Ну, знаешь… эти малые собирают мертвяков за деньги. Жалкая участь».~
@1850  = ~«Да они просто не годятся для того, чем занимаюсь я».~
@1851  = ~Она плюёт и рисует полукруг у себя над сердцем. «Эта ведьма с клинками! Вся из себя высокая и могучая, хозяйка всего этого города, летающая и молчаливая. Убивает всех, кто попадает в её тень. Она присматривает за городом, ага… — она присвистывает. — И оставляет всё живое в нём *гнить*».~
@1852  = ~«Вот и всё, здоровяк».~
@1853  = ~«Для тебя… — она критически тебя изучает. — Семь медяков, ни больше ни меньше. За серьёзный базар возьму дороже».~
@1854  = ~«Для такого красавчика, как ты… — она широко улыбается, открывая ряд грязных зубов. — Трёх медяков будет достаточно, чтоб развязать мне язык». Она облизывает губы, затем хмурится: «За серьёзный базар возьму больше».~
@1855  = ~Анна ощетинивается, когда ты собираешься уйти с женщиной. «Ты чё, *рехнулся*… или просто идиот?!» — её хвост начинает мотаться из стороны в сторону, затем она резко поворачивается к шлюхе. «Хс-ст! — она размахивает своими кинжалами перед напуганной проституткой. — Вали, ты, сигильская шлюха!»~
@1856  = ~Она кружится вокруг тебя: «А ты, кобель долбаный — только попробуй ещё с кем-нибудь спутаться, и я тебе черешок-то подровняю, усёк?»~
@1857  = ~Женщина натыкается на тебя, затем отступает и смотрит с полуулыбкой. От неё пахнет, как от винокурни.~
@1858  = ~«При-ве-е-ет… — она машет тебе рукой, затем её разбирает смех. — При-ве-ет, здоровяк». Она снова смеётся.~
@1859  = ~Она смотрит на тебя искоса, кладёт руки на бёдра и наклоняется достаточно, чтобы предоставить тебе полный обзор своей груди сверху. «Разве я *плоха* для тебя, здоровяк?! А? — она вся встряхивается, затем снова начинает смеяться. — Ты выглядишь так, будто тебе просто необходима любовь и забота!» Для пущей убедительности она тыкает пальцем тебе в грудь.~
@1860  = ~Она одаривает тебя насмешливо-строгим взглядом: «Я могу быть твоей, если мне понравится твоя цена». Она прижимается к тебе: «Итак?»~
@1861  = ~Она надувает губы: «Чтоб ты сифилис подхватил! Поглядим, найдёт ли такой как ты кого-то лучше меня».~
@1862  = ~«Тогда ладно». Она оглядывает тебя с ног до головы, и, кажется, немного трезвеет: «Э-э… не, не думаю, что я с тобой справлюсь…»~
@1863  = ~«О, так ты думаешь, *я* могу помочь *тебе*?! Ого, да ты у нас требовательный здоровячок! Ну же, польсти мне ещё!» — она улыбается.~
@1864  = ~«Да!» — она пьяно улыбается.~
@1865  = ~«Не-е-е-ет!» Она выглядит весьма удивлённой и для пущей выразительности тыкает тебя в грудь: «Нет! Нет!»~
@1866  = ~«Да-а-а-а? — она косится на тебя. — Чё хошь-то?»~
@1867  = ~Ты уже собираешься уйти, но что-то тебя останавливает. Внезапно ты чувствуешь, что-то здесь *не так*… и с этим чувством приходит осознание того, что пьяное состояние этой женщины — просто игра. Приглядевшись, ты замечаешь, как проститутка что-то прячет себе в рукав… по-видимому, что-то твоё.~
@1868  = ~Ты выбрасываешь руку и как клещами хватаешь её за запястье. Она моментально трезвеет, отчаянно пытаясь высвободить руку, и начинает изо всей мочи кричать.~
@1869  = ~Она отдёргивает руку назад, прежде чем тебе удаётся её схватить. Пьяное выражение женщины исчезает, и она начинает изо всей мочи кричать.~
@1870  = ~Пьяное выражение женщины улетучивается, и она начинает изо всей мочи кричать.~
@1871  = ~Она продолжает попытки вырвать руку, одновременно зовя на помощь. Голос у женщины просто невероятно зычный… в твоих ушах уже звенит.~
@1872  = ~Она продолжает попытки вырвать руку, одновременно зовя на помощь. Голос у женщины невероятно зычный… он просто разрывает твои уши.~
@1873  = ~Возможно, ты настороже благодаря собственному навыку карманной кражи, но отворачиваясь, чтобы уйти, ты чисто инстинктивно проверяешь кошелёк… и замечаешь, как проститутка убирает от него свою руку. Однако она не поняла, что ты её заметил.~
@1874  = ~Ты наклоняешься ближе, тоже смеясь, и видишь, как её рука снова ныряет в твой кошелёк… её быстрота и техника, с какими она таскает монеты из кошелька, никак не сочетаются с пьяной болтовнёй (и её грудью). Рукава выглядят достаточно длинными и просторными, чтобы быстро спрятать любой украденный предмет. Ты запоминаешь её технику… даже несмотря на то, что её руки делают ещё одну ходку в твой кошелёк.~
@1875  = ~Должно быть, есть *что-то* в интонации твоего голоса, потому как она замирает и смотрит на тебя большими испуганными глазами.~
@1876  = ~Она кивает и засучивает свои длинные просторные рукава, открывая маленький подбитый мешочек, висящий на её запястье. Судя по всему, в него она и бросает украденные монеты; подбивка приглушает любой их звон. Без единого слова она отдаёт мешочек тебе… он заполнен несколькими дюжинами медяков.~
@1877  = ~Она достаёт из подвязки другой мешочек и протягивает его тебе. Он наполнен медяками, которые ты высыпаешь в свой кошелёк.~
@1878  = ~Она медленно опускает руку в сапожок, достаёт странный стилетоподобный кинжал и протягивает его тебе рукояткой вперёд. Затем она опускает руку в другой сапожок, достаёт *другой* кинжал — ещё опаснее первого, с широким лезвием — и протягивает его тебе, также рукояткой вперёд. Потом она встряхивает головой, открывая небольшую серёжку, которая была спрятана за копной волос. Она отстёгивает её и передаёт тебе.~
@1879  = ~Она кивает.~
@1880  = ~Когда твоя рука сжимает ей шею, её глаза расширяются и она отчаянно кусает тебя за пальцы… но прежде чем она успевает высвободиться, слышится *хруст* и борьба затихает.~
@1881  = ~Ты отпускаешь её, и она сползает на землю. Это убийство далось тебе куда легче, чем с Пыльными. Ты чувствуешь странную дрожь, когда смотришь на её тело… ты *знаешь*, что раньше уже убивал таким способом. Однако воспоминания ускользают в подсознание, несмотря на твои отчаянные попытки зацепиться за них.~
@1882  = ~Ты отпускаешь её, и она сползает на землю. Ты чувствуешь странную дрожь, когда смотришь на её тело… ты *знаешь*, что раньше уже убивал таким способом. С этой мыслью приходит какое-то воспоминание, но оно слишком слабо и уплывает в подсознание.~
@1883  = ~Женщина отступает, а затем вдруг начинает дико кричать во всё горло!~
@1884  = ~Анна внезапно шипит, когда ты отворачиваешься, и ты видишь, что пьяная женщина в испуге отступает.~
@1885  = ~Анна кивает на женщину, затем у неё в руках вырастают кинжалы. «Эта сучка обчистила тя, эт точно, — одно из лезвий оказывается приставленным к горлу женщины. — Ты недосчитаешься медяков после того, как эта сигильская шлюшка об тя потёрлась». ~
@1886  = ~Пьяная женщина смотрит на Анну, затем на тебя, и трясёт в испуге головой: «Я ничего не крала, здоровяк! Она ошибается!»~
@1887  = ~«А? — Анна рычит, её хвост начинает хлестать как плётка. — *Уверена* ли я?» Её клинок входит глубоко в горло женщины. «Ага… я уверена». Её глаза сужаются, когда она смотрит на тебя. «Ты мне не веришь? — она сплёвывает. — Неважно. Я выпотрошу её и заберу всё добро».~
@1888  = ~«А? — Анна шипит, как кошка. — Ты чё, *тупой*?! Она ж тя обобрала».~
@1889  = ~Женщина выдерживает паузу, кивает, затем медленно засучивает рукава, чтобы открыть небольшой мешочек, привязанный к её запястью. Анна срезает его и убирает в карман. «А ты б лучше валила, — она отталкивает женщину. — Ш-ш-ш! Исчезни!»~
@1890  = ~Анна долго молчит, потом отводит кинжал и отступает в сторону. Затем шипит и плюёт женщине под ноги: «Ш-ш-ш! Исчезни!»~
@1891  = ~Анна ухмыляется, затем резким взмахом кинжала… вспарывает рукав платья женщины, обнажая мешок, привязанный к её запястью. Похоже, он привязан там для того, чтобы быстро прятать деньги.~
@1892  = ~Женщина кивает, затем медленно дотягивается и отвязывает небольшой мешочек от запястья. Анна выхватывает его и убирает в карман.~
@1893  = ~«Э-э… приветствую».~
@1894  = ~«Смотри куда прёшь, женщина!»~
@1895  = ~«Прощай».~
@1896  = ~«Прощай».~
@1897  = ~«Прощай».~
@1898  = ~«Прощай».~
@1899  = ~НОВАЯ ЖИЗНЬ~
@1900  = ~СВЯТОЙ СИМВОЛ ПЫЛЬНОГО СОЭГО
Вес: 1

Этот святой символ принадлежал Пыльному по имени Соэго. Символ из прочного железа; изготовлен так, чтобы крепиться вокруг кисти обладателя несколькими маленькими, прочно присоединёнными цепочками. Сам символ похож на кричащее лицо.~
@1901  = ~Осмотр скрижали показывает, что перо в ней принадлежит врокам, одной и многих рас танар'ри, населяющих Бездну. Вроки похожи на огромных грифов, и танар'ри часто используют их в качестве разведчиков в Кровавой Войне.~
@1902  = ~СКРИЖАЛЬ ДХАЛЛА
Особенности: знание легенд навсегда увеличивается на 1
Вес: 0
Доступно: магам

Осмотр скрижали показывает, что перо в ней принадлежит врокам, одной и многих рас танар'ри, населяющих Бездну. Вроки похожи на огромных грифов, и танар'ри часто используют их в качестве разведчиков в Кровавой Войне.

Дхалл использовал эту скрижаль всю свою жизнь, поэтому она хранит некоторые воспоминания и кое-какой опыт. Сломав её, ты обретёшь часть знаний скрижали — это даст тебе добавку к Знанию легенд.~
@1903  = ~ХАРИЗМА

Эта характеристика отражает убедительность, обаяние и способность к лидерству. Чем выше значение харизмы, тем лучше к персонажу будут относиться окружающие.~
@1904  = ~Ты видишь крупного мужчину. Выражение его лица просто каменное.~
@1905  = ~«Приветствую».~
@1906  = ~Пройти мимо.~
@1907  = ~Мужчина бросает на тебя взгляд, хрюкает, затем поднимает руку, показывая спрятанный кинжал. Он зло улыбается и начинает угрожающе им покручивать.~
@1908  = ~Напасть на него.~
@1909  = ~«Ну, прощай…»~
@1910  = ~Мужчина медленно поднимает голову, когда ты приближаешься. Он оглядывает тебя и с отвращением усмехается. «Всеми кругами ада, ты ещё кто? — он морщит нос. — Похоже, Пыльные потеряли одного из своих гниющих парней». Он смеётся: «Ха! *Никогда* не видал ничего уродливее».~
@1911  = ~«Кроме своего отражения?»~
@1912  = ~«Ты бы попридержал язык, или он упадёт к твоим ногам».~
@1913  = ~«Прощай».~
@1914  = ~Мужчина на секунду выглядит опешившим, затем снова ухмыляется, трогая рукоять клинка. «Тебе надо пустить кровь, приятель».~
@1915  = ~«Только достань этот клинок, и единственным, чья кровь прольётся, будешь ты сам».~
@1916  = ~«Угомонись, мне незачем с тобой драться».~
@1917  = ~Напасть на него.~
@1918  = ~«Прощай».~
@1919  = ~Он выхватывает своё оружие: «Поглядим, говнюк, поглядим…»~
@1920  = ~«О, незачем, да? — он плюёт тебе под ноги. — Что, жиденькая кровь труса в венах, а, кретин? Или она вся уже вытекла, когда тя били в последний раз?»~
@1921  = ~«Насколько помню, это у твоей мамаши была жиденькая кровь труса в венах… а значит, в этом городе у половины ублюдков такая же, по моим прикидкам».~
@1922  = ~«Прекрати это, пока не начались неприятности».~
@1923  = ~Напасть на него.~
@1924  = ~«Прощай».~
@1925  = ~Мужчина моргает, пытаясь переварить твои слова, затем его лицо искажает гримаса гнева. Он достаёт свой клинок и кидается на тебя.~
@1926  = ~«Не-не, пень, не всё так просто. Тебе придётся *заплатить* за привилегию не быть проткнутым клинком».~
@1927  = ~«Ладно. Сколько?»~
@1928  = ~«А твоя мать платы не требовала. Почему ты требуешь?»~
@1929  = ~«А твоя мать платы не требовала. Почему ты требуешь?»~
@1930  = ~Напасть на него.~
@1931  = ~Просто уйти.~
@1932  = ~«Я так думаю, вся твоя наличность уладит дело, — он смеётся. — Давай, выкладывай».~
@1933  = ~«Может, в следующий раз ты дважды подумаешь, прежде чем заговаривать со мной, ты, выблядок своей мамаши».~
@1934  = ~«Ага, двигай обратно в лавку мясника, трус», — он смеётся.~
@1935  = ~«Ай… мои искреннейшие извинения, здоровяк… ты чё, глухой?» — бандит смотрит на тебя презрительно. «По голове больше чем надо били? — он стучит себя по голове для выразительности. — С тобой чё, надо разговаривать помедленней, пень?»~
@1936  = ~Отдать ему все свои деньги.~
@1937  = ~Напасть на него.~
@1938  = ~Уйти.~
@1939  = ~«*Что* ты сказал?»~
@1940  = ~Плюнуть и уйти.~
@1941  = ~Напасть на него.~
@1942  = ~«*Что* ты сказал?»~
@1943  = ~Плюнуть и уйти.~
@1944  = ~Напасть на него.~
@1945  = ~«Я тебя предупреждал…»~
@1946  = ~Защищаться…~
@1947  = ~Напасть на него.~
@1948  = ~Уйти.~
@1949  = ~Он поднимает руки, когда ты достаёшь свои деньги. «Не, трус, попридержи-ка их немного… Думаю, я всё равно возьму их потом, а сперва я тя выпотрошу, — он обнажает клинок и улыбается. — Сделаю тя ещё уродливей, чем щас».~
@1950  = ~Защищаться…~
@1951  = ~«А? — он ухмыляется. — Опять ты, пень? Тебе чего, милостыню надо? Попрошайничай в другом месте». Он оглядывает тебя сверху донизу: «Никогда не видел ничего уродливее».~
@1952  = ~«Кроме своего отражения?»~
@1953  = ~«Кроме своего отражения?»~
@1954  = ~«Ты бы попридержал язык, или он упадёт к твоим ногам».~
@1955  = ~«Прощай».~
@1956  = ~При твоём приближении мужчина отступает; трусоватым, хищным огоньком в глазах он напоминает падальщика… с одного взгляда на него становится понятно, что он оценивает, сможет ли одолеть тебя. Дрожь в его голосе выдаёт неуверенность: «Оставь меня в покое, я н-н-ничего те не сделал».~
@1957  = ~«Даже не думай нападать на меня, или у моего клинка появится новое пристанище».~
@1958  = ~«На *драку* нарываешься?»~
@1959  = ~«Ничего я не нарываюсь… — когда он говорит, слюна брызжет у него изо рта, — …но те стоит поберечься, еси надумал, что меня побить сможешь!»~
@1960  = ~«Прощай».~
@1961  = ~«*Никто* со мной так не разговаривает, *никто* мне не угрожает. Возьми свои слова назад, пока говорить можешь. Второго шанса не будет!»~
@1962  = ~«Да, да. Просто держись подальше, а не то пожалеешь».~
@1963  = ~Напасть на него.~
@1964  = ~«Тогда прощай».~
@1965  = ~Он угрюмо на тебя смотрит.~
@1966  = ~«Ты меня *понял*? Возьми свои слова назад, или я тебя выпотрошу».~
@1967  = ~Он угрюмо на тебя смотрит.~
@1968  = ~«Ты меня *понял*? Держись подальше, или я тебя выпотрошу».~
@1969  = ~Напасть на него.~
@1970  = ~Уйти.~
@1971  = ~Напасть на него.~
@1972  = ~Уйти.~
@1973  = ~Его голос дрожит: «Я… забираю свои слова. Не хотел тя обидеть».~
@1974  = ~«Ладно. Вали с глаз долой».~
@1975  = ~«Проваливай».~
@1976  = ~Всё равно напасть на него.~
@1977  = ~«Тогда нам лучше не мозолить друг другу глаза. Ничего обидного, еси я прошёлся по одной с тобой улице».~
@1978  = ~«Ладно. Вали с глаз долой».~
@1979  = ~«Проваливай».~
@1980  = ~Всё равно напасть на него.~
@1981  = ~Ты видишь огненно-рыжую девушку, одетую в кожаный доспех. Её правая рука покрыта рядом смыкающихся пластин, напоминающих шкуру какого-то животного, а левую защищает рогатый наплечник. Как ни странно, у неё есть хвост… который раскачивается из стороны в сторону. «Отвали».~ [ANA377A]
@1982  = ~«Приветствую».~
@1983  = ~Пройти мимо.~
@1984  = ~Девушка тебя игнорирует.~
@1985  = ~«Кто ты?»~
@1986  = ~«Можешь сказать мне, где я?»~
@1987  = ~«Я ищу кое-кого по имени Фарод. Не знаешь, где мне его найти?»~
@1988  = ~«Я потерял дневник. Ты не видела ничего такого?»~
@1989  = ~«Тогда прощай».~
@1990  = ~Девушка ухмыляется и делает непристойный жест хвостом: «Иди ты, придурок».~
@1991  = ~«Ага, знаю. Могу и сказать кой-чего, если подсластишь вопрос, — она щёлкает языком и трёт двумя пальцами. — Медяки, ага?»~
@1992  = ~«„Медяки“?»~
@1993  = ~«„Медяки“?»~
@1994  = ~«Ладно… сколько?»~
@1995  = ~«Тогда забудь. Прощай».~
@1996  = ~Девушка недоверчиво глядит на тебя, а её хвост на минуту замирает. «Ты чё? Медяки — монеты… медь, серебро, золото… деньги, сечёшь? — она поднимает бровь. — Найдёшь немного — может, и у меня найдётся кой-чего, что захочешь услышать».~
@1997  = ~«Ладно. Сколько?»~
@1998  = ~«Сомневаюсь, что ты можешь сказать *хоть что-то* интересное мне, но попробуй. Тогда уж я решу, стоит ли это денег».~
@1999  = ~«Неважно. Прощай».~
@2000  = ~«Она имеет в виду деньги».~
@2001  = ~«Ох».~
@2002  = ~«Ага… — она глядит на Морте, затем пожимает плечами. — То, чё сказала черепушка. Твёрдая монета».~
@2003  = ~«Ладно. Сколько?»~
@2004  = ~«Сомневаюсь, что ты можешь сказать *хоть что-то* интересное мне, но попробуй. Тогда уж я решу, стоит ли это денег».~
@2005  = ~«Неважно. Прощай».~
@2006  = ~«А сколько дашь, чтоб узнать, а? — она тебя изучает, затем складывает руки. — Ну же, я тут весь день торчать не буду».~
@2007  = ~Попробовать очаровать: «Как насчёт десяти? Если информация интересная, может, добавлю».~
@2008  = ~«Как насчёт десяти? Достаточно?»~
@2009  = ~«Как насчёт двадцати?»~
@2010  = ~«Подозреваю, у меня не хватит денег, чтобы тебя заинтересовать».~
@2011  = ~«Неважно. Прощай».~
@2012  = ~«Этого куска меди не хватит даже Обречённому аппетит раззадорить. Тебе понадобится больше, чтоб подружиться здесь с кем-нибудь, чувак».~
@2013  = ~«Как насчёт двадцати?»~
@2014  = ~«Подозреваю, у меня не хватит денег, чтобы тебя заинтересовать».~
@2015  = ~«Неважно. Прощай».~
@2016  = ~«Ага, пойдёт…» — она прячет деньги. И делает это так быстро, что ты представления не имеешь, куда они исчезли. «Ищи его в аллее к шпилю отсюда… это на юго-запад от Мортуария, усёк?»~
@2017  = ~«Хорошо. У меня другие вопросы…»~
@2018  = ~«Странно… на юго-западе от Мортуария находится аллея, по которой шатаются хорошо вооружённые бандюги. Знаешь что-нибудь об этом?»~
@2019  = ~«Ты потерялся, но найдёшь щас только неприятности. Теряйся в другом месте, парниша».~
@2020  = ~«Сперва я хотел бы задать ещё кое-какие вопросы…»~
@2021  = ~«Тогда прощай».~
@2022  = ~«Да? И чего тебе надо?»~
@2023  = ~«Ты знаешь, что у тебя хвост?»~
@2024  = ~«Не могу удержаться, чтобы не спросить: ты знаешь о своём хвосте?»~
@2025  = ~«Можешь сказать мне, где я?»~
@2026  = ~«Я ищу кое-кого по имени Фарод. Не знаешь, где мне его найти?»~
@2027  = ~«Ты говорила, Фарода можно найти на юго-западе от Мортуария, так?»~
@2028  = ~«Странно… на юго-западе от Мортуария находится аллея, по которой шатаются хорошо вооружённые бандюги. Знаешь что-нибудь об этом?»~
@2029  = ~«Я потерял дневник. Ты не видела ничего такого?»~
@2030  = ~«Ничего. Прощай».~
@2031  = ~Рыжеволосая девушка хмурится, когда ты подходишь, а её хвост начинает раскачиваться взад и вперёд: «Ну? Чё надо?»~ [ANA238D]
@2032  = ~«Ты знаешь, что у тебя есть хвост?»~
@2033  = ~«Не могу удержаться, чтобы не спросить: ты знаешь о своём хвосте?»~
@2034  = ~«Можешь сказать мне, где я?»~
@2035  = ~«Я ищу кое-кого по имени Фарод. Не знаешь, где мне его найти?»~
@2036  = ~«Ты говорила, Фарода можно найти на юго-западе от Мортуария, так?»~
@2037  = ~«Странно… на юго-западе от Мортуария находится аллея, по которой шатаются хорошо вооружённые бандюги. Знаешь что-нибудь об этом?»~
@2038  = ~«Я потерял дневник. Ты не видела ничего такого?»~
@2039  = ~«Ничего. Прощай».~
@2040  = ~«Юго-запад от Мортуария? Спасибо. Прощай».~
@2041  = ~«*Знаю* ли я?» — девушка осматривает свой хвост. «Ну да! А я уж подумала, не обманывают ли меня глаза. Ого, да ты умный парень! — она скалится. — Почему б тебе не свалить в дыру, откуда выполз, и не оставить меня в покое?! Ни я, ни мой хвост не продаются, усёк?»~
@2042  = ~«Ладно… я просто поинте…»~
@2043  = ~«Ладно… у меня другие вопро…»~
@2044  = ~«Неважно. Прощ…»~
@2045  = ~«Да, но *почему* у тебя хвост?»~
@2046  = ~«Ладно… у меня другие вопросы…»~
@2047  = ~«Неважно… прощай».~
@2048  = ~«Да нет никакой разницы, что именно продавать: тебя или твой хвост. На жизнь ты в любом случае не наскребёшь».~
@2049  = ~«Э-э…»~
@2050  = ~«Ты эт о чём, паршивец?! Ну-ка повтори!»~
@2051  = ~«Он ничего не сказал… но мне всё же интересно… *почему* у тебя хвост?»~
@2052  = ~«Забудь о нём… у меня другие вопросы…»~
@2053  = ~«Он сказал, что ты не заработаешь на жизнь, продавая себя».~
@2054  = ~«Он сказал, что ты не заработаешь на жизнь, продавая себя. Я с ним не согласен».~
@2055  = ~«Он сказал, что ты не заработаешь на жизнь, продавая себя. Я с ним согласен».~
@2056  = ~«Неважно. Мы уходим. Прощай».~
@2057  = ~«Ага, сдрисни тогда».~
@2058  = ~Глаза девушки сужаются в щёлочки: «Ты чё, *идиот*? Тупее камня или, может, ты сама сила незнания? Да чтоб тобой дабус улицу выложил вместо кирпича!»~
@2059  = ~«Послушай…»~
@2060  = ~«Неважно. У меня другие вопросы…»~
@2061  = ~«Тогда прощай».~
@2062  = ~«Заткнись! Мне больше нечего тебе сказать, придурок! Вали!»~
@2063  = ~«Ты бы последила за своим языком, девка, или его отрежут. Помни это, когда мы снова встретимся».~
@2064  = ~Уйти.~
@2065  = ~«Ну всё, хватит с меня, девка… пора тебе умереть».~
@2066  = ~Уйти.~
@2067  = ~«Она тифлинг, шеф. В них есть немного крови демонов, и это делает их немного параноидальными, всегда готовыми защищаться… однако, симпатичный хвост. Жаль, что он принадлежит такому уродливому телу».~
@2068  = ~«Погоди, тогда…»~
@2069  = ~«Молодец, Морте».~
@2070  = ~«Те лучше попридержать своего гнойноротого мимира, а не то я ему челюсть проломлю, усёк?»~
@2071  = ~«Прощай».~
@2072  = ~Изверг выглядит удивлённым и поворачивается к тебе: «Ты не научил её манерам, странник?»~
@2073  = ~«Анна, полегче».~
@2074  = ~«Ну так *попробуй* проломить мне челюсть, девчонка! Пока я слышу только болтовню от всякого мусора из Улья! Давай, ударь меня! Ну! Я тебе ноги пооткусываю!»~
@2075  = ~«Хватит! Мы уходим».~
@2076  = ~«Хватит!»~
@2077  = ~«Нет. Она сама по себе и говорит, что хочет».~
@2078  = ~«Ага, верно. Попридержи своего мимира, чувак, а то я похороню его вместе с его телом, усёк?»~
@2079  = ~«Мимир — говорящая энциклопедия. Это я, шеф».~
@2080  = ~«Уяснил».~
@2081  = ~«Ага, тогда вали туда, откуда припёрся».~
@2082  = ~«И тебе до свидания».~
@2083  = ~Уйти.~
@2084  = ~«Ага, мимир! Чё, дыра между ушей такая большая, что эхо моих слов слышно? Идиот!»~
@2085  = ~«Ты всё ещё не ответила на мой вопрос. Что значит мимир?»~
@2086  = ~«Мимир? Ты о чём?»~
@2087  = ~«Ладно. Слушай, у меня другие вопросы…»~
@2088  = ~«Прощай».~
@2089  = ~Она смотрит на Морте, потом на тебя, а затем ухмыляется: «Дай я догадаюсь, у кого из вас есть мозги, а?»~
@2090  = ~«Да, да. Слушай, у меня другие вопросы…»~
@2091  = ~«Прощай».~
@2092  = ~«Да ладно? Хорошо, что я продаю трупы, ага? Вот тебя уже можно продать для печки Пыльных, череп».~
@2093  = ~«Чё за дела? Строишь из себя строгого делягу, да ещё клинья подбиваешь? — она ухмыляется. — Отвали, развратная мразь».~
@2094  = ~«Да ладно? Хорошо, что я продаю трупы, ага? Вот вас обоих уже можно продавать для печки Пыльных, — её хвост начинает раскачиваться из стороны в сторону. — Не заставляй меня записывать вас обоих в книгу мёртвых».~
@2095  = ~«Продаёшь трупы?»~
@2096  = ~«У меня другие вопросы…»~
@2097  = ~«Прощай».~
@2098  = ~«Нет пока… у меня другие вопросы…»~
@2099  = ~«Прощай».~
@2100  = ~«Ага, Пыльные платят любому, кто хочет почистить улицы от мертвяков и доставить их в Мортуарий. Это моя территория, так что даже не думай промышлять тут сбором трупов, понял?»~
@2101  = ~«Продаёшь трупы?»~
@2102  = ~«Успокойся, девка. Ответь мне ещё на кое-какие вопросы, а потом мы оставим тебя…»~
@2103  = ~«Это ни к чему не приведёт. Прощай».~
@2104  = ~Уйти.~
@2105  = ~«Зачем Пыльным трупы?»~
@2106  = ~«Твоя территория?»~
@2107  = ~«Хорошо».~
@2108  = ~«Прощай».~
@2109  = ~«Чтоб правильно похоронить. Послать всех в их родные планы и убедиться, что всё в мультивселенной мило и аккуратно».~
@2110  = ~«Ага, *планы*! Чё, дыра между ушей такая большая, что эхо моих слов слышно? Тьфу! Слишком много вопросов задаёшь. Валил бы ты и доставал кого другого своими вопросами».~
@2111  = ~«„Планы“?»~
@2112  = ~«Ясно. Слушай, у меня есть ещё вопросы…»~
@2113  = ~«Прощай».~
@2114  = ~«Всего только один вопрос…»~
@2115  = ~«Ладно тогда. Прощай».~
@2116  = ~«Ага, *моя* территория! Чё, дыра между ушей такая большая, что эхо моих слов слышно? Тьфу! Слишком много вопросов задаёшь. Валил бы ты и доставал кого другого своими вопросами».~
@2117  = ~«Всего только один вопрос…»~
@2118  = ~«Ладно тогда. Прощай».~
@2119  = ~«Эй, полегче, у меня вопросы…»~
@2120  = ~«Следи за языком, девка. Я сегодня *не в настроении*. Теперь давай отвечай на мой вопрос. Кто ты?»~
@2121  = ~«Э-э… прощай тогда».~
@2122  = ~Она странно на тебя смотрит: «Не… ничего такого не видела, не-а».~
@2123  = ~«Ладно. У меня другие вопросы…»~
@2124  = ~«Всё равно спасибо. Прощай».~
@2125  = ~«Да ладно? Мож, те лучше спросить у кого другого, где эта старая развалина находится?»~
@2126  = ~Правда: «Хватит врать. Скажи мне, девка, где Фарод, или тебя скоро запишут в покойнички».~
@2127  = ~Блеф: «Хватит врать. Скажи мне, девка, где Фарод, или тебя скоро запишут в покойнички».~
@2128  = ~«Может быть. Слушай, у меня другие вопросы…»~
@2129  = ~«Ага… — она изучает тебя. — Говорила. Ты чё, уже забыл?»~
@2130  = ~«Нет, но у меня есть ещё вопросы…»~
@2131  = ~«Нет, но мне было интересно, знаешь ли *ты*… видишь ли, на юго-западе от Мортуария находится аллея, по которой шатаются хорошо вооружённые бандюги. Знаешь что-нибудь об этом?»~
@2132  = ~«Не забыл. Прощай».~
@2133  = ~Ты видишь человека в длинных чёрных одеждах и с бледным лицом. Он похож на тех, кого ты видел в Мортуарии, но в отличие от них этот выглядит смущённым и всё время оглядывается. Заметив тебя, он поднимает руку, чтобы привлечь твоё внимание.~
@2134  = ~Ты видишь Пыльного в длинных чёрных одеждах и с бледным лицом. Он похож на Пыльных, которых ты видел в Мортуарии, но в отличие от них этот выглядит смущённым и всё время оглядывается. Заметив тебя, он поднимает руку, чтобы привлечь твоё внимание.~
@2135  = ~Кажется, мужчина испытывает облегчение, когда ты заговариваешь с ним. Он слегка кивает: «Спасибо, что откликнулись, путешественник. Я известен как Покрытый-Пеплом, представитель секты Пыльных. Меня интересует, не можете ли вы указать мне дорогу… Я не очень хорошо знаю этот район и ищу определённое здание — бар, куда часто заходят люди моей секты. Вы знаете это место?»~
@2136  = ~Пыльный кивает: «Ну, да, *фракция*, я имел в виду фракцию… секта, фракция, одно и то же, вообще-то… вы не знаете этот бар, куда часто заходят люди моей фракции?»~
@2137  = ~Он вздыхает и показывает руки: «К сожалению, должен сказать, что у меня нет денег».~
@2138  = ~Пыльный кивает и отвешивает прощальный поклон: «Спасибо, что уделили мне время».~
@2139  = ~Пыльный улыбается: «Премного благодарен, путешественник. Я ценю вашу доброту. Эти люди в Улье… редко помогают в таких делах».~
@2140  = ~Он кивает: «Ваша просьба разумна. Скажите, где я могу найти бар „Собиратели пыли“, и я буду рад ответить на любой ваш вопрос».~
@2141  = ~«Какие у вас вопросы?»~
@2142  = ~«Мне жаль, но это имя мне незнакомо».~
@2143  = ~«Я не знаю, где вам найти эту вещь. Я скорблю о её потере».~
@2144  = ~Мужчина слегка пожимает плечами: «Я сочувствую вашей потере. В нашей жизни так много ценного».~
@2145  = ~«Этот район… ну, здесь на северо-западе есть рынок. И какое-то правительственное здание на юго-западе… — он на мгновение задумывается. — Кажется, управление контроля за паразитами».~
@2146  = ~Он пожимает плечами: «Улей — большое место. Я знаю некоторые районы, но не все».~
@2147  = ~Мужчина моргает. «Ну… я не обычный Пыльный».~
@2148  = ~Он на минуту замолкает… затем кивает: «Буду рад. Мы… Пыльные… принимаем жизнь такой, какая она есть: шанс испытать наши страсти перед следующей жизнью. Мы просеиваем прах наших предыдущих жизней в поисках смысла для последующих».~
@2149  = ~Мужчина немного неловко кивает: «Ну так это… я Покрытый-Пеплом, представитель девятого круга».~
@2150  = ~Внезапно он напрягается: «У меня нет времени обсуждать с вами распорядок и иерархию секты Пыльных. Так что прошу меня извинить…»~
@2151  = ~Мужчина невинно смотрит на тебя, но ты видишь, что он нервничает: «Простите?»~
@2152  = ~Я не знаю, где это.~
@2153  = ~Он кивает: «Договорились. Больше мы не пересечёмся. Я найду, кого обчищ… э-э, чем заняться, где-нибудь ещё».~
@2154  = ~Ты уже собираешься уходить, когда внезапно чувствуешь что-то неладное. С подозрением, ты снова смотришь на Покрытого-Пеплом — как раз вовремя, чтобы заметить, как он что-то прячет в рукав… похоже, это что-то принадлежит тебе.~
@2155  = ~Ты бы и внимания не обратил, если бы не подозревал чего-то с самого начала. Во время одного из низких поклонов Покрытого-Пеплом ты замечаешь, как его рука проскальзывает по направлению к твоему кошельку.~
@2156  = ~Ты бы ничего не заметил, если бы не был предупреждён о Пыльном-карманнике. Во время одного из низких поклонов Покрытого-Пеплом ты замечаешь, как его рука проскальзывает по направлению к твоему кошельку.~
@2157  = ~Возможно, именно твоё собственное умение обчищать карманы заставляет тебя быть настороже. Собираясь уходить, ты инстинктивно проверяешь свой кошелёк… и замечаешь, как Покрытый-Пеплом убирает от него свою руку. Однако он вроде бы не понял, что ты его заметил.~
@2158  = ~Под предлогом дать ему дополнительные инструкции по географии города, ты вовлекаешь Покрытого-Пеплом в непринуждённый разговор и незаметно следишь за его движениями. Кажется, он полностью полагается на то, что вид Пыльного избавит от подозрений его жертву, и часто использует свои поклоны, чтобы прикрыть попытки обчистить карманы. Ты мысленно отмечаешь для себя его технику… а он как раз в очередной раз пытается залезть в твой кошелёк.~
@2159  = ~Ты выбрасываешь руку и хватаешь его запястье мёртвой хваткой. Пыльный морщится и рычит, пытаясь высвободится: «Отпусти меня, собака, или я позову стражу!»~
@2160  = ~Ты вскидываешь руку, но Покрытый-Пеплом резко отстраняется и его запястье тебе поймать не удаётся. Пыльный морщится и с испуганным выражением убегает!~
@2161  = ~Покрытый-Пеплом внезапно бросается бежать!~
@2162  = ~«Тьфу, — он кажется сильно раздражённым. — Что меня выдало?»~
@2163  = ~«И какие же у тебя вопросы?»~
@2164  = ~Он пожимает плечами. «Никто не подозревает Пыльного, — он натянуто хихикает. — Можно неплохо приподняться, прежде чем кто-нибудь застукает за этим занятием».~
@2165  = ~Его глаза сужаются: «У меня ничего нет. Ты у меня сегодня первый».~
@2166  = ~Он ворчит, прикидывает свои шансы одолеть тебя, думает ещё раз, затем касается подкладки одежды. Резким движением он отрывает часть подкладки и достаёт небольшой мешочек медяков, хранившийся там. И протягивает его тебе. У тебя вряд ли получилось бы найти, если бы он не показал.~
@2167  = ~Он обнажает зубы: «У меня больше ничего нет».~
@2168  = ~Как только ты собираешься обыскать мужчину, из его рукава неожиданно выскальзывает кинжал прямо ему в свободную руку. С рычанием он бросается на тебя!~
@2169  = ~Мужчина хмурится: «Ну и? Думаешь, я что-нибудь подобное видел? Я имею дело только с медяками, пень».~
@2170  = ~«И что с ним?»~
@2171  = ~«Ты меня отпустишь, если я скажу?»~
@2172  = ~Он плюёт на землю: «Тогда мне нечего сказать на эту тему».~
@2173  = ~«Фарод — босс Сборщиков. У него много парней в его тени, ходят слухи, что у них всё везде схвачено. Больше ничего о нём не знаю. Я бы был поосторожнее, если бы связывался с ним».~
@2174  = ~«У него хаза на Площади Мусорщиков… это такая большая куча мусора и тряпья к северо-западу отсюда. Валишь через северные ворота, затем на север, пока не упрёшься. Ходят слухи, что Фарод прячется в какой-то куче разного хлама, даже может закопался под ним. Кто знает? Теперь ты меня отпустишь?»~
@2175  = ~Он разъярен: «Ты *сказал*, что отпустишь меня».~
@2176  = ~Ты снова видишь Покрытого-Пеплом… он по-прежнему выглядит заблудившимся и что-то бормочет, глядя на здания.~
@2177  = ~«Боюсь, я забыл, куда вы указывали, сэр. Могу я просить вас указать направление снова?»~
@2178  = ~«Я ухожу! Оставь меня!»~
@2179  = ~«Я знаю, раньше вы не смогли мне помочь, сэр. Может, в этот раз вы подскажете, где искать бар, куда часто ходят люди из моей секты?»~
@2180  = ~«Приветствую».~
@2181  = ~Игнорировать его.~
@2182  = ~«Приветствую».~
@2183  = ~Игнорировать его.~
@2184  = ~«Знаешь, говорят, здесь какой-то карманник прикидывается Пыльным. Он тебе, случайно, не знаком?»~
@2185  = ~«„Секта“? Может, ты имеешь в виду „фракция“?»~
@2186  = ~«„Секта“? Ты же Пыльный: ты имеешь в виду „фракция“?»~
@2187  = ~«А, бар Пыльных? Он рядом с Мортуарием. Ориентируйся по главным воротам Мортуария, затем иди чётко на юго-запад. Пропустить невозможно».~
@2188  = ~«Слышал, как же. Рад буду тебе помочь… за вознаграждение».~
@2189  = ~Ложь: «Э-э… да, я слышал о нём. Рад буду тебе помочь… за вознаграждение».~
@2190  = ~Ложь: «Э-э… да, я слышал о нём. Рад буду тебе помочь… если ответишь мне на некоторые вопросы».~
@2191  = ~«Нет, извини, я не знаю, где это».~
@2192  = ~Ложь: «Нет, извини, я не знаю, где это».~
@2193  = ~«Я не могу тебе помочь, прощай».~
@2194  = ~«Я не могу тебе помочь, прощай».~
@2195  = ~«Знаешь, говорят, здесь какой-то карманник прикидывается Пыльным. Он тебе, случайно, не знаком?»~
@2196  = ~«Бар, который ты ищешь, находится рядом с Мортуарием. Ориентируйся по главным воротам Мортуария, затем иди строго на юго-запад. Пропустить невозможно».~
@2197  = ~«Слышал, как же. Рад буду тебе помочь… за вознаграждение».~
@2198  = ~«Слышал, как же. Рад буду тебе помочь… если ответишь мне на некоторые вопросы».~
@2199  = ~Ложь: «Э-э… да, я слышал о нём. Рад буду тебе помочь… за вознаграждение».~
@2200  = ~Ложь: «Э-э… да, я слышал о нём. Рад буду тебе помочь… если ответишь мне на некоторые вопросы».~
@2201  = ~«Нет, извини, я не знаю, где это».~
@2202  = ~Ложь: «Нет, извини, я не знаю, где это».~
@2203  = ~«Я не могу тебе помочь, прощай».~
@2204  = ~«Я не могу тебе помочь, прощай».~
@2205  = ~«Забудь тогда. Бар, который ты ищешь, рядом с Мортуарием. Ориентируйся по главным воротам Мортуария, затем иди чётко на юго-запад. Пропустить невозможно».~
@2206  = ~«Как насчёт ответить на несколько моих вопросов, и назовём это честной сделкой».~
@2207  = ~Ты видишь приятную молодую женщину. Её волосы в беспорядке, корсаж платья порван. Она в отчаянии озирается и вдруг замечает тебя.~
@2208  = ~«Приветствую».~
@2209  = ~Игнорировать её.~
@2210  = ~Древний свиток~
@2211  = ~Вортен~
@2212  = ~Вортен~
@2213  = ~Большой глабрезу~
@2214  = ~Большой глабрезу~
@2215  = ~Кестер~
@2216  = ~Кестер~
