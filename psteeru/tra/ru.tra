@38888 = ~~
@38889 = ~~
@38890 = ~«Кто ты?»~
@38891 = ~«Кто ты?»~
@38892 = ~«Кто ты?»~
@38893 = ~«Кто ты?»~
@38894 = ~«Что это за место?»~
@38895 = ~«Что это за место?»~
@38896 = ~«Что это за место?»~
@38897 = ~«Что это за место?»~
@38898 = ~«Я думаю, тебе будет интересно знать: Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38899 = ~«Я думаю, тебе будет интересно знать: Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38900 = ~«Почему ты называешь меня „убийца“?»~
@38901 = ~«Да просто так зашёл. И уже собираюсь уходить».~
@38902 = ~«Кто ты?»~
@38903 = ~«Кто ты?»~
@38904 = ~«Кто ты?»~
@38905 = ~«Кто ты?»~
@38906 = ~«Почему ты называешь меня „убийца“?»~
@38907 = ~«Что ты от меня хочешь?»~
@38908 = ~«Вообще-то я здесь, чтобы уничтожить тебя».~
@38909 = ~«Я об этом подумаю».~
@38910 = ~«Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38911 = ~«Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38912 = ~Блеф: «Безмолвный Король слишком силён, чтобы нападать на него. Лучше держись подальше от Мёртвых Народов, иначе трупы тебя уничтожат».~
@38913 = ~«Пока сказать нечего».~
@38914 = ~«Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38915 = ~«Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38916 = ~Блеф: «Безмолвный Король слишком силён, чтобы нападать на него. Лучше держись подальше от Мёртвых Народов, иначе трупы тебя уничтожат».~
@38917 = ~«Пока сказать нечего».~
@38918 = ~«Что, ты вот так запросто решил меня прогнать?»~
@38919 = ~«Хорошо. Прощай».~
@38920 = ~«Ну, да. И я согласен работать на того, кто предложит лучшую цену».~
@38921 = ~«Нет».~
@38922 = ~«Я сохраню эту тайну».~
@38923 = ~«Интересно посмотреть, как у тебя это получится».~
@38924 = ~«Нет. Я думаю об имени. Скажи мне, о каком». Подумать: Фарод.~
@38925 = ~«Нет. Я думаю об имени. Скажи мне, о каком». Подумать: управление по контролю за паразитами и болезнями.~
@38926 = ~«Нет. Я думаю об имени. Скажи мне, о каком». Подумать: Безмолвный Король.~
@38927 = ~«Нет. Я думаю об имени. Скажи мне, о каком». Подумать: Живой Мертвец.~
@38928 = ~«Хорошо. Прощай».~
@38929 = ~«Что ты хочешь сказать?»~
@38930 = ~«Только если ты меня заставишь…»~
@38931 = ~«Я хочу сказать, что мы можем помочь друг другу».~
@38932 = ~«Ты знаешь, что я имею в виду. У меня есть способности, которые могут оказаться полезными тебе. А у тебя есть силы, которые нужны мне».~
@38933 = ~«Как мне тебя убедить?»~
@38934 = ~«Убеждать тебя? Какая мне в том нужда? Или ты мне веришь, или нет».~
@38935 = ~«Что ты вообще можешь мне предложить?»~
@38936 = ~«Что ты вообще можешь мне предложить?»~
@38937 = ~«Забудь всё, что я сказал. Я ухожу».~
@38938 = ~«Я могу убить всех вас прямо сейчас, и ты меня не остановишь. Я не могу умереть».~
@38939 = ~«Попробуй остановить меня».~
@38940 = ~Как только ты открываешь ворота, холодный ветер вырывается на волю. При звуках шепчущего голоса тебя охватывает дрожь, хоть ты и не можешь разобрать, что именно он говорит. Мгновение спустя всё проходит и воцаряется тишина. Ты осознаёшь, что уже был здесь раньше, и у тебя такое чувство, что компаньонам лучше с тобой не ходить.~
@38941 = ~Блеф: «Кого?»~
@38942 = ~«Кого?»~
@38943 = ~«Что ты вообще можешь мне предложить?»~
@38944 = ~«Что ты вообще можешь мне предложить?»~
@38945 = ~«И не подумаю. Я ухожу».~
@38946 = ~«Почему бы тебе этого не сделать?»~
@38947 = ~«Хорошо. Будет сделано».~
@38948 = ~«Что ты вообще можешь мне предложить?»~
@38949 = ~«Что ты вообще можешь мне предложить?»~
@38950 = ~«И не подумаю. Я ухожу».~
@38951 = ~«Дальше я пойду один. Ждите меня здесь».~
@38952 = ~~
@38953 = ~«Почему бы тебе этого не сделать?»~
@38954 = ~«Хорошо. Будет сделано».~
@38955 = ~«И это называется заинтересовать? Придётся тебе предложить что-то поинтереснее».~
@38956 = ~«Хорошо. Если это всё, что ты можешь мне дать, отказываться не буду. Что мне надо сделать?»~
@38957 = ~«Это могло бы сработать… если бы меня волновали мои компаньоны».~
@38958 = ~«Боюсь, не могу принять такие условия. Я ухожу».~
@38959 = ~«Хорошо. Что мне надо сделать?»~
@38960 = ~«Может быть. Но ты всё ещё не сказал, что можешь предложить в обмен на мои услуги».~
@38961 = ~«Может быть. Но ты всё ещё не сказал, что можешь предложить в обмен на мои услуги».~
@38962 = ~«Да, может, даже больше. Продолжай».~
@38963 = ~«Боюсь, не могу принять такие условия. Я ухожу».~
@38964 = ~«Почему бы тебе самому не заняться?»~
@38965 = ~«Хорошо. Что мне надо сделать?»~
@38966 = ~«Я там уже был».~
@38967 = ~«Я так не думаю. Я ухожу».~
@38968 = ~«Почему бы тебе самому не заняться?»~
@38969 = ~«Хорошо. Что мне надо сделать?»~
@38970 = ~Многие-как-Один, коллективный разум черепокрыс, попросил меня убить Безмолвного Короля в Мёртвых Народах. Я согласился. О выполнении задания нужно доложить Многим-как-Один.~
@38971 = ~«Тогда, может, заключим что-то вроде сделки?»~
@38972 = ~«И всё же я намерен попробовать. Умри, паразит!»~
@38973 = ~«Согласен».~
@38974 = ~«Почему бы тебе этого не сделать?»~
@38975 = ~«И не подумаю».~
@38976 = ~Я узнал, что гитиянки и гитцерай — конкурирующие расы. Очевидно, раньше они были одной расой, но разделились тысячелетия назад, и теперь их ненависть друг к другу не знает границ.~
@38977 = ~Многие-как-Один, коллективный разум черепокрыс, попросил меня убить Безмолвного Короля в Мёртвых Народах. Я согласился. О выполнении задания нужно доложить Многим-как-Один.~
@38978 = ~«Попробуй меня убить».~
@38979 = ~«Посмотри в мой разум и проверь, лгу ли я. Или не можешь?»~
@38980 = ~«Как мне доказать, что я не лгу?»~
@38981 = ~«Нет».~
@38982 = ~«Погоди! Мы можем договориться!»~
@38983 = ~«Я всегда готов…»~
@38984 = ~«Посмотри в мой разум и проверь, лгу ли я. Или не можешь?»~
@38985 = ~«Ты прав. Я вижу, что от тебя ничего не укроешь».~
@38986 = ~«Ты ошибаешься».~
@38987 = ~«Ты не можешь прочесть мои мысли. Почему?»~
@38988 = ~«Безмолвный Король? Кто это?»~
@38989 = ~Блеф: «Безмолвный Король? Кто это?»~
@38990 = ~«И какое?»~
@38991 = ~«Я отказываюсь».~
@38992 = ~«Ты не можешь читать мои мысли, не так ли?»~
@38993 = ~«Рискни».~
@38994 = ~«Нет, не могу. Я могу убить вас всех, и тебе не остановить меня».~
@38995 = ~«Почему ты не можешь читать мои мысли?»~
@38996 = ~«Тогда, может, нам стоит выработать что-то вроде соглашения».~
@38997 = ~«Отпусти меня, и я тебя больше не побеспокою».~
@38998 = ~«Согласен».~
@38999 = ~«Я отказываюсь».~
@39000 = ~Морте шепчет: «Это нехорошо шеф. Будь осторожен, а то тебе начисто выжгут мозги… чем их больше, тем они сильнее — каждая крыса добавляет себя к общему мозгу. Такой толпой они *смертельны*».~
@39001 = ~Морте шепчет: «Это нехорошо шеф. Будь осторожен, а то тебе начисто выжгут мозги… чем их больше, тем они сильнее — каждая крыса добавляет себя к общему мозгу. Такой толпой они *смертельны*».~
@39002 = ~Морте шепчет: «Не знаю, что они собрались делать, шеф, но следи за своими мыслями. Они — это групповой разум, каждая крыса добавляет себя к этому разуму, и дерутся они словно — прости за такое сравнение — загнанные в угол крысы. Мы сейчас на их территории, шеф, так что отступать им некуда. Не лезь в эту заварушку».~
@39003 = ~«Эй, вот так собрание мозговых паразитов! Лучше б нам свалить отсюда и пошустрее — пока они те мозги не расплющили! Видала я, как десяток-другой этих тварей устраивали засады на пьяниц, целые здания захватывали, и даже слышала, они заклинаниями кидаются, когда их много. Даже вообразить не могу, чё могут натворить несколько сотен…»~
@39004 = ~«Эй, вот так собрание мозговых паразитов! Лучше б нам свалить отсюда и пошустрее — пока они те мозги не расплющили! Видала я, как десяток-другой этих тварей устраивали засады на пьяниц, целые здания захватывали, и даже слышала, они заклинаниями кидаются, когда их много. Даже вообразить не могу, чё могут натворить несколько сотен…»~
@39005 = ~Анна шепчет тебе: «Ты сумел-таки вывести этих мозговошек из себя, ага? Тогда я вот что скажу: лучше б нам свалить отсюда и пошустрее, пока нам мозги не расплющили. Бандой они умнее, видала я, как десяток-другой этих тварей устраивали засады на пьяниц, целые здания захватывали, и даже слышала, они заклинаниями кидаются, когда их много. Даже вообразить не могу, чё может натворить такая толпа… а ты в них разбудил зверя. Будь осторожнее, ага?»~
@39006 = ~Анна шепчет тебе: «Ты сумел-таки вывести этих мозговошек из себя, ага? Тогда я вот что скажу: лучше б нам свалить отсюда и пошустрее, пока нам мозги не расплющили. Бандой они умнее, видала я, как десяток-другой этих тварей устраивали засады на пьяниц, целые здания захватывали, и даже слышала, они заклинаниями кидаются, когда их много. Даже вообразить не могу, чё может натворить такая толпа… а ты в них разбудил зверя. Будь осторожнее, ага?»~
@39007 = ~«Не знаю, в какую игру эти мозговошки с тобой играют, но если они предлагают мир, лучше соглашаться без базара. Толпой они умнее, ага, и стоит только подумать навредить им, стая такого размера запросто пошлёт тебя в книгу мёртвых».~
@39008 = ~«Не знаю, в какую игру эти мозговошки с тобой играют, но если они предлагают мир, лучше соглашаться без базара. Толпой они умнее, ага, и стоит только подумать навредить им, стая такого размера запросто пошлёт тебя в книгу мёртвых».~
@39009 = ~«Я пришёл сказать, что Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@39010 = ~«Я пришёл сказать, что Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@39011 = ~«Почему ты называешь меня „убийца“?»~
@39012 = ~«Да просто так зашёл. И уже собираюсь уходить».~
@39013 = ~«Но я пришёл сказать, что Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@39014 = ~«Но я пришёл сказать, что Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@39015 = ~«За что? И почему ты называешь меня „убийцей“?»~
@39016 = ~~
@39017 = ~«Но я зашёл случайно».~
@39018 = ~«Я пришёл сказать, что Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@39019 = ~«Я пришёл сказать, что Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@39020 = ~«Почему ты называешь меня „убийца“?»~
@39021 = ~«Я пришёл безо всякой цели. И попал я сюда случайно».~
@39022 = ~«Что ты имеешь в виду?»~
@39023 = ~~
@39024 = ~«Конечно».~
@39025 = ~«Нет».~
@39026 = ~«Я не знал, что они были частью тебя».~
@39027 = ~«Они же напали первыми».~
@39028 = ~«И что же это я никак не *начну* страдать, ты, побитый молью коврик коллективной глупости?»~
@39029 = ~«И что же это я никак не *начну* страдать, ты, побитый молью коврик коллективной глупости?»~
@39030 = ~«Я прошу пощады».~
@39031 = ~«А примирение между нами возможно?»~
@39032 = ~«И что же это я никак не *начну* страдать, ты, побитый молью коврик коллективной глупости?»~
@39033 = ~«Как нам помириться?»~
@39034 = ~«Меня сложно убить, и я знаю заклинания».~
@39035 = ~«Меня сложно убить».~
@39036 = ~«Я умею прятаться, и меня трудно обнаружить».~
@39037 = ~«Меня сложно убить, и я отличный воин».~
@39038 = ~«Всё же?»~
@39039 = ~«Да?»~
@39040 = ~«Да?»~
@39041 = ~«Да?»~
@39042 = ~«Да».~
@39043 = ~«Я пришёл сказать, что Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@39044 = ~«Я пришёл сказать, что Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@39045 = ~«Почему ты называешь меня „убийца“?»~
@39046 = ~«Вообще-то я здесь, чтобы уничтожить тебя».~
@39047 = ~«Да просто так зашёл. И уже собираюсь уходить».~
@39048 = ~«Я отказываюсь».~
@39049 = ~«И что нужно сделать?»~
@39050 = ~«Я не знал, что они были из твоего рода».~
@39051 = ~«Я готов…»~
@39052 = ~«Что ты от меня хочешь?»~
@39053 = ~«Интересно посмотреть, как у тебя это получится».~
@39054 = ~«Это что, спасибо такое?»~
@39055 = ~«Ну рискни, попробуй».~
@39056 = ~«Я здесь, чтобы тебя уничтожить».~
@39057 = ~«Что ты от меня хочешь?»~
@39058 = ~«Не дождёшься».~
@39059 = ~Она властно кивает: «Продолжай».~
@39060 = ~«Что ты здесь делаешь?»~
@39061 = ~Это был новый узел, но когда ты его увидишь — это будет уже старый узел. Вот такая вот фигня! Текст Текст Текст Слова Слова Слова. Один узел не похож на другой, все узлы разные…~
@39062 = ~~
@39063 = ~~
@39064 = ~~
@39065 = ~~
@39066 = ~~
@39067 = ~«Что ты здесь делаешь?»~
@39068 = ~«Что это за невероятный запах?»~
@39069 = ~«Что это за флакон в твоём ожерелье?»~
@39070 = ~«Не расскажешь мне об этом месте?»~
@39071 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@39072 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@39073 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@39074 = ~«Знаешь что-нибудь о Рейвел Клубок-Загадок?»~
@39075 = ~«Я уже говорил с девятью проститутками… ты не знаешь, где десятая ученица?»~
@39076 = ~«Неважно. Прощай».~
@39077 = ~«Кроме моей учёбы здесь? Вообще-то я кое-что ищу. Тебе, случайно, не доводилось сталкиваться с определённым запахом?»~
@39078 = ~«Учёбы?»~
@39079 = ~«Запахом?»~
@39080 = ~«Нет, я так не думаю…»~
@39081 = ~«Знаешь, пойду-ка я лучше. Прощай».~
@39082 = ~Вивьен кивает со слегка скучающим видом: «Совершенно верно. Мадам Грейс учит нас искусству общения и взаимодействия, способности влиять на других словом и помогает по-новому взглянуть на себя и других. Все проститутки здесь являются такими же ученицами».~
@39083 = ~«Ты… спрашивала, не сталкивался ли я с запахом?»~
@39084 = ~«Позволь спросить тебя о другом…»~
@39085 = ~«Это всё, что я хотел узнать. Прощай».~
@39086 = ~«Да, у меня есть особый „аромат“, который ушёл… *погулять*. Такое очень трудно… держать на одном месте. Я надеюсь, никто его не взял случайно… хотя ничего нельзя сказать наверняка, со всеми этими „дамами“ вокруг, — она хмурится. — Итак… не чувствовал ли ты, случайно, где-нибудь этот аромат?»~
@39087 = ~«Знаешь, ты и сейчас замечательно пахнешь…»~
@39088 = ~«Как аромат мог пойти погулять?»~
@39089 = ~«Не припоминаю ничего такого поблизости…»~
@39090 = ~«Какая жалость. Боюсь, я его никогда не найду».~
@39091 = ~«А как его узнать, когда найдёшь?»~
@39092 = ~«Я могу помочь…»~
@39093 = ~«Позволь спросить тебя о другом…»~
@39094 = ~«Удачи в поисках. Счастливо».~
@39095 = ~Мгновение она хмурится, затем улыбается тебе. «Да-да, и спасибо за комплимент… но, уверяю, этот запах — *ничто* по сравнению с моим личным ароматом», — она вздыхает.~
@39096 = ~«Как аромат мог пойти погулять?»~
@39097 = ~«Не припоминаю ничего такого поблизости…»~
@39098 = ~Вивьен качает головой. «Мои слова подразумевают догадку, что его *взяли*. Здешние „дамы“ иногда немного ревнивы. Уже случалось, что они брали мою парфюмерию. И вот теперь кто-то скрылся с моим личным ароматом… я над ним так долго работала, довела до совершенства, и вот *раз* — и его нет! Мне не нужны такие неожиданности! — Вивьен топает ножкой. — Я хочу вернуть свой аромат и хочу его прямо сейчас!»~
@39099 = ~«А как его узнать, когда найдёшь?»~
@39100 = ~«Я могу помочь…»~
@39101 = ~«Позволь спросить тебя о другом…»~
@39102 = ~«Удачи в поисках. Счастливо».~
@39103 = ~«Его узнаешь по запаху, уверяю. Необычайно притягательный аромат, особенно для мужчин».~
@39104 = ~«Я могу тебе помочь…»~
@39105 = ~«Позволь спросить тебя о другом…»~
@39106 = ~«Удачи в поисках. Счастливо».~
@39107 = ~Вивьен, похоже, колеблется: «Ты уверен? Я не хочу навязываться».~
@39108 = ~«Ничуть. Мне будет приятно помочь такой очаровательной женщине, как ты».~
@39109 = ~«Ничуть. Мне будет приятно помочь такой очаровательной женщине, как ты».~
@39110 = ~«А кто сказал, что ты навязываешься? Я это сделаю за вознаграждение».~
@39111 = ~«Если сомневаешься, то я, наверное, ничем не смогу помочь».~
@39112 = ~Вивьен улыбается и кивает тебе: «Ты очень добр. Хорошо… если натолкнёшься на него — прошу, дай мне знать. Я, в некотором роде, горю желанием его вернуть. Это действительно единственный-в-своём-роде аромат».~
@39113 = ~«Позволь спросить тебя о другом…»~
@39114 = ~«Мне пора идти. Прощай».~
@39115 = ~Вивьен закатывает глаза: «Как и следовало ожидать при твоей-то грубой внешности, типичный наёмник. Ладно… найдёшь мой аромат, и я помогу тебе с твоим».~
@39116 = ~«С моим?»~
@39117 = ~Она усмехается и тыкает в тебя пальчиком: «Да, с *твоим*. Этот отвратительный, едкий запах». Она принюхивается и морщит нос: «Похоже, он в самой твоей *коже*… от этой вони ванна не поможет».~
@39118 = ~«Как ты это сделаешь, и какая мне от того польза?»~
@39119 = ~«Забудь. Пустая трата моего времени».~
@39120 = ~«Отвечу на первый вопрос: я обладаю некоторым искусством, магическим по своей природе, в детали я вдаваться не буду, но оно позволяет мне создавать и менять чьи-либо запахи».~
@39121 = ~«А польза мне от того?..»~
@39122 = ~«Забудь. Пустая трата моего времени».~
@39123 = ~«Ты просто не можешь отрицать, что запах играет важную роль в том, как на тебя реагируют окружающие. Говорили тебе о том или нет, но я уверена, людей отпугивает этот твой запах смерти. Твоя харизма возрастёт, если ты будешь пахнуть немного приятнее, чем сейчас, знаешь ли».~
@39124 = ~«Ладно… найду я твой аромат».~
@39125 = ~«Забудь. Пустая трата моего времени».~
@39126 = ~«Тогда договорились. Если натолкнёшься — дай мне знать. Я, в некотором роде, горю желанием его вернуть. Это действительно единственный-в-своём-роде аромат».~
@39127 = ~«Позволь спросить тебя о другом…»~
@39128 = ~«Мне пора идти. Прощай».~
@39129 = ~«Ладно. Это просто вопрос времени. Не сомневаюсь, я найду его, с твоей помощью или без».~
@39130 = ~«Позволь спросить тебя о другом…»~
@39131 = ~«Мне пора идти. Прощай».~
@39132 = ~Вивьен улыбается. «Спасибо за комплимент… но уверяю тебя, этот запах — просто дешёвая туалетная вода по сравнению с моим личным ароматом», — она вздыхает.~
@39133 = ~«Твоим… „личным ароматом“?»~
@39134 = ~«Позволь спросить тебя о другом…»~
@39135 = ~«Это всё, что я хотел узнать. Прощай».~
@39136 = ~Вивьен опускает глаза на флакончик, висящий у неё на шее. «А… это. Это духи. Но я тебя уверяю, их запах просто ни в какое сравнение не идёт с моим „личным ароматом“», — она вздыхает.~
@39137 = ~«Твоим… „личным ароматом“?»~
@39138 = ~«Позволь спросить тебя о другом…»~
@39139 = ~«Это всё, что я хотел узнать. Прощай».~
@39140 = ~«Она же какая-то историческая личность? Не могу точно вспомнить. Кто она?»~
@39141 = ~«Ночная ведьма из прошлого Сигила, вроде так».~
@39142 = ~«Неважно… позволь спросить тебя кое о чём другом…»~
@39143 = ~«Забудь. Прощай».~
@39144 = ~«Тогда я надеюсь, что в прошлом она и останется. Ночные ведьмы — грязные создания, порочащие женщин на всех планах, — внезапно она прерывается. — Возможно, тебе стоит спросить Ивес? Она знает самые разные истории».~
@39145 = ~~
@39146 = ~«У меня вопрос о другом…»~
@39147 = ~«Это всё, что я хотел узнать. Прощай».~
@39148 = ~«Если бы я знала, где она, то сожгла бы её, а остатки сбросила бы в бездну! Чтобы гнусная тварь *никогда* не нашла своей драгоценной вуали и просидела в той комнате до конца дней своих!» — Вивьен фыркает.~
@39149 = ~«У меня вопрос о другом…»~
@39150 = ~«Тогда прощай».~
@39151 = ~«Бордель мадам Грейс? Это школа, здесь она учит нас искусству общения и взаимодействия, способности влиять на других словом и помогает по-новому взглянуть на себя и других. Для многих это подготовка к вступлению в ряды Общества Восприятия».~
@39152 = ~«Общества Восприятия?»~
@39153 = ~«Я хочу спросить о другом…»~
@39154 = ~«Это всё, что я хотел узнать. Прощай».~
@39155 = ~Вивьен вздыхает: «Возможно, тебе стоит поговорить о Чующих с Падшей Грейс, а ещё лучше — с кем-нибудь в Фестхолле. Уверена, они будут счастливы с тобой пообщаться».~
@39156 = ~«У меня вопрос о другом…»~
@39157 = ~«Это всё, что я хотел узнать. Прощай».~
@39158 = ~Вивьен кивает, понижая голос: «До меня тоже доходили такие слухи. По крайней мере, это объясняет её красные глаза… необычный цвет кожи. Однако я не знаю, насколько эти слухи верны. Поговори с Джульеттой, когда-то они с Кезай-Серрис были лучшими подругами, пока Джульетта не влюбилась в Монтекки».~
@39159 = ~«У меня вопрос о другом…»~
@39160 = ~«Тогда прощай».~
@39161 = ~«Десятая ученица? — она смотрит на тебя так, словно не расслышала. — Возможно, тебя слишком много били по голове. Или, может, одна из девочек решила сыграть с тобой в свои игры. Здесь нет десятой проститутки, или я ничего не знаю».~
@39162 = ~«У меня вопрос о другом…»~
@39163 = ~«Тогда прощай».~
@39164 = ~Вивьен приветствует тебя королевским поклоном. Она всё ещё окружена экзотическим эротичным запахом, от которого тебя так к ней и тянет.~
@39165 = ~«У меня кое-какие вопросы…»~
@39166 = ~«Просто проходил мимо. Прощай».~
@39167 = ~Вивьен приветствует тебя вежливой полуулыбкой: «Не посчастливилось ли тебе найти мой „личный аромат“?»~
@39168 = ~«Да… я его нашёл в этой малиновой вуали…»~
@39169 = ~«В некотором смысле… я уверен, он в потерянной вуали Мариссы, которую я вернул ей. Твой аромат у неё».~
@39170 = ~«Нет, но у меня вопросы…»~
@39171 = ~«Нет, но я продолжу искать. До свидания».~
@39172 = ~«Я одна из проституток мадам Грейс. Одна из её учениц здесь, в Борделе. Я готовлюсь вступить во фракцию Чующих, и моя семья порекомендовала мне это заведение как лучшее место для изучения самой себя и проверки твёрдости моих намерений».~
@39173 = ~«Фракция Чующих?»~
@39174 = ~«У меня вопрос о другом…»~
@39175 = ~«Это всё, что я хотел узнать. Прощай».~
@39176 = ~Глаза Вивьен загораются: «О, просто замечательно!» Она берёт у тебя вуаль, шепчет над ней несколько слов и возвращает тебе. Встряхивает копной своих тёмно-красных волос, и тут же тебя окружает самый экзотичный и возбуждающий аромат из всех, какие ты когда-либо чувствовал.~
@39177 = ~«Этот запах… великолепен…»~
@39178 = ~«Этот запах… великолепен…»~
@39179 = ~«Он прекрасен, не так ли? — она тебе улыбается. — И за то, что ты для меня сделал, я тоже кое-что сделаю для тебя. Подойди ближе, израненный…»~
@39180 = ~Подойти к ней.~
@39181 = ~«Нет, спасибо. Со мной и так всё в порядке. Прощай».~
@39182 = ~~
@39183 = ~~
@39184 = ~Ты подходишь к Вивьен ближе, она берёт твою ладонь, переворачивает её и осторожно принюхивается к твоему запястью. «Фу! — она морщит свой носик. — Уксус! Или… бальзамирующую жидкость? Вот, сейчас я уберу этот запах…» Она бормочет несколько странных слов, и лёгкое покалывание распространяется по всей твоей коже. Во мгновение ока исходящий от тебя запах химикатов существенно уменьшается. «Ну и как оно? Знаешь, теперь люди будут куда охотнее с тобой общаться».~
@39185 = ~«Спасибо, Вивьен. Прощай».~
@39186 = ~«Он прекрасен, не так ли? — улыбка неожиданно исчезает с лица Вивьен. — Ну, полагаю, теперь ты хочешь получить свою награду. Подойди ближе, израненный…»~
@39187 = ~Подойти к ней.~
@39188 = ~«Нет, спасибо. Со мной и так всё в порядке. Прощай».~
@39189 = ~На какой-то миг глаза Вивьен наполняются гневом: «Так это сделала *она*, да? Посмотрим. Стой тут, я скоро вернусь».~
@39190 = ~Ждать.~
@39191 = ~«Надо же! Это всё проясняет! Эта мерзкая ведьма… она вечно крала мои духи, но я и подумать не могла, что у неё хватит наглости взять мой „личный аромат“. Пф!» — она встряхивает копной своих тёмно-красных волос, и тут же тебя окружает самый экзотичный и возбуждающий аромат из всех, какие ты когда-либо чувствовал.~
@39192 = ~«Этот запах… великолепен…»~
@39193 = ~«Этот запах… великолепен…»~
@39194 = ~Вивьен поворачивается, чтобы поздороваться. Её и без того королевская красота стала просто потрясающей в окружении этого удивительно эротичного запаха… её экзотического «личного аромата», который ты ей вернул.~
@39195 = ~«У меня к тебе вопрос, Вивьен…»~
@39196 = ~«Просто проходил мимо. Прощай, Вивьен».~
@39197 = ~«Ты имеешь в виду Экко? Она прелесть. Тихая, — Вивьен хмурится. — Это может быть частью каких-то чар. Самые разные слухи ходят о том, почему она молчит, но я думаю, что её сердце было разбито самым ужасным образом. Долора может знать больше. Её видели в компании с мужчиной, в которого была влюблена Экко до того, как потеряла голос».~
@39198 = ~«У меня вопрос о другом…»~
@39199 = ~«У меня вопрос о другом…»~
@39200 = ~Анна что-то злобно бормочет, ты разбираешь слова «хренов» и «тупарь».~
@39201 = ~«Приветствую…»~
@39202 = ~Оставить её в покое.~
@39203 = ~«Приветствую. Я Ивес, Охотница-за-Рассказами».~
@39204 = ~Ивес невозмутимо продолжает: «Ты пришёл обменяться историями?»~
@39205 = ~«Почему бы и не обменяться, я люблю истории».~
@39206 = ~«У меня кое-какие вопросы…»~
@39207 = ~«Я просто проходил мимо. Прощай».~
@39208 = ~«Приветствую. Я Ивес, Охотница-за-Рассказами. Ты пришёл обменяться историями?»~
@39209 = ~«Почему бы и не обменяться, я люблю истории».~
@39210 = ~«У меня кое-какие вопросы…»~
@39211 = ~«Я просто проходил мимо. Прощай».~
@39212 = ~Ивес молча кивает.~
@39213 = ~«Почему тебя называют „Охотница-за-Рассказами“?»~
@39214 = ~«Что ты здесь делаешь?»~
@39215 = ~«Не расскажешь мне об этом месте?»~
@39216 = ~«Ивес… ты мне кое-кого напоминаешь. Твою мать, случайно, зовут не Ивана?»~
@39217 = ~«Ты уже поговорила со своей матерью, Ивес?»~
@39218 = ~«Может, обменяемся историями?»~
@39219 = ~«Не повторишь одну из тех историй, что ты уже рассказывала?»~
@39220 = ~«Что ты можешь мне рассказать о молчаливой проститутке?»~
@39221 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@39222 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@39223 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@39224 = ~«Знаешь что-нибудь о Рейвел Клубок-Загадок?»~
@39225 = ~«Я уже говорил с девятью проститутками… ты не знаешь, где десятая ученица?»~
@39226 = ~«Вообще-то забудь. Прощай».~
@39227 = ~Ивес качает головой: «Нет, но история про Мариссу довольно интересна. Хочешь её услышать?»~
@39228 = ~«Да, давай».~
@39229 = ~«Не сейчас. У меня другой вопрос…»~
@39230 = ~«Не сейчас. До встречи, Ивес».~
@39231 = ~Ивес качает головой: «Поговори с Ненни… она ухитряется быть повсюду и везде суёт свой нос».~
@39232 = ~«У меня другой вопрос…»~
@39233 = ~«Прощай, Ивес».~
@39234 = ~«История Рейвел Клубок-Загадок, устрашительницы детей, начинается и заканчивается вопросом: „Что может изменить природу человека?“»~
@39235 = ~«Продолжай…»~
@39236 = ~«Погоди… у меня вопрос…»~
@39237 = ~~
@39238 = ~~
@39239 = ~~
@39240 = ~Хр-р-р-ш-ш-ш-ш-пш-ш пр-р-р-ф-ф-ф-хр-р-р пс-с-с-пс-с~
@39241 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39242 = ~«Однажды престарелый мужчина из района Клерков исчез, а его тело никак не могли найти. Чтобы сокрыть улики, убийца закопал его на кладбище под другим трупом. Прорицатель указал, где можно найти тело. Там и копали, но нашли не то тело, которое искали. Пришлось отпустить убийцу, и никто не знал, где находится тело его жертвы, пока не решили перезахоронить то тело, которое нашли ранее. Только после этого обнаружилось тело старика.

Порой надо копать очень глубоко, чтобы докопаться до истины».~
@39243 = ~«Я… понимаю. Разреши ещё вопрос…»~
@39244 = ~«Ясно… продолжу копать. Счастливо, Ивес».~
@39245 = ~«Однажды девушка пришла к оракулу, который, по слухам, многое знал, и спросила его совета. Ей надо было выбрать жизненный путь, так что она спросила, чему же ей себя посвятить…»~
@39246 = ~«Продолжай…»~
@39247 = ~«Погоди… у меня вопрос…»~
@39248 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39249 = ~«Оракул вовсе не был злым, но изъяснялся весьма расплывчато и к тому же имел пристрастие к спиртному, что сделало его несколько неясным в вопросах суждений и направлений. Он только сказал девушке: в одной из историй, что та услышит за время своей жизни, будет истина, которую она ищет. Девушка ушла и начала собирать истории, охотится за ними и по сей день, не зная, в какой из тысяч и тысяч находится истина.

Такова опасность глупого вопроса и мудрость вопроса не заданного».~
@39250 = ~«У меня вопрос о другом…»~
@39251 = ~«Это всё, что я хотел узнать, Ивес. Счастливо».~
@39252 = ~«Однажды, в мире героев и мелких молодых богов, жили-были три сестры. Над ними висело проклятие: их внешность была так ужасна, что люди этих земель считали их демонами и все их избегали. Одна из них ужасно скучала по своим сёстрам, однако всё же покинула тот жалкий мир… но всего лишь променяла ничтожность пантеона на собственную ничтожность».~
@39253 = ~«У меня вопрос о другом…»~
@39254 = ~«Это всё, что я хотел узнать, Ивес. Счастливо».~
@39255 = ~«Я собираю истории и меняюсь ими с теми, у кого есть свои истории».~
@39256 = ~«Может, обменяемся историями?»~
@39257 = ~«У меня вопрос о другом…»~
@39258 = ~«Это всё, что я хотел узнать, Ивес. Счастливо».~
@39259 = ~«Это часть истории мадам Грейс, но не моя история. Она сказала, что когда её годы подойдут к концу, она мне её расскажет… и только в том случае, если я поклянусь ни с кем больше не делиться».~
@39260 = ~«Она надеется, что ей не придётся рассказывать мне свою историю, потому что я найду свою собственную историю раньше и покину это место. Я думаю, она боится, что моя жизнь пройдёт в собирании историй, а не в работе над тем, что я уже знаю, — Ивес тихо вздыхает. — Но ничего тут не поделаешь».~
@39261 = ~«Твоя собственная история?»~
@39262 = ~«У меня вопрос о другом…»~
@39263 = ~«Это всё, что я хотел узнать, Ивес. Счастливо».~
@39264 = ~«Много раз она загадывала эту загадку тем, кто приходил к ней, тем, кто жаждал усвоить хоть часть той странной магии, которой владела она одна. Все пытались ответить на её вопрос, но никто не преуспел… а ценой за неправильный ответ была ужасная судьба, всякий раз более ужасная, чем судьба предыдущей жертвы. Перечислять все их страдания — значит затронуть материю, из которой сотканы кошмары».~
@39265 = ~«Продолжай…»~
@39266 = ~«Погоди… у меня вопрос…»~
@39267 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39268 = ~«История мне видится так: Рейвел сама не знала ответа на свою загадку, но страстно его жаждала. В вопросе было важным одно лишь *почему*. Почему природа человека так важна для Серых Сестёр, особенно для такой могущественной, как Рейвел?»~
@39269 = ~«Продолжай…»~
@39270 = ~«Погоди… у меня вопрос…»~
@39271 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39272 = ~«Говорят, она задала свой вопрос и Госпоже Боли, не напрямую, но прокричав его самому Сигилу в надежде на ответ Госпожи. Когда ответа не последовало, она подняла волну ужасной магии, которая грозила распахнуть Клетку, и тогда ярость планов прокатилась бы по ней, словно волна».~
@39273 = ~«Продолжай…»~
@39274 = ~«Погоди… у меня вопрос…»~
@39275 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39276 = ~«Никакого ответа, кроме изгнания, она не получила. И по сей день никто не знает ответа на вопрос Рейвел… и не к кому больше обратиться, ведь Рейвел исчезла, потерялась в бесконечности планов».~
@39277 = ~«У меня вопрос о другом…»~
@39278 = ~«Это всё, что я хотел узнать, Ивес. Счастливо».~
@39279 = ~Ивес кивает: «Да, я бы очень этого хотела».~
@39280 = ~Рассказать ей историю своего пробуждения в Мортуарии.~
@39281 = ~Рассказать ей историю улицы Протяжных Вздохов.~
@39282 = ~Рассказать ей историю Безмолвного Короля.~
@39283 = ~Рассказать ей историю Безмолвного Короля.~
@39284 = ~Рассказать ей историю Построителя снов.~
@39285 = ~Рассказать ей историю проклятья Вонючки.~
@39286 = ~Рассказать ей историю аллеи Опасных Углов.~
@39287 = ~Рассказать ей историю Фарода.~
@39288 = ~Рассказать ей историю Игнуса.~
@39289 = ~Спросить кого-либо из своих компаньонов, есть ли у них история на обмен.~
@39290 = ~«Вообще-то я хотел задать вопрос…»~
@39291 = ~«Знаешь, давай в другой раз. До свидания, Ивес».~
@39292 = ~Ивес терпеливо ждёт твоей истории.~
@39293 = ~«Морте… у тебя есть история для обмена?»~
@39294 = ~«Анна… у тебя есть история для обмена?»~
@39295 = ~«Дак'кон… у тебя есть история для обмена?»~
@39296 = ~«Падшая Грейс… у тебя есть история для обмена?»~
@39297 = ~«Нордом, если у тебя есть история, пожалуйста, поделись ей с Ивес».~
@39298 = ~«Вообще-то, Ивес, позволь задать тебе вопрос…»~
@39299 = ~«Истории в другой раз. До свидания, Ивес».~
@39300 = ~Ивес наклоняется вперёд, когда ты рассказываешь историю своего пробуждения в Мортуарии Пыльных… она ловит каждое слово. Когда ты заканчиваешь, она улыбается: «Я запомню эту историю. Я тоже расскажу тебе историю о Пыльных — „Главы Пыли“».~
@39301 = ~«Продолжай…»~
@39302 = ~«Погоди… у меня вопрос…»~
@39303 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39304 = ~«Есть главы в книге мёртвых, массивном томе, куда Пыльные записывают всех, кто ушёл за Вечную Границу. В этой книге есть главы, в которых нет ничего, кроме пыли. Считается, что там записаны имена тех несчастных, кто не может умереть, но должны пережить пытку вечностью, пока сама история не окончит свой бег и не дарует им освобождение».~
@39305 = ~«У меня есть ещё одна история».~
@39306 = ~«У меня к тебе вопрос, Ивес…»~
@39307 = ~«Мне пора идти. Счастливо, Ивес».~
@39308 = ~Ивес наклоняется вперёд, когда ты рассказываешь историю улицы, рождающей новую жизнь… она ловит каждое слово. Когда ты заканчиваешь, она улыбается: «Я запомню эту историю. А теперь у меня есть одна для тебя. Прежде чем начать, я должна спросить: знаешь ли ты, кто такие модроны?»~
@39309 = ~«Да».~
@39310 = ~«Нет…»~
@39311 = ~«Тогда я расскажу тебе историю „Часы и квадрон“».~
@39312 = ~«Продолжай…»~
@39313 = ~«Погоди… у меня вопрос…»~
@39314 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39315 = ~«Давным-давно жил-был модрон. Свежесобранный, логика его была свежа и ещё не протестирована. Он пришёл в Сигил, следуя командам старших модронов».~
@39316 = ~«Продолжай…»~
@39317 = ~«Погоди… у меня вопрос…»~
@39318 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39319 = ~«Он ничего не знал, кроме команд и директив. Он ничего не умел, кроме как следовать указаниям начальства. Замечу, что модроны подчиняются только командам непосредственных начальников — большего авторитета для них нет. До того случая».~
@39320 = ~«Продолжай…»~
@39321 = ~«Погоди… у меня вопрос…»~
@39322 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39323 = ~«МЫ ПРИКАЗЫВАЕМ ТВОИМ КОМПАНЬОНАМ ЗАМОЛЧАТЬ. ТЫ ДОСТАВИЛ НАМ БОЛЬ, МНОГО БОЛИ, А ТЕПЕРЬ МЫ ТРЕБУЕМ ОТ ТЕБЯ КОМПЕНСАЦИИ».~
@39324 = ~~
@39325 = ~ывпфвжадрдард~
@39326 = ~~
@39327 = ~~
@39328 = ~«Однажды он зашёл в небольшую лавку, где висели маленькие часы, которые больше не ходили. Они потрескались по краям, шестерёнки их стрелок сломались. Модрон немедленно приступил к восстановлению поломанных часов».~
@39329 = ~«Продолжай…»~
@39330 = ~«Погоди… у меня вопрос…»~
@39331 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39332 = ~«Он сконструировал для часов новый деревянный корпус, заменил старые пружины, наладил и смазал все часовые механизмы и установил новые стрелки из какого-то редкого металла, какой бывает только у них. Тиканье починенных часов напомнило ему о великих механизмах Механуса, и ему это было настолько приятно, насколько вообще что-либо может быть приятно модрону».~
@39333 = ~«Продолжай…»~
@39334 = ~«Погоди… у меня вопрос…»~
@39335 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39336 = ~«А вот чего модрон так и не смог понять, так это того, что он на самом деле *полюбил* те часы, над которыми поработал. И по причинам, которые он и сам не смог бы объяснить, он решил остаться в Сигиле и быть со своими часами до конца своих дней».~
@39337 = ~«У меня есть ещё одна история».~
@39338 = ~«У меня к тебе вопрос, Ивес…»~
@39339 = ~«Мне пора идти. Счастливо, Ивес».~
@39340 = ~«Модроны — создания абсолютного порядка, они даже ближе к машинам, чем к живым существам. Существует много разновидностей модронов, но все они занимают своё место в жёсткой, тщательно организованной иерархии. Они так связаны с этой системой, что не могут общаться или даже предположить существование каких-то других модронов, кроме непосредственных начальников или подчинённых».~
@39341 = ~«Теперь я понял».~
@39342 = ~«Погоди… у меня вопрос…»~
@39343 = ~«Поговорим в другой раз, Ивес. Счастливо».~
@39344 = ~Ивес наклоняется вперёд, когда ты рассказываешь историю тайного народа мёртвых, управляемого трупом, который не говорил уже тысячу лет… она ловит каждое слово. Когда ты заканчиваешь, она улыбается: «Я запомню эту историю. А теперь у меня есть одна для тебя — „Проситель у ворот“».~
@39345 = ~«Продолжай…»~
@39346 = ~«Погоди… у меня вопрос…»~
@39347 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39348 = ~«Было далеко за пик, когда послышались первые гулкие удары в ворота Тюрьмы».~
@39349 = ~«Продолжай…»~
@39350 = ~«Погоди… у меня вопрос…»~
@39351 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39352 = ~«Карус — старейший Убийца Милосердия из известных во фракции — медленно слез со своего сидения и поплёлся к громадным воротам, которые отделяли осуждённых от внешнего мира. Стук не смолк и тогда, когда он подошёл к воротам и заговорил».~
@39353 = ~«Продолжай…»~
@39354 = ~«Погоди… у меня вопрос…»~
@39355 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39356 = ~«Он окликнул, но ответа не последовало. Тогда он открыл ворота без особой боязни, но со странным, непонятным ему чувством».~
@39357 = ~«Продолжай…»~
@39358 = ~«Погоди… у меня вопрос…»~
@39359 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39360 = ~«Прямо за воротами на коленях стояла измученная фигура. Её руки были в крови от отчаянного стука в ворота, а дыхание скорее напоминало судорожные всхлипы. Когда неровный свет изнутри упал на мостовую, она посмотрела на Убийцу Милосердия, стоявшего неподвижно в проёме, и с облегчением начала рыдать».~
@39361 = ~«Продолжай…»~
@39362 = ~«Погоди… у меня вопрос…»~
@39363 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39364 = ~«Убийца Милосердия уставился на женщину, взволнованный её появлением, и чувствовал, словно смотрит в зеркало, искажающее лишь его пол. Карус понял, что не находит слов, так что просто ждал от женщины объяснения».~
@39365 = ~«Продолжай…»~
@39366 = ~«Погоди… у меня вопрос…»~
@39367 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39368 = ~«И она объяснила. Объяснение было простым, но крайне важным и заставило Каруса, колени которого болели с каждым движением всё сильнее… нагнуться и помочь женщине встать на ноги. Он ввёл её внутрь, вежливо проводив в коридоры за воротами».~
@39369 = ~«Продолжай…»~
@39370 = ~«Погоди… у меня вопрос…»~
@39371 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39372 = ~«Она сказала, что была совершена несправедливость. И это было всё, что требовалось услышать Карусу».~
@39373 = ~«Продолжай…»~
@39374 = ~«Погоди… у меня вопрос…»~
@39375 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39376 = ~«В конце концов оказалось, что она не выполнила свой долг Фурии и позволила человеку, виновному в кровавом преступлении, умереть безнаказанным. Она умоляла Каруса и Убийц Милосердия о помощи… и они казнили её. Ибо она пренебрегла своими обязанностями».~
@39377 = ~«У меня есть ещё одна история».~
@39378 = ~«У меня к тебе вопрос, Ивес…»~
@39379 = ~«Мне пора идти. Счастливо, Ивес».~
@39380 = ~Ивес наклоняется вперёд, когда ты рассказываешь историю о человеке, который перестал видеть сны и заказал постройку машины, которая позволит ему снова увидеть сон… она ловит каждое слово. Когда ты заканчиваешь, она улыбается: «Я запомню эту историю. А теперь у меня есть одна для тебя — „Рассказ о пчеловоде“».~
@39381 = ~«Нет, просто проходил мимо. Прощай».~
@39382 = ~Старик поворачивается к тебе и улыбается: «И снова приветствую. Могу я что-нибудь для вас сделать?»~
@39383 = ~«Да, у меня кое-какие вопросы…»~
@39384 = ~«Нет, просто проходил мимо. Прощай».~
@39385 = ~«Разумеется, продолжайте, молодой человек».~
@39386 = ~«Что ты здесь делаешь?»~
@39387 = ~«Что можешь рассказать мне об этом месте?»~
@39388 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@39389 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@39390 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@39391 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@39392 = ~«Знаешь что-нибудь о Рейвел Клубок-Загадок?»~
@39393 = ~«Я поговорил всего с девятью проститутками… не знаешь, где десятая ученица?»~
@39394 = ~«Вообще-то неважно. Прощай».~
@39395 = ~Старик весело хихикает: «Что здесь делает большинство мужчин, юноша… болтаю с прекрасными дамами из Борделя».~
@39396 = ~«Какую ты мог бы мне порекомендовать?»~
@39397 = ~«Я хочу спросить о другом…»~
@39398 = ~«Это всё, что я хотел узнать. Прощай».~
@39399 = ~Он хмурится в раздумье, поглаживая бороду: «Я бы сказал… нет, забудьте. Видите ли, молодой человек, я не знаю, зачем вы здесь. Если бы знал, какого рода беседы вам приятны — возможно, тогда я бы смог вам что-либо посоветовать».~
@39400 = ~«Хорошо. У меня был другой вопрос…»~
@39401 = ~«Тогда лучше я с ними сам поговорю. Счастливо».~
@39402 = ~Старик улыбается, его глаза сверкают: «Могу сказать вам, что это *удивительнейшее* заведение! Дамы здесь необычайно очаровательны… даже, по-своему, прелестная на язык Кимази. Но пожалуйста, мой юный сэр, поговорите с Падшей Грейс… будучи хозяйкой Борделя, она сможет рассказать о сути этого места намного лучше меня».~
@39403 = ~«Я хочу спросить о другом…»~
@39404 = ~«Это всё, что я хотел узнать. Прощай».~
@39405 = ~«А, да… это прелестное создание зовут Экко. Такая милая девочка… с ней так легко разговаривать. Причём не только потому, что она молчит, просто есть в ней что-то *этакое*, — он счастливо вздыхает. — Однако я не знаю, *почему* она не говорит».~
@39406 = ~«Я хочу спросить о другом…»~
@39407 = ~«Это всё, что я хотел узнать. Прощай».~
@39408 = ~«Рейвел? — старик поднимает бровь. — Рейвел Клубок-Загадок, ночной ведьмы? Как волнующе! Нет, я ничего такого не слышал. Вот так слух, однако, правдивый или нет».~
@39409 = ~«Я хочу спросить о другом…»~
@39410 = ~«Это всё, что я хотел узнать. Прощай».~
@39411 = ~«Нет. И боюсь, окажись он у меня под самым носом, я бы не заметил… я почти лишён обоняния, — он постукивает по носу. — Печально, но это старость. Мне говорили, что у Вивьен всегда самые прекрасные ароматы…»~
@39412 = ~«Я хочу спросить о другом…»~
@39413 = ~«Это всё, что я хотел узнать. Прощай».~
@39414 = ~Он качает головой: «Я знаю, о какой вуали вы говорите… один или два раза я видел Мариссу за пределами Борделя в её вуали… но где вуаль сейчас — не знаю».~
@39415 = ~«Я хочу спросить о другом…»~
@39416 = ~«Это всё, что я хотел узнать. Прощай».~
@39417 = ~«Я мало знаю, помимо той легенды, которую слышал любой ребёнок: что она была ночной ведьмой, но не простой, а особенно злой, и что её давным-давно изгнали из Сигила».~
@39418 = ~«Я хочу спросить о другом…»~
@39419 = ~«Это всё, что я хотел узнать. Прощай».~
@39420 = ~Старик хмурится и чешет бороду: «Если тут *есть* десятая ученица, мой юный друг, я бы очень хотел с ней встретиться! Но, насколько мне известно, такой здесь нет».~
@39421 = ~«Я хочу спросить о другом…»~
@39422 = ~«Это всё, что я хотел узнать. Прощай».~
@39423 = ~Конечно, у тебя есть вопросы обо мне. Должно быть, у тебя сейчас куча вопросов обо ВСЁМ на свете. Давай я тебе всё растолкую: когда ты мёртв столько же, сколько я… без ног, без рук и всего остального, появляется много времени на размышления, ясно? Я как-то подсчитал, и вышло, что я записан в книгу мёртвых уже несколько сотен лет, и время уже не отсчитывает жизненный путь, как это было раньше… Без смертности твоё существование всё сильнее давит на тебя, дни и ночи сливаются в один сплошной поток. И ты размышляешь о том, о сём… и вот, самая мудрая вещь, которую я понял за последнюю сотню с небольшим лет — существует НАМНОГО больше непристойных жестов, которые можно выразить челюстью и глазами, чем думает большинство людей. Даже не оскорбляя и не насмехаясь можно добиться потрясающих эффектов путём правильной комбинации движений глаз и щелчков челюстью. Это выводит людей из себя! Если тебе когда-нибудь отрубят голову, и кожа слезет с твоего черепа, — я покажу тебе, как это делается. У меня есть такие перлы, шеф, которые способны довести даже дэва до убийства, точно говорю.

Я знаю, о чём ты думаешь: считаешь, что я мертвец, что я лишился всего. Нужно трезво оценивать все те радости, что я пропустил; всю ту любовь, что я потерял. Некоторые люди так боятся смерти — да они просто её НЕ ИСПЫТАЛИ — и никогда не поймут, как сильно меняются взгляды на вещи. Смерть даёт тебе возможность взглянуть на жизнь по-другому, расширяет горизонты. Что до меня, то я понял, сколько убойных девчонок в этом городе, и как мало настоящих мужчин с острым языком — вроде меня — ходит по этим улицам. Просто поверни руль в нужную сторону — и годы одиночества окончены!

Мелко мыслю? Вовсе нет. Я просто умею не попадать в сети всей этой философии, веры и убеждений, о которых болтает каждый болван от Арбореи до Серой Пустоши. Кому какое дело? Планы — это планы; а ты — это ты. И если что-то тут изменится — ну и замечательно, ибо всё что ни делается — всё к лучшему. Уж кому об этом знать, как не мне. Давай, спроси меня о планах, или о всяких байках, о людях и культурах… Когда окончишь жизнь как я, оставшись без бровей над глазами, — ты сам откроешь массу нового, и я могу рассказать тебе почти всё, что тебе надо знать.

Короче, дела обстоят так: мы вместе, шеф. До конца. И я прилип к тебе, как банный лист.~
@39424 = ~[Биография Анны]Ага, так чё ты хошь узнать про меня? Или те просто скучно? Слушай, моя жизнь — не самая захватывающая история. Так что если хочешь услышать что-то эпическое — поди погреми шкатулкой с кем-нибудь другим, лады?

Я видела, как ты смотрел на мой хвост. Пока у тебя глаза на лоб не полезли, я скажу тебе, откуда он взялся: это подарочек от дедули… или бабули. В общем, от того из них, кто был извергом. Я — тифлинг, вот так вот, и у меня достаточно демонической крови, чтоб вырос хвост. Эта кровь прошла долгий путь от дедули с бабулей, и отразилась на мне… после того, как прошла через моих мамулю с папулей, кем бы они ни были.

Фарод? Мой папаня? Ха! Этот старый пердун не мой папаша — по крайней мере, не мой настоящий. Он просто вырастил меня, ага, вытащил меня из Улья и прибрал к рукам.

И не думай, что он такой весь добрый дядя… его как-то не тянуло плакать от того, что я сирота, — просто ему нужен был кто-то, кто помог бы рыскать по улицам Улья в поисках жмуриков, а я довольно ловкая и могу пролезть там, где не могут остальные его подельники. К тому же почти все эти бродяги — трусливые сопляки. В результате получилось так, что я доставала жмуриков из тех мест, куда они боялись даже заглянуть. Пылюки платили достаточно денег за те тела, что я им приносила, а Фарод из этих денег забирал себе не слишком много, так что мне не приходилось подрабатывать с протянутой рукой. Получается, что он не так уж и плох, вроде как.

Ладно, хватит вопросов. Теперь Я хочу кое-что сказать о ТЕБЕ.

Я видела тя в действии, и ты должен запомнить кое-что, если мы собираемся путешествовать вместе… первое — не трепись и не заглядывайся на кого попало. Это самая прямая дорога к неприятностям. И никому понапрасну не хами — это привлекает внимание, самую худшую его разновидность.

И последнее. Не думай, что со мной можно обходиться, как с уличной девкой. Попробуешь — и познакомишься с моими клинками, будь уверен.

Мои клинки? Ага, эти ножички мои. Мне нравятся эти кастеты. Можешь сколько угодно носиться со своими топорами, молотами и булавами — но только эти маленькие клинки в моём стиле. Просто веди себя хорошо, и не обнаружишь их у себя в потрохах, ага?~
@39425 = ~Моё прошлое тебе неизвестно. Открыть тебе знания о нём — не в моей воле.

Знай, что я ношу шрамы того, кто путешествовал по планам. Знай, что я не задерживался надолго ни в одном месте. Знай, я несу бремя того, кто прошёл долгий путь, чтобы оказаться здесь.

Знай, что я гитцерай. Знай, что я из народа Зертимона.

Это Зертимон познал гитцерай до того, как мы познали самих себя. Он знал, что нужно сделать, чтобы освободить нас. От этого знания зародилось действие. Его знание породило свободу. Гитцерай перестали быть рабами и стали народом.

Знай, что я следую Неразорванному Кругу Зертимона. Я познал его слова. Я познал его сердце.

Всё это означает, что я знаю себя.~
@39426 = ~[Биография Грейс]Моё прошлое не столь продолжительно, во всяком случае, по меркам танар'ри. Не знаю, знаком ли ты с танар'ри, но мы — раса Бездны, ступенчатого ряда планов, наполненных хаосом и злыми сердцами.

Я — танар'ри, изверг, суккуб… я выросла на первом плане Бездны. Моя мать тоже была суккубом. Полагаю, тебе известно, что суккубы соблазняют смертных и затаскивают их души в Бездну. Моя мать была одной из лучших — за свою жизнь она обрекла бессчётное число смертных мужчин на вечную пытку. Она и сейчас живёт в Бездне, продавая своих детей в рабство.

Мать продала меня баатезу, заклятым врагам танар'ри. Думаю, она надеялась, что они меня убьют. Несмотря на её обширные познания, она немногое знает о культуре баатезу и о той радости, которую они испытывают, пытая других.

К счастью, баатезу — гордые создания. Сама мысль о том, что танар'ри может в чём-то превзойти их, им невыносима. Поэтому я вызвала на соревнование по импровизации одного из самых гордых исчадий ямы, и моё сердце танар'ри позволило одержать верх. Танар'ри — хаотичные создания, дикие и непредсказуемые. Баатезу — куда более коварные и организованные изверги. Они понимают, что такое импровизация, но не особо сильны в применении её на практике. Так я выиграла свою свободу.

Много времени прошло с тех пор. Я покинула Нижние планы и поселилась в Сигиле. Я вступила в Общество Восприятия, а мой опыт общения с баатезу разбудил во мне желание узнать больше о мультивселенной.

Почему? Я верю в существование истины в мультивселенной… даже если истиной является то, что истины не существует. Я верю, что на всех планах нужно обязательно побывать лично, и чем больше ты узнаешь о путешествиях, о радости, о боли, о веселье или страдании — тем полнее мультивселенная раскроется перед тобой…

И тем лучше ты раскроешься для самого себя.~
@39427 = ~[Биография Игнуса]Довольно разговоров и с-скитаний… Игнус-с ж-желает ГОРЕ-Е-ЕТЬ…

Игнус-с-с горит… уж-же… так дол-лго…

Когда-то…

Когда-то… Игнус-с-с не з-знал НИЧЕГО о пламени… он заж-жигал маленькие огни, крохотные огоньки, с-с-совс-сем крохотные… маленькие кус-сочки пламени…

Огонь рос-с-с… Игнус-с-с заж-жигал огонь на улицах-х… и огонь ярос-с-сти в с-с-сердцах людиш-ш-шек…

Люди х-хотели наказ-зать Игнуса, маленькие букаш-шки из Улья. Они мечтали увидеть, как Игнус-с-с ГОРИ-И-ИТ, пос-сле того, как он з-заж-жёг огонь на их улицах-х…

…крохотные колдунчики, захудалые волш-шебнички, з-заклинатели рун… крошечные искорки магии приш-шли НАКАЗ-З-ЗАТЬ Игнус-с-са за то, что он делал больно их-х близ-з-зким… они приговорили С-С-СЖЕЧЬ Игнус-с-са, с-сделать Игнус-с-са ФАКЕЛОМ, плюющ-щимс-с-ся огнём, пылающ-щим, пылающ-щим…

Это ПРАВОС-С-СУДИЕ, с-сказали они…

…но это не было приговором…

…с-с-столько огня и боли, что боли НЕТ… только С-С-СВЕТ, и ТЕПЛО, и ЖАР, и плоть, с-с-с-сгорающ-щ-щая как ЖИР на моих кос-с-с-стях…

…и в первый разс-с-с…

…Игнус-с-с был С-С-СЧАСТЛИВ…

Когда планы с-с-сгорят и вс-с-ся ж-жизнь с-с-станет факелами, тогда Игнус-с-с наконец упокоитс-с-ся… с-с-с миром…~
@39428 = ~[Биография Нордома]Модрон наоборот = Нордом. Вопросы? Хронология: поход модронов. Место назначения: Лимбо. (Первоначальное место назначения: Механус —> причина смены места назначения неизвестна. Причина: утеряна?) Новые параметры установлены вышестоящим: придана форма материи плана (Лимбо) для проверки гипотезы. Подземелье Рубикон создано.

Вышестоящий потерян в полевом испытании. Вышестоящий = Нордом? Воздействие плана вызвало отклонения от нормы. Ощущения стали меньше и громче. Крылья заменены руками: причины неизвестны. Вывод/гипотеза: не нравились крылья? Предположение.

Нордом когда-то был «ЕДИНЫМ», но теперь я «единый» меньше и громче. Затруднения в обработке информации.

Два духа-механизма Рубикона помогают Нордому. Трансформировались в оружие для защиты от ошибок Рубикона. Их запрос: покинуть это место и застрелить враждебных разумных существ (цель: приключение?).

Причина отклонения Нордома неизвестна. Основная функция завершена, когда разрушение Рубикона достигло трёх кубитов внутрь и продолжало увеличиваться. Обработка функций… по прибытии новых разумных существ функции переопределены. Нордом теперь является механизмом новой иерархии.

Назначенный лидер: адресат. Внимание: Нордом следует.~
@39429 = ~[Биография Вейлора]Я Вейлор. Я Убийца Милосердия. Я — правосудие.

Это моё прошлое. Это моё настоящее. Это моё будущее.

Все виновные должны быть наказаны. Я не успокоюсь, все приговоры не будут приведены в исполнение.

Милосердие — удел слабых. Наказание ломает души и делает их достойными служить высшим. Когда число казнённых становится достаточным, неповиновение прекращается.

Я и моё сердце знаем: в мультивселенной есть только одна истина. Мультивселенная должна быть заточена и стать лезвием правосудия. Точильный камень правосудия приведёт мультивселенную к совершенству.~
@39430 = ~Игра не была сохранена. Выход уничтожит весь несохранённый прогресс. Сохранить игру сейчас?~
@39431 = ~Сейчас игра не может быть сохранена. Выход уничтожит весь несохранённый прогресс. Действительно выйти из игры?~
@39432 = ~Загрузка игры уничтожит весь несохранённый прогресс. Действительно загрузить игру?~
@39433 = ~Получено~
@39434 = ~Выполнено~
@39435 = ~Нельзя установить больше 256 меток на одной карте.~
@39436 = ~Пауза в игре~
@39437 = ~Оружие Дак'кона изменилось.~
@39438 = ~пунктов здоровья добавлено за счёт специализации.~
@39439 = ~к знанию легенд получено за счёт специализации.~
@39440 = ~к интеллекту получено за счёт специализации.~
@39441 = ~«Я думаю, мне нужно идти. Прощай».~
@39442 = ~Корвус тщательно изучает бумаги, складывает их и прячет. Затем с улыбкой кивает тебе: «Отличная работа, гражданин. Я прослежу за тем, чтобы эти документы были заслушаны в суде и все узнали о позоре Байрона». Он хмурится: «Однако Байрон Пикит мёртв и уже предстал перед высшим судом».~
@39443 = ~«Ясно. У меня кое-какие вопросы…»~
@39444 = ~«Мне пора идти. Прощай».~
@39445 = ~«Хорошо. Прощай».~
@39446 = ~Он запинается, затем злобно улыбается: «Правда? Как здорово… такое никогда бы не случилось с хорошим человеком».~
@39447 = ~«Прощай, Ленни».~
@39448 = ~Это твой ручной лим-лим. Заметив твоё внимание, он преданно чирикает: «Пийо!»~
@39449 = ~Осмотреть лим-лима.~
@39450 = ~Это твой ручной лим-лим. Заметив твоё внимание, он преданно чирикает: «Пийо!»~
@39451 = ~«Прекрасно. Прощай».~
@39452 = ~Я только что заключил сделку с Йи'минном, гитиянки-рыболовом, чтобы вернуть мне воспоминания из Астрального плана. Он сказал, что я должен снова с ним встретиться в Нижнем районе через неделю.~
@39453 = ~Дак'кон объяснил мне различия между гитиянки и гитцерай. Когда-то они были одной расой, порабощённой злыми пожирателями разума или иллитидами, как он их называет. Но когда они освободились от жестокого ига своих захватчиков, два лагеря решили последовать за разными лидерами. С тех пор они непрестанно враждуют.~
@39454 = ~Я согласился прикинуться ревнивым ухажёром Джульетты, одной из проституток в Борделе Безумной Интеллектуальной Страсти. Мне нужно найти в Фестхолле её любовника Монтекки и потребовать, чтобы он уступил её мне.~
@39455 = ~Я согласился прикинуться ревнивым ухажёром Джульетты, одной из проституток в Борделе Безумной Интеллектуальной Страсти. Мне нужно найти в Фестхолле её любовника Монтекки и потребовать, чтобы он уступил её мне.~
@39456 = ~Джульетта попросила доставить мужчине по имени Монтекки «фальшивые» любовные письма якобы от любовника. Она хочет убедить Монтекки, что у неё роман с другим. Совершенно очевидно, что Джульетта не удовлетворена уровнем их с Монтекки отношений. Как только я заполучу письма, мне нужно будет принести их в Фестхолл как «доказательство» её измены. Джульетта предложила мне поговорить со Своевольным Пенном, которого можно найти в типографии в Нижнем районе.~
@39457 = ~По словам Джульетты, Кимази Язык-Гадюки, одна из проституток в Борделе Безумной Интеллектуально Страсти, — наполовину сестра Кезай-Серрис, которая, как мне сказали, является дочерью Рейвел Клубок-Загадок.~
@39458 = ~Я рассказал Джульетте о том, что произошло с Монтекки, и она разразилась слезами.~
@39459 = ~В Мортуарии я встретил старого писаря по имени Дхалл… он знал, что я не помню своего прошлого, прежде чем я успел вымолвить слово. Интересно, знал ли я Дхалла до того, как потерял память? Я надеялся получить несколько ответов, но это место как будто вызывает всё новые и новые вопросы.~
@39460 = ~Я спросил Дхалла, знает ли он меня. Он ответил, что знает обо мне совсем немного, даже меньше чем о тех, с кем я путешествовал в прошлом. Вероятно, их тела лежат в Мортуарии… возможно, встреча с ними поможет мне восстановить воспоминания.~
@39461 = ~Дхалл сказал, что одна женщина, путешествовавшая со мной, погребена в мемориальном зале на первом этаже Мортуария.~
@39462 = ~Дхалл сказал, что обещает держать мои посещения Мортуария в тайне от остальных Пыльных. Являясь писарем в приёмной, он единственный, кто видит моё тело при поступлении сюда.~
@39463 = ~По-видимому, Фарод доставил сюда моё тело в повозке вместе с кучей других трупов. Был ли я действительно *мёртв*, когда он это сделал?~
@39464 = ~Дхалл сказал, что Фарода можно найти вне Мортуария, в месте, называемом «Улей». Похоже, Дхалл не хотел, чтобы я отправлялся на поиски Фарода, но в конце концов, это не он потерял память и пробудился после собственной смерти, так что пусть держит своё мнение при себе. Дхалл предложил мне расспросить людей в Улье о том, где можно найти Фарода.~
@39465 = ~Я согласился найти человека по имени Весельчак — первую любовь Долоры — и поговорить с ним от её имени. Она сказала мне, что он является членом Общества Восприятия, поэтому его можно найти в Общественном Фестхолле.~
@39466 = ~За хорошее вознаграждение я согласился найти человека по имени Весельчак — первую любовь Долоры — и поговорить с ним от её имени. Она сказала мне, что он является членом Общества Восприятия, поэтому его можно найти в Общественном Фестхолле.~
@39467 = ~Я сказал Джульетте о том, что произошло с Монтекки. Нельзя сказать, что новости её обрадовали.~
@39468 = ~Я рассказал писарю Дхаллу о Ваксисе и его маскировке. Дхалл решил отправить Пыльных поймать Ваксиса.~
@39469 = ~Я обещал Ваксису, что не выдам его Пыльным, и что с того? Я рассказал писарю Дхаллу о нём и его маскировке. Дхалл решил послать Пыльных, чтобы поймать Ваксиса.~
@39470 = ~Дхалл предположил, что раны на моём теле несущественны по сравнению с ранами в моей душе… он даже выдвинул версию, что именно эти раны послужили причиной потери памяти, и что ментальный вред может быть гораздо серьёзнее амнезии. От этих мыслей становится как-то невесело. Я был бы не прочь время от времени слышать и *хорошие* новости.~
@39471 = ~Я вернулся к Долоре после того, как нашёл Весельчака, и вернул ей ключи от её сердца.~
@39472 = ~Женщина по имени Гвоздичка сказала, что заполненная мусором арка на Площади Мусорщиков на самом деле является порталом, который она обнаружила случайно. «Ключом» к нему служит кучка мусора, которую проходящий — я в данном случае — должен иметь при себе. Гвоздичка сказала, что портал выходит на небольшую площадку с воротами, ведущими под землю. Но дальше Гвоздичка в одиночку идти не решилась.~
@39473 = ~Я научился воровству у человека по имени Эли Хэвлок в Фестхолле. Хотя Эли предпочитает называть нас «разведчиками».~
@39474 = ~Я выучился на мага у женщины по имени леди Торнкомб, наставницы магов в Фестхолле.~
@39475 = ~Кимази Язык-Гадюки, единокровная сестра Кезай-Серрис, сказала, чтобы я попросил Кезай поговорить со своим отцом. Это должно доказать Кезай, что она — дочь Рейвел Клубок-Загадок.~
@39476 = ~Я подслушал, что гитиянки планируют нападение на крепость гитцерай, Вристигор.~
@39477 = ~Морте упоминал кое-что о «Правиле Трёх». Видимо, некоторые верят в то, что всё имеет тенденцию происходить трижды. Они придают этому числу огромное значение.~
@39478 = ~Я разговаривал с лингвистом Финамом по поводу странной надписи на развернутом додекаэдре. Он говорит, что его отец знал язык мертвых, на котором была сделана надпись, но его задушил неизвестный много лет тому назад. Прах его отца теперь покоится в урне в доме Финама. Может быть существует способ связаться с духом отца Финама через его пепел, так как практически невозможно найти человека, который бы понимал этот давно никем не употребляемый язык.~
@39479 = ~Я разговаривал с духом лингвиста Фина Андли и понял, что знал язык, на котором были сделаны надписи на додекаэдре. Теперь я наконец смогу прочитать, что там написано.~
@39480 = ~Разговаривая с лингвистом Фином Андли, я вспомнил, что именно я убил этого человека. Могу только предположить, что целью убийства было не дать ему научить кого-либо другого языку уйо, чтобы сохранить в секрете написанное на головоломке-додекаэдре.~
@39481 = ~Я согласился доставить странную коробочку некоему Ку'атраа. Мар сказал, что этого приятеля обычно можно найти в юго-восточной части Улья.~
@39482 = ~Вероятно, покинув Улей, я выпустил на свободу существо, заключённое в шкатулке. Я не знаю зачем, но опасаюсь, что кем бы ни было это создание, оно отправится искать последнего владельца шкатулки. Думаю, мне стоит быть осторожнее.~
@39483 = ~Головы на вратах сказали, что Керст проиграл злу и был затянут через врата в Карцери. Ещё они сказали, что моя судьба ждёт по ту сторону врат.~
@39484 = ~Хотя это идёт вразрез с моими убеждениями, я решил простить Мару его поступок. Несмотря на то, что я стараюсь вернуть свою потерянную память, — это приключение я хотел бы забыть.~
@39485 = ~Я узнал, что вражда между гитцерай и гитиянки обусловлена их общим происхождением: и те, и другие ненавидят то, во что превратился их противник. Как странно, что часто две вещи, произошедшие из одного источника, становятся диаметрально противоположными.~
@39486 = ~Я узнал, что вражда между гитцерай и гитиянки обусловлена их общим происхождением: и те, и другие ненавидят то, во что превратился их противник. Как странно, что часто две вещи, произошедшие из одного источника, становятся диаметрально противоположными.~
@39487 = ~Я получил сообщение, что женщина по имени Джолми из Дома Сирма хочет сделать мне какое-то предложение. Стоит найти её в Общественном Фестхолле. На ней будет платье из зелёного шёлка с золотой каймой; её волосы цвета голубой стали.~
@39488 = ~У меня был странный разговор с Ку'атраа, которому Мар доверил мне доставить эту необычную коробочку. Ку'атраа явно был напуган её содержимым. Когда я показал ему шкатулку, он настолько испугался, что принялся лепетать, а потом вылетел как ошпаренный. Судя по тому, что я смог разобрать из его бессвязного бормотания, он хотел, чтобы я отнёс шкатулку кому-то по имени Браскен, живущему в юго-западной части Улья. Остаётся только надеяться, что этот Браскен объяснит, в чём дело, и заберёт у меня эту шкатулку. Мне не по себе каждый раз, когда я на неё смотрю.~
@39489 = ~Я рассказал встретившейся мне гитцерай об атаке на крепость Вристигор, которую планируют осуществить гитиянки. Гитцерай спешно ушла.~
@39490 = ~Я сказал Немель, что её подруга Эльвин ищет её. Немель отблагодарила меня магическим поцелуем, который повысил мою выносливость.~
@39491 = ~Я предложил загадочной женщине по имени Немель найти её подругу Эльвин. Из описания я понял, что Эльвин — высокая красивая женщина с глазами золотого цвета и малиновыми волосами.~
@39492 = ~Загадочная женщина по имени Немель открыла мне командное слово для найденного мной магического графина: «Нилденосай».~
@39493 = ~Я предложил загадочной женщине по имени Немель найти её подругу Эльвин. Оказалось, я уже знал, где можно найти эту девушку. Немель наградила меня магическим поцелуем, который повысил мою выносливость.~
@39494 = ~Я сказал Немель, что отыскал её подругу Эльвин. Немель наградила меня магическим поцелуем, который повысил мою выносливость.~
@39495 = ~Я обвинил Тильдона и Сароса в убийстве кузнеца Авилдона. Их обоих арестовали.~
@39496 = ~Я доложил Лиене об успешном устранении офицера Гармониума.~
@39497 = ~Лиена со склада в Нижнем районе попросила меня доказать свою преданность Анархистам, убив офицера Гармониума по имени Вортен.~
@39498 = ~Я обвинил Сароса в убийстве кузнеца Авилдона. Его арестовали.~
@39499 = ~Моё последнее испытание на пути вступления в Боготы — отговорить члена фракции от самоубийства. Его зовут Сандоз, он отец Сароса и Сароссы.~
@39500 = ~Я обвинил Тильдона в убийстве кузнеца Авилдона. Его арестовали.~
@39501 = ~Я выполнил первое задание Боготов и приступил ко второму испытанию: расследованию убийства. Мне нужно поговорить со смотрительницей в главном цехе и доложить Келдору, когда я соберу доказательства.~
@39502 = ~Я на пути к своей цели: стать Боготом. Мне нужно найти в Великой Кузнице кузнеца, который объяснит, как работать молотом, чтобы я мог выковать какой-нибудь предмет. Таким образом я докажу, что вижу потенциал даже в мёртвом куске руды. Это должно быть несложно. Когда всё будет сделано, нужно будет вернуться к Келдору.~
@39503 = ~К счастью, я уже позаботился о Покрытом-Пеплом, так что сразу получил вознаграждение.~
@39504 = ~Я рассказал Мару, что прикончил изверга, которого случайно выпустил, покинув Улей. Хотя Мар был впечатлён моей способностью убивать извергов, он отказался заплатить мне за услуги. Вряд ли я могу с ним поспорить, ведь я не послушал его предостережений и не доставил коробку как было наказано.~
@39505 = ~Я рассказал Мару, что открыл шкатулку после того, как окончательно сломал голову, кому её отдать. Теперь он отказывается мне платить. Не думаю, что поступаю безнравственно, требуя вознаграждение, ведь должен же я получить хотя бы небольшую компенсацию за свои труды. В конце концов, я сделал всё, чтобы доставить эту коробку… вот только никто не хотел брать её у меня. Хотя я всё-таки пренебрёг предупреждением Мара и открыл коробку. Так или иначе, я покинул Мара со смешанными чувствами, без награды и благодарности. Я просто рад, что вся эта тягомотина со шкатулкой и сидящим в ней извергом закончилась.~
@39506 = ~Я признался Фину Андли, что это я убил его, и объяснил почему. Он простил меня, чему я несказанно рад… как бы то ни было, я почувствовал, как груз — маленький, но всё равно груз, — свалился с моих плеч.~
@39507 = ~Я рассказал Мару, что открыл шкатулку и убил изверга. Поначалу я был зол на Мара за то, что он не рассказал мне о содержимом коробки, но это в конце концов моя вина, что я не слушал его предостережений. В будущем мне стоит научиться держать своё любопытство в узде.~
@39508 = ~Как только я доставил сообщение Келдору, аукционер Гильтспур попросил меня за вознаграждение в 200 монет доставить рекламное объявление Баркису в бар «Горящий труп».~
@39509 = ~После того, как я отнёс объявление в типографию Своевольного Пенна, аукционер Гильтспур попросил меня доставить сообщение Келдору из Дуриана в Великую Кузницу за вознаграждение в 100 монет.~
@39510 = ~Аукционер Гильтспур предложил мне 50 монет за доставку рекламного объявления печатнику Своевольному Пенну.~
@39511 = ~Я сделал две ошибки. Первой ошибкой было игнорировать предостережения Мара насчёт открытия шкатулки. Второй ошибкой был побег от вылезшего из шкатулки изверга. Я не смогу исправить первой ошибки, но ещё могу попытаться исправить вторую. Мне нужно убить изверга.~
@39512 = ~Сарос дал мне шило с вырезанным на нём именем «Тильдон». Он сказал, что нашёл его рядом с телом в ночь убийства.~
@39513 = ~Сарос признался, что нарочно подкинул шило на место преступления. По его утверждению, он сделал это лишь для того, чтобы люди узнали о причастности Тильдона.~
@39514 = ~Сарос отрицает, что пытался подставить Тильдона. Он говорит, что Тильдона нужно арестовать за убийство. Как будто я сам не знаю, КОГО на самом деле нужно арестовать.~
@39515 = ~Я рассказал Саросу, что значит быть Анархистом.~
@39516 = ~Мой первоначальный дневник пропал, поэтому я начал новый. Я очнулся в месте под названием «Мортуарий». Я не знаю ни кто я, ни что здесь делаю, ни даже как попал сюда. Единственный, кого я увидел перед собой, был говорящий череп по имени Морте… когда он осматривал мои раны, он нашёл «указания», вытатуированные у меня на спине:

«Я знаю, ты чувствуешь себя так, будто нахлебался мутных вод Стикса, но тебе нужно СОБРАТЬСЯ. Среди твоих вещей должен быть ДНЕВНИК, который прольёт немного света на это тёмное дело. ФАРОД расскажет тебе оставшуюся часть истории, если, конечно, он ещё не попал в книгу мёртвых».

«Не потеряй свой дневник, иначе мы снова погрузимся в воды Стикса. И что бы ты ни делал, НИКОГДА никому НЕ говори, КТО ты или ЧТО с тобой случилось, а то они устроят тебе скорое паломничество в крематорий. Делай, как я говорю: ПРОЧТИ дневник, а потом НАЙДИ Фарода».

Интересно, я сам написал себе это послание? Судя по всему, мне действительно нужно найти этого «Фарода» и мой дневник.~
@39517 = ~На моём носовом платке осталось несколько капель крови Кезай-Серрис. Я знаю, что она — дочь Рейвел. Видимо, этого должно быть достаточно для ключа к лабиринту Рейвел. Можно сказать, что эта кровь — «частичка Рейвел».~
@39518 = ~Кезай-Серрис наконец поверила, что она на самом деле дочь Рейвел. Согласившись на доводы Кимази, Кезай-Серрис каким-то образом поговорила со своим отцом-извергом и узнала правду.~
@39519 = ~Я спросил Кезай-Серрис, не дочь ли она Рейвел. Вопрос её очень расстроил… она отказывается в это верить. Если то, что мне про неё рассказали, на самом деле правда — мне просто придётся найти способ ей это доказать.~
@39520 = ~Я вернул Мариссе малиновую вуаль, но только после того, как потребовал за это награду.~
@39521 = ~Я вернул Мариссе её малиновую вуаль, хотя от неё и слова доброго не дождёшься.~
@39522 = ~Марисса, одна из проституток в Борделе Безумной Интеллектуальной Страсти, потеряла свою малиновую вуаль. Она не просила меня найти её, но, возможно, всё же стоит поспрашивать местных, вдруг где-нибудь всплывёт.~
@39523 = ~Я спросил Мариссу, правда ли, что её видели выходящей из покоев Вивьен. Марисса отказалась говорить со мной на эту тему.~
@39524 = ~Ненни сказала, что видела, как Кимази Язык-Гадюки тайком выходила из покоев Мариссы… возможно, это она украла малиновую вуаль или хотя бы знает, где та может быть.~
@39525 = ~Ненни сказала, что видела, как Марисса тайком выходила из покоев Вивьен… возможно, это она украла её «личный аромат» или хотя бы знает, где его можно найти.~
@39526 = ~Ненни сказала, что видела мужчину, тайком выходящего из комнаты Кимази Язык-Гадюки, но не видела, чтобы он покидал Бордель. Если этот мужчина — вор, то он, вероятно, ещё находится здесь.~
@39527 = ~Завершенные Задания~
@39528 = ~Описание~
@39529 = ~«Однажды человек пришёл на пасеку. Он слышал над полем жужжание тысяч пчёл, но ни одной не видел. Между ульями прохаживался пчеловод, который доставал соты из явно пустых ульев. Даже несмотря на отсутствие насекомых, жужжание не прекращалось; человек был озадачен».~
@39530 = ~«Он решил поговорить с пчеловодом, и тогда тот снял капюшон, скрывавший под собой существо, полностью состоящее из пчёл. В массе насекомых, которая представляла собой лицо существа, образовалась дырка в форме рта, отверстие двигалось, когда существо говорило, но жужжание было настолько сильным, что слов было разобрать невозможно. В этот миг человек умер, пытаясь понять, что же всё-таки сказал ему пчеловод».~
@39531 = ~Ивес наклоняется вперёд, слушая твой рассказ о проклятии Вонючки… она с жадностью внимает каждому твоему слову. Когда ты заканчиваешь рассказ, она улыбается: «Я запомню твой рассказ. Теперь у меня есть рассказ для тебя — „Позолоченная история“».~
@39532 = ~«На плане Изгард есть Позолоченный Зал, где Чующие, ищущие удовольствия для своей глотки и чресел, могут обрести их. Они ревностно предаются этим удовольствиям, даже не подозревая, что двери зала никогда не откроются и что пути назад в Фестхолл нет. Это ненужные Чующие, те, у кого нет подлинной веры во фракцию. Вместо этого они ищут удовольствий ради удовольствий. Являются ли заключёнными те, кто даже не осознают, что они заключённые?»~
@39533 = ~Ивес наклоняется вперёд, слушая твой рассказ об аллее Опасных Углов и как она появилась… она с жадностью внимает каждому твоему слову. Когда ты заканчиваешь рассказ, она улыбается: «Я запомню твой рассказ. Теперь у меня есть рассказ для тебя — „Ухажёр Госпожи“».~
@39534 = ~«В рассказе речь об ухажёре Госпожи Боли, одном из многих за долгие годы. Этот юноша был просто одержим хозяйкой Сигила. Он видел её везде, в любом уголке города. Услышав шуршание её платья, скрежет её клинков, он начинал сходить с ума без всякой меры. Он надеялся, что если будет боготворить её, то сможет хотя бы видеть её… и он боготворил её».~
@39535 = ~«Его нашли мёртвым в луже крови на ступеньках собственного дома, ужасные раны покрывали всё его тело… но глаза его были широко раскрыты, а на губах сияла триумфальная улыбка».~
@39536 = ~Ивес наклоняется вперёд, слушая твой рассказ о падении Фарода… она с жадностью внимает каждому твоему слову. Когда ты заканчиваешь рассказ, она улыбается: «Я запомню твой рассказ. Теперь у меня есть рассказ для тебя…»~
@39537 = ~«Однажды жил человек, который видел самую прекрасную вещь в мультивселенной. И было у него желание: поместить свои впечатления в один из камней чувств в Фестхолле, в магические устройства, которые вечно хранят чувства и воспоминания для того, чтобы остальные тоже смогли их прочувствовать».~
@39538 = ~«Но он подумал: а не ослабит ли это его собственное впечатление? Так он и оставил это чувство при себе и постарел со своим бесценным воспоминанием. Но пока он старел, воспоминание становилось потускневшим и избитым, и он больше уже не мог вспомнить всей прелести этого впечатления».~
@39539 = ~Ивес наклоняется вперёд, слушая твой рассказ об Игнусе и Искусстве, которое горело в нём… она с жадностью внимает каждому твоему слову. Когда ты заканчиваешь рассказ, она улыбается: «Я запомню твой рассказ. Теперь у меня есть рассказ для тебя — „Казнь“».~
@39540 = ~«Некогда по улицам Сигила скитался убийца, бессердечный мужчина по имени Коссакс. Его благословила мать в Бездне, и благословение не позволяло никому ударить его с целью нанести вред. Тот, кто осмеливался это сделать, умирал. Он пользовался своим благословением, провоцируя драки и убивая каждого, кто попадался на его пути».~
@39541 = ~Во время совершения одного из убийств стражник Гармониума с помощью сетей захватил его и заставил предстать перед Старейшинами. Судебное разбирательство было кратким и окончательным, но Коссакс смеялся во время процесса, зная, что ни один из них не сможет нанести ему вреда, не умерев сам. В последний день суда его признали виновным и приговорили к смерти.~
@39542 = ~«„Плевать я хотел на вас, трусов!“ — рассмеялся Коссакс, нащупал в темноте чашу и разбил её об стену. Яд стекал по стене и сох, пока от него ничего не осталось. „Ну давайте же, попробуйте меня убить“».~
@39543 = ~Ивес улыбается: «Интересный рассказ, Морте. У меня тоже есть рассказ для тебя и твоего спутника… „Игра изверга“».~
@39544 = ~«Один изверг скитался по диким местам некоего первичного мира в обличье дружелюбного старика. Однажды он натолкнулся в лесу на охотников.

„Что вы здесь делаете?“, — спросил изверг. Охотники ему ответили, и он кивнул: „Я никогда раньше не был на охоте“».~
@39545 = ~«Охотники пригласили старика пойти с ними, и вот группа вышла на поляну, где паслись несколько оленей. Охотники приготовили арбалеты, но стрелять не стали. Изверг спросил их, почему они не стреляют».~
@39546 = ~«„Они безоружны, — ответили охотники, поглаживая свои арбалеты. — Мы не охотимся на тех, кто не может себя защитить. В конце концов, это даже не спортивно“.

Изверг на это кивнул и быстро призвал трёх своих приятелей. Охотники помчались во главе той весёлой погони, но в конечном счёте их поймали и съели».~
@39547 = ~Ивес улыбается: «Прекрасный рассказ, Нордом. У меня тоже есть рассказ для тебя и твоего спутника… „Цветы и Чующие“».~
@39548 = ~«Жил на свете человек, который много читал о цветах: очерки, научные труды, тексты по ботанике, поэзию — и поэтому считал себя очень образованным в этой области. Однажды ему встретился полуслепой садовник, который ухаживал за садами Чующих. И кто же из них был слепым с точки зрения самих цветов?»~
@39549 = ~Ивес улыбается: «Очаровательно, Дак'кон. Позволь мне поделиться другой версией этой же истории, которую я недавно услышала…»~
@39550 = ~Ивес рассказывает другую версию истории Дак'кона, в которой Ач'али была изгнана из города гитцерай Шра'кт'лора из-за её постоянной бесполезной болтовни…

«Однажды она встретила слаади на его пути к камню нереста. Она быстро возвела вокруг себя прочные стены из материи, которые было нелегко сломать даже слаади. Изголодавшись, он поджидал, разговаривая с ней через стену. Она задавала ему вопросы и всё больше увлекалась своей бессмысленной викториной и ответами слаади, её собственная стена распалась и обрушилась на неё… так она и утонула в материи Лимбо».~
@39551 = ~Ивес улыбается Анне: «Но я бы очень хотела услышать твою историю…»~
@39552 = ~Ивес улыбается: «Удивительная история, Анна, ты не должна стесняться рассказывать её. У меня тоже есть одна для тебя и твоего спутника — „Опалённая земля“».~
@39553 = ~«Однажды маленькую деревеньку поразила ужасная засуха. Фермер отправился к Камню Поклонения и в очередной раз молился там, чтобы узнать причины. Он спросил Камень, почему тот бездействовал в то время, как поля умирали от засухи. Почему люди и животные умирали, а Камень не сделал ничего. „Неужели недостаточно мы пережили страданий?“ — спросил фермер, умоляя его на коленях. Но Камень не отвечал, он просто стоял и отбрасывал тень».~
@39554 = ~Ивес кивает: «Которую?»~
@39555 = ~Ивес мило улыбается: «Вновь приветствую. Ты пришёл обменяться историями?»~
@39556 = ~Ивес кивает: «Да, но мы больше не разговариваем друг с другом, да мне и больше нечего ей сказать».~
@39557 = ~Ивес с улыбкой кивает: «Да, спасибо тебе».~
@39558 = ~«Экко? — Ивес хмурится, задумавшись. — Однажды я слышала историю о девочке, знавшей слово, произнеся которое, можно разрушить мультивселенную. Возможно, это и есть Экко. Впрочем, спроси Долору… я так понимаю, она иногда встречается с человеком, который знал Экко, когда она ещё говорила».~
@39559 = ~Ивес мило улыбается: «Вновь приветствую. Я наткнулась на историю, которую бы ты наверняка захотел услышать. Хочешь, чтобы я тебе рассказала?»~
@39560 = ~«Жил-был человек, очень влиятельный человек, который, несмотря на своё богатство и положение, был очень несчастен. Его дочь умерла, и то немногое, что осталось от его жизни, было покрыто тенью её смерти».~
@39561 = ~«Случилось так, что к нему явился бывший возлюбленный его дочери и говорил о ней с глубоким смыслом и чувством, возвращая свет в его сердце. И в том разговоре оба они открыли для себя совершенно разные вещи, для каждого они были дороги по-своему».~
@39562 = ~«Искра жизни вернулась к одному из них, тоска покинула его глаза и уголки его сердца».

«А возлюбленный обнаружил в себе кое-что другое, что оказалось более ценным в его путешествии: сожаление».~
@39563 = ~«Ведь говорят, что сожаление может изменить природу человека, хотя только Серые Сёстры могут знать это наверняка».

Ивес с улыбкой кивает тебе: «Я не понимаю смысла этой истории, но, быть может, она пригодится тебе в будущем».~
@39564 = ~«Какое совпадение! Я тоже кое до чего большой охотник».~
@39565 = ~«Я? Почему как языком трещать, так сразу *я*?»~
@39566 = ~«Да нет, я расскажу… просто хотел пожаловаться на недостаток слушателей. Кроме того, я люблю привлекать внимание».~
@39567 = ~«Пожалуйста! Ну же? Пожа-алуйста? Это прекрасная история! Множество персонажей, действий, предзнаменований и непредсказуемая *развязка!*»~
@39568 = ~«Прекрасна! Клянусь! Ну *давай*!»~
@39569 = ~«Без понятия! Но зато как впечатляюще *звучит*!»~
@39570 = ~«Хорошо, хорошо…»~
@39571 = ~«Пожилой мужчина в одиночестве сидел на краю тёмной дороги, хорошо? Он не знал, в каком направлении ему отправиться, не помнил, ни куда он шёл, ни кем он был. Он присел на минуту, чтобы дать отдых своим уставшим ногам, взглянул вверх и неожиданно увидел пожилую женщину. Она беззубо улыбнулась, хихикнула и заговорила: „Теперь твоё *третье* желание. Что ты хочешь?“»~
@39572 = ~«„Третье желание? — удивился мужчина. — Как это желание может быть третьим, если у меня не было первого и второго?“»~
@39573 = ~«„Я уже выполнила два твои желания, — ответила колдунья, — но твоим вторым желанием было вернуть всё как было до исполнения первого. Вот почему ты ничего не помнишь: ведь всё, что ты помнил, было до того, как ты загадал первое желание“. Она усмехнулась над бедным пнём: „Так что у тебя осталось только одно желание“».~
@39574 = ~«„Хорошо, — ответил мужчина, — Я не верю тебе, но желание не принесёт мне вреда. Я хочу знать, кто я такой“.

„Смешно, — сказала женщина, исполнив его желание и исчезнув навсегда. — Это было твоё первое желание“».~
@39575 = ~«Что это была за чушь, тупой многогранник?! Самая скучная история из всех, какие я слышал!»~
@39576 = ~«Приукрашена?»~
@39577 = ~«*Давай* же, демонёныш. Покажи, что у тебя не только хвост есть».~
@39578 = ~Грейс поворачивается к Ивес: «Сегодня у меня нет истории, которой я бы хотела с тобой поделиться, Охотница-за-Рассказами. Я не могу позволить опустошить мои запасы, пока не пополню их».~
@39579 = ~«Во время 13.7-ой Революции нам было приказано починить механизм и тридцать первый зубец в пятом кольце Механуса. Мы устранили препятствие, и механизм заработал в полную силу. После выполнения поставленной задачи мы вернулись в Источник».~
@39580 = ~«История действительно имела место. Но немного приукрашена, конечно».~
@39581 = ~~
@39582 = ~«Я посчитал, что возвращение к Источнику — чрезвычайно подходящее окончание для рассказа».~
@39583 = ~Дак'кон церемонно кивает: «Я поделюсь историей об „Ач'али Утопшей“».

Дак'кон рассказывает историю Ач'али, глупой гитцерай, которая потерялась в хаосе Лимбо. Обычно гитцерай могут использовать свою концентрацию и внутреннюю дисциплину, чтобы превратить царящий вокруг хаос в пригодную для жизни среду. Однако Ач'али, желавшая вернуться домой, задавала столько бесполезных и не относящихся к делу вопросов, что островок организованной материи вокруг неё растаял и она утонула.~
@39584 = ~Дак'кон внимательно слушает, не скрывая лёгкого удивления.~
@39585 = ~«Не-а, не умею я рассказывать истории, не умею и всё, — она хмурится и машет руками, словно пытаясь отмахнуться от самой мысли об этом. — Даже и не проси о такой ерунде».~
@39586 = ~Анна чувствует себя не в своей тарелке, её хвост медленно покачивается из стороны в сторону. «Ну, одну историю я знаю… — неожиданно она смотрит на Ивес свирепо, — …но тебе она может не понравиться, наверняка не понравится, так что не обвиняй *меня* в том, что вырвала её!»~
@39587 = ~Анна зло смотрит, затем сдаётся с раздражённым вздохом: «Я слышала эту историю, когда была совсем маленькой.

Один пень возвращался домой поздно ночью, около антипика, мимо него по пустынной улице прошла беззубая старуха. „Куда ты идёшь?“ — спросила она».~
@39588 = ~«„Домой к жене“, — ответил он.

„Это около Шлаков?“ — спросила она.

„Точняк“, — сказал он».~
@39589 = ~«Она попросила его об одолжении… отнести коробку к Яме Трупаков и отдать одной женщине. Этот пень был настоящим мямлей, слишком хорошим, чтоб отказать, хотя со старой каргой явно было что-то *нечисто*, и согласился. „Но как зовут эту женщину? — спросил он. — Где она живёт? Где мне её искать, если её не будет у Ямы Трупаков?“»~
@39590 = ~«Старуха протянула ему деревянную коробку, завёрнутую в цветную тряпку, и сказала, чтоб он не парился и шёл, женщина будет там. Под конец она предупредила его: „Но что б ты ни делал, *НЕ открывай* коробку!“»~
@39591 = ~«Он принёс коробку домой и спрятал за стропилами, решив, что отнесёт её к Яме Трупаков утром. Но его жена видела, как он прятал коробку. Её переполнила ревность от мысли, что это может быть подарком любовнице, и она открыла её, как только он отвернулся».~
@39592 = ~«В общем, оказалось, что коробка была переполнена выдавленными глазами и обрубленными членами мужчин вместе с волоснёй. Пень прибежал на её крики… он вспомнил, что сказала старуха, испугался и снова завернул коробку».~
@39593 = ~«Он тут же отправился к Яме Трупаков, а там его и правда ждала другая старая карга. Он протянул ей коробку, а она ему говорит: „Эту коробку открывали и смотрели внутрь“».~
@39594 = ~«Бедный пень пытался отрицать, но она как глянет на него жутким взглядом. „Ты сделал ужасную вещь!“ — сказала она и исчезла. А мужик побежал обратно домой».~
@39595 = ~«Как только вернулся, он почувствовал недомогание и сразу же завалился в койку. Его жена горько пожалела, что открыла коробочку, но было уже поздно… на следующий день он умер от ужасной болезни, сгнил заживо. Примечательно, что первыми он потерял глаза и член».

Анна мрачно кивает, её рассказ окончен.~
@39596 = ~Сильнейшее убитое существо:~
@39597 = ~«Продолжай…»~
@39598 = ~«Погоди… у меня к тебе вопрос…»~
@39599 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39600 = ~«Продолжай…»~
@39601 = ~«Погоди… у меня вопрос…»~
@39602 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@39603 = ~«У меня есть ещё одна история».~
@39604 = ~«У меня к тебе вопрос, Ивес…»~
@39605 = ~«Мне пора идти. Счастливо, Ивес».~
@39606 = ~«Продолжай…»~
@39607 = ~«Погоди… у меня вопрос…»~
@39608 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
