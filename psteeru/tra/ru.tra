@38586 = ~Здесь слишком опасно для отдыха.~
@38587 = ~Тебе надо иметь разрешение, чтобы отдыхать здесь.~
@38588 = ~«Что это за существо?»~
@38589 = ~«Конечно».~
@38590 = ~«Я так не думаю».~
@38591 = ~«Что по поводу твоего друга?»~
@38592 = ~«Это трокопотака. Белая. С-с-с рогами. Ужас-сная. Троки едят плоть. Наши враги. Убей её, да?»~
@38593 = ~«Что по поводу твоего друга?»~
@38594 = ~«Я убью её».~
@38595 = ~«Убивай-ка ты сам».~
@38596 = ~«Да… хорошо. Тебе с-с-сокровище с трупа. Нам мяс-с-со. Иди! Убей!»~
@38597 = ~«Уже пошёл».~
@38598 = ~«С-с-с… бес-сполезное с-с-существо из мяс-са. Уходи!»~
@38599 = ~«Хорошо».~
@38600 = ~«Ха-ха… трус-с-с. Боитс-с-ся троков. Ха-ха. Убьёшь для нас-с-с, да?»~
@38601 = ~«И всё же, что это?»~
@38602 = ~«Ладно, убью».~
@38603 = ~«Нет, я так не думаю».~
@38604 = ~«Ха-ха… он трус-с-с. Боитс-с-ся троков. Ха-ха. Убьёшь для нас-с-с, да?»~
@38605 = ~«Уже пошёл».~
@38606 = ~«Он мёртв… это ты виноват! Он мёртв! Умри, мяс-с-со!» — упырь нападает на тебя!~
@38607 = ~Драться.~
@38608 = ~Бежать.~
@38609 = ~«Он мёртв… это ты виноват! Он мёртв! Умри, мяс-с-со!» — упырь нападает на тебя!~
@38610 = ~Драться.~
@38611 = ~Бежать.~
@38612 = ~«С-с-с… троко мертва… ты берёшь с-с-сокровище, мы — мяс-с-со, да?»~
@38613 = ~«Что это за тварь?»~
@38614 = ~«Договорились».~
@38615 = ~«Нет, если ты умрёшь первым».~
@38616 = ~«Это трокопотака. Белая. С-с-с рогами. Ужас-сная. Троки едят плоть. Наши враги. Плохой вкус-с-с. Щас-с-с мёртвая. Спас-с-сибо, с-существо из мяс-с-са».~
@38617 = ~«Спасибо. Прощай».~
@38618 = ~«Тогда бери и уходи… мы будем ес-с-сть».~
@38619 = ~«Прощай».~
@38620 = ~«Опять пришёл, с-с-существо из мяс-с-са? Забирай с-с-свои монеты и уходи».~
@38621 = ~«Ладно. Прощай».~
@38622 = ~«Убей троко для нас-с-с, да, и заберёш-шь его деньги. Мы з-заберём его еду. Нравитс-с-ся?»~
@38623 = ~«Что это за существо?»~
@38624 = ~«Трокопотака. Тебе нравитс-с-ся? Нам не нравитс-с-ся, нет… с-с-страшные и злые монс-с-стры. И мы им не нравимс-с-ся. Эта… охраняет тело, а оно нужно нам. Ты убьёш-шь её?»~
@38625 = ~«Что по поводу твоего друга?»~
@38626 = ~«Не друг! Хвас-с-стун! Больш-шой упырь! Говорит, не боитс-с-ся ничего! Думаеш-шь, он подойдёт к троко? Нет! Он трус-с-с! Убей её и покажеш-шь, кто с-с-смелый!»~
@38627 = ~«И всё же, что это?»~
@38628 = ~«Ладно, убью».~
@38629 = ~«С-с-с… бес-сполезное с-с-существо из мяс-са. Уходи».~
@38630 = ~«Хорошо».~
@38631 = ~«Нет, я так не думаю».~
@38632 = ~«Убью».~
@38633 = ~«С-с-спасибо… заберёш-шь деньги, когда она умрёт».~
@38634 = ~«Так и планировал».~
@38635 = ~«Убивай-ка ты сам».~
@38636 = ~«Конечно».~
@38637 = ~«Я так не думаю».~
@38638 = ~«Что по поводу твоего друга?»~
@38639 = ~«Почему ты не убиваеш-шь троко? Троко должна умереть! Убей её!»~
@38640 = ~«Уже пошёл».~
@38641 = ~«Что… что привело тебя обратно, глупое мяс-с-со? Умри!» — отвратительное существо прыгает на тебя!~
@38642 = ~Драться.~
@38643 = ~Бежать.~
@38644 = ~«Что… что привело тебя обратно, глупое мяс-с-со? Умри!» — отвратительное существо прыгает на тебя!~
@38645 = ~Драться.~
@38646 = ~Бежать.~
@38647 = ~«Забрал с-своё с-с-сокровище? Забирай и уходи, кус-с-сок мяс-са».~
@38648 = ~«Что это за тварь?»~
@38649 = ~«Трокопотака, да? Нравитс-ся? Нам не нравитс-с-ся, нет… с-с-страшные и злые монс-с-стры. И мы им не нравимс-с-ся. Мёртвая, да?»~
@38650 = ~«Наслаждайся. Прощай».~
@38651 = ~«Договорились».~
@38652 = ~«Нет, если ты умрёшь первым».~
@38653 = ~«Тогда бери и уходи… мы будем ес-с-сть».~
@38654 = ~«Прощай».~
@38655 = ~«Кто ты?»~
@38656 = ~«Кто ты?»~
@38657 = ~«Кто ты?»~
@38658 = ~«Что это за место?»~
@38659 = ~«Что это за место?»~
@38660 = ~«Что это за место?»~
@38661 = ~«Что это за место?»~
@38662 = ~«Я думаю, тебе будет интересно знать: Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38663 = ~«Я думаю, тебе будет интересно знать: Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38664 = ~Блеф: «Я думаю, тебе будет интересно знать: Безмолвный Король слишком силён, чтобы нападать на него. Лучше держись подальше от Мёртвых Народов, иначе трупы тебя уничтожат».~
@38665 = ~«Я пришёл повидаться с тобой, Многие-как-Один».~
@38666 = ~«Я здесь случайно».~
@38667 = ~«Если ты читаешь мои мысли, то к чему мне говорить, зачем я пришёл?»~
@38668 = ~«МЫ ГЛАЗА В ТЕМНОТЕ. МЫ МНОЖЕСТВО, МЫСЛЯЩЕЕ КАК ОДИН. МЫ НЕ ОТВЕЧАЕМ НА ТВОИ ВОПРОСЫ. ТЫ ОТВЕТИШЬ НА НАШИ. ЧТО ТЫ ДЕЛАЕШЬ В ЭТОМ МЕСТЕ, ТАК ДАЛЕКО ОТ ОСВЕЩЁННЫХ КОРИДОРОВ ЧЕЛОВЕЧЕСТВА?»~
@38669 = ~«МЫ ГЛАЗА В ТЕМНОТЕ. МЫ МНОЖЕСТВО, МЫСЛЯЩЕЕ КАК ОДИН. МЫ НЕ ОТВЕЧАЕМ НА ТВОИ ВОПРОСЫ. ТЫ ОТВЕТИШЬ НА НАШИ. ЧТО ТЫ ДЕЛАЕШЬ В ЭТОМ МЕСТЕ, ТАК ДАЛЕКО ОТ ОСВЕЩЁННЫХ КОРИДОРОВ ЧЕЛОВЕЧЕСТВА?»~
@38670 = ~«МЫ ГЛАЗА В ТЕМНОТЕ. МЫ МНОЖЕСТВО, МЫСЛЯЩЕЕ КАК ОДИН. МЫ НЕ ОТВЕЧАЕМ НА ТВОИ ВОПРОСЫ. ТЫ ОТВЕТИШЬ НА НАШИ. ЧТО ТЫ ДЕЛАЕШЬ В ЭТОМ МЕСТЕ, ТАК ДАЛЕКО ОТ ОСВЕЩЁННЫХ КОРИДОРОВ ЧЕЛОВЕЧЕСТВА?»~
@38671 = ~«МЫ ГЛАЗА В ТЕМНОТЕ. МЫ МНОЖЕСТВО, МЫСЛЯЩЕЕ КАК ОДИН. МЫ НЕ ОТВЕЧАЕМ НА ТВОИ ВОПРОСЫ. ТЫ ОТВЕТИШЬ НА НАШИ. ГОВОРИ ПРЯМО И ПОМНИ: МЫ СЛЫШИМ, КОГДА ТЫ ЛЖЁШЬ. ЧТО ТЫ ДЕЛАЕШЬ В ЭТОМ МЕСТЕ, ТАК ДАЛЕКО ОТ ОСВЕЩЁННЫХ КОРИДОРОВ ЧЕЛОВЕЧЕСТВА?»~
@38672 = ~«Я думаю, тебе будет интересно знать: Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38673 = ~«Я думаю, тебе будет интересно знать: Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38674 = ~Блеф: «Я думаю, тебе будет интересно знать: Безмолвный Король слишком силён, чтобы нападать на него. Лучше держись подальше от Мёртвых Народов, иначе трупы тебя уничтожат».~
@38675 = ~«Я пришёл повидаться с тобой, Многие-как-Один».~
@38676 = ~«Я здесь случайно».~
@38677 = ~«Если ты читаешь мои мысли, то к чему мне говорить, зачем я пришёл?»~
@38678 = ~Голоса в твоей голове, хоть и беззвучны, практически оглушают. «МЫ ПРИКАЗЫВАЕМ ТЕМ, КТО С ТОБОЙ, ЗАМОЛЧАТЬ. ТЫ В ДОМЕ МЫСЛИ, МЕСТЕ БЕЗРАЗДЕЛЬНОГО ГОСПОДСТВА МНОГИХ-КАК-ОДИН. ГОВОРИ ПРЯМО И ПОМНИ: МЫ СЛЫШИМ, КОГДА ТЫ ЛЖЁШЬ. ЧТО ТЕБЕ НУЖНО В ТЁМНЫХ ТУННЕЛЯХ?»~
@38679 = ~«Я думаю, тебе будет интересно знать: Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38680 = ~«Я думаю, тебе будет интересно знать: Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38681 = ~Блеф: «Я думаю, тебе будет интересно знать: Безмолвный Король слишком силён, чтобы нападать на него. Лучше держись подальше от Мёртвых Народов, иначе трупы тебя уничтожат».~
@38682 = ~«Я пришёл повидаться с тобой, Многие-как-Один».~
@38683 = ~«Я здесь случайно».~
@38684 = ~«Если ты читаешь мои мысли, то к чему мне говорить, зачем я пришёл?»~
@38685 = ~«ТАК ПУСТЬ ЖЕ МЁРТВЫЕ МЁРТВЫМИ И ПРЕБУДУТ. ИХ КОРОЛЬ-ИМПОТЕНТ БОЛЬШЕ НЕ БУДЕТ СТОЯТЬ НА НАШЕМ ПУТИ. ТЫ ОКАЗАЛСЯ ПОЛЕЗЕН. ЗА ЭТО МЫ РАЗРУШИМ БАРЬЕР ТВОЕГО РАЗУМА И ПОКАЖЕМ ТЕБЕ ТЕБЯ САМОГО. ПРИГОТОВЬСЯ К ОТКРОВЕНИЮ».~
@38686 = ~«Подожди! Не сейчас!»~
@38687 = ~«Я готов».~
@38688 = ~~
@38689 = ~~
@38690 = ~«ТЫ ПОСМЕЛ ПОКАЗАТЬСЯ ЗДЕСЬ СНОВА? ДВУНОГИЙ, ТЫ НЕОСТОРОЖЕН. ПРИГОТОВЬСЯ».~
@38691 = ~Драться.~
@38692 = ~«СКАЖИ НАМ, ЧТО ЗНАЕШЬ, ДВУНОГИЙ».~
@38693 = ~«Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38694 = ~«Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@38695 = ~Блеф: «Безмолвный Король слишком силён, чтобы нападать на него. Лучше держись подальше от Мёртвых Народов, иначе трупы тебя уничтожат».~
@38696 = ~«Пока мне нечего сказать».~
@38697 = ~«УПЫРИ СЛИШКОМ СИЛЬНЫ, ДАЖЕ ДЛЯ МОИХ ЛЮБИМЦЕВ КРЫС-ОБОРОТНЕЙ. ТЫ ПОТЕРПЕЛ НЕУДАЧУ. МЫ БОЛЬШЕ НЕ НУЖДАЕМСЯ В ТВОИХ УСЛУГАХ. УХОДИ СЕЙЧАС ЖЕ ИЛИ СТОЛКНЁШЬСЯ С УЖАСНЫМИ ПОСЛЕДСТВИЯМИ».~
@38698 = ~«Что, ты вот так запросто решил меня прогнать?»~
@38699 = ~«Тогда прощай».~
@38700 = ~Ты видишь худого мужчину в запятнанной одежде, у него скрюченный нос, а изо лба растут два коротких рога. Он куда-то ковыляет, бормоча что-то себе под нос… от него несёт солью, запахом рвоты и дешёвым вином.[Be sure to put in placeholder 2]~
@38701 = ~«Приветствую».~
@38702 = ~«Ты Джелай? Краддок говорит, что ты нужен ему на рынке».~
@38703 = ~Пройти мимо.~
@38704 = ~«Э… чё нада? Чего?»~
@38705 = ~«Ты Джелай? Краддок говорит, что ты нужен ему на рынке».~
@38706 = ~«Нет, ничего. Прости, что побеспокоил».~
