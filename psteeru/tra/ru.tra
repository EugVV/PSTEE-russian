@41511 = ~«У меня кое-какие вопросы…»~
@41512 = ~«Верно. Прощай, Долора».~
@41513 = ~«Да… вот они».~
@41514 = ~«Ещё нет… но я вернусь с ними».~
@41515 = ~«Я надеялся узнать побольше о твоей природе».~
@41516 = ~«Что ты здесь делаешь?»~
@41517 = ~«Можешь рассказать мне об этом месте?»~
@41518 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@41519 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@41520 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@41521 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@41522 = ~«Ты что-нибудь знаешь о Рейвел Клубок-Загадок?»~
