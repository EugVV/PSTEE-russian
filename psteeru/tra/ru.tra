@106497 = ~Женщина кивает и тут же убегает. Вряд ли ты когда-нибудь увидишь её снова.~
@106498 = ~[This is a placeholder to prevent a string with a sound file from becoming strref 106498, which causes problems.]~
@106499 = ~«Так кто же ты такой, Морте? Ты никогда не говорил о себе».~
@106500 = ~Прикинуться, что хочешь стать Пыльным, оставаясь Анархистом: «Да».~
@106501 = ~Прикинуться, что хочешь стать Чующим, оставаясь Анархистом: «Я готов. Я хочу стать Чующим».~
@106502 = ~Прикинуться, что хочешь стать Чующим, оставаясь Анархистом: «Я готов. Я хочу присоединиться к Обществу Восприятия. Больше я не чувствую себя частью фракции Боготов».~
@106503 = ~Прикинуться, что хочешь стать Чующим, оставаясь Анархистом: «Я готов. Я хочу присоединиться к Обществу Восприятия. Больше я не чувствую себя частью фракции Пыльных».~
@106504 = ~Прикинуться, что хочешь стать Чующим, оставаясь Анархистом: «Я готов. Я хочу присоединиться к Обществу Восприятия. Больше я не чувствую себя частью фракции Хаоситеков».~
@106505 = ~Прикинуться, что хочешь стать Хаоситом, оставаясь Анархистом: «Итак, что дальше?»~
@106506 = ~Прикинуться, что хочешь стать Хаоситом, оставаясь Анархистом: «Готов уже я Хаоситеком стать. Не принадлежу к Боготам больше я».~
@106507 = ~Прикинуться, что хочешь стать Хаоситом, оставаясь Анархистом: «Готов уже я Хаоситеком стать. Не принадлежу к Пыльным больше я».~
@106508 = ~Прикинуться, что хочешь стать Хаоситом, оставаясь Анархистом: «Готов уже я Хаоситеком стать. Не принадлежу к Чующим больше я».~
@106509 = ~Прикинуться, что хочешь стать Пыльным, оставаясь Анархистом: «Если это должно свершиться, то оно свершится. Мой разум должен быть в ладу с самим собой, и никак иначе. С этого момента я отрекаюсь от веры Боготов».~
@106510 = ~Прикинуться, что хочешь стать Пыльным, оставаясь Анархистом: «Если это должно свершиться, то оно свершится. Мой разум должен быть в ладу с самим собой, и никак иначе. С этого момента я отрекаюсь от… э-э… „веры“ Хаоситов».~
@106511 = ~Прикинуться, что хочешь стать Пыльным, оставаясь Анархистом: «Если это должно свершиться, то оно свершится. Мой разум должен быть в ладу с самим собой, и никак иначе. С этого момента я отрекаюсь от веры Чующих».~
@106512 = ~«Проклятие, Вейлор, ты хоть понимаешь, что натворил?!»~
@106513 = ~Вейлор отходит от трупа Триаса и поворачивается к тебе лицом к лицу: *Ты МИЛОСЕРДЕН и СЛАБ. ОЖЕСТОЧИ своё СЕРДЦЕ, пока болезнь не РАСПРОСТРАНИЛАСЬ.*~
