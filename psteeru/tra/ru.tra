@29002 = ~«Поговорим позже. Прощай».~
@29003 = ~«У меня вопросы о тебе…»~
@29004 = ~«У меня вопросы об этом месте».~
@29005 = ~«Что ты знаешь о Рейвел Клубок-Загадок?»~
@29006 = ~«Неважно. Прощай».~
@29007 = ~«Над чем ты размышлял, когда я подошёл?»~
@29008 = ~«Кто ты?»~
@29009 = ~«Что ты здесь делаешь?»~
@29010 = ~«На самом деле у меня вопросы о другом…»~
@29011 = ~«Неважно. Прощай».~
@29012 = ~«Что или кто ты?»~
@29013 = ~«Что ты здесь делаешь?»~
@29014 = ~«У меня вопросы о другом…»~
@29015 = ~«Это всё, что я хотел знать. Прощай».~
@29016 = ~«Над чем размышляешь?»~
@29017 = ~«Можешь потренировать меня?»~
@29018 = ~«Кто ты?»~
@29019 = ~«У меня были вопросы о другом…»~
@29020 = ~«Это всё, что я хотел знать. Прощай».~
@29021 = ~Сломать камень.~
@29022 = ~Сломать камень.~
@29023 = ~«Вообще-то забудь. У меня были другие вопросы».~
@29024 = ~«Мне пора уходить, забери свой камень. Прощай».~
@29025 = ~«У меня кое-какие вопросы…»~
@29026 = ~«В таком случае прощай».~
@29027 = ~«Чтобы защитить себя».~
@29028 = ~«Чтобы сокрушить врагов».~
@29029 = ~«Чтобы сокрушить врагов».~
@29030 = ~«Забудь. Позволь задать тебе ещё пару вопросов».~
@29031 = ~«Пока и не нужна. Прощай».~
@29032 = ~«Что ты хочешь сказать?»~
@29033 = ~«Забудь об этом. Дай-ка я спрошу тебя кое о чём ещё».~
@29034 = ~«В таком случае прощай».~
@29035 = ~«Но боя всё равно не избежать. Полагаться только на воровство — ошибка».~
@29036 = ~«Но боя всё равно не избежать. Полагаться только на воровство — ошибка».~
@29037 = ~~
@29038 = ~«Так ты не будешь меня тренировать?»~
@29039 = ~~
@29040 = ~~
@29041 = ~«Тогда я хотел бы спросить тебя о другом…»~
@29042 = ~«В таком случае прощай».~
@29043 = ~«Но ни один вор не поднимался до такого мастерства в скрытности. И от некоторых противников всё равно не спрятаться: тебя выдаст твой запах или даже всего лишь мысли».~
@29044 = ~«Но ни один вор, даже Эли, не поднимался до такого мастерства в скрытности. И от некоторых противников всё равно не спрятаться: тебя выдаст твой запах или даже всего лишь мысли».~
@29045 = ~«Так ты не будешь меня тренировать?»~
@29046 = ~~
@29047 = ~~
@29048 = ~«Маги — они как флакон с горючим маслом: мощно, но сгорело — и нет его. Кроме того, как правило, маги немощны физически, а их заклинания — лишь подпорка для их тела. Раз прочитанное заклинание исчезает, а суть боя остаётся».~
@29049 = ~~
@29050 = ~«Так ты не будешь меня тренировать?»~
@29051 = ~~
@29052 = ~~
@29053 = ~«Вскоре я буду там».~
@29054 = ~«У меня ещё есть дела, так что я зайду попозже».~
@29055 = ~«Прости, я всего лишь хотел удостовериться, что ты статуя».~
@29056 = ~«Хотел отплатить по заслугам за попытку одурачить меня».~
@29057 = ~«Забудь о том, что случилось. Прощай».~
@29058 = ~«Возможно. У меня кое-какие вопросы».~
@29059 = ~«Может быть. Прощай».~
@29060 = ~«Прости, я всего лишь хотел удостовериться, что ты статуя».~
@29061 = ~«Вот беда-то. Я хотел задать тебе пару вопросов».~
@29062 = ~«Тогда прощай».~
@29063 = ~«Генаси?»~
