@33761 = ~«Это всё, что мне нужно было знать. Прощай».~
@33762 = ~«Где расположен Мортуарий?»~
@33763 = ~«Где я могу найти Мемориал?»~
@33764 = ~«Как мне попасть к мавзолею?»~
@33765 = ~«Куда ведут западные врата?»~
@33766 = ~«Это всё, что мне нужно было знать. Прощай».~
@33767 = ~Этот бандитского вида мужик приближается к тебе с кривой улыбкой: «Эй там, кореш… как делишки? Тут местный проводник, я то бишь, так чё если медяк накинешь — я весь твой, направления укажу и типа того».~
@33768 = ~«Эй там, кореш… как делишки? Тут местный проводник, я то бишь, так чё если медяк накинешь — я весь твой, направления укажу и типа того».~
@33769 = ~«Тю, задницы сил… ты по ходу ещё неопытней в Сигиле, чем выглядишь! Проводник — это гид, кореш».~
@33770 = ~Мужик выхватывает у тебя из рук монетку и подмигивает: «Отлично! Из этой части Улья двое ворот — одни на севере и одни на юго-востоке. О, и если нарываешься на отличную драчку — есть аллея, ведущая на северо-восток, по которой ты, возможно, захочешь прогуляться. Ещё у нас тут есть управление контроля за паразитами и болезнями и приличного размера рынок».~
@33771 = ~«Посерёдке южной части района… дверь выходит на юг, просто шлёпай по самой южной дороге с запада на восток, пока не увидишь».~
@33772 = ~«К югу от „Г“-образного здания посерёдке северной половины района. Если двигать по северной дороге с запада на восток — мимо не пройдёшь. Толпа народу, куча купцов и всякое такое».~
@33773 = ~«Снова в Улей, кореш. Там есть ночлежка, если ты устал… или изранен… и тебе надо чуток вздремнуть».~
@33774 = ~«В другой кусок Улья, чувак. Там ты можешь сделать себе татуировки у мастера, а ещё там шикарная пивнушка под названием „Горящий труп“».~
@33775 = ~Мужик пожимает плечами: «Просто место, куда можно сходить если хочется чуток грубости и бардака. Как я уже сказал, это на северо-востоке… держись оттуда подальше, если не хочешь нарваться на неприятности».~
@33776 = ~«Что значит проводник?»~
@33777 = ~«Конечно… вот твой медяк».~
@33778 = ~«Нет, пока не нужно. Прощай».~
@33779 = ~«Что значит проводник?»~
@33780 = ~«Конечно… вот твой медяк».~
@33781 = ~«Нет, пока не нужно. Прощай».~
@33782 = ~«Хорошо… вот твой медяк».~
@33783 = ~«Никаких указаний на сегодня, спасибо. Прощай».~
@33784 = ~«Где находится управление контроля за паразитами и болезнями?»~
@33785 = ~«Где рынок?»~
@33786 = ~«Куда ведут северные ворота?»~
@33787 = ~«Куда ведут юго-восточные ворота?»~
@33788 = ~«Что там насчёт аллеи, о которой ты говорил?»~
@33789 = ~«Это всё, что я хотел узнать. Прощай».~
@33790 = ~«Где рынок?»~
@33791 = ~«Куда ведут северные ворота?»~
@33792 = ~«Куда ведут юго-восточные ворота?»~
@33793 = ~«Что там насчёт аллеи, о которой ты говорил?»~
@33794 = ~«Это всё, что я хотел узнать. Прощай».~
@33795 = ~«Где находится управление контроля за паразитами и болезнями?»~
@33796 = ~«Куда ведут северные ворота?»~
@33797 = ~«Куда ведут юго-восточные ворота?»~
@33798 = ~«Что там насчёт аллеи, о которой ты говорил?»~
@33799 = ~«Это всё, что я хотел узнать. Прощай».~
@33800 = ~«Где находится управление контроля за паразитами и болезнями?»~
@33801 = ~«Где находится рынок?»~
@33802 = ~«Куда ведут юго-восточные ворота?»~
@33803 = ~«Что там насчёт аллеи, о которой ты говорил?»~
@33804 = ~«Это всё, что я хотел узнать. Прощай».~
@33805 = ~«Где находится управление контроля за паразитами и болезнями?»~
@33806 = ~«Где рынок?»~
@33807 = ~«Куда ведут северные ворота?»~
@33808 = ~«Что там насчёт аллеи, о которой ты говорил?»~
@33809 = ~«Это всё, что я хотел узнать. Прощай».~
@33810 = ~«Где находится управление контроля за паразитами и болезнями?»~
@33811 = ~«Где рынок?»~
@33812 = ~«Куда ведут северные ворота?»~
@33813 = ~«Куда ведут юго-восточные ворота?»~
@33814 = ~«Это всё, что я хотел узнать. Прощай».~
@33815 = ~Эта привлекательная полураздетая женщина окликает тебя, устремляясь навстречу: «Прошу прощения, добрый сэр! Извини! Ты вродь как чуток потерялся, могу я позволить такую дерзость… те, случайно, не нужны услуги проводника? Всего-то за один медячок…»~
@33816 = ~«Те не нужны услуги проводника, добрый сэр? Всего-то один медячок станет…»~
@33817 = ~«Гид, сэр, чтоб провести тя по этой части Улья».~
@33818 = ~«Спасиб, сэр… эти денежки потрачены не зря, — она прячет медяк в карман. — Отсюда ведут двое врат — и те, и другие в самой западной части района: одни на севере и одни на юге. Здесь есть два местечка, которые ты можешь захотеть посетить: это бар „Горящий труп“ и салон татуировок. И наконец, вон там есть несколько зданий, их часто называют Логовом Головорезов… опасное, очень опасное место, сэр».~
@33819 = ~«Прям в центре района, сэр… квадратное здание с куполообразной крышей. Двигай вдоль самой южной дороги с востока на запад; увидишь вход в здание с южной стороны».~
@33820 = ~«Салон на самом востоке района, сэр… здание в форме купола с отделанной железной сеткой крышей… вход с юго-запада».~
@33821 = ~«В ту часть Улья, где Мортуарий, сэр. А ещё там бар „Собиратели пыли“, мемориал Пыльных и мавзолей».~
@33822 = ~«Врата ведут в ту часть Улья, где находится управление контроля за паразитами и болезнями и приличных размеров рынок».~
@33823 = ~Она кивает: «Эта группа зданий тянется вдоль северной части района, сэр… лучше б те держаться от этого места подальше. Иначе наверняка на драку нарвёшься, сэр».~
@33824 = ~«Что значит проводник?»~
@33825 = ~«Конечно… вот твой медяк».~
@33826 = ~«Нет, пока не нужны. Прощай».~
@33827 = ~«Что значит проводник?»~
@33828 = ~«Конечно… вот твой медяк».~
@33829 = ~«Нет, пока не нужны. Прощай».~
@33830 = ~«Хорошо… вот твой медяк».~
@33831 = ~«Никаких указаний на сегодня, спасибо. Прощай».~
@33832 = ~«Где расположен бар „Горящий труп“?»~
@33833 = ~«Где находится салон татуировок?»~
@33834 = ~«Куда ведут северо-западные врата?»~
@33835 = ~«Где это логово головорезов?»~
@33836 = ~«Это всё, что я хотел узнать. Прощай».~
@33837 = ~«Где находится салон татуировок?»~
@33838 = ~«Куда ведут северо-западные врата?»~
@33839 = ~«Куда ведут юго-западные врата?»~
@33840 = ~«Где это логово головорезов?»~
@33841 = ~«Это всё, что я хотел узнать. Прощай».~
@33842 = ~«Где расположен бар „Горящий труп“?»~
@33843 = ~«Куда ведут северо-западные врата?»~
@33844 = ~«Куда ведут юго-западные врата?»~
@33845 = ~«Где это логово головорезов?»~
@33846 = ~«Это всё, что я хотел узнать. Прощай».~
@33847 = ~«Где расположен бар „Горящий труп“?»~
@33848 = ~«Где находится салон татуировок?»~
@33849 = ~«Куда ведут юго-западные врата?»~
@33850 = ~«Где это логово головорезов?»~
@33851 = ~«Это всё, что я хотел узнать. Прощай».~
@33852 = ~«Где расположен бар „Горящий труп“?»~
@33853 = ~«Где находится салон татуировок?»~
@33854 = ~«Куда ведут северо-западные врата?»~
@33855 = ~«Где это логово головорезов?»~
@33856 = ~«Это всё, что я хотел узнать. Прощай».~
@33857 = ~«Где расположен бар „Горящий труп“?»~
@33858 = ~«Где находится салон татуировок?»~
@33859 = ~«Куда ведут северо-западные врата?»~
@33860 = ~«Куда ведут юго-западные врата?»~
@33861 = ~«Это всё, что я хотел узнать. Прощай».~
@33862 = ~Ты видишь старика с длинными седыми волосами и морщинистой жёлтой кожей. Держится он статно, несмотря на явную старость. Он улыбается и отвешивает тебе лёгкий поклон.~
@33863 = ~«Приветствую».~
@33864 = ~Не обращать на него внимания.~
@33865 = ~«И я тебя тоже, здоровяк. Чем могу услужить?» — он поднимает брови в ожидании ответа.~
@33866 = ~«У меня пара вопросов…»~
@33867 = ~«Мне нужны кое-какие заклинания».~
@33868 = ~«Я хочу посмотреть твой товар».~
@33869 = ~«Неважно. Прощай».~
@33870 = ~Он хмурится: «Прости меня, здоровяк, но я торгую магическим товаром, а не информацией. Если нужна информация, поищи её где-нибудь в другом месте».~
@33871 = ~«Мне нужны кое-какие заклинания».~
@33872 = ~«Покажи мне свой товар».~
@33873 = ~«Ясно. Прощай».~
@33874 = ~Пустая вершина~
@33875 = ~~
@33876 = ~~
@33877 = ~Ты видишь Аалека, торговца магическим товаром. «Добрый день, здоровяк. Рад новой встрече. Чем могу услужить?»~
@33878 = ~«Дай мне ещё раз посмотреть твой товар».~
@33879 = ~«Неважно. Прощай».~
@33880 = ~Он кивает и обводит взглядом рынок. «Прости меня, здоровяк, но я торгую только магическими вещицами. Тебе нужно потолковать с Циндером. Его прилавок за печью, по пути к выходу».~
@33881 = ~«Покажи мне свой товар».~
@33882 = ~«Спасибо, прощай».~
@33883 = ~Ты видишь сурового старика. Его лицо — сплошная сетка морщин.~
@33884 = ~«Приветствую».~
@33885 = ~Не обращать на него внимания.~
@33886 = ~Он отвешивает быстрый резкий поклон: «И тебе доброго здоровьичка. Меня Анзе зовут. Чёт надо?»~
@33887 = ~«У меня пара вопросов…»~
@33888 = ~«Неважно. Прощай».~
@33889 = ~Он улыбается беззубой улыбкой: «Чую, придётся с тобой балякать. Чё надо-то?»~
@33890 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@33891 = ~«У меня был череп, но его украли. Не знаешь, кто бы мог это сделать?»~
@33892 = ~«Для чего используется та печь?»~
@33893 = ~«Мне нужно приобрести оружие».~
@33894 = ~«Мне нужны магические товары».~
@33895 = ~«Мне пора идти. Прощай».~
@33896 = ~«Не припомню, чтоб слышал об ентом Лотаре… — старик украдкой оглядываясь по сторонам, раздумывая. — А, тот *костяной* малый… ага, слыхал об ём. Мой те сказ, не связывайся с ним. Крутой перец, с мёртвыми и всякой нечистью якшается».~
@33897 = ~«Где мне его найти?»~
@33898 = ~«Что ты можешь о нём рассказать?»~
@33899 = ~«Мне пора идти. Прощай».~
@33900 = ~Он пожимает плечами: «Прям и не знаю. Такой крутой может хучь где кости кинуть. Ни один пень не откажет, уж будь уверен».~
@33901 = ~«Что ты можешь о нём рассказать?»~
@33902 = ~«Ясно. Я хотел спросить о другом…»~
@33903 = ~«Мне пора идти. Прощай».~
@33904 = ~Он отрывисто смеётся: «Я ужо всё сказал, здоровяк. Больше ничё об ём не знаю».~
@33905 = ~«Где мне его найти?»~
@33906 = ~«Ясно. Я хотел спросить о другом…»~
@33907 = ~«Мне пора идти. Прощай».~
@33908 = ~Он старается выглядеть озабоченным, но получается у него плохо: «Мне типа жаль, здоровяк. Еси думаешь, чё череп твой украли, так сообщи в Гармониум».~
@33909 = ~«Гармониум?»~
@33910 = ~«Спасибо, у меня к тебе ещё пара вопросов…»~
@33911 = ~«Мне пора идти. Прощай».~
@33912 = ~Он улыбается: «Закон, здоровяк. Вояки из Гармониума и есть закон в Сигиле. Еси у тя чего украли, надо к ним обращаться».~
@33913 = ~«Думаешь, Гармониум сможет вернуть мне череп?»~
@33914 = ~«Ясно. Я хотел спросить о другом…»~
@33915 = ~Он хочет что-то сказать, но задумывается на минуту, затем хихикает: «Эт вряд ли, здоровяк. Неважно, проехали».~
@33916 = ~«Мне пора идти. Прощай».~
@33917 = ~«Так побазарь с Аалеком за соседним прилавком. Мож, у него кой-чё для тя и найдётся», — он указывает на прилавок слева.~
@33918 = ~«У меня к тебе ещё пара вопросов…»~
@33919 = ~«Спасибо. Прощай».~
@33920 = ~Он бросает взгляд на топку и понижает голос: «Печь нужна, тока чтоб научить моего ленивого мальчугана ответс'ности. Пацан тока и делает, чё вертится да языком треплет. Шибко умным себя считает, а цену настоящей работы не знает. Еси у тя ещё есть серьёзные вопросы… так лучше его поспрошай, не меня».~
@33921 = ~«У меня к тебе ещё пара вопросов…»~
@33922 = ~«Ясно. Прощай».~
@33923 = ~Пустая вершина~
@33924 = ~~
@33925 = ~~
@33926 = ~~
@33927 = ~нейтральный добрый.

Нейтрально-добрые персонажи верят в баланс между порядком и хаосом, но склонны совершать добрые дела.~
@33928 = ~хаотичный добрый.

Хаотично-добрым персонажам плевать на законы и порядок. Это индивидуалисты, склонные делать добрые дела.~
@33929 = ~законопослушный нейтральный.

Законопослушные нейтральные персонажи больше всего верят в порядок.~
@33930 = ~О твоей харизме ходят мифы. Твоё лидерство, действия и способность командовать могут привести планы к войне.~
@33931 = ~Твоя харизма легендарна. Ты был рождён, чтобы руководить; целые армии будут отдавать за тебя свои жизни.~
@33932 = ~Твоя харизма выше, чем у простых смертных. Ты такой человек, за которого многие отдадут свою жизнь.~
@33933 = ~По своему телосложению ты один из самых крепких существ в мультивселенной. Ты получаешь +<STAT_CONVAL1> пунктов здоровья за уровень.~
@33934 = ~О твоём телосложении слагают легенды. Ты получаешь +<STAT_CONVAL1> пунктов здоровья за уровень.~
@33935 = ~Твоё телосложение выше, чем у простых смертных. Ты получаешь +<STAT_CONVAL1> пунктов здоровья за уровень.~
@33936 = ~Твоя ловкость позволит тебе увернуться от атаки самой смерти. Ты получаешь улучшение к классу защиты +<STAT_DEXVAL1>.~
@33937 = ~О твоей ловкости слагают легенды. Ты получаешь улучшение к классу защиты +<STAT_DEXVAL1>.~
@33938 = ~Твоя ловкость выше, чем у простых смертных. Ты получаешь улучшение к классу защиты +<STAT_DEXVAL1>.~
@33939 = ~По своей мудрости ты — один из мудрейших существ в мультивселенной. Ты получаешь колоссальную прибавку ко всему получаемому опыту.~
@33940 = ~О твоей мудрости слагают легенды. Ты получаешь приличную прибавку ко всему получаемому опыту.~
@33941 = ~Твоя мудрость выше, чем у простых смертных. Ты получаешь приличную прибавку ко всему получаемому опыту.~
@33942 = ~По своему интеллекту ты один из умнейших существ в мультивселенной.~
@33943 = ~О твоём интеллекте слагают легенды. Ты можешь занести в свою книгу бесконечное множество заклинаний.~
@33944 = ~Твой интеллект выше, чем у простых смертных. Ты можешь занести в свою книгу бесконечное множество заклинаний.~
@33945 = ~По своей силе, ты один из сильнейших существ в мультивселенной. У тебя +<STAT_STRVAL1> к атаке и +<STAT_STRVAL2> к урону в ближнем бою.~
@33946 = ~О твоей силе слагают легенды. У тебя +<STAT_STRVAL1> к атаке и +<STAT_STRVAL2> к урону в ближнем бою.~
@33947 = ~Твоя сила выше, чем у простых смертных. У тебя +<STAT_STRVAL1> к атаке и +<STAT_STRVAL2> к урону в ближнем бою.~
@33948 = ~истинно нейтральный.

Истинно-нейтральные персонажи верят в баланс между порядком и хаосом. Они не склоняют чашу весов ни в одну из сторон и противостоят всем склоняющим.~
@33949 = ~хаотичный нейтральный.

Хаотичные нейтральные персонажи не признают порядка. Это сборище безумцев, сумасбродов и импульсивных личностей.~
@33950 = ~законопослушный злой.

Законопослушно-злые персонажи верят в «организованное зло» и предпочитают творить зло в иерархически упорядоченной манере.~
@33951 = ~нейтральный злой.

Нейтрально-злые персонажи верят в баланс между порядком и хаосом, но склоняются в сторону совершения злых деяний.~
@33952 = ~хаотичный злой.

Хаотично-злые персонажи — это негодяи из негодяев. Им плевать на порядок, правду и справедливость, они руководствуются только собственными эгоистичными желаниями.~
@33953 = ~Превращение Пламени~
@33954 = ~У тебя сила младенца. У тебя -%d к атаке и -%d к урону в ближнем бою.~
@33955 = ~Твоя сила достойна только жалости. У тебя -%d к атаке и -%d к урону в ближнем бою.~
@33956 = ~Твоя сила ниже среднего. У тебя -%d к атаке и -%d к урону в ближнем бою.~
@33957 = ~Подавить воспоминание.~
@33958 = ~«Я знал, что ты вернёшься, шеф! Наконец-то осознал, что без меня не обойтись, а?»~ [MRT516]
@33959 = ~«Да… пошли».~
@33960 = ~«Не сейчас, Морте».~
@33961 = ~«Пф. Ну что ж, не знаю, как долго я буду здесь ждать, так что я даю тебе один ПОСЛЕДНИЙ шанс. Ты точно уверен, что тебе не пригодятся мой быстрый ум и мудрые советы?»~
@33962 = ~«Морте, но у тебя же нет ни того, ни другого».~
@33963 = ~«Ну хорошо, я передумал. Идём».~
@33964 = ~«Не сейчас, Морте. Возможно, позже».~
@33965 = ~«Пытаешься задеть мои чувства, шеф? Я что-то не так сказал? Или причина, что у меня нет рук? В чём дело?»~
@33966 = ~«Ну хорошо, я передумал. Идём».~
@33967 = ~«Ничего подобного. Просто прямо сейчас мне не нужно твоё сопровождение. Прощай, Морте».~
@33968 = ~«Ну что ж, я не собираюсь ждать ВЕЧНО, так что тебе следует поскорее передумать и вернуться».~
@33969 = ~«Так и сделаю. Прощай, Морте».~
@33970 = ~«Что тебя гложет, шеф?»~
@33971 = ~~
@33972 = ~Дак'кон поворачивается при твоём приближении, его глаза похожи на полированные угольки: «Мне было *известно*, что ты вернёшся. Ты желаешь, чтобы два наших пути стали одним?»~ [DAK207]
@33973 = ~«Да. Мне нужна твоя помощь, Дак'кон».~
@33974 = ~«Не сейчас, Дак'кон, нет».~
@33975 = ~«Твой путь — мой путь».~ [DAK206]
@33976 = ~«Ну, в таком случае в путь».~
@33977 = ~«В таком случае наши пути расходятся».~
@33978 = ~«Прощай, Дак'кон».~
@33979 = ~«Какова твоя воля?»~ [DAK205]
@33980 = ~«Не бери в голову. Я просто проверял, со мной ли ты до сих пор».~
@33981 = ~Анна внимательно следит за твоим приближением, мотая хвостом взад-вперёд: «Ну чё… те нужна моя помощь?»~ [ANA454A]
@33982 = ~«Я хочу, чтобы мы снова путешествовали вместе».~
@33983 = ~«Нет, извини, что побеспокоил тебя».~
@33984 = ~«А ты ТОЧНО в этом уверен? Один раз ты уже бросал меня здесь, и мне это не нравится. Нету у меня времени на твои колебания. Если и в этот раз не совсем уверен, то лучше проваливай».~
@33985 = ~«Уверен. Мне нужна твоя помощь, Анна».~
@33986 = ~«Тогда я лучше пойду. Прощай».~
@33987 = ~«Пф-ф. В этом нет смысла, но я пойду с тобой. Раз уж те правда нужна помощь».~
@33988 = ~«Хорошо, пошли».~
@33989 = ~«Ну? И чё ты хошь теперь?»~ [ANA579B]
@33990 = ~«Ничего, Анна. Просто проверял, по-прежнему ли ты со мной».~
@33991 = ~Когда ты подходишь, Игнус шипит, от него струятся потоки горячего воздуха: «*Когда я здес-с-сь… мыс-сли наполнены пламенем…*»~ [IGN247]
@33992 = ~«Игнус, мне нужна твоя помощь».~
@33993 = ~~
@33994 = ~«*Я твой… пока с-с-смерть не зас-с-станет нас-с обоих…*»~ [IGN248]
@33995 = ~«Хорошо. Пошли».~
@33996 = ~Завитки пламени опоясывают горло Игнуса, а из-за его почерневших зубов вырываются языки огня: «*Дас-с-с?..*»~ [IGN249]
@33997 = ~«Игнус, что сделало тебя таким?»~
@33998 = ~«Вейлор… ну, пошли. Стряхни пыль с этих старых поножей и поторопись. Нам предстоит исправить столько зла».~
@33999 = ~Вейлор стоит молча и неподвижно; если бы не мерцающий красный огонёк в глазах, он бы сошёл за статую.~
@34000 = ~«Вейлор, мне нужна твоя помощь. Ты отправишься со мной?»~
@34001 = ~«Вейлор, мне нужна твоя помощь. Ты отправишься со мной?»~
@34002 = ~*Да*.~ [VHA127]
@34003 = ~«В таком случае в путь».~
@34004 = ~Вейлор стоит молча и неподвижно; если бы не мерцающий красный огонёк в глазах, он бы сошёл за статую.~
@34005 = ~«Мне нужно задать тебе пару вопросов, Вейлор…»~
@34006 = ~Кажется, Нордом запутался в собственных мыслях. Буквально. Он *щёлкает* и *вжикает* сам с собой, словно счётная машина.~
@34007 = ~«Нордом, мне нужна твоя помощь. Ты отправишься со мной?»~
@34008 = ~Оставить Нордома наедине с его «мыслями».~
@34009 = ~«Рот» Нордома принимает форму неестественно скошенного набок полукруга: «Подтверждение! Допуск дан, установки заменены». Его арбалеты начинают неистово *щёлкать* и *звенеть*, будто хотят вырваться из рук: «Статус: все готовы и Ждут указаний».~ [NOR298]
@34010 = ~«В таком случае в путь».~
@34011 = ~Нордом уставился на свои арбалеты. Они издают разнообразные щёлкающие звуки: сначала один, затем другой, как будто разговаривают между собой.~
@34012 = ~~
@34013 = ~Не обращать внимания на… куб.~
@34014 = ~Падшая Грейс поднимает глаза, заметив твоё приближение: «Ты хочешь, чтобы я снова стала твоей спутницей?»~ [FFG247]
@34015 = ~«Да. Если ты сама этого пожелаешь».~
@34016 = ~«Не сейчас… я просто зашёл проверить, как ты».~
@34017 = ~Она кивает: «С удовольствием».~ [FFG249]
@34018 = ~«Пошли».~
@34019 = ~Она кивает: «Спасибо. Очень мило с твоей стороны». Затем слегка улыбается: «Если тебе в будущем понадобится моя помощь, найдёшь меня здесь».~
@34020 = ~«Спасибо, Грейс. Я буду иметь тебя в виду».~
@34021 = ~«Да?»~ [FFG003]
@34022 = ~«Не расскажешь мне о танар'ри?»~
@34023 = ~«Приветствую…»~
@34024 = ~Игнорировать его.~
@34025 = ~Он улыбается, показывая свои дикого вида акульи зубы; его глаза похожи на блестящие чёрные шарики. Голос его хриплый и низкий: «Гаоха тоже тебя приветствует… ты ведь пришёл сыграть со мной, да?»~
@34026 = ~«Нет, но я хотел задать кое-какие вопросы…»~
@34027 = ~«Да, я сыграю с тобой».~
@34028 = ~«Нет… прощай».~
@34029 = ~Он уже собирается ответить, когда его глаза — блестящие и непроницаемые, словно шарики чёрного янтаря — останавливаются на Дак'коне. Минуту они молча глазеют друг на друга, затем взгляд гитцерай возвращается к тебе. Голос его хриплый и низкий: «Гаоха приветствует тебя… ты ведь пришёл сыграть со мной, да?»~
@34030 = ~«Нет, но я хотел задать кое-какие вопросы…»~
@34031 = ~«Да, я сыграю с тобой».~
@34032 = ~«Нет… прощай».~
@34033 = ~Улыбка Гаохи тут же слетает с губ, он отрицательно качает головой. «Не интересуют вопросы меня. Только игра… бросок костей, звон монет, проигрыш или выигрыш, да? — он трясёт в руке кости. — Тебя… разве не интересуют подобные вещи?»~
@34034 = ~«Ну хорошо… я сыграю с тобой».~
@34035 = ~«Ну хорошо… я сыграю с тобой».~
@34036 = ~«Нет. Прощай».~
@34037 = ~Гаоха тянется в карман своей туники и достаёт оттуда монетку: «Эта монетка? Твоя монетка». Он кладёт её у твоих ног и достаёт другую: «Эта монетка? Монетка Гаоха». Он кладёт её у своих ног, затем сжимает две кости между большим и указательным пальцами: «Кости… каждый из нас кидает по одной, да?»~
@34038 = ~«Продолжай…»~
@34039 = ~«Твой бросок больше, обе монеты… — он поднимает обе монеты с земли и протягивает тебе, — …твои. Бросок Гаохи больше?» Он быстро засовывает медяки обратно в тунику: «Мои. Никто не бросил больше? Монеты ставятся на другой бросок. Итак: сколько денег будет лежать у твоих ног?»~
@34040 = ~«Один медяк».~
@34041 = ~~
