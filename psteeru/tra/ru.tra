@54105 = ~«Продолжай…»~
@54106 = ~«Я хочу стать воином. Можешь меня научить?»~
@54107 = ~«Я хочу стать лучшим воином. Не поможешь мне развить свои умения?»~
@54108 = ~«Я хочу стать воином. Можешь меня научить?»~
@54109 = ~«Я хочу стать лучшим воином. Не поможешь мне развить свои умения?»~
@54110 = ~«Мне пора идти. Прощай».~
@54111 = ~Череп Мантуока~
@54112 = ~ЧЕРЕП МАНТУОКА
Вес: 2

Это череп крысы-оборотня Мантуока.~
@54113 = ~Глаза Лотара горят яростью. «Убиваешь моих слуг, да? Дай мне череп, — он тщательно осматривает череп и говорит. — Я чую через его кость запах предательства. Осторожный проныра, но всё же недостаточно осторожный, м-м? Я вытащу из него его секреты. Не беспокойся, я узнаю причину его двуличия. У тебя есть ко мне вопросы?»~
@54114 = ~«У меня много вопросов».~
@54115 = ~«Ещё нет».~
@54116 = ~«Ещё нет».~
@54117 = ~Проклятие чёрных шипов~
@54118 = ~Щит чёрных шипов~
@54119 = ~При твоём приближении этот коротышка с кислым лицом поднимает брови. Он говорит тоном заевшегося, заносчивого дворянина: «Напоминаю, любезный, что ты вмешиваешься в официальный процесс, и следи за своим языком: я здесь влиятельный магистрат и не хотел бы, чтобы ты разделил судьбу… — он даёт знак, чтобы приговор приводили в исполнение, — …этого *несчастного*».~
@54120 = ~«Если вы его казните, то только добавите хаоса, низвергнувшего город в Карцери. Положите конец этому безумию, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@54121 = ~«Если вы его казните, то только добавите хаоса, низвергнувшего город в Карцери. Положите конец этому безумию, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@54122 = ~«Если вы его казните, то только добавите хаоса, низвергнувшего город в Карцери. Положите конец этому безумию, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@54123 = ~«Вы не можете казнить этого человека. Именно из-за подобных вещей Керст соскользнул в Карцери… и именно это мы должны остановить, чтобы вернуть город-врата обратно во Внешние Земли».~
@54124 = ~«Вы не можете казнить этого человека. Это *неправильно*. Именно из-за подобных вещей Керст соскользнул в Карцери… и именно это мы должны остановить, чтобы вернуть город-врата обратно во Внешние Земли».~
@54125 = ~«„Официальный процесс“? Сомнительно. Вы не казните этого человека».~
@54126 = ~«Тогда неважно. Прощай».~
@54127 = ~«О? — он опускает одну густую бровь, одновременно поднимая другую. — Так ты посмеешь встать на пути правосудия? И *как* ты собираешься остановить казнь, любезный?»~
@54128 = ~«Этот мужчина — просто козёл отпущения. Если вы казните его, то только добавите хаоса, низвергнувшего город в Карцери. Нам нужно покончить с этим безумием, чтобы мы смогли вернуть Керст куда подобает… прежде чем убьют нас *всех*».~
@54129 = ~«Я… — Анна вздрагивает от новой волны холода, идущей от портала. — Ага, я с тобой… и ваще, ты ж потеряешь головёшку, если её не придерживать. Куда ж ты без няньки, так что я в деле».~
@54130 = ~«Может, и так. Дак'кон? Ты со мной?»~
@54131 = ~«Может, и так. Дак'кон? Ты со мной?»~
@54132 = ~«Может, и так. Морте? Ты со мной?»~
@54133 = ~«Может, и так. Морте? Ты со мной?»~
@54134 = ~«Ладно… посмотрим, что там за этим порталом».~
@54135 = ~«Ладно… посмотрим, что там за этим порталом».~
@54136 = ~«Ладно… посмотрим, что там за этим порталом».~
@54137 = ~«Я… — Анна свирепо смотрит на Падшую Грейс, потом поворачивается к тебе, её глаза горят. — Если *она* идёт, то и я тоже… да, я иду. Не парься, тут тебя не брошу».~
@54138 = ~«Отлично. Дак'кон? Ты со мной?»~
@54139 = ~«Отлично. Дак'кон? Ты со мной?»~
@54140 = ~«Отлично. Морте? Ты со мной?»~
@54141 = ~«Отлично. Морте? Ты со мной?»~
@54142 = ~«Ладно… посмотрим, что там за этим порталом».~
@54143 = ~«Ладно… посмотрим, что там за этим порталом».~
@54144 = ~«Ладно… посмотрим, что там за этим порталом».~
@54145 = ~«*Я твой… пока с-с-смерть не придёт з-з-за нами ОБОИМИ…*»~
@54146 = ~«Ясно… Падшая Грейс?»~
@54147 = ~«Ясно… Анна?»~
@54148 = ~«Ясно… Дак'кон?»~
@54149 = ~«Ясно… Дак'кон?»~
@54150 = ~«Ясно… Морте?»~
@54151 = ~«Ясно… Морте?»~
@54152 = ~«Ладно… посмотрим, что там за этим порталом».~
@54153 = ~«Ладно… посмотрим, что там за этим порталом».~
@54154 = ~«Ладно… посмотрим, что там за этим порталом».~
@54155 = ~«Почему бы и нет, шеф? — Морте встряхивает головой. — Я хочу сказать, мы уже посетили ВСЕ ОСТАЛЬНЫЕ ужасные планы мультивселенной, какие только можно себе представить. Почему бы не сделать последний шаг с обрыва?» Он испускает шумный вздох: «ТЫ-то готов? Потому что если не готов ты…»~
@54156 = ~«Не расскажешь мне снова о том, что находится за порталом?»~
@54157 = ~«Я готов, Морте. Больше мне нечего делать для подготовки. Ты со мной?»~
@54158 = ~«Может, ты и прав… дай-ка я сначала подготовлюсь».~
@54159 = ~«Ну, я… — Морте смотрит на мерцающий синий занавес и издаёт ещё один шумный вздох. — Конечно. Пошли. Я хочу сказать, любое место будет лучше медленного гниения моей черепушки в Мортуарии, верно?»~
@54160 = ~«Что ж, ладно…»~
@54161 = ~«Э… — Морте колеблется, глядя на портал, потом на тебя, потом снова на портал, и шумно вздыхает. — Слушай, я не *очень-то* много могу тут сказать, но… ну, кое-что я всё-таки сказать должен…»~
@54162 = ~«О чём ты, Морте?»~
@54163 = ~«Что? Да ладно тебе, Морте, нам надо идти…»~
@54164 = ~«Ну, это о том, куда мы направляемся… или, точнее, где… мы… уже *были*».~
@54165 = ~«„Где МЫ уже были“? О чём ты говоришь?»~
@54166 = ~«„Где МЫ уже были“? О чём ты говоришь?»~
@54167 = ~«„Где МЫ уже были“? О чём ты говоришь?»~
@54168 = ~«Э-э… шеф? — Морте колеблется, глядя на портал, потом на тебя, потом снова на портал, и шумно вздыхает. — Слушай, я не *очень-то* много могу тут сказать, но… ну, кое-что я всё-таки сказать должен…»~
@54169 = ~«О чём ты, Морте?»~
@54170 = ~«Что? Да ладно тебе, Морте, нам надо идти…»~
@54171 = ~«Ну, это о том, куда мы направляемся… или, точнее, где… мы… уже *были*».~
@54172 = ~«„Где МЫ уже были“? О чём ты говоришь?»~
@54173 = ~«„Где МЫ уже были“? О чём ты говоришь?»~
@54174 = ~«„Где МЫ уже были“? О чём ты говоришь?»~
@54175 = ~«Мы… э-э, не в ПЕРВЫЙ раз через это проходим… понимаешь, раньше мы уже были в этой „Крепости Сожалений“… просто мы… я… не знал этого тогда».~
@54176 = ~«Ты не *знал*? Как это возможно?»~
@54177 = ~«Так ты С САМОГО НАЧАЛА… мог мне СКАЗАТЬ, где находится портал, ЧТО является ключом к нему, ПОЧЕМУ я бессмертен, ЧТО случилось с моей смертностью И сам факт, что она находится в Крепости?! Морте, я тебя *УБЬЮ*!..»~
@54178 = ~«Морте, я жду объяснений… отныне больше никакой лжи и отговорок».~
@54179 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54180 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54181 = ~«Это трудно объяснить, пока не *попадёшь* туда… кроме того, ты не знал, э-э, *другого* себя: он вовсе не был рубахой-парнем и не особо ДЕЛИЛСЯ с нами байками. Хочу сказать, я знал, что он ищет ОДНО место, но не знал, почему ищет, ЧТО это за место и где оно. Я не мог сказать тебе НИЧЕГО, потому что НИЧЕГО не знал! Я… просто знаю, что случилось, когда мы туда ПРИШЛИ…»~
@54182 = ~Ты видишь огромное, больше пятнадцати футов в высоту, создание. От его массивного торса отходят четыре руки… две из них заканчиваются клешнями, а две другие — когтистыми кистями. Голова напоминает собачью, с острыми клыками и фиолетовыми глазами. Оно не отрывает от тебя взгляда.~
@54183 = ~Привет. Надеюсь, у тебя есть клевая секира для меня.~
@54184 = ~Ты видишь пустую пентаграмму. Воздух над ней сухой и холодный. Вокруг царит ощущение великого зла.~
@54185 = ~Оставить её в покое.~
@54186 = ~Прочитатать свиток Донны Квишо.~
@54187 = ~На миг воздух темнеет, твою голову и сердце словно бы пронизывает холодный ветер. Когда зрение проясняется, перед тобой стоит огромный изверг!~
@54188 = ~~
@54189 = ~«И… что случилось?»~
@54190 = ~«И… что случилось?»~
@54191 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54192 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54193 = ~Морте выглядит испуганным: «Нет! Нет! Мы… я… ничего этого НЕ ЗНАЛ! Ты вовсе не был самым общительным рубахой-парнем на планах! Этот… *другой* ты держал КУЧУ баек при себе… а мы даже не знали, ЗАЧЕМ направляемся в это место и ЧТО это вообще за место! Я… просто знаю, что произошло, когда мы туда ПРИШЛИ…»~
@54194 = ~«И… что произошло?»~
@54195 = ~«И… что произошло?»~
@54196 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54197 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54198 = ~«Ну, мы пришли в эту… эту КРЕПОСТЬ и, прежде чем наши ноги ступили в это место, были все РАЗДЕЛЕНЫ друг от друга и вынуждены сражаться за свои жизни… это *первое*, что я хотел тебе сказать, если ты всё-таки решишь пройти через портал. Высока вероятность, что кто-то окажется *далеко* от других. А тебе — вот беда — всё же понадобятся там напарники…»~
@54199 = ~«Зачем ты мне это рассказываешь?»~
@54200 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54201 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54202 = ~«Ну, мы пришли в эту… эту КРЕПОСТЬ и, прежде чем наши ноги ступили в это место, были все РАЗДЕЛЕНЫ друг от друга и вынуждены сражаться за свои жизни… это *первое*, что я хотел тебе сказать, если ты всё-таки решишь пройти через портал. Высока вероятность, что кто-то окажется *далеко* от других. А тебе — вот беда — всё же понадобятся там напарники…»~
@54203 = ~«Зачем ты мне это рассказываешь?»~
@54204 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54205 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54206 = ~«Что бы ни ожидало тебя в Крепости, шеф, однажды оно уже победило тебя… по сей день я не понимаю, как тебе удалось выжить. Но если ты снова падёшь, тебе понадобится кто-то, кто вытащит тебя из Крепости…»~
@54207 = ~«Морте, мне нужно, чтобы ты рассказал о Крепости всё возможное… это важно».~
@54208 = ~«Морте, мне нужно, чтобы ты рассказал о Крепости всё возможное… это важно».~
@54209 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54210 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54211 = ~«Эта „Крепость Сожалений“… она тянется на целые ЛИГИ, шеф. Это Крепость, но она куда больше похожа на ПЛАН: весь каменный, весь погружён во мрак, и тени… всюду тени. Ты идёшь туда, и… тебе лучше хорошо подготовиться».~
@54212 = ~«Что случилось, когда мы попали туда в первый раз?»~
@54213 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54214 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54215 = ~«Эта „Крепость Сожалений“… она тянется на целые ЛИГИ, шеф. Это Крепость, но она куда больше похожа на ПЛАН: весь каменный, весь погружён во мрак, и тени… всюду тени. Мы идём туда, и… лучше бы нам быть готовыми ко всему».~
@54216 = ~«Что случилось, когда мы попали туда в первый раз?»~
@54217 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54218 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54219 = ~«Шеф, я не знаю, что случилось с ТОБОЙ, но помню, что случилось со МНОЙ… я провёл время, бегая от укрытия к укрытию; эти тени ползли за мной, пытаясь меня убить… и тут… внезапно мы вывалились „прочь“, будто кто-то вышвырнул нас назад…»~
@54220 = ~«Секундочку. Когда ты сказал „нас“, звучало, будто там были не только ты и я».~
@54221 = ~«Секундочку. Когда ты сказал „нас“, звучало, будто там были не только ты и я».~
@54222 = ~«Как мне отсюда выбраться?»~
@54223 = ~«Секундочку. Когда ты сказал „нас“, звучало, будто там были не только ты и я».~
@54224 = ~~
@54225 = ~«Ясно. Что ещё ты можешь мне рассказать?»~
@54226 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54227 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54228 = ~~
@54229 = ~На мгновение Морте смолкает. «Нет… были и другие. Был… Дак'кон, девчонка-чующая Дейонарра, слепой лучник, наполовину спятивший от выпивки, и мы с тобой… а потом мы просто попали в ад и обратно. Очевидно, что ты, я и Дак'кон вернулись, а те двое — нет. Я не знаю, что случилось с ними».~
@54230 = ~«Дак'кон? Но почему?.. Стоит спросить об этом его. Однако ты сказал, что Дейонарра и тот лучник не вернулись из Крепости?»~
@54231 = ~«Дак'кон? Но почему?.. Стоит спросить об этом его. Однако ты сказал, что эта женщина, Дейонарра, и тот лучник не вернулись из Крепости?»~
@54232 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54233 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54234 = ~На мгновение Морте смолкает. «Нет… были и другие. Был… тот старый гит Дак'кон, девчонка-чующая Дейонарра, слепой лучник, наполовину спятивший от выпивки, и мы с тобой… а потом мы просто попали в ад и обратно. Очевидно, что ты, я и Дак'кон вернулись, а те двое — нет. Я не знаю, что случилось с ними».~
@54235 = ~«Говоришь, Дейонарра и тот лучник не вернулись из Крепости?»~
@54236 = ~«Говоришь, та женщина, Дейонарра, и тот лучник не вернулись из Крепости?»~
@54237 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54238 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54239 = ~Морте трясёт головой: «Нет, насколько мне известно».~
@54240 = ~«Что ещё ты можешь рассказать об этой Крепости?»~
@54241 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54242 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54243 = ~«Больше ничего, шеф. Кроме того, что мы разделились, едва появившись там, и того, что это ОГРОМНОЕ место, кишащее тенями… и где-то в этой Крепости есть нечто более могущественное, нежели *любой* из нас. А больше и сказать нечего…»~
@54244 = ~«Ты *уверен*? Это может оказаться последней возможностью поговорить друг с другом…»~
@54245 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54246 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54247 = ~Портальная линза в твоих руках кажется холодной и безжизненной. Похоже, она не будет работать вне куба модронов.~
@54248 = ~Убрать линзу.~
@54249 = ~«Ну… — Морте выдерживает паузу. — Да, есть ещё одна вещь, которую тебе следует знать: ТЫ, которого я знал раньше и который привёл нас сюда в прошлый раз, — он был не такой, как ты. Абсолютно».~
@54250 = ~«Что ты имеешь в виду?»~
@54251 = ~Портальная линза пульсирует от наполняющей её энергии. Она ожидает выбора места назначения…~
@54252 = ~«Что ты имеешь в виду?»~
@54253 = ~Улей, район ночлежки.~
@54254 = ~Улей, район Мортуария.~
@54255 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54256 = ~Улей, район рынка.~
@54257 = ~Улей, район бара «Горящий труп».~
@54258 = ~Нижний район.~
@54259 = ~Район Клерков.~
@54260 = ~Катакомбы Плачущих Камней.~
@54261 = ~Убрать линзу.~
@54262 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54263 = ~«Другой ТЫ… он… он ни о ком особо не заботился. Вообще ни о ком. Мы могли ВСЕ умереть в Крепости, а он и глазом бы не моргнул. Так что… я просто хочу отметить твоё отличие… ну, теперешний *ты* мне нравишься больше. НАМНОГО больше».~
@54264 = ~«Но это не всё, что ты хотел бы сказать, так?»~
@54265 = ~«Это всё?»~
@54266 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54267 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54268 = ~«Это всё, что я хотел сказать. Несмотря на твой ослиный характер, у ТЕБЯ больше духа, чем когда-либо было у него. Другой ТЫ, он… он был отстранённым от всего. Я просто хочу… чтобы ты не забывал об этом».~
@54269 = ~«Но это не всё, что ты хотел бы сказать, так?»~
@54270 = ~«Это всё?»~
@54271 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54272 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54273 = ~«Нет… — Морте снова выдерживает паузу, — …есть ещё одна вещь. Я никогда особо не любил *другого* тебя, но он был умным убийцей — умнейшим из всех, кого я знал: у него всегда было всё схвачено. Если он умер в Крепости, это значит… ну…»~
@54274 = ~«Ты сомневаешься, что у меня получится, да?»~
@54275 = ~«Неважно, Морте. Я готов пройти через портал. Ты со мной?»~
@54276 = ~«Неважно, Морте. Что случилось — то случилось. Я собираюсь пройти через портал».~
@54277 = ~«Нет… — Морте трясёт головой. — Не так, шеф. Потому что не всегда побеждает сильнейший, или умнейший, или самый злобный… иногда имеет значение, кто ты и чего *на самом деле* хочешь. Я хочу сказать, когда-то ты захотел стать бессмертным — но *действительно* ли ты этого хотел? Я говорю, чтобы ты подумал, действительно ли ты хочешь того, что делаешь».~
@54278 = ~«Достаточно честно. Слушай, Морте… мы никогда об этом не говорили, но ты знаешь, что не обязан туда со мной идти, верно? Я пойму, если ты откажешься».~
@54279 = ~«Понял. Если ты уже высказал своё дружелюбие, то пошли. Готов?»~
@54280 = ~«Понял, спасибо за совет, Морте. Теперь я собираюсь пройти через портал».~
@54281 = ~«Да… знаю, шеф. И не могу лгать тебе… я не хочу туда идти… но пойду. Только знай, что теперь мы идём в этот портал не только ради *тебя*. Ты играешь нашими жизнями, но мы не желаем отступать, даже если погибнем».~
@54282 = ~«Тогда почему?..»~
@54283 = ~«Тогда почему?..»~
@54284 = ~«Тогда почему?..»~
@54285 = ~«Тогда почему?..»~
@54286 = ~«Тогда почему?..»~
@54287 = ~Жёлтые-Пальцы бросается прочь, не переставая угрюмо бормотать.~
@54288 = ~Уйти.~
@54289 = ~Это безукоризненно чистая полка с пустым пространством — с череп размером — между двумя скалящимися черепами.~
@54290 = ~Это безукоризненно чистая полка с пустым пространством — с череп размером — между двумя скалящимися черепами.~
@54291 = ~Оставить полку в покое.~
@54292 = ~Оставить полку в покое.~
@54293 = ~«Для тебя теперь нет спасения».~
@54294 = ~«Ладно, народ, вы видели достаточно!»~
@54295 = ~«Твоё время вышло, винокур».~
@54296 = ~«Взять его!»~
@54297 = ~«Ещё один нарушитель? Приготовься к смерти!»~
@54298 = ~«Умри, дикий зверь!»~
@54299 = ~~
@54300 = ~Тестоклес, я хочу провести тест на взаимодействие партии.~
@54301 = ~Тогда да будет тест. Я извергну один беспредметный незначащий текст, который ты сейчас читаешь. Моя любимая ассистентка, малышка Тест, прочтет несколько слов мудрости, а затем я закончу взаимодействие с последним любопытным фактом этой беседы.~
@54302 = ~Вот вам и тест. Успешное выполнение теста на взаимодействие, наполненное драмой и неизвестностью. Я надеюсь, вам понравится наше маленькое шоу.~
@54303 = ~Тестоклес, я хочу провести тест на взаимодействие партии.~
@54304 = ~Я хотел бы помочь тебе, но я не могу найти малышку ТЕСТ, мою возлюбленную ассистентку. Если ты поместишь её ко мне (с помощью редактора мира), я с радостью начну тест.~
@54305 = ~Батарейки в комплект не входят. Отсутствует на складе. Потребуется некоторая сборка. Использовать по назначению. Предлагать пустоту запрещено законом.~
@54306 = ~«Я искал тебя, дэв».~
@54307 = ~«Я искал тебя, дэв».~
@54308 = ~«Я искал тебя, дэв».~
@54309 = ~«Я искал тебя, дэв».~
@54310 = ~«Я искал тебя, дэв».~
@54311 = ~«Я искал тебя, дэв».~
@54312 = ~Я нашёл ангела, о котором говорила Рейвел, «Триаса», заключённого в Керсте. Тяжело даже представить себе, что граждане могут так обращаться с ангелом… это на самом деле город головорезов и предателей. Не то чтобы он сильно отличался от ОСТАЛЬНЫХ мест, где я бывал…~
@54313 = ~«Чего ты от меня желаешь, смертный? Говори как на духу, а затем уходи».~ [TTB005]
@54314 = ~«У меня к тебе кое-какие вопросы…»~
@54315 = ~«У меня твой меч».~
@54316 = ~«Забудь. Прощай».~
@54317 = ~«Что тебе нужно, смертный?»~ [TTB002]
@54318 = ~«У меня к тебе кое-какие вопросы…»~
@54319 = ~«У меня твой меч».~
@54320 = ~«Ничего. Прощай».~
@54321 = ~«Благодарю за моё освобождение. Я в долгу перед тобой, — его обгоревшие крылья трепещут. — Что ты хочешь просить, смертный? Боюсь, я мало что могу предложить в качестве дара».~ [TTB098]
@54322 = ~«У меня к тебе много вопросов…»~
@54323 = ~«Ну и ладно. Прощай».~
@54324 = ~Дэв поднимает голову и пристально на тебя смотрит. Его глас чист и мелодичен: «Чего ты желаешь от меня, смертный? Выкладывай как на духу и позволь мне вернуться к воспоминаниям о рае».~ [TTB004]
@54325 = ~«Ведьма Рейвел сказала мне разыскать тебя».~
@54326 = ~«Я слышал об эпидемии, вспыхнувшей, когда открыли эту тюрьму».~
@54327 = ~«Что это за место?»~
@54328 = ~«Кто ты?»~
@54329 = ~«Воспоминаниям о рае?»~
@54330 = ~~
@54331 = ~~
@54332 = ~Дэв поворачивает голову и останавливает взгляд на Морте: «От тебя исходит сильное зловоние Баатора, череп».~
@54333 = ~Дэв поворачивает голову и останавливает взгляд на Морте: «От тебя исходит сильное зловоние Баатора, череп».~
@54334 = ~~
@54335 = ~~
