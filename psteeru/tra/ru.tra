@7533  = ~«Не расскажешь мне об этом районе?»~
@7534  = ~«Я ищу дневник. Ты его не видела?»~
@7535  = ~«Я ищу кое-кого по имени Фарод. Не знаешь, где его можно найти?»~
@7536  = ~«Неважно. Прощай».~
@7537  = ~«Неважно. Прощай».~
@7538  = ~«Неважно. Прощай».~
@7539  = ~«Неважно. Прощай».~
@7540  = ~Схватить её за руку.~
@7541  = ~Схватить её за руку.~
@7542  = ~«Эй! Что ж ты делаешь?!»~
@7543  = ~Подставиться, чтобы женщина ещё раз залезла к тебе в карман, и проследить за её техникой.~
@7544  = ~«Приветствую».~
@7545  = ~Подставиться, чтобы женщина ещё раз залезла к тебе в карман, и проследить за её техникой.~
@7546  = ~Подставиться, чтобы женщина ещё раз залезла к тебе в карман, и проследить за её техникой.~
@7547  = ~Напасть на неё.~
@7548  = ~Игнорировать инцидент, уйти.~
@7549  = ~Тихо: «Не ори, а то язык вырву».~
@7550  = ~«Тихо! Мать твою, женщина, молчи!»~
@7551  = ~Сломать ей шею свободной рукой.~
@7552  = ~Отпустить её.~
@7553  = ~«Ладно же…»~
@7554  = ~«Ладно же…»~
@7555  = ~Напасть на неё.~
