@35301 = ~«Приятно было пообщаться. Прощай».~
@35302 = ~Оставить труп в покое.~
@35303 = ~«Приятно было пообщаться. Прощай».~
@35304 = ~Оставить труп в покое.~
@35305 = ~Этот труп не отвечает. Кажется, она находится слишком далеко отсюда, чтобы ответить.~
@35306 = ~Этот оживлённый скелет ужасно воняет, как будто с него совсем недавно ободрали мясо и почистили. Его челюсть и основные суставы туго стянуты кожаными ремнями, а на тело наброшен грубый халат. На лбу вырезан номер «1221».~
@35307 = ~«Извини, ты не видел здесь других скелетов?»~
@35308 = ~Скелет не отвечает.~
@35309 = ~«Рад был поговорить, Костяшка. Будь здоров».~
@35310 = ~«Хм-м-м. Интересно, будет ли против этот серобородый, если *я* позаимствую его тело…»~
@35311 = ~«Серобородый?»~
@35312 = ~«Серобородый… ну, старый приятель, жёлтая собака… старикашка».~
@35313 = ~«Ну, я не думаю, что он будет возражать. Почему бы не взять тело?»~
@35314 = ~Морте какое-то время изучает скелет, затем качает головой: «Не-а… мне нужен посвежее, чем этот. И посолиднее… этот уж больно скрипучий и растрескавшийся».~
@35315 = ~«А ты нет?»~
@35316 = ~«О, да ты прям ходячий прикол, — яростно сверлит тебя взглядом Морте. — Особенно, когда *молчишь*, тупица. Зеркала молят о пощаде, когда ты рядом».~
@35317 = ~«Что, правда? Ну, у *меня* хотя бы все части тела на месте».~
@35318 = ~Морте фыркает. Ты не знаешь, как ему это удаётся без лёгких.~
@35319 = ~«Дай-ка я тебе кое-что скажу, Морте. Нет ничего лучше, чем просто ходить, размахивать руками, вдыхать свежий воздух через лёгкие. Иметь тело — это ЗДОРОВО».~
@35320 = ~«Должен уведомить, что помощь в твоём побеге из препарационной добавлена в список поступков, о которых я жалею, — Морте снова фыркает. — Надо было оставить тебя гнить… и дальше, то есть».~
@35321 = ~«Рад, что ты это чувствуешь. Пошли».~
@35322 = ~«Пошли».~
@35323 = ~«Пошли».~
@35324 = ~«Ладно. Пошли».~
@35325 = ~«Что-то мне подсказывает, что ты был бы в два раза надоедливее, будь у тебя руки. Пошли».~
@35326 = ~«Я не думаю, что он будет возражать».~
@35327 = ~«Что-то мне подсказывает, что ты был бы в два раза надоедливее, будь у тебя руки. Пошли».~
@35328 = ~«Рад был поговорить, Костяшка. Будь здоров».~
@35329 = ~«Рад был поговорить, Костяшка. Будь здоров».~
@35330 = ~«Извини, ты не видел здесь других скелетов?»~
@35331 = ~«Никак не пойму, зачем тебе халат? Скрывать-то под ним вроде уже нечего».~
@35332 = ~«Никак не пойму, зачем тебе халат? Скрывать-то под ним вроде уже нечего».~
@35333 = ~Использовать на скелете свою способность «Разговор с мёртвыми».~
@35334 = ~Этот скелет не отвечает. Кажется, что он слишком далеко отсюда, чтобы отвечать на твои вопросы.~
@35335 = ~Оставить скелет в покое.~
@35336 = ~Оставить скелет в покое.~
@35337 = ~Оставить скелет в покое.~
@35338 = ~Внимательно осмотреть скелет.~
@35339 = ~Кто-то связал кости этого скелета кожаными ремнями, намотанными на тело так, что они напоминают мускулы и сухожилия. Ремни закреплены металлическими болтами, вбитыми в суставы. Похоже, этот скелет служил довольно долго: большинство его костей имеют сколы, а их многочисленные трещины скреплены замазкой и плохо пахнущим клеем.~
@35340 = ~Попробовать вытащить болты из скелета.~
@35341 = ~«Эй, шеф. Это же вандализм. Возможно, те болты — единственное, что скрепляет этот мешок костей. Так вот действуют силы некромантии, знаешь ли».~
@35342 = ~«И чего?»~
@35343 = ~«О, это не проблема, — Морте делает странное движение, которое может означать пожатие плечами. — Просто не был уверен, знаешь ты или нет. Давай, сделай это».~
@35344 = ~Попробовать вытащить болты из скелета.~
@35345 = ~Ты пытаешься вытащить железные болты, но у тебя не хватает силы. Они вбиты довольно основательно.~
@35346 = ~«Может, если бы у меня был нужный инструмент, я бы их вынул… хм-м-м. Возможно, я ещё вернусь, Костяшка».~
@35347 = ~«Может, если бы у меня был нужный инструмент, я бы их вынул… хм-м-м. Возможно, я ещё вернусь, Костяшка».~
@35348 = ~«Может, если бы у меня был нужный инструмент, я бы их вынул… хм-м-м. Возможно, я ещё вернусь, Костяшка».~
@35349 = ~Оставить скелет в покое.~
@35350 = ~Оставить скелет в покое.~
@35351 = ~Оставить скелет в покое.~
@35352 = ~Попробовать вытащить болты из скелета.~
@35353 = ~Ты изо всех сил пытаешься вытащить железные болты и после нескольких рывков выдираешь их из суставов. Скелет рассыпается; некоторые кости всё ещё подёргиваются.~
@35354 = ~«Извини, Костяшка…»~
@35355 = ~Попробовать вытащить болты из скелета.~
@35356 = ~Используя монтировку, ты вырываешь болты из суставов скелета. Скелет рассыпается; некоторые кости всё ещё подёргиваются.~
@35357 = ~«Извини, Костяшка…»~
@35358 = ~«Неважно. Может, в другой раз».~
@35359 = ~«Неважно. Может, в другой раз».~
@35360 = ~«Ох… я не хотел причинять необратимые повреждения».~
@35361 = ~«Ладно, неважно. Может, в другой раз».~
@35362 = ~Попробовать вытащить болты из скелета.~
@35363 = ~Попробовать вытащить болты из скелета.~
@35364 = ~Попробовать вытащить болты из скелета.~
@35365 = ~«Не против, если я позаимствую эти ремни и болты?»~
@35366 = ~«Не против, если я позаимствую эти ремни и болты?»~
@35367 = ~«Не против, если я позаимствую эти ремни и болты?»~
@35368 = ~Оставить скелет в покое.~
@35369 = ~Оставить скелет в покое.~
@35370 = ~Оставить скелет в покое.~
@35371 = ~Попробовать вытащить болты из скелета.~
@35372 = ~Попробовать вытащить болты из скелета.~
@35373 = ~Попробовать вытащить болты из скелета.~
@35374 = ~Попробовать вытащить болты из скелета.~
@35375 = ~Попробовать вытащить болты из скелета.~
@35376 = ~Попробовать вытащить болты из скелета.~
@35377 = ~Попробовать вытащить болты из скелета.~
@35378 = ~«Как насчёт этого скелета, Морте? Сгодится в качестве тела?»~
@35379 = ~Оставить скелет в покое.~
@35380 = ~Оставить скелет в покое.~
@35381 = ~Оставить скелет в покое.~
@35382 = ~Этот скелет не отвечает. Кажется, он слишком далеко отсюда, чтобы отвечать на твои вопросы.~
@35383 = ~Согласно надписи, вырезанной над бровью скелета, его номер «748». Он необычен только тем, что некоторые из его зубов, похоже, не настоящие, а сделаны из какого-то красновато-коричневого камня. Очевидно, ценности они не представляют, так как в противном случае смотрители удалили бы их.~
@35384 = ~«Извини, ты не видел здесь других скелетов?»~
@35385 = ~Скелет не отвечает.~
@35386 = ~«Рад был поговорить, Костяшка. Будь здоров».~
@35387 = ~«Хм-м-м. Интересно, будет ли против этот серобородый, если *я* позаимствую его тело…»~
@35388 = ~«Серобородый?»~
@35389 = ~«Серобородый… ну, старый приятель, жёлтая собака… старикашка».~
@35390 = ~«Ну, я не думаю, что он будет возражать. Почему бы не взять тело?»~
@35391 = ~Морте какое-то время изучает скелет, затем качает головой: «Не-а… мне нужен посвежее, чем этот. И посолиднее… этот уж больно скрипучий и растрескавшийся».~
@35392 = ~«А ты нет?»~
@35393 = ~«О, да ты прям ходячий прикол, — яростно сверлит тебя взглядом Морте. — Особенно, когда *молчишь*, тупица. Зеркала молят о пощаде, когда ты рядом».~
@35394 = ~«Что, правда? Ну, у *меня* хотя бы все части тела на месте».~
@35395 = ~Морте фыркает. Ты не знаешь, как ему это удаётся без лёгких.~
@35396 = ~«Дай-ка я тебе кое-что скажу, Морте. Нет ничего лучше, чем просто ходить, размахивать руками, вдыхать свежий воздух через лёгкие. Иметь тело — это ЗДОРОВО».~
@35397 = ~«Должен уведомить, что помощь в твоём побеге из препарационной добавлена в список поступков, о которых я жалею, — Морте снова фыркает. — Надо было оставить тебя гнить… и дальше, то есть».~
