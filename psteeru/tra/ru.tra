@13223 = ~«Ещё я ищу мужчину по имени Фарод».~
@13224 = ~«Я хочу задать вопрос о другом…»~
@13225 = ~«Это всё, что я хотел узнать. Прощай».~
@13226 = ~«Как тут с работой?»~
@13227 = ~«Должен ли я чего-нибудь здесь остерегаться?»~
@13228 = ~«Должен ли я чего-нибудь здесь остерегаться?»~
@13229 = ~«Ещё я ищу мужчину по имени Фарод».~
@13230 = ~«Я хочу задать вопрос о другом…»~
@13231 = ~«Следи за языком, Анна».~
@13232 = ~«Не обращай на неё внимания, Гвоздичка. У меня были вопросы…»~
@13233 = ~«У меня были вопросы, Гвоздичка…»~
@13234 = ~«Неважно. Прощай».~
@13235 = ~Правда: «Анна… прошу прощения, если я вёл себя не по-товарищески. Надеюсь, ты простишь мне все прежние обиды».~
@13236 = ~Правда: «Анна… прошу прощения, если я вёл себя не по-товарищески. Надеюсь, ты простишь мне все прежние обиды».~
