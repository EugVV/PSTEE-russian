Боль, Агония, Мучение, Страдание. После призыва Руны сама земля содрогнётся от боли. Страдание разума. Страдание тела. Страдание души. Всё станет явным, когда будет начертан Круг.

Когда Высший Круг будет начертан на земле, Руна взорвётся и все враждебные существа в области 50х50 футов получат 30-100 пунктов урона. Спасброска нет.~
@49302 = ~Ты видишь мужчину с ангельским лицом. Его глаза почти закрыты, как если бы он не хотел видеть ужасы этого мира или позволить миру видеть ужасы внутри себя. Тем не менее улыбка морщит его лицо. Когда он приветствует тебя, голос звучит томно, но дружелюбно: «Привет».~
@49303 = ~«У меня к тебе вопросы…»~
@49304 = ~«Привет и прощай».~
@49305 = ~«Что ты хотел бы знать?»~
@49306 = ~«Что можешь рассказать об этом месте?»~
@49307 = ~«Кто ты?»~
@49308 = ~«Я ищу дэва».~
@49309 = ~«Спасибо, ничего. Прощай».~
@49310 = ~«Что, о таверне „Врата предателей“? Здесь заправляет Пятнистый Барс; частенько захаживают сюда Маркез, бывший Гармониум, Китла, бывшая служащая, Даллан, бывшее-всё-что-угодно, — если я услышу о нём какие байки, может, и расскажу как-нибудь — и Донна Квишо, чью историю я не знаю… пока».~
@49311 = ~«Кто ты?»~
@49312 = ~«Я ищу дэва».~
@49313 = ~«Спасибо. Прощай».~
@49314 = ~«Я? Я — Набат. Когда-то рассказчик, а теперь докатился до историй за деньги в тавернах. Нынче я не при делах. Быть может, позже я расскажу историю и тебе. Быть может. Хочешь что-нибудь ещё?»~
@49315 = ~«Что можешь рассказать об этом месте?»~
@49316 = ~«Я ищу дэва».~
@49317 = ~«Спасибо, ничего. Прощай».~
@49318 = ~Его лицо морщит улыбка: «И с чего ты решил, что я могу тут хоть чем-то помочь? Серьёзно… что ты хочешь знать?»~
@49319 = ~«Что можешь рассказать об этом месте?»~
@49320 = ~«Кто ты?»~
@49321 = ~«Спасибо, ничего. Прощай».~
@49322 = ~Набат тебе улыбается: «Чего хочешь теперь?»~
@49323 = ~«Я всего лишь хотел получить ответы на вопросы…»~
@49324 = ~«Ничего. Прощай».~
@49325 = ~Ты видишь мужчину с ангельским лицом. Его глаза почти закрыты, как если бы он не хотел видеть ужасы этого мира или позволить миру видеть ужасы внутри себя. Тем не менее улыбка морщит его лицо. Когда он приветствует тебя, голос звучит томно, но дружелюбно: «Привет. Я слышал, ты ищешь некий ключ».~
@49326 = ~«Точно».~
@49327 = ~«Да, но не сейчас. У меня к тебе пара вопросов…»~
@49328 = ~«Не сейчас. Прощай».~
@49329 = ~«Так… ты вернулся. Хочешь узнать третью часть ключа?»~
@49330 = ~«Да».~
@49331 = ~«Да, но не сейчас. У меня к тебе пара вопросов…»~
@49332 = ~«Не сейчас. Прощай».~
@49333 = ~«Смотритель городской свалки — человек по имени Кайз. Просочились слухи, что у него куча золота под полом спрятана, — а тут случись банда головорезов, которые захотели его ограбить. У меня свои причины не допустить этого. Иди поговори с Кайзом и помоги ему. Сделай это, и я скажу тебе ключ. И, если тебе интересно, покажу некоторые уловки для лучшей скрытности».~
@49334 = ~«Ладно. Только сначала пара вопросов».~
@49335 = ~«Хорошо. До свидания».~
@49336 = ~«У тебя вопросы? Славно. Но сейчас вопрос один: собираешься ты это делать или нет? У меня — ключ, у тебя — вопросы. И ты получишь ответы, когда всё кончится. У тебя не очень-то много времени».~
@49337 = ~«Хорошо. Что мне надо сделать?»~
@49338 = ~«Почему это тебе так важно?»~
@49339 = ~«Как скажешь. Прощай».~
@49340 = ~«А тебе не всё ли равно? Быть может, он мой любимый дедушка. Быть может, я хочу отомстить людям, которые хотят на него напасть. Быть может, я сам положил глаз на его деньги. Так ли важна мотивация? Ты получаешь то, что нужно тебе, — ключ — а я получаю то, что нужно мне».~
@49341 = ~«Хорошо. Что мне надо сделать?»~
@49342 = ~«Тогда ладно. Прощай».~
@49343 = ~У тебя такое ощущение, что эти полуприкрытые глаза тебя оценивают: «Мои источники говорят, что ты ещё не выполнил работу, которую я тебе дал. Сделай её и узнаешь третью часть ключа».~
@49344 = ~«Можешь ты всего лишь ответить на мои вопросы?»~
@49345 = ~«Хорошо. До свидания».~
@49346 = ~Он вздыхает: «Что ты хочешь знать? Хочешь знать обо мне? Я Набат. Хочешь знать о Керсте? Спроси у тех, кого он волнует. Хочешь знать об этой таверне? Она полна людей, которых предали. Хочешь знать о дэве? Закончи работу и на шаг продвинешься в его поисках. Теперь иди заканчивай, и все мы будем довольны».~
@49347 = ~«Хорошо. До свидания».~
@49348 = ~Когда ты подходишь, Набат выдаёт широчайшую улыбку: «Я слышал, ты выполнил уговор. Это значит, что ты узнаешь третью часть ключа». Его глаза на миг вспыхивают, и он изрекает: «„…их участь определена…“» Когда глаза возвращаются в обычное состояние, он пожимает плечами: «Боюсь, не слишком много от стиха… но без этого не сработает. Спасибо за помощь. Следующая часть ключа у Даллана. Он вон там, с молоденькой подружкой. Или я могу научить тебя кое-каким воровским уловкам…»~
@49349 = ~«Ну теперь-то ты ответишь на пару вопросов?»~
@49350 = ~«Научи-ка меня искусству скрытности».~
@49351 = ~Набат сообщил мне третью часть ключа: «…их участь определена…» Теперь я должен поговорить с Далланом. Он тот, что с молоденькой подружкой.~
@49352 = ~«Почему бы и нет? Я как раз в настроении».~
@49353 = ~«Зачем ты хотел, чтобы я спас старика? Разве это не город предательств?»~
@49354 = ~«Расскажи мне о себе».~
@49355 = ~«Расскажи мне историю».~
@49356 = ~«Расскажи об этом месте».~
@49357 = ~«Научишь меня искусству скрытности?»~
@49358 = ~«Опять ты, да? Чего тебе нужно теперь?»~
@49359 = ~«Ответы на пару вопросов…»~
@49360 = ~«Хочу, чтобы ты обучил меня искусству скрытности».~
@49361 = ~«Это моя бывшая банда. Они выгнали меня за кражу их денег — хотя на самом деле меня подставили. Я сам распускал слухи насчёт Кайза — знал, что они на это купятся и либо с ними кто-либо разделается, либо они оставят улики и попадутся страже. В любом случае я выигрывал».~
@49362 = ~«Ясно… у меня ещё пара вопросов…»~
@49363 = ~«Как мило с твоей стороны. Прощай».~
@49364 = ~«Звать меня Набат. Просто Набат. Некоторое время тому назад я пришёл сюда из Аутоматы в поисках впечатлений, в поисках людей, которые любят истории. Связался с дурной компанией и всё такое… остальное — уже история».~
@49365 = ~«Надо же, как оригинально. Ещё пара вопросов…»~
@49366 = ~«Спасибо. Прощай».~
@49367 = ~«Сейчас я как раз работаю над рассказом о мести. Можно сказать, навеяло, — он зловеще улыбается. — Быть может, когда закончу, я расскажу тебе, но не раньше. Суеверия, знаешь ли».~
@49368 = ~«Ну хорошо. Ответь ещё на пару вопросов…»~
@49369 = ~«Ладно. Прощай».~
@49370 = ~«Оно является примерно тем, что ты видишь, кроме той части, которая не видна. Этот городишко полон предателей, лицемеров и ударов в спину. Родной дом для всего худшего в человеческой натуре. Это нехорошо. Надеюсь, ты спрашивал отвлечённо, потому что я тебе *не экскурсовод*».~
@49371 = ~«Всё ясно. Ещё пара вопросов…»~
@49372 = ~«Спасибо. Прощай».~
@49373 = ~Ты видишь высокого мужчину с чёрным волосами до плеч и пронзительными синими глазами. Куда бы он ни смотрел, кажется, это место сейчас начнёт дымиться. Рядом с ним стоит скромная девушка, которая рассеянно улыбается всему, что он говорит. Он обращает на тебя ясные синие глаза и широко улыбается. Протягивает тебе руку: «Я Даллан. Рад встрече».~
@49374 = ~«У меня пара вопросов…»~
@49375 = ~«Приятно познакомится. Прощай».~
@49376 = ~«Как скажешь. Прощай».~
@49377 = ~Даллан снова широко тебе улыбается: «Что случилось?»~
@49378 = ~«У меня пара вопросов…»~
@49379 = ~«Ничего. Прощай».~
@49380 = ~«Что тебе нужно знать?»~
@49381 = ~«Я слышал, в этом городе находится дэв».~
@49382 = ~«Кто ты?»~
@49383 = ~«Кто эта девушка?»~
@49384 = ~«Забудь. Прощай».~
@49385 = ~Он смеётся и качает головой: «А другой вопрос у тебя есть?»~
@49386 = ~«Да. Что ты знаешь об этом дэве?»~
@49387 = ~«Кто ты?»~
@49388 = ~«Кто эта твоя подруга?»~
@49389 = ~«Нет. Прощай».~
@49390 = ~«Я — бард, историк, актёр и артист всех жанров. Самый виртуозный музыкант во Внешних Землях, — его лицо вновь озаряет заразительная улыбка. — По крайней мере, так я всем говорю».~
@49391 = ~«Так расскажи мне об этом дэве…»~
@49392 = ~«Кто твоя подруга?»~
@49393 = ~«Спасибо. Прощай».~
@49394 = ~Он ухмыляется: «Она — подруга. Это всё, что тебе нужно знать». Девушка слегка улыбается в его сторону и краснеет.~
@49395 = ~«Ладно, тогда расскажи мне об этом дэве…»~
@49396 = ~«Тогда расскажи мне о себе…»~
@49397 = ~«Понял. Прощай».~
@49398 = ~Он громко смеётся: «Всякая вещь имеет себе цену, а для этой информации цену я ещё не готов назвать. Возможно, позже».~
@49399 = ~«Может, угрозы с моей стороны помогут тебе передумать?»~
@49400 = ~«Ну тогда расскажи мне о своей подруге…»~
@49401 = ~«Тогда расскажи мне о себе…»~
@49402 = ~«Понимаю. Прощай».~
@49403 = ~Его рука устремляется к оружию: «Полагаю, тогда мы выясним, кто из нас лучший боец».~
@49404 = ~«Расслабься. Это просто вопрос. Кстати, ответь ещё на пару…»~
@49405 = ~«Может, позже. У меня ещё вопросы…»~
@49406 = ~«Хм-м. Я подумаю. Прощай».~
@49407 = ~Ты видишь высокого мужчину с чёрным волосами до плеч и пронзительными синими глазами. Куда бы он ни смотрел, кажется, это место сейчас начнёт дымиться. Рядом с ним стоит скромная девушка, которая рассеянно улыбается всему, что он говорит. Он обращает на тебя ясные синие глаза и широко улыбается: «Я Даллан. Ты ищешь ключ».~
@49408 = ~«Верно. И что мне нужно сделать?»~
@49409 = ~«Не сейчас. Прощай».~
@49410 = ~~
@49411 = ~Чтобы получить часть ключа от Даллана, я должен поговорить с чиновником-гитиянки по имени Ан'изиус. Его можно найти рядом с вратами в Карцери в центре города.~
@49412 = ~«Ты хочешь ключ, не так ли?»~
@49413 = ~«Верно. И что мне нужно сделать?»~
@49414 = ~«Не сейчас. Прощай».~
@49415 = ~«Это сама простота. У одного из городских лидеров есть некоторые… политические затруднения, скажем так. Один из его врагов в городском совете доставляет ему неудобства. Сходи поговори с ним об этом и подумай, чем ты можешь ему помочь. Его имя Ан'изиус, он гитиянки. Ты найдёшь его у врат в Карцери в центре города».~
@49416 = ~«Позволь мне уточняющий вопрос. Он что, твой друг? Какого именно результата ты ждёшь?»~
@49417 = ~~
@49418 = ~«Хорошо. Я вернусь. До встречи».~
@49419 = ~Его ухмылка ширится: «Скажем так, я доверяю твоему решению. Ты поймёшь, что я имею в виду».~
@49420 = ~~
@49421 = ~«Хорошо. Я вернусь. До встречи».~
@49422 = ~Даллан одаривает тебя очередной фирменной улыбкой и обнимает свою подругу за плечи: «Как дела, м-м? Есть успехи?»~
@49423 = ~«Дело движется. У меня появилась пара вопросов…»~
@49424 = ~«Я работаю над этим. До свидания».~
@49425 = ~«Позже. Сейчас у меня есть дела поважнее… — он рассеянно оглядывает комнату. — Поговорим, когда будет результат».~
@49426 = ~«Хорошо. До свидания».~
@49427 = ~«Я всё слышал о твоей прекрасной работе, друг. Это был интересный маленький переворот. И как тебе политическая жизнь в Керсте, а? — он отхлёбывает свой эль. — Вот тебе плата с моей стороны». Его голос понижается, приобретая почти ритуальные нотки: «„Поскольку удалены они от Богов и света Небесного…“» Его голос становится обычным, и он говорит: «За последней частью ключа обратись к Донне Квишо. Она вон там».~
@49428 = ~«Сперва ответь на пару вопросов…»~
@49429 = ~«Спасибо. Прощай».~
@49430 = ~Даллан отплатил мне своей частью ключа и направил меня к Донне Квишо. Его часть гласит: «Поскольку удалены они от Богов и света Небесного…»~
@49431 = ~«Снова вернулся, да? Соскучился?» Девушка с ним едва уловимо отличается… вроде бы черты лица другие, но поведение настолько похоже, что трудно сказать определённо.~
@49432 = ~«У меня кое-какие вопросы…»~
@49433 = ~«Кажется, уже прошло. Прощай».~
@49434 = ~«Что ты хотел знать?»~
@49435 = ~«Кто эта твоя подруга?»~
@49436 = ~«Каким боком ты был замешан в этом деле? Тебе-то что за забота?»~
@49437 = ~«Ничего. Прощай».~
@49438 = ~«Она — подруга, дружище, и мы здорово проводим время вместе. Тебе надо что-то ещё?»~
@49439 = ~«Да. Откуда такой интерес к этому делу? Как ты с этим связан?»~
@49440 = ~«Нет. Прощай».~
@49441 = ~«Ан'изиус запретил мне играть в городе, — он плюёт на пол. — А Сиабха отказалась помочь, несмотря на нашу долгую дружбу. Она сказала, что сейчас не время раскрывать карты. Потому что он властолюбивый ублюдок, а она — амбициозная шлюха. Я знал, что так или иначе один из них — или они оба — должны были пасть».~
@49442 = ~«Ясно. Прощай».~
@49443 = ~«О-о, гитиянки. На спор, что Дак'кон будет *очень* рад помочь».~
@49444 = ~«Спасибо за ценный вклад, Морте. Пошли».~
@49445 = ~Девушка мило тебе улыбается и отступает в сторону своего мужчины. Она ничего не говорит, а когда с ней заговариваешь ты, отшатывается ещё сильней.~
@49446 = ~«Тогда прощай».~
@49447 = ~~
@49448 = ~Когда ты приближаешься, девушка отходит, глядя куда угодно, только не на тебя. Она кажется очень юной.~
@49449 = ~«Прощай».~
@49450 = ~Этот невысокий, приземистый мужчина пребывает в атмосфере собственной важности. Похоже, как раз сейчас он готовится читать лекцию.~
@49451 = ~Остаться на лекции.~
@49452 = ~Уйти.~
@49453 = ~Ты видишь высокую эффектную женщину. Она отсутствующим взглядом смотрит на стены таверны, медленно сжимая и разжимая кулаки. Когда женщина замечает тебя, она пробегается взглядом по твоей одежде и вещам, затем смотрит тебе прямо в глаза; по её лицу скользит сардоническая улыбка, и она возвращается к созерцанию стен.~
@49454 = ~«Приветствую».~
@49455 = ~Пройти мимо.~
@49456 = ~Она возвращается взглядом к тебе и хмурится: «Ты всегда вот так пристаёшь к незнакомкам?»~
@49457 = ~«Только когда хочу кое-что спросить».~
@49458 = ~«Обычно нет, но я подумал, что неплохо было бы поговорить с тобой».~
@49459 = ~«Нет. Прощай».~
@49460 = ~«Какая у тебя интересная жизнь, наверное! К сожалению для тебя, я занята. Порадуй меня одиночеством».~
@49461 = ~«У меня всего-то пара вопросов…»~
@49462 = ~«Тогда я оставлю тебя. Прощай».~
@49463 = ~«Какое из двух слов во фразе „я занята“ тебе непонятно? Оставь… меня… в покое. Спасибо», — женщина уходит в себя, окончательно погружаясь в собственные мысли. Она закусывает нижнюю губу так, что появляются капельки крови.~
@49464 = ~«Тогда прощай».~
@49465 = ~Ты видишь высокую эффектную женщину. Она отсутствующим взглядом смотрит на стены таверны, медленно сжимая и разжимая кулаки. Когда женщина замечает тебя, она пробегается взглядом по твоей одежде и вещам, затем смотрит тебе прямо в глаза; по её лицу скользит сардоническая улыбка, и она возвращается к созерцанию стен. «Чего-то ищешь, здоровяк?» — интересуется она, не глядя на тебя.~
@49466 = ~«Я так понял, ты следующая, с кем я должен поговорить об этом ключе».~
@49467 = ~«У меня к тебе вопросы…»~
@49468 = ~«Не сейчас. Прощай».~
@49469 = ~«О ключе, м-м? — она выгибает бровь. — Хочешь знать, что тебе нужно ради него сделать, верно? Это довольно легко, друг. Интересует? Наверное, да, раз ты здесь. Готов ли ты слушать — вот в чём вопрос».~
@49470 = ~[нет текста]~
@49471 = ~«Скажи, что я должен сделать».~
@49472 = ~«Не сейчас. До свидания».~
@49473 = ~Китла поручила мне забрать завещания у двух человек: Крамплпанча и Кестера — или уладить спор между ними. В награду за выполнение задания она сообщит мне вторую часть ключа, который должен привести меня к дэву.~
@49474 = ~«Тут есть двое мужчин, их имена Крамплпанч и Кестер. Крамплпанч работает кузнецом, Кестер — винокур. Они оба должны мне *много* денег. Один из них при этом ещё должен другому, и оба не платят мне. У них спор о наследстве; забери у них завещания, тогда я смогу сторговаться с ними очень выгодно. Если не выйдет, помоги разрешить проблемы между ними — или убей их — и я сообщу тебе вторую часть ключа».~
@49475 = ~«У меня к тебе вопросы…»~
@49476 = ~«Я не буду этого делать».~
@49477 = ~«Обязательно. Прощай».~
@49478 = ~Она лукаво смотрит на тебя: «Может, мы поговорим, когда ты закончишь с этим маленьким поручением, м-м? Давай же, действуй». Она возвращается к выпивке.~
@49479 = ~«Тогда до свидания».~
@49480 = ~Она очаровательно улыбается: «Тогда ты не получишь ключ. Иди и действуй».~
@49481 = ~«До свидания».~
@49482 = ~«Вернулся, м-м? В конце концов выходит, что от тебя будет толк. Ты поможешь мне, я помогу тебе, и мы оба будем довольны».~
@49483 = ~«Что я должен сделать?»~
@49484 = ~«Может, позже. До свидания».~
@49485 = ~Китла поручила мне забрать завещания у двух человек: Крамплпанч и Кестера — или уладить спор между ними. В награду за выполнение задания она сообщит мне вторую часть ключа, который должен привести меня к дэву.~
@49486 = ~Её глаза сверкают в полумраке таверны: «У тебя есть что-нибудь для меня, израненный?»~
@49487 = ~«У меня тут оба их завещания».~
@49488 = ~«У меня только завещание Крамплпанча».~
@49489 = ~«У меня только завещание Кестера».~
@49490 = ~«Крамплпанч мёртв».~
@49491 = ~«Кестер мёртв».~
@49492 = ~«В самом деле? Отдай их мне, и я сообщу тебе вторую часть ключа».~
@49493 = ~«Держи».~
@49494 = ~«Я всё ещё пытаюсь сгладить углы. Дай мне шанс».~
@49495 = ~«Не сейчас. Прощай».~
@49496 = ~Она берёт их у тебя и недобро смеётся. «ТЕПЕРЬ посмотрим, как они скажут мне, что не имеют возможности платить, — она прячет завещания в сумку на поясе. — Готов принять вторую часть ключа?»~
@49497 = ~«Да. Говори».~
@49498 = ~«Позже. Сначала ответь на кое-какие вопросы».~
@49499 = ~«Ещё нет. Увидимся».~
@49500 = ~Она вздыхает: «Деньги, которые они должны, не вернутся быстрее от наших разговоров. Давай уже… разберись с проблемой».~
@49501 = ~«Ладно. До свидания».~
@49502 = ~На мгновение она сосредотачивается, и её голос становится глубже, когда она произносит: «„Здесь их Тюрьма, погружённая в кромешную тьму…“» Затем Китла прерывается и говорит обычным тоном: «Третья часть ключа у Набата. Он где-то здесь». Она роскошно зевает: «Я утомлена. Прими это и оставь меня на время. Я должна продумать следующий шаг. Прощай».~
@49503 = ~«Я лишь хотел задать пару вопросов…»~
@49504 = ~«Мне нужно поучиться магии».~
@49505 = ~Я получил от Китлы вторую часть ключа: «Здесь их Тюрьма, погружённая в кромешную тьму…» Теперь мне нужно поговорить с мужчиной по имени Набат.~
@49506 = ~«Подойди как-нибудь попозже. Сейчас у меня голова не тем занята…»~
@49507 = ~«Можешь потренировать меня в магии?»~
@49508 = ~Она вздыхает: «Слушай, сейчас я должна хорошенько обдумать свои следующие действия… позволь мне просто сообщить тебе ключ, и мы будем в расчёте, ладно?»~
@49509 = ~«Хорошо. Говори».~
@49510 = ~«Мне нужно поучиться магии».~
@49511 = ~«И ты намерен отдать его мне? — она протягивает руку. — Уж тогда Крамплпанч наверняка изыщет способ заплатить мне».~
@49512 = ~«Да, держи».~
@49513 = ~«Я всё ещё пытаюсь сгладить углы. Дай мне шанс».~
@49514 = ~«Не сейчас. До свидания».~
@49515 = ~«И ты намерен отдать его мне? — она протягивает руку. — Уж тогда Кестер наверняка изыщет способ заплатить мне».~
@49516 = ~«Да, держи».~
@49517 = ~«Я всё ещё пытаюсь сгладить углы. Дай мне шанс».~
@49518 = ~«Не сейчас. До свидания».~
@49519 = ~Она прячет завещание в сумку на поясе и злобно ухмыляется: «Ты хочешь вторую часть ключа сейчас?»~
@49520 = ~«Да, говори».~
@49521 = ~«Позже. Сначала ответь на кое-какие вопросы».~
@49522 = ~«Ещё нет. Увидимся».~
@49523 = ~Она вздыхает: «Спасибо, что решил эту проблему, но… знаешь, мне сейчас есть о чём подумать. Позволь мне просто сообщить тебе ключ, и мы будем в расчёте, ладно?»~
@49524 = ~«Хорошо. Говори».~
@49525 = ~«Может, позже. До свидания».~
@49526 = ~Действительно установить для ВСЕХ привязок клавиш значения по умолчанию?~
@49527 = ~[нет текста]~
@49528 = ~Металлическая плита~
@49529 = ~Тёмные Птицы Окантуса~
@49530 = ~Весельчак~
@49531 = ~Джолми~
@49532 = ~Привлекательная молодая женщина любезно улыбается: «Могу я чем-нибудь помочь вам, сэр?»~
@49533 = ~«Как мне попасть в одну из этих комнат?»~
@49534 = ~«Можно мне здесь отдохнуть?»~
@49535 = ~«Не сейчас. Прощай».~
@49536 = ~«Вы должны быть членом Общества Восприятия и утверждены Сплинтером, сэр. Он прямо на входе в Фестхолл, если вы захотите поговорить с ним».~
@49537 = ~«Могу я здесь хотя бы отдохнуть?»~
@49538 = ~«Тогда прощай».~
@49539 = ~«Общественный Фестхолл часто сдаёт неиспользуемые комнаты к вечеру; конечно, вы сможете отдохнуть, если найдутся свободные. Поискать для вас, сэр?»~
@49540 = ~«Да, пожалуйста».~
@49541 = ~Привлекательная молодая женщина любезно улыбается: «Приветствую, сэр». Она закрывает глаза и листает большой регистрационный журнал, останавливаясь — как тебе кажется — на случайной странице. Затем открывает глаза. «А… вот ключ от вашей комнаты… — она протягивает тебе маленький ключ. — Самая восточная комната долго ждала вашего возвращения. Хотите отдохнуть сейчас, сэр?»~
@49542 = ~«Да, было бы неплохо».~
@49543 = ~«Нет… но что значит „ждала моего возвращения“?»~
@49544 = ~«Не сейчас. Прощай».~
@49545 = ~Служащая смотрит на тебя с удивлением: «В моём журнале указано, что это ваш ключ, сэр. И он был вашим довольно давно. Если это не так, — возможно, я просто ошиблась. Хотите отдохнуть сейчас, сэр?»~
@49546 = ~«Да, было бы неплохо».~
@49547 = ~«Не сейчас. Прощай».~
@49548 = ~Привлекательная молодая женщина любезно улыбается: «Приветствую, сэр. Хотите отдохнуть сейчас?»~
@49549 = ~«Да, было бы неплохо».~
@49550 = ~«Не сейчас. Прощай».~
@49551 = ~Уйти.~
@49552 = ~Булава баатезу~
@49553 = ~Клерк Фестхолла~
@49554 = ~«Тогда я хотел бы спросить о другом…»~
@49555 = ~«В таком случае у меня больше нет вопросов».~
@49556 = ~«Ещё раз, как ты выжил на Кровавой Войне?»~
@49557 = ~«Ещё раз, как ты выжил на Кровавой Войне?»~
@49558 = ~«Ещё раз, как ты выжил на Кровавой Войне?»~
@49559 = ~«Ещё раз, как ты выжил на Кровавой Войне?»~
@49560 = ~«Но женщина по имени Вришика сказала мне, что ты должен был принести в жертву своих людей, чтобы сбежать с Войны».~
@49561 = ~Некачественная булава~
@49562 = ~Булава~
@49563 = ~БУЛАВА
Урон: 2-8 дробящий
Фактор скорости: 7
Вес: 12
Навык: булава
Доступно: воинам

Похоже, это стандартная вариация булавы. Если правильно использовать, то ей можно нанести противнику дробящие повреждения.~
@49564 = ~«Ещё раз, как ты выжил в Кровавой Войне?»~
@49565 = ~«Ещё раз, как ты выжил в Кровавой Войне?»~
@49566 = ~«Не бери в голову. У меня больше нет вопросов».~
@49567 = ~«Ставим! Вот моя ставка!»~
@49568 = ~«Ну же! Ты меня оскорбляешь, уважаемый!»~
@49569 = ~«Это предложение оскорбительно!»~
@49570 = ~«Это предложение оскорбляет меня и все мои последующие поколения!»~
@49571 = ~«Это нечто особенное!»~
@49572 = ~«Вы что, все онемели? Ну же: КАКОВА МОЯ СТАВКА?»~
@49573 = ~«100 монет?! Я сделаю вид, что не слышал этого!»~
@49574 = ~«За этот прекрасный предмет! Ты предлагаешь жалкие гроши! Это просто оскорбление, уважаемый!»~
@49575 = ~«Ты, уважаемый! Не будешь ли так любезен подойти?»~
@49576 = ~«Что я предлагаю?»~
@49577 = ~«Эй, ты, там! Похоже, тебе будет полезно…»~
@49578 = ~Тёмный проход тянется вглубь на несколько футов и внезапно заканчивается лицом из сплошного камня.~
@49579 = ~[нет текста]~
@49580 = ~Эта древняя машина выглядит как пережиток забытой войны.~
@49581 = ~Расположение этих зазубренных железных шипов напоминает паука.~
@49582 = ~Эти огромные часы остановились; на них не видно ничего, что могло бы управлять ими.~
@49583 = ~Эти многогранные шары, кажется, предназначены, чтобы улавливать и удерживать малейшие проблески света.~
@49584 = ~Эта полка заполнена черепами. Ты слишком далеко, чтобы рассмотреть её получше.~
@49585 = ~Эти массивные железные ворота приржавели друг к другу. Их невозможно открыть.~
@49586 = ~Это рахитичное строение выглядит так, как будто стояло сотни лет. Его деревянные стены испорчены погодой и возрастом. Несколько планок недавно были отломаны.~
@49587 = ~Эта полуразрушенная постройка на грани полного разрушения. Несколько досок были прибиты недавно, чтобы поддержать обваливающееся здание.~
@49588 = ~Похоже, дабус занимался ремонтом этого здания. Несколько новых, более крепких досок прибиты поверх старых. С помощью подходящего инструмента их можно было бы отодрать.~
@49589 = ~Уйти.~
@49590 = ~Использовать монтировку, чтобы убрать доски.~
@49591 = ~~
@49592 = ~~
@49593 = ~Одну за другой ты отрываешь свежие доски с фасада здания. Когда последняя доска убрана, здание издаёт громкий треск, как будто оставшийся без поддержки каркас уже не может выдержать его вес.~
@49594 = ~~
@49595 = ~~
@49596 = ~~
@49597 = ~Такое впечатление, что дабус пытался снести древнее здание. Несколько досок болтаются, держащие их гвозди почти до конца выдернуты.~
@49598 = ~Использовать кувалду, чтобы прибить гвозди на место.~
@49599 = ~Уйти.~
@49600 = ~Ты аккуратно прибиваешь гвозди на место. Шагнув назад, чтобы полюбоваться на свою работу, ты замечаешь, что здание, как ни странно, уже не выглядит таким старым, каким казалось на первый взгляд.~
@49601 = ~~
@49602 = ~Уйти.~
@49603 = ~Уйти.~
@49604 = ~~
@49605 = ~~
@49606 = ~~
@49607 = ~~
@49608 = ~~
@49609 = ~~
@49610 = ~~
@49611 = ~~
@49612 = ~~
@49613 = ~~
@49614 = ~~
@49615 = ~~
@49616 = ~~
@49617 = ~~
@49618 = ~~
@49619 = ~~
@49620 = ~~
@49621 = ~~
@49622 = ~~
@49623 = ~~
@49624 = ~~
@49625 = ~Языки пламени~
@49626 = ~Ищущие огни~
@49627 = ~Ужас Игнуса~
@49628 = ~Инфернальная сфера~
@49629 = ~Инфернальный щит~
@49630 = ~Огненный дождь~
@49631 = ~Удар стихий~
@49632 = ~Резчик~
@49633 = ~Стальное писание~
@49634 = ~Сокрытие воли~
@49635 = ~Глаз Вилкуара~
@49636 = ~Власть гнева~
@49637 = ~Сила одного~
@49638 = ~Баланс всего~
@49639 = ~Головорез из Нижнего района~
@49640 = ~Головорез из Нижнего района~
@49641 = ~Этот мужчина насвистывает весёлый мотивчик и поигрывает ухоженным боевым ножом. Когда ты приближаешься, он перестаёт свистеть и с любопытством на тебя смотрит: «Хм? Чего тебе надо?»~
@49642 = ~«У меня вопросы…»~
@49643 = ~«Ничего. Прощай».~
@49644 = ~Мужчина продолжает насвистывать весёлый мотивчик, вертя в руках зловеще выглядящий нож. Когда ты приближаешься, он прекращает свистеть и окидывает тебя скучающим взглядом: «Чего ещё, а?»~
@49645 = ~«У меня вопросы…»~
@49646 = ~«Ничего. Прощай».~
@49647 = ~«Меня звать Крысёныш, паря. Я наёмный вор на службе у Шергрейва, шефа всех Сборщиков в округе. Платит мне, чтоб я учил его ребят не светиться, да ещё вдарить кому, если проблемы. Вряд ли я тебе отвечу на другие вопросы, паря», — он фыркает и пожимает плечами.~
@49648 = ~«Наёмный вор? А меня сможешь потренировать?»~
@49649 = ~«Не знаешь, как пройти через тот забитый мусором проход к северо-западу отсюда?»~
@49650 = ~«Я ищу мужчину по имени Фарод. Не знаешь, где он?»~
@49651 = ~«И где этот парень Шергрейв?»~
@49652 = ~«Тогда прощай».~
@49653 = ~Мужчина по имени Крысёныш сказал, что если я хочу пройти в забитую мусором арку на Площади Мусорщиков, то мне нужно спросить об этом Кридена. По его словам, Криден должен быть где-то в Улье, рядом с управлением по контролю за паразитами и болезнями.~
@49654 = ~Он кивает на большой, обветшавший дом рядом. «Тока осторожно, паря. Не любит он чужаков. Никому не верит. Шергрейв даж не его настоящее имя… эт мы его так прозвали».~
@49655 = ~«Говоришь, ты наёмный вор? Можешь меня чему-нибудь научить?»~
@49656 = ~«Не знаешь, как пройти через тот забитый мусором проход к северо-западу отсюда?»~
@49657 = ~«Я ищу мужчину по имени Фарод. Не знаешь, где он?»~
@49658 = ~«Это всё, что я хотел узнать. Прощай».~
@49659 = ~Крысёныш трясёт головой. «Не-а, без понятия. Но слыхал, он где-т рядом. Кой-кого из его парней тут отлавливают иногда, лазят через какую-то дыру фиг знает где. Бьюсь об заклад, где-т возле тех торчащих помостов, но эт не моё дело, — он пожимает плечами и плюёт на землю. — Живи и дай жить другим, говорит Крысёныш».~
@49660 = ~«Говоришь, ты наёмный вор? Можешь меня чему-нибудь научить?»~
@49661 = ~«Не знаешь, как пройти через тот забитый мусором проход к северо-западу отсюда?»~
@49662 = ~«А где твой шеф… Шергрейв?»~
@49663 = ~«Тогда прощай».~
@49664 = ~«А? Не-а, не знаю. Слышь… можешь спросить Кридена, крысолова. Он там шарится иногда и непонятно куда девается. Криден обычно в Улье, прям перед управлением по контролю за паразитами и болезнями».~
@49665 = ~«Управлением по чему? Где это?»~
@49666 = ~«Говоришь, ты наёмный вор? Можешь меня чему-нибудь научить?»~
@49667 = ~«Я ищу мужчину по имени Фарод. Не знаешь, где он?»~
@49668 = ~«А где твой шеф… Шергрейв?»~
@49669 = ~«Спасибо. Прощай».~
@49670 = ~Крысёныш хмурится: «Возвращайся в Улей, паря. Спроси у проводника, если тебе надо».~
@49671 = ~«Говоришь, ты наёмный вор? Можешь меня чему-нибудь научить?»~
@49672 = ~«Я ищу мужчину по имени Фарод. Не знаешь, где он?»~
@49673 = ~«А где твой шеф… Шергрейв?»~
@49674 = ~«Тогда прощай».~
@49675 = ~«Без проблем, за чуток медяков. Тебя учили когда-нить?»~
@49676 = ~«Да».~
@49677 = ~«Нет».~
@49678 = ~«Прекрасно. Сейчас я отвешу затрещину, сможешь уклониться?» — внезапно он бьёт открытой ладонью по твоей голове.~
@49679 = ~Уклониться от удара.~
@49680 = ~Уклониться от удара.~
@49681 = ~Ты пытаешься увернуться, но рука Крысёныша успевает звонко шлёпнуть тебя по затылку. «Прости, паря, ты слишком неуклюж».~
@49682 = ~«Не знаешь, как пройти через тот забитый мусором проход к северо-западу отсюда?»~
@49683 = ~«Я ищу мужчину по имени Фарод. Не знаешь, где он?»~
@49684 = ~«Где твой шеф… Шергрейв?»~
@49685 = ~«Тогда прощай».~
@49686 = ~Ты избегаешь удара Крысёныша. «Нормально, паря. Теперь о медяках… пятьдесят монет, и я научу тебя прям щас».~
@49687 = ~«Звучит неплохо. Вот…»~
@49688 = ~«У меня столько нет…»~
@49689 = ~«Нет, спасибо».~
@49690 = ~Крысёныш равнодушно пожимает плечами.~
@49691 = ~«Не знаешь, как пройти через тот забитый мусором проход к северо-западу отсюда?»~
@49692 = ~«Я ищу мужчину по имени Фарод. Не знаешь, где он?»~
@49693 = ~«Где твой шеф… Шергрейв?»~
@49694 = ~«Тогда прощай».~
@49695 = ~«Ты ведь в курсе, что придётся прекратить все теперешние занятия, верно? Не можешь же ты быть бойцом или ещё кем *и* вором. Тебя эт устроит, паря?»~
@49696 = ~«Да».~
@49697 = ~«Нет, лучше откажусь. Я забираю деньги назад… прощай, Крысёныш».~
@49698 = ~«Ну, тада к делу. Я собираюсь научить тебя шести лучшим навыкам вора: красться и прятаться, вскрывать замки, резать карманы, искать и обезвреживать ловушки, и мой любимый: удар исподтишка».~
@49699 = ~«Продолжай…»~
@49700 = ~«Думаю, основы я понял, Крысёныш. Давай перейдём к тренировке».~
@49701 = ~«Прятаться в тенях и втихаря подкрадываться, эт, паря, очень сподручно. Лучше уж живой плут, чем мёртвый громила, ага? И не тока драчки избежать позволяет, если надо, можно *шустро* насадить кого-нить на перо… но об этом позже. Тока учти… ты не можешь спрятаться, када на тебя уже кто-нить смотрит».~
@49702 = ~«Продолжай…»~
@49703 = ~«Думаю, основы я понял, Крысёныш. Давай перейдём к тренировке».~
@49704 = ~«Срезать кошельки и замки взламывать — тоже занятие ничего себе… нехило приподняться можно. Тока будь готов драпать и всегда проверяй на ловушки у подозрительных замков. И не торопись с ловушками… порой время нужно, чтоб их углядеть».~
@49705 = ~«Продолжай…»~
@49706 = ~«Думаю, основы я понял, Крысёныш. Давай перейдём к тренировке».~
@49707 = ~«А если уж *нашёл* ловушку — приложи для обезвреживания этой дряни все умения. Эт как замок с секретом вскрывать, точно говорю».~
@49708 = ~«Продолжай…»~
@49709 = ~«Думаю, основы я понял, Крысёныш. Давай перейдём к тренировке».~
@49710 = ~«И последнее, чему я тебя обучу, — эт удар в спину, — Крысёныш с довольным видом переводит дыхание. — Если смог подкрастся к пидару и хочешь завалить, просто нападай на олуха сзади — он и не пикнет, как будет уже на пере».~
@49711 = ~«Всё понятно. Давай приступим к тренировке».~
@49712 = ~Крысёныш кивает: «Хорошо, паря… первое — это расслабон. Ты чересчур напряжён. Позволь взять верх инстинктам, доверься интуиции…» Так начинается твоё обучение воровскому ремеслу.~
@49713 = ~Усвоить всё, что получится.~
@49714 = ~Усвоить всё, что получится.~
@49715 = ~Усвоить всё, что получится.~
@49716 = ~Усвоить всё, что получится.~
@49717 = ~Я научился воровскому ремеслу у Крысёныша, которого встретил на Площади Мусорщиков.~
@49718 = ~После длительной тренировки Крысёныш явно удовлетворён: «Скажу я тебе, паря, ни в жисть не видал, чтоб прям на лету всё схватывали! Как будто ты и раньше всем этим занимался!»~
@49719 = ~«Может, и занимался, просто забыл. Спасибо, Крысёныш, и прощай».~
@49720 = ~После длительной тренировки Крысёныш явно удовлетворён: «Скажу я тебе, паря, ни в жисть не видал, чтоб прям на лету всё схватывали! Как будто ты и раньше всем этим занимался!» Пока он говорит, ты понимаешь, что *действительно* занимался этим раньше… и что когда-то уже обладал воровскими навыками, тренировка просто снова их пробудила.~
@49721 = ~«Может, и занимался, просто забыл. Спасибо, Крысёныш, и прощай».~
@49722 = ~После длительной тренировки Крысёныш явно удовлетворён: «Скажу я тебе, паря, ни в жисть не видал, чтоб прям на лету всё схватывали! Как будто ты и раньше всем этим занимался!» Пока он говорит, ты понимаешь, что *действительно* занимался этим раньше… и что когда-то уже обладал воровскими навыками.~
@49723 = ~«Может, и занимался, просто забыл. Спасибо, Крысёныш, и прощай».~
@49724 = ~В голове всплывают выцветшие воспоминания о прятках в тёмных коридорах и уклонении от смертельных ловушек, позволяя «научиться» большему, чем в состоянии преподать Крысёныш.~
@49725 = ~Уйти.~
@49726 = ~«Не знаю, чему я смогу тебя научить, если ты уже обучен, паря. Но если забросил воровство ради другой стези, — боёв там или магии — я могу переучить тебя шустро».~
@49727 = ~«Я опять хочу пойти в воры, Крысёныш».~
@49728 = ~«Ясно. Прощай, Крысёныш».~
@49729 = ~Крысёныш кивает: «Теперь про бабки, паря… пятьдесят медяков — и я тебя потренирую».~
@49730 = ~«Звучит неплохо. Вот…»~
@49731 = ~«У меня столько нет…»~
@49732 = ~«Нет, спасибо».~
@49733 = ~«Ты ведь в курсе, что придётся прекратить все теперешние занятия, верно? Не можешь же ты быть бойцом или ещё кем *и* вором. Тебя эт устроит, паря?»~
@49734 = ~«Да».~
@49735 = ~«Нет, лучше откажусь. Я забираю деньги назад… прощай, Крысёныш».~
@49736 = ~«Ты схватываешь прям на лету, паря, точно говорю, — минуту он с любопытством тебя разглядывает, затем пожимает плечами. — На этом всё; ты снова в деле».~
@49737 = ~«Спасибо, Крысёныш. Прощай».~
@49738 = ~Уйти.~
@49739 = ~Эта молодая женщина, следящая за представлением своего рода актёра, выглядит чем-то озадаченной. Когда ты подходишь, она поворачивает к тебе голову.~
@49740 = ~«Приветствую…»~
@49741 = ~Оставить женщину в покое.~
@49742 = ~«Никогда раньше ничего подобного не видела. Я нахожу это раздражающим, но в то же время интересным».~
@49743 = ~«А что происходит?»~
@49744 = ~«Неважно. У меня кое-какие вопросы…»~
@49745 = ~Уйти.~
@49746 = ~Она продолжает разглядывать мужчину, который кажется пойманным в невидимый ящик или клетку. «В другой раз, сэр. Пожалуйста, пока оставьте меня».~
@49747 = ~«Погоди… хотя бы скажи, что здесь происходит?»~
@49748 = ~«Всего лишь пара вопросов…»~
@49749 = ~Уйти.~
@49750 = ~Женщина бросает на тебя раздражённый взгляд: «Несмотря на то, что *вы* могли себе напридумывать, сэр, я не хочу подвергаться на улице расспросам незнакомцев. Теперь оставьте меня!»~
@49751 = ~«Погоди… хотя бы скажи, что здесь происходит?»~
@49752 = ~Уйти.~
@49753 = ~«Я не уверена, что сама понимаю. Представления этого человека включали в себя все виды подражания и физической комедии, но он никогда не говорил ни слова. Чуть раньше здесь проходил маг, артист спародировал его необычную походку… и разгневанный маг проклял его. Думаю, мим не может больше говорить, а невидимый ящик, заключение в котором он раньше изображал, кажется, стал реальным. Сначала он был очень напуган, но теперь успокоился и просто продолжает представление».~
@49754 = ~«Я хочу спросить о другом…»~
@49755 = ~«Это всё, что я хотел узнать. Прощай».~
@49756 = ~Этот джентльмен с удивлённым выражением на лице пристально следит за выступлением своего рода актёра.~
@49757 = ~«Приветствую…»~
@49758 = ~Оставить мужчину в покое.~
@49759 = ~Мужчина поворачивается к тебе, но актёр по-прежнему приковывает к себе его внимание: «Странно, не правда ли? Бедный малый».~
@49760 = ~«А что происходит?»~
@49761 = ~«Неважно. У меня кое-какие вопросы…»~
@49762 = ~Уйти.~
@49763 = ~Он продолжает глазеть на безмолвного актёра во всём чёрном и трясёт в ответ головой: «Не сейчас, сэр, прошу вас. Прощайте».~
@49764 = ~«Погоди… хотя бы скажи, что здесь происходит?»~
@49765 = ~«Всего лишь пара вопросов…»~
@49766 = ~Уйти.~
@49767 = ~«В самом деле, сэр, уходите. Я уверен, у вас и кроме меня найдётся с кем поговорить. Дайте мне спокойно посмотреть, хорошо? Прощайте».~
@49768 = ~«Погоди… хотя бы скажи, что здесь происходит?»~
@49769 = ~Уйти.~
@49770 = ~«Ну, видите ли… это уличный актёр. Его представление состоит из различных мимических перевоплощений: он изображает невидимую верёвку, заключение в невидимый ящик и тех, кто проходит мимо. Он умудрился передразнить необычную походку проходящего мага и сейчас, похоже, проклят: мим *действительно* заключён в невидимом ящике и не может говорить. Иронично, правда?»~
@49771 = ~«Да, немного. У меня кое-какие вопросы…»~
@49772 = ~«Действительно странно. Прощай».~
@49773 = ~Лицо этого мужчины выкрашено в белый цвет. На лбу нарисована пара выгнутых бровей, красная пудра лежит двумя кругами на щеках и подчёркивает губы. Он что-то говорит, но ты ничего не слышишь. Его руки прижаты к тому, что кажется невидимой стеной.~
@49774 = ~«Что? Я тебя не слышу…»~
@49775 = ~Проверить, сможешь ли ты дотронуться до него.~
@49776 = ~Уйти.~
@49777 = ~Он вешает голову, беззвучно вздыхает и пожимает плечами. Затем немного отступает назад, машет тебе на прощание и начинает изображать разные действия… тянуть верёвку, спускаться по ступенькам и так далее.~
@49778 = ~Проверить, сможешь ли ты дотронуться до него.~
@49779 = ~Уйти.~
@49780 = ~Ты протягиваешь руку, чтобы дотронуться до мужчины, но её останавливает невидимая сила. Мим кажется пойманным в невидимый ящик или клетку.~
@49781 = ~Уйти.~
@49782 = ~Падшая Грейс пристально смотрит на человека. «Кажется, я слышала об этом виде представлений. Он популярен в некоторых Первичных мирах… — она понижает голос так, что только ты можешь её слышать, — …и широко ненавидим во многих из них».~
@49783 = ~Проверить, сможешь ли ты дотронуться до него.~
@49784 = ~Уйти.~
@49785 = ~Надпись вокруг пьедестала этого камня чувств сообщает, что он содержит переживание «Неделя звериной охоты в лесах Арбореи».~
@49786 = ~Начать переживание.~
@49787 = ~Уйти.~
@49788 = ~Ты стоишь в круге белых палаток где-то глубоко в лесах. Деревья вокруг тебя — самые огромные из всех, что ты когда-либо видел. Внезапно у тебя возникает странное покалывающее ощущение в затылке…~
@49789 = ~Продолжить переживание.~
@49790 = ~Прервать переживание и уйти.~
@49791 = ~Ты стараешься прекратить переживание изо всех сил и понимаешь, что не можешь. Оно продолжается без спроса и ещё глубже увлекает тебя в чужую память…~
@49792 = ~Окружающее сливается в бесцветное пятно, затем медленно преображается в нечто похожее на внутренность большой серой сферы. Напротив тебя стоит фигура, почти идентичная твоей собственной. Его глаза вспыхивают в полутьме, безумная улыбка искажает черты: «Я ЗНАЛ, что ты придёшь…»~
@49793 = ~«Приветствую…»~
@49794 = ~«Кто ты?»~
@49795 = ~«О, „приветствую-приветствую, так рад тебя видеть“, — он ухмыляется. — Я просил бы тебя держать свой КРОВАВЫЙ язык за зубами! Вот уж правда: кровавый. Твоя притворная невинность выглядит СМЕХОТВОРНОЙ!»~
@49796 = ~«Кто ты?»~
@49797 = ~«О, ты не ЗНАЕШЬ? Разве все эти ГРЯЗНЫЕ, ЛЖИВЫЕ, ТРИЖДЫ ПРОКЛЯТЫЕ ДНЕВНИКИ не сказали тебе, кто я? Дневники, которые были так кстати „забыты“ рядом со мной, когда я очнулся… эти дневники, называвшие меня ИНКАРНАЦИЕЙ! Ха! Сжёг их ВСЕ! Да, все, что НАШЁЛ…»~
@49798 = ~«И что именно в них было написано?»~
@49799 = ~«Итак… ты одна из моих предыдущих инкарнаций?»~
@49800 = ~«В них была ЛОЖЬ, ЛОЖЬ, ЛОЖЬ и ничего больше! Грязное враньё о человеке, который забыл сам себя, свои предыдущие инкарнации, о том, что эти дневники сохраняют его воспоминания для будущих жизней… ВОРЫ! Это МОЯ жизнь. МОЯ! ВЫ ВСЕ ХОТИТЕ УКРАСТЬ МОЁ ТЕЛО, НО ВЫ ЕГО НЕ ПОЛУЧИТЕ!»~
@49801 = ~«Итак… ты одна из моих предыдущих инкарнаций?»~
@49802 = ~«Где я?»~
@49803 = ~Он скрещивает руки на груди, отводит взгляд: «Если ты видишь СМЫСЛ в такой ЧУШИ, то да».~
@49804 = ~«И о чём же говорилось в этих „лживых“ дневниках?»~
@49805 = ~«О, ЭТО? — он показывает вокруг себя, хихикая. — Просто маленькая ЛОВУШКА, это всё. Я понимал, что УБИВАТЬ вас, ПОХИТИТЕЛЕЙ ТЕЛ, может быть недостаточно… Я должен был ПОЙМАТЬ тебя, ЗАКЛЮЧИТЬ тебя навечно. Наверное, ты уже понял, что из этого камня чувств нет выхода… твоё сознание заперто здесь. Ты увидишь, какое РЕДКОЕ окружение я приготовил для тебя… всё для того, чтобы БЕЗУМИЕ захватило тебя прочно и БЫСТРО, пока твоя плоть гниёт». Он злобно хихикает.~
@49806 = ~«Тогда у меня кое-какие вопросы…»~
@49807 = ~Попытаться прекратить переживание.~
@49808 = ~Ты пытаешься выйти из переживания, но ничего не выходит. Твоя ранняя инкарнация заливается ещё более язвительным смехом: «Сдавайся! Ты НИКОГДА не выберешься! С тем же успехом можешь лечь на пол и ждать, пока не распадёшься в НИЧТО. Только я могу освободить тебя, а я этого не сделаю».~
@49809 = ~«Подожди… но *я* — это ты. Значит, я могу освободить себя *сам*…»~
@49810 = ~«Тогда у меня к тебе кое-какие вопросы…»~
@49811 = ~Твоя предыдущая инкарнация скрещивает руки на груди и возмущённо отворачивается. Кроме нескольких дополнительных прядей волос на голове, он ничем не отличается от тебя — даже на руках в основном те же татуировки.~
@49812 = ~«Это ты создал тот додекаэдр с ловушками?»~
@49813 = ~«Как ты создал эту ловушку?»~
@49814 = ~«Эти татуировки сделал ты?»~
@49815 = ~Попытаться прекратить переживание.~
@49816 = ~«Не знаю, что ты там бормочешь. Хе. Хе-хе. Ну ладно, это БЫЛ я. БЛЕСТЯЩЕ, не правда ли? Ты ПОИГРАЛ с ним немного? Потерял ПАЛЕЦ или ГЛАЗ, я надеюсь?» — он весело хихикает.~
@49817 = ~«Умно, но я всё-таки открыл и прочитал эту штуку».~
@49818 = ~«Как ты создал эту ловушку?»~
@49819 = ~«Эти татуировки сделал ты?»~
@49820 = ~Попытаться прекратить переживание.~
@49821 = ~Твоя инкарнация, похоже, в ужасе: «НЕТ! НЕТ! НЕТ! НЕВОЗМОЖНО! Никто не смог бы прочитать язык, на котором он написан; я лично свернул шею ЕДИНСТВЕННОМУ человеку, который понимал его, после того, как он НАУЧИЛ меня. МЁРТВЫЙ язык, МЁРТВЫЙ лингвист… подходящая парочка в залах смерти».~
@49822 = ~Ложь: «Я прочитал его, потому что я — это *ты*. Я не из фальшивых „я“, ты поймал здесь себя самого. Я поймал сам себя. Разве не видишь?»~
@49823 = ~«Как ты создал эту ловушку?»~
@49824 = ~«Эти татуировки сделал ты?»~
@49825 = ~Попытаться прекратить переживание.~
@49826 = ~«Но… это не… ты один из… я думал, что соблюдал ПРЕДОСТОРОЖНОСТИ! Как мог ТЫ… Я… быть таким ГЛУПЫМ! — он заламывает руки, кусая нижнюю губу. — Как ВЫЙТИ? КАК? Я забыл… подожди: „Только я могу освободить тебя, а я этого не сделаю“. Если ты это я, то ты МОЖЕШЬ освободить себя…»~
@49827 = ~Попытаться освободиться, «пожелав», чтобы ловушка открылась.~
@49828 = ~«Нет! Нет… не может быть… СТОЙ!»~
@49829 = ~Попытаться освободиться, «пожелав», чтобы ловушка открылась.~
@49830 = ~«Не могу тебе сказать… она НЕПОВТОРИМА, магия, использованная в ней, УТЕРЯНА, даже для меня. Однако это УМНО… одно переживание СКРЫТО под другим так, что ничья ПЛОТЬ, кроме МОЕЙ, не заставит ловушку сработать…»~
@49831 = ~«Но… если твоя плоть заставляет её сработать, не значит ли это, что я — это *ты*? Ты поймал себя. *Я* поймал себя. Понимаешь?»~
@49832 = ~«Так на самом деле в камне два переживания?»~
@49833 = ~«А додекаэдр с ловушками тоже ты создал?»~
@49834 = ~«Эти татуировки сделал ты?»~
@49835 = ~Попытаться прекратить переживание.~
@49836 = ~«Да, тут арборейская охота и вот эта ЛОВУШКА, — твои слова его вдруг чем-то настораживают. — А ЧТО?»~
@49837 = ~Попытаться пробиться в другое переживание с помощью исключительной силы воли.~
@49838 = ~Попытаться пробиться в другое переживание с помощью исключительной силы воли.~
@49839 = ~«Что… что ты ДЕЛАЕШЬ? ПРЕКРАТИ!»~
@49840 = ~Продолжить пробиваться в другое переживание.~
@49841 = ~В конце концов ты выталкиваешь себя во «внешнее» переживание — арборейскую охоту — и прекращаешь его до того, как тебя затягивает обратно в ловушку.~
@49842 = ~Уйти.~
@49843 = ~«Нет! — он выглядит крайне расстроенным. — Их делала только одна инкарнация, „ПРАКТИЧНАЯ“. Я пытался выжечь их, но кожа ВОССТАНАВЛИВАЕТСЯ, и татуировки вместе с ней! Я пытался ВЫРЕЗАТЬ их, вытравить КИСЛОТОЙ… НЕНАВИЖУ их…»~
@49844 = ~«Но… зачем?»~
@49845 = ~Прочитать татуировки.~
@49846 = ~«Это ты создал тот додекаэдр с ловушками?»~
@49847 = ~«Как ты создал эту ловушку?»~
@49848 = ~Попытаться прекратить переживание.~
@49849 = ~Его глаза неприятно вспыхивают: «Это сводит меня с ума — чувствовать на себе ГЛАЗА, читающие твоё ТЕЛО, как КНИГУ…»~
@49850 = ~Прочитать татуировки.~
@49851 = ~«Это ты создал тот додекаэдр с ловушками?»~
@49852 = ~«Как ты создал эту ловушку?»~
@49853 = ~Попытаться прекратить переживание.~
@49854 = ~Его глаза становятся безумными: «Прекрати! ПРЕКРАТИ МЕНЯ ЧИТАТЬ!» Он пытается прикрыть себя руками, отвернувшись от тебя.~
@49855 = ~Продолжить чтение.~
@49856 = ~«Ладно. Это ты создал додекаэдр с ловушками?»~
@49857 = ~«Хорошо. Как ты сделал эту ловушку?»~
@49858 = ~Попытаться прекратить переживание.~
@49859 = ~Глаза фигуры становятся ещё безумнее: «ПРЕКРАТИ! Прекрати НЕМЕДЛЕННО! Я тебя предупреждаю!» Он отворачивается, съёживается, прикрывая большую часть своего тела. Ты видишь на его спине список татуированных предупреждений, который Морте когда-то прочитал тебе в Мортуарии. Однако там есть одна строка, которую Морте не стал читать вслух: «НЕ ДОВЕРЯЙ ЧЕРЕПУ». Бешенство твоего предыдущего воплощения растёт всё больше и больше, пока ты продолжаешь на него глазеть: «ПРЕДУПРЕЖДАЮ тебя в ПОСЛЕДНИЙ РАЗ! ПРЕКРАТИ!»~
@49860 = ~«Тебе меня не испугать… ты лишь запись памяти, видение. Я просто продолжу читать, пока ты не выпустишь меня отсюда».~
@49861 = ~«Ладно. Это ты создал додекаэдр с ловушками?»~
@49862 = ~«Хорошо. Как ты сделал эту ловушку?»~
@49863 = ~Попытаться прекратить переживание.~
@49864 = ~Он воет как сумасшедший, дико трясясь, раздирая себе руки и исходя пеной: «ВОН! ВОН! ВОН! ВОН! ВОН! ВОН! ВОН!» И внезапно всё *кончается*… ты опять стоишь в сенсориуме, слегка обалдевший, но невредимый.~
@49865 = ~Уйти.~
@49866 = ~Надпись вокруг пьедестала этого камня чувств сообщает, что он содержит переживание «Неделя звериной охоты в лесах Арбореи». Однако, если ты дотронешься до него, тебя снова затянет в ловушку безумной прежней инкарнации.~
@49867 = ~Оставить камень в покое.~
@49868 = ~«Пройди через среднюю дверь в восточной стене, а также через дверь за ней. Затем прямо по коридору до второй двери с северной стороны».~
@49869 = ~«Я хочу спросить о другом…»~
@49870 = ~«Это всё, что я хотел узнать. Прощай».~
@49871 = ~«Пройди через самую южную дверь в восточной стене».~
@49872 = ~«Я хочу спросить о другом…»~
@49873 = ~«Это всё, что я хотел узнать. Прощай».~
@49874 = ~«Пройди через среднюю дверь в восточной стене, а также через дверь за ней. Затем прямо по коридору до первой двери с северной стороны».~
@49875 = ~«Я хочу спросить о другом…»~
@49876 = ~«Это всё, что я хотел узнать. Прощай».~
@49877 = ~«Эй! Что ты делаешь в моей палатке?!»~
@49878 = ~«Приветствую…»~
@49879 = ~«Я ищу палатку Раука. Не знаешь, где она?»~
@49880 = ~«Моя ошибка. Прощай».~
@49881 = ~«Прокляни тебя Госпожа! Всеми планами, чего тебе ещё надо?!»~
@49882 = ~«Приветствую…»~
@49883 = ~«Я ищу палатку Раука. Не знаешь, где она?»~
@49884 = ~«Я ухожу. Прощай».~
@49885 = ~«Ага, ты друг Раука и я друг Раука. И что? Это не значит, что мне упёрлось с тобой разговаривать».~
@49886 = ~«Тогда прощай».~
@49887 = ~«Ты врываешься в мою палатку и всё, что можешь сказать, это „приветствую“?! Брысь отсюда, пень!»~
@49888 = ~«Прощай».~
@49889 = ~«Ё-моё! Ещё один „друг“ Раука? Да, тут одна из палаток, которые он считает домом. Как видишь, эта переполнена. Иди-ка ты в другую его палатку».~
@49890 = ~«Прощай».~
@49891 = ~Кажется, ты её напугал. Она внезапно перестаёт рыться в палатке и нервно глазеет на тебя.~
@49892 = ~«Приветствую…»~
@49893 = ~«Прощай».~
@49894 = ~«Я ничего не делала! Клянусь!»~
@49895 = ~«Расскажи-ка мне, чего именно ты не делала?»~
@49896 = ~«Мне без разницы, что ты делала. Прощай».~
@49897 = ~Она смотрит на тебя, будто хочет что-то сказать, а потом быстро шмыгает к двери.~
@49898 = ~«Стой…»~
@49899 = ~СТЕКЛЯННЫЙ ГЛАЗ
Вес: 0

Этот стеклянный глаз — не слишком хорошая замена настоящему.~
@49900 = ~Ты видишь молодого человека, одетого просто, но аккуратно. При твоём приближении он перестаёт расхаживать.~
@49901 = ~«Приветствую…»~
@49902 = ~«Неважно. Прощай».~
@49903 = ~«Ты принёс? Да?»~
@49904 = ~«У меня все кольца. Вот».~
@49905 = ~«Вернусь, когда найду их все. Прощай».~
@49906 = ~«Ты друг. Помог Рауку. Хорошо».~
@49907 = ~«Прощай».~
@49908 = ~«Раук потерял друзей. Но у Раука новый друг. Зову его Зелёной Штукой».~
@49909 = ~«Прощай».~
@49910 = ~«Раук в беде, большой. Помочь ты можешь?»~
@49911 = ~«Что не так?»~
@49912 = ~«У меня нет времени. Прощай».~
@49913 = ~«Раук забыл кольца в палатке. Друзьям нужны для магии. Без колец разозлятся на Раука. Одно кольцо бурое, как медяк. Другое блестящее, как зеркало. Последнее красивое и жёлтое. Принесёшь Рауку?»~
@49914 = ~«Я принесу их тебе, Раук».~
@49915 = ~«Забудь. Прощай».~
@49916 = ~Раук попросил принести три кольца, якобы забыл их в своей палатке. Насколько можно было понять из его описания, первое кольцо сделано из золота, второе — из серебра, а третье — из бронзы. Осталось только найти его палатку. Раук показался приятелем недалёким, так что и палатка вряд ли далеко.~
@49917 = ~«Ты теперь новый друг Рауку. Раук теперь имеет кольца. Раук благодарит новых друзей».~
@49918 = ~«Прощай, Раук».~
@49919 = ~Я вернулся с тремя кольцами и отдал их Рауку. Простая задача для простого человека.~
@49920 = ~Этот мужчина выглядит как въедливый придирчивый старый чудак. Его рот искривлён в недовольной гримасе, которая становится ещё гаже, когда он видит твоё приближение. «Моё имя Весельчак, но я вовсе не такой уж весёлый! Убирайся, юнец! Нет времени для таких, как ты!» — он даже срывается на кашель, так громко пытается тебя прогнать.~
@49921 = ~«Подожди… меня просила поговорить с тобой Долора».~
@49922 = ~«Хорошо… прощай».~
@49923 = ~Весельчак бросает на тебя угрюмый, испепеляющий взгляд. «Уходи», — шипит он.~
@49924 = ~«Подожди… меня просила поговорить с тобой Долора».~
@49925 = ~«Хорошо… прощай».~
@49926 = ~Весельчак смотрит на тебя подозрительно: «Вот как? О *чём*, а? Хм? Ну?»~
@49927 = ~«Она сказала, что ты её первая любовь, и пока у тебя ключи от её сердца, она не сможет полюбить другого».~
@49928 = ~«Забудь. Прощай».~
@49929 = ~«Так и сказала, а? Я удивлён. Наверное, попечение мадам Грейс сделало то, чего не смог я… разбудило её чувства. В любом случае… — он роется в карманах своей туники, — …так просто я ключи тебе не *отдам*».~
@49930 = ~«Подожди, так это буквально „ключи от её сердца“?»~
@49931 = ~«В таком случае что ты за них хочешь?»~
@49932 = ~«Тогда, возможно, я просто *заберу* их у тебя…»~
@49933 = ~«Поговорим позже. Прощай».~
@49934 = ~«Единственный способ *забрать* мои ключи, юнец, — это вырвать их из моих холодных мёртвых пальцев! А я не уверен в мудрости того, кто начнёт драку в Фестхолле…»~
@49935 = ~Напасть на него.~
@49936 = ~«Приму во внимание. Так это буквально „ключи от её сердца“?»~
@49937 = ~«Ну ладно. Что ты за них хочешь, Весельчак?»~
@49938 = ~«В таком случае прощай».~
@49939 = ~Он кивает. «Так и есть. Долора — конструкт, разве ты не знал? Создание из колдовства и часовых механизмов и лучшее из моих творений, — Весельчак вздыхает. — Но холодное, без эмоций и без характера. Я доставил её в Бордель и „настроил“ так, чтобы она не могла уйти, в надежде, что постоянный контакт с множеством других разовьёт её собственную личность. Ключи — это инструмент для её „настройки“, полагаю, они ей нужны, поскольку она сейчас чувствует, как они ограничивают её персональный рост».~
@49940 = ~«Тогда почему бы просто не вернуть их ей?»~
@49941 = ~«Что ты хочешь за ключи?»~
@49942 = ~«Возможно, я просто *заберу* их у тебя…»~
@49943 = ~«Это всё, что я хотел узнать. Прощай».~
@49944 = ~Весельчак хмурится: «Потому что я стал жестоким и циничным стариком, который ищет для себя выгоды».~
@49945 = ~«Тогда продолжай… чего ты хочешь?»~
@49946 = ~«Не получишь, если я просто заберу ключи, Весельчак…»~
@49947 = ~«Обсудим это позже. Прощай».~
@49948 = ~«Я хочу… я хочу забыть. Я прожил почти сто пятьдесят лет и видел в этом огромном зале все камни чувств, какие хотел. У меня осталось мало времени, и я слишком слаб, чтобы выйти отсюда за новыми переживаниями… так что мне нужно найти способ все их забыть. Таким образом я смогу начать всё сначала в мои последние дни…»~
@49949 = ~«Так… может, просто хорошенько треснуть тебя по затылку, или как?»~
@49950 = ~«Как я могу тебе помочь?»~
@49951 = ~«Я подумаю об этом. Прощай».~
@49952 = ~Весельчак хочет, чтобы я помог ему потерять все воспоминания, и тогда он даст мне ключи к сердцу Долоры. Думаю, я должен найти что-то с таким эффектом и принести ему… Весельчак предложил, как вариант, воду из реки Стикс.~
@49953 = ~«Нет, кровожадный увалень!»~
@49954 = ~«Мне нужно что-нибудь… предмет, состав… который позволит мне забыть. Как воды реки Стикс, что-то вроде того».~
@49955 = ~«Вот, возьми эту кружку… в ней Тёмная Птица Окантуса, осколок льда из реки Стикс. Он сотрёт твою память начисто…»~
@49956 = ~«Хорошо. Я вернусь, если что-нибудь найду… прощай».~
@49957 = ~Весельчак косится на тебя: «Ну? Принёс мне что-нибудь, что очистит мой разум от этих — чтоб им пусто было — воспоминаний? Я искренне надеюсь, что ты вернулся не с пустыми руками… иначе ты никогда не получишь ключи от сердца Долоры».~
@49958 = ~«Вот, возьми эту кружку… в ней Тёмная Птица Окантуса, осколок льда из реки Стикс. Он сотрёт твою память начисто…»~
@49959 = ~«Возможно, я просто заберу у тебя ключи, Весельчак…»~
@49960 = ~«Нет, не принёс. Прощай».~
@49961 = ~Весельчак берёт кружку и вынимает из кармана клочок бумаги. Он опрокидывает кружку и вытряхивает лёд в рот… лёд немедленно испаряется, оставляя старика с несколько испуганным лицом…~
@49962 = ~«Весельчак?..»~
@49963 = ~«Весельчак?..»~
@49964 = ~Весельчак огорошенно смотрит на тебя, затем переводит взгляд на бумагу в своей руке. Он читает вслух: «Поздравляю, Весельчак: ты можешь начинать сначала. Поблагодари мужчину напротив тебя и дай ему ключ из своего кармана. Поговори со Сплинтером — мужчиной в дверях здания — для получения дополнительной информации». Он опять смотрит на тебя: «Ну… похоже, я должен вас поблагодарить, добрый сэр. Вот… возьмите этот ключ. Я лучше поищу этого, как его, Сплинтера, и выясню, что здесь происходит!»~
@49965 = ~«Спасибо, Весельчак. Удачи».~
@49966 = ~Весельчак огорошенно смотрит на тебя, затем переводит взгляд на бумагу в своей руке. Он читает вслух: «Поздравляю, Весельчак: ты можешь начинать сначала. Поблагодари мужчину напротив тебя и дай ему ключ из своего кармана. Поговори со Сплинтером — мужчиной в дверях здания — для получения дополнительной информации». Он опять смотрит на тебя: «Ну… похоже, я должен вас поблагодарить, добрый сэр. Хм-м… кажется, при мне нет ключа. Наверное, кто-то его у меня взял. Так жаль! Ну, я лучше поищу этого, как его, Сплинтера, и выясню, что здесь происходит!»~
@49967 = ~«Удачи, Весельчак. Прощай».~
@49968 = ~Эта красивая, соблазнительно одетая проститутка — не чета тем, которых ты видел в Улье. От неё пахнет дорогими духами, а черты её лица лишь чуть-чуть подчёркнуты лёгкими мазками мягких, тёплых цветов. Когда ты подходишь к ней, она улыбается и делает грациозный реверанс: «Приветствую, добрый сэр. Я надеюсь, вы хотите утолить свою страсть, неудовлетворённую борделем мадам Грейс?»~
@49969 = ~~
@49970 = ~~
@49971 = ~~
@49972 = ~Она кладёт палец на твои губы, чтобы ты замолчал: «Я отвечу только на один вопрос, и ответ будет таков: да, сэр, всего лишь за пятьсот монет».~
@49973 = ~«Пятьсот? Слишком много…»~
@49974 = ~~
@49975 = ~«Какая жалость. Пожалуйста, возвращайтесь, если передумаете, дорогой сэр. Я буду с нетерпением ждать вас. Прощайте».~
@49976 = ~Уйти.~
@49977 = ~Она улыбается: «О, я уверяю вас, дорогой сэр…» Она наклоняется ближе и горячо шепчет тебе в ухо: «Вы не пожалеете ни об одной монетке».~
@49978 = ~«Звучит неплохо. Ну, пошли».~
@49979 = ~~
@49980 = ~~
@49981 = ~Финам раздражённо вздыхает: «Я не знаю точно, где они сейчас. И в настоящее время ищу кое-что другое — мой дневник исследований. Может быть, когда я найду его, я смогу уделить время поискам этих записей».~
@49982 = ~«Это, случайно, не то, что ты ищешь?»~
@49983 = ~«Это, случайно, не то, что ты ищешь?»~
@49984 = ~«Я поищу его для тебя. Где ты видел его в последний раз?»~
@49985 = ~«Ты сказал, что твой отец был убит?»~
@49986 = ~«Это ужасно. Прощай, Финам».~
@49987 = ~Я вернул лингвисту Финаму его дневник исследований.~
@49988 = ~Я согласился найти и вернуть лингвисту Финаму его дневник исследований… по возвращении, я надеюсь, он отдаст мне заметки его отца о таинственном языке, на которым написан текст в додекаэдре. Похоже, он забыл свой дневник где-то в Борделе Безумной Интеллектуальной Страсти.~
@49989 = ~Финам поднимает брови. «Да это же он и есть! — он берёт его у тебя, затем начинает рыться в карманах. — Вот, пожалуйста… записки моего отца. В расчёте, верно? Хорошо. А сейчас мне необходимо просмотреть свои записи, так что вынужден откланяться…»~
@49990 = ~«Спасибо, Финам. Прощай».~
@49991 = ~Уйти.~
@49992 = ~Финам поднимает брови. «Вот, это он и есть!» Он берет его у тебя, затем начинает рыться в карманах. «Хм-м… странно, они исчезли. Прости, но похоже кто-то спер записки моего отца. Ах, черт… жалко. Мне бы сейчас просмотреть дневник, так что я вынужден откланяться…»~
@49993 = ~«Не волнуйся об этом. Прощай».~
@49994 = ~Уйти.~
@49995 = ~«Э… ну… я не уверен. Он может быть в… ну, возможно, он каким-то образом может лежать в Борделе Безумной Интеллектуальной Страсти, хотя как он туда может попасть — я не знаю». Он покашливает, глядя в сторону.~
@49996 = ~«В таком случае я поищу там. Прощай».~
@49997 = ~«Я поищу там. Ты сказал, что твоего отца убили?»~
@49998 = ~Финам прерывает свои поиски и смотрит на тебя: «Может, вам удалось найти мой дневник?»~
@49999 = ~«Это, случайно, не то, что ты ищешь?»~
@50000 = ~«Это, случайно, не то, что ты ищешь?»~
@50001 = ~«Нет. Повтори, куда ты его брал с собой в последний раз?»~
@50002 = ~«Нет… но что ты там говорил об убийстве твоего отца?»~
@50003 = ~«Ещё нет. Прощай».~
@50004 = ~Финам бросает в твою сторону слегка раздражённый взгляд: «Я должен просмотреть свои заметки, так что вынужден откланяться…»~
@50005 = ~«Только один вопрос. Ты сказал, что твоего отца убили?»~
@50006 = ~«Тогда прощай».~
@50007 = ~Могила~
@50008 = ~«Если ты ухитришься прожить достаточно долго, чтобы найти ключ, то дверь в комнате на юго-востоке. Я буду наблюдать из теней. Если сможешь открыть дверь и добраться до аллеи целым, я буду прямо позади тебя».~
@50009 = ~«Тогда прощай».~
@50010 = ~«Должна тебе сказать, здоровяк… впечатляет. Я была уверена, что эти зверюги сжуют тебя и не поморщатся. Ну, думаю, надо сказать тебе спасибо, — на мгновение она замолкает, затем достаёт из кошелька маленький зелёный камушек. — Вот… он был у одного из Псов. Увидимся, здоровяк».~
@50011 = ~«Счастливо, Сибил».~
@50012 = ~~
@50013 = ~Вопрос насчёт переменной Джима. Ты знаешь, установлен ли там нуль?~
@50014 = ~Простите, но я всего лишь тестовый персонаж, поэтому не могу знать ответа на вопрос такого плана. Но теперь мне и самому любопытно, нуль установлен?~
@50015 = ~Установлен нуль.~
@50016 = ~Установлено НЕНУЛЕВОЕ значение.~
@50017 = ~Установлен нуль, и я оценю, если вы сделаете её не нулём.~
@50018 = ~Сейчас НЕ НУЛЬ, но мне нужно сбросить на нуль.~
@50019 = ~~
@50020 = ~~
@50021 = ~~
@50022 = ~~
@50023 = ~~
@50024 = ~~
@50025 = ~~
@50026 = ~Небольшое жилище~
@50027 = ~Ты видишь рыжеволосую женщину, маленькую и пухлую. Её лицо сплошь покрыто морщинами от забот, тревог и злобы, которые, кажется, гложут её уже слишком долго. Женщина фыркает при твоём приближении и отворачивается, так что ты не можешь видеть её глаза. Она ведёт себя так, будто ты не сможешь заметить её, если она не будет замечать тебя. Ты для неё просто не существуешь.~
@50028 = ~Казарма~
@50029 = ~«Тогда прощай».~
@50030 = ~Женщина непоколебима в намерении игнорировать тебя. Никакие из твоих слов не производят на неё впечатление.~
@50031 = ~«Ну и ладно».~
@50032 = ~Винокурня~
@50033 = ~Ты видишь рыжеволосую женщину, маленькую и пухлую. Её лицо сплошь покрыто морщинами от забот, тревог и злобы, которые, кажется, гложут её уже слишком долго. Она скрипит: «Ты тот чудак, что хочет под землю, да? Тебе надо угодить Донне Квишо, чтобы она дала тебе свою часть ключа. Здесь, в городе, заперт изверг. Мне надо, чтоб его освободили». Прежде чем ты успеваешь отреагировать, она суёт тебе в руки свиток.~
@50034 = ~Мир сна~
@50035 = ~«Зачем?»~
@50036 = ~«Не в моих правилах освобождать извергов».~
@50037 = ~Сад Чёрных Шипов Рейвел~
@50038 = ~«Скажи, что я должен сделать».~
@50039 = ~«Падшая Грейс, что ты об этом думаешь?»~
@50040 = ~«Потому что он мой! Потому что я пожертвовала ради него слишком многим! Потому что его у меня забрали, спрятали от меня и заперли, и никто мне не помог, хотя всё, чего я хотела, был он! — в её голосе появляется коварство. — Но сейчас у меня есть знание, которое нужно тебе, и ты его не получишь, пока не отпустишь Агрил-Шанака».~
@50041 = ~«Откуда мне знать, не начнёт ли он буйствовать?»~
@50042 = ~«Не в моих правилах освобождать извергов».~
@50043 = ~«Скажи, что я должен сделать».~
@50044 = ~«Падшая Грейс, что ты об этом думаешь?»~
@50045 = ~Она смеётся тебе в лицо: «Не имеет значения. Тебе нужна пятая часть ключа. Я её знаю. Если не найдёшь другого способа залезть под свою разлюбезную землю, делай, что я говорю».~
@50046 = ~«Откуда мне знать, не начнёт ли он буйствовать?»~
@50047 = ~«Я не буду этого делать».~
@50048 = ~«Скажи, что я должен сделать».~
@50049 = ~«Найди в городе зернохранилище. Найди там нарисованную на полу пентаграмму. Используй рядом этот свиток, и когда Агрил-Шанак появится… освободи его. Договаривайся с ним о чём хочешь, но освободи его. Меня не волнует, что ты будешь делать потом».~
@50050 = ~«Хорошо. До свидания».~
@50051 = ~Чтобы получить пятую часть ключа, мне нужно отыскать в этом городе зернохранилище, найти в нём пентаграмму, использовать рядом с ней свиток и освободить изверга Агрил-Шанака. Когда выполню задание, я должен вернуться к Донне Квишо за ключом.~
@50052 = ~В её глазах играет улыбка — одна из самых ядовитых, какие тебе доводилось видеть: «Это не моя проблема. Мне побоку твои дела с извергом. Он нужен мне свободным, вот и всё».~
@50053 = ~«Что мне нужно сделать?»~
@50054 = ~«Я не буду этого делать».~
@50055 = ~«Тогда ты не получишь пятой части ключа. Ты передумаешь, никаких сомнений. Так что возвращайся», — она хихикает и отворачивается.~
@50056 = ~Уйти.~
@50057 = ~Когда ты приближаешься к женщине на сей раз, она поворачивается к тебе с нетерпением. Она скрипит: «Ты тот чудак, что хочет под землю, да? Тебе надо угодить Донне Квишо, чтобы она сказала тебе свою часть ключа. Здесь, в городе, заперт изверг. Мне надо, чтоб его освободили». Прежде чем ты успеваешь отреагировать, она суёт тебе в руки свиток.~
@50058 = ~«Зачем?»~
@50059 = ~«Не в моих правилах освобождать извергов».~
@50060 = ~«Скажи, что я должен сделать».~
@50061 = ~«Падшая Грейс, что ты об этом думаешь?»~
@50062 = ~При твоём приближении Донна Квишо поднимает глаза, и презрение переполняет её черты: «Ты ещё не освободил Агрил-Шанака, нет? Возвращайся, когда освободишь».~
@50063 = ~«Ещё раз, что мне нужно сделать?»~
@50064 = ~«Я не собираюсь этого делать».~
@50065 = ~«Хорошо. До свидания».~
@50066 = ~Она нетерпеливо вздыхает: «Зернохранилище. Пентаграмма. Прочитать свиток. Доступно? Вперёд». Она отворачивается.~
@50067 = ~«Тогда до встречи».~
@50068 = ~«Ты всё сделал, не так ли? Да, сделал… но где Агрил-Шанак?»~
@50069 = ~Правда: «Он мёртв».~
@50070 = ~Ложь: «Он скоро появится».~
@50071 = ~«Я уверен, он скоро будет здесь».~
@50072 = ~Она хихикает: «И мы будем плести заговоры и строить ловушки, а они поплатятся за свои ошибки, о да». Она суёт тебе в руки мешочек монет. «Вот последняя часть ключа: „Как от Центра трижды к крайнему полюсу“. Теперь возвращайся и поговори с Пятнистым Барсом, он направит тебя куда надо», — всё ещё хихикая, она собирает свои пожитки и выскальзывает наружу.~
@50073 = ~«Прощай…»~
@50074 = ~Донна Квишо сообщила мне пятую часть ключа: «Как от Центра трижды к крайнему полюсу». Она прокудахтала что-то о мести и отправила меня обратно к Пятнистому Барсу, чтобы узнать, как использовать ключ.~
@50075 = ~Её лицо бледнеет: «Мёртв… но?.. Ты убил его? Тогда я труп. Получи свой проклятый ключ и убирайся». Она произносит безжизненно: «„Как от Центра трижды к крайнему полюсу“». Мгновение она оглядывается вокруг. «Поговори ещё раз с Барсом. Он знает, что делать», — она собирается с мыслями и убегает.~
@50076 = ~«Тогда прощай».~
@50077 = ~Донна Квишо сообщила мне пятую часть ключа: «Как от Центра трижды к крайнему полюсу». Она сказала мне снова поговорить с Пятнистым Барсом, пробормотала что-то о собственной кончине, когда я сказал ей о смерти Агрил-Шанака, и исчезла, как будто за ней гнались хозяева всех Девяти Кругов Ада.~
@50078 = ~«Договориться с извергом можно, но в зависимости от вида нужны разные подходы. Если это баатезу, то он может предложить сделку за свою свободу. Если это танар'ри, мы просто должны продемонстрировать убедительный аргумент, который заставит его уступить, — она мягко улыбается. — Доводы должны диктоваться твоим вооружением».~
@50079 = ~«Хорошо. Донна Квишо, что я должен сделать?»~
@50080 = ~«Не в моих правилах освобождать извергов».~
@50081 = ~На покупку всех выбранных предметов не хватает денег.~
@50082 = ~На это заклинание не хватает денег.~
@50083 = ~На этот напиток не хватает денег.~
@50084 = ~На опознание всех выбранных предметов не хватает денег.~
@50085 = ~На эту комнату не хватает денег.~
@50086 = ~Я не принимаю краденые вещи. Дай мне что-нибудь другое.~
@50087 = ~ДОДЕКАЭДР
Вес: 2

Этот тяжёлый додекаэдр размером с два твоих кулака выглядит необычайно знакомым. Его поверхность холодная и гладкая, но ты не можешь понять, сделан ли он из металла или камня. В нём чувствуется некоторая «напряжённость», почти неуловимая, словно он в любой момент готов взмыть в воздух.~
@50088 = ~ЛЕДЕНЕЦ!
Вес: 0

Похоже на маленький каменный брусок. Интересно, но бесполезно.~
@50089 = ~МАГИЧЕСКИЙ ПРЕДМЕТ!
Вес: 0

Это что-то, но будь проклят Баатор, если ты можешь понять, что именно. Однако от него исходит магия.~
@50090 = ~УЛИКА!
Вес: 0

Этот загадочный кусок пергамента гласит:

«Теперь ты лучше понимаешь всё, что происходит…»~
@50091 = ~СУМКА МОНЕТ
Вес: 0

Маленькая сумочка, полная каких-то странных монет. На монетах необычные картинки и надписи. Похоже, они ничего не стоят.~
@50092 = ~ПЕПЕЛ ПАБУЛУМА
Вызывает трелонов
Вес: 1
Недоступно: магам
Доступно только Безымянному

Этот пепел — всё, что осталось от школы иллюзионистов под названием Пабулум. Судя по их путевым заметкам, они путешествовали по пустоши Глины в поисках утраченных работ Фостерера, могучего колдуна, который когда-то правил империей, на месте которой теперь расположена пустошь Глины.

Наивные иллюзионисты достигли успеха, наткнувшись на одно из его последних открытий: логово злобных созданий под названием трелоны. Останки магов несколько дней спустя были найдены двумя бариаурами-разведчиками и сожжены на погребальном костре в ознаменование их глупости.

Чтобы освободить силу этого пепла, его нужно потереть указательным пальцем левой руки, а затем распылить щепотку в воздухе по кругу. Запах останков, говорят, вызовет трелона, который будет служить тебе.

Никто не знает, откуда родом трелоны, но, похоже, они сочетают в себе худшие черты демонов и насекомых. Кажется, они испытывают исступлённую ненависть к магам, но причина этого неизвестна.~
@50093 = ~ШЕПЧУЩИЙ ПУЗЫРЁК
Вызывает: «Помощь»
Особенности:
   Сила: +2
Доступно: гитцерай

Этот контейнер содержит необычный порошок под названием «Шепчущая Пыль» (плохой перевод выражения гит), одну из форм лечебного порошка, часто используемого гитцерай на плане Лимбо. Если вынуть пробку и насыпать порошок на кожу раненого, то он начинает растекаться по телу, заполняя «дыры» в физической оболочке — неважно какого размера. Чтобы заставить порошок работать, нужно сконцентрироваться на его исцеляющей силе… с должной самоорганизацией, опытный гитцерай может излечить самые страшные раны. Кроме целительства порошок используется и в их некоторых ритуалах перехода… утверждают, что пряность также заполняет и духовные «дыры», позволяя избавиться от сомнений и лучше сосредоточиться на своей цели.~
@50094 = ~Оставить камень в покое.~
@50095 = ~«Что ж, я всё равно не хотел его читать… по крайней мере, не сейчас».~
@50096 = ~Шкаф~
@50097 = ~Снова осмотреть труп.~
@50098 = ~~
@50099 = ~~
@50100 = ~~
@50101 = ~~
@50102 = ~~
@50103 = ~~
@50104 = ~~
@50105 = ~~
@50106 = ~~
@50107 = ~«Приветствую».~
@50108 = ~Ты видишь высокое существо с копной белых волос. Его кожа зеленоватого оттенка, изо лба торчат два козлиных рога. Оно одето в длинные ниспадающие одежды и, похоже, плывёт над землёй.~
@50109 = ~«Приветствую».~
@50110 = ~Существо поворачивается к тебе, и вокруг его головы появляется ряд символов. Символы слабо светятся и просто… парят в воздухе.~
@50111 = ~«Э-э… — Анна странно смотрит на тебя. — Это ж дабус, ты чё?»~
@50112 = ~«Что такое „дабус“?»~
@50113 = ~Анна понижает голос до шёпота: «Дабус — один из *Её* родичей: они заботятся о городе, чинят его, сносят всё и снова отстраивают. Они базарят символами-головоломками в воздухе — надо сложить части вместе, чтоб понять, о чём речь». Она выглядит раздражённой: «Одна головная боль от них, вот чё».~
@50114 = ~«„Её“ родичей? Чьих?»~
@50115 = ~«Госпожи Боли, — Анна чертит в воздухе перед собой полукруг. — Они её слуги, а она их защищает. Не приставай к ним, а то привлечёшь её взгляд».~
@50116 = ~«Можешь рассказать мне о Госпоже Боли?»~
@50117 = ~«Ш-ш-ш-ш! — Анна проводит пальцем у горла. — Не греми о ней костями. У неё уши *повсюду*, так что не упоминай её имя всуе, ага?»~
@50118 = ~«Ох».~
@50119 = ~Дабус спокойно ждёт, его руки спрятаны в рукава. Над головой появляется ряд символов, затем они исчезают, и появляется знак вопроса.~
@50120 = ~Попытаться вступить в разговор и посмотреть, сможешь ли ты разобрать, о чём говорит дабус.~
@50121 = ~Ты задаёшь дабусу несколько вопросов, пытаясь разобраться в ребусах, появляющихся над его головой. Он проявляет исключительное терпение во время этой «дискуссии», отвечая лёгкими для перевода предложениями. Через несколько минут ты начинаешь осваиваться… и понимаешь, что уже делал это раньше.~
@50122 = ~«Может, ты поможешь мне…»~
@50123 = ~Дабус ждёт.~
@50124 = ~«Кто ты?»~
@50125 = ~Дабус чуть склоняет голову, и над ней появляется целый поток символов. Как ты понимаешь, он говорит, что он дабус.~
@50126 = ~«У меня есть другой вопрос».~
@50127 = ~«Это всё, что я хотел узнать. Прощай».~
@50128 = ~Дабус отвешивает лёгкий поклон. Символы вьются над его головой, затем он отворачивается.~
@50129 = ~Уйти.~
@50130 = ~«Что делаешь?»~
@50131 = ~Над головой дабуса появляется группа символов. Как ты понимаешь, он говорит, что выполняет свой долг… или свои обязанности.~
@50132 = ~«У меня другой вопрос…»~
@50133 = ~«Очень информативно. Спасибо и прощай».~
@50134 = ~«Это всё, что я хотел узнать. Прощай».~
@50135 = ~«Кто ты?»~
@50136 = ~Дабус чуть склоняет голову, и над ней появляется целый поток символов. (Я дабус.)~
@50137 = ~«У меня другой вопрос».~
@50138 = ~«Это всё, что я хотел узнать. Прощай».~
@50139 = ~«Что делаешь?»~
@50140 = ~Над головой дабуса появляется группа символов. (Я выполняю свои обязанности.)~
@50141 = ~«У меня другой вопрос…»~
@50142 = ~«Очень информативно. Спасибо и прощай».~
@50143 = ~«Это всё, что я хотел узнать. Прощай».~
@50144 = ~«Можешь рассказать мне о Госпоже Боли?»~
@50145 = ~Над головой дабуса появляется одинокий символ. Это металлическая женская маска, из сторон которой торчат клинки. Один только взгляд на этот символ вызывает у тебя тревогу.~
@50146 = ~«Хм… не совсем тот ответ, на который я рассчитывал».~
@50147 = ~«Пожалуй, на определённый ответ вряд ли стоит рассчитывать».~
@50148 = ~«Можешь задать ему другой вопрос?»~
@50149 = ~Падшая Грейс кивает: «Да, конечно».~
@50150 = ~«Спроси его, кто он такой».~
@50151 = ~Дабус чуть склоняет голову, и над ней появляется целый поток символов.~
@50152 = ~«Что он сказал, Анна?»~
@50153 = ~«Он сказал только, что он из дабусов, — она пожимает плечами. — У них нет имён».~
@50154 = ~«Можешь задать ему другой вопрос?»~
@50155 = ~Анна кивает. Дабус продолжает глазеть на вас обоих, руки его спрятаны в рукавах.~
@50156 = ~«Спроси его, кто он такой».~
@50157 = ~«Спроси его, кто он такой».~
@50158 = ~Дабус чуть склоняет голову, и над ней появляется целый поток символов. Как ты понимаешь, он говорит, что он дабус.~
@50159 = ~«Что он сказал, Анна?»~
