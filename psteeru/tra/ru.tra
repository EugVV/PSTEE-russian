@31096 = ~Этот ящик имеет символ черепа и вырезанный девиз «Спроектировано для Вечности».~
@31097 = ~«У меня ещё вопросы о Сигиле…»~
@31098 = ~«У меня вопросы о другом…»~
@31099 = ~Хотя эти ящики и составлены как попало, каждый из них имеет порядковый номер.~
@31100 = ~«Это всё, что я хотел узнать. Прощай».~
@31101 = ~«Ну, я, например, планирую познать секреты мультивселенной, натирая брюхо домашним сыром и поглощая в огромных количествах пресноводную рыбу. М-м… сыр».~
@31102 = ~«Ну, я, например, планирую познать секреты мультивселенной, натирая брюхо домашним сыром и поглощая в огромных количествах пресноводную рыбу. М-м… сыр».~
