@25475 = ~«Хорошо».~
@25476 = ~«Ладно. Я имею в виду… э-э… постараюсь больше ничего не подписывать».~
@25477 = ~«Ладно. Я имею в виду… э-э… постараюсь больше ничего не подписывать».~
@25478 = ~«Ладно. Я имею в виду… э-э… постараюсь больше ничего не подписывать».~
@25479 = ~«Я хочу задать ему ещё один вопрос…»~
@25480 = ~«Это всё, что я хотел узнать. Прощай».~
@25481 = ~Правда: «Я… не чувствую. По сути, с тех пор, как проснулся в Мортуарии, я чувствую себя, будто что-то… потерял. Что-то внутри себя».~
@25482 = ~Правда: «Я… не чувствую. По сути, с тех пор, как проснулся в Мортуарии, я чувствую себя, будто что-то… потерял. Что-то внутри себя».~
@25483 = ~Правда: «Я… не чувствую. По сути, с тех пор, как проснулся в Мортуарии, я чувствую себя, будто что-то… потерял. Что-то внутри себя».~
@25484 = ~«Тебя это не касается».~
@25485 = ~Ложь: «Да, я чувствую себя целым. А что?»~
@25486 = ~«Я хочу задать ему ещё один вопрос…»~
@25487 = ~«Это всё, что я хотел узнать. Прощай».~
@25488 = ~«Постараюсь. Я хочу задать ему ещё один вопрос…»~
@25489 = ~«Это всё, что я хотел узнать. Прощай».~
@25490 = ~«Я хочу задать ему ещё один вопрос…»~
@25491 = ~«Это всё, что я хотел узнать. Прощай».~
@25492 = ~Этот мужчина одет в грязные рваные коричневые одежды, длинный капюшон закрывает большую часть его лица.~
@25493 = ~«Приветствую…»~
@25494 = ~Его глаза под капюшоном сужаются, и он отступает назад: «Чё тебе надо?»~
@25495 = ~«Чем занимаешься?»~
@25496 = ~«Ищу этих проклятых трупаков повсюду. Но, похоже, силы мёртвых собрали шмотки и покинули планы, народ совсем не мрёт… — ты видишь внезапный проблеск в его глазах. — У нас тут эпидемия была месяц назад, чудное времячко было… всё до небес провоняло от трупаков, столько бабок наварили».~
@25497 = ~«Зачем ты ищешь трупаков?»~
@25498 = ~Он выглядит удивлённым: «Ну так, тащишь паршивцев в Мортуарий, там торгуешься с Пыльниками и получаешь свои несколько медяков».~
@25499 = ~«А зачем Пыльные покупают тела?»~
@25500 = ~«Они собирают мёртвых… эт типа их работа. Платят нам за зачистку и забирают всех трупаков, которых мы им прём. Заботятся о захоронении тел паршивцев в нужном месте или о кремации. Для Пыльников это типа серьёзно всё, дебильная философия у них такая. Но для меня это тока больше медяков значит», — он подмигивает.~
@25501 = ~«Что это за место?»~
@25502 = ~Он хмурится на тебя: «Ты в Улье, ясен перец. Мерзейшее место во всём Сигиле. Откуда ты, здоровяк? С Первичного или как?»~
@25503 = ~«Нет. Зачем ты ищешь трупы?»~
@25504 = ~«Нет. Но у меня пара вопросов…»~
@25505 = ~Он поднимает бровь: «У меня найдётся, чё те порассказать, но насколько сильно ты хочешь знать?»~
@25506 = ~«Что ты имеешь в виду?»~
@25507 = ~«Посмотри вокруг, здоровяк… Я слишком мало навариваюсь, чтоб задаром тут свет проливать. Если хочешь баек — гони бабки, ага».~
@25508 = ~Дать ему пару медяков.~
@25509 = ~Он хмыкает: «Даже Пыльные платят больше, здоровяк. Похоже, ты ничего узнать не хочешь».~
@25510 = ~Бросить ему пять медяков.~
@25511 = ~Некоторое время он изучает лежащие в руках монетки. «Угу, — он проворно прячет их. — Спрашивай».~
@25512 = ~«Расскажи мне о Сборщиках».~
@25513 = ~«Я… мы… зарабатываем на жизнь тем, что ищем в Сигиле трупаков и тащим их свинцовые задницы в Мортуарий. Не лучший способ заработка, но это ж только начало. Это всё, что ты хотел знать, здоровяк?» — он смотрит на тебя странно.~
@25514 = ~«Я ищу мужчину по имени Фарод».~
@25515 = ~Внезапно он прищуривается: «Фарод… а что с ним?»~
@25516 = ~«Ты вдруг насторожился… почему?»~
@25517 = ~«Фарод, хмпф! — он плюёт, презрительно фыркая. — Площадь Мусорщиков — это территория Шергрейва, моего шефа, если не в курсе. Фарод и его псы вылазят временами и пытаются нас вытеснить. Мы вышибли их, ага, так что терь они где-то ныкаются. Бывает, мы ловим его парней в районе Площади. Обычно Мортуарий за них хорошо платит, за этих долбаных пидоров».~
@25518 = ~«Расскажи мне о Шергрейве».~
@25519 = ~«Он мой босс… бросает свою тень на все-е-х Сборщиков в округе, ага. Я б держался от него подальше, если тока нет *действительно* хорошей причины для базара… Лично я сам никогда с ним не говорил».~
@25520 = ~«Не знаешь, где Фарод?»~
@25521 = ~«Я знаю, где этой ублюдочной крысы нету — на Площади Мусорщиков; эт точно, хотя там шарятся почти все Сборщики… Но он где-то поблизости, судя по байкам».~
@25522 = ~«Все ли Сборщики разделяют твоё мнение о Фароде?»~
@25523 = ~«Расскажи мне о Сборщиках».~
@25524 = ~«Я ищу свой потерянный дневник».~
@25525 = ~Он озадаченно мотает головой.~
@25526 = ~«Расскажи мне о Сборщиках».~
@25527 = ~«А ещё я ищу мужчину по имени Фарод».~
@25528 = ~«Что ты знаешь о Меббет?»~
@25529 = ~«Повитуха? Добрая тетка, эт уж точно. Поможет, если ты типа больной и всё такое. Она живёт в хижине рядом с помостами на Площади Мусорщиков, если те надо с ней повидаться».~
@25530 = ~«Расскажи мне о Сборщиках».~
@25531 = ~«Я ищу мужчину по имени Фарод».~
@25532 = ~«Я ищу свой потерянный дневник».~
@25533 = ~«Это всё, что я хотел узнать. Прощай».~
@25534 = ~«Лан, береги себя, здоровяк. Если я найду твой труп на улицах, то буду с ним осторожен».~
@25535 = ~Уйти.~
@25536 = ~«Тогда прощай».~
@25537 = ~«Что ты знаешь о Меббет?»~
@25538 = ~«Это всё, что я хотел узнать. Прощай».~
@25539 = ~«Расскажи мне о Сборщиках».~
@25540 = ~«Я ищу свой потерянный дневник».~
@25541 = ~«Что ты знаешь о Меббет?»~
@25542 = ~«Это всё, что я хотел узнать. Прощай».~
@25543 = ~«Не знаешь, где этот Фарод?»~
@25544 = ~«Расскажи мне о Сборщиках».~
@25545 = ~«Я ищу свой потерянный дневник».~
@25546 = ~«Что ты знаешь о Меббет?»~
@25547 = ~«Это всё, что я хотел узнать. Прощай».~
@25548 = ~«Не знаешь, где он?»~
