@50240 = ~«Спроси его, кто он такой».~
@50241 = ~«Спроси его, что он делает».~
@50242 = ~«Спроси его, что он делает».~
@50243 = ~«Спроси его, что он делает».~
@50244 = ~«Попроси его рассказать нам о Госпоже Боли».~
@50245 = ~«Попроси его рассказать нам о Фелле».~
@50246 = ~Грейс хмурится: «Не думаю, что было бы мудро о нём спрашивать. Можно обидеть дабуса, так как Фелл больше не входит в их сообщество…»~
@50247 = ~«И всё же, можешь его спросить?»~
@50248 = ~«Достаточно наставлений, просто спроси».~
@50249 = ~«Можешь задать ему другой вопрос?»~
@50250 = ~«Тогда забудь. Пошли».~
@50251 = ~«Забудь. Пошли отсюда».~
