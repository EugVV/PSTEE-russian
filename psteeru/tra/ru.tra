@46745 = ~Лоб этого на редкость мускулистого трупа покрыт сплошными шрамами, как будто при жизни он использовал голову исключительно для драки. К тому же его прошивает насквозь красной нитью число 1508, а рот накрепко стянут стежками чёрного волокна. Он явственно пахнет жидкостью для бальзамирования.~
@46746 = ~«Так… что-нибудь интересненькое происходит?»~
@46747 = ~Труп продолжает пялиться на тебя.~
@46748 = ~Оставить труп в покое.~
@46749 = ~«Так… что-нибудь интересненькое происходит?»~
@46750 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@46751 = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@46752 = ~Труп не отвечает. Кажется, он витает слишком далеко, чтобы отвечать на твои вопросы.~
@46753 = ~Оставить труп в покое.~
@46754 = ~«Было приятно пообщаться. Прощай».~
@46755 = ~Оставить труп в покое.~
@46756 = ~Кожа на этом трупе изрыта оспинами, его уши, кончик носа и несколько пальцев совсем сгнили… больше всего он похож на жертву страшной болезни. Номер 1445 татуирован на его лбу, а его губы крепко пришиты друг к другу.~
@46757 = ~«Так… что-нибудь интересненькое происходит?»~
@46758 = ~Труп продолжает пялиться на тебя.~
@46759 = ~Оставить труп в покое.~
@46760 = ~«Так… что-нибудь интересненькое происходит?»~
@46761 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@46762 = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@46763 = ~Труп не отвечает. Кажется, он витает слишком далеко, чтобы отвечать на твои вопросы.~
@46764 = ~Оставить труп в покое.~
@46765 = ~«Было приятно пообщаться. Прощай».~
@46766 = ~Оставить труп в покое.~
@46767 = ~«Прости, уважаемый. Никому сюда нельзя, пока управляющий Сандоз не вернётся. Ты не можешь войти».~
@46768 = ~«Что ты можешь о нём рассказать?»~
@46769 = ~Приглушённый голос раздаётся из-за двери: «Уходи!»~
@46770 = ~«Твоё имя Сандоз?»~
@46771 = ~Пустая оправа~
