@9286  = ~«Кто ты?»~
@9287  = ~«Откуда ты?»~
@9288  = ~«Как ты попал сюда? В смысле, в виде зомби».~
@9289  = ~«Я… я не знаю».~
@9290  = ~«В другой раз скажу. У меня к тебе вопрос…»~
@9291  = ~«Может, в другой раз. Прощай».~
@9292  = ~«Ясно. Я хотел спросить о другом…»~
@9293  = ~«Это всё, что я хотел узнать. Прощай».~
@9294  = ~«Я хочу спросить о другом…»~
@9295  = ~«Это всё, что я хотел узнать. Прощай».~
@9296  = ~«Ясно. Я хотел спросить о другом…»~
@9297  = ~«Это всё, что я хотел узнать. Прощай».~
@9298  = ~«Ты знаешь что-нибудь о городе, в котором находится Мортуарий?»~
@9299  = ~«Ясно. Я хотел спросить о другом…»~
@9300  = ~«Это всё, что я хотел узнать. Прощай».~
@9301  = ~«Возможно. Я хотел спросить о другом…»~
@9302  = ~«Не знаю. Прощай».~
@9303  = ~«Я уверен, ты что-нибудь придумаешь. Я вот спросить хочу…»~
@9304  = ~Придумать имя: «Не знаю… „Адан“?»~
@9305  = ~«Нет, неважно. Прощай».~
@9306  = ~«Кто ты?»~
@9307  = ~«Кто ты?»~
@9308  = ~«Откуда ты?»~
@9309  = ~«Как ты попал сюда? В смысле, в виде зомби».~
@9310  = ~«Где ты… то есть где сейчас пребывает… твой дух?»~
@9311  = ~«Что ты знаешь об этом месте?»~
@9312  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@9313  = ~«Да…»~
@9314  = ~«Нет. Прощай».~
@9315  = ~«Да… наверное. У меня есть ещё вопросы…»~
@9316  = ~«Возможно. Прощай».~
@9317  = ~«Где ты… то есть где сейчас находится… твой дух?»~
@9318  = ~«Что ты знаешь об этом месте?»~
@9319  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@9320  = ~«Ни о чём, неважно».~
@9321  = ~«Неважно, забудь».~
@9322  = ~«Дай нам знать, если что-нибудь найдёшь».~
@9323  = ~«Нет, спасибо. Лучше не буду».~
@9324  = ~«У меня такое чувство, будто я делаю это до сих пор».~
@9325  = ~«Так и есть».~
@9326  = ~«Не хочешь просто присесть и отдохнуть? Он нарисуется рано или поздно».~
@9327  = ~«Знаю, знаю. Я не хочу его пропустить».~
@9328  = ~«Ты слишком нетерпелив. Никуда он не денется. Терпение, маленький охотник».~
@9329  = ~«Крыски! Свежие крыски!»~
@9330  = ~«Ты думал найти его здесь?»~
@9331  = ~«Лодыри…»~
@9332  = ~«Поспешите с этими ящиками!»~
@9333  = ~«Эй, папаша… хочешь рассказ за медяки? А?»~
@9334  = ~«Рассказы-за-деньги… рассказы-за-деньги?..»~
@9335  = ~«Возьми себе выпивки и остынь, охотник».~
@9336  = ~«Я его не видел».~
@9337  = ~«Не ищи слишком долго».~
@9338  = ~Этот мужчина смотрит на тебя странными вытаращенными глазами. Его глаза просто *огромные*… настолько огромные, что кажется, будто они вот-вот выскочат из глазниц и покатятся по мостовой. Он с энтузиазмом кивает тебе, когда ты подходишь, голова его покачивается как у птицы… при приближении в нос бьют окружающие его ароматы мочи и испражнений.~
@9339  = ~«Приветствую».~
@9340  = ~Мужчина шмыгает носом, вытирает сопли рукавом, затем открывает рот, обнажая почерневшие, гнилые дёсны. «Рассказы-за-деньги, любезный? — изо рта у него воняет так, будто там хранится тухлое мясо. — Рассказы-за-деньги?»~
@9341  = ~«Кто ты?»~
@9342  = ~Этот человек приветствует тебя усмешкой. «Я Креддок, бугор здешнего заведения для полудурков. Теперь исчезни. У меня столько дел с этими недоносками, что на тебя времени нет».~
@9343  = ~«Очень хорошо… Кред-КОК».~
@9344  = ~«А у тя острый глаз, здоровяк! Всё, чё я продаю, — это мозговые паразиты, вот… уверен, ты найдёшь их намного вкуснее обычных крыс. Весьма недурны, правда!» — он демонстрирует их тебе ещё раз, соблазняюще размахивая ими перед твоим носом… крысы качаются из стороны в сторону, как маленькие кусочки говядины.~
@9345  = ~«Ещё нет».~
@9346  = ~Эта широкоплечая женщина вертится вокруг огромных балок, валяющихся на мостовой. Она пинает балки своими подкованными башмаками, время от времени наклоняется и голыми руками выдирает гвозди. Каждый из них она подносит к лицу, оценивает и бросает в кожаный мешочек на ремне.~
@9347  = ~Выражение нетерпения исчезает с его лица, как будто ему влепили пощёчину: «Нас обоих? Что я сделал?»~
@9348  = ~Ты видишь тощего усталого мужчину. От его одежды разит грязью и потом, кажется, он запыхался. На тебя он не обращает внимания… похоже, это один из обычных рыночных грузчиков.~
@9349  = ~Оставить его в покое.~
@9350  = ~Этот мужчина целиком погружён в изучение товаров на рыночных прилавках. Он не обращает на тебя никакого внимания.~
@9351  = ~«Хм… прости, что потревожил».~
@9352  = ~Эта женщина тебя совсем не замечает. Она кажется целиком поглощённой разглядыванием выставленных на продажу товаров.~
@9353  = ~Оставить её, пусть занимается своими покупками.~
@9354  = ~Эта мрачного вида женщина удостаивает тебя лишь мимолётным взглядом и продолжает вещать с подмостков. Её мощный голос разносится по всей рыночной площади, легко перекрывая выкрики торговцев и шум толпы вокруг.~
@9355  = ~Оставить её в покое.~
@9356  = ~Ты видишь тощего желтокожего человекоподобного, покрытого множеством затейливых татуировок. Его глаза подведены углём, зубы остро заточены. Он видит тебя и машет рукой, зажатые в ней игральные кости гремят.~
@9357  = ~«Приветствую…»~
@9358  = ~Этот парень просто заворожен речью женщины. Он даже не замечает, когда ты пытаешься заговорить с ним.~
@9359  = ~«Тогда неважно».~
@9360  = ~Эта тётка просто заворожена речью женщины. Она даже не замечает, когда ты пытаешься заговорить с ней.~
@9361  = ~«Тогда неважно».~
@9362  = ~Этот обитатель Улья наблюдает за работой дабуса. Он озадаченно чешет в затылке и поворачивается к тебе: «Клянусь жизнью Госпожи, не разберу, что они делают с этим домом… ихние дабусы вечно что-то сносят, потом опять строят… ни толку, ни ладу никакого не вижу».~
@9363  = ~«Тогда не бери в голову».~
@9364  = ~Этот краснорожий старик что-то выкрикивает в окружающую его толпу. Когда ты подходишь к нему, он с надеждой смотрит на тебя: «Не уделишь ли секундочку… или монетку… ради одной из самых интересных вещей на этой стороне Сигила, уважаемый?»~
@9365  = ~«Покажешь, что у тебя есть, после того, как я с Робом Холловеем проверю местные лавки».~
@9366  = ~«Хм-м. Как проверишь — возвращайся».~
@9367  = ~«Обязательно».~
@9368  = ~Эта старуха, похожая на урючину, что-то выкрикивает в окружающую её толпу. Когда ты подходишь к ней, она улыбается и загребает полные горсти, кажется, дохлых крыс и птиц: «Ты голоден, уважаемый?»~
@9369  = ~«Не сегодня, спасибо».~
@9370  = ~Мужчина стремительно поворачивается к тебе и кланяется: «Уважаемый… без сомнения, ты в поиске лучшего товара во всём Сигиле. Ты пришёл куда надо».~
@9371  = ~«Ну… я подожду, пока у тебя действительно что-нибудь появится».~
@9372  = ~Эта женщина внимательно изучает тебя, когда ты подходишь, затем запускает руку в карман и усмехается: «Рожей не вышел, да? Может, хоть деньги водятся, и хочешь прикупить что-нибудь у бродячего лудильщика, а?»~
@9373  = ~«Не нужно… грязнуля».~
@9374  = ~Лающий-Дикарь~
@9375  = ~Адизоэль Эриан-Ард~
@9376  = ~Гаоха~
@9377  = ~Плачущий-по-Деревьям~
@9378  = ~Торговец из Улья~
@9379  = ~0200dab1~
@9380  = ~«Великая тьма падёт на этот город!»~
@9381  = ~«Я предвижу конец!»~
@9382  = ~«Хэмрису он понравится, точняк…»~
@9383  = ~«Убедись, что ящики надежны, сейчас же!»~
@9384  = ~«Сигил не спит, так что пошевеливайтесь, болваны!»~
@9385  = ~«За этот выручу кучу медяков…»~
@9386  = ~«Вкусные, вкусные крыски! Прямо из погреба!»~
@9387  = ~«Крыски? Кому крысок? Пальчики оближешь!»~
@9388  = ~«Крыски здесь, налетай!»~
@9389  = ~«Крыски со специями! Варёные крыски! Жареные крыски!»~
@9390  = ~«Фаршированные крыски! Три гроша пара!»~
@9391  = ~«Крысиные тушки! Свежеободранные, без хвостов, без лап!»~
@9392  = ~«Печёные крыски! Три медяка пара!»~
@9393  = ~«Крыски! Свежие крыски!»~
@9394  = ~«Шикарно…»~
@9395  = ~«Гвозди, гвозди…»~
@9396  = ~«Вот ещё отличный…»~
@9397  = ~«Шикарные гвозди…»~
@9398  = ~Дух открывает один глаз; глазное яблоко сияет белизной на фоне серой морщинистой плоти. Он медленно поворачивает голову, чтобы взглянуть на тебя; обожжённая и искромсанная плоть его лица и шеи свисает с костей. Наконец он хрипит остатками горла: «Нет. Нет… и не буду, ты… сраный… пустоголовый».~
@9399  = ~«Хе, хе-ХР-Р!» — смех духа резко обрывается неистовым спазмом и извержением потока бальзамирующих средств с чёрными остатками разложения. Корчась от боли, дух заходится в кашле, прерываясь, чтобы вытереть жёлтую жидкость и оборвать швы с остатков губ.~
@9400  = ~Наконец ужасный кашель духа успокаивается. «Нет, пень… ты… не можешь. Если только… если только махом не двинешь в Баатор и не спасёшь меня, я… ослеп. Для меня время… расплаты», — дух закрывает глаз и откидывает голову на пол.~
@9401  = ~Дух издаёт клокочущее рычание, из его потрескавшихся почерневших губ выступают кривые жёлтые зубы. «Смейся… смейся, пока я… не выберусь из этой Преисподней… я… первым приду за тобой, пень…»~
@9402  = ~Дух издаёт слабое гортанное рычание и плюёт в твою сторону — мерзкая жижа падает на пол в нескольких дюймах от твоих ног. Существо в изнеможении откидывается на пол, и жизнь вновь покидает тело.~
@9403  = ~Ты наносишь быстрый удар по почкам трупа, но безрезультатно; духу ничего не делается. «Хе-хе-хе», — смеётся дух, перед тем как окончательно покинуть тело. Тебе остаётся лишь смутное чувство разочарования.~
@9404  = ~«Чё… чё те *вообще* может быть от меня нужно, пень?» — дух всё ещё корчится, как будто пытаясь сбить с себя пламя.~
@9405  = ~«Не твоё собачье дело… оставь меня… в покое…»~
@9406  = ~«Э? Да отлюби тебя силы, кому… какое дело? Из Сигила… ты, помоечник».~
@9407  = ~«А ты как думаешь, тормоз? — вспышка гнева вызывает у духа короткий приступ судорожного мучительного кашля. — Я продал это мясо за… за чуток медяков. Грёбаные Пыльники… настоящая дыра — НАСТОЯЩАЯ ДЫРА, можешь поверить — какой-то спятивший маг решил сжечь к чертям Улей и меня заодно!» Дух некоторое время зло бормочет, из рваной дыры его рта пузырится и течёт дымящаяся жидкость.~
@9408  = ~«А ты… как думаешь, кожеголовый толкач? Баатор, в этой вонючей навозной дыре под названием Флегетос. Горю, горю… горю… вот и всё, что я делаю. Я сгорел до смерти при жизни, а теперь горю и мёртвый. Ар-рх! — труп скрежещет зубами от ярости. — Тошнотворная шуточка! Када я выберусь оттуда, я покрошу кучу педрил в этой долбаной дыре. Хе, хе-хе…» Он издаёт булькающий звук.~
@9409  = ~«Заслужить? ЭТО? Да ничего! Я… *гха*… ничё не сделал. Просто пытался добиться… добиться, чего все хотят… и „пу-у-ух!“ Этот магов ублюдок поджёг Улей!»~
@9410  = ~«Ничё. Ничё я *тебе* не скажу, пень. Просто… просто оставь меня в покое и сгори…»~
@9411  = ~«Кто? Что? Нет! Какого… какого те взбрело в голову, что я скажу… тупорылый пень? Хмф…»~
@9412  = ~«Месть, пустоголовый! Я хочу… хочу… добраться до всех них, всех, кто мне встречался. А особенно до того мага! Я хочу выбить из него дух и перерезать ему горло! А потом кинуть его в вонючую дыру, чтоб его! Его и ещё нескольких для… для ровного счёта, заодно! Хе, хе-хе…»~
@9413  = ~«Я хочу спросить тебя…»~
@9414  = ~Оставить горящий дух в покое.~
@9415  = ~«Могу я тебе чем-нибудь помочь?»~
@9416  = ~«Я хочу задать вопрос…»~
@9417  = ~«Ну и к лучшему, вонючий, гниющий пень; наверно, ты эту судьбу заслужил. Прощай».~
@9418  = ~Оставить измученного духа в покое.~
@9419  = ~Терпеливо ждать.~
@9420  = ~«Ты злобный ничтожный человечишка. Похоже, такую судьбу ты как раз и заслужил».~
@9421  = ~«Я хочу спросить о другом…»~
@9422  = ~Оставить дух страдать.~
@9423  = ~«Ясно. Я хотел спросить о другом…»~
@9424  = ~«Хорошо. Прощай».~
@9425  = ~«Можешь попробовать. Я не боюсь таких, как ты».~
@9426  = ~Ударить его.~
@9427  = ~Не обращая внимания на негодяя, развернуться и уйти.~
@9428  = ~«Кто ты?»~
@9429  = ~«Откуда ты?»~
@9430  = ~«Как ты попал сюда? В смысле, в виде зомби».~
@9431  = ~«Где ты… то есть где сейчас находится… твой дух?»~
@9432  = ~«Что ты сделал, чтобы заслужить эту пытку?»~
@9433  = ~«Что ты знаешь об этом месте?»~
@9434  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@9435  = ~«Ничего, неважно».~
@9436  = ~«Нет. Я хотел спросить о другом…»~
@9437  = ~«Тогда прощай».~
@9438  = ~«Я хочу спросить о другом…»~
@9439  = ~«Это всё, что я хотел узнать. Прощай».~
@9440  = ~«Маг поджёг Улей?»~
@9441  = ~«Я хочу спросить о другом…»~
@9442  = ~«Почему ты хочешь своей судьбы другим?»~
@9443  = ~«Я хочу спросить о другом…»~
@9444  = ~«Это всё, что я хотел узнать. Прощай».~
@9445  = ~«Маг… поджёг… Улей?»~
@9446  = ~«Ясно. Я хотел спросить о другом…»~
@9447  = ~«Ладно. Тогда у меня другой вопрос…»~
@9448  = ~«Тогда прощай».~
@9449  = ~«Хорошо. Я хотел спросить о другом…»~
@9450  = ~«Это всё, что я хотел узнать. Прощай».~
@9451  = ~«Ясно. У меня ещё вопросы…»~
@9452  = ~«Это всё, что я хотел узнать. Прощай».~
@9453  = ~«Горе тем, кто слушает, но не внимает!»~
@9454  = ~«Им суждено отправиться в лабиринты!»~
@9455  = ~«Там, куда опустится тень Госпожи, падут все!»~
@9456  = ~«Спустя пять лет! Проклятие!»~
@9457  = ~«Фракции будут разогнаны!»~
@9458  = ~«Да. Улей… худшую часть Сигила. Я никогда в жизни не видел столько огня… я бежал, пытался удрать, но всё было в огне! Дома, улицы, народ, дети… а тот трижды грёбаный маг всё смеялся! Я завернул за угол, думал, что спасся, но тут вся моя башка оказалась в огне! Неслабо полыхнуло так… отправился в мир иной…» — открытый глаз духа загорается злобой.~
@9459  = ~«Кто был этот маг?»~
@9460  = ~0200dab3~
@9461  = ~0200dab4~
@9462  = ~0200dab2~
@9463  = ~«Не будет пощады даже фактолам!»~
@9464  = ~«Ясно. У меня ещё вопросы…»~
@9465  = ~«Это всё, что я хотел узнать. Прощай».~
@9466  = ~0200thg1~
@9467  = ~0200thg2~
@9468  = ~0200ingr~
@9469  = ~0200har1~
@9470  = ~0200har2~
@9471  = ~0200har3~
@9472  = ~0200dab5~
@9473  = ~0200har4~
@9474  = ~0200har5~
@9475  = ~0200har6~
@9476  = ~0200har7~
@9477  = ~0200twn1~
@9478  = ~0200twn2~
@9479  = ~0200twn3~
@9480  = ~0200twn4~
@9481  = ~0200twn5~
@9482  = ~0200twn6~
@9483  = ~0200strk~
@9484  = ~0200twn7~
@9485  = ~0200twn8~
@9486  = ~0200dm1~
@9487  = ~0200dm2~
@9488  = ~0200dm3~
@9489  = ~0200dm4~
@9490  = ~0200dm5~
@9491  = ~0200dm8~
@9492  = ~0200dm9~
@9493  = ~0200df1~
@9494  = ~0200df2~
@9495  = ~0200df5~
@9496  = ~0200mrn1~
@9497  = ~«Добро пожаловать в „Горящий труп“!»~
@9498  = ~0200mrn2~
@9499  = ~«Кажется, это и вправду больно».~
@9500  = ~0200mrn3~
@9501  = ~0200mrn4~
@9502  = ~0200mid~
@9503  = ~0200thgv~
@9504  = ~«Не купишь девушке выпить, парень в шрамах?»~
@9505  = ~«Если привыкнуть к запаху, это не самое плохое место, чтобы позависать».~
@9506  = ~«Ты бестолочь?»~
@9507  = ~«Пришёл посмотреть, как он горит?»~
@9508  = ~«Вечером здесь несколько безжизненно… хоть и не так, как в Мортуарии».~
@9509  = ~«Для рождённого на планах Сигил — просто большой крысятник».~
@9510  = ~«Думаешь, какая-то из сил вправду найдёт его важным?»~
@9511  = ~«Что ты имеешь в виду?»~
@9512  = ~«Какое это имеет отношение к Сигилу?»~
@9513  = ~«Это место, которое люди считают важным. Мы ничтожны в рамках великой схемы. Мы крысы».~
@9514  = ~«Нет. Это ТЫ крыса. Планы дают тебе возможность стать настолько великим, насколько пожелаешь. Очевидно, ты этого не хочешь».~
@9515  = ~«Не знаю, зачем я вообще утруждаю себя разговором с тобой».~
@9516  = ~«Как и я».~
@9517  = ~«Проклятье. Эта часть не подходит».~
@9518  = ~«На помощь! Кто-нибудь, помогите!»~
@9519  = ~«Прыгай, лим-лим, прыгай!»~
@9520  = ~«Вооружённый гуляка — *живой* гуляка!»~
@9521  = ~«Холодная сталь, острая как бритва! Всего несколько медяков!»~
@9522  = ~«Сталь лучше, чем у Боготов!»~
@9523  = ~«Лучшая сталь во всём Сигиле!»~
@9524  = ~«Они могут прыгать на пятнадцать футов, если их тыкать горячими углями!»~
@9525  = ~«Смотри, как эти восхитительные создания танцуют и скачут!»~
@9526  = ~«Посмотри на резвящихся лим-лимов!»~
@9527  = ~«Оловянные кружки!»~
@9528  = ~«Медные тарелки! Оловянные чашки!»~
@9529  = ~«Ешьте с посуды для знати!»~
@9530  = ~«Пейте из бокалов богатейших господ!»~
@9531  = ~«Блюда! Кувшины! Чашки! Кружки!»~
@9532  = ~«Такие цены, просто отпад!»~
@9533  = ~«Выгодная торговля, честные сделки!»~
@9534  = ~«Не тратьте времени на этих жуликов и врунов!»~
@9535  = ~«Лучший товар во всём Сигиле!»~
@9536  = ~«Свежие рыбьи головы!»~
@9537  = ~«Све-е-ежая ры-ы-ы-ыбка!»~
@9538  = ~«Рыбьи головы!»~
@9539  = ~0100dab4~
@9540  = ~0100dab3~
@9541  = ~0100dab2~
@9542  = ~0100dab1~
@9543  = ~«Гискорл продаёт одежду, покупает одежду».~
@9544  = ~«Гискорл стирает одежду, носит одежду».~
@9545  = ~«Гискорл продаёт одежду, покупает одежду».~
@9546  = ~«Я, Гискорл».~
@9547  = ~«Потрать медяки ради острых ощущений!»~
@9548  = ~«Пиршество королей за жалкие медяки!»~
@9549  = ~«Образцы травок и приправок поразят ваш язык!»~
@9550  = ~«Зерно из Байтопии! Специи из Лимбо!»~
@9551  = ~«Арборейские огненные семена! Фрукты из Элизиума!»~
@9552  = ~«Лучшие травы, приправы, фрукты — никуда ходить не надо!»~
@9553  = ~Одержимое тело поёт, подпрыгивая и кружась, тембр и громкость голоса повышаются и понижаются случайным образом: «ТЫ есть ДУХ Я есть ЖИВУЩИЙ, ты БУДЕШЬ отвечать на мои вопросы!» Кажется, твоё обескураженное выражение его удовлетворяет; он запускает костистые пальцы в рот и растягивает его в дьявольской улыбке, разражается безумным хохотом и вываливает одутловатый белый язык.~
@9554  = ~Кажется, дух на миг успокаивается, затем разражается потоком оглушающей бессмыслицы. Какофония почти сводит тебя с ума, ты вот-вот бухнешься на колени. И так же внезапно, как началось… всё прекращается. Труп стоит перед тобой, чуть подёргиваясь.~
@9555  = ~Дух заводит старую песню: «На вопросы ЖИВУЩИХ должен МЁРТВЫЙ ответить; ТАК было и будет ВПРЕДЬ. Ты на вопросы мои ОТВЕТИШЬ!» Кажется, выражение твоего лица его дико радует, он бешено скачет; удивительно, как тело может это выдержать и не развалиться. Ты почти что слышишь хруст и треск костей, звук рвущихся связок во время бешеных скачков.~
@9556  = ~Когда дух покидает тело, рот растягивается в понимающей улыбке. Дикие, сверкающие глаза пронзают тебя взором психопата, и он шепчет одно слово, тщательно выговаривая его, будто перебирая жемчужное ожерелье: «Лимбо…»~
@9557  = ~…и с тем пропадает, оставив тебя в расстроенных чувствах. Зомби возвращается к работе.~
@9558  = ~Оставить дух в покое.~
@9559  = ~«Хорошо… задавай свои вопросы».~
@9560  = ~«Нет. *Я* буду спрашивать *тебя*…»~
@9561  = ~Оставить безумный дух в покое.~
@9562  = ~«Я не совсем уловил. Сделай одолжение, повтори».~
@9563  = ~«Не понимаю. Но я хочу спросить…»~
@9564  = ~«Я тебя не понимаю. Прощай».~
@9565  = ~«Хорошо… задавай свои вопросы».~
@9566  = ~«Ты не понимаешь. Я хочу спросить *тебя*…»~
@9567  = ~Махнуть рукой на психованного духа и уйти.~
@9568  = ~«Что?»~
@9569  = ~Не обращая внимания, отвернуться.~
@9570  = ~«*Ох-х*…»~
@9571  = ~0100dab7~
@9572  = ~0100dab6~
@9573  = ~0100dab5~
@9574  = ~0100dab4~
@9575  = ~0100dab3~
@9576  = ~0100dab2~
@9577  = ~::Бормочет::~
@9578  = ~~
@9579  = ~~
@9580  = ~~
@9581  = ~~
@9582  = ~~
@9583  = ~~
@9584  = ~~
@9585  = ~~
@9586  = ~~
@9587  = ~0100mhul~
@9588  = ~0100har5~
@9589  = ~0100har4~
@9590  = ~0100har3~
@9591  = ~0100har2~
@9592  = ~0100har1~
@9593  = ~0100dab8~
@9594  = ~0100dab7~
@9595  = ~0100dab6~
@9596  = ~0100dab5~
@9597  = ~0100tm1~
@9598  = ~0100thg4~
@9599  = ~0100thg3~
@9600  = ~0100thg2~
@9601  = ~0100thg1~
@9602  = ~0100dm1~
@9603  = ~0100cl4~
@9604  = ~0100cl3~
@9605  = ~0100cl2~
@9606  = ~0100cl1~
@9607  = ~0100flee~
@9608  = ~0100ba2~
@9609  = ~0100ba1~
@9610  = ~0100tf2~
@9611  = ~0100tf1~
@9612  = ~0100thg5~
@9613  = ~*Вздох*…~
@9614  = ~0100tm3~
@9615  = ~0100tm2~
@9616  = ~Уйти.~
@9617  = ~«Пожалуйста, кто-нибудь! Моя сестра…»~
@9618  = ~«Умоляю, помогите! Умоляю!»~
@9619  = ~«Приве-е-е-ет, здоровяк…»~
@9620  = ~«Ао-о-о-о-о-о-о-о»~
@9621  = ~«Ау-у-у-у-у-у-у»~
@9622  = ~«А-o-o-o-o-o»~
@9623  = ~«Ар-ру-у-у-у»~
@9624  = ~*Ик*~
@9625  = ~«Хи-хи-хи-и-и-и…»~
@9626  = ~«Пачиму эти у-у-улицы как в тума-а-ане?..»~
@9627  = ~«Ого… земляа-а прям ве-е-ертится…»~
@9628  = ~*Ик*~
@9629  = ~«Пачиму эти у-у-улицы как в тума-а-ане?..»~
@9630  = ~«Ш-ш-што? Э-э-эх… ничего-о-о…»~
@9631  = ~«Ну-у-у-у… крыша еде-е-е-ет…»~
@9632  = ~::Бормочет::~
@9633  = ~::Ворчит::~
@9634  = ~«На помощь!»~
@9635  = ~«На помощь, кто-нибудь, помогите!»~
@9636  = ~«Надо вырвать эту штуку…»~
@9637  = ~«Ты-ы тру-упак?»~
@9638  = ~«Гол-ло-о-одный».~
@9639  = ~«У-у-ух-х…»~
@9640  = ~«Хи-хи-хи…»~
@9641  = ~*Ик*~
@9642  = ~Он говорит медленным монотонным голосом, в котором сквозит безнадёжность; даже сейчас он почти неотличим от бездушного зомби: «Что вы хотите знать, милорд?»~
@9643  = ~Дух говорит так тихо, что ты с трудом улавливаешь смысл; рот трупа едва шевелится, вымучивая каждое слово: «Я — никто, милорд; жалкая букашка, отчаянно цепляющаяся за Опустошённую Башню Оиноса. Когда-то меня звали Арабим, хотя… это было так давно, милорд».~
@9644  = ~«Я жил в Сигиле, милорд. В Улье. Это оказалось не такое уж ужасное место, как я когда-то думал. Теперь мой дом… Оинос», — труп моргает так медленно, что на какой-то миг ты думаешь, будто он просто закрыл глаза.~
@9645  = ~«Я был убит грабителями, милорд. Напился вусмерть и шатался по переулкам Улья, потерялся и, наверное, наткнулся на банду головорезов. Так часто бывает. Моя жизнь, вероятно, стоит меньше, чем несколько медяков, которые Сборщик мог выручить за мой труп».~
@9646  = ~Дух на миг закрывает глаза, а тело слегка вздрагивает: «Ужасный Оинос, милорд. На Серой Пустоши. Там заточена моя душа, в тени Кхин-Ойна, Опустошённой Башни».~
@9647  = ~«Таков мой удел, милорд. Навечно заточён я в губительных пустошах Оиноса. Для таких, как я, нет надежды», — кажется, дух от отчаяния становится ещё более жалким, плечи трупа поникают под тяжестью страданий.~
@9648  = ~«Очень мало, милорд, только то, что мёртвых приносят сюда для похорон или кремации… или чтобы они служили здесь рабочими, как случилось с моим телом».~
@9649  = ~Труп медленно качает головой из стороны в сторону: «Нет, милорд. Я не знал никого с таким именем. Прошу прощения, милорд».~
@9650  = ~«Мало что можно сказать, милорд. Это земли моего Хозяина, Владыки Кхин-Ойна… в них царят страдания и болезни, гниение поражает тело и душу. Это место крайней безысходности».~
@9651  = ~«Да, милорд. Скверное место, но Оинос ужаснее».~
@9652  = ~«Да, милорд. Это величественная башня, намного больше крупнейших зданий Сигила. Она похожа на кость, милорд, как будто позвонок какого-то колоссального существа. Там я тружусь, чиню повреждения, нанесённые армиями врагов Хозяина, мятежных принцев».~
@9653  = ~«Я знаю его только как Хозяина, милорд; он — Владыка Кхин-Ойна. Он принц извергов — ультралот ужасающей силы. Ему принадлежит моя душа, и принадлежит навечно, ничтожная пылинка под его ногами пока вечность не канет в Забвение».~
@9654  = ~«Да, милорд, Сборщик. Один из тех, кто собирает мёртвые тела по Сигилу и приносит их в Мортуарий — где мы сейчас находимся — за небольшую плату», — дух окидывает взглядом окружающую обстановку, затем тихо вздыхает.~
@9655  = ~«Я не буду говорить об этом, милорд. Не стоит оно обсуждения», — похоже, в этом дух непоколебим.~
@9656  = ~Ты не осознаёшь, что дух покинул тело, пока зомби шаркающей походкой не возвращается к своей работе.~
@9657  = ~Оставить дух в покое.~
@9658  = ~«Кто ты?»~
@9659  = ~«Откуда ты?»~
@9660  = ~«Как ты попал сюда? В смысле, в виде зомби».~
@9661  = ~«Где ты… то есть где сейчас находится… твой дух?»~
@9662  = ~«Почему ты говоришь с таким отчаянием?»~
@9663  = ~«Что ты знаешь об этом месте?»~
@9664  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@9665  = ~«Ничего, неважно».~
@9666  = ~«Опустошённая Башня?»~
@9667  = ~«Оинос?»~
@9668  = ~«Я хочу спросить о другом…»~
@9669  = ~«Я узнал всё, что мне нужно. Прощай».~
@9670  = ~«Улей?»~
@9671  = ~«Оинос?»~
@9672  = ~«Я хочу спросить о другом…»~
@9673  = ~«Это всё, что я хотел узнать. Прощай».~
@9674  = ~«Почему такое низкое мнение о своей жизни?»~
@9675  = ~«Сборщик?»~
@9676  = ~«Я хочу спросить о другом…»~
@9677  = ~«Это всё, что я хотел узнать. Прощай».~
@9678  = ~«Расскажи мне больше об этом… Оиносе».~
@9679  = ~«Кхин-Ойн?»~
@9680  = ~«Я хочу спросить о другом…»~
@9681  = ~«Я узнал всё, что мне нужно. Прощай».~
@9682  = ~«Оинос?»~
@9683  = ~«Ясно. Я хотел спросить о другом…»~
@9684  = ~«Это всё, что я хотел узнать. Прощай».~
@9685  = ~«Ясно. Ещё вопрос…»~
@9686  = ~«Я узнал всё, что мне нужно. Прощай».~
@9687  = ~«Не за что. Я хотел спросить о другом…»~
@9688  = ~«Тогда прощай».~
@9689  = ~«Кто этот… „Хозяин“?»~
@9690  = ~«Кхин-Ойн?»~
@9691  = ~«Я хочу спросить о другом…»~
@9692  = ~«Похоже, именно так и есть. Прощай, дух».~
@9693  = ~«Оинос?»~
@9694  = ~«Я хочу спросить о другом…»~
@9695  = ~«Это всё, что я хотел узнать. Прощай».~
@9696  = ~«Кто этот „Хозяин“?»~
@9697  = ~«Ясно. Я хотел спросить о другом…»~
@9698  = ~«Ясно. Теперь я покину тебя, дух, прощай».~
@9699  = ~«Расскажи мне об этом „Кхин-Ойне“».~
@9700  = ~«Я хочу спросить о другом…»~
@9701  = ~«Я узнал всё, что мне нужно. Прощай».~
@9702  = ~«Что ты знаешь о Мортуарии?»~
@9703  = ~«Ясно. У меня другой вопрос…»~
@9704  = ~«Это всё, что я хотел узнать. Прощай».~
@9705  = ~«Ладно. У меня другие вопросы…»~
@9706  = ~«Тогда прощай».~
@9707  = ~Ты видишь усталого старика с печатью печали на лице, уставившегося на высохшее дерево перед собой. Он бормочет себе под нос и теребит подбородок, словно пытаясь что-то придумать. Иногда он начинает горестно качать головой.~
@9708  = ~Это существо с телом барана и человеческим торсом. Витые рога растут из его косматой головы, шерсть выстрижена сложными узорами. В его волосы вплетены цветные бусинки, незатейливые украшения свисают с рогов. Кажется, оно тебя не заметило.~
@9709  = ~Этот приятель не обращает на тебя внимания, он поглощён перепалкой со стоящей рядом шлюхой.~
@9710  = ~Этот мужчина пьян в стельку. Он с трудом стоит, а уж на разговор можно и не надеяться. От него несёт перегаром, блевотиной и застоявшейся мочой.~
@9711  = ~Этот мужчина нетвёрдо покачивается взад-вперёд, на секунду принимает вертикальное положение и ухитряется изобразить слащавую кривую улыбку кому-то в районе твоего правого уха.~
@9712  = ~Этот мужчина с безумными глазами сутулится и издаёт низкое рычание. Похоже, не стригся он годами… его волосы вуалью скрывают глаза. У него длинные тонкие усы, лоснящиеся от жира и пота, кончики усов запутались в косматой бороде.~
@9713  = ~Тильдон~
@9714  = ~Саросса~
@9715  = ~Вонючка~
@9716  = ~Зомби-телохранитель~
@9717  = ~Бариаур~
@9718  = ~«Языкознание всегда вызывало во мне жгучий интерес. Когда я стал учёным, выяснилось, что я могу усваивать новые языки почти без труда».~
@9719  = ~«Это многое объясняет. Так ты не нашёл убийц?»~
@9720  = ~«Ясно. Позволь спросить тебя ещё кое о чём…»~
@9721  = ~«Я понял. Спасибо, что поговорил со мной. Прощай».~
@9722  = ~*Хр-р-ртьф-фу-у*~
@9723  = ~*Фу-у-у*~
@9724  = ~«Вот… гм… немного денег. Я принесу ещё… гм… позже».~
@9725  = ~«Лучше бы так и было. Или я снова пошлю его за тобой».~
@9726  = ~«Хм-мф».~
@9727  = ~::Глоток::~
@9728  = ~«Кажется, ты потерялся, уважаемый».~
@9729  = ~«Так как можно *использовать* тело после смерти?»~
@9730  = ~«Может быть, скоро другой появится…»~
@9731  = ~«Слышал, что в Мортуарии хранятся невостребованные трупы…»~
@9732  = ~«Эй, незнакомец… поговори немного со мной».~
@9733  = ~«Нелепый вздор…»~
@9734  = ~«Неужели ни одного *мужчины*?!»~
@9735  = ~«Чё, так все и бросите женщину в беде?»~
@9736  = ~«Хм-м-м. Посмотрим, будет ли эта деталь работать».~
@9737  = ~«Сучья бритвенная лоза…»~
@9738  = ~«Может, тута?..»~
@9739  = ~«Мож, где-та тута…»~
@9740  = ~«Интересно, фигли этот старый упырь собирается…»~
@9741  = ~«Хм-м-м… может, где-то под этим?..»~
@9742  = ~«Залез на мой участок, ты, ублюдок…»~
@9743  = ~«Тута ничего…»~
@9744  = ~«Без понятия. Я уже хорошо пропёкся, пока его остановили, если ваще пытались. Вроде бы кто-то за ним погнался, када всё началось, орали его имя… э-э… о! Игнис вроде его звали. Игнис. Или как-то так. Сильно надеюсь, этот ублюдок сидит глубже в жопе, чем я!»~
@9745  = ~«Это всё, что я хотел узнать. Прощай».~
@9746  = ~«Это всё, что я хотел узнать. Прощай».~
@9747  = ~«Ясно. У меня ещё вопросы…»~
@9748  = ~«Это всё, что я хотел узнать. Прощай».~
@9749  = ~Зомби стоит неподвижно. Ты ясно видишь пятно на его плече, там, где ты мог написать её имя.~
@9750  = ~Зомби немедленно делает жест рукой (туда, где находится эта несчастная Ксикси).~
@9751  = ~Зомби стоит неподвижно.~
@9752  = ~~
@9753  = ~~
@9754  = ~~
@9755  = ~~
@9756  = ~~
@9757  = ~~
@9758  = ~~
@9759  = ~~
@9760  = ~~
@9761  = ~~
@9762  = ~~
@9763  = ~~
@9764  = ~~
@9765  = ~~
@9766  = ~«Хм-м. Ты можешь похоронить имя для меня?»~
@9767  = ~«Сегодня никаких имён. Прости, что потревожил тебя».~
@9768  = ~«Квентин».~
@9769  = ~«Хм-м-м… Эс-Аннон».~
@9770  = ~«У меня нет ни… гроша. Может, в другой раз».~
@9771  = ~«Эс-Аннон».~
@9772  = ~«Э-э… „Адан“?»~
@9773  = ~Судя по виду, эта башня была построена для сбора дождевой воды.~
@9774  = ~К этой доске пришпилено несколько крысиных хвостов.~
@9775  = ~Эта чаша воняет кровью и дохлыми крысами.~
@9776  = ~Похоже, это ржавое железное чудовище используется для взвешивания тушек крыс.~
@9777  = ~Похоже на часы, но нет ни чисел, ни стрелок.~
@9778  = ~На эту стену нанесён узор из колючих чёрных ветвей.~
@9779  = ~На татуировке изображён чёрный как ночь конь с мёртвыми белыми глазами и лопатками, ощетинившимися острыми шипами.~
@9780  = ~На рисунке изображена чернёная сфера, из которой шлейфом тянется чёрный туман.~
@9781  = ~Этот рисунок изображает несколько чёрных рек, чьи русла дробятся, пересекаются, затем снова сливаются.~
@9782  = ~На этом рисунке изображён полый зверь с крошечным демоном в голове.~
@9783  = ~На этих деревянных рамах растянута человеческая кожа, покрытая татуировками.~
@9784  = ~На этой стене нарисован горящий череп. Его окаймляют два символа двойственности.~
@9785  = ~На этом рисунке изображено нечто, похожее на тень, которая отбрасывает свою тень. По силуэту нельзя понять, женщина это или мужчина.~
@9786  = ~По-видимому, этот необычного вида стул предназначен для клиентов салона.~
@9787  = ~Необычное произведение… искусства.~
@9788  = ~Плита, сложенная из окаменевшего дерева.~
@9789  = ~Ты видишь красивого молодого человека в щегольской одежде. Похоже, он в крайнем восхищении.~
@9790  = ~«Приветствую».~
@9791  = ~Оставить его в покое.~
@9792  = ~До пьяного, похоже, с трудом доходит, что ты к нему обращаешься. Он оглядывается в недоумении, пытаясь определить источник голоса. Ты замечаешь, что Анна подкрадывается к нему сзади, скорее всего, нацелившись на кошелёк.~
@9793  = ~До пьяного, похоже, с трудом доходит, что ты к нему обращаешься. Он оглядывается в недоумении, пытаясь определить источник голоса.~
@9794  = ~Он поворачивается и смотрит на тебя раздражённо: «Смойся, пень. Мне нечего сказать таким, как ты». Он отворачивается.~
@9795  = ~«Гы, гы? Гы-ы? Ы-гы-гы-ы-ы!» — внезапно его рвёт фонтаном; ты отскакиваешь назад, чтобы не забрызгало. Видимо, от этого всклокоченного вонючего прожигателя жизни ты не добьёшься никакого толка.~
@9796  = ~«Гы, гы? Гы-ы? Ы-гы-гы-ы-ы!» — внезапно его рвёт фонтаном; вы с Анной отскакиваете назад, чтобы не забрызгало. Видимо, от этого всклокоченного вонючего прожигателя жизни ты не добьёшься никакого толка.~
@9797  = ~«Слушай, я просто хочу задать пару вопросов».~
@9798  = ~«Прости, что побеспокоил. Прощай».~
@9799  = ~Он снова поворачивается к тебе, здорово разозлившись на твоё вторжение: «Задвинься. Я пытаюсь наблюдать за процессом, а ты тут шкатулкой трясёшь. Смойся». Он снова отворачивается.~
@9800  = ~Хлопнуть его по плечу: «Хватит с меня такого отношения. Отвечай на вопросы, или попорчу тебе мордашку».~
@9801  = ~Она намеревается что-то сказать, но ты осаживаешь её тяжёлым взглядом раньше, чем она успевает выразить протест. Анна отвечает презрительной усмешкой, складывает руки на груди и хлещет хвостом.~
@9802  = ~Она просто делает вид, что не слышала, и роется во вшивой одежде мужчины, когда тот спотыкается. Убедившись, что у него ни медяка, Анна отвешивает ему лёгкого тумака и отворачивается: «Хе! Всё равно он совсем пустой. Грёбаные алкаши…»~
@9803  = ~Анна роется во вшивой одежде мужчины, когда тот спотыкается. Убедившись, что у него ни медяка, она отвешивает ему лёгкого тумака и отворачивается: «Хе! Он совсем пустой, грёбаный алкаш…»~
@9804  = ~«Очень хорошо. Прощай».~
@9805  = ~Он поворачивается к тебе с багровым от гнева лицом: «Ты не посмеешь! Я племянник самого…»~
@9806  = ~Оборвать его: «Да мне по сараю, чей ты там родственник, хоть самой Госпожи. Лучше пусть следующие слова из твоей „шкатулки“ будут „чем могу помочь“».~
@9807  = ~«У меня к тебе кое-какие вопросы…»~
@9808  = ~Оборвать его: «Неважно. Ты вряд ли стоишь таких усилий».~
@9809  = ~«У меня к тебе кое-какие вопросы…»~
@9810  = ~Молодой человек вот-вот взорвётся. Он быстро оглядывается, но не видит в толпе никакой поддержки: «Ч-чем могу помочь?»~
@9811  = ~Игнорировать его.~
@9812  = ~«Вот… теперь не такой уж крутой, правда? У меня к тебе кое-какие вопросы».~
@9813  = ~«Анна… нет».~
@9814  = ~С улыбкой: «Уже помог. Достаточно вот такого выражения твоей морды лица. Всего хорошего».~
@9815  = ~«Я слушаю».~
@9816  = ~«Анна… нет».~
@9817  = ~«Что происходит?»~
@9818  = ~«Кто тут главный».~
@9819  = ~Встряхнуть его как следует для привлечения внимания.~
@9820  = ~«Я ищу дэва. Говорят, он где-то в городе».~
@9821  = ~«Что тут новенького?»~
@9822  = ~«Не бери в голову. Прощай».~
@9823  = ~«Просто казнь. Вот и всё».~
@9824  = ~Оставить его в покое.~
@9825  = ~«Какое преступление он совершил?»~
@9826  = ~«Ясно. Следующий вопрос».~
@9827  = ~«Благодарю тебя. Прощай».~
@9828  = ~Встряхнуть его как следует для привлечения внимания.~
@9829  = ~«Не знаю. Спроси в городской управе».~
@9830  = ~Оставить его в покое.~
@9831  = ~«Хорошо. Так и сделаю. Ещё вопрос».~
@9832  = ~Оставить его в покое.~
@9833  = ~Он гадко улыбается: «Это мой дядя, Товус Гильяф».~
@9834  = ~Оставить его в покое.~
@9835  = ~Встряхнуть его как следует для привлечения внимания.~
@9836  = ~«Убери эту улыбочку, или я сам это сделаю».~
@9837  = ~Оставить его в покое.~
@9838  = ~Улыбочка быстро пропадает. Он хмуро смотрит на тебя и молчит.~
@9839  = ~«Так-то лучше. Ещё вопрос».~
@9840  = ~Встряхнуть его как следует для привлечения внимания.~
@9841  = ~«Пожалуй, с тебя хватит. Прощай».~
@9842  = ~Оставить его в покое.~
@9843  = ~«И тебе также всего хорошего. Я расскажу о тебе моему дядюшке… красавчик», — его внимание снова переключается на толпу.~
@9844  = ~Уйти.~
@9845  = ~«Смотри не забудь».~
@9846  = ~Он смотрит на тебя презрительно: «Хмф. Дэв в Керсте. Это нечто такое, чего не каждый день увидишь. Либо ты ошибся, либо у тебя не все дома».~
@9847  = ~«Хорошо, следующий вопрос».~
@9848  = ~«Хорошо. Прощай».~
@9849  = ~Он пожимает плечами: «Насколько я знаю, ничего».~
@9850  = ~«Ясно. Может, расскажешь мне ещё кое о чём».~
@9851  = ~«Тогда прощай».~
@9852  = ~Ты видишь грубого вида мужчину с обветренной кожей. Он мрачен и тебя не замечает.~
@9853  = ~«Приветствую».~
@9854  = ~Не обращать на него внимания.~
@9855  = ~Он медленно кивает, но только бульканье вырывается из его горла, а из угла рта на грязную всклокоченную бороду стекает тонкая струйка зелёной слюны. Похоже, он с трудом держится на ногах, а говорить уж тем более не способен.~
@9856  = ~~
@9857  = ~При звуке твоего голоса он подпрыгивает и быстро поворачивается к тебе. Его лицо наливается кровью, а дыхание учащается.~
@9858  = ~~
@9859  = ~«Немножко нервничаешь, да?»~
@9860  = ~«Пардон, шеф… ты вытряхнешь из бедняги душу раньше, чем разбудишь!»~
@9861  = ~«Прошу прощения, что напугал. У меня к тебе пара вопросов».~
@9862  = ~«Прости, что потревожил. Прощай».~
@9863  = ~Он злобно хмурит брови и вытаскивает из-за спины кинжал: «Слышь, пень! Гуляй отсюдова или в книге мёртвых пропишешься».~
@9864  = ~«Приветствую…»~
@9865  = ~«Остынь. Я просто хочу спросить».~
@9866  = ~Оставить его в покое.~
@9867  = ~«Не бери в голову… прощай».~
@9868  = ~«Убери нож, или я тебя же им и прирежу».~
@9869  = ~~
@9870  = ~«Как хочешь. Прощай».~
@9871  = ~~
@9872  = ~Он встаёт в защитную стойку и размахивает перед тобой клинком: «Обойдёшься. Нечего мне тебе сказать. Пшёл вон!»~
@9873  = ~«Убери нож, или я тебя же им и прирежу».~
@9874  = ~«Ладно. Прощай».~
@9875  = ~Он хохочет тебе в лицо, поигрывая ножом: «Так иди сюда. Выпотрошу и поржу, пока ты дохнешь!»~
@9876  = ~Напасть на него.~
@9877  = ~~
@9878  = ~«Неважно. Прощай».~
@9879  = ~~
@9880  = ~Он просто не знает, что сказать, такое у тебя создаётся впечатление. Твоё замечание явно застало его врасплох. «Ну, э-э… я просто задумался, здоровяк. Чё те надо?» — он настороженно на тебя смотрит.~
@9881  = ~~
@9882  = ~«Ты прав, Морте, пошли отсюда».~
@9883  = ~«Просто ответь на пару вопросов. Хорошо?»~
@9884  = ~«Вообще-то ничего. Прощай».~
@9885  = ~Секунду он смотрит на тебя, затем нервно оглядывается по сторонам: «Один вопрос, потом ты свалишь. Нету у меня ни времени, ни желания».~
@9886  = ~«Я ищу дэва. Как понимаю, он в Керсте».~
@9887  = ~«Кто тут всем заправляет?»~
@9888  = ~«Расскажи местные новости».~
@9889  = ~«Чем ты тут занимаешься?»~
@9890  = ~«Куда бы ты пошёл, если бы тебе нужны были достоверные ответы на вопросы?»~
@9891  = ~«Не бери в голову. Всего хорошего».~
@9892  = ~Он насмешливо смотрит на тебя: «Ага, конечно. Один из этих мудил „святее-чем-ты“ ходит по улицам Керста. У тебя не все дома, здоровяк. Я тебе ответил, отвали». Он отворачивается и уходит.~
@9893  = ~Уйти.~
@9894  = ~«Товус Гильяф. Он в управе, на городской площади, — он машет рукой в неясном направлении. — Я тебе ответил, исчезни». Он отворачивается и уходит.~
@9895  = ~Уйти.~
@9896  = ~Он на миг задумывается. «Я не в курсе, здоровяк… сплетен не слушаю. Иди во „Врата предателей“, вот там всем кости перемывают, — он машет рукой куда-то в сторону. — Я тебе ответил, отвали». Он отворачивается и уходит.~
@9897  = ~Уйти.~
@9898  = ~Он смеётся тебе в лицо: «Ничем, что тебе нужно знать, пень. Я тебе ответил, сдрисни». Он отворачивается и уходит.~
@9899  = ~Уйти.~
@9900  = ~Осклабившись, он смеётся тебе в лицо. «Хороший вопрос. А ты всё-таки умён, здоровяк, — на миг он задумывается, затем внимательно смотрит на тебя. — Будь я на твоём месте, я б побазарил с Шар. Она шляется по улицам вокруг, найти несложно. Если будешь с ней милым, она поможет. Я тебе ответил, мотай отсюдова». Он отворачивается и уходит.~
@9901  = ~Уйти.~
@9902  = ~Ты видишь мужчину в доспехе и с висящим на поясе мечом. Он настороженно смотрит, как ты приближаешься.~
@9903  = ~«Приветствую».~
@9904  = ~Оставить его в покое.~
@9905  = ~Он кивает тебе, затем быстро оглядывается по сторонам: «И тебе привет. Что нужно?»~
@9906  = ~«Я хотел бы задать пару вопросов».~
@9907  = ~«Не бери в голову».~
@9908  = ~«Я недавно в Керсте, так что вряд ли смогу ответить. Но попробую».~
@9909  = ~«Не слышал о дэве, который может быть в городе?»~
@9910  = ~«Если не секрет, почему ты в Керсте?»~
@9911  = ~«Неважно».~
@9912  = ~Он смотрит на тебя с удивлением: «Дэв… нет, не могу сказать, что слышал. Что тут терять дэву? В этом мало смысла, если вообще есть».~
@9913  = ~«Ну… да. А ты почему в Керсте?»~
@9914  = ~«Понятия не имею, Мне нужно идти».~
@9915  = ~«Хорошо, удачи тебе. Прощай».~
@9916  = ~«И тебе».~
@9917  = ~«Я наёмник. Прослышал, что в Керсте есть работа, и пришёл наниматься. Но большая часть этого проклятого города на карантине из-за эпидемии. Я не могу попасть туда, куда мне надо».~
@9918  = ~«Что ты знаешь об эпидемии?»~
@9919  = ~«А куда тебе надо?»~
@9920  = ~«Ясно. Я должен распрощаться».~
@9921  = ~Он пожимает плечами: «На самом деле ничего. Говорят, она вспыхнула внезапно, но её быстро взяли под контроль, опечатав заражённые районы города». Он вздыхает: «Грёбаное невезение. Я не могу прийти на условленную встречу».~
@9922  = ~«А куда тебе надо?»~
@9923  = ~«Спасибо. Мне пора идти».~
@9924  = ~«„Четвертованный“. Эта пивная — место сбора наёмников, но в ту часть города сейчас не попасть».~
@9925  = ~«Ясно. Мне пора идти».~
@9926  = ~Оставить его в покое.~
@9927  = ~Он оглядывает тебя с головы до ног, прежде чем ответить на приветствие: «И тебе привет, здоровяк. Чего надо?»~
@9928  = ~«Я хотел бы задать пару вопросов».~
@9929  = ~«Неважно. Прощай».~
@9930  = ~Некоторое время он смотрит на тебя в упор, затем фыркает от смеха: «Ничего не знаю, ничего не вижу и ничего не слышу. Так что ничего и не отвечу. А теперь смойся, или врежу».~
@9931  = ~«С тобой же ничего не случится, если просто ответишь на пару простых вопросов, а?»~
@9932  = ~«Если мне придётся выколотить из тебя ответы, я нисколько не задумаюсь».~
@9933  = ~«Ладно. Всего хорошего».~
@9934  = ~Он хмуро на тебя смотрит: «Мне нечего тебе сказать, пень. Это твой последний шанс убраться отсюда целеньким».~
@9935  = ~«Если мне придётся выколотить из тебя ответы, я нисколько не задумаюсь».~
@9936  = ~«Ладно, всего хорошего».~
@9937  = ~Он снова осматривает тебя с головы до ног, останавливая взгляд на шрамах, затем дарит приветливую улыбку: «Хорошо, тебя так просто не запугаешь. С такими можно говорить. Что тебе нужно?»~
@9938  = ~«Всего лишь ответы на кое-какие вопросы».~
@9939  = ~«Неважно».~
@9940  = ~Он пожимает плечами: «Конечно, спрашивай».~
@9941  = ~«Я ищу дэва. Я слышал, что он в Керсте».~
@9942  = ~«Что ты можешь рассказать мне о Керсте?»~
@9943  = ~«Кто тут всем заправляет?»~
@9944  = ~«Что происходит в городе?»~
@9945  = ~«Неважно. Прощай».~
@9946  = ~Он фыркает: «Это вряд ли, здоровяк. Что-то не вижу я дэва, направляющего свои стопы в эту дыру… если только он не захочет искоренить саму память о ней. Думаю, ты зря тратишь своё время».~
@9947  = ~«Ясно. Ещё вопрос».~
@9948  = ~«Что ты имеешь в виду?»~
@9949  = ~«Спасибо. Прощай».~
@9950  = ~Он пожимает плечами: «Я слышал, некоторые пни называют дэвов ангелами. Керст не такой город, в котором можно застукать „ангела“. Не та сторона Кольца».~
@9951  = ~«Какого ещё кольца?»~
@9952  = ~«Ясно. Ещё вопрос».~
@9953  = ~«Кольца Внешних планов. На одной стороне порядок, на другой хаос, а между ними — добро и зло. Только вчера появился или как?» — он смотрит на тебя с недоумением.~
@9954  = ~«Можно сказать и так. Я хочу спросить о другом».~
@9955  = ~«Неважно. Прощай».~
@9956  = ~Он пожимает плечами и улыбается: «Тут славное местечко для правильных парней. Всё зависит от тебя и от того, кого ты знаешь».~
@9957  = ~«И кого, по твоему мнению, мне стоит знать?»~
@9958  = ~«Хорошо, ещё вопрос».~
@9959  = ~«Ясно. Ну, мне пора идти».~
@9960  = ~Он на миг задумывается. «Громилы типа тебя интересуются „Вратами предателей“. Это такой кабачок, держит его мужик по имени Пятнистый Барс, — он улыбается. — Не говори ему, что тебя послал я».~
@9961  = ~«Как его найти?»~
@9962  = ~«Ясно. Ещё вопрос».~
@9963  = ~«Спасибо. Прощай».~
@9964  = ~Он пожимает плечами. «Точно не скажу. Думаю, куда-то туда, — он указывает направо от тебя. — Просто иди и увидишь».~
@9965  = ~«Хорошо. Ещё вопрос».~
@9966  = ~«Прощай».~
@9967  = ~«Товус Гильяф. Его можно найти на городской площади возле управы».~
@9968  = ~«Что ты можешь рассказать об этом Товусе?»~
@9969  = ~«Ещё вопрос».~
@9970  = ~«Спасибо и всего хорошего».~
@9971  = ~«Я дел с ним не имел. Помимо того, что он вертит этим городишком, я только имя слышал», — он выглядит поскучневшим.~
@9972  = ~«Хорошо. У меня ещё вопрос».~
@9973  = ~«Всего хорошего».~
@9974  = ~Он со скучающим видом оглядывается по сторонам: «На самом деле ничего. Сейчас тут довольно тихо».~
@9975  = ~«Ясно. У меня ещё вопрос».~
@9976  = ~«Мне пора идти. Всего хорошего».~
@9977  = ~Ты видишь бедно одетого старика. Он замечает твой взгляд и пытается скрыться. Ты без труда догоняешь его.~
@9978  = ~«Приветствую».~
@9979  = ~Оставить его в покое.~
@9980  = ~Он выглядит, словно собирался убежать, но затем придумал кое-что получше. Его глаза стреляют во все стороны, но избегают останавливаться на тебе. Однако у тебя такое впечатление, что он в любой момент готов броситься бежать: «У меня ничего нет! Я ничего не сделал! Отпусти меня… прошу!»~
@9981  = ~«Успокойся. Я лишь хочу задать пару вопросов. Ладно?»~
@9982  = ~«Прости, что потревожил. Иди своей дорогой».~
@9983  = ~Его глаза в первый раз обращаются к тебе. Он оглядывает тебя с головы до ног, и его беспокойство крепнет: «Я… я помогу тебе, если смогу. Но, клянусь, я ничего не знаю… ничего, клянусь! Прошу, отпусти меня».~
@9984  = ~«Откуда ты знаешь, что не сможешь помочь, если я ещё ничего не успел спросить?»~
@9985  = ~«Хорошо. Иди».~
@9986  = ~Его глаза снова стреляют по сторонам, как если бы он отовсюду ожидал нападения. Он заламывает руки и бросает на тебя нервный взгляд, затем снова переводит внимание на улицы вокруг. «Э-э… я не хочу неприятностей, понимаешь? Поэтому я взял за правило ничего не знать, ясно? Потому и говорю, что ничем не могу помочь. Пожалуйста! Отпусти меня!» — пожалуй, он вот-вот заревёт от страху.~
@9987  = ~«Хорошо. Прости, что потревожил».~
@9988  = ~«Пф. Ничего не знаешь, задница? Мне нужны ответы, и я получу их от тебя. Или морду расквашу».~
@9989  = ~«Слушай, я не хотел тебя так пугать. Я чем-нибудь могу помочь? Похоже, у тебя неприятности».~
@9990  = ~На его лице мелькает облегчение, и он пятится от тебя. Его глаза продолжают стрелять вокруг, наконец он срывается с места и убегает.~
@9991  = ~«Пожалуй, я начинаю понимать, что такое „псих“».~
@9992  = ~Его глаза стреляют по сторонам, он хнычет, утыкает голову в руки и с причитаниями валится на землю. Непохоже, чтобы от него можно было добиться хоть какого-то толку.~
@9993  = ~«Пожалуй, я начинаю понимать, что такое „псих“».~
@9994  = ~На его лице мелькает облегчение, и он пятится от тебя. Его глаза продолжают стрелять вокруг, затем их взгляд возвращается к тебе: «Ты… ты хочешь мне помочь? Мне, странник? Что потребуешь взамен, пень?»~
@9995  = ~«Да, я помогу. Никаких условий. Просто скажи, что тебе нужно».~
@9996  = ~Он осматривает тебя с головы до ног, затем оглядывается по сторонам. Затравленное выражение исчезает из его глаз, когда он снова поворачивает к тебе лицо: «Спасибо. Никто здесь не предлагает помощь таким, как я. Я… и не думал, что здесь мне кто-нибудь поможет… никогда. Спасибо… мне надо идти».~
@9997  = ~«Понятно. Прощай».~
@9998  = ~Ты видишь усталого мужчину средних лет. Заметив твой взгляд, он слегка склоняет голову в знак приветствия.~
@9999  = ~«Приветствую».~
@10000 = ~Оставить его в покое.~
@10001 = ~Он избегает встречаться с тобой взглядом и старательно разглядывает землю под ногами: «Добрый день, здоровяк. Чем могу помочь?»~
@10002 = ~«Можешь на меня посмотреть, раз уж я к тебе обращаюсь».~
@10003 = ~«У меня кое-какие вопросы».~
@10004 = ~«Не бери в голову».~
@10005 = ~Он на миг поднимает взгляд, а затем опять смотрит в землю: «Я слуга, а потому не могу встречаться с тобой взглядом, здоровяк».~
@10006 = ~«Хорошо. Ты знаешь своё место, так и придерживайся его».~
@10007 = ~«Ну, мне ты не слуга, поэтому я хотел бы, чтобы ты смотрел на меня как на равного».~
@10008 = ~«Ладно. У меня кое-какие вопросы».~
@10009 = ~«Неважно. Прощай».~
@10010 = ~Он кивает головой, но взгляда не поднимает: «Да, здоровяк».~
@10011 = ~«Я ищу дэва. Говорят, он в Керсте. Ты его не видел?»~
@10012 = ~«Расскажи мне о Керсте».~
@10013 = ~«Что новенького?»~
@10014 = ~«Кто тут всем заправляет?»~
@10015 = ~«Забудь».~
@10016 = ~«Я не знаю ни о каком дэве, здоровяк. Не могу представить себе хоть одного даже в окрестностях Керста, не говоря уж о самом городе, — он на миг задумывается. — Я бы спросил в городской управе на площади. Они бы знали о таком госте».~
@10017 = ~«Спасибо. Но у меня ещё вопросы».~
@10018 = ~«Ты мне очень помог. Прощай».~
@10019 = ~«Мало что можно тут сказать, здоровяк. Керст — город-врата Внешних Земель. Здесь находятся врата в Карцери, они на городской площади… — он сосредоточенно морщит лоб. — Не думаю, однако, что эти врата ещё открыты. Карантин, понимаешь ли, чтобы эпидемия не распространялась…»~
@10020 = ~«Эпидемия?»~
@10021 = ~Тон твоего голоса вынуждает его начать суетливо объясняться: «Да, здоровяк, но не бойся за себя. Заражённые районы отгорожены карантином, всё под контролем».~
@10022 = ~«Э-э… ладно. Тогда у меня ещё вопросы».~
@10023 = ~«Ты мне очень помог. Прощай».~
@10024 = ~«Нового?.. Ну, я слышал, скоро будет казнь… другая, не эта. Ничего больше в голову не приходит, здоровяк».~
@10025 = ~«Кого казнить будут и за что?»~
@10026 = ~«Хорошо. Я хочу спросить ещё кое о чём».~
@10027 = ~«Ясно. Спасибо за информацию. Прощай».~
@10028 = ~Он пожимает плечами: «Не знаю, здоровяк. Не тебя и не меня… так что какая разница?»~
@10029 = ~«…Думаю, никакой. У меня другие вопросы».~
@10030 = ~«Ясно. Мне пора идти. Прощай».~
@10031 = ~«Должно быть, городской глава Товус Гильяф. Его можно найти в городской управе на площади».~
@10032 = ~«Ясно. Что можешь рассказать об этом Товусе?»~
@10033 = ~«Большое спасибо. Я хочу спросить ещё кое о чём».~
@10034 = ~Он в первый раз на самом деле поднимает взгляд и встречается глазами с твоим: «Ничего, здоровяк. Совсем ничего. Если у тебя вопросы о его правлении, то его и спрашивай». И снова его взгляд упирается в землю.~
@10035 = ~«Хорошо, может быть, так и сделаю. Позволь задать другой вопрос».~
@10036 = ~«Ясно. Ну, мне пора идти. Прощай».~
@10037 = ~Ты видишь вороватого вида мужчину. При взгляде на него в голову приходит мысль, что он, быть может, положил глаз на стоящий рядом дом.~
@10038 = ~«Приветствую».~
@10039 = ~Оставить его в покое.~
@10040 = ~Он выглядит достаточно дружелюбно, отвечая на твоё приветствие: «И тебе добрый день». Затем он поворачивается и собирается уйти.~
@10041 = ~«Секундочку. Я хочу кое о чём спросить».~
@10042 = ~Дать ему уйти.~
@10043 = ~Он останавливается и поворачивается к тебе с дружеской улыбкой: «Конечно, и чем же я могу помочь?» Ты замечаешь его немного напряжённую позу. Твой натренированный взгляд подсказывает, что он готов выхватить спрятанное оружие.~
@10044 = ~«Ты просто смотрел на вон тот дом?»~
@10045 = ~«Я ищу дэва. Говорят, он в Керсте».~
@10046 = ~«Неважно».~
@10047 = ~Он глядит на тебя с некоторым удивлением: «Да нет же, на самом деле не смотрел. А что? Там что-то интересное?» Он поворачивается и начинает разглядывать означенный дом.~
@10048 = ~«Подойди ближе. Я же не дурак. Ты что-то замышляешь!»~
@10049 = ~«Неужели?»~
@10050 = ~«Неважно, я ошибся. У меня вопрос. Я ищу дэва, который может быть в городе».~
@10051 = ~«Извини, ошибся. Я пойду».~
@10052 = ~Он оглядывает тебя и, похоже, прикидывает, на что ты годишься. Затем делает ловкое движение рукой и глядит на тебя невинным взором. Взглянув вниз, ты замечаешь блеск монет в его рукаве: «Наверное, ты ошибся, друг. Я просто наслаждаюсь прогулкой в этот чудный день».~
@10053 = ~«Да, разумеется, ты прав. Прошу прощения… друг».~
@10054 = ~«Нет, я явно прав насчёт того, чем ты тут занят».~
@10055 = ~Он делает шаг вперёд и дружески хлопает тебя по спине, при этом ты чувствуешь, что твой кошелёк потяжелел: «Ну так прощай, друг. До новых встреч».~
@10056 = ~«Прощай».~
@10057 = ~Он мрачно смотрит на тебя: «Тогда я должен… удвоить усилия, чтобы убедить тебя в обратном. Да будет тебе известно, однако, что дальше я в своих попытках не зайду». Ещё одно ловкое движение, и ты видишь блеск монет в обоих его рукавах.~
@10058 = ~«Пожалуй, да. Уверен, ты просто наслаждаешься прогулкой, как и сказал».~
@10059 = ~«Нет, я знаю, что видел».~
@10060 = ~Он делает шаг вперёд и дружески хлопает тебя по спине, при этом ты чувствуешь, что твой кошелёк потяжелел: «Ну так прощай, друг. До новых встреч».~
@10061 = ~«Прощай».~
@10062 = ~Он хмурится и делает ловкое движение обеими руками — но теперь блеск золота в них сменяется блеском стали: «Сожалею, но мы не сошлись во мнениях».~
@10063 = ~«Скоро будешь жалеть ещё сильнее».~
@10064 = ~Он смотрит на тебя с удивлением: «Вообще-то… я нахожу это крайне необычным. Тут место явно не из тех, где можно встретить дэва. Однако, если это правда, стоит спросить в кабачке „Врата предателей“. Я так понимаю, там могут располагать информацией, которая тебе нужна».~
@10065 = ~«Спасибо, так и поступлю».~
@10066 = ~«Где мне найти это место?»~
@10067 = ~«Извини, друг, но сам я там не был, так что точно не знаю. Но ты в нужном районе. Просто осмотрись».~
@10068 = ~«Спасибо и прощай».~
@10069 = ~Вор несколько встревожен вашей новой встречей: «Да ладно, неужели мой старый приятель? Пришёл нанести мне новый визит? Ценю твою учтивость, но я тут пытаюсь работать, знаешь ли».~
@10070 = ~«Мне нужны деньги, а не разговоры».~
@10071 = ~Он хмуро глядит на тебя и становится очень серьёзным: «Слушай, друг. Однажды ты меня поймал, и я, как профессионал профессионалу, заплатил тебе, чтобы ты меня отпустил. Завязывай с этой темой, и останемся друзьями».~
@10072 = ~«Я ищу дэва. Говорят, один из них в Керсте».~
@10073 = ~«Извини, что потревожил, просто поздороваться хотел».~
@10074 = ~«Хорошо. Тогда я пошёл».~
@10075 = ~«Не думаю. Выкладывай золотишко, или я тебя прирежу».~
@10076 = ~«Сожалею, мы не сошлись во мнениях».~
@10077 = ~«Скоро будешь жалеть ещё сильнее».~
@10078 = ~«Ха! Всё ж ясно, как ишачьи сиськи! Любителей развелось в этом городе! — она поворачивается к тебе. — Ты его просёк верно. Он намылился кого-то обчистить».~
@10079 = ~«Пожалуй, ты права, Анна. Может, нам следует по этому поводу что-то предпринять».~
@10080 = ~Этот отвратно выглядящий мужчина быстро замечает, что привлёк твоё внимание: в секунду он оказывается рядом с тобой и толкает свой «товар». Он носит длинный деревянный шест, с которого свисают дюжины освежёванных и приготовленных крыс. Когда он начинает говорить, то указывает на них грубой, грязной рукой, обнажая в улыбке жёлтые, обломанные зубы: «Ого, здоровяк, как делишки? Какого сорта вку-у-усненькие крыски нужны тебе в этот чудный день?»~
@10081 = ~ПОДВЕСКА ЙЕМЕТА
Вес: 1

Подвеска Йемета названа в честь своего создателя, колдуна давних времён. Хотя могущество Йемета было велико, время начинало брать своё — он стал слабеть и дряхлеть. Кулон был изготовлен умирающим волшебником в качестве сосуда для душ. Душ, которые Йемет лично вырывал из умирающих смертных, дабы поддерживать свою слабеющую жизненную силу. В конце концов Йемет был убит в бою, полностью стёрт с лица земли, а кулон был утерян. Мудрецы говорили, что даже если он и будет найден, ни один из смертных не познает секретов его использования.

Ты уверен, что когда-то уже видел эту подвеску — а возможно, даже носил её.~
@10082 = ~~
@10083 = ~~
@10084 = ~~
@10085 = ~~
@10086 = ~~
@10087 = ~~
@10088 = ~~
@10089 = ~Ты видишь девушку в недорогой одежде, пахнущую дешёвыми духами и с нарисованной улыбкой. Она замечает, что ты на неё смотришь, и улыбается.~
@10090 = ~«Приветствую».~
@10091 = ~Не обращать на неё внимания.~
@10092 = ~Она подходит ближе, кладёт руку на твоё плечо, а другую заводит тебе за спину — и с улыбкой медленно проводит рукой от плеча вниз по твоей руке. «Ну же, разве ты не крут, здоровяк? Я люблю сильных мужчин, которые могут взять то, что им понравится, — внезапно она разворачивает тебя к себе. — Так скажи мне… чего ты хочешь?»~
@10093 = ~«Гм… просто ответов на вопросы».~
@10094 = ~«Неважно. Мне надо идти».~
@10095 = ~Она заглядывает тебе в глаза, а улыбка как будто становится ещё шире: «Я здесь не для бесед. Ты уверен, что хочешь именно этого?»~
@10096 = ~Эта женщина слишком уж напориста. Что-то не так.~
@10097 = ~«Ну… может, я и не прочь поразвлечься».~
@10098 = ~«Ну… может, я и не прочь поразвлечься».~
@10099 = ~«Неважно. Я должен идти».~
@10100 = ~Заподозрив неладное, ты отталкиваешь женщину — и тут чувствуешь рывок. Скосив глаза вниз, ты видишь её *пустую* руку, выскальзывающую из твоего кошелька. Она поспешно удаляется.~
@10101 = ~Схватить её.~
@10102 = ~Схватить её.~
@10103 = ~Отпустить её.~
@10104 = ~Ты ловко хватаешь её за запястье. Она борется, отчаянно пытается вырваться: «Отпусти меня, пень, или я крикну стражу!»~
@10105 = ~«Давай, кричи. Ты помрёшь раньше, чем кто-нибудь прибежит».~
@10106 = ~«Давай, кричи. Не думаю, что кто-нибудь в этом городе почешется».~
@10107 = ~Отпустить её.~
@10108 = ~Она пристально смотрит на тебя, затем перестаёт бороться: «Отпусти меня, прошу. Я не успела тебя обчистить, ты поймал меня раньше».~
@10109 = ~«Отдавай все свои деньги и можешь идти».~
@10110 = ~«Хорошо, но больше мне не попадайся. Поняла?»~
@10111 = ~Она кивает головой и лезет в кошелёк. Вынимает пригоршню монет и протягивает тебе: «Прошу, здоровяк. Если ты заберёшь мои медяки, мне будет нечего есть. Умоляю, просто отпусти меня».~
@10112 = ~Забрать деньги и отпустить её.~
@10113 = ~Забрать деньги и убить её.~
@10114 = ~Отпустить её.~
@10115 = ~Ты берёшь деньги и убираешь их в карман. Она ещё секунду глядит на тебя, затем поворачивается и медленно уходит.~
@10116 = ~Отпустить её.~
@10117 = ~Ты отпускаешь её и делаешь знак удалиться. Она секунду смотрит на тебя, затем одаривает слабой улыбкой: «Спасибо, здоровяк». Потом поворачивается и медленно уходит.~
@10118 = ~Уйти.~
@10119 = ~Ты пытаешься схватить её за запястье, но она проворнее. Она отпрыгивает и собирается бежать.~
@10120 = ~Напасть на неё.~
@10121 = ~Отпустить её.~
@10122 = ~Она выпускает тебя из объятий и с улыбкой пятится: «Извини, здоровяк. Я передумала. Всего хорошего». Она поворачивается и уходит.~
@10123 = ~Отпустить её.~
@10124 = ~Ты видишь немолодую уже женщину в дешёвой одежде. Она явно прилагает значительные усилия, чтобы казаться моложе и привлекательнее, чем есть. Подойдя ближе, ты замечаешь в воздухе запах дешёвого вина.~
@10125 = ~«Приветствую».~
@10126 = ~Не обращать на неё внимания.~
@10127 = ~Она поворачивается к тебе, её лицо полыхает от обилия выпитого. «О, приве-е-етик. Ищешь… компанию? — она улыбается, а затем, похоже, наконец обращает внимание, кто перед ней. — О-о-ох, ну и видок у тя. Что с тоб… с тобой?»~
@10128 = ~«Я надеялся получить ответы на пару вопросов».~
@10129 = ~«Не твоё дело».~
@10130 = ~«Неважно. Прощай».~
@10131 = ~Она наклоняется ближе и кладёт ладонь тебе на грудь: «Нет… нужды в вопросах. Нароешь медяков… покажу свой талант. Моя халупа совсем рядом. Пошли».~
@10132 = ~«Это не то, что мне нужно. Меня интересует информация».~
@10133 = ~«Сколько?»~
@10134 = ~«Неважно. Прощай».~
@10135 = ~Она кладёт руки на бедра. «Слу… слушай сюда, пень. Я на жизнь зарабатываю, сечёшь? Мож, ты малость попутал, но… разве я похожа на мудреца? Все ответы прямо здесь», — она распахивает объятия.~
@10136 = ~«Неважно. Прощай».~
@10137 = ~«Сколько?»~
@10138 = ~Она улыбается и хихикает. «О-о-о, вот это базар… пять монет, и я могу кричать, но никому не скажу…» — она выжидательно на тебя смотрит.~
@10139 = ~«Прости, у меня нет денег».~
@10140 = ~«Пошли…»~
@10141 = ~«Неважно. Прощай».~
@10142 = ~Она ведёт тебя в свою дыру. Через час вы возвращаетесь на улицу. «Приходи ещё… тебе понравится», — она улыбается и машет рукой на прощание.~
@10143 = ~«До свидания».~
@10144 = ~Она хмурится: «Эй ты… неча тут грубить. Если по-хорошему никак, я с тобой время проводить не буду. Пшёл!» Она отворачивается и уходит.~
@10145 = ~Оставить её в покое.~
@10146 = ~Ты видишь девушку в недорогом платье. Её корсаж определённо туже, чем следует, потому пышная грудь выступает наружу.~
@10147 = ~«Приветствую».~
@10148 = ~Не обращать на неё внимания.~
@10149 = ~Она окидывает тебя взглядом и принимает скучающий вид: «Ты малость неотёсан, как по мне. Думаю, тебе следует уйти, здоровяк».~
@10150 = ~«О чём ты?»~
@10151 = ~«Я только вопрос задать».~
@10152 = ~«Хм… да. Прощай».~
@10153 = ~Она бросает лукавый взгляд и склоняется к тебе: «Подумай вот о чём, пень. Какими делами я занимаюсь, как думаешь?» Она переводит взгляд на свой бюст, затем подмигивает: «Что-нибудь нравится?»~
@10154 = ~«Если ты не думаешь, что я тебе по вкусу, то зачем демонстрируешь свой „товар“?..» — ты не можешь подобрать подходящее слово для «товара».~
@10155 = ~«Я просто хотел задать пару вопросов».~
@10156 = ~«Да, и чего мне это будет стоить?»~
@10157 = ~«На самом деле нет. Я ухожу».~
@10158 = ~Она хихикает, затем выпрямляется: «Просто немного развлекаюсь, вот и всё. Чего-то хочешь?»~
@10159 = ~«Я просто хотел задать пару вопросов».~
@10160 = ~«Да, и чего мне это будет стоить?»~
@10161 = ~«На самом деле нет. Я ухожу».~
@10162 = ~Она бросает гневный взгляд: «Эй! Не вякай, пень. Я — лучшая из всех, кого ты когда-нибудь встречал на улицах».~
@10163 = ~«Прощай».~
@10164 = ~Она улыбается: «Ну и гуляй».~
@10165 = ~Она вздыхает и смотрит на тебя со скукой: «И что же ты хочешь знать?»~
@10166 = ~«Прощай».~
@10167 = ~«Я ищу дэва. Говорят, он в Керсте».~
@10168 = ~«Что новенького?»~
@10169 = ~«Кто тут всем заправляет?»~
@10170 = ~«Что можешь рассказать о Керсте?»~
@10171 = ~«Как тебя зовут?»~
@10172 = ~«Ничего. Прощай».~
@10173 = ~Она надувает губки и хмурит личико в раздумье. Потом улыбается: «Да, вспомнила. Он в тюрьме». Она снова хмурится: «Странное место для дэва, не кажется?»~
@10174 = ~«В тюрьме? Ты уверена?»~
@10175 = ~«Ясно. Могу я задать ещё один вопрос?»~
@10176 = ~«Спасибо, ты мне очень помогла. Прощай».~
@10177 = ~Она хмурится: «Конечно, уверена. Я слышала от одного из стражников. Этот заключённый дэв по-настоящему хорош. Землекопы расширяли тюрьму. Недавно они отвалили камень, а там он. Он очень хорошо сохранился».~
@10178 = ~«Хм-м. Увидеть его будет сложно».~
@10179 = ~«Другой вопрос».~
@10180 = ~«Прощай».~
@10181 = ~Она вытягивает руку и хитро улыбается: «Медяки? Медяки?»~
@10182 = ~Дать ей пару монет.~
@10183 = ~Ложь: «Извини, нет денег».~
@10184 = ~«Позволь спросить ещё кое о чём».~
@10185 = ~«Неважно. Прощай».~
@10186 = ~Она обольстительно улыбается, затем наклоняется вперёд, позволяя тебе снова созерцать её гигантский бюст. «Иди в бар „Врата предателей“ и там спроси. Тамошние тебе помогут», — она убирает монеты в корсет.~
@10187 = ~«Спасибо, так и сделаю. Позволь задать другой вопрос».~
@10188 = ~Она вздыхает и, надувшись, смотрит на тебя: «Должно быть, я спятила, но всё равно тебе скажу. Иди в бар „Врата предателей“ и там спроси. Тамошние тебе помогут».~
@10189 = ~«Спасибо, так и сделаю. Позволь задать другой вопрос».~
@10190 = ~«Ну… эпидемия наконец под контролем. Некоторые районы города на карантине. Закрыли даже врата в Карцери на городской площади», — она замолкает, задумавшись.~
@10191 = ~«Продолжай».~
@10192 = ~«Извини. Эпидемия?»~
@10193 = ~«Спасибо за помощь. Прощай».~
@10194 = ~«Дочка Пятнистого Барса пропала. Он вне себя от этого и ищет какого-нибудь головореза, который помог бы её найти».~
@10195 = ~«Продолжай».~
@10196 = ~«Кто такой этот Пятнистый Барс, и где его искать?»~
@10197 = ~«Спасибо. Прощай».~
@10198 = ~«Один бедолага сегодня останется без головы. Его казнят на городской площади. Мерзость какая, правда», — она хмурится и отводит взгляд.~
@10199 = ~«Продолжай».~
@10200 = ~«Что он натворил?»~
@10201 = ~«Спасибо, леди. Прощай».~
@10202 = ~Она на миг задумывается. «Больше ничего не знаю», — пожимает плечами она.~
@10203 = ~«Ты очень хорошо информирована. Я поражён».~
@10204 = ~«Если можно, я тебя ещё кое о чём спрошу».~
@10205 = ~«Спасибо тебе. Прощай, леди».~
@10206 = ~Она улыбается, подаётся вперёд и упирается взглядом в тебя. «Просто люди мне рассказывают. Не знаю уж почему», — она выпрямляется и хихикает.~
@10207 = ~«Хм… да, почему бы это. В любом случае у меня другие вопросы».~
@10208 = ~«Прощай».~
@10209 = ~«Да, но не волнуйся. Она под контролем, заражённые районы на карантине».~
@10210 = ~«Ясно. Продолжай».~
@10211 = ~«А эта эпидемия вспыхнула не в то самое время, когда открыли тюрьму дэва?»~
@10212 = ~«Мне пора идти. Прощай».~
@10213 = ~«Он хозяин бара „Врата предателей“. Это в дальнем конце той улицы», — она указывает вдоль улицы.~
@10214 = ~«Продолжай».~
@10215 = ~«Спасибо за помощь. Прощай».~
@10216 = ~Она на секунду мрачнеет и отводит взгляд. Затем пожимает плечами: «Точно не знаю. Никто из моих… связей мне не говорил».~
@10217 = ~«Продолжай».~
@10218 = ~«Ты очень мне помогла. Прощай».~
@10219 = ~Она хихикает. «Это, должно быть, Товус. Товус Гильяф. Он может быть иногда… несдержан, но всегда добр ко мне и хорошо платит, — она колеблется и, кажется, обдумывает то, что сказала. — Я не могу говорить о Товусе. Ты найдёшь его в городской управе, на площади».~
@10220 = ~«Хорошо, другой вопрос».~
@10221 = ~«Мне нужно идти».~
@10222 = ~«Керст… — она вздыхает и становится чуточку несчастной. — Этот город — клетка для одиноких. Те бедняги, которых ты видишь здесь, попали сюда из-за предательства и измены. Теперь они проживают день за днём, постоянно оглядываясь через плечо, никогда не зная, кому можно верить и кого называть другом».~
@10223 = ~«И ты в том числе?»~
@10224 = ~«Интересно. Пожалуй, я пойду».~
@10225 = ~Она с тоской смотрит вдаль. «Я сделала свой выбор и уже пожалела о нём. Теперь… — она снова поворачивается к тебе. — Если бы я могла дать тебе совет, он был бы таким: что бы ты ни делал в жизни, убедись, что сможешь простить сам себя».~
@10226 = ~«Я это запомню. Могу я задать другой вопрос?»~
@10227 = ~«Прощай».~
@10228 = ~Она снова осматривает тебя с головы до ног: «Ну… если ты обещаешь обращаться со мной хорошо и не бить… то десять монет».~
@10229 = ~«Заманчиво… но не прямо сейчас. Можно ещё спросить?»~
@10230 = ~«Извини, мне пора. Прощай».~
@10231 = ~Она морщит лоб в раздумье, затем некоторое время смотрит вдаль. Наконец она снова обращается к тебе: «Знаешь, никогда об этом не думала, но ты, пожалуй, прав. Эпидемия началась почти сразу после того, как его нашли».~
@10232 = ~«Ясно. Продолжай».~
@10233 = ~«Ты мне очень помогла. Прощай».~
@10234 = ~Она одаривает тебя ласковой улыбкой: «Я Шарлен, но все друзья зовут меня Шар».~
@10235 = ~«Чудное имя, Шар. Я хочу спросить о другом».~
@10236 = ~«Ты мне очень помогла. Прощай, Шар».~
@10237 = ~Погреб Пыльных~
@10238 = ~«У тебя мой глаз, верно? Я бы хотел его выкупить».~
@10239 = ~«Кто ты?»~
@10240 = ~«Что это за место?»~
@10241 = ~«Что ты можешь мне рассказать о здешних посетителях?»~
@10242 = ~«Я хочу выпить».~
@10243 = ~«Я ищу дневник».~
@10244 = ~«Я ищу Фарода, Сборщика».~
@10245 = ~«Опять вернулся? Сейчас чего надо?»~
@10246 = ~«Когда я говорил с тобой в первый раз, ты сказал: „Опять ты?“. Что ты имел в виду?»~
@10247 = ~«Ты говорил, что у тебя мой глаз. Я бы хотел получить его обратно».~
@10248 = ~«Кто ты?»~
@10249 = ~«Что это за место?»~
@10250 = ~«Что ты можешь мне рассказать о здешних посетителях?»~
@10251 = ~«Я хочу выпить».~
@10252 = ~«Больше у тебя не будет проблем с Мокаи».~
@10253 = ~«Я хочу выпить».~
@10254 = ~«Я ищу дневник».~
@10255 = ~«Я ищу Фарода, Сборщика».~
@10256 = ~«Что ты можешь мне рассказать о здешних посетителях?»~
@10257 = ~«Поторопись, ладно? У меня клиенты».~
@10258 = ~«Когда я говорил с тобой в первый раз, ты сказал: „Опять ты?“. Что ты имел в виду?»~
@10259 = ~«Ты говорил, что у тебя мой глаз. Я хочу его выкупить».~
@10260 = ~«Кто ты?»~
@10261 = ~«Что это за место?»~
@10262 = ~«Что ты можешь мне рассказать о здешних посетителях?»~
@10263 = ~«Я хочу выпить».~
@10264 = ~«Я позаботился о должнице».~
@10265 = ~«Я хочу выпить».~
@10266 = ~«Я ищу дневник».~
@10267 = ~«Я ищу Фарода, Сборщика».~
@10268 = ~«Аукционер Гильтспур хотел, чтобы ты повесил этот листок».~
@10269 = ~«Да, „опять ты“. У тебя проблемы со слухом или чего? Ты тут был лет пятнадцать назад, всё выжрал, разнёс заведение и заплатил меньше, чем стоило возместить ущерб. Тогда ты выдрал собственный глаз и сказал мне, что вернёшься его забрать, когда соберёшь две сотни. За пятнадцать лет с процентами набежало сотен пять. Гони бабки, приятель, тогда получишь свой глаз».~
@10270 = ~«Пять сотен? Это смешно!»~
@10271 = ~«Пять сотен? Это смешно!»~
@10272 = ~«Пять сотен? Хорошо. Вот».~
@10273 = ~«У меня столько нет».~
@10274 = ~«Сейчас не нужно. Лучше ответь мне на вопросы».~
@10275 = ~«Забудь. Прощай».~
@10276 = ~Он на миг замолкает, соображая. «Так и быть. Вот что скажу. Дай мне три сотни, и глаз твой».~
@10277 = ~«Это дело. Держи деньги».~
@10278 = ~«Всё равно для меня это много».~
@10279 = ~«Забудь. Лучше ответь мне на вопросы».~
@10280 = ~«Забудь. Я ещё приду».~
@10281 = ~«Такова цена. Плати или вали».~
@10282 = ~«Хорошо, беру».~
@10283 = ~«У меня столько нет».~
@10284 = ~«Забудь. Лучше ответь мне на вопросы».~
@10285 = ~«Я сваливаю. Прощай».~
@10286 = ~«По рукам», — он вынимает из кармана потемневшую, закупоренную воском широкогорлую бутылку. Ты слышишь внутри тяжёлый плеск жидкости. Когда открываешь бутылку, в нос бьёт резкая, тошнотворная вонь какого-то консерванта. Глаз плавает в липкой дряни. «Лучше соображай быстрее, что с ним делать… теперь ты выставил его на воздух, можно снова замариновать яичко в банке от греха подальше. Соображай, здоровяк… маринованное яичко или как?»~
@10287 = ~Вырвать собственный глаз и вставить в глазницу этот.~
@10288 = ~Вырвать собственный глаз и вставить в глазницу этот.~
@10289 = ~Вырвать собственный глаз и вставить в глазницу этот.~
@10290 = ~Наблюдать его разложение.~
@10291 = ~«Тогда ты свой глаз не получишь. Ясно? Сначала тащи медяки».~
@10292 = ~«Ладно. Тогда у меня к тебе вопросы».~
@10293 = ~«Хорошо. Прощай».~
@10294 = ~После секундного колебания ты запускаешь пальцы в глазницу и вырываешь оттуда глаз. Бармен приходит на помощь, отделяет зрительный нерв и направляет твою руку в банку с дрянью, стоящую на стойке. Ты помещаешь глаз в консервант, берёшь пальцами старый и вставляешь в пустую глазницу. Боль неописуемая. Однако мгновение спустя ты чувствуешь, что зрительный нерв подсоединился к новому глазу… и на тебя внезапно обрушивается лавина воспоминаний!~
@10295 = ~Впустить их.~
@10296 = ~Проблеск памяти: перед тобой расстилается хаотическая, ежесекундно меняющаяся пустошь, впереди маячит группа человекоподобных стервятников с грубым оружием наготове, и твой собственный сверкающий клинок крепко зажат в руке…

Проблеск памяти: тебя окружили трое в раскраске врага, но ты не можешь определить, какого именно. В их руках длинные кинжалы, а жутко оскаленные зубы отражают свет. Ты бросаешь взгляд на свои покрытые шрамами руки и понимаешь, что скоро они будут все в крови…

Проблеск памяти: гигантское, похожее на лягушку существо движется в твоём направлении над/среди/под хаотической материей, рот его полон острых зубов. Ты бросаешь копьё через движущуюся материю и прикалываешь существо к неведомо откуда взявшейся каменной плите… Ты восстановил часть утраченных боевых навыков.~
@10297 = ~Задать ещё вопросы Баркису.~
@10298 = ~Уйти.~
@10299 = ~Ты запускаешь руки в глазницу. Боль очень сильная, непередаваемая, внезапно она переполняет всё твоё тело. Ты падаешь на пол, истекая кровью из глазницы. Ты умираешь.~
@10300 = ~Такие дела.~
@10301 = ~«Ты хочешь его обратно? Плати пять сотен. Нету денег — и глаза не получишь».~
@10302 = ~«Пять сотен? Это смешно!»~
@10303 = ~«Пять сотен? Это смешно!»~
@10304 = ~«Пять сотен? Хорошо. Вот».~
@10305 = ~«У меня столько нет».~
@10306 = ~«Сейчас не нужно. Лучше ответь мне на вопросы».~
@10307 = ~«Забудь. Прощай».~
@10308 = ~«Я? Я — Баркис. Хозяин и содержатель этого заведения».~
@10309 = ~«Что это за заведение?»~
@10310 = ~«Тогда именно тебя я и хотел расспросить».~
@10311 = ~«Чудное местечко. Прощай».~
@10312 = ~«Ты не видел вывеску над входом? Не видел пня, который горит у входа? Это „Горящий труп“, здоровяк, самый лучший кабак в Сигиле. По крайней мере, в этой части Улья, а значит, точно один из лучших в Сигиле. Мать вашу, они разукрасили кабаки цветами, как в районе Госпожи, и насовали уродских кабаков в остальной части Улья, но ни один из них по репутации не сравнится с „Горящим трупом“».~
@10313 = ~«Ладно, а что за труп?»~
@10314 = ~«Ясно. Не расскажешь кое о чём другом?»~
@10315 = ~«Правда не так однозначна. Прощай».~
@10316 = ~«Он-то? Игнус. Когда-то был колдуном огня, сжёг часть Улья, и его замела толпа других магов. Хочешь узнать о нём побольше — спроси Друзиллу, вон там, у входа».~
@10317 = ~«Ладно. Но я хотел бы спросить о другом».~
@10318 = ~«Хорошо, обязательно. Прощай».~
@10319 = ~«Я не вмешиваюсь в жизни людей, которые отдают мне свои тяжким трудом доставшиеся медяки, если только сами не просят. Так. Вон там — Кандриан. Планарный странник. С ним хорошо поговорить о путешествии по планам — он везде побывал. Чуть дальше Эбб Скрипучие Колени, старый вояка из Гармониума — ты против него не устоишь — и проводник. У него доброе сердце, и он знает Сигил вдоль и поперёк. Вон те два изверга — Этельгрин и Тегар'ин. Мой тебе совет: не связывайся с ними. Может, они и мелкие шишки в своей иерархии, но всё-таки изверги. В той стороне Илквикс — НЕ ВЕРЬ ему — и несколько Убийц Милосердия, высматривают какого-то бедолагу. Дак'кон, гитцерай, он для меня загадка. Почти ничего о нём не знаю. Он не особо разговорчив. И наконец… хочешь заработать бесплатную выпивку?»~
@10320 = ~«Да».~
@10321 = ~«Не особо. Могу я задать тебе другой вопрос?»~
@10322 = ~«Видишь пьянчужку у той дальней стены, в тени прохлаждается? Она пытается набраться храбрости и улизнуть, не заплатив. Я хочу, чтобы ты этого не допустил. Сделаешь — всю жизнь за бесплатно тут пить будешь».~
@10323 = ~«Нет. Я пойду. Прощай».~
@10324 = ~«Сделаю. Но сначала я хочу тебя спросить».~
@10325 = ~«Пожалуй, откажусь. Лучше ответь мне на вопросы».~
@10326 = ~«Договорились. Дам тебе знать, когда выполню».~
@10327 = ~«Нет, спасибо. Прощай».~
@10328 = ~«И чё хочешь? Обычное пиво стоит медяк, горькое — два, мёд — четыре. У нас есть вода прямо со стихийного плана за восемь медяков, арборейское огненное вино и огненные семена за десять, керстское сердечное вино за восемь и настоящее виски из Баатора за двадцать. Что будешь?»~
@10329 = ~«Пиво».~
@10330 = ~«Пиво».~
@10331 = ~«Горькое».~
@10332 = ~«Горькое».~
@10333 = ~«Мёд».~
@10334 = ~«Мёд».~
@10335 = ~«Воду».~
@10336 = ~«Воду».~
@10337 = ~«Огненное вино с семенами».~
@10338 = ~«Огненное вино с семенами».~
@10339 = ~«Хочешь выпить — получай выпивку. У нас есть: пиво, горькое пиво, мёд, вода со стихийного плана, арборейское огненное вино и огненные семена, сердечное вино из Керста и виски из Баатора. Что будешь?»~
@10340 = ~«Сердечное вино».~
@10341 = ~«Сердечное вино».~
@10342 = ~«Виски».~
@10343 = ~«Виски».~
@10344 = ~«Мне нужна информация».~
@10345 = ~«Ничего. Прощай».~
@10346 = ~«Пиво».~
@10347 = ~«Горькое».~
@10348 = ~«Мёд».~
@10349 = ~«Воду».~
@10350 = ~«Огненное вино с семенами».~
@10351 = ~«Сердечное вино».~
@10352 = ~«Виски».~
@10353 = ~«Мне нужна информация».~
@10354 = ~«Ничего. Прощай».~
@10355 = ~Бармен хмуро смотрит на тебя: «У тебя не хватает медяков, чтобы расплатиться. Так что ничего и не получишь. Я уже столько раз обжигался. Что-нибудь другое?»~
@10356 = ~«Что у тебя есть выпить?»~
@10357 = ~«Да. Информацию».~
@10358 = ~«Нет, извини».~
@10359 = ~Ты залпом пьёшь слабенький напиток. На вкус так себе, но насыщает, и алкоголь там явно есть. Кажется, больше он никак на тебя не действует. «Ещё чего надо, здоровяк?»~
@10360 = ~«Налей мне другого».~
@10361 = ~«Налей мне другого».~
@10362 = ~«Я хочу задать вопрос».~
@10363 = ~«Ничего».~
@10364 = ~Он отходит к бочке у стены и поворачивает кран. Из крана в стакан льётся самая чистая вода, какую ты когда-либо видел. Он ставит стакан перед тобой, и ты делаешь глубокий глоток. Ничего более восхитительного ты никогда не пробовал, прохлада самой воды, ощущение воздуха, проходящего по языку в глотку, пока свежесть успокаивает на миг даже жар твоих страстей. «Из самого сердца стихийного плана Воды, — фыркает Баркис. — После этого любая другая вода покажется грязной».~
@10365 = ~«Налей мне другого!»~
@10366 = ~«Это было здорово. Налей мне другого».~
@10367 = ~«В таком случае я просто хотел бы расспросить тебя».~
@10368 = ~«Замечательное ощущение. Спасибо. Прощай».~
@10369 = ~Он подаёт тебе стакан кроваво-красного вина и пригоршню ярко окрашенных семечек. «Возьми семена в рот, — советует он, — и сделай глоток вина. Не удивляйся, когда семена охватит огнём, они не причинят тебе вреда. Неповторимый вкус». Он оказывается прав. Когда ты кладёшь семечко в рот, оно вспыхивает от слюны крохотным огоньком. Ты запиваешь его добрым глотком огненного вина, вкус получается неописуемый. Баркис улыбается: «Ещё чего налить?»~
@10370 = ~«Дьявол побери, да. Налей мне другого».~
@10371 = ~«Не откажусь».~
@10372 = ~«Не сейчас, спасибо. Лучше я задам тебе вопрос».~
@10373 = ~«Не сейчас. Прощай».~
@10374 = ~Он наливает тебе стакан знаменитого сердечного вина из Керста. От букета захватывает дух, само вино крепкое и ароматное. А уж послевкусие — лучше и не пожелаешь. «Сделано из настоящей бритвенной лозы, вот так-то. Хотел бы я узнать рецепт, — бармен кивает на пустой стакан. — Хочешь ещё?»~
@10375 = ~«Конечно».~
@10376 = ~«Конечно».~
@10377 = ~«Нет, но я хотел бы задать вопрос».~
@10378 = ~«Нет, спасибо».~
@10379 = ~Он выставляет стопку с какой-то дымящейся субстанцией, похожей на кипящую мочу. Несмотря на это, доносящийся до тебя аромат весьма соблазнителен. Жидкость невыносимо горячая и на вкус словно сгущённый дым. Ощущения от напитка, прожигающего путь в кишках, почти на грани боли, но даже эта боль несёт в себе сладость. Глаза бармена расширяются: «Ты всё ещё на ногах? Большинство народу и с полглотка бы свалилось».~
@10380 = ~«Я в полном порядке. Чувствую себя замечательно».~
@10381 = ~«Налей мне другого».~
@10382 = ~«Налей мне другого».~
@10383 = ~«Я и не такое выносил. Не ответишь мне на вопрос?»~
@10384 = ~«Я ведь не большинство. Прощай».~
@10385 = ~Глаз разлагается во мгновение ока, растекается мерзкой слизью, сильно испортив при этом воздух. Бармен машет перед носом рукой, разгоняя вонь, и говорит: «Зря только деньги потратил. Что-нибудь ещё?»~
@10386 = ~«Деньги отдавай. Сейчас же».~
@10387 = ~«Просто ответь на мои вопросы».~
@10388 = ~«Нет. Прощай».~
@10389 = ~«Пень, если ты решил, что тебе твоя покупка не нужна, это не значит, что я в чём-то виноват. Хотел бы с этим глазом что-то сделать — выкинул бы тот же трюк с глазом, что и раньше. Не моя проблема».~
@10390 = ~«Будет, если я тебя убью».~
@10391 = ~«Наверно, не твоя. Тогда ответь на мои вопросы».~
@10392 = ~«Может, ещё будет. Всего хорошего».~
@10393 = ~«Думаю, нет. Прощай».~
@10394 = ~Он криво улыбается: «Ну так попробуй».~
@10395 = ~«Забудь. Лучше ответь на вопрос».~
@10396 = ~«Забудь».~
@10397 = ~Напасть на него.~
@10398 = ~Хозяин внимательно разглядывает тебя, придерживая подбородок рукой. «Знаешь, здоровяк, у некоторых есть врождённый иммунитет к ядам и тому подобному. А кое-кто считает выпивку ядом. Если всё так, то маловероятно, что ты станешь лёгкой добычей отравителей».~
@10399 = ~«Ну, раз уж речь зашла… налей-ка мне чего другого».~
@10400 = ~«Ну, раз уж речь зашла… налей-ка мне чего другого».~
@10401 = ~«Это пригодится. Я хочу кое о чём спросить».~
@10402 = ~«Хорошо. Спасибо и прощай».~
@10403 = ~«Дневник? Слова на бумаге? Друг, такие вещи в Улье даром никому не нужны. Тут людишки еле-еле могут вывеску на двери прочитать, не то что целый дневник. Если ищешь дневник, лучше выработай систему, вместо того чтобы просто ходить и всех подряд допрашивать».~
@10404 = ~«Спасибо за непрошеный совет. Тогда у меня ещё вопрос».~
@10405 = ~«Ладно. Всего хорошего».~
@10406 = ~Он поворачивается и сплёвывает на пол. «Фарод? Тьфу. С таким же успехом ты можешь сразу повернуться к нему спиной, чтобы он всадил туда кинжал. Впрочем, судя по твоему виду, тебе его уже всадили. Если тебе до смерти, прости за каламбур, нужен Фарод, поговори с Эббом Скрипучие Колени, вон там сидит. Он должен что-то знать».~
@10407 = ~«Так и сделаю, но сперва ответь ещё на пару вопросов».~
@10408 = ~«Эбб? Вон тот старик? Спасибо».~
@10409 = ~«Тогда, друг, ты можешь перепробовать весь ассортимент… за так. Всё, что хочешь и когда хочешь».~
@10410 = ~«Должно быть, она тебе здорово задолжала».~
@10411 = ~«Спасибо. Ещё кое-какие вопросы…»~
@10412 = ~«Ловлю на слове, заскочу как-нибудь. Прощай».~
@10413 = ~«Ты и половины не знаешь. Хочешь выпить?»~
@10414 = ~«Давай».~
@10415 = ~«Прямо сейчас мне нужна только информация».~
@10416 = ~«Нет. Но я вернусь».~
@10417 = ~«Огненные семена, налетай!»~
@10418 = ~Этот крепкий юноша со свежим лицом мельком оглядывает тебя, а затем вдруг выпаливает: «Ты! Я о тебе слышал! О! Ты под арестом! Нет, стой… ты приговариваешься к казни!» Он выхватывает оружие и готовится скрестить его с твоим.~
@10419 = ~Напасть на него.~
@10420 = ~Бежать.~
@10421 = ~Ты видишь парня вряд ли старше восемнадцати лет. Его лицо выдаёт некоторое напряжение: «Помочь тебе, здоровяк?»~
@10422 = ~«Кто ты?»~
@10423 = ~«Я ищу дневник. Ты ничего такого, случайно, не видел?»~
@10424 = ~«Я ищу Сборщика по имени Фарод. Не подскажешь, где я могу его найти?»~
@10425 = ~«Что ты можешь рассказать мне о Вейлоре?»~
@10426 = ~~
@10427 = ~«Кто эти твои друзья?»~
@10428 = ~«Что ты можешь рассказать мне об этом месте?»~
@10429 = ~«Чем ты занят?»~
@10430 = ~«Нет. Прощай».~
@10431 = ~«Опять ты? Чего надо?» — он выглядит нетерпеливым и нервным.~
@10432 = ~«Твой убийца до сих пор не появился?»~
@10433 = ~«Кто ты?»~
@10434 = ~«Я ищу дневник. Ты ничего такого, случайно, не видел?»~
@10435 = ~«Я ищу Сборщика по имени Фарод. Не подскажешь, где я могу его найти?»~
@10436 = ~«Что ты можешь рассказать мне о Вейлоре?»~
@10437 = ~«Кто эти твои друзья?»~
@10438 = ~«Что ты можешь рассказать мне об этом месте?»~
@10439 = ~«Чем ты занят?»~
@10440 = ~«Ничего. Прощай».~
@10441 = ~«Я Калеб, из Убийц Милосердия. Я здесь с Тарнером и Илсидоном для того, чтобы схватить своего первого преступника».~
@10442 = ~«Что ты можешь рассказать мне об Убийцах Милосердия?»~
@10443 = ~«Ясно. Я хотел бы задать другой вопрос».~
@10444 = ~«Удачи тебе. Прощай».~
@10445 = ~«Дневник? Нет, прости. Я тут новенький, так что не обо всём в курсе. Если увижу что-то подобное, дам тебе знать», — он оглядывает бар.~
@10446 = ~«Чем ты занят?»~
@10447 = ~«Спасибо. А пока я хотел бы задать пару вопросов».~
@10448 = ~«Спасибо. Прощай».~
@10449 = ~«Они здесь для того, чтобы я ничего неподобающего не сделал. Тарнер — старший. Илсидон здесь с целью убедиться, что я сделаю свою работу как надо, а при случае и помочь, — он с шумом сглатывает. — Надеюсь, помощь не потребуется».~
@10450 = ~«Всё будет в порядке, я уверен. Не ответишь мне на кое-какие вопросы?»~
@10451 = ~«Удачи тебе. Прощай».~
@10452 = ~«Это место? Это „Горящий труп“. По-моему, кабак назвали в честь того мужика посерёдке. Здесь собираются бандиты и отбросы общества. Хотя… здесь есть несколько типов, которые знают, о чём говорят. Среди них, правда, и вон те изверги, но я не хочу иметь с ними дела. У меня чувство, что они мне прямо в душу глядят».~
@10453 = ~«Понятно. У меня ещё вопросы».~
@10454 = ~«Так и есть. Прощай».~
@10455 = ~«Ну, как новичку среди Убийц Милосердия мне положено предать преступника в руки закона, это моё испытательное задание. Я решил, что мне нужно поймать убийцу, поспрашивал в округе и услышал, что он собирался прийти сюда. Однако пока его ещё нет. Я немного нервничаю, по правде говоря. С твоего позволения, мне действительно необходимо ещё раз рассмотреть все здешние рожи», — он вертит шеей, оглядывая бар.~
@10456 = ~«Ещё пару вопросов, и оставлю тебя в покое».~
@10457 = ~«Хорошо. Всего доброго».~
@10458 = ~«Нет. Ещё нет. Но Тарнер говорит, что уж сюда-то он обязательно заявится. Так что пока играем в ожидание».~
@10459 = ~«Верно. Позволь задать ещё пару вопросов».~
@10460 = ~«Удачи тебе. Прощай».~
@10461 = ~«Ну, они… прости, *я* — мне ещё надо к этому привыкнуть! — верю, что самое главное на свете — это правосудие. Я верю, что без правосудия не будет и смысла жизни, а без смысла мы просто друг дружку перебьём. Я не хочу совершить подобное самоубийство, поэтому я за правосудие. Если ты хочешь узнать больше, тебе стоит спросить одного из двоих наших старших. Они тебе все уши прожужжат!»~
@10462 = ~«Что ты можешь рассказать мне о Вейлоре?»~
@10463 = ~«Наверно, так и сделаю. Но сначала я хочу спросить тебя ещё кое о чём».~
@10464 = ~«Хорошо. Спасибо».~
@10465 = ~«Что ты хочешь узнать?»~
@10466 = ~«Твой убийца до сих пор не появился?»~
@10467 = ~«Кто ты?»~
@10468 = ~«Я ищу дневник. Ты ничего такого, случайно, не видел?»~
@10469 = ~«Я ищу Сборщика по имени Фарод. Не подскажешь, где я могу его найти?»~
@10470 = ~«Что ты можешь рассказать мне о Вейлоре?»~
@10471 = ~«Кто эти твои друзья?»~
@10472 = ~«Что ты можешь рассказать мне об этом месте?»~
@10473 = ~«Чем ты занят?»~
@10474 = ~«Ничего. Прощай».~
@10475 = ~«Не могу сказать, чтобы слышал о нём. Он преступник? Может быть, мы поймаем его попозже… Спасибо за предупреждение, гражданин».~
@10476 = ~«Я просто разыскиваю его, убивать не надо. Могу я задать тебе другой вопрос?»~
@10477 = ~«Пожалуйста. Если поймаете его, дайте мне знать до того, как убьёте. Прощай».~
@10478 = ~«Вейлор? По-моему, это был один из тех старых Убийц Милосердия. Когда-нибудь я надеюсь стать таким, как он. Я слышал, чувак был почти богом!»~
@10479 = ~«Примером для тебя, это уж точно. Могу я задать ещё вопрос?»~
@10480 = ~«Ясно. Спасибо».~
@10481 = ~Этот мужчина в тяжёлом доспехе без слов достаёт оружие и бросается на тебя.~
@10482 = ~Защищаться.~
@10483 = ~Бежать.~
@10484 = ~Мужчина огромен, как бронированный бегемот. Кроме того, у него очень цепкий взгляд — ничего из происходящего не упускает. А ещё он, кажется, не заинтересован в разговоре с тобой.~
@10485 = ~«Я хотел бы задать кое-какие вопросы».~
@10486 = ~«Привет?»~
@10487 = ~«Что ты можешь рассказать мне о Вейлоре?»~
@10488 = ~«Тогда прощай».~
@10489 = ~Мужчина смотрит на тебя, как на букашку, сверлит взглядом почти неморгающих глаз. Затем, не проронив ни слова, отворачивает голову и забывает о твоём существовании.~
@10490 = ~«Ты будешь говорить со мной, или я заберу твоё сердце, неуклюжая консервная банка».~
@10491 = ~«Привет?»~
@10492 = ~«Что ты можешь рассказать мне о Вейлоре?»~
@10493 = ~«Тогда прощай. Спрошу кого-нибудь другого».~
@10494 = ~Ты слышишь подземный гул из глубин его грудной клетки. Он легко поглаживает своё оружие и глядит на тебя с возрождённым интересом.~
@10495 = ~«Что ты можешь рассказать мне о Вейлоре?»~
@10496 = ~«Если ты так на всё отвечаешь, то прощай».~
@10497 = ~Напасть на него.~
@10498 = ~К твоему удивлению, молчаливый гигант реагирует. Он наклоняется вперёд и не сводит с тебя взгляда своих блестящих, немигающих глаз. Его очень глубокий голос с шумом вырывается из мощной груди: «Среди нас Вейлор был одним из лучших. Истинный Убийца Милосердия. Справедливость была его госпожой и его жизненной силой. Сказывали, что он мог видеть, насколько чиста твоя душа. Он был так предан делу, что никогда не сдавался, даже перед лицом смерти. Он пропал много лет назад, последовав за преступником через портал. С тех пор мы его не видели. Он — настоящая легенда». Он садится обратно на свой стул и перестаёт обращать на тебя внимание.~
@10499 = ~«Могу я задать ещё кое-какие вопросы?»~
@10500 = ~«Спасибо. Прощай».~
@10501 = ~«Нет», — Убийца Милосердия даже не смотрит в твою сторону.~
@10502 = ~«Я всего-то хотел бы услышать ответы на пару вопросов».~
@10503 = ~«Тогда прощай».~
@10504 = ~Седой Убийца Милосердия медленно поворачивается в твою сторону, изучает твоё лицо, и внезапно его руки приходят в движение. Во мгновение ока в них оказывается какое-то крайне отвратительное на вид оружие. «Парни! Среди нас убийца!» — он нападает на тебя.~
@10505 = ~Защищаться.~
@10506 = ~Бежать.~
@10507 = ~Ты видишь седого крепкого мужика в доспехе с шипами. Он медленно и холодно осматривает тебя с головы до ног, оценивая. На какое-то время взгляд задерживается на твоём лице, как если бы оно что-то ему напомнило. Затем он вздыхает и произносит: «Могу я чем-нибудь помочь, друг?»~
@10508 = ~«Кто ты?»~
@10509 = ~«Ты узнал меня?»~
@10510 = ~«Кто эти твои друзья?»~
@10511 = ~«Я ищу дневник. Ты ничего такого не видел?»~
@10512 = ~«Я ищу Сборщика по имени Фарод. Не подскажешь, где я могу его найти?»~
@10513 = ~«Тебе что-нибудь от меня нужно?»~
@10514 = ~«Что ты можешь рассказать мне о Вейлоре?»~
@10515 = ~«Тебя не затруднит рассказать мне об этом месте?»~
@10516 = ~«Нет, не сейчас. Прощай».~
@10517 = ~«Кто ты?»~
@10518 = ~«Ты узнал меня?»~
@10519 = ~«Кто эти твои друзья?»~
@10520 = ~«Я ищу дневник. Ты ничего такого не видел?»~
@10521 = ~«Не знаешь Сборщика по имени Фарод? Я его ищу».~
@10522 = ~«Что ты можешь рассказать мне о Вейлоре?»~
@10523 = ~«Тебя не затруднит рассказать мне об этом месте?»~
@10524 = ~«Нет, не сейчас. Прощай».~
@10525 = ~«Я? Меня зовут Тарнер».~
@10526 = ~«Что у тебя за снаряжение?»~
@10527 = ~«Кто эти твои друзья?»~
@10528 = ~«Можно я задам тебе ещё вопрос?»~
@10529 = ~«Спасибо. Всего доброго».~
@10530 = ~«Мне показалось, что узнал, но тем рисункам несколько столетий, и подозреваемый уже давно помер. Разумеется, это планы, и странные вещи тут случаются. Однако, если ты тот самый парень, о котором я подумал, то похоже, что ты сполна получил своё наказание болью».~
@10531 = ~«Что ты можешь рассказать мне о том парне?»~
@10532 = ~«Хм. Кто знает? Могу я задать тебе ещё вопрос?»~
@10533 = ~«Полнее, чем ты хотел бы знать. Полнее, чем знаю *я*. Прощай».~
@10534 = ~«Это Калеб и Илсидон. Калеб — наше новое мясо, новобранец. Илсидон — мышцы. Я — мозг».~
@10535 = ~«Чем вы здесь заняты?»~
@10536 = ~«Новобранец? Так вот почему вы все одинаково одеты?»~
@10537 = ~«Ладно. Я хочу кое о чём спросить тебя».~
@10538 = ~«Ясно. Прощай».~
@10539 = ~«Друг, на вонючих улицах Сигила столько дерьма валяется. Если только твой дневник не был чем-то впечатляющим, я на него, скорее всего, и внимания не обратил».~
@10540 = ~«Тогда ладно. Могу я задать тебе ещё вопрос?»~
@10541 = ~«Пожалуй, я и сам его не припомню. Тогда прощай».~
@10542 = ~«Это? Это „Горящий труп“. Ходит байка, что в этом месте полно порталов и тому подобной дряни, но в Сигиле куда ни плюнь, везде будут порталы. Дешёвая, но годная выпивка, и, если не учитывать общество алкашей и извергов, совсем неплохое местечко. Если тебе хочется узнать побольше об этом месте, поговори с хозяином или ещё с кем».~
@10543 = ~«Понятно. Я хотел бы спросить о другом».~
@10544 = ~«Отлично. Прощай».~
@10545 = ~«Что ты хочешь узнать?»~
@10546 = ~«Кто ты?»~
@10547 = ~«Ты узнал меня?»~
@10548 = ~«Кто эти твои друзья?»~
@10549 = ~«Я ищу дневник. Ты ничего такого не видел?»~
@10550 = ~«Ты когда-нибудь слышал о Сборщике по имени Фарод? Я его ищу».~
@10551 = ~«Что ты можешь рассказать мне о Вейлоре?»~
@10552 = ~«Тебя не затруднит рассказать мне об этом месте?»~
@10553 = ~«Сейчас ничего. Прощай».~
@10554 = ~«Это наша форма. Мы Красная Смерть… Убийцы Милосердия. Мы люди закона. Если кто-то совершает преступление, мы предаём его суду. А ещё мы исправляем несправедливость. Если хочешь узнать больше, поговори с кем-нибудь из вербовщиков».~
@10555 = ~«Неплохо. Можешь ответить на пару вопросов?»~
@10556 = ~«Всего доброго тогда».~
@10557 = ~«Он был особо жестоким преступником, насколько я слышал. Это, разумеется, было столетия назад. Говорили, он отличался невероятной силой и яростью, руками мог оторвать голову бариауру. Не тот тип, с которым приятно встретиться. Ещё говорили, что он был окружён патрулями Красной Смерти, убежал через портал и больше не появлялся. — он хмурится, изучая тебя. — Есть его портреты. Если у тебя убрать несколько шрамов, ты будешь на него похож. Наверное, это всё-таки не ты».~
@10558 = ~«Опасный тип, судя по всему. Я хотел спросить о другом».~
@10559 = ~«Неприятная история. Прощай».~
@10560 = ~«Ждём преступника. Для Калеба это будет первый арест — если, конечно, этот пень вообще когда-нибудь появится».~
@10561 = ~«Так вы что-то вроде полиции? А ваши доспехи… это форма?»~
@10562 = ~«Ясно. У меня другой вопрос».~
@10563 = ~«Удачи тебе. Прощай».~
@10564 = ~«Ты его ищешь, да? По твоему тону, держу пари, ты не бутылочку в честь встречи с ним распить хочешь. Слушай, я давно знаю Фарода. Он исключительно скользкий тип, и потребуется время, пока мы сможем его прижать. Проблема в том, что только фанатики вроде Вейлора позволяли себе казнить без доказательств. Всё это к тому, что я не знаю, где его искать, но ты обязан иметь в виду, что он подозреваемый, и будет не очень здорово, если тебя с ним увидят».~
@10565 = ~«Спасибо за совет. Могу я задать ещё вопрос?»~
@10566 = ~«Спасибо, друг, хоть и не особо помог. Прощай».~
@10567 = ~«Вейлор? Фанатик он был, вот кто. Никогда не останавливался ни перед чем, если считал себя правым, даже когда думал, что может поплатиться жизнью. Он так ревностно верил в правосудие, настоящее правосудие, что, держу пари, убил бы и саму Смерть, чтобы добраться до информатора, который указал бы ему путь к преступнику. И не было для него никаких границ. Все мы берём с него пример».~
@10568 = ~«Это преданность, хорошо. Могу я ещё спросить?»~
@10569 = ~«Бьюсь об заклад, так и было. Прощай».~
@10570 = ~«Ты сейчас на территории Шива, пень».~
@10571 = ~«Мне уже наскучило ждать его».~
@10572 = ~«Смотри-ка… нет, ничего».~
@10573 = ~«Взрыв! Опять пусто!»~
@10574 = ~«Ничего! Вы где?!»~
@10575 = ~«Ты еси глуп!»~
@10576 = ~«Кретины».~
@10577 = ~«Просто хотел убедиться. Уже ухожу».~
@10578 = ~Ты видишь некую личность в женском одеянии Пыльных, с полупустым стаканом в правой руке. Когда ты приближаешься, она тебя окликает: «Гм, ты. Там…» Ты замечаешь в ней какую-то странность… твоего знакомства с Пыльными достаточно, чтобы понять, какую именно. Она слишком полна жизни для настоящего члена фракции.~
@10579 = ~Подойти к ней.~
@10580 = ~Оставить её в покое.~
@10581 = ~Оставить её в покое.~
@10582 = ~Ты видишь женщину из Пыльных. Когда ты приближаешься, она тебя окликает: «Гм, ты. Там…»~
@10583 = ~Подойти к ней.~
@10584 = ~Оставить её в покое.~
@10585 = ~Оставить её в покое.~
@10586 = ~«Гм-м… что тебе нужно?»~
@10587 = ~«Баркис сказал, что тебе пора платить по счетам. Выкладывай денежки».~
@10588 = ~«Никакая ты не Пыльная, ведь правда?»~
@10589 = ~«Мне нужно больше денег, чтобы я сохранил твой маскарад в тайне».~
@10590 = ~«Мне нужно ещё больше денег, чтобы я сохранил твой маскарад в тайне».~
@10591 = ~«Мне нужны ответы на кое-какие вопросы».~
@10592 = ~«Ничего».~
@10593 = ~«Слишком хорош, чтоб зависнуть с кем-то вроде Пыльной, ага? Купи мне выпивки, и я оставлю тебя в покое».~
@10594 = ~«Хорошо. Вот пять монет. Теперь оставь меня».~
@10595 = ~«Никакая ты не Пыльная, ведь правда?»~
@10596 = ~«Баркис сказал, что тебе пора платить по счетам. Выкладывай денежки».~
@10597 = ~«Не думаю. Всего доброго».~
@10598 = ~«Эй, здоровяк… поставишь даме выпивку?»~
@10599 = ~«Никакая ты не Пыльная, ведь правда?»~
@10600 = ~«Баркис сказал, что тебе пора платить по счетам. Выкладывай денежки».~
@10601 = ~«Кто ты?»~
@10602 = ~«Что это за место?»~
@10603 = ~«Расскажи мне об остальных посетителях».~
@10604 = ~«Что это за горящий труп?»~
@10605 = ~Отвлечь её и отравить выпивку бальзамирующей жидкостью: «Смотри! Что это там?»~
@10606 = ~Отвлечь её и отравить выпивку бальзамирующей жидкостью: «Смотри! Что это там?»~
@10607 = ~«Забудь. Прощай».~
@10608 = ~«Спасибо, здоровяк… да обретёшь ты Истинную Смерть». Она прячет твои деньги и нервно смотрит в сторону бара.~
@10609 = ~«За медяки я хочу услышать ответы на вопросы».~
@10610 = ~«Всего хорошего».~
@10611 = ~«Что, гм, ты хочешь узнать?»~
@10612 = ~«Никакая ты не Пыльная, ведь правда?»~
@10613 = ~«Баркис сказал, что тебе пора платить по счетам. Выкладывай денежки».~
@10614 = ~«Кто ты?»~
@10615 = ~«Что это за место?»~
@10616 = ~«Расскажи мне об остальных посетителях».~
@10617 = ~«Что это за горящий труп?»~
@10618 = ~Отвлечь её и отравить выпивку бальзамирующей жидкостью: «Смотри! Что это там?»~
@10619 = ~Отвлечь её и отравить выпивку бальзамирующей жидкостью: «Смотри! Что это там?»~
@10620 = ~«Мне нужно больше денег, чтобы я сохранил твой маскарад в тайне».~
@10621 = ~«Мне нужно ещё больше денег, чтобы я сохранил твой маскарад в тайне».~
@10622 = ~«Ничего. Прощай».~
@10623 = ~Она нервно оглядывается по сторонам и, кажется, начитает стремительно трезветь. «Почему, гм, ты так считаешь?»~
@10624 = ~«Потому что ты ведёшь себя не как Пыльники и не предлагаешь заключить договор. На самом деле ты берёшь деньги вместо того, чтобы платить их за трупы для работы в Мортуарии».~
@10625 = ~«Потому что я сам из Пыльных».~
@10626 = ~Она вздрагивает, и её нервное напряжение перерастает в настоящий страх. «Что ты собираешься делать?»~
@10627 = ~«Требовать от тебя расплатиться. Сейчас же».~
@10628 = ~«Требовать от тебя расплатиться. Сейчас же».~
@10629 = ~«Пока ничего. Сначала ответь на вопросы».~
@10630 = ~Она издаёт перепуганный писк и начинает суетливо объяснять: «Нет, нет, нет-нет-нет. Я не из Пыльных. Я просто нашла это облачение на улице, у меня не было денег на что-нибудь поприличнее, и я, э-э, слышала, что здесь есть вор из Пыльных, но ты его, наверно, найдёшь где-нибудь в другом месте, в юго-западной части Улья. Я видела его, но спряталась. Пожалуйста, не бей меня».~
@10631 = ~«Давай деньги, и можешь идти».~
@10632 = ~«Ничего я не собираюсь делать. Просто хочу сказать, что плохо играешь. Теперь ответь мне на пару вопросов».~
@10633 = ~«Не буду. Пока. Прощай».~
@10634 = ~«Гм-м… мне это не по карману. Не одолжишь хотя бы десять процентов? Я, гм, отдам их ему, и он поймёт, что я заплачу и остальное».~
@10635 = ~«Сколько тебе надо?»~
@10636 = ~«Не думаю. Я не благотворительная организация. Можешь придумать другой способ заплатить?»~
@10637 = ~«Не подкинешь несколько монеток на выпивку, здоровяк?»~
@10638 = ~«Хорошо. Держи пять монет».~
@10639 = ~«Нет. Лучше ответь мне на пару вопросов».~
@10640 = ~«Нет. Прощай».~
@10641 = ~«Гм, полагаю, мне нужно около сотни монет, чтобы начать выплачивать этот долг».~
@10642 = ~Отвлечь её и отравить выпивку бальзамирующей жидкостью: «Смотри! Что это там?»~
@10643 = ~Отвлечь её и отравить выпивку бальзамирующей жидкостью: «Смотри! Что это там?»~
@10644 = ~«Я одолжу тебе денег. Держи. Иди расплачивайся. Прямо сейчас».~
@10645 = ~«Ещё есть варианты?»~
@10646 = ~«Другой способ заплатить? Ха, — она горько улыбается. — Ты всегда можешь, гм, убить меня».~
@10647 = ~Отвлечь её: «Я мог бы, но… что это такое вон там?»~
@10648 = ~«Я бы мог, но лучше найти другой способ».~
@10649 = ~«Я просто одолжу тебе эти деньги. Теперь иди расплачивайся».~
@10650 = ~Ложь: «Я бы тебе одолжил, но у меня столько нет. Ты не могла бы ответить на кое-какие вопросы?»~
@10651 = ~Правда: «Я бы тебе одолжил, но у меня столько нет. Ты не могла бы ответить на кое-какие вопросы?»~
@10652 = ~«Я вернусь с деньгами».~
@10653 = ~«Вернусь позже».~
@10654 = ~«Где? — она поворачивает голову туда, куда ты указываешь, и на секунду замолкает, пытаясь собрать в кучу затуманенные выпивкой глаза. — Я ничего не вижу».~
@10655 = ~Отравить её выпивку бальзамирующей жидкостью.~
@10656 = ~«Неважно. Можешь ответить на пару вопросов?»~
@10657 = ~«Должно быть, показалось. Забудь. Прощай».~
@10658 = ~Пока она смотрит в сторону, ты поспешно подливаешь в её полупустой стакан бальзамирующую жидкость. Вонь бьёт в ноздри, но она, похоже, ничего не замечает, поворачивается обратно и опрокидывает отравленный напиток в рот. «Гм, и что там? Что я должна была увидеть?» Внезапно она начинает задыхаться.~
@10659 = ~«Свою смерть. Прощай, Мокаи».~
@10660 = ~«Гм… что ты делаешь?» Она замечает, что ты достал бутылку с жидкостью для бальзамирования, и подозрительно на тебя смотрит.~
@10661 = ~«Просто ставлю бутылку на стол. Я принёс свою выпивку».~
@10662 = ~«Просто ставлю бутылку на стол. Я принёс свою выпивку».~
@10663 = ~«Просто ставлю бутылку на стол. Я принёс свою выпивку».~
@10664 = ~«К чему такая подозрительная? Я рылся в своём барахле и вспомнил, что принёс».~
@10665 = ~«Ничего, что касалось бы тебя».~
@10666 = ~«Ничего. У меня дела в другом месте. Прощай».~
@10667 = ~Она смотрит на тебя долгим взглядом, покачиваясь, затем говорит: «Гм, хорошо. Что-нибудь ещё нужно?»~
@10668 = ~«Да. Ответы».~
@10669 = ~«Нет. Прощай».~
@10670 = ~«Я могу дать тебе пятьдесят монет. Пожалуйста… никому не говори».~
@10671 = ~«Посмотрим. Теперь я хочу задать тебе кое-какие вопросы».~
@10672 = ~«Пятьдесят? Я хочу больше».~
@10673 = ~«Посмотрим. Прощай».~
@10674 = ~«Гм, хочешь больше? Я, гм, не могу дать сколько в прошлый раз. Но могу дать, гм, двадцать пять монет».~
@10675 = ~«Я хочу больше».~
@10676 = ~«Этого хватит… пока. А сейчас я хочу задать тебе кое-какие вопросы».~
@10677 = ~«Этого хватит… пока. Я ещё вернусь».~
@10678 = ~«Ну, гм, очень жаль. Потому что, гм, больше я тебе дать ничего не могу. У меня просто, гм, больше нет денег».~
@10679 = ~«Очень жаль. Тогда ответь на мои вопросы».~
@10680 = ~«Очень жаль. Посмотрим, что будет. Прощай».~
@10681 = ~Она горько на тебя смотрит. «Я не могу. Один, гм, пень забрал все мои деньги. Мне нужно взять взаймы или, гм, типа того, чтобы расплатиться с ним сейчас».~
@10682 = ~«Сколько тебе надо?»~
@10683 = ~«Не думаю. Я не благотворительная организация. Можешь придумать другой способ заплатить?»~
@10684 = ~Она убирает твои медяки в карман, бросает быстрый взгляд на дверь, как бы взвешивая шансы ускользнуть, тяжко вздыхает, поняв, что шансов никаких, и идёт к бару. «Гм, спасибо, наверно».~
@10685 = ~«Пожалуйста. И даже не думай направиться к двери, пока не расплатишься».~
@10686 = ~«Я? Я Мокаи. Просто хотела тут, гм, выпить, и, гм-м… — она на мгновение утрачивает нить разговора. — Я просто человек, понимаешь?»~
@10687 = ~«Понимаю. Тогда ответь мне на другой вопрос».~
@10688 = ~«Ясно. Тогда прощай, Мокаи».~
@10689 = ~«Кабак „Горящий труп“. Читать не умеешь? Или нажрался в зюзю, меня похлеще?»~
@10690 = ~«Забудь. Расскажи мне о другом».~
@10691 = ~«Забудь. Прощай».~
@10692 = ~«Не знаю. Они просто, гм, люди. Я с ними почти не общаюсь. Кроме как если они ставят мне выпивку…» — она с надеждой смотрит на тебя.~
@10693 = ~«Ясно. Я хочу спросить о другом».~
@10694 = ~«Оно и ясно, почему. Прощай».~
@10695 = ~«Это, гм, вовсе не труп. Он, гм, какой-то сбрендивший маг. Поспрашивай тут. Тебе порасскажут всякого».~
@10696 = ~«Хорошо. Тогда ответь на другой вопрос».~
@10697 = ~«Прощай».~
@10698 = ~«У меня нет времени на таинственные бредни. Я ищу дневник. Это важно. Не знаешь, где я могу его найти?»~
@10699 = ~«Ты не Фарод? Я ищу Фарода, Сборщика».~
@10700 = ~«Кто ты?»~
@10701 = ~«Забудь. У меня куча дел. Прощай».~
@10702 = ~«Снова здравствуй, путник, — кажется, О с прошлого раза не сдвинулся с места. — Что тебе от меня нужно?»~
@10703 = ~«Расскажи мне об этом божественном алфавите, который ты упоминал».~
@10704 = ~«Расскажи мне о себе».~
@10705 = ~«Я ищу дневник. Это важно. Не знаешь, где я могу его найти?»~
@10706 = ~«Ты не встречал Сборщика по имени Фарод? А может, слышал о нём?»~
@10707 = ~«Расскажи мне о посетителях кабака».~
@10708 = ~«Ничего. Прощай».~
@10709 = ~Когда он открывает рот, тебя снова охватывает ощущение вечности: внутри его рта ты не видишь ни языка, ни зубов. Как будто этот мужчина — всего лишь оболочка, внутри которой находится неограниченное пространство. «Я уже говорил с тобой, но всегда забываешь ты. Твой бесконечный поиск самого себя всегда заканчивается амнезией. Ты то приближаешься к истине, то удаляешься от неё. Давай будем надеяться, что у тебя хватит сил выдержать такое существование».~
@10710 = ~«Что ты обо мне знаешь? Как ты это узнал?»~
@10711 = ~«У меня нет времени на это безумие. Прощай».~
@10712 = ~«Я знаю, что ты как бабочка вознёсся из остатков своей старой оболочки, полетал немножко, а теперь бьёшься об окно истины. Порхаешь около стекла, бездумно ищешь свет и падаешь в изнеможении при неудачах. Садишься на других, чтобы кормиться за их счёт, и движешься дальше, не считаясь с ними. Я наблюдал, как ты пришёл сюда, и слышал твои слова, и наблюдал, как ты ушёл, ничуть не помудрев. Будешь ли ты учиться на своих ошибках, ищущий?»~
@10713 = ~«Не сказал бы, что мне нравится твой тон».~
@10714 = ~«Кто ты?»~
@10715 = ~«Не в этот раз. Прощай».~
@10716 = ~Напасть на него.~
@10717 = ~Хотя на его лице и не видно улыбки, в голосе явно слышна насмешка: «Неужели драка вслепую — твой ответ на все проблемы? Останешься ли ты всего лишь кусачим насекомым, или всё-таки наберёшься разума в своём жалком существовании?»~
@10718 = ~«Предупреждаю…»~
@10719 = ~«Кто ты такой, чтобы говорить со мной в таком тоне?»~
@10720 = ~«Мне это не нужно. Прощай».~
@10721 = ~«Ты вызываешь меня? Я, произнесённый в сущее, знаю слова, которые тебя опустошат, погубят то малое, что осталось от твоей души, и оставят тебя хныкающим на земле. Однако я вижу, что не стоит мне тратить подобные тайны на таких, как ты, когда я могу просто стать для тебя незаметным».~
@10722 = ~Напасть на него.~
@10723 = ~«Так кто же ты такой?»~
@10724 = ~«Довольно позёрства. Прощай».~
@10725 = ~«Я O», — почему-то, когда он произносит своё имя, оно кажется куда большим, чем простая буква — словно он наполнил звучание непроизносимыми возможностями и нюансами. Такой звук не может издать ни одно человеческое горло.~
@10726 = ~«Что это за имя такое?»~
@10727 = ~«Кто ты?»~
@10728 = ~«Приятно познакомиться, O. Прощай».~
@10729 = ~«Это моё имя. Это имя частицы вечности. Я буква в божественном алфавите. Понимание меня ведёт к постижению сущего. Я вписан в подлинные имена половины всего на свете. Моё бытие заключает в себе истину. Я есть математика, органика, метафизика».~
@10730 = ~«По-моему, у тебя крыша совсем поехала».~
@10731 = ~«И что это значит?»~
@10732 = ~«…хорошо. Могу я задать тебе другой вопрос?»~
@10733 = ~«Ясно. Прощай».~
@10734 = ~«Если именно в это ты хочешь верить. Удачи тебе, путник. Прощай».~
@10735 = ~«Можно я задам тебе ещё пару вопросов?»~
@10736 = ~«Прощай».~
@10737 = ~«Божественный алфавит вписан в имена всего сущего, от семени в сердце стихийных планов до оболочки Великого Предела. Мои братья/сёстры… — (это одно слово, которое в твоём мозгу превращается в два.) — …и я охватываем всё, что есть, было или когда-нибудь будет. Мы — мысль, мы — реальность, мы — представление, и мы же непредставимое».~
@10738 = ~«Расскажи мне о Великом Пределе».~
@10739 = ~«Так что же ты здесь делаешь?»~
@10740 = ~«То есть ты знаешь все тайны бытия, так?»~
@10741 = ~«Тогда ты сможешь ответить на мои вопросы».~
@10742 = ~«Мне надо всё это обдумать. Прощай».~
@10743 = ~Больше он не обращает на тебя внимания. Уверенность, что он и в дальнейшем не будет обращать на тебя внимания, тяжким грузом ложится на твои плечи, и ты представления не имеешь, откуда она взялась.~
@10744 = ~«Тогда прощай».~
@10745 = ~«Что ты желаешь знать?»~
@10746 = ~«Что ты говорил о божественном алфавите?»~
@10747 = ~«Я ищу дневник. Это важно. Не знаешь, где я могу его найти?»~
@10748 = ~«Ты не встречал Сборщика по имени Фарод? А может, слышал о нём?»~
@10749 = ~«Расскажи мне о посетителях кабака».~
@10750 = ~«Расскажи мне о себе».~
@10751 = ~«Ничего, если подумать. Прощай».~
@10752 = ~«Ты не поймёшь. Наверное, никто из смертных не сможет. Это за пределами понимания всех, кроме самых могущественных из сил, и как только они понимают, они выходят за рамки познания, доступные смертному. Больше я ничего не могу объяснить. Быть может, когда-нибудь ты сможешь понять».~
@10753 = ~«Так что же ты здесь делаешь?»~
@10754 = ~«Тогда я хотел бы задать тебе другой вопрос».~
@10755 = ~«Ясно. Тогда прощай».~
@10756 = ~«Я знаю, где ты можешь его найти, но не моё дело открывать такую информацию. Не беспокойся, НАЙДЁШЬ, как и того человека, которого ищешь».~
@10757 = ~«Ты знаешь, где Фарод?»~
@10758 = ~«Что тебе об этом известно?»~
@10759 = ~«Ну что ж, спасибо. Может быть, ты ответишь на другой вопрос?»~
@10760 = ~«Ну что ж, спасибо. Прощай».~
@10761 = ~«Я знаю где он. Но тебе могу сказать только одно слово: близко. Ты найдёшь его в Улье, под покровом тайны».~
@10762 = ~«Я смотрю, все твои ответы покрыты той же тайной. Можешь ответить ещё на один вопрос?»~
@10763 = ~«Тогда лучше я пойду искать его. Прощай».~
@10764 = ~«Я знаю, что в своих странствиях ты далеко ушёл от поисков дневника, к важным вопросам бытия. Ты будешь бороться за свою жизнь и за самый дух свой… и больше я тебе об этом ничего не скажу».~
@10765 = ~«Тогда скажи о другом».~
@10766 = ~«Ну и ладно. Прощай».~
@10767 = ~«Я наблюдаю за отливами и приливами смертности».~
@10768 = ~«И что ты видишь?»~
@10769 = ~«Вы, смертные, подобны осам. Вы строите свои жизни/гнёзда из тончайших нитей, и когда ветер валит ваш дом/древо жизни, вы пытаетесь зажалить ветер до смерти. Вместо осознания своих глупых ошибок, вы пытаетесь починить то, что сами же и разрушили, и, как видно из твоего опыта, причиняете вред всем, кто имел несчастье оказаться рядом с вами в моменты боли и отчаяния. Мой тебе совет — да и всем смертным: не будьте насекомыми, действуйте разумно».~
@10770 = ~«Я обдумаю твои слова. А пока, ответь мне на другой вопрос».~
@10771 = ~«Спасибо за совет. Прощай».~
@10772 = ~«Я знаю части многих из них. Без связи с моими братьями/сёстрами я всего лишь буква. Когда я один, я символ. Вместе мы язык и сила».~
@10773 = ~«Так ты не знаешь тайн бытия?»~
@10774 = ~«Тогда ты ничего не знаешь. Может, знаешь хоть ответы на кое-какие вопросы?»~
@10775 = ~«Звучная метафора, многоуровневая. Прощай».~
@10776 = ~«Такого я не говорил. Буква — могучая сила даже сама по себе. Позволь мне продемонстрировать». Он открывает рот всё шире и шире. Маска его лица разрывается вокруг глаз, рта и носа, обнажая ткань вечности, которую ты уже видел мельком. Ты теряешься в ней, растворяешься… становишься её частью. Потом к тебе возвращаются обычные чувства — и ты понимаешь, что О исчез. Но твои горизонты странным образом раздвинулись. Тебя настигло просветление, хотя и краткое.~
@10777 = ~«Это было… неописуемо».~
@10778 = ~«Посетители тут разные, но все смертные. И как у всех смертных, их интересы ограничены, ограничены в возможности вырастания в настоящую Истину. Хотя могу тебе сказать: здесь ты можешь найти товарища, близкого твоему сердцу. Хотя бы настолько, насколько твоё сердце позволит».~
@10779 = ~«Полагаю, мне следовало бы оскорбиться, но я пропущу это мимо ушей. Могу я задать тебе ещё вопрос?»~
@10780 = ~«Не сказал бы, что мне нравится твой тон».~
@10781 = ~«Благодарю тебя. Прощай».~
@10782 = ~«Я ищу дневник. Ничего такого не видел?»~
@10783 = ~«Я ищу Сборщика по имени Фарод. Ты что-нибудь о нём знаешь?»~
@10784 = ~«Что ты можешь рассказать мне об этом месте?»~
@10785 = ~«Кто этот горящий тип у входа?»~
@10786 = ~«Очевидно, ты не можешь мне помочь. Всего доброго».~
@10787 = ~«Кто же, как не мой старый друг, господин Шрам!» — он сдавленно хихикает, или, по крайней мере, отваживается на попытку. В его состоянии вообще трудно что-либо делать. «Чем старина Хлоппи может те помочь, раненный?»~
@10788 = ~«Кто ты?»~
@10789 = ~«Я ищу дневник. Кажется, я куда-то его засунул».~
@10790 = ~«Что ты можешь рассказать мне об этом месте?»~
@10791 = ~«Кто этот горящий тип у входа?»~
@10792 = ~«Ничем. Всего доброго».~
@10793 = ~«Я? Я АНДОР! — он покачивается. — Када-та был охеренно крутым бойцом, но эт до того, как выпивон меня в плен взял. Друзья звали меня Хлоппи, ведь я ухлопал не одного противника, а терь меня зовут Хлоппи потому, что с какой женщиной ни заговорю — пощёчину получаю».~
@10794 = ~«Замечательно. Могу я задать тебе пару вопросов?»~
@10795 = ~«Замечательно… хм-м… Андор. Прощай».~
@10796 = ~На миг он замолкает. «Ну, еси ты его в Улье потерял, то запросто может быть, что какой-нить Сборщик подобрал. Пошукай в Улье ещё раз. Они там самое разное барахло находят. Может, и тебе помогут».~
@10797 = ~«Ладно. Я хотел бы задать ещё пару вопросов».~
@10798 = ~«Спасибо. Прощай».~
@10799 = ~«Это место? „Горящий труп“. Лучший кабак в городе. Еси, ясно дело, ничего не имеешь против пьянки в компании извергов. И еси не боишься наткнуться на патруль Красной Смерти. Здесь куча народу. Куча интересных вещей. Куча».~
@10800 = ~«И ты одна из местных достопримечательностей, судя по всему. Ответь мне на пару вопросов».~
@10801 = ~«Ясно. Прощай».~
@10802 = ~«Этот? Это Игнус. Сбрендивший старый маг, которому када-та затесалась в башку блестящая мысль сжечь Улей. Видал аллею Опасных Углов? Он это таки сделал. Потом несколько магов собрались толпой и наложили на него какие-то заклятия, и теперь он… эм-м… талисман этой забегаловки. Один из тех магов — мой двоюродный брат. Не слишком-то крутой маг, но он поймал этого пня!»~
@10803 = ~«Это здорово, Хлоппи. У меня ещё пара вопросов».~
@10804 = ~«Спасибо, Хлоппи. Прощай».~
@10805 = ~«Что ты хочешь узнать?»~
@10806 = ~«Кто ты?»~
@10807 = ~«Я ищу дневник. Не видел ничего подобного в последнее время?»~
@10808 = ~«Я ищу Сборщика по имени Фарод. Ты что-нибудь о нём знаешь?»~
@10809 = ~«Что ты можешь рассказать мне об этом месте?»~
@10810 = ~«Кто этот горящий тип у входа?»~
@10811 = ~«Ничего. Всего доброго».~
@10812 = ~«Фарод? Знакомое имечко, но… а, ну ты знаешь, как выпивка в голове шумит, ясно дело знаешь. Просто не могу припомнить. Извиняй, чувак-в-шрамах».~
@10813 = ~«Хорошо. Тогда ответь на пару вопросов, ладно?»~
@10814 = ~«Хорошо. Всего доброго».~
@10815 = ~«Это было весьма основательно, Игнус, и несколько поспешно. Я хотел с ней поговорить».~
@10816 = ~На лице и руках этой женщины можно заметить следы от синяков, в её погасших глазах видно лишь отчаяние. Когда-то она была, похоже, весьма привлекательной, но эти дни давно прошли. Она медленно поворачивается к тебе. Жизнь появляется в чертах её лица, а в глазах зажигается сардонический огонёк, и ты удивляешься, насколько глаза тебя обманули: «Добро пожаловать в „Горящий труп“, человек со шрамами».~
@10817 = ~«Кто ты?»~
@10818 = ~«Я ищу дневник. Ты ничего такого, случайно, не видела?»~
@10819 = ~«Что ты можешь рассказать мне об этом месте?»~
@10820 = ~«Кто этот горящий тип у входа?»~
@10821 = ~«Я ищу Сборщика по имени Фарод. Не доводилось видеть его или слышать о нём?»~
@10822 = ~«Неважно. Всего хорошего».~
@10823 = ~В этот раз Друзилла выглядит чуть поживее — по крайней мере, ты не видишь в её лице отчаяния. «Привет ещё раз, путник».~
@10824 = ~«Привет, Друзилла. Я хотел бы задать кое-какие вопросы».~
@10825 = ~«Здравствуй, Друзилла, и прощай».~
@10826 = ~«Я? Я Друзилла. А ты, должно быть, бестолочь. И не спрашивай, откуда я знаю. Это у тебя на морде написано».~
@10827 = ~«Бестолочь? Я другого мнения».~
@10828 = ~«Правильно. Написано. Ответь мне на пару вопросов».~
@10829 = ~«Не хочу это слышать. И особенно от тебя. Всего хорошего».~
@10830 = ~«Дневник? О, конечно. Я же слежу за всеми потерянными дневниками. Просто на всякий случай, вдруг мужик в шрамах придёт в мой любимый кабак и начнёт о нём спрашивать. Ты каждого встречного об этом спрашиваешь? Какая увлекательная жизнь».~
@10831 = ~«А у тебя острый язычок, ведь так?»~
@10832 = ~«Просто ответь на мои вопросы, и проехали».~
@10833 = ~«Держу пари, увлекательней твоей».~
@10834 = ~«Это? Это „Горящий труп“, хотя горящий ещё не помер. Он просто поддерживает в себе жизнь, пока кто-то не придёт и не освободит его. Сюда приходят те, кому приятно видеть чужие страдания. Например, извергам это нравится. Да и люди, которых это не парит, тоже идут сюда… само название отпугивает большинство остальных придурков».~
@10835 = ~«Так кто он, всё-таки?»~
@10836 = ~«Понял. Ответь на другой вопрос».~
@10837 = ~«Хорошее название. Прощай».~
@10838 = ~Отчаяние, которое ты видел на её лице раньше, снова проносится чернокрылой тенью. Потом она овладевает собой: «Это Игнус, один из величайших магов, когда-либо рождавшихся в этой, с позволения сказать, выгребной яме. Они схватили его и открыли через него канал на план Огня. Теперь он просто дверь туда и поддерживает в себе жизнь исключительно силой воли. Если бы кто-нибудь на короткое время потушил его, это вернуло бы его к жизни… но не наберёшь столько воды».~
@10839 = ~«А как насчёт этого графина? Говорят, он бездонный».~
@10840 = ~«Кто-нибудь наверняка что-нибудь придумает. А, ладно. Можно я задам тебе ещё пару вопросов?»~
@10841 = ~«Что тебя с ним связывает?»~
@10842 = ~«Жалость какая. Прощай».~
@10843 = ~«Да, путник? Что ты хочешь знать?»~
@10844 = ~«Кто ты?»~
@10845 = ~«Я ищу дневник. Ты ничего такого, случайно, не видела?»~
@10846 = ~«Что ты можешь рассказать мне об этом месте?»~
@10847 = ~«Я ищу Сборщика по имени Фарод. Не доводилось видеть его или слышать о нём?»~
@10848 = ~«Кто этот горящий тип у входа?»~
@10849 = ~«Ничего. Всего хорошего».~
@10850 = ~Она ухмыляется, и синяки становятся почти незаметными: «Как скажешь, лапуля».~
@10851 = ~«Конечно. Ответь мне на пару вопросов».~
@10852 = ~«Разумеется. Прощай».~
@10853 = ~«Да, острый язычок от острого ума. Я вовсе не идиотка, как ты, наверно, подумал, доходяга. Мозги у меня есть».~
@10854 = ~«Если ты такая умная, то сможешь ответить на мои вопросы».~
@10855 = ~«Плохо, что не В тебе. Прощай».~
@10856 = ~«О, вот как, да? Ты когда-нибудь любил живое пламя? Ты когда-нибудь жаждал совсем пропасть в чужих руках, потерять себя в огне страсти? Твои глаза говорят мне, что ты получал желаемое, но не получил удачи. Не рассказывай мне об увлекательном. Шрамы не увлекательны. Драки не увлекательны. Крутость не увлекательна. ТЫ не увлекателен».~
@10857 = ~«Я не считаю, что должен оправдываться перед тобой».~
@10858 = ~«С чего начать? Я бессмертен, я теряю память при каждой смерти, у меня в закадычных друзьях летающий череп, кое-что из пережитого мной заставит большинство смертных кричать так, что души через глаза повылазят, и ты говоришь мне, что любить огонь увлекательно? Это не увлекательно — это просто безумно».~
@10859 = ~«С чего начать? Я бессмертен, я теряю память при каждой смерти, кое-что из пережитого мной заставит большинство смертных кричать так, что души через глаза повылазят, и ты говоришь мне, что любить огонь увлекательно? Это не увлекательно — это просто безумно».~
@10860 = ~«Разговор окончен».~
@10861 = ~«Ой-ой, это же так сложно, да? Отвали. Мне нет нужды говорить с тобой», — она поворачивается спиной и забывает о твоём существовании.~
@10862 = ~«Ещё увидимся».~
@10863 = ~«Прощай».~
@10864 = ~Она вдруг отшатывается и пристально на тебя смотрит. В её голосе появляется плохо сдерживаемое волнение: «Ты тот самый, не так ли? Ты тот самый!»~
@10865 = ~«Что ты имеешь в виду?»~
@10866 = ~«Нет. Я просто хочу задать пару вопросов».~
@10867 = ~«Ничего подобного. Прощай».~
@10868 = ~«Он сказал, что ты придёшь! Он сказал, что ты тот, кто освободит его! Он говорил со мной во сне и сказал, что ты придёшь с морем воды и уравновесишь его, так что он сможет прожечь путь сквозь планы! Освободи его! Пожалуйста, спаси его!»~
@10869 = ~«Что тебя с ним связывает?»~
@10870 = ~«Я подумаю об этом. Но сперва ответь ещё на пару вопросов».~
@10871 = ~«Я подумаю об этом. Прощай».~
@10872 = ~«Я была возлюбленной Игнуса. Мы оба любили огонь, хотя он любил его больше, чем я. Но теперь я смотрю на его красоту, когда он корчится в сердце огня, и я, Друзилла, люблю их обоих одинаково».~
@10873 = ~«Уж не спятила ли ты? Ладно, ответь ещё на кое-какие вопросы».~
@10874 = ~«У тебя просто не все дома. Прощай».~
@10875 = ~«Когда ты освободишь Игнуса?»~
@10876 = ~«Как только смогу использовать это на нём. Говорят, в этом графине бесконечный запас воды».~
@10877 = ~«А кто ты ему?»~
@10878 = ~«Я ищу дневник. Ты его, случайно, не видела?»~
@10879 = ~«Я ищу Сборщика по имени Фарод. Не доводилось видеть его или слышать о нём?»~
@10880 = ~«Что ты можешь рассказать мне об этом кабаке?»~
@10881 = ~«Ещё раз, где твой тайник?»~
@10882 = ~«Да! Используй это на нём, и он наверняка освободится! О, мой Игнус, я жду тебя! — она на миг прерывается, в её глазах благоговейный ужас. — Ты знаешь ключевое слово?»~
@10883 = ~«Ещё нет».~
@10884 = ~«Да».~
@10885 = ~«Это тюрьма для моего любимого, место, куда его безжалостно заточили на века, место, куда я прихожу десятилетиями, чтобы разделить с ним его огненные мучения. Место, заставившее меня жить, невзирая на годы и рассудок. Я ненавижу это место».~
@10886 = ~«Ладно. У меня другие вопросы».~
@10887 = ~«Я понял. Прощай».~
@10888 = ~Её голос просто пульсирует глубокой болью: «Я была возлюбленной Игнуса, а он моим возлюбленным. Он любил пламя больше, чем меня, и теперь он стал пламенем — а так как я люблю его, я люблю пламя… кроме всего, что оно сделало. Теперь я жду, когда он потухнет. Я бы продала всё, что у меня есть, лишь бы быть рядом с ним».~
@10889 = ~«Ладно. У меня другие вопросы».~
@10890 = ~«Я понял. Прощай».~
@10891 = ~«Фарод? — она смеётся. — Король Сборщиков? Наверно, найдёшь его и его вонючую банду в мусорных трущобах на дальней стороне Улья. Удачи тебе, если хочешь получить от него какие бы то ни было ответы — он коварный дьявол».~
@10892 = ~«Хорошо. У меня другие вопросы».~
@10893 = ~«Я понял. Прощай».~
@10894 = ~«Фарод? — она усмехается. — Король Сборщиков? Наверно, найдёшь его и его вонючую банду в мусорных трущобах на дальней стороне Улья. Удачи тебе, если хочешь получить от него какие бы то ни было ответы. Он коварный дьявол. Но куда ему до моего Игнуса».~
@10895 = ~«Хорошо. У меня другие вопросы».~
@10896 = ~«Я понял. Прощай».~
@10897 = ~«Я не видела никаких дневников, о которых могу вспомнить. Не знаю. Может, спросить Сборщиков? Я не знаю!»~
@10898 = ~«Не особо помогла. Ответь мне на пару вопросов, Друзилла».~
@10899 = ~«Я понял. Прощай».~
@10900 = ~Это начинающий лысеть мужчина с циничным выражением лица. Он говорит отрывисто, чётко и ясно выговаривая каждое слово: «Что тебе нужно, здоровяк?»~
@10901 = ~«Кто ты?»~
@10902 = ~«Я ищу дневник».~
@10903 = ~«Я ищу парня по имени Фарод. Он Сборщик. Не видел его? А может, слышал о нём что-нибудь?»~
@10904 = ~«Что ты можешь рассказать мне об этом месте?»~
@10905 = ~«Кто этот горящий тип у входа?»~
@10906 = ~«Что ты и твоя подруга говорили о Сигиле?»~
@10907 = ~«Ничего. Всего доброго».~
@10908 = ~«Как раз когда мы с ней собирались вступить в очередную увлекательную беседу, — его голос прямо-таки источает сарказм. — Чем я могу тебе помочь?»~
@10909 = ~«Хотел задать тебе пару вопросов».~
@10910 = ~«Ничем. Забудь».~
@10911 = ~«Я Килен Железные Пальцы. И предупреждая твой следующий вопрос: я получил это имя после того, как мой идиот братец уронил мне на ноги пятидесятифунтовый камень и раздробил пальцы на ногах. Теперь они у меня железные. Идёт?»~
@10912 = ~«Идёт. Наверное. Я хочу задать тебе другой вопрос».~
@10913 = ~«Ладно. Прощай».~
@10914 = ~«Я ничего такого не видел. По крайней мере, ничего такого, что отложилось бы в памяти. Если он не особо ценный, поищи в мусорных кучах на противоположном конце Улья. Сочувствую твоему положению. Дневники содержат саму суть личности. Они дают нам взгляд на прошлое и помогают планировать будущее. Сам я всегда веду дневник и полагаю, что это изменило меня к лучшему», — последнее он говорит с самодовольной улыбкой.~
@10915 = ~«А ты не шутишь. Ещё пара вопросов».~
@10916 = ~«Мусорные кучи, говоришь? Спасибо».~
@10917 = ~«Это „Горящий труп“. Я привёл свою неопытную, бестолковую, неотёсанную двоюродную сестру познакомиться с некоторыми видами, запахами и звуками Сигила. Пока, правда, они её не впечатлили».~
@10918 = ~«Ясно почему. Можешь рассказать мне о другом?»~
@10919 = ~«Правда? Странно. Всего доброго, уважаемый».~
@10920 = ~«Если слухи правдивы, этого несчастного зовут Игнус. Он сжёг дотла часть Улья, пока народ не собрался и не позаботился о нём. Из него сделали канал на стихийный план Огня, и теперь он корчится тут к удовольствию почтеннейшей публики. Не слишком забавное зрелище, конечно, зато интересно».~
@10921 = ~«Конечно. Можешь рассказать мне о другом?»~
@10922 = ~«Да, верно. Прощай».~
@10923 = ~«А. Моя двоюродная *сестра*… — он акцентирует это слово, как бы подчёркивая, что вынужден её сопровождать, — …недавно прибыла из своего захолустного первичного мира. Мой дядя, знаменитый маг, перенёс её сюда, чтобы расширить ей кругозор. Она пребывает в заблуждении, что *здесь* центр мультивселенной, и почему-то думает, что это крайне важно. Так как я тут всю жизнь прожил, я думаю иначе: это место, за которым присматривают силы и рождённые на планах, в точности как люди ухаживают за белками в парке. Ничего важного, и чем скорее люди поймут, что они ничего важного из себя не представляют, тем лучше».~
@10924 = ~«Правда? Хм. Надо бы выслушать её аргументы. А сейчас, ты не мог бы ответить на другой вопрос?»~
@10925 = ~«Увлекательно. Спасибо и всего доброго».~
@10926 = ~«Что ты хотел бы узнать?»~
@10927 = ~«Кто ты?»~
@10928 = ~«Я ищу дневник».~
@10929 = ~«Я ищу Сборщика по имени Фарод. Не видел его? А может, слышал о нём что-нибудь?»~
@10930 = ~«Что ты можешь рассказать мне об этом месте?»~
@10931 = ~«Кто этот горящий тип у входа?»~
@10932 = ~«Что ты и твоя подруга говорили о Сигиле?»~
@10933 = ~«Ничего. Всего доброго».~
@10934 = ~«Сборщик? Уж не один ли из тех мерзких трупоносов? Я с такими типами знакомства не вожу. Не моего круга люди. Так что я ничего о нём не слышал».~
@10935 = ~«А какого ТЫ круга?»~
@10936 = ~«Не слишком-то помог. Может быть, ты позволишь задать тебе ещё пару вопросов».~
@10937 = ~«Тогда прощай».~
@10938 = ~«Я живу со своим дядей в районе Госпожи. Там живут лучшие люди города, если мне позволено будет так отозваться о своей персоне. И никакого тебе отребья, которое тут так и кишит. Нет, надо сказать, этот район города — ОПРЕДЕЛЁННО трущобы. Не могу сказать, чтобы это мне очень уж нравилось, но надо же получить опыт общения с разными сторонами жизни. С этой стороной я почти закончил».~
@10939 = ~«Район Госпожи, да? Ладно. Ещё вопрос».~
@10940 = ~«Хорошо. Прощай».~
@10941 = ~Это женщина с отстранённым выражением лица. По виду сложно понять, молодая она или старая. Может быть, выражение лёгкого недоверия на лице мешает определить её возраст. Это выражение показывает, что она не доверяет своим чувствам. Обратив на тебя внимание, она произносит резко, но без неприязни: «Тебе что-нибудь нужно?»~
@10942 = ~«Кто ты?»~
@10943 = ~«Я ищу дневник».~
@10944 = ~«Я ищу Сборщика по имени Фарод. Не доводилось видеть его или слышать о нём?»~
@10945 = ~«Что ты можешь рассказать мне об этом месте?»~
@10946 = ~«Кто этот горящий тип у входа?»~
@10947 = ~«Что ты и твой друг говорили о Сигиле?»~
@10948 = ~«Ничего. Всего доброго».~
@10949 = ~«Тебе чего-нибудь нужно?»~
@10950 = ~«Ответы на пару вопросов».~
@10951 = ~«Нет. Прощай».~
@10952 = ~«Я Киарус. Киарус Колючий Язык. Здесь с двоюродным братом, потому что дядюшка не разрешает мне бродить по Улью одной. Кажется, он не верит, что я вполне взрослая. Может, он и прав. Я не знаю как следует ни этот город, ни этот план. Я не отсюда. С Первичного плана».~
@10953 = ~«С Первичного плана? А что это такое?»~
@10954 = ~«Ты с Первичного плана?»~
@10955 = ~«Ну, ты всё же можешь знать ответы на мои вопросы».~
@10956 = ~«Тогда ты, наверное, не сможешь мне ответить. Прощай».~
@10957 = ~«Извини. Я недавно в городе, и могу заверить, что мне не приходилось здесь видеть ничего похожего на дневник. Хотя мне говорили, что нечто, выглядящее как существо, может на самом деле быть для кого-нибудь дневником. Я всё пытаюсь разобраться в местной философии. Порой она кажется непостижимой, но говорят, что если не сдаваться, со временем станет много проще».~
@10958 = ~«Какое облегчение. Я хотел бы спросить тебя кое о чём».~
@10959 = ~«Надеюсь. Прощай».~
@10960 = ~«Это, как я понимаю, таверна „Горящий труп“, названная в честь того парня рядом со входом. Насколько вижу я, это забегаловка, где отбросы смешивают с кремом, чтобы получить совсем уж неаппетитный новый вкус. Разумеется, я с Первичного плана и могу быть слегка предвзятой».~
@10961 = ~«Ты с Первичного плана? Что это значит?»~
@10962 = ~«Ты с Первичного плана? Что ты здесь делаешь?»~
@10963 = ~«Возможно. Не всегда вещи таковы, какими их видишь здесь. Могу я задать тебе пару вопросов?»~
@10964 = ~«Может быть. Прощай».~
@10965 = ~«Это Игнус. Он пытался сжечь часть города некоторое время назад — века, быть может? — и был наказан превращением в живое пламя. Незавидная судьба, но этот пироман и поджигатель её заслужил. Из того, что я читала, оставить его совсем одного было лучшим решением».~
@10966 = ~«Откуда ты столько знаешь об этом месте? Ведь ты же с первичного?»~
@10967 = ~«Я хотел бы задать тебе ещё вопрос».~
@10968 = ~«Спасибо. Всего доброго».~
@10969 = ~«Он мне не друг, а двоюродный брат. Он просто говорил мне, что здесь совсем не центр мультивселенной, хотя место это расположено прямо в центре Внешних Земель, хотя здесь точка выхода порталов, ведущих со всей вселенной, — нигде нет больше — хотя все ссоры богов происходят над ним, хотя совершенно разные силы сконцентрировались в этом месте. Не существует другого такого места в космосе, а он мне говорит, что в нём нет ничего необычного? Ха!»~
@10970 = ~«Интересная точка зрения. Может, каждый из вас по-своему прав?»~
@10971 = ~«Как бы то ни было, я хочу задать тебе другой вопрос».~
@10972 = ~«Интересно. Мне пора идти. Прощай».~
@10973 = ~«Спрашивай. Я отвечу, если смогу».~
@10974 = ~«Кто ты?»~
@10975 = ~«Я ищу дневник».~
@10976 = ~«Я ищу Сборщика по имени Фарод. Не доводилось видеть его или слышать о нём?»~
@10977 = ~«Что ты можешь рассказать мне об этом месте?»~
@10978 = ~«Кто этот горящий тип у входа?»~
@10979 = ~«Что ты и твой друг говорили о Сигиле?»~
@10980 = ~«Забудь. Всего доброго».~
@10981 = ~«Может, ты и прав, но такой релятивизм выше моего понимания. Место либо представляет важность, либо нет. Парадокс может питать планы, но здесь должна быть какая-то определённость».~
@10982 = ~«Не обязательно… но сейчас у меня нет времени об этом спорить. Взамен я хотел бы задать тебе пару вопросов».~
@10983 = ~«Надеюсь. Мне нужны ответы. Прощай».~
@10984 = ~Она склоняет голову набок и странно на тебя смотрит. «Первичный материальный план? Место, где по поверью родились и сформировались внешние планы? Мир? Звёзды, луны и так далее? Вера и действительность? Я очень надеюсь, что ты знаешь, чем является Первичный план, потому как это неотъемлемая часть планарного знания».~
@10985 = ~«Это я знаю. У меня другие вопросы».~
@10986 = ~«О. Ну ладно. Прощай».~
@10987 = ~«В гостях. Расширяю свой кругозор. Первичный план — чудесное место для жизни, но он какой-то слишком… настоящий, что ли. Мой дядюшка каждому из своих племянников и племянниц даёт возможность несколько лет пожить на планах и позволяет нам остаться здесь, если мы так решим. Наверное, я так и решу. Я очарована и шокирована. Но предполагаю, что такова природа планов, верно?»~
@10988 = ~«Насколько я понимаю, верно. У тебя хватит познаний, чтобы ответить на мои вопросы?»~
@10989 = ~«Да, так и есть. Прощай, и удачи тебе».~
@10990 = ~«Да. Прощай».~
@10991 = ~«Как и я, дядя Килан — маг, и живёт он здесь. Он разбросал своих родственников по планам случайным образом, чтобы показать им красоты и ужасы мультивселенной. Я хотела быть готовой к этому путешествию и подготовилась. Хорошо подготовилась. Возможно, я знаю об этом городе больше, чем мой двоюродный брат, который живёт здесь всю жизнь», — она делает жест в сторону стоящего рядом мужчины.~
@10992 = ~«Вот так дядя. Могу я задать тебе другой вопрос?»~
@10993 = ~«Вот так подарок. Прощай».~
@10994 = ~«Сборщик? Не уверена, что слышала это слово… — она замолкает в раздумье. — Это один из тех, кто переносит трупы? Те бедные люди, которые собирают тела бесчисленных жертв в Улье и получают за них деньги?»~
@10995 = ~«Да».~
@10996 = ~«Очевидно, что ты его не знаешь, поэтому я задам тебе другой вопрос».~
@10997 = ~«Забудь. Прощай».~
@10998 = ~«Как я понимаю, они концентрируются главным образом в тех частях Улья, которые дальше всего от Мортуария, где больше жизни и больше насилия. Лучше тебе развернуть свои поиски подальше от дома мёртвых».~
@10999 = ~«Возможно, так и сделаю, но сперва я хотел спросить тебя ещё кое о чём».~
@11000 = ~«Хороший совет. Спасибо тебе, и прощай».~
@11001 = ~Отказаться от рукопожатия.~
@11002 = ~Рукопожатие у него крепкое. «Таким образом я приношу свои извинения за неудачные шутки, парень. Надеюсь, ты не принял их близко к сердцу; могу я поставить тебе кружечку или две, чтоб загладить вину?»~
@11003 = ~«Почему нет?»~
@11004 = ~«Нет».~
@11005 = ~От убирает руку. «Ладно, ладно. Таким образом я приношу свои извинения за неудачные шутки, парень. Надеюсь, ты не принял их близко к сердцу; могу я поставить тебе кружечку или две, чтоб загладить вину?»~
@11006 = ~«Почему нет?»~
@11007 = ~«Нет».~
@11008 = ~«Вот это настрой, парень! Подожди минутку», — он встаёт и направляется к стойке. Через минуту он возвращается с парой кружек: «Держи, парень. Твоё здоровье!» Он делает добрый глоток из своей кружки, выпускает клуб дыма и говорит: «Что старина Эбб может для тебя сделать в этот чудный сигильский день?»~
@11009 = ~«У меня были вопросы об этом месте».~
@11010 = ~«Ничего. Прощай».~
@11011 = ~«Ладно, парень, ладно, — он на пару секунд прерывается, попыхивая трубкой, затем говорит. — Так что старина Эбб может для тебя сделать в этот чудный сигильский день?»~
@11012 = ~«У меня были вопросы об этом месте».~
@11013 = ~«Ничего. Прощай».~
@11014 = ~«О, ну я так и подумал, лишь только глянул на тебя. Я к тому, что ты вроде не выглядишь здешним, парень… малость не в своей тарелке для коренного жителя!» — Эбб хихикает, затем делает ещё глоток. «Так чем я могу тебе помочь, парень? Хочешь узнать, что здесь к чему?» — Эбб подмигивает.~
@11015 = ~«Кто ты?»~
@11016 = ~«Чем занимаешься?»~
@11017 = ~«Что это за место?»~
@11018 = ~«Да. Расскажи мне, как тут всё заведено в городе и окрестностях».~
@11019 = ~«Нет. Прощай».~
@11020 = ~«Эбб Скрипучие Колени, Третья Ступень Гармониума, ныне в отставке и служу проводником, глотку деру, ибо не могу двигаться так же легко, как лет тридцать назад! — он хмыкает. — Теперь твоя очередь, парень. Кто ты такой, и в чём твоя проблема?»~
@11021 = ~«Третья Ступень Гармониума?»~
@11022 = ~«Что значит проводник?»~
@11023 = ~«Почему ты думаешь, что у меня проблема?»~
@11024 = ~«Забудь. До свидания».~
@11025 = ~Эбб гордо надувается и напускает на себя суровости. «Да, Третья Ступень Гармониума… — он чуть переводит дух. — Хотя служил не больше десятка лет. Не особо сподручно выколачивать из кого-то пыль после всех боёв и стычек, в которых я побывал, так что я сижу тут, в Улье, и пытаюсь понемножку помогать людям чем могу. А ты как раз похож на нуждающегося в поддержке… какие-то неприятности, парень?»~
@11026 = ~«А в каких боях и стычках ты был?»~
@11027 = ~«В некотором роде».~
@11028 = ~«Сущие пустяки. Я очнулся в Мортуарии и, похоже, забыл, кто я такой».~
@11029 = ~«Вообще-то это не твоё дело. У меня ещё пара вопросов…»~
@11030 = ~«Ничего особенного. Прощай».~
@11031 = ~Эбб вращает глазами. «Их было больше, чем смогу припомнить, парень! Ну ладно… *почти что* больше, чем смогу припомнить, по крайней мере. Я участвовал во всех дальних походах Кровавой Войны, в той позорной адской Войне Лжи на Землях, и много-много лет в Войне Чёрных Веков… — Эбб начинает загибать пальцы и считать про себя, — …э, потом была Война Трёх Планов и много других, я даже поучаствовал в Войне за Освобождение Гармониума. Ох, и наконец я был в Городском Карауле Сигила… кое-кто бы сказал, что это и было самое опасное!» Он громко хохочет. При упоминании Кровавой Войны ты чувствуешь, словно тебе всадили в сердце холодный кинжал.~
@11032 = ~«Расскажи мне больше о Кровавой Войне».~
@11033 = ~«У меня другие вопросы…»~
@11034 = ~«Спасибо, Эбб. Прощай».~
@11035 = ~Эбб вздыхает, не обращая внимания на твою реакцию. «Да-а… Кровавая Война — самая страшная междоусобица по эту сторону от изначального тумана. С одной стороны толпа подлых извергов, с другой — группа демонов-милитаристов. Такая война, что потрясла основы творения, и до сих пор они грызутся друг с другом».~
@11036 = ~«Так значит, две группы извергов воюют друг с другом?»~
@11037 = ~«У меня другие вопросы…»~
@11038 = ~«Спасибо. Прощай».~
@11039 = ~«Да. Танар'ри, ужасные убийцы, которые заботятся только о себе, и военная машина баатезу — всё во имя закона и порядка под их адским господством. Вся эта заваруха временами перекидывается на другие планы, что делает мультивселенную куда менее приятным местом для жизни».~
@11040 = ~«Ясно. У меня другие вопросы…»~
@11041 = ~«Ясно. Прощай, Эбб».~
@11042 = ~«О, вот как. Что ж, надеюсь, ничего слишком серьёзного… но не буду допытываться. В этом городе и так проблем хватает, не хочу добавлять. Когда почувствуешь, что хочешь поговорить, — приходи».~
@11043 = ~«У меня другие вопросы…»~
@11044 = ~«Спасибо. Прощай».~
@11045 = ~«А? — Эбб моргает, затем хмурится. — Что ты сказал, парень? Ты очнулся в Мортуарии…» Эбб внимательно тебя разглядывает. «О, так они приняли тебя за мёртвого из-за всех этих шрамов? — он хихикает. — Не скажу, что я сообразил бы быстрее…» Он выпускает клуб дыма. «А эти Пыльники… — Эбб собирается с мыслями. — То бишь эти *Пыльные*… „Пыльники“ звучит грубовато по отношению к этим бледнолицым приятелям, а я не хочу показаться совсем уж неуважительным… они же всё своё внимание и дружелюбие обращают на могильные камни, ага? Не скажу, что не видел их скрючившихся за таким занятием, парень».~
@11046 = ~«Да, мне тоже доводилось видеть. У меня другие вопросы…»~
@11047 = ~«Нет. Прощай».~
@11048 = ~«Что ж, своевременный вопрос, поскольку теперь мне очевидно, что ты совсем зелёный, а проводник — лучший друг всех бестолочей, которые хотят пробежаться по улицам Сигила. И я как раз тот, кто тебе нужен, — он делает глоток. — Проводник — это дружелюбный городской гид; он показывает тебе, что есть что, даёт общее представление о городе… проводник — да, проводник — лучшая помощь при его осмотре. Если не считать, что я не встаю с этого стула из-за возраста, так я могу подсказать тебе направления и места, которые любому захочется посетить в путешествиях по нашему чудесному городу. И совершенно бесплатно».~
@11049 = ~«Почему бесплатно?»~
@11050 = ~«И сколько тебе лет?»~
@11051 = ~«Проводник, который сам не ходит, не может заламывать цену, парень. Во имя сил, не платить же за пустую болтовню!»~
@11052 = ~«Сколько тебе лет?»~
@11053 = ~«У меня другие вопросы…»~
@11054 = ~«И верно. Прощай».~
@11055 = ~«Достаточно стар, чтобы узнать жизнь получше, парень, и слишком стар, чтобы много ходить! — он попыхивает трубкой. — Скажу только, что мои лучшие годы уже позади, и лишь кое-какие узы заставляют биться это сердце».~
@11056 = ~«Какие узы?»~
@11057 = ~«Ясно. У меня другие вопросы…»~
@11058 = ~«Похоже на правду. Прощай».~
@11059 = ~«Ну, парень, не хочу портить разговор, но надеюсь, в один прекрасный день и в старый добрый „Горящий труп“ придёт святой, и надеюсь, он отпустит кое-какие мои тайные грешки, чтобы я смог отправиться на лучший план».~
@11060 = ~«Ясно. У меня другие вопросы…»~
@11061 = ~«Ясно. Прощай».~
@11062 = ~«Парень, ни у кого нет стольких шрамов, как у тебя, разве это не показатель проблем, если не от других, так от самого себя?! — Эбб смотрит на тебя с насмешливым укором. — За кого ты принимаешь старого Эбба? За слепого?! Ха! Слушай, из меня уже песок скоро посыплется, но я ещё кое-что вижу и кое-что соображаю! Ну, и что у тебя случилось? Может, я смогу тебе помочь, а?»~
@11063 = ~«У меня другие вопросы…»~
@11064 = ~«Небольшие неприятности, вот и всё».~
@11065 = ~«Сущие пустяки. Я очнулся в Мортуарии и, похоже, забыл, кто я такой».~
@11066 = ~«Наверняка нет. Прощай».~
@11067 = ~«„Чем занимаюсь?“ Странный вопрос, парень. А на что это похоже?.. Убиваю время в приятном окружении, с кружкой пива в обнимку, с трубочкой и в интересной компании. Замечательный способ провести день, полагаю! Ага? Ага?» — Эбб хлопает тебя по плечу и смеётся.~
@11068 = ~«„Ага“, конечно. У меня ещё пара вопросов…»~
@11069 = ~«Конечно. Прощай».~
@11070 = ~«Ты в кабаке „Горящий труп“, парень. Не такое приятное место, как некоторые другие, но своё грубое очарование ему присуще».~
@11071 = ~«Расскажи мне о посетителях».~
@11072 = ~«Чей это горящий труп?»~
@11073 = ~«Что тут лучше всего выпить?»~
@11074 = ~«У меня другие вопросы…»~
@11075 = ~«Прощай».~
@11076 = ~«Ну, тут есть O, по его словам, он не личность, а буква; несколько Убийц Милосердия, поджидающих преступника; дальше парочка абишаев в отпуске с Кровавой Войны; гитцерай, который глядит на тебя издалека, приятель из пытливых и вполне тут к месту, уверяю; там Алайс, из бестолочей, которому штаны малость жмут, если понимаешь, о чём я. Если тебе нужна информация о планах, вон Кандриан Болезненный — он знает куда больше меня и с радостью поделится».~
@11077 = ~«Чей это горящий труп?»~
@11078 = ~«Что тут лучше всего выпить?»~
@11079 = ~«У меня другие вопросы…»~
@11080 = ~«Прощай».~
@11081 = ~«Он-то? Да никакой он не труп, парень, вовсе не жмурик. Насколько мы можем судить, старина Игнус всё ещё живой, хоть и вертится как свинья на вертеле. Во всяком случае, мы можем так полагать, — Эбб морщит нос. — А ещё он порой адски жутко воняет. Не расстаюсь с трубкой, чтобы эта вонь не просочилась мне в нос». Он смеётся.~
@11082 = ~«Как он туда попал?»~
@11083 = ~«У меня другие вопросы…»~
@11084 = ~«Ну, не скажешь, что я прям по-бааторийски придирчив, когда дело доходит до выпивки, но кое-что я люблю, а некоторые марки — нет. Как ни странно, из моего самого любимого в этом баре — арборейские огненные семена… полощешь их во рту, добавляя чуток воздуха, немножко слюны и спирта, и можно выдыхать огонь, если надо. По крайней мере, такое возникает чувство».~
@11085 = ~«Расскажи мне о посетителях».~
@11086 = ~«Чей это горящий труп?»~
@11087 = ~«У меня другие вопросы…»~
@11088 = ~«Прощай».~
@11089 = ~Он затягивается, как будто подбирая слова. «Ну, знаешь, парень, Игнус нахватался проблем и нехилых магических знаний в придачу, а такая смесь редко к добру, если ты меня понимаешь. Он любил… — Эбб выпускает в потолок клуб дыма, — …ну, он любил всё поджигать и начал превращать в факелы людей, дома. В итоге наломал кучу дров».~
@11090 = ~«И?»~
@11091 = ~«У меня другие вопросы…»~
@11092 = ~«Вот беда. Прощай».~
@11093 = ~«Ну, большая часть всего этого происходила в Улье, а я вынужден признать, что Улей — не то место, где силы Гармониума поддерживают закон Сигила в первую очередь… — Эбб выглядит слегка пристыженным. — Оплошность с нашей стороны, поскольку этому месту мы, возможно, нужнее всего. Ну и, с молчаливого согласия Госпожи, произошло небольшое уличное судилище в сообществе магов… гадалки на чайных листьях, захудалые колдуны и ведьмы-повитухи собрались толпой и ухитрились сплести заклинание, которое стало чем-то вроде высшего правосудия». Эбб указывает трубкой в сторону Игнуса: «Так что теперь он горит здесь, но всё ещё жив, на что они, подозреваю, не рассчитывали».~
@11094 = ~«Хм. У меня другие вопросы…»~
@11095 = ~«Интересно. Прощай».~
@11096 = ~«Да, парень? Что ты хочешь узнать?»~
@11097 = ~«Не знаешь кого-нибудь по имени Фарод?»~
@11098 = ~«Я потерял дневник».~
@11099 = ~«Кто ты?»~
@11100 = ~«Что это за место?»~
@11101 = ~«Расскажи мне о Сигиле и его окрестностях».~
@11102 = ~«Какие ещё места ты советуешь посетить?»~
@11103 = ~«Ничего. Прощай».~
@11104 = ~«Фарод? — Эбб хмурится, вынимает трубку изо рта. — Парень, что тебе нужно от такого пня, как Фарод?»~
@11105 = ~«Похоже, я раньше знал его».~
@11106 = ~«Думаю, он кое-что у меня украл».~
@11107 = ~«Не твоё дело. Что ты о нём знаешь?»~
@11108 = ~«Ничего. У меня другие вопросы…»~
@11109 = ~«Ничего. Прощай».~
@11110 = ~«А, ну тогда твоё невезение неудивительно. Пожалуй, кое-какие вещи тебе лучше забыть», — Эбб пускает обильные клубы дыма.~
@11111 = ~«Что ты о нём знаешь?»~
@11112 = ~«О, не сомневайся, парень, не сомневайся, — ворчит Эбб, мусоля во рту трубку. — Рядом с этим жадным пауком необходимо буквально всё держать на привязи. Он, должно быть, один из Обречённых: всё, что не приковано цепью, оседает в его доме. Дай ему палец — руку откусит, ага?»~
@11113 = ~«Что ты о нём знаешь?»~
@11114 = ~«Ну, я не знаю прямо-таки всего о старом Фароде, но знаю кое-что о тьме, которая его окружает. Если ты решил выследить этого паука и приколоть его к стенке, то собери сначала побольше баек, чтобы знать, во что впутываешься, — он прерывается, чтобы набить трубку. — Фарод не так давно свил себе гнездо на Площади Мусорщиков, собрал вместе толпу сборщиков и бандитов. Иной бы сказал: начал собирать свою фракцию… может, так и есть…»~
@11115 = ~«Где я могу его найти?»~
@11116 = ~«Ясно. У меня другие вопросы…»~
@11117 = ~«Ясно. Прощай».~
@11118 = ~«Ну, парень, если ты ищешь Фарода, — а я бы сказал, что ты тогда совсем спятил — то придётся чуток свернуть с проторённой дорожки. Тебе надо найти Площадь Мусорщиков. Ходит байка, что Фарод устроил своё логово где-то там. Где именно — даже я не знаю, хоть я не один раз кольцо обошёл. Подозреваю, Фарод хочет сохранить своё обиталище в тайне. Если ты твёрдо решил найти Фарода — иди на Площадь Мусорщиков и попытайся выяснить расположение его логова у местных. Попытайся, но будь осторожен, поскольку там полно тех, кто в один миг из тебя котлету сделает».~
@11119 = ~~
@11120 = ~«У меня другие вопросы…»~
@11121 = ~«Ясно. Прощай».~
@11122 = ~ТОЧКА ОТСЧЁТА~
@11123 = ~«Хорошо. У меня другие вопросы…»~
@11124 = ~«Спасибо. Прощай».~
@11125 = ~«Ты потерял дневник? Этот дневник был чем-то большим, чем просто странички и писанина? Иначе вряд ли кто-то будет тратить силы на слова, если только они не острые и меткие. Здесь мало пользы от умных книг. Не знаю, где ты можешь найти такую штуку… — Эбб попыхивает трубкой, затем щёлкает пальцами. — Но знаешь, парень, если это Фарод выкинул тебя с улиц Сигила, то он может знать, где твоё барахлишко… скорее всего, у него и осело. Как правило, мертвец не может защитить своё добро, когда Сборщики натыкаются на его тело».~
@11126 = ~«Расскажи мне о Фароде».~
@11127 = ~«У меня другие вопросы…»~
@11128 = ~«Спасибо. Прощай».~
@11129 = ~Эбб громко смеётся: «Ты не гонишься за малым, да? Если хочешь узнать о том, что за пределами города, — иди к Кандриану Болезненному, это вон тот путешественник. А что до остального… я могу рассказать тебе о Госпоже, о дабусах, о ключах и порталах, о том, как мы измеряем время, об устройстве города… Что ты хочешь узнать?»~
@11130 = ~«На самом деле я хотел задать пару других вопросов…»~
@11131 = ~«Расскажи мне о Госпоже».~
@11132 = ~«Расскажи мне о дабусах».~
@11133 = ~«Расскажи мне о времени Сигила».~
@11134 = ~«Расскажи мне об устройстве города».~
@11135 = ~«Расскажи мне о ключах и порталах».~
@11136 = ~«Ничего. Прощай».~
@11137 = ~«Что ещё ты хотел узнать о Клетке?»~
@11138 = ~«Ну, я не слишком много о ней знаю, парень, и думаю, даже те, кто знает больше, чем немного, всё равно знают не намного больше. Она окутана тайной, и даже если тебе придётся столкнуться с ней… упаси нас силы… она молчалива и смертоносна. Она не злая, вовсе нет, скажу тебе, но удерживает вокруг себя и Сигила совершенно непроницаемую тьму. Никто не может проникнуть сквозь тьму, а кому удаётся — те отправляются в лабиринты».~
@11139 = ~«Продолжай».~
@11140 = ~«В лабиринты? Что ты имеешь в виду?»~
@11141 = ~«У меня другие вопросы о Сигиле».~
@11142 = ~«У меня другие вопросы…»~
@11143 = ~«Спасибо. Прощай».~
@11144 = ~«Скорее всего, ты её не встретишь, если только не натворишь что-нибудь совсем уж ужасное… переколотишь кучу народа, убьёшь дабуса, выступишь против её власти, начнёшь её обожествлять. Она это ненавидит, равно как и когда мешают работе дабуса (ведь это может считаться и работой Госпожи). Если тебе повезёт, за тобой придут просто Убийцы Милосердия, но если придёт она — ты умрёшь в тот же миг, когда её тень падёт на тебя».~
@11145 = ~«Что ты имеешь в виду, говоря о „лабиринтах“?»~
@11146 = ~«Продолжай».~
@11147 = ~«У меня другие вопросы о Сигиле».~
@11148 = ~«У меня другие вопросы…»~
@11149 = ~«Спасибо. Прощай».~
@11150 = ~«Дальше, Госпожа может делать в Сигиле почти всё, парень, больше, чем мы можем вообразить. Сделать его больше или меньше, построить новые порталы, закрыть старые, проследить, чтобы Кровавая Война не выплеснулась на наши улицы, удержать кого угодно от телепорта в город, сдержать силы».~
@11151 = ~«Что ты имеешь в виду, говоря о „лабиринтах“?»~
@11152 = ~«Кто такие силы?»~
@11153 = ~«У меня другие вопросы о Сигиле».~
@11154 = ~«У меня другие вопросы…»~
@11155 = ~«Спасибо. Прощай».~
@11156 = ~«Да. Некоторых типов отправляют в места, где они не могут причинить вреда. Так вот, Госпожа берёт кусок Сигила и делает из него небольшое измерение, лабиринт. Потом помещает туда тех, кто перешёл ей дорогу, и оставляет их там гнить, — Эбб выпускает клуб дыма. — И… от этого не скрыться, парень, если Госпожа обратила на тебя взгляд. В конце концов она заберёт тебя, как бы ты ни сопротивлялся и ни прятался. Прогуливаешься по аллее, или прыгаешь через портал, или сворачиваешь на улочку, по которой тыщу раз ходил, и вдруг оказываешься незнамо где. Вообще, лабиринты не защищены от побега. Из любого есть выход… портал, который Госпожа оставила там. Тебе всего-то надо знать, где он и как им воспользоваться».~
@11157 = ~«У меня другие вопросы о Сигиле».~
@11158 = ~«У меня другие вопросы…»~
@11159 = ~«Спасибо. Прощай».~
@11160 = ~«А, эти забавные летающие франты, которые говорят символами? — Эбб смеётся. — Хороши, а? Дабусы — это слуги и работники Госпожи. Они делают в точности то, чего она хочет: смотрят, чтобы Сигилу ничего не угрожало, чинят стены, сносят старые дома, возводят новые, открывают порталы, запечатывают порталы и так далее. Это настоящие нейтралы; не пытайся помешать дабусу или убить его, иначе быстро навлечёшь на себя гнев Госпожи».~
@11161 = ~«Расскажи мне о Госпоже».~
@11162 = ~«У меня другие вопросы о Сигиле».~
@11163 = ~«У меня другие вопросы…»~
@11164 = ~«Спасибо. Прощай».~
@11165 = ~«Мы в Сигиле измеряем время по яркости неба. У нас, видишь ли, нет ни солнца, ни луны, как в большинстве миров, есть просто непрекращающийся цикл света и тьмы. То, что в большинстве мест называют полночью, мы называем антипиком. А то, что обычно называют полднем, мы называем пиком. Понимаешь, это основано на пике и антипике освещённости. Так что если ты услышишь что-нибудь типа „пять часов после пика“, ты поймёшь».~
@11166 = ~«У меня другие вопросы о Сигиле».~
@11167 = ~«У меня другие вопросы…»~
@11168 = ~«Спасибо. Прощай».~
@11169 = ~«Фьють. Дай-ка горло промочу», — он делает глоток из кружки. «Город парит над бесконечно высоким Шпилем. Он лежит на боку, как колесо опрокинутой телеги, но нет спиц, которые соединяли бы его со Шпилем. Город разделён на шесть районов, каждый из которых выполняет свою функцию. Вот сейчас мы в Улье. По-моему, назначение Улья в том, чтобы своим убожеством оттенять великолепие остального города! — он смеётся. — Фракции — это философские клубы или банды, если тебе угодно, — делят между собой управление городом».~
@11170 = ~«А ты входил в какую-нибудь фракцию?»~
@11171 = ~«Продолжай».~
@11172 = ~«У меня другие вопросы о Сигиле».~
@11173 = ~«У меня другие вопросы…»~
@11174 = ~«Спасибо. Прощай».~
@11175 = ~«Город называют перекрёстком планов, Городом Дверей, Клеткой. Говорят, здесь есть порталы в любую точку мироздания и сюда приходят бестии отовсюду: кто торговать, кто в поисках убежища, кто просто проездом. Но это сильно сокращённая версия, парень; ты должен познакомиться с городом сам».~
@11176 = ~«Что ты говорил о порталах?»~
@11177 = ~«У меня другие вопросы о Сигиле».~
@11178 = ~«У меня другие вопросы…»~
@11179 = ~«Спасибо. Прощай».~
@11180 = ~«Сигил не просто так называют Городом Дверей, парень… здесь везде порталы. Порталы — это… ну, вроде как двери, которые ведут в другие места мультивселенной, только вот выглядят не как двери. Это может быть любое ограниченное со всех сторон место… окно, дверь, рытвина, картина в раме, обруч от бочки, пространство внутри строительных лесов, платяной шкаф… все они могут быть порталами, и нужен только ключ, чтобы открыть портал и перенестись в другое место. Что касается ключей…»~
@11181 = ~«Продолжай».~
@11182 = ~«Так вот, у каждого портала есть ключ, без которого портал не открыть. И как порталами могут быть любые замкнутые пространства, так и ключи бывают самые разные. Ключом может быть всё, от коротенькой мелодии, которую надо промурлыкать перед порталом, до чего угодно: станцевать джигу, быть в определённом настроении, иметь при себе кусочек из того места, куда отправляешься… и так далее. В юности я однажды увидел, как девушка, поцеловавшая мужчину рядом с собой… открыла портал в Аркадию. И мы совершили много вылазок в Аркадию. Наверное, большую часть порталов никогда не найдут. Некоторые ты можешь найти, просто расспрашивая людей и добыв нужный ключ. Труднее всего раскрыть тайну портала. Но предупреждаю тебя, парень. Не увлекайся прыжками по порталам… и никогда не ходи по Сигилу в темноте. Лучше всего придерживаться основных дорог, в самый пик и поменьше зевать».~
@11183 = ~«У меня другие вопросы о Сигиле».~
@11184 = ~«У меня другие вопросы…»~
@11185 = ~«Спасибо. Прощай».~
@11186 = ~Эбб поднимает руку, как бы прерывая тебя, и легко смеётся: «О, да ладно, придержи лошадей, парень: я не какой-то там бывший член фракции. Говорят и правильно говорят, что если однажды вступить в Гармониум, то это уже на всю жизнь. Мы пытаемся уберечь Сигил от проблем. Чтобы Шпиль не раскачивали, чтобы народ слишком увлечённо друг дружку не лупил, чтобы поменьше шума в городе было. Мы храним мир, парень, и, как правило, это достойное занятие».~
@11187 = ~«У меня другие вопросы о Сигиле».~
@11188 = ~«У меня другие вопросы…»~
@11189 = ~«Спасибо. Прощай».~
@11190 = ~«Так ещё называют богов, парень. И их огромная прорва на всех планах, — Эбб выпускает клуб дыма. — Однако они не могут прийти в Сигил… Госпожа нашла способ не допускать их сюда, и, по слухам, он пока не подводил. Как бы то ни было, это охраняет Сигил от захвата чужаками».~
@11191 = ~«А что ты там говорил о лабиринтах?»~
@11192 = ~«У меня другие вопросы о Сигиле».~
@11193 = ~«У меня другие вопросы…»~
@11194 = ~«Спасибо. Прощай».~
@11195 = ~«Ну… — Эбб затягивается и изучает тебя. — Начнём с того, что тут, наверно, самая лучшая дыра, в которую ты мог забрести… судя по твоим татуировкам, ты любишь участвовать в разрисовке собственного тела, а тут есть салон татуировок неподалёку. Если можешь, держись подальше от аллеи Опасных Углов… Игнус не так давно поджёг это место, а на пожарище потом какие-то банды устроили логово».~
@11196 = ~«У меня другие вопросы…»~
@11197 = ~«Спасибо. Прощай, Эбб».~
@11198 = ~«Вернулся за добавкой, а? — Эбб откидывается на своём стуле. — Рад тебя снова видеть, парень».~
@11199 = ~«Здравствуй, Эбб. Я хотел спросить…»~
@11200 = ~«Прощай».~
@11201 = ~Ты видишь неповоротливое широкоплечее существо с собачьей головой и четырьмя руками. Одна пара мускулистых рук заканчивается ужасными, зазубренными клешнями, которые, судя по виду, могут и саму душу из несчастной жертвы выдрать. Говорит оно неожиданно учтивым голосом. «А, путешественник! Я вижу, твои товарищи весьма достойны и, — оно прерывается, принюхиваясь, — с *прелестных* запахом. Анна, я знал твоего отца, даже сейчас он трудится в глубинах Бездны».~
@11202 = ~«Не стоит благодарности. Прощай».~
@11203 = ~Ты видишь неповоротливое широкоплечее существо с собачьей головой и четырьмя руками. Одна пара мускулистых рук заканчивается ужасными зазубренными клешнями, которые, судя по виду, могут и саму душу из несчастной жертвы выдрать. Говорит оно неожиданно учтивым голосом. «А, путешественник! Я вижу, твои товарищи весьма достойны и, — оно прерывается, принюхиваясь, — с *прелестных* запахом. Госпожа Грейс, твоя мать, Красный Саван, наверняка будет рада услышать о твоём добром здравии».~
@11204 = ~Ты видишь неповоротливое широкоплечее существо с собачьей головой и четырьмя руками. Одна пара мускулистых рук заканчивается ужасными зазубренными клешнями, которые, судя по виду, могут и саму душу из несчастной жертвы выдрать. Говорит оно неожиданно учтивым голосом: «Расщепить имена этих абишаев на составляющие звуки было большим, большим удовольствием. Спасибо тебе за такую возможность».~
@11205 = ~Глабрезу энергично поворачивается к тебе, как к старому другу: «А, путешественник! Ты вернулся! Могу я чем-нибудь тебе помочь?» Он насмешливо, как бы между прочим, кивает головой Падшей Грейс и Анне.~
@11206 = ~«Я хотел бы задать кое-какие вопросы…»~
@11207 = ~«Не сейчас. Прощай».~
@11208 = ~«Ну конечно же! Я буду только рад помочь тому, кто может оказаться самым дорогим другом и союзником!»~
@11209 = ~«Расскажи мне о себе».~
@11210 = ~«Почему раньше у тебя был другой облик?»~
@11211 = ~«Расскажи об этом баре и его посетителях».~
@11212 = ~«Баркис просил меня разобраться с долгом Мокаи».~
@11213 = ~«Больше мне ничего не нужно. Прощай».~
@11214 = ~Глабрезу энергично поворачивается к тебе, как к старому другу: «А, путешественник! Ты вернулся! Могу я чем-нибудь тебе помочь?» Он насмешливо, как бы между прочим, кивает головой Анне.~
@11215 = ~«Я хотел бы задать кое-какие вопросы…»~
@11216 = ~«Не сейчас. Прощай».~
@11217 = ~Глабрезу энергично поворачивается к тебе, как к старому другу: «А, путешественник! Ты вернулся! Могу я чем-нибудь тебе помочь?» Он насмешливо, как бы между прочим, кивает головой Падшей Грейс.~
@11218 = ~«Я хотел бы задать кое-какие вопросы…»~
@11219 = ~«Не сейчас. Прощай».~
@11220 = ~Глабрезу энергично поворачивается к тебе, как к старому другу: «А, путешественник! Ты вернулся! Могу я чем-нибудь тебе помочь?»~
@11221 = ~«Я хотел бы задать кое-какие вопросы…»~
@11222 = ~«Не сейчас. Прощай».~
@11223 = ~«Я? Я лишь простой глабрезу, танар'ри, — невежды называют нас „демонами“ — пришёл сюда для того, чтобы побродить среди смертных и побольше узнать о них. Некоторым, кого я считаю достойными такой чести, я предлагаю больше силы за скромную плату. Я хотел бы предложить такое и тебе, но на тебе печать порядка, и твой дух тесно связан с ним. Преодолеть печать за пределами моих нынешних возможностей, но если бы ты пожелал испытать эту силу когда-нибудь позже, — он широко улыбается, показывая полный рот острых, крепких зубов. — то, быть может, мы пришли бы к соглашению».~
@11224 = ~«Может быть. Расскажи мне больше о танар'ри».~
@11225 = ~«Может быть. Расскажи мне больше о танар'ри».~
@11226 = ~«Возможно. У меня другие вопросы…»~
@11227 = ~«Возможно. Но не сейчас. Прощай».~
@11228 = ~«Я носил тот облик потому, что это позволяло мне следить за абишаями, которые теперь мертвы. И потому, что моя мощь здорово пугает малодушных. Однако сейчас пришло время принять мою настоящую форму».~
@11229 = ~«Почему сейчас?»~
@11230 = ~«Ясно. У меня другие вопросы».~
@11231 = ~«Тогда прощай».~
@11232 = ~«С исчезновением тех омерзительных баатезу это место стало ещё более приятным. Запах горелой плоти, небольшие столкновения сил и незначительные драмы создают весьма приятную атмосферу. Я бы не отказался услышать больше криков, но всё-таки здесь не Бездна. Посетители — главным образом — те, кому дано чуть-чуть мыслить и чуть-чуть мечтать. О — для меня загадка, я не могу постичь природу его силы, но постигну. Что же до остальных — они не вызывают во мне интереса. Я повидал таких за бесчисленные тысячелетия».~
@11233 = ~«Хорошо. Тогда ответь мне на другой вопрос…»~
@11234 = ~«Тогда прощай».~
@11235 = ~«Проблему можно решить совсем просто. Ты мог бы прирезать её, но это привлекло бы к тебе ненужное внимание. Лучше отрави».~
@11236 = ~«А что, если я просто выплачу её долг и помогу в беде?»~
@11237 = ~«Но у меня нет яда».~
@11238 = ~«Спасибо за совет. У меня другие вопросы…»~
@11239 = ~«Спасибо за совет. Прощай».~
@11240 = ~Илквикс кивает в сторону Грейс. «Твоя спутница может рассказать больше, — он чуть косится и продолжает. — Мы горделиво хаотичны, верим в силу отдельной личности. Разумеется, сейчас я говорю только за себя, — он снова иронически улыбается. — Некоторые называют нас злом, может быть, так и есть. Но я верю, что каждый отвечает только за себя. Слишком уж заботиться о других — признак слабости. И, наконец, запомни: каждый танар'ри — или демон, как нас иногда называют смертные — это способ мышления, конкретное воплощение ума в силу. В Бездне нас неисчислимое множество. По-настоящему мы демонстрируем свою силу в умах смертных».~
@11241 = ~«Так вы на самом деле не физической природы?»~
@11242 = ~«Ясно. У меня другие вопросы…»~
@11243 = ~«Ясно. Прощай».~
@11244 = ~«Мы горделиво хаотичны, верим в силу отдельной личности. Разумеется, сейчас я говорю только за себя, — он снова иронически улыбается. — Некоторые называют нас злом, может быть, так и есть. Но я верю, что каждый отвечает только за себя. Слишком уж заботиться о других — признак слабости. И, наконец, запомни: каждый танар'ри — или демон, как нас иногда называют смертные — это способ мышления, конкретное воплощение ума в силу. В Бездне нас неисчислимое множество. По-настоящему мы демонстрируем свою силу в умах смертных».~
@11245 = ~«Так вы на самом деле не физической природы?»~
@11246 = ~«Ясно. У меня другие вопросы…»~
@11247 = ~«Ясно. Прощай».~
@11248 = ~«Разумеется, физической — до тех пор, пока мы остаёмся здесь, на Внешних планах. Всё же здесь такое место, где все мысли обретают материальное воплощение. Но по-настоящему мы — представление. Наша сила растёт по мере роста веры в нас на Первичном материальном. Поэтому мы и вербуем смертных, которые даже не подозревают о нашем присутствии в их разуме и сердце».~
@11249 = ~«Это отвратительно. Им необходимо оставить свободную волю и право выбора».~
@11250 = ~«Если они слишком слабы, чтобы противостоять вам, или если сами вас зовут, то они всё это заслужили».~
@11251 = ~«Ясно. У меня другие вопросы…»~
@11252 = ~«Ясно. Прощай».~
@11253 = ~«У них есть свободная воля, тело-в-шрамах. Нам бы и пяди не досталось, если бы они хотя бы сопротивлялись. Их губит собственная слабость. Будь они твёрже, мы бы ничего не добились. А поскольку они не таковы, мы становимся сильнее. Это естественный отбор, — он улыбается. — И даже если бы было не так, мы бы поступали по-своему».~
@11254 = ~«У меня другие вопросы…»~
@11255 = ~«Спасибо, что просветил. Прощай».~
@11256 = ~«Поскольку сейчас время, которое я выбрал. У меня свои причины, маленький бессмертный, и не буду же я раскрывать их просто потому, что тебе любопытно? Если только, конечно, ты меня не *заставишь*…»~
@11257 = ~«Лучше я задам тебе ещё вопрос…»~
@11258 = ~«Сам напросился. Готовься к смерти».~
@11259 = ~«Если ты действительно этого хотел, то зачем спросил совета у изверга? Будет тебе. Разумеется, яд — лучшее решение этой маленькой проблемы».~
@11260 = ~«Нет, я думаю, что поступлю иначе. Ответь мне на другой вопрос…»~
@11261 = ~«Часть проблемы в том, что у меня и яда-то нет».~
@11262 = ~«Я подумаю. У меня есть другой вопрос…»~
@11263 = ~«Возможно. Прощай».~
@11264 = ~«У тебя нет яда? Ну так я тебе дам!» — он на миг сосредотачивается, и в его клешне появляется банка с жидкостью. «Ты наверняка узнаешь бальзамирующую жидкость, которой пользуются Пыльные, — мурлычет он. — Она вызывает почти безболезненную смерть, если у тебя с этим затруднения». Изверг вкладывает яд в твою руку.~
@11265 = ~«Спасибо. У меня есть другой вопрос…»~
@11266 = ~«Благодарю тебя. Прощай».~
@11267 = ~Анна сердито возражает: «Ага, и Бездна — лучшее для него место, ведь он вкалывает добровольно. Он сделал выбор, демонёнок, вот и всё, что я могу сказать порождению духа типа тебя!»~
@11268 = ~Он тихо смеётся и вращает глазами с видом «ты не поверишь, что случилось со мной». Это зрелище кажется тебе странно знакомым. «Вовремя, друг! Я уж думал, весь день тебя здесь прожду».~
@11269 = ~«Ну конечно», — он смотрит на тебя с сомнением. «По крайней мере, я так думаю. Я… э-э… ну… не могу вспомнить о тебе всё, но…» — он задумчиво морщит лоб, потом пожимает плечами. «…в любом случае рад тебя видеть. Я Адан. Я так понимаю, мы друзья. Замечательно! Я бы хотел иметь больше таких друзей, наверно… — он смущённо оглядывается по сторонам, — …так как я, похоже, никого здесь больше не знаю. И не знаю, как вообще сюда попал».~
@11270 = ~Её лицо каменеет, и она взрывается: «Ты правда хочешь сказать, что позволишь этому… этому дьявольскому отродью учить тебя жить? Ага, ну так я тут сама по себе, и я посмотрю, как оно сожрёт твою душу, тупой пень!»~
@11271 = ~«Тогда продолжим. Илквикс, у меня другие вопросы…»~
@11272 = ~«Тогда продолжим. Илквикс, у меня другие вопросы…»~
@11273 = ~Падшая Грейс невозмутимо отвечает: «Согласна, Илквикс, моя мать будет рада услышать, что я и поныне пребываю в добром здравии, что по-прежнему придерживаюсь своего выбора и путешествую в компании тех, кого сама себе выбрала в спутники. Не будешь ли ты так любезен передать ей это моё послание, когда вернёшься в Бездну? Она, без сомнения, вознаградит того, кто принесёт ей отличные новости обо мне». Она вежливо улыбается.~
@11274 = ~«Это всё просто распрекрасно, но у меня кое-какие вопросы…»~
@11275 = ~«Достаточно. Прощай, Илквикс».~
@11276 = ~Мужчина фыркает, харкая мокротой. «Имена, имена… кто ты, кто ты… — при каждом повторении голова его слегка подёргивается. — Имена… опасно, опасно». Он переводит взгляд вниз и растирает ногой грязь.~
@11277 = ~«Знать имя или своё выбалтывать, в обоих случаях куча неприятностей, — он снова смотрит на тебя. — Моё имя — это прозвище, не то, которое спрашивают. Вонючка». Тебя снова сшибают с ног его зловонное дыхание и набор исходящих от него ароматов мочи и испражнений. «Прозвище, прозвище».~
@11278 = ~«Не настоящее моё имя, не настоящее имя, — бормочет Вонючка, голова его подёргивается на каждом слове *имя*. — Настоящее имя — опасная вещь, даёт другим силу». Он пристально на тебя смотрит своими огромными глазами и грозит пальцем: «Храни своё имя в тайне, храни его надёжно, никому не говори».~
@11279 = ~«Имена как запахи… по ним можно выслеживать», — Вонючка кашляет, при этом его глаза почти выскакивают из орбит. Кашель что-то ослабляет в его кишечнике, и он громко пукает, как бы подчёркивая сказанное. «Если кто-то знает твоё настоящее имя, это даёт ему силу, — он облизывает губы. — Силу *вредить*».~
@11280 = ~Глаза Вонючки расширяются; зрелище выпучивающихся ещё больше глазных яблок тебя несколько беспокоит. «Тогда ты благословен, благословен. Оставайся без имени, и ты будешь как дух на планах, неуловимый, невидимый, неощутимый, — он сплёвывает мокротой. — Имя выбранное, имя данное… по нему другие могут найти тебя и навредить».~
@11281 = ~Вонючка отвешивает дёргающийся кивок, затем чешется. «Дал моему имени однажды ускользнуть, только однажды, только однажды», — его глаза подёргиваются дымкой, как если бы воспоминание причиняло боль, затем смущённо на тебя смотрят. «Расскажу тебе историю, расскажу, но должен увидеть три медяка», — его лицо при слове *медяка* расплывается в улыбке, а вонь изо рта бьёт тебя по голове, как молотом.~
@11282 = ~Вонючка встаёт в позу, смотрит налево, потом направо, потом на тебя. Его лицо напрягается, и затем он опять громко пукает. Амбре чуть не сбивает тебя с ног, но он ничего не замечает. «Проклят, проклят! Гулял по районам в блеске…» — он чопорно выпрямляется и задирает нос вверх. Прохаживается взад и вперёд, раскланиваясь с невидимыми прохожими.~
@11283 = ~Вонючка замирает, подбоченившись. «Скрестились пути с перекрещенным. Проклятье! Выглядел как тыква, оранжевая!» — Вонючка выпячивает пузо так, что кажется толстым, откидывает волосы назад, приглаживает их ладонью и сцепляет пальцы на своём «жирном» пузе. Затем вновь прохаживается, изображая своего героя, «важную персону». «Всё пошло вкривь с проклятием, вот так», — с презрительной усмешкой и бесшабашным жестом «толстый» насылает невидимое проклятие на «важную персону».~
@11284 = ~«Узнал моё имя, дал ему утечь я, всё получил, получил всё!» — он выпрямляется, глубоко вздыхает и вновь изображает свою «важную персону». Персона рушится, а Вонючка делает мощный пук, затем набирает воздух в свои прогнившие, зловонные лёгкие: «Проклят зловонием, запахом, экскрементами! Пришёл сюда рассказывать истории, всё хорошо, всё пока хорошо. Теперь зовут Вонючка — новое имя, новое…»~
@11285 = ~При звуке этого имени Вонючка надувает щёки, выпучивает глаза и вдруг начинает блевать себе под ноги. Всё его тело сотрясается, заходится в кашле и рвотных позывах… через несколько долгих минут он слабо кивает и описывает полукруг над сердцем.~
@11286 = ~Вонючка на какой-то миг выглядит обнадёженным, затем жалко сникает. «Обещания, обещания… — он издаёт тяжкий вздох, прерываемый вонючей икотой. — Попытайся, если хочешь, если хочешь…»~
@11287 = ~Он издаёт тяжкий вздох, прерываемый вонючей икотой. «Тогда неважно, неважно…»~
@11288 = ~При твоём появлении Вонючка поднимает взгляд, с нетерпением трясёт головой и таращится на тебя своими выпученными глазами. Когда ты подходишь ещё ближе, тебя снова обдаёт ароматами мочи и испражнений.~
@11289 = ~«Вопросы, вопросы… — Вонючка склоняется, осторожно поглядывая на тебя своими огромными глазами. — Ответы, ответы?..»~
@11290 = ~«Расскажу тебе историю, расскажу, но должен увидеть три медяка», — его лицо при слове *медяка* расплывается в улыбке, а вонь изо рта бьёт тебя по голове, как молотом.~
@11291 = ~Он берёт монетку, пробует на зуб, а затем, к твоему изумлению, проглатывает. «Лучший кошелёк, лучший кошелёк — в брюхе, в брюхе», — Вонючка обдаёт тебя смрадом изо рта. «История, история…» — он чмокает губами, потом вытирает их грязной полой одежды.~
@11292 = ~«Улей, Улей… историю могу рассказать, историю могу рассказать, расскажу, но сначала должен увидеть три медяка», — он сжимает зубы и хрюкает, как поросёнок.~
@11293 = ~«К шпилю отсюда, к шпилю… — Вонючка указывает налево от себя, на обугленную улицу вдали, — аллея *Опасных Углов*». Он сгибает руки в какой-то искажённой пародии на остов здания. «Не всегда были углы, не всегда сгоревшая и обугленная, когда-то живая, теперь нет».~
@11294 = ~«Огонь, пламя! — он вскидывает руки вверх, затем размахивает ими, изображая огонь. — Аллея горела, много дыму, пепел везде… а в конце остались только *скелеты* зданий, кости мёртвых домов, кости мёртвых домов. Углы… везде углы».~
@11295 = ~Он наклоняется вперёд, понизив голос до шёпота. Вновь тебя окатывает неповторимым букетом его запахов. «Опасно теперь, плохие люди устроили там логово, там логово, — он кивает, затем снова струёй пускает газы, как в рог трубит. — Эта история о том, как улица стала аллеей Опасных Углов».~
@11296 = ~Он описывает полукруг над сердцем. «Человек это сделал. Зверь это сделал. Человек, которым даже *изверги* восхищаются».~
@11297 = ~«Историю о колдуне, наполненную безумием, печалью, горением, желанием… историю могу рассказать, историю могу рассказать, расскажу, но сначала должен увидеть три медяка, — он шипит, затем клокочет, изображая звук пожара. — Страшную историю, страшную историю».~
@11298 = ~«Жил-был колдун, да не простой колдун, а маг *силы*, — Вонючка почтительно складывает руки, затем зло улыбается. — Он горел Искусством, а Искусство жгло его».~
@11299 = ~«Его имя было Игнус, сначала его уважали, потом его боялись, потом ненавидели, потом наказали», — Вонючка громко хрипит, затем хватает воздух и шипит, словно имитируя «Игнус».~
@11300 = ~«Учился Игнус у одного из последних великих магов и, будучи его подмастерьем, узнал много, много… и в то же время ничего», — Вонючка горько качает головой. «В его сердце, чёрном как уголь, бушевал огонь. Оно горело, оно горело, и оно было *голодным*, — Вонючка хватается за грудь, как от боли. — А раз оно было голодным, и Игнус был голодным. Хотел видеть, как планы *горят*».~
@11301 = ~«И ночью… — Вонючка горбится и начинает медленно двигаться в сторону аллеи, с безумной улыбкой на лице, — Игнус пришёл на эту улицу, которой суждено было стать аллеей Опасных Углов, и огонь в его глазах, огонь в его сердце вышли наружу». Вонючка указывает на аллею Опасных Углов, затем вскидывает руки в воздух, беззвучно крича и хохоча одновременно.~
@11302 = ~«Плоть плавилась, как воск, люди горели, как свечки, а Игнус смеялся, смеялся… — Вонючка плюхается на землю, его тело корчится от воображаемой боли. — Злодейство, злодейство свершилось и не забыто, не забыто». Он встаёт, затем сгибается, смотрит налево, направо, затем бормочет, словно тихо ведёт сам с собой беседу: «Что-то должно быть сделано, должно быть сделано…»~
@11303 = ~Он выпрямляется с сухим, решительным лицом. «Вынесли ему наказание, все окрестные колдуны, знахарки, предсказатели, второсортные ведьмы, маги всех видов… они собрались, все, даже у кого силы было совсем немного, собрались наказать Игнуса. Порознь они были мухами… — он пытается изобразить жужжание сгнившими дёснами. — Вместе — опасны, опасны».~
@11304 = ~Он гудит, затем воздевает руки… «Поймали Игнуса, исполнили его желание… — Вонючка крутит руками, как бы произнося заклинание. — Он хотел гореть, они так и сделали, использовали его собственную страсть как топливо для заклинания. Сделали из его тела дверь на план Огня — они думали убить его, убить его…»~
@11305 = ~«Не получилось, не получилось… — Вонючка снова пускает ветры, словно подчёркивая неудачу волшебников. — Игнус живой, Игнус живой, только заснул, объятый пламенем, пламенем, заснул, как только загорелся, никогда не был счастливее, никогда не был счастливее…» Он закрывает глаза, описывает руками широкий круг и медленно поворачивается. «Горит… вечно горит… — его глаза внезапно распахиваются. — Когда-нибудь он проснётся, и тогда, тогда планы будут *в огне!*»~
@11306 = ~Вонючка громко пукает, затем почёсывает свои руки. На миг он задумывается, затем качает головой: «Никакого дневника, никакого дневника не видел».~
@11307 = ~Вонючка вдруг горбится и хитро на тебя смотрит. Некоторое время он ходит вокруг тебя, подволакивая ногу, словно хромает. «Король! Благородная история, благородная история! Историю могу рассказать, расскажу, но сначала должен увидеть три медяка…»~
@11308 = ~Вонючка по-прежнему горбится и глядит на тебя исподлобья. «Когда-то был уважаемым человеком Фарод, человеком, человеком цели и *положения*. Всё пошло прахом, всё, превратилось в дым, — Вонючка щурится, затем громко пукает, наполняя воздух благоуханием больных кишок. — Обратилось в дым… и вонь».~
@11309 = ~«Лжец, мошенник был Фарод, всегда закон обходил», — он склоняется, как бы записывая что-то на столе. Так он «пишет» какое-то время, затем внезапно останавливается в страхе: «И вот однажды он узнал, что обошёл себя самого!»~
@11310 = ~«Он стал таким лжецом, что попал бы в ужасное место после смерти… — Вонючка печально качает головой, затем снова горбится и безумно оглядывается во все стороны. — Фарод с этим не смирится, нет, нет! Он обманывал остальных, он обманет и судьбу!»~
@11311 = ~«Он читал, закопался в книги, советовался с провидцами… — Вонючка вышагивает взад-вперёд, приставив ладонь козырьком, как бы пытаясь что-то рассмотреть вдали, — …и они сказали ему, что только в отбросах он может обмануть судьбу». Вонючка снова пускает газы, затем кашляет, обдавая тебя вонью ещё и с этой стороны. «Может, они и врали…»~
@11312 = ~Вонючка неуклюже выпрямляется, затем начинает снимать с себя воображаемую одежду. С каждой снятой «вещью» он всё больше и больше горбится. «Фарод отбросил своё положение, свои титулы и принял новый титул…» — Вонючка останавливается и искоса смотрит на тебя. Он потрясает своими тряпками. «И стал Королём Оборванцев! Он правит свалкой, заставляет подчинённых обыскивать её в поисках того, что ему поможет, — он качает головой. — Он ищет даже сейчас, даже сейчас…»~
@11313 = ~Вонючка качает головой: «Он живёт среди мусора и тряпья. Там ты и найдёшь его, найдёшь его…»~
@11314 = ~Вонючка прекращает дёргаться и чесаться на минуту и пристально на тебя смотрит. «Эта история… эта история бесплатно, потому что она ничего не стоит, и не стоит она ничего, чтобы стать действительно печальной историей».~
@11315 = ~«Так где же начинается эта история?..» — бормочет Вонючка, затем делает такой вонючий выдох, что у тебя глаза вылезают на лоб. Он задумывается.~
@11316 = ~Вонючка кивает, затем изучает тебя и начинает яростно скрестись, будто хочет наскрести себе шрамов. «Мёртвый, но не мёртвый… нет памяти, нет памяти, нет имени…»~
@11317 = ~Вонючка выглядит загипнотизированным твоими словами. «Да, да, имя очень опасно… может быть… — он прерывается. — Может быть, тот человек, с которым заговаривает безымянный, предупреждает об опасности имён». Он задумывается. «Может, тому, кто забыл своё имя, лучше всего?..»~
@11318 = ~Вонючка кашляет, затем сплёвывает зелёной мокротой и опять поворачивается к тебе. «Это твой вопрос, твоя история… — говорит он медленно. — И *ты* должен ответить».~
@11319 = ~Вонючка качает головой. «Мой ответ, мой ответ…» — он снова кашляет, изрыгая очередную волну смрада. Затем чмокает губами, словно пытаясь проветрить рот от гадкого запаха. «Вот мой ответ: оба дураки, но только один из них знает, что он дурак».~
@11320 = ~Вонючка обдумывает сказанное, облизывая губы. Он начинает медленно кивать, затем что-то бормочет под нос, как бы беседуя сам с собой. Наконец он снова поворачивается к тебе. «Это история, у истории есть мораль, и это мораль рассказчика… — он кашляет и выплёвывает на мостовую ещё один сгусток мокроты. — История, которая получит ответ, в своё время, в своё время?..»~
@11321 = ~Вонючка чешется, кивает, затем лезет за пазуху и даёт тебе монетку. «За такую историю — медяк ломаный, — он мерзко хихикает. — Больше не дам, история не закончена».~
@11322 = ~Ты видишь Вонючку… его глаза вернулись к нормальному размеру, и его более не мучают приступы трясучки, которые ты замечал раньше. Он улыбается и выглядит, словно его помыли.~
@11323 = ~Он изумлённо смотрит на тебя: «Оно… остановилось. Всё остановилось, вот так запросто». Он щёлкает пальцами, затем осматривает себя. «Великие силы, я… — он радостно смеётся. — Я снова чувствую себя *чистым*».~
@11324 = ~«Спасибо тебе, уважаемый. Мне… — он выглядит смущённым. — Мне нечем отблагодарить тебя, но я навсегда у тебя в долгу…» Он пожимает плечами: «Если это имеет значение». Он задумывается, насупившись, затем выпрямляется: «Я расскажу историю о твоей доброте всем, кто захочет услышать».~
@11325 = ~«Конечно, конечно! — Вонючка оглядывается вокруг… — Но хватит мне уже рассказывать истории… у тебя ничего не найдётся, чтобы записать их?»~
@11326 = ~Вонючка берёт дневник: «Ага…» Некоторое время он быстро пишет, затем отдаёт дневник тебе: «Вот».~
@11327 = ~«Э-э… если ты никогда больше не будешь пользоваться этим именем, я… и другие тоже, будем благодарны».~
@11328 = ~«Моё имя… — он вдруг останавливает себя и улыбается. — Нет, пусть оно на этот раз останется со мной». Он с уважением тебе кивает: «Ещё раз спасибо, добрый сэр».~
@11329 = ~Оставить оборванца в покое.~
@11330 = ~«Не сегодня. Прощай».~
@11331 = ~«Опасно?»~
@11332 = ~«Неважно. Прощай».~
@11333 = ~«Хм… подходящее имя».~
@11334 = ~«Хе. Это имя тебе хорошо подходит».~
@11335 = ~«Это же не настоящее имя?»~
@11336 = ~«Ясно. Прощай».~
@11337 = ~«Что ты имеешь в виду?»~
@11338 = ~«Ясно. Прощай».~
@11339 = ~«Я не знаю своего настоящего имени».~
@11340 = ~«Ясно. Прощай».~
@11341 = ~«Тебе навредили?»~
@11342 = ~«Ясно. Прощай».~
@11343 = ~«Хорошо. Вот три медяка».~
@11344 = ~Ложь: «У меня столько нет. Но есть кое-какие вопросы…»~
@11345 = ~Правда: «У меня столько нет. Но есть кое-какие вопросы…»~
@11346 = ~«Не сегодня. Прощай».~
@11347 = ~Слушать.~
@11348 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11349 = ~«Пожалуй, я услышал достаточно. Прощай».~
@11350 = ~Ты видишь низенького толстенького человечка с растерянным выражением лица. По морщинам на коже понятно, что для него это выражение не в новинку. Он держит бутыль с пивом, и она стремительно пустеет. Между глотками он говорит вежливым голосом, так тихо, что ты с трудом разбираешь слова: «Здравствуй, путешественник. Моё имя Илквикс. Могу ли я чем-нибудь тебе помочь?»~
@11351 = ~«Здравствуй. Я хотел бы задать кое-какие вопросы».~
@11352 = ~«Нет. Прощай».~
@11353 = ~Пухлый человечек поворачивается к тебе и улыбается: «Снова здравствуй, путешественник. Чем Илквикс может помочь тебе сегодня?»~
@11354 = ~«Здравствуй, Илквикс. Я хотел спросить тебя».~
@11355 = ~«Ничем. Прощай».~
@11356 = ~«Что ты хочешь знать, друг мой?»~
@11357 = ~«Кто ты такой на самом деле?»~
@11358 = ~«Кто ты такой на самом деле?»~
@11359 = ~«Что ты можешь рассказать об этом месте?»~
@11360 = ~«Что ты можешь рассказать о посетителях этого места?»~
@11361 = ~«Кто вон тот горящий человек?»~
@11362 = ~«Я ищу способ заставить Мокаи заплатить за выпивку. Ничего не посоветуешь?»~
@11363 = ~«Ничего. Прощай».~
@11364 = ~Слушать.~
@11365 = ~«Я? Я всего лишь скромная персона с тонкими, поэтическими наклонностями и тягой к сверхъестественному. К сожалению, я не обладаю тут никакими ресурсами, иначе я бы очень, ОЧЕНЬ жаждал научить тебя путям силы, — он прерывается и восхищённо смотрит на Грейс. — Могу ли я воздать тебе хвалу, уважаемый, за твой выбор товарищей? Ты со всей очевидностью понимаешь, что тебе нужно; очевидно и то, что ты человек напористый. Всех энергичных людей следует ценить».~
@11366 = ~«Подожди секунду… я *нашёл* человека, который тебя проклял. Его имя Убийца Чувств, так?»~
@11367 = ~«Я? Я всего лишь скромная персона с тонкими, поэтическими наклонностями и тягой к сверхъестественному. К сожалению, я не обладаю тут никакими ресурсами, иначе я бы очень, ОЧЕНЬ жаждал научить тебя путям силы. Может, в другой раз?»~
@11368 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11369 = ~«Да, я бы не отказался. Но сейчас я хотел спросить о другом…»~
@11370 = ~«Я услышал достаточно. Прощай».~
@11371 = ~«Возможно. Прощай».~
@11372 = ~«Ясно. У меня ещё вопросы…»~
@11373 = ~«Это место? Бар „Горящий труп“? Чудное заведение и замечательный хозяин: Баркис — настоящий джентльмен и достаточно честолюбив, чтобы поставить своё заведение на ноги. По-моему, наиболее похвальные качества, какими кто-либо может обладать».~
@11374 = ~«Они привлекают людей. Я хотел бы задать ещё вопрос…»~
@11375 = ~«Подожди секунду… я *нашёл* человека, который тебя проклял. Его имя Убийца Чувств, так?»~
@11376 = ~«Многие с тобой согласятся. Прощай».~
@11377 = ~«Посетителей в таверне много, и все разные. С большинством из них я общался и нашёл их очаровательными — за исключением тех существ закона, — он указывает на пару абишаев в углу. — Они портят воздух самим своим присутствием, придавая нездоровое зловоние приятной в остальных отношениях окружающей обстановке. Советую поговорить с Баркисом — как понимаю, он нуждается в некой помощи с пустячным делом. Потом есть ещё О. Я всё пытаюсь постичь его. Он *та ещё* штучка, между нами говоря. Это что касается интересных личностей. Остальные… ну, может, я чересчур придирчив».~
@11378 = ~«Я услышал достаточно. Прощай».~
@11379 = ~«Почему ты так презираешь законопослушных созданий?»~
@11380 = ~«Что случилось после того, как ты встретил… его?»~
@11381 = ~«Возможно. У меня есть другой вопрос».~
@11382 = ~«Неприятная история. У меня к тебе ещё кое-какие вопросы…»~
@11383 = ~«Спасибо, что уделил мне время. Прощай».~
@11384 = ~«Он мёртв, знаешь ли».~
@11385 = ~«Тот? Ха. Последний неудачник, который не соразмерил свои желания с силой, необходимой для преодоления последствий их исполнения. Его имя Игнус, и он… был… пироманом. Он поджигал и поджигал, но не тех, кого стоило, вызывал такую силу, которую сам не мог контролировать. А теперь ты видишь, что с ним сталось. Если хочешь узнать о нём побольше, возможно, тебе расскажет то несчастное создание, Друзилла».~
@11386 = ~«Знаешь, я, наверно, мог бы заставить его снять проклятие».~
@11387 = ~«Ясно. У меня другие вопросы…»~
@11388 = ~«Ясно. Прощай».~
@11389 = ~«Прощай».~
@11390 = ~Он смеётся, его челюсти сотрясаются так, будто вот-вот выпадут изо рта. «Ты всегда можешь отравить её, друг! Доза яда весьма эффективно разрешает почти *любой* конфликт! — он снова хохочет. — Конечно, я шучу». Он подмигивает.~
@11391 = ~«Что случилось после того, как ты встретил… его?»~
@11392 = ~«Конечно. У меня есть другой вопрос…»~
@11393 = ~«Конечно. Прощай».~
@11394 = ~«А, чудный вопрос, друг мой! Я вырос на хаотической стороне Великого Кольца — можешь поговорить о планах с Кандрианом Болезненным (не суди о нём по имени). Он величает себя великим планарным путешественником. Возвращаясь к теме, я жил с Хаосом долгие годы и прекрасно с ним ужился. Для меня цепи закона, как у этих существ, кажутся оскорбительными и тираническими. Если мне суждено кому-то подчиняться, то лучше уж личности, чем машине, не знающей чувств».~
@11395 = ~Правда: «Я всецело согласен».~
@11396 = ~Ложь: «Я всецело согласен».~
@11397 = ~Правда: «Я не согласен».~
@11398 = ~Ложь: «Я не согласен».~
@11399 = ~«Многие с тобой согласятся. Я хотел спросить о другом…»~
@11400 = ~«Многие с тобой согласятся. Прощай».~
@11401 = ~Илквикс демонстрирует зубастую улыбку, причём его жирные щёки почти не двигаются. «Каждому своё, скажу я тебе. У тебя есть ещё вопросы?»~
@11402 = ~«Да».~
@11403 = ~«Нет. Прощай».~
@11404 = ~Грейс отвечает небольшим реверансом: «Уверена, твои учтивые слова растопят любое сердце, Илквикс. Но всегда следует помнить, сколь многие являются чем-то большим или меньшим, чем выглядят. Разумеется, если бы всех разоблачали слишком быстро, было бы досадно, даже разочаровывающе».~
@11405 = ~«Ты это к чему, Грейс?»~
@11406 = ~«Хватит. Мне нужны ответы на кое-какие вопросы, Илквикс».~
@11407 = ~«Я это к тому, что о сказанном в запале часто приходится горько жалеть — и что у многих есть качества и даже силы, о которых мало кто подозревает. Слишком многие полагаются на умозаключения и не осознают, когда те рушатся. Потому следует тщательно подбирать слова, чтобы они не открыли о нас больше, чем мы хотим».~
@11408 = ~«Ясно. Илквикс, я хотел бы задать ещё вопрос…»~
@11409 = ~«Хорошо сказано, Грейс. Прощай, Илквикс».~
@11410 = ~«Разговор окончен. Прощай, Илквикс».~
@11411 = ~«У меня к тебе другие вопросы…»~
@11412 = ~«Поговорю с ним прямо сейчас. Прощай».~
@11413 = ~«У меня к тебе другие вопросы…»~
@11414 = ~«Прощай».~
@11415 = ~«Здравствуй, Вонючка. У меня к тебе кое-какие вопросы…»~
@11416 = ~Оставить Вонючку в покое.~
@11417 = ~«Так кто ты?»~
@11418 = ~«Что с тобой случилось?»~
@11419 = ~«Я хотел бы послушать рассказ».~
@11420 = ~«Можешь рассказать мне об этом месте?»~
@11421 = ~«Не расскажешь мне, где можно найти кое-кого по имени Фарод?»~
@11422 = ~«Не расскажешь мне о Фароде снова?»~
@11423 = ~«Я потерял дневник. Ты ничего такого не видел?»~
@11424 = ~«Я нашёл того, кто проклял тебя, в Фестхолле. Его зовут Убийца Чувств».~
@11425 = ~«Прощай».~
@11426 = ~«Хорошо. Вот три медяка».~
@11427 = ~Ложь: «У меня столько нет. Но есть кое-какие вопросы…»~
@11428 = ~Правда: «У меня столько нет. Но есть кое-какие вопросы…»~
@11429 = ~«Не сегодня. Прощай».~
@11430 = ~Ждать, пока он выберет рассказ.~
@11431 = ~Ждать, пока он выберет рассказ.~
@11432 = ~Ждать, пока он выберет рассказ.~
@11433 = ~«Я хотел бы услышать историю о том, как тебя прокляли».~
@11434 = ~«Я хотел бы услышать историю о том, что случилось с аллеей Опасных Углов».~
@11435 = ~«Расслабься. Я просто хотел задать пару вопросов».~
@11436 = ~«От тебя? Ничего».~
@11437 = ~«Оно и видно по твоему отношению, что больше ничего тебе не надо. Ты меня очень порадуешь, если не будешь больше беспокоить своим присутствием. Всего хорошего», — он чопорно отворачивается.~
@11438 = ~«Слушай, я прошу прощения за свои слова. Я просто хотел задать кое-какие вопросы».~
@11439 = ~«Ну и ладно».~
@11440 = ~«Сказанного не воротишь, и я принял твои слова близко к сердцу. Но нельзя сказать, что я такой уж твердолобый. Что ты хотел спросить?»~
@11441 = ~«Так кто ты?»~
@11442 = ~«Кто бывает в этом кабаке?»~
@11443 = ~«Что ты можешь рассказать об этом месте?»~
@11444 = ~«Я ищу дневник. Ты ничего подобного в последнее время не видел?»~
@11445 = ~«Не слышал о Сборщике по имени Фарод?»~
@11446 = ~«Я хотел бы принести тебе свои извинения».~
@11447 = ~«Я хотел бы принести тебе свои извинения».~
@11448 = ~«Ничего. Забудь».~
@11449 = ~В его глазах таится огонь: «Ты достаточно оскорбил меня, „друг“. Больше я не хочу иметь с тобой дела». Он совсем отворачивается с видом уязвлённой гордости, и явно никакие уговоры не заставят его повернуться обратно.~
@11450 = ~Напасть на него.~
@11451 = ~Оставить его в покое.~
@11452 = ~«Единственный, кого я знаю, — это Эбб. Он вон там. Я в этом месте новичок и не считаю своей обязанностью вмешиваться в дела других. У тебя есть ещё вопросы, или мне можно продолжить наслаждаться одиночеством?»~
@11453 = ~«Я хотел бы услышать историю Игнуса».~
@11454 = ~«Ну, на самом деле я сперва хотел задать тебе ещё пару вопросов».~
@11455 = ~«Можешь вернуться к своим делам, что бы ты там ни делал».~
@11456 = ~Он тяжело вздыхает и смотрит на тебя с презрением: «Ну так выкладывай, человек со шрамами, спрашивай и уходи».~
@11457 = ~«Я хочу услышать историю о человеке, который пришёл в этот город без имени и без памяти и разговорился с проклятым сказителем, предупредившем его об опасности имён».~
@11458 = ~«Так кто ты?»~
@11459 = ~«Я хочу услышать историю о человеке, который пришёл в этот город без имени и без памяти и разговорился с проклятым сказителем, предупредившем его об опасности имён».~
@11460 = ~«Кто бывает в этом кабаке?»~
@11461 = ~«Что ты можешь рассказать об этом месте?»~
@11462 = ~«Я ищу дневник. Ты ничего подобного в последнее время не видел?»~
@11463 = ~«Не сегодня. Прощай».~
@11464 = ~«Не слышал о Сборщике по имени Фарод?»~
@11465 = ~«Я хотел бы принести тебе свои извинения».~
@11466 = ~«Я хотел бы принести тебе свои извинения».~
@11467 = ~«Неважно. Забудь».~
@11468 = ~«Хорошо. Вот три медяка».~
@11469 = ~«Это таверна, одна из самых привычных картин моего дома. По крайней мере, была бы, если бы не вон те изверги в углу и не бесконечные странности, происходящие у меня на глазах. Тем не менее, я нахожу в этом месте некую человечность, за что его и люблю».~
@11470 = ~«О, всё верно. Ты бестолочь, не так ли?»~
@11471 = ~«Ты первичник, ведь так?»~
@11472 = ~«Так и думал. Ещё вопрос, если ты не против».~
@11473 = ~«Так и думал. Прощай».~
@11474 = ~«Дневник? И где бы я мог его увидеть? Я новичок в этом месте, а ты меня спрашиваешь, не помню ли я ДНЕВНИК? Да ты не только грубиян и невежа, ты ещё и глуп к тому же».~
@11475 = ~«Давай-ка закончим с оскорблениями на сегодня, а?»~
@11476 = ~«Ты меня провоцируешь?»~
@11477 = ~«Это бессмысленно. Прощай».~
@11478 = ~Напасть на него.~
@11479 = ~Ложь: «У меня столько нет. Но есть кое-какие вопросы…»~
@11480 = ~Правда: «У меня столько нет. Но есть кое-какие вопросы…»~
@11481 = ~«Не сегодня. Прощай».~
@11482 = ~Слушать.~
@11483 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11484 = ~«Я услышал достаточно. Прощай».~
@11485 = ~Слушать.~
@11486 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11487 = ~«Я услышал достаточно. Прощай».~
@11488 = ~«Как начался пожар?»~
@11489 = ~«У меня другие вопросы…»~
@11490 = ~«Ясно. Прощай».~
@11491 = ~«Кто?»~
@11492 = ~«У меня другие вопросы…»~
@11493 = ~«Это всё, что я хотел узнать. Прощай».~
@11494 = ~«Хорошо. Вот три медяка».~
@11495 = ~Ложь: «У меня столько нет. Но есть кое-какие вопросы…»~
@11496 = ~Правда: «У меня столько нет. Но есть кое-какие вопросы…»~
@11497 = ~«Не сегодня. Прощай».~
@11498 = ~Слушать.~
@11499 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11500 = ~«Я услышал достаточно. Прощай».~
@11501 = ~Слушать.~
@11502 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11503 = ~«Я услышал достаточно. Прощай».~
@11504 = ~Слушать.~
@11505 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11506 = ~«Я услышал достаточно. Прощай».~
@11507 = ~Слушать.~
@11508 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11509 = ~«Я услышал достаточно. Прощай».~
@11510 = ~Слушать.~
@11511 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11512 = ~«Я услышал достаточно. Прощай».~
@11513 = ~Слушать.~
@11514 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11515 = ~«Я услышал достаточно. Прощай».~
@11516 = ~Слушать.~
@11517 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11518 = ~«Я услышал достаточно. Прощай».~
@11519 = ~«Неприятная история. У меня к тебе ещё кое-какие вопросы…»~
@11520 = ~«Я услышал достаточно. Прощай».~
@11521 = ~«У меня к тебе другие вопросы…»~
@11522 = ~«Ладно, тогда прощай».~
@11523 = ~«Хорошо. Вот три медяка».~
@11524 = ~«Я уже сказал тебе, что здесь совсем недавно, но ты, видимо, издеваешься. Безусловно, я ничего не знаю об этих „Сборщиках“. Теперь ты оставишь меня в покое?»~
@11525 = ~«Ещё нет. У меня другие вопросы».~
@11526 = ~«Я хотел бы принести тебе свои извинения».~
@11527 = ~«Я бы хотел как-то загладить вину».~
@11528 = ~«Конечно. Всего доброго».~
@11529 = ~Он выглядит вконец огорошенным, как будто сама идея извинений ему чужда. «Ты хочешь… принести извинения?»~
@11530 = ~«Именно».~
@11531 = ~«Нет, не хочу. Я передумал. Прощай».~
@11532 = ~«Тогда… тогда… тогда, пожалуй, для меня дело чести их принять. Хорошо. В свою очередь, я приношу тебе свои извинения. Забудем этот прискорбный случай и не будем больше упоминать».~
@11533 = ~«Отлично. Тогда не ответишь ещё на пару вопросов?»~
@11534 = ~«Хорошо. Прощай».~
@11535 = ~«Может, я и дурак, но не настолько, чтобы радостно сносить от тебя оскорбления и так легко прощать. Можешь хоть заколоться, уважаемый, мне-то что за дело. Я лишь надеюсь, что ты заработаешь новые шрамы, а может, и новую славу. Всего хорошего, уважаемый», — он чопорно отворачивается и больше не обращает на тебя никакого внимания.~
@11536 = ~Напасть на него.~
@11537 = ~Уйти.~
@11538 = ~«Ты дважды оскорбил меня, любезный, и больше я такого слышать не хочу. Защищайся!»~
@11539 = ~«Переживём как-нибудь…»~
@11540 = ~«Если ты имеешь в виду, что я из настоящего мира, то да, я первичник. Я немного известен там как воин. И ещё, хоть я пока и не знаю все закоулки в этой новой стране, всё равно не считаю себя „бестолочью“, и не позволю местным негодяям себя так называть».~
@11541 = ~«Ладно. Давай просто закончим с оскорблениями, а?»~
@11542 = ~«Правда? А я буду».~
@11543 = ~«Хорошо. Прощай».~
@11544 = ~Ложь: «У меня столько нет. Но есть кое-какие вопросы…»~
@11545 = ~«Закончим? Не раньше, чем ты извинишься, негодяй, — он выглядит, словно так и рвётся в драку. — Или тебя ещё подразнить?»~
@11546 = ~«Тогда ладно. Я приношу свои извинения».~
@11547 = ~«Извиняться? Перед тобой? Никогда».~
@11548 = ~Правда: «У меня столько нет. Но есть кое-какие вопросы…»~
@11549 = ~«Ты низкий подлец, слабак без чести, кусок мяса без подлинной души, дряхлый, покрытый шрамами, без надежды на лучшую участь, обречённый всю жизнь скитаться и не обрести даже капли того, что делает мужчину мужчиной. Я сказал всё, и могу только пожалеть тебя. Всего хорошего, уважаемый», — он поворачивается спиной.~
@11550 = ~Напасть на него.~
@11551 = ~Уйти.~
@11552 = ~«Не сегодня. Прощай».~
@11553 = ~«Что ты хочешь узнать?»~
@11554 = ~Слушать.~
@11555 = ~«Кто ты?»~
@11556 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11557 = ~«Кто бывает в этом кабаке?»~
@11558 = ~«Я услышал достаточно. Прощай».~
@11559 = ~«Кто бывает в этом кабаке?»~
@11560 = ~Слушать.~
@11561 = ~«Что ты можешь рассказать мне об этом месте?»~
@11562 = ~«Я ищу дневник. Ты ничего подобного в последнее время не видел?»~
@11563 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11564 = ~«Я услышал достаточно. Прощай».~
@11565 = ~Ты видишь опрятного мускулистого мужчину, его одежда чуть более тусклая и обыденная, чем у большинства в этом городе. Держится он с надменным высокомерием и вообще резко выделяется из местной толпы. «Что тебе надо?» — спрашивает он.~
@11566 = ~«Кто ты?»~
@11567 = ~Слушать.~
@11568 = ~«Не расскажешь о посетителях этого кабака?»~
@11569 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11570 = ~«Что ты можешь рассказать мне об этом месте?»~
@11571 = ~«Я ищу дневник. Ты ничего подобного в последнее время не видел?»~
@11572 = ~«Я услышал достаточно. Прощай».~
@11573 = ~«Я ищу дневник. Ты ничего подобного в последнее время не видел?»~
@11574 = ~«Не слышал о Сборщике по имени Фарод?»~
@11575 = ~Слушать.~
@11576 = ~«На самом деле, сейчас у меня нет времени на рассказы. Но есть ещё кое-какие вопросы…»~
@11577 = ~«Я услышал достаточно. Прощай».~
@11578 = ~«Хм… не знаешь, где мне его найти?»~
@11579 = ~«У меня другие вопросы…»~
@11580 = ~«Ничего. Забудь».~
@11581 = ~«Я услышал достаточно. Прощай».~
@11582 = ~«У меня другие вопросы…»~
@11583 = ~«Не слышал о Сборщике по имени Фарод?»~
@11584 = ~«Я услышал достаточно. Прощай».~
@11585 = ~«Я Алайс, славный воитель! Ты наверняка слышал обо мне?»~
@11586 = ~«Тем не менее, я хотел бы услышать».~
@11587 = ~«Ладно. У меня другие вопросы…»~
@11588 = ~Ложь: «Да».~
@11589 = ~«Я услышал достаточно. Прощай».~
@11590 = ~Правда: «Нет».~
@11591 = ~«Эта история будет начинаться с того, как человек очнулся в Мортуарии, сочтённый мёртвым, но на деле мертва была только его память».~
@11592 = ~«Наконец-то! Не все здесь полные невежды! Я даже позволю тебе поставить мне выпивку, а потом мы можем обменяться рассказами! Я услажу твой слух историей о моих последних приключениях, включая рассказ о том, как я попал в этот изумительный и ужасающий город».~
@11593 = ~«Ладно. У меня другие вопросы…»~
@11594 = ~«Истории подождут. Может быть, сперва я задам тебе кое-какие вопросы?»~
@11595 = ~«Откуда ты? Как сюда ПОПАЛ?»~
@11596 = ~«Я услышал достаточно. Прощай».~
@11597 = ~«Может, в другой раз. Прощай».~
@11598 = ~«Он бежит из Мортуария и оказывается в Улье, а там заговаривает с человеком, который дал своему настоящему имени утечь и пожалел об этом».~
@11599 = ~«Ладно. У меня другие вопросы…»~
@11600 = ~«Я услышал достаточно. Прощай».~
@11601 = ~«Да? Что лучше: принять истину, пусть горькую, со всеми её последствиями или остаться невеждой? Кем лучше быть?»~
@11602 = ~«Ладно. У меня другие вопросы…»~
@11603 = ~«Я услышал достаточно. Прощай».~
@11604 = ~«Я хочу услышать твой ответ».~
@11605 = ~«Лучше быть тем, кто знает своё настоящее имя, потому что он знает себя и тем силён».~
@11606 = ~«Как же такое может быть правдой? Как может быть, что в целом городе никто не слышал обо мне и моих деяниях? Увы… придётся мне снова всё доказывать. А я думал, моя слава разнеслась по всем мирам».~
@11607 = ~«Лучше быть тем, кто забыл своё настоящее имя, потому что он защищён от желающих навредить ему, в том числе и от себя самого. Куда бы ни пошла личность с именем, за ней тянется шлейф. За безымянным имя не оставляет следов».~
@11608 = ~«Из *какого* мира ты родом?»~
@11609 = ~«Разумеется. Не мог бы ты ответить мне на кое-какие вопросы?»~
@11610 = ~«Неважно. У меня другие вопросы…»~
@11611 = ~«Я услышал достаточно. Прощай».~
@11612 = ~«Бывают в жизни огорчения. Прощай».~
@11613 = ~«Хорошо. У меня другие вопросы…»~
@11614 = ~«Я услышал достаточно. Прощай».~
@11615 = ~Правда: «Возможно. Чему быть, того не миновать. А может статься, у этой истории и нет ответа».~
@11616 = ~Правда: «Должен быть ответ, и у каждой истории есть конец. Я не приму иного исхода».~
@11617 = ~Правда: «Вот уж не знаю. Не мне решать».~
@11618 = ~«Хорошая цена. Тогда, может быть, ты ответишь на мои вопросы…»~
@11619 = ~«Прощай».~
@11620 = ~«Здравствуй, Вонючка. Я хотел спросить тебя…»~
@11621 = ~Оставить Вонючку в покое.~
@11622 = ~«Рад слышать. Джамбл не хотел снимать проклятие, но я добился».~
@11623 = ~«Рад слышать, что у тебя всё в порядке».~
@11624 = ~«Рад слышать. Джамбл не хотел снимать проклятие, но я добился».~
@11625 = ~«Рад слышать, что у тебя всё в порядке».~
@11626 = ~«На самом деле, у тебя есть истории, которых ты мне ещё не рассказывал? Их будет достаточно в качестве оплаты…»~
@11627 = ~«Спасибо, Вонючка. Рад был тебе помочь».~
@11628 = ~«У меня есть дневник».~
@11629 = ~«Я пришёл из города Элибурна на реке Тейме. Ты, конечно же, слышал о его славе и чудесах? Неважно, неважно… этот город населён невеждами и деревенщиной, если вести речь о славе настоящих городов. Я скажу тебе, что моя родина — то, что жители этого города называют „первичным“ — хотя я не знаю, почему он первичный».~
@11630 = ~«Спасибо, Вонючка».~
@11631 = ~~
@11632 = ~«Хорошо. И как же мне тебя звать?»~
@11633 = ~~
@11634 = ~«Договорились. Прощай».~
@11635 = ~~
@11636 = ~«Прощай».~
@11637 = ~Он свирепеет, наливается кровью, а рука его судорожно вцепляется в рукоять меча. «Бестолочь, говоришь? Я принимаю твои слова за вызов, любезный, и прошу тебя уйти в надежде больше не встречаться», — он отворачивается, переполненный яростью и высокомерием.~
@11638 = ~«Я просто хотел задать тебе пару вопросов».~
@11639 = ~«Тогда прощай».~
@11640 = ~«Я знаком только со старым Эббом Скрипучие Колени, который просветил меня по части путей в городе и этих „пластов“. Должно быть, заклинание моего противника перенесло нас очень далеко, потому что на нашей родине никто не слышал ни о каких пластах».~
@11641 = ~«Нет-нет… планы. Это как планы бытия. Планы воображения, мысли и веры. Это не физические степи или равнины, но другие измерения».~
@11642 = ~«Нет-нет… планы. Это как планы бытия. Планы воображения, мысли и веры. Это не физические степи или равнины, но другие измерения».~
@11643 = ~«Я понял. Ты бестолочь».~
@11644 = ~«Хм. Ладно. Слушай, у меня другие вопросы».~
@11645 = ~«Ясно. Далеко же тебя занесло от дома. Удачи тебе, и прощай».~
@11646 = ~На его лице появляется смущение. «Я… я понимаю. То, что говорил старик, обретает для меня смысл… прошу прощения. Я должен это обдумать. Прощай».~
@11647 = ~«Прощай».~
@11648 = ~«Даже и не знаю. Когда я сюда прибыл, я понял: мне нужно место, чтобы прийти в себя. И представь моё удивление, когда выяснилось, что даже простая таверна в этой части мира набита чудаками и сумасшедшими. Я как будто перенёсся в дурдом!»~
@11649 = ~«Откуда ты?»~
@11650 = ~«Да, у меня иногда такое же ощущение. Я хотел бы задать ещё пару вопросов».~
@11651 = ~«Да, так и есть. Прощай».~
@11652 = ~«Боюсь, мне не до поиска подобных вещей. Я изо всех сил пытаюсь приспособиться к этому необычному окружению, сосредоточиться на его мелких деталях и должен признать, что дневники всех видов меня не интересуют».~
@11653 = ~«Тогда ладно. У меня другие вопросы».~
@11654 = ~«Хорошо. Спасибо, что уделил время».~
@11655 = ~«Фарод? Сборщик? Это имена и названия мне незнакомы, а у меня абсолютная память. Я определённо запомню твоё лицо. Просто не смогу его забыть».~
@11656 = ~«Спасибо. Не мог ты бы ответить ещё на кое-какие вопросы?»~
@11657 = ~«Спасибо. Прощай».~
@11658 = ~«Ничего. Забудь».~
@11659 = ~~
@11660 = ~«На самом деле я хотел задать пару других вопросов…»~
@11661 = ~«Расскажи мне о Госпоже».~
@11662 = ~«Расскажи мне о дабусах».~
@11663 = ~«Расскажи мне о времени Сигила».~
@11664 = ~«Расскажи мне об устройстве города».~
@11665 = ~«Расскажи мне о ключах и порталах».~
@11666 = ~«Ничего. Прощай».~
@11667 = ~Она натянуто улыбается: «Ага, изверг, как видишь, мы здесь верим в *настоящую* свободу. И никто не помешает мне говорить, что я на самом деле думаю». Илквикс на мгновение изображает презрительную ухмылку, затем его лицо опять превращается в вежливую маску.~
@11668 = ~«Тогда продолжим. Илквикс, у меня другие вопросы…»~
@11669 = ~«Тогда продолжим. Илквикс, у меня другие вопросы…»~
@11670 = ~Бежать.~
@11671 = ~Мужчина поднимает взгляд на звук твоего голоса, и выражение вялости исчезает… в глазах разгораются два огня. «Какие дела позволили тебе врываться в мой дом? — он сужает глаза и стискивает зубы. — Пшёл вон! Или я отправлю тебя обратно в могилу, из которой ты выполз!»~
@11672 = ~«Какого дьявола ты пристаёшь к моей жене?! Тут не публичный дом… оставь её в покое, или в книге мёртвых появится новое имя!»~
@11673 = ~Лицо мужчины становится багровым, и он начинает орать. «Ты идиот?! — он со злобой сплёвывает тебе под ноги. — *Ах ты грязный, драный кобель, ишь шрамов сколько! Вон отсюда, иначе даже силы не спасут твою шкуру!*»~
@11674 = ~Он выкрикивает тебе в спину запасённые к уходу колкости: «И лучше не переступай больше порог моего дома, вонючий обрыган-ублюдок».~
@11675 = ~Ты видишь Ангияра — лучше выглядеть он не стал. Когда ты снова подходишь, он медленно поворачивается. Его лицо напрягается: «Опять ты! Я разве тебе не сказал всё в ПРОШЛЫЙ раз, псина облезлая?! Вон из моего дома, или, помогите мне силы, я тебя прирежу на том же месте, где стоишь!»~
@11676 = ~Как только ты вытаскиваешь договор, от лица Ангияра отливает вся кровь. На какой-то миг он теряет дар речи, затем его гнев быстро возвращается: «Где ты это взял?! Во имя сил, лучше скажи мне…»~
@11677 = ~Минуту Ангияр брызжет слюной, затем его ярость находит себе предмет: «Я… я *убью* её! Я…»~
@11678 = ~«Ты *смеешь*… ты *смеешь* учить меня, как поступать… в моём *собственном* доме?.. — он делает глубокий вдох, затем взрывается. — Вон отсюда, сволочь! И бумагу эту сраную забирай с собой!»~
@11679 = ~«Она нарушила слово, данное мне, своему *мужу!* — руки Ангияра сжимаются в кулаки, он смотрит на тебя свирепо. — Я наказал ей не говорить об этом ни с кем, а она растрепала первому встречному, зашедшему в мой дом!»~
@11680 = ~Часть ярости покидает Ангияра, и он ворчит: «Что сделано, то сделано…» Он бросает на тебя подозрительный взгляд, затем кивает на договор: «Что ты собираешься делать с этой бумагой?»~
@11681 = ~Ангияр не отрывает глаз от договора. «Зачем ты принёс его мне? — он смотрит на тебя подозрительно. — Чтобы получить выкуп?»~
@11682 = ~Ты разрываешь пергамент, и глаза Ангияра отчаянно провожают клочки, падающие на пол. Он чуть дрожит, затем распрямляется, как будто с него свалился тяжкий груз. «Ты… — он смотрит так, словно вот-вот скажет спасибо, затем в его взгляде появляется подозрение. — Ничего не делается бесплатно. Не в Улье, здоровяк».~
@11683 = ~Яростное выражение исчезает с лица Ангияра; он словно устал бороться с навалившейся удачей. «Я… я… должно быть, молился правильным силам последние полмесяца, — он вздыхает. — Ты добился от меня благодарности, здоровяк… если для тебя это хоть что-то значит».~
@11684 = ~«Я уже заложил свою жизнь одному человеку, и не собираюсь закладывать вновь, в особенности ходячему мертвецу, — рычит он. — Вон из моего дома, пока не стал дважды мёртвым!»~
@11685 = ~Ангияр кивает: «Задавай свои вопросы».~
@11686 = ~Ангияр кивает: «Да, это имя мне знакомо, и тёплых чувств оно не вызывает».~
@11687 = ~Он хмурится: «Он один из этих Сборщиков и очень влиятелен: у него полно шестёрок наготове. Может, он и не властелин мира, но и не какой-нибудь ловкач, с которым стоит ссориться».~
@11688 = ~«Стервятники, шакалы, гиены… подонки, у которых нет достоинства ни на грош. Большинство из них устроили логово на Площади Мусорщиков. Собирают жмуриков, срывают с них всё ценное, затем продают трупы Пыльникам в Мортуарий».~
@11689 = ~«Пыльники платят за трупы. Это помогает им содержать улицы в чистоте, когда недостаточно дождя».~
@11690 = ~«Да, но не много ли тебе чести, чтоб я рассказывал… — он хмурится ещё суровее. — Один из моих родичей связался с ними несколько месяцев назад, и кое-что про Фарода рассказывал. Так вот, по его словам Фарод устроил своё логово где-то *под* Площадью Мусорщиков. Чтобы попасть туда, необходимо пройти через какой-то портал, держа в руке немного мусора».~
@11691 = ~«Это в нескольких кварталах отсюда… иди прямо на запад до ворот Мортуария, продолжай идти, пока не увидишь, что кругом мусор и рваньё. Там лучше быть поосторожнее… Сборщики не всегда ждут, когда тело помрёт, чтоб его собрать как труп, ясно?»~
@11692 = ~«Наверно, всё это богатство и изобилие вокруг свело меня с ума… — он фыркает. — У нас меньше чем ничего, и мне нужны были медяки. Тогда мне было не так уж и важно, откуда их взять. А продать моё тело Пыльникам было куда достойнее, чем большинство оплачиваемой здесь работы…»~
@11693 = ~«Просто… — он вздыхает — Я увидел одного из этих зомби на улице с полмесяца назад… одного из зомби, которые работают на Пыльников, и это ударило меня прямо в сердце. Я понял, что сделал ошибку… я не хочу после смерти быть чем-то таким».~
@11694 = ~Ангияр наливается кровью. «Мне тут не нужны твои проповеди! Да чтоб тебя, как ты *смеешь* задаваться в моём доме? Я не просил приносить мне эту адову бумагу, я тебе *ничего* не должен! Вон отсюда! Глаза б мои на тебя не глядели!»~
@11695 = ~Когда ты уже готов заговорить, странное покалывание охватывает твой затылок… ты вдруг понимаешь, что Ангияру не понравится выслушивать твои нравоучения.~
@11696 = ~Ангияр ворчит: «Пожалуй, так…»~
@11697 = ~Ты видишь Ангияра — теперь он выглядит значительно лучше; щекам вернулся цвет, а из глаз исчезла одержимость. Когда ты подходишь к нему, он медленно поворачивается и фыркает: «Хм-м-мф… не завёлся ли в Улье святой… специально для таких бедолаг, как я». Он ворчит: «Что я могу для тебя сделать?»~
@11698 = ~Ангияр кивает: «Это самое малое, что я могу сделать. Я попрошу жену вытащить для тебя пару одеял…»~
@11699 = ~Ангияр хмурится, затем качает головой: «Ничего я такого не видел, здоровяк».~
@11700 = ~«Я уже заложил свою жизнь одному человеку, и не собираюсь закладывать вновь, — он качает головой. — Разделаемся с долгами сейчас».~
@11701 = ~Оставить его со своими мыслями.~
@11702 = ~«Я говорил с твоей женой. Пожалуй, я могу помочь тебе…»~
@11703 = ~«Я говорил с твоей женой. Пожалуй, я могу помочь тебе…»~
@11704 = ~«Ну так вперёд, попробуй, если силёнок хватит…»~
@11705 = ~«*Никто* не говорит со мной таким тоном… возьми свои слова обратно, или этот дом превратится в склеп».~
@11706 = ~Показать ему его договор с Пыльными.~
@11707 = ~«Остынь. Я хотел спросить…»~
@11708 = ~«Тогда прощай».~
@11709 = ~«Ну так вперёд, попробуй, если силёнок хватит…»~
@11710 = ~«*Никто* не говорит со мной таким тоном… возьми свои слова обратно, или этот дом превратится в склеп».~
@11711 = ~Показать ему его договор с Пыльными.~
@11712 = ~«Остынь. Я хотел спросить…»~
@11713 = ~«Тогда прощай».~
@11714 = ~«Ну так вперёд, попробуй, если силёнок хватит…»~
@11715 = ~«Тогда прощай».~
@11716 = ~«Ну всё. Ты заработал себе место в могиле…»~
@11717 = ~Молча уйти.~
@11718 = ~«Я говорил с твоей женой. Пожалуй, я могу помочь тебе…»~
@11719 = ~«Я говорил с твоей женой. Пожалуй, я могу помочь тебе…»~
@11720 = ~«Ну так вперёд, попробуй, если силёнок хватит…»~
@11721 = ~«*Никто* не говорит со мной таким тоном… возьми свои слова обратно, или этот дом превратится в склеп».~
@11722 = ~Показать ему его договор с Пыльными.~
@11723 = ~«Остынь. Я хотел спросить…»~
@11724 = ~«Тогда прощай».~
@11725 = ~«Твоя жена сказала мне, где он. Она беспокоилась о тебе».~
@11726 = ~«Твоя жена сказала мне, где он. Она беспокоилась о тебе».~
@11727 = ~«Я забрал его у Пыльного по имени Мортаи. Тут стоит твоё имя».~
@11728 = ~Разорвать договор.~
@11729 = ~«Ты и *пальцем* к ней не прикоснёшься, если жизнь дорога».~
@11730 = ~«Это твоё дело, но сначала давай обсудим то, что касается нас обоих: Что ты хочешь отдать мне за этот договор?»~
@11731 = ~«Она сказала мне, потому что волнуется о тебе… а твоя первая реакция *наказать* её за заботу о тебе?»~
@11732 = ~Разорвать договор.~
@11733 = ~«Ну так *заставь* меня уйти, если силёнок хватит…»~
@11734 = ~«Стой! Она сказала мне, потому что волнуется о тебе… а твоя первая реакция *наказать* её за заботу о тебе?»~
@11735 = ~«Она нарушила слово, потому что любит тебя. Закон и клятвы иногда должны уступать дорогу более важным вещам».~
@11736 = ~«У тебя есть причины гневаться. Она не должна была давать слово, если не собиралась его держать. Я не уважаю клятвопреступников, но это уже в прошлом».~
@11737 = ~«У тебя есть причины гневаться. Она не должна была давать слово, если не собиралась его держать. Я не уважаю клятвопреступников, но это уже в прошлом».~
@11738 = ~«Да, нарушила, и тебе придётся это расхлёбывать. Нечего тут больше сказать».~
@11739 = ~«Я полагаю, ты заплатишь за него столько же, сколько заплатили тебе».~
@11740 = ~Разорвать договор.~
@11741 = ~Разорвать договор.~
@11742 = ~«Я полагаю, ты заплатишь за него столько же, сколько заплатили тебе».~
@11743 = ~«Считай, что бесплатно. И, скорее всего, многие правила Улья ко мне неприменимы».~
@11744 = ~«Возможно, в будущем мне потребуется одолжение. Сможешь мне помочь?»~
@11745 = ~«Ну, если тебе так уж нужно мне отплатить, то ответь на несколько вопросов…»~
@11746 = ~«Значит сиди и думай, как ты мне сможешь отплатить… а пока прощай».~
@11747 = ~«На самом деле ты можешь мне помочь… у меня кое-какие вопросы…»~
@11748 = ~«Просто не повторяй своих ошибок… в следующий раз меня может и не оказаться рядом».~
@11749 = ~«Для меня это многое значит. До скорого, Ангияр».~
@11750 = ~Разорвать договор.~
@11751 = ~«Ты хочешь меня убить? Ну так давай, попробуй…»~
@11752 = ~«Отлично. Я просто оставлю договор у себя… просто чтобы ты знал, что он по-прежнему вне досягаемости и вступит в силу после твоей смерти. Прощай, Ангияр».~
@11753 = ~«Могу я спросить тебя, зачем ты подписал этот договор с Пыльными?»~
@11754 = ~«Я ищу мужчину по имени Фарод. Не знаешь, где мне его найти?»~
@11755 = ~«Я потерял свой дневник. Ничего такого не видел?»~
@11756 = ~«Не возражаешь, если я тут отдохну?»~
@11757 = ~«Не бери в голову. Прощай».~
@11758 = ~«Что ты можешь о нём сказать?»~
@11759 = ~«У меня другие вопросы…»~
@11760 = ~«Неважно. Прощай».~
@11761 = ~«Сборщики?»~
@11762 = ~«Не знаешь, где мне его найти?»~
@11763 = ~«Не знаешь, где мне его найти?»~
@11764 = ~«У меня другие вопросы…»~
@11765 = ~«Ясно. Спасибо за информацию. Прощай».~
@11766 = ~«Зачем они это делают?»~
@11767 = ~«Так Фарод один из Сборщиков? Не знаешь, где мне его найти?»~
@11768 = ~«Так где я могу найти Фарода?»~
@11769 = ~«У меня другие вопросы…»~
@11770 = ~«Ясно. Прощай».~
@11771 = ~«Так Фарод один из Сборщиков? Не знаешь, где мне его найти?»~
@11772 = ~«Так где я могу найти Фарода?»~
@11773 = ~«У меня другие вопросы…»~
@11774 = ~«Ясно. Прощай».~
@11775 = ~«Где находится Площадь Мусорщиков?»~
@11776 = ~«У меня другие вопросы…»~
@11777 = ~«Ясно. Прощай».~
@11778 = ~«У меня другие вопросы…»~
@11779 = ~«Спасибо за информацию. Прощай».~
@11780 = ~«И что заставило тебя изменить мнение?»~
@11781 = ~«Ясно. У меня другие вопросы…»~
@11782 = ~«Я просто полюбопытствовал. Прощай, Ангияр».~
@11783 = ~«Тогда ты не должен был подписывать договор».~
@11784 = ~«Тогда ты не должен был подписывать договор».~
@11785 = ~«Все мы делаем ошибки».~
@11786 = ~«Ясно. У меня другие вопросы…»~
@11787 = ~«Я просто полюбопытствовал. Прощай, Ангияр».~
@11788 = ~«Ну так заставь меня уйти, если силёнок хватит…»~
@11789 = ~«Тогда прощай».~
@11790 = ~«Тогда ты не должен был подписывать договор, Ангияр».~
@11791 = ~«Все мы делаем ошибки».~
@11792 = ~«У меня другие вопросы…»~
@11793 = ~«Я просто полюбопытствовал. Прощай, Ангияр».~
@11794 = ~«У меня другие вопросы…»~
@11795 = ~«Ну, я просто полюбопытствовал. Прощай, Ангияр».~
@11796 = ~«У меня кое-какие вопросы…»~
@11797 = ~«Я просто зашёл посмотреть, как у тебя дела, Ангияр. Прощай».~
@11798 = ~«Спасибо…»~
@11799 = ~«Пока я не хочу отдыхать. У меня были вопросы…»~
@11800 = ~«Пока я не хочу отдыхать. Может, вернусь, когда мне это понадобится. До свидания».~
@11801 = ~«Может быть, ты тогда ответишь мне на пару других вопросов…»~
@11802 = ~«Всё равно спасибо. Прощай».~
@11803 = ~«Отлично. Если тебе так уж нужно мне отплатить, то ответь на несколько вопросов…»~
@11804 = ~«Я мог бы тут отдыхать».~
@11805 = ~«Ты ничего не должен, Ангияр, считай это подарком. Прощай».~
@11806 = ~«Тебе… тебе б лучше уйти, пока я не позвала мужа. Он будет не особо любезен с тем, кто вламывается в наш дом».~
@11807 = ~Она бросает взгляд на мужа, в её глазах тревога. «У… у… меня нет времени, незнакомец. Не беспокой меня подобными вещами».~
@11808 = ~Она бледнеет, глаза её в страхе расширяются. Не успеваешь ты задать ей вопрос, как она делает глубокий вдох и начинает вопить!~
@11809 = ~«У меня? — похоже, она удивлена. — О… да, да». Женщина понижает голос: «Ты б лучше уходил. Муж сейчас сам не свой… лучше б тебе его не злить».~
@11810 = ~«Он что-то не в духе последнее время, может, простудился…» — она неуверенно пожимает плечами.~
@11811 = ~«Я думаю… я думаю, он сделал что-то, о чём жалеет, — тревога на её лице переходит в отчаяние. — Мне кажется, он подписал Посмертный Договор. Не представляю, что толкнуло его на такой глупый шаг!»~
@11812 = ~Она прерывает тебя. «Прошу тебя, никому не говори, что я тебе сказала, а особенно моему мужу… — она выглядит испуганной. — Обещай мне».~
@11813 = ~Кажется, она успокаивается… но не полностью: «Тогда прощай».~
@11814 = ~Она впадает в полное отчаяние. «Я… я *ничего* не должна была тебе говорить… — её глаза наполняются слезами. — Я ещё большая дура, чем он!»~
@11815 = ~«Мой муж весьма крутого нрава… и он взял с меня слово никому не рассказывать, что с ним происходит… — она снова на тебя смотрит. — Ты *должен* хранить об этом молчание».~
@11816 = ~Она вздыхает: «И всё же, я…»~
@11817 = ~«Мёртвые… Пыльные… предлагают заключить договор, который даёт им право на твоё тело после смерти».~
@11818 = ~«Они оживляют его своей чёрной магией, превращают в ходячего мертвеца, чтобы работал на них, пока… — она безнадёжно смотрит на мужа, — …пока совсем не разложится».~
@11819 = ~«Наверно, ему не терпелось принести домой больше медяков, чем обычно. Он был так горд собой… но мне кажется, он этим договором больше навредил сам себе».~
@11820 = ~«Помимо мерзости самого договора, муж сильно изменился… с тех пор он стал замкнутым и мрачным, и кажется, не может заставить себя найти приличную работу. Как будто тень Госпожи пала на него…» — она вздыхает.~
@11821 = ~Она бросает взгляд на мужа, в её глазах тревога. «У… у… меня нет времени, незнакомец. Я должна выполнять свою работу по хозяйству…»~
@11822 = ~Она удивлённо смотрит на тебя, затем вздыхает. «Я *пыталась!* Я говорила с Пыльным, с которым муж подписал договор, но тот был холоден и безучастен, как все Пыльники! Он даже отчитал меня из-за мужа, как будто я не имею права попытаться ему помочь! — она плотно сжимает губы, как бы изображая Пыльного. — Он просто равнодушный грубиян».~
@11823 = ~«Я не могу отвергать такие жесты расположения, — её лицо светится благодарностью, однако потом возвращается тревога. — Но я должна попросить тебя: никому не говори, что это я тебе сказала. У моего мужа крутой нрав, и если он узнает…» Её бросает в дрожь.~
@11824 = ~«Этот Пыльник называл себя Могильщиком… настоящего имени я не знаю. У него стол в баре Пыльных в Улье… „Собиратели пыли“ — кажется, так он называется. Скорее всего, ты найдёшь его там, он всучивает свои договоры другим людям».~
@11825 = ~«Двигай к выходящей из района улице, как дойдёшь до мемориального камня — сверни от него к югу и западу…» — она барабанит пальцами по подбородку. «Упрёшься прямо в бар. Там один из этих… — от отвращения её лицо покрывают морщины, — …ходячих трупов прямо у входа».~
@11826 = ~«Спасибо, незнакомец… Я признательна за твою помощь».~
@11827 = ~«Тогда я прошу тебя не болтать о нашем разговоре без необходимости».~
@11828 = ~«Мёртв?! — она буквально парализована. — Но договор… нет способа раз…»~
@11829 = ~Она замолкает. Глядит на мужа, затем поворачивается к тебе: «В таком случае ничего не поделать». Её голос скрежещет как точильный камень: «Уходи».~
@11830 = ~Жена Ангияра испуганно поднимает глаза при твоём приближении: «Я уже сказала, что тебе здесь не рады… Тебе… тебе б лучше уйти, пока я не позвала мужа. Он будет не особо любезен с тем, кто вламывается в наш дом».~
@11831 = ~Жена Ангияра с надеждой поднимает глаза при твоём приближении: «У тебя получилось?..»~
@11832 = ~Завидев тебя, жена Ангияра улыбается: «Рада тебя видеть, добрый сэр. Чем могу помочь?»~
@11833 = ~Она с облегчением улыбается, глаза её заволакивает слезами: «О, клянусь силами… ты, должно быть, переодетый дэв, раз делаешь такое для человека, которого едва знаешь…»~
@11834 = ~«Нет… нет, если можешь — покажи договор моему мужу и скажи, что ты сделал это для него, не вдаваясь в подробности… Я была бы признательна».~
@11835 = ~Она смотрит на тебя с опаской: «У меня есть немного денег, несколько медяков… ты примешь их?»~
@11836 = ~Она лезет в карман и достаёт пригоршню медных монет. Какое-то мгновение печально на них глядит, потом отдаёт тебе: «Это небольшая плата за спасение души моего мужа».~
@11837 = ~«Нет… нет, если можешь — покажи договор моему мужу и скажи, что ты сделал это для него, не вдаваясь в подробности… Я была бы признательна».~
@11838 = ~«У… у меня больше ничего нет, — она выглядит испуганной. — В самом деле, сэр, ничего больше. Мой муж не подписал бы Посмертный Договор, если бы не…»~
@11839 = ~Она бледнеет, глаза её в страхе расширяются. Не успеваешь ты отреагировать, как она делает глубокий вдох и начинает вопить!~
@11840 = ~Когда ты приближаешься, жена Ангияра поворачивается к тебе и бросает встревоженный взгляд на мужа. «Я благодарна тебе за ту историю с договором, но ты не нравишься мужу, — она смотрит на Ангияра испуганными глазами. — Лучше б тебе уйти».~
@11841 = ~Жена Ангияра с надеждой поднимает глаза при твоём приближении: «Ты отдал ему?..»~
@11842 = ~«Этот Пыльник называл себя Могильщиком… настоящего имени я не знаю. У него стол в баре Пыльных в Улье… „Собиратели пыли“ — кажется, так он называется. Скорее всего, ты найдёшь его там, он всучивает свои договоры другим людям».~
@11843 = ~«Двигай к выходящей из района улице, как дойдёшь до мемориального камня — сверни от него к югу и западу…» — она барабанит пальцами по подбородку. «Упрёшься прямо в бар. Там один из этих… — от отвращения её лицо покрывают морщины, — …ходячих трупов прямо у входа».~
@11844 = ~Оставить женщину в покое.~
@11845 = ~«Если бы ты намеревалась его позвать, давно бы уже позвала. У меня к тебе кое-какие вопросы…»~
@11846 = ~«Только позови мужа, и вы оба умрёте. А теперь отвечай на мои вопросы».~
@11847 = ~«Успокойся. Я всего-то хочу задать пару вопросов…»~
@11848 = ~«Прощай».~
@11849 = ~«Прости… у тебя всё в порядке?»~
@11850 = ~«На меня ты время найдёшь. А теперь, отвечай на вопросы…»~
@11851 = ~«Тогда прощай. Прости, что потревожил».~
@11852 = ~«Проклятье…»~
@11853 = ~«Я говорил с ним… он совершенно не в себе. С ним что-то неладно?»~
@11854 = ~«С ним что-то неладно?»~
@11855 = ~«Нет, это ему лучше не злить меня, и тебе тоже. А теперь, отвечай на вопросы…»~
@11856 = ~«Тогда прощай. Прости, что потревожил».~
@11857 = ~«И всё-таки, что с ним такое?»~
@11858 = ~«Если ты скажешь мне, что именно не так, возможно, я смогу помочь».~
@11859 = ~«Тогда прощай. Прости, что потревожил».~
@11860 = ~«Посмертный Договор?»~
@11861 = ~«Ясно… похоже, у тебя целая куча проблем. Прощай».~
@11862 = ~«Почему?»~
@11863 = ~Ложь: «Клянусь, что никому не скажу».~
@11864 = ~Клятва: «Даю слово, что никому не скажу».~
@11865 = ~«Я не могу дать такое обещание. Прощай».~
@11866 = ~«Прощай».~
@11867 = ~«Почему это надо держать в тайне?»~
@11868 = ~«Ты права. Тебе не следовало мне рассказывать. Прощай».~
@11869 = ~Уйти.~
@11870 = ~«Тебе не следовало мне всё это рассказывать… слово надо держать, иначе между двумя людьми не будет доверия. Но лучше бы тебе было не давать такое обещание».~
@11871 = ~«Обещание, вырванное угрозами, — вообще не обещание. И нет греха в том, чтобы его нарушить».~
@11872 = ~«Обещания просто созданы для того, чтобы их нарушать. По важности они и сравниться не могут с человеческим благополучием».~
@11873 = ~Ложь: «Клянусь, что никому не скажу».~
@11874 = ~Клятва: «Даю слово, что никому не скажу».~
@11875 = ~«Я не могу дать такое обещание. Прощай».~
@11876 = ~«Слушай, возможно, я смогу чем-то помочь… что это за Посмертные Договоры, о которых ты говорила?»~
@11877 = ~Ложь: «Не бери в голову. Я клянусь, что никому не скажу».~
@11878 = ~Клятва: «Не бери в голову. Даю слово, что никому не скажу».~
@11879 = ~«Больше нам с тобой говорить не о чём. Прощай».~
@11880 = ~«Что Пыльные делают с телом после смерти?»~
@11881 = ~«Ясно. Прощай».~
@11882 = ~«Зачем твой муж подписал такую бумагу?»~
@11883 = ~«Твоему мужу больше не нужно будет тело, когда он умрёт. В чём вообще проблема?»~
@11884 = ~«Похоже, твои проблемы — это только твои проблемы. Прощай».~
@11885 = ~«Какая неприятность. Однако я хотел спросить тебя…»~
@11886 = ~«Можно ли разорвать этот договор?»~
@11887 = ~«Твоему мужу больше не нужно будет тело, когда он умрёт. В чём вообще проблема?»~
@11888 = ~«Похоже, твои проблемы — это только твои проблемы. Прощай».~
@11889 = ~«Какая неприятность. Однако я хотел спросить тебя…»~
@11890 = ~«Можно ли разорвать этот договор?»~
@11891 = ~«Зачем твой муж подписал такую бумагу?»~
@11892 = ~«Похоже, твои проблемы — это только твои проблемы. Прощай».~
@11893 = ~«На меня ты время найдёшь. А теперь, отвечай на вопросы…»~
@11894 = ~«Тогда прощай. Прости, что потревожил».~
@11895 = ~«Давай посмотрим, что можно сделать. С кем из Пыльных твой муж подписал договор?»~
@11896 = ~«Какая неприятность. Однако я хотел спросить тебя…»~
@11897 = ~«Похоже, твои проблемы — это только твои проблемы. Прощай».~
@11898 = ~Ложь: «Даю слово, что твой муж ничего не узнает».~
@11899 = ~Клятва: «Даю слово, что твой муж ничего не узнает».~
@11900 = ~«Я не могу давать никаких обещаний. Что будет, то и будет».~
@11901 = ~~
@11902 = ~«А, Мортаи? Он мёртв».~
@11903 = ~«Тогда я его разыщу. Где этот бар „Собиратели пыли“?»~
@11904 = ~«Договор твоего мужа у меня уже с собой».~
@11905 = ~«Отлично. Пойду посмотрю, что можно сделать».~
@11906 = ~«Нет проблем. Пойду посмотрю, можно ли разорвать договор твоего мужа».~
@11907 = ~«Ладно. Пойду посмотрю, можно ли разорвать договор твоего мужа».~
@11908 = ~«Это проблема».~
@11909 = ~«Не волнуйся. Договор у меня с собой».~
@11910 = ~«Сначала я хотел бы задать пару вопросов…»~
@11911 = ~«Прощай».~
@11912 = ~«Так что это за Посмертный Договор, который подписал твой муж?»~
@11913 = ~«Если бы ты намеревалась его позвать, давно бы уже позвала. У меня к тебе кое-какие вопросы».~
@11914 = ~«Только позови мужа, и вы оба умрёте. А теперь отвечай на мои вопросы».~
@11915 = ~«Успокойся. Я всего-то хочу задать пару вопросов…»~
@11916 = ~«Да, я смог забрать договор у Мортаи. Вот он».~
@11917 = ~«Прощай».~
@11918 = ~«Пока нет. Напомни мне, с кем твой муж подписал договор?»~
@11919 = ~«Я всё ещё пытаюсь что-то сделать. Прощай».~
@11920 = ~«Я бы не отказался тут отдохнуть».~
@11921 = ~«У меня кончаются припасы… не поможешь мне?»~
@11922 = ~«Просто захотел проведать тебя и посмотреть, как дела. Прощай».~
@11923 = ~Отдать ей договор.~
@11924 = ~«Я сделал это не за так, знаешь ли. Я хочу получить что-нибудь взамен».~
@11925 = ~«Хорошо. Тогда я покажу договор ему».~
@11926 = ~«Я сделал это не за так, знаешь ли. Я хочу получить что-нибудь взамен».~
@11927 = ~«Да».~
@11928 = ~«Несколько медяков — слишком мало. Что ещё у тебя есть?»~
@11929 = ~«Это только на чаевые. Что ещё у тебя есть?»~
@11930 = ~«Хорошо. Держи договор».~
@11931 = ~«Хорошо. Тогда я покажу договор ему».~
@11932 = ~«Не *лги* мне, женщина. Что ещё у тебя есть?»~
@11933 = ~«Неважно. Держи договор».~
@11934 = ~«Проклятье…»~
@11935 = ~«Ладно. Прости, что потревожил».~
@11936 = ~«Ещё нет. Вернусь, когда отдам».~
@11937 = ~«А, Мортаи? Он мёртв».~
@11938 = ~«Тогда я его разыщу. Где этот бар „Собиратели пыли“?»~
@11939 = ~«Договор твоего мужа у меня уже с собой».~
@11940 = ~«Отлично. Пойду посмотрю, что можно сделать».~
@11941 = ~~
@11942 = ~~
@11943 = ~~
@11944 = ~~
@11945 = ~~
@11946 = ~Морте подплывает поближе: «Что за сказ, шеф?»~
@11947 = ~Морте смотрит на твою ладонь. «Ага-а-а, — зубы вызывают у него нездоровое восхищение. — Маленькие уродливые мерзавцы, не так ли?»~
@11948 = ~«Задвинься, — Морте содрогается. — Может, *себе* такую дрянь хочешь вставить?»~
@11949 = ~«Эта трусливая мелкота пусть лучше и близко ко мне не подходит, или я… — Морте замолкает. — Знаешь, я и понятия не имею, чем можно грозить зубам».~
@11950 = ~Борьба оказывается короткой. Ты хватаешь Морте за основание черепа — единственное, что ты можешь сделать — и пока он пытается освободиться, прокусав себе путь к свободе, зубы выскакивают у тебя из руки и налетают на его челюсть. Морте воет от боли, когда зубы Ингресс вырывают его старые зубы и прыгают в образовавшиеся углубления.~
@11951 = ~Морте продолжает выть. Зубы вживаются к нему в челюсть, рассаживаясь поудобнее и пуская корни с противным сверлящим звуком.~
@11952 = ~Кажется, Морте тебя не слышит… он всё воет и воет, затем вдруг начинает щёлкать зубами. Он делает три мощных укуса, а потом верхние и нижние зубы смыкаются, не давая ему открыть рот.~
@11953 = ~Морте бурчит что-то в твою сторону, расширив глаза.~
@11954 = ~Внезапно зубы открываются, и Морте делает глубокий вдох. «*Убил* бы тебя за такое, — говорит он. — Пакостная шуточка».~
@11955 = ~Морте осторожно двигает челюстью: «Странно. Но неплохо». Вдруг зубы превращаются в клыки. «О-о-о-о-о! Они меняются!» Они снова уменьшаются до нормальных размеров, затем снова вырастают в клыки, потом опять уменьшаются… «Пожалуй, они начинают мне нравиться».~
@11956 = ~«О, я тебе всё равно это припомню», — отвечает Морте. Он скалит зубы, и они опять превращаются в клыки: «Только подожди».~
@11957 = ~«Что не так? — Морте подлетает ближе и бросает взгляд на твою ладонь. — Эй… они как будто чего-то задумали, нет?»~
@11958 = ~Происходящее дальше трудно описать… и неприятно наблюдать. Не успеваешь ты сжать руку в кулак, как зубы выскакивают из неё и налетают на челюсть Морте. Морте воет от боли, когда зубы Ингресс вырывают его старые зубы и прыгают в образовавшиеся углубления.~
@11959 = ~Внезапно зубы открываются, и Морте делает глубокий вдох. «*Убил* бы тебя за такие шуточки! Ты это нарочно! Я знаю!»~
@11960 = ~~
@11961 = ~~
@11962 = ~~
@11963 = ~~
@11964 = ~~
@11965 = ~~
@11966 = ~~
@11967 = ~~
@11968 = ~~
@11969 = ~~
@11970 = ~~
@11971 = ~~
@11972 = ~~
@11973 = ~~
@11974 = ~«Видишь эти зубы?»~
@11975 = ~«Неважно, забудь».~
@11976 = ~«Иди сюда, Морте, ты им нравишься. Посмотри, как они на тебя глазеют».~
@11977 = ~Схватить Морте и засунуть зубы ему в рот.~
@11978 = ~«Тогда забудем».~
@11979 = ~Осмотреть зубы.~
@11980 = ~Схватить Морте и засунуть зубы ему в рот.~
@11981 = ~«Тогда забудем».~
@11982 = ~«Ну вот, Морте. Это было не так уж и плохо, правда?»~
@11983 = ~«Морте? Ты в порядке?»~
@11984 = ~«Ого».~
@11985 = ~«Ну… они тебе нравятся?»~
@11986 = ~«Морте, ты в порядке?»~
@11987 = ~«Как они себя чувствуют?»~
@11988 = ~«Извини, Морте. Я не хотел причинить тебе вреда».~
@11989 = ~«Видишь? Разве я был неправ?»~
@11990 = ~«Э-э… месть ещё никому не помогала, Морте… хм, пошли».~
@11991 = ~«Ты мне потом спасибо скажешь. Вот увидишь».~
@11992 = ~«Наверняка задумали, не…»~
@11993 = ~«Морте!»~
@11994 = ~«Слушай, я не хотел, чтобы так получилось… пытался даже предупредить. Э-э… ну и как они себя чувствуют?»~
@11995 = ~КИНЖАЛ АДАНА
Урон: 2-5 колющий
Зачаровано: +1
THAC0: +1
Фактор скорости: 1
Вес: 0
Навык: клинок
Недоступно: священникам

Этот подарок ты получил от Адана, когда расстался с ним баре «Горящий труп». Это простой металлический кинжал с серебряной рукояткой. Очень трудно почувствовать его баланс, потому что он почти ничего не весит. Само лезвие сделано из какого-то странного металла, который изменяется при рассмотрении — становится то серебряным, то бронзовым, то золотым.~
@11996 = ~Это «символ отрицания»: плоский чёрный диск, который, похоже, вообще ничего не весит. Повернув его боком, можно обнаружить, что у него вообще нет толщины — совершенно нет, он двумерный. Он защищает тебя и всю группу от существ, сущность которых негативная — но не делает вас неуязвимыми для них.~
@11997 = ~ВИТОЕ КОЛЬЦО
Особенности:
Класс защиты: +1
Вес: 0

Это кольцо выглядит так, словно три колечка были переплетены между собой. Один лишь взгляд на него вызывает лёгкое головокружение.~
@11998 = ~МЕШОЧЕК ЗУБОВ
Вес: 2

Этот маленький кожаный мешочек содержит некоторое количество зубов: от коренных человеческих до клыков, по виду принадлежащих извергам. При встряхивании издаёт звук, похожий на маракасы.~
@11999 = ~КРЫСИНЫЙ АМУЛЕТ
Вызывает: «Замешательство»
Особенности:
   Класс защиты: +2
   Сила: +1
   Телосложение: +1
   Мудрость: -2
Вес: 0
Доступно: Хаоситам

Этот странный амулет из переплетённых крысиных хвостов создан Лающим-Дикарём и впитал в себя часть его хаотической натуры. Надетый, он помогает владельцу уклоняться от физических атак и вызывает безумный прилив силы и энергии (но соответственно снижает мудрость). Если держать его в руке, то можно на некоторое время сбить других с толку. Этот предмет может использоваться только Хаоситектами.~
@12000 = ~КОЛЬЦО АДАНА
Вес: 0

Этот подарок ты получил от Адана, прощаясь с ним в баре «Горящий труп». Это металлическое кольцо без украшений выглядит очень толстым и тяжёлым, но на деле почти ничего не весит. Оно изменяется при рассмотрении — становится то серебряным, то бронзовым, то золотым.~
@12001 = ~ПОДДЕЛЬНЫЙ ПОСМЕРТНЫЙ ДОГОВОР
Вес: 0

Этот фальшивый «Посмертный Договор» такой же, как и обыкновенный, но мелкий неразборчивый почерк скрывает факт, что подписавший его в действительности не отдавал свой труп в пользование Пыльным… на самом деле, любой Пыльный, который подписал договор, просто платит подписавшему определённую сумму за подпись.~
@12002 = ~ПОСМЕРТНЫЙ ДОГОВОР МЕДНОГЛАЗОГО
Вес: 0

Этот бланк договора ты получил у Медноглазого, он имеет слабый металлический запах. Мелкий, неразборчивый почерк документа позволяет разобрать, что это, похоже, договор между двумя сторонами: Пыльными и пока ещё неназванным подписавшим. За тридцать медных монет подписавший отдаёт Пыльным права на пользование своим трупом. Под этим подразумевается, что труп подписавшего будут использовать в Мортуарии в качестве разнорабочего.~
@12003 = ~«У меня кое-какие вопросы…»~
@12004 = ~«Моя ошибка… я принял тебя за другого. Прощай».~
@12005 = ~Медноглазый ничего не говорит.~
@12006 = ~«Это твой последний шанс. Отдай мне договор, или пожалеешь».~
@12007 = ~«Хм… забудь. Прощай».~
@12008 = ~«Я передумал. Прощай».~
@12009 = ~«Прощай».~
@12010 = ~Ты снова удивляешься иллюзорной природе мужчины и снова смотришь как прикованный, когда его бледно-голубые глаза обращаются на тебя. «Твои странствия принесли то, что тебе нужно?»~
@12011 = ~«Ещё нет. Я хотел спросить тебя».~
@12012 = ~«Ещё нет. Прощай».~
@12013 = ~Ты видишь добродушного вида мужчину с вежливым взглядом, устремлённым вдаль. Одет он в мягкую кожаную одежду, по которой развешаны различные полезные вещи, такие как верёвки, гвозди, трутницы, пустые пузырьки. Мужчина в буквальном смысле выглядит наполовину отсутствующим: есть в нём некая иллюзорность, словно его сущность частью улетучилась. Он поднимает на тебя глаза, и ты вдруг находишь их решительными и неотразимыми. «Приветствую тебя, ищущий».~
@12014 = ~«Приветствую».~
@12015 = ~«Прощай».~
@12016 = ~Ты снова удивляешься иллюзорной природе мужчины и снова смотришь как прикованный, когда его бледно-голубые глаза обращаются на тебя. «Твои странствия принесли то, что тебе нужно?»~
@12017 = ~«Ещё нет. Я хотел спросить тебя».~
@12018 = ~«Ещё нет. Прощай».~
@12019 = ~Он аккуратно ставит на стол свою кружку и обращает всё внимание на тебя: «Я повидал самые дальние области мультивселенной и вернулся, чтобы рассказать о них. Я шествовал по телам мёртвых богов и завивал лунные лучи в Астрале на виду у тысяч вопящих рыцарей гитиянки. Я преодолевал границы самого существования и наблюдал, как моя сущность дрожит далеко за спиной. Чем я могу тебе помочь?»~
@12020 = ~«Я хотел задать тебе кое-какие вопросы».~
@12021 = ~«Ничем. Прощай».~
@12022 = ~«Наверное, у меня будут для тебя ответы. Говори, и я отвечу».~
@12023 = ~«Я встретил женщину по имени Ингресс с *очень* плохими зубами. Она сказала, что пришла сюда через портал из какого-то мира. Портал открывался, если промурлыкать мелодию, проходя мимо двух деревьев. Можешь отправить её домой?»~
@12024 = ~«Кто ты?»~
@12025 = ~«Чем занимаешься?»~
@12026 = ~«Что это за место?»~
@12027 = ~«Я ищу свой потерянный дневник».~
@12028 = ~«Не знаешь Сборщика по имени Фарод?»~
@12029 = ~«Забудь. Прощай».~
@12030 = ~На короткое время он задумывается. «Я знаю тот портал, о котором ты говоришь, хотя и не путешествовал в тех местах последние лет тридцать. Я доставлю её домой, ищущий. Иди и скажи ей, что скоро я приду, затем возвращайся сюда, и я расскажу тебе, удалось ли мне».~
@12031 = ~«Спасибо. У меня ещё кое-какие вопросы…»~
@12032 = ~«Спасибо. Прощай».~
@12033 = ~«Я Кандриан Болезненный — путешественник, мечтатель, рассказчик и так далее».~
@12034 = ~«Ты путешественник? Расскажи мне о планах».~
@12035 = ~«У меня другие вопросы…»~
@12036 = ~«Спасибо. Прощай».~
@12037 = ~«Я устал, ищущий, так устал… только что вернулся с Негатива. Я отвечу на твои вопросы, но не могу обещать, что ответы тебя удовлетворят. Что ты хочешь узнать? Хочешь услышать о Внешних планах, о Первичном материальном или о Внутренних планах?»~
@12038 = ~«А в чём разница?»~
@12039 = ~«Расскажи мне о Внешних планах».~
@12040 = ~«Расскажи мне о Внутренних планах».~
@12041 = ~«Расскажи мне о Первичном материальном».~
@12042 = ~«Только что вернулся с Негатива? Что ты имеешь в виду?»~
@12043 = ~«Ни о чём. Но у меня другие вопросы…»~
@12044 = ~«Ни о чём. Прощай».~
@12045 = ~«Ты хотел бы узнать больше о планах? Спрашивай, и я отвечу всё, что знаю. Хочешь услышать о Внешних планах, о Первичном материальном или о Внутренних планах?»~
@12046 = ~«А в чём разница?»~
@12047 = ~«Расскажи мне о Внешних планах».~
@12048 = ~«Расскажи мне о Внутренних планах».~
@12049 = ~«Расскажи мне о Первичном материальном».~
@12050 = ~«Что ты имел в виду, когда говорил о „негативе“?»~
@12051 = ~«Ни о чём. Но у меня другие вопросы…»~
@12052 = ~«Ни о чём. Прощай».~
@12053 = ~«Разница в самой сущности, ищущий. Внутренние планы — это материя, вещество, настоящая физическая реальность. Они строительные кирпичики мультивселенной, это из них распространяются все эти верования в стихии. Внутренние планы пропускаются через Эфирный план — план потенциала, как говорят некоторые, который формирует стихии в миры смертных. Пройдя через Эфирный план, можно достичь Первичного материального, где обитают всевозможные смертные и монстры, мифы и машины. Это место, где рождается вера, и там возникают духи, создающие Внешние планы. Когда смертные умирают, они переходят через Астральный план, не-место, которое есть мысль и ментальная энергия в чистом виде. Во всём и ни в чём. Это парадокс, наряду с другими, и через него духи переходят в Большое Кольцо. Пока понятно?»~
@12054 = ~«Да. Продолжай».~
@12055 = ~«Я не уверен».~
@12056 = ~«Забудем об этом. У меня другие вопросы…»~
@12057 = ~«Давай поговорим об этом позже. Прощай».~
@12058 = ~«Теперь… Внешние планы… С чего бы начать? Знаешь ли ты основные правила планов, на которых основано всё остальное? Знаешь ли ты структуру Внешних планов? Знаешь ли ты о Большом Кольце и о частях его в наших сердцах? Знаешь ли ты о конкретных планах? Каждый из этих вопросов ведёт к следующему, и потому лучше начать сначала».~
@12059 = ~«Расскажи мне об основных правилах».~
@12060 = ~«Расскажи мне о структуре планов».~
@12061 = ~«Расскажи мне о Большом Кольце и его частях».~
@12062 = ~«Расскажи мне о конкретных планах».~
@12063 = ~«Лучше расскажи мне о Внутренних планах».~
@12064 = ~«Лучше расскажи мне о Первичном материальном плане».~
@12065 = ~«Забудь. У меня другие вопросы…»~
@12066 = ~«Наверное, мы вернёмся к этому в другой раз. Прощай».~
@12067 = ~«Отдай мне всё, что у тебя есть, вор, и я отпущу тебя».~
@12068 = ~«Стражу? Ну давай, зови. Я уверен, их вокруг *в изобилии*».~
@12069 = ~Напасть на него.~
@12070 = ~Отпустить его.~
@12071 = ~«Проклятье…»~
@12072 = ~«Проклятье…»~
@12073 = ~«Меня предупредили об одном таком как ты, который одет в одежду Пыльных и лазит по карманам».~
@12074 = ~«Твоё незнание некоторых основ философии Пыльных. Тебе следовало бы кое-что разузнать, прежде чем браться надувать людей поумнее тебя. Сейчас у меня кое-какие вопросы…»~
@12075 = ~«Тебе нужно поработать над своим навыком обчистки карманов. Сейчас у меня кое-какие вопросы…»~
@12076 = ~«Задумайся над этим сам. Сейчас у меня кое-какие вопросы…»~
@12077 = ~«Это знание тебе уже не пригодится. Приготовься к смерти».~
@12078 = ~«Что ты делаешь в одежде Пыльных?»~
@12079 = ~«Я ищу кое-кого по имени „Фарод“. Ты его знаешь?»~
@12080 = ~«Я ищу дневник».~
@12081 = ~Правда: «Отдай мне всё, что у тебя есть, или я убью тебя».~
@12082 = ~Блеф: «Отдай мне всё, что у тебя есть, или я убью тебя».~
@12083 = ~Правда: «Теперь… отдай мне *всё*, что у тебя есть, или я убью тебя».~
@12084 = ~Блеф: «Теперь… отдай мне *всё*, что у тебя есть, или я убью тебя».~
@12085 = ~«Единственный мой вопрос — сколько времени я буду тебя убивать… приготовься к смерти».~
@12086 = ~«Убирайся. Ещё раз увижу — выпотрошу».~
@12087 = ~«Уходи. И чтобы я больше даже не *слышал* о таких аферах где бы то ни было в Сигиле. Ясно?»~
@12088 = ~«Интересно. У меня другие вопросы…»~
@12089 = ~«Это всё, что я хотел узнать. Приготовься к смерти».~
@12090 = ~«Ясно. И смотри, Покрытый-Пеплом, чтобы я тут тебя больше не видел, или выпотрошу. А теперь мотай отсюда».~
@12091 = ~«Да, довольно ловко. Смотри, чтобы я больше даже не *слышал* о таких аферах где бы то ни было в Сигиле. Ясно?»~
@12092 = ~Блеф: «Ты не просто под дурачка косишь, ты и *есть* дубина. Выкладывай всё, что там у тебя есть, или Сборщикам достанется ещё одно тело».~
@12093 = ~Правда: «Ты не просто под дурачка косишь, ты и *есть* дубина. Выкладывай всё, что там у тебя есть, или Сборщикам достанется ещё одно тело».~
@12094 = ~«Неправильный ответ. Приготовься к смерти».~
@12095 = ~«О, неужели? Ну хорошо, сейчас встряхнём хорошенько и проверим».~
@12096 = ~«И всё? Лучше найди ещё чего-нибудь, Покрытый-Пеплом, или вы со смертью в момент станете близкими друзьями».~
@12097 = ~«Хорошо. Сейчас у меня кое-какие вопросы…»~
@12098 = ~«Вот и всё, что мне нужно. Приготовься к смерти».~
@12099 = ~«Убирайся. Ещё раз увижу — выпотрошу».~
@12100 = ~«Уходи. И чтобы я больше даже не *слышал* о таких аферах где бы то ни было в Сигиле. Ясно?»~
@12101 = ~«Ладно тогда. Сейчас у меня кое-какие вопросы…»~
@12102 = ~«О, неужели? Ну хорошо, сейчас встряхнём хорошенько и проверим».~
@12103 = ~«Неправильный ответ. Приготовься к смерти».~
@12104 = ~«Убирайся. Ещё раз увижу — выпотрошу».~
@12105 = ~«Уходи. И чтобы я больше даже не *слышал* о таких аферах где бы то ни было в Сигиле. Ясно?»~
@12106 = ~«Ладно же…»~
@12107 = ~«Ладно, у меня другие вопросы…»~
@12108 = ~«Это всё, что я хотел узнать. Приготовься к смерти».~
@12109 = ~«Убирайся. Ещё раз увижу — выпотрошу».~
@12110 = ~«Уходи. И чтобы я больше даже не *слышал* о таких аферах где бы то ни было в Сигиле. Ясно?»~
@12111 = ~«Кто он?»~
@12112 = ~«Ничего. У меня другие вопросы…»~
@12113 = ~«Забудь. Приготовься к смерти».~
@12114 = ~«Убирайся. Ещё раз увижу — выпотрошу».~
@12115 = ~«Уходи. И чтобы я больше даже не *слышал* о таких аферах где бы то ни было в Сигиле. Ясно?»~
@12116 = ~«Нет».~
@12117 = ~Клятва: «Даю слово, я отпущу тебя… если ты ответишь на мои вопросы».~
@12118 = ~Правда: «Да».~
@12119 = ~Ложь: «Да».~
@12120 = ~Правда: «Я оставлю тебе *жизнь*, если ты мне расскажешь».~
@12121 = ~Блеф: «Я оставлю тебе *жизнь*, если ты мне расскажешь».~
@12122 = ~Клятва: «Хорошо. Даю слово, я отпущу тебя… если ты ответишь на мои вопросы».~
@12123 = ~Правда: «Ладно, я тебя отпущу».~
@12124 = ~Ложь: «Ладно, я тебя отпущу»~
@12125 = ~Правда: «Я оставлю тебе *жизнь*, если ты мне расскажешь».~
@12126 = ~Блеф: «Я оставлю тебе *жизнь*, если ты мне расскажешь».~
@12127 = ~«Неправильный ответ. Приготовься к смерти».~
@12128 = ~«Где я могу его найти?»~
@12129 = ~«Нет. У меня ещё кое-какие вопросы…»~
@12130 = ~«Нет. У меня ещё кое-какие вопросы…»~
@12131 = ~«Это всё, что я хотел узнать. Приготовься к смерти».~
@12132 = ~«Убирайся. Ещё раз увижу — выпотрошу».~
@12133 = ~«Уходи. И чтобы я больше даже не *слышал* о таких аферах где бы то ни было в Сигиле. Ясно?»~
@12134 = ~«А *ты* сказал, что ты из Пыльных. Теперь что касается моих вопросов…»~
@12135 = ~«Да, я кучу всего наговорил, а теперь мне с тобой общаться надоело. Приготовься к смерти».~
@12136 = ~«Убирайся. Ещё раз увижу — выпотрошу».~
@12137 = ~«Уходи. И чтобы я больше даже не *слышал* о таких аферах где бы то ни было в Сигиле. Ясно?»~
@12138 = ~«Приветствую».~
@12139 = ~«Приветствую».~
@12140 = ~Пройти мимо.~
@12141 = ~«Знаешь, говорят, здесь какой-то карманник прикидывается Пыльным. Он тебе, случайно, не знаком?»~
@12142 = ~«А, бар Пыльных? Он рядом с Мортуарием. Ориентируйся по главным воротам Мортуария, затем иди чётко на юго-запад. Пропустить невозможно».~
@12143 = ~«Слышал, как же. Рад буду тебе помочь… за вознаграждение».~
@12144 = ~«Слышал, как же. Рад буду тебе помочь… если ответишь мне на некоторые вопросы».~
@12145 = ~Ложь: «Э-э… да, я слышал о нём. Рад буду тебе помочь… за вознаграждение».~
@12146 = ~Ложь: «Э-э… да, я слышал о нём. Рад буду тебе помочь… если ответишь мне на некоторые вопросы».~
@12147 = ~«Я не могу тебе помочь, прощай».~
@12148 = ~«Я не могу тебе помочь, прощай».~
@12149 = ~«Лучше бы тебе поторопиться».~
@12150 = ~«Знаешь, говорят, здесь какой-то карманник прикидывается Пыльным. Он тебе, случайно, не знаком?»~
@12151 = ~«„Секта“? Может, ты имеешь в виду „фракция“?»~
@12152 = ~«„Секта“? Ты же Пыльный: ты имеешь в виду „фракция“?»~
@12153 = ~«А, бар Пыльных? Он рядом с Мортуарием. Ориентируйся по главным воротам Мортуария, затем иди чётко на юго-запад. Пропустить невозможно».~
@12154 = ~«Я слышал о нём. И с радостью помогу… за вознаграждение».~
@12155 = ~«Я слышал о нём. И с радостью помогу… если ты ответишь мне на некоторые вопросы».~
@12156 = ~Ложь: «Э-э… да, я слышал о нём. И с радостью помогу… за вознаграждение».~
@12157 = ~Ложь: «Э-э… да, я слышал о нём. И с радостью помогу… если ты ответишь мне на некоторые вопросы».~
@12158 = ~«Ничем не могу помочь, прощай».~
@12159 = ~«Ничем не могу помочь, прощай».~
@12160 = ~«Внутренние планы — это физическая сущность. Они создают материю. Они ведут к Первичному материальному плану, который есть жизнь, смерть и рождение мысли. С Первичного можно попасть на Внешние планы, которые есть материализованная вера, где мысль обретает форму. Так проще?»~
@12161 = ~«Я всё равно не понимаю».~
@12162 = ~«Да. Продолжай».~
@12163 = ~«Лучше я спрошу тебя о другом…»~
@12164 = ~«Пожалуй, лучше я пойду. Прощай».~
@12165 = ~«К сожалению, я объяснил так просто, как только мог. Но запомни: место, где ты находишься, не в полной мере материально, оно создано силой веры, исходящей с Первичного и всех Внешних планов. Его можно изменить верой, и для перемен в нём достаточно одной лишь силы разума».~
@12166 = ~«Хорошо. Расскажи мне о планах подробнее».~
@12167 = ~«У меня другие вопросы…»~
@12168 = ~«Мне пора идти. Прощай».~
@12169 = ~«Ты должен запомнить три правила. Первое — это Правило Трёх: если ты видишь две подобные друг другу вещи, ищи третью. Второе правило называется Центром Мультивселенной: космос столь огромен, ищущий, что любое место, где ты находишься, можно с равным успехом считать центром. Некоторые могут считать центром Сигил, и они правы — но правы и те, кто помещает центр мира в бесконечных пустотах Геенны. У мультивселенной нет границ, и потому нет центра. Третье правило — правило Союза Колец: всё подчиняется принципу кольца. У колец нет начала и нет конца: Большое кольцо Внешних планов, кольцеобразная форма Сигила, кольцо стихийных планов — даже силы мыслят кольцами, кольца из колец, и кольцами подгоняют».~
@12170 = ~«Расскажи мне о структуре планов».~
@12171 = ~«У меня другие вопросы…»~
@12172 = ~«Вернёмся к этому в другой раз. Прощай».~
@12173 = ~«Внешние планы созданы и основаны на вере, мыслях и убеждениях. Они получают свою форму в соответствии с воззрениями Первичного материального плана и благодаря им принимают вид, потрясающий воображение. Вера создаёт планы, она главная сила здесь. Изменяется вера, и можно изменить природу реальности. Существа, рождённые здесь, — коренные обитатели планов, изверги и небожители, например, — по-настоящему рождены мыслями и представлениями смертных. Каждое из них воплощает тот или иной идеал, и чем большую силу набирает этот идеал, тем могущественней оказывается существо — а это значит, что существо, олицетворяющее любовь, — одно из сильнейших».~
@12174 = ~«Продолжай».~
@12175 = ~«У меня другие вопросы…»~
@12176 = ~«Поговорим об этом в другой раз. Прощай».~
@12177 = ~«Поэтому силы — или боги, как их иногда называют, — не живут здесь. Они живут там, куда стекается вся вера в них, там, где они сильнее и чище всего. Их царства есть продолжения их самих, проявления их божественной сущности, все они основаны на вере».~
@12178 = ~«То есть структура планов основывается на вере? Теперь расскажи мне о Большом Кольце».~
@12179 = ~«Расскажи мне о Внутренних планах».~
@12180 = ~«Расскажи мне о Первичном материальном плане».~
@12181 = ~«У меня другие вопросы…»~
@12182 = ~«Хватит пока. Прощай».~
@12183 = ~«Мы, свободные планарные странники, считаем бесконечность Внешних планов кольцом, опоясывающим план воплощённой нейтральности — Внешние Земли. Шпиль, на вершине которого расположен Сигил, является центром Внешних Земель. Чем дальше удаляешься от Шпиля, тем дальше план уходит от нейтральности, пока не перейдёт в соседние планы. Каждый из этих планов стыкуется с Внешними Землями, воплощая порядок и хаос, добро и зло. Великая Дорога образует демаркационную линию между Внешними Землями и городами-вратами, через которые можно попасть порталами на другие планы. За городами-вратами расстилаются Внутренние Земли, не нанесённые на карты территории, потерянные для истории, потерявшие разум. Опасность царит во Внутренних Землях».~
@12184 = ~«Продолжай».~
@12185 = ~«Давай чуть вернёмся назад, к общей информации. Расскажи мне больше о планах в целом».~
@12186 = ~«У меня другие вопросы…»~
@12187 = ~«Достаточно. Прощай».~
@12188 = ~«О каком наборе планов ты хочешь услышать?»~
@12189 = ~«О Верхних планах».~
@12190 = ~«О Нижних планах».~
@12191 = ~«О Граничных планах».~
@12192 = ~«О Внешних Землях».~
@12193 = ~«Давай чуть вернёмся назад, к общей информации. Расскажи мне больше о планах в целом».~
@12194 = ~«У меня другие вопросы…»~
@12195 = ~«Ни о каком. Прощай».~
@12196 = ~«Что касается Верхних планов, там есть нейтральные планы, планы порядка и хаоса. О каких конкретно ты хочешь узнать?»~
@12197 = ~«О нейтральных планах».~
@12198 = ~«О планах порядка».~
@12199 = ~«О планах хаоса».~
@12200 = ~«Давай чуть вернёмся назад, к общей информации. Расскажи мне больше о планах в целом».~
@12201 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12202 = ~«У меня другие вопросы…»~
@12203 = ~«Ни о каких. Прощай».~
@12204 = ~«Внешние планы различаются моралью, а не материей. Для того, чтобы ты понял, разделим все планы на три группы: Верхние планы добра, Нижние планы зла, и нейтральные Граничные планы. В свою очередь, эти группы подразделяются на планы порядка и хаоса, и Внешние Земли в середине. Какие из них тебя интересуют?»~
@12205 = ~«Верхние планы».~
@12206 = ~«Нижние планы».~
@12207 = ~«Граничные планы».~
@12208 = ~«Внешние Земли».~
@12209 = ~«Давай чуть вернёмся назад, к общей информации. Расскажи мне больше о планах в целом».~
@12210 = ~«У меня другие вопросы…»~
@12211 = ~«Никакие. Прощай».~
@12212 = ~«Верхние нейтральные планы включают в себя Зверинец, страну нейтральности и добра с лёгким уклоном в хаос, где и днём, и ночью вечное господство зверей. Там же расположена Байтопия, промышленный рай, где все трудятся на общее благо, и Элизиум, самый прекрасный план добра и спокойствия, какой я только видел. Увы, прямо сейчас я не совсем достоин насладиться её укрепляющими воздействиями. Что ещё ты хочешь узнать?»~
@12213 = ~«Расскажи мне об остальных Верхних планах».~
@12214 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12215 = ~«У меня другие вопросы».~
@12216 = ~«Ничего. Прощай».~
@12217 = ~Кандриан чуть вздрагивает. «Я не та личность, с которой лучше всего говорить о планах порядка, — говорит он. — Их врождённая структурность и всеохватывающие шаблоны меня пугают. Я не приемлю их, потому что ставлю свою индивидуальность выше, чем то знание, которое они мне навязывают. К этим планам относится военизированная Аркадия, ближайший из всех планов добра к незыблемому порядку Механус, и гора Селестия, дом архонов, остров в Серебряном море».~
@12218 = ~«Расскажи мне об остальных Верхних планах».~
@12219 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12220 = ~«У меня другие вопросы».~
@12221 = ~«Спасибо. Прощай».~
@12222 = ~«Там я чувствую себя как дома, хотя и далёк от большей части идеалов Изгарда: бесконечные войны и проверки отваги среди плавучих земляных айсбергов не по мне. А вот Арборея… — он вздыхает. — Горы изящнее, воздух чище, реки прозрачнее, а игры дольше, чем где-нибудь ещё. Это настоящий рай, место, где страсти кипят, а вино никогда не иссякает. Когда я достаточно восстановлю свой разум и тело — напомни мне рассказать о моём путешествии на Внутренние планы, когда мы закончим с Внешними — я вернусь в Арборею и на какое-то время растворюсь там, дам себе оторваться».~
@12223 = ~«Расскажи мне об остальных Верхних планах».~
@12224 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12225 = ~«У меня другие вопросы».~
@12226 = ~«Достаточно. Прощай».~
@12227 = ~«Подобно Верхним планам, Нижние подразделяются на планы порядка, хаоса и нейтральные. Каждый из них имеет свои ужасы, и все эти ужасы угнетают дух путешественника, так что лучше их избегать. О каких планах ты хочешь услышать?»~
@12228 = ~«О нейтральных планах».~
@12229 = ~«О планах порядка».~
@12230 = ~«О планах порядка».~
@12231 = ~«О планах хаоса».~
@12232 = ~«О планах хаоса».~
@12233 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12234 = ~«У меня другие вопросы».~
@12235 = ~«Ни о каких. Прощай».~
@12236 = ~«Нейтральные планы, да? Они отвратительны, плохо постижимы разумом и по природе своей более коварны, чем можно вообразить. Например, Геенна: четыре извергающихся вулкана плавают в бесконечной пустоте, каждый из них в какой-то мере *живой* и каждый жаждет любой ценой заполучить твою душу. Населяют этот план юголоты — ужаснейшие из извергов, по моему мнению, и там им и место. План запредельного зла — по крайней мере так его называют — это Серая Пустошь, не-место, которое похищает цвет твоего тела и души, крадёт даже апатию, — и это поле самой страшной битвы в войне тех краёв. Даже и не проси меня о подробностях… Далее, на хаотической стороне расположен Карцери…»~
@12237 = ~«Расскажи мне о войне».~
@12238 = ~«Расскажи мне о Карцери».~
@12239 = ~«Расскажи мне об остальных Нижних планах».~
@12240 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12241 = ~«У меня другие вопросы».~
@12242 = ~«Это всё, что я хотел узнать. Прощай».~
@12243 = ~«Да, Кровавая Война», — при этих словах твоя кровь стынет в жилах. Кажется, Болезненный этого не замечает, целиком погрузившись в воспоминания: «Две армии извергов схлестнулись на всём протяжении Нижних планов, бессмысленно убивая друг друга во славу порядка и хаоса. Они дерутся во славу своих идей, конечно, но в конце концов торжествует ненависть и тупость, которая никому не помогает и лишь наносит многим огромный вред».~
@12244 = ~«Расскажи мне о Карцери».~
@12245 = ~«Расскажи мне об остальных Нижних планах».~
@12246 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12247 = ~«У меня другие вопросы».~
@12248 = ~«Это всё, что я хотел узнать. Прощай».~
@12249 = ~«Ах, Карцери и его ядовитые джунгли, кислотные болота, разъедающие воды, как цепочка гниющих жемчужин, нанизанных рядком… — он выдерживает паузу и внимательно на тебя смотрит, снова пригвоздив к месту глазами. — Помни, ищущий: Карцери — это тюрьма, дом гехрелетов, одной из самых опасных разновидностей извергов. Сила этой тюрьмы в силе её хозяина, а он настолько силён, насколько ему позволяет пленник. Уничтожь тюремщика, и тело сможет покинуть Красную тюрьму. Оттуда практически нет другого пути, если ворота закрылись за тобой и наблюдают твои мучения. Берегись Карцери, путник, его узы крепче уз плоти».~
@12250 = ~«Расскажи мне о войне».~
@12251 = ~«Расскажи мне об остальных Нижних планах».~
@12252 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12253 = ~«У меня другие вопросы».~
@12254 = ~«Это всё, что я хотел узнать. Прощай».~
@12255 = ~«Как бы ни ненавидел я организованность Верхних планов порядка, но в них есть хоть капля божественного. Что же касается Нижних планов порядка… Ахерон — место бесконечных столкновений летающих кубов, роящихся среди душ мёртвых гуманоидов. Баатор… — он непроизвольно вздрагивает. — Баатор — это место, которое лучше обойти. Те изверги, которых ты тут убил, были едва ли не самыми слабыми из воплощений ненормального разложения, объединённого в бездушную машину порядка. Все пороки бюрократизма и чинопочитания исходят из Баатора, и он распространяет их в сердцах смертных, как ржавчину. Хотя и там можно найти кое-какое знание, оно редко стоит тех душевных ран, которые наносит этот план».~
@12256 = ~«Расскажи мне об остальных Нижних планах».~
@12257 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12258 = ~«У меня другие вопросы».~
@12259 = ~«Это всё, что я хотел узнать. Прощай».~
@12260 = ~«Как бы ни ненавидел я организованность Верхних планов порядка, но в них есть хоть капля божественного. Что же касается Нижних планов порядка… Ахерон — место бесконечных столкновений летающих кубов, роящихся среди душ мёртвых гуманоидов. Баатор… — он непроизвольно вздрагивает. — Баатор — это место, которое лучше обойти. Баатезу — вон те изверги в углу — едва ли не самые слабые из воплощений ненормального разложения, объединённого в бездушную машину порядка. Все пороки бюрократизма и чинопочитания исходят из Баатора, и он распространяет их в сердцах смертных, как ржавчину. Хотя и там можно найти кое-какое знание, оно редко стоит тех душевных ран, которые наносит этот план».~
@12261 = ~«Расскажи мне об остальных Нижних планах».~
@12262 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12263 = ~«У меня другие вопросы».~
@12264 = ~«Это всё, что я хотел узнать. Прощай».~
@12265 = ~«Приношу твоей спутнице извинения, — он кивает на Падшую Грейс, — но Бездна — не то место, куда стоит направиться. Если Баатор — воплощение порядка, то Бездна полна хаоса и нестабильности, и ни то ни другое не здорово. Если там появляется нечто, что кажется тебе нормальным, именно этого и надо больше всего бояться. Это дом танар'ри, которых большинство жителей Первичного называют „демонами“, и это имя дано им неспроста. Они… прошу прощения, леди, — Грейс склоняет голову, — непредсказуемы и жестокосердны, и очень немногим из них можно верить. Ещё раз примите мои извинения, госпожа Грейс, — насколько мне известно, вы как раз из этих немногих».~
@12266 = ~«Расскажи мне об остальных Нижних планах».~
@12267 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12268 = ~«У меня другие вопросы».~
@12269 = ~«Это всё, что я хотел узнать. Прощай».~
@12270 = ~«Бездна — не то место, куда стоит направиться. Если Баатор — воплощение порядка, то Бездна полна хаоса и нестабильности, и ни то ни другое не здорово. Если там появляется нечто, что кажется тебе нормальным, именно этого и надо больше всего бояться. Это дом танар'ри, которых большинство жителей Первичного называют „демонами“, и это имя дано им неспроста. Они непредсказуемы и жестокосердны, и очень немногим из них можно доверять. Но даже заслуживающим доверия я не стал бы верить полностью: они создания воплощённого хаоса и зла и если вдруг становятся дружелюбными, кто поручится, что это не часть большего обмана?»~
@12271 = ~«Расскажи мне об остальных Нижних планах».~
@12272 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12273 = ~«У меня другие вопросы».~
@12274 = ~«Это всё, что я хотел узнать. Прощай».~
@12275 = ~«Мне известны два Граничных плана, и они диаметрально противоположны. Один из них, Механус, представляет собой порядок в чистом виде, место, где убеждения стыкуются друг с другом, переплетаются, чередуются в гигантской машине, которой и является весь план. Некоторые считают Механус гигантским двигателем, приводящим планы в движение. Другой план — Лимбо, вращающееся болото Хаоса, где не существует законов и правил вообще, и даже если тебе кажется, что ты придумал для Лимбо классификацию, всё тут же изменяется — или не изменяется. Ничего заранее не скажешь. Я был в Лимбо не так уж давно…»~
@12276 = ~«Расскажи мне о своём путешествии…»~
@12277 = ~«Расскажи мне о своём путешествии…»~
@12278 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12279 = ~«У меня другие вопросы».~
@12280 = ~Он закрывает глаза, вспоминая: «Со мной был проводник из гитцерай, анарх, который мог придавать нелогичной материи этого плана форму своих желаний. Мы сражались с ордами слаади, созданий хаоса, населяющих те места. Кажется, их было больше, чем обычно, но кто может сказать, что „обычно“ в Лимбо… впрочем, я отвлёкся. Посреди всего этого хаоса мы натолкнулись на ряд гигантских металлических кубов, сцепленных между собой, похожих на какую-то невероятную головоломку. Они не были чем-то, что можно воплотить, осознанно или нет. Мы не нашли пути внутрь. Они были похожи… на бастион порядка в пучинах хаоса, семечко закона. Это всё, что я могу тебе рассказать».~
@12281 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12282 = ~«У меня другие вопросы».~
@12283 = ~«Это всё, что я хотел узнать. Прощай».~
@12284 = ~«Внешние Земли — возведённая в абсолют нейтральность. Возможно, это лучшее место для посещения на Внешних планах, кроме Сигила, если не хочется, чтобы мораль плана вошла в твоё сердце. На Внешних Землях всё сбалансировано — как и должно быть на плане, который является центром Внешних планов. Миры сил разбросаны вокруг, и здесь небольшое количество „городов-врат“, открывающих путь на остальные из Внешних планов. Города-врата обычно исповедуют ту же философию, что и планы, врата в которые находятся в этих городах. А если в городе не соблюдён баланс веры, город ускользает на соседний план. Это плохо для всех, так как мало кто в городе действительно *желает* таких изменений. Но хватит об этом. Что ты ещё хотел узнать?»~
@12285 = ~«Давай чуть вернёмся назад, к общей информации. Расскажи мне больше о планах в целом».~
@12286 = ~«Расскажи мне ещё о планах Большого Кольца».~
@12287 = ~«У меня другие вопросы».~
@12288 = ~«Это всё, что я хотел узнать. Прощай».~
@12289 = ~Он вздыхает, как если бы это напомнило ему о невероятной усталости. «Внутренние планы можно себе представить в виде глобуса. На верхнем полюсе находится Позитивный материальный план. На нижнем — Негативный, — он выдерживает паузу. — Напомни мне потом, чтобы я рассказал тебе о Негативе». Его глаза обращаются внутрь, словно к какому-то внутреннему ужасу. «Из взаимодействия между ними двумя проистекает всё богатство существующего и несуществующего, жизнь и смерть, действительность и небытие. Из них проистекают основные стихийные планы — Огня, Воды, Воздуха и Земли — парастихийные планы, расположенные между четырьмя основными, а также квазистихийные, происходящие от взаимодействия четырёх стихий с Позитивом и Негативом».~
@12290 = ~«Расскажи мне о Негативном плане».~
@12291 = ~«Расскажи мне об остальных планах».~
@12292 = ~«У меня другие вопросы…»~
@12293 = ~«Это всё, что я хотел узнать. Прощай».~
@12294 = ~Его глаза заволакивает туманом. «Я отправился на Внутренние планы, чтобы познать свою истинную сущность. Посещать Негативный материальный план было ошибкой. Я хотел постичь расположенность моего тела к угасанию и циклу жизни и смерти. Полагал, что буду защищён от вредоносного воздействия плана благодаря моей магии, но просчитался. Чернота бесконечной пустоты сдавила мою душу, и я попал во власть теней, которые хотели высосать саму мою сущность. На какое-то время — оно казалось бесконечностью — я сбился с пути и едва не утратил самого себя. Уже чувствовал, как сущность утекает из меня, и даже сейчас я полон лишь наполовину. Никогда туда не вернусь».~
@12295 = ~«Как же ты уцелел?»~
@12296 = ~«Как же ты уцелел?»~
@12297 = ~«Тогда расскажи мне о других планах».~
@12298 = ~«У меня другие вопросы…»~
@12299 = ~«Ясно. Прощай».~
@12300 = ~«Как я уцелел? — он выдавливает улыбку. — С помощью частицы небытия, которая небытие удерживала. Небытие можно остановить только подобным, знаешь ли, поэтому и пришлось вооружиться ничем для защиты. А что, намереваешься сам отправиться на Негатив? Тебя окружает аура безрассудства, и потому тебе от меня подарок. Держи его в руке, когда тебя одолеют тени, и он в какой-то мере защитит тебя и твоих друзей, если они будут поблизости. Вот». Он протягивает тебе маленький чёрный жетон, который выглядит будто у него вообще нет размеров.~
@12301 = ~«Спасибо. Расскажи мне больше о планах».~
@12302 = ~«У меня другие вопросы…»~
@12303 = ~«Спасибо. Прощай».~
@12304 = ~«Только символ, который я отдал тебе, и позволил унести ноги. Без него я погиб бы навечно».~
@12305 = ~«Расскажи мне больше о планах».~
@12306 = ~«У меня другие вопросы…»~
@12307 = ~«Спасибо. Прощай».~
@12308 = ~«Если хочешь побольше узнать о Первичном — наведайся туда. Безграничные миры этого плана отличаются невероятным разнообразием, будто это несколько разных планов, но я не опишу их вкратце, как остальные. Достаточно сказать, что там и рождаются Внешние планы, дети Внутренних, и возможности их в своих пределах безграничны».~
@12309 = ~«Расскажи мне больше о планах».~
@12310 = ~«У меня другие вопросы…»~
@12311 = ~«Спасибо. Прощай».~
@12312 = ~«Я? Недавно вернулся с Негатива, а теперь пытаюсь восстановить свою сущность, пока не потерял её целиком».~
@12313 = ~«Негатив? Что ты имеешь в виду?»~
@12314 = ~«Ясно. У меня другие вопросы…»~
@12315 = ~«Ясно. Прощай».~
@12316 = ~«Если только космос не сдвинулся или нас не забросило в Лабиринты, я полагаю, мы в кабаке „Горящий труп“».~
@12317 = ~«Что ты можешь рассказать о здешних посетителях?»~
@12318 = ~«Лабиринты? Что ты имеешь в виду?»~
@12319 = ~«У меня другие вопросы…»~
@12320 = ~«Прощай».~
@12321 = ~«У меня тут свои дела, ищущий, и я потратил уже слишком много времени впустую. Если тебе нужно узнать о посетителях, спроси трактирщика».~
@12322 = ~«У меня другие вопросы…»~
@12323 = ~«Прощай».~
@12324 = ~«Да, Лабиринты, в которые Госпожа ссылает неугодных ей, — он описывает небольшой полукруг над сердцем, произнося имя Госпожи. — Если хочешь больше узнать о Госпоже и городе, найди проводника или кого другого».~
@12325 = ~«Хорошо. У меня другие вопросы…»~
@12326 = ~«Хорошо. Прощай».~
@12327 = ~«Я давно не видел дневников кроме своего собственного — да и тот распался и канул в небытие. Так что извини».~
@12328 = ~«Ничего. У меня другие вопросы…»~
@12329 = ~«Прощай».~
@12330 = ~«Фарод вырос до Сборщика? Как давно это было? Когда я последний раз был здесь, он был всего лишь услужливым юношей в одном из верхних районов. Эх. Время МЕНЯЕТ людей. Нет, ищущий, больше я ничего не знаю о Фароде, ручаюсь».~
@12331 = ~«Хорошо. У меня другие вопросы…»~
@12332 = ~«Хорошо. Прощай».~
@12333 = ~«Это всё, что я хотел узнать. Прощай».~
@12334 = ~«У меня есть несколько вопросов…»~
@12335 = ~«Неважно. Прощай».~
@12336 = ~«Я только хотел задать тебе несколько вопросов…»~
@12337 = ~«Тогда прощай».~
@12338 = ~Напасть на него, когда он соберется уходить.~
@12339 = ~Напасть на него, когда он соберется уходить.~
@12340 = ~Отпустить его.~
@12341 = ~Тело этого существа выглядит, словно человеческое совместили с бараньим. Голова одновременно имеет и те и другие признаки: широкий плоский нос, покрытые шерстью уши, пара витых рогов. Грязная шерсть выстрижена сложными узорами, а за поясом огромная секира с четырьмя лезвиями. Кажется, существо тебя не замечает.~
@12342 = ~«Снова мы встрэтылись, путник. Что-ныбудь тэбе от мэня нужно?»~
@12343 = ~«Тогда прощай».~
@12344 = ~Ты видишь чешуйчатого изверга, очень похожего на такого же, стоящего рядом. Оба они чёрные и похожи на рептилий со сложенными крыльями, как у летучих мышей. У обоих проколоты левые уши. У этого не хватает зуба с правой стороны. Он замечает рядом с тобой Падшую Грейс и резко шипит: «Убери этот сброд из Бездны, и мы будем говорить. А до тех пор мы ничего не скажем». Он смачно сплёвывает.~
@12345 = ~«Тогда прощай».~
@12346 = ~Ты видишь чешуйчатого изверга, очень похожего на такого же, стоящего рядом. Они оба чёрные и похожи на рептилий со сложенными крыльями, как у летучих мышей. У обоих проколоты левые уши. У этого не хватает зуба с правой стороны. «А, Тегар'ин, — говорит он. — Наш старый друг вернулся с ответным визитом».~
@12347 = ~При твоём приближении абишай гневно шипит. «Убери отсюда этих мелких крыс Хаоса, — показывает он на Падшую Грейс и Анну. — и мы будем иметь с тобой дело. Иначе мы и слова тебе не скажем».~
@12348 = ~«Тогда прощай».~
@12349 = ~При твоём приближении абишай гневно шипит. «Убери отсюда эту мелкую крысу Хаоса, — показывает он на Анну. — и мы будем иметь с тобой дело. Иначе мы и слова тебе не скажем».~
@12350 = ~«Тогда прощай».~
@12351 = ~При твоём приближении абишай гневно шипит. «Убери отсюда эту мелкую крысу Хаоса, — показывает он на Падшую Грейс. — и мы будем иметь с тобой дело. Иначе мы и слова тебе не скажем».~
@12352 = ~«Тогда прощай».~
@12353 = ~«Блудный сын возвращается, а? — изверг скалится в улыбке, из уголков его рта вьются струйки ядовитого пара. — Твоя память вернулась к тебе, старый друг?»~
@12354 = ~«Что ты имеешь в виду?»~
@12355 = ~«У меня кое-какие вопросы…»~
@12356 = ~«Прощай».~
@12357 = ~«Вопросы? Быть может, у нас есть на них ответы. Мы определённо рады помочь тебе, старый друг».~
@12358 = ~«Кто вы?»~
@12359 = ~«Чем занимаетесь?»~
@12360 = ~«Что это за место?»~
@12361 = ~«Расскажи мне об извергах».~
@12362 = ~«Не знаешь Сборщика по имени Фарод?»~
@12363 = ~«Я ищу дневник».~
@12364 = ~«Ничего не знаешь о Сборщике, который вёл дела с извергами?»~
@12365 = ~«Да и я глубоко огорчён, Тегар'ин. Но я смогу спать спокойно. В конце концов, прошли столетия, а мы знаем, как разрушаются мозги смертных с возрастом».~
@12366 = ~Этельгрин не обращает на тебя внимания, отвечая своему товарищу: «И вновь, Тегар'ин, ты ухватил самую суть дела. Хотя, возможно, не стоит упоминать о том, что носящий имя „Трижды Проклятый“ должен был его заслужить».~
@12367 = ~«У меня другие вопросы…»~
@12368 = ~«У меня другие вопросы…»~
@12369 = ~«Уж не маленький ли летающий череп я вижу? Какой же приятный запах бааторианского разложения вокруг тебя, моя прелесть. Может быть, мы обсудим это… позже, — абишай обращает своё внимание к тебе: — Ну так… ты говорил, что у тебя есть вопросы?»~
@12370 = ~«Кто вы?»~
@12371 = ~«Чем занимаетесь?»~
@12372 = ~«Что это за место?»~
@12373 = ~«Расскажи мне об извергах».~
@12374 = ~«Не знаешь Сборщика по имени Фарод?»~
@12375 = ~«Я ищу дневник».~
@12376 = ~«Ничего не знаешь о Сборщике, который вёл дела с извергами?»~
@12377 = ~«Чем занимаемся? Ну же, разве это не совершенно очевидно, старый друг? Мы получили отпуск с любимой службы, наслаждаемся столь необходимым отдыхом, а заодно и вербуем новых рекрутов в наши славные ряды. Начальство полностью поддерживает наше присутствие здесь, будь уверен».~
@12378 = ~«Как мы видим, изверги делятся на два сорта: правильные и неправильные. Наша сторона — сторона баатезу — правильная. Другая сторона — эти проклятые, ненавистные, хаотичные танар'ри — неправильная и должна быть уничтожена».~
@12379 = ~«Я не веду дневника, друг, и тебе не советую. А почему — спроси моего дорогого товарища Тегар'ина, и на тебя снизойдёт просветление».~
@12380 = ~«Хорошо. Тегар'ин, почему мне не следует вести дневник?»~
@12381 = ~«Может, позже. У меня другие вопросы…»~
@12382 = ~«Возможно, в другой раз. Прощай».~
@12383 = ~«Ты! Я жэ сказал: ныкагда, *ныкагда* нэ пападайса у мэня на пути! Вон отсюда, двуногий…»~
@12384 = ~Оно поворачивается с удивительным проворством, и его глаза подозрительно на тебя смотрят. Голос существа глубокий и грохочущий, не совсем человеческий и с сильным акцентом: «Что тэбэ надо, двуногий…» Его рука ползёт к рукояти секиры.~
@12385 = ~Похоже, существо успокаивается, рука отодвигается от оружия. Однако оно всё ещё держится от тебя на некотором расстоянии…~
@12386 = ~«Что ты хочэшь у мэня спрасить?»~
@12387 = ~В один момент он выхватывает секиру из-за пояса, приготовившись к драке. «Перэд тэм как обломать тэбе рога, я хочу лишь спросить, почэму ты напал на мэня, двуногий». Его обутые в железо ноги выбивают искры из мостовой, когда он перемещает свой вес взад и вперёд.~
@12388 = ~Его секира слегка опускается; он раздражённо выдыхает: «Ну ладно, вазможно, нам нэ стоит так тарапиться випустить кровь. Что ты от мэня хотэл?»~
@12389 = ~Морте шепчет тебе: «Шеф, мне это не нравится. Их здесь быть не должно. Небожителям не настолько надрали жопу в Кровавой Войне, чтобы хоть одному извергу дали отпуск. Им что-то *надо*. Поосторожнее». А тем временем разговор продолжает ответ Тегар'ина…~
@12390 = ~«ШТО? Нет, двуногий, это *ты* на *мэня* напал. Я нэ откажусь с тобой подраться, если ты этаго хочэшь, но нэ будет ущэрба для чести, если мы сэйчас мирно разойдёмся…»~
@12391 = ~«ШТО? — кажется, он слегка обалдевает от твоих обвинений. — Нэт, двуногий, это *ты* на *мэня* напал. Я нэ откажусь с тобой подраться, если ты этаго хочэшь, но нэ будет ущэрба для чести, если мы сэйчас мирно разойдёмся…»~
@12392 = ~«А, апят ты, двуногий. Что ещё?»~
@12393 = ~«Ну харашо, ты, гавнаед с бусами в валасах и со шрамами на рожэ! Если ты вдруг да уцэлэешь, лучшэ *ныкагда* мнэ больше нэ пападайса!» — его копыта высекают искры, пока он готовится к схватке.~
@12394 = ~На какой-то момент он замолкает, как бы ожидая от тебя чего-то ещё. «А… что ты хочэшь узнать об этам городе?»~
@12395 = ~«Ну, эта перэкрёсток, двуногий. Навэрное, ты слышал, что все пороги вэдут в Сыгил?»~
@12396 = ~«Тогда прощай».~
@12397 = ~«Тогда прощай».~
@12398 = ~Ты видишь чешуйчатого изверга, очень похожего на такого же, стоящего рядом. Оба они чёрные и похожи на рептилий со сложенными крыльями, как у летучих мышей. У обоих проколоты левые уши. У этого небольшой шрам под левым глазом. Он замечает рядом с тобой Падшую Грейс и резко шипит: «Убери этот сброд из Бездны, и мы будем говорить. А до тех пор мы ничего не скажем». Он смачно сплёвывает.~
@12399 = ~«Тогда прощай».~
@12400 = ~Ты видишь чешуйчатого изверга, очень похожего на такого же, стоящего рядом. Оба они чёрные и похожи на рептилий со сложенными крыльями, как у летучих мышей. У обоих проколоты левые уши. У этого небольшой шрам под левым глазом. «Здравствуй, старый товарищ. Приятно встретить тебя снова».~
@12401 = ~«Снова?»~
@12402 = ~При твоём приближении абишай гневно шипит. «Убери отсюда этих мелких крыс Хаоса, — показывает он на Падшую Грейс и Анну. — и мы будем иметь с тобой дело. Иначе мы и слова тебе не скажем».~
@12403 = ~«Тогда прощай».~
@12404 = ~При твоём приближении абишай гневно шипит. «Убери отсюда эту мелкую крысу Хаоса, — показывает он на Анну. — и мы будем иметь с тобой дело. Иначе мы и слова тебе не скажем».~
@12405 = ~«Тогда прощай».~
@12406 = ~При твоём приближении абишай гневно шипит. «Убери отсюда эту мелкую крысу Хаоса, — показывает он на Падшую Грейс. — и мы будем иметь с тобой дело. Иначе мы и слова тебе не скажем».~
@12407 = ~«Тогда прощай».~
@12408 = ~«Блудный сын возвращается, а? — изверг скалится в улыбке, из уголков его рта вьются струйки ядовитого пара. — Твоя память вернулась к тебе, старый друг?»~
@12409 = ~«Что ты имеешь в виду?»~
@12410 = ~«Так и есть, Этельгрин, так и есть. Но его глаза не горят, как когда-то. Как ты думаешь, что привело его к нам опять? Что ПРИВЕЛО тебя к нам опять, друг?»~
@12411 = ~«Кто вы?»~
@12412 = ~«Чем занимаетесь?»~
@12413 = ~«Что это за место?»~
@12414 = ~«Расскажи мне об извергах».~
@12415 = ~«Не знаешь Сборщика по имени Фарод?»~
@12416 = ~«Я ищу дневник».~
@12417 = ~«Ничего. Прощай».~
@12418 = ~«Эх, Этельгрин, время украло память у нашего старого товарища! Ты нас действительно не узнаёшь? По правде говоря, я огорчён».~
@12419 = ~«Но…»~
@12420 = ~«Что я имею в виду, дорогой ты мой, так это вот что: время — наш старый враг — нанесло тебе огромный вред. Оно отняло у тебя память и украло все воспоминания. Если ты нас не помнишь, то это потому, что пал жертвой одной из слабостей смертных. Мы твои старые друзья, очень старые. Чем мы можем тебе помочь?»~
@12421 = ~«У меня были вопросы…»~
@12422 = ~«Ах-х, хорошо сказано. Старый друг, мы абишаи из Баатора. Сейчас в отпуске. Я — Тегар'ин Трижды Проклятый. Так меня прозвали за способность извлекать пользу из любой ситуации. А он — Этельгрин, который ещё не заработал себе прозвища, хотя не из-за недостатка усердия».~
@12423 = ~«Ничем. Прощай».~
@12424 = ~«Недостатка усердия? Что ты имеешь в виду?»~
@12425 = ~В свою очередь Тегар'ин игнорирует твои слова, отвечая к своему товарищу: «И вновь я утверждаю, что любое упоминание лучше, чем никакого». Абишай поворачивается к тебе: «Старый друг, я удовлетворил твоё любопытство в отношении наших личностей?»~
@12426 = ~«Пожалуй, удовлетворил. У меня другие вопросы…»~
@12427 = ~«Пожалуй, удовлетворил. Прощай».~
@12428 = ~«Если отвечать более обстоятельно, мы развлекаемся в этом… очаровательном… заведении. Ну и, конечно, отмечаем встречу со старым другом. Однако ветер, который иногда доносит до нас запахи божественности, несколько ослабляет нас: физически, психически и духовно. К счастью, воздух в этом районе города пропитан восхитительными ароматами боли и мольбы. Ты согласен?» — изверг снова широко улыбается тебе.~
@12429 = ~«У меня ещё кое-какие вопросы».~
@12430 = ~«Конечно. Прощай».~
@12431 = ~«Это кабак „Горящий труп“ — одно из самых занимательных и достойных питейных заведений в этом городе. Поэтическое зрелище горящего человека перед входом в заведение придаёт ему просто море очарования. Ты хотел спросить ещё о чём-то?»~
@12432 = ~«Да, у меня ещё кое-какие вопросы…»~
@12433 = ~«Нет. Прощай».~
@12434 = ~«Мы настаиваем, что танар'ри — непосредственные виновники развязывания Кровавой Войны! Если бы не они, мы бы содержали Нижние планы в мире, и не пришлось бы тратить столько сил на эту гнусную войну, которая… к сожалению… перетекает на соседние планы, вызывая такую озабоченность среди жеманных добродетелей. Именно танар'ри напрямую виновны в столь жалком состоянии мультивселенной».~
@12435 = ~«На самом деле я спросил немного о другом. Я хотел бы знать, что вас отличает друг от друга».~
@12436 = ~«Ясно. У меня другие вопросы…»~
@12437 = ~«Ясно. Прощай».~
@12438 = ~Изверг на миг замолкает, потом его лицо озаряется пониманием: «Ах да. Понимаешь, мы представляем закон и порядок. Нарушители закона должны быть наказаны. Если бы закона не было, то была бы сплошная анархия, а ты наверняка видел, что анархия натворила с Бездной: там такие ужасы, аж представить невозможно. Любые крайности со стороны баатезу оправдываются тем, что танар'ри олицетворяют прилив хаоса. Мы не желаем никому вреда, просто требуем уважения границ».~
@12439 = ~«Ясно. У меня другие вопросы…»~
@12440 = ~«Ясно. Прощай».~
@12441 = ~«Фарод? Я слышал это имя. Он не мудрец, часом? Не некромант? А может, трущобный прорицатель? Я слышал о нём, друг, но не имел удовольствия познакомиться. Возможно, кто-нибудь другой из… здешних посетителей… поможет тебе».~
@12442 = ~«Возможно. У меня другие вопросы».~
@12443 = ~«Возможно. Прощай».~
@12444 = ~«А потому, друг мой, что опасно оставлять правдивые слова потомкам, а особенно тому, кому ты когда-то верил, — он бросает ядовитый взгляд на Этельгрина. — Эти слова могут быть использованы против тебя. На самом деле, это может даже привести к поступкам, равносильным дезертирству… потеря дневника может стоить тебе самого твоего существования».~
@12445 = ~«Ясно. У меня другие вопросы…»~
@12446 = ~«Ясно. У меня другие вопросы…»~
@12447 = ~«Ясно. Прощай».~
@12448 = ~«Ясно. Прощай».~
@12449 = ~«Шеф, я всё больше уверен, что дело тут нечисто. Очень уж похоже, что они дезертировали, а теперь ищут способ как-то повысить свой статус в Бааторе. Не стоило бы с ними говорить, шеф… ты не знаешь, в какую игру они играют, и можешь запросто поджариться… образно выражаясь».~
@12450 = ~«Хорошо, Морте. Всего пара вопросов…»~
@12451 = ~«Хорошо, Морте. Завязываем с этим».~
@12452 = ~«Гдэ? Хм-м… — он задумчиво оглядывается, тряся бородой, — …он во Внэшних Зэмлях — это центр систэмы планов. Но так как попасть сюда можно практычески атавсуду, Сыгил нэ только здэсь, а ещё в куче разных мэст. Понятно?»~
@12453 = ~На секунду он мрачнеет. «Это мэсто… нэсчастное, нэчистое место… полно враждэбных, ыногда просто отчаянных людэй. Нэ лучшее мэсто посещения для бариаура, двуногий, — он пожимает плечами. — Но у мэня тут дэла, так что приходится тэрпеть».~
@12454 = ~Бариаур качает головой, посмеиваясь: «Нэт, нэт, двуногий… бариауры здэсь жить нэ могут».~
@12455 = ~«В слэдующий раз, двуногий. Если мы когда-нибудь встрэтимся в… более прыятном мэсте, я тэбэ об этом расскажу».~
@12456 = ~«Я с равнин Изгарда, двуногий. Там мой дом», — он тепло улыбается, как будто согретый воспоминаниями.~
@12457 = ~Он удивлённо на тебя смотрит: «Что имэнно ты хотэл бы о них узнать?»~
@12458 = ~«Я нэ думаю, что тут можно гдэ-то развлэчься, двуногий. Можэт, тэбэ слэдует паискать гдэ-нибудь в другом загоне».~
@12459 = ~Он хмурится: «Сомнэваюсь, что тут можно заняться чэм-нибудь прыличным… едынствэнное, что здэсь, в Улье, в избытке — это праблэмы».~
@12460 = ~«Я знаю здэсь нэ так много народу, двуногий… этот „Фарод“ нэ из их числа. Он твой друг?»~
@12461 = ~Он просто качает головой: «Нэт, двуногий… ничего подобного».~
@12462 = ~«Гаспажа? — он оглядывается, будто боится, что его подслушают. — Я знаю только, что она правит этим мэстом, всэм Сыгилом, и мэстные вэрят, что говорить а ней прыносит нэсчастье».~
@12463 = ~Он выглядит чуть недовольным: «Да, имэнно это я и сказал. „Пороги“».~
@12464 = ~Его чёрные глаза превращаются в щели; во взгляде появляются подозрение и ярость: «Я сказал, что сказал. Может, имэнно *ты* должен виучыть *мой* язык, двуногий…»~
@12465 = ~Он презрительно морщится, тянется к оружию… затем берёт себя в руки: «Больше нэ пападайса мнэ на… ПРАХАДЫ… сабака свынская, или я тэбя убью». Он отворачивается.~
@12466 = ~Морте подлетает совсем близко и шепчет тебе в самое ухо: «Он *прав*, шеф… не знаю, что вас обоих так взбесило».~
@12467 = ~«Да, да! Отличная идея!»~
@12468 = ~*Снифф* — *Снифф* «Хрмф! Ничего!»~
@12469 = ~«Приветствую…»~
@12470 = ~Оставить его в покое.~
@12471 = ~«У меня кое-какие вопросы…»~
@12472 = ~«Нет, не бери в голову. Прощай».~
@12473 = ~«Но…»~
@12474 = ~Защищаться.~
@12475 = ~«Только поговорить с тобой. Я хотел спросить…»~
@12476 = ~«Если ты ищешь драки, я тебе обеспечу…»~
@12477 = ~«Ничего, не бери в голову. Прощай».~
@12478 = ~«Почему ты такой подозрительный по отношению ко мне?»~
@12479 = ~«Расскажи мне об этом городе».~
@12480 = ~«Расскажи мне о трущобах вокруг нас».~
@12481 = ~«Можешь рассказать мне о Госпоже Боли?»~
@12482 = ~«Знаешь кого-нибудь по имени Фарод?»~
@12483 = ~«Я потерял дневник. Не знаешь, где я могу его найти? Ничего подобного не видел?»~
@12484 = ~«На самом деле, ничего. Прощай».~
@12485 = ~«Ничего такого я в виду не имел…»~
@12486 = ~«Я? Это *ты* угрожал *мне*».~
@12487 = ~«Я? Это *ты* угрожал *мне*».~
@12488 = ~«Ты оскорбил меня, козложопый четвероногий болван!»~
@12489 = ~«Да просто *захотелось*…»~
@12490 = ~Повернуться и уйти.~
@12491 = ~Убежать.~
@12492 = ~«Всего-то задать тебе несколько вопросов…»~
@12493 = ~«Я передумал. Лучше я тебе кровь пущу…»~
@12494 = ~«Хорошо… Я только хотел задать тебе вопрос…»~
@12495 = ~«О, нет… это *ты* первый начал, и ты об этом пожалеешь!»~
@12496 = ~«Забудь. Прощай».~
@12497 = ~«У меня вопрос…»~
@12498 = ~«Ничего… прощай».~
@12499 = ~Защищаться.~
@12500 = ~Убегать.~
@12501 = ~«Что это за место?»~
@12502 = ~«Где именно он расположен?»~
@12503 = ~«Неважно. Я задам тебе другой вопрос».~
@12504 = ~«Забудь, что я спрашивал; это неважно. Прощай».~
@12505 = ~«„Пороги“?.. Ты хотел сказать „дороги“?»~
@12506 = ~«Да, ясно… и где именно находится Сигил?»~
@12507 = ~«Я хочу спросить о другом».~
@12508 = ~«Это всё, что я хотел узнать. Прощай».~
@12509 = ~«Я так думаю, да. Но *что* это за место?»~
@12510 = ~«Угу. Я хочу спросить о другом».~
@12511 = ~«Да, конечно. Это всё, что я хотел узнать; прощай».~
@12512 = ~«Место посещения? Так ты не местный?»~
@12513 = ~«Дела? И зачем же ты здесь?»~
@12514 = ~«Ясно. У меня другие вопросы».~
@12515 = ~«Тогда не буду тебя задерживать, прощай».~
@12516 = ~«Откуда ты?»~
@12517 = ~«А что у тебя здесь за дела?»~
@12518 = ~«Ясно. У меня другие вопросы».~
@12519 = ~«Тогда не буду тебя задерживать, прощай».~
@12520 = ~«Ты сказал, что посещаешь Сигил; так ты сам не местный?»~
@12521 = ~«Тогда я хотел бы спросить тебя о другом…»~
@12522 = ~«Тогда до следующего раза. Прощай».~
@12523 = ~«А чем ты занимаешься здесь?»~
@12524 = ~«Я хочу задать тебе другой вопрос…»~
@12525 = ~«Это всё, что я хотел узнать. Прощай».~
@12526 = ~«Я ищу место, где можно поразвлечься».~
@12527 = ~«Я ищу место, где можно поразвлечься».~
@12528 = ~«Я ищу работу».~
@12529 = ~«Знаешь кого-нибудь по имени Фарод?»~
@12530 = ~«Я потерял дневник. Не знаешь, где я могу его найти? Ничего подобного не видел?»~
@12531 = ~«На самом деле ничего. У меня другие вопросы…»~
@12532 = ~«Ничего. Прощай».~
@12533 = ~«А если бы я искал работу?»~
@12534 = ~«У меня другие вопросы…»~
@12535 = ~«А где тут можно поразвлечься?»~
@12536 = ~«А где тут можно поразвлечься?»~
@12537 = ~«По правде говоря, не знаю. Давай я спрошу о другом…»~
@12538 = ~«Может быть, я и сам не знаю. Прощай».~
@12539 = ~«Хм-м. Ещё вопрос…»~
@12540 = ~«Хорошо. Тогда прощай».~
@12541 = ~«Ясно. Другой вопрос…»~
@12542 = ~«Спасибо. Пока это всё, что я хотел узнать; прощай».~
@12543 = ~«Нет… ты опять оговорился. „Дороги“, а не „пороги“».~
@12544 = ~«Я понял. А где именно находится Сигил?»~
@12545 = ~«Ясно. Я хочу спросить тебя о другом».~
@12546 = ~«Хорошо. Вот и всё, что я хотел узнать; прощай».~
@12547 = ~«А легко: слюшай, ти ка-азел, ти ка-азел!»~
@12548 = ~«Ты прав, я прошу прощения. Я хотел бы спросить тебя кое о чём».~
@12549 = ~«Как скажешь, четвероногий. Прощай».~
@12550 = ~«Ты прав, я прошу прощения. Прощай».~
@12551 = ~Пусть себе топает.~
@12552 = ~Напасть на него, пока он отвернулся.~
@12553 = ~«Хорошо… Я только хотел задать тебе вопрос…»~
@12554 = ~«Заткнись, не череп, а нытик! А ты, козложопый, сейчас умрёшь…»~
@12555 = ~«О, нет… это *ты* первый начал, и ты об этом пожалеешь…»~
@12556 = ~«Забудь. Прощай».~
@12557 = ~«Возможно, ты мне ответишь на другой вопрос…»~
@12558 = ~«Может, ты и прав. Прощай».~
@12559 = ~«Хочешь сказать, в другом районе? Может быть. Прощай».~
@12560 = ~«Эй, там, здоровяк; рад видеть снова. Захотел вкусненьких крысок старого Кридена, а?»~
@12561 = ~Все крысы освежёваны и выпотрошены, лишены хвостов и лапок; они свисают с палки на крючках, зацепленных за шеи. Изучая способы их приготовления, ты обнаруживаешь, что их головы слегка деформированы — каждый череп увенчан выпуклой костяной шишкой, её покрывают извилины, придающие выпуклости вид обнажённого мозга.~
@12562 = ~Мужик вовсе не выглядит возмущённым; он кивает тебе, приветливо улыбаясь: «Дай-ка я те скажу, здоровяк… ты даже понятия не имеешь, чё теряешь! Я буду здесь, когда ты поймёшь…» Он продолжает впаривать своих крыс прохожим.~
@12563 = ~«Хорошо, здоровяк, хорошо! Какой сорт те нравится? — он тыкает всех по очереди пальцем с жутко грязным ногтем. — У меня есть печёные, со специями, варёные и жареные! Все свежие, все восхитительные… всего три медяка пара!»~
@12564 = ~Ты протягиваешь медяки, и он одним ловким движением насаживает пару печёных крыс на деревянную шпажку, снимает их с крюков и кладёт тебе в руку. Затем подмигивает тебе: «Приятного аппетита, здоровяк!»~
@12565 = ~Ты протягиваешь медяки, и он одним ловким движением насаживает пару крыс со специями на деревянную шпажку, снимает их с крюков и кладёт тебе в руку. Затем подмигивает тебе: «Приятного аппетита, здоровяк!»~
@12566 = ~Ты протягиваешь медяки, и он одним ловким движением насаживает пару варёных крыс на деревянную шпажку, снимает их с крюков и кладёт тебе в руку. Затем подмигивает тебе: «Приятного аппетита, здоровяк!»~
@12567 = ~Ты протягиваешь медяки, и он одним ловким движением насаживает пару жареных крыс на деревянную шпажку, снимает их с крюков и кладёт тебе в руку. Затем подмигивает тебе: «Приятного аппетита, здоровяк!»~
@12568 = ~Мясо крыс мягкое и сочное; оно легко отделяется от костей и тает во рту. Оно чуть жирное и довольно питательное, а по вкусу похоже на какое-то… другое… мясо, которое ты определённо пробовал. Мужик выжидающе глядит на тебя. «Нравится? Ещё хочешь?»~
@12569 = ~Мясо крыс ароматное и пряное, видимо, мариновалось в какой-то смеси трав перед приготовлением. Оно чуть жирное и довольно питательное, а по вкусу похоже на какое-то… другое… мясо, которое ты определённо пробовал. Мужик выжидающе глядит на тебя. «Нравится? Ещё хочешь?»~
@12570 = ~Мясо крыс, приготовленное таким образом, довольно безвкусное и жёсткое. По вкусу похоже на какое-то… другое… мясо, которое ты определённо пробовал. Ты уверен, что это мясо будет куда лучше, если его готовить иначе; тебе не понятно, зачем *вообще* варить мясо для еды. Мужик выжидающе глядит на тебя. «Нравится? Ещё хочешь?»~
@12571 = ~Снаружи мясо подгорело и покрыто хрустящей коркой, но внутри сочное и мягкое. Оно чуть жирное и довольно питательное, а по вкусу похоже на какое-то… другое… мясо, которое ты определённо пробовал. Мужик выжидающе глядит на тебя. «Нравится? Ещё хочешь?»~
@12572 = ~Он выглядит искренне удивлённым. «Жаль это слышать, здоровяк. Доброго дня», — он готов отвернуться.~
@12573 = ~Он небрежно взваливает шест с крысами себе на плечи. «Чё ты хочешь спросить, здоровяк?»~
@12574 = ~«Чё? Этих? — он трясёт шест, от чего освежёванные крысы выплясывают какую-то жуткую джигу. — Сам их ловил… в подвалах и переулках по всему Улью».~
@12575 = ~Он бросает взгляд через плечо. «Это управление по контролю за паразитами и болезнями, здоровяк. Туда я продаю крысиные хвосты за медяки, потом готовлю и продаю мелких паршивцев».~
@12576 = ~«Точно, здоровяк! Там, в этом управлении по контролю за паразитами, сидит один пень — его зовут Лорт, и он платит за хвосты. Медяк за хвост, во как. Но это должны быть мозговые паразиты… а не обычные крысы».~
@12577 = ~«Его зовут Финеас. Финеас Лорт. По-моему, он был типа воротилы раньше, ага, но его разорили конкуренты, и он осел в этой заднице Сигила. Этот пень день и ночь сидит там один и всё ждёт, когда народ принесёт ему крысиные хвосты за медяки. И знаешь, что смешнее всего? У бедолаги явно аллергия на крыс, страшная сыпь выскакивает, когда он с ними возится! Хо-хо! Хвала силам, я не на месте этого приятеля».~
@12578 = ~«Ну, он болтлив, не то слово. Часами будет трещать те шкатулкой о том, как он умён и всё такое. Из-за этого, может, и облажался», — он пожимает плечами.~
@12579 = ~«Я-то? Ну, меня зовут Криден, иногда — Крид-крысоубийца!» — он претенциозно улыбается, обнажая неровный ряд жёлтых, сломанных и кривых зубов.~
@12580 = ~«Ага, здоровяк, мозговые паразиты. Пакостные создания. Ну, обычные крысы просто жрут запасы, разносят болезни и всё такое… помеха, не более. А вот *черепные* крысы — мозговые паразиты, на которых *я* охочусь — прям проблема. Когда этих мелких трусов собирается вместе больше горстки, они становятся умны… иногда *взаправду* умны».~
@12581 = ~Он громко гогочет, от его несвежего дыхания разит луком: «Я прям эксперт по крысам, верно! Чё хочешь спросить, здоровяк?»~
@12582 = ~«Уверен как в том, что стою перед тобой, точняк! Если завижу больше двоих зараз, драпаю от них, как *только*… — он делает выразительную паузу, — …могу! А когда они собираются в стаю, они… они соображают как человек, во как!»~
@12583 = ~«Лучший мой те совет, здоровяк… если решишь зарабатывать ловлей мозговых паразитов, охоться на маленькие стайки. Дюжина, не больше. Но скажу я тебе… — он подходит ближе, обдавая зловонным дыханием, и зловеще шепчет. — Если их больше дюжины… больше пары дюжин… беги от них, как от тени Госпожи!» Он снова возвращается на место.~
@12584 = ~«Волшебство, здоровяк… волшебство! Когда этих мелких извергов становится много, у них появляются всякие странные силы! Могут заставить мозги толкача вытечь через уши, не вру! Очень страшно… просто неправильно, скажу я те. Потому Сигил и стремится так от них избавиться… это вознаграждение и всё такое».~
@12585 = ~«Сигил, в смысле? Чё ты хочешь узнать о старой Клетке, здоровяк?»~
@12586 = ~«Да, Сигил… Клетка… чё ты хочешь узнать, здоровяк?»~
@12587 = ~Он качает головой и смеётся, раскачивая мёртвых паразитов на палке: «Вишь ли, здоровяк, всё из-за этих дверей. Народ ещё называет Сигил „Городом Дверей“… магических дверей, они везде… и ведут *куда угодно*! Но тут такое дело… они все заперты! Поэтому он больше Клетка, чем чё-нибудь другое… выйти сможешь только если у тя есть подходящий ключ».~
@12588 = ~«Хей-ху-у! Хочешь байки потравить, да! Ну, я те их все вкратце перескажу: Клетка полна дверей. Эти двери везде, по всему городу Сигилу… но их не видно, пока у тя нет подходящего ключа. К каждой двери собственный ключ, и все ключи разные. Ключ может быть настоящим ключом, ну таким железным, так? А к другой двери ключом будет… скажем… жареная крыска! Или сплясать перед дверью джигу. Если у тя есть нужный ключ, ты пройдёшь через дверь, куда б она ни вела».~
@12589 = ~Крысолов насмешливо разглядывает Морте, который висит в воздухе рядом с тобой: «Мужик, ты бы просто попросил своего мимира рассказать те обо всём…»~
@12590 = ~Крысолов, в смущении глазея на вас обоих и почёсывая затылок, вдруг понимает, что вновь оказался в центре внимания. Он стряхивает озадаченное выражение и собирается с мыслями.~
@12591 = ~Он хмурится, обдумывая ответ. «Есть шанс, что если ты узнал о ключе, ты уже знаешь, куда ведёт дверь. А если, скажем, открыл её случайно, те просто надо быть осторожным. Можешь для пробы засунуть туда голову и посмотреть… но некоторые двери просто тя втягивают! Ты можешь оказаться в пакостном месте, здоровяк, попомни мои слова».~
@12592 = ~Он пожимает плечами, раскачивая шест с крысами и снова вызывая болтанку приготовленных паразитов: «Те просто надо спросить нужного человека. Из тех, кто знает всю эту фигню, скажем. Знаешь, некоторые двери остаются на месте, а некоторые движутся… если пытаться отследить их все, крыша поедет. Я сам нечасто пользуюсь дверями, так что мало чем те помогу».~
@12593 = ~Он на миг выглядит озадаченным: «Чё, об Улье, да? Чё ты хочешь узнать, здоровяк?»~
@12594 = ~«Мой собственный дом и место работы! Чё ты хочешь узнать, здоровяк?»~
@12595 = ~«Хм-м… — крысолов скребёт подбородок, оставляя на лице маслянистые пятна. — Много об этом баек, много… как я понимаю, где-то тут есть целое скопление зданий, запутанная мешанина хижин и развалюх, которые служат местом сбора всяких отбросов. Оно называется Улей, и от него все эти трущобы… целый район… получили это название».~
@12596 = ~Его дружеская улыбка превращается в сердитую гримасу: «Одни неприятности от них, здоровяк. Даже если найдёшь это место, мой те совет: не суйся. Вот и всё, чё я те о них скажу». Он вытирает нос в знак окончания ответа, и гримаса пропадает.~
@12597 = ~«Я ж не знаю, чё именно те интересно, здоровяк. Скажи, и старый Криден укажет те направление».~
@12598 = ~«Наименее опасные места, где можно набульбениться… бар „Собиратели пыли“ и „Горящий труп“. Ничего больше посоветовать не могу, здоровяк».~
@12599 = ~Он на секунду задумывается перед ответом: «Ну, здоровяк, вишь ли… здесь не так уж здорово. Жизнь тут не сахар. Это безнадёжное место, полное отчаявшихся людей. Я только скажу те, что некоторые делают чё захотят, ноль внимания на других пней. Пропасть в Улье очень просто, так и знай».~
@12600 = ~«Хе… где его нет, здоровяк? Раз уж Сигил дотянулся до всех мест, — а мне кажется, так и есть, — то нет места, где б его не было. Не знаю, правда ли он существует где-то в обычном смысле слова… то бишь в одном месте. Но большинство серьёзного народу говорит, что это где-то во Внешних Землях».~
@12601 = ~«Угу, здоровяк, так и есть. Это так называемый „Центр всех планов“, вот тут и находится Сигил. Но в том-то и проблема: если уж попал в Сигил, покинуть его можно только через магические двери. Нету здесь „нормального“ выхода на Внешние Земли».~
@12602 = ~«Да-да. А если ты вне Сигила… на Внешних Землях, тогда… ты не можешь пройти в Сигил ножками. Там просто бесконечный каменный шпиль в центре Внешних Земель, протыкает облака, а Сигил, говорят, на самой его верхушке!»~
@12603 = ~Он кивает. «Теперь скажи мне, здоровяк: если ты не можешь просто взять и выйти из Сигила на Внешние Земли или пройти с Внешних Земель в Сигил, кто скажет, где он на деле расположен? — он с мудрым видом кивает, довольный собой. — Я думаю, Сигил разбросан по всем планам понемножку — он одновременно везде и нигде».~
@12604 = ~«Да, здоровяк, двери. Я те вкратце расскажу: Клетка полна дверей. Эти двери везде, по всему городу Сигилу… но их не видно, пока у тя нет подходящего ключа. К каждой двери собственный ключ, и все ключи разные. Ключ может быть настоящим ключом, ну таким железным, так? А к другой двери ключом будет… скажем… жареная крыска! Или сплясать перед дверью джигу. Если у тя есть нужный ключ, ты пройдёшь через дверь, куда б она ни вела».~
@12605 = ~«Вообще-то в Улье не так уж много работы… большинство народу занято добычей еды и выживанием. Ты можешь собирать жмуриков, как Сборщики… или охотиться на мозговых паразитов за вознаграждение».~
@12606 = ~Он кивает. «Пень может собирать трупы и таскать их в Мортуарий, Пыльные платят медяки за труп, как я слышал. Сборщики этим и живут, обычно сначала обирают свежего жмурика, а потом продают. Я слышал… — он понижает голос и быстро оглядывается, — …кой-кто из них помогает пням пропасть, если понимаешь, о чём я. Злобный народ, в натуре».~
@12607 = ~«Ну, здоровяк, я пытаюсь. Результат ты видишь, моё дело… большинство здешнего народа подозрительны и явно враждебны, но я хочу, чтоб любой знал: у Кридена найдётся для него тёплая улыбка и вкусная, с пылу, с жару, крыска!» — он тебе подмигивает.~
@12608 = ~«Да, Госпожа Сигила. Я не говорю о Госпоже, здоровяк… а те не следует о ней спрашивать. Это приносит несчастье, точно говорю», — он описывает рукой полукруг над сердцем.~
@12609 = ~Он выглядит немного удивлённым: «Фарод? Зачем тебе искать такого типа?»~
@12610 = ~«Он главарь банды Сборщиков… ни минуты на месте не сидит, наверно, чтоб избежать неприятностей. Где-нибудь на Площади Мусорщиков найдёшь, скорее всего. Этот Фарод очень коварный малый. Здоровяку лучше поостеречься его».~
@12611 = ~Криден хмурится: «Ну тогда, здоровяк, меня не касается и где может быть такой человек».~
@12612 = ~«Извини, здоровяк, ничего подобного в округе не видел».~
@12613 = ~«Разумеется, здоровяк. Бар „Собиратели пыли“ прямо напротив Мортуария, а „Горящий труп“ — на восток отсюда».~
@12614 = ~«Ага, здоровяк… пропасть. В книге мёртвых».~
@12615 = ~«Верно, здоровяк… пропасть. В книге мёртвых».~
@12616 = ~«Я те покажу, здоровяк, только дай мне свою карту», — он показывает, оставив на карте большой жирный след от пальца.~
@12617 = ~Он касается твоей руки: «Вижу, ты уходишь, здоровяк, но пока не ушёл, не хочешь попробовать чудных, вку-у-усненьких крысок? Штучку на дорожку, а?»~
@12618 = ~«Эй там, здоровяк; рад новой встрече. Ты передумал? Вернулся за одной из вку-у-усненьких крысок Кридена?» — он соблазняюще потряхивает своим шестом с крысами.~
@12619 = ~«Эй там, здоровяк; рад новой встрече. Хочешь снова попробовать моих вку-у-усненьких крысок? Знаю, в прошлый раз те не понравилось, но может, у Кридена найдётся что-то новое, и те понравится…»~
@12620 = ~«На это не так просто ответить, как когда-то, здоровяк… вишь ли, эти дряни в последние дни куда-то задевались. Обычно я ловил их в тёмных переулках и в подвалах, да видно переловил всех. Можешь попробовать поохотиться на Площади Мусорщиков; все эти кучи мусора — отличное место для крыс».~
@12621 = ~Морте, похоже, малость сбит с толку таким вниманием со всех сторон: «Что? Что?» У тебя такое впечатление, что будь у него губы, он бы невинно насвистывал.~
@12622 = ~«Ну, я предлагаю дослушать этого мужика. Ага?» — Морте поворачивается и тяжёлым взглядом сверлит крысолова.~
@12623 = ~Морте вращает глазами, как бы в смущении. «Это… говорящая энциклопедия. Не то, чем я мог бы гордиться. А теперь давай дослушаем этого приятеля, хорошо?»~
@12624 = ~«Да ладно, шеф… зачем бы мне от тебя что-то скрывать? Я рассказывал тебе всё полезное, что *мне* было известно. Давай просто примем слова этого пня как есть».~
@12625 = ~«Да, шеф! Вот это настрой!»~
@12626 = ~«Помереть, шеф… помереть».~
@12627 = ~«Помереть, шеф… помереть».~
@12628 = ~Осмотреть «крысок».~
@12629 = ~«Я уж лучше падаль есть буду».~
@12630 = ~«А какого сорта… „крыски“ у тебя есть на продажу?»~
@12631 = ~«Сегодня никакого… но у меня есть вопросы…»~
@12632 = ~«Ничего из этого меня не интересует, спасибо. Прощай».~
@12633 = ~«Почему бы и нет… что есть в наличии?»~
@12634 = ~«Да я скорее сам себя есть буду, чем эту гадость!»~
@12635 = ~«Нет, не сегодня. Но я хотел спросить…»~
@12636 = ~«Нет, спасибо. Прощай».~
@12637 = ~«Твои крысы странно выглядят».~
@12638 = ~«Пожалуй, возьму одну».~
@12639 = ~«Я такие отбросы не ем».~
@12640 = ~«Ничего не надо, спасибо. Но я хочу тебя спросить…»~
@12641 = ~«Спасибо, никаких крыс. Прощай».~
@12642 = ~«Мозговые паразиты?»~
@12643 = ~«Я попробую».~
@12644 = ~«Пакость какая. Да я скорее падаль есть буду, чем вот это».~
@12645 = ~«Интересно. Я хочу спросить тебя…»~
@12646 = ~«Это всё, что я хотел услышать. Прощай».~
@12647 = ~«Печёных».~
@12648 = ~«Со специями».~
@12649 = ~«Варёных».~
@12650 = ~«Жареных».~
@12651 = ~«Восхитительные? Сомнительно. Кто станет есть такие отбросы?»~
@12652 = ~«У меня столько нет… но есть кое-какие вопросы…»~
@12653 = ~«У меня столько нет. Прощай».~
@12654 = ~«Я передумал, ничего не нужно. Но у меня кое-какие вопросы…»~
@12655 = ~«Знаешь, я не так уж и голоден. Прощай».~
@12656 = ~Съесть «крыску».~
@12657 = ~С отвращением выбросить её.~
@12658 = ~Съесть «крыску».~
@12659 = ~С отвращением выбросить её.~
@12660 = ~Съесть «крыску».~
@12661 = ~С отвращением выбросить её.~
@12662 = ~Съесть «крыску».~
@12663 = ~С отвращением выбросить её.~
@12664 = ~«Они и вправду хороши, но я хотел задать тебе кое-какие вопросы…»~
@12665 = ~«Ладно, возьму ещё».~
@12666 = ~«Нет, редкая гадость».~
@12667 = ~«Мне больше ничего не нужно. Прощай».~
@12668 = ~«Они и вправду хороши, но я хотел задать тебе кое-какие вопросы…»~
@12669 = ~«Ладно, возьму ещё».~
@12670 = ~«Нет, редкая гадость».~
@12671 = ~«Мне больше ничего не нужно. Прощай».~
@12672 = ~«Они и вправду хороши, но я хотел задать тебе кое-какие вопросы…»~
@12673 = ~«Ладно, возьму ещё».~
@12674 = ~«Нет, редкая гадость».~
@12675 = ~«Мне больше ничего не нужно. Прощай».~
@12676 = ~«Они и вправду хороши, но я хотел задать тебе кое-какие вопросы…»~
@12677 = ~«Ладно, возьму ещё».~
@12678 = ~«Нет, редкая гадость».~
@12679 = ~«Мне больше ничего не нужно. Прощай».~
@12680 = ~«Подожди, у меня к тебе вопрос…»~
@12681 = ~Отпустить его.~
@12682 = ~«Кто ты?»~
@12683 = ~«Я хотел поговорить с тобой о крысах…»~
@12684 = ~«Что это за здание у тебя за спиной?»~
@12685 = ~«Можешь рассказать мне об этом… городе?»~
@12686 = ~«Можешь рассказать мне о Сигиле?»~
@12687 = ~«Можешь рассказать мне об этих трущобах?»~
@12688 = ~«Можешь рассказать мне об Улье?»~
@12689 = ~«Можешь рассказать мне о Госпоже Боли?»~
@12690 = ~«Не знаешь кого-нибудь по имени Фарод?»~
@12691 = ~«Я потерял дневник. Ты ничего такого не видел?»~
@12692 = ~«Я хотел бы попробовать одну из твоих крыс».~
@12693 = ~«Ничего. Прощай».~
@12694 = ~«Ясно. Расскажи мне об этом „Улье“».~
@12695 = ~«У меня другой вопрос».~
@12696 = ~«Это всё, что я хотел узнать. Прощай».~
@12697 = ~«Кто-то платит за крысиные хвосты?»~
@12698 = ~«Я хочу спросить о другом…»~
@12699 = ~«Это всё, что я хотел узнать. Прощай».~
@12700 = ~«Расскажи мне побольше об этом Лорте».~
@12701 = ~«Мозговые паразиты?»~
@12702 = ~«Интересно. Я хочу спросить тебя о другом…»~
@12703 = ~«Ясно. Пока всё, прощай».~
@12704 = ~«„Разорили“? Есть идеи, как такое могло случиться?»~
@12705 = ~«Сигил?»~
@12706 = ~«Хорошо. Я хотел спросить о другом…»~
@12707 = ~«Может быть, я нанесу ему визит. Прощай».~
@12708 = ~«Я понял. Ещё вопрос…»~
@12709 = ~«Может быть, я поговорю с ним. Прощай».~
@12710 = ~«Ты выглядишь намного… дружелюбнее… чем большинство местного народу».~
@12711 = ~«Рад познакомиться, Криден. У меня есть ещё вопрос…»~
@12712 = ~«Может, в другой раз поговорим, Криден. Прощай».~
@12713 = ~«Они становятся разумнее?»~
@12714 = ~«Ясно. У меня другие вопросы…»~
@12715 = ~«Это всё, что я хотел узнать. Прощай».~
@12716 = ~«Где ты взял всех этих крыс?»~
@12717 = ~«Где лучше всего ловить крыс?»~
@12718 = ~«Расскажи мне об этих крысах, которых ты ловишь».~
@12719 = ~«Ничего. Давай я задам тебе ещё вопрос ни о чём…»~
@12720 = ~«Неважно. Прощай».~
@12721 = ~«Продолжай…»~
@12722 = ~«Интересно. Я хотел задать другой вопрос…»~
@12723 = ~«Ясно… это всё, что мне было нужно. Прощай».~
@12724 = ~«Почему? Что в них такого страшного?»~
@12725 = ~«Госпожа?»~
@12726 = ~«Тогда буду осторожен. Я хотел спросить о другом…»~
@12727 = ~«Я приму это к сведению. Прощай».~
@12728 = ~«Сигил?»~
@12729 = ~«Вознаграждение? Кто-то платит за крысиные хвосты?»~
@12730 = ~«Понял. Я хочу задать вопрос…»~
@12731 = ~«Ясно. Это всё, что я хотел узнать. Прощай».~
@12732 = ~«Почему ты называешь его Клеткой?»~
@12733 = ~«Где точно находится это место?»~
@12734 = ~«Ничего. Но у меня другие вопросы…»~
@12735 = ~«Ничего… не бери в голову. Прощай».~
@12736 = ~«Почему ты называешь его Клеткой?»~
@12737 = ~«Где точно находится это место?»~
@12738 = ~«Ничего. Но у меня другие вопросы…»~
@12739 = ~«Ничего… не бери в голову. Прощай».~
@12740 = ~«Расскажи мне о дверях и ключах».~
@12741 = ~«Расскажи мне о дверях и ключах».~
@12742 = ~«Ясно. Я хочу спросить тебя ещё кое о чём…»~
@12743 = ~«Это всё, что я хотел узнать. Прощай».~
@12744 = ~«Как узнать, куда ведёт дверь?»~
@12745 = ~«Как выяснить, какой ключ открывает какую дверь?»~
@12746 = ~«Интересно. У меня другие вопросы…»~
@12747 = ~«Спасибо за информацию. Прощай».~
@12748 = ~Слушать его.~
@12749 = ~«А как узнать, какой ключ открывает какую дверь?»~
@12750 = ~«Интересно. Я хочу спросить о другом…»~
@12751 = ~«Я понял. Спасибо за информацию; прощай».~
@12752 = ~«А как узнать, куда ведёт дверь?»~
@12753 = ~«Интересно. Я хочу спросить о другом…»~
@12754 = ~«Я понял. Спасибо за информацию; прощай».~
@12755 = ~«Не знаешь, почему Улей так называется?»~
@12756 = ~«Что здесь интересного?»~
@12757 = ~«Ничего, не бери в голову. Я хочу спросить о другом…»~
@12758 = ~«Неважно, это всё. Прощай».~
@12759 = ~«Не знаешь, почему Улей так называется?»~
@12760 = ~«Что здесь интересного?»~
@12761 = ~«Ничего, не бери в голову. Я хочу спросить о другом…»~
@12762 = ~«Неважно, это всё. Прощай».~
@12763 = ~«Место сбора? Кого или чего?»~
@12764 = ~«Ясно. Что здесь интересного?»~
@12765 = ~«Хм-м. У меня другие вопросы…»~
@12766 = ~«Спасибо за информацию. Прощай».~
@12767 = ~«Я понял. Что тут есть поблизости интересного?»~
@12768 = ~«Ясно. Тогда я хотел бы спросить о другом…»~
@12769 = ~«Ладно. Тогда прощай».~
@12770 = ~«Я хочу хорошо провести время».~
@12771 = ~«Я хочу хорошо провести время».~
@12772 = ~«Я ищу работу».~
@12773 = ~«Я ищу мужчину по имени Фарод».~
@12774 = ~«Я ищу дневник. Ничего такого не видел?»~
@12775 = ~«Забудь. У меня другие вопросы…»~
@12776 = ~«Неважно. Прощай».~
@12777 = ~«Не покажешь мне, где это?»~
@12778 = ~«Наименее опасные?»~
@12779 = ~«Спасибо. У меня другой вопрос».~
@12780 = ~«Наверное, прогуляюсь-ка я к одному из этих мест. Прощай».~
@12781 = ~«Но ты выглядишь вполне дружелюбным…»~
@12782 = ~«Пропасть?»~
@12783 = ~«Пропасть?»~
@12784 = ~«У меня другие вопросы…»~
@12785 = ~«Спасибо за информацию. Прощай».~
@12786 = ~«Во Внешних Землях?»~
@12787 = ~«Странно. Я хочу ещё спросить…»~
@12788 = ~«Пожалуй, я понял. Прощай».~
@12789 = ~«Продолжай…»~
@12790 = ~«Двери?»~
@12791 = ~«У меня другие вопросы…»~
@12792 = ~«Наверное, дослушаю в другой раз. Прощай».~
@12793 = ~«Да… продолжай…»~
@12794 = ~«У меня другие вопросы…»~
@12795 = ~«Наверное, дослушаю в другой раз. Прощай».~
@12796 = ~«Возможно. У меня ещё кое-какие вопросы…»~
@12797 = ~«Интересная теория, я подумаю об этом. Прощай».~
@12798 = ~«Хорошо, продолжай».~
@12799 = ~«Потом дорасскажешь, ответь сперва на другой вопрос…»~
@12800 = ~«Наверное, дослушаю в другой раз. Прощай».~
@12801 = ~«Сборщики?»~
@12802 = ~«Кто-то платит за дохлых крыс?»~
@12803 = ~«Мозговые паразиты?»~
@12804 = ~«Ясно. Я хочу спросить о другом…»~
@12805 = ~«Хорошо. Прощай».~
@12806 = ~«Пропасть?»~
@12807 = ~«Пропасть?»~
@12808 = ~«Что ты там говорил о тех, кто платят за дохлых крыс?»~
@12809 = ~«Интересно. Я хочу спросить о другом…»~
@12810 = ~«Хорошо. Прощай».~
@12811 = ~«У меня другие вопросы…»~
@12812 = ~«Понятно. Прощай, Криден».~
@12813 = ~«Тогда у меня другие вопросы».~
@12814 = ~«Тогда я пойду. Прощай».~
@12815 = ~«Долгая история… мне просто нужно его найти».~
@12816 = ~«Тебя это не касается, крысолов».~
@12817 = ~«Забудь, что я спрашивал. Я хочу спросить о другом…»~
@12818 = ~«Забудь, неважно. Прощай».~
@12819 = ~«Сборщики?»~
@12820 = ~«Где эта „Площадь Мусорщиков“?»~
@12821 = ~«Хорошо. У меня другие вопросы…»~
@12822 = ~«Спасибо за информацию. Прощай».~
@12823 = ~«Мне важно его найти… Прошу прощения за грубость. Не поможешь мне?»~
@12824 = ~«Тогда ладно. Может быть, ты ответишь на другой вопрос…»~
@12825 = ~«Да будет так. Прощай».~
@12826 = ~«У меня другие вопросы…»~
@12827 = ~«Тогда я продолжу поиски. Прощай».~
@12828 = ~«Спасибо. Ты что-то говорил об опасности?»~
@12829 = ~«Спасибо. Но у меня есть ещё вопросы…»~
@12830 = ~«Пожалуй, прогуляюсь-ка я к одному из этих мест. Прощай».~
@12831 = ~«Ясно… но ты выглядишь вполне дружелюбным…»~
@12832 = ~«Я понял. Ещё вопрос…»~
@12833 = ~«Ясно. Это всё, что я хотел узнать. Прощай».~
@12834 = ~«Ясно. Что ты говорил о тех, кто платят за дохлых крыс?»~
@12835 = ~«Я понял. Хочу спросить о другом…»~
@12836 = ~«Ладно. Прощай».~
@12837 = ~«Спасибо. Ты упомянул Сборщиков?»~
@12838 = ~«Спасибо тебе. У меня другие вопросы…»~
@12839 = ~«Спасибо за информацию. Прощай».~
@12840 = ~«Почему нет?»~
@12841 = ~«Да я скорее свой язык съем».~
@12842 = ~«Нет, спасибо. Прощай».~
@12843 = ~«Почему бы и нет… что есть в наличии?»~
@12844 = ~«Да я скорее свой язык съем».~
@12845 = ~«Нет, не сегодня. Но я хотел спросить…»~
@12846 = ~«Нет, спасибо. Прощай».~
@12847 = ~«Почему бы и нет… что есть в наличии?»~
@12848 = ~«Просто я их не люблю, крысолов».~
@12849 = ~«Нет, не сегодня. Но я хотел спросить…»~
@12850 = ~«Нет, спасибо. Прощай».~
@12851 = ~«Где эта „Площадь Мусорщиков“?»~
@12852 = ~«Спасибо. Я хотел спросить о другом…»~
@12853 = ~«Это всё, что я хотел узнать. Прощай».~
@12854 = ~«Морте, у тебя есть объяснение?»~
@12855 = ~«Что такое „мимир“?»~
@12856 = ~«Забудь о нём… ты можешь мне ответить?»~
@12857 = ~«Нет, Морте… давай послушаем, что ты можешь мне поведать».~
@12858 = ~«Секундочку… что такое „мимир“?»~
@12859 = ~Повернуться обратно к крысолову.~
@12860 = ~«Хорошо».~
@12861 = ~«Нет, я услышал достаточно. Прощай, крысолов».~
@12862 = ~«Хорошо».~
@12863 = ~«Неважно. Пошли… прощай, крысолов».~
@12864 = ~«Но ты выглядишь вполне дружелюбным, крысолов…»~
@12865 = ~«Я понял. Ещё вопрос…»~
@12866 = ~«Спасибо за информацию. Прощай».~
@12867 = ~«А… что ты говорил о тех, кто платят за дохлых крыс?»~
@12868 = ~«Ясно. Я хочу спросить о другом…»~
@12869 = ~«Я понял. Прощай».~
@12870 = ~«Сюда! Кто это? СТРАЖА! ОН ЗДЕСЬ!»~
@12871 = ~Завершить.~
@12872 = ~«Я не опорочу себя разговорами с тобой! Вон отсюда!»~
@12873 = ~Уйти.~
@12874 = ~«Что этот мелкий подхалим рассказал тебе на этот раз? Уверен, он всё врёт».~
@12875 = ~«На самом деле я с ним пока не говорил. У меня ещё вопросы, и я хочу получить на них ответы».~
@12876 = ~«Он сказал мне, что это не подстава. На самом деле он сказал, что видел, как ты убил этого беднягу».~
@12877 = ~«Я всё ещё рассматриваю версию насчёт Анархистов».~
@12878 = ~«Говорит, он подкинул шило только потому, что хотел понадёжнее впутать тебя в это дело. Говорит, ты убийца, и он хочет быть уверенным, что тебя арестуют».~
@12879 = ~«Говорит, он подкинул шило только потому, что хотел понадёжнее впутать тебя в это дело. Говорит, ты убийца, и он хочет быть уверенным, что тебя арестуют».~
@12880 = ~«Я принял решение о том, кого следует обвинить».~
@12881 = ~«Пока не твоё дело. Мне нужно, чтобы ты ответил на кое-какие вопросов».~
@12882 = ~«Пока ничего. Прощай».~
@12883 = ~«Жалко беднягу Авилдона, правда жалко. Тем не менее. Он не заставлял себя работать без отдыха. Он не был *предан*. Так уж устроены планы, попомни мои слова… каждый толкач получает то, что заслужил. Ах да. Чем старый Тильдон может тебе помочь?»~
@12884 = ~«Сарос — ты помнишь Сароса, не так ли? — дал мне шило, найденное возле тела. Странно, но на шиле выбито твоё имя. Как ты это объяснишь?»~
@12885 = ~«Я бы хотел задать кое-какие вопросы».~
@12886 = ~«Сейчас ничем. Прощай».~
@12887 = ~«Уж поверь мне на слово, пень, и не только! У тебя в руках опасный преступник, и ты должен обеспечить, чтобы он больше никого не убил. За работу!»~
@12888 = ~«Тильдон, я сказал, что мне нужны ответы на вопросы. Уж потрудись ответить».~
@12889 = ~«У меня всё под контролем. Не волнуйся. Прощай».~
@12890 = ~«Он ЧТО? Говорю же тебе, что этот парень — вор и убийца, а ты мне не веришь? А если я тебе скажу, что парень к тому же из Анархистов, член Революционной Лиги?»~
@12891 = ~«Почему я должен этому верить?»~
@12892 = ~Ложь: «Если бы это было правдой, я бы передал его в руки правосудия».~
@12893 = ~Правда: «Если бы это было правдой, я бы передал его в руки правосудия».~
@12894 = ~«Откровенно говоря, мне почти всё равно. Полагаю, я услышал достаточно, чтобы убедиться: преступник — ты».~
@12895 = ~На его лице появляется прям-таки святое выражение. «Потому что я так говорю. Потому что я хочу сказать кое-что, за что меня можно привлечь к суду, но я всё равно это скажу ради свершения правосудия, — он выдерживает паузу. — Я знаю, что он из Анархистов, потому что он пытался завербовать и меня. Он и та инженерша Бедай-Лин. Я хотел было согласиться, чтобы поймать их, но потом понял, что не могу причинить вред бедняге Саросу. Я отказал им, и теперь они пытаются замести следы. Потому и хотят устранить меня. Это они убийцы. Не я».~
@12896 = ~«Предположим, что я поверю, но почему бы мне не посадить и тебя за компанию?»~
@12897 = ~«Предположим. Я проверю. Сначала ответь на другой вопрос».~
@12898 = ~«Ладно. Я проверю это прямо сейчас. Никуда не уходи, Тильдон. Прощай».~
@12899 = ~«Да, это правда! Клянусь праведными глазами моей бедной покойной матушки. Он и та инженерша, Бедай-Лин, пытались меня завербовать. Я было сказал им, что вступлю в их ряды, потому что хотел разоблачить предателей. Это мой долг перед фракцией. Но потом, ну, потом я решил, что это будет для меня просто нечестно. И тогда они решили, что лучше мне болтаться на столбе».~
@12900 = ~«Интересно. Хотя абсолютно невероятно. Слишком уж всё притянуто за уши. Полагаю, мне следует просто доложить на тебя».~
@12901 = ~«Ясно. Я проверю. Ответь на другой вопрос, Тильдон».~
@12902 = ~«Я проверю. Спасибо за подсказку».~
@12903 = ~«Что? Ты обвиняешь МЕНЯ? Но я ничего не делал! Пень, я не тот человек, который тебе нужен! Пожалуйста! Я этого не делал!»~
@12904 = ~«Я просто чуток разыграл тебя, Тильдон. Расслабься. У меня ещё кое-какие вопросы».~
@12905 = ~«Я пошутил, Тильдон. Прощай».~
@12906 = ~«Все улики указывают на тебя, Тильдон. В следующий раз встретимся во время твоей казни. Прощай».~
@12907 = ~«Всё ещё рассматриваешь? Не слишком-то хороший из тебя следователь. Даже не знаю, почему я стараюсь тебе помочь, если ты даже не проверяешь информацию, которую получил от меня…»~
@12908 = ~«Завязывай с притворной добродетелью, Тильдон. Я хочу услышать твои ответы на вопросы».~
@12909 = ~«Я услышал от тебя всё, что хотел. Прощай».~
@12910 = ~С лица смотрителя пропадает вся краска. «Он… что… он… я… он признался, что он Анархист?»~
@12911 = ~«Да. Похоже, он считает, что ты опасен для всех окружающих, будь то Анархисты или Боготы, и что тебя кто-то должен остановить. Он готов признаться в своих собственных преступлениях, лишь бы тебя настигла карающая рука правосудия».~
@12912 = ~«Да. А ты убийца. Твои действия выдали тебя».~
@12913 = ~«Он… он признался? Тогда ты должен арестовать его! Разве ты не видишь, что он несёт в себе угрозу? Как ты можешь верить вору и вруну, у которого очевидно нет никаких моральных устоев? Схвати его и закончи с этим делом!»~
@12914 = ~«Видишь ли, Тильдон, он явно готов принять наказание, если ты его разделишь. Всё, что я о нём слышал, говорит, что он вовсе не плохой человек — и если он согласен принять наказание, лишь бы ты получил своё, значит, ты это и вправду заслужил».~
@12915 = ~«По-моему, тут что-то не так. Зачем бы ему это делать?»~
@12916 = ~«Здесь не ты отдаёшь приказы, Тильдон. Запомни это. А теперь отвечай на мои вопросы».~
@12917 = ~«Не дави на меня, Тильдон. Ты ходишь по тонкому льду. Всего хорошего».~
@12918 = ~«Чтобы способствовать осуществлению планов Анархистов, пень! — он понижает голос и недобро глядит на тебя в упор. — Эти Анархисты, видишь ли, все фанатики и не терпят таких, как я, которые хотят их разоблачить. Они принесут в жертву кого угодно для своих целей». Он выпрямляется и вещает: «Пришло время честным людям, подобным мне, вывести этих козлов на чистую воду».~
@12919 = ~«И правда, Тильдон. Сарос молод, а молодёжь склонна делать ошибки. Я сильно сомневаюсь, что он оговорил себя просто для того, чтобы выгородить людей, которые ввергли его в такую заваруху. Преданность — штука хорошая, но он достаточно умён, чтобы различить подставу. Нет, Тильдон, я думаю, что преступник — ты».~
@12920 = ~«Кажется, здесь что-то не так, но не знаю, что именно».~
@12921 = ~«Честным? Хорошо. У меня другие вопросы».~
@12922 = ~«Какая у тебя благородная цель. Прощай, Тильдон».~
@12923 = ~«Вот что здесь не так: ты своей тупой башкой не можешь и представить себе козни этих подонков! Вынь наконец голову из задницы, дурень, и избавься от этого маленького ублюдка!» На мгновение он выглядит ошеломлённым, видимо, осознав, что он произнёс и кому, и быстро добавляет: «Э-э. Прошу прощения. Это всё от нервов. Не так-то просто быть подозреваемым сразу в убийстве и в принадлежности к Анархистам».~
@12924 = ~«Уверен, что-то не так. Я всё тщательно проверю. У меня другие вопросы».~
@12925 = ~«Я уверен, что-то не так. Прощай».~
@12926 = ~Его мясистая физиономия наливается кровью: «Ты обвиняешь МЕНЯ? Но я не убивал! Я просто пытался разоблачить Анархистов, пень! Да будь ты проклят, ты не можешь поступить так со мной! Не можешь верить всем, кто заявляет, что видел, как я это делаю, и не можешь утверждать, что я это сделал!»~
@12927 = ~«И ты берёшься это повторить под присягой и под заклинанием? Спорим, что Сарос на это согласится».~
@12928 = ~«Саросу скорее поверят. Его доводы более убедительны, и его вовсе не ненавидят так, как тебя. Готов поспорить, что он говорит правду, и потому я иду к Келдору».~
@12929 = ~«Я выдам вас обоих. Как тебе такое? Прощай, Тильдон. Больше мы не увидимся».~
@12930 = ~«На самом деле я могу утверждать всё что захочу. Прощай, Тильдон».~
@12931 = ~«Я это тщательно и всесторонне обдумаю. А пока наслаждайся жизнью, Тильдон. Прощай».~
@12932 = ~«Сволочь. Могу я хотя бы забрать своё барахло и сделать этому месту ручкой? Старый Тильдон обещает, что ты не пожалеешь».~
@12933 = ~«Конечно. Иди».~
@12934 = ~«Только если ты успеешь смыться до того, как я расскажу обо всём Келдору. Не думаю, что твои шансы так уж высоки».~
@12935 = ~«Нет. Оставайся здесь, или будет ещё хуже. Не сомневайся, уж я прослежу. Всего хорошего, Тильдон».~
@12936 = ~«Ухожу, ухожу. Больше ты меня не увидишь и не услышишь».~
@12937 = ~«Убирайся, пока я не передумал».~
@12938 = ~«Я передумал. Вскоре ты познакомишься с палачом. Прощай, Тильдон».~
@12939 = ~«Тебе нужны ответы? Какие?»~
@12940 = ~«Кто ты?»~
@12941 = ~«Расскажи мне о Боготах».~
@12942 = ~«Что ты делал в ночь убийства?»~
@12943 = ~«Мне нужно поработать в кузнице. Не выдашь мне руду?»~
@12944 = ~«Мне нужно поработать в кузнице. Не выдашь мне руду?»~
@12945 = ~«Мне нужно поработать в кузнице. Не выдашь мне руду?»~
@12946 = ~«Мне нужно поработать в кузнице. Не выдашь мне руду?»~
@12947 = ~«Мне нужно поработать в кузнице. Не выдашь мне руду?»~
@12948 = ~«Мне нужно поработать в кузнице. Не выдашь мне руду?»~
@12949 = ~«Никакие. Прощай».~
@12950 = ~«Кого ты обвинишь?» — он выглядит странно возбуждённым.~
@12951 = ~«Я собираюсь обвинить в убийстве Сароса».~
@12952 = ~«Я обвиняю тебя и Сароса».~
@12953 = ~«Я скажу Келдору, что убийца — ты».~
@12954 = ~«Пока никого. Я хотел спросить о другом…»~
@12955 = ~«Пока не скажу. Прощай».~
@12956 = ~«Тильдон Серый, смотритель этого цеха. Моя работа в том, чтобы мои рабочие занимались своим делом — и чтобы всякие вроде тебя им не мешали. Они работают без должного усердия, засранцы мелкие, и если бы меня не было, они бы бездельничали весь остаток дня. Я суров… но справедлив. Спроси кого угодно».~
@12957 = ~«Почему тебя называют „Серый“?»~
@12958 = ~«Тогда это к тебе я должен обратиться, чтобы получить железную руду для кузницы…»~
@12959 = ~«Тогда это к тебе я должен обратиться, чтобы получить железную руду для кузницы…»~
@12960 = ~«Тогда это к тебе я должен обратиться, чтобы получить железную руду для кузницы…»~
@12961 = ~«Тогда это к тебе я должен обратиться, чтобы получить железную руду для кузницы…»~
@12962 = ~«Тогда это к тебе я должен обратиться, чтобы получить железную руду для кузницы…»~
@12963 = ~«Тогда это к тебе я должен обратиться, чтобы получить железную руду для кузницы…»~
@12964 = ~«Наверно, так и сделаю. У меня другие вопросы…»~
@12965 = ~«Наверно, так и сделаю. Прощай».~
@12966 = ~«Потому что я постоянно в пепле от этих топок. Так меня прозвали мои рабочие… от любви, наверняка».~
@12967 = ~«Она… мертва».~
@12968 = ~Саркастически: «Наверняка. Они так уважают твоё доброе сердце».~
@12969 = ~Серьёзно: «Наверняка».~
@12970 = ~«Конечно. Так и должно быть».~
@12971 = ~«Ясно. У меня другие вопросы…»~
@12972 = ~«Ясно. Прощай».~
@12973 = ~«Ты подозреваешь, что я не совсем справедлив к рабочим? Но я справедлив! Я им как отец родной!»~
@12974 = ~«И папаша регулярно порет большинство детишек…»~
@12975 = ~«Я просто предположил, что ты порой можешь быть ЧЕРЕСЧУР справедлив, если понимаешь, о чём я».~
@12976 = ~«Ладно-ладно. У меня другие вопросы…»~
@12977 = ~«Конечно. Прощай».~
@12978 = ~От ярости его лицо наливается краской. В конце концов он берёт себя в руки и шипит: «Прочь с глаз моих, или я позову стражу!»~
@12979 = ~«Нет, пока я расследую это убийство, никого ты не позовёшь. А теперь ответь мне на другой вопрос».~
@12980 = ~«Просто ответь на пару вопросов…»~
@12981 = ~«Хорошо, я ухожу. Прощай».~
@12982 = ~Он кричит стражу: «СТРАЖА! Уберите эту развалину с глаз моих, чтоб ДУХУ ЕГО тут не было!»~
@12983 = ~«Ты пожалеешь об этом. Готовься к смерти, свинья».~
@12984 = ~«Ну и ладно. Прощай».~
@12985 = ~«Ты и правда так думаешь? Полагаешь, следовало бы больше думать о том, как держать их в узде? Ну, я так и сделаю. И очень вероятно, что это будет тот самый способ, который я уже применяю! А теперь убирайся».~
@12986 = ~«Сейчас не ты отдаёшь приказы, Тильдон. А теперь отвечай на мои вопросы».~
@12987 = ~«Просто ответь на пару вопросов…»~
@12988 = ~«Хорошо, я ухожу. Прощай».~
@12989 = ~«Это точно. От любви. Они знают, что в противном случае получат сполна».~
@12990 = ~«Хочешь сказать, кузнецы получают сполна?»~
@12991 = ~«Ясно. У меня другие вопросы…»~
@12992 = ~«Ясно. Прощай».~
@12993 = ~Он на миг бледнеет: «Это была просто фигура речи, не более. Я ничего не хотел сказать».~
@12994 = ~«Ладно. Ответь мне на другой вопрос».~
@12995 = ~«Посмотрим. Прощай».~
@12996 = ~«Что ты хочешь этим сказать?»~
@12997 = ~«Что я согласен с тобой».~
@12998 = ~«Я не верю, что они хоть капельку тебя любят».~
@12999 = ~«Я хочу сказать: заткнись, пень».~
@13000 = ~«Хорошо, хорошо. Мультивселенная была бы гораздо лучше, если бы каждый делал что положено. Теперь мне нужно вернуться к работе».~
@13001 = ~«Я хотел задать ещё пару вопросов…»~
@13002 = ~«Тогда прощай».~
@13003 = ~«Просто поверь, что тебе нужно верить, малыш. Я знаю своих рабочих. Им нужна твёрдая рука. Они уважают меня за это. Теперь сгинь с глаз моих».~
@13004 = ~«Сейчас не ты отдаёшь приказы, Тильдон. А теперь отвечай на мои вопросы».~
@13005 = ~«Просто ответь на кое-какие вопросы…»~
@13006 = ~«Ладно. Прощай».~
@13007 = ~«Они приняли меня и вырастили таким, каков я сейчас есть. И я должен быть им благодарен за это. Они развили мой природный талант до мастерства. Скажу тебе, что я — любимец управляющего. И когда-нибудь он всем покажет всю мою важность для нашей организации. Они говорят, что в каждом сокрыта божественность. По правде говоря, полагаю, что я ближе к ней, чем большинство других. Это даёт мне право действовать так, как если бы я был богом, и ожидать полного подчинения от моих работников. Я учусь использовать силу и двигать горы силой своей веры. Когда буду править космосом, бьюсь об заклад, я вспомню каждого из тех пней, которые становились у меня на пути».~
@13008 = ~«Это… интересно. У меня ещё вопросы…»~
@13009 = ~«Ясно. Прощай».~
@13010 = ~«Похоже, ты не наковался всласть, а? Ладно, держи, и закончим с этим, — он берёт с полки кусок железа и суёт тебе в руки. — Что-нибудь ещё, или я могу вернуться к надзору за этими неудачниками?»~
@13011 = ~«У меня ещё пара вопросов…»~
@13012 = ~«Возвращайся к работе. Прощай».~
@13013 = ~Он смотрит на тебя прищурившись: «Тебе нет в том нужды, вот всё, что я могу сказать. Исчезни, пень».~
@13014 = ~«Почему бы тебе не дать её мне? Тогда сможешь уйти сам, без лишних проблем со здоровьем».~
@13015 = ~«Почему бы тебе не дать её мне? Тогда сможешь уйти сам, без лишних проблем со здоровьем».~
@13016 = ~«Ладно, ладно. Тогда у меня другой вопрос…»~
@13017 = ~«Если по-другому никак, прощай».~
@13018 = ~Он оценивающе оглядывает тебя с ног до головы и говорит: «Хочешь стать кузнецом, а? Не могу сказать, что огонь сильно повредит такой коже, как твоя. Ну держи и не мешай моим рабочим. Всего хорошего, уважаемый».~
@13019 = ~«Тогда прощай».~
@13020 = ~«Похоже, Боготы в последнее время принимают во фракцию просто всех», — ворчит он. «Не так, как в старые добрые времена, когда от кандидатов требовалось продемонстрировать настоящие возможности. Тебе железо нужно для приёмного экзамена? Так бери и проваливай», — он вручает тебе кусок холодной руды.~
@13021 = ~«Спасибо. У меня другие вопросы…»~
@13022 = ~«Спасибо. Прощай».~
@13023 = ~Он смотрит на размер твоих рук, на твоё лицо и приходит к выводу, что ты серьёзен. «Не думай, что я тебе этого не припомню, пень», — говорит он, протягивая кусок руды, — но глазами с тобой встречаться избегает.~
@13024 = ~«Спасибо. У меня есть ещё вопросы…»~
@13025 = ~«Спасибо. Прощай».~
@13026 = ~Он смотрит на твои руки, оценивая их размеры, и глумливо ухмыляется: «Ты что, думаешь и меня так разукрасить? Исчезни, пень». Он отворачивается от тебя.~
@13027 = ~Напасть на него.~
@13028 = ~Уйти.~
@13029 = ~«Что я делал? Ну, я… я сидел в своей комнате с чудесным караваем хлеба и кувшином вина. Той ночью никуда не выходил. Не видел в том необходимости».~
@13030 = ~«Знаешь кого-нибудь, кто мог бы подтвердить это под присягой?»~
@13031 = ~«Ясно. Я хотел спросить о другом…»~
@13032 = ~«Ясно. Прощай».~
@13033 = ~«Нет. Никогда не видел необходимости даже задумываться об этом. Вот кого ты должен допросить, если действительно ищешь следы, — так это Сароса. Этот маленький вороватый дворянишка ходит везде, потому что у него папаша — один из местных шишек. Он всегда искал чего-то новенького — парень практически готовый Чующий, если тебе интересно моё мнение. Может, захотел кого-то убить и посмотреть, удастся ли выкрутиться».~
@13034 = ~«Сарос, да? Я запомню. А сейчас я хотел бы задать ещё вопрос…»~
@13035 = ~«Сарос, да? Пойду проверю. Прощай».~
@13036 = ~Он расплывается в широкой улыбке, обнажая гнилые зубы, и протягивает тебе руку для пожатия: «Ты сделал хороший выбор, друг, хороший. С нетерпением жду новой встречи».~
@13037 = ~«Кто бы сомневался. Прощай».~
@13038 = ~Гвоздичка выпрямляется и кладёт свои руки на бёдра: «Вернулся, а? Что надо на этот раз?»~
@13039 = ~«Я уверен, что ты убил кузнеца и пытаешься обвинить в своём преступлении Сароса. Ещё я уверен, что Сарос пытался указать на тебя незаконным образом и что он виновен в других преступлениях».~
@13040 = ~Гвоздичка выпрямляется и кладёт свои руки на бёдра. «Вернулся, а? Что надо на этот… — внезапно она замечает рядом с тобой Анну. — Ну, здоровяк… кто эта твоя новая подружка?»~
@13041 = ~«Я просто чуток разыграл тебя, Тильдон. Расслабься. У меня другие вопросы».~
@13042 = ~«Я пошутил, Тильдон. Прощай».~
@13043 = ~«Убил кузнеца Авилдона и попытался выставить виновным другого. Прощай».~
@13044 = ~«Что, опять ты?»~
@13045 = ~«Ответь на мои вопросы, Тильдон».~
@13046 = ~«Нет. Прощай».~
@13047 = ~Ты видишь мужика с плоским животом, толстыми руками и всклокоченной бородой. Несёт от него так, будто он годами не мылся, а от запаха изо рта так и тянет вернуть завтрак наружу. Он раздаёт приказы своим подчинённым, одному при этом заехав кулаком в ухо. Он поворачивается к тебе, заложив пальцы за пояс: «Чего надо?»~
@13048 = ~«У меня кое-какие вопросы…»~
@13049 = ~«Ничего. Прощай».~
@13050 = ~Гвоздичка выпрямляется и кладёт свои руки на бёдра. «Вернулся, а? — она смотрит мимо тебя, явно смутившись. — Скажи, здоровяк… где та миленькая девчушка, что ходила с тобой раньше?»~
@13051 = ~Гвоздичка выпрямляется и кладёт свои руки на бёдра. Увидев Анну, она широко улыбается: «Вернулась, а? Рада снова видеть твоё прелестное личико, девочка». Она поворачивается к тебе: «Что тебе надо, здоровяк?»~
@13052 = ~«И ты прощай, здоровяк».~
@13053 = ~Она выпрямляется, заслышав твоё приближение. Улыбается учтиво, но из её стойки и расположения руки близко к рукояти оружия видно, что к неприятностям она готова. Ты замечаешь, что один её глаз затянут бельмом. «Так достаточно близко, здоровяк… что тебе от меня надо?»~
@13054 = ~Она выпрямляется, заслышав твоё приближение. Её оружие в ножнах, но видно, что к неприятностям она готова. Ты замечаешь, что один её глаз затянут бельмом. Заметив Анну, она улыбается и кивает той в знак приветствия, и только потом поворачивается к тебе: «Так достаточно близко, здоровяк… что тебе от меня надо?»~
@13055 = ~Она кивает: «Тогда задавай».~
@13056 = ~Она вытаскивает из мешочка на ремне три гвоздя, подбрасывает в воздух и ловит в ладонь. «Гвоздичка, так меня зовут». Она кидает гвозди обратно в мешочек с приглушённым *клинк*.~
@13057 = ~Лицо Гвоздички ожесточается: «Не твоё дело, пень. Что, хочешь заполучить ещё один шрам в коллекцию?»~
@13058 = ~Она вращает глазами: «А ты как думаешь, на что это похоже, пень? Собираю гвозди!» Она осторожно смеётся, покачивая головой.~
@13059 = ~«Я продаю их мужчине, его зовут Хэмрис, в Нижнем районе. Гробовщик он».~
@13060 = ~Она пожимает плечами. «Из разных мест, полагаю. Иногда дабусы бросают тут хлам, а я просматриваю его, пока следующая группа не унесла. Вероятно, строительный мусор от зданий или стен, которые они возводят или рушат».~
@13061 = ~«Ага, дабусы, слуги Госпожи, — она смотрит на тебя удивлённо. — Ты, должно быть, новичок в Сигиле».~
@13062 = ~«Они работают по всему городу, выполняя волю Госпожи. Вечно строят и перестраивают, из того, что развалилось или разрушено, делают новое».~
@13063 = ~Гвоздичка хмурится. «О, нет, нет! Я не скажу о ней ничего больше того, что уже сказала… — она описывает рукой полукруг над сердцем. — Мой тебе совет, пень… не спрашивай о Госпоже».~
@13064 = ~«Тут мало что можно сказать… он немножко болтлив — будет греметь шкатулкой, пока у тебя крыша не поедет, если ему позволить, — но честный торговец. Ему нужны гвозди, мне нужны медяки, и всем хорошо».~
@13065 = ~«Э-э… когда-то я знала путь, но дабусы перестроили улицы вокруг. Не знаю, как туда теперь попасть — придётся разведывать новый путь — но думаю, со временем дабусы всё исправят».~
@13066 = ~Она ухмыляется и качает головой. «Никто не сообразил или не пытался это делать до меня, и я распугала всех, кто пытался потом опротестовать мои претензии», — она ласково похлопывает по длинному кинжалу, висящему на боку.~
@13067 = ~«Да, именно так! В Улье не так просто найти приличную работу, и я не собираюсь позволять какому-нибудь грёбаному говнюку отобрать у меня моё дело. Я многих отправила на фиг с соплями и воплями, некоторые несли кишки в руках… а некоторые, кому не повезло, отправились к Сборщикам, — её мёртвый глаз загорается безумным светом. — Улей знает, что не надо шутить с Гвоздичкой, ага».~
@13068 = ~Она от души смеётся: «Ага, а кроме того, у тебя вряд ли найдётся для него место!»~
@13069 = ~«Слушай, здоровяк, у меня прорва работы; пока я тут буду травить с тобой байки, гвозди ко мне сами в мешочек не попрыгают. Почему б тебе не выбрать для трёпа кого другого?»~
@13070 = ~Она кивает: «Ага, слыхала я это имя. Глава банды Сборщиков или типа того. Однако не скажу точно, где его можно найти. Попробуй глянь на Площади Мусорщиков; это к северо-западу отсюда. Целая куча Сборщиков валит туда на ночлег…»~
@13071 = ~«Нет, не видела, — она на миг замолкает. — Знаешь, а хорошая идея, этот… дневник. Может, мне стоит начать свой».~
@13072 = ~Она обдумывает твои слова. «Хе. Ты прав. Ты явно прав, здоровяк! Так и сделаю. Спасибо за совет», — она улыбается.~
@13073 = ~Гвоздичка выглядит искренне опечаленной. «Э… а… понятно. Это печально, печально. Обычное дело в Улье, надо сказать, — она трясёт головой, словно чтобы стряхнуть меланхолию. — Ну ладно, что тебе было надо?»~
@13074 = ~«О? — наконец она обращает своё внимание на тебя, нахмурившись. — Это слишком плохо. Так что тебе было надо?»~
@13075 = ~Она вытаскивает из мешочка на ремне три гвоздя, подбрасывает в воздух и ловит в ладонь. «Гвоздичка, так меня зовут». Она кидает гвозди обратно в мешочек с приглушённым *клинк*. Затем смотрит на Анну, чтобы проверить, видела ли та это представление. Поняв, что тифлинг уже отвернулась, Гвоздичка снова поворачивается к тебе.~
@13076 = ~Гвоздичка ошарашена этим замечанием, но быстро берёт себя в руки. Она улыбается тебе с ноткой печали: «Конечно, могу, здоровяк. Что ты ищешь?»~
@13077 = ~Гвоздичка чешет затылок: «Вообще-то в Улье только два вида работы… охотиться на мозговых крыс или собирать жмуриков».~
@13078 = ~«Да. Город Сигил платит награду за хвосты этих маленьких поганцев. Местная контора находится к югу отсюда; там сидит мужик, он тебе всё расскажет».~
@13079 = ~ «Пыльные платят медяки за жмуриков… это поддерживает улицы в чистоте и всё такое. Те пни, которые этим живут, называются Сборщиками… по мне, так помоечниками. А гвозди не воняют так, как жмурики», — она самодовольно ухмыляется.~
@13080 = ~«Ну, зависит от того, как любишь развлекаться. Пара хороших кабаков поблизости — это „Собиратели пыли“ и „Горящий труп“. Там довольно приличная публика, но, опять же, зависит от того, какую компанию предпочитаешь», — она мельком смотрит на Анну, но тифлинг не обращает на неё внимания.~
@13081 = ~«В Улье на каждом шагу разборки… а судя по твоему виду, ты поучаствовал в куче таких! Просто смотри с кем болтаешь, вот и всё, — она снова бросает на тебя оценивающий взгляд. — Я не сомневаюсь, ты можешь за себя постоять… и твоя милая подружка тоже круто выглядит». Гвоздичка выжидающе смотрит на Анну, но девушка ничего не отвечает.~
@13082 = ~Она кивает на Анну. «Твоя прекрасная подружка, по-моему, сама из Улья… её ты спрашивал?» — Гвоздичка улыбается тифлингу, хотя её больной глаз слегка портит впечатление.~
@13083 = ~Гвоздичка на секунду задумывается, почёсывая подбородок. «„Собиратели пыли“ — рядом с Мортуарием, на юго-запад от его главных ворот. А „Горящий труп“ — я сама туда захаживаю — на восток отсюда. Я бы сходила туда выпить с тобой, но работы по горло».~
@13084 = ~«Я могу говорить за себя, знаешь ли! Я Анна, если только это твоё собачье дело», — Анна скрещивает руки на груди со звуком *хмпф*. Гвоздичка только улыбается и обращает свой здоровый глаз снова на тебя.~
@13085 = ~«Я могу говорить за себя, знаешь ли! Я Анна, если только это твоё собачье дело. А что касается *этого* хама, — она бросает на тебя жгучий взгляд. — я покамест не уверена, друг ли он мне вообще!» Гвоздичка легко улыбается и обращает свой здоровый глаз снова на тебя.~
@13086 = ~Анна внезапно перестаёт бить хвостом и поворачивает голову в твою сторону, её глаза расширяются от удивления. Кажется, она собирается что-то сказать… и затем отворачивается, просто кивнув. Задняя часть её шеи багровеет, и тебе интересно, насколько покраснело её лицо.~
@13087 = ~Анна перестаёт бить хвостом. Она ничего не говорит, просто кивает.~
@13088 = ~Глаза Анны вспыхивают, как два зелёных огня, но она не говорит ни слова — просто хмурится.~
@13089 = ~Всё тело Анны на миг напрягается. Она ничего не говорит, но гнев на твои слова переполняет воздух вокруг. Ты уже ожидаешь худшего, но она хранит молчание, вознаградив тебя лишь презрительной усмешкой.~
@13090 = ~Анна наклоняет голову и хмурится на Гвоздичку: «Почему б вместо заботы обо мне и моих знаниях не ответить на вопросы этого человека?» В дополнение к сказанному она награждает Гвоздичку ухмылкой.~
@13091 = ~На мгновение он выглядит взволнованным, затем говорит: «Сарос — вор. Скорее всего, он это шило у меня и украл. На самом деле оно пропало за некоторое время до убийства, а я никогда не упоминал об этом, потому как думал, что оно просто потерялось. Теперь я знаю, Сарос украл его, чтобы меня подставить. Лучше схвати его, пока он тебе ручкой не сделал». Видя выражение на твоём лице, он добавляет: «Пока не сбежал».~
@13092 = ~«Как-то уж слишком гладко звучит. Я спрошу его об этом сразу после того, как ты ответишь ещё на пару вопросов…»~
@13093 = ~«Тогда я пойду разыщу его. Прощай».~
@13094 = ~«Приветствую…»~
@13095 = ~«Приветствую…»~
@13096 = ~Не мешать её работе.~
@13097 = ~«У меня кое-какие вопросы…»~
@13098 = ~«Ничего. Прощай».~
@13099 = ~~
@13100 = ~(auto link)~
@13101 = ~Ложь: «Я не уверен. У меня были вопросы…»~
@13102 = ~«Я не уверен. У меня были вопросы…»~
@13103 = ~Ложь: «Я не уверен. Прощай».~
@13104 = ~«Я не уверен. Прощай».~
