@50253 = ~«Хм… ясно. Дак'кон, можешь задать ему другой вопрос?»~
@50254 = ~«Хм… у меня есть ещё вопрос…»~
@50255 = ~«Хм… это всё, что я хотел узнать. Прощай».~
@50256 = ~«Можешь рассказать мне о Фелле?»~
@50257 = ~«Прощай».~
@50258 = ~«Просто хотел попрактиковаться в ребусах. Прощай».~
@50259 = ~Попытаться вступить в разговор и посмотреть, сможешь ли ты разобрать, о чём говорит дабус.~
@50260 = ~Попытаться заговорить с дабусом и посмотреть, сможешь ли ты понять его.~
@50261 = ~Ты задаёшь дабусу несколько вопросов, пытаясь разобраться в ребусах, появляющихся над его головой. Хотя во время всей «дискуссии» он проявляет исключительное терпение, у тебя ничего не получается. В конце концов дабус перестаёт играть символами и просто ждёт.~
@50262 = ~«Морте, можешь перевести мне, что он говорит?»~
@50263 = ~Морте усмехается: «Да я скорее повешусь на кишках танар'ри, чем разгадаю, что эти летающие козлиные головы пытаются втолковать. Тебе нужен переводчик? Найди коренного сигильца».~
@50264 = ~«Понятно».~
@50265 = ~«Морте, можешь перевести мне, что он говорит?»~
@50266 = ~Морте усмехается. «Да я скорее повешусь на кишках танар'ри, чем разгадаю, что эти летающие козлиные головы пытаются втолковать. Тебе нужен переводчик? Пускай эта девка-изверг переводит, — он кивает на Анну. — Она же местная, из Улья».~
@50267 = ~«Может, у меня получится…»~
@50268 = ~«Морте, можешь перевести мне, что он говорит?»~
@50269 = ~Морте усмехается. «Да я скорее повешусь на кишках танар'ри, чем разгадаю, что эти летающие козлиные головы пытаются втолковать. Тебе нужен переводчик? — он кивает в сторону Дак'кона. — Вот этот святее-тебя-и-вдвойне-молчаливее вполне справится».~
@50270 = ~«Может, у меня получится…»~
@50271 = ~«Морте, можешь перевести мне, что он говорит?»~
@50272 = ~Морте усмехается. «Да я скорее повешусь на кишках танар'ри, чем разгадаю, что эти летающие козлиные головы пытаются втолковать. Тебе нужен переводчик? Ну так танар'ри подойдёт, — он кивает в сторону Падшей Грейс. — Она наверняка спелась с этими парнями».~
@50273 = ~«Может, у меня получится…»~
@50274 = ~«Анна, можешь перевести мне, что он говорит?»~
@50275 = ~Она отвечает не сразу: «Ага… могу».~
@50276 = ~«А согласна?»~
@50277 = ~«А согласна?»~
@50278 = ~Анна качает головой: «Не, я не собираюсь потом из-за этого бродить в тени Госпожи, ну уж нет! Давай не будем терять время, ага? Так мы ничо не добьёмся, только взгляд Госпожи привлечём из-за лишнего трёпа с её роднёй».~
@50279 = ~«Понятно».~
