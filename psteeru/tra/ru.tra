@13106 = ~«Ничего. Прощай».~
@13107 = ~Уйти.~
@13108 = ~Уйти.~
@13109 = ~«У меня кое-какие вопросы…»~
@13110 = ~«Ничего, неважно. Прощай».~
@13111 = ~«У меня кое-какие вопросы…»~
@13112 = ~«Ничего, неважно. Прощай».~
@13113 = ~«Кто ты?»~
@13114 = ~«Кто ты?»~
@13115 = ~«Так кто ты?»~
@13116 = ~«Так кто ты?»~
@13117 = ~«Что ты делаешь?»~
@13118 = ~«Можешь рассказать мне об этом месте?»~
@13119 = ~«Можешь рассказать мне об этом месте?»~
@13120 = ~«Я ищу мужчину по имени Фарод».~
@13121 = ~«Я ищу свой потерянный дневник. Ты его не видела?»~
@13122 = ~«Неважно. Прощай».~
@13123 = ~«Зачем ты собираешь гвозди?»~
@13124 = ~«Что случилось с твоим глазом?»~
@13125 = ~«Рад познакомиться. У меня другие вопросы…»~
@13126 = ~«Подходящее имя. Прощай, Гвоздичка».~
@13127 = ~«Нет-нет. У меня другие вопросы…»~
@13128 = ~«Думаю, я вполне обойдусь и без этого».~
@13129 = ~«А ты рискнёшь добавить? Хотелось бы посмотреть, как у тебя получится…»~
@13130 = ~«Нет, не хочу. Прощай».~
@13131 = ~«Зачем?»~
@13132 = ~«Откуда все эти балки?»~
@13133 = ~«У меня другие вопросы».~
@13134 = ~«Это всё, что я хотел узнать. Прощай».~
@13135 = ~«Расскажи мне больше о Хэмрисе».~
@13136 = ~«Где находится Нижний район?»~
@13137 = ~«Кто-нибудь ещё собирает здесь гвозди?»~
@13138 = ~«Откуда все эти балки?»~
@13139 = ~«Это всё, что я хотел узнать. Прощай».~
@13140 = ~«Дабусы?»~
@13141 = ~«У меня другие вопросы».~
@13142 = ~«Это всё, что я хотел узнать. Прощай».~
@13143 = ~«Расскажи мне об этих дабусах».~
@13144 = ~«Госпожи?»~
@13145 = ~«У меня другие вопросы…»~
@13146 = ~«Это всё, что я хотел узнать. Прощай».~
@13147 = ~«Госпожи?»~
@13148 = ~«У меня другие вопросы».~
@13149 = ~«Это всё, что я хотел знать. Прощай».~
@13150 = ~«Хорошо. У меня другие вопросы…»~
@13151 = ~«Тогда прощай».~
@13152 = ~«Где находится Нижний район?»~
@13153 = ~«Кто-нибудь ещё собирает здесь гвозди?»~
@13154 = ~«У меня другие вопросы…»~
@13155 = ~«Это всё, что я хотел узнать. Прощай».~
@13156 = ~«Дабусы?»~
@13157 = ~«Расскажи мне больше о Хэмрисе».~
@13158 = ~«Кто-нибудь ещё собирает здесь гвозди?»~
@13159 = ~«Хм-м. У меня другие вопросы…»~
@13160 = ~«Возможно, лучше я спрошу направление у кого-нибудь другого. Прощай».~
@13161 = ~«Твои „претензии“?»~
@13162 = ~«Расскажи мне больше о Хэмрисе».~
@13163 = ~«Где находится Нижний район?»~
@13164 = ~«Ясно. У меня другие вопросы…»~
@13165 = ~«Хорошо. Тогда прощай».~
@13166 = ~«Это потому у тебя глаз такой?»~
@13167 = ~«Расскажи мне больше о Хэмрисе».~
@13168 = ~«Где находится Нижний район?»~
@13169 = ~«У меня другие вопросы…»~
@13170 = ~«Ясно. Тогда прощай».~
@13171 = ~«Хе… у меня ещё кое-какие вопросы».~
@13172 = ~«Наверное, ты права. Прощай».~
@13173 = ~«Ясно. У меня другие вопросы…»~
@13174 = ~«Тогда я поищу его там. Прощай».~
@13175 = ~«Я хочу задать вопрос о другом…»~
@13176 = ~«Возможно, так и сделаю. Прощай».~
@13177 = ~«Да, стоит. Просто удивительно, сколько мы забываем… а дневник помогает сохранить воспоминания».~
@13178 = ~«Может быть. У меня другие вопросы…»~
@13179 = ~«Может, и так. Прощай».~
@13180 = ~«Конечно. У меня другие вопросы…»~
@13181 = ~«Пустяки. Прощай».~
@13182 = ~«Как я уже сказал, у меня были вопросы…»~
@13183 = ~«Ничего, неважно. Прощай».~
@13184 = ~«Как я уже сказал, у меня были вопросы…»~
@13185 = ~«Ничего, неважно. Прощай».~
@13186 = ~«Зачем ты собираешь гвозди?»~
@13187 = ~«Как ты потеряла глаз?»~
@13188 = ~«Рад познакомиться. У меня другие вопросы…»~
@13189 = ~«Подходящее имя. Прощай, Гвоздичка».~
@13190 = ~«Я ищу работу».~
@13191 = ~«Я хотел бы поразвлечься».~
@13192 = ~«Должен ли я чего-нибудь здесь остерегаться?»~
@13193 = ~«Должен ли я чего-нибудь здесь остерегаться?»~
@13194 = ~«Я ищу мужчину по имени Фарод».~
@13195 = ~«Ничего, на самом деле. У меня вопросы о другом…»~
@13196 = ~«Охотится на мозговых крыс?»~
@13197 = ~«Собирать… жмуриков?»~
@13198 = ~«А если я захочу поразвлечься, куда мне идти?»~
@13199 = ~«Должен ли я чего-нибудь здесь остерегаться?»~
@13200 = ~«Должен ли я чего-нибудь здесь остерегаться?»~
