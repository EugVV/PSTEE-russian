@25557 = ~«Я ищу свой потерянный дневник».~
@25558 = ~«Что ты знаешь о Меббет?»~
@25559 = ~«Неважно. Прощай».~
@25560 = ~Отсыпать ему в ладонь десять медяков.~
@25561 = ~«Задавай свои вопросы. Чем смогу, помогу».~
@25562 = ~«Расскажи мне о Сборщиках».~
@25563 = ~«Я ищу мужчину по имени Фарод».~
@25564 = ~«Я ищу свой потерянный дневник».~
@25565 = ~«Что ты знаешь о Меббет?»~
@25566 = ~«Неважно. Прощай».~
@25567 = ~«Ты ничего не получишь и будешь отвечать на мои вопросы».~
@25568 = ~«Я ничего не знаю, толкач, поищи-ка ты ответы в другом месте».~
@25569 = ~Схватить его и хорошенько потрясти.~
@25570 = ~Дать ему пару медяков.~
@25571 = ~Бросить ему пять медяков.~
@25572 = ~Отсыпать ему в ладонь десять медяков.~
@25573 = ~«Тогда забудь. Прощай».~
@25574 = ~«Тогда забудь. Прощай».~
@25575 = ~Бросить ему пять медяков.~
@25576 = ~Отсыпать ему в ладонь десять медяков.~
@25577 = ~«Ты ничего не получишь и будешь отвечать на мои вопросы».~
@25578 = ~«Тогда забудь. Прощай».~
@25579 = ~«Расскажи мне о Сборщиках».~
@25580 = ~«Я ищу мужчину по имени Фарод».~
@25581 = ~«Я ищу свой потерянный дневник».~
@25582 = ~«Что ты знаешь о Меббет?»~
@25583 = ~«Неважно. Прощай».~
@25584 = ~«Нет. Это всё, что я хотел знать. Прощай».~
@25585 = ~«У меня пара вопросов…»~
@25586 = ~«Это всё, что я хотел узнать. Прощай».~
@25587 = ~«Что это за место?»~
@25588 = ~«У меня вопросы…»~
@25589 = ~«Это всё, что я хотел узнать. Прощай».~
@25590 = ~«Что это за место?»~
@25591 = ~«У меня вопросы…»~
@25592 = ~«Это всё, что я хотел узнать. Прощай».~
@25593 = ~«Что это за место?»~
@25594 = ~«У меня вопросы…»~
@25595 = ~«Ничего. Прощай».~
@25596 = ~Оставить его в покое.~
@25597 = ~Мужчина отступает, подозрительно глядя на тебя из-под капюшона: «Опять, да? Чё хотел?»~
@25598 = ~«Чем занимаешься?»~
@25599 = ~«Что это за место?»~
@25600 = ~«У меня пара вопросов…»~
@25601 = ~«Ничего. Прощай».~
@25602 = ~Люк вниз к Похороненной деревне~
@25603 = ~Ступеньки вверх к Мусорным трущобам~
@25604 = ~Дом швеи Марты~
@25605 = ~Ворота в катакомбы Плачущих Камней~
@25606 = ~Дом Оджо Кожеголового~
@25607 = ~Проход во двор Фарода~
@25608 = ~Портал в бункер Фарода~
@25609 = ~В склеп Объятых~
@25610 = ~В разрушенный склеп~
@25611 = ~В Дом Мысли~
@25612 = ~В катакомбы Мёртвых Народов~
@25613 = ~В мозаичный склеп~
@25614 = ~В разделённый склеп~
@25615 = ~Обратно в катакомбы Плачущих Камней~
@25616 = ~Люк в нижний зал~
@25617 = ~Лестница на верхний уровень разделённого склепа~
@25618 = ~В катакомбы Затопленных Народов~
@25619 = ~Покои Тухлой Мэри~
@25620 = ~Тенистый альков~
@25621 = ~Часовня~
@25622 = ~Покои Соэго~
@25623 = ~Прихожая тронного зала Безмолвного Короля~
@25624 = ~В логово Многих-как-Один~
@25625 = ~Назад к Дому Мысли~
@25626 = ~Обратно в катакомбы Мёртвых Народов~
@25627 = ~Запечатанный проход~
@25628 = ~«ВЗЯТЬ ЕГО!»~
@25629 = ~Портной~
@25630 = ~Бордель Безумной Интеллектуальной Страсти~
@25631 = ~В ПодСигил~
@25632 = ~Ты видишь получеловеческий-полукрысиный гибрид. Его красные глаза светятся коварством, а голос, исходящий из глотки, маслянистый и вкрадчивый: «Итак… двуногий добровольно явился в залы Многих-как-Один. Чего ты хочешь, человек, и куда собираешься пройти? Подойди медленно, нарушитель, и говори Мантуоку только правду».~
@25633 = ~Дом адвоката~
@25634 = ~«Нет, двуногий, не так быстро. Теперь ответь на мой вопрос: чего ты хочешь, двуногий, и куда направляешься?»~
@25635 = ~Галерея искусств и диковин~
@25636 = ~Магазинчик странностей~
@25637 = ~«А, деревня. Освежи мою память… мусорщики, да? Ты пришёл рыться в отбросах?»~
@25638 = ~«Ничего ценного, двуногий? Единственный отброс, который я вижу в нашем приличном доме, — это ТЫ. Боюсь, однако, придётся нам привыкать к вони — ты никогда не увидишь снова дневной свет».~
@25639 = ~«Тогда твой ответ заставляет Мантуока осведомиться: зачем ты здесь? Неправильный поворот, неверный шаг, последовательность ошибок, да? Пришёл искать меня или Многих-как-Один? А может, просто не знаешь, зачем ты здесь? Объясни мне это немедленно».~
@25640 = ~«Всего лишь последовательность ошибок, да? Тебе было бы намного лучше сделать одной ошибкой меньше и не находить дорогу сюда».~
@25641 = ~Аптека~
@25642 = ~«Передай своё сообщение мне, двуногий, и я доставлю его многим».~
@25643 = ~Фестхолл~
@25644 = ~Фойе Фестхолла~
@25645 = ~Мантуок наклоняется вперёд, поворачивая своё ухо к тебе.~
@25646 = ~Он фыркает: «Так ты говоришь. У тебя будет время пересмотреть этот ответ. Много времени». Он поднимает руки, с его пальцев струится дым.~
@25647 = ~«Ты действительно не знаешь, да? Ясно, что пришёл сюда по ошибке. Ты не уйдёшь», — он поднимает руки, с его пальцев струится дым.~
@25648 = ~Зал боевой тренировки~
@25649 = ~Зал воровской тренировки~
@25650 = ~Он задумывается. Его хвост хлещет по полу. Минуту он пристально смотрит на тебя. «Мои уши не ошиблись, ты сказал мне, что Безмолвный Король всего лишь блеф трупаков? Ага, вроде бы так, — он отворачивается ненадолго, а когда поворачивается, в его глазах горит торжество. — Трупы скоро взаправду будут лежать спокойно, а мы сгрызём их плоть для верности…» Внезапно он смотрит на тебя подозрительно: «…если это не обман. Ты поговоришь с Многими-как-Один, да?»~
@25651 = ~Зал магической тренировки~
@25652 = ~«Да. Запомни: они уже знают твои слова. Прощай. Мы ещё увидимся».~
@25653 = ~Коридор, ведущий в комнаты отдыха~
@25654 = ~Мантуок шипит: «Слишком силён, да? Ты видел доказательства его мощи? Тьфу! Многие-как-Один услышат об этом — когда ты скажешь Многим. Эти скверные новости сообщишь ему сам! Идём со мной».~
@25655 = ~«Это была не просьба», — он поднимает руки, с его пальцев струится дым. На мгновение всё заволакивает тьма.~
@25656 = ~«Пришёл повидать *меня*? И кто послал тебя с этим дурацким поручением?»~
@25657 = ~Он прерывается, будто бы оценивая тебя. «И почему бы священнику пыли и пепла не использовать обычные способы? Почему Соэго Крысоподобный не может использовать посланцев? Тьфу. Неважно. Передавай послание и покончим с этим».~
@25658 = ~Хвост крысы-оборотня яростно хлещет. «Хорошо же. Ты должен поговорить с Многими-как-Один. Не ври, двуногий, потому что Многие читают твои мысли так же, как слышат твой голос».~
@25659 = ~«Твой язык страдает раздвоением между ложью и лестью — признак мошенника. Говори прямо, да, или будешь страдать. Что у тебя за дело здесь, и что ты ищешь? Возможно, последовательность ошибок привела тебя к моей двери? Какое у тебя тут дело?»~
@25660 = ~«И зачем? Что у тебя за дело к Многим-как-Один?»~
@25661 = ~Он открывает рот с явным намерением выпустить поток ругательств, но внезапно его глаза становятся отсутствующими, а голова склоняется набок, как будто он выслушивает какое-то сообщение. Когда его глаза опять концентрируются на тебе, он плюёт: «Лучше бы твои новости стоили того, двуногий, иначе твои пытки будут легендарными».~
@25662 = ~«Я голос Многих-как-Один! Говори, зачем пожаловал! — его голос стихает и становится вкрадчивым. — Ты расскажешь мне, иначе у тебя будут… сложности, ясно?»~
@25663 = ~Мантуок даже подпрыгивает, затем шипит: «Мерзкий, мерзкий человечишка. Грозит Мантуоку. Не уважает Мантуока. Плюёт на его обязанности. Отпускает злые угрозы в адрес Мантуока. Сегодня ты не заимел друзей, человек. Иди к Многим-как-Один и говори своё сообщение».~
@25664 = ~~
@25665 = ~«Я уже ухожу».~
@25666 = ~«Я пришёл из Похороненной деревни, всего лишь для поисков».~
@25667 = ~«Пришёл повидать твоё милое личико».~
@25668 = ~«Куда и откуда я иду — не твоё дело».~
@25669 = ~«Что ты *такое*?»~
@25670 = ~«Я пришёл из Похороненной деревни, всего лишь для поисков».~
@25671 = ~«Куда и откуда я иду — не твоё дело».~
@25672 = ~«Что ты *такое*?»~
@25673 = ~«Я сказал, что уже ухожу. Прощай».~
@25674 = ~«Да, но в этой выгребной яме нет ничего ценного».~
@25675 = ~«Нет».~
@25676 = ~«Что ты имеешь в виду?»~
@25677 = ~«Ты мне угрожаешь?»~
@25678 = ~«Думаю, увижу».~
@25679 = ~«Просто последовательность ошибок».~
@25680 = ~«Я ищу Многих-как-Один».~
@25681 = ~«Кто такой Многие-как-Один?»~
@25682 = ~«Пришёл повидать твоё милое личико».~
@25683 = ~«У меня здесь нет особенных дел».~
@25684 = ~«Что ты имеешь в виду?»~
@25685 = ~«Тогда я исправлю ошибку и уйду…»~
@25686 = ~«Хорошо».~
@25687 = ~«Я так не думаю».~
@25688 = ~Напасть на него.~
@25689 = ~«Я не хочу обсуждать никакие дела».~
@25690 = ~«Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@25691 = ~«Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@25692 = ~«Безмолвный Король слишком силён, чтобы нападать на него. Лучше держаться подальше от Мёртвых Народов, иначе трупы вас уничтожат».~
@25693 = ~«Что за?..»~
@25694 = ~«Ты и правда такой невежественный, а? Тебе не уйти». Между его пальцами проскакивают маленькие молнии.~
@25695 = ~«Мы можем обсудить это…»~
@25696 = ~«Что ты делаешь?»~
@25697 = ~«О, теперь мне можно поговорить с Многими-как-Один?»~
@25698 = ~«Тогда прощай».~
@25699 = ~«Я так не думаю».~
@25700 = ~«Пошли».~
@25701 = ~«Что за?..»~
@25702 = ~«Соэго».~
@25703 = ~«Никто».~
@25704 = ~«Никто. Я просто предположил, что ты тут имеешь положение».~
@25705 = ~«Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@25706 = ~«Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@25707 = ~«Безмолвный Король слишком силён, чтобы нападать на него. Лучше держаться подальше от Мёртвых Народов, иначе трупы вас уничтожат».~
@25708 = ~«Он сказал мне говорить только с Многими-как-Один».~
@25709 = ~«Вообще-то у меня нет никакого послания».~
@25710 = ~«Буду иметь в виду».~
@25711 = ~«Просто последовательность ошибок».~
@25712 = ~«Я ищу Многих-как-Один».~
@25713 = ~«Кто такой Многие-как-Один?»~
@25714 = ~«У меня здесь нет особенных дел».~
@25715 = ~«Я принёс новости».~
@25716 = ~«Моё дело тебя не касается».~
@25717 = ~«Ничего особенного».~
@25718 = ~«Избавь меня от угроз. Я пошёл».~
@25719 = ~«Многие-как-Один заставят тебя пожалеть, если попытаешься навредить, Мантуок».~
@25720 = ~«У меня нет никаких особенных дел».~
@25721 = ~«Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@25722 = ~«Безмолвный Король — всего лишь мёртвый скелет. У него нет никакой силы».~
@25723 = ~«Безмолвный Король слишком силён, чтобы нападать на него. Лучше держаться подальше от Мёртвых Народов, иначе трупы вас уничтожат».~
@25724 = ~«Спасибо. Ты мне очень помог».~
@25725 = ~Западная лекционная аудитория~
@25726 = ~Восточная лекционная аудитория~
@25727 = ~Назад в фойе Фестхолла~
@25728 = ~Стол приёма~
@25729 = ~Твоя старая комната~
@25730 = ~Назад в район Клерков~
@25731 = ~Раздевалка~
@25732 = ~Задняя комната аптеки~
@25733 = ~«Приветствую…»~
@25734 = ~Оставить его в покое.~
@25735 = ~Он останавливается и окидывает тебя взглядом. Похоже, его несколько смущает твой внешний вид. «Я… э-э… знаю вас, сэр?»~
@25736 = ~«Нет, но у меня кое-какие вопросы…»~
@25737 = ~«Что-то не так в моей наружности?»~
@25738 = ~«Нет. Прощай».~
@25739 = ~«У меня нет времени, сэр… дела не терпят. Так что, если не возражаете…»~
@25740 = ~«Всего один вопросик?»~
@25741 = ~«Всего один вопросик?»~
@25742 = ~«Возражаю. Теперь отвечай на мои вопросы…»~
@25743 = ~«Тогда прощай».~
@25744 = ~Он закусывает губу, затем кивает: «Хорошо, не буду отказывать. Но побыстрее, прошу!»~
@25745 = ~«Что это за место?»~
@25746 = ~«Что здесь интересного?»~
@25747 = ~«Где-нибудь здесь можно найти работу?»~
@25748 = ~«Как пройти…»~
@25749 = ~«Что ты знаешь о Рейвел Клубок-Загадок?»~
@25750 = ~«Не бери в голову. Прощай».~
@25751 = ~Он странно на тебя смотрит: «Это же район Клерков. Вы что… потерялись? А, неважно. Мне пора идти! Прощайте…»~
@25752 = ~«Погоди… у меня были ещё вопросы…»~
@25753 = ~«Прощай».~
@25754 = ~«У меня нет времени даже на один вопрос, сэр. Возможно, у людей в уличных кафе времени будет побольше. Теперь прощайте…»~
@25755 = ~«Стой. Ты будешь стоять здесь и отвечать на мои вопросы».~
@25756 = ~«Тогда прощай».~
@25757 = ~«Сэр! У меня нет ни времени, ни желания подвергаться вашим нападкам! Оставьте меня, иначе я буду вынужден звать на помощь!»~
@25758 = ~«Не сомневаюсь, она прибудет вовремя — ты ещё остыть не успеешь».~
@25759 = ~«На твоём месте я бы не стал никого звать».~
@25760 = ~«Извини. Прощай».~
@25761 = ~«Тогда прощай».~
@25762 = ~Он пятится с криком: «Стража! Стража!»~
@25763 = ~Напасть на него.~
@25764 = ~Убежать, пока не поздно.~
@25765 = ~«В районе Клерков есть на что посмотреть, сэр… а больше всего — в этом квартале! Общественный Фестхолл, конечно, галерея искусств и диковин, Бордель Безумной Интеллектуальной Страсти…» — он улыбается, погружённый в приятные воспоминания.~
@25766 = ~«Что-нибудь ещё?»~
@25767 = ~На мгновение он задумывается. «Хм-м. Ну, тут есть портной, аптека и дом адвоката. О, и ещё катакомбы под районом. И магазинчик всяких странностей, — он пожимает плечами. — Вполне хватит занять кого угодно, полагаю. Наслаждайтесь и позвольте откланяться!»~
@25768 = ~«У меня вопрос об одном из упомянутых мест…»~
@25769 = ~«Я хочу спросить тебя о другом…»~
@25770 = ~«Спасибо. Прощай».~
@25771 = ~Он ненадолго задумывается. «Можете попробовать обратиться к аптекарю. Или адвокату. Или в Фестхолл… у них почти всегда найдётся случайная работа. Удачи, сэр… прощайте».~
@25772 = ~«У меня вопрос об одном из упомянутых мест…»~
@25773 = ~«Позволь мне спросить о другом…»~
@25774 = ~«Спасибо. Прощай».~
@25775 = ~«И что вы ищете?»~
@25776 = ~«Дом адвоката».~
@25777 = ~«Аптеку».~
@25778 = ~«Галерею искусств».~
@25779 = ~«Бордель, конечно!»~
@25780 = ~«Катакомбы под районом».~
@25781 = ~«Фестхолл».~
@25782 = ~«Магазинчик странностей».~
@25783 = ~«Портного».~
@25784 = ~«Ничего, неважно. Прощай».~
@25785 = ~«Дом Янниса находится к югу от ворот в Нижний район — это откуда вы пришли, вероятно. Он на восточной стороне улицы».~
@25786 = ~«Спасибо. Можно ещё вопрос задать?»~
@25787 = ~«Ясно, спасибо. Прощай».~
@25788 = ~«Идите по дороге на восток от ворот в Нижний район — это откуда вы, похоже, сюда пришли. Когда дорога разделится на две, одна ведёт на северо-восток, а другая на юго-восток, держитесь южнее, и на восточной стороне дороги она как раз и будет стоять. Лицом здание смотрит на юг, в нём три окна с витражами».~
@25789 = ~«Спасибо. Можно ещё вопрос задать?»~
@25790 = ~«Ясно, спасибо. Прощай».~
@25791 = ~«Идите по дороге на восток от ворот в Нижний район — это откуда вы, похоже, сюда пришли. Когда дорога разделится на две, одна ведёт на северо-восток, а другая на юго-восток, держитесь южнее и найдёте здание на западной стороне дороги, фасад его обращён к югу, а крыша покрыта черепицей».~
@25792 = ~«Спасибо. Можно ещё вопрос задать?»~
@25793 = ~«Ясно, спасибо. Прощай».~
@25794 = ~«А, Бордель Безумной Интеллектуальной Страсти? — он понимающе улыбается. — Он к востоку от ворот в Нижний район — это откуда вы, похоже, сюда пришли. Большое круглое здание, вход которого обращён к югу».~
@25795 = ~«Спасибо. Можно ещё вопрос задать?»~
@25796 = ~«Ясно, спасибо. Прощай».~
@25797 = ~Он хмурится: «Хм. Здесь явно больше одного входа, я хорошо знаю… ладно, не очень хорошо. Но должен предупредить, никто не выходит оттуда… и никто из тех, кто входит».~
@25798 = ~«Спасибо. Можно ещё вопрос задать?»~
@25799 = ~«Ясно, спасибо. Прощай».~
@25800 = ~«Фестхолл очень просто найти, сэр. Огромное здание в северо-восточной части этого района».~
@25801 = ~«Спасибо. Можно ещё вопрос задать?»~
@25802 = ~«Ясно, спасибо. Прощай».~
@25803 = ~«Сам я там никогда не был, но мне показывали, где он расположен. Это необычное здание в южной части района, к нему наверх ведёт широкая лестница. Мимо не пройдёте».~
@25804 = ~«Спасибо. Можно ещё вопрос задать?»~
@25805 = ~«Ясно. Спасибо вам. Прощай».~
@25806 = ~«Вы найдёте магазинчик портного Гонкальвеса к северо-востоку от ворот в Нижний район — это откуда вы, похоже, сюда пришли. Это широкое здание, его вход смотрит на юг».~
@25807 = ~«Спасибо. Можно ещё вопрос задать?»~
@25808 = ~«Ясно, спасибо. Прощай».~
@25809 = ~Он качает головой: «Поищите собеседников в уличном кафе — там много досужего люда… А теперь прощайте…»~
@25810 = ~«Стой. Ты будешь стоять здесь и отвечать на мои вопросы».~
@25811 = ~«Тогда прощай».~
@25812 = ~«А? — на мгновение он выглядит смущённым… потом его глаза загораются, похоже, он что-то вспомил. — А! Ночная ведьма, да? Помню, мне рассказывали сказки про неё, в детстве…»~
@25813 = ~«Сказки?»~
@25814 = ~«Ясно. Позволь задать вопрос о другом…»~
@25815 = ~«Спасибо, это всё, что я хотел знать. Прощай».~
@25816 = ~Он кивает. «Да. Но она же миф, так? Ведьма, которая пыталась разрушить Сигил? — неожиданно он хмурится. — Мне определённо пора, сэр… прощайте».~
@25817 = ~«Погоди, у меня был ещё вопрос…»~
@25818 = ~«Спасибо. Прощай».~
@25819 = ~«Нет, сэр, вовсе нет! — мужчина нервно хихикает. — Ну… хм…» Он показывает на твой голый торс, покрытый шрамами: «Вы, прямо скажем, выглядите малость свирепо для обычного местного жителя, нет?.. Не обижайтесь, сэр…»~
@25820 = ~«Не обижаюсь. Но у меня были некоторые вопросы…»~
@25821 = ~«Мне больше ничего не нужно. Прощай».~
@25822 = ~«Рад новой встрече, сэр. А теперь прошу меня извинить, мне пора бежать. Прощайте…»~
@25823 = ~«Погоди. У меня вопросы…»~
@25824 = ~«Прощай».~
@25825 = ~«Как уже сказал, сэр, я жутко спешу. Может быть, вы найдёте собеседника в одном из уличных кафе. Теперь прощайте…»~
@25826 = ~«Стой. Ты будешь стоять здесь и отвечать на мои вопросы».~
@25827 = ~«Тогда прощай».~
@25828 = ~«С-с-с… какая тос-с-ска…»~
@25829 = ~«Новые дома, логова… новое мяс-с-со…»~
@25830 = ~«Держ-жите глаз-за… открытыми».~
@25831 = ~«Будьте ос-с-сторожны, упыри…»~
@25832 = ~::Рык::~
@25833 = ~«Что охраняет это с-сущес-ство? Пос-смотри».~
@25834 = ~Кто-то умер~
@25835 = ~Это проверка~
@25836 = ~«Дас-с-с…»~
@25837 = ~«Ты… ис-с-спугалс-ся? Ха-ха!»~
@25838 = ~«Вперёд! Дос-стать тварь!»~
@25839 = ~«Я попробую. Она… быс-страя».~
@25840 = ~«Ха-ха! Трус-с!»~
@25841 = ~«Тупое ж-животное».~
@25842 = ~Эта опрятная, хорошо одетая женщина явно идёт по делам.~
@25843 = ~«Приветствую…»~
@25844 = ~Женщина останавливается, смотрит на тебя, и её глаза на миг округляются. Она оглядывается в поисках, не обращаешься ли ты к кому-нибудь ещё, затем неловко улыбается: «Простите меня, но… разве мы знакомы?»~
@25845 = ~«Нет, но у меня кое-какие вопросы…»~
@25846 = ~«Я иду по делу и крайне ограничена во времени, — она пятится. — Так что, если вы не возражаете…»~
@25847 = ~«Всего один вопросик?»~
@25848 = ~Она закусывает губу, затем кивает: «Хорошо, сэр. Но спрашивайте быстро… время — основа всего!»~
@25849 = ~«Что это за место?»~
@25850 = ~От удивления она округляет глаза: «Район Клерков, сэр… вы что, потерялись? О, неважно. Мне пора идти! Прощайте…»~
@25851 = ~«Погоди… у меня были ещё вопросы…»~
@25852 = ~«Сэр, я давала согласие только на один вопрос. Не будете ли вы так добры, чтобы отнестись к этому с уважением и позволить мне идти по своим делам? Возможно, у людей в кафе найдётся больше времени на ваши вопросы».~
@25853 = ~«Стой. Ты будешь стоять здесь и отвечать на мои вопросы».~
@25854 = ~Её глаза сужаются: «Ваши грубые манеры и пугающий вид могут хорошо служить там, откуда вы свалились, но у нас, в порядочной части Сигила, есть закон. Теперь оставьте меня, „сэр“, иначе я буду вынуждена звать на помощь!»~
@25855 = ~«Не сомневаюсь, она прибудет вовремя — ты ещё остыть не успеешь».~
@25856 = ~Она пятится с криком: «Стража! Стража!»~
@25857 = ~Напасть на неё.~
@25858 = ~Убежать, пока не поздно.~
@25859 = ~«На твоём месте я бы не стал никого звать».~
@25860 = ~«Извини. Прощай».~
@25861 = ~«Тогда прощай».~
@25862 = ~«Тогда прощай».~
@25863 = ~«Прощай».~
@25864 = ~«Что здесь интересного?»~
@25865 = ~«Многое, сэр! Особенно здесь, в этой части района Клерков, где Общественный Фестхолл. А также галерея искусств и диковин».~
@25866 = ~«Что-нибудь ещё?»~
@25867 = ~На мгновение она задумывается. «Хм-м. Ну, тут есть портной Гонкальвес, аптека, дом адвоката и этот бордель „Безумной Интеллектуальной Страсти“. А, ещё катакомбы под районом… и да, магазинчик всяких странностей».~
@25868 = ~«У меня вопрос об одном из мест, которые ты упомянула…»~
@25869 = ~«Позволь мне спросить о другом…»~
@25870 = ~«Спасибо. Прощай».~
@25871 = ~«Где-нибудь здесь можно найти работу?»~
@25872 = ~Она ненадолго задумывается. «Можете попробовать обратиться в Фестхолл… у них почти наверняка найдутся предложения. А ещё можете поговорить с адвокатом или, возможно, с аптекарем. А я лучше пойду… прощайте».~
@25873 = ~«У меня вопрос об одном из мест, которые ты упомянула…»~
@25874 = ~«Позволь мне спросить о другом…»~
@25875 = ~«Спасибо. Прощай».~
@25876 = ~«Как пройти…»~
@25877 = ~«Что вы ищете, сэр?»~
@25878 = ~«Дом адвоката».~
@25879 = ~«Дом Янниса к югу от ворот в Нижний район — это откуда вы пришли, вероятно. Он на восточной стороне улицы».~
@25880 = ~«Спасибо. Можно ещё вопрос задать?»~
@25881 = ~«Ясно, спасибо. Прощай».~
@25882 = ~«Аптеку».~
@25883 = ~«Идите по дороге на восток от ворот в Нижний район — это откуда вы, похоже, пришли сюда. Когда дорога разделится на две, одна ведёт на северо-восток, а другая на юго-восток, держитесь южнее, и на восточной стороне дороги она как раз и будет стоять. Лицом здание смотрит на юг, и там три окна с витражами».~
@25884 = ~«Спасибо. Можно ещё вопрос задать?»~
@25885 = ~«Ясно, спасибо. Прощай».~
@25886 = ~«Галерею искусств».~
@25887 = ~«Идите по дороге на восток от ворот в Нижний район — это откуда вы, похоже, пришли сюда. Когда дорога разделится на две, одна ведёт на северо-восток, а другая на юго-восток, держитесь южнее и обнаружите её на западной стороне дороги, фасад обращён к югу, а крыша покрыта черепицей».~
@25888 = ~«Спасибо. Можно ещё вопрос задать?»~
@25889 = ~«Ясно, спасибо. Прощай».~
@25890 = ~«Бордель, конечно!»~
@25891 = ~Она смотрит многозначительно и качает головой: «Он к востоку от ворот в Нижний район — это откуда вы, похоже, пришли сюда. Большое круглое здание, вход которого обращён к югу».~
@25892 = ~«Спасибо. Можно ещё вопрос задать?»~
@25893 = ~«Ясно, спасибо. Прощай».~
@25894 = ~«Катакомбы под районом».~
@25895 = ~Она хмурится: «Разве входы туда до сих пор открыты? Если так, они наверняка охраняются… говорят, эти катакомбы очень опасны. Я не скажу точно, как туда попасть, сэр».~
@25896 = ~«Спасибо. Можно ещё вопрос задать?»~
@25897 = ~«Ясно, спасибо. Прощай».~
@25898 = ~«Фестхолл».~
@25899 = ~«Фестхолл очень просто найти, сэр. Это огромное здание в северо-восточной части этого района».~
@25900 = ~«Спасибо. Можно ещё вопрос задать?»~
@25901 = ~«Ясно, спасибо. Прощай».~
@25902 = ~«Магазинчик странностей».~
@25903 = ~«Это в южной части района. Необычное здание, к нему наверх ведёт широкая лестница. Сама я там никогда не была… у меня от него странные чувства».~
@25904 = ~«Спасибо. Можно ещё вопрос задать?»~
@25905 = ~«Ясно. Спасибо вам. Прощай».~
@25906 = ~«Портного».~
@25907 = ~«Вы найдёте магазинчик портного Гонкальвеса к северо-востоку от ворот в Нижний район — это откуда вы, похоже, пришли сюда. Большое здание со входом на юге».~
@25908 = ~«Спасибо. Можно ещё вопрос задать?»~
@25909 = ~«Ясно, спасибо. Прощай».~
@25910 = ~«Ничего, неважно. Прощай».~
@25911 = ~«Что ты знаешь о Рейвел Клубок-Загадок?»~
@25912 = ~Женщина качает головой: «Очень сожалею… возможно, вы найдёте себе собеседника в одном из уличных кафе, сэр. Прощайте…»~
@25913 = ~«Стой. Ты будешь стоять здесь и отвечать на мои вопросы».~
@25914 = ~«Ночная ведьма Рейвел? Родители рассказывали мне сказки про неё, когда я была ещё ребёнком… страшные сказки».~
@25915 = ~«Сказки?»~
@25916 = ~«Ясно. Но я хочу задать ещё вопрос…»~
@25917 = ~«Тогда прощай».~
@25918 = ~«Спасибо, это всё, что я хотел знать. Прощай».~
@25919 = ~«Не бери в голову. Прощай».~
@25920 = ~«Всего один вопросик?»~
@25921 = ~Она кивает. «Да. О ведьме с чёрным сердцем, которая хотела разрушить Сигил. Мне говорили, что она придёт за мной, если я буду слишком громко кричать, и утащит меня в ужасное место, куда её изгнали, — неожиданно она хмурится. — Мне определённо пора, сэр… прощайте».~
@25922 = ~«Погоди, у меня был ещё вопрос…»~
@25923 = ~«Спасибо. Прощай».~
@25924 = ~«Возражаю. Теперь отвечай на мои вопросы…»~
@25925 = ~«Тогда прощай».~
@25926 = ~«Что-то не так в моей наружности?»~
@25927 = ~«Нет, сэр… вовсе нет! — женщина нервно хихикает. — Ну, возможно…» Она показывает на твой голый торс, покрытый шрамами: «Вы выглядите, прямо скажем, жутковато для обычного местного жителя, нет? Прошу, не обижайтесь на мои слова, сэр».~
@25928 = ~«Не обижаюсь. Но у меня были некоторые вопросы…»~
@25929 = ~«Мне больше ничего не нужно. Прощай».~
@25930 = ~«Нет. Прощай».~
@25931 = ~Оставить его.~
@25932 = ~Женщина вежливо кланяется: «Здравствуйте и прощайте… прошу прощения, сэр, но я немного спешу».~
@25933 = ~«Погоди. У меня вопросы…»~
@25934 = ~«Как я сказала, сэр, у меня крайне мало времени. Может быть, вы найдёте собеседника в одном из уличных кафе…»~
@25935 = ~«Стой. Ты будешь стоять здесь и отвечать на мои вопросы».~
@25936 = ~«Тогда прощай».~
@25937 = ~«Прощай».~
@25938 = ~«Приветствую…»~
@25939 = ~«Приветствую…»~
@25940 = ~Оставить её в покое.~
@25941 = ~Она с удивлением останавливается и смотрит вокруг в надежде, что ты обращался к кому-то другому, затем неловко улыбается. «Простите меня, но разве мы… — внезапно её глаза останавливаются на Морте. — Ой! Какой славный маленький мимир!»~
@25942 = ~«Мимир?»~
@25943 = ~«Не правда ли? Он обожает, когда ему чешут верхушку черепа».~
@25944 = ~«Я бы не стал его трогать — он кусается».~
@25945 = ~«Да-да. У меня были кое-какие вопросы…»~
@25946 = ~«Что-то не так в моей наружности?»~
@25947 = ~«Нет. Прощай».~
@25948 = ~Женщина улыбается: «Какая прелесть! Он разговаривает сам!»~
@25949 = ~~
@25950 = ~Она качает головой: «Нет, никогда не видела. Они же обычные вещи, не так…»~
@25951 = ~~
@25952 = ~Женщина пожимает плечами: «Весьма возможно».~
@25953 = ~«У меня кое-какие вопросы…»~
@25954 = ~«Мне пора идти».~
@25955 = ~«Правда? — она продолжает улыбаться, но уже несколько неуверенно. — Наверняка вы шутите, сэр! Это всего лишь мимир…»~
@25956 = ~«Что ты имеешь в виду? Разве не всем им это нравится?»~
@25957 = ~«Нет, я говорю правду. Можешь попробовать».~
@25958 = ~«Не обращай на него внимания. У меня были кое-какие вопросы…»~
@25959 = ~Она дотрагивается и осторожно похлопывает Морте… а тот немедленно начинает тереться о её ладонь, скаля зубы в широкой ухмылке и довольно подмигивая тебе. Она смущённо смеётся: «Как странно!»~
@25960 = ~«Да… так вот, у меня кое-какие вопросы…»~
@25961 = ~«Уже всё? Прощай».~
@25962 = ~«Разновидность говорящей энциклопедии, шеф. Но на самом деле я не люблю говорить об этом».~
@25963 = ~~
@25964 = ~Морте покачивает надбровьями и направляется к женщине: «Я много чего ещё уме…»~
@25965 = ~«Хватит, Морте».~
@25966 = ~«Да, да. Хорошо, — Морте вращает глазами и ворчит себе под нос. — Тьфу, я с таким же успехом мог быть *мёртвым*…»~
@25967 = ~«Слушай… ты сказала „разговаривает сам“? Разве они обычно так не делают?»~
@25968 = ~«Я хочу задать пару вопросов этой женщине…»~
@25969 = ~Оставить женщину в покое.~
@25970 = ~Морте прерывает её: «Ну, видишь ли, шеф, всё дело в *качестве* твоего мимира. Некоторые — вроде меня — более продвинутые, чем другие, вот и всё. С большим… э-э… „самосознанием“, вот как это называется».~
@25971 = ~«Хм-м».~
@25972 = ~«Ясно».~
@25973 = ~«Эй! Я просто хочу поразвлечься, шеф!»~
@25974 = ~~
@25975 = ~«Что… что эта тварь нам с-сделала?»~
@25976 = ~«Ты был в последние дни в оружейной?»~
@25977 = ~«Я знаю. Интересно, что он делает?»~
@25978 = ~«Он здесь уже давно!»~
@25979 = ~«Слышал, что к вечеру польёт дождь».~
@25980 = ~«Ты ещё кто такой?! Стой!»~
@25981 = ~«Не могу дождаться конца смены».~
@25982 = ~«Интересно, чем он так обеспокоен?»~
@25983 = ~«Нет, но я слышал, что они там работают над какой-то машиной».~
@25984 = ~::Зевает:: «Может, стоит соснуть».~
@25985 = ~«Но чтобы управляющий не видел, чем ты занят».~
@25986 = ~«Сандоз вернулся очень озабоченный, прямо не в себе».~
@25987 = ~Старый поэт~
@25988 = ~«Вершитель»~
@25989 = ~Раненая трокопотака~
@25990 = ~Сев'Тай~
@25991 = ~Глашатай Эс-Аннона~
@25992 = ~Каждый дюйм кожи этого мужчины покрыт паутиной чёрных линий, как будто какой-то художник хотел прорисовать пером все изгибы его тела. В результате даже когда его лицо лишено выражения, кажется, что он хмурится.~
@25993 = ~«Приветствую».~
@25994 = ~Оставить размалёванную личность в покое.~
@25995 = ~Эта женщина выглядит совершенно сломленной. Вся она покрыта шрамами — в основном это следы укусов и ужасные царапины от ногтей. Женщина баюкает в руках какие-то рваные тряпки и безучастно смотрит на стену монумента, где выбиты имена.~
@25996 = ~«Приветствую».~
@25997 = ~Оставить женщину в покое.~
@25998 = ~Этот невысокий жилистый головорез закутан в тряпьё, выкрашенное в красный и чёрный. Он окидывает тебя взглядом.~
@25999 = ~Мужик ничего не говорит, просто свирепо на тебя смотрит. Непохоже, что он главарь этой маленькой банды.~
@26000 = ~«Тогда прощай».~
@26001 = ~«Приветствую».~
@26002 = ~Оставить головореза в покое.~
@26003 = ~Этот плотного сложения бандит закутан в тряпьё, выкрашенное в красный и чёрный. На взгляд он состоит из одних мышц. Он сердито смотрит, как ты приближаешься.~
@26004 = ~«Приветствую».~
@26005 = ~Оставить бандита в покое.~
@26006 = ~Потоки слёз проложили канавки на покрытом пылью лице этого мужчины. Он похож на монаха или святошу, но так покрыт грязью, что подробно разглядеть его почти невозможно. Он монотонно напевает и раскачивает головой взад-вперёд, словно исполняет какой-то ритуал.~
@26007 = ~«Приветствую».~
@26008 = ~Оставить святошу в покое.~
@26009 = ~Золотое кольцо~
@26010 = ~Бронзовый браслет~
@26011 = ~Потускневший серебряный браслет~
@26012 = ~Серебряный браслет~
@26013 = ~Золотой браслет~
@26014 = ~Клинок Бессмертного~
@26015 = ~Клинок энтропии~
@26016 = ~Маскировка под Богота~
@26017 = ~Костюм Пыльного~
@26018 = ~Костюм Богота~
@26019 = ~Булава~
@26020 = ~Сыр~
@26021 = ~Седой волос Рейвел~
@26022 = ~Чёрные шипастые семена~
@26023 = ~Серьга Одноухого~
@26024 = ~Медная серьга~
@26025 = ~СЕРЕБРЯНАЯ СЕРЬГА
Вес: 0

У этой незатейливой серебряной серьги на поверхности видна полустёршаяся гравировка, но разобрать узор ты не можешь.~
@26026 = ~ЗОЛОТАЯ СЕРЬГА
Вес: 0

Возможно, эта простая золотая серёжка когда-то свисала с уха дворянина.~
@26027 = ~БРОНЗОВОЕ КОЛЬЦО
Вес: 0

Это грубое бронзовое кольцо слегка изогнуто, как будто кто-то в прошлом носил его в носу. Несмотря на многочисленные выбоины и царапины, его можно продать местным торговцам за несколько монет.~
@26028 = ~СЕРЕБРЯНОЕ КОЛЬЦО
Вес: 0

Это простое серебряное кольцо без камней и всякой отделки; возможно, когда-то было обручальным. Но чем бы оно раньше ни было, сейчас за него можно выручить несколько монет у местного торговца.~
@26029 = ~ЗОЛОТОЕ КОЛЬЦО
Вес: 0

Наружная сторона этого золотого кольца покрыта гравировкой, но ты не можешь понять её значение. Для чего бы оно ни предназначалось ранее, возможно, местные торговцы дадут за него несколько монет.~
@26030 = ~БРОНЗОВЫЙ БРАСЛЕТ
Вес: 0

Этот толстый бронзовый браслет довольно тяжёл, прост и безыскусен. Возможно, местный торговец даст за него несколько монет.~
@26031 = ~ПОТУСКНЕВШИЙ СЕРЕБРЯНЫЙ БРАСЛЕТ
Вес: 1

Этот потускневший серебряный браслет покрыт вмятинами и царапинами. На вид он не старый, но его явно много носили. Как бы он ни выглядел, за него можно выручить несколько монет у местного торговца.~
@26032 = ~СЕРЕБРЯНЫЙ БРАСЛЕТ
Вес: 1

Это тонкий браслет из серебра высокой пробы, покрытый искусной гравировкой. Наверняка купец даст за него немало.~
@26033 = ~ЗОЛОТОЙ БРАСЛЕТ
Вес: 0

Хотя этот браслет из высокопробного золота, на нём нет ни украшений, ни гравировок. Но несмотря на простоту, для местных торговцев он наверняка будет иметь определённую ценность.~
@26034 = ~КЛИНОК БЕССМЕРТНОГО
(Уникальный, артефакт)
Урон: 2-3 колющий
Зачаровано: +1
THAC0: +1
Фактор скорости: 1
Вес: 0
Навык: клинок
Недоступно: священникам

Этот странный клинок выковал железный голем, используя каплю твоей крови. Это оружие омерзительного вида напоминает один из символов на твоей левой руке. Чёрные жилки расползаются по поверхности металла, а лезвие выглядит настолько тупым, что на вид и тёплое масло резать не будет. В твоих руках он медленно пульсирует, будто сердце. Голем утверждал, что этот «клинок» может убить даже тебя, если применить его в месте, отрезанном от остальных планов.~
@26035 = ~КЛИНОК ЭНТРОПИИ
Урон: 3-23 колющий
Зачаровано: +2
THAC0: +3
Фактор скорости: 1
Вес: 1
Навык: клинок
Недоступно: священникам

Этот странный предмет попал к тебе в руки после того, как ты отдал куб модронов железному голему из осадной башни. Он похож на небольшой кинжал, но его поверхность прогибается и изменяется под твоим взглядом, как будто он хочет вырваться из своей формы.

Вероятно, он сделан из железа, серебра и… любого другого из числа различных металлов. Время от времени металлы сливаются, иногда — исчезают в глубине клинка, чтобы снова появиться на поверхности через несколько минут.~
@26036 = ~МАСКИРОВКА ПОД БОГОТА
Вес: 5

Этот комплект из простой крепкой одежды и рабочих башмаков копирует обычный рабочий костюм членов фракции Боготов.~
@26037 = ~КОСТЮМ ПЫЛЬНОГО
Вес: 5

Это хорошо сшитая копия унылой чёрной одежды, которую носят члены фракции Пыльных. В отличие от настоящих одежд Пыльных, эта из дорогой материи и на шёлковой подкладке.~
@26038 = ~КОСТЮМ БОГОТА
Вес: 5

Это искусно исполненная копия простой крепкой одежды и рабочих башмаков, которые образуют обычное рабочее одеяние членов фракции Боготов. В отличие от настоящего рабочей одежды, этот костюм из дорогой материи и на шелковой подкладке.~
@26039 = ~ВЕРШИТЕЛЬ
Урон: 3-12 дробящий
Зачаровано: +2
Особенности: ускоряет регенерацию
THAC0: +2
Фактор скорости: 2
Вес: 2
Навык: булава
Доступно: воинам

Эта булава выглядит так же, как и любая другая булава — шипованный шар на конце деревянной рукояти и кожаный ремень, чтобы в пылу боя не потерять оружие. Необычно то, что на головке оружия кислотой вытравлен знак Ока, стилизованное изображение бога Хоруса.

Это оружие называется «Вершитель». Булава, созданная в городе Гелиополисе на плане Аркадия, призвана помогать всем последователям добра и уничтожать поборников зла. Она может исцелить своего владельца, если её попросить, а так же имеет своё собственное мнение на некоторые вещи.~
@26040 = ~СЫР
Вес: 0

Это кусочек сыра.~
@26041 = ~ОТРАВЛЕННЫЙ СЫР
Вес: 0

Этот кусок сыра пропитан сильнодействующим ядом.~
@26042 = ~ЧЁРНОЕ ШИПАСТОЕ СЕМЯ
Вызывает: «Проклятие чёрных шипов»
Позволяет записать «Проклятие чёрных шипов» в книгу заклинаний
Дистанция: 30 футов
Длительность: мгновенно
Время чтения: 2
Зона действия: 1 существо
Спасбросок: нет
Вес: 0

Эти зловещие семена несут в себе часть лабиринта чёрных шипов. Сила семян высвобождается, если бросить их перед противником. Как только семя попадает на землю, из него вырастают чёрные колючие ветви, которые с жадностью раздирают тело жертвы на части. В каждом семечке только одно такое заклятье.~
@26043 = ~ОБСИДИАНОВАЯ СЕРЬГА
Особенности:
   Скрыться в тенях: +10%
Вес: 0
Доступно: ворам

Эта маленькая серёжка выполнена из полированного обсидиана. Несмотря на гладкую поверхность, она совсем не отражает света.

Часто называемый «лучшим другом вора», чёрный камень серьги обладает магическим свойством поглощать свет, благодаря чему владельцу легче двигаться в тенях необнаруженным.~
@26044 = ~СЕДОЙ ВОЛОС РЕЙВЕЛ
Вес: 0

Это один из длинных седых волос Рейвел; он выглядит таким старым, будто обычный седой волос Рейвел ещё больше побелел от старости. Должно быть, он несколько футов в длину… да ещё и очень жёсткий.~
@26045 = ~МЕДНАЯ СЕРЬГА
Вес: 0

Этот грубое медное колечко выглядит как жертва страстного любовника… или кого-то, кто любит грызть металл. С одной стороны оно погнуто и имеет отметины от зубов.~
@26046 = ~Бронзовый браслет~
@26047 = ~Потускневший серебряный браслет~
@26048 = ~Серебряный браслет~
@26049 = ~Золотой браслет~
@26050 = ~Клинок Бессмертного~
@26051 = ~Клинок энтропии~
