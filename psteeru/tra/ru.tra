@29084 = ~«Просто проходил мимо. Прощай».~
@29085 = ~«Вскоре я буду там».~
@29086 = ~«У меня ещё есть дела, так что я зайду попозже».~
@29087 = ~«Нет, у меня кое-какие вопросы…»~
@29088 = ~«Да, обучи меня».~
@29089 = ~«Да».~
@29090 = ~«Э-э… нет».~
@29091 = ~«Обучи меня кулачному бою».~
@29092 = ~«Обучи меня кулачному бою».~
@29093 = ~«Обучи меня сражаться клинками».~
@29094 = ~«Обучи меня сражаться клинками».~
@29095 = ~«Обучи меня сражаться булавами».~
@29096 = ~«Обучи меня сражаться булавами».~
@29097 = ~«Обучи меня сражаться топорами».~
@29098 = ~«Обучи меня сражаться топорами».~
@29099 = ~«Обучи меня сражаться молотами».~
@29100 = ~«Обучи меня сражаться молотами».~
@29101 = ~«На самом деле у меня были вопросы…»~
@29102 = ~«Прямо сейчас ничему. Прощай».~
@29103 = ~«Тогда у меня кое-какие вопросы».~
@29104 = ~«Быть может. Прощай».~
@29105 = ~Приступить к тренировке.~
@29106 = ~«Спасибо. Можешь меня ещё чему-нибудь обучить?»~
@29107 = ~«Спасибо. Можешь меня ещё чему-нибудь обучить?»~
@29108 = ~«Спасибо и прощай, Кви-Сай».~
@29109 = ~«Можешь меня обучить ещё чему-нибудь?»~
@29110 = ~«Тогда у меня кое-какие вопросы…»~
