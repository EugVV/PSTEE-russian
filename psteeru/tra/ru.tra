@41766 = ~«Как и я. Прощай».~
@41767 = ~«На сегодня хватит. Прощай».~
@41768 = ~«Кто ты?»~
@41769 = ~«Чем ты тут занимаешься?»~
@41770 = ~«Скажи… ты можешь подтянуть Морте по части ругательств?»~
@41771 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@41772 = ~«Я слышал, ты наполовину сестра Кезай-Серрис. Это правда?»~
@41773 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@41774 = ~«Мне сказали, что тебя недавно видели выходящей украдкой из комнаты Мариссы… это как-то связано с её пропавшей вуалью?»~
@41775 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@41776 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@41777 = ~«Знаешь что-нибудь о Рейвел Клубок-Загадок?»~
@41778 = ~«Я уже говорил с девятью проститутками… ты не знаешь, где десятая ученица?»~
@41779 = ~«Вообще-то забудь. Прощай».~
@41780 = ~«Я хочу спросить о другом…»~
@41781 = ~«Тогда прощай».~
@41782 = ~«Я слышал, что Кезай-Серрис — её дочь. Это правда?»~
@41783 = ~«Я хочу спросить о другом…»~
@41784 = ~«Тогда прощай».~
@41785 = ~«Я спросил об этом её, а она всё отрицает».~
@41786 = ~«Не бери в голову. У меня другой вопрос».~
@41787 = ~«Забудь. Прощай».~
@41788 = ~«Ещё я слышал, что ты наполовину сестра Кезай-Серрис».~
@41789 = ~«Может, и нет. У меня другой вопрос…»~
@41790 = ~«Забудь. Прощай».~
@41791 = ~«Я надеялся, что ты поможешь мне узнать, *действительно* ли Кезай — дочь Рейвел».~
@41792 = ~«Не бери в голову. У меня другой вопрос».~
@41793 = ~«Забудь. Прощай».~
@41794 = ~«Камбион?»~
@41795 = ~«Спасибо. Я хотел спросить о другом…»~
@41796 = ~«Тогда пойду поговорю с ней. Спасибо, Кимази, и прощай».~
@41797 = ~«Я спрашиваю, что это значит…»~
@41798 = ~«Нет… но у меня ещё один вопрос».~
@41799 = ~«Нет. Прощай».~
@41800 = ~«Лучше так, чем наполовину *ты*, Кимази».~
@41801 = ~«Я хочу спросить о другом…»~
@41802 = ~«Прощай, Кимази».~
@41803 = ~«Достаточно, Кимази. У меня другой вопрос…»~
@41804 = ~«У меня нет времени на эту ерунду. Прощай».~
@41805 = ~«Марисса? Ты уверена?»~
@41806 = ~«Марисса… её я ещё не встречал. Ты уверена?»~
@41807 = ~«Хм-м. У меня другой вопрос…»~
@41808 = ~«Забудь. Прощай».~
@41809 = ~Опуститься на колени и проверить.~
@41810 = ~«Хм-м. У меня другой вопрос…»~
@41811 = ~«Забудь. Прощай».~
@41812 = ~«Тогда у меня ещё один вопрос…»~
@41813 = ~«Это всё, что я хотел узнать. Прощай».~
@41814 = ~«У меня другой вопрос…»~
@41815 = ~«Предположу, что это Кимази, как написано на ошейнике. Прощай».~
@41816 = ~«У меня другой вопрос…»~
@41817 = ~«Неважно. Прощай».~
@41818 = ~«Я… понял. У меня ещё один вопрос…»~
@41819 = ~«Хорошо… пойду-ка я. Прощай».~
@41820 = ~«Зачем *вообще* кому-то нюхать твои трусики?»~
@41821 = ~~
@41822 = ~«Хм. У меня ещё один вопрос».~
@41823 = ~«Это всё, что я хотел узнать. Прощай».~
@41824 = ~«Нет, просто у меня пара вопросов…»~
@41825 = ~«Вообще-то я просто мимо проходил. Прощай».~
@41826 = ~«У меня пара вопросов…»~
@41827 = ~«Вообще-то я просто мимо проходил, Кимази. Прощай».~
@41828 = ~«Я хочу спросить о другом…»~
@41829 = ~«Это всё, что я хотел узнать. Прощай».~
@41830 = ~«Послушай, шеф. Очевидно, что после твоего последнего танца со смертью ты немного сбит с толку… так что у меня для тебя два совета: во-первых, если у тебя есть вопросы — *задавай* их, ладно?»

^NПРИМЕЧАНИЕ. <SPEAKTO>^-~
@41831 = ~«Ладно… если будут вопросы, я тебя спрошу».~
@41832 = ~«Во-вторых, если ты хоть *наполовину* такой забывчивый, каким кажешься, — начни вести записи. Как только тебе попадется то, что *может* оказаться важным, запиши это, чтобы не забыть».~
@41833 = ~«Если бы у меня был тот дневник, который *должен был* у меня быть, я бы так и сделал».~
@41834 = ~«Ну так заведи новый, шеф. Ничего ещё не потеряно. Кроме того, тут полно чернил и пергамента, так что можно взять… попользоваться».~
@41835 = ~«Хм-м-м. Ладно. Хуже от этого не будет… заведу новый».~
@41836 = ~«Записывай в него все свои перемещения. Если ты когда-нибудь начнешь забывать важные вещи, вроде того, кто ты такой, или, что более важно, кто *я* такой… всегда сможешь освежить память».

^NПРИМЕЧАНИЕ. Чтобы воспользоваться дневником, нужно нажать кнопку дневника в быстром меню. Дневник обновляется автоматически в процессе игры.^-~
@41837 = ~«Хорошо… понял. Пошли».~
@41838 = ~«Что тебя гложет, шеф?»~ [MRT515]
@41839 = ~Количество смертей:~
@41840 = ~«Можешь ещё раз прочесть, что у меня вытатуировано на спине?»~
@41841 = ~«Напомни, что это за место?»~
@41842 = ~«Это здание просто огромно… кто за ним присматривает?»~
@41843 = ~«Повтори ещё раз, кто смотрители этого места?»~
@41844 = ~«Эти трупы… откуда они все взялись?»~
@41845 = ~«Ты вроде упоминал, что мне не стоит вредить *женским* трупам. Почему?»~
@41846 = ~«Как мне использовать эти бинты?»~
@41847 = ~«Прямо сейчас ничего, Морте. Просто проверял, со мной ли ты ещё».~
@41848 = ~«Прямо сейчас ничего, Морте. Просто проверял, со мной ли ты ещё».~
@41849 = ~«Кхм, *да ладно*, шеф. Только не говори, что ты уже всё забыл».~
@41850 = ~«Мне просто надо освежить это в памяти».~
@41851 = ~«Неважно. У меня другие вопросы…»~
@41852 = ~«Ладно, забудь. Пойдём».~
@41853 = ~«Ладно, забудь. Пойдём».~
@41854 = ~«Готов поспорить, мне придётся слышать ЭТО много раз, — Морте кашляет, делая вид, что прочищает горло. — Та-ак, посмотрим…

„Я знаю, ты чувствуешь себя так, будто нахлебался мутных вод Стикса, но тебе нужно СОБРАТЬСЯ. Среди твоих вещей должен быть ДНЕВНИК, который прольёт немного света на это тёмное дело. ФАРОД расскажет тебе оставшуюся часть истории, если, конечно, он ещё не попал в книгу мёртвых“».~
@41855 = ~«Фарод… хм-м-м. Продолжай».~
@41856 = ~«Неважно. У меня другие вопросы…»~
@41857 = ~«Ладно. Я уже всё вспомнил. Пошли».~
@41858 = ~«Ладно. Я уже всё вспомнил. Пошли».~
@41859 = ~«Сейчас-сейчас, погоди, — Морте на секунду останавливается. — Ага, вот он, последний кусок…

„Не потеряй свой дневник, иначе мы снова погрузимся в воды Стикса. И что бы ты ни делал, НИКОГДА никому НЕ говори, КТО ты или ЧТО с тобой случилось, а то они устроят тебе скорое паломничество в крематорий. Делай, как я говорю: ПРОЧТИ дневник, а потом НАЙДИ Фарода“».~
@41860 = ~«А когда я очнулся, со мной не было дневника?»~
@41861 = ~«Хорошо. У меня было ещё несколько вопросов…»~
@41862 = ~«Ладно. Я уже всё вспомнил. Пошли».~
@41863 = ~«Ладно. Я уже всё вспомнил. Пошли».~
@41864 = ~«Нет… ты был раздет полостью. Как я уже говорил, похоже, тебе придётся обойтись тем дневником, что у тебя на спине».~
@41865 = ~«И ты точно не знаешь никого по имени Фарод?»~
@41866 = ~«И верно. У меня другие вопросы…»~
@41867 = ~«Ну ладно, пошли».~
@41868 = ~«Ну ладно, пошли».~
@41869 = ~«Не-а. Хотя, какой-нибудь пень должен знать, где его можно найти. Можно поспрашивать… ПОСЛЕ того, как выберемся отсюда».~
@41870 = ~«Прежде чем мы тронемся, я хотел бы ещё кое-что спросить…»~
@41871 = ~«Ну ладно, пошли».~
@41872 = ~«Ну ладно, пошли».~
@41873 = ~«Оно называется „Мортуарий“… большое чёрное сооружение с архитектурным очарованием беременной паучихи».~
@41874 = ~«Уяснил. У меня другие вопросы…»~
@41875 = ~«Это всё, что я хотел знать. Спасибо».~
@41876 = ~«Это всё, что я хотел знать. Спасибо».~
@41877 = ~«Они называют себя „Пыльными“. Их невозможно не узнать: это такие ребята в сером с лицами как у покойников. Толпа мерзких поклонников смерти с промытыми мозгами: они верят, что все должны умереть… и чем раньше, тем лучше».~
@41878 = ~«Странно… какое Пыльным дело до того, что я отсюда сбегу?»~
@41879 = ~«Уяснил. У меня другие вопросы…»~
@41880 = ~«Понятно. Буду осторожен».~
@41881 = ~«Понятно. Буду осторожен».~
@41882 = ~«Ты чё, не слушаешь меня, а? Пыльные считают, что ВСЕ должны умереть, и лучше раньше, чем позже. Как думаешь, трупам веселее быть в книге мёртвых или вне её?»~
@41883 = ~«Уяснил. У меня другие вопросы…»~
@41884 = ~«Ладно… я… постараюсь не забыть».~
@41885 = ~«Ладно… я… постараюсь не забыть».~
@41886 = ~«Ну так… просто *используй* их. От потери крови помогает и вообще».

^NПРИМЕЧАНИЕ. <BANDAGES2>^-~
@41887 = ~«Уяснил. У меня другие вопросы…»~
@41888 = ~«Спасибо. Думаю, что смогу с этим справиться».~
@41889 = ~«Спасибо. Думаю, что смогу с этим справиться».~
@41890 = ~«Смерть посещает планы каждый день, шеф. Эти увальни — всё, что осталось от тех несчастных, которые продали свои тела смотрителям после смерти».~
@41891 = ~«Уяснил. У меня другие вопросы…»~
@41892 = ~«Ладно… я… постараюсь не забыть».~
@41893 = ~«Ладно… я… постараюсь не забыть».~
@41894 = ~«Чт?.. Ты *серьёзно*? Слушай, шеф, эти девки — последний шанс для пары крутых парней вроде нас. Мы должны быть *галантными*… не кромсать их ради ключей, не разбирать на органы и всё такое».~
@41895 = ~«Последний шанс? Ты вообще *о чём* говоришь?»~
@41896 = ~«Неважно, у меня есть ещё несколько вопросов…»~
@41897 = ~«Ладно… я… постараюсь не забыть».~
@41898 = ~«Шеф, ОНИ померли, и МЫ тоже мертвы… ясно, куда я клоню? А? А?»~
@41899 = ~«Нет… вообще-то, нет».~
@41900 = ~«Надеюсь, ты не *всерьёз*?»~
@41901 = ~«Неважно, у меня есть ещё несколько вопросов…»~
@41902 = ~«Я уже достаточно услышал. Пошли».~
@41903 = ~«Шеф, у нас тут шикарная возможность наметилась с этими хромающими дамами. В конце концов, мы *все* хотя бы раз были мертвы, так? Нам есть о чём порассказать, а эти девушки просто обожают парней с таким опытом смерти, как у нас».~
@41904 = ~«Погоди… разве не ты говорил минуту назад, что я *не* мёртв?»~
@41905 = ~«Неважно, у меня есть ещё несколько вопросов…»~
@41906 = ~«Я уже достаточно услышал. Пошли».~
@41907 = ~«Ну ладно, ладно. Может, *ты* и не помер, шеф, но *я* — уж наверняка. И пока я здесь, не отказался бы разделить гробик, например, вон с той штучкой, которая маленько посвежее, — Морте пощёлкивает челюстями в предвкушении. — Конечно, тут приоритет принадлежит местным смотрителям, но непохоже…»~
@41908 = ~«У меня к тебе есть другие вопросы, Морте…»~
@41909 = ~«Я уже достаточно услышал. Пошли».~
@41910 = ~«Силы всевышние. Да тут просто весь АД в одной книге».~
@41911 = ~«Что это?»~
@41912 = ~Сделай из меня ВОРА, Тестоклес.~
@41913 = ~«Попробую угадать… думаю, это книга, в которую они записывают имена всех несчастных доходяг, попадающих сюда».~
@41914 = ~«А моё имя там может быть?»~
@41915 = ~«Э-э… ну… *возможно*. Чтобы узнать наверняка, тебе надо бы потрещать шкатулкой с этим летучим Пыльным. Правда, по-моему, это не очень хорошая идея».~
@41916 = ~«Ну, мне нужны ответы. Так что я пойду, поговорю с ним».~
@41917 = ~Оставить его в покое.~
@41918 = ~Мужчина отвешивает преувеличенно низкий поклон и даёт тебе маленькую карточку, на которой написано «Джамбл Убийца Чувств — Хорцерор Экстраординарный Хаоситек». Затем он вырывает карточку у тебя из рук и начинает её есть, беспрерывно улыбаясь.~
@41919 = ~Морте шепчет: «В какой-то психушке не хватает одного пациента».~
@41920 = ~«У меня пара вопросов, Джамбл…»~
@41921 = ~«Ты и есть человек, который проклял Вонючку, не так ли?»~
@41922 = ~«Я ухожу, Джамбл. Прощай».~
@41923 = ~«Ой-ой… кажется, на тебя только что наложили проклятье, шеф…»~
@41924 = ~«Что ты со мной сделал, Джамбл?»~
@41925 = ~«Джамбл… пожалуйста, отмени то, что ты сделал».~
@41926 = ~«Что бы ты ни сделал, Джамбл, — отмени это, а не то крупно пожалеешь».~
@41927 = ~«Давай просто уйдём отсюда, Морте».~
@41928 = ~«У меня пара вопросов, Джамбл…»~
@41929 = ~«Ты и есть человек, который проклял Вонючку, не так ли?»~
@41930 = ~«Я ухожу, Джамбл. Прощай».~
@41931 = ~Джамбл зевает и смотрит в сторону, барабаня пальцами по животу.~
@41932 = ~«Джамбл? Что насчёт моих вопросов?»~
@41933 = ~«Неважно… прощай».~
@41934 = ~Джамбл вращает глазами. Поворачивается к тебе, ухмыляется и начинает сосать большой палец.~
@41935 = ~«Хотя бы скажи: это ты наложил проклятие на Вонючку?»~
@41936 = ~«Ты что, немой? Поэтому ты мне не отвечаешь?»~
@41937 = ~Правда: «Мне нужны ответы на вопросы. И я выбью их из тебя силой, если понадобится».~
@41938 = ~Блеф: «Мне нужны ответы на вопросы. И я выбью их из тебя силой, если понадобится».~
@41939 = ~Уйти.~
@41940 = ~Джамбл наклоняет голову и глупо улыбается. Медленно пожимает плечами… затем закрывает глаза и показывает тебе язык.~
@41941 = ~Правда: «Мне нужны ответы на вопросы. И я выбью их из тебя силой, если понадобится».~
@41942 = ~Блеф: «Мне нужны ответы на вопросы. И я выбью их из тебя силой, если понадобится».~
@41943 = ~Уйти.~
@41944 = ~Джамбл поднимает бровь и делает шаг назад. Внезапно он открывает рот, и хотя его губы с языком даже не шевелятся, чтобы сформировать слова, целый поток труднопонимаемого лепета вырывается из его глотки.~
@41945 = ~«Что за?..»~
@41946 = ~Джамбл закрывает рот, и лепет прекращается… он смотрит на тебя прищуренными глазами, на его пухлом лице играет самодовольная улыбка. Неожиданно ты икаешь.

И снова икаешь. Икаешь. И опять икаешь.

А Джамбл Убийца Чувств только отворачивает голову и машет тебе на прощанье.~
@41947 = ~«Что ты со мной сделал?»~
@41948 = ~«Джамбл… пожалуйста, отмени то, что ты сделал».~
@41949 = ~«Что бы ты ни сделал, Джамбл, — отмени это, а не то крупно пожалеешь».~
@41950 = ~«Поищу-ка я лучше кого-нибудь, кто поможет избавиться от проклятия. Прощай».~
@41951 = ~Джамбл полностью тебя игнорирует.~
@41952 = ~Напасть на него.~
@41953 = ~«Поищу-ка я лучше кого-нибудь, кто поможет избавиться от проклятия. Прощай».~
@41954 = ~Джамбл смотрит на тебя невинными глазами и пожимает плечами, словно говоря: «Ничего не знаю». Затем он прикрывает рот руками и хихикает, как легкомысленная школьница.~
@41955 = ~«Я хочу снять с него проклятие».~
@41956 = ~«Я хочу спросить о другом…»~
@41957 = ~«Это всё, что я хотел узнать. Прощай».~
@41958 = ~Джамбл прикидывается, будто ничего не слышал, только громко отрыгивает и продолжает барабанить пальцами по животу, бегая глазами по Фестхоллу.~
@41959 = ~«Что я могу сделать, чтобы ты снял проклятие с Вонючки?»~
@41960 = ~Правда: «Сними проклятие, Джамбл, пока не вынудил меня сделать тебе больно».~
@41961 = ~Блеф: «Сними проклятие, Джамбл, пока не вынудил меня сделать тебе больно».~
@41962 = ~Уйти.~
@41963 = ~Джамбл отрицательно качает головой, даже не удостоив тебя взглядом.~
@41964 = ~Правда: «Сними проклятие, Джамбл, пока не вынудил меня сделать тебе больно».~
@41965 = ~Блеф: «Сними проклятие, Джамбл, пока не вынудил меня сделать тебе больно».~
@41966 = ~Уйти.~
@41967 = ~Джамбл Убийца Чувств отвешивает тебе свой коронный преувеличенно низкий поклон, затем наклоняет голову и с любопытством смотрит на тебя.~
@41968 = ~«У меня пара вопросов, Джамбл…»~
@41969 = ~«Ты и есть человек, который проклял Вонючку, не так ли?»~
@41970 = ~«Я просто проходил мимо; Прощай».~
@41971 = ~При твоём появлении Джамбл хмурит брови, тыкая пальцем в твою сторону и отмахиваясь другой рукой.~
@41972 = ~Наложить на него проклятие, которому научил тебя Салабеш.~
@41973 = ~«Джамбл, я хочу, чтобы ты снял с меня своё проклятие».~
@41974 = ~«У меня пара вопросов…»~
@41975 = ~Уйти.~
@41976 = ~Он вращает глазами и подчёркнуто зевает.~
@41977 = ~Наложить на него проклятие, которому научил тебя Салабеш.~
@41978 = ~Правда: «Сними проклятие, Джамбл, пока не вынудил меня сделать тебе больно».~
@41979 = ~Блеф: «Сними проклятие, Джамбл, пока не вынудил меня сделать тебе больно».~
@41980 = ~Уйти.~
@41981 = ~Джамбл Убийца Чувств разыгрывает целое шоу из рассматривания и чистки ногтей.~
@41982 = ~Наложить на него проклятие, которому научил тебя Салабеш.~
@41983 = ~Напасть на него.~
@41984 = ~Уйти.~
@41985 = ~Ты произносишь по слогам проклятие Салабеша, а Джамбл скептически на тебя смотрит. После минуты неловкой тишины маг замечает, что ничего не происходит… и дьявольская улыбка озаряет его лицо.~
@41986 = ~Продолжить…~
@41987 = ~Он открывает рот, чтобы отплатить ещё одним из своих проклятий… только для того, чтобы убедиться в отсутствии голоса! Проклятие Салабеша отняло у него способность говорить, таким образом разрушив его способность накладывать проклятья на других. Он хватается за горло, его глаза переполняет неподдельная паника.~
@41988 = ~«Похоже, расстановка сил поменялась, Джамбл. Как думаешь, что с тобой будет, когда те, кого ты проклял, — *ик!* — обнаружат, что ты не можешь больше говорить или накладывать проклятья?»~
@41989 = ~Джамбл падает на колени с умоляющим выражением лица. Кажется, он готов разразиться слезами.~
@41990 = ~«Снимешь — *ик!* — проклятие, которое на меня наложил? И поклянись, что ты никогда не проклянёшь никого, кто не желал тебе зла».~
@41991 = ~Джамбл кладёт руку на сердце и энергично кивает.~
@41992 = ~«Хорошо. В таком случае я сниму проклятие…»~
@41993 = ~Джамбл облегчённо вздыхает, когда ты снимаешь с него проклятие Салабеша. Взамен он снимает своё собственное, и ты наконец перестаёшь икать. Затем он смиренно кланяется, опустив глаза в пол.~
@41994 = ~«Я хочу, чтобы ты снял проклятие и с Вонючки».~
@41995 = ~«Прощай, Джамбл».~
@41996 = ~Джамбл кивает, надув губы, и взмахом руки снимает проклятие с Вонючки.~
@41997 = ~«Спасибо. Прощай, Джамбл».~
@41998 = ~Джамбл неуклюже кланяется и бросает на тебя тревожный взгляд. Ясно, что он предпочёл бы больше с тобой не связываться.~
@41999 = ~«Я хочу, чтобы ты снял проклятие с Вонючки».~
@42000 = ~«Просто проходил мимо, Джамбл. Прощай».~
@42001 = ~Оставить его в покое.~
@42002 = ~Мужчина одаривает тебя кособокой ухмылкой и тыкает себя в грудь большим пальцем правой руки: «Прыщ меня зовут, — *чхи!* — алхимик». Он снова показывает на себя, в этот раз указательным пальцем левой: «Звать Кильн. *Апчхи!* Нужно чё-нить?»~
@42003 = ~«Ты в порядке?»~
@42004 = ~«Что ты продаёшь?»~
@42005 = ~«Да, у меня вопросы…»~
@42006 = ~«Нет, не нужно. Прощай».~
@42007 = ~«*А-апчхи!*» Резким движением левой руки он хлопает по прилавку, волосы на его предплечье извиваются и скручиваются. На руке выведен целый ряд каракулей — похоже, список цен и число соответствующих товаров. Ты замечаешь, что некоторые лечащие отвары и амулеты в наличии.~
@42008 = ~«Я хочу кое-что купить…»~
@42009 = ~«Ты в порядке?»~
@42010 = ~«У меня вопросы».~
@42011 = ~«Мне ничего не нужно. Прощай».~
@42012 = ~Половина его рта искривляется в недовольной гримасе, он качает головой. «Я ж днями на складе вкалываю, ага. *А-а-апчхи!*» — он содрогается всем телом; неожиданно у него на переносице вскрывается третий глаз… левый глаз сдвигается в сторону и позволяет новому занять его место. «Я говорю только о — *чха!* — магазине, сэр», — после этих слов кожа его лица снова «поглощает» новый глаз, а левый возвращается на своё старое место.~
@42013 = ~«Ты в порядке?»~
@42014 = ~«Пожилой инженер в Кузнице сказал, что ему нужен образец моей кожи и крови, чтобы механизм заработал. Сделаешь мне такой образец?»~
@42015 = ~«Тогда прощай».~
@42016 = ~«Ага, я в порядке. *Пчхи!*» — его горло на минуту содрогается в судорогах, затем расслабляется. Огромный, светящийся зелёным цветом прыщ вырывается наружу с левой стороны его шеи. «Что-нить нужно, сэр? *Чхак!*» — его горло снова сжимается, и волна трясущейся плоти проглатывает гноящийся зелёный прыщ назад под кожу. Он резко кашляет в течение некоторого времени, затем его отпускает: «Фух».~
@42017 = ~«Могу я узнать, что с тобой случилось?»~
@42018 = ~«У меня вопросы…»~
@42019 = ~«Тогда прощай».~
@42020 = ~Его левый глаз раздражённо закатывается вверх. Правый глаз подозрительно смотрит на тебя. «Слишком много выпил».~
@42021 = ~«*Чего* много выпил?»~
@42022 = ~«Я хочу спросить о другом…»~
@42023 = ~«Это всё, что я хотел узнать. Прощай».~
@42024 = ~«Зелья я пил. Слишком много зелий. *А-апчхи-и!* — его рот съезжает ниже подбородка, из левой ноздри выделяется ещё одна. — Больше, чем *я* когда-либо пил, эт уж точно! Для полиморфа… они были замешаны и сварены… *чхак!* …в Лимбо».~
@42025 = ~«Могу я чем-нибудь помочь?»~
@42026 = ~«Я хочу спросить о другом…»~
@42027 = ~«Это всё, что я хотел узнать. Прощай».~
@42028 = ~Глаза мужчины поворачиваются внутрь, чтобы посмотреть друг на друга, затем снова обращают взор в твою сторону. «Без понятия. *Пчхи!* — он содрогается всем телом, рот выползает из-под подбородка вверх и проглатывает тот, что было уже образовался из ноздри. — Такое случается довольно часто; у нас нет выбора, — *чхе!* — кроме как самим опробовать товары. Если найдёшь способ помочь, мы оба были бы очень — *а-а-апчхи!* — благодарны, сэр».~
@42029 = ~«Я хочу спросить о другом…»~
@42030 = ~«Если что-нибудь придумаю, я дам знать. Прощай».~
@42031 = ~Ты видишь Прыща Кильна. Видок у него — или у них — такой же жуткий, как и раньше. Плоть постоянно меняется, ползёт и морщится по его лицу и телу. «Добро пожаловать — *пчху!* — назад, сэр».~
@42032 = ~«У меня есть эликсир жуткого разделения… как думаешь, он поможет?»~
@42033 = ~«Ты в порядке?»~
@42034 = ~«Я хочу кое-что купить…»~
@42035 = ~«У меня вопросы…»~
@42036 = ~«Я просто проходил мимо. Прощай».~
@42037 = ~Оба его глаза резко сходятся на маленькой бутылочке в твоих руках. Он кивает, причмокивая губами.~
@42038 = ~«Вот, держи…»~
@42039 = ~«Знаешь, я жду вознаграждения».~
@42040 = ~Прыщ Кильн берёт бутылочку обеими руками и аккуратно убирает её под прилавок. Его левый глаз внимательно смотрит на тебя, в то время как правый глаз и правая рука заняты неистовым выписыванием на прилавке каких-то каракулей. «Из него мы сварганим такую штуку, которая — *чхи!* — вмиг нас починит. Дай нам минутку, а када всё будет готово, — *чхак!* — мы заварим те лечебную микстуру в награду», — он разворачивается и направляется вглубь магазина…~
@42041 = ~~
@42042 = ~«Хорошо… тогда до свидания».~
@42043 = ~Левый глаз закатывается назад, но правый по-прежнему не отрывается от тебя. Он кивает: «Может, достаточно каких-нибудь лечебных штук, — *чхак!* — сэр?»~
@42044 = ~«Да, достаточно. Держи свой эликсир».~
@42045 = ~«Нет… я пока придержу его. Прощай».~
@42046 = ~«Соскоб? *Пчхик!* Хорошо». Его правая рука берёт лезвие бритвы, левая — бутылку с широким горлышком. Он срезает небольшой кусочек кожи с твоего предплечья и помещает его в бутылочку вместе с небольшим количеством твоей крови. Затем зажимает ранку небольшим кусочком марли и протягивает тебе бутылёк. «Ещё что-нить нужно, — *а-а-апчхи-и!* — сэр?»~
@42047 = ~«Нет, но… с тобой всё в порядке?»~
@42048 = ~«Да… я хочу кое-что купить».~
@42049 = ~«Нет, это всё. Спасибо и прощай».~
@42050 = ~Этот мужчина очень похож на Прыща Кильна, однако без ползущей кожи и постоянных мелких мутаций. «Приветствую снова, сэр, рад встрече. И что я, Прыщ, могу для тебя сделать?»~
@42051 = ~«Я надеялся получить лечебные зелья».~
@42052 = ~«У меня вопросы…»~
@42053 = ~«Я хочу кое-что купить…»~
@42054 = ~«Просто проходил мимо. Прощай, Прыщ».~
@42055 = ~«Да, конечно, твоя награда, ага? Давай посмотрим… для тебя, разумеется, сделаю забесплатно… но мне нужны подходящие ингредиенты. Хм… сердце они, или порошок красного железняка, или волосы дэва, или ниточку из мантии аазимона, или кровь регенерирующего существа, типа тролля или…»~
@42056 = ~«Вообще-то мои раны заживают *очень* быстро».~
@42057 = ~Прыщ поднимает бровь: «Правда? Что ж, тогда подойдёт и твоя кровь. Вот… дай мне взять её образец».~
@42058 = ~Позволить ему взять немного крови.~
@42059 = ~Выпустив у тебя немного крови, Прыщ отправляется с ней вглубь магазина. Возвращается он с чем-то похожим на затвердевшие капельки крови. «Если положить эту капельку под язык, она вылечит существующие раны и на какое-то время поможет предотвратить новые».~
@42060 = ~«Спасибо, Прыщ. У меня были вопросы…»~
@42061 = ~«Благодарю. Я хотел кое-что купить…»~
@42062 = ~«Спасибо, Прыщ, и прощай».~
@42063 = ~«Мои извинения, сэр, но я говорю только о магазине. Кроме того, я редко покидаю это место, ясно? Тебе лучше поискать кого-то ещё, если хочешь получить ответы на вопросы».~
@42064 = ~«Пожилой инженер в Кузнице сказал, что ему нужен образец моей кожи и крови, чтобы механизм заработал. Сделаешь мне такой образец?»~
@42065 = ~«Я хочу кое-что купить…»~
@42066 = ~«В таком случае прощай».~
@42067 = ~«Образец кожи и крови? Хорошо», — Прыщ берёт в руки лезвие бритвы и бутылёк с широким горлышком, срезает небольшой кусочек кожи с твоего предплечья и кладёт его в бутылочку вместе с небольшим количеством твоей крови. Затем зажимает ранку небольшим кусочком марли и протягивает тебе бутылёк. «Ещё что-нибудь нужно, сэр?»~
@42068 = ~«Да… я хочу кое-что купить».~
@42069 = ~«Нет, это всё. Спасибо и прощай».~
@42070 = ~Ты видишь Прыща, алхимика. «Приветствую снова, сэр, рад встрече. И что я, Прыщ, могу для тебя сделать?»~
@42071 = ~«Я надеялся получить лечебные зелья».~
@42072 = ~«У меня вопросы…»~
@42073 = ~«Я хочу кое-что купить…»~
@42074 = ~«Просто проходил мимо. Прощай, Прыщ».~
@42075 = ~Этот мужчина очень похож на Прыща Кильна, однако без ползущей кожи и постоянных мелких мутаций. «Привет ещё раз… моё имя Кильн. Что-нить нужно?»~
@42076 = ~«Я надеялся получить лечебные зелья».~
@42077 = ~«У меня вопросы…»~
@42078 = ~«Я хотел кое-что купить…»~
@42079 = ~«Вообще-то я просто проходил мимо. Прощай, Кильн».~
@42080 = ~Ты видишь Кильна, помощника алхимика. «Привет ещё раз… что-нить нужно?»~
@42081 = ~«Я надеялся получить лечебные зелья».~
@42082 = ~«У меня вопросы…»~
@42083 = ~«Я хотел кое-что купить…»~
@42084 = ~«Вообще-то я просто проходил мимо. Прощай, Кильн».~
@42085 = ~«Уже говорил с Прыщом? Уж он-то их те сварганит».~
@42086 = ~«Тогда пойду поговорю с ним. Прощай».~
@42087 = ~«Я ж днями на складе вкалываю, ага… не шибко мастер вопросы отвечать».~
@42088 = ~«Пожилой инженер в Кузнице сказал, ему нужен образец моей кожи и крови, чтобы машина заработала. Не сделаешь для меня?»~
@42089 = ~«Могу я тогда что-нибудь купить?»~
@42090 = ~«В таком случае прощай».~
@42091 = ~«Те стоит потолковать об этом с Прыщом. С такими вещами он управляется».~
@42092 = ~«Тогда пойду поговорю с ним. Прощай».~
@42093 = ~«Я полагаю, что она слепая по собственной воле, а не по воле случая».~
@42094 = ~«Тогда я осмотрюсь. Увидимся».~
@42095 = ~«Конечно. Пожалуйста, спрашивай».~
@42096 = ~«У меня вопрос об одном из произведений искусства…»~
@42097 = ~«Ивана, ты можешь видеть?»~
@42098 = ~«Ивана, ты можешь видеть?»~
@42099 = ~«Не знаешь, что это за маленькое кубическое создание?»~
@42100 = ~«Твоё лицо кажется мне знакомым… ты не знаешь никого по имени Ивес?»~
@42101 = ~«Ты уже поговорила со своей дочерью, Ивана?»~
@42102 = ~«Что это за место?»~
@42103 = ~«Что здесь интересного?»~
@42104 = ~«Где-нибудь здесь можно найти работу?»~
@42105 = ~«Я хотел спросить об одном месте…»~
@42106 = ~«Как пройти…»~
@42107 = ~«Что ты знаешь о Рейвел Клубок-Загадок?»~
@42108 = ~«Вообще-то не бери в голову. Прощай».~
@42109 = ~«Боюсь, я очень редко выхожу за стены галереи и не могу помочь тебе в этом вопросе. Попробуй спросить ещё кого-нибудь».~
@42110 = ~«У меня вопрос о другом…»~
@42111 = ~«Тогда прощай».~
@42112 = ~«Это моя дочь, — на мгновение в молочной белизне её глаз просвечивает капелька грусти. — Больше мы не разговариваем друг с другом».~
@42113 = ~«Почему?»~
@42114 = ~«У меня вопрос о другом…»~
@42115 = ~«Это всё, что я хотел узнать. Прощай».~
@42116 = ~«Нам нечего друг другу сказать. Она с головой ушла в свои истории… по причинам, о которых я не знаю».~
@42117 = ~«Она рассказала мне историю, которая может дать ответ на этот вопрос…»~
@42118 = ~«У меня вопрос о другом…»~
@42119 = ~«Это всё, что я хотел узнать. Прощай».~
@42120 = ~Ивана поднимает брови: «Да? Пожалуйста, расскажи мне! Я буду очень признательна, сударь…»~
@42121 = ~Рассказать ей историю Охотницы-за-Рассказами и её вечной погони за историей, в которой сокрыта истина.~
@42122 = ~«Может, в следующий раз. У меня другой вопрос…»~
@42123 = ~«Может, в другой раз. Прощай».~
@42124 = ~Ивана медленно кивает. «Я… даже понятия не имела. Мне нужно скорее её увидеть. Спасибо, сударь, что принёс мне вести о моей единственной дочери», — пока она говорит, краска медленно приливает к её бледным радужным оболочкам, наконец глаза становятся ярко-зелёного цвета.~
@42125 = ~«Твои глаза… теперь ты можешь видеть, Ивана?»~
@42126 = ~«У меня вопрос о другом…»~
@42127 = ~«Это всё, что я хотел узнать. Прощай».~
@42128 = ~Она кивает, улыбаясь.~
@42129 = ~«У меня вопрос о другом…»~
@42130 = ~«Это всё, что я хотел узнать. Прощай».~
@42131 = ~«Одну минуту, сударь… твой голос, он отягощён возрастом и ранами. Не сочтёшь ли дерзостью мою просьбу дотронуться до твоего лица?»~
@42132 = ~«Хорошо, дотронься».~
@42133 = ~«Нет. Я бы предпочёл обойтись без прикосновений».~
@42134 = ~«Подожди…»~
@42135 = ~Ивана кивает: «Хорошо, больше я не буду тебя просить».~
@42136 = ~«У меня кое-какие вопросы…»~
@42137 = ~«Мне пора идти. Прощай».~
@42138 = ~Ивана улыбается, мягко проводя ладонями по твоей коже. Она хмурится и выглядит несколько озадаченно. «Так много шрамов… и старых, и новых. Они как будто… — она дотрагивается до твоей шеи и, покраснев, отдёргивает руку. — Прости меня, сударь. Мне просто было интересно, насколько далеко заходят твои шрамы».~
@42139 = ~«Ничего страшного. Они везде, всё моё тело покрыто шрамами».~
@42140 = ~«Просто не делай так больше, старая женщина».~
@42141 = ~Ивана кивает.~
@42142 = ~«У меня кое-какие вопросы…»~
@42143 = ~«Мне пора идти. Прощай».~
@42144 = ~«Я не вижу, но только потому, что не хочу видеть. Со временем я разрешу своему зрению вернуться, чтобы я снова смогла оценить и прочувствовать произведения в моей галерее новым, свежим взглядом».~
@42145 = ~«У меня вопрос о другом…»~
@42146 = ~«Это всё, что я хотел узнать. Прощай».~
@42147 = ~Ивана с улыбкой кивает: «Твоя подруга совершенно права, сударь…»~
@42148 = ~«Мы снова разговариваем друг с другом, да… и я должна тебя за это поблагодарить. Такая радость снова делиться мыслями со своей дочерью», — Ивана тебе улыбается.~
@42149 = ~«У меня вопрос о другом…»~
@42150 = ~«Это всё, что я хотел узнать. Прощай».~
@42151 = ~«Что ж, это моя галерея планов, — она улыбается и обводит рукой вокруг себя. — Все эти произведения были привезены сюда издалека. Некоторые я продаю, некоторые храню — и все время от времени выставляю напоказ. Прошу, наслаждайся ими… и если у тебя появятся вопросы по поводу любого экспоната — не стесняйся спрашивать у меня».~
@42152 = ~«У меня вопрос о другом…»~
@42153 = ~«Это всё, что я хотел узнать. Прощай».~
@42154 = ~«Она — ночная ведьма, одна из старейших среди Серых Сестёр Пустоши. Она пришла в Сигил много веков назад, чтобы проводить колдовские эксперименты. Считается, что эти эксперименты проводились против воли Госпожи и что именно из-за них Рейвел была изгнана из Сигила, навечно заключена в один из лабиринтов Госпожи, где её тело покоится и по сей день…»~
@42155 = ~«Продолжай…»~
@42156 = ~«Погоди… у меня был другой вопрос…»~
@42157 = ~«Дослушаю в другой раз. Прощай».~
@42158 = ~«Говорят, Рейвел была великой мастерицей загадок и головоломок, но есть мнение, что одна загадка — один вопрос, если быть точной, — мучил древнюю ночную ведьму: „Что может изменить природу человека?“»~
@42159 = ~«Продолжай…»~
@42160 = ~«Погоди… у меня был другой вопрос…»~
@42161 = ~«Дослушаю в другой раз. Прощай».~
@42162 = ~«Она бросала вызов всем, кто был заинтересован. Обещала обучить каждого своему искусству… но только если она будет удовлетворена ответом на этот вопрос. Если же кто-либо не мог ответить — он становился её трапезой. Многие умерли, возжелав познать учение Рейвел, и говорят, что до последних своих дней в Сигиле Рейвел так и не получила ответа на свой вопрос».~
@42163 = ~«Продолжай…»~
@42164 = ~«Погоди… у меня был другой вопрос…»~
@42165 = ~«Дослушаю в другой раз. Прощай».~
@42166 = ~«Рейвел обвиняли в том, что она пыталась разбить Клетку, из неизвестных побуждений вскрыть сам Сигил, — Ивана вздыхает. — Это всё, что я о ней знаю».~
@42167 = ~«У меня вопрос о другом…»~
@42168 = ~«Это всё, что я хотел узнать. Прощай».~
@42169 = ~«О? И каком же? Одной из картин?»~
@42170 = ~«Аркадийские витражи».~
@42171 = ~«Боевой рог Ахерона».~
@42172 = ~«Тёмные Птицы Окантуса».~
@42173 = ~«Рубиновая статуэтка».~
@42174 = ~«Живая цепь китона».~
@42175 = ~«Статуя кричащего мужчины».~
@42176 = ~«Да, вопрос об одной из картин…»~
@42177 = ~«На самом деле у меня вопрос кое о чём другом…»~
@42178 = ~«Вообще-то никаком. Прощай».~
@42179 = ~«И какая же интересует, сударь?»~
@42180 = ~«„Побережье Каразутры“».~
@42181 = ~«„Налётчики Внешних Земель“».~
@42182 = ~«„Хазазот поглощает Н'гара“».~
@42183 = ~«„Поверхность Таласии“».~
@42184 = ~«„Библиотека“».~
@42185 = ~«„Глупость Удо“».~
@42186 = ~«„Долина под Клангеддином“».~
@42187 = ~«„Серая ведьма Оиноса“».~
@42188 = ~«„Эскиз движения волн #7“».~
@42189 = ~«„Мгновенный Взгляд со стен Моч'чмы“».~
@42190 = ~«На самом деле у меня вопрос кое о чём другом…»~
@42191 = ~«Вообще-то неважно. Прощай».~
@42192 = ~«Витраж был найден парящим на третьем ярусе Аркадии тридцать два года назад, сцена в нём предсказывала то, что ещё должно было случиться. Когда это событие произошло, изображение выцвело и осталось то, что ты видел. По преданию, витраж мог поглощать свет и тьму из Шара Ночи и Дня в Аркадии, затем медленно испускать их, создавая иллюзию медленного увядания сумерек или восхождения солнца, но только в самом стекле».~
@42193 = ~«Шар Ночи и Дня? Аркадия?»~
@42194 = ~«Позволь мне спросить о другом шедевре…»~
@42195 = ~«У меня вопрос о другом…»~
@42196 = ~«Это всё, что я хотел узнать. Прощай».~
@42197 = ~«Аркадия — это план спокойствия и порядка, также известный, как Земля Совершенного Добра. Шар Ночи и Дня — это сфера, расположенная на самом высоком пике Аркадии, каждая её половина испускает либо свет, либо тьму. Поворот Шара приносит Аркадии день и ночь».~
@42198 = ~«Позволь мне спросить о другом шедевре…»~
@42199 = ~«У меня вопрос о другом…»~
@42200 = ~«Это всё, что я хотел узнать. Прощай».~
@42201 = ~«А, Очищающий Рог… рог из кованого свинца, метала, добытого прямо из куба Ахерона. Говорят, что Очищающий Рог в последний раз звучал, когда Войско Шакала и Кланы Выбитого Глаза встретились для битвы за Спорные Земли. Легенда гласит, что сила рога была использована под конец битвы, чтобы свести кубы вместе, раздавив Войско Шакала до того, как они смогли убежать».~
@42202 = ~«Кубы? Ахерон?»~
@42203 = ~«Позволь мне спросить о другом шедевре…»~
@42204 = ~«У меня вопрос о другом…»~
@42205 = ~«Это всё, что я хотел узнать. Прощай».~
@42206 = ~«Ахерон — это план с жёстко установленным порядком, где следовать догмам важнее, чем быть добрым. Он состоит из гигантских металлических кубов, плавающих в бесконечной пустоте… многие кубы настолько велики, что целые города или даже королевства были построены на их поверхностях».~
@42207 = ~«Позволь мне спросить о другом шедевре…»~
@42208 = ~«У меня вопрос о другом…»~
@42209 = ~«Это всё, что я хотел узнать. Прощай».~
@42210 = ~«Все они откололись от великого магического пласта тьмы, бесконечной глыбы льда, покоящейся на чёрном брюхе плана Окантус, — Ивана ненадолго замолкает, барабаня пальцами подбородок. — Говорят, что эта глыба льда — тот последний пункт назначения, куда текут воды реки Стикс, и что воспоминания всех, окунувшихся в стирающие память воды Стикса, до сих пор заморожены в этом льде».~
@42211 = ~«Если воды Стикса стирают память, то этот лёд с Окантуса может сделать то же самое?»~
@42212 = ~«Позволь мне спросить о другом шедевре…»~
@42213 = ~«У меня вопрос о другом…»~
@42214 = ~«Это всё, что я хотел узнать. Прощай».~
@42215 = ~«Я могу только предположить, что да».~
@42216 = ~«Позволь мне спросить о другом шедевре…»~
@42217 = ~«У меня вопрос о другом…»~
@42218 = ~«Это всё, что я хотел узнать. Прощай».~
@42219 = ~«Этот шедевр был найден в соборе, который находится в плодородных полях Элизиума на первом уровне Беспечной Амории, на границе с рекой Океанус. Название шедевра неизвестно, но мастерство, с которым он выполнен, считается одним из самых ярких примеров великолепной работы с драгоценными камнями на планах. Достаточно просто посмотреть, как это произведение искусства поглощает, очищает и усиливает свет, проходящий через его поверхность, и для тебя откроется его захватывающая дух красота. Оно как будто выводит на свет возможную идеологическую связь между самыми грешными и самыми чистыми существами в мультивселенной… само очарование».~
@42220 = ~«Позволь мне спросить о другом шедевре…»~
@42221 = ~«У меня вопрос о другом…»~
@42222 = ~«Это всё, что я хотел узнать. Прощай».~
@42223 = ~«Цепь попала сюда из города Шумный Хитер, города цепей, который вцепился в Минаурос, третий уровень Баатора. Там самые прекрасные цепи в мультивселенной, но обитатели Шумного Хитера очень злобны и жестоки, используют цепи в качестве живого оружия против каждого, кто войдёт в их город и нарушит их законы».~
@42224 = ~«Китоны передвигаются по городу цепей, как пауки по паутине, украшенные цепями, туго обмотанными вокруг их тел. Китоны обладают силой, известной как „дар цепей“, которая позволяет им мысленно манипулировать цепями. Существует предание, что цепь из моей галереи ожила во время сражения, в котором контролирующий её китон был убит с помощью проклятого молота… и его жизненная сила перешла к цепи».~
@42225 = ~«Позволь мне спросить о другом шедевре…»~
@42226 = ~«У меня вопрос о другом…»~
@42227 = ~«У меня вопрос о другом…»~
@42228 = ~«Это всё, что я хотел узнать. Прощай».~
@42229 = ~«Считается, что превращение в статую не привело к окончательной гибели этерзерианского колдуна Гангройгидона. Атакованный конклавом конкурирующих колдунов на вершине своего мечтательного сумасшествия, он был околдован заклятьем, превратившим его тело в камень. Говорят, на губах Гангройгидона застыло его последнее заклинание, ужасное проклятие, так и не слетевшее с его губ, настолько ужасное, что оно *никогда* не должно быть произнесено из уст живущего».~
@42230 = ~«Говорят, силы проклятья было достаточно, чтобы плоть услышавших его слезла бы костей, и что оно могло расколоть на мелкие кусочки даже камни».~
@42231 = ~«Позволь мне спросить о другом шедевре…»~
@42232 = ~«У меня вопрос о другом…»~
@42233 = ~«Это всё, что я хотел узнать. Прощай».~
@42234 = ~«Каразутра — это уровень в Зверинце, в котором постоянно царит ночь и где живут все виды ночных зверей, преследующих во тьме свою добычу. Эти полотна мне подарил один художник, полюбивший Владычицу Котов и последовавший за ней на её родину. Но он так и не открыл секрета создания шедевра».~
@42235 = ~«Позволь мне спросить о другой картине…»~
@42236 = ~«У меня вопрос о другом…»~
@42237 = ~«Это всё, что я хотел узнать. Прощай».~
@42238 = ~«Интересный экземпляр, не правда ли? Художник сумел создать поразительный эффект с помощью формы тени, отбрасываемой скалой. Женщина, которая принесла мне эту картину, сказала, что нашла её в заброшенном лагере во Внешних Землях… так и не удалось установить, кто написал эту картину. Предположительно, художник был убит налётчиками, которых изобразил на холсте».~
@42239 = ~«Позволь мне спросить о другой картине…»~
@42240 = ~«У меня вопрос о другом…»~
@42241 = ~«Это всё, что я хотел узнать. Прощай».~
@42242 = ~«Эта картина — копия той, что нарисована на стене камеры в Доме Врат — самом большом сумасшедшем доме Сигила. Всё, что мог сказать обитатель камеры, было: „Хазазот поглотил Н'гара… Хазазот поглотил Н'гара…“ Слегка пугает, по-моему, но тем не менее прекрасная картина».~
@42243 = ~«Позволь мне спросить о другой картине…»~
@42244 = ~«У меня вопрос о другом…»~
@42245 = ~«Это всё, что я хотел узнать. Прощай».~
@42246 = ~«Таласия — это море, в которое впадает и откуда берёт своё начало река Океанус, протекающая через весь план Элизиум. Полотно было написано жителем одного из многочисленных островов этого плана».~
@42247 = ~«Позволь мне спросить о другой картине…»~
@42248 = ~«У меня вопрос о другом…»~
@42249 = ~«Это всё, что я хотел узнать. Прощай».~
@42250 = ~«Об этом произведении я знаю очень немного… однажды кто-то принёс его сюда и оставил у входа в мою галерею, завёрнутым в чёрный бархат с надписью „Из Цитадели“. Один умный человек выдвинул гипотезу о том, что это крепость какого-то колдуна, заточённого в полуплане, созданном им самим».~
@42251 = ~«Позволь мне спросить о другой картине…»~
@42252 = ~«У меня вопрос о другом…»~
@42253 = ~«Это всё, что я хотел узнать. Прощай».~
@42254 = ~«Эта картина иллюстрирует одну из легенд Первичного мира Гоха. Удо был королём-волшебником и обладал такими способностями и могуществом, что решил прочесть заклинание, которое превратит его в силу, а людей его великой нации — в божественных слуг. Когда он закончил чтение заклинания, молнии обрушились на дворец Удо, объяв его пламенем. До того, как утих гром, город был пуст… не осталось ни одного живого существа. Больше семидесяти тысяч человек испарилось без следа, во мгновение ока. Никто не знает участь Удо и его людей».~
@42255 = ~«Позволь мне спросить о другой картине…»~
@42256 = ~«У меня вопрос о другом…»~
@42257 = ~«Это всё, что я хотел узнать. Прощай».~
@42258 = ~«Эту картину мне продал Бульбог Каменный Нос… на ней нарисовано поле под горой Клангеддин, домом дварфов-эйнериаров — духов Верхних планов, которые служат стражами или воинами на плане Аркадия».~
@42259 = ~«Позволь мне спросить о другой картине…»~
@42260 = ~«У меня вопрос о другом…»~
@42261 = ~«Это всё, что я хотел узнать. Прощай».~
@42262 = ~«Говорят, что это портрет Рейвел Клубок-Загадок, вероятно, самой злой ведьмы, терроризировавшей всех на Серой Пустоши и за её пределами».~
@42263 = ~«Что ты знаешь о Рейвел Клубок-Загадок?»~
@42264 = ~«Позволь мне спросить о другой картине…»~
@42265 = ~«У меня вопрос о другом…»~
@42266 = ~«Это всё, что я хотел узнать. Прощай».~
@42267 = ~«Эту картину мне продал юноша, имени которого я не знаю. Таких полотен было несколько, но остальные были уже проданы… если верить его словам. Мне так хотелось купить всю коллекцию, но увы — часто оказывается так, что некоторые вещи просто тебе не предназначены».~
@42268 = ~«Позволь мне спросить о другой картине…»~
@42269 = ~«У меня вопрос о другом…»~
@42270 = ~«Это всё, что я хотел узнать. Прощай».~
@42271 = ~«Моч'чма — это крепость гитцерай, которая дрейфует на плане Лимбо. Мгновенный Взгляд был написан представительницей школы хаоса Ди, которая с точностью до мельчайших деталей помнит всё, что она видела, когда не переживает припадки сумасшествия».~
@42272 = ~«Позволь мне спросить о другой картине…»~
@42273 = ~«У меня вопрос о другом…»~
@42274 = ~«Это всё, что я хотел узнать. Прощай».~
@42275 = ~Ивана улыбается и жестом подзывает тебя: «Ещё раз приветствую. У тебя появились вопросы об одном из шедевров?»~
@42276 = ~«Нет, но есть вопросы другого характера…»~
@42277 = ~«Да…»~
@42278 = ~«Не сейчас. Прощай, Ивана».~
@42279 = ~Ивана берёт игрушку и проводит по ней пальцами. Она ощупывает очертания предмета, а затем возвращает его тебе: «Это не просто искусно сделанный игрушечный модрон, я уверена. Это может быть какая-то головоломка или ключ от портала».~
@42280 = ~«Что такое модрон?»~
@42281 = ~«У меня вопрос о другом…»~
@42282 = ~«Это всё, что я хотел узнать. Прощай».~
@42283 = ~«Модроны — это раса законопослушных, дисциплинированных существ. Они бывают разных размеров и форм, каждый занимает определённый уровень в их строгой модронской иерархии. Думаю, эта разновидность называется „квадрон“».~
@42284 = ~«У меня вопрос о другом…»~
@42285 = ~«Это всё, что я хотел узнать. Прощай».~
@42286 = ~«Согласно вашему желанию; теперь вы — вор».~
@42287 = ~~
@42288 = ~«С-с-с! Не подходи ближе, человек!»~
@42289 = ~«Ты попадёш-шь в нашу ловушку!»~
@42290 = ~«Приятно было пообщаться. Прощай».~
@42291 = ~Оставить труп в покое.~
@42292 = ~Оставить труп в покое.~
@42293 = ~Похоже, у этого трупа нет ключа… и он выглядит так, что вообще вряд ли смог бы им воспользоваться: его пальцы сломаны, будто кто-то стукнул по ним молотком. Ты замечаешь, что левое плечо трупа обильно забинтовано… бинты вполне можно использовать, если сначала избавить от них владельца.~
@42294 = ~«Кажется, у тебя его нет… ты, случайно, не знаешь, у кого из твоих дохлых друзей есть ключ от этого места?»~
@42295 = ~«Кажется, у тебя его нет… ты, случайно, не знаешь, у кого из твоих дохлых друзей есть ключ от этого места?»~
@42296 = ~«Приятно было пообщаться. Прощай».~
@42297 = ~Оставить труп в покое.~
@42298 = ~«Эй, шеф… они не слышат тебя, понимаешь? Они мертвы».~
@42299 = ~«Но ты тоже мёртв. И ты разговариваешь со мной».~
@42300 = ~«Да, но *я* — особенный. Смерть не смогла убить мою жажду жизни. Эти трупы… — Морте вращает глазами. — Они вряд ли что-либо из себя представляли при жизни».~
@42301 = ~«Ясно…»~
@42302 = ~«Послушай, шеф… наблюдение за тем, как ты пытаешься поговорить с этими трупами, не особо прибавляет мне боевого духа. Давай оставим эту идиотскую затею, хорошо?»~
@42303 = ~«Ну ладно, пошли».~
@42304 = ~Оставить труп в покое.~
@42305 = ~Оставить труп в покое.~
@42306 = ~«Он выглядит как счастливый просящий, шеф. Смотри… у него в руке ключ».~
@42307 = ~Записка с трупа #1201~
@42308 = ~«Приятно было пообщаться. Прощай».~
@42309 = ~Оставить труп в покое.~
@42310 = ~Оставить труп в покое.~
@42311 = ~У этого трупа ничего нет… но ты случайно замечаешь толстый слой бинтов на его руках. Бинты вполне можно использовать, если сначала убить его.~
@42312 = ~«Кажется, у тебя ключа нет… ты, случайно, не знаешь, у кого из твоих дохлых друзей есть ключ от этого места?»~
@42313 = ~«Кажется, у тебя ключа нет… ты, случайно, не знаешь, у кого из твоих дохлых друзей есть ключ от этого места?»~
@42314 = ~«Приятно было пообщаться. Прощай».~
@42315 = ~Оставить труп в покое.~
@42316 = ~«Приветствую?..»~
@42317 = ~«Должно быть, это тело Мертвина…»~
@42318 = ~Оставить его в покое.~
@42319 = ~~
@42320 = ~Безголовое тело на минуту перестаёт шататься и останавливается. Оно вытягивает руки, как будто пытаясь нащупать, где ты стоишь.~
@42321 = ~Разрешить ему дотронуться до тебя.~
@42322 = ~Взять его за руку.~
@42323 = ~Отойти от него.~
@42324 = ~Через минуту его пальцы касаются твоего предплечья. Оно вцепляется в твою руку и пробегает пальцами до плеча, затем по голове. Ощупывая твоё лицо и шею, его рука словно пытается что-то найти. Наконец оно хватает тебя за руку и резко её трясёт в рукопожатии. Ты замечаешь, что его кожа холодная и слегка липкая.~
@42325 = ~«Ты меня понимаешь?»~
@42326 = ~«Мне пора идти. Прощай».~
@42327 = ~Безголовое тело неожиданно подпрыгивает, затем крепко сжимает твою руку, тряся её… оно кажется довольно дружелюбным. Его рукопожатие крепкое, но кожа холодная и слегка липкая.~
@42328 = ~«Где твоя голова? Ты вообще меня понимаешь?»~
@42329 = ~«Мне пора идти. Прощай».~
@42330 = ~Тело делает несколько движений руками, затем ждёт ответа. Кажется, оно что-то спрашивает.~
@42331 = ~«Что? Я не понимаю…»~
@42332 = ~«Мне пора идти. Прощай».~
@42333 = ~Безголовое тело минуту барабанит по ноге, затем чешет протез головы в месте, где должен быть подбородок. Неожиданно оно поднимает вверх указательный палец, словно ему в голову пришла идея. Оно показывает на тебя, затем на глаза своей деревянной головы, затем снова на тебя. Затем оно показывает на свою деревянную голову обеими руками, пожимает плечами и опять показывает на тебя.~
@42334 = ~«Хм, нет… я нигде не видел твоей головы».~
@42335 = ~Безголовое тело пожимает плечами, затем разворачивается и бредёт прочь, слегка сутулясь.~
@42336 = ~Уйти.~
@42337 = ~Тело шаркает к тебе и тянется в сторону железной коробки с головой Мертвина.~
@42338 = ~Позволить телу Мертвина взять его голову.~
@42339 = ~Не отдавать голову безголовому телу.~
@42340 = ~«Ох, так гораздо лучше; благодарю вас, добрый сэр! Представляю, что тут вытворяло без меня моё тело, — тело крепко обнимает железную коробку. — Да, я тоже по тебе скучал…» Тело засовывает коробку под мышку и сгибается в поклоне. «Что касается вас, сэр… вы несомненно заслуживаете *некоторого* вознаграждения за потраченное время. Посмотрим, что у меня есть…» — тело шарит по карманам и, ничего там не отыскав, копается в своей тунике. Наконец оно извлекает несколько горстей медных монет.~
@42341 = ~«Спасибо, Мертвин. У меня к тебе вопросы…»~
@42342 = ~«Благодарю. Прощай, Мертвин».~
@42343 = ~«Конечно, спрашивайте всё что пожелаете!»~
@42344 = ~«Как так получилось… что ты остался без головы?»~
@42345 = ~«Что ты здесь делаешь?»~
@42346 = ~«Не расскажешь мне об этом месте?»~
@42347 = ~«Что ты знаешь о Рейвел Клубок-Загадок?»~
@42348 = ~«Не бери в голову, Мертвин. Прощай».~
@42349 = ~«Я точно не знаю… тело положило меня в одной из лекционных аудиторий. Следующее, что я помню, — как кто-то сбежал вместе со мной! И ещё я помню, как вы подобрали меня…»~
@42350 = ~«Но я имел в виду, каким образом ты *потерял* голову?»~
@42351 = ~«Я хочу спросить о другом…»~
@42352 = ~«Это всё, что я хотел узнать. Прощай».~
@42353 = ~Тело заметно напрягается: «О, мы не любим об этом говорить. Довольно ужасная история, правда… что было — то было, не стоит к этому возвращаться. Хотя могу признаться: я в железной коробке, потому что моя голова не вполне презентабельна, если понимаете, о чём я».~
@42354 = ~«Я хочу спросить о другом…»~
@42355 = ~«Это всё, что я хотел узнать. Прощай».~
@42356 = ~«По большей части брожу по Фестхоллу. То там, то сям, понимаете? Я не Чующий, но просто обожаю наблюдать за самыми разными людьми, толкущимися тут».~
@42357 = ~«Чующий?»~
@42358 = ~«Я хочу спросить о другом…»~
@42359 = ~«Это всё, что я хотел узнать. Прощай».~
@42360 = ~Тело мягко покачивает железную коробку, «кивая» головой, находящейся внутри: «Да… знаете, есть такое Общество Восприятия. Они рыщут повсюду, пытаясь всё прочувствовать, воображая, что таким образом они наткнутся когда-нибудь на великую тайну мультивселенной, если будут достаточно долго искать». Тело пожимает плечами.~
@42361 = ~«Я хочу спросить о другом…»~
@42362 = ~«Это всё, что я хотел узнать. Прощай».~
@42363 = ~Мертвин выглядит смущённым: «Разве не все знают о Фестхолле? Гм… что ж, это штаб-квартира Чующих и, что видимо более важно, здесь находятся сенсориумы».~
@42364 = ~«Расскажи мне о сенсориумах…»~
@42365 = ~«Чующих?»~
@42366 = ~«Я хочу спросить о другом…»~
@42367 = ~«Это всё, что я хотел узнать. Прощай».~
@42368 = ~«Мужчина у ворот сможет рассказать о них лучше, чем я, сэр… но это палаты, в которых хранятся заколдованные камни, в свою очередь содержащие записанные в них различные чувства и переживания. Общественные сенсориумы открыты для каждого, хотя есть небольшая плата за использование камней. Частные сенсориумы открыты только для членов Общества Восприятия, Чующих».~
@42369 = ~«Чующих?»~
@42370 = ~«Я хочу спросить о другом…»~
@42371 = ~«Это всё, что я хотел узнать. Прощай».~
@42372 = ~«Рейвел? Не думаю, что я знаю женщину с таким именем…»~
@42373 = ~«Тогда у меня другой вопрос…»~
@42374 = ~«В таком случае прощай».~
@42375 = ~Безголовый человек всё ещё шатается вокруг, натыкаясь на стены, колонны и прочие препятствия. Его деревянная голова опасно раскачивается на плечах, когда он шаркает туда-сюда.~
@42376 = ~«Приветствую?..»~
@42377 = ~«Приветствую?..»~
@42378 = ~«Должно быть, это тело Мертвина…»~
@42379 = ~Оставить его в покое.~
@42380 = ~~
@42381 = ~Тело Мертвина стоит, спокойно поглаживая железную коробку, в которой лежит его голова. При твоём приближении оно наклоняет коробку в твою сторону: «Ещё раз здравствуйте, благородный сэр!»~
@42382 = ~«Приветствую. У меня кое-какие вопросы, Мертвин…»~
@42383 = ~«Я просто проходил мимо, Мертвин. Прощай».~
@42384 = ~У этой прочной стальной коробки сверху толстая кожаная ручка, но способа открыть контейнер не заметно — он словно запаян. С одной стороны идёт множество очень узких щелей, однако посмотреть через них внутрь коробки не удаётся. Сквозь щели наружу сочится тошнотворно-сладкий запах гниения. Пока ты рассматриваешь ящик, он слегка покачивается в руках. В нём что-то движется! Изнутри слышится человеческий голос: «Эй, там… случаем, никого нету? Меня зовут Мертвин… кто-нибудь? Привет?»~
@42385 = ~«Да… приветствую…»~
@42386 = ~Не обращать внимания на голос, убрать коробку.~
@42387 = ~«Хвала силам! Вы, случайно, не видели моё тело? Его сложно не заметить… бродит везде с дурацкой деревянной головой… оно, должно быть, в поисках меня уже разбило ноги в кровь!»~
@42388 = ~«Да… в Фестхолле».~
@42389 = ~«Нет… не думаю…»~
@42390 = ~«В таком случае мне очень повезло! Могу я попросить вас вернуть его мне, любезный сэр?»~
@42391 = ~«Да, я это сделаю».~
@42392 = ~«А что мне с этого?»~
@42393 = ~«Может, позже. Прощай».~
@42394 = ~«Как чудесно! Благодарю вас от всего сердца, сэр. Если вы не возражаете, мы отложим разговоры до тех пор, пока я вновь не обрету своё тело».~
@42395 = ~«Погоди, я хочу спросить…»~
@42396 = ~«Ладно… прощай».~
@42397 = ~«Не сомневаюсь, сэр, при встрече с одинокой говорящей головой, заключённой в железную коробку, появляются вопросы… но придётся подождать. Очень трудно быть отделённым от своего тела, знаете ли… мои глубочайшие извинения».~
@42398 = ~«Тогда ладно. Прощай».~
@42399 = ~«М-м… моя благодарность?»~
@42400 = ~«Хорошо. Я верну тебя твоему телу».~
@42401 = ~«Я думаю, мне причитается нечто большее».~
@42402 = ~«Что ж, вместе с моим телом мы наверняка найдём что-нибудь по вашему вкусу, сэр. Но не могли бы вы сначала вернуть меня на место?»~
@42403 = ~«Хорошо, я это сделаю».~
@42404 = ~«Дай мне что-нибудь сейчас».~
@42405 = ~«Гм… видите ли, в настоящее время у меня *ничего* нет. Я *всего лишь* голова, заключённая в железную коробку».~
@42406 = ~«Ладно… я это сделаю».~
@42407 = ~«Прекрасно… тогда оставайся в своей коробке, Мертвин».~
@42408 = ~«Погодите! Погодите, добрый сэр! Послушайте; я отблагодарю вас *кое-чем*, просто сначала мне нужно вернуться к моему телу!»~
@42409 = ~«Хорошо, я это сделаю».~
@42410 = ~«Поговорим об этом позже. Прощай».~
@42411 = ~«Вот дела. Что ж, на это даже и надеяться не стоило, так? В любом случае оно, наверное, бродит по Фестхоллу, в северо-восточном углу района Клерков. Могу я убедить вас взять меня туда, любезный сэр?»~
@42412 = ~«Да, я так и сделаю».~
@42413 = ~«А что мне с того?»~
@42414 = ~«Может, позже. Прощай».~
@42415 = ~Голова Мертвина болтается, когда ты поднимаешь коробку. «O, ещё раз здравствуйте… скажите, каковы теперь мои шансы, что вы вернёте меня моему телу? Могу заверить, я буду *очень* благодарен…»~
@42416 = ~«Да, я это сделаю».~
@42417 = ~«А что мне с этого?»~
@42418 = ~«Может, позже. Прощай».~
@42419 = ~Голова Мертвина болтается, когда ты поднимаешь коробку. «Мы уже на месте, любезный сэр? Хм-м… я не *вижу* моего тела…»~
@42420 = ~«Ещё нет, но у меня кое-какие вопросы…»~
@42421 = ~«Мы ещё не пришли. До свидания».~
@42422 = ~Неожиданно из коробки раздаётся голос Мертвина: «Oх! Oх! Вот оно! Это моё тело! Ты здесь, старый друг… здесь…»~
@42423 = ~«Oх, ну же… это не очень благородно, сэр. И на что вам, в конце концов, моя голова?»~
@42424 = ~Позволить телу Мертвина взять его голову.~
@42425 = ~«Прости, придётся тебе ещё некоторое время побыть со мной. Прощай».~
@42426 = ~«Кто ты?»~
@42427 = ~«Что ты можешь рассказать об этом месте?»~
@42428 = ~«У меня нет к тебе вопросов. Прощай».~
@42429 = ~Ана'зи моргает, на её глаза накатывают слёзы, она шипит несколько слов Дак'кону.~
@42430 = ~«Что она сказала?»~
@42431 = ~«Убей её, Дак'кон. И поболезненней».~
@42432 = ~«Дак'кон, избавь её от страданий. Ей, без сомнения, очень больно, долго она не протянет».~
@42433 = ~«Уходим отсюда, Дак'кон. Скажи до свидания».~
@42434 = ~Помочь её горю.~
@42435 = ~Убить её ради забавы.~
@42436 = ~Она глазеет на тебя и что-то невнятно бормочет Дак'кону.~
@42437 = ~Дак'кон переводит на тебя взгляд и говорит: «Она не понимает твою речь. Она говорит, что умирает».~
@42438 = ~«От чего она умирает?»~
@42439 = ~«Может, тебе стоит просто убить её. Сделай это поболезненней».~
@42440 = ~«Мы можем что-нибудь для неё сделать?»~
@42441 = ~«Отлично. Нам надо идти».~
@42442 = ~«Её зовут Ан'ази. Она говорит, что раньше работала в госпитале, до того как полмесяца назад болезнь стала для неё невыносимой. От неё отказались, выгнали из дома и бросили умирать. Ей больно говорить, болезнь практически разрушила её ум. Она говорит, что нам не будет от неё никакой пользы».~
@42443 = ~«И?»~
@42444 = ~«В таком случае оставим её. Может, она поправится».~
@42445 = ~Глаза Дак'кона становятся безжизненными, но он послушно склоняет голову. Затем поворачивается к старой женщине, показывает ей Неразорванный Круг Зертимона и произносит несколько отрывистых слов. Женщина бросает на тебя полный ненависти взгляд и снова поворачивается к Дак'кону. Он обнажает свой клинок; она стоит перед ним, глядя прямо в глаза. Он замахивается…~
@42446 = ~«Остановись, Дак'кон. Давай оставим её в покое. Пошли».~
@42447 = ~«Лучше заколи её, Дак'кон. Я сказал, сделай это поболезненней».~
@42448 = ~Позволить ему зарубить её.~
@42449 = ~«*Знай*, что она не выживет. Я могу избавить её от страданий. Вот и всё. Будучи *зертом* из Народа, я обязан предоставить альтернативу».~
@42450 = ~«Сделай это. Но поболезненней».~
@42451 = ~«Так будь сострадателен, Дак'кон».~
@42452 = ~«Забудь. У нас есть другие заботы».~
@42453 = ~Дак'кон смотрит на тебя без выражения, затем поворачивается к женщине-гитцерай кланяется ей и отходит.~
@42454 = ~Дак'кон не смотрит на тебя, просто пронзает её тело своим клинком *карач*. Она испускает дух, водянистая кровь льётся у неё изо рта. Её глаза закатываются, ноги подкашиваются. Она отшатывается от удара и валится на землю.~
@42455 = ~«Пойдём отсюда».~
@42456 = ~Дак'кон обнажает клинок и ждёт, когда женщина подготовится. Она касается Неразорванного Круга Зертимона у него на шее, и её лицо принимает стоическое выражение. Движения его клинка молниеносны, и когда он завершает удар, она уже лежит в луже крови на грубых камнях сигильской улицы.~
@42457 = ~«Хороший удар, Дак'кон. Пошли».~
@42458 = ~Она касается Неразорванного Круга Зертимона у него на шее, и её лицо принимает стоическое выражение. Движения его клинка молниеносны, и когда он завершает удар, она уже лежит в луже крови на грубых камнях сигильской улицы.~
@42459 = ~«Пошли, Дак'кон».~
@42460 = ~«Её имя Ан'ази. Её болезнь смертельна. Она причиняет ей боль. Сопротивление Народа вредному воздуху, сгустившемуся в этом районе, слабее, чем у человека. Я *зерт*. Моя обязанность — предоставить альтернативу. Она сама попросила меня об этом, так как Народ боится к ней приближаться».~
@42461 = ~«Тогда сделай это. Но поболезненней».~
@42462 = ~«Так будь сострадателен, Дак'кон».~
@42463 = ~«Забудь. У нас есть другие заботы».~
@42464 = ~Мар~
@42465 = ~Браскен~
@42466 = ~Посыльный~
@42467 = ~Ты видишь болезненную женщину-гитцерай. Она вся сгорблена, её постоянный кашель, несомненно, причиняет ей боль. В руках она сжимает практически полностью пропитанный кровью и мокротами носовой платок. Женщина следит за тобой и шипит.~
@42468 = ~«Приветствую».~
@42469 = ~«Кто ты?»~
@42470 = ~«Что ты можешь рассказать об этом месте?»~
@42471 = ~«Тебе нужно лечение? Могу я что-нибудь сделать?»~
@42472 = ~«Что с тобой случилось?»~
@42473 = ~«У меня нет к тебе вопросов. Прощай».~
@42474 = ~Пожилая женщина-гитцерай выглядит ещё хуже прежнего, если такое возможно. Она пытается что-то прошипеть, но её останавливает приступ кровавого кашля.~
@42475 = ~«Тебе нужно лечение? Могу я что-нибудь сделать?»~
@42476 = ~«Что с тобой случилось?»~
@42477 = ~«Не могла бы ты ответить на мои вопросы?»~
@42478 = ~«Прощай, старая женщина».~
@42479 = ~Она кашляет и кашляет, наполняя свой мокрый платок кровавой слизью. Её глаза сверкают на тебя злобой.~
@42480 = ~«Тебе нужно лечение? Могу я что-нибудь сделать?»~
@42481 = ~«Что с тобой случилось?»~
@42482 = ~«Тогда прощай».~
@42483 = ~Она кашляет, затем машет на тебя руками и закутывается в свои лохмотья, явно желая, чтобы ей дали спокойно умереть.~
@42484 = ~«Тебе больно? Могу я хоть *чем-нибудь* помочь?»~
@42485 = ~Дать ей несколько монет.~
@42486 = ~«Слушай, просто ответь на пару вопросов…»~
@42487 = ~«Ну ладно. Прощай».~
@42488 = ~Она, с трудом пересиливая кашель, говорит несколько фраз на неизвестном тебе языке и сгибается напополам от боли, когда новая волна кашля сотрясает её тело.~
@42489 = ~«Тогда прощай».~
@42490 = ~Она выбивает деньги из твоей руки, отправив их прыгать по мостовой, и снова слабо шипит.~
@42491 = ~«Тогда прощай».~
@42492 = ~Она вскидывает ослабленные руки к небу и указывает на Кузницу, на мусор вокруг, на кучи угля, а потом на свою грудь. Словно подчеркивая её слова, новая волна кашля сотрясает её тело, оставив кровавый след на её губах.~
@42493 = ~«Это смог?»~
@42494 = ~«Могу я предложить тебе какое-нибудь лекарство?»~
@42495 = ~Она кивает и снова заходится кашлем.~
@42496 = ~«Могу я предложить тебе какое-нибудь лекарство?»~
@42497 = ~«Тогда я ничем не могу помочь. Прощай».~
@42498 = ~Её глаза темнеют, когда она указывает сначала на твоё оружие, затем на себя.~
@42499 = ~«Хочешь, чтобы я тебя убил?»~
@42500 = ~«На такое я не пойду. Прощай».~
@42501 = ~Она энергично, насколько может, трясёт головой, за что тут же расплачивается новым приступом кашля. Потом снова решительно указывает на твоё оружие. В её жёлтых глазах нет ни капли страха.~
@42502 = ~«Хорошо. Желаю удачи в следующей жизни».~
@42503 = ~«На такое я не пойду».~
@42504 = ~Она плюёт тебе под ноги кровавой слизью, когда ты поворачиваешься к ней спиной.~
@42505 = ~Оставить её в покое.~
@42506 = ~Убить её.~
@42507 = ~Женщина смело смотрит на тебя, в её глазах нет и тени страха. Она ждёт, когда ты нанесёшь ей смертельный удар.~
@42508 = ~Помочь её горю.~
@42509 = ~«Я не могу этого сделать».~
@42510 = ~Ты отправляешь её на тот свет быстрым ударом. Тело женщины валится на грубые камни улицы, но каким-то образом в ней чувствуется благодарность.~
@42511 = ~«Прощай, гитцерай».~
@42512 = ~Покупатель~
@42513 = ~Микка~
@42514 = ~Убрать~
@42515 = ~~
@42516 = ~~
@42517 = ~~
@42518 = ~Под атакой~
@42519 = ~Ты видишь офицера Гармониума. Он со скукой смотрит, как ты приближаешься.~
@42520 = ~Он бросает на тебя усталый взгляд: «Приветствую, гражданин. Третья Ступень Вортен к твоим услугам».~
@42521 = ~~
@42522 = ~~
@42523 = ~~
@42524 = ~~
@42525 = ~~
@42526 = ~~
@42527 = ~~
@42528 = ~~
@42529 = ~~
@42530 = ~~
@42531 = ~~
@42532 = ~«Разговариваю? Что ж, полагаю, да».~
@42533 = ~«Я Луис. А кто *ты?* Безмозглый, неотёсанный тип, шарящий по чужим вещам…»~
@42534 = ~«Что ж, любезный, если тебе необходимо знать… я — шкаф».~
@42535 = ~«Я стал шкафом, потому что *хочу* быть шкафом, спасибо за вопрос. А *вовсе* не чтобы смотреть на раздевающихся девушек или хранить и ощущать кожей своих ящиков их мягкое, сладко пахнущее нижнее бельё. Такого рода обвинения оскорбительны для того, кто практикует магию. Я просто хочу прочувствовать, *каково* это — быть шкафом. Виды, запахи, ощущения…»~
@42536 = ~«Да! Да, знают и всем сердцем поддерживают… ну, не совсем всем сердцем. И пока они не *сплетничают* в моём присутствии, поскольку ещё не до конца осознают, что я шкаф. А я бы не хотел, чтобы они считали меня кем-то ещё. Не стоит им вникать во все тонкости происходящего».~
@42537 = ~«Отлично! Превосходно! Открой третий ящик, ты, прохвост». Когда ты просовываешь руку в ящик, он с силой захлопывается — ты еле успеваешь вовремя убрать пальцы.~
@42538 = ~«Ха-ха! Кретин! Идиот! Я сказал: „Открой ящик“, а ты туда полез…» — он для выразительности снова хлопает ящиком и весь трясётся от смеха.~
@42539 = ~«Отлично! Превосходно! Открой третий ящик, ты, прохвост». Когда ты просовываешь руку в ящик, он с силой захлопывается и бьёт тебе прямо по пальцам. Резкая боль прокатывается по твоей руке, когда ты выдёргиваешь свои разбитые пальцы.~
@42540 = ~«Ты *ничего* мне не сделаешь! Почему? Даже самый *заурядный* человек знает, что никто не имеет права совершать акт жестокости на территории Борделя… тебя просто выкинут. Да даже если и *нет*, могу тебя заверить: я весьма неплохо владею Искусством».~
@42541 = ~«Сначала я скажу тебе одну вещь: на протяжении довольно долгого времени я тайно входил и выходил из Борделя… я довольно неплохо знаю всех его обитательниц и то, чем они занимаются. Могу заверить, что говорить кому-либо обо мне бесполезно: ты не только потеряешь потенциальный источник информации, но я просто исчезну до того, как кто-нибудь начнёт расследовать твою жалобу, оставив тебя в дураках».~
@42542 = ~«Да?»~
@42543 = ~Шкаф на минуту задумывается. «Какая мне выгода делиться секретами с такими, как ты? И кроме того, нет основания делать это сейчас, поскольку я ещё полностью не прочувствовал себя в роли шкафа. Это сложная работа: держать и перебирать мягкое кружевное белье, пахнущее завораживающими женскими запахами», — ящики то открываются, то закрываются, издаваемые звуки похожи на довольные вздохи.~
@42544 = ~«Лучше я предоставлю возможность выяснить самому, чем буду всё рассказывать… в конце концов, в этом заключается половина всех удовольствий. Я только скажу тебе то, что ты, скорее всего, уже знаешь: это заведение называется Бордель Безумной Интеллектуальной Страсти. Проститутки здесь специализируются в искусстве языка и общения».~
@42545 = ~«Да, Экко. Знаешь, она не всегда была немой. В противном случае она бы научилась какому-нибудь другому способу общения. Должно быть, это случилось недавно».~
@42546 = ~«Я бы не стал заходить так далеко, чтобы назвать её дочерью *Рейвел*, но она *точно* ночная ведьма — в этом я уверен. Посмотри на кожу, глаза, её страстную натуру и чрезмерный интерес к чужим снам… это всё верные знаки. Без сомнения, только отрицание Кезай её настоящей натуры сохранило её от превращения в старую каргу, какими становятся все ночные ведьмы».~
@42547 = ~«О да, дорогуша… я *слышал* о пропаже. Какое несчастье! Ты когда-нибудь имел удовольствие вдохнуть её изысканный аромат? — кажется, ящики шкафа дрожат от восхищения. — Он был совершенно изумителен, этот запах. Но нет, к сожалению, я не знаю, где может быть „личный аромат“ доброй леди Вивьен».~
@42548 = ~«Я слышал, раньше она постоянно ходила в малиновой вуали, но теперь не выходит из своей затемнённой комнаты. Я и не знал, что случилось. Так значит, её вуаль пропала?»~
@42549 = ~«Немногие из тех, кто хоть раз был в Сигиле, не знают о ней. Однако вынужден поинтересоваться, что именно о ней ты хотел бы узнать?»~
@42550 = ~«Знаешь, ты сумасшедший… совершенно сумасшедший. „Совсем спятил“ — по-моему, так обычно говорят. Рейвел была изгнана из Сигила давным-давно, и если она не мертва, то *удачи* тебе в её поисках. Она пожирала всех, кто находил её в былые времена, и, скорее всего, окажет тебе ту же услугу. Я бы оставил её в покое».~
@42551 = ~«Нет никакой десятой ученицы! Что за ерунду ты говоришь?»~
@42552 = ~Тебе удаётся выхватить из недр шкафа кусок ткани — полупрозрачную малиновую вуаль. Пряча её, ты замечаешь, что она надушена лёгким, экзотическим и самым восхитительным на свете благоуханием.~
@42553 = ~«Проклятие! Ты негодяй! Мошенник! Подлец! Верни мне это назад *немедленно*! Это не твоё! Это очень личная вещь, принадлежащая одной леди из этого заведения, и её не порадует, что ты играешься с её личными вещами!»~
@42554 = ~«По сравнению с тобой я не делаю ничего криминального, мои намерения чисты! Я просто погружаюсь в чувства, необходимые для моего роста как личности».~
@42555 = ~Ты просто не успеваешь сделать достаточно быстрое движение рукой, чтобы выхватить малиновую ткань из недр Луиса… и не добиваешься ничего, кроме разбитых пальцев.~
@42556 = ~«Не отдам. Ни за что. Никогда».~
@42557 = ~«*M-м-м*. Стой! Стой, тебе говорят! Аккуратнее с ручками! Не поцарапай отделку! Будь ты проклят, назойливый негодяй!» — шкаф доблестно сопротивляется, но ты наконец открываешь ящик и вырываешь оттуда кусок ткани — полупрозрачную малиновую вуаль. Пряча её, ты замечаешь, что она надушена лёгким, экзотическим и самым восхитительным на свете благоуханием.~
@42558 = ~Ящик остаётся закрытым. Ты слышишь, как он скрипит и трещит от усилий. «Убирайся *прочь*, варвар!»~
@42559 = ~«Ой, прекрати этот вздор! Это довольно утомительно и превосходит все возможные значения слова *скука*!»~
@42560 = ~«СТОЙ! Как же это занудно! Ты нагоняешь на меня дремоту».~
@42561 = ~Шкаф зевает, выставляя напоказ малиновый кусок ткани, приютившийся среди нижнего белья. Ты хватаешь его резким движением руки, прежде чем гардероб успевает закрыться. Кусок оказывается малиновой вуалью, пряча её, ты замечаешь, что она надушена лёгким, экзотическим и самым восхитительным на свете благоуханием.~
@42562 = ~Это Луис, говорящий шкаф.~
@42563 = ~Это Луис, говорящий шкаф.~
@42564 = ~От шкафа исходит лишь зловещее молчание, он не отвечает. Ты уверен, что это всё ещё Луис — ты практически *чувствуешь* ненависть, излучаемую деревом, — но он не произносит ни слова.~
@42565 = ~Ты стоишь перед шкафом наизготовку. Он всё так же выдвигает и задвигает свои ящики, но это происходит слишком быстро, чтобы ты успел вытащить кусок ткани.~
@42566 = ~«Ты *думаешь?* *ДУМАЕШЬ?!* Как ты можешь быть столь вызывающе грубым, столь смехотворно бесцеремонным, не будучи абсолютно *уверенным* в своих обвинениях?! Как ты *смеешь*! Наглый, бесстыдный хам! Почему я должен…»

Пока Луис рвёт и мечет его ящики выдвигаются и задвигаются… ты замечаешь среди другой одежды клочок малиновой ткани. Однако из-за постоянного открытия и закрытия ящиков вытащить её далеко не просто.~
@42567 = ~Просто уйти.~
@42568 = ~«Ты *разговариваешь*?»~
@42569 = ~«Кто ты?»~
@42570 = ~«Что ты здесь делаешь?»~
@42571 = ~«Пожалуй, я просто пойду. Прощай».~
@42572 = ~«Кто ты?»~
@42573 = ~«Что ты здесь делаешь?»~
@42574 = ~«Пожалуй, я просто пойду. Прощай».~
@42575 = ~«Неважно. Что ты здесь делаешь?»~
@42576 = ~«Забудь. Прощай».~
@42577 = ~«Но *почему* ты шкаф в этом борделе?»~
@42578 = ~«Это всё, что я хотел узнать. Прощай».~
@42579 = ~«Так все женщины об этом знают?»~
@42580 = ~«Хорошо. Я хотел спросить о другом…»~
@42581 = ~«Это всё, что я хотел узнать. Прощай».~
@42582 = ~«Мне от тебя кое-что понадобится, чтобы я помалкивал обо всех тонкостях».~
@42583 = ~«Мне от тебя кое-что понадобится, чтобы я помалкивал обо всех тонкостях».~
@42584 = ~«У меня к тебе пара вопросов…»~
@42585 = ~«Это всё, что я хотел узнать. Прощай».~
@42586 = ~«Я сейчас же расскажу всем об этом».~
@42587 = ~«Я порублю тебя на дрова».~
@42588 = ~«Очень смешно. У меня пара вопросов, Луис…»~
@42589 = ~Уйти.~
@42590 = ~«Прекрасно… тогда я просто пойду и расскажу всем о тебе».~
@42591 = ~«У меня кое-какие вопросы…»~
@42592 = ~«В таком случае прощай».~
@42593 = ~«Может, я просто порублю тебя на дрова».~
@42594 = ~«Понимаю. В таком случае у меня пара вопросов…»~
@42595 = ~«Ясно. Тогда прощай, Луис».~
@42596 = ~«Так… почему ты шкаф в этом борделе?»~
@42597 = ~«Ты можешь при желании вернуться в своё нормальное состояние?»~
@42598 = ~«Можешь рассказать мне об этом месте?»~
@42599 = ~«Ненни сказала, что видела, как мужчина выходил из комнаты Кимази Язык-Гадюки… я думаю, это был ты, Луис».~
@42600 = ~«Не расскажешь мне что-нибудь о молчаливой проститутке?»~
@42601 = ~«Я слышал, что Кезай-Серрис — дочь Рейвел. Это правда?»~
@42602 = ~«Я пытаюсь найти аромат Вивьен… не знаешь, где он может быть?»~
@42603 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@42604 = ~«Знаешь что-нибудь о Рейвел Клубок-Загадок?»~
@42605 = ~«Я уже говорил с девятью проститутками… ты не знаешь, где десятая ученица?»~
@42606 = ~«Неважно. Прощай».~
@42607 = ~«Я хочу спросить о другом…»~
@42608 = ~«Это всё, что я хотел узнать. Прощай».~
@42609 = ~«Я хочу спросить о другом…»~
@42610 = ~«Это всё, что я хотел узнать. Прощай».~
@42611 = ~«Я хочу спросить о другом…»~
@42612 = ~«Это всё, что я хотел узнать. Прощай».~
@42613 = ~«Я хочу спросить о другом…»~
@42614 = ~«Это всё, что я хотел узнать. Прощай».~
@42615 = ~«Я хочу спросить о другом…»~
@42616 = ~«Да. У меня другой вопрос…»~
@42617 = ~«Да, пропала. Прощай, Луис».~
@42618 = ~«Мне нужно её найти».~
@42619 = ~«Неважно. У меня другой вопрос…»~
@42620 = ~«Забудь, что я о ней спрашивал. Прощай, Луис».~
@42621 = ~«Я хочу спросить о другом…»~
@42622 = ~«Это всё, что я хотел узнать. Прощай».~
@42623 = ~«Неважно. У меня другой вопрос…»~
@42624 = ~«Забудь об этом, Луис. Прощай».~
@42625 = ~«О, а для тебя так это нормально, деревянный развратник?»~
@42626 = ~«Да-да… прощай, Луис».~
@42627 = ~«Да-да… прощай, Луис».~
@42628 = ~«Отдай мне эту малиновую ткань».~
@42629 = ~Открыть ящик и достать кусок ткани.~
@42630 = ~Открыть ящик и достать кусок ткани.~
@42631 = ~Умолять, чтобы он отдал тебе ткань.~
@42632 = ~Открыть ящик и достать кусок ткани.~
@42633 = ~Открыть ящик и достать кусок ткани.~
@42634 = ~Умолять, чтобы он отдал тебе ткань.~
@42635 = ~«Отдай мне эту малиновую ткань, Луис».~
@42636 = ~Открыть ящик и достать кусок ткани.~
@42637 = ~Умолять, чтобы он отдал тебе ткань.~
@42638 = ~«Отдай мне эту малиновую ткань».~
@42639 = ~Открыть ящик и достать кусок ткани.~
@42640 = ~Продолжать умолять.~
@42641 = ~«Отдай мне эту малиновую ткань».~
@42642 = ~Открыть ящик и достать кусок ткани.~
@42643 = ~Открыть ящик и достать кусок ткани.~
@42644 = ~Продолжать умолять.~
@42645 = ~«У меня пара вопросов, Луис…»~
@42646 = ~Оставить его в покое.~
@42647 = ~«У меня пара вопросов, Луис…»~
@42648 = ~Оставить его в покое.~
@42649 = ~«Пока, Луис».~
@42650 = ~Уйти.~
@42651 = ~Постараться просунуть руку, пока ящик открыт.~
@42652 = ~Постараться просунуть руку, пока ящик открыт.~
@42653 = ~Всё же сделать попытку.~
@42654 = ~Всё же сделать попытку.~
@42655 = ~Подождать, когда представится возможность.~
@42656 = ~Цепь слегка тёплая, как будто живая. Ты замечаешь различные зубцы, маленькие крючки, иголки и другие мелкие острые кусочки, приваренные к цепи по всей её длине.~
@42657 = ~Дотронуться до цепи.~
@42658 = ~Уйти.~
@42659 = ~Уйти.~
@42660 = ~Ты кладёшь руку на полотно, не совсем зная, чего ожидать… но, к твоему удивлению, пальцы ощущают лишь мазки краски по холсту.~
@42661 = ~Поверхность картины сильно пахнет морским воздухом.~
@42662 = ~Понюхать картину.~
@42663 = ~Дотронуться до картины.~
@42664 = ~Уйти.~
@42665 = ~Понюхать картину.~
@42666 = ~Уйти.~
@42667 = ~Дотронуться до картины.~
@42668 = ~Уйти.~
@42669 = ~Ты стараешься изо всех сил, но не можешь извлечь из рога ни единого звука. Оторвав губы от рога, ты чувствуешь привкус крови, дыма и металла.~
@42670 = ~Уйти.~
@42671 = ~Уйти.~
@42672 = ~Уйти.~
@42673 = ~Уйти.~
@42674 = ~Дотронуться до картины.~
@42675 = ~Уйти.~
@42676 = ~Как ни странно, в поверхности картины нет ничего необычного.~
@42677 = ~Уйти.~
@42678 = ~Уйти.~
@42679 = ~Уйти.~
@42680 = ~Уйти.~
@42681 = ~Это гротескный портрет старой-престарой карги с длинным крючковатым носом. Её кожа болезненного серо-голубого цвета, глаза горят красным светом, как угольки затухающего огня. Её длинный острый подбородок сильно выступает вперёд, два жёлтых клыка, как маленькие бивни, торчат вверх из нижней челюсти. Злая улыбка на иссохших лиловых губах говорит о какой-то страшной тайне. Табличка гласит: «Серая ведьма Оиноса».~
@42682 = ~Когда ты уже собираешься отвернуться от картины, что-то привлекает твоё внимание… странное чувство возникает в глубине души… воспоминания всплывают на поверхность…~
@42683 = ~Ты вспоминаешь себя стоящим в лабиринте из колючего кустарника, сбитым с толку. Отвратительная старуха с картины стоит перед тобой, безумно хихикая. Ты раздражённо сжимаешь зубы, пытаясь понять, почему она над тобой смеётся. «Мой бедный, дорогой, любимый человечек! — мурлыкает она. — Да ведь это же было твоё *первое* желание!» Она указывает одним из своих костлявых когтистых пальцев на твой лоб. У тебя начинает болезненно стучать в висках… и больше ты ничего не можешь вспомнить.~
@42684 = ~Уйти.~
@42685 = ~~
@42686 = ~Уйти.~
@42687 = ~Попытаться вспомнить всё.~
@42688 = ~Отвернуться и подавить в себе воспоминания.~
@42689 = ~Уйти.~
@42690 = ~~
@42691 = ~Ты прижимаешь ладонь к холсту… сама рябь не чувствуется, однако при первом прикосновении твою руку охватывает ощущение пощипывающей прохлады.~
@42692 = ~~
@42693 = ~Дотронуться до картины.~
@42694 = ~~
@42695 = ~~
@42696 = ~Уйти.~
@42697 = ~~
@42698 = ~Уйти.~
@42699 = ~~
@42700 = ~~
@42701 = ~~
@42702 = ~~
@42703 = ~~
@42704 = ~Уйти.~
@42705 = ~~
@42706 = ~Ты протягиваешь руку, чтобы дотронуться до двигающихся волнами кусочков стекла, но обнаруживаешь, что не можешь этого сделать… твоя рука останавливается прямо у поверхности стекла.~
@42707 = ~~
@42708 = ~Ты добиваешься только синяков на костяшках пальцев; стекло с тем же успехом может быть сделанным из железа.~
@42709 = ~Дотронуться до кусочков стекла.~
@42710 = ~Уйти.~
@42711 = ~~
@42712 = ~~
@42713 = ~~
@42714 = ~Ударить стекло кулаком.~
@42715 = ~~
@42716 = ~~
@42717 = ~Уйти.~
@42718 = ~Уйти.~
@42719 = ~Ты прижимаешь ладонь к картине… как ты и подозревал, холст физически не двигается, меняется лишь рисунок.~
@42720 = ~Дотронуться до картины.~
@42721 = ~Уйти.~
@42722 = ~Уйти.~
@42723 = ~~
@42724 = ~~
@42725 = ~~
@42726 = ~~
@42727 = ~~
@42728 = ~~
@42729 = ~~
@42730 = ~Твой лим-лим выглядит наполовину животным, наполовину насекомым по происхождению. У него огромного размера ноги, но ручки маленькие, почти рудиментарные. Спина наполовину покрыта панцирем в ярких пятнышках. С боков у него поигрывает пара двойных крыльев как у насекомого, глаза маленькие и чёрные, а рот словно постоянно радостно улыбается.~
@42731 = ~«Пийо! Пийо!» — лим-лим весело скачет вокруг, его крылышки стрекочут. Кажется, ему чрезвычайно приятно твоё внимание.~
@42732 = ~Ты пытаешься с размаху отвесить пинка лим-лиму, но он шустро отскакивает в сторону. «Пийо!» — он поворачивается и бежит, стрекоча крыльями.~
@42733 = ~Осмотреть лим-лима.~
@42734 = ~Взять лим-лима на руки.~
@42735 = ~Приласкать лим-лима.~
@42736 = ~Пнуть лим-лима.~
@42737 = ~Перестать играть с лим-лимом.~
@42738 = ~Взять лим-лима на руки.~
@42739 = ~Приласкать лим-лима.~
@42740 = ~Пнуть лим-лима.~
@42741 = ~Перестать играть с лим-лимом.~
@42742 = ~Взять лим-лима на руки.~
@42743 = ~Приласкать лим-лима ещё разок.~
@42744 = ~Пнуть лим-лима.~
@42745 = ~Перестать играть с лим-лимом.~
@42746 = ~Позволить ему бежать.~
@42747 = ~Погнаться за ним и попытаться пнуть снова.~
@42748 = ~Опустить лим-лима немного поиграть.~
@42749 = ~Приласкать лим-лима.~
@42750 = ~Пнуть лим-лима.~
@42751 = ~Перестать играть с лим-лимом.~
@42752 = ~Твой лим-лим выглядит наполовину животным, наполовину насекомым по происхождению. У него огромного размера ноги, но ручки маленькие, почти рудиментарные. Спина наполовину покрыта панцирем в ярких пятнышках. С боков у него поигрывает пара двойных крыльев как у насекомого, глаза маленькие и чёрные, а рот словно постоянно радостно улыбается.~
@42753 = ~Опустить лим-лима немного поиграть.~
@42754 = ~Приласкать лим-лима.~
@42755 = ~Пнуть лим-лима.~
@42756 = ~Перестать играть с лим-лимом.~
@42757 = ~«Пийо! Пийо!» — лим-лим весело извивается, его крылышки стрекочут. Кажется, ему чрезвычайно приятно твоё внимание.~
@42758 = ~Опустить лим-лима немного поиграть.~
@42759 = ~Приласкать лим-лима ещё разок.~
@42760 = ~Пнуть лим-лима.~
@42761 = ~Перестать играть с лим-лимом.~
@42762 = ~Ты пытаешься подбросить и пнуть лим-лима, но он выскальзывает из твоих рук и летит к земле!~
@42763 = ~«Ой…»~
@42764 = ~~
@42765 = ~Этот сводчатый проход всего на несколько дюймов уходит внутрь небольшого здания, а затем упирается в сплошную стену хлама. Мусор слежался так плотно, что по твёрдости не уступает камням или цементу.~
