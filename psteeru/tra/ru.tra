@31138 = ~Попытаться его перебить.~
@31139 = ~«Она отняла власть над Сигилом у силы? Как ты об этом узнал?»~
@31140 = ~«Один её вид сводит людей с ума?»~
@31141 = ~«У меня ещё вопросы о Сигиле…»~
@31142 = ~«У меня вопросы о другом…»~
@31143 = ~«Это всё, что я хотел узнать. Прощай».~
