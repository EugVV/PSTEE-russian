@33664 = ~«Прекратите драку, а то я вас обоих в кровь изобью».~
@33665 = ~«Прекратите драку, а то я вас обоих в кровь изобью».~
@33666 = ~«Прекрасно… прощай».~
@33667 = ~«Рад, что всё разрешилось таким образом. Прощай».~
@33668 = ~«Рад, что всё разрешилось таким образом. Прощай».~
@33669 = ~«Спасибо. Прощай».~
@33670 = ~Этот громкоголосый угрюмый парень неспешно подходит к тебе и отвешивает быстрый поклон: «Привет, здоровяк! Всего один медяк за мои услуги проводника! Куда-нить направить?»~
@33671 = ~Этот громкоголосый угрюмый парень быстро замечает твоё внимание: «Рад встрече, здоровяк! Всего один медяк за мои услуги проводника! Куда-нить направить?»~
@33672 = ~Человек поднимает бровь, потом пожимает плечами: «Типа гида, здоровяк… указываю всё, чё те надо найти в этом районе Улья».~
@33673 = ~Парень прячет в кулаке монетку и кланяется: «Ворота из этой части Улья ведут на восток, север и юго-запад; из известных мест тут ночлежка, где уставший работяга может немного отдохнуть».~
@33674 = ~«Прям в середине этой части Улья, здоровяк… длинное узкое здание с дверями на юго-восток. Годное место для ночлега, если малость измотан».~
@33675 = ~«К Площади Мусорщиков, здоровяк… там ошиваются все Сборщики».~
@33676 = ~«К другой части Улья, здоровяк. Там Мортуарий и бар „Собиратели пыли“, где любят выпивать Пыльные. Ещё там мавзолей и большой Мемориал Пыльных».~
@33677 = ~«Просто в другую часть Улья, здоровяк. Там находится офис контроля за паразитами и болезнями и большой рынок».~
@33678 = ~«Что такое проводник?»~
@33679 = ~«Конечно… вот твоя монетка».~
@33680 = ~«Нет, пока никуда. Прощай».~
@33681 = ~«Что такое проводник?»~
@33682 = ~«Конечно… вот твоя монетка».~
@33683 = ~«Нет, пока никуда. Прощай».~
@33684 = ~«Хорошо… вот твоя монетка».~
@33685 = ~«Никаких указаний сегодня, спасибо. Прощай».~
@33686 = ~«Где находится ночлежка?»~
@33687 = ~«Куда ведут северные ворота?»~
@33688 = ~«Куда ведут восточные ворота?»~
@33689 = ~«Куда ведут юго-западные ворота?»~
@33690 = ~«Это всё, что я хотел узнать. Прощай».~
@33691 = ~«Куда ведут северные ворота?»~
@33692 = ~«Куда ведут восточные ворота?»~
@33693 = ~«Куда ведут юго-западные ворота?»~
