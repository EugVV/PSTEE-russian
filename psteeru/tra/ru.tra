@19330 = ~~
@19331 = ~~
@19332 = ~«Нет! Харгримм, нет! Я бы никогда не осмелился…»~
@19333 = ~«Где твой дневник? Дай мне его. Докажи свою невиновность перед лицом Безмолвного Короля».~
@19334 = ~«Я… я…»~
@19335 = ~«Я взываю к твоему милосердию, Харгримм…»~
@19336 = ~«Перемирие Мёртвых защитит тебя здесь, Соэго. Но ты никогда не покинешь этих подземелий. Ты продолжишь поиски твоей драгоценной „Истинной Смерти“ здесь, в одиночестве… до конца дней своих. Прощай».~
@19337 = ~«Упыри… присматривайте за этим человеком. Не позволяйте ему уйти или с кем-либо разговаривать. Приносите по необходимости воду и еду».~
@19338 = ~Гискорл~
@19339 = ~Квинт Торговец-Трупами~
@19340 = ~Ломбард Броки и Микки~
@19341 = ~Жена Ангияра~
@19342 = ~Офис контроля за паразитами~
@19343 = ~Старая Меббет~
@19344 = ~Швея Марта~
@19345 = ~Кабинет Фелла~
@19346 = ~Сейчас~
@19347 = ~Двойной класс~
@19348 = ~Выбрать~
@19349 = ~Поначалу кажется, что это разлагающееся мужское тело совершенно не осознаёт твоего присутствия. Однако когда ты подходишь ближе, оно медленно кивает, как бы приветствуя.~
@19350 = ~Зомби тихо стонет в ответ: «Гнху-у-у… фн-н-ну-у-ух…» С каждым выдохом воздух наполняет зловоние гниющего мяса.~
@19351 = ~«Сту-у-ух-х… м-ма-а-ау-ухр-р…» — зомби невнятно стонет… ничего разобрать не получается.~
@19352 = ~Зомби тихо стонет в ответ. Только твой навык общения с мёртвыми позволяет разобрать, что он говорит: «При-и-иве-ет».~
@19353 = ~Тело мнётся с ноги на ногу, прежде чем ответить: «Во-опро-ошы?»~
@19354 = ~КЛАСС~
@19355 = ~УМЕНИЯ~
@19356 = ~НАЗНАЧЕНИЕ ОП~
@19357 = ~Тело сонно кивает: «Вопро-ош-шы?»~
@19358 = ~Следует длинная пауза. «А-а-а-а? — пожимает плечами зомби, одно плечо поднимается несколько выше другого. — Спрос-си-и М-мэ-эри, Ту-у-ух-хлую Мэ-э-эри».~
@19359 = ~«До-ом-м. М-м-мой дом-м, — остатки мускулов на лице растягиваются в гримасу, которую можно толковать как улыбку. — Стран-на-а-а Безмолвн-н-н Короля-а-а, Мё-ортв-вы-ые Наро-оды».~
@19360 = ~НОВАЯ ЖИЗНЬ~
@19361 = ~УНИВЕРСАЛ~
@19362 = ~ИЗГОНЯЮЩИЙ~
@19363 = ~ПРИЗЫВАЮЩИЙ~
@19364 = ~ПРОРИЦАТЕЛЬ~
@19365 = ~ЧАРОВНИК~
@19366 = ~ИЛЛЮЗИОНИСТ~
@19367 = ~ЗАКЛИНАТЕЛЬ~
@19368 = ~НЕКРОМАНТ~
@19369 = ~ПРЕОБРАЗОВАТЕЛЬ~
@19370 = ~Универсал~
@19371 = ~Изгоняющий~
@19372 = ~Призывающий~
@19373 = ~Прорицатель~
@19374 = ~Чаровник~
@19375 = ~Зомби таращит на тебя глаза: «Сво-ою-у-у рабо-оту-у. Служ-жу-у Безмлов-в Королю-у. Ка-ак сле-едуе-ет слежу-у-у за-а до-о-омом-м».~
@19376 = ~Иллюзионист~
@19377 = ~«М-мно-огие. Мы-ы-ы, с-скеле-еты-ы, упыри-и, — он медленно поднимает руку и указывает на восток. — Кры-ыс-сы». Его рука с трудом поворачивается и показывает на тебя: «Жив-ву-у-ущие-е».~
@19378 = ~Заклинатель~
@19379 = ~Некромант~
@19380 = ~«М-мно-огие. Мы-ы-ы, с-скеле-еты-ы, упыри-и, — он медленно поднимает руку и указывает на восток. — Кры-ыс-сы».~
@19381 = ~Преобразователь~
@19382 = ~Голова трупа мотается взад-вперёд: «С-соэ-э-эго-о…»~
@19383 = ~«Пы-ы-ыл-льный. С-спроси-и М-мэ-эри, Тух-х-хлую М-мэ-э-эри».~
@19384 = ~Зомби кладёт гниющую руку на грудь, тронутую разложением. «С-си-ильные-е!» Он показывает одной своей рукой на ногу, потом на висок, плоть рядом с которым отслоилась, открывая голую кость. «М-м-ме-е-едленные. Хе-ех-х… — труп издаёт раздражающий булькающий звук, немного напоминающий хихиканье. — В-в-ведё-о-от Тух-х-хлая М-мэ-эри-и…»~
@19385 = ~«Кто-о? Ко-ости-и? Упы-ыри-и-и?»~
@19386 = ~«Ко-о-ости-и! — его голос звучит почти восхищённо. — Руководя-а-ат, в-веду-у-ут нас-с! Вме-ес-сте с-стро-о-оим Мё-о-ортвые Наро-оты-ы».~
@19387 = ~«Х-харгри-и-имм в-ведё-о-от ко-о-сти-и. Гов-вори-ит с Безмолв-в Королё-о-ом, пото-ом-м передаё-о-от Мэ-эри-и. Она-а говори-ит с на-ами-и, даё-о-от на-ам рабо-о-оту», — он кивает.~
@19388 = ~Он снова медленно поднимает руку и показывает на восток. «Кр-ры-ы-ысы-ы… — мокрые лохмотья его верхней губы в оскале обнажают жёлто-коричневые зубы, между зубов сочится и капает вниз густая чёрная жидкость. — Едя-а-ат мё-ортвы-ых… едя-а-ат… пло-охи-ие. Ща-а-ас боя-а-атс-ся-а упыре-ей. Держатся-а да-алеко-о».~
@19389 = ~«Э-э-э… с-спроси-и М-мэ-эри, Тух-х-хлую М-мэ-э-эри».~
@19390 = ~Зомби показывает на живот, похожий на пособие по анатомии — через гниющие дыры в плоти видны все внутренние органы: «Вс-сегда-а го-олодны-ы… Безмо-олв-в Коро-оль не-е даё-о-от им е-есть мё-о-ортвы-ых ту-ут. Упыри-и охраня-а-ают на-ас, защища-ают э-эти за-алы-ы».~
@19391 = ~«Кры-ысы-ы. И… — он тянет руку и показывает наверх, — живу-у-ущие-е све-ерх-ху. Они-и обкра-ады-ываю-ут мё-ортвы-ых-х, беспоко-о-оят их».~
@19392 = ~«Он-на-а ведё-о-от нас-с. Смо-отрит за на-ами. Несё-о-от с-сло-ово Безмо-олв-в Короля-а-а».~
@19393 = ~«Влады-ыка Мё-о-ортвы-ых Наро-одов-в. С-спроси-и М-мэ-эри, Тух-х-хлую М-мэ-э-эри».~
@19394 = ~Труп стоит неподвижно, уставившись на тебя. В конце концов он говорит: «Н-не-е-ет. С-спроси-и М-мэ-эри, Тух-х-хлую М-мэ-э-эри».~
@19395 = ~Зомби поворачивается к тебе, в его мёртвых глазах мелькает искра узнавания. «У-ух-ху-у-у».~
@19396 = ~Труп качает головой: «С-спроси-и М-мэ-эри, Тух-х-хлую М-мэ-э-эри».~
@19397 = ~«Приветствую…»~
