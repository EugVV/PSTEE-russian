@34914 = ~*Фырк*~
@34915 = ~::Смешок::~
@34916 = ~«З-з-забы-ыла с-своё и-им-м-мя…»~
@34917 = ~«М-моё и-им-м-мя?..»~
@34918 = ~::Стонет::~
@34919 = ~«Жду с нетерпением».~
@34920 = ~Этот труп тяжело ковыляет по треугольной траектории. Дойдя до одной из вершин треугольника, он останавливается, затем разворачивается и направляется к следующей вершине. Сбоку на черепе у него вытатуировано «965». При твоём приближении он останавливается и таращит на тебя глаза.~
@34921 = ~~
@34922 = ~Этот труп тяжело ковыляет по треугольной траектории. Дойдя до одной из вершин треугольника, он останавливается, затем разворачивается и направляется к следующей вершине. Сбоку на черепе у него вытатуировано «965». При твоём приближении он останавливается и таращит на тебя глаза.~
@34923 = ~«Так… зачем ты ходишь по этому треугольнику?»~
@34924 = ~~
@34925 = ~~
@34926 = ~~
@34927 = ~Труп тупо глазеет на тебя.~
@34928 = ~Оставить труп в покое.~
@34929 = ~~
@34930 = ~~
@34931 = ~Этот труп волочит ноги от плиты к плите, бинтуя лежащих на них мертвецов. На его левом виске вырезан номер «396», губы плотно сшиты. Ты замечаешь в руках у трупа рулон бинтов… бинты выглядят вполне пригодными.~
@34932 = ~«Ты не против, если я позаимствую у тебя эти бинты?»~
@34933 = ~Труп продолжает пялиться на тебя.~
@34934 = ~Постараться забрать у зомби бинты.~
@34935 = ~«Ты не против, если я позаимствую у тебя эти бинты?»~
@34936 = ~Постараться забрать у зомби бинты.~
@34937 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@34938 = ~Труп не реагирует. Похоже, он слишком «далеко», чтобы отвечать на любые твои вопросы.~
@34939 = ~Оставить труп в покое.~
@34940 = ~Использовать на трупе «Разговор с мёртвыми».~
@34941 = ~«Приятно было пообщаться. Прощай».~
@34942 = ~Мясистая голова трупа в какой-то момент была ровно отрублена и наспех пришита обратно. Несколько разных рядов швов — все в той или иной степени разошедшиеся — видимо, следы того, что она постоянно заваливалась назад и пришивалась обратно за время его работы. Номер «79» вырезан на его виске, окружённом зубчатым кругом, который, похоже, был наклеймён на лоб.~
@34943 = ~«Так… что-нибудь интересненькое происходит?»~
@34944 = ~Труп продолжает пялиться на тебя.~
@34945 = ~Оставить труп в покое.~
@34946 = ~Рассмотреть зубчатый круг.~
@34947 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@34948 = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@34949 = ~Труп не отвечает. Кажется, он витает слишком далеко, чтобы отвечать на твои вопросы.~
@34950 = ~Оставить труп в покое.~
@34951 = ~«Приятно было пообщаться. Прощай».~
@34952 = ~Оставить труп в покое.~
@34953 = ~На лбу этого трупа чернилами написан номер «1201». Потёки чернил покрывают его глаза, щёки и подбородок. Проследив за следами чернильных слёз на лице трупа, ты замечаешь, что они проходят через швы на его губах. Твой взгляд задерживает нечто похожее на уголок записки, торчащей изо рта мертвеца.~
@34954 = ~Попробовать вытащить записку.~
@34955 = ~Во рту зомби виднеется записка, заляпанная гноем. Если ты попробуешь вытащить её через накрест наложенные стежки — это разорвёт бумагу в клочья. А если убьёшь труп, то, скорее всего, уничтожишь и послание. Тебе придётся найти способ аккуратно удалить швы и достать записку.~
@34956 = ~Использовать скальпель, чтобы разрезать стежки.~
@34957 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@34958 = ~Использовать на трупе «Разговор с мёртвыми».~
@34959 = ~«Приятно было пообщаться. Прощай».~
@34960 = ~Ты аккуратно разрезаешь все стежки до последнего, и челюсти открываются. Затем аккуратно вытаскиваешь записку изо рта трупа… несмотря на состояние бумаги, надпись на ней довольно разборчивая.

^NПРИМЕЧАНИЕ. <READSTUFF>^-~
@34961 = ~Внимательно осмотреть труп ещё раз.~
@34962 = ~Оставить труп в покое.~
