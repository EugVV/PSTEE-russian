@50302 = ~«Понятно».~
@50303 = ~«Приветствую».~
@50304 = ~Существо поворачивается к тебе, и вокруг его головы появляется ряд символов. Символы слабо светятся и просто… парят в воздухе.~
@50305 = ~Попытаться вступить в разговор и посмотреть, сможешь ли ты разобрать, о чём говорит дабус.~
@50306 = ~Попытаться вступить в разговор и посмотреть, сможешь ли ты разобрать, о чём говорит дабус.~
@50307 = ~Попытаться заговорить с существом и посмотреть, сможешь ли ты понять его.~
@50308 = ~«У меня к тебе вопросы…»~
@50309 = ~«Прости… я тебя не понимаю».~
@50310 = ~«Морте, можешь перевести мне, что он говорит?»~
@50311 = ~«Морте, можешь перевести мне, что он говорит?»~
@50312 = ~«Морте, можешь перевести мне, что он говорит?»~
@50313 = ~«Морте, можешь перевести мне, что он говорит?»~
@50314 = ~«Анна, можешь перевести мне, что он говорит?»~
@50315 = ~«Дак'кон, можешь перевести, что он говорит?»~
@50316 = ~«Падшая Грейс, можешь перевести, что он говорит?»~
@50317 = ~«Неважно. Прости, что побеспокоил. Прощай».~
@50318 = ~«Приветствую».~
@50319 = ~Существо поворачивается к тебе, и вокруг его головы появляется ряд символов. Символы слабо светятся и просто… парят в воздухе.~
@50320 = ~«О, во имя сил! Долбаный дабус».~
@50321 = ~«Что не так?»~
@50322 = ~«Он дабус. Они „говорят“ загадками, этими раздражающими словесными головоломками. Если *ты* не знаешь, что он говорит, тогда нам лучше найти местного или какой-то другой способ общаться с дабусом… если мы захотим. Неприятные типы. Бьюсь об заклад, они *могут* говорить, просто скорее пошлют собеседника куда подальше, пытаясь запудрить ему мозги тем, что сказали».~
@50323 = ~«Что такое „дабус“?»~
@50324 = ~«Ходят слухи, что они уборщики Госпожи Боли. Они плавают вокруг, ломая, чиня, латая Сигил по её капризам. Они хуже, чем трупные мухи, — Морте вздыхает. — И их нельзя прихлопнуть, а то Госпожа… расстроится».~
@50325 = ~«„Госпожа Боли“? Кто это?»~
@50326 = ~«Она заправляет в этом городе. Ты узнаешь её, если увидишь: вокруг её лица эти клинки, она ростом примерно с великана и парит над землёй, вот как эти ребятки, — Морте кивает на дабуса, который смотрит на вас обоих. — Никто толком о ней не знает… она же много не говорит. Всё, что тебе нужно знать, — не зли её. Если ты её увидишь, мой тебе совет: драпай».~
@50327 = ~«Ясно».~
@50328 = ~«Что ты можешь рассказать мне о Госпоже Боли?»~
@50329 = ~«Понятно».~
@50330 = ~Оставить существо в покое.~
@50331 = ~Ты видишь дабуса. Он одет в длинные ниспадающие одежды и невысоко парит над землёй.~
@50332 = ~«Приветствую».~
@50333 = ~Оставить дабуса в покое.~
@50334 = ~Ты видишь дабуса. Он одет в длинные ниспадающие одежды и невысоко парит над землёй.~
@50335 = ~Он поворачивается к тебе лицом, и ряд символов появляется вокруг его головы. (Я должен выполнять свои обязанности. Нет времени говорить.)~
@50336 = ~Дабус слегка склоняет голову набок. Множество символов вьётся вокруг его головы, большая часть выражает удивление и горе, а не слова. (Мёртвый? Где?)~
@50337 = ~Дабус ненадолго задерживает на тебе взгляд, затем отвешивает лёгкий поклон и уплывает в направлении заброшенного здания.~
@50338 = ~Дабус поворачивается к тебе, и вокруг его головы появляется ряд символов. Символы слабо светятся и просто… парят в воздухе.~
@50339 = ~Дабус слегка склоняет голову набок. Множество символов вьётся вокруг его головы. Хотя ты не можешь понять их смысл, но замечаешь, что конец фразы украшен ярко сверкающим знаком вопроса.~
@50340 = ~«Приветствую».~
@50341 = ~«Приветствую».~
@50342 = ~Оставить дабуса в покое.~
@50343 = ~«Понимаю. Я просто думаю, тебе стоит знать, что я нашёл на этой улице тело дабуса».~
@50344 = ~~
@50345 = ~Правда: «Он лежит в заброшенном здании недалеко отсюда. Похоже, он каким-то образом пойман внутри».~
@50346 = ~Ложь: «Он лежит в заброшенном здании недалеко отсюда. Я не знаю, как он умер».~
@50347 = ~«Прощай».~
@50348 = ~«Э-э… я просто думаю, тебе стоит знать, что я нашёл на этой улице тело дабуса».~
@50349 = ~~
@50350 = ~Правда: «Он лежит в заброшенном здании недалеко отсюда. Похоже, он каким-то образом пойман внутри».~
@50351 = ~Ложь: «Он лежит в заброшенном здании недалеко отсюда. Я не знаю, как он умер».~
@50352 = ~~
@50353 = ~~
@50354 = ~~
@50355 = ~Ты видишь мёртвое тело дабуса. Воняет от него совершенно невообразимо, и, судя застывшей неестественной позе, трупное окоченение зашло уже далеко. Однако эта картина почему-то вызывает у тебя необъяснимое возбуждение.~
@50356 = ~Использовать на теле способность «Разговор с мёртвыми».~
@50357 = ~Несколько секунд кажется, что ничего не происходит. Затем внезапно слабый порыв хриплого дыхания исторгается из открытого рта трупа.~
@50358 = ~«Эй? Ты слышишь меня?»~
@50359 = ~Непродолжительное молчание, затем рот трупа без предупреждения начинает двигаться: «Конечно, я тебя слышу! Я сдох, а не глух… полудурок».~
@50360 = ~«Спокойно… я всего лишь хочу задать тебе пару вопросов».~
@50361 = ~«Вопросы? Я тебе что, справочник, отсос?»~
@50362 = ~«Что это за жаргон… разве ты не должен говорить ребусами, дабус?»~
@50363 = ~«Проклятье! Ты просто тупой осёл. Все знают, что смерть — универсальный язык. Какого же дьявола я должен тужиться, выдавая эти драные символы твоей заднице, которая хоть бы что-то понимала в них? Ну, и как тебе эта загадка? И это ещё более-менее цивильно, попа с ручкой».~
@50364 = ~«Можешь ты в конце концов сказать мне, как умер, чтобы я уже разделался с этим долбаным заданием Беременной Улицы и отправился в Нижний район?»~
@50365 = ~«Другой разговор, начальник. Короче, типа вот. Я пошёл в эту Улицу посмотреть, чё происходит, какого дьявола дома меняются и всё такое. Ну, я впёрся в этот вот клоповник, а потом все двери и окна просто закрылись. Я попался и выхода не было. Я хотел раздолбать стенку, но, как только начинал, эта дрянь чинила себя и всё».~
@50366 = ~«Спасибо, ты мне очень помог».~
@50367 = ~«Не бери в голову, дурилка!»~
@50368 = ~Уйти.~
@50369 = ~«Можешь ты в конце концов сказать мне, как умер, чтобы я уже разделался с этим долбаным заданием Беременной Улицы и отправился в Нижний район?»~
@50370 = ~Оставить труп разлагаться в мире.~
@50371 = ~Ты видишь мёртвое тело дабуса. Воняет от него совершенно невообразимо, и, судя застывшей неестественной позе, трупное окоченение зашло уже далеко. Однако эта картина почему-то вызывает у тебя необъяснимое возбуждение.~
@50372 = ~Использовать на теле способность «Разговор с мёртвыми».~
@50373 = ~Оставить труп разлагаться в мире.~
@50374 = ~Мёртвый дабус больше ничего не может тебе сказать. Попытайся опять, когда Стив засунет в него финальный диалог.~
@50375 = ~Уйти.~
@50376 = ~Это записи покойного лингвиста Фина Андли. Они состоят из его исследований языка уйо… который кажется поразительно похожим на надписи, обнаруженные тобой на головоломке-додекаэдре.~
@50377 = ~Прочитать их внимательно. Проверить, не пробуждают ли они воспоминаний.~
@50378 = ~Отложить их.~
@50379 = ~Я прочитал заметки лингвиста Фина Андли и понял, что уже знаю язык, на котором написана головоломка-додекаэдр, — мёртвый язык уйо. Теперь я наконец смогу его прочитать.~
@50380 = ~Читая заметки Фина Андли о его исследованиях мёртвого языка уйо, ты чувствуешь ритмичную пульсацию в висках, и воспоминания начинают пробуждаться… воспоминания об этом языке.

Ты вспоминаешь буквы, слова, фразы, пока пелена, закрывавшая в твоём разуме язык, не спадает целиком — словно ветер от Шпиля разгоняет ядовитый смог Кузницы. Теперь ты сможешь прочитать написанное в додекаэдре.~
@50381 = ~Отложить заметки.~
@50382 = ~Это записи покойного лингвиста Фина Андли. Они состоят из его исследований языка уйо.~
@50383 = ~Отложить их.~
@50384 = ~Это старый, выцветший, безобидный на вид пергаментный свиток, перевязанный красной лентой и слегка пахнущий плесенью. Ленту удерживает на месте простая восковая печать.~
@50385 = ~Сломать печать, открыть свиток, прочитать его.~
@50386 = ~Отложить свиток.~
@50387 = ~Свиток содержит несколько строк шаткой каллиграфии и странную руну. Надпись гласит:

«может быть, это не УБЬЁТ тебя, но ЗАДЕРЖИТ, я УВЕРЕН»
«ПЕРЕСТАНЬТЕ ПРЕСЛЕДОВАТЬ МЕНЯ, ВОРОВАТЫЕ УБЛЮДКИ, это МОЁ тело МОЁ МОЁ МОЁ»
«теперь… УМРИ»~
@50388 = ~«Что за?..»~
@50389 = ~~
@50390 = ~~
@50391 = ~Додекаэдр~
@50392 = ~Додекаэдр~
@50393 = ~Леденец!~
@50394 = ~Это заклинание уже есть в книге заклинаний персонажа.~
@50395 = ~Книга заклинаний персонажа уже содержит максимальное количество заклинаний этого уровня.~
@50396 = ~Магический предмет!~
@50397 = ~Улика!~
@50398 = ~Сумка монет~
@50399 = ~То, что ты поначалу принял за невзрачную книжицу, запертую на маленький латунный замок, на самом деле оказывается томом, переплетённым в необыкновенного вида кожу и обрамлённым зачарованной бронзой. Называется книга просто: «Кодекс Невероятного».~
@50400 = ~Открыть её… и прочитать!~
@50401 = ~С благоговением отложить книгу.~
@50402 = ~Ты отпираешь замки книги и открываешь её. От одного взгляда на содержание книги твоя челюсть отвисает. Ты стоишь, зачарованный, листая её страницы. Она содержит слишком многое, чтобы это можно было описать: простые слова кажутся бессильными для тех чудес, которые она содержит.~
@50403 = ~«Это было… это… я…»~
@50404 = ~Рупор Хранилища Девятого Мира~
@50405 = ~«Это было… это… я…»~
@50406 = ~Минуту ты задумчиво стоишь, глядя на Кодекс, потом закрываешь его и с благоговением убираешь.~
@50407 = ~Уйти.~
@50408 = ~Кодекс Невероятного переплетён в необыкновенного вида кожу и зачарованную бронзу. Он содержит больше, чем ты можешь описать — такие чудеса, что слова бессильны.~
@50409 = ~С благоговением отложить книгу.~
@50410 = ~«Что? Что? Что там было, шеф?»~
@50411 = ~«Я не знаю, что и сказать, Морте…»~
@50412 = ~«Ничего, что касается тебя, Морте».~
@50413 = ~Показать ему Кодекс.~
@50414 = ~«ЧТО?! Ты что, издеваешься, да? Ну-ка, дай посмотреть!»~
@50415 = ~Показать ему Кодекс.~
@50416 = ~«Нет, Морте. Просто забудь, что ты её видел».~
@50417 = ~Морте недовольно ворчит… но оставляет тему.~
@50418 = ~Морте заглядывает тебе через плечо, чтобы рассмотреть содержимое Кодекса. Его глаза, кажется, вот-вот выскочат из орбит, когда он просматривает страницы: «О-о. О-о-о-о. О, я… но… ух ты».~
@50419 = ~Этот истекающий слюной желтоглазый упырь воняет кровью и падалью. Он ковыряется в кривых зубах длинными грязными когтями, постоянно нюхая воздух вокруг. Его кожа болезненно-зелёного цвета и покрыта гнойными, мокнущими язвами.~
@50420 = ~«Приветствую…»~
@50421 = ~Оставить упыря в покое.~
@50422 = ~Эта упыриха воняет кровью и падалью. Черви и мелкие жучки кишат в её длинных волосах, свисающих сосульками на жёлтые глаза. Она смахивает волосы со лба ужасного вида когтями. Её кожа болезненно-зелёного цвета и покрыта гнойными, мокнущими язвами.~
@50423 = ~«Приветствую…»~
@50424 = ~~
@50425 = ~Оставить упыря в покое.~
@50426 = ~Поначалу кажется, что это разлагающееся женское тело совершенно не осознаёт твоего присутствия. Однако когда ты подходишь ближе, оно медленно кивает, как бы приветствуя.~
@50427 = ~«Приветствую…»~
@50428 = ~«Приветствую…»~
@50429 = ~Это простой с виду тяжёлый металлический графин с откидной крышкой. Несмотря на неказистый вид, тебе не хочется до него дотрагиваться… как будто бы он может тебя укусить. Тебе сказали, что внутри заточено некое чудовище, но, заглянув внутрь, ты видишь лишь чернильную темноту.~
@50430 = ~Меч В'инна — также известный как Клинок Обманщика — выглядит скорее декоративным кинжалом, чем пригодным для сражения оружием. Довольно плохо сбалансированный, он тем не менее зачарован и поэтому более эффективен в бою, чем «обычный» нож. Однако основное свойство меча В'инна — придавать владельцу способность жульничать: просто встав с ним в руке в подходящую театральную позу, можно победить любого соперника в игре, для которой он предназначен.~
@50431 = ~Это официальный текст.~
@50432 = ~Перевернуть графин и посмотреть что там.~
@50433 = ~Спрятать графин.~
@50434 = ~Сначала ничего не происходит… но затем из носика графина начинает капать чёрная вязкая жидкость, образуя на земле слизистую лужу дымящейся, смолистой грязи. Когда графин в твоих руках испаряется, лужа начинает дрожать, корчиться и подниматься, образуя высокую отвратительную тварь…~
@50435 = ~«Что за?..»~
@50436 = ~Жульничать: встать, слегка расставив ноги, размять все мышцы и триумфально поднять клинок к небесам.~
@50437 = ~Отложить кинжал на время.~
@50438 = ~Заряд силы пульсирует в лезвии клинка, где-то в отдалении звучит гром. В считанные мгновения конец игры приблизится к тебе…~
@50439 = ~Наблюдать его приближение…~
@50440 = ~Хэмрис тебе улыбается: «Ещё раз добрый день, уважаемый. Не разобрался ещё в ситуции со складом?»~
@50441 = ~«Нет, я над этим работаю. Прощай».~
@50442 = ~«Нет, но у меня к тебе кое-какие вопросы…»~
@50443 = ~Хэмрис тебе улыбается: «Ещё раз добрый день, здоровяк. Получил планы, которые искал?»~
@50444 = ~«У меня вопросы…»~
@50445 = ~«Неважно, прощай».~
@50446 = ~Ты видишь элегантно одетого стареющего мужчину. У него ясные глаза и располагающая улыбка. При твоём приближении он одаривает лёгким поклоном: «Добрый день, здоровяк. Я Себастьян. Чем могу быть полезен?»~
@50447 = ~«Приветствую».~
@50448 = ~Не обращать на него внимания.~
@50449 = ~Интеллект персонажа слишком низок, чтобы скопировать это заклинание.~
@50450 = ~Действительно удалить это заклинание из списка запомненных?~
@50451 = ~Скетч~
@50452 = ~Меч В'инна~
@50453 = ~Йелаан~
@50454 = ~Герик~
@50455 = ~Гиб~
@50456 = ~Пито~
@50457 = ~Ан'изиус~
@50458 = ~Сиабха~
@50459 = ~Роберта~
@50460 = ~Ан'изиус~
@50461 = ~Игра успешно сохранена~
@50462 = ~~
@50463 = ~~
@50464 = ~«Они все уже мертвы».~
@50465 = ~«Они все уже мертвы. К сожалению, она тоже».~
@50466 = ~«Расскажи мне что-нибудь об оружии».~
@50467 = ~~
@50468 = ~«Они все уже мертвы».~
@50469 = ~«Они все уже мертвы. К сожалению, она тоже».~
@50470 = ~Этот улыбающийся мужчина весело кивает, когда ты приближаешься: «Добро пожаловать в моё кафе, добрый сэр. Чем могу услужить? Может, немного вина?»~
@50471 = ~«Это тот самый?»~
@50472 = ~«Это череп, так? Именно такого хочет ОН. Хватай его».~
@50473 = ~«Во имя Девяти Адских Задниц, какого…»~
@50474 = ~«Эй! Пусти! Пусти! Помогите! ПОМОГИТЕ!»~
@50475 = ~«Эй, шеф! Я здесь, на полке, справа от лестницы!»~
@50476 = ~«Ты быстро „отвалишь“ отсюда, если только себе не враг. Убирайся!»~
@50477 = ~«Сэр! Сэр! Могу я с вами переговорить?»~
@50478 = ~::Прижимает руки изнутри к стенкам невидимого ящика::~
@50479 = ~::Подтягивается на невидимой верёвке::~
@50480 = ~«Ну-ну… летающий изворотливый череп без тела…»~
@50481 = ~«Ну-ну… Падшая Грейс… или как ты там себя теперь называешь. Истинное удовольствие видеть тебя здесь. Чем обязана таким почётным визитом? Я думала, ты теперь редко путешествуешь в компании нам подобных, — она секунду взирает на тебя с той же слабой ухмылкой. — Или твоё задание здесь почти закончено?»~
@50482 = ~«Ну-ну…  изворотливый череп без тела и Падшая Грейс… или как ты там себя теперь называешь. Истинное удовольствие видеть тебя здесь. Чем обязана таким почётным визитом? Я думала, ты теперь редко путешествуешь в компании нам подобных, — она секунду взирает на тебя с той же слабой ухмылкой. — Или твоё задание здесь почти закончено?»~
@50483 = ~Она щурится. «Ты… ты тот израненный, который ходит тут везде и задаёт всякие вопросы? — она оглядывает тебя с головы до ног. — Ты явно выглядишь потерянным. Ты действительно хотел войти или просто ошиваешься здесь от нечего делать?»

«Поскольку Вришика… — она показывает на себя, — …может тебе помочь».~
@50484 = ~Она отвечает отрывисто, как будто парируя удар: «Сама по себе. А ты? Куда твои приказы заведут тебя в следующий раз?» Внезапно она поворачивается к тебе. «Видишь ли, *малыш*… — Вришика улыбается, смакуя слова, — …лучшая искусительница — та, которая представляется тебе одновременно развратной и девственной; проститутка-монахиня, так сказать. Мадам Грейс — среди величайших…» Она поворачивается к Падшей Грейс: «…не правда ли? Ты же не будешь утверждать, что тысячи лет рабства не оставили свои шрамы, нет?»~
@50485 = ~«Как ты можешь мне помочь?»~
@50486 = ~«Что это за место?»~
@50487 = ~«У меня были вопросы…»~
@50488 = ~«Нет, спасибо. Прощай».~
@50489 = ~«Хорошо. Всё же это *вы* пришли в мой магазин», — Вришика переводит взгляд на тебя.~
@50490 = ~«Я приму любые вопросы о товарах, но я не собираюсь утопать в одной из твоих знаменитых бесед в стиле двадцать-вопросов-обо-всём-что-творится-в-мире, *понял*?»~
@50491 = ~«Хочешь купить раба или нанять слугу, Вришика?»~
@50492 = ~«Кто ты такая, Вришика?»~
@50493 = ~«Что ты имела в виду, когда назвала Морте „изворотливым“?»~
@50494 = ~«Кажется, ты и Падшая Грейс не в восторге друг от друга…»~
@50495 = ~«Расскажи мне об этом месте».~
@50496 = ~«Тогда позволь посмотреть твой товар».~
@50497 = ~«В таком случае прощай».~
@50498 = ~«То, что ты видишь в лавке, — результат путешествий и торговли меж планами, — она широким жестом обводит магазин. — Оружие, побрякушки… и другие *особенные* вещи выставлены на продажу, а также… всё редкое и ах-какое-изысканное наполняет мой магазин. Всё что нужно. И даже больше».~
@50499 = ~«У меня вопрос о другом…»~
@50500 = ~«Тогда позволь посмотреть твой товар».~
@50501 = ~«Это всё, что я хотел узнать. Прощай».~
@50502 = ~«Изворотливый… искажающий факты, вероломный, лицемерный, *лживый*… о, я это сказала? Я имела в виду летающий *лукавый* череп без тела. Как в религии — всегда может представить дело в выгодном для себя свете», — Вришика невинно улыбается.~
@50503 = ~«Хм. У меня другой вопрос…»~
@50504 = ~«Тогда ладно. Позволь посмотреть твой товар…»~
@50505 = ~«Ясно. Это всё, что я хотел узнать, прощай».~
@50506 = ~~
@50507 = ~«А, эта полковая шлюшка баатезу, обосновавшаяся в Сигиле? Тебе любопытно, да? На самом деле, что может быть лучшим прикрытием для её агентуры, чем это её маленький „бордель“…»~
@50508 = ~«Полковая шлюшка баатезу?»~
@50509 = ~«Агентуры?»~
@50510 = ~«Хм. У меня другой вопрос…»~
@50511 = ~«Я бы посмотрел, чем ты торгуешь…»~
@50512 = ~«Это всё, что я хотел узнать. Прощай».~
@50513 = ~«С тех пор, как мать продала её в рабство, она столетиями была игрушкой планов. Она утверждает, что могла освободиться от своих оков, но ты можешь ей доверять ровно настолько, насколько любой другой сучке-танар'ри, — она слегка улыбается. — Исключая меня, разумеется».~
@50514 = ~«Правда?! *Правда*?! Никто не „освобождается“ от договоров баатезу, сучка, одетая в человеческую кожу. Ты врёшь, и все это знают, начиная с последнего танар'ри и заканчивая другими суккубами, вскормленными в комфорте и скачущими по планам. „С самого рождения Падшая Грейс была ничем иным, как рабыней баатезу, и *навсегда* ей останется“. Ты по-прежнему проданная с потрохами игрушка баатезу, и они сделают с тобой всё, что захотят, — Вришика ухмыляется. — Ты даже *ведёшь* себя как они».~
@50515 = ~«Хватит! Я не позволю тебе лгать в моём присутствии!»~
@50516 = ~«Да… они её глаза и уши в городе Сигил и по всем планам. То, что они не могут увидеть или услышать сами, они вытягивают из тех мужчин, которые видели или слышали. И кто бы мог подумать, что люди способны на такой обман и хитрость? О, Грейс — настоящая умница. Не такая умница, как её мать, но всё же…»~
@50517 = ~«О, ну *конечно* нет! Могу ли я осмелиться предположить подобное? Но, может, ты предоставишь человеку право судить самому? — Вришика поворачивается к тебе, сверкая глазами: — Ты не ещё не задумался, малыш? Сомнения ещё не закрадываются в твою голову? Разве обстановка борделя не кажется тебе *странной*?»~
@50518 = ~Вришика продолжает до того, как ты успеваешь ответить: «Бритва Оккама может оставить шрам, но это хороший инструмент, чтобы удалить опухоль обмана и притворства».

«И вот, пожалуйста, она путешествует с тобой. Крайне любопытно. Зачем это владелице такого заведения бросать его ни с того ни с сего? Тем более ради человека, которого она едва знает? Вопросы, вопросы…»

«А ответы могут быть действительно неутешительны».~
@50519 = ~«О, я нисколько не сомневаюсь… какой мужчина смог бы устоять?» — Вришика фыркает и с отвращением отворачивается.~
@50520 = ~«Что ты там говорила насчёт полковой шлюшки баатезу?»~
@50521 = ~«Я хочу спросить о другом…»~
@50522 = ~«Я бы посмотрел, чем ты торгуешь…»~
@50523 = ~«Это всё, что я хотел узнать. Прощай».~
@50524 = ~Вришика громко вздыхает: «Алу-изверг… полудемон. Моя мать была танар'ри, изверг, а отец — великий король смертных. Какой грубый вопрос… да ты и сам довольно груб, не так ли?»~
@50525 = ~«Я хочу спросить о другом…»~
@50526 = ~«Я бы посмотрел, чем ты торгуешь…»~
@50527 = ~«Это всё, что я хотел узнать. Прощай».~
@50528 = ~«Я путешествую и веду широкую торговлю. Я много слышу, много покупаю и много зарабатываю. Возможно, мы заключим хорошую сделку. Есть здесь что-нибудь, чего ты жаждешь?»~
@50529 = ~«Только ответы на некоторые вопросы…»~
@50530 = ~«Возможно. Что ты продаёшь?»~
@50531 = ~«Нет, не сейчас. Прощай».~
@50532 = ~Невозможно использовать предмет.~
@50533 = ~«Не желаешь посмотреть оружие и амулеты? Или что-то из более *экзотических* товаров?»~
@50534 = ~«Оружие и амулеты…»~
@50535 = ~«Экзотические товары…»~
@50536 = ~«На самом деле ничего. Прощай».~
@50537 = ~Неправильный тип предмета~
@50538 = ~Предмет проклят!~ [Z_CURSE]
@50539 = ~Вришика улыбается, пока ты оглядываешь полки в средней части магазина: «Если не найдёшь здесь ничего достойного, посмотри ещё в передней и задней части лавки».~
@50540 = ~~
@50541 = ~~
@50542 = ~~
@50543 = ~~
@50544 = ~Предмет не опознан~
@50545 = ~Нет возможности~
@50546 = ~Рюкзак полон~
@50547 = ~ЗЕРТСКИЙ КЛИНОК ДАК'КОНА («КРАДУЩИЙ ФОРМУ»)
Урон: 3-10 рубящий
Зачаровано: +1
Особенности: позволяет запомнить 1 дополнительное заклинание мага первого уровня
THAC0: +1
Фактор скорости: 7
Вес: 5
Навык: клинок
Доступно только Дак'кону

В Лимбо, родном плане гитцерай, твёрдая материя встречается крайне редко. Лимбо — это смешанная масса элементов; и только собственная сила воли позволяет гитцерай соединять эти элементы, создавая устойчивую материю.

Субстанция, называемая «карач», — это и есть материал, которым можно манипулировать с помощью разума. Клинок Дак'кона изготовлен из этой субстанции; только с помощью силы своего разума Дак'кон сохраняет целостность меча. Когда настрой и дух носителя этого оружия колеблются, клинок реагирует на это, отражая мысли владельца.

Дак'кон должен очень сильно пострадать в бою, чтобы клинок карач стал мертвенно-чёрным, отражая глаза Дак'кона. Меч становится длиннее, острее и одна сторона покрывается тонкими шипами, похожими на зубы.

Похоже, этот клинок имеет особое религиозное значение для Дак'кона. Он обмотал несколько кусков пергамента вокруг эфеса меча. Скорее всего, это мантры, посвящённые Зертимону.~
@50548 = ~Заметки Фина Андли~
@50549 = ~~
@50550 = ~~
@50551 = ~Осмотреть язык изверга.~
@50552 = ~Осмотреть мазь горгоны.~
@50553 = ~~
@50554 = ~Осмотреть металлическую статуэтку в форме куба.~
@50555 = ~Осмотреть жуткий графин.~
@50556 = ~~
@50557 = ~~
@50558 = ~~
@50559 = ~~
@50560 = ~~
@50561 = ~~
@50562 = ~«Позволь взглянуть на оружие и амулеты…»~
@50563 = ~«Сейчас меня ничего не интересует. Прощай, Вришика».~
@50564 = ~Вришика замечает, что ты рассматриваешь книгу под названием «КОДЫ ОБМАНА»: «Да… это именно то, что ты думаешь. Вперёд, взгляни на них».~
@50565 = ~«Коды обмана? Я не понимаю…»~
@50566 = ~Просмотреть оглавление книги.~
@50567 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50568 = ~«Сейчас меня ничего не интересует. Прощай, Вришика».~
@50569 = ~Невозможно сдвинуть предмет~
@50570 = ~Клинок Бессмертного~
@50571 = ~Кассиус~
@50572 = ~Рэи~
@50573 = ~«О, перестань», — Вришика упирает руки в бёдра и наклоняет голову. «Не строй из себя дурачка! Помни, что я изверг и чую твоё возбуждение. Да… — она говорит медленно, как будто с ребёнком. — Это коды *обмана*. Они позволяют тебе ЖУЛЬНИЧАТЬ. Ну же… посмотри их. Они тебя не укусят».~
@50574 = ~Просмотреть оглавление книги.~
@50575 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50576 = ~«Нет, спасибо. Прощай, Вришика».~
@50577 = ~Книга содержит следующие главы: Чит телепорта, Чит отдыха, Чит богатства, Чит параметров, Чит смерти, Чит слова добра и зла, Чит законопослушности и хаотичности.~
@50578 = ~«Что ты хочешь за книгу?»~
@50579 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50580 = ~«Нет, спасибо. Прощай, Вришика».~
@50581 = ~Ты осматриваешь кучу одинаковых бутылочек, на каждой написано «Детское масло». Вришика поднимает одну из них и показывает тебе: «Интересует? Оно настоящее, разумеется. Тысячи хныкающих смертных младенцев ушло на то, чтобы сделать это масло».~
@50582 = ~«Э… нет, спасибо. Дай мне взглянуть на другие вещи».~
@50583 = ~«Нет, спасибо. Прощай, Вришика».~
@50584 = ~Ты осматриваешь маленькое создание, похожее на беса, сделанное из чистого молочного шоколада. «Выглядит вкусно, не правда ли? Завезено с Нижних планов. Они редкость, знаешь ли, и очень ценятся любителями сладкого. Это настоящий квазит, приживала извергов, превращённый в шоколад сильным колдовством. Всего лишь сто девяносто девять медяков».~
@50585 = ~«Беру».~
@50586 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50587 = ~«Нет, спасибо. Прощай, Вришика».~
@50588 = ~~
@50589 = ~Ты осматриваешь невзрачную книжку, закрытую на маленький латунный замок. «Это… — воркует Вришика. — Кодекс Невероятного. Я только скажу тебе, что он… он… ну, я не могу это объяснить. Обычных слов просто недостаточно! Ты можешь завладеть им всего лишь за какую-то тысячу медяков… и поверь мне: он того стоит».~
@50590 = ~«Беру».~
@50591 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50592 = ~«Нет, спасибо. Прощай, Вришика».~
@50593 = ~Ты осматриваешь маленький стеклянный флакон с наклейкой «Слёзы дэва». «Они были собраны у дэва, захваченного в одной из стычек Кровавой Войны. Изверги пытали заключённого ангела в течение эпох, пока он наконец не сбежал. Бутылочка содержит двенадцать слёз, пролитых им за это время. Их цена всего сотня медяков».~
@50594 = ~«Я возьму их».~
@50595 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50596 = ~«Нет, спасибо. Прощай, Вришика».~
@50597 = ~Ты осматриваешь маленький стеклянный флакон с наклейкой «Слёзы дэва». «Они были собраны у дэва, захваченного в одной из стычек Кровавой Войны. Изверги пытали заключённого ангела в течение эпох, пока он наконец не сбежал. Бутылочка содержит двенадцать слёз, пролитых им за это время. Говорят, их прикосновение способно смягчить самый дикий гнев… даже вызванный языком изверга, — Вришика безжалостно улыбается. — Их цена всего девятьсот девяносто девять медяков».~
@50598 = ~«Они могут остановить проклятие языка изверга. Я возьму их».~
@50599 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50600 = ~«Они могут быть тем, что нужно Экко… но нет, спасибо. Прощай».~
@50601 = ~Ты осматриваешь бутылочку с наклейкой «Эликсир жуткого разделения». Вришика показывает её тебе: «Эта штука создана учёной, обнаружившей, что у неё есть тёмная сторона, которая временами берёт над ней верх и заставляет делать ужасные вещи. Жидкость должна была отделить от неё эту тёмную сторону, создав двух разных людей. Однако Убийцы Милосердия нашли и казнили её раньше, чем она успела воспользоваться эликсиром. Я продам его тебе всего за две сотни медяков».~
@50602 = ~«Беру».~
@50603 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50604 = ~«Нет, спасибо. Прощай, Вришика».~
@50605 = ~Ты осматриваешь нечто, похожее на язык, плавающий в банке рассола. Вришика хмурится: «Это язык изверга… думаю, корнугона, но кто знает? Говорят, помещённый в рот любой живой твари, он даёт способность говорить, даже если раньше этой способности не было. Я продаю эту диковину всего за шестьдесят шесть медяков, если хочешь».~
@50606 = ~«Беру».~
@50607 = ~«Я возьму его, он может вернуть Экко её голос».~
@50608 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50609 = ~«Нет, спасибо. Прощай, Вришика».~
@50610 = ~Ты осматриваешь бутылочку с наклейкой «Мазь горгоны». Вришика показывает её тебе: «Я выменяла её у какого-то мечника из первичного мира… кажется, его звали Персей. Намазанная на поверхность существа, обращённого в камень, она восстанавливает его плоть. Всего сотня медяков, и ты убедишься, как это удобно, если твой друг окаменеет».~
@50611 = ~«Беру».~
@50612 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50613 = ~«Нет, спасибо. Прощай, Вришика».~
@50614 = ~Ты осматриваешь маленькую металлическую копию кубического существа с огромными глазами на одной из граней. У игрушки две руки, две ноги, два складывающихся крыла и по меньшей мере восемнадцать сочленений. Вришика улыбается и демонстрирует её тебе: «Коллекционная вещь, вероятно, или произведение искусства. Кто знает? Но мне нравится. Если купишь… поспрашивай народ, может, кто-то знает о ней больше, чем я. Всего полторы тысячи медяков».~
@50615 = ~«Беру».~
@50616 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50617 = ~«Нет, спасибо. Прощай, Вришика».~
@50618 = ~Ты осматриваешь простой с виду графин… несмотря на неказистый вид, тебе не хочется до него дотрагиваться, как будто он может тебя укусить. Вришика наблюдает за тобой, посмеиваясь, затем пожимает плечами: «Это графин. В нём сидит какое-то чудовище, поэтому у тебя и волосы дыбом. Если нравится — всего сто монет».~
@50619 = ~«Беру».~
@50620 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50621 = ~«Нет, спасибо. Прощай, Вришика».~
@50622 = ~Ты осматриваешь заляпанную линзу из матового стекла шириной с твою ладонь, зажатую в блестящее стальное кольцо. Маленькие механические крепления на кольце наводят на предположение, что это часть какого-то часового устройства. Она издаёт лёгкий запах каких-то ужасных духов. Вришика демонстрирует её тебе: «Понятия не имею, что это, но оно явно излучает сильную магию. Старый солдат по имени Гизис принёс её мне с поля боя на Нижнем плане. Он убил собственных людей, чтобы сбежать от своих обязанностей там, и принёс мне массу интересных вещей, которые собрал в ходе кампании. Я хранила её больше в качестве предмета обсуждения, однако можешь приобрести её за сто сорок девять медяков, если хочешь».~
@50623 = ~«Беру».~
@50624 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50625 = ~«Нет, спасибо. Прощай, Вришика».~
@50626 = ~Ты осматриваешь кольцо в небольшой коробочке, подбитой тканью. Вришика поднимает коробочку, чтобы ты мог рассмотреть хорошенько: «Это Кольцо Почти Невидимости Йевры. Оно делает надевшего невидимым — ну, почти. Я расстанусь с ним за скромную сумму в три сотни сорок девять медяков».~
@50627 = ~«Беру».~
@50628 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50629 = ~«Нет, спасибо. Прощай, Вришика».~
@50630 = ~Ты осматриваешь странной формы кинжал, выставленный на затейливой подставке. Вывеска под ней гласит: «Меч В'инна». Вришика тыкает пальцем в эфес: «Он также известен как Клинок Обманщика. Просто подняв его, ты выиграешь игру. Если ты уверен, что тебе это понравится, я вручу его тебе за полторы тысячи медных монет».~
@50631 = ~«Выиграю что… что ты имеешь в виду?»~
@50632 = ~«Беру».~
@50633 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50634 = ~«Нет, спасибо. Прощай, Вришика».~
@50635 = ~Вришика щурит на тебя свои жёлтые глаза: «Ой, да ладно тебе. Ты *точно* знаешь, что я имею в виду. Купив Клинок Обманщика, ты победишь в игре. Это так просто… всего-то за полторы тысячи медных монет. Ты хочешь этого или нет?»~
@50636 = ~«Да, я возьму его».~
@50637 = ~«Нет… но позволь посмотреть другие вещи…»~
@50638 = ~«Нет, спасибо. Прощай, Вришика».~
@50639 = ~Годы не были милосердны к этой маленькой тряпичной кукле: швы несколько поистрепались, а кое-где нитки и вовсе разошлись. Выглядит она как странная женщина в мантии и с ореолом из шипов вокруг головы. Вришика демонстрирует её тебе: «Это было найдено в хорошо защищённом сейфе глубоко под поверхностью Сигила. Кукла лежала в небольшой куче сокровищ и запрещённых магических текстов, но я не знаю, для чего она. Если тебе нравится, всего девяносто девять медных монет».~
@50640 = ~«Беру».~
@50641 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50642 = ~«Нет, спасибо. Прощай, Вришика».~
@50643 = ~Годы не были милосердны к этой маленькой тряпичной кукле: швы несколько поистрепались, а кое-где нитки и вовсе разошлись. Очевидно, кукла должна была изображать Госпожу Боли, но её пуговичные глаза и мягкость материала не внушают особого страха. Вришика демонстрирует её тебе: «Это было найдено в хорошо защищённом сейфе глубоко под поверхностью Сигила. Кукла лежала в небольшой куче сокровищ и запрещённых магических текстов, но я не знаю, для чего она. Если тебе нравится, всего девяносто девять медных монет».~
@50644 = ~«Беру».~
@50645 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50646 = ~«Нет, спасибо. Прощай, Вришика».~
@50647 = ~Вришика подходит ближе. «За такую вещь простых денег недостаточно. Мне нужен фунт твоей крови, выпущенной предо мной этим клинком… — внезапно в её руке появляется зазубренный кинжал, — …и собранной в этот железный контейнер. Ничего другого я не приму».~
@50648 = ~«Я пойду на это».~
@50649 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50650 = ~«Нет, спасибо. Прощай, Вришика».~
@50651 = ~В считанные минуты мрачный ритуал завершён, и Вришика — с удовлетворённой улыбкой на губах — передаёт тебе книгу: «Сейчас у меня маловато времени. Прощай».~
@50652 = ~«Прощай».~
@50653 = ~«Да, — мурлычет Вришика, — мудрый выбор». Медь, высыпанная в её руку, как будто испаряется в момент касания ладони. Она протягивает тебе предмет: «Пожалуйста, наслаждайся новым приобретением».~
@50654 = ~«Прощай».~
@50655 = ~Пухлые чёрные губы Вришики складываются в улыбку: «Я *всегда* заинтересована в помощниках. Стэндиш — ленивый олух — помогает мне в магазине, но мне нужен кто-то другой для особняка. Кого ты мне предложишь? Я заплачу пять тысяч монет, если он меня устроит».~
@50656 = ~«Как насчёт Морте?»~
@50657 = ~«Эту девушку-тифлинга, Анну».~
@50658 = ~«Дак'кон, гитцерай».~
@50659 = ~«Падшую Грейс».~
@50660 = ~«Вот этого модрона, Нордома».~
@50661 = ~«На самом деле, забудь. У меня другой вопрос…»~
@50662 = ~«Вообще-то никого, не бери в голову. Прощай».~
@50663 = ~Вришика щурит свои глаза на Морте: «Хм-м-м… да, он может оказаться полезным. Пока ты не понял, что никогда его больше не увидишь… я предлагаю за него пять тысяч монет».~
@50664 = ~«Говоришь, никогда больше? Прекрасно… забирай его».~
@50665 = ~«Нет, я передумал. Прощай, Вришика».~
@50666 = ~Вришика показывает кусок пергамента своему новому рабу, Морте. «Вот… адрес моего дома в районе Госпожи. Сейчас же иди туда… только попробуй сбежать, и я натравлю на тебя извергов, так что ты будешь умолять о возвращении в Сигил и служении мне, — затем она поворачивается к тебе: — А *тебе*… мои благодарности. Я уверена, он своё отработает. Вот твои пять тысяч монет… прощай».~
@50667 = ~Вришика щурит свои глаза на Дак'кона: «Хм-м-м… гитцерай, да? И к тому же *зерт*. Пока ты не понял, что никогда его больше не увидишь… я предлагаю за него пять тысяч монет».~
@50668 = ~«Прощай».~
@50669 = ~«Никогда? Я понял. Забирай его».~
@50670 = ~«Нет, я передумал. Прощай, Вришика».~
@50671 = ~«Не *смеши*, — Вришика ухмыляется, качая головой. — Как будто бы она *твоя*, чтобы её продавать… уходи и возвращайся — или нет — когда придумаешь что-нибудь поумнее».~
@50672 = ~Уйти.~
@50673 = ~Вришика щурит глаза на Нордома: «Хм-м-м… механический слуга в мою полную собственность? Да, я безусловно согласна. Пока ты не понял, что никогда его больше не увидишь… я предлагаю за него пять тысяч монет».~
@50674 = ~«Никогда? Я понял. Забирай его».~
@50675 = ~«Нет, я передумал. Прощай, Вришика».~
@50676 = ~Вришика отвешивает быстрый полупоклон: «Добро пожаловать обратно. Будешь что-нибудь покупать?»~
@50677 = ~«Не сейчас. У меня вопросы…»~
@50678 = ~«Да».~
@50679 = ~Ты осматриваешь большую оловянную пивную кружку, покрытую странными рунами. Вришика поднимает её, чтобы ты рассмотрел поближе: «Пивная кружка необычной конструкции, позволяющая хранить содержимое — обычно, конечно, пиво — ледяным независимо от окружающей температуры. Две сотни девяносто девять монет, и ты можешь наслаждаться самым холодным элем, какой только может быть за пределами парастихийного плана Льда».~
@50680 = ~«Беру».~
@50681 = ~«На самом деле, позволь посмотреть другие вещи…»~
@50682 = ~«Нет, спасибо. Прощай, Вришика».~
@50683 = ~Резкие черты лица этой женщины довольно привлекательны, хоть и немного смущают её сине-чёрная кожа и ярко-жёлтые глаза. Пока она тебя изучает, за спиной у неё раскрываются и снова складываются два крыла, как у летучей мыши.~
@50684 = ~Резкие черты лица этой женщины довольно привлекательны, хоть и немного смущают её сине-чёрная кожа и ярко-жёлтые глаза. Пока она тебя изучает, за спиной у неё раскрываются и снова складываются два крыла, как у летучей мыши.~
@50685 = ~Резкие черты лица этой женщины довольно привлекательны, хоть и немного смущают её сине-чёрная кожа и ярко-жёлтые глаза. Пока она тебя изучает, за спиной у неё раскрываются и снова складываются два крыла, как у летучей мыши.~
@50686 = ~«Не знаю, о каком задании ты говоришь, Вришика. А вот твоё присутствие здесь вызывает массу вопросов. В последний раз, когда я слышала о тебе, ты была знаменосцем в Роте Стервятника. Как ты попала в Сигил?»~
@50687 = ~Падшая Грейс отвечает с холодностью, которой ты никогда не слышал от неё раньше. Сам воздух леденеет, когда она рассекает Вришику взглядом: «Достаточно».~
@50688 = ~«Это правда…»~
@50689 = ~«Освободиться от договоров баатезу можно, если аккуратно выбираешь выражения и понимаешь, что баатезу обязаны держать данное слово. Нужно просто остерегаться слов, значение которых они могут извратить… а я *очень* хорошо подкована в словах и их подтексте. Несмотря на это, было очень непросто…»~
@50690 = ~Падшая Грейс сохраняет своё безупречное спокойствие и только кивает… хотя когда ты ловишь её взгляд, она смотрит слегка раздражённо, но затем сразу улыбается.~
@50691 = ~«Что ты там сказала насчёт её агентуры, Вришика?»~
@50692 = ~«У меня другой вопрос, Вришика…»~
@50693 = ~«Я бы хотел посмотреть твои товары, Вришика…»~
@50694 = ~«Это всё, что я хотел узнать, Вришика. Прощай».~
@50695 = ~«Это не входит в задачи моего заведения…»~
@50696 = ~«Он прекрасно знает, зачем я согласилась с ним пойти, Вришика… ведь он сам попросил меня».~
@50697 = ~«Эй! Эй! Эй! Ты же *шутишь*, верно? Ты же не *серьёзно*, шеф!»~
@50698 = ~«Я серьёзно. Ты возьмёшь его, Вришика?»~
@50699 = ~«Шучу, конечно. У меня другой вопрос, Вришика…»~
@50700 = ~«Ты прав, Морте, это была не лучшая идея. Пошли».~
@50701 = ~«Не могу в это поверить… ты и до этого падал в моих глазах, шеф, но это в этот раз пробил дно. Я увижу *тебя* в Бааторе, обдолбаный, вероломный, неблагодарный, рябой дерьмоед с коротким членом, грязноволосый и гнилозубый жалкий кусок беспамятного мусора! Попомни мои слова, засранец грёбаный, продолжай в том же духе и очень скоро ты умрёшь *навсегда*… и посмотрим, как тогда ты найдёшь себя!»~
@50702 = ~«Ты что, совсем головой *двинулся*, а, говнюк? Силы сверху и снизу, лучше б это щас была плохая шутка, или, клянусь, я быстро сделаю тебя *хорошим*, усёк?»~
@50703 = ~«Я серьёзно. Купишь её, Вришика?»~
@50704 = ~«Проехали. У меня другой вопрос, Вришика…»~
@50705 = ~«Ты права… это была не самая удачная шутка, Анна. Пошли».~
@50706 = ~Дак'кон молчит, затем его слова вырываются наружу как клинок: «Не моя *воля* быть рабом этой женщины».~
@50707 = ~«У тебя не очень-то большой выбор, а, раб? Ты купишь его, Вришика?»~
@50708 = ~«Очень сожалею, Дак'кон. Ты купишь его, Вришика?»~
@50709 = ~«Тогда и не будешь. У меня другой вопрос, Вришика…»~
@50710 = ~«Хорошо… тогда пошли, Дак'кон».~
@50711 = ~«Никогда я не думал… — его угольно-чёрные глаза секунду изучают твоё лицо, а потом опускаются вниз, и он качает головой. — На жестокий путь низвергли меня мои необдуманные слова. Мой путь… путь Дак'кона…» Он молча отворачивается от тебя.~
@50712 = ~«Мне следует понимать, что мои услуги были предложены для продажи? Передача полномочий от тебя к Вришике на основании товарно-денежных отношений?»~
@50713 = ~«Да, всё верно. Ты возьмёшь его, Вришика?»~
@50714 = ~«Да, но забудь об этом. У меня другой вопрос, Вришика…»~
@50715 = ~«Да… но я отменил решение. Пошли, Нордом».~
@50716 = ~«Нордом готовится принять Вришику — алу-изверга, владелицу лавки редких товаров — как фигуру с превалирующими полномочиями».~
@50717 = ~«Да?»~
@50718 = ~Ты видишь чрезвычайно тучного мужчину со складками жира, свисающими практически повсюду. Его глаз медленно поворачивается к тебе, и как только он останавливается, тебя внезапно охватывает чувство необъяснимой опасности. «Я содержу в себе истинную сущность меча. То, что ты видишь, — пустая оболочка. Клинок во мне. Ты должен победить меня, чтобы достать его».~
@50719 = ~«Кто ты?»~
@50720 = ~«Леди Торнкомб, здесь в Фестхолле».~
@50721 = ~Выяснилось, что несколько капель крови Кезай сработают как ключ для открытия портала в лабиринт Рейвел… Мне только нужно принести ей платочек, чтобы собрать кровь.~
@50722 = ~«Ведь говорят, что сожаление может изменить природу человека, хотя только Серые Сёстры могут знать это наверняка».

Ивес с улыбкой кивает тебе: «Я не понимаю смысла этой истории, но, быть может, она пригодится тебе в будущем».~
@50723 = ~«Приговор Коссаксу, вынесенный Старейшинами, звучал так: „Заключение сроком трижды по тридцать дней, в течение которого приговорённый обязуется отказаться от своей жизни, будет объявлен мёртвым, а его тело лишится всех признаков жизни“. Коссакс смеялся и предлагал любому из них попытаться нанести ему вред, но суд хранил молчание».~
@50724 = ~«Продолжай…»~
@50725 = ~«Погоди… у меня вопрос…»~
@50726 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@50727 = ~«Убийцы Милосердия привели Коссакса в свою тюрьму и заперли его в тёмной пустой камере. Там не было ни койки, ни света. И единственной дверью была стальная решётка в потолке.

Поместив его в темницу, Убийцы Милосердия сказали ему: „В углу своей камеры найдёшь ты чашу. Она содержит яд. Твоя смерть будет быстрой“.

„Разве вы не собираетесь казнить меня?“ — зарычал стражам Коссак.

„Никто в Сигиле не наложит на тебя руку с намерением причинить вред“, — ответили Убийцы Милосердия».~
@50728 = ~«Погоди… у меня вопрос…»~
@50729 = ~«Продолжай…»~
@50730 = ~«Дослушаю в другой раз, Ивес. Счастливо».~
@50731 = ~«Но никакого ответа из решётки в потолке не последовало. И тогда Коссакс заметил, что в камере нет койки. Нет света. И нет ни еды, ни воды. Всё, что осталось, — разбитая чаша с пролитым ядом. И в первый раз Коссак познал ледяное касание приближающейся смерти.

Через дважды тридцать дней решётку открыли и из камеры достали тело Коссака, теперь холодное. Оно отказалось от жизни, и приговор был приведён в исполнение».~
@50732 = ~«У меня есть ещё одна история».~
@50733 = ~«У меня к тебе вопрос, Ивес…»~
@50734 = ~«Мне пора идти. Счастливо, Ивес».~
@50735 = ~«Эй, сэр… я бы хотел минутку с вами переговорить».~
@50736 = ~«Вы! Да, это вам: будьте добры, подойдите сюда, а?»~
@50737 = ~«Милейший… ещё… эля, пожалуйста».~
@50738 = ~«Вот».~
@50739 = ~*Глоток*~
@50740 = ~«Ух! Вот так… *отрыжка* …пойло».~
@50741 = ~«…и вот почему Акт о Подобающем Одеянии крайне важен…»~
@50742 = ~«…и таким образом может быть реализована „система чередующихся расписаний“, чтобы…»~
@50743 = ~«…и вот ещё двадцать причин, почему необходимы четырнадцать членов Нижней палаты Магистрата…»~
@50744 = ~«…пришёл. О дражайший, ты не сказал ни слова! Но позволь мне объяснить…»~
@50745 = ~«Предсказание судьбы… жалкие пять медяков за предсказание судьбы!»~
@50746 = ~«Подходите к Элобранде и узнайте судьбу! Всего лишь пять монет…»~
@50747 = ~«„Вор“, — говорят они. Хмф! „Разведчик“ я, недоразвитые дураки! „РАЗВЕДЧИК“!»~
@50748 = ~«Аон т'хесей ома айос ха аон эйаш».~
@50749 = ~«Ност айен ай фасир хем выл обрис аон меха;»~
@50750 = ~«Уи аон ривон со аон вирано грас Ем нозаех»~
@50751 = ~«Рарех роиб и эхсин со санатоум серолк…»~
@50752 = ~«И'уер ней аон Дадик Артаг, алад авив овулф мои'ок»~
@50753 = ~«Уи якиллу недиу выр аон джигар о'ур м'хеш…»~
@50754 = ~«Куалов тиенг вал аон унамихир т'сугент во»,~
@50755 = ~«Нодве аон земон уи сонье ме асахо ге дио?»~
@50756 = ~«Вам знаком этот язык?»~
@50757 = ~«Нет, совершенно… но звучит мелодично».~
@50758 = ~«Хм-м-м…»~
@50759 = ~::В замешательстве пожимает плечами::~
@50760 = ~«Поразительно, что он продолжает представление…»~
@50761 = ~«Интересно, как долго он будет в ловушке?»~
@50762 = ~«Жаль его… хотя, быть может, он заслужил эту судьбу».~
@50763 = ~«На это, „добрый“ Дерек мой, отвечу я: тьфу на тебя, тьфу, и ещё раз тьфу!»~
@50764 = ~«То было не спровоцировано и незаслуженно совсем! Чем раздражение навлёк я?»~
@50765 = ~«Нонсенс! То было оскорбление, хоть и пытаешься ты ныне отрицать!»~
@50766 = ~«Глупец ты, гнев твой абсолютно беспричинен!»~
@50767 = ~«*Глупец?!* Я?! Глупость тут лишь продолжать страдать от столь компании презренной!»~
@50768 = ~«Ну всё, с меня довольно! К барьеру!»~
@50769 = ~«Быть посему, отведай моей стали!»~
@50770 = ~«Ты бьёшься словно хилое дитя!»~
@50771 = ~«А ты — как робкий щёголь!»~
@50772 = ~«Погоди… а в чём причина нашей драки?»~
@50773 = ~«Да, давай же прекратим весь этот вздор».~
@50774 = ~«Ладно, ладно. Мне ненавистна мысль, что наша дружба завершится так».~
@50775 = ~«Поистине, ты совершенно прав».~
@50776 = ~«Однако наша дружбы быть могла б покрепче…»~
@50777 = ~::С подозрительной миной:: «А?»~
@50778 = ~«…да только этот норов твой…»~
@50779 = ~«Норов? Что имеешь ты в виду?»~
@50780 = ~«Ну перестань, ты должен сам признать, что несколько несдержан…»~
@50781 = ~«Тот, который слева, — ничего, да?»~
@50782 = ~«Хм… а я думаю, другой приятель — актёр поприличней».~
@50783 = ~«Тебе не разобрать, как кто играет, даже если укусить тебя за зад».~
@50784 = ~«Ещё немного вина, если хотите…»~
@50785 = ~«…а потом этот дурак меня толкнул…»~
@50786 = ~«…и я *ПРОКЛЯЛ* этого неуклюжего олуха!»~
@50787 = ~«…и она сказала: „Нет, они мои“».~
@50788 = ~«…так что я *ПРОКЛЯЛ* эту болтливую корову!»~
@50789 = ~«…и когда они набрались наглости странно на меня посмотреть…»~
@50790 = ~«…я просто *ПРОКЛЯЛ* обоих этих негодяев!»~
@50791 = ~«…и вот почему *Я* должен быть преподавателем магии в Общественном Фестхолле».~
@50792 = ~«Что это за место?»~
@50793 = ~«Почему меня заточили здесь?»~
