@8328  = ~«Кого конкретно вы оплакиваете?»~
@8329  = ~«Ясно. У меня ещё вопросы…»~
@8330  = ~«Пожалуй, я услышал достаточно. Прощай».~
@8331  = ~«Истинной Смерти?»~
@8332  = ~«Кого конкретно вы оплакиваете?»~
@8333  = ~«Кого конкретно вы оплакиваете?»~
@8334  = ~«Кого конкретно вы оплакиваете?»~
@8335  = ~«Кого конкретно вы оплакиваете?»~
@8336  = ~«Кого конкретно вы оплакиваете?»~
@8337  = ~«Кого конкретно вы оплакиваете?»~
@8338  = ~«Ясно. У меня ещё вопросы…»~
@8339  = ~«Пожалуй, я услышал достаточно. Прощай».~
@8340  = ~«Похоже на забвение».~
@8341  = ~«И потому вы оплакиваете живых?»~
@8342  = ~«Кого конкретно вы оплакиваете?»~
@8343  = ~«Кого конкретно вы оплакиваете?»~
@8344  = ~«Кого конкретно вы оплакиваете?»~
@8345  = ~«Кого конкретно вы оплакиваете?»~
@8346  = ~«Кого конкретно вы оплакиваете?»~
@8347  = ~«Кого конкретно вы оплакиваете?»~
@8348  = ~«Ясно. У меня ещё вопросы…»~
@8349  = ~«Пожалуй, я услышал достаточно. Прощай».~
@8350  = ~«Кого конкретно вы оплакиваете?»~
@8351  = ~«Кого конкретно вы оплакиваете?»~
@8352  = ~«Кого конкретно вы оплакиваете?»~
@8353  = ~«Кого конкретно вы оплакиваете?»~
@8354  = ~«Кого конкретно вы оплакиваете?»~
@8355  = ~«Кого конкретно вы оплакиваете?»~
@8356  = ~«Неважно. У меня есть ещё несколько вопросов…»~
@8357  = ~«Пожалуй, я услышал достаточно. Прощай».~
@8358  = ~«Что вы делаете?»~
@8359  = ~«Почему ваша песнь изменилась?»~
@8360  = ~«Я оплакиваю мёртвого».~
@8361  = ~«Я прошу за того, кто потерял близкого».~
@8362  = ~«Я хотел бы послушать ваше пение».~
@8363  = ~«Прости, что потревожил тебя. Прощай».~
@8364  = ~Попытаться вспомнить…~
@8365  = ~Попытаться вспомнить…~
@8366  = ~Попытаться вспомнить…~
@8367  = ~Попытаться вспомнить…~
@8368  = ~Восстановить ориентацию.~
@8369  = ~Восстановить ориентацию.~
@8370  = ~Слушать дальше.~
@8371  = ~Оставить их со своим пением.~
@8372  = ~«Я хочу задать тебе вопрос…»~
@8373  = ~Оставить их со своим пением.~
@8374  = ~«Я хочу задать тебе вопрос…»~
@8375  = ~Оставить их со своим пением.~
@8376  = ~«Я хочу задать тебе вопрос…»~
@8377  = ~Оставить их со своим пением.~
@8378  = ~«Я хочу задать тебе вопрос…»~
@8379  = ~Оставить их со своим пением.~
@8380  = ~«Ваша песнь изменилась… я слышу, что изменились мелодия и ритм».~
@8381  = ~«Хорошо, забудем».~
@8382  = ~«Я хочу ещё спросить…»~
@8383  = ~«Может быть. Прощай».~
@8384  = ~«Дейонарра? Я слышал о ней. Ты знаешь, как именно она умерла?»~
@8385  = ~«У меня другие вопросы…»~
@8386  = ~«Спасибо. Это всё, что я хотел узнать».~
@8387  = ~«Мне стало легче. Тот, кого вы оплакивали ранее, больше нуждается в вас, чем я».~
@8388  = ~«У меня другие вопросы…»~
@8389  = ~«Спасибо. Это всё, что я хотел узнать».~
@8390  = ~«Ей стало легче. Тот, кого вы оплакивали ранее, больше нуждается в вас, чем она».~
@8391  = ~«У меня другие вопросы…»~
@8392  = ~«Спасибо. Это всё, что я хотел узнать».~
@8393  = ~«Э-э… Адану стало легче. Тот, кого вы оплакивали ранее, больше нуждается в вас, чем он».~
@8394  = ~«У меня другие вопросы…»~
@8395  = ~«Спасибо. Это всё, что я хотел узнать».~
@8396  = ~«У меня другие вопросы…»~
@8397  = ~Слушать.~
@8398  = ~Уйти.~
@8399  = ~«Нет. Это не волнует его чувств».~
@8400  = ~«Да. Женщина, жена Ангияра, потеряла сына. Она очень тяжело переживает своё горе».~
@8401  = ~Ложь: «Э-э, да… мой друг… Адан его зовут… потерял близкого человека. Он сильно скорбит по умершему».~
@8402  = ~«Да, эта недавняя смерть повергла его в страшное горе и отчаяние».~
@8403  = ~«Прошу прощения… я оговорился. Прощай».~
@8404  = ~«Если бы вы могли, это облегчило бы мою боль».~
@8405  = ~«Нет, не нужно. Прощай».~
@8406  = ~«У меня другие вопросы…»~
@8407  = ~«Очень хорошо. Это всё, что я хотел узнать».~
@8408  = ~«Если бы вы могли, это облегчило бы его боль».~
@8409  = ~«Нет, не нужно. Прощай».~
@8410  = ~«Я хочу задать тебе несколько вопросов…»~
@8411  = ~Оставить их со своим пением.~
@8412  = ~«Этому человеку стало легче. Тот, кого вы оплакивали ранее, больше нуждается в вас, чем он».~
@8413  = ~«У меня другие вопросы…»~
@8414  = ~«Спасибо. Это всё, что я хотел узнать».~
@8415  = ~«Ты думал, что можешь безнаказанно мне угрожать? Глупец!» — она произносит три загадочных слога, и у тебя возникает чувство, будто из груди вырвали кусок сердца. Затем она кричит: «Стража! СТРАЖА!»~
@8416  = ~Напасть на неё.~
@8417  = ~Уйти.~
@8418  = ~«Мой тебе совет: уходи. Драка с нашей стражей не принесёт тебе пользы. Покинь нас».~
@8419  = ~«Я хотел бы услышать ответы на кое-какие вопросы».~
@8420  = ~«Ты ответишь на мои вопросы, или будет хуже».~
@8421  = ~«Хорошо. Прощай».~
@8422  = ~«Я не буду отвечать на твои вопросы, пока стража требует от тебя другого. Это всё».~
@8423  = ~«Ты мне ответишь, девочка, или поплатишься».~
@8424  = ~«Хорошо. Прощай».~
@8425  = ~«Так. Ты вернулся, чтобы вымолить прощение, или решил продолжить вести себя отвратительно?»~
@8426  = ~«Я пришёл убить тебя».~
@8427  = ~«Я пришёл извиниться перед тобой, Саросса».~
@8428  = ~«Я пришёл извиниться перед тобой, Саросса».~
@8429  = ~«Я пришёл извиниться перед тобой, Саросса».~
@8430  = ~«Ни то ни другое. Прощай… пока».~
@8431  = ~«И ты смеешь заговаривать со мной после того, как послал моего брата на плаху? За то горе, что ты принёс нашей семье, я из тебя душу выну!»~
@8432  = ~«Сарос был твоим братом?»~
@8433  = ~«Прости меня, Саросса. Он был виновен, и никакие узы кровного родства этого не изменят».~
@8434  = ~«Сарос был твоим братом?»~
@8435  = ~«Прости меня, Саросса. Он был виновен, и никакие узы кровного родства этого не изменят».~
@8436  = ~«Он был моим братом. Знай ты это, ты поступил бы с ним по-другому?»~
@8437  = ~«И он, и Тильдон были виновны, хотя и в разных преступлениях. Оба они предстали перед законом».~
@8438  = ~«Забудь. Прощай».~
@8439  = ~Правда: «Да».~
@8440  = ~Ложь: «Да».~
@8441  = ~«Нет».~
@8442  = ~«Ты и вправду в это веришь? Я люблю моего брата, но ты по-своему прав, и я не могу тебя порицать».~
@8443  = ~«Хорошо. Тогда я хотел бы задать тебе пару вопросов, ты не против?»~
@8444  = ~«Если так, не вернёшь ли ты украденную тобой часть меня?»~
@8445  = ~«Если так, не вернёшь ли ты украденную тобой часть меня?»~
@8446  = ~«Если так, не вернёшь ли ты украденную тобой часть меня?»~
@8447  = ~Правда: «Я прошу прощения за то горе, которое принёс тебе и твоей семье, леди».~
@8448  = ~Ложь: «Я прошу прощения за то горе, которое принёс тебе и твоей семье».~
@8449  = ~«Тогда прощай».~
@8450  = ~«Ты и вправду рассчитывал обмануть ту, что может читать в сердцах мужчин? Дурак, — она произносит лишь одно слово, и воздух вокруг словно искривляется, вырывая часть тебя и унося её в эфир. — Уходи отсюда, израненный, и больше не подходи ко мне».~
@8451  = ~«Я ещё вернусь. Ты мне за это заплатишь».~
@8452  = ~«Прощай, Саросса. Я этого не забуду».~
@8453  = ~Её взгляд устремляется вдаль, как будто она видит что-то, недоступное твоим пяти чувствам. «Ты прощён до тех пор, пока помнишь, что у всех твоих дел есть последствия, видишь ты их или нет, и что ты можешь причинять боль просто по неведению. Пусть эти слова принесут тебе пользу».~
@8454  = ~«Спасибо. Ты не могла бы ответить на кое-какие вопросы?»~
@8455  = ~«Спасибо. Прощай».~
@8456  = ~«Он был моим братом, а сейчас и отец мой при смерти. Надеюсь, твоё сердце выдержит груз того, что ты принёс в мир столько горя».~
@8457  = ~«Я не могу отбросить свою веру в закон ради выгоды кого-то одного».~
@8458  = ~«Разумеется выдержит. Так было раньше, и, скорее всего, так будет впредь».~
@8459  = ~«Если бы я знал, что он твой брат, я не впутал бы его в это дело».~
@8460  = ~«Такие думы не греют моё сердце. Но я верю, что страдания часто ведут к лучшему. Хотя мы сразу и не видим это лучшее, мы учимся видеть хорошее, когда боль уходит».~
@8461  = ~«Тогда проси прощения».~
@8462  = ~Правда: «Я не имел права так говорить с тобой. Мои слова и поступки были поспешными, меня вели злые помыслы. Я приложу все усилия, чтобы в дальнейшем быть осторожнее».~
@8463  = ~Ложь: «Я не имел права так говорить с тобой. Мои слова и поступки были поспешными, меня вели злые помыслы. Я приложу все усилия, чтобы в дальнейшем быть осторожнее».~
@8464  = ~«Нет».~
@8465  = ~«Не лги мне в глаза, получеловек, или я выну твою жизнь из тела, — она выплёвывает ещё одно замысловатое слово, и ты с содроганием чувствуешь, как тебя покидает очередная часть твоей души. — Уходи же. Я не желаю говорить с тобой».~
@8466  = ~Напасть на неё.~
@8467  = ~«Тогда прощай».~
@8468  = ~«Если в твоём сердце нет сожаления, нет его и в моём. Уходи. Сейчас же».~
@8469  = ~Напасть на неё.~
@8470  = ~«Прощай».~
@8471  = ~«Тогда проси прощения».~
@8472  = ~Правда: «Я не имел права так говорить с тобой. Мои слова и поступки были поспешными, меня вели злые помыслы. Я приложу все усилия, чтобы в дальнейшем быть осторожнее».~
@8473  = ~Ложь: «Я не имел права так говорить с тобой. Мои слова и поступки были поспешными, меня вели злые помыслы. Я приложу все усилия, чтобы в дальнейшем быть осторожнее».~
@8474  = ~«Нет».~
@8475  = ~«Тогда проси прощения».~
@8476  = ~Правда: «Я не имел права так говорить с тобой. Мои слова и поступки были поспешными, меня вели злые помыслы. Я приложу все усилия, чтобы в дальнейшем быть осторожнее».~
@8477  = ~Ложь: «Я не имел права так говорить с тобой. Мои слова и поступки были поспешными, меня вели злые помыслы. Я приложу все усилия, чтобы в дальнейшем быть осторожнее».~
@8478  = ~«Нет».~
@8479  = ~Её рот вновь порождает странные слоги, и ты чувствуешь себя полным — как если бы в твою духовную сущность добавили недостающее. «Ты свободен, получеловек. Что тебе нужно?»~
@8480  = ~«Почему ты называешь меня получеловеком?»~
@8481  = ~«Я просто хотел бы услышать ответы на кое-какие вопросы».~
@8482  = ~«Расскажи мне о своей семье».~
@8483  = ~«Расскажи мне о своей семье».~
@8484  = ~«Расскажи мне о своей семье».~
@8485  = ~«Расскажи мне о своей семье».~
@8486  = ~«Не уважаешь никого, кроме себя, да? Мне это отвратительно в ком бы то ни было, как бы ты ни был одарён. Прощай, получеловек. СТРАЖА!»~
@8487  = ~«Твой брат говорил, что у тебя есть особый талант».~
@8488  = ~«Ничего. Прощай».~
@8489  = ~Напасть на неё.~
@8490  = ~Уйти.~
@8491  = ~«Я зову тебя так потому, что не вижу твоей души. Все другие смертные, с которыми я встречалась, раскрывали мне свою душу. У одних она была яркой вспышкой, у других тлела, как угли. У тебя же я её не вижу. Я называю тебя получеловеком потому, что не могу разглядеть твою душу, как вижу души других. Быть может, у тебя и вовсе нет души, а может, она вне досягаемости, не скажу. Так или иначе, ты человек только наполовину. Какова же твоя вторая половина — я не могу сказать».~
@8492  = ~«Ясно. Тогда ответь мне на другие вопросы».~
@8493  = ~«Ясно. Прощай».~
@8494  = ~«Какие ответы ты ищешь, получеловек?»~
@8495  = ~«Почему ты называешь меня получеловеком?»~
@8496  = ~«Мне нужно поговорить с тобой о твоём отце».~
@8497  = ~«Кто ты?»~
@8498  = ~«Расскажи мне о своей семье».~
@8499  = ~«Расскажи мне о своей семье».~
@8500  = ~«Расскажи мне о своей семье».~
@8501  = ~«Расскажи мне о своей семье».~
@8502  = ~«Пожалуй, у каждого есть особый талант. Расскажи мне, каков он у тебя».~
@8503  = ~«Никаких. Прощай».~
@8504  = ~«Мой брат Сарос — дитя Кузницы, однако боюсь, он никогда не сможет постичь всю глубину философии Верующих в Источник. Мой отец здесь управляющий, и странствия уводили его далеко от Кузницы, в те миры, которых большинство смертных и не мечтают достичь».~
@8505  = ~«Расскажи мне подробнее о своём брате».~
@8506  = ~«Расскажи мне подробнее о своём отце».~
@8507  = ~«Расскажи мне подробнее о своём отце».~
@8508  = ~«Расскажи мне подробнее о своём отце».~
@8509  = ~«Ясно. Могу я задать тебе ещё вопрос?»~
@8510  = ~«Спасибо. Прощай».~
@8511  = ~В её голосе появляется нотка горечи: «Мой брат — как тебе известно — ожидает казни. Мой отец, как тебе может быть известно, путешествует по всей мультивселенной в поисках истин, которые большинство смертных не в состоянии постичь».~
@8512  = ~«Расскажи мне подробнее о своём брате».~
@8513  = ~«Расскажи мне подробнее о своём отце».~
@8514  = ~«Расскажи мне подробнее о своём отце».~
@8515  = ~«Расскажи мне подробнее о своём отце».~
@8516  = ~«Ясно. Могу я задать тебе ещё вопрос?»~
@8517  = ~«Мой брат Сарос, надеюсь, достаточно мудр для своего возраста, а мой отец здесь управляющий, и странствия уводили его далеко от Кузницы, в те миры, которых большинство смертных и не мечтают достичь».~
@8518  = ~«Расскажи мне подробнее о своём брате».~
@8519  = ~«Расскажи мне подробнее о своём отце».~
@8520  = ~«Расскажи мне подробнее о своём отце».~
@8521  = ~«Расскажи мне подробнее о своём отце».~
@8522  = ~«Ясно. Могу я задать тебе ещё вопрос?»~
@8523  = ~«Спасибо. Прощай».~
@8524  = ~«Не знаю, как ко мне пришёл мой талант. Кажется, это всегда было моей частью. Могу только предположить, что какие-то особенности моих прошлых жизней и мои убеждения, приобретённые в этой, даровали мне особый взгляд в глубину души смертного. Я обладаю способностью видеть в каждом существе часть потенциала. Читая истинное имя смертного, а потом произнеся его чуть по-другому, я могу изменить суть этого потенциала, а тем самым и натуру его носителя».~
@8525  = ~«Можешь научить меня этому искусству?»~
@8526  = ~«А меня изменить можешь?»~
@8527  = ~«Интересно. Ответь мне на другой вопрос».~
@8528  = ~«Много же странного на свете. Прощай».~
@8529  = ~«Сарос — дерзкий, импульсивный юноша, всецело озабоченный своей зрелостью. Он жаждет доказать, что не хуже любого на планах, и потому по-юношески агрессивен. Полагаю, он по сути своей ближе к Чующим, чем к Верующим в Источник, и это лишь подкрепляет мою веру в то, что Чующие — самая незрелая фракция Сигила».~
@8530  = ~«Почему самая незрелая?»~
@8531  = ~«Расскажи мне о своём отце».~
@8532  = ~«Расскажи мне о своём отце».~
@8533  = ~«Расскажи мне о своём отце».~
@8534  = ~«Можно задать тебе ещё вопрос?»~
@8535  = ~«Спасибо… и прощай».~
@8536  = ~«Мой отец — управляющий делами Верующих в Источник, и за свою жизнь он твёрдо уверовал в то, что мы в этом мире с определённой целью. Я могу только надеяться, что он всё ещё твёрдо держится этой веры, да ещё веры в то, что его дети любят его».~
@8537  = ~«Я сообщу ему о твоих надеждах. Не ответишь мне на другой вопрос?»~
@8538  = ~«Пожалуй, он замечательный человек. Не ответишь мне на другой вопрос?»~
@8539  = ~«Пожалуй, он замечательный человек. Прощай».~
@8540  = ~«Я сообщу ему о твоих надеждах. Прощай».~
@8541  = ~«Благодаря твоим словам мой отец, Сандоз, жив и здоров. Я могу только надеяться, что какова бы ни была сила, пометившая его таким образом, — не могу поверить, что идея была его собственная, — она поплатится за свои злодеяния. Что ещё я могу для тебя сделать?»~
@8542  = ~«Можешь ответить на пару вопросов».~
@8543  = ~«Ничего. Прощай».~
@8544  = ~«Мой отец мёртв».~
@8545  = ~«Прости меня. Могу я задать тебе пару вопросов?»~
@8546  = ~«Гм… ладно. Прощай».~
@8547  = ~«Нет. Он всегда был импульсивен, жаждал доказать свою храбрость всем и вся в этом грубом мире — и вот теперь уже ничего не может. Я не буду никого винить, но и говорить об этом не хочу. Если тебе нужно узнать больше, приходи в другой раз. Прощай».~
@8548  = ~«Прощай».~
@8549  = ~«Я могу изменить тебя, но научить не смогу: разве можно научить слепого различать цвета или глухого петь? И я *изменю* тебя, если цена будет соответствующей».~
@8550  = ~«И какова цена?»~
@8551  = ~«Не думаю, что это справедливо».~
@8552  = ~«Забудь. У меня ещё пара вопросов».~
@8553  = ~«И какова цена?»~
@8554  = ~«Почему самая незрелая? Да потому что они как дети, не понимают, что есть много чего и за пределами мира чувств, за пределами того, что можно видеть, слышать, ощущать, трогать, обонять. Посмотри вокруг себя. Ты на одном из Внешних планов. Здесь вера становится материальной, но это не означает, что сию грубую на вид материю можно постичь чувствами. Это вера, и простыми физическими характеристиками её не выразишь».~
@8555  = ~«Ясно. Давай поговорим о другом».~
@8556  = ~«Ясно. Прощай».~
@8557  = ~«Скажи мне. Ты принимаешь философию Боготов?»~
@8558  = ~Правда: «Да».~
@8559  = ~Ложь: «Да».~
@8560  = ~«Нет».~
@8561  = ~«Я недостаточно знаю для ответа на вопрос».~
@8562  = ~«Нет. Это не справедливо. Но таков мой дар, и таковы мои испытания, и я выбираю применять свои таланты как захочу. Теперь. Чем я могу тебе помочь?»~
@8563  = ~«Ответь на мои вопросы».~
@8564  = ~«Ничем не можешь, по крайней мере сейчас. Прощай».~
@8565  = ~«Тогда у меня нет препятствий тому, чтобы поделиться с тобой моим даром», — она произносит загадочное слово, потрясающее тебя до самой глубины, и ты каким-то образом чувствуешь себя сильнее.~
@8566  = ~«Как ты это сделала?»~
@8567  = ~«Благодарю! Не ответишь на кое-какие вопросы?»~
@8568  = ~«Благодарю. Прощай».~
@8569  = ~«Тебе не нравится наша философия? Почему?»~
@8570  = ~«Потому что я принадлежу к Пыльным».~
@8571  = ~«Потому что я принадлежу к Чующим».~
@8572  = ~«Потому что я принадлежу к Анархистам».~
@8573  = ~«Думаю, она хуже, чем у Пыльных. По крайней мере те не проповедуют — они принимают и идут дальше».~
@8574  = ~«Я всё ещё раздумываю над этим. Убеди меня».~
@8575  = ~«Узнай о нас больше. Войди в нашу фракцию всей душой. Если ты ещё этого не сделал, поговори с Келдором из Дуриана. Он заведует приёмом новых членов. Его можно найти здесь, в главном зале. Прощай».~
@8576  = ~«Прощай».~
@8577  = ~«Тогда не буду пытаться переубедить тебя. Что ещё я могу для тебя сделать?»~
@8578  = ~«Можешь ответить на пару вопросов».~
@8579  = ~«Ничего. Прощай».~
@8580  = ~Ты видишь молодую женщину. Когда ты к ней подходишь, она пристально смотрит тебе в глаза. Тебя охватывает беспокойство: она не просто изучает цвет твоих глаз, её взгляд проникает гораздо глубже. «Здравствуй, странник. Как твои дела?»~
@8581  = ~«Неплохо. Я хотел бы задать тебе кое-какие вопросы».~
@8582  = ~«Ты Саросса? Мне нужно поговорить с тобой о твоём отце».~
@8583  = ~«Неплохо. Прощай».~
@8584  = ~«Здравствуй, израненный человек. Что тебе от меня нужно?»~
@8585  = ~«Ответы».~
@8586  = ~«Мне нужно поговорить с тобой о твоём отце».~
@8587  = ~«Ничего. Прощай».~
@8588  = ~«Я Саросса, дочь Сандоза, одного из управляющих Боготов».~
@8589  = ~«Не ответишь мне на кое-какие вопросы?»~
@8590  = ~«Мне нужно поговорить с тобой о твоём отце».~
@8591  = ~«Ясно. Спасибо. Прощай».~
@8592  = ~«Что с ним?»~
@8593  = ~«Он заперся в своей комнате и грозится покончить с собой. Не расскажешь о нём чего-нибудь, что помогло бы мне удержать его от этого шага?»~
@8594  = ~«Ты лжёшь! Мой отец путешествует! Он должен быть в отъезде ещё несколько дней как минимум!»~
@8595  = ~«И тем не менее. Поговори с Келдором, если не веришь мне. Помоги мне, если хочешь видеть отца в живых».~
@8596  = ~«Ты мне не веришь? Ну хорошо. Это будет на твоей совести. Прощай».~
@8597  = ~«Хочу, будь уверен, — она замолкает и смотрит на тебя тяжёлым взглядом. — Ты говоришь правду, ведь так? Я не вижу лжи в твоём сердце. Отлично. Я хочу, чтобы ты передал моему отцу вот что: „Вся жизнь — испытание. Нельзя его вот так просто избежать, закончив всё. Это не ответ. Только Стражи Судьбы и Пыльные верят в полное разрушение, за это ты их всегда и презирал“. Запомни это».~
@8598  = ~«Я ему передам. Но сперва я хотел бы задать тебе пару вопросов».~
@8599  = ~«Я ему передам. Прощай».~
@8600  = ~«И ты смеешь заговаривать со мной после того, как послал моего брата на плаху? За то горе, что ты принёс нашей семье, я из тебя душу выну!»~
@8601  = ~«Сарос был твоим братом?»~
@8602  = ~«Прости меня, Саросса. Он был виновен, и никакие узы кровного родства этого не изменят».~
@8603  = ~«Сарос был твоим братом?»~
@8604  = ~«Прости меня, Саросса. Он был виновен, и никакие узы кровного родства этого не изменят».~
@8605  = ~«И он, и Тильдон были виновны, хотя и в разных преступлениях. Оба они предстали перед законом».~
@8606  = ~«Я и не смею. Прощай».~
@8607  = ~Толпа черепов~
@8608  = ~Чувственное касание~
@8609  = ~Разговор с мёртвыми~
@8610  = ~Чувство отклонения~
@8611  = ~Цветная сфера~
@8612  = ~Доспех~
@8613  = ~Малое бальзамирование~
@8614  = ~Железный кулак~
@8615  = ~Опознание~
@8616  = ~Устрашение~
@8617  = ~Магический снаряд~
@8618  = ~Умиротворение~
@8619  = ~Защита от зла~
@8620  = ~Захват~
@8621  = ~Щит~
@8622  = ~Жалящее касание~
@8623  = ~Снаряд терпения~
@8624  = ~Поцелуй гадюки~
@8625  = ~Проклятие чёрных шипов~
@8626  = ~Щит чёрных шипов~
@8627  = ~Кровавый мост~
@8628  = ~Великое бальзамирование~
@8629  = ~Гулкое эхо~
@8630  = ~Ледяной нож~
@8631  = ~Раздражение~
@8632  = ~Зеркало боли~
@8633  = ~Луч ослабления~
@8634  = ~Сила~
@8635  = ~Проклятие роя~
@8636  = ~Шаровая молния~
@8637  = ~Повязка Сирелина~
@8638  = ~Смущение~
@8639  = ~Мантия опеки~
@8640  = ~Слёзы Элизиума~
@8641  = ~Призрачный доспех~
@8642  = ~Удержание нежити~
@8643  = ~Невыносимый саркастический смех Таши~
@8644  = ~Прикосновение вампира~
@8645  = ~Секира страданий~
@8646  = ~Чёрная сфера~
@8647  = ~Замешательство~
@8648  = ~Отчаяние~
@8649  = ~Удар огня~
@8650  = ~Заряды силы~
@8651  = ~Улучшенная сила~
@8652  = ~Улучшенное прикосновение вампира~
@8653  = ~Саван теней~
@8654  = ~Облако-убийца~
@8655  = ~Конус холода~
@8656  = ~Аура страха~
@8657  = ~Дупликация Энолл-Эва~
@8658  = ~Оболочка антимагии~
@8659  = ~Сфера неуязвимости~
@8660  = ~Вопль Пандемониума~
@8661  = ~Кислотный шторм~
@8662  = ~Вихрь лезвий~
@8663  = ~Огонь и лёд~
@8664  = ~Мантия защитника~
@8665  = ~Буря~
@8666  = ~Гит поворачивается к тебе, когда ты подходишь ближе. Его глаза — как два чёрных камешка; их взгляд быстро окидывает твою фигуру, затем останавливается на лице. Хотя гит похож на человека, у него жёлтый оттенок кожи и вытянутые черты. Телосложение тонкое, угловатое; конечности выглядят так, будто состоят только из переплетённых мышц. Одежда представляет собой причудливую смесь ярких тонов и скучных оттенков грязно-коричневого.~
@8667  = ~Глаза гита упираются в твои. Какой-то миг он молчит, изучая тебя, затем отвечает на ломаном всеобщем. Из-за акцента его тяжело понять — такое ощущение, что он берёт каждое слово, ломает его, затем извлекает по одному слогу. Если ты правильно его понимаешь, он говорит просто: «Путнику приветствие».~
@8668  = ~Глаза гита упираются в твои. Какой-то миг он молчит, изучая тебя, затем отвечает на ломаном всеобщем. Из-за акцента его тяжело понять — такое ощущение, что он берёт каждое слово, ломает его, затем извлекает по одному слогу. Если ты правильно его понимаешь, он говорит просто: «Ты мне *неизвестен*». На слове *неизвестен* он делает необычный упор.~
@8669  = ~Каменное выражение на лице гита медленно исчезает, и вызов в его взгляде сменяется удивлением. «Ты мне *неизвестен*, — он снова оценивающе тебя разглядывает. — Я выслушаю тебя».~
@8670  = ~Гит поворачивается к тебе, как только ты подходишь. Как и у Дак'кона, у него жёлтый оттенок кожи и худощавое телосложение. Одежда представляет собой причудливую смесь ярких тонов и скучных оттенков грязно-коричневого. Взгляд непроницаемо-чёрных глаз скользит по Дак'кону, затем по тебе.~
@8671  = ~Мужчина не обращает на тебя внимания и поворачивается к Дак'кону. Он произносит несколько рубленых слов на грубом языке, которого ты не понимаешь. Пока он говорит, его выражение не меняется, он не делает никаких жестов, поэтому ты даже и догадаться не можешь, о чём это он. Дак'кон отвечает отрывистыми словами на том же языке, и гитцерай замолкает.~
@8672  = ~Когда ты заговариваешь, гитцерай поворачивается к тебе, затем обратно к Дак'кону и говорит снова, на этот раз куда больше. Дак'кон отвечает — кажется, в точности теми же словами, что и в прошлый раз. Гитцерай снова замолкает. Дак'кон говорит что-то другое, и гитцерай отвечает ему ещё одним потоком слов.~
@8673  = ~Пустой кивок.~
@8674  = ~«Твои слова *известны* мне, — прерывает гитцерай. — Обращайся ко мне и говори, что на уме. Я выслушаю тебя».~
@8675  = ~Гитцерай не обращает на тебя внимания и поворачивается к Дак'кону. Он произносит несколько рубленых слов на странном грубом языке, если ты правильно понимаешь, он сказал: «Весьма признателен, *зерт*».~
@8676  = ~Когда ты заговариваешь, гитцерай поворачивается к тебе, затем обратно к Дак'кону и говорит снова, на этот раз куда больше.~
@8677  = ~Ты с трудом улавливаешь структуру фразы, но, видимо, он сказал: «Здесь тот, чьё имя Дак'кон, кто не один из Народа. Сказано, что разум его разделён. Сказано, что он *зерт*, который не *знает* слов Зертимона».~
@8678  = ~Ответ гита так стремителен и напорист, что, пожалуй, за ним стоит агрессия. Ты не уверен, что уловил весь смысл, но, судя по всему, гит бросает Дак'кону своеобразный вызов в форме вопроса: «*Зерт*, ты *подчиняешься* словам этого человека?»~
@8679  = ~Гит некоторое время молчит. «Это дело воняет иллитидами, — его глаза изучают лицо Дак'кона. — Я не вижу на тебе цепей. Говори, что на уме. Как же могло случиться такое кощунство?»~
@8680  = ~Гит не смотрит на тебя. Всё его внимание обращено к Дак'кону: «Он может говорить. Я выслушаю его».~
@8681  = ~Гит поворачивается и сверлит тебя взглядом. Дак'кон по-прежнему пристально смотрит на гита.~
@8682  = ~Клинок гита исчезает, он отступает. Дак'кон опускает оружие. Гит шипит в лицо Дак'кону: «Глаз Вилкуара не так ярок, а сердце Селканта не так черно. Это не будет забыто». Похоже, он собирается уходить.~
@8683  = ~Гит поворачивается к Дак'кону: «Слова этого человека отравляют мои уши. Я должен его слушать?»~
@8684  = ~На какой-то миг тебе кажется, что гит тебя не услышал. Затем в воздухе раздаётся шелест стали, а в руках гита вырастает клинок. Дак'кон немедленно обнажает свой: скорее всего, он собирается напасть на гита, если тот сделает хоть шаг к тебе.~
@8685  = ~Хотя Дак'кон стоит с обнажённым клинком, гит не отрывает от тебя взгляда. Но его следующий вопрос адресован Дак'кону: «Твой разум разделён в этом вопросе?»~
@8686  = ~«В этом деле отзвуки иллитидов, *зерт*. Ты обнажил оружие против одного из Народа. Во имя Зертимона, я не могу позволить подобное оскорбление и оставить его слова без иного ответа, чем пролитая кровь».~
@8687  = ~Гит поворачивается к тебе, но всё его внимание по-прежнему обращено к Дак'кону. «Как же могло случиться такое кощунство, *зерт*?»~
@8688  = ~Гит ждёт. Видимо, он на распутье.~
@8689  = ~Гит поворачивается к тебе, когда ты подходишь ближе. Его глаза — как два чёрных камешка; их взгляд быстро окидывает твою фигуру, затем останавливается на лице. Хотя гит похож на человека, у него жёлтый оттенок кожи и вытянутые черты. Телосложение тонкое, угловатое; конечности выглядят так, будто состоят только из переплетённых мышц. Одежда представляет собой причудливую смесь ярких тонов и скучных оттенков грязно-коричневого.~
@8690  = ~В воздухе раздаётся шелест стали, и в руке гитцерай вырастает клинок. «Ты *известен* мне. Ты обнажил оружие против одного из Народа. Пусть эти камни напьются твоей крови».~
@8691  = ~Гит колеблется. «Здесь нет ошибки. Всё совпадает с описанием: человеческий мужчина в шрамах».~
@8692  = ~Гит морщит лоб, затем опускает оружие: «Прости меня. Обещаю в дальнейшем аккуратнее выбирать слова». Он всё ещё исполнен подозрения.~
@8693  = ~Гит колеблется. «Здесь нет ошибки. Всё совпадает с описанием: человеческий мужчина в шрамах». Он смотрит на Дак'кона: «Ты говоришь за этого человека, *зерт*?»~
@8694  = ~Дак'кон отвечает медленно, наверное, чтобы успокоить гита. «Его слова — не проповедь Анархов. Он груб не по злому умыслу».~
@8695  = ~«На мой взгляд, он говорит с правдивостью и убедительностью Анарха. Моему разуму не… допустимо быть разделённым в этом вопросе».~
@8696  = ~«Не нападай. Я не могу нарушить слово».~
@8697  = ~Дак'кон снова говорит очень медленно. «Выбор Т'ча стал моим». Его кожа становится пепельного цвета, пока он говорит… речь звучит так, будто каждое слово его убивает. «Сто лет Анарха, нет таких часов, чтобы измерить историю. Дело запутано, как корни Фри'хи. Его разрешение одно из невозможных и может никогда не прийти, — Дак'кон хмурится. — Не нападай, или я стану убийцей родичей».~
@8698  = ~Дак'кон отвечает на том же языке. У фразы странное строение; тебе кажется, Дак'кон сказал: «Он в числе заслуживающих доверия».~
@8699  = ~Дак'кон отвечает то же, что и в прошлый раз; тон его чуть изменился, но смысл, похоже, нет: «Он в числе заслуживающих доверия». Дак'кон умолкает, как бы давая время осознать свои слова. «Тот, что рядом со мной, говорит. Услышишь ли ты его?»~
@8700  = ~Ответ Дак'кона короток, но говорит он медленно, словно вытягивая слова клещами: «Выбор Т'ча стал моим».~
@8701  = ~Дак'кон снова говорит очень медленно: «Эти цепи — мой собственный выбор». Его кожа становится пепельного цвета, пока он говорит… речь звучит так, будто каждое слово его убивает. «Сто лет Анарха, нет таких часов, чтобы измерить историю. Дело запутано, как корни Фри'хи. Его разрешение одно из невозможных и может никогда не прийти, — Дак'кон хмурится, его голос крепнет. — Тот, что рядом со мной, говорит. Услышишь ли ты его?»~
@8702  = ~Дак'кон поворачивается к тебе: «Он будет слушать тебя».~
@8703  = ~Дак'кон кивает, но так медленно, как будто это причиняет ему боль. «Ты… ошибся. Этот человек не убивал никого из Народа».~
@8704  = ~Дак'кон поворачивается к гитцерай и говорит, на этот раз медленнее и более взвешенно. Гитцерай отвечает очень коротко.~
@8705  = ~«Я сказал, „приветствую“».~
@8706  = ~«Я сказал, „приветствую“».~
@8707  = ~«Я сказал, „приветствую“».~
@8708  = ~«Я сказал, „приветствую“».~
@8709  = ~«Я сказал, „приветствую“».~
@8710  = ~«Я сказал, „приветствую“».~
@8711  = ~«У меня кое-какие вопросы…»~
@8712  = ~«У меня кое-какие вопросы…»~
@8713  = ~«У меня кое-какие вопросы…»~
@8714  = ~«У меня кое-какие вопросы…»~
@8715  = ~«У меня кое-какие вопросы…»~
@8716  = ~«У меня кое-какие вопросы…»~
@8717  = ~«Неважно. Извини за беспокойство».~
@8718  = ~«Ну и ладно…»~
@8719  = ~«Ты гитиянки, так ведь? У меня к тебе кое-какие вопросы…»~
@8720  = ~«Я сказал, „приветствую“».~
@8721  = ~«Ты меня понимаешь?»~
@8722  = ~«У меня кое-какие вопросы…»~
@8723  = ~«Неважно. Прощай».~
@8724  = ~«У меня к тебе вопросы…»~
@8725  = ~«Неважно. Прощай».~
@8726  = ~Заступить ему дорогу.~
@8727  = ~Дать ему уйти.~
@8728  = ~«Можешь сначала ответить на кое-какие вопросы?»~
@8729  = ~«Нет. Сперва ответь на кое-какие вопросы».~
@8730  = ~«Я не отступлю. Предлагаю тебе вложить свой свинорез в ножны, пока я не вложил его в тебя».~
@8731  = ~Напасть на него первым.~
@8732  = ~Отойти в сторону и дать ему пройти.~
@8733  = ~«Я просто хотел спросить».~
@8734  = ~«Сперва ответь на кое-какие вопросы».~
@8735  = ~«Я не отступлю. Предлагаю тебе вложить свой свинорез в ножны, пока я не вложил его в тебя».~
@8736  = ~Напасть на него первым.~
@8737  = ~«Готовься к смерти…»~
@8738  = ~Нет ответа.~
@8739  = ~Попытаться перевести…~
@8740  = ~Попытаться перевести…~
@8741  = ~«Прошу прощения?»~
@8742  = ~«Прямо сейчас — ничего. Прощай».~
@8743  = ~«Что я делаю? Я инженер из инженеров. Я учился у кузнеца Кацана из танар'ри, который ковал слова в кузнице гнева, закаливал их в отчаянии и посылал крушить тупость. К нему приходили элементы фраз, меткие слова, и он создавал оружие чудовищной силы — оружие, которое могло повергнуть любого врага и разрушить чужие убеждения. Я уверен, ты видел его работу».~
@8744  = ~«Хм… это значит, что ты будешь меня слушать?»~
@8745  = ~«Хорошо. Ты будешь меня слушать?»~
@8746  = ~Оставить мужчину в покое.~
@8747  = ~«Вовсе нет! Моя кузница построена не на ненависти, а на понимании. Я учился и у архонского мастера Терасафирея, который создал исцеляющее прикосновение благородного ума, той идеи, которая переплавляет любое злобное сердце. Он творил силой воли вместе с любовью и преданностью. Моя работа блекнет перед его творениями, как блекнет душа смертного перед демоническим и небесным».~
@8748  = ~«Каждое решение, каждое действие, каждое ответное действие — всё это закладывает фундамент, на котором будет построено что-то другое. Тогда представляется очевидным, что наше нынешнее состояние закладывает фундамент для перехода в какое-то новое, более высокое качество. Что же это, если не божественность? Именно так я всегда это оправдывал, но, честно говоря, я не в настроении для философских споров. Если охота, найди управляющего или ещё кого».~
@8749  = ~«Посмотрим. Ты будешь меня слушать?»~
@8750  = ~Оставить мужчину в покое.~
@8751  = ~«Я ищу кое-кого по имени Фарод. Ты что-нибудь о нём знаешь?»~
@8752  = ~«Я потерял дневник. Ты его не видел?»~
@8753  = ~«Не можешь рассказать мне о Дак'коне?»~
@8754  = ~«Ты знаешь гитцерай по имени Дак'кон?»~
@8755  = ~«Не расскажешь мне об этом городе?»~
@8756  = ~«Так ты создаёшь здесь губительное оружие?»~
@8757  = ~«Можешь рассказать мне о Сигиле?»~
@8758  = ~«Конечно. У меня другие вопросы».~
@8759  = ~«Да, должно быть. Прощай».~
@8760  = ~«Я хотел бы задать кое-какие… конкретные… вопросы об этом городе».~
@8761  = ~«Твои товарищи по работе такие же мастера, как и ты?»~
@8762  = ~«Невероятно! Могу я спросить тебя о другом?»~
@8763  = ~Оставить мужчину в покое.~
@8764  = ~«Это нужно как следует обдумать. Прощай».~
@8765  = ~«Где мне найти управляющего?»~
@8766  = ~«Ясно. Могу я задать тебе другой вопрос?»~
@8767  = ~«Ясно. Прощай».~
@8768  = ~«У меня другие вопросы…»~
