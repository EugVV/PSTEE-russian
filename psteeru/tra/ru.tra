@38349 = ~«Мне надо знать твоё имя, чтобы искать сведения о твоём голосе…»~
@38350 = ~«Мне надо знать твоё имя, чтобы искать сведения о твоём голосе. Тебя зовут „Экко“?»~
@38351 = ~Клятва: «Клянусь, я отыщу способ вернуть тебе голос».~
@38352 = ~«Я постараюсь вернуть тебе голос».~
@38353 = ~«Я могу попробовать вернуть тебе голос… но не бесплатно».~
