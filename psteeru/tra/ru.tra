@13246 = ~«Гм… Гвоздичка, у меня были вопросы…»~
@13247 = ~«Неважно, Гвоздичка. Прощай».~
@13248 = ~Правда: «Анна… прошу прощения, если оскорбил тебя. Я неудачно выразился и надеюсь, ты сможешь меня простить… во имя нашей дружбы, если уж иначе никак».~
@13249 = ~Правда: «Анна… прошу прощения, если оскорбил тебя. Я неудачно выразился и надеюсь, ты сможешь меня простить… во имя нашей дружбы, если уж иначе никак».~
@13250 = ~Ложь: «Анна… прошу прощения, если оскорбил тебя. Я неудачно выразился и надеюсь, ты сможешь меня простить… во имя нашей дружбы, если уж иначе никак».~
@13251 = ~Ложь: «Анна… прошу прощения, если оскорбил тебя. Я неудачно выразился и надеюсь, ты сможешь меня простить… во имя нашей дружбы, если уж иначе никак».~
@13252 = ~«Не обращай на неё внимания, Гвоздичка. У меня были вопросы…»~
@13253 = ~«У меня были вопросы, Гвоздичка».~
@13254 = ~«Не бери в голову, Гвоздичка. Прощай».~
@13255 = ~Уйти.~
@13256 = ~Уйти.~
@13257 = ~Уйти.~
@13258 = ~Уйти.~
@13259 = ~«В Улье на каждом шагу разборки… а судя по твоему виду, ты поучаствовал в куче таких! Я слыхала, тут бродит опасный тип, напрашивается на неприятности и окрашивает меч в красный. По виду благородного происхождения, — она снова бросает на тебя оценивающий взгляд. — Не сомневаюсь, ты можешь за себя постоять… и твоя милая подружка тоже круто выглядит». Гвоздичка выжидающе смотрит на Анну, но та игнорирует её комментарий.~
@13260 = ~«Как тут с работой?»~
