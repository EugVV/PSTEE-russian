@4103  = ~БИНТЫ
Восстанавливают 3 пункта здоровья.
Вес: 0

Это бинты, полезные для перевязки лёгких ран. При использовании бинты восстанавливают 3 пункта здоровья.~
@4104  = ~Нагрудная пластина 4~
@4105  = ~Кожаный ремень~
@4106  = ~Это бинты, полезные для перевязки лёгких ран. При использовании бинты восстанавливают 3 пункта здоровья.~
@4107  = ~Мусор~
@4108  = ~Тряпьё~
@4109  = ~Нагрудная пластина 3~
@4110  = ~Укус Морте (острый)~
@4111  = ~Кожаный фартук~
@4112  = ~Расписка с печатью символа Боготов. Возможно, имеет хождение в Великой Кузнице.~
@4113  = ~Кожаный ремень~
@4114  = ~Укус Морте~
@4115  = ~Необычная железка~
@4116  = ~Расписка~
@4117  = ~Щипцы~
@4118  = ~Мусор~
@4119  = ~«Приветствую».~
@4120  = ~Сделать вид, что ты здешний, и, не обращая на него внимания, просто пройти мимо.~
@4121  = ~Глаза Пыльного сужаются до щелей, а рука опускается на кинжал. Похоже, он хочет позвать и других стражников.~
@4122  = ~Ты наклоняешься, чтобы «прошептать» ему, и Пыльный тоже наклоняется. Как только его голова оказывается в зоне захвата, твои руки смыкаются на висках и ты резко поворачиваешь его голову влево.~
@4123  = ~Прежде чем Пыльный успевает произнести хоть слово, твои руки охватывают его виски и резко поворачивают голову влево.~
@4124  = ~Слышится хруст, и Пыльный обмякает у тебя в руках.~
@4125  = ~К твоему удивлению, действие было инстинктивным, как будто ты раньше делал это много раз… эта мысль вызывает волнение в памяти, но слишком слабое, чтобы что-либо уловить.~
@4126  = ~Ты недостаточно быстр, и Пыльный уворачивается, когда ты нападаешь. Отступая назад, он трижды звонко хлопает в ладоши. В ответ в Мортуарии начинает звонить большой железный колокол.~
@4127  = ~Пыльный трижды звонко хлопает в ладоши. В ответ в Мортуарии начинает звонить большой железный колокол.~
@4128  = ~Пыльный хмурится, когда ты к нему обращаешься: «Что тебе здесь надо?»~
@4129  = ~Ты видишь сурового вида человека в чёрных одеждах. Он смотрит строго перед собой. Похоже, он вообще не замечает твоего присутствия.~
@4130  = ~Охранник Пыльных подпрыгивает от удивления, когда ты обращаешься к нему, затем отступает назад: «Ты не зомби… кто ты… и как сюда попал?»~
@4131  = ~Ты видишь сурового вида человека в чёрных одеждах. Заметив тебя, он кивает.~
@4132  = ~«Приветствую, посвящённый».~
@4133  = ~«В вестибюле есть гиды. Они должны помочь тебе, посвящённый».~
@4134  = ~«Эй! Эй! Что ты делаешь?»~
@4135  = ~«Если собираешься чесать языком с Пыльными, избавь меня от этого. Я и они не лучшие приятели… и тебе не стоит якшаться с ними. Они скорее спалят тебя или похоронят, чем будут слушать. Не будь идиотом; давай валить отсюда».~
@4136  = ~«Эй! Ты что, оглох? Что ты делаешь?»~
@4137  = ~«Тогда *не слушай* меня — это твои похороны».~
@4138  = ~«Ага, можешь заказывать панихиду. А сейчас помолчи».~
@4139  = ~«Ты прав. Забудь. Пошли».~
@4140  = ~«Слушай, я собираюсь поговорить с этим парнем. Есть проблемы?»~
@4141  = ~«Ничего, пошли».~
@4142  = ~«Спасибо за совет, но я *всё ещё* собираюсь поговорить с этим парнем».~
@4143  = ~«Договорились, пошли».~
@4144  = ~«Я собираюсь *поговорить* с этим парнем. Какие-то проблемы?»~
@4145  = ~«Ничего, пошли».~
@4146  = ~Попытаться проигнорировать его, пройти мимо.~
@4147  = ~«Никаких дел. Я заблудился, но сейчас направляюсь к выходу».~
@4148  = ~«Зови своих друзей, Пыльный… очень хочу с ними встретиться».~
@4149  = ~Убежать.~
@4150  = ~Ждать.~
@4151  = ~Сломать ему шею, прежде чем он закричит.~
@4152  = ~Сломать ему шею, прежде чем он закричит.~
@4153  = ~«Зови своих друзей, Пыльный… очень хочу с ними встретиться».~
@4154  = ~Убежать.~
@4155  = ~Ждать.~
@4156  = ~«Я не могу позволить тебе поднять тревогу…»~
@4157  = ~«Я не могу позволить тебе поднять тревогу…»~
@4158  = ~«Лучше уж ты, чем я, Пыльник».~
@4159  = ~«Лучше уж ты, чем я, Пыльник».~
@4160  = ~Спрятать тело в тень, затем идти дальше.~
@4161  = ~«Надеюсь, ты помолился сегодня своим богам, Пыльный…»~
@4162  = ~«Надеюсь, ты помолился сегодня своим богам, Пыльный…»~
@4163  = ~«Похоже, я заблудился в этих залах. Здесь есть какие-нибудь гиды, которые указывают дорогу посетителям?»~
@4164  = ~«Похоже, я… потерялся».~
@4165  = ~«Мои дела — это мои дела. Займись-ка лучше своими СОБСТВЕННЫМИ, Пыльный».~
@4166  = ~Наклониться к нему, будто собираешься что-то прошептать, и свернуть ему шею.~
@4167  = ~Наклониться к нему, будто собираешься что-то прошептать, и свернуть ему шею.~
@4168  = ~«Единственное, что мне надо — покинуть это место. Я не хочу причинять неприятности».~
@4169  = ~«Ничего. Я заблудился, но сейчас направляюсь к выходу».~
@4170  = ~«Приветствую».~
@4171  = ~Прошаркать мимо.~
@4172  = ~Сломать ему шею, прежде чем он закричит.~
@4173  = ~Сломать ему шею, прежде чем он закричит.~
@4174  = ~«Я могу объяснить… видишь ли, всё началось, когда я очнулся после смерти на одной из плит… там был говорящий череп и…»~
@4175  = ~Убежать.~
@4176  = ~«Приветствую».~
@4177  = ~Кивнуть в ответ, продолжать идти.~
@4178  = ~«Возможно, ты поможешь мне. Кажется, я заблудился. Не укажешь мне дорогу?»~
@4179  = ~«Похоже, я… потерялся».~
@4180  = ~«Не буду отвлекать, посвящённый».~
