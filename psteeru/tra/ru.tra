@19754 = ~ВОИН/ВОР~
@19755 = ~«Мне пора идти. Прощай».~
@19756 = ~ВОИН/МАГ~
@19757 = ~«Почему я здесь заключён?»~
@19758 = ~Вор~
@19759 = ~«Где я?»~
@19760 = ~«Что ты здесь делаешь?»~
@19761 = ~«Кто живёт в этом месте?»~
@19762 = ~Маг~
@19763 = ~«Позволь спросить кое о ком в частности…»~
@19764 = ~Священник~
@19765 = ~«Не видел здесь небольшой бронзовой сферы?»~
@19766 = ~Воин/вор~
@19767 = ~Воин/маг~
@19768 = ~«Неважно. Прощай».~
@19769 = ~«У меня другие вопросы…»~
@19770 = ~«Это всё, что я хотел узнать. Прощай».~
