@33703 = ~«Где находится ночлежка?»~
@33704 = ~«Куда ведут северные ворота?»~
@33705 = ~«Куда ведут восточные ворота?»~
@33706 = ~«Это всё, что я хотел узнать. Прощай».~
@33707 = ~Эта улыбающаяся женщина средних лет подбегает к тебе и делает реверанс: «Здорово, сэр, рада встрече! Всего за один медяк я могу предложить услуги проводника. Подсказать какое-нибудь направление?»~
@33708 = ~Эта улыбающаяся женщина средних лет весело машет тебе рукой, когда замечает твоё приближение: «Привет, сэр! Всего за один медяк я могу предложить услуги проводника. Подсказать какое-нибудь направление?»~
@33709 = ~Женщина скептически на тебя смотрит и пожимает плечами: «Проводник — это гид в своём роде, сэр. Я могу указать что угодно в этой части Улья, вроде того».~
@33710 = ~Женщина берёт монетку и делает реверанс: «В этой части Улья имеются врата, ведущие на запад и на юг; известные места включают Мортуарий, бар „Собиратели пыли“, Мемориал Пыльных и мавзолей. Ещё я рекомендую держаться подальше от одной аллеи, которая ведёт на юго-запад; там полно головорезов».~
@33711 = ~«Мортуарий — это то огромное куполообразное сооружение в северо-восточной части района. Хотя Пыльные не разрешат войти внутрь, если у тебя нет там никаких дел. Либо если ты не мёртвый, я полагаю», — улыбается она.~
@33712 = ~«Он находится в юго-западной части района… куполообразное сооружение, дверь которого выходит на юго-восток. „Собиратели пыли“ — это одна из самых безопасных, самых тихих таверн в Улье».~
@33713 = ~«Примерно в центре северной части этой территории… это окружённый стенами дворик с открытой аркой в каждой стене. Там обычно толпа Пыльных, оплакивающих кого-нибудь около юго-восточного входа».~
@33714 = ~«Мавзолей в северо-западной части района. Это большое здание, похожее на старую квадратную башню».~
@33715 = ~«Тоже в Улей, сэр. Там есть ночлежка, если ты устал и хочешь отдохнуть».~
@33716 = ~«Просто в другую часть Улья, сэр. В том направлении есть мастерская татуировок и бар „Горящий труп“. А ещё там масса бандюков… целое здание ими наполнено».~
@33717 = ~«Что значит „проводник“?»~
@33718 = ~«Конечно… вот твой медяк».~
@33719 = ~«Нет, пока не нужно. Прощай».~
