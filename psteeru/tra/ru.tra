@16541 = ~«Повеса?»~
@16542 = ~«Скажи мне».~
@16543 = ~«Расскажешь в другой раз. Прощай».~
@16544 = ~«Продолжай…»~
@16545 = ~«Дослушаю в другой раз. Прощай».~
@16546 = ~«А ты во всём этом уверен?»~
@16547 = ~«Зачем бы это извергу говорить со Сборщиком?»~
@16548 = ~«Интересный рассказ. Прощай».~
@16549 = ~«Зачем бы это извергу говорить со Сборщиком?»~
@16550 = ~«Зачем бы это извергу говорить со Сборщиком?»~
@16551 = ~«Интересный рассказ. Прощай».~
@16552 = ~«Спасибо за информацию. У меня другие вопросы…»~
@16553 = ~«Может быть, если встречу. Прощай».~
@16554 = ~«Спасибо за информацию. У меня другие вопросы…»~
@16555 = ~«Может быть, если встречу. Прощай».~
@16556 = ~«Понятно».~
@16557 = ~«Не думаю, что это стоит моего времени».~
@16558 = ~«У меня вопросы…»~
@16559 = ~«Просто проходил мимо. Прощай».~
@16560 = ~Когда ты прерываешь ход его мыслей, на мгновение он пугается. Затем неторопливо говорит спокойным, но переполненным печалью голосом: «О… и тебе привет, друг. Как у тебя дела нынче?»~
@16561 = ~Он улыбается, но в глазах всё ещё стоит печаль: «Это замечательно, друг. Надеюсь, удача не оставит тебя». Кажется, он собирается вернуться к дереву.~
@16562 = ~Похоже, он ещё больше падает духом: «Какая жалость, друг… больно слышать. Надеюсь, удача улыбнётся тебе». Кажется, он собирается вернуться к дереву.~
@16563 = ~Мужчина застигнут врасплох, но вскоре уверенно кивает: «Да, друг, важно. По крайней мере, для меня… хотя, пожалуй, не стоит придавать этому большое значение». Кажется, он собирается вернуться к дереву.~
@16564 = ~Он слабо пожимает плечами и выдавливает подобие улыбки: «Удача улыбается мне, хотя я всё так же печалюсь».~
@16565 = ~Он похлопывает по стволу дерева рядом с собой. «Эти деревья, здесь, в Улье. Они гибнут, друг, и никто не беспокоится, — видя выражение твоего лица, он вздымает ладони, как бы призывая секунду помолчать. — Может, кому-то и дела нет, но для меня это важно. Досадно смотреть, как последние остатки красоты и жизни в этом районе гибнут, заброшенные. Можешь ли ты это понять, друг?»~
@16566 = ~«Долгая история… и наверняка не из тех, что захочет слушать случайный прохожий. Давай просто скажем, что все мои попытки воодушевить здешних людей на действие остались… незамеченными».~
@16567 = ~Он вздыхает: «Я этого ожидал: такой же, как и другие. Просто оставь меня с моими мыслями, ладно?» Он отворачивается.~
@16568 = ~«Я хотел, чтобы они… они… — он выглядит раздражённым, расстроенным тем, что не может подобрать слов, — …*беспокоились*. Это так много, друг?» Он серьёзно смотрит на тебя.~
@16569 = ~Он выглядит удивлённым и выпаливает: «Правда? О! Я хочу сказать, прекрасно! Возможно, ты мог бы…» Мужчина замолкает и вдруг становится подозрительным. Он берёт себя в руки и продолжает в своей обычной неторопливой манере: «В любом случае это хорошо. Мне кажется, теперь у тебя ко мне „кое-какие вопросы“…»~
@16570 = ~В первый раз мужчина выглядит неподдельно счастливым. Лучезарно улыбаясь, он объясняет: «Здесь трудно выжить любому… просто посмотри вокруг, и поймёшь, что я имею в виду, друг. Я не знаю, могут ли деревья здесь разрастаться, даже если каким-то образом *получат* достаточно света и чистой воды…»~
@16571 = ~Он с энтузиазмом кивает: «Но если достаточно народу *обеспокоится*… действительно *захочет*, чтобы они жили… я знаю, они будут жить! Они снова зазеленеют и зацветут!»~
@16572 = ~Он понимающе улыбается, качая головой: «Ты здесь новичок, теперь я это вижу. Ты не понимаешь, как всё *устроено* в Сигиле, друг. Вера здесь решает всё… просто всё!»~
@16573 = ~«Я *прав*, я в том уверен, — убеждённость окружает его, как аура; он уже не похож на того человека, с которым ты говорил поначалу. — Это всё, о чём я тебя прошу, друг… просто беспокойся о них, надейся, что они оживут. Однажды этого захочет столько людей, что оно сбудется. Ты поможешь мне, друг?»~
@16574 = ~«Превосходно, друг мой, превосходно! Благодарю тебя… ты вернул мне мою веру, мою целеустремлённость. Возможно, я смогу найти и других, подобных тебе, кто услышит… возможно, всё изменится к лучшему. А теперь, чем я могу помочь тебе, друг?»~
@16575 = ~«Превосходно, друг мой, превосходно! Благодарю тебя… ты вернул мне мою веру, мою целеустремлённость. Возможно, я смогу найти и других, подобных тебе, кто услышит… возможно, всё изменится к лучшему. А как насчёт твоих товарищей, друг? Мог бы ты поговорить с ними от моего имени?»~
@16576 = ~«Подожди, друг… выслушай меня, — убеждённость окружает его, как аура; он уже не похож на того человека, с которым ты говорил поначалу. — Всё, о чём я тебя прошу, друг… просто беспокойся о них, надейся, что они оживут. Однажды этого захочет столько людей, что оно сбудется. Ты поможешь мне, друг?»~
@16577 = ~«Просто посмотри вокруг себя, друг. Можешь представить себе хоть *что-то*, чему здесь будет житься хорошо? И несмотря на это жалкое состояние, дабусы редко появляются в этой части Сигила».~
@16578 = ~«Ну, знаешь, дабусы. Ты наверняка их видел… они слуги Госпожи, заботятся о городе. Конечно, о некоторых районах больше, чем о прочих», — он с горечью смотрит на дерево рядом с собой.~
@16579 = ~«Госпожа Боли, друг? Владычица Сигила?» — он вдруг замолкает. Описав рукой полукруг над сердцем, он придвигается к тебе вплотную и шепчет: «Не к добру говорить о Госпоже. Знай только, что она одна правит городом — заметно это или иногда нет — и больше не упоминай о ней».~
@16580 = ~«Улей — опасное место, но тут не то… дабусы находятся под охраной Госпожи, и никто ещё не спятил настолько, чтобы ссориться с ней, друг. Думаю, причиной тому в первую очередь Фелл».~
@16581 = ~«Фелл? Он… э-э… ну, друг, я просто скажу, что он единственный дабус, который не служит Госпоже. Я не знаю всей его „тьмы“, как говорят, но он не общается со своей роднёй и живёт здесь, в Улье, один. Он держит салон татуировок, но большая часть Сигила обходит это заведение стороной».~
@16582 = ~«Отсюда всего несколько зданий на восток, и будет салон Фелла; на нём его личный знак: белый овал, перечёркнутый молнией. Сам я никогда там не был, друг, но как я понял, он может задействовать картинки из своей речи — ты же знаешь, что дабусы говорят символами? Ребусами?»~
@16583 = ~Он кивает: «Так вот, он как-то умеет переводить образы своей речи в татуировки. Но не просто обычные наколки, скажу я, там присутствует магия, и не только в способе их изготовления. Впрочем, это почти всё, что я знаю».~
@16584 = ~«Да, символами. Ты увидишь, что я имею в виду, если попробуешь заговорить с дабусом. Они запускают в воздух потоки символов над головами, — для наглядности он помахивает пальцем над своей. — вместо обычной речи. Зависит от слушателя, получится ли разгадать, что же дабус сказал, но я слыхал, что при наличии практики это легче». Он пожимает плечами.~
@16585 = ~«Знаешь, друг, с тех пор как он отвернулся от Госпожи, многие думают, что это всего лишь вопрос времени, когда на него падёт её тень. И никто не хочет оказаться рядом, когда и если *это* случится, я уверен».~
@16586 = ~«Как я уже сказал, друг, я не слишком-то уверен. Я слышал только расплывчатые слухи о том, что он оказался не на той стороне, когда какая-то сила решила потягаться с Госпожой. Ты всегда можешь попробовать спросить его, друг. Говорят, он довольно дружелюбный, хотя и немного странный».~
@16587 = ~Он кивает, ожидая вопроса.~
@16588 = ~«Здешние люди зовут меня „Плачущий-по-Деревьям“, друг».~
@16589 = ~«Трачу время впустую, если вообще что-то делаю, друг», — он печально вздыхает.~
@16590 = ~«Самая отвратительная часть Сигила, друг. Больше и сказать почти нечего», — он горько улыбается.~
@16591 = ~«В Улье? Если только ты не вор, то вряд ли что найдёшь. Всегда можно собирать трупы и таскать их к воротам Мортуария, если нужда настолько отчаянная. Я слышал, Пыльные чуток платят за них, чтобы на улицах Улья не воняло ещё гаже».~
@16592 = ~«Ну, друг… в таком месте и развлечения соответствующие. На твоём месте я бы пошёл развлекаться в другой район. Там безопаснее».~
@16593 = ~«Здесь? Всё, друг. Всё. Ну, может, кроме меня. Эх…»~
@16594 = ~«Прости, друг. Когда я впервые оказался здесь, я говорил со многими людьми… но с таким именем никого не помню».~
@16595 = ~«Не припомню, чтобы встречал где-то подобное. Когда ты последний раз его видел, друг?»~
@16596 = ~«Снова здравствуй, друг».~
@16597 = ~Он смотрит на тебя только миг, затем отводит глаза. «О, это опять ты… друг».~
@16598 = ~«Прости меня… друг. Мне нужно обо многом подумать. Может быть, мы поговорим в другой раз».~
@16599 = ~Он оглядывается на тебя всего на секунду: «Я приму твои извинения, друг. Хочешь о чём-то спросить меня?»~
@16600 = ~«Божество, друг? Бог? Как правило, Госпожа не имеет проблем с им подобными, ведь она совсем не пускает их в Сигил. Его имя было Аоскар, но больше я почти ничего не знаю».~
@16601 = ~«Госпожа Боли, друг? Владычица Сигила?» — он вдруг замолкает. Описав рукой полукруг над сердцем, он придвигается к тебе вплотную и шепчет: «Не к добру говорить о Госпоже. Знай только, что она одна правит городом — заметно это или иногда нет — и больше не упоминай о ней».~
@16602 = ~Он серьёзно кивает: «Как я понимаю, Госпожа уничтожила его. Я бы не забывал об этом, если вдруг возникнет желание связаться с ней или с её слугами».~
@16603 = ~Завидев тебя, Плачущий-по-Деревьям широко улыбается: «Ах, друг мой, ты вернулся! Что-нибудь нужно от меня?»~
@16604 = ~«Нет, пока нет, друг. Но я всё ещё надеюсь… каждый день говорю с людьми».~
@16605 = ~«Да, друг, изменения есть! Пока такие слабые, что почти незаметно, но смотри: свежая живица от стволов и несколько молодых почек. Теперь это лишь вопрос времени. Снова благодарю тебя за то, что ещё раз дал мне надежду».~
@16606 = ~На мгновение Плачущий выглядит обеспокоенным. «Что-то не так, друг? Ты вроде бы чем-то расстроен…»~
@16607 = ~«Превосходно, друг мой, превосходно! Благодарю тебя… ты вернул мне мою веру, мою целеустремлённость. Возможно, я смогу найти и других, подобных тебе, кто услышит… возможно, всё изменится к лучшему. А теперь, чем я могу помочь тебе, друг?»~
@16608 = ~«Превосходно, друг мой, превосходно! Благодарю тебя… ты вернул мне мою веру, мою целеустремлённость. Возможно, я смогу найти и других, подобных тебе, кто услышит… возможно, всё изменится к лучшему. А как насчёт твоих товарищей, друг? Мог бы ты поговорить с ними от моего имени?»~
@16609 = ~Плачущий-по-Деревьям улыбается тебе, но выглядит озадаченным: «Что ты находишь таким забавным, друг?»~
@16610 = ~Плачущий-по-Деревьям улыбается тебе, но выглядит озадаченным: «Что ты находишь таким забавным, друг?»~
@16611 = ~Плачущий-по-Деревьям замирает в ужасе, когда до него доходит, что сейчас будет. Внезапно он переходит к действиям и встаёт между Игнусом и деревьями с воплем: «Нет! Остановись! Ты не можешь!»~
@16612 = ~Завидев тебя, Плачущий-по-Деревьям широко улыбается: «Ах, друг мой, ты вернулся! Деревья хорошеют день ото дня. Что-нибудь нужно от меня?»~
@16613 = ~«А? О, ясно дело, шеф, конечно. Как скажешь».~
@16614 = ~Морте некоторое время молча глядит на тебя, затем кивает: «Да, могу. Если тебе это так важно, я так и сделаю».~
@16615 = ~«Знаешь, я *правда* не могу видеть, как это происходит везде. Тут как кровь из камня выжимать, шеф — эти малые просто-напросто так не работают».~
@16616 = ~«Ох, парень; приплыли. Я *поверить* не могу, что ты так тратишь своё время, шеф!»~
@16617 = ~«Знаешь, шеф, я достаточно странностей повидал… но сама возможность *такого* просто выносит мне мозг».~
@16618 = ~«Ох! Не могу на это смотреть!»~
@16619 = ~На этой стойке вывешены на просушку разные травы.~
@16620 = ~Этот фонарь излучает мягкий жёлтый свет… он не мерцает, как факел или пламя свечи.~
@16621 = ~«Чё? Ты ж не всерьёз щас?!»~
@16622 = ~«Хе! Не пойдёт! Ищи кого другого рыдать над своими долбаными деревьями. Ты рехнулся, если думаешь, что я потрачу время хоть на мысли о таком бреде. Рехнулся, я те говорю!»~
@16623 = ~Её ухмылка наконец уступает место улыбке: «Ах, да Баатор с ним! Если ты так обрыдался, почему б и нет? Конечно, здоровяк, я „обеспокоюсь“ о твоих деревьях. Но ты у меня в долгу, вот!»~
@16624 = ~Игнус медленно поворачивается, чтобы встретиться с тобой взглядом: «*Да-с-с?*»~
@16625 = ~Игнус поворачивается к деревьям, и воздух вокруг него тут же становится нестерпимо горячим. «*Да-с-с-с… горите…*»~
@16626 = ~Игнус разражается ужасающим хохотом, из его глотки вырываются языки пламени: «*Ты вс-с-стаёшь между мной и тем, ш-ш-што горит? Хорош-ш-шо, ты тоже сгориш-ш-шь…*»~
@16627 = ~Грейс кивает: «Конечно. На мой взгляд, превосходная мысль».~
@16628 = ~«Кто-то найдёт твою просьбу весьма интригующей. Деревья, в Улье? Подобно городам в Лимбо, они будут стоять, как проявление воли народа не склониться перед тем, что окружает и пожирает его. Напоминать о том, что всегда можно сделать нечто большее со своей жизнью, нежели просто прожить её. Я присоединю свою волю к твоей в беспокойстве о деревьях».~
@16629 = ~Дак'кон кивает: «Ко… конечно».~
@16630 = ~«Определить: Помощь, требования».~
@16631 = ~«Требуется уточнение способа заботы о них».~
@16632 = ~«Запрос: Помогать Плачущему (ТАКЖЕ Плачущий-по-Деревьям) (Дорожить деревьями). Неверная команда/имя объекта».~
@16633 = ~«Команда принята. Параметры приемлемы. Какому назначению будет служить высказанное желание?»~
@16634 = ~«Высказанное желание приводится в осуществление немедленно».~
@16635 = ~Вейлор стоит молча и неподвижно; если бы не мерцающий красный огонёк в глазах, он бы сошёл за статую.~
@16636 = ~Голос Вейлора наконец вырывается эхом из-под пустого шлема: *Состояние дерева для меня значения не имеет. Его смерть не является ни справедливой, ни несправедливой — она просто наступает*.~
@16637 = ~Эти полки заполнены книгами, книгами и снова книгами. Все они проиндексированы и расставлены по порядку.~
@16638 = ~Похоже, когда-то это сооружение было виселицей. Теперь с неё свисает только фонарь.~
@16639 = ~Этим балкам, похоже, не одна сотня лет… выглядят они твёрдыми, как камень.~
@16640 = ~Эти тряпки как будто кто-то жевал.~
@16641 = ~Стена выглядит готовой обрушиться в любой момент. Камни расшатались, и она вся в дырах.~
@16642 = ~Края этих полок когда-то были покрыты символами, но все они стёрлись. Может быть, когда-то это была библиотека?~
@16643 = ~«Приветствую…»~
@16644 = ~Оставить его в покое.~
@16645 = ~«Всё хорошо».~
@16646 = ~«Отвратительно».~
@16647 = ~«Это важно?»~
@16648 = ~«Не собираюсь я сейчас отчитываться, забудь. У меня были вопросы…»~
@16649 = ~«Неважно… прощай».~
@16650 = ~«А у тебя как дела нынче?»~
@16651 = ~«Подожди, у меня были кое-какие вопросы…»~
@16652 = ~«Прощай».~
@16653 = ~«А у тебя как дела нынче?»~
@16654 = ~«Подожди, у меня были кое-какие вопросы…»~
@16655 = ~«Прощай».~
@16656 = ~«У меня всё хорошо».~
@16657 = ~«Дела идут отвратительно».~
@16658 = ~«Не стоит придавать значения? Что ты имеешь в виду?»~
@16659 = ~«Подожди, у меня были кое-какие вопросы…»~
@16660 = ~«Прощай».~
@16661 = ~«Почему бы это?»~
@16662 = ~«Сочувствую. У меня были кое-какие вопросы…»~
@16663 = ~«Очень жаль. Прощай».~
@16664 = ~«Да… ты прав, это досадно».~
@16665 = ~«Нет. Всё когда-то умирает, зачем сосредотачиваться на том, когда и как это происходит?»~
@16666 = ~«Нет, не могу. Если деревья никому не приносят пользы, кто будет беспокоиться о них?»~
