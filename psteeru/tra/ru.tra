@22160 = ~Испытание побуждений~
@22161 = ~Лабиринт отражений~
@22162 = ~Крыша Крепости~
@22163 = ~Инженерная комната~
@22164 = ~Комната Нордома~
@22165 = ~Фойе модронов~
@22166 = ~Лабиринт
модронов~
@22167 = ~Логово волшебника~
@22168 = ~Плачущие Камни~
@22169 = ~Разрушенный склеп~
@22170 = ~Мозаичный склеп~
@22171 = ~Разделённый склеп~
@22172 = ~Часовня~
@22173 = ~Склеп Объятых~
@22174 = ~Мёртвые Народы~
@22175 = ~Тронная комната~
@22176 = ~Дом Мысли~
@22177 = ~Многие-как-Один~
@22178 = ~Затопленные Народы~
@22179 = ~Гробница~
@22180 = ~«Меббет, повитухе с Площади Мусорщиков, нужна трава из этих семян. Не можешь мне помочь?»~
@22181 = ~Лабиринт игрока~
@22182 = ~Катакомбы~
@22183 = ~Портал назад во двор Фарода~
@22184 = ~Торговец берёт семя, критически его осматривает… потом сжимает между пальцами и вздрагивает, а из большого пальца выступает капелька крови. «Ай! Это семя кусается…»~
@22185 = ~«Привет и прощай».~
@22186 = ~Он отвечает, не отрывая взгляда от семени: «Парень, я *ни у кого* тут не видел ничего похожего… честно говоря, и семян подобных никогда не видел. Тебе нужен кто-то, кому приходилось выращивать такие семена, я ничем не помогу».~
@22187 = ~«Ответа на эту загадку я не знаю, друг, — он возвращает тебе семя. — Вряд ли в Улье найдётся много садовников…»~
@22188 = ~«Меббет, повитухе с Площади Мусорщиков, нужна трава из этих семян. Не можешь мне помочь?»~
@22189 = ~Она показывает на себя и говорит снова: «Ту-ту-тухл Мыхр-ри». Похоже, гниение основательно затронуло её голосовые связки.~
@22190 = ~~
@22191 = ~«Тухлая Мэри? У меня вопросы…»~
@22192 = ~«Тухлая Мэри? У меня вопросы…»~
@22193 = ~«Мне пора идти, Мэри. Прощай».~
@22194 = ~«Меббет, повитухе с Площади Мусорщиков, нужна трава из этих семян. Не можешь мне помочь?»~
@22195 = ~Труп медленно кивает.~
@22196 = ~«У меня вопросы…»~
@22197 = ~«У меня вопросы…»~
@22198 = ~«Мне пора идти. Прощай».~
@22199 = ~«Я заметил. Есть ли у тебя травы, о которых она говорила?»~
@22200 = ~Она кивает головой, ожидая вопроса.~
@22201 = ~«Харгримм сказал, что мне нужно *научиться* слушать тебя… не знаешь, что он имел в виду?»~
@22202 = ~«Мэри, мне нужно поговорить с Безмолвным Королём. Не поможешь мне?»~
@22203 = ~«Почему я здесь заключён?»~
@22204 = ~«Ладно, но… где мне найти такого умельца?»~
@22205 = ~«Где я?»~
@22206 = ~«Ладно, но… где мне найти такого умельца?»~
@22207 = ~«Что ты здесь делаешь?»~
@22208 = ~«Ладно, но… где мне найти такого умельца?»~
@22209 = ~«Кто живёт в этом месте?»~
@22210 = ~«Позволь спросить кое о ком в частности…»~
@22211 = ~«Не видела тут небольшой бронзовой сферы?»~
@22212 = ~«Неважно. Прощай».~
@22213 = ~«Ясно. Можно посмотреть, что ещё у тебя есть?»~
@22214 = ~Она, заикаясь, мычит что-то совершенно невразумительное.~
@22215 = ~«Прости, но я не понимаю тебя. Неужели с тобой больше никак нельзя общаться?»~
@22216 = ~«Я не понимаю тебя. Ты не могла бы говорить почётче?»~
@22217 = ~«Хм… у меня другие вопросы…»~
@22218 = ~«Не бери в голову… прощай».~
@22219 = ~Она грустно качает головой и болезненно медленно пожимает плечами.~
@22220 = ~«Похоже, придётся поискать. Спасибо за помощь. Прощай».~
@22221 = ~«Тогда прощай».~
@22222 = ~«Хм-м. Возможно, поможет Плачущий-по-Деревьям… прощай».~
@22223 = ~Труп шагает к тебе, протягивая руку, чтобы дотронуться.~
@22224 = ~Отойти.~
@22225 = ~«Единственный, которого я знал… взял да помер. Впрочем неважно. Прощай».~
@22226 = ~Отойти.~
@22227 = ~Дать ей прикоснуться к себе.~
@22228 = ~«Что ты делаешь?»~
@22229 = ~«Что ты делаешь?»~
@22230 = ~Она кивает: «О да… множество. И по самым разным ценам…»~
@22231 = ~Она поднимает бровь. Затем запускает руку в свой ящик, достаёт из него старую кружку и кидает в тебя. Кружка вся покрыта вмятинами, а её ручка, кажется, вот-вот отвалится.~
@22232 = ~Она слегка улыбается.~
@22233 = ~«Слушай, мне нужно что-то, чтобы держать чернила. У тебя нет какой-нибудь кружки или кубка на продажу?»~
@22234 = ~«Слушай, мне нужно что-то, чтобы держать чернила. У тебя нет какой-нибудь кружки или кубка на продажу?»~
@22235 = ~«Слушай, мне нужно что-то, чтобы держать чернила. У тебя нет какой-нибудь кружки или кубка на продажу?»~
@22236 = ~«Хм, ну давай ту, что подешевле».~
@22237 = ~«Ого… ей, похоже, пытались кого-то убить».~
@22238 = ~«Беру. Спасибо и прощай».~
@22239 = ~«Здравствуй… и прощай».~
@22240 = ~Плачущий-по-Деревьям берёт семечко и поднимает его к глазам: «Что за странное семя… это зубы по краю? Шипы, вероятно… где ты достал его, друг?»~
@22241 = ~«Нет…» — Плачущий-по-Деревьям продолжает глазеть на семя. «Других экземпляров этого вида мне видеть не довелось… Я… ай! — он вскрикивает, на пальце у него появляется кровавое пятнышко. — Какие острые шипы! Наверное, лучше тебе забрать его».~
@22242 = ~«Если только ты сможешь вырастить эту траву. Я тут не помощник… как уже говорил, я ничего подобного не видел, друг».~
@22243 = ~Плачущий-по-Деревьям качает головой: «Не знаю. Возможно, несколько сезонов».~
@22244 = ~Плачущий-по-Деревьям смотрит на семя: «Возможно… если бы ты по-настоящему *пожелал*, чтобы она выросла…»~
@22245 = ~«Это Сигил, друг. Вера здесь всё. Всё… начиная от шпиля, на котором покоится город, до этого маленького семечка в твоих руках. Если твоя сила *веры* достаточна, возможно всё что угодно…»~
@22246 = ~Неожиданно семечко раскрывается с громким *КРАК!*, и из него начинают лезть маленькие, но подвижные веточки. Инстинктивно ты бросаешь его на землю, но один из усиков как лапка хватает тебя за запястье.~
@22247 = ~Плачущий-по-Деревьям как зачарованный глазеет на колючие ветви, охватившие твоё запястье: «Я… думаю, шипов на этих ветвях будет более чем достаточно для твоей подруги».~
@22248 = ~«Мне нужна трава, выращенная из этого семени. Не поможешь?»~
@22249 = ~«Старая Меббет, повитуха с площади, попросила меня принести траву, выращенную из этого семечка. Не подскажешь, где достать такую траву?»~
@22250 = ~«Так ты хоть чем-то можешь помочь?»~
@22251 = ~«А если сильно захотеть, чтобы семя взошло, можно заставить его прорасти?»~
@22252 = ~«Есть ли способ заставить её расти быстрее?»~
@22253 = ~«Я не собираюсь ждать. Мне нужна эта проклятая трава, и нужна прямо сейчас».~
@22254 = ~«Я не собираюсь ждать. Мне нужна эта проклятая трава, и нужна прямо сейчас».~
@22255 = ~«Я думаю, можно и подождать… но сколько она будет расти?»~
@22256 = ~«А если сильно захотеть, чтобы семя взошло, можно заставить его прорасти?»~
@22257 = ~«Есть ли способ заставить её расти быстрее?»~
@22258 = ~«Я не собираюсь ждать. Мне нужна эта проклятая трава, и нужна прямо сейчас».~
@22259 = ~«Мне *правда* нужна эта трава. Можно ли что-нибудь сделать?»~
@22260 = ~«Что ты имеешь в виду?»~
@22261 = ~Сфокусироваться на семени, *пожелать*, чтобы оно росло.~
@22262 = ~«Что ж, полагаю, стоит попробовать…»~
@22263 = ~Сфокусироваться на семени, *пожелать*, чтобы оно росло.~
@22264 = ~«Что ж, полагаю, стоит попробовать…»~
@22265 = ~«Какого дьявола?»~
@22266 = ~«Надеюсь, она сможет снять с меня эту штуку. Пока не ушёл, я хотел бы задать кое-какие вопросы…»~
@22267 = ~«Вернусь-ка я к ней, пожалуй. Спасибо за помощь… прощай».~
@22268 = ~Она только тихо стонет в ответ и снова тянется к твоей руке.~
@22269 = ~Позволить прикоснуться к себе.~
@22270 = ~«Мне пора идти. Прощай».~
@22271 = ~Она только тихо стонет в ответ и снова тянется к твоей руке. Несмотря на разрушительное действие времени, в её глазах по-прежнему видны признаки человечности. Ты понимаешь, что она не хочет причинить тебе вреда.~
@22272 = ~Позволить прикоснуться к себе.~
@22273 = ~«Мне пора идти. Прощай».~
@22274 = ~Её почти лишённая плоти рука легко касается твоего предплечья, и она произносит: «Слш-ш-ш-шй». (Слушай.)~
@22275 = ~«Как ты это сделала?»~
@22276 = ~«Но как я могу понимать тебя?»~
@22277 = ~Она прикасается к тебе ещё раз: «Гв-выхр-рть с нм-ми т-ты мож-жш-ш. Но длжен-н дел-л-лхть т-то прыхв-вльн-н-н». (Говорить с нами ты можешь. Но должен делать это правильно.)~
@22278 = ~«Можешь научить меня?»~
@22279 = ~Она улыбается, затвердевшая кожа на её лице трескается: «Х-х-ха». (Да.)~
@22280 = ~«Тогда научи, прошу…»~
@22281 = ~Сборщик по имени Нодд попросил найти в Улье свою сестру Амариссу и передать от него весточку. Он описал её как привлекательную молодую женщину, живущую где-то в Улье.~
@22282 = ~Мэри обучает тебя навыкам общения с мёртвыми. Она называет этот процесс «Разговор с мёртвыми».~
@22283 = ~«Теперь я могу говорить с любым трупом?»~
@22284 = ~«Н-н-ныхктр-р-ры. Др-р-рги-и слиш-ш-ш-ш мыхртв-в. Над-д-д испл-л-лз ымен-н» (С некоторыми. Другие слишком мертвы. Надо использовать умение.)~
@22285 = ~«Спасибо. У меня были вопросы…»~
@22286 = ~«Спасибо. Прощай».~
@22287 = ~Она кивает головой, ожидая вопроса.~
@22288 = ~«Мэри, мне нужно поговорить с Безмолвным Королём. Не поможешь мне?»~
@22289 = ~«Мэри, мне нужно поговорить с Безмолвным Королём. Не поможешь мне?»~
@22290 = ~«Мэри, мне нужно поговорить с Безмолвным Королём. Не поможешь мне?»~
@22291 = ~«Почему я здесь заключён?»~
@22292 = ~«Где я?»~
@22293 = ~«Что ты здесь делаешь?»~
@22294 = ~«Кто живёт в этом месте?»~
@22295 = ~«Позволь спросить кое о ком в частности…»~
@22296 = ~«Не видела тут небольшой бронзовой сферы?»~
@22297 = ~«Неважно. Прощай».~
@22298 = ~«З-з-злы Бызм-м-млв Крыл-ля». (Залы Безмолвного Короля.)~
@22299 = ~«Расскажи мне о Безмолвном Короле».~
@22300 = ~«У меня другие вопросы…»~
@22301 = ~«Это всё, что я хотел узнать. Прощай».~
@22302 = ~«Нас-ств дрыгх-х зом-м-мб. Забот-т-т о-о тих-х-х». (Наставляю других зомби. Забочусь о тихих.)~
@22303 = ~«Расскажи мне о других зомби».~
@22304 = ~«Тихих?»~
@22305 = ~«У меня другие вопросы…»~
@22306 = ~«Это всё, что я хотел узнать. Прощай».~
@22307 = ~«З-зо-ом-м-мб. Склет-т-т. Упыр-пыр-пыри-и. Кхрыс-с-сы». (Зомби. Скелеты. Упыри. Крысы.)~
@22308 = ~«Расскажи мне о зомби».~
@22309 = ~«Расскажи мне о скелетах».~
@22310 = ~«Расскажи мне об упырях».~
@22311 = ~«Расскажи мне о крысах».~
@22312 = ~«У меня другие вопросы…»~
@22313 = ~«Это всё, что я хотел узнать. Прощай».~
@22314 = ~«Дл-лыют-т ры-ры-рыб-бт ля-а Бызм-м-млв Крыл-ля». (Делают работу для Безмолвного Короля.)~
@22315 = ~«Какую работу?»~
@22316 = ~«Расскажи мне о Безмолвном Короле».~
@22317 = ~«Кто ещё живёт в этом месте?»~
@22318 = ~«У меня другие вопросы…»~
@22319 = ~«Это всё, что я хотел узнать. Прощай».~
@22320 = ~«Пр-рыстраивт-т то, шт-то-о был-л-л разруш-ш-ш. Забот-т об-б ист-т-т мыхрт-т-т». (Перестраивают то, что было разрушено. Заботятся об истинно мёртвых.)~
@22321 = ~«Расскажи мне о Безмолвном Короле».~
@22322 = ~«Кто ещё живёт в этом месте?»~
@22323 = ~«У меня другие вопросы…»~
@22324 = ~«Это всё, что я хотел узнать. Прощай».~
@22325 = ~«Х-хгры-ым-м-м, их-х ли-ид-др, говрит-т-т, что с-сказ-з-з Бы-ы-ызмлв-в Крыл-л. С-скел-л-лты ру-ухквдт-т на-ам-м». (Харгримм, их лидер, говорит, что сказал Безмолвный Король. Скелеты руководят нами.)~
@22326 = ~«Расскажи мне о Харгримме».~
@22327 = ~«Расскажи мне о Безмолвном Короле».~
@22328 = ~«Кто ещё живёт в этом месте?»~
@22329 = ~«У меня другие вопросы…»~
@22330 = ~«Это всё, что я хотел узнать. Прощай».~
@22331 = ~«Гл-лыдн-н… вс-сехгд гл-лыдн-н». (Голодные… всегда голодные.)~
@22332 = ~«Кто ещё живёт в этом месте?»~
@22333 = ~«У меня другие вопросы…»~
@22334 = ~«Это всё, что я хотел узнать. Прощай».~
@22335 = ~«Ш-ш-шли-и-их-х. Упы-ы-ыр-ри прохгнли-и». (Ушли. Упыри прогнали).~
@22336 = ~«Расскажи мне об упырях».~
@22337 = ~«Кто ещё живёт в этом месте?»~
@22338 = ~«У меня другие вопросы…»~
@22339 = ~«Это всё, что я хотел узнать. Прощай».~
@22340 = ~«Х-х-ха-а?» (Да?)~
@22341 = ~«Расскажи мне о себе».~
@22342 = ~«Расскажи мне о Безмолвном Короле».~
@22343 = ~«Расскажи мне о Харгримме».~
@22344 = ~«Расскажи мне о Соэго».~
@22345 = ~«Расскажи мне об Акасте».~
@22346 = ~«Не бери в голову. У меня другие вопросы…»~
@22347 = ~«Неважно. Прощай».~
@22348 = ~«Бы-ы-ызмлв-в Кры-кры-крыл-л». (Безмолвный Король.)~
@22349 = ~«Что ты можешь рассказать о нём?»~
@22350 = ~«Ладно. Расскажи мне ещё кое о ком».~
@22351 = ~«Неважно. У меня другие вопросы…»~
@22352 = ~«Неважно. Прощай».~
@22353 = ~«Бы-ызмлв-в Крыл-л-л». (Безмолвный Король.)~
@22354 = ~«Что ты знаешь о нём?»~
@22355 = ~«Ладно. Расскажи мне ещё кое о ком».~
@22356 = ~«Неважно. У меня другие вопросы…»~
@22357 = ~«Неважно. Прощай».~
@22358 = ~«Бы-ызмлв-в Крыл-л-л». (Безмолвный Король.)~
@22359 = ~«Ладно. Расскажи мне ещё кое о ком».~
@22360 = ~«Неважно. У меня другие вопросы…»~
@22361 = ~«Тогда забудь. Прощай».~
@22362 = ~«Хргрым-м-м в-выд-дт с-скел-л-лт, несыт-т нм-м-м слы-ыхв-в Бы-ызмлв-в Крыл-л-ля. Обыс-быспокн. Оз-зыб-бочн». (Харгримм ведёт скелетов, несёт нам слово Безмолвного Короля. Обеспокоен. Озабочен.)~
@22363 = ~«Чем он обеспокоен?»~
@22364 = ~«Расскажи мне ещё кое о ком».~
@22365 = ~«У меня другие вопросы…»~
@22366 = ~«Это всё, что я хотел узнать. Прощай».~
@22367 = ~«С-с-сыэгх. Акс-с-сты». (Соэго. Акаста.)~
@22368 = ~«Почему его беспокоит Соэго?»~
@22369 = ~«Почему его беспокоит Акаста?»~
@22370 = ~«Расскажи мне ещё кое о ком».~
@22371 = ~«У меня другие вопросы…»~
@22372 = ~«Это всё, что я хотел узнать. Прощай».~
@22373 = ~«С-с-сыэгх прыпвед-дет смыхрт-ть». (Соэго проповедует смерть.)~
@22374 = ~«Проповедует смерть?»~
@22375 = ~«Расскажи мне ещё кое о ком».~
@22376 = ~«У меня другие вопросы…»~
@22377 = ~«Это всё, что я хотел узнать. Прощай».~
@22378 = ~«Хычш-шет-т, штыб-б м-мы ум-мрлы». (Хочет, чтобы мы умерли.)~
@22379 = ~«Зачем ему ваша смерть?»~
@22380 = ~«Расскажи мне ещё кое о ком».~
@22381 = ~Нодд выглядит испуганным и трясёт головой. «Фарод, Фарод, Фарод… — он скребёт затылок. — Чё? Чё про него?» Нодд хмурит брови, затем качает головой, будто не уверен, нужно ли вообще говорить с тобой.~
@22382 = ~«У меня другие вопросы…»~
@22383 = ~«Это всё, что я хотел узнать. Прощай».~
@22384 = ~Нодд трясёт головой и быстро смотрит на тебя, потом начинает бормотать что-то, похожее на молитву против зла. «Не-не-не *зд-десь*. На Площади… — он хмурится, затрудняясь объяснить, — …но не на Площади». Он снова трясёт головой, затем кашляет.~
@22385 = ~Тухлая Мэри рассказала, что Харгримм, верховный жрец Безмолвного Короля, обеспокоен деятельностью Пыльного по имени Соэго. Соэго пытается убедить нежить из Мёртвых Народов принять Истинную Смерть.~
@22386 = ~«Ын-н-н Пыл-л-лнй». (Он Пыльный.)~
@22387 = ~«Нет-нет-нет, — Нодд отчаянно мотает головой. — Нет неп-ника». Он шмыгает носом, вытирая его рукавом.~
@22388 = ~«А почему Харгримма беспокоит Акаста?»~
@22389 = ~«Повитуха… зелья с амулетами, она… с малышами помогает, хорошая». Он морщит нос: «Её дом — вверху, на платформах. Плохо пахнет».~
@22390 = ~«Расскажи мне ещё кое о ком».~
@22391 = ~«У меня другие вопросы…»~
@22392 = ~Нодд трясёт головой, затем что-то бормочет под нос. Он выглядит напуганным и не знает, что делать.~
@22393 = ~«Это всё, что я хотел узнать. Прощай».~
@22394 = ~«Тень Шергрейва длинная, на Нодда падает, ага, падает. Нодд отдаёт Шергрейву бабки. Шергрейв говорит другим в тени: „За Ноддом присматривайте“. Ага», — он сопит и медленно кивает.~
@22395 = ~«Акс-с-сты… ярыс-с-сть». (Акаста… ярость.)~
@22396 = ~«Э-э… э-э… — он трясёт головой, кашляет, потом принимается кивать. — Ты ж спрашивал Нодда, ага, щас у Нодда… вопрос к тебе, ага…»~
@22397 = ~«Ярость?»~
@22398 = ~«У Нодда есть сестра Амарисса, ага. А-ма-рис-са… в Улье живёт, далеко отсюда… далеко от Площади. Так давно, так давно Нодд не видел сестру, забрали его…»~
@22399 = ~«Расскажи мне ещё кое о ком».~
@22400 = ~«У меня другие вопросы…»~
@22401 = ~«Это всё, что я хотел узнать. Прощай».~
@22402 = ~«Акс-с-сты хычш-шет всх-х убыт-т». (Акаста хочет всех убить.)~
@22403 = ~«Но зачем ей всех убивать?»~
@22404 = ~«Расскажи мне ещё кое о ком».~
@22405 = ~«У меня другие вопросы…»~
@22406 = ~«Это всё, что я хотел узнать. Прощай».~
@22407 = ~«Глы-ыд-д-дн. Зл-л-ла». (Голодная. Злая.)~
@22408 = ~«Глы-ыд-д-дн. Зл-л-ла». (Голодная. Злая.)~
@22409 = ~«Почему Харгримма беспокоит Соэго?»~
@22410 = ~«Расскажи мне ещё кое о ком».~
@22411 = ~«У меня другие вопросы…»~
@22412 = ~«Это всё, что я хотел узнать. Прощай».~
@22413 = ~Тухлая Мэри сказала, что Харгримм, верховный жрец Безмолвного Короля, обеспокоен насчёт Акасты, которая хочет убить и сожрать всё в Мёртвых Народах.~
@22414 = ~«Расскажи мне ещё кое о ком».~
@22415 = ~«Не знаешь её? — он грустно качает головой, кусая нижнюю губу. — Еси увидишь, еси увидишь — скажи, чё её Нодд, её брат очень беспокоится о ней, ага, он беспокоится».~
@22416 = ~«У меня другие вопросы…»~
@22417 = ~«НЕТ! — Нодд прикрывает голову руками и бормочет под нос. — Нодд… Нодд не может больше говорить, нет, не может, надо трупы искать в грязи на Площади, Площади Мусорщиков… НЕТ!» Вспышка вызывает длительный приступ кашля.~
@22418 = ~«Это всё, что я хотел узнать. Прощай».~
@22419 = ~«Ын-н-н Пыл-л-лнй». (Он Пыльный.)~
@22420 = ~«Расскажи мне ещё кое о ком».~
@22421 = ~Нодд сопит, тихо потупив взор. Наконец он снова начинает кивать и тихо говорит: «Нодд был молодой, ага, молодой был, и начал слышать голоса, говорили Нодду: „Делай это! Делай то!“. Плохие вещи, плохие, типа грызть пальцы, пальцы…» Он поднимает руки, и ты видишь на пальцах под слоем засохшей грязи старые шрамы от укусов.~
@22422 = ~«У меня другие вопросы…»~
@22423 = ~«Это всё, что я хотел узнать. Прощай».~
@22424 = ~«Тух-тух-хл-л-л Мыхр-ри». (Тухлая Мэри.)~
@22425 = ~«Нодд не знает, не знает. Плохое место, плохое!» — он трясёт головой так, что кажется, она вот-вот отвалится.~
@22426 = ~«Что ты здесь делаешь?»~
@22427 = ~«И вот предки забрали Нодда, забрали, отвели в плохое место, Башню с Крыльями, там ему иглы и крючья в голову навтыкали… голоса пропали, ага, пропали, но Нодд не мог думать, не мог говорить правильно. Нодд убежал оттуда, убежал, очнулся в Улье, ага».~
@22428 = ~«Как ты сюда попала?»~
@22429 = ~«У меня другие вопросы…»~
@22430 = ~«Расскажи мне ещё кое о ком».~
@22431 = ~«Нодд очнулся, а там были Сборщики, ага. Сборщики потыкали в Нодда и сказали: „Смотри! Не трупак, он вовсе не трупак! Несите его назад, несите назад!“ И вот они утащили Нодда назад на Площадь, ага. Так много… много лет назад».~
@22432 = ~«Это всё, что я хотел узнать. Прощай».~
@22433 = ~«Нодд благодарит тебя, ага, Нодд благодарит. Амарисса красивая, такая красивая, живёт щас в Улье. Светлая кожа, ага, волосы как смоль, и всегда в голубом, голубом… всегда в голубом…»~
@22434 = ~«Ыст-ыстин-н мр-ртвы». (Истинно мёртвые.)~
@22435 = ~Он трясёт головой и кашляет. «Ничего, ничего нет у Нодда, так мало чё дать…»~
@22436 = ~«Расскажи мне о других зомби».~
@22437 = ~Нодд грустно смотрит на тебя. «Нодд даст всё, всё, чё есть, ага. Всё, чё есть у Нодда, тока поговори с ней. Докажи Нодду, чё поговорил с Амариссой, сестрёнкой Нодда, ага, — он сопит, затем кашляет. — Светлая кожа, у неё была, волосы как смоль, и всегда в голубом, голубом… всегда в голубом…»~
@22438 = ~«У меня другие вопросы…»~
@22439 = ~«Это всё, что я хотел узнать. Прощай».~
@22440 = ~«Н-н-ныт, прст-т-ти». (Нет, прости.)~
@22441 = ~«Говорил? Нодд так счастлив, так счастлив. Как сестрёнка Нодда? Расскажи ему про Амариссу, расскажи, прошу!» — волнение вызывает у него продолжительный кашель. Когда он наконец справляется с приступом, то спрашивает: «Сестра Нодда всё ещё красивая, такая красивая?»~
@22442 = ~«У меня другие вопросы…»~
@22443 = ~«Это всё, что я хотел узнать. Прощай».~
@22444 = ~«Доказать! Нодду доказать…»~
@22445 = ~Она пожимает плечами: «Спрыс-си Хргрым-м-м». (Спроси Харгримма.)~
@22446 = ~«Айи-и-и!» — он бросается на тебя.~
@22447 = ~«Расскажи мне о Харгримме».~
@22448 = ~«Нодд так счастлив узнать, узнать про сестрёнку! — он выглядит, словно вот-вот заплачет, но с трудом проглатывает комок. — Чё-то ещё, чё-то ещё она сказала? Чё-то ещё Нодду?»~
@22449 = ~«У меня другие вопросы…»~
@22450 = ~«Ты говорил? Нодд так счастлив, так счастлив!» — он копается под одеждой и достаёт грязный комок тряпок. Разворачивает их и вручает тебе содержимое — одиннадцать медяков. «Вот, вот всё, чё у Нодда! Как сестрёнка Нодда? Расскажи про Амариссу, расскажи Нодду, прошу!» — волнение вызывает у него продолжительный кашель. Когда он наконец справляется с приступом, то спрашивает: «Сестра Нодда всё ещё красивая, такая красивая?»~
@22451 = ~«Это всё, что я хотел узнать. Прощай».~
@22452 = ~Нодд энергично кивает: «Ага, ага, всё, чё у Нодда! Смотри, где он живёт, бедный Нодд… смотри…» Он беспомощно обводит рукой вокруг себя и бормочет под нос.~
@22453 = ~«Дав-вны уж-же м-мыхртв-ва. Пыз-забыл-л-лы». (Давно уже мертва. Позабыла.)~
@22454 = ~«Что ты здесь делаешь?»~
@22455 = ~«Расскажи мне ещё кое о ком».~
@22456 = ~Он забирает деньги и от удивления даже перестаёт кивать. «Нодд благодарит тебя, он благодарит. Ага, благодарит…»~
@22457 = ~«У меня другие вопросы…»~
@22458 = ~Глаза Нодда под грязным коричневым капюшоном загораются радостью: «Такие замечательные новости, хорошие, замечательные новости, ага! Нодд благодарит тебя, и ещё раз, и тыщу раз благодарит, ага!»~
@22459 = ~«Это всё, что я хотел узнать. Прощай».~
@22460 = ~«Зщ-щчем-м?» (Зачем?)~
@22461 = ~Когда ты даёшь Нодду сотню монет, у него просто отпадает челюсть, а голова перестаёт кивать. Глаза его под грязным коричневым капюшоном загораются радостью: «Такие замечательные новости, хорошие, замечательные новости, ага! Нодд благодарит тебя, и ещё раз, и тыщу раз благодарит, ага!»~
@22462 = ~«Мне нужно покинуть это место, Мэри. Я столько должен сделать… а заточён тут только за то, что пришёл… это просто несправедливо. Не поможешь мне… я прошу лишь капельку сострадания?»~
@22463 = ~На минуту голова Нодда поникает и он тихо бормочет. Наконец он смотрит тебя прямо в глаза: «Нодд прощает, прощает, ага. Хорошо, чё сказал Нодду, хорошо, показал, чё пытаешься быть хорошим, но не можешь, как Нодд… как Нодд. Нодд благодарит за хорошие новости, всё равно, ага».~
@22464 = ~«Забудь. У меня другие вопросы…»~
@22465 = ~«Не бери в голову. Прощай».~
@22466 = ~Ты видишь, как Нодд бродит вокруг и кивает, бормоча себе под нос.~
@22467 = ~«Зщ-щчем-м?» (Зачем?)~
@22468 = ~«Мне нужно уйти отсюда».~
@22469 = ~~
@22470 = ~«Ага, вот парень, который помог найти сестрёнку, ага, милую Амариссу. Нодд благодарит опять».~
@22471 = ~«Забудь. У меня другие вопросы…»~
@22472 = ~«Не бери в голову. Прощай».~
@22473 = ~«Приветствую…»~
@22474 = ~«Ны-ы-ы». (Нет.)~
@22475 = ~Оставить его в покое.~
@22476 = ~~
@22477 = ~«Я говорил с твоей сестрой Амариссой…»~
@22478 = ~«Тогда у меня другие вопросы…»~
@22479 = ~«Тогда прощай».~
@22480 = ~Ты видишь Тухлую Мэри. Когда она наконец замечает твоё присутствие, то тихо мычит: «Пы-пы-пыриве-етс…»~
@22481 = ~«У меня вопросы…»~
@22482 = ~«У меня вопросы…»~
@22483 = ~Ты видишь Тухлую Мэри. Когда она наконец замечает твоё присутствие, то тихо мычит: «Пы-пы-пыриве-етс…» (Приветствую.)~
@22484 = ~«У меня вопросы…»~
@22485 = ~«Просто проходил мимо. Прощай».~
@22486 = ~Тухлая Мэри некоторое время молчит, потом кивает. Она поднимает руку и показывает на первый из трёх порталов в северной стене: «З-з-зкрой гл-л-лза-ах. Ду-у-умй пр-р Бы-ызмл-лв-в Крыл-ля. Пр-р-рди чрез-з сев-вровост-тчн ал-л-лкы-ыв-в. Н-но т-тылк-к пк-ка я ж-ж-жва». (Закрой глаза. Думай про Безмолвного Короля. Пройди через северо-восточный альков. Но только пока я жива.)~
@22487 = ~«Спасибо, Мэри. Прощай».~
@22488 = ~Тухлая Мэри сказала, что для прохода в покои Безмолвного Короля я могу воспользоваться порталом в её комнате. Мне нужно пройти через северо-восточный альков с закрытыми глазами и мыслью о Безмолвном Короле. Но портал будет действовать только покуда она жива.~
@22489 = ~«Я говорил с твоей сестрой Амариссой…»~
@22490 = ~«Я говорил с твоей сестрой Амариссой…»~
@22491 = ~«Я говорил с твоей сестрой Амариссой…»~
@22492 = ~«Что ты делаешь?»~
@22493 = ~«Что это за место?»~
@22494 = ~«У меня вопросы…»~
@22495 = ~«Прощай».~
@22496 = ~«Трупаков?»~
@22497 = ~«Зачем ты ищешь трупы?»~
@22498 = ~«Что это за место?»~
@22499 = ~«У меня вопросы…»~
@22500 = ~«Это всё, что я хотел узнать. Прощай».~
@22501 = ~«Это всё, что я хотел узнать. Прощай».~
@22502 = ~«Ты продаёшь трупы?»~
@22503 = ~«Что это за место?»~
@22504 = ~«У меня вопросы…»~
@22505 = ~«Это всё, что я хотел узнать. Прощай».~
@22506 = ~«Это всё, что я хотел узнать. Прощай».~
@22507 = ~«Почему они платят за трупы?»~
@22508 = ~«Что это за место?»~
@22509 = ~«У меня вопросы…»~
@22510 = ~«Это всё, что я хотел узнать. Прощай».~
@22511 = ~«Это всё, что я хотел узнать. Прощай».~
@22512 = ~«Что это за место?»~
@22513 = ~Пустая Карта~
@22514 = ~«У меня вопросы…»~
@22515 = ~«Это всё, что я хотел узнать. Прощай».~
@22516 = ~«Это всё, что я хотел узнать. Прощай».~
@22517 = ~«Что ты делаешь?»~
@22518 = ~«У меня вопросы…»~
@22519 = ~«Это всё, что я хотел узнать. Прощай».~
@22520 = ~«Это всё, что я хотел узнать. Прощай».~
@22521 = ~Дать ему пару медяков.~
@22522 = ~Бросить ему пять медяков.~
@22523 = ~Отвалить ему в ладонь десять медяков.~
@22524 = ~«Ты ничего не получишь, и будешь отвечать на мои вопросы».~
@22525 = ~«Тогда неважно. Прощай».~
@22526 = ~«Расскажи мне о Сборщиках».~
@22527 = ~«Расскажи мне об этом районе».~
@22528 = ~«Не знаешь мужчину по имени Фарод?»~
@22529 = ~«Я ищу потерянный дневник».~
@22530 = ~«Расскажи мне о Меббет».~
@22531 = ~«Неважно. Прощай».~
@22532 = ~«Неважно. Прощай».~
@22533 = ~«Расскажи мне об этом районе».~
@22534 = ~«Не знаешь мужчину по имени Фарод?»~
@22535 = ~«Я ищу потерянный дневник».~
@22536 = ~«Расскажи мне о Меббет».~
@22537 = ~«Это всё, что я хотел узнать. Прощай».~
@22538 = ~«Это всё, что я хотел узнать. Прощай».~
@22539 = ~«Расскажи мне о Шергрейве».~
@22540 = ~«Расскажи мне о Сборщиках».~
@22541 = ~Дак'кон кивает.~
@22542 = ~«Он *известен* под именем Фелл».~
@22543 = ~«Он рисует картинки на коже. „Татуировки“».~
@22544 = ~«Его слова разделены противоречием, — Дак'кон выдерживает паузу, его чёрные глаза снова бегают по символам. — Он говорит, что ты приходишь к нему в первый раз. И он говорит, что ты приходишь к нему не в первый раз».~
@22545 = ~«Ты *известен* ему. Но он не может рассказать, что ты хочешь *знать*».~
@22546 = ~«Вместо ответа он извиняется за то, что вынужден молчать, — Дак'кон выдерживает паузу и когда начинает говорить, его слова холодны как лёд. — Он говорит, что не может изменить *природу человека*». При этих словах Дак'кона ты чувствуешь страшное давление внутри черепа… но оно проходит с последним словом.~
@22547 = ~«Она реальна».~
@22548 = ~«Она была заключена в один из лабиринтов Госпожи».~
@22549 = ~«Воля Рейвел была отлична от воли Госпожи. И Госпожа наказала её».~
@22550 = ~«Она пыталась разрушить стены Сигила».~
@22551 = ~«Способ добраться до неё ему *неизвестен*».~
@22552 = ~«Он предостерегает нас от поисков ночной ведьмы. Говорит, что её сердце черно, а её воля — навредить нам».~
@22553 = ~Дак'кон смотрит на символы, но сохраняет молчание.~
@22554 = ~«Рука — твоя, татуировки — его».~
@22555 = ~Дак'кон на мгновение замолкает… и вдруг ты инстинктивно понимаешь, что Дак'кон тебе *лжёт*. Он монотонно продолжает: «Остальные символы мне *неизвестны*».~
@22556 = ~Дак'кон на мгновение замолкает. «Остальные символы мне *неизвестны*».~
@22557 = ~Дак'кон снова замолкает. Он избегает встречаться с тобой взглядом, словно неотрывно следит за чем-то далёким: «Символы… нет ничего хорошего в *знании* ответа на твой вопрос».~
@22558 = ~«В твоих словах есть правда. Эта правда… должна быть *известна* мне, — Дак'кон на миг замолкает, затем поворачивается к тебе, его взгляд ожесточается. — Символы говорят о четырёх, с кем ты путешествовал в прошлом».~
@22559 = ~Дак'кон поворачивается к тебе, его взгляд ожесточается: «Да».~
@22560 = ~Дак'кон поворачивается к тебе, его взгляд ожесточается: «Символы говорят о четырёх, с кем ты путешествовал в прошлом».~
@22561 = ~Дак'кон даже не смотрит на символы: «Татуировка говорит о четырёх разумах. Одна — женщина, любившая мужчину, который *знал* её, но не *знал* любви. Другой — слепец, который видел то, чего не видят глаза других смертных. Ещё был приручённый, питомец мага, выкупленный и обязанный. Последним был раб».~
@22562 = ~«Эти четверо были связаны символом, который *знаком* мне».~
@22563 = ~«Этот символ — страдание. Он говорит, что символ был на тебе всегда. Плоть *знала* страдания, даже когда разум забывал их».~
@22564 = ~Дак'кон снова замолкает. «Я не буду говорить о них здесь. Спроси меня, когда разговор будет только для наших ушей».~
@22565 = ~«Он говорит, что на руке есть забытые татуировки. Теперь он их вспомнил. Они могут быть твои, если захочешь».~
@22566 = ~«Он говорит, что татуировки не его».~
@22567 = ~«Символы на спине — это оставленные тебе указания. Знак на плече — это символ страдания. Он говорит, этот символ лежит на тебе потому, что плоть *знает* страдания, даже если разум их забывает».~
@22568 = ~«Тени».~
@22569 = ~«Он говорит, что множество теней пришли за тобой. Причина, по которой они отняли у тебя жизнь, ему *неизвестна*».~
@22570 = ~«Это его галерея. Он говорит, что *знает* тебя, как свой холст. Он выражает уважение к твоей силе и восхищается тобой, — Дак'кон на мгновение замолкает. — Затем он оскорбляет тебя своей жалостью».~
@22571 = ~«Он жалеет тебя из-за шрамов, оставленных на тебе страданиями. Он говорит, что ты вытерпел их. Терпение сделало тебя сильнее».~
@22572 = ~«Он говорит, его восхищение *вызвано* тем, что ты вытерпел все потери. Говорит, потери лежат на тебе как цепи, однако ты можешь стоять и идти».~
@22573 = ~«Он говорит, потери покрывают твою жизнь и все твои предыдущие жизни тоже. Говорит, ты сбрасываешь эти жизни, как змея свою шкуру, оставляя за собой в бесконечном пути по жизням».~
@22574 = ~«Он хочет, чтобы ты *познал* его предостережение: каждая из твоих жизней порождает тени бытия. Твой путь должен привести тебя к месту, где тени не *знают* самих себя, и где стены сложены из сожалений».~
@22575 = ~«Он говорит, чтобы ты ничего не подписывал».~
@22576 = ~«Он спрашивает, *знаешь* ли ты себя как целого».~
@22577 = ~«Он уважает тебя за твою силу. Говорит, если ты будешь хранить веру, то снова *познаешь* себя».~
@22578 = ~Падшая Грейс кивает: «Да, конечно».~
@22579 = ~«Не знаешь мужчину по имени Фарод?»~
@22580 = ~«Его имя Фелл, — Грейс почти не смотрит на символы перед тем, как поворачивается к тебе. — Этот символ… чёрная молния, рассекающая белый овал… нарисован также и снаружи на здании. Я думаю, белый овал символизирует Сигил, а молния…» Грейс замолкает. «Я точно не знаю».~
@22581 = ~«Я ищу потерянный дневник».~
@22582 = ~«Расскажи мне о Меббет».~
@22583 = ~Грейс терпеливо ждёт, пока символы исчезнут. «Это его мастерская. Тут он наносит на кожу других татуировки, — Грейс поворачивается к тебе и улыбается; присутствие Фелла словно добавляет ей сил. — Фелла знают в Сигиле как талантливого художника. Плоть других — его холст».~
@22584 = ~«Это всё, что я хотел узнать. Прощай».~
@22585 = ~Грейс внимательно изучает символы, а затем поворачивается и странно на тебя смотрит. «Фелл говорит, что ты здесь впервые, но не в первый раз, — Грейс одаривает тебя оценивающим взглядом. — Возможно, он помнит тебя до того, как вы стали тобой…» Внезапно она понимает, что сказала, и тихо смеётся: «Извини… никогда бы не подумала, что буду использовать множественное число, обращаясь к кому-то конкретному».~
@22586 = ~«Это всё, что я хотел узнать. Прощай».~
@22587 = ~Грейс задумчиво хмурится, положив руку на подбородок. «Фелл говорит, что знает тебя… затем он говорит — и это странно — что ему не *позволено* рассказывать твою историю».~
@22588 = ~«Не знаешь, где мне его найти?»~
@22589 = ~«Расскажи мне о Сборщиках».~
@22590 = ~«Расскажи мне об этом районе».~
@22591 = ~«Он извиняется, но не может сказать, — Грейс поворачивается к тебе и пристально смотрит в глаза. — Далее он говорит нечто странное. Он говорит, что *„не может изменить природу человека“*». На этой фразе Грейс ты чувствуешь страшное давление внутри черепа… как будто голова взрывается от удара молота… чувство быстро рассеивается, как только она произносит последнее слово.~
@22592 = ~«Я ищу потерянный дневник».~
@22593 = ~«Расскажи мне о Меббет».~
@22594 = ~«Это всё, что я хотел узнать. Прощай».~
@22595 = ~«Это всё, что я хотел узнать. Прощай».~
@22596 = ~«Расскажи мне о Сборщиках».~
@22597 = ~«Расскажи мне об этом районе».~
@22598 = ~«Я ищу потерянный дневник».~
@22599 = ~«Расскажи мне о Меббет».~
@22600 = ~«Это всё, что я хотел узнать. Прощай».~
@22601 = ~«Это всё, что я хотел узнать. Прощай».~
@22602 = ~«Расскажи мне о Сборщиках».~
@22603 = ~«Расскажи мне об этом районе».~
@22604 = ~«Не знаешь мужчину по имени Фарод?»~
@22605 = ~«Расскажи мне о Меббет».~
@22606 = ~«Это всё, что я хотел узнать. Прощай».~
@22607 = ~«Это всё, что я хотел узнать. Прощай».~
@22608 = ~«Расскажи мне о Сборщиках».~
@22609 = ~«Расскажи мне об этом районе».~
@22610 = ~«Не знаешь мужчину по имени Фарод?»~
@22611 = ~«Я ищу потерянный дневник».~
@22612 = ~«Это всё, что я хотел узнать. Прощай».~
@22613 = ~«Это всё, что я хотел узнать. Прощай».~
@22614 = ~«Расскажи мне о Сборщиках».~
@22615 = ~«Расскажи мне об этом районе».~
@22616 = ~«Не знаешь мужчину по имени Фарод?»~
@22617 = ~«Я ищу потерянный дневник».~
@22618 = ~«Расскажи мне о Меббет».~
@22619 = ~«Это всё, что я хотел узнать. Прощай».~
@22620 = ~«Это всё, что я хотел узнать. Прощай».~
@22621 = ~«Расскажи мне о Сборщиках».~
@22622 = ~«Не знаешь мужчину по имени Фарод?»~
@22623 = ~«Я ищу потерянный дневник».~
@22624 = ~«Расскажи мне о Меббет».~
@22625 = ~«Это всё, что я хотел узнать. Прощай».~
@22626 = ~«Это всё, что я хотел узнать. Прощай».~
@22627 = ~«Давай, спрашивай…»~
@22628 = ~Игнорировать его, повернуться и уйти.~
@22629 = ~«Тебя разлучили с ней, и ты просишь её найти?»~
@22630 = ~«И твой вопрос?..»~
@22631 = ~«Интересно. Прощай».~
@22632 = ~Амарисса сказала, что в детстве Нодда звали Тодус.~
@22633 = ~Я поклялся Амариссе, что отнесу медяки её брату Нодду, на Площадь Мусорщиков.~
@22634 = ~Я солгал Нодду, что его сестра — отвратительная шлюха, и он набросился на меня.~
@22635 = ~Я согласился за деньги передать весточку от Нодда его сестре Амариссе. Он сказал, что она светлокожая, черноволосая и всегда носит голубое.~
@22636 = ~Я согласился передать весточку от Нодда его сестре Амариссе. Он сказал, что она светлокожая, черноволосая и всегда носит голубое.~
@22637 = ~«А почему бы тебе не пойти и не найти её?»~
@22638 = ~«Хорошо. Я сделаю это для тебя».~
@22639 = ~«Я найду её… за деньги».~
@22640 = ~«Я подумаю. Прощай».~
@22641 = ~«Что с тобой случилось, Нодд?»~
@22642 = ~«Хорошо. Я сделаю это для тебя».~
@22643 = ~«Я найду её… за деньги».~
@22644 = ~«Я подумаю. Прощай».~
@22645 = ~«Продолжай…»~
@22646 = ~Джелай ворчит. «Ну чё я за дурак… я ж просто выскочил ненадолго за парой глотков, а там… — он скрежещет зубами. — Спасиб те за хорошие новости… за мной не заржавеет, ага».~
@22647 = ~«Хорошо, я найду твою сестру».~
@22648 = ~«Хорошо, я найду твою сестру… за деньги».~
@22649 = ~«Интересно. Прощай».~
@22650 = ~«Ладно, продолжай свою историю…»~
@22651 = ~Мужчина смотрит, как ты приближаешься… он один из тех, с кем ты работал вместо Джелая. «Ага, здорово… рад видеть, — он понижает голос. — Эй, не нарывайся на неприятности с Краддоком — он парень на руку скорый».~
@22652 = ~«Спасибо за предупреждение. Прощай».~
@22653 = ~«Ты Джелай? Краддок говорит, что ты нужен ему на рынке».~
@22654 = ~Пройти мимо.~
@22655 = ~«А? — мужчина косит на тебя затуманенными глазами. — Чё нада? Чё?»~
@22656 = ~«Ты Джелай? Краддок говорит, что ты нужен ему на рынке».~
@22657 = ~«Ничего. Прости, что побеспокоил».~
@22658 = ~«Кра-док? — его глаза расширяются. — А! Краддок! Этот грязный пёс, шавка низкопробная! Мож ему передать: „Джелай на него работать больше не будет! НИКОГДА! Пусть он ОТВАЛИТ!“» Он тыкает тебя в грудь пальцем: «Скажи это ему!»~
@22659 = ~«Я передам ему… издалека. Прощай».~
@22660 = ~«Хм… я скажу ему… прощай, Джелай».~
@22661 = ~Ты видишь Джелая. Он всё ещё спотыкается и бормочет что-то себе под нос… распространяя запахи рассола, рвоты и дешёвого вина.~
@22662 = ~Оставить его в прежнем ступоре.~
@22663 = ~Ты видишь Джелая. Похоже, он несколько протрезвел с момента вашей прошлой встречи.~
@22664 = ~«Джелай… слушай. Я бы поостерёгся. Краддок в ярости, он обещает тебя убить, когда увидит».~
@22665 = ~Джелай ворчит. «Ну чё я за дурак… я ж просто выскочил ненадолго за парой глотков, а там… — он скрежещет зубами. — Спасиб за предупреждение…»~
@22666 = ~«Просто будь осторожен. Прощай».~
@22667 = ~«Джелай… слушай. Я сказал Краддоку, что могу заменить тебя на немножко… у тебя по-прежнему есть твоя работа, просто будь осторожнее».~
@22668 = ~Пройти мимо.~
@22669 = ~«Хорошо, я найду твою сестру».~
@22670 = ~«Просто будь поосторожнее в другой раз. Прощай».~
@22671 = ~«Хорошо, я найду твою сестру… за деньги».~
@22672 = ~Я вернулся к Джелаю и предупредил его насчёт Краддока — это меньшее, что я мог сделать. Джелай поблагодарил меня за предупреждение; похоже, он сожалеет о своих словах. Бедолага…~
@22673 = ~Я вернулся к Джелаю и сказал, что подменил его на работе, но работа у него по-прежнему есть. Джелай поблагодарил меня; похоже, он сожалеет о своих словах.~
@22674 = ~«Интересно. Прощай».~
@22675 = ~«А где эта башня с крыльями?»~
@22676 = ~«Продолжай свою историю…»~
@22677 = ~«Хорошо, я найду твою сестру».~
@22678 = ~«Хорошо, я найду твою сестру… за деньги».~
@22679 = ~«Интересно. Прощай».~
@22680 = ~«Хорошо, я найду твою сестру».~
@22681 = ~«Хорошо, я найду твою сестру… за деньги».~
@22682 = ~«Интересно. Прощай».~
@22683 = ~«Прощай, Нодд».~
@22684 = ~«Пойдёт всё, что найдёшь».~
@22685 = ~«Тогда я найду её забесплатно».~
@22686 = ~«Тогда забудь. Прощай».~
@22687 = ~«Хорошо. Вернусь, когда поговорю с ней. Прощай».~
@22688 = ~«Забудь. Прощай».~
@22689 = ~«Да, красивая. Она сейчас… проститутка в Улье. У неё всё хорошо, и она беспокоится о тебе».~
@22690 = ~Ложь: «Да. Она сейчас… прислуживает в таверне в Улье. У неё все хорошо, и она беспокоится о тебе».~
@22691 = ~Ложь: «Да, говорил. Она теперь шлюха, и настолько отвратительная, что я бы, наверно, и забесплатно не рискнул с ней переспать».~
@22692 = ~«Она мне сказала, что твоё прежнее имя — Тодус».~
@22693 = ~«Ого…»~
@22694 = ~~
@22695 = ~«Она сказала только, что навестит тебя, как только у неё выпадет время».~
@22696 = ~«Да, она передала тебе немножко меди, вот. И сказала, что навестит тебя, как только у неё выпадет время».~
@22697 = ~Ложь: «Она сказала только, что навестит тебя, как только у неё выпадет время — вот и всё».~
@22698 = ~«Да, она дала мне немного денег, чтобы я передал тебе, но… я их потратил. Она сказала, что навестит тебя, как только у неё выпадет время».~
@22699 = ~Я дословно передал сообщение Джелая Краддоку… Краддок был мягко говоря недоволен. М-да, парень пожалеет о своих словах, как только протрезвеет.~
@22700 = ~Меббет дала мне какое-то странное чёрное семя и сказала, чтобы я пошёл к торговцу фруктами в Улье. Она хочет получить выращенную из этого семени траву. Она сказала, что торговые ряды находятся к юго-востоку от её хижины.~
@22701 = ~Я дословно передал сообщение Джелая Краддоку… Краддок был мягко говоря недоволен — настолько, что даже Морте, похоже, пополнил свой репертуар оскорблений замечательными новыми выражениями. М-да, Джелай пожалеет о своих словах, как только протрезвеет.~
@22702 = ~Я сказал Краддоку, что поработаю вместо Джелая, которого нашёл ранее. Краддок поначалу отнёсся к этому скептически, но затем согласился.~
@22703 = ~Я встретил старую женщину по имени Меббет — бабку-повитуху с Площади Мусорщиков. Она маленько не в себе… как и все в этом городе.~
@22704 = ~Меббет предложила бесплатно излечить мои раны… а неплохая идея, возвращаться к ней, когда необходимо лечение.~
@22705 = ~Меббет рассказала мне, что в прибежище Фарода ведут ворота, находящиеся где-то на Площади. Она посоветовала расспросить о них Сборщиков.~
@22706 = ~Меббет рассказала мне историю Рейвел. Та была ночной ведьмой на Серой Пустоши, но однообразие этого места посеяло в её душе недовольство, так что она собрала вещи и двинулась в поисках знаний в Сигил. Но всё, что узнала, Рейвел обратила против самого города и его населения, породив такое зло, что Меббет не смогла о нём рассказать. Рейвел была наказана Госпожой и заключена в лабиринт, где тишина и спокойствие остудили её алчущее сердце.~
@22707 = ~Я поговорил с сестрой Нодда, Амариссой, и вернулся рассказать ему. Он был счастлив слышать о ней, хоть у меня и не оказалось денег, которые я поклялся отдать. Тем не менее он простил меня, и я даже рад, что не промолчал о них.~
@22708 = ~Я поговорил с сестрой Нодда, Амариссой, и вернулся рассказать ему. Он был вне себя от радости. А о медяках я промолчал, нарушив данную Амариссе клятву.~
@22709 = ~Я поговорил с сестрой Нодда, Амариссой, и вернулся рассказать ему. Он был счастлив слышать о ней да ещё и получить медяки, которые я поклялся отдать.~
@22710 = ~Я поговорил с сестрой Нодда, Амариссой, и вернулся рассказать ему. Он был вне себя от радости.~
@22711 = ~«Это *действительно* всё, что у тебя есть, Нодд?»~
@22712 = ~«Я не могу взять у тебя эти деньги, Нодд… забери их обратно».~
@22713 = ~«Да, красивая. Она сейчас… проститутка в Улье. У неё всё хорошо, и она беспокоится о тебе.~
@22714 = ~Ложь: «Да. Она сейчас… прислуживает в таверне в Улье. У неё всё хорошо, и она беспокоится о тебе».~
@22715 = ~Ложь: «Да, говорил. Она теперь шлюха, и настолько отвратительная, что я бы, наверно, и забесплатно не рискнул с ней переспать».~
@22716 = ~«Ладно. Твоя сестра красивая, а сейчас она… проститутка в Улье. У неё всё хорошо, и она беспокоится о тебе».~
@22717 = ~Ложь: «Ладно. Твоя сестра красивая, а сейчас она… прислуживает в таверне в Улье. У неё всё хорошо, и она беспокоится о тебе».~
@22718 = ~Ложь: «Ладно. Она теперь шлюха, и настолько отвратительная, что я бы, наверно, и забесплатно не рискнул с ней переспать».~
@22719 = ~«Конечно. Твоя сестра красивая, а сейчас она… проститутка в Улье. У неё всё хорошо, и она беспокоится о тебе».~
@22720 = ~Ложь: «Конечно. Твоя сестра красивая, а сейчас она… прислуживает в таверне в Улье. У неё всё хорошо, и она беспокоится о тебе».~
@22721 = ~Ложь: «Конечно. Она теперь шлюха, и настолько отвратительная, что я бы, наверно, и забесплатно не рискнул с ней переспать».~
@22722 = ~«Рад, что смог тебе помочь. Прощай, Нодд».~
@22723 = ~«Не благодари меня — ты же заплатил, пусть и мало. Прощай».~
@22724 = ~«Не благодари меня — ты же заплатил, пусть и мало. Прощай».~
@22725 = ~«Рад, что смог тебе помочь. Прощай, Нодд».~
@22726 = ~«Не благодари меня — ты же заплатил, пусть и мало. Прощай».~
@22727 = ~«Не благодари меня — ты же заплатил, пусть и мало. Прощай».~
@22728 = ~«Прощай, Нодд».~
@22729 = ~«Привет, Нодд».~
@22730 = ~Оставить его в покое.~
@22731 = ~«Прощай, Нодд».~
@22732 = ~Игнорировать мужчину и просто пройти мимо.~
@22733 = ~«Э… — выражение надежды угасает, когда он вглядывается в твоё лицо. — Тысяча извинений, добрый сэр, если я нечаянно обидел». Он слегка кланяется: «Я — Баен Посыльный, третий сын Дай'Баена Посыльного. Я один из многих курьеров на службе у Дома Посыльных».~
@22734 = ~«Не стоит извиняться, Баен. Что ты хотел?»~
@22735 = ~«Ты не обидел меня… пока. Что тебе нужно?»~
@22736 = ~«Слушай, Баен, мне пора идти…»~
@22737 = ~Когда ты уже собираешься скрыться, мужчина вновь окликает, громче на этот раз. Его голос почти переходит в визг от усилия: «Краддок? Добрый сэр, у меня для вас сообщение!»~
@22738 = ~«Ты о чём?»~
@22739 = ~«Всего лишь минуту вашего время, добрый сэр. Я ищу надзирателя по имени Краддок. Говорили, он где-то в Улье, но увы… он неуловим. Вы ничего о нём не слышали?»~
@22740 = ~«Нет».~
@22741 = ~«К сожалению…»~
@22742 = ~«Тысяча извинений, что беспокою вас по такому ничтожному поводу, но я ищу человека по имени Краддок, надзирателя в Улье… — Баен выглядит огорчённым. — Но увы… он неуловим». Он смотрит на тебя с надеждой: «Возможно, вы слышали что-нибудь о нём?»~
@22743 = ~«Нет».~
@22744 = ~«Прости, нет».~
@22745 = ~Баен глубоко вздыхает: «Я обязан доставить ему сообщение, но пока что удача не на моей стороне…»~
@22746 = ~«Я мог бы помочь тебе. Если я встречу его, то передам твоё сообщение».~
@22747 = ~«Я мог бы доставить ему твоё сообщение… за некоторое вознаграждение».~
@22748 = ~«Ничем не могу помочь. И вообще у меня нет времени».~
@22749 = ~«Конечно, добрый сэр. Тысяча извинений за беспокойство, — Баен кивает. — Спасибо за потраченное время».~
@22750 = ~«Прощай».~
@22751 = ~Лицо Баена освещается, как фонарь: «О, что за счастливый день для Баена и всего Дома Посыльных! Любая ваша помощь будет приветствоваться! Если вы найдёте Краддока и передадите ему сообщение, то я позабочусь о том, чтобы оплатить ваше время».~
@22752 = ~«Хорошо… а что за сообщение?»~
@22753 = ~Лицо Баена освещается, как фонарь: «Конечно, добрый сэр. Я позабочусь о том, чтобы оплатить потраченное вами время, если вы найдёте Краддока и передадите ему сообщение».~
@22754 = ~«Хорошо… а что за сообщение?»~
@22755 = ~Баен читает сообщение как молитву: «*Груз должен быть в Керсте через три дня, иначе будет наложен штраф*». Баен хмурится: «Как мне сказали, Краддок знает, что за „груз“ упоминается в сообщении».~
@22756 = ~«Если я увижу Краддока, то передам сообщение. Не подскажешь мне, как бы его найти?»~
@22757 = ~«Мне сказали, что он настоящий *гигант* с суровым лицом. Он надсмотрщик на одном из рынков Улья. Увы, это всё, что я знаю, добрый сэр».~
@22758 = ~«Ясно. Достаточно для начала».~
@22759 = ~Баен кланяется: «Спасибо, сэр. Пусть удача сопутствует вам. Когда доставите Краддоку сообщение — будьте так добры вернуться и известить меня. Я позабочусь, чтобы ваши усилия были вознаграждены».~
@22760 = ~«Отлично. Прощай, Баен».~
@22761 = ~Я согласился доставить сообщение некоему Краддоку, если встречу его. Баен сказал, что он надсмотрщик на каком-то рынке в Улье. Буду глядеть в оба.~
@22762 = ~Ты видишь посыльного Баена. Он смотрит на тебя с надеждой… но ничего не говорит.~
@22763 = ~«Слушай, тебе по-прежнему нужно найти этого… Краддока, верно? Если ещё нужно, я помогу тебе».~
@22764 = ~«Я передумал. Я помогу найти этого Краддока… за вознаграждение».~
@22765 = ~Игнорировать его.~
@22766 = ~Ты видишь посыльного Баена. Он смотрит на тебя с надеждой: «Вам удалось найти Краддока, добрый сэр?»~
@22767 = ~«Да, и я передал твоё сообщение, хотя оно его не очень порадовало».~
@22768 = ~«Пока нет, Баен. Что ты можешь рассказать мне про него?»~
@22769 = ~«Нет… но по-прежнему ищу. Я вернусь, когда найду его».~
@22770 = ~Я рассказал Баену, что доставил сообщение Краддоку. Он был рад и неплохо мне заплатил.~
@22771 = ~Баен, похоже, не слышит никаких слов после „да“ и только улыбается со вздохом облегчения: «Какое счастье! Спасибо вам, добрый сэр, большое спасибо!» Он достаёт из кармана горсть медяков, пересчитывает их и отдаёт тебе.~
@22772 = ~«Пятнадцать медяков за доставку сообщения, а? Вполне справедливо».~
@22773 = ~«Тридцать медяков за доставку сообщения, а? Вполне справедливо».~
@22774 = ~«Сорок пять медяков за доставку сообщения, а? Вполне справедливо».~
@22775 = ~«О, *более* чем справедливо, добрый сэр, более чем! Я без колебаний могу сказать, что в Сигиле нет профессии прекрасней, чем курьер Дома Посыльных!»~
@22776 = ~«Буду иметь в виду. Прощай, Баен».~
@22777 = ~Ты видишь посыльного Баена. При твоём приближении он почтительно кивает: «Рад встрече, добрый сэр. Тысяча благодарностей за помощь в розыске Краддока и доставку ему сообщения».~
@22778 = ~«Да не за что. Прощай, Баен».~
@22779 = ~«Ты не Амарисса, случаем?»~
@22780 = ~«Нет, но у меня были кое-какие вопросы…»~
@22781 = ~«Нет. Прощай».~
@22782 = ~«Уверен. Ты не Амарисса, случаем?»~
@22783 = ~«Не нуждаюсь. Прощай».~
@22784 = ~Минуту она молча глазеет на тебя, затем произносит: «Да, меня так звали когда-то, давным-давно. Кто ты?»~
@22785 = ~«Меня послал твой брат Нодд. Он о тебе очень беспокоится и хочет знать, как ты живёшь».~
@22786 = ~«Н-нодд? Он жив? Где? Почему он не пришёл ко мне сам?»~
@22787 = ~«Я думаю, ему просто стыдно. Он Сборщик, живёт сейчас в нищете на Площади Мусорщиков. И, похоже, у него… не всё в порядке. С головой, я имею в виду».~
@22788 = ~«Ага, он был малость тронутым уже в детстве, когда его ещё звали Тодус. Стыдно ему, да? Ха! Можно подумать, моя работа почётнее! Ах, ну, я хоть преуспеваю… по меркам Улья, во всяком случае, а? Я должна его навестить, и поскорее, — она в первый раз с начала разговора пристально тебя разглядывает. — А ты друг Нодда, или?..»~
@22789 = ~«В некотором роде. А что?»~
@22790 = ~«Не совсем. Он заплатит мне за беспокойство».~
@22791 = ~Ложь: «Да-да, конечно. А что?»~
@22792 = ~«Ты не… — она закусывает губу, как будто что-то обдумывает. — Ты не мог бы передать это ему?» Она подходит ближе и тайком показывает небольшой кошель. Судя по размеру, в нём около ста монет.~
@22793 = ~«Да, конечно. Клянусь, я отдам это ему».~
@22794 = ~«Да, конечно. Клянусь, я отдам это ему».~
@22795 = ~«Да, я отдам это ему».~
@22796 = ~«Нет, лучше откажусь. Но я скажу, что вскоре ты навестишь его. Прощай».~
@22797 = ~«Нет, лучше откажусь. Но я скажу, что вскоре ты навестишь его. Прощай».~
@22798 = ~Она отдаёт тебе кошель: «Спасибо. Поговори с Ноддом и скажи ему, что я очень за него беспокоюсь!»~
@22799 = ~«Обязательно. Прощай».~
@22800 = ~«Прости, здоровяк, но не мог бы ты поклясться? Слишком уж много меди на кону… для меня, по крайней мере».~
@22801 = ~«Да, конечно. Клянусь, я отдам это ему».~
@22802 = ~«Да, конечно. Клянусь, я отдам это ему».~
@22803 = ~«Нет, лучше откажусь. Но я скажу, что вскоре ты навестишь его. Прощай».~
@22804 = ~«Нет, лучше откажусь. Но я скажу, что вскоре ты навестишь его. Прощай».~
@22805 = ~«Хм-м. Ну, всё равно спасибо. Прошу, поговори с Ноддом и скажи ему, что я очень за него беспокоюсь!»~
@22806 = ~«Обязательно. Прощай».~
@22807 = ~Амарисса с надеждой смотрит тебе в лицо: «Ты уже говорил с Ноддом?»~
@22808 = ~«Нет, ещё нет».~
@22809 = ~«Ещё нет. Прощай».~
@22810 = ~«Прошу, поговори с Ноддом и скажи ему, что я очень за него беспокоюсь!»~
@22811 = ~«Обязательно. Прощай».~
@22812 = ~«Я слышала, что ты говорил с Ноддом про меня… Спасибо, здоровяк».~
@22813 = ~«Конечно… но как ты узнала?»~
@22814 = ~«Конечно. Прощай».~
@22815 = ~«У меня много друзей в Улье, — она подмигивает. — И ещё раз спасибо».~
@22816 = ~«Конечно. Прощай».~
@22817 = ~Ты видишь Амариссу, но она тебя пока не замечает.~
@22818 = ~Поговорить с ней.~
@22819 = ~Поговорить с ней.~
@22820 = ~Оставить её в покое.~
@22821 = ~При виде тебя её глаза загораются яростью, в руке во мгновение ока появляется клинок, и она кричит: «Ублюдок! Уж не думаешь ли ты, что я не слышала про моего бедного брата? Я убью тебя!»~
@22822 = ~Драться с ней.~
@22823 = ~Бежать.~
@22824 = ~При виде тебя её глаза загораются яростью, в руке во мгновение ока появляется клинок, и она кричит: «Вороватый ублюдок! Я слышала, как ты поступил! Взял последние медяки бедной тяжко работающей девушки и украл у её брата! Я убью тебя!»~
@22825 = ~Драться с ней.~
@22826 = ~Бежать.~
@22827 = ~Согнуть правое колено до угла в пятнадцать градусов, после чего максимально расправить крылья, а потом развернуть правую руку на 180 градусов.~
@22828 = ~Согнуть правое колено до угла в пятнадцать градусов, после чего максимально расправить крылья, а потом развернуть правую руку на 180 градусов.~
@22829 = ~Спрятать куб.~
@22830 = ~~
@22831 = ~Игрушка *щёлкает* и *жужжит*, когда ты двигаешь её шарнирами. В считанные мгновения маленький кубик побеждает каждого воображаемого противника, которого ты ему посылаешь, а затем успокаивается и возвращается в обычное положение.~
@22832 = ~Помахать её руками и изобразить приветственные крики толпы.~
@22833 = ~Помахать её руками и изобразить приветственные крики толпы.~
@22834 = ~Помахать её руками и изобразить приветственные крики толпы.~
@22835 = ~Помахать её руками и изобразить приветственные крики толпы.~
@22836 = ~Согнуть правое колено до угла в пятнадцать градусов, после чего максимально расправить крылья, а потом развернуть правую руку на 180 градусов.~
@22837 = ~Согнуть правое колено до угла в пятнадцать градусов, после чего максимально расправить крылья, а потом развернуть правую руку на 180 градусов.~
@22838 = ~Спрятать куб.~
@22839 = ~Толпы воображаемых существ приветствуют победу кубика. Ты почти видишь масляную слезу, переполняющую один его глаз… он — герой, самый отважный кубик, какой когда-либо рождался на планах, и все его обожают.~
@22840 = ~Согнуть правое колено до угла в пятнадцать градусов, после чего максимально расправить крылья, а потом развернуть правую руку на 180 градусов.~
@22841 = ~Согнуть правое колено до угла в пятнадцать градусов, после чего максимально расправить крылья, а потом развернуть правую руку на 180 градусов.~
@22842 = ~Отложить кубик до грядущих битв с мультивселенной.~
@22843 = ~Отложить кубик до грядущих битв с мультивселенной.~
@22844 = ~Толпы воображаемых существ приветствуют победу кубика. Ты почти видишь масляную слезу, переполняющую один его глаз… он — герой, самый отважный кубик, какой когда-либо рождался на планах, и все его обожают. В твоём воображении Падшая Грейс и Анна обнимают его и осыпают поцелуями.~
@22845 = ~Согнуть правое колено до угла в пятнадцать градусов, после чего максимально расправить крылья, а потом развернуть правую руку на 180 градусов.~
@22846 = ~Слышится *вж-ж-ж*, потом *щелчок*, и вдруг у тебя в руках вспыхивает ослепительный белый свет…~
@22847 = ~«Чт!..»~
@22848 = ~«Что ж, не сработало. Отложу-ка я тебя пока, а потом попробую в другом месте».~
@22849 = ~Морте смотрит на тебя и качает головой.~
@22850 = ~«Что такое, кубик-герой? Морте — тупой череп? Что ж, так и есть, верно, кубик-герой?»~
@22851 = ~Спрятать куб.~
@22852 = ~«Эй, он этого не говорил!»~
@22853 = ~«Сказал-сказал! Только что сказал!»~
@22854 = ~Спрятать куб.~
@22855 = ~«Что?!.. Ну-ка дай мне!»~
@22856 = ~«Нет, он мой! Он хочет тусоваться только со мной, правда, кубик-герой? Да-да, именно так!»~
@22857 = ~Спрятать куб.~
@22858 = ~«Я. Просто. Хочу. Секунду. Подержать. Его».~
@22859 = ~«Но у тебя нет рук».~
@22860 = ~Спрятать куб.~
@22861 = ~«Ничего, в ЗУБАХ подержу».~
@22862 = ~«Нет, думаю, я до поры просто спрячу его».~
@22863 = ~«Я разобью этот дурацкий кубик на кусочки».~ [MRT251]
@22864 = ~«Ты что-то слышал, кубик-герой? Я тоже ничего не слышал!»~
@22865 = ~Согнуть правое колено до угла в пятнадцать градусов, после чего максимально расправить крылья, а потом развернуть правую руку на 180 градусов.~
@22866 = ~Вздохнуть и отложить кубик до грядущих битв с мультивселенной.~
@22867 = ~Вздохнуть и отложить кубик до грядущих битв с мультивселенной.~
@22868 = ~Раздаётся «вж-ж-ж», потом «щёлк», потом «щёлк-щёлк-щёлк», потом низкое «ж-ж-ж». Ничего не происходит.~
@22869 = ~Утешить себя, подвигав ручками куба и изобразив шум боя на мечах.~
@22870 = ~Ты видишь огромного мужчину, молчаливо взирающего на площадь недовольным взглядом прищуренных глаз из-под сведённых бровей. От его одежды исходит отталкивающий запах грязи и пота.~
@22871 = ~Мужчина бросает на тебя взгляд сверху, и его недовольство усиливается: «Да? Чё ты тут разнюхать пытаешься?»~
@22872 = ~Он ворчит: «Нету у меня времени на всяких нищих и собак. Мотай-ка ты отсюда!»~
@22873 = ~«Может быть… — он внимательно изучает твоё лицо, словно пытается тебя вспомнить. — Даже если и так, чё тебе с того?»~
@22874 = ~«Во имя *кругов ада*! Эти *придурки* чё, думают, мы тут чудотворцы типа? Ладно, паря, ты доставил своё сообщение куда надо. Доволен — вали!»~
@22875 = ~«Глянь вокруг! — Краддок кивает на рыночных рабочих, а затем хмурится. — Эти тупые увальни просто едва могут стоять с грузом на плечах, а теперь нам уменьшили время! Вдвое!»~
@22876 = ~«Я скажу, чё мне нужно: чтоб все работали как надо, а тут чё? Джелай пропал с утра, а он мне нужен!»~
@22877 = ~«Это отродье Улья наверняка валяется пьяным в канаве где-нибудь рядом с „Горящим трупом“, хотя должен нам помогать. Никчёмный засранец…»~
@22878 = ~«О, можешь, можешь, да? — Краддок косится на тебя. — И на кой бы тебе это делать?»~
@22879 = ~Краддок на мгновение замолкает, а потом кивает. «Лады… найдёшь Джелая, скажи ему, чтоб тащил свою тупорылую задницу сюда. Я заплачу тебе… — он хмурится, — …*когда* ты его найдёшь. Двигай!»~
@22880 = ~«Это к юго-востоку отсюда: двигай через юго-восточные ворота, а потом около квартала на восток. Там полно всяких алкашей и прочего сброда, не пропустишь. Джелай наверняка где-то там».~
@22881 = ~Ты видишь Краддока. Он как будто ещё мрачнее, чем был в первый раз… морщина на лбу, кажется, вот-вот разломит лицо пополам.~
@22882 = ~«Правда? — Краддок оглядывается. — И *где* же он?»~
@22883 = ~Краддок багровеет и издаёт утробный рык: «Будь проклято его имя! Всех абишаев ада ему в задницу! Полуумок…» Гневный поток оскорблений, домыслов и угроз изо рта Краддока в подробностях расписывает их близкие отношения с Джелаем и всей его роднёй…~
@22884 = ~Краддок багровеет и издаёт утробный рык: «Будь проклято его имя! Всех абишаев ада ему в задницу! Полуумок…» Гневный поток оскорблений, домыслов и угроз изо рта Краддока в подробностях расписывает их близкие отношения с Джелаем и всей его роднёй…~
@22885 = ~Краддок заканчивает тираду ворчанием: «Дьявол бы побрал… этого Джелая…»~
@22886 = ~Краддок минуту внимательно изучает тебя. «Ты? Ха! Да ты даже не сможешь… — внезапно он замолкает. — Хотя… может, и сможешь. Но работа тяжёлая, и никакого пьянства у меня…»~
@22887 = ~Довольно долгий рабочий день как ни странно не изматывает тебя до предела. В конце ты подходишь к Краддоку, он ворчит. «А ничё так, молодец… вот твои бабки, — он отсыпает горсть монет. — Теперь убирайся. Дальше и без тебя обойдёмся».~
@22888 = ~Довольно долгий рабочий день как ни странно не изматывает тебя до предела. Остальные грузчики поражены скоростью твоей работы и количеством груза, которое ты перетаскиваешь. В конце ты подходишь к Краддоку, он ворчит. «Плечи у тебя прям как у бариаура. Ты заработал двойную плату Джелая… вот бабки, — он отсыпает пригоршню монет, всего двадцать. — Теперь убирайся. Дальше и без тебя обойдёмся».~
@22889 = ~Довольно долгий рабочий день как ни странно не изматывает тебя до предела. Остальные грузчики поражены скоростью твоей работы и количеством груза, которое ты перетаскиваешь. В конце ты подходишь к Краддоку, он ворчит. «Плечи у тебя прям как у токолы. Ты заработал тройную плату Джелая… вот бабки, — он отсыпает пригоршню монет, всего тридцать. — Теперь убирайся. Дальше и без тебя обойдёмся».~
@22890 = ~Краддок недовольно лезет в карман и достаёт оттуда несколько монет: «Теперь проваливай! Встретишь Джелая ещё раз — передай ему, что он покойник!»~
@22891 = ~Краддок недовольно лезет в карман и достаёт оттуда несколько монет: «Вот твои бабки! Теперь проваливай!»~
@22892 = ~«О-о-о-о!» — Морте восхищённо пощёлкивает зубами на протяжении тирады Краддока. Ты почти слышишь, как у него в черепушке происходит запись особо удачных выражений.~ [MRT387]
@22893 = ~«Приветствую».~
@22894 = ~Игнорировать мужчину, продолжить обход рынка.~
@22895 = ~«У меня кое-какие вопросы…»~
@22896 = ~«Ты Краддок?»~
@22897 = ~«Нет, ничего. Прости, что побеспокоил».~
@22898 = ~ «Ты Краддок?»~
@22899 = ~Спасбросок успешен: против магии~
@22900 = ~«Неважно. Прощай».~
@22901 = ~«Я пришёл от некоего посыльного Баена с сообщением: „Груз должен быть в Керсте через три дня, иначе будет наложен штраф“».~
@22902 = ~«Ничего, забудь. Я, должно быть, обознался. Прощай».~
@22903 = ~«В чём проблема?»~
@22904 = ~~
@22905 = ~~
@22906 = ~«Тебе нужна помощь?»~
@22907 = ~«Очень жаль это слышать. Прощай».~
@22908 = ~«Джелай? И куда он пошёл?»~
@22909 = ~«Очень жаль это слышать. Прощай».~
@22910 = ~«Я могу найти его для тебя».~
@22911 = ~«Я могу найти его для тебя… но не бесплатно».~
@22912 = ~«Очень жаль это слышать. Прощай».~
@22913 = ~[нет текста]~
@22914 = ~«Так тебе ведь нужна помощь, нет? Работать некому, и самому тебе вроде как некогда за ним бегать».~
@22915 = ~«Забудь. Прощай».~
@22916 = ~«Я могу найти его, но не думай, что буду это делать забесплатно».~
@22917 = ~«Ты сказал, он у „Горящего трупа“? А где это?»~
@22918 = ~«Хорошо, я поищу его. Прощай».~
@22919 = ~«Хорошо, я поищу его. Прощай».~
@22920 = ~«Ты вроде как расстроен сообщением Баена. В чём дело?»~
@22921 = ~«Я нашёл Джелая».~
@22922 = ~«Если не хватает рук — я могу помочь вам».~
@22923 = ~Оставить Краддока в покое.~
@22924 = ~Правда: «Он просил передать, чтобы ты „отвалил“, что ты „шавка низкопробная“, и что „он на тебя работать больше не будет“».~
@22925 = ~Угольный амулет~
@22926 = ~Подушка снов~
@22927 = ~Ключ снов~
@22928 = ~Флакон снов~
@22929 = ~Молитвенные чётки~
@22930 = ~Золотая серьга~
@22931 = ~Бронзовое кольцо~
@22932 = ~Серебряное кольцо~
@22933 = ~Клетка снов~
@22934 = ~Ключ от кабинета в Мортуарии~
@22935 = ~Угольный амулет~
@22936 = ~Подушка снов~
@22937 = ~Клетка снов~
@22938 = ~Ключ снов~
@22939 = ~Флакон снов~
@22940 = ~Молитвенные чётки~
@22941 = ~Медная серьга~
@22942 = ~Золотая серьга ~
@22943 = ~Бронзовое кольцо~
@22944 = ~Золотое кольцо~
@22945 = ~Ключ от кабинета в Мортуарии~
@22946 = ~Правда: «Он просил передать, чтобы ты „отвалил“, что ты „шавка низкопробная“, и что „он на тебя работать больше не будет“».~
@22947 = ~Ложь: «Он сказал, э-э… что я должен подменить его».~
@22948 = ~«Ну, таково сообщение. Если это всё, то гони монету…»~
@22949 = ~~
@22950 = ~«Знаешь, я мог бы подменить его, если тебе нужны работники».~
@22951 = ~«Мне нужна работка на денёк. Я мог бы временно поработать за Джелая, за деньги, естественно».~
@22952 = ~«Хм… не беспокойся, денег за его поиски мне не надо. Пойду я, прощай».~
@22953 = ~«Мне пора идти. Прощай».~
@22954 = ~«Знаешь, я мог бы подменить его, если тебе нужны работники».~
@22955 = ~«Мне нужна работка на денёк. Я мог бы временно поработать за Джелая, за деньги, естественно».~
@22956 = ~«Ну, таково сообщение. Если это всё, то гони монету…»~
@22957 = ~«Может, в другой раз…»~
@22958 = ~«Хм… не беспокойся, денег за его поиски мне не надо. Пойду я, прощай».~
@22959 = ~Место для безымянной женщины-зомби.~
@22960 = ~«Мне пора идти. Прощай».~
@22961 = ~Место для упыря с ножом.~
@22962 = ~«Ясно… давай приступим».~
@22963 = ~«Ясно… давай приступим».~
@22964 = ~«Ясно… давай приступим».~
@22965 = ~«А как насчёт оплаты за доставку сообщения от Джелая?»~
@22966 = ~«Тогда прощай».~
@22967 = ~«А как насчёт оплаты за доставку сообщения от Джелая?»~
@22968 = ~«Тогда прощай».~
@22969 = ~«А как насчёт оплаты за доставку сообщения от Джелая?»~
@22970 = ~«Тогда прощай».~
@22971 = ~«Знаешь, я мог бы подменить его, если тебе нужны работники».~
@22972 = ~«Мне нужна работка на денёк. Я мог бы временно поработать за Джелая, за деньги, естественно».~
@22973 = ~«Я запомню. Прощай».~
@22974 = ~«Тогда прощай».~
@22975 = ~Годы не были милосердны к этой маленькой тряпичной кукле: швы несколько поистрепались, а кое-где нитки и вовсе разошлись. Выглядит она как странная женщина в мантии и с ореолом из шипов вокруг головы.~
@22976 = ~Кукла равнодушна к умасливанию и просто глазеет на тебя пуговичными глазами.~
@22977 = ~Годы не были милосердны к этой маленькой тряпичной кукле: швы несколько поистрепались, а кое-где нитки и вовсе разошлись. Очевидно, кукла должна была изображать Госпожу Боли, но её пуговичные глаза и мягкость материала не внушают особого страха.~
@22978 = ~Как только ты собираешься произнести эти слова, ты чувствуешь странное покалывание в задней части черепа. Вместе с этим приходит предчувствие, что произнесение этих слов может иметь страшные последствия… даже сама *мысль* о таком поступке кажется опасной.~
@22979 = ~Кукла равнодушна к умасливанию и просто глазеет на тебя пуговичными глазами.~
@22980 = ~Как только ты произносишь эти слова, тебя вдруг охватывает ледяной озноб… сопровождаемый чувством ужаса. Что-то не так, куколка больше не кажется тебе такой уж безобидной. На мгновение, не больше, ты думаешь, что клинки вокруг её головы отливают металлом.~
@22981 = ~«Ой-ой… ты просто милая маленькая кукла, не так ли? Да-да, ути-пусеньки!»~
@22982 = ~Спрятать куклу.~
@22983 = ~«Хорошо-хорошо… я же просто забавы ради… тьфу».~
@22984 = ~«Ой-ой… ты просто милая маленькая Госпожа Боли, не так ли? Да-да, ути-пусеньки!»~
@22985 = ~Искренне: «О великая Госпожа Боли, богиня Сигила! Услышь мои мольбы и помоги мне в час нужды».~
@22986 = ~Искренне: «О великая Госпожа Боли, богиня Сигила! Услышь мои мольбы и помоги мне в час нужды».~
@22987 = ~Искренне: «О великая Госпожа Боли, богиня Сигила! Услышь мои мольбы и помоги мне в час нужды».~
@22988 = ~В шутку: «О великая Госпожа Боли, богиня Сигила! Услышь мои мольбы и помоги мне в час нужды».~
@22989 = ~Искренне: «О великая Госпожа Боли, богиня Сигила! Услышь мои мольбы и помоги мне в час нужды».~
