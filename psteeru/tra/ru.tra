@27503 = ~«У меня другие вопросы…»~
@27504 = ~«Это всё, что я хотел узнать. Прощай».~
@27505 = ~«Чующих?»~
@27506 = ~«Сенсориумы?»~
@27507 = ~«Где находится Фестхолл?»~
@27508 = ~«Я хотел спросить о другом месте…»~
@27509 = ~«У меня другие вопросы…»~
@27510 = ~«Это всё, что я хотел узнать. Прощай».~
@27511 = ~«Полуизверг?»~
@27512 = ~«Нижние планы?»~
@27513 = ~«Где я могу найти это место?»~
@27514 = ~«Я хотел спросить о другом месте…»~
@27515 = ~«У меня другие вопросы…»~
@27516 = ~«Это всё, что я хотел узнать. Прощай».~
@27517 = ~«А где магазин Гонкальвеса?»~
@27518 = ~«Я хотел спросить о другом месте…»~
@27519 = ~«У меня другие вопросы…»~
@27520 = ~«Это всё, что я хотел узнать. Прощай».~
