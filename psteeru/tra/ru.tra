@35512 = ~«Неважно. Может, в другой раз».~
@35513 = ~«Неважно. Может, в другой раз».~
@35514 = ~«Ох… я не хотел причинять необратимые повреждения».~
@35515 = ~«Ладно, неважно. Может, в другой раз».~
@35516 = ~Попробовать вытащить болты из скелета.~
@35517 = ~Попробовать вытащить болты из скелета.~
@35518 = ~Попробовать вытащить болты из скелета.~
@35519 = ~«Не против, если я позаимствую эти ремни и болты?»~
@35520 = ~«Не против, если я позаимствую эти ремни и болты?»~
@35521 = ~«Не против, если я позаимствую эти ремни и болты?»~
