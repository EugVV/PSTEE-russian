@3219  = ~Ивес Охотница-за-Рассказами~
@3220  = ~Лотар~
@3221  = ~Мантуок~
@3222  = ~Прыщ Кильн~
@3223  = ~Неизбежный~
@3224  = ~Марисса~
@3225  = ~Многие-как-Один~
@3226  = ~Джамбл Убийца Чувств~
@3227  = ~Кимази Язык-Гадюки~
@3228  = ~Грызь~
@3229  = ~Чующий~
@3230  = ~Пожилой мужчина~
@3231  = ~Крыса-оборотень~
@3232  = ~Многие-как-Один~
@3233  = ~Человек без головы~
@3234  = ~Модрон~
@3235  = ~Больная книга~
@3236  = ~Чующий~
@3237  = ~Алхимик~
@3238  = ~Торговец района Клерков~
@3239  = ~Босс Сборщиков~
@3240  = ~Беспокойный дух~
@3241  = ~Тлетворная книга~
@3242  = ~Модрон~
@3243  = ~Квиллион Рейфелд~
@3244  = ~Головорез из Голодных Лающих Псов~
@3245  = ~Подж~
@3246  = ~Монтекки~
@3247  = ~Рейвел~
@3248  = ~Кви-Сай~
@3249  = ~Сплинтер~
@3250  = ~Чующий~
@3251  = ~Превосходящий~
@3252  = ~Тухлая Мэри~
@3253  = ~Разбросанный-по-Трём-Планам~
@3254  = ~Вейлор~
@3255  = ~Неудовлетворённое-Желание~
@3256  = ~Триас~
@3257  = ~Ивана~
@3258  = ~Вираго~
@3259  = ~Чёрный абишай~
@3260  = ~Фарод~
@3261  = ~Хранилище Девятого Мира~
@3262  = ~Вришика~
@3263  = ~Зелёный абишай~
@3264  = ~Квелл~
@3265  = ~Упырь~
@3266  = ~Нордом~
@3267  = ~Мертвин Безголовый~
@3268  = ~Металлическая голова~
@3269  = ~Ночная Ведьма~
@3270  = ~Куратор~
@3271  = ~Гид Чующих~
@3272  = ~Бандит с дикими глазами~
@3273  = ~Превосходящий~
@3274  = ~Дэв~
@3275  = ~Доспехи Убийцы Милосердия~
@3276  = ~Импортёр~
@3277  = ~Повеса~
@3278  = ~Упырь~
@3279  = ~Чёрный абишай~
@3280  = ~Статуя~
@3281  = ~Корнугон~
@3282  = ~Красный абишай~
@3283  = ~Глабрезу~
@3284  = ~Напперибо~
@3285  = ~Лемур~
@3286  = ~Гехрелет~
@3287  = ~Черепокрыса~
@3288  = ~Госпожа Боли~
@3289  = ~Крыса-оборотень~
@3290  = ~Чума~
@3291  = ~Каменный голем упырей~
@3292  = ~Ай-Вин~
@3293  = ~Трокопотака~
@3294  = ~Тускампа~
@3295  = ~Токола~
@3296  = ~Большая тень~
@3297  = ~Каменная статуя~
@3298  = ~Корнугон~
@3299  = ~Красный абишай~
@3300  = ~Глабрезу~
@3301  = ~Гехрелет~
@3302  = ~Крыса-оборотень~
@3303  = ~Черепокрыса~
@3304  = ~Госпожа Боли~
@3305  = ~Токола~
@3306  = ~Завсегдатай «Горящего трупа»~
@3307  = ~Гриллиг~
@3308  = ~Триша~
@3309  = ~Лемур~
@3310  = ~Сутулый зомби~
@3311  = ~Осунувшаяся женщина~
@3312  = ~Личиночный червь~
@3313  = ~Трелон~
@3314  = ~Тригит~
@3315  = ~Колонна Черепов~
@3316  = ~Большая тень~
@3317  = ~Тускампа~
@3318  = ~Убийца Милосердия~
@3319  = ~Соумьен~
@3320  = ~Червь~
@3321  = ~Напперибо~
@3322  = ~Лим-лим~
@3323  = ~Трокопотака~
@3324  = ~Зелёный абишай~
@3325  = ~Эта покрытая чёрной чешуёй рептилия возвышается на восемь футов. Её огромный рост, однако, компенсируется тонким, как у змеи, телом. Длинный цепкий хвост волочится сзади, кожистые крылья собраны за спиной. От существа исходит резкий неприятный запах… а вдобавок ещё и жар. Кажется, оно тебя не замечает.~
@3326  = ~«Приветствую».~
@3327  = ~Я КРАСНЫЙ абишай, совсем не такой, как чёрные. Правда. Но я тоже хочу убить тебя.~
@3328  = ~Очаровательно.~
@3329  = ~Я «зелёный» абишай. Мне тошно даже смотреть на себя.~
@3330  = ~Мне тоже. Я имею в виду на себя.~
@3331  = ~Гр-р-р. Моя большой корнугон. Моя опасен. Причинять много боли.~
@3332  = ~Я тоже. Рад познакомиться.~
@3333  = ~Возможно, черепокрысы в игре могут говорить с персонажем. Если так, эта заготовка здесь как раз для этого.~
@3334  = ~Удобно.~
@3335  = ~тест/Крис/8.25~
@3336  = ~тест крис часть 2 8.25~
@3337  = ~Ключ от комнаты Фестхолла~
@3338  = ~Заметки Фина Андли~
@3339  = ~Я один из последователей Мантуока. Бла-бла.~
@3340  = ~Да уж, действительно бла-бла.~
@3341  = ~Я из «гниющего стада» зомби, которые заполняют катакомбы. Я тащусь на работу и с работы, прямо как Крис Авеллон.~
@3342  = ~А потом что ты делаешь?~
@3343  = ~Я из «гниющего стада» зомби, которые заполняют катакомбы. Я тащусь на работу и с работы, прямо как Крис Авеллон. Бла, бла. Бла?~
@3344  = ~Ты и пахнешь точно как он.~
@3345  = ~Я один из скелетов-последователей Харгримма. Мы платим мёртвым дань и чтим их жертву.~
@3346  = ~Ладно, я вас оставляю, добрые скелеты.~
@3347  = ~«Столб»~
@3348  = ~Завсегдатай из Убийц Милосердия~
@3349  = ~Ингресс~
@3350  = ~Соумьен~
@3351  = ~Стрейк~
@3352  = ~Стенчпот~
@3353  = ~Пожилая жительница Улья~
@3354  = ~Смерть-Имён~
@3355  = ~Тригит~
@3356  = ~Трелон~
@3357  = ~Квентин~
@3358  = ~Гигантский скелет~
@3359  = ~Триша~
@3360  = ~Личиночный червь~
@3361  = ~Лим-лим~
@3362  = ~Гриллиг~
@3363  = ~«Есть такой Гнилой Уильям. Он тёмный и лживый человек, лидер Клинков Тёмной Аллеи. Найди его в этой аллее и убей. Этим ты послужишь добру. Потерпишь неудачу — и зло воспрянет. Откажешься — и я убью тебя».~
@3364  = ~«У меня другие вопросы…»~
@3365  = ~Уйти.~
@3366  = ~Интересно, сможет ли дизайнер убрать это. Должно быть прикольно!~
@3367  = ~«Пожалуйста. Я хотел бы кое о чём спросить…»~
@3368  = ~Может быть? Может быть, если ты не сделаешь это, я врежу по твоей крысиной, тупой человеческой роже.~
@3369  = ~«Мы кочуем. Приходится переезжать снова и снова. Здесь мы осели одновременно с Гнилым Уильямом и Клинками Тёмной Аллеи и теперь бьёмся за наши жизни. Мы просто назначили небольшую плату за проход. Они же убивают. Мы по сути добрые люди. Они же — злые, ведомые злым человеком».~
@3370  = ~«Ты меня знаешь, незнакомец?»~
@3371  = ~«Я ищу Фарода».~
@3372  = ~«Кто ты?»~
@3373  = ~Знаешь, слушаю тебя и прямо кончаю в штаны.~
@3374  = ~[нет текста]~
@3375  = ~Сумка~
@3376  = ~Нагрудная пластина 2~
@3377  = ~Скрюченная пальцевая кость~
@3378  = ~Нагрудная пластина 3~
@3379  = ~Тряпьё~
@3380  = ~Бинты~
@3381  = ~Нагрудная пластина 4~
@3382  = ~Потрескавшийся бронзовый нагрудник~
@3383  = ~Кулаки~
@3384  = ~Клинок гигантского скелета~
@3385  = ~Кулак зомби (удар)~
@3386  = ~Нитка с иголкой~
@3387  = ~Руна доспеха~
@3388  = ~Корсаж безбожного священника~
@3389  = ~Кулак зомби (удар)~
@3390  = ~Кулаки~
@3391  = ~Кожаный фартук~
@3392  = ~Скрюченная пальцевая кость~
@3393  = ~Малая охранная руна~
@3394  = ~Клинок гигантского скелета~
@3395  = ~Скрижаль Дхалла~
@3396  = ~Я один из Сборщиков в Похороненной деревне. Слоняюсь тут, собираю вещи и трупы для Фарода.~
@3397  = ~Звучит прикольно.~
@3398  = ~Я покупатель из Нижнего района. Шатаюсь тут, смотрю товар и в целом тут просто для массовки.~
@3399  = ~Круто. Спасибо, что уделил мне своё «время».~
@3400  = ~Я покупатель Нижнего района, женщина. Как и мужчины моего рода деятельности, я хожу от магазина к магазину, смотрю товар и решаю, что же хочу купить. В общем ни для чего конкретно не нужна.~
@3401  = ~Интересно… хоть и банально. Спасибо, что уделила мне время, дорогая.~
@3402  = ~Я одна из девушек Похороненной деревни. Хожу по деревне, ищу трупы и всякие безделушки для Фарода.~
@3403  = ~Добро. Зло. У меня есть оружие.~
@3404  = ~Ты видишь худощавую молодую женщину с бледным лицом. Впалые щёки и шея делают её похожей на голодающую. Кажется, она занята вскрытием лежащего перед ней трупа — протыкает его грудь пальцем.~
@3405  = ~~
@3406  = ~«Приветствую».~
@3407  = ~Оставить её в покое.~
@3408  = ~Ты видишь осунувшуюся женщину, завёрнутую в лохмотья. Её волосы растрёпаны и грязны, а цвет лица необычайно тёмный. Ожоги покрывают её руки, а правая рука — просто оголённый кусок плоти… она выглядит растаявшей, как воск от сильного жара.~
@3409  = ~«Приветствую».~
@3410  = ~Женщина не отвечает… похоже, она слишком поглощена работой с телом перед ней. Наблюдая за её работой, ты внезапно обращаешь внимание на руки… её пальцы — когти. Они орудуют в груди трупа как ножи, удаляя органы.~
@3411  = ~«Я сказал „приветствую“».~
@3412  = ~«Я сказал „приветствую“».~
@3413  = ~«Я сказал „приветствую“».~
@3414  = ~«Что с твоими руками?»~
@3415  = ~«Что с твоими руками?»~
@3416  = ~Оставить её в покое.~
@3417  = ~Женщина не отвечает.~
@3418  = ~Дотронуться до женщины, чтобы привлечь её внимание.~
@3419  = ~Оставить её в покое.~
@3420  = ~Женщина не отвечает.~
@3421  = ~Женщина вздрагивает и поворачивает к тебе лицо… у неё глаза гниловато-жёлтого цвета с маленькими оранжевыми точками зрачков. Когда она замечает тебя, её выражение меняется от удивления к раздражению и она хмурится.~
@3422  = ~«Э… приветствую».~
@3423  = ~Кажется, женщина тебя не слышит. Она наклоняется вперёд, щурясь, как будто не может тебя разглядеть… что бы там ни было с её глазами, вероятно, она очень близорука. «Ты… — она сводит вместе свои когтистые пальцы, затем делает странное движение руками. — Найди НИТКУ и БАЛЬЗАМИРУЮЩУЮ ЖИДКОСТЬ, неси СЮДА, к Ай-Вин. Пошёл-пошёл-пошёл».

^NПРИМЕЧАНИЕ. Получено задание. Задания отображаются в одноимённом разделе дневника. Чтобы увидеть все текущие квесты (и их статус), нужно просто выбрать пункт «Задания» в меню дневника.^-~
@3424  = ~Дать ей нитку и бальзамирующую жидкость.~
@3425  = ~«Сначала я хотел бы задать несколько вопросов…»~
@3426  = ~«Сначала я хотел бы задать несколько вопросов…»~
@3427  = ~«Что это с твоими руками?»~
@3428  = ~«Что это с твоими руками?»~
@3429  = ~Уйти.~
@3430  = ~Она отворачивается… и ничем не показывает, что слышала тебя. Её слух так же плох, как и зрение.~
@3431  = ~Дотронуться до плеча, чтобы привлечь её внимание.~
@3432  = ~Уйти.~
@3433  = ~Не теряя ритма, Ай-Вин берёт у тебя нитку и обматывает вокруг одного из своих когтей, затем начинает зашивать грудь трупа. Потом она берёт бальзамирующую жидкость и начинает наносить её на труп.~
@3434  = ~Ждать.~
@3435  = ~Уйти.~
@3436  = ~Когда ты уже собираешься уйти, Ай-Вин говорит: «Стой. Ты следующий».~
@3437  = ~Ждать.~
@3438  = ~Быстро уйти.~
@3439  = ~Через несколько минут Ай-Вин заканчивает. Она щёлкает когтями, а затем поворачивается к тебе. К твоему удивлению, она протягивает руку и проводит когтями по твоим рукам и груди.~
@3440  = ~«Э-э, это, конечно, очень лестно, но…»~
@3441  = ~«Э-э, это, конечно, очень лестно, но…»~
@3442  = ~Продолжать изображать зомби.~
@3443  = ~Продолжать изображать зомби.~
@3444  = ~Оттолкнуть её и уйти.~
@3445  = ~Когда ты её отталкиваешь, она выглядит потрясённой. «Зомфи? Ты не зомфи!» — она отступает, а затем, прежде чем ты успеваешь среагировать, трижды хлопает в ладоши. В ответ звон огромного колокола разносится по Мортуарию.~
@3446  = ~Когда она проводит когтями по твоим рукам и груди, ты внезапно понимаешь, что она изучает твои шрамы. Ай-Вин отводит когти, дважды щёлкает ими, затем наклоняется и изучает некоторые татуировки на твоей груди. «Хмф-ф. Кто на тебе пишет? Жители Улья? Не уважают зомфи. Зомфи, а не картина, — она фыркает, затем указывает на один из твоих шрамов. — Плохая оболочка, много шрамов, никакого сохранения».~
@3447  = ~Ждать.~
@3448  = ~Её когти внезапно подцепляют нитку, которую ты принёс, и она молниеносно втыкает один коготь в кожу рядом с одним из твоих шрамов. По ощущениям это не больнее укола булавки. Похоже, она собирается начать тебя штопать.~
@3449  = ~Дать ей работать.~
@3450  = ~Оттолкнуть её и уйти.~
@3451  = ~Ай-Вин начинает зашивать твои шрамы, при этом ощущения у тебя на удивление безболезненны.

Закончив работу, она обнюхивает тебя, хмурится, а затем макает свои пальцы в бальзамирующую жидкость. В течение нескольких минут она покрывает твоё тело этой жидкостью… и, как ни странно, после этого ты чувствуешь себя *гораздо* лучше.~
@3452  = ~Дать ей работать.~
@3453  = ~Дать ей работать.~
@3454  = ~Ай-Вин дотрагивается до тебя в последний раз, ещё раз обнюхивает, кивает, а затем делает отстраняющее движение когтями: «Готово. Пошёл-пошёл».~
@3455  = ~«Подожди минутку. Мне нужен ключ от комнаты для бальзамирования. У тебя он есть?»~
@3456  = ~«Подожди минутку, — изобразить, как будто поворачиваешь ключ. — Мне нужен ключ от комнаты для бальзамирования. У тебя он есть?»~
@3457  = ~«Подожди минутку, — изобразить, как будто поворачиваешь ключ. — Мне нужен ключ от комнаты для бальзамирования. У тебя он есть?»~
@3458  = ~Ты видишь Ай-Вин. Она всё ещё копается своими когтями в трупе. Ритм движений её когтей о чём-то напоминает тебе, но ты никак не можешь вспомнить, о чём именно.~
@3459  = ~Наблюдать за ней, изучая движения её рук.~
@3460  = ~~
@3461  = ~~
@3462  = ~~
@3463  = ~Дотронуться до неё, чтобы привлечь внимание.~
@3464  = ~Следя за движениями рук Ай-Вин, ты чувствуешь покалывание у себя в черепе, а затем вдруг ощущаешь, что перед глазами всё плывёт и размывается, пока…~
@3465  = ~~
@3466  = ~~
@3467  = ~~
@3468  = ~Ай-Вин поворачивается, смотрит на тебя и хмурится. «Тупой зомфи, — она нетерпеливо сводит вместе свои когти, затем делает сшивающие движения пальцами. — Найди нитку и бальзамирующую жидкость и принеси сюда, к Ай-Вин. Пошёл-пошёл-пошёл».~
@3469  = ~Дать ей нитку и бальзамирующую жидкость.~
@3470  = ~«Подожди минутку, — изобразить, как будто поворачиваешь ключ. — Мне нужен ключ от комнаты для бальзамирования. У тебя он есть?»~
@3471  = ~Ай-Вин наклоняется вперёд, смотрит на движение твоей руки, затем фыркает. Она засовывает руку в полы своей одежды, а когда вынимает — с указательного пальца свисает ключ. Она стряхивает его в твою руку: «Верни, когда закончишь. Пошёл-пошёл».~
@3472  = ~Женщина не отвечает.~
@3473  = ~«Я думаю, Пыльница немного туга на ухо, шеф. Пошли отсюда, а?»~
@3474  = ~«Что это с её руками?»~
@3475  = ~Дотронуться до женщины, чтобы привлечь её внимание.~
@3476  = ~Оставить её в покое.~
@3477  = ~«Э-э… она *тифлинг*, шеф. В их жилах частично течёт кровь извергов; обычно из-за того, что кто-то из их предков спутался с тем или иным демоном. Некоторые из них больные на голову… и выглядят обычно соответствующе».~
@3478  = ~Дотронуться до женщины, чтобы привлечь её внимание.~
@3479  = ~Оставить её в покое.~
@3480  = ~«Я думаю, Пыльница немного туга на ухо, шеф. Пошли отсюда, а?»~
@3481  = ~«Э-э… она *тифлинг*, шеф. В их жилах частично течёт кровь извергов; обычно из-за того, что кто-то из их предков спутался с тем или иным демоном. Некоторые из них больные на голову… и выглядят обычно соответствующе».~
@3482  = ~Уйти.~
@3483  = ~«Что это с её руками?»~
@3484  = ~Уйти.~
@3485  = ~Она отворачивается… и ничем не показывает, что слышала тебя.~
@3486  = ~Она отворачивается… и ничем не показывает, что слышала тебя. Её слух так же плох, как и зрение.~
@3487  = ~«Похоже, у тебя появилась новая подруга, шеф. Вам двоим надо немного побыть вместе или?..»~
@3488  = ~«Прекрати, Морте».~
@3489  = ~Продолжать изображать зомби.~
@3490  = ~Оттолкнуть женщину.~
@3491  = ~«Ну и ладно…»~
@3492  = ~«Второй раз в своей жизни я рад, что у меня нет носа».~
@3493  = ~Ай-Вин поворачивается, смотрит на тебя и хмурится. «Тупой зомфи, — она нетерпеливо сводит вместе свои когти, затем делает сшивающие движения пальцами. — Ты готов. Всё зашито. Пошёл-пошёл-пошёл».~
@3494  = ~«Что с твоими руками?»~
@3495  = ~«Что с твоими руками?»~
@3496  = ~Уйти.~
@3497  = ~«Подожди минутку, — изобразить, как будто поворачиваешь ключ. — Мне нужен ключ от комнаты для бальзамирования. У тебя он есть?»~
@3498  = ~Она отворачивается… и ничем не показывает, что слышала тебя. Её слух так же плох, как и зрение.~
@3499  = ~Уйти.~
@3500  = ~Мне нужен ключ. У тебя он есть?~
@3501  = ~«Подожди минутку, — изобразить, как будто поворачиваешь ключ. — Мне нужен ключ от комнаты для бальзамирования. У тебя он есть?»~
@3502  = ~«Подожди минутку, — изобразить, как будто поворачиваешь ключ. — Мне нужен ключ от комнаты для бальзамирования. У тебя он есть?»~
@3503  = ~МАЛАЯ ОХРАННАЯ РУНА
Вызывает: «Доспех»
Позволяет выучить: «Доспех»
Уровень: 1 / Заклинания мага
Радиус: 0
Длительность: до разрушения от урона
Время чтения: 1
Зона действия: 1 существо
Спасбросок: нет
Вес: 5
Доступно: магам

Подробное изучение рун, покрывающих этот нагрудный доспех, наводит на мысль, что их силу можно раскрыть и использовать для создания простейшего защитного заклинания. Чары будут подобны тем, что когда-то защищали гигантского скелета. Однако активация рун уничтожит нагрудник.~
@3504  = ~РАСПИСКА БОГОТОВ
Вес: 0

Расписка с печатью символа Боготов. Возможно, имеет хождение в Великой Кузнице.~
@3505  = ~СКРЮЧЕННАЯ ПАЛЬЦЕВАЯ КОСТЬ
Вес: 0

Это скрюченная пальцевая кость скелета. Ты не знаешь, почему она сохраняет свою уродливую форму; на ней нет ничего, что хоть как-то может сцеплять отдельные кости.~
@3506  = ~КОЖАНЫЙ РЕМЕНЬ
Вес: 1

Этот кожаный ремень использовался для связывания костей скелетов-рабочих. Хотя ремень и растрёпан на концах, выглядит он всё ещё довольно прочным.~
@3507  = ~МУСОР
Вес: 1

Это коллекция всякого хлама… маленькие пружины, сломанные болты и пара треснутых шестерёнок. Похоже, кто-то считал, что всё это когда-нибудь пригодится, но тебе они кажутся совершенно бесполезными.~
@3508  = ~ТРЯПЬЁ
Вес: 1

Эта плотная куча тряпья выглядит так, словно её нарвали из обивочной ткани или чьей-то одежды.~
@3509  = ~КУЛАК ЗОМБИ (УДАР)
Вес: 0

Это удар зомби наотмашь.~
@3510  = ~Это один из кожаных ремней, использующихся для связывания костей скелетов-рабочих. Хотя ремень и растрёпан на концах, выглядит он всё ещё очень прочным.~
@3511  = ~СКРЮЧЕННАЯ ПАЛЬЦЕВАЯ КОСТЬ
Вес: 0

Это скрюченная пальцевая кость скелета. Ты не знаешь, почему она сохраняет свою уродливую форму; на ней нет ничего, что хоть как-то может сцеплять отдельные кости.~
@3512  = ~КОЖАНЫЙ ФАРТУК
Вес: 5

Тяжёлый фартук, сделанный из кожи какого-то животного. Такие фартуки используются, чтобы защитить одежду рабочих от жара, исходящего от топки.~
@3513  = ~На расписке стоит печать в виде символа, изображающего меч, излучающий яркий солнечный свет.~
@3514  = ~ТРЕНИРОВОЧНАЯ БУЛАВА
Урон: 1-2 дробящий
Фактор скорости: 5
Вес: 4
Навык: булава
Доступно: воинам

На ощупь эта булава мягкая, будто сделана из губки. Скорее всего, оружие используется для тренировок.~
@3515  = ~НЕОБЫЧНАЯ ЖЕЛЕЗКА
Вес: 10

Это блестящее металлическое изделие филигранной работы, которое ты получил в Великой Кузнице. Выглядит оно почти прозрачным, с краёв выступают острые концы. Ты понятия не имеешь, что делать с ним прямо сейчас, но сохранить его кажется очень важным.~
@3516  = ~ЩИПЦЫ
Вес: 5

Эти покрытые сажей щипцы используются для того, чтобы держать железную руду в огне печи.~
@3517  = ~ЖЕЛЕЗНАЯ РУДА
Вес: 5

Кусок железной руды.~
@3518  = ~ПОТРЕСКАВШИЙСЯ БРОНЗОВЫЙ НАГРУДНИК
Вес: 5

На поверхности этого потрескавшегося нагрудника выгравированы многочисленные руны. Он достался тебе от гигантского скелета в Мортуарии после разрушения чар, которые того оживляли.~
@3519  = ~КЛИНОК ГИГАНТСКОГО СКЕЛЕТА
Урон: 3-24 рубящий
Вес: 0
Доступно: гигантским скелетам

Этим оружием обычно вооружают гигантских скелетов.~
@3520  = ~Разве тебе не полагается быть немного умнее? Я имею в виду, ТЫ — высокоуровневый изверг, который воспитывал своё зло и интеллект на протяжении тысячелетий, так ведь?~
@3521  = ~Э-э, ну, да, но гораздо легче просто много рычать «гр-р»… это производит впечатление на чайников, знаешь ли.~
@3522  = ~Хенкельмонстр — это высокое германское существо с длинными, ниспадающими волосами.~
@3523  = ~Аазимары — противоположность тифлингов. Это дети от небожителей, обитателей Верхних планов, и смертных. Они несут искру божественности в самой своей плоти, но некоторые всё же отворачиваются от своего наследия. Хотя обычно аазимары — образцы добродетели, но доверять им стоит с оговорками.~
@3524  = ~Двуличный — жертва Триаса, которого он называет «Предателем». Фьюлл подписал контракт с дэвом, по которому он обязан нести добродетель, пока Триас не умрёт. Двуличный живёт в костях Уль-Гориса на Внешних Землях, прячась от смертных и бессмертных. У него есть знания и вещи, которые могут оказаться полезными.~
@3525  = ~Призрак по имени Дейонарра уверяет, что знает тебя, что ты её «Любовь». Что бы ни удерживало её на физическом плане, оно должно быть достаточно мощным, чтобы так долго не позволять ей покинуть этот мир. Похоже, смерть не изменила отношение Дейонарры к тебе.~
@3526  = ~Морте — говорящий череп. Единственным его оружием является рот, с помощью которого он или кусается, или насмехается. Похоже, Морте всё время следует за тобой, хочешь ты этого или нет.

Интересно, как это ему удаётся парить в воздухе?~
@3527  = ~«Пыльные» — это те, кто следит за Мортуарием, огромным моргом, наполненным трупами. Эта фракция довольно замкнута, они редко проявляют интерес к чему бы то ни было. Их интересует только ухаживание за телами, которые привозят в Мортуарий, каталогизирование трупов, подготовка к похоронам, а затем сами похороны… где-нибудь.

Пыльные подавляют большинство своих чувств, рассматривая их только в качестве отвлекающего явления на пути к «Истинной Смерти». Они воспринимают свою «жизнь» как нечто временное — тень Истинной Смерти, к которой стремятся все живые существа. Согласно философии Пыльных, люди должны отречься от всех страстей, прежде чем смогут выйти за пределы этого существования к Истинной Смерти.~
@3528  = ~Дхалл очень стар и совершенно точно не человек. Его кожа отдаёт желтизной, как старый пергамент. Мёртвые угольно-серые глаза смотрят с костлявого лица… нечеловеческого лица с заострёнными к кончикам ушами. Большая белая борода ниспадает по его чёрным одеждам, как водопад. Время от времени Дхалл кашляет. Книга, над которой он работает, огромна и явно содержит множество имён мертвецов, доставленных в Мортуарий.

Дхалл — член фракции Пыльных, фракции, верящей в «Истинную Смерть» — высочайшее состояние небытия, которое ожидает за гранью жизни. Дхалл утверждает, что знает тебя и встречался с тобой много раз. Обращается он к тебе не иначе как «Беспокойный». А ещё он заявляет, что хранит твои постоянные воскрешения в секрете от остальных членов фракции. Кажется, его желание — чтобы ты сам разобрался с тем, что удерживает тебя от «Истинной Смерти».~
@3529  = ~Зомби — это безмозглые трупы, приводимые в движение некромантией. В отличие от скелетов, у зомби ещё сохраняется много плоти на костях, что является одновременно и преимуществом, и недостатком: это делает их крепче и сильнее скелетов, но в то же время трупное окоченение затрудняет их движения, делая их гораздо медленнее обычных людей.

Хотя зомби ходят и атакуют очень медленно, их огромная сила становится очевидной, когда они попадают в цель. Они могут убить обыкновенного человека с одного удара.~
@3530  = ~С помощью некромантии этим скелетам было подарено некоторое подобие жизни. Хотя у них нет мышц и сухожилий, их суставы скреплены тонкими металлическими болтами, а кости соединены кожаными ремнями и шнурами. Скелеты получают меньший урон от рубящего и колющего оружия. Дробящее оружие, наподобие дубин и молотов, наносит им нормальные повреждения.~
@3531  = ~В отличие от других черепов, что ты видишь в этой комнате, этот, кажется, живёт и здравствует. Его глаза в глазницах вполне живые, и они следят за всеми твоими движениями. Похоже, череп хочет привлечь твоё внимание.~
@3532  = ~Эти скелеты созданы из костей гигантов и получили подобие жизни с помощью некромантии. Хотя у них нет мышц и сухожилий, их суставы скреплены металлическими болтами, а кости усилены кожаными ремнями и шнурами, намотанными под доспехами. Размеры этих скелетов вводят в заблуждение насчёт их скорости и умения обращаться с большими мечами. На самом деле эти навыки выше всяких похвал.

Архаичные оружие и доспехи, которые используют эти скелеты, не выглядят пострадавшими от времени, их лезвия остры как бритвы. Вероятно, всё это ежедневно чистится кем-то из работников Мортуария.

Скелеты получают меньший урон от рубящего и колющего оружия. Дробящее оружие, такое как дубины и молоты, наносит им нормальные повреждения.~
@3533  = ~«Пыльные» — это те, кто следит за Мортуарием, огромным моргом, наполненным трупами. Представители этой фракции довольно угрюмы, редко проявляют интерес к чему бы то ни было. Их интересует только ухаживание за телами, которые привозят в Мортуарий, каталогизирование трупов, подготовка к похоронам, а затем сами похороны… где-нибудь.~
@3534  = ~Этот почтенный писарь выглядит очень старым… его кожа морщинистая и желтоватая, как старый пергамент. Мёртвые угольно-серые глаза смотрят с костлявого лица… нечеловеческого лица с заострёнными к кончикам ушами. Большая белая борода ниспадает по его чёрным одеждам, как водопад. Время от времени он кашляет. Книга, над которой он работает, огромна и явно содержит множество имён.~
@3535  = ~Это призрачное видение — загадка для тебя. Это дух невероятно красивой молодой женщины в длинном белом платье. Она кажется расстроенной, а в её глазах сияет странный свет, который вызывает у тебя тревожные чувства. Ты представления не имеешь, какая одержимость заставляет это создание цепляться за нежизнь, но желаешь знать, не имеет ли это какое-либо отношение к твоему состоянию.~
@3536  = ~Zombie Male Battle Cry 1 (Approach 1)~ [ZOMBW01]
@3537  = ~Giant Armored Skeleton Battle Cry 2 (Approach 2)~ [ARMSK02]
@3538  = ~Giant Armored Skeleton Damage 1~ [ARMSK06]
@3539  = ~Giant Armored Skeleton Damage 2~ [ARMSK07]
@3540  = ~Giant Armored Skeleton Death~ [ARMSK08]
@3541  = ~Cornugon Battle Cry 1 (Approach 1)~ [CORNU01]
@3542  = ~Zombie Male Battle Cry 2 (Approach 2)~ [ZOMBW02]
@3543  = ~Zombie Female Battle Cry 1 (Approach 1)~ [ZOMBF01]
@3544  = ~Zombie Female Battle Cry 2 (Approach 2)~ [ZOMBF02]
@3545  = ~Cranium Rat Battle Cry 2 (Approach 2)~ [CRRAT02]
@3546  = ~Cranium Rat Damage 1~ [CRRAT06]
@3547  = ~Zombie Female Damage 1~ [ZOMBF06]
@3548  = ~Zombie Female Damage 2~ [ZOMBF07]
@3549  = ~Zombie Female Death~ [ZOMBF08]
@3550  = ~Уйти.~
@3551  = ~«Силы небесные! Разве я не сказал те поговорить с Гнилым Уильямом? Вот тупой пень. Клинки Тёмной Аллеи! В АТАКУ!»~
@3552  = ~Бежать.~
@3553  = ~Атаковать.~
@3554  = ~«Ты убрал этого мстителя? Хорошо. Он правда путался у нас под ногами. Поговори с Уильямом — у него кой-чего для тя есть».~
@3555  = ~Уйти.~
@3556  = ~«Хватит болтать со мной, иди избавься от этого вонючки-мстителя! Наши жизни в опасности, придурок!»~
@3557  = ~Уйти.~
@3558  = ~«Я знал, что эта самодовольная сучка рано или поздно доиграется. Иди поговори с Гнилым Уильямом. Ему есть чего те сказать».~
@3559  = ~Уйти.~
@3560  = ~«Почему б вместо пустой траты времени не пойти убить наконец?»~
@3561  = ~Уйти.~
@3562  = ~«Ты! Умри! Клинки Тёмной Аллеи! В АТАКУ!»~
@3563  = ~Атаковать.~
@3564  = ~Бежать.~
@3565  = ~«Не слыхал, что я сказал? Не болтай со мной. Поговори с Кристалл. Поговори с Кристалл. Поговори с Кристалл. Усёк?»~
@3566  = ~Уйти.~
@3567  = ~«Эй, дружище… спасибо, что позаботился об этой сволочи. Уверен, скажу за всех: мы это заценили. Уж Кристалл-то точно».~
@3568  = ~Уйти.~
@3569  = ~«Правда здорово, что ты поможешь нам с этим мстителем. Удачи!»~
@3570  = ~Уйти.~
@3571  = ~«Это прогонит Клинков Тёмной Аллеи прочь! Теперь аллея наша!»~
@3572  = ~Уйти.~
@3573  = ~«Преподай урок этим Клинкам Тёмной Аллеи!»~
@3574  = ~Уйти.~
@3575  = ~«Ты посмел здесь показываться? Умри, злодей!»~
@3576  = ~Уйти.~
@3577  = ~«Эй! Свежее мясо! Вот что я тебе скажу, мясо: давай сюда все свои деньги, или я возьму твою душу».~
@3578  = ~«Вот все мои деньги. Не причиняй мне зла».~
@3579  = ~«У тебе есть ещё деньги? Давай сюда».~
@3580  = ~«Не в этот раз. Попробуй-ка забрать их с моего трупа».~
@3581  = ~«Давай».~
@3582  = ~Фелл — это падший дабус, бывший слуга Госпожи Боли и один из немногих оставшихся священников Аоскара, мёртвого бога порталов. Фелл получил некоторую известность в качестве татуировщика, каким-то образом вдыхая в свои произведения жизнь. Просто вернись к нему с историей об очередном приключении, и он вытатуирует её у тебя на коже, позволив черпать из неё силы.~
@3583  = ~Падшая Грейс — суккуб, одна из танар'ри, существ, буквально слепленных из чистого хаоса и зла. Её тело и разум — великолепные образцы для искушения мужчин любой расы и возраста. Она — хозяйка Борделя Безумной Интеллектуальной Страсти.~
@3584  = ~Каким-то образом этот дрон достиг способности ощущать и сверг модрона с поста хозяина подземелья. Прежде чем он смог замыслить что-нибудь серьёзное, сработала охранная система куба и ввела дрона в статичное парализованное состояние. А ты снова включил его. Ну и молодец.~
@3585  = ~Эбб Скрипучие Колени — старый член Гармониума, которого вполне устраивает сидеть на своём стуле в баре «Горящий труп» и болтать с любым, кто не прочь его послушать. Эбб — кладезь информации, если ты, конечно, сможешь пробраться сквозь дебри его многословных объяснений.~
@3586  = ~Дак'кон — гитцерай, один из представителей молчаливого народа Лимбо. Его кожа жёлтая и покрыта морщинами; он стар, и боль живёт в его маленьких чёрных глазах. От носит с собой клинок из странного металла.~
@3587  = ~Лёгкие дроны не представляют серьёзной опасности — они были созданы, чтобы установить границу вторжения для «любопытных приключенцев». Но в общем, они мелкие и раздражающие.~
@3588  = ~Корнугоны — одни из самых высокопоставленных баатезу во всём Бааторе. Они пробились из рядов своих товарищей благодаря бесчисленным предательствам, самопожертвованиям, обманам и всем видам пороков. Из-за своих огромных крыльев, груды мышц и небольших рогов на головах корнугоны похожи на тупых существ и часто пользуются этим в своих интересах. Но на самом деле они очень высокоинтеллектуальные создания. Никто не скажет наверняка, как глубоко могут зайти их хитроумные интриги.~
@3589  = ~Поодиночке черепокрысы немногим отличаются от обычных помоечных крыс, разве только слегка выпирающими из их черепов пульсирующими мозгами. Но стоит собраться группой — и они становятся существенно опаснее. Близость с другими черепокрысами создаёт коллективный разум, делая их умнее с каждой новой присоединившейся особью. Интеллект большой стаи черепокрыс может возрастать до божественного: они получают возможность пользоваться заклинаниями и устрашающими ментальными способностями. Только убив большую часть крыс поодиночке, можно ослабить их общий разум. Лучше вообще избегать больших стай, если это возможно.~
@3590  = ~Эти конструкты — могущественные создания, населяющие лабиринт модронов. Они существуют в двух вариантах: одни мощнее, другие слабее. Оба вида более мощные, чем лёгкие дроны, и оба достаточно опасны. Так что при их появлении лучше быть настороже.~
@3591  = ~Дабусы — это слуги Госпожи Боли, загадочной правительницы Сигила. Они парят над землёй и говорят ребусами — символами, выстраивающимися в последовательности, которые образуют слова и предложения. Дабусы могут разрушать стены и создавать улицы по молчаливому приказу Госпожи. Что-то в этих существах кажется тебе неправильным.~
@3592  = ~Эти горожане злы и подозрительны; покрывающие их одежду защитные лезвия отражают преграду вокруг их сердец. Внешний вид полностью отражает их сущность.~
@3593  = ~Правоохранительные органы Керста жестоки и часто несправедливы. Они — лишь пешки в твёрдой руке местного главы Товуса Гильяфа для поддержания нищенского положения жителей города и устранения неугодных.~
@3594  = ~Нет известных существ~
@3595  = ~Вам ещё предстоит встретиться с выдающимися представителями существ этой категории.~
@3596  = ~Сборщики — это жалкие отбросы общества, каста отверженных в Улье. Они объединяются в попытках изображать какое-то подобие жизни, собирая мёртвых на улицах Улья и оттаскивая тела в Мортуарий, где за трупы Пыльные заплатят им жалкие крохи. Знаешь, они подберут и твоё тело при случае…~
@3597  = ~Эти монстры, кажется, родом с плана-тюрьмы Карцери. Их огромные бивни наносят болезненные рваные раны тем, кому не посчастливилось стоять у них на пути, а природная броня защищает от атак тупым оружием. Похоже, у них не очень развит интеллект, но его недостаток они восполняют своей невероятной физической силой. От этого не легче.~
@3598  = ~Анна — тифлинг, нахальная девчонка на грани женственности. Её хвост резко ходит из стороны в сторону, когда она в гневе. Анна — ловкая и осмотрительная беспризорница, а Улей ей как дом родной.~
@3599  = ~Адвокат — это тот, кто посвящает себя изучению законов Сигила, ища смысл в запутанной структуре законов, существующих в городе. Они могут представлять частных лиц в делах по наследствам (также называемых «завещаниями»), а также выполнять другие гражданские обязанности.~
@3600  = ~Абишаи — это одна из низших форм баатезу, расы законопослушных извергов, стремящихся установить жестокую тиранию на планах зла. Красные абишаи — это высшие абишаи, стоящие в иерархии выше зелёных и чёрных. Они — пехота и стрелки в Кровавой Войне. Абишаи злобны и, в сравнении с другими расами баатезу, не слишком умны. Красный абишай — это последний шаг перед продвижением к высшей форме баатезу.~
@3601  = ~Абишаи — это одна из низших форм баатезу, расы законопослушных извергов, стремящихся установить жестокую тиранию на планах зла. Зелёные абишаи — вторые по значимости абишаи, стоящие в иерархии выше чёрных и ниже красных. Они — пехота и стрелки в Кровавой Войне. Абишаи злобны и, в сравнении с другими расами баатезу, не слишком умны.~
@3602  = ~Абишаи — это одна из низших форм баатезу, расы законопослушных извергов, стремящихся установить жестокую тиранию на планах зла. Чёрные абишаи — это низшие абишаи, стоящие в иерархии ниже зелёных и красных. Они — пехота и стрелки в Кровавой Войне. Абишаи злобны и, в сравнении с другими расами баатезу, не слишком умны.~
@3603  = ~Фарод Червеголовый — это Король Сборщиков Улья, физически и морально искалеченная личность. Однако его ум, похоже, остр как никогда. Он держит Похороненную деревню в железном кулаке, подчиняя даже неорганизованную толпу. Фарод — хитрый проныра и вор и, кажется, очень многое знает о тебе, хоть и не спешит поделиться без… уговоров.~
@3604  = ~Находясь немного выше лемуров в пищевой цепочке баатезу, напперибо практически лишены разума. Они — куски мяса, в которых содержится чистейшее зло и порядок. Под жестокими хлыстами своих начальников они могут сформировать боевую волну, которая без усилий поглотит врага. К тому же напперибо можно нанести вред только магическим или освящённым оружием.~
@3605  = ~Этот модрон, кажется, немного отличается от тех, что тебе уже доводилось видеть. В своих четырёх руках он держит пару арбалетов и, кажется, серьёзно заинтересован твоим поведением.~
@3606  = ~Воплощения совершенного порядка, модроны родом из Плана-Механизма Высшего Закона — Механуса. Они придерживаются строгой кастовой системы, системы настолько совершенной, что модроны не могут понимать касты, которые не примыкают непосредственно к их собственной. Их унифицированный разум настолько совершенен, что они не воспринимают самих себя как индивидуальность. У них нет стремлений, эмоций; модроны существуют только для выполнения приказов своих начальников.

Разумеется, в любой системе есть недостатки. Модрон может повысить индивидуальность и стать бродягой. Но ты понятия не имеешь, как такое может произойти.~
@3607  = ~Одна из самых устрашающих фракций Сигила, Убийцы Милосердия — или Красная Смерть — безжалостны в своём стремлении к справедливости. Они верят, что без справедливости правды быть не может, а себя они назначили стражами и палачами истинной справедливости в мультивселенной. Их единственные оправдывающие качества — что они одинаковы в своей справедливости ко всему, даже к самим себе, и не насаждают несправедливых законов. Их фанатичная преданность нервирует, но может быть использована и против них самих.~
@3608  = ~Лотар, повелитель Костей Ночи, держит в своём салоне полные полки черепов. Они рассказывают давно забытые секреты, их шёпот заполняет *его* череп тайным знанием. Очень может быть, что он один из немногих в мироздании, кто может тебя уничтожить по-настоящему. Народ Сигила говорит о нём почтительно, шёпотом и всеми силами избегает обижать его даже на словах.~
@3609  = ~Лемуры — это воплощённые духи истинного зла, самая младшая из орд законопослушно-злых баатезу. Они используются как пушечное мясо в Кровавой Войне и не особо разумны. Чтобы нанести им повреждения, необходимо магическое или освящённое оружие. Похоже, их студенистая плоть затягивается после любых ран, которые им наносят.~
@3610  = ~Госпожа — это загадка. Повсеместно она считается фактическим правителем Сигила, его защитником и его жертвой. Говорят, она охраняет двери Клетки от многочисленных происков богов и является основным выражением баланса в мультивселенной, одновременно будучи пленницей Города Дверей. О ней ходят тысячи легенд, одна из которых даже утверждает, что Госпожа — это шесть гигантских белок в головном уборе, в мантии и с кольцом левитации и иллюзий, но правду не знает никто. Госпожа Боли — истинная загадка, головоломка без решения.

Если кто-то вызывает её недовольство — нарушая равновесие города или поклоняясь ей — Госпожа может наказать нарушителя. Её наказания варьируются от лабиринта — перекрученного ада с хорошо замаскированным выходом, до отбрасывания на обидчика тени, которая наносит ему смертельные раны острыми краями и оставляет за собой только лужу крови и кучу внутренностей. Ни один из упомянутых вариантов не является привлекательным.~
@3611  = ~Эти безобидные насекомые не кажутся чем-то намного большим гигантских блох. Однако они поддаются дрессировке и считаются верными своим хозяевам. Хотя следовало бы выяснить, насколько простирается их верность.~
@3612  = ~Эти существа, похожие на птиц, являются довольно способными созданиями, которые держаться вместе на Внешних Землях. Они вполне дружелюбны, но что будет, если они разозлятся, — это уже совсем другой вопрос. Интересно, каковы они на вкус?~
@3613  = ~Горящий человек парит в воздухе над решёткой в баре «Горящий труп». Его кожа пузырится и тлеет, языки пламени вырываются из страдающих глаз, но выражение лица у него отсутствующее, как будто он почти наслаждается огненной купелью.~
@3614  = ~Первое, что предупреждает о появлении соумьенов, — грохот их копыт. Четвероногие существа из чистого зла, соумьены имеют тело лошади и головы из ночных кошмаров. Утыканные шипами плечи соумьенов придают им ещё более угрожающий вид. По-видимому, они передвигаются хищными стадами.~
@3615  = ~Гронк — это большое туповатое существо, по-глупому агрессивное. Они довольно миролюбивы, если только не вторгаются на их территорию. Но проблема как раз в том, что если ты их увидел, то, скорее всего, ты уже вторгся на их территорию. Битвы с ними лучше избегать. Похоже, у них иммунитет к тупому оружию.~
@3616  = ~Представители стада этих животных довольно трусливы по одиночке, предпочитая охотится только рядом со своими вожаками. Они атакуют задними ногами, рубя своих врагов острыми как бритва когтями. Похоже, у гриллигов иммунитет к острому оружию…~
@3617  = ~Охранники Боготов очень преданны своей работе. Также их очень интересует всё, что происходит в Кузнице.~
@3618  = ~Боготы — ещё одна фракция Сигила. Они также известны как «Верующие в Источник». Боготы верят, что каждое существо носит в себе частицу божественного, что всё в жизни — это испытание и что каждый шаг — это урок. Безграничный оптимизм Боготов делает их очень популярными. Их резиденция находится в Великой Кузнице в Нижнем районе, а славятся они изготовлением лучших на планах изделий из металлов.~
@3619  = ~Из всех танар'ри — демонических извергов, заселяющих Бездну хаосом и злом, — немногие столь же коварны, как собакоподобные глабрезу. Это избранные искусители умов смертных, предлагающие власть и знания за пределами познаваемого. Конечно, знания эти даются за определённую цену. Помимо того, глабрезу — жестокие воины, одни из самых опасных, каких ты только встречал. С ними нельзя без осторожности, и в теле, и в уме.~
@3620  = ~Гитцерай — это давно отделившиеся родственники гитиянки. Там, где их бывшие сородичи жестоки и беспощадны, гитцерай спокойны и сдержаны. Они горят страстью, которая ведёт их гораздо дальше, чем кого бы то ни было из смертных. Гитцерай живут на Лимбо, в вечно движущихся морях Хаоса, делая свои крепости неприступными для атак коренных обитателей этого плана. Гитцерай говорят метафорами и легендами, а держат себя со спокойным благородством.~
@3621  = ~Акаста — королева упырей Мёртвых Народов, прислуживающая пожирательница плоти, которая объединяет свою стаю в страхе перед Безмолвным Королём и превосходящей толпой. Она сильна, вынослива и, несмотря на внешний вид, умна. Она из тех, кого явно следует опасаться.~
@3622  = ~Упырь мужского пола, описание каменного голема.~
@3623  = ~Ходячие мертвецы встречаются разных форм и размеров. Конкретно эта форма и размер принадлежит пожирателю падали — существу, которое поддерживает своё существование поеданием плоти и костей как живых, так и мёртвых. Упырь — это свирепое существо с крупицами совести и ещё меньшим интеллектом. К счастью, от них легко избавиться.~
@3624  = ~Гехрелеты — это изгнанные с планов изверги; свирепые бойцы, которые создают себя из тел мёртвых, заселяющих сферы Карцери. Их повсюду боятся и презирают — и правильно делают. Лучше держаться от них подальше, а если это невозможно, то следует убедиться, что есть оружие, способное их прогнать.~
@3625  = ~Описание железного голема.~
@3626  = ~Это вовсе не те славные земляные черви, которые вылезают из земли после сильного дождя. Эти — скользкие массивные создания, питающиеся падалью; во рту у них острые зубы, которые могут оторвать руку взрослому человеку или голову ребёнку.~
@3627  = ~Ликантропия — это болезнь, передаваемая через укус заражённого существа. Болезнь обращает несчастную жертву в «оборотня» — существо, которое наполовину человек, наполовину монстр. Существует много существ, передающих эту заразу: некоторые из них вполне благородны, другие же ужасают и повергают в трепет. Крысы не относятся ни к тем, ни к другим. Их ближайшие родственники-ликантропы — это скалкеры из мира оборотней, прячущиеся в тенях и всеми ненавидимые. Образ жизни в полной мере отражается на их личных качествах.

Мантуок, представитель Многих-как-Один, сообщества черепокрыс, — льстивый маленький ублюдок, чьи лучшие достоинства в том, чтобы подлизываться к сильнейшим. У него есть небольшой талант мага, и, кажется, он продаст даже своего хозяина, лишь бы самому продвинуться. Мантуок страстно тебя ненавидит — наверно, завидует.~
@3628  = ~Ликантропия — это болезнь, передаваемая через укус заражённого существа. Болезнь обращает несчастную жертву в «оборотня» — существо, которое наполовину человек, наполовину монстр. Существует много существ, передающих эту заразу: некоторые из них вполне благородны, другие же ужасают и повергают в трепет. Крысы не относятся ни к тем, ни к другим. Их ближайшие родственники-ликантропы — это скалкеры из мира оборотней, прячущиеся в тенях и всеми ненавидимые. Образ жизни в полной мере отражается на их личных качествах.~
@3629  = ~Этот комплект доспехов Убийц Милосердия стоял здесь в тюрьме под Керстом на протяжении многих лет. Его не беспокоили, что странно, принимая в расчёт то, как быстро люди Керста находят выгоду.~
@3630  = ~Варгуйльи, ужасные существа с Нижних планов, — это головы с крыльями без туловища. Их укусы смертельны и даже хуже: после смерти жертвы таких укусов, скорее всего, превратятся в варгуйлий. Хотя они не слишком опасны в поединке один на один, но когда их небольшая стая, то варгуйльи могут оказаться смертельно опасными неподготовленному путешественнику. Любой, кто хочет исследовать тёмные места и руины, должен всегда быть начеку.~
@3631  = ~Говорят, в лабиринте Чёрных Шипов Рейвел заточена сама легендарная ночная ведьма. Но по прошествии столетий после изгнания Рейвел из Сигила у неё была возможность изменить собственный лабиринт. Семена падают с её волос, когда она проходит сквозь лабиринт, и необычная энергия лабиринта порождает этих существ — тригитов. По существу, они наделённые сознанием деревья и, похоже, утоляют свою жажду кровью.~
@3632  = ~Трокопотаки — это большие белые крокодилообразные существа, предпочитающие сырость. Они живут в катакомбах под улицами Сигила, сражаясь с варгуйльями и Сборщиками, у которых хватает глупости забраться к ним в логово. Трокопотаки — легенда среди матерей Улья, запугивающих ими детей, и преступников, собравшихся лезть под город. Они существуют. И они опасны.~
@3633  = ~Триас — это дэв, божественное существо с Верхних планов. В первый раз тебе довелось его встретить в тюрьме Керста, заключённым в обсидиановый пузырь. Его красоту сложно перенести; аура добра исходит от него в виде волны света. Его крылья сожжены до костей, но кажется, он переносит свои мучения с гордостью.~
@3634  = ~Вообще-то ты всегда думал, что жуки — это маленькие существа, которых можно раздавить ботинком. Ты ни за что не приписал бы им обладание интеллектом. И уж конечно не представлял себе, что у них могут быть садистские наклонности. Ну, по крайней мере, до тех пор, пока не увидел трелонов. Этот шипящий жук живёт в темноте и отмечен явной склонностью к причинению боли. Вероятно, трелоны — существа Нижних планов, в них просто ощущается зло.~
@3635  = ~Описание Превосходящего.~
@3636  = ~Харгримм — скелет-священник, лидер скелетов Мёртвых Народов, который несёт слово Безмолвного Короля своим последователям. Вместе с зомби Тухлой Мэри и королевой упырей Акастой он образует триумвират, поддерживающий ненадёжное равновесие Мёртвых Народов. Смещение баланса в одну из сторон может привести к хаосу.~
@3637  = ~Описание вооружённых скелетов.~
@3638  = ~Эти тени очень похожи на другие два вида теней, которых ты уже встречал, но у этих есть смертельные когти и яростное желание твоей смерти. Опасные и поодиночке, они обычно охотятся группами, поэтому становятся смертельно опасными.~
@3639  = ~Тени-скелеты, занявшие места простых теней, которых ты видел в начале. Большие тени кажутся ещё более опасными — их вытянутые конечности завершаются ужасными когтями, и они роятся, подобно насекомым.~
@3640  = ~Эти тени — бледные женоподобные призраки, которые бесшумно поднимаются из земли. Они нападают без предупреждения и кажутся даже более кровожадными, чем обычные воители.~
@3641  = ~Все истории о Рейвел Клубок-Загадок, что ты слышал, представляли её как омерзительное чудовище, которое сожрёт твою душу. Но если она и намерена это сделать, то выбрала странный путь достижения цели — она, несомненно, обезумела, заключённая в лабиринте чёрных колючек и зла. Её можно только пожалеть: несмотря на свою огромную силу, Рейвел потеряла всё и даже не знает об этом.~
@3642  = ~Печальный жизненный факт: зачастую единственный способ выжить для женщины — продать своё тело и разум мужчинам, нуждающимся в разрядке и общении. К несчастью, это в полной мере относится к Улью, поэтому в нём так много проституток на улицах.~
@3643  = ~Алу-изверг — ребёнок танар'ри и человеческого отца. По внешнему виду они близки к суккубам. Лишь некоторые из них стараются подавить в себе зло; большинство же наоборот пытается превзойти натуру своего демонического предка в склонности к абсолютному злу и жестокости. Только глупый будет доверять танар'ри.~
@3644  = ~Ещё одна фракция Сигила — Гармониум. Их кредо: «Живи правильно». К несчастью для других, это кредо часто переводится как «Живи как мы или никак». Они стойко верят в букву закона и поэтому служат блюстителями порядка на улицах Сигила. Их красные доспехи помогают им выделиться на городских улицах.~
@3645  = ~Описание среднего боевого дрона.~
@3646  = ~Токола — это тупые и грубые гуманоиды. Их тела покрыты коричневой, практически переходящей в мех кожей, а выступающие челюсти с трудом скрывают их уродливые зубы. Токола — воины, и нет для них пущей радости, чем кровопролитие. Вероятно, лучше их не злить.~
@3647  = ~Эта отвратительная масса голов одиноко возвышается в диких пустошах Авернуса, первого уровня Баатора. Очевидно, что Колонна состоит из голов лжецов и злых магов, наказанных за расточение дара знания. Говорят, Колонна знает ответ на вопрос о твоей смертности — ценнейшую тайну, которая влекла тебя все эти долгие годы.~
@3648  = ~«Я ищу дневник».~
@3649  = ~«Просто прохожу мимо».~
@3650  = ~«Я не хочу неприятностей».~
@3651  = ~«Чёрная Роза хочет твоей смерти».~
@3652  = ~«Кристалл желает твоей смерти».~
@3653  = ~«Это не твоё дело».~
@3654  = ~«Хочешь Фарода, а? Ну, красавец, за некоторую сумму я скажу тебе, где его найти».~
@3655  = ~«Сколько?»~
@3656  = ~«Вот, держи. Где он?»~
@3657  = ~«Мне неинтересно»~
@3658  = ~«У меня столько нет».~
@3659  = ~«Мне это уже говорили!»~
@3660  = ~«Спасибо. Прощай».~
@3661  = ~Он оценивает твои возможности. «Всего-то пять медяков. Разумная цена для отчаянного типа вроде тебя».~
@3662  = ~«И что мне с того?»~
@3663  = ~«Будет сделано».~
@3664  = ~«Я не буду этого делать. Я не убийца».~
@3665  = ~«Мне хотелось бы вначале обдумать».~
@3666  = ~«Я ищу дневник».~
@3667  = ~«Просто прохожу мимо».~
@3668  = ~«Найдёшь его рядом с Площадью Мусорщиков. Ищи его и его Сборщиков, проблем быть не должно».~
@3669  = ~«Я не хочу неприятностей».~
@3670  = ~«Чёрная Роза хочет твоей смерти».~
@3671  = ~«Кристалл желает твоей смерти».~
@3672  = ~«Ага, ну тогда, мож, ещё кое-чего тебя заинтересует. Есть тут одна дура по имени Кристалл, она заправляет теми слабыми сёстрами, которых зовут Ангелы-Лезвия. Устрани её, и мы поговорим о награде».~
@3673  = ~«Это не твоё дело».~
@3674  = ~«Я просто хочу знать, что мне за это причитается».~
@3675  = ~Карине нужен друг.~
@3676  = ~«Ну, за что платил, то и получил. Так… чего тебе здесь надо?»~
@3677  = ~«Разве я не говорил, что награду обсудим только когда ты покончишь с мокрухой? Я не шутил, пень. Так ты возьмёшься или нет?»~
@3678  = ~«Замечательно! Возвращайся, когда закончишь. И уж будь уверен, что всё шито-крыто. Мне не хочется слышать нытьё, как ты не смог. Мы заключили сделку, так выполняй».~
@3679  = ~«Советую пересмотреть отношение. Не торопись, ладно? Как насчёт, скажем, двухсот монет?»~
@3680  = ~«Получишь, что заслуживаешь, пень. Пусть будет, скажем, двести монет, ладно? По рукам?»~
@3681  = ~«Как насчёт увеличить награду?»~
@3682  = ~«Да, по рукам».~
@3683  = ~«Три сотни. Последнее предложение».~
@3684  = ~«Если ты так хошь — будет по-плохому. Жаль, что не захотелось по-хорошему, — он повышает голос. — Клинки! Избавьтесь от этой падали!»~
@3685  = ~«Дневник, говоришь? Не журнал? Не книга учёта? Именно дневник? — он замолкает на минуту, а затем, когда ты уже собираешься ответить, говорит. — Как будто он не пошёл бы на растопку, если попал бы сюда. Не, не видел. Чего ещё надо?»~
@3686  = ~«Просто проходишь мимо, ага? Какая жалость. Никто не проходит здесь без оплаты».~
@3687  = ~Он смеётся и поднимает руку: «Не так быстро, приятель. Это не та плата, о которой я говорил. Кое-что совсем другое. Видишь ли, здесь одна дура рулит соперничающей с нами бандой на другой стороне аллеи, мне бы хотелось, чтоб ты прописал её в книгу мёртвых… кровью. Её зовут Кристалл».~
@3688  = ~«Небольшой кровавый взнос. Тебе повезло, что кровь не твоя. Кровь другого — одной дуры по имени Кристалл, которая набралась наглости и пытается умыкнуть кусок моей территории. Я хочу, чтоб ты её нашёл и устранил… убей её».~
@3689  = ~Я встретился со словоохотливой женщиной по имени Карина. Она сказала мне, что ей одиноко, так как люди её избегают. Может, я смогу ей помочь.~
@3690  = ~«Нет. Я не убийца».~
@3691  = ~Я встретился со стражником Гармониума по имени Корвус. Ему приглянулась Карина, и я сказал ему, что она как раз ищет друга. Думаю, вместе они будут счастливы.~
@3692  = ~«Конечно. Будет сделано».~
@3693  = ~«Не беспокойся».~
@3694  = ~«Как насчёт четырёх сотен?»~
@3695  = ~«Нет. Я не буду этого делать».~
@3696  = ~«Будет сделано».~
@3697  = ~«Нет. Я не буду этого делать».~
@3698  = ~«А, так тебе повезло, что я не хочу тебе зла. Мне просто нужно, чтоб ты оказал мне небольшую услугу. Послушаешь?»~
@3699  = ~«Нет. Я не буду этого делать».~
@3700  = ~«По рукам. Считай, она уже труп».~
@3701  = ~Драться.~
@3702  = ~Бежать.~
@3703  = ~«Я ищу Фарода».~
@3704  = ~«Просто прохожу мимо».~
@3705  = ~«Я не хочу неприятностей».~
@3706  = ~«Чёрная Роза хочет твоей смерти».~
@3707  = ~«Кристалл желает твоей смерти».~
@3708  = ~«Это не твоё дело».~
@3709  = ~«Я уже заплатил».~
@3710  = ~Блеф: «Я уже заплатил».~
@3711  = ~«Какова цена?»~
@3712  = ~«Хотелось бы мне иметь что заплатить».~
@3713  = ~«А что мне с того?»~
@3714  = ~«Будет сделано».~
@3715  = ~«Я не буду этого делать. Я не убийца».~
@3716  = ~«Мне хотелось бы вначале обдумать».~
@3717  = ~«А что мне с того?»~
@3718  = ~«Сколько?»~
@3719  = ~«Боюсь, мне неинтересно».~
@3720  = ~«Будет сделано».~
@3721  = ~«Я не буду этого делать. Я не убийца».~
@3722  = ~«Мне хотелось бы вначале обдумать».~
@3723  = ~«Что за услуга?»~
@3724  = ~«Да».~
@3725  = ~«Ага. И ты намерен выполнить заказ?»~
@3726  = ~«Я не уверен».~
@3727  = ~Драться.~
@3728  = ~«Я Чёрная Роза. Я охотник и голод. Я кара. Провозгласи свои убеждения».~
@3729  = ~Понятно. Ну, спасибо.~
@3730  = ~«Я жду. Иди. Сейчас же».~
@3731  = ~«Ответов нет. Есть только действия. Иди».~
@3732  = ~«Есть такая женщина по имени Кристалл. Она лидер Ангелов-Лезвий. Она хочет сделать эту аллею *светлее* и превратить её в блестящий пример достижений добра. Убей её и будешь вознаграждён. Потерпишь неудачу — и за тобой будут охотиться до конца твоих дней».~
@3733  = ~Его глаза вспыхивают, затем смягчаются. Голос звучит с придыханием: «Нейтральный. Союзник. Ты знаешь, что такое равновесие. Помоги мне. Я уничтожаю впавших в крайности».~
@3734  = ~«Я охочусь за Ангелами-Лезвий и Клинками Тёмной Аллеи. Выбери одного из главарей и приговори его».~
@3735  = ~Его глаза зло сужаются, и он шепчет: «Тогда ты враг». Почти неразличимый в своих стремительных движениях, он атакует!~
@3736  = ~«Тогда будем следовать нашей философии. Состязание с оружием. Выигравший будет подлинным победителем в нашей борьбе за истину».~
@3737  = ~Его глаза расширяются: «Ты вечный. Твоя истина вечна. Приветствую тебя. Это для меня честь. Прощай».~
@3738  = ~«Ты убил Гнилого Уильяма?»~
@3739  = ~Это первый узел.~
@3740  = ~Ух-ты, первый узел. Что ты можешь мне сказать о нём?~
@3741  = ~Наплевать мне на этот узел.~
@3742  = ~Этот первый узел очень прикольный, часто первый в диалогах.~
@3743  = ~Как ты груб!~
@3744  = ~«Это ведь одна из студий Фелла, не так ли? Я давно хотела с ним встретиться».~
@3745  = ~«Работай *быстрее*. Иди уже. Я жду», — он скрещивает руки.~
@3746  = ~«Твоё следующее задание — убить Кристалл, лидера Ангелов-Лезвий. Равновесие требует её смерти».~
@3747  = ~«Ты убил Кристалл?»~
@3748  = ~«Твоё следующее задание — убить Гнилого Уильяма, лидера Клинков Тёмной Аллеи. Равновесие требует этого от тебя».~
@3749  = ~«Я предпочитаю помогать тем, кто несчастнее меня. Я выбираю добро».~
@3750  = ~«Идеи добра существуют для слабых. Я выбираю зло».~
@3751  = ~«Ни то ни другое. Крайности опасны».~
@3752  = ~«Кто ты?»~
@3753  = ~«Хорошо. Я это сделаю».~
@3754  = ~«Я не буду этого делать. Я не убиваю людей».~
@3755  = ~Драться.~
@3756  = ~Бежать.~
@3757  = ~«Я предпочитаю помогать тем, кто несчастнее меня. Я выбираю добро».~
@3758  = ~«Идеи добра существуют для слабых. Я выбираю зло».~
@3759  = ~«Ни то ни другое. Крайности опасны».~
@3760  = ~«Сначала я бы задал пару вопросов…»~
@3761  = ~Ловкость ниже среднего.~
@3762  = ~«Уже иду».~
@3763  = ~«Хорошо».~
@3764  = ~«Я это сделаю».~
@3765  = ~«Я так не думаю».~
@3766  = ~Драться.~
@3767  = ~Бежать.~
@3768  = ~«Что я могу сделать?»~
@3769  = ~«Не думаю, что хочу тебе помогать».~
@3770  = ~«Я займусь Ангелами-Лезвий».~
@3771  = ~«Я займусь Клинками Тёмной Аллеи».~
@3772  = ~«Гнилой Уильям, главарь Клинков Тёмной Аллеи, уже мёртв. Я убью Кристалл».~
@3773  = ~«Кристалл, лидер Ангелов-Лезвий, уже мертва. Я убью Гнилого Уильяма».~
@3774  = ~«Они оба уже мертвы».~
@3775  = ~«Не думаю, что хочу тебе помогать».~
@3776  = ~Драться.~
@3777  = ~Бежать.~
@3778  = ~«Как пожелаешь, но я не могу умереть. Ты проиграешь».~
@3779  = ~«Ты что, правда сумасшедший?»~
@3780  = ~Драться.~
@3781  = ~«Прощай».~
@3782  = ~«Нет ещё, и не собираюсь».~
@3783  = ~«Нет. Я над этим работаю».~
@3784  = ~«Да».~
@3785  = ~«Да».~
@3786  = ~«Хорошо».~
@3787  = ~«Я не буду этого делать».~
@3788  = ~«Я вернусь».~
@3789  = ~Фракция: Свободная Лига («Индепы»)

Девиз: мы индивидуалисты, собравшиеся вместе для защиты от других фракций. «Истины» же нет — просто живи свободным или умри.~
@3790  = ~«Нет ещё. И не собираюсь».~
@3791  = ~«Нет. Я над этим работаю».~
@3792  = ~«Да».~
@3793  = ~«Да».~
@3794  = ~«Я не буду этого делать».~
@3795  = ~«Я вернусь».~
@3796  = ~«Так ты избавился от этой ведьмы Кристалл, ага? Думаешь, тебе щас типа платить не надо? Жаль, но так и есть. Проходи».~
@3797  = ~«Спасибо. Прощай».~
@3798  = ~«Привет, незнакомец. Ты типа щас на территории Клинков Тёмной Аллеи. Похоже, твой кошелёк стоит чуток облегчить. Молись, чтоб нам хватило».~
@3799  = ~«Мне нужно поговорить с вашим лидером».~
@3800  = ~«Сколько тебе надо?»~
@3801  = ~«Значит, будешь слышать от меня просьбу всякий раз, когда мы будем разговаривать. Это необходимо сделать».~
@3802  = ~«Ну как, попытки записать Гнилого Уильяма в книгу мёртвых увенчались успехом?»~
@3803  = ~«А я сказала, что буду продолжать просить, пока ты не согласишься».~
@3804  = ~«Тогда почему ты говоришь со мной? Эту работу необходимо выполнить!» — она отворачивается.~
@3805  = ~«Кончено? Гнилого Уильяма больше нет? Благодарю, путешественник, тебе больше никогда не придётся платить за проход по аллее Опасных Углов. У меня есть к тебе ещё одна просьба».~
@3806  = ~«Есть такой опасный убийца, одинокий волк, имя которого „Чёрная Роза“. Он охотится на моих людей. Я прошу тебя его остановить».~
@3807  = ~«Медяки. Деньги. И немалые. Ты заинтересован?»~
@3808  = ~«Тогда найди Чёрную Розу на этой аллее и пропиши его в книгу мёртвых. Когда он будет мёртв, возвращайся, и я вознагражу тебя».~
@3809  = ~Она улыбается: «Как ты, наверное, понимаешь, я буду продолжать просить тебя, пока ты не согласишься. До скорого свидания».~
@3810  = ~«Ты нашёл Чёрную Розу и удалил эту опухоль с аллеи?»~
@3811  = ~Найти долговую расписку Трист.~
@3812  = ~Она протягивает тебе большой залатанный кошель: «Прими мои благодарности и благодарности Ангелов-Лезвий. Мы расстаёмся друзьями и будем помнить тебя».~
@3813  = ~Трист должна быть продана в рабство, так как не может доказать, что выплатила долг Байрону Пикиту. Я согласился попробовать найти долговую расписку, чтобы освободить её.~
@3814  = ~«Привет, друг. Снова благодарю. Считай, что аллея — какой бы ни была она скромной — теперь твой дом. Прощай».~
@3815  = ~Я нашёл долговую расписку Трист. Теперь она свободна.~
@3816  = ~«Пожалуйста, не оставляй попыток. Он истребляет моих людей».~
@3817  = ~~
@3818  = ~«Расскажи мне о себе».~
@3819  = ~«Расскажи мне об Ангелах-Лезвиях».~
@3820  = ~«Расскажи мне об аллее».~
@3821  = ~«Я ищу Фарода».~
@3822  = ~«Я ищу дневник».~
@3823  = ~«Чёрная Роза хочет твоей смерти. Я здесь, чтобы убить тебя».~
@3824  = ~«Гнилой Уильям хочет твоей смерти. Я здесь, чтобы убить тебя».~
@3825  = ~«Ничего».~
@3826  = ~«Расскажи мне о себе».~
@3827  = ~«Расскажи мне об Ангелах-Лезвиях».~
@3828  = ~«Расскажи мне об аллее».~
@3829  = ~«Я ищу Фарода».~
@3830  = ~«Я ищу дневник».~
@3831  = ~«Чёрная Роза хочет твоей смерти. Я здесь, чтобы убить тебя».~
@3832  = ~«Ничего».~
@3833  = ~«Похоже на прибыльное местечко».~
@3834  = ~«Спасибо за информацию. Прощай».~
@3835  = ~«Включая тебя?»~
@3836  = ~«Ясно. Ладно, мне надо идти. Прощай».~
@3837  = ~«Не видела где-нибудь здесь дневник?»~
@3838  = ~Получить улики, что Байрон Пикит преступник.~
@3839  = ~«Спасибо. Прощай».~
@3840  = ~У вора Ленни есть доказательства, что Байрон Пикит преступник. Они находятся на складе. Мне нужно пойти туда и получить их.~
@3841  = ~«Ладно. Не знаешь, где мне найти мужчину по имени Фарод?»~
@3842  = ~Я предъявил Корвусу, стражнику Гармониума, улики, что Байрон Пикит — преступник. Корвус арестовал его и обещал проследить, чтобы правосудие свершилось.~
@3843  = ~«Благодарю. Прощай».~
@3844  = ~«Расскажи мне о своей банде».~
@3845  = ~«Похоже на выгодное предложение. По рукам».~
@3846  = ~«Я не убийца».~
@3847  = ~«Как скажешь. Прощай».~
@3848  = ~«Не исключено. Прощай».~
@3849  = ~Убить абишая Гросука по просьбе Себастьяна.~
@3850  = ~Маг Себастьян хочет, чтобы я убил абишая Гросука. Если я сделаю это, то он поможет мне с моими шрамами.~
@3851  = ~«Прощай».~
@3852  = ~Я убил абишая Гросука по просьбе Себастьяна. Он был благодарен и помог мне с моими шрамами.~
@3853  = ~Я согласился убить Гнилого Уильяма.~
@3854  = ~«Забудь. Я этого делать не буду».~
@3855  = ~«Тогда я сделаю это».~
@3856  = ~«Я убью его».~
@3857  = ~«Похоже, его подход мне ближе. Прощай».~
@3858  = ~«Я этого делать не буду».~
@3859  = ~«Полагаю, тогда мне лучше выполнить твою просьбу».~
@3860  = ~«И всё же вынужден отказать. Прощай».~
@3861  = ~Корнугон, повреждения 1~ [CORNU06]
@3862  = ~Зомби-мужчина, повреждения1~ [ZOMBW06]
@3863  = ~Зомби-мужчина, повреждения2~ [ZOMBW07]
@3864  = ~Зомби-мужчина, смерть~ [ZOMBW08]
@3865  = ~Скелет-рабочий, боевой крик 2 (Подход 2)~ [SKELW02]
@3866  = ~Скелет-рабочий повреждения 1~ [SKELW06]
@3867  = ~Скелет-рабочий повреждения 2~ [SKELW07]
@3868  = ~Скелет-рабочий, смерть~ [SKELW08]
@3869  = ~[нет текста]~
@3870  = ~«Эй! Эй! Что ты делаешь?»~
@3871  = ~«Я *собираюсь* поговорить с этим парнем. Какие-то проблемы?»~
@3872  = ~«Ничего, пошли».~
@3873  = ~«Если собираешься чесать языком с Пыльными, избавь меня от этого. Я и они не лучшие приятели… и тебе не стоит якшаться с ними. Они скорее спалят тебя или похоронят, чем будут слушать. Не будь идиотом, давай валить отсюда».~
@3874  = ~«Спасибо за совет, но я *всё же* собираюсь поговорить с этим парнем».~
@3875  = ~«Договорились, пошли».~
@3876  = ~«Эй! Ты что, оглох? Что ты делаешь?»~
@3877  = ~«Знаешь, я собираюсь поговорить с этим парнем. Есть проблемы?»~
@3878  = ~«Ничего, пошли».~
@3879  = ~«Тогда *не слушай* меня — это твои похороны».~
@3880  = ~«Ага, можешь заказывать панихиду. А сейчас помолчи».~
@3881  = ~«Ты прав. Забудь. Пошли».~
@3882  = ~Оставить тело, идти дальше.~
@3883  = ~Ты недостаточно быстр, и Пыльный уворачивается, когда ты нападаешь. Отступая назад, он трижды звонко хлопает в ладоши. В ответ в Мортуарии начинает звонить большой железный колокол.~
@3884  = ~«Ну и ладно…»~
@3885  = ~Сломать ему шею, прежде чем он закричит.~
@3886  = ~«Тогда зови их. Я бы хотел с ними встретиться».~
@3887  = ~Сломать ему шею, прежде чем он закричит.~
@3888  = ~«Тогда зови их. Я бы хотел с ними встретиться».~
@3889  = ~Ты наклоняешься, чтобы «прошептать» ему, Пыльный тоже наклоняется. Как только его голова оказывается в зоне захвата, твои руки смыкаются на висках и ты резко поворачиваешь его голову влево.~
@3890  = ~«Я не могу позволить тебе поднять тревогу…»~
@3891  = ~Пыльный выглядит настороженным. Похоже, он собирается что-то сказать, затем слегка трясёт головой и возвращается к своим делам.~
@3892  = ~Уйти.~
@3893  = ~Пыльная внимательно тебя изучает: «Ты не один из нас, не так ли? Что ты здесь делаешь? Ты из Анархистов? Или шпион другой фракции? Это может заинтересовать стражу…»~
@3894  = ~Пыльный кивает, затем возвращается к своим делам.~
@3895  = ~Уйти.~
@3896  = ~Пыльный хмурится: «Это имя мне незнакомо».~
@3897  = ~Пыльный по-прежнему хмурится, но слегка кивает: «Ладно. Чем могу быть полезен, посвящённый?»~
@3898  = ~«Я новопосвящённый. Прости моё невежество».~
@3899  = ~«Я… новичок здесь. Пытаюсь… сориентироваться».~
@3900  = ~«Да ладно, э-э… что в имени? Храни веру, посвящённый».~
@3901  = ~«Если ты не можешь мне помочь, тогда я найду кого-нибудь, кто сможет. Прощай».~
@3902  = ~«У меня кое-какие вопросы…»~
@3903  = ~«Сегодня ничем. Прощай».~
@3904  = ~«Моё имя тебя не касается. Я должен идти. Прощай».~
@3905  = ~«Моё имя тебя не касается. Я должен идти. Прощай».~
@3906  = ~Ложь: «Звать… э-э, Адан».~
@3907  = ~«Моё имя тебя не касается. Я должен идти. Прощай».~
@3908  = ~«Моё имя тебя не касается. Я должен идти. Прощай».~
@3909  = ~«Я… здесь новичок. Пытаюсь… сориентироваться».~
@3910  = ~«Да ладно, э-э… что в имени? Храни веру, посвящённый».~
@3911  = ~«Если ты не можешь мне помочь, тогда я найду кого-нибудь, кто сможет. Прощай».~
@3912  = ~«Да ладно, э-э… что в имени? Храни веру, посвящённый».~
@3913  = ~«Если ты не можешь мне помочь, тогда я найду кого-нибудь, кто сможет. Прощай».~
@3914  = ~Сломать ему шею, прежде чем он закричит.~
@3915  = ~Сломать ему шею, прежде чем он закричит.~
@3916  = ~«Нет-нет… хочу сказать, я не шпион… видишь ли, я очнулся на одной из плит… и…»~
@3917  = ~Быстро уйти.~
@3918  = ~«Я… здесь новичок. Пытаюсь… сориентироваться».~
@3919  = ~«Да ладно, э-э… что в имени? Храни веру, посвящённый».~
@3920  = ~«Если ты не можешь мне помочь, тогда я найду кого-нибудь, кто сможет. Прощай».~
@3921  = ~«Я слыхал о тебе, пень… ты тут вынюхивал насчёт Фарода, ага? Если ещё его ищешь, поспрошай к северу отсюда, на Площади Мусорщиков».~
@3922  = ~«Тебя это не касается».~
@3923  = ~«Приятно было поговорить. Прощай».~
@3924  = ~Оставить труп в покое.~
@3925  = ~«Тогда прощай».~
@3926  = ~«Тогда прощай».~
@3927  = ~Кто-то связал кости этого скелета кожаными ремнями, намотанными на тело так, что они напоминают мускулы и сухожилия. Сами ремни закреплены металлическими болтами, вбитыми в суставы. Похоже, этот скелет довольно долго прослужил: большинство его костей имеют сколы, а их многочисленные трещины скреплены смазкой и плохо пахнущим клеем.~
@3928  = ~Попробовать вытащить болты из скелета.~
@3929  = ~Попробовать вытащить болты из скелета.~
@3930  = ~Попробовать вытащить болты из скелета.~
@3931  = ~Попробовать вытащить болты из скелета.~
@3932  = ~Попробовать вытащить болты из скелета.~
@3933  = ~Попробовать вытащить болты из скелета.~
@3934  = ~Попробовать вытащить болты из скелета.~
@3935  = ~Попробовать вытащить болты из скелета.~
@3936  = ~«Как насчёт этого скелета, Морте? Сгодится в качестве тела?»~
@3937  = ~Оставить скелет в покое.~
@3938  = ~Оставить скелет в покое.~
@3939  = ~Оставить скелет в покое.~
@3940  = ~«Рад был поговорить, Костяшка. Будь здоров».~
@3941  = ~«Рад был поговорить, Костяшка. Будь здоров».~
@3942  = ~Оставить скелет в покое.~
@3943  = ~Оставить скелет в покое.~
@3944  = ~Попробовать вытащить болты из скелета.~
@3945  = ~Попробовать вытащить болты из скелета.~
@3946  = ~Попробовать вытащить болты из скелета.~
@3947  = ~«Не против, если я позаимствую эти ремни и болты?»~
@3948  = ~«Не против, если я позаимствую эти ремни и болты?»~
@3949  = ~«Не против, если я позаимствую эти ремни и болты?»~
@3950  = ~Оставить скелет в покое.~
@3951  = ~Оставить скелет в покое.~
@3952  = ~Оставить скелет в покое.~
@3953  = ~Ты пытаешься вытащить железные болты, но у тебя не хватает силы. Они довольно сильно вбиты.~
@3954  = ~«Может, если бы у меня был нужный инструмент, я бы их вынул… хм-м-м. Возможно, я ещё вернусь, Костяшка».~
@3955  = ~«Может, если бы у меня был нужный инструмент, я бы их вынул… хм-м-м. Возможно, я ещё вернусь, Костяшка».~
@3956  = ~«Может, если бы у меня был нужный инструмент, я бы их вынул… хм-м-м. Возможно, я ещё вернусь, Костяшка».~
@3957  = ~Оставить скелет в покое.~
@3958  = ~Оставить скелет в покое.~
@3959  = ~Оставить скелет в покое.~
@3960  = ~Ты изо всех сил пытаешься вытащить железные болты и после нескольких рывков выдираешь их из суставов. Скелет рассыпается; некоторые кости всё ещё подёргиваются.~
@3961  = ~Используя монтировку, ты вырываешь болты из суставов скелета. Скелет рассыпается; некоторые кости всё ещё подёргиваются.~
@3962  = ~«Извини, Костяшка…»~
@3963  = ~«Извини, Костяшка…»~
@3964  = ~«Эй, шеф. Это же вандализм. Возможно, те болты — единственное, что скрепляет этот мешок костей. Так вот действуют силы некромантии, знаешь ли».~
@3965  = ~«И чего?»~
@3966  = ~«Ох… я не хотел причинять необратимые повреждения».~
@3967  = ~«Ладно, неважно. Может, в другой раз».~
@3968  = ~«О, это не проблема, — Морте делает странное движение, которое может означать пожатие плечами. — Просто не был уверен, знаешь ты или нет. Давай, сделай это».~
@3969  = ~Попробовать вытащить болты из скелета.~
@3970  = ~Попробовать вытащить болты из скелета.~
@3971  = ~Попробовать вытащить болты из скелета.~
@3972  = ~«Неважно. Может, в другой раз».~
@3973  = ~«Неважно. Может, в другой раз».~
@3974  = ~«Хм-м-м. Интересно, будет ли против этот серобородый, если *я* позаимствую его тело…»~
@3975  = ~«Серобородый?»~
@3976  = ~«Я не думаю, что он будет возражать».~
@3977  = ~«Что-то мне подсказывает, что ты был бы в два раза надоедливее, будь у тебя руки. Пошли».~
@3978  = ~«Серобородый… ну, старый приятель, жёлтая собака… старикашка».~
@3979  = ~«Ну, я не думаю, что он будет возражать. Почему бы не взять тело?»~
@3980  = ~«Что-то мне подсказывает, что ты был бы в два раза надоедливее, будь у тебя руки. Пошли».~
@3981  = ~Морте какое-то время изучает скелет, затем качает головой: «Не-а… мне нужен посвежее, чем этот. И посолиднее… этот уж больно скрипучий и растрескавшийся».~
@3982  = ~«А ты нет?»~
@3983  = ~«Ладно. Пошли».~
@3984  = ~«О, да ты прям ходячий прикол, — яростно сверлит тебя взглядом Морте. — Особенно, когда *молчишь*, тупица. Зеркала молят о пощаде, когда ты рядом».~
@3985  = ~«Что, правда? Ну, у *меня* хотя бы все части тела на месте».~
@3986  = ~«Пошли».~
@3987  = ~Морте фыркает. Ты не знаешь, как ему это удаётся без лёгких.~
@3988  = ~«Дай-ка я тебе кое-что скажу, Морте. Нет ничего лучше, чем просто ходить, размахивать руками, вдыхать свежий воздух через лёгкие. Иметь тело — это ЗДОРОВО».~
@3989  = ~«Пошли».~
@3990  = ~«Помощь в твоём побеге из препарационной добавлена в список поступков, о которых я жалею, — Морте снова фыркает. — Надо было оставить тебя гнить… и дальше, то есть».~
@3991  = ~«Рад, что ты это чувствуешь. Пошли».~
@3992  = ~«Приветствую».~
@3993  = ~«Приветствую».~
@3994  = ~«Приветствую».~
@3995  = ~«Приветствую».~
@3996  = ~Осторожно осмотреть гигантского скелета.~
@3997  = ~Посмотреть, можешь ли ты снять чары с нагрудника скелета.~
@3998  = ~Попробовать вынуть клинок из рук скелета.~
@3999  = ~Попробовать вынуть клинок из рук скелета.~
@4000  = ~Попробовать вынуть болты, которые держат доспехи скелета.~
@4001  = ~Попробовать вынуть болты, которые держат доспехи скелета.~
@4002  = ~«Эй, Морте, как насчёт ЭТОГО скелета? Сгодится в качестве тела?»~
@4003  = ~Использовать на скелете свою способность «Разговор с мёртвыми».~
@4004  = ~Оставить скелет в покое.~
@4005  = ~Как только ты дотрагиваешься до скелета, в Мортуарии начинает звонить железный колокол… и со скоростью молнии скелет пробуждается, поднимая свой клинок для нападения!~
@4006  = ~Собравшись это сделать, ты вдруг останавливаешься… твой взгляд притягивают доспехи скелета. Что-то в символах, вырезанных на его нагруднике, заставляет тебя задуматься. Если эти скелеты — стражи, тогда такими действиями их можно… пробудить.~
@4007  = ~Замысловатые бронзовые доспехи скелета закреплены на его грудной клетке и плечах рядом железных болтов. Изучая скелет за доспехами, ты замечаешь, что такие же болты вставлены в плечевые, локтевые, тазовые и коленные суставы. Множество толстых кожаных шнуров и крепко связанных канатов проходят по всей длине рук и ног скелета, переплетаясь таким образом, что напоминают мышцы и сухожилия.~
@4008  = ~Несмотря на явную старость доспехов, выглядят они вполне ухоженными. Метал ярко сияет, а символы, выгравированные на нагруднике, кажется, переливаются на свету, слегка смещаясь, когда ты пытаешься сфокусировать на них взгляд.~
@4009  = ~Почти бессознательно ты расслабляешь взгляд и спокойно смотришь на символы. Через некоторое время символы перестают перемещаться и превращаются в шлейф рун, который идёт вверх и вниз по нагруднику. Довольно странно, но переплетённый рунический узор напоминает тебе цепи… и с этой мыслью ты внезапно вспоминаешь, что эти руны — какие-то охранные чары.~
@4010  = ~Ты изучаешь руны некоторое время, но никак не можешь разобраться в этих чарах. Они выглядят довольно сложными, и тебе трудно сосредоточиться.~
@4011  = ~Ты изучаешь последовательность рун, выгравированных на доспехах. Самые простые из рун — это малые защитные чары. Но несколько рун, похожих на черепа, вместе со сферическими рисунками на краях доспехов наводят тебя на мысль, что здесь переплетены сильная некромантия и охранные чары. Если дотронутся до скелета, он, скорее всего, пробудится… и будет защищаться.~
@4012  = ~Ты подозреваешь, что порча наружного рунического узора на нагруднике, вероятнее всего, разрушит чары. Но это кажется непростым… узор крайне замысловат, и разрушение его в неправильной последовательности вполне может оживить скелет.~
@4013  = ~Как только ты начинаешь работать с рунами, украшающими нагрудную пластину, в Мортуарии начинает звонить железный колокол… и со скоростью молнии скелет пробуждается, поднимая свой клинок для нападения!~
@4014  = ~Поначалу работа кажется сложной и нервной, но постепенно твой разум концентрируется, и руны разрушаются под твоим напором. Через несколько минут чары со скелета полностью сняты. Он разваливается, падая на пол со страшным шумом!~
@4015  = ~Ты ждёшь какое-то время, но реакции на шум нет. Действуя быстро, ты тщательно осматриваешь части скелета на полу. Большинство из них очень тяжёлые или слишком древние, чтобы быть полезными, но ты замечаешь кусок нагрудника с уцелевшими по большей части выгравированными рунами. У тебя такое чувство, что он может пригодиться.~
@4016  = ~В этот раз снятие чар проходит заметно легче, и руны быстро разрушаются под твоим напором. В считанные минуты все чары со скелета сняты. Помня о том, что случилось с первым скелетом, ты подхватываешь его прежде, чем он успевает упасть и наделать шума, а затем медленно опускаешь на пол.~
@4017  = ~Ты быстро осматриваешь останки скелета и вновь находишь кусок нагрудника… как и на первом, на нём осталась часть выгравированных рун. Он может оказаться полезным.~
@4018  = ~Морте скалит зубы.~
@4019  = ~«Ну так чего: да или?..»~
@4020  = ~«О… прости, — Морте взлетает к голове скелета, смотрит на неё, затем опускается обратно, попутно изучая доспехи и клинок. — О, да. Да-да, думаю, сгодится».~
@4021  = ~«Тогда во имя Баатора, чего ты меня СПРАШИВАЕШЬ, хочу ли я его? Практикуешься в навыках жестокости? — Морте негодующе покачивается. — И это после всего, что я для тебя сделал…»~
@4022  = ~Морте пучит на тебя глаза. «Мы чего, В БРАКЕ СОСТОИМ? Что это ещё за „Я не хочу, чтобы тебе было больно“? — сердито смотрит на тебя он. — Если бы ты ДЕЙСТВИТЕЛЬНО беспокоился обо мне, то придумал бы, как приставить мою голову к телу этого скелета».~
@4023  = ~«Ладно… подожди минутку, я попробую снять у него голову».~
@4024  = ~«Ладно… подожди минутку, я попробую снять у него голову».~
@4025  = ~«Не знаю. Совладаешь ли ты с такой громадиной…»~
@4026  = ~«Мне кажется, лучше оставить его в покое. Давай убираться отсюда».~
@4027  = ~«Ладно… подожди минутку, я попробую снять у него голову».~
@4028  = ~«Ладно… подожди минутку, я попробую снять у него голову».~
@4029  = ~«Я думал о твоей безопасности, Морте. Я боюсь, как бы установка твоей головы на это тело, не навредила тебе».~
@4030  = ~«Я по-прежнему считаю, что нам лучше оставить его в покое. Давай убираться отсюда».~
@4031  = ~«Ладно… подожди минутку, я попробую снять у него голову».~
@4032  = ~«Ладно… подожди минутку, я попробую снять у него голову».~
@4033  = ~«Извини, я не настолько к тебе привязан. Пошли».~
@4034  = ~«Я говорю, оставим его. Давай убираться отсюда».~
@4035  = ~Посмотреть, можешь ли ты снять чары с нагрудника скелета.~
@4036  = ~Попробовать вынуть клинок из рук скелета.~
@4037  = ~Попробовать вынуть клинок из рук скелета.~
