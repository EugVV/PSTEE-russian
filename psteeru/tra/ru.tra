@34971 = ~~
@34972 = ~~
@34973 = ~~
@34974 = ~~
@34975 = ~Этот оживший труп окружают неприятные запахи горелого мяса и жжёной материи. Довольно свежие следы ожогов видны на правой стороне его тела; возможно, он стоял слишком близко к огню и загорелся. На его лбу вырезан номер «199», губы плотно зашиты.~
@34976 = ~«Так… что-нибудь интересненькое происходит?»~
@34977 = ~Труп продолжает пялиться на тебя.~
@34978 = ~Оставить труп в покое.~
@34979 = ~«Так… что-нибудь интересненькое происходит?»~
@34980 = ~«Я знаю, что ты не зомби. Ты никого тут не одурачишь».~
@34981 = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@34982 = ~Труп не отвечает. Кажется, он витает слишком далеко, чтобы отвечать на твои вопросы.~
@34983 = ~Оставить труп в покое.~
@34984 = ~«Приятно было пообщаться. Прощай».~
@34985 = ~Оставить труп в покое.~
@34986 = ~При твоём приближении труп этой женщины останавливает свои шаркающие шаги. Ты замечаешь номер «114», вырезанный на лбу. Рот был плотно зашит, но стежки уже потихоньку распускаются, и слабые стоны вырываются из её уст.~
@34987 = ~«Так… чем занимаемся в последнее время?»~
@34988 = ~Труп продолжает пялиться на тебя.~
@34989 = ~«Тогда прощай».~
@34990 = ~«Эй. Ты видел, как она смотрела на меня? А? Ты это видел? Как она огибала взглядом изгиб моей затылочной кости?»~
@34991 = ~«О *чём* ты?»~
@34992 = ~«Чт… ты чё, СЛЕПОЙ?! Она меня изучала! Она меня бесстыдно ХОТЕЛА».~
@34993 = ~«Может, хотела, чтобы ты *ушёл*. Она была так поглощена МНОЙ, что не обращала внимания на какую-то глупую болтающуюся башку с большим ртом».~
@34994 = ~«Тобой? Ага, конечно! Уж поверь мне, девочкам под могильной плитой плевать на „физические данные“, на „у меня есть тело“ и „я весь в шрамах и вообще весь из себя крутой“. Им нужны парни с ХАРАКТЕРОМ. Такие, как я, шеф. А трупы вроде ТЕБЯ — обычны, как медяки».~
@34995 = ~«Как скажешь, Морте. Пошли».~
@34996 = ~«Я думаю, ты это себе навоображал. Она зомби. Труп. Мёртвая особа. Скорее всего, она тебя даже не почувствовала».~
@34997 = ~«Ну да, ну да, конечно. Если бы ты был мёртв не меньше моего, то понимал бы сигналы. Может, они слишком ТРУДНОУЛОВИМЫ для тебя, и вот почему я буду проводить СВОИ ночи с какой-нибудь сладкой мёртвой крошкой, пока ты тут ходишь со своими „Э-э?“, „А ш-што происходит?“, „Где мои вус-вус-воспоминания?“»~
@34998 = ~«Как скажешь, Морте. Пошли».~
@34999 = ~«Я думаю, тебе и твоему воображению стоит отдохнуть друг от друга».~
@35000 = ~«Как скажешь, Морте. Пошли».~
@35001 = ~«Ты имеешь в виду этот пустой загробный взгляд?»~
@35002 = ~«Тогда прощай».~
@35003 = ~«Тогда прощай».~
@35004 = ~«Так… чем занимаемся в последнее время?»~
@35005 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@35006 = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@35007 = ~Этот труп не отвечает. Кажется, она находится слишком далеко отсюда, чтобы ответить.~
@35008 = ~«Тогда прощай».~
@35009 = ~«Тогда прощай».~
@35010 = ~«Тогда прощай».~
@35011 = ~«Приятно было пообщаться. Прощай».~
@35012 = ~Оставить труп в покое.~
