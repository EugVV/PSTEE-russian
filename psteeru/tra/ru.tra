@38290 = ~«Я ищу „личный аромат“ Вивьен… не знаешь, где его можно найти?»~
@38291 = ~«Я ищу „личный аромат“ Вивьен… не знаешь, где его можно найти?»~
@38292 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@38293 = ~«Я ищу малиновую вуаль Мариссы… не знаешь, где её можно найти?»~
@38294 = ~«Я уже говорил с девятью проститутками… ты не знаешь, где десятая ученица?»~
@38295 = ~«Я уже говорил с девятью проститутками… ты не знаешь, где десятая ученица?»~
@38296 = ~«Вообще-то неважно. Прощай».~
@38297 = ~«Говорить-то ты можешь?»~
@38298 = ~«Неважно. Прощай».~
@38299 = ~«А писать или изъясняться жестами можешь?»~
@38300 = ~«Говорить-то ты можешь?»~
@38301 = ~«У меня другие вопросы…»~
@38302 = ~«Неважно. Прощай».~
@38303 = ~Клятва: «Клянусь, я отыщу способ вернуть тебе голос».~
@38304 = ~«Я постараюсь вернуть тебе голос».~
@38305 = ~«Я могу попробовать вернуть тебе голос… но не бесплатно».~
@38306 = ~«Говорить-то ты можешь?»~
@38307 = ~«У меня другие вопросы…»~
@38308 = ~«Могу я спросить, почему ты не можешь общаться?»~
@38309 = ~«И всё-таки позволь ещё вопрос…»~
@38310 = ~«Тогда прощай».~
@38311 = ~«Что? Что ты о ней знаешь?»~
@38312 = ~«Говорить-то ты можешь?»~
@38313 = ~«Могу я спросить, почему ты не можешь общаться?»~
@38314 = ~«Тогда прощай».~
@38315 = ~«Ты молчишь потому, что твоё сердце разбито?»~
@38316 = ~«Ты знаешь слово, которое может уничтожить мультивселенную?»~
@38317 = ~«Ты испытала эмоциональное потрясение? И поэтому не можешь разговаривать?»~
@38318 = ~«Твой голос послужил причиной смерти или другой трагедии?»~
@38319 = ~«Ты почему-либо поклялась молчать?»~
@38320 = ~«У тебя похитили голос?»~
@38321 = ~«Вообще-то я лучше о чём-нибудь другом спрошу…»~
@38322 = ~«Не бери в голову, прощай».~
@38323 = ~«Может, это было что-то другое?»~
@38324 = ~«У меня вопросы о другом…»~
@38325 = ~«Это всё, что я хотел узнать. Прощай».~
@38326 = ~«Может, это было что-то другое?»~
