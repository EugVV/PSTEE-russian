@31203 = ~«Да… очень интересно… но мне пора идти. Прощай».~
@31204 = ~«Постой… у меня были вопросы…»~
@31205 = ~«Да… очень интересно… но мне пора идти. Прощай».~
@31206 = ~«Постой… у меня были вопросы…»~
@31207 = ~«Да… очень интересно… но мне пора идти. Прощай».~
@31208 = ~«Постой… у меня были вопросы…»~
@31209 = ~«Да… очень интересно… но мне пора идти. Прощай».~
@31210 = ~Этот экран позволяет настроить звук в игре. Выбор настройки покажет её описание.~
@31211 = ~STRREF_OPTIONS_HELP_GAMEPLAY~
@31212 = ~Этот экран содержит игровые настройки. Выбор настройки покажет её описание.~
@31213 = ~Этот экран позволяет настроить обратную связь в игре. Выбор настройки покажет её описание.~
@31214 = ~Этот экран позволяет настроить автопаузу в игре. Выбор настройки покажет её описание.~
@31215 = ~Когда эта настройка активирована, игра идет в полноэкранном режиме, когда дезактивирована — в окне.~
@31216 = ~При активизации этой настройки, отражение изображений осуществляется программным методом, а не средствами аппаратного ускорения. Включайте только если отражения функционируют неправильно.~
@31217 = ~Всегда просвечивать~
@31218 = ~Кровь~
@31219 = ~<WEAPONNAME>~
@31220 = ~При активизации этой настройки, вывод всех прозрачных изображений будет обрабатывается программным методом, а не средствами аппаратного ускорения. Включайте только если прозрачные изображения отображаются неправильно.~
@31221 = ~При активизации этой настройки, вывод всех непрозрачных изображений будет обрабатывается программным методом, а не средствами аппаратного ускорения. Включайте только если обычные изображения отображаются неправильно.~
@31222 = ~При активизации этой настройки происходит размытие и сглаживание полигонов. Это улучшает отображение персонажей.~
@31223 = ~Если эта настройка включена, игра будет показывать все сцены насилия. Если её отключить, сцены насилия отображаться не будут.~
@31224 = ~Если эта настройка включена, игра использует возможности звуковой окружающей среды Creative Labs (Creative Labs' Environmental Audio Extensions). Если ваша система не поддерживает EAX, то эта настройка будет не активна.~
@31225 = ~Позволяет регулировать громкость музыки.~
@31226 = ~Позволяет регулировать громкость речи.~
@31227 = ~Позволяет регулировать громкость окружающих звуковых эффектов.~
@31228 = ~Изменение громкости звуков действий.~
@31229 = ~Позволяет регулировать громкость видео роликов.~
@31230 = ~Эта настройка управляет скоростью прокрутки мышью главного экрана.~
@31231 = ~Эта настройка управляет скоростью прокрутки главного экрана стрелками клавиатуры.~
@31232 = ~Эта настройка управляет появлением подсказок при наведении мыши. Если установить ползунок в крайнее левое положение, подсказки будут появляться незамедлительно, а если в крайнее правое — не будут появляться вообще.~
@31233 = ~Эта настройка устанавливает уровень сложности игры. При перемещении ползунка влево враги будут наносить меньший урон, что облегчит игру. Перемещение вправо увеличивает наносимый врагами урон, усложняя игру.~
@31234 = ~Яркость~
@31235 = ~Он просто отворачивается и уходит.~
@31236 = ~Этот огромного роста мужчина одет в такие же громадные богато украшенные красные доспехи. Даже через щели в шлеме ты можешь видеть, что он смотрит на тебя подозрительно.~
@31237 = ~Внезапно он поднимает оружие: «Как я и думал: ты — это он!» Он стремительно нападает на тебя, попутно призывая ещё стражу.~
@31238 = ~«Приветствую».~
@31239 = ~Оставить его в покое.~
@31240 = ~«Погоди… у меня кое-какие вопросы…»~
@31241 = ~«Прощай».~
@31242 = ~Уйти.~
@31243 = ~«Приветствую…»~
@31244 = ~Оставить его в покое.~
@31245 = ~Защищаться.~
@31246 = ~Бежать.~
@31247 = ~По-прежнему нет ответа. Возникает чувство, что Кви-Сай испытывает твоё терпение.~
@31248 = ~~
@31249 = ~~
@31250 = ~~
@31251 = ~Проходит несколько минут, но Кви-Сай всё ещё молчит.~
@31252 = ~~
@31253 = ~~
@31254 = ~~
@31255 = ~~
@31256 = ~~
@31257 = ~Подождать ещё некоторое время…~
@31258 = ~Подождать ещё некоторое время…~
@31259 = ~Подождать ещё некоторое время…~
@31260 = ~Сдаться и уйти.~
@31261 = ~«Хм?» — она берёт палец в рот, откидывая назад закрывающую глаза прядь волос.~
@31262 = ~«Приветствую…»~
@31263 = ~Оставить женщину в покое.~
@31264 = ~«Ты, случайно, не леди Торнкомб?»~
@31265 = ~«У меня кое-какие вопросы…»~
@31266 = ~«Не обращай внимания. Прощай».~
@31267 = ~Её глаза на мгновение расширяются. Затем она отводит взгляд: «Нет-нет, это не я, сэр».~
@31268 = ~«Я всё же думаю, это ты. Мне сказали, что ты преподаватель магии в Фестхолле».~
@31269 = ~«Знаешь, обманщица из тебя скверная».~
@31270 = ~«Тогда кто ты, если мне позволено спросить?»~
@31271 = ~«У меня кое-какие вопросы…»~
@31272 = ~«Тогда я пойду. Прощай».~
@31273 = ~Леди Торнкомб смотрит на тебя довольно угрюмо: «А хоть бы я и была ей? Что с того?»~
@31274 = ~«Я надеялся немного потренироваться в искусстве магии».~
@31275 = ~«У меня к тебе кое-какие вопросы…»~
@31276 = ~«Ничего, неважно. Прощай».~
@31277 = ~«Тогда мне придётся разрушить твои надежды: больше я не желаю преподавать магию… теперь уходи, оставь меня в покое».~
@31278 = ~«Почему?»~
@31279 = ~«Пока я не ушёл, позволь задать кое-какие вопросы…»~
@31280 = ~«Прощай».~
@31281 = ~«Как будто это тебя касается!»~
@31282 = ~«Но ведь касается… я стремлюсь учиться — а ты можешь научить. Хотелось бы знать, как я могу убедить тебя на занятия со мной».~
@31283 = ~«Ну и ладно. Прощай».~
@31284 = ~Она качает головой: «Не всегда так… маги немощны физически, а наши заклинания — лишь подпорка для слабого тела. Раз прочитанное заклинание исчезает, а бой остаётся боем».~
@31285 = ~«Ясно. У меня ещё вопросы…»~
@31286 = ~«Понимаю. Спасибо и прощай».~
@31287 = ~«Хорошо, спрашивай что угодно», — говорит она безразлично.~
@31288 = ~«Ты, случайно, не леди Торнкомб?»~
@31289 = ~«Кви-Сай не хочет тренировать меня. Он говорит, что заклинания более эффективны, чем рукопашный бой. Что ты об этом думаешь?»~
@31290 = ~«Хотел расспросить о тебе…»~
@31291 = ~«У меня вопросы об этом месте…»~
@31292 = ~«Вообще-то забудь. Прощай».~
@31293 = ~Она громко вздыхает и продолжает грызть ноготь: «Сомневаюсь, что у тебя есть что мне предложить. Я богата, а камни чувств дают мне всё, чего нельзя купить».~
@31294 = ~«Камни чувств?»~
@31295 = ~«Ну и ладно. Прощай».~
@31296 = ~«М-м, да… в каждом камне записаны впечатления и опыт других. Когда впервые пришла в эти залы, я не обращала на них много внимания. И только теперь понимаю, как много я потеряла…»~
@31297 = ~«И что ты потеряла?»~
@31298 = ~«Ну и ладно. Прощай».~
@31299 = ~У леди Торнкомб, похоже, выработалась зависимость от камней чувств, и она предпочитает тратить дни на чужие впечатления вместо того, чтобы преподавать магию. Интересно, как мне убедить её вернуться к преподавательской деятельности…~
@31300 = ~Она с улыбкой кивает. В её глазах появляется стеклянный блеск, она обхватывает себя руками: «Можно потратить здесь, среди камней, целую жизнь… одно чудесное впечатление за другим… обычными словами не выразить этого великолепия. Могу только посоветовать попробовать самому».~
@31301 = ~«Похоже, у тебя выработалась… зависимость».~
@31302 = ~«Наверно, так и сделаю. Прощай».~
@31303 = ~Она недовольно ворчит: «Вздор! Я могу остановиться в любой момент! Просто я *выбрала* наслаждение их чудесами. Зачем проводить время впустую среди неблагодарных недоучек, если среди этих драгоценных камней я могу каждый день проживать сотни новых жизней?»~
@31304 = ~«Не думаю, что камни создавались для этого. А не приходила в голову мысль, что ты могла бы и сама поделиться своими ощущениями, если бы они у тебя были?»~
@31305 = ~«Тогда забудь. Прощай».~
@31306 = ~«Хмпф! Что *ты* там думаешь, меня не волнует. Прощай».~
@31307 = ~Уйти.~
@31308 = ~Ты начинаешь задавать вопрос, но понимаешь, что она даже не смотрит на тебя… не говоря уже о том, чтобы слушать.~
@31309 = ~«Эй? У меня вопрос…»~
@31310 = ~«Леди Торнкомб? Я хочу спросить…»~
@31311 = ~Оставить её в покое.~
@31312 = ~Леди Торнкомб ухмыляется: «А ты — всего лишь изрубленный кусок человека, проживающий своё жалкое подобие жизни. Теперь уходи».~
@31313 = ~«Эй, не разговаривай со мной так, если не хочешь быть изрубленной на куски сама».~
@31314 = ~«Постой… я просто хотел обучиться магии».~
@31315 = ~«Пока нет. У меня к тебе кое-какие вопросы…»~
@31316 = ~«Ладно, неважно. Прощай».~
@31317 = ~Она издевательски смеётся над тобой: «Иди бей себя в грудь перед тем, кто может тебя испугаться. Лично я вряд ли сочту это забавным, скорее оскорбительным, и лучше бы тебе быть подальше, когда у меня кончится терпение».~
@31318 = ~«С другой стороны, почему бы нам не выяснить все вопросы прямо сейчас, мерзкая ведьма?»~
@31319 = ~«Я… не хотел ничего подобного. Позволь принести извинения…»~
@31320 = ~«Я ухожу, но только потому, что ты мне надоела. Прощай».~
@31321 = ~Просто уйти.~
@31322 = ~Она качает головой и громко вздыхает: «Если ты оставишь меня в покое, я с радостью приму твои извинения».~
@31323 = ~«Но я надеялся получить урок в искусстве магии».~
@31324 = ~«Минутку, у меня к тебе вопросы…»~
@31325 = ~«Ну и ладно. Прощай».~
@31326 = ~В районе Клерков, в одном из сенсориумов Фестхолла, я встретил леди Торнкомб, преподавателя магии. Она отказалась меня обучать… хотя я не очень понимаю, почему.~
@31327 = ~Она нервно улыбается: «Никто из тех, о ком стоило бы говорить, уверяю».~
@31328 = ~«Я всё же думаю, это ты, мадам. Ты — леди Торнкомб, преподаватель магии в Фестхолле».~
@31329 = ~«Знаешь, обманщица из тебя скверная».~
@31330 = ~«Как же тебя зовут?»~
@31331 = ~«Тем не менее у меня пара вопросов…»~
@31332 = ~«Тогда я пойду. Прощай».~
@31333 = ~«О, я… э… Адана?»~
@31334 = ~«Ладно, хватит с меня. Мы *оба* знаем, кто ты, леди Торнкомб».~
@31335 = ~«Я думаю, ты на самом деле леди Торнкомб, преподаватель магии в Фестхолле. Я прав?»~
@31336 = ~«Знаешь, обманщица из тебя скверная».~
@31337 = ~Женщина всё ещё бродит по сенсориуму, прикасаясь то к одному камню, то к другому. Она рассеянно смотрит на тебя, как будто не узнавая.~
@31338 = ~«Ты, случайно, не леди Торнкомб?»~
@31339 = ~«У меня кое-какие вопросы…»~
@31340 = ~«Не обращай внимания. Прощай».~
@31341 = ~Леди Торнкомб косится, словно пытается вспомнить, кто ты. Наконец она подчёркнуто хмурится: «Ты! Я надеялась, что ты ушёл навсегда и больше не станешь донимать меня своими злосчастными попытками утащить в тренировочный зал… потому как я точно не пойду».~
@31342 = ~«Мне просто интересно, знаешь ли ты, что Салабеш был рад слышать о твоём решении и хочет подать прошение о назначении его на должность преподавателя магии».~
@31343 = ~«Вообще-то у меня просто появились кое-какие вопросы…»~
@31344 = ~«А я и не стану. Прощай».~
@31345 = ~«Салабеш?! Этот тучный маленький болван… с его магическими талантами и из заплесневелого мешка не выберешься! Но о каком *решении* ты там говорил?»~
@31346 = ~«Ну, о твоём решении остаться в сенсориуме и отказаться от обучения начинающих магов».~
@31347 = ~«Неважно, забудь мои слова. Прощай».~
@31348 = ~Океан-перед-Штормом, череп Чующего в коллекции черепов Лотара, рассказал мне о Рейвел Клубок-Загадок и о печально известном плане ночной ведьмы.~
@31349 = ~Я рассказал леди Торнкомб об интригах Салабеша, который хочет её подсидеть… видимо, эти двое не питают друг к другу особой любви, и она резко решила вернуться к преподавательской деятельности.~
@31350 = ~«Что? Но я… я…»~
@31351 = ~«Да, леди Торнкомб?»~
@31352 = ~Она сверлит тебя взглядом: «Глупость. Совершенная глупость. Если увидишь Салабеша снова, скажи ему, чтобы особенно не беспокоился: я возвращаюсь в тренировочный зал».~
@31353 = ~«Возможно, там и увидимся, леди Торнкомб. До свидания».~
@31354 = ~Леди Торнкомб хмурится: «Сейчас у меня нет времени на разговоры… если хочешь, встретимся позже, в тренировочном зале. Прощай».~
@31355 = ~Уйти.~
@31356 = ~Леди Торнкомб кивает тебе, но неясно, узнала она тебя или нет. Она привела в порядок свою одежду с волосами и выглядит как дворянка в возрасте, которая всё ещё не потеряла привлекательности… но на лице её по-прежнему видна некоторая отрешённость: «Приветствую… ты здесь для того, чтобы попрактиковаться в магии?»~
@31357 = ~«Да… покажи мне, каким заклинаниям ты можешь меня научить».~
@31358 = ~«Да».~
@31359 = ~«Нет, но у меня кое-какие вопросы…»~
@31360 = ~«Нет, не сейчас. Прощай».~
@31361 = ~«Моё время полностью отдано ученикам, сэр. Я бы посоветовала поговорить с одним из них… или, по крайней мере, с кем-то, кто занят меньше».~
@31362 = ~«Погоди, Кви-Сай не хочет меня тренировать. Он говорит, что магия более эффективна, чем боевые искусства. Что ты об этом думаешь?»~
@31363 = ~«Тогда прощай».~
@31364 = ~«Моё время полностью отдано ученикам, сэр. Я бы посоветовала поговорить с одним из них… или, по крайней мере, с кем-то, кто занят меньше».~
@31365 = ~Она качает головой: «Не всегда так… маги немощны физически, а наши заклинания — лишь подпорка для слабого тела. Раз прочитанное заклинание исчезает, а бой остаётся боем».~
@31366 = ~«Понятно. Спасибо и прощай».~
@31367 = ~Ты отвечаешь на все её вопросы, и она удовлетворённо кивает: «Ты по профессии маг, я правильно поняла?»~
@31368 = ~«Именно».~
@31369 = ~«Именно».~
@31370 = ~«Нет».~
@31371 = ~«Не теперь… однако я проходил курс обучения».~
@31372 = ~«Вообще-то забудь. Прощай».~
@31373 = ~Она закрывает глаза и издаёт долгий-долгий вздох: «Тогда чему же ты хочешь научиться у меня? Не отнимай больше моего времени и времени моих учеников! Прощай».~
@31374 = ~«Погоди… ты можешь *сделать* меня магом?»~
@31375 = ~«Погоди… я хотел бы вернуться на путь мага. Можешь направить меня?»~
@31376 = ~«Прощай, леди Торнкомб».~
@31377 = ~«Хорошо. Отвечай на мои вопросы, если сможешь…» — она тестирует твой интеллект при помощи множества загадок и головоломок…~
@31378 = ~Отвечать на её вопросы как можно лучше.~
@31379 = ~Отвечать на её вопросы как можно лучше.~
@31380 = ~«Прости, но твой интеллект недостаточен, чтобы постигнуть даже базовые принципы магического мастерства. Однако я желаю удачи на любом другом избранном пути. Прощай».~
@31381 = ~«Э-э… ладно. Прощай».~
@31382 = ~«Я могу *попробовать*, это уж точно. Ты искренне хочешь оставить свою нынешнюю профессию?»~
@31383 = ~«Да, я оставляю свой меч ради постижения магического искусства».~
@31384 = ~«Да, я оставляю профессию вора ради постижения магического искусства».~
@31385 = ~«Да, я оставляю свой меч ради постижения магического искусства».~
@31386 = ~«Да, я оставляю профессию вора ради постижения магического искусства».~
@31387 = ~«Ну нет уж, я так долго практиковался. Прощай».~
@31388 = ~«Отлично. Проверим, что ты знаешь об Искусстве… вместе мы довольно скоро снова наставим тебя на его путь».~
@31389 = ~Слушать и учиться.~
@31390 = ~«Впечатляющий результат! Если бы камни памяти не научили меня тому, что невозможное случается чаще, чем мы думаем, то я бы сказала, что вернуться на путь Искусства за столь короткий срок невозможно. Ты, наверное, хочешь взглянуть на заклинания, которым я могу обучить?»~
@31391 = ~«Да, покажи мне всё, что у тебя есть».~
@31392 = ~«Нет, но я вернусь попозже. Прощай».~
@31393 = ~«Ты готов посмотреть список заклинаний, которым я могу обучить?»~
@31394 = ~«Да, покажи мне всё, что у тебя есть».~
@31395 = ~«Нет, но я вернусь попозже. Прощай».~
@31396 = ~«Хорошо, я научу тебя тому, чему смогу», — она прерывается, глубоко задумавшись. «Талант к Искусству — это ещё не всё. Ты должен непрерывно концентрировать свои мысли на том, что является сутью процесса магии — на заклинаниях. Обычно их держат в книге, но я видела много магов… которые использовали для записи заклинаний свитки из папируса, каменные пластинки… вышитые шелка… даже шкурки животных», — её глаза тускнеют, она принимается грызть ноготь.~
@31397 = ~«Леди Торнкомб? Ты хотела что-то сказать?»~
@31398 = ~«М-м? О! Прости… я хотела сказать, что для Искусства тебе нужна книга заклинаний — или что-то подобное. Ты ведь грамотный, да?»~
@31399 = ~«Не знаю».~
@31400 = ~«Да».~
@31401 = ~«Так, проведём ещё один тест, — она достаёт из кожаной сумки на боку свиток. — Можешь его прочитать?»~
@31402 = ~Изучить свиток.~
@31403 = ~Изучить свиток.~
@31404 = ~Написанное в свитке плывёт у тебя перед глазами, каждый символ ускользает от взгляда, когда ты пытаешься разобрать его. Почти инстинктивно ты расслабляешь глаза, позволяя им охватить всю страницу… и символы сливаются в описание жестов, компонентов и слов для малого заклинания очарования.~
@31405 = ~«Это ведь малое заклинание очарования, не так ли? Чтобы усилить привлекательность личности?»~
@31406 = ~Написанное в свитке плывёт у тебя перед глазами, каждый символ ускользает от взгляда, когда ты пытаешься разобрать его.~
@31407 = ~Изучить символы, попытаться расшифровать их.~
@31408 = ~«Я сдаюсь, леди Торнкомб… что означают эти символы?»~
@31409 = ~Ты сосредоточенно изучаешь символы. Однако как ты ни стараешься сконцентрироваться, написанное в свитке ускользает от твоего внимания, скручивается и извивается, как клубок змей. Твои глаза болят от попыток проследить за движениями символов.~
@31410 = ~Продолжать изучать символы, пытаясь разгадать их значение.~
@31411 = ~«Я сдаюсь, леди Торнкомб… что означают эти символы?»~
@31412 = ~Ты пытаешься разобраться в символах ещё несколько минут, а леди Торнкомб молча наблюдает. В конце концов она теряет интерес и просто блуждает глазами по комнате.~
@31413 = ~Продолжать изучать символы, пытаясь разгадать их значение.~
@31414 = ~«Я сдаюсь, леди Торнкомб… что означают эти символы?»~
@31415 = ~Уже почти готовый сдаться и отвернуться, ты расслабляешь глаза, позволяя им охватить всю страницу… и символы сливаются в описание жестов, компонентов и слов для малого заклинания очарования.~
@31416 = ~«Это ведь малое заклинание очарования, не так ли? Чтобы усилить привлекательность личности?»~
@31417 = ~Глаза леди Торнкомб расширяются. «Кто ты такой, что так дурачишь меня? — она вырывает свиток из твоих рук. — Ты мне лжёшь? Ты всё-таки маг? Или же демон? Ответь!»~
@31418 = ~«Что не так?»~
@31419 = ~«Нет, насколько знаю. А что не так?»~
@31420 = ~Леди Торнкомб пыталась протестировать мои знания и дала мне свиток малого заклинания очарования. Я смог прочитать его без всякой дополнительной подготовки. Интересно, выходит, я и раньше учился магии?~
@31421 = ~«Просто я не ожидала… хм-м… — она испытующе на тебя смотрит. — То, что ты прочёл, написано на языке *Искусства*. Если бы ты никогда раньше не изучал магию, то эти запутанные символы были бы совершенно лишены для тебя смысла. Но ты читаешь их, это ясно, как небеса Амора. Как такое возможно?»~
@31422 = ~«И сам не знаю… я просто *знал*, что там написано».~
@31423 = ~«Думаю, когда-то я знал, но забыл… а эти символы воскресили мою память».~
@31424 = ~«А может, у тебя редкий дар от природы… впрочем, неважно, — она улыбается. — Только что ты сэкономил месяцы, если не годы на изучение магических символов. Ладно… ты можешь их читать, но есть ли у тебя книга, чтобы их записывать?»~
@31425 = ~«Книга заклинаний? Нет…»~
@31426 = ~«А это тогда что?» — она показывает на твой дневник.~
@31427 = ~«Дневник. Сюда я записываю всё достойное внимания… что происходит со мной в путешествиях и разное прочее».~
@31428 = ~«Сойдёт. Сюда же можешь записывать и свои заклинания, — она просматривает дневник. — Несколько неопрятен, ну да ничего». Она застывает с открытым дневником в руках и снова принимается грызть ноготь. Кажется, она погружена в мысли.~
@31429 = ~Контраст~
@31430 = ~«Леди Торнкомб?..»~
@31431 = ~Эта настройка управляет яркостью изображения.~
@31432 = ~Она снова поворачивается к тебе: «М-м? А… да. Пока заклинания всего лишь записаны в книге — они просто слова и никакой силы не имеют. Искусство требует *запоминать* их для высвобождения их силы. Для этого твой ум должен быть ясен, так что лучшим советом будет сначала хорошенько высыпаться. Понял?»~
@31433 = ~«Да, продолжай».~
@31434 = ~«Думаю, основы я понял, леди Торнкомб».~
@31435 = ~«Прекрасно. Теперь: *перед* сном ты должен выбрать заклинания для запоминания, это крайне важно. Тогда после пробуждения они будут свежи в памяти и готовы к прочтению в любой момент».~
@31436 = ~«Сколько заклинаний я смогу использовать?»~
@31437 = ~«Думаю, основы я понял, леди Торнкомб».~
@31438 = ~«Сейчас ты сможешь прочитать только одно или два заклинания и будешь вынужден отдыхать снова… как начинающий маг, ты просто пока не можешь уместить в своей памяти больше. Используй заклинания мудро, пока не достигнешь новых высот в Искусстве… но даже тогда я бы рекомендовала мудрый подход. С ростом опыта твоя способность к запоминанию заклинаний также будет расти».~
@31439 = ~«Хорошо… продолжай…»~
@31440 = ~«Думаю, основы я понял, леди Торнкомб».~
@31441 = ~«Ты можешь читать только те заклинания, которые запомнил. Итак, для того, чтобы определить, какие два предмета у тебя в руках, ты должен запомнить заклинание опознания… сколько раз?»~
@31442 = ~«Один раз».~
@31443 = ~«Два раза».~
@31444 = ~«Э-э…»~
@31445 = ~«Думаю, основы я понял, леди Торнкомб».~
@31446 = ~«Дважды! Чтобы прочитать заклинание *дважды*, его и запомнить нужно *дважды*».~
@31447 = ~«Ясно. Но как мне получить новые заклинания?»~
@31448 = ~«Думаю, основы я понял, леди Торнкомб».~
@31449 = ~Леди Торнкомб обучила меня основам Искусства. Она говорит, что перед сном я должен выбирать заклинания для запоминания из своей книги. Если я хочу прочитать заклинание несколько раз, то и запоминать его надо несколько раз. После пробуждения заклинания будут у меня в памяти и готовы к прочтению в любой момент. Ещё она сказала, что пока я смогу запомнить немного заклинаний, но с ростом опыта способность к запоминанию заклинаний также будет расти. В городе я наверняка найду других учителей, которые обучат меня чтению заклинаний.~
@31450 = ~«Правильно».~
@31451 = ~«И как мне получить новые заклинания?»~
@31452 = ~«Думаю, основы я понял, леди Торнкомб».~
@31453 = ~«Всегда ищи возможность для изучения нового… даже у простого народа могут оказаться кое-какие младшие заклинания. Кроме того, есть ещё много свитков, рецептов, книг и даже более необычных предметов, где записана магия. Если найдёшь что-нибудь интересное из названного, просто внимательно изучи и скопирую заклинание в свою книгу».~
@31454 = ~«Уяснил».~
@31455 = ~«Думаю, основы я понял, леди Торнкомб».~
@31456 = ~«Тогда вот тебе несколько свитков… младшая магия, чтобы разжечь твой аппетит к Искусству, — она лукаво улыбается — Приходи ещё, как только почувствуешь, что преуспел в Искусстве. Я не смогу больше учить тебя задаром, но продам больше могущественных заклинаний, когда ты будешь способен их читать».~
@31457 = ~«Спасибо, леди Торнкомб. Прощай».~
@31458 = ~«Тогда я ещё вернусь позже. До свидания».~
@31459 = ~Эта настройка служит для управления контрастом изображения.~
@31460 = ~Фон~
@31461 = ~Книга огромна… должно быть, в ней записаны тысячи имён.~
@31462 = ~Не перевести.~
@31463 = ~Прекрасное серебряное зеркало.~
@31464 = ~Похоже, ворота накрепко заперты. Ни замка, ни ручки не видно.~
@31465 = ~Горожанин-Мужчина Повреждения 1~ [CON_05]
@31466 = ~Эффекты~
@31467 = ~Голос~
@31468 = ~Музыка~
@31469 = ~Ролики~
@31470 = ~Настройки автопаузы~
@31471 = ~Гаериен~
@31472 = ~Сибил~
@31473 = ~Тифлинг-художница~
@31474 = ~Тиресиас~
@31475 = ~Анамоли~
@31476 = ~Охранник Похороненной деревни~
@31477 = ~Бариаур~
@31478 = ~Настройки обратной связи~
@31479 = ~Сложность~
@31480 = ~Прокрутка стрелками~
@31481 = ~Задержка подсказок~
@31482 = ~Прокрутка мышью~
@31483 = ~Вставьте диск Planescape: Torment номер~
@31484 = ~«Не стой рядом со мной, Морте».~ [ANA575F]
@31485 = ~«Слушай, полуизверг… тебе же никак не повредит, если мы перекинемся парой слов, а?»~ [MRT478]
@31486 = ~Это папка с документами, касающимися Дак'кона.~
@31487 = ~«Морте, мне интересно… что случилось с твоим телом?»~ [FFG326]
@31488 = ~*Я должен спросить ещё раз: Безымянный, мы встречались раньше?*~ [VHA256A]
@31489 = ~Это папка с документами, касающимися Игнуса.~
@31490 = ~«Внимание: Морте. Ты знаешь, что у меня шесть граней?»~ [NOR311]
@31491 = ~«Это испытание. Даже не пытайся перевести».~
@31492 = ~«Многовато бабок в кармане?»~
@31493 = ~Несколько осколков чёрного хрусталя — или льда — вращаются в вихре ледяного ветра, испускаемого этим богато украшенным пьедесталом. Каждый осколок острый, как лезвие; дотрагиваться до них — дело крайне рискованное. На пьедестале написано: «Тёмные Птицы Окантуса».~
@31494 = ~Оставить их в покое.~
@31495 = ~Прикоснуться к одному.~
@31496 = ~Схватить один.~
@31497 = ~Поймать один из осколков кружкой морозного эля.~
@31498 = ~Как только ты тянешься к кружащимся осколкам, твой палец попадает в ледяной порыв ветра, поднимающийся от пьедестала. Палец мгновенно коченеет, покрытый ледяной коркой, и ты резко отдёргиваешь руку назад.~
@31499 = ~Оставить их в покое.~
@31500 = ~Всё равно потрогать один из осколков.~
@31501 = ~Всё равно потрогать один из осколков.~
@31502 = ~Схватить один.~
@31503 = ~Поймать один из осколков кружкой морозного эля.~
@31504 = ~Ты суёшь руку в поток холодного воздуха. И сам не замечаешь, как он замораживает твой указательный палец до состояния сосульки. Понимаешь ты это только когда один из осколков врезается в твой палец; тот с хрустом отламывается и скользит по полу галереи. Не самое страшное ранение, но из-за ослабленного здоровья оно оказывается для тебя смертельным.~
@31505 = ~Погрузиться во тьму…~
@31506 = ~Ты суёшь руку в ледяной, вызывающий окоченение ветер. И сам не замечаешь, как он замораживает твой указательный палец до состояния сосульки. Понимаешь ты это только когда один из осколков врезается в твой палец; тот с хрустом отламывается и скользит по полу галереи. Ледяные Тёмные Птицы всё так же вращаются в своём вихре, пока ты ожидаешь, когда же отрастёт новый палец.~
@31507 = ~Поймать один из осколков кружкой морозного эля.~
@31508 = ~Уйти, пока никто этого не заметил.~
@31509 = ~Как только ты тянешься к кружащимся осколкам, твои пальцы попадают в ледяной порыв ветра, поднимающийся от пьедестала. Пальцы мгновенно коченеют, покрытые ледяной коркой, и ты резко отдёргиваешь руку назад.~
@31510 = ~Оставить их в покое.~
@31511 = ~Просто потрогать.~
@31512 = ~Всё равно схватить один из осколков.~
@31513 = ~Всё равно схватить один из осколков.~
@31514 = ~Поймать один из осколков кружкой морозного эля.~
@31515 = ~Ты суёшь руку в ледяной, вызывающий окоченение ветер. И сам не замечаешь, как он замораживает твою руку до состояния сосульки, пока ты пытаешься схватить одну из Тёмных Птиц. Когда один из чёрных осколков врезается в твоё запястье, кулак с хрустом отламывается и с громким стуком катится по полу галереи. Из-за уже полученных тобой ран и увечий ты сползаешь на пол и умираешь.~
@31516 = ~Погрузиться во тьму…~
@31517 = ~Ты суёшь руку в ледяной, вызывающий окоченение ветер. И сам не замечаешь, как он замораживает твою руку до состояния сосульки, пока ты пытаешься схватить одну из Тёмных Птиц. Когда один из чёрных осколков врезается в твоё запястье, кулак с хрустом отламывается и с громким стуком катится по полу галереи.~
@31518 = ~Быстро поднять отломавшуюся часть руки и прижать к ране!~
@31519 = ~Ты поднимаешь свой покрытый ледяной коркой кулак и прижимаешь к кровоточащей культе. При этом ты замечаешь, что пойманная тобой Тёмная Птица — бритвенно-острый осколок чёрного льда — уже растаяла и превратилась в ничто. Должно быть, нужна какая-то ёмкость, которая сохраняет холод. В конце концов ткани оттаивают и регенерируют, к руке возвращаются тепло и осязание.~
@31520 = ~Поймать один из осколков кружкой морозного эля.~
@31521 = ~Уйти, пока никто этого не заметил.~
@31522 = ~Ты «окунаешь» кружку в ледяной ветер, поднимающийся с пьедестала, и быстро отдёргиваешь её, зацепив один из осколков. Заглянув внутрь, ты замечаешь, что Тёмная Птица — острый как бритва осколок чёрного льда, и только магические свойства кружки не дают ему растаять.~
@31523 = ~Уйти.~
@31524 = ~Кажется, статуя вот-вот что-то гневно провозгласит. Скульптору блестяще удалось поймать выражение ярости, чтобы так точно высечь морщинки напряжения на лбу и шее, явно ушли долгие месяцы работы. Вся скульптура покрыта тонкими трещинками, а к пьедесталу прикреплена табличка с надписью.~
@31525 = ~Нижние планы распространяют своё зло на всё мироздание, заражая всё, к чему ни прикоснутся. Иногда зло поглощает людей. Если они возвращаются, то с отметинами Нижних планов на лицах и душах, а иногда и с детьми. Ребёнок, которого коснулись Нижние планы, называется тифлингом, и это прикосновение ранит его с рождения. Несомненная печать зла в душе, полученная при рождении, оставляет шрам на всю жизнь. Отношение, которое тифлинг испытывает взрослея, ранит его ещё больше. Тифлинги склонны к одиночеству, избегают дружеских отношений и веры кому-либо, живя своей жизнью. Если они кому-то доверяют, то лишь тщательно взвесив и далеко не сразу, — и крайне редко проявляют доверие открыто.~
@31526 = ~Члены этой фракции, которая также известна как Революционная Лига, считают, что процессу познания мультивселенной препятствуют организации, которые создаются человеком. Он стремятся к разрушению всего, что собрано человеком. Неорганизованность вредит им самим — они разбиты на маленькие ячейки, которые часто враждуют даже друг с другом… Они — террористы и убийцы, которые успели настроить против себя всё общество.~
@31527 = ~Довольно странная фракция Хаоситектов, которую даже сложно назвать фракцией, базирует свою философию жизни на познании мультивселенной через хаос. Они пытаются постичь его природу всеми способами. Они стремятся к самовыражению в оригинальных формах, что, по иронии, приводит к похожему самовыражению.~
@31528 = ~Одна из множества фракций Сигила, Чующие — или Общество Восприятия — считает, что единственный путь к познанию истины мультивселенной — чувственное восприятие, накопление ощущений и опыта. Они стремятся пропустить через призму своих чувств всё, до чего могут дотянуться. Их штаб расположен в районе Клерков, в Общественном Фестхолле, и его двери открыты для всех любопытствующих.~
@31529 = ~В любом обществе присутствуют личности, которые не могут жить по установленным всеобщим законам. Быть может, они чувствуют себя обездоленными и угнетёнными. Возможно, они были вынуждены податься на улицы из-за отсутствия иных перспектив. А может, они просто обижены. Какой бы ни была причина, довольно многие из них избирают себе преступную жизнь, существование за счёт других. Такое знакомо не понаслышке и тебе. Но это не значит, что ты легко смиришься с их попытками ограбить *тебя*.~
@31530 = ~Смазать статую мазью горгоны.~
@31531 = ~Прочесть надпись.~
@31532 = ~Осмотреть трещины.~
@31533 = ~Уйти.~
@31534 = ~Табличка гласит: «Эта статуя представляет собой печальную судьбу этерзерианского колдуна Гангройгидона. В разгар своего мечтательного сумасшествия он был атакован конклавом конкурирующих магов, которые лишили его свободы, заклинанием превратив его плоть в камень. Легенда гласит, что Гангройгидон окаменел в тот самый момент, когда на его устах застыло последнее слово проклятья, столь ужасного, что никто из живущих *никогда* не слышал ничего подобного».~
@31535 = ~Смазать статую мазью горгоны.~
@31536 = ~Осмотреть статую.~
@31537 = ~Уйти.~
@31538 = ~Ты тщательно исследуешь трещинки, которые, как тонкие чёрные вены, паутиной разбегаются по всей поверхности статуи. Около той руки, что ближе к телу, есть кусочек, готовый выпасть.~
@31539 = ~Выломать кусочек.~
@31540 = ~Выломать кусочек.~
@31541 = ~Прочитать надпись.~
@31542 = ~Уйти.~
@31543 = ~Ты крепко хватаешься за предплечье, где трещины наиболее глубоки, и бьёшь по нему кузнечным молотом. С еле слышным звоном металла по камню от статуи отламывается осколок размером с кинжал.~
@31544 = ~«Есть…»~
@31545 = ~Едва выломав кусочек, ты чувствуешь, как на тыльную сторону твоей руки падает капля воды. Ты поднимаешь глаза и с удивлением обнаруживаешь, что глаза статуи полны слёз. Быстро — и незаметно — спрятав осколок, ты отворачиваешься от плачущей скульптуры.~
@31546 = ~Смазать статую мазью горгоны.~
@31547 = ~Осмотреть статую.~
@31548 = ~Прочитать надпись.~
@31549 = ~Уйти.~
@31550 = ~Ты просовываешь руку туда, где, как тебе кажется, есть слабое место — и обнаруживаешь, что без молотка камень не отколоть. К тому же между рукой и телом недостаточно места для замаха, поэтому молот нужен немаленький… скорее боевой, чем рабочий.~
@31551 = ~Смазать статую мазью горгоны.~
@31552 = ~Осмотреть статую.~
@31553 = ~Общество Восприятия~
@31554 = ~Бариаур~
@31555 = ~Житель из простонародья~
@31556 = ~Прочитать надпись.~
@31557 = ~Уйти.~
@31558 = ~Ты мажешь статую отвратительно пахнущей мазью. Изваяние охватывает странное свечение, и ты видишь, как Гангройгидон делает вдох, а его глаза переполняет жгучее, яростное безумие.~
@31559 = ~«Приветствую…»~
@31560 = ~Прикрыть уши.~
@31561 = ~Бежать без оглядки.~
@31562 = ~Прежде чем ты успеваешь хоть что-то предпринять, изо рта Гангройгидона извергается обжигающий поток слов. Ты чувствуешь агонию от его речи, словно по телу прокатывается внезапная волна неистового жара. Кожа горит и покрывается язвами. Глаза рвутся из орбит и лопаются, тебя поражает слепота… ты слышишь чей-то крик и тут же понимаешь, что это кричишь ты…~
@31563 = ~Подождать, пока кошмар закончится.~
@31564 = ~Погрузиться во тьму жертвой Ужасного Проклятья Гангройгидона.~
@31565 = ~Последнее, что ты слышишь, — это крик Морте…~
@31566 = ~«Клянусь острыми сиськами Госпожи… что за…»

Внезапно на тебя обрушивается мёртвая тишина, все чувства сходят на нет…~ [MRT387]
@31567 = ~Принять страшную смерть от Ужасного Проклятья Гангройгидона.~
@31568 = ~Пожалуйста, вставьте DVD-диск с игрой в дисковод~
@31569 = ~В дисковод~
@31570 = ~Неправильный диск в дисководе~
@31571 = ~Нет диска в дисководе~
@31572 = ~Planescape: Torment~
@31573 = ~Planescape: Torment не может запуститься с глубиной цвета, установленной для вашего монитора. У вас должна быть глубина цвета 16, 24 или 32 бит.~
@31574 = ~Planescape: Torment не может установить полноэкранный режим под DirectDraw.~
@31575 = ~Вы уверены, что хотите покинуть игру Planescape: Torment?~
@31576 = ~Недостаточно пространства на диске для того, чтобы сохранить игру.~
@31577 = ~Недостаточно пространства на диск для того, чтобы сохранить игру. Желаете продолжить?~
@31578 = ~Нет диска. Поставьте диск 1.~
@31579 = ~Череп устало выдыхает и говорит сальным голосом: «Зачем тревожишь мой покой? Так много событий в последнее время, и хотя я приветствую новые впечатления, вынужден признать желание ощутить тишину».~
@31580 = ~Левая серьга~
@31581 = ~«Расскажи мне о себе».~
@31582 = ~«Что ты здесь делаешь?»~
@31583 = ~«Что ты можешь рассказать о Лотаре?»~
@31584 = ~«А что скажешь об остальных черепах на полке?»~
@31585 = ~«Тогда не буду мешать наслаждаться ей. Прощай».~
@31586 = ~«Я… я был Океаном-перед-Штормом, Чующим. Теперь же, увы, я просто декорация».~
@31587 = ~«Чующим? Что это такое?»~
@31588 = ~«Должно быть, неприятная участь…  тут не очень-то много впечатлений, да?»~
@31589 = ~«Что ты можешь рассказать о Лотаре?»~
@31590 = ~«Что ты здесь делаешь?»~
@31591 = ~«А что ты знаешь о других черепах?»~
@31592 = ~«А что скажешь об остальных черепах на полке?»~
@31593 = ~«Ясно. Прощай».~
@31594 = ~«Ну, лежу на полке и собираю пыль, пока кому-нибудь из крыс-прихвостней Лотара не придёт в голову протереть меня тряпочкой. Ещё я отвечаю на вопросы Лотара и… вот, собственно, и весь смысл моего ничтожного существования…»~
@31595 = ~«Нет, мне интересно, как ты сюда попал?»~
@31596 = ~«Нет, мне интересно, как ты сюда попал?»~
@31597 = ~«Какого рода вопросы?»~
@31598 = ~«Расскажи мне о себе».~
@31599 = ~«Что ты можешь рассказать о Лотаре?»~
@31600 = ~«А что насчёт остальных черепов на полке?»~
@31601 = ~«А что скажешь об остальных черепах на полке?»~
@31602 = ~«Ну, не буду тебе мешать. Прощай».~
@31603 = ~«Ничего, что ты не услышишь от него сам. Поскольку я не уверен, не донесут ли на меня другие черепа, скажи я что-нибудь неподобающее, лучше я просто промолчу. Да, я его боюсь, если хочешь знать».~
@31604 = ~«И что он может тебе сделать?»~
@31605 = ~«Расскажи мне о себе».~
@31606 = ~«Что ты здесь делаешь?»~
@31607 = ~«А что насчёт остальных черепов на полке?»~
@31608 = ~«А что скажешь об остальных черепах на полке?»~
@31609 = ~«Тогда оставлю тебя в покое. Прощай».~
@31610 = ~«О, практически полная скукота. Гоатскомб — крыса-оборотень; Гримскальп — анархист; Штерн — старый наёмный убийца и маг по совместительству. Не знаю, чем Штерн занимался, но он злой по самой своей сути».~
@31611 = ~«Прагматик? Так часто втыкал кинжалы в спину, что это стало основным методом решения проблем?»~
@31612 = ~Океан-перед-Штормом снова обращает своё внимание на тебя: «Видишь? Совершенно злой».~
@31613 = ~«Расскажи мне о себе».~
@31614 = ~«Что ты здесь делаешь?»~
@31615 = ~«Что ты можешь рассказать о Лотаре?»~
@31616 = ~«Да, вижу. Прощай».~
@31617 = ~«Чующий — это член Общества Восприятия, одной из фракций Сигила, расположенной в Общественном Фестхолле, в районе Клерков. Мы всегда считали, что вселенную можно постичь только через ощущения. Поэтому мы должны накапливать как можно больше различных впечатлений. По-моему, я достиг предела, сидя на пыльной полке: мой порог скуки низок как никогда».~
@31618 = ~«Могу я для тебя что-то сделать?»~
@31619 = ~«Что ты здесь делаешь?»~
@31620 = ~«Что ты можешь рассказать о Лотаре?»~
@31621 = ~«А что скажешь об остальных черепах на полке?»~
@31622 = ~«А что скажешь об остальных черепах на полке?»~
@31623 = ~«Жаль. Прощай».~
@31624 = ~«Нет, но спасибо за заботу. Однажды я бросился с полки и разбился, но через день нашёл себя склееным и на своём месте. Лотар сам избавится от меня, когда я ему надоем».~
@31625 = ~«Что ты здесь делаешь?»~
@31626 = ~«Что ты можешь рассказать о Лотаре?»~
@31627 = ~«А что насчёт остальных черепов на полке?»~
@31628 = ~«А что скажешь об остальных черепах на полке?»~
@31629 = ~«Ну, удачи тебе. Прощай».~
@31630 = ~Череп глазеет на тебя. «Точно. Трави мою рану, — он делает длительную паузу. — Убирайся».~
@31631 = ~«Эй, да ладно, я просто пошутил…»~
@31632 = ~«Хорошо. Прощай».~
@31633 = ~«Это долгая история, и я не намерен ничего говорить, пока ты не выполнишь задание Лотара».~
@31634 = ~«И что он может тебе сделать?»~
@31635 = ~«Мне ты можешь рассказать».~
@31636 = ~«Тогда расскажи мне о себе».~
@31637 = ~«Что ты можешь рассказать о Лотаре?»~
@31638 = ~«Ну ладно. А как насчёт остальных черепов на полке?»~
@31639 = ~«Ну ладно. А что скажешь об остальных черепах на полке?»~
@31640 = ~«Ну, не буду тебе мешать. Прощай».~
@31641 = ~«Это длинная история, которая связана с Рейвел Клубок-Загадок, ночной ведьмой. Хочешь послушать?»~
@31642 = ~«Да».~
@31643 = ~«Не особенно».~
@31644 = ~Если бы череп мог пожать плечами, он бы это сделал: «Ничего нового, что ты не слышал бы раньше».~
@31645 = ~«Расскажи мне о себе».~
@31646 = ~«Что ты можешь рассказать о Лотаре?»~
@31647 = ~«Ладно. Прощай».~
@31648 = ~Дух-защитник~
@31649 = ~Череп таращит глаза, и у тебя возникает чувство, что он ёжится. «Знаешь, незабываемую боль можно испытать и не имея нервных окончаний. Не вся боль физическая, и не все эмоции в мыслях. Есть впечатления, повторять которые не хочется, — он выдерживает паузу. — Интервью закончено. Прощай».~
@31650 = ~«Ответь мне на другой вопрос…»~
@31651 = ~Безымянный~
@31652 = ~Слабый головорез~
@31653 = ~Огромный головорез~
@31654 = ~Девушка из высшего общества~
@31655 = ~Юноша из высшего общества~
@31656 = ~Торговец~
@31657 = ~Страж~
@31658 = ~Некромант~
@31659 = ~Дух-защитник~
@31660 = ~«Прощай».~
@31661 = ~«О, обо всём на свете… о моём жизненном опыте, политике Чующих, —  к сожалению, эти сведения несколько устарели! — впечатления о людях, которые здесь бывают, и ещё много, много всего. Вопросы меняются, но мне нравится на них отвечать. Если тебе больше нечего у меня спросить, то я замолкаю. Прощай».~
@31662 = ~«Нет, погоди. У меня были ещё вопросы…»~
@31663 = ~«Прощай».~
@31664 = ~Череп безжизненно таращится и ничего не говорит.~
@31665 = ~«Ну и ладно. Прощай».~
@31666 = ~«Тогда я лучше вернусь в тишину. Прощай».~
@31667 = ~«Нет, постой, ответь ещё на пару вопросов…»~
@31668 = ~«Прощай».~
@31669 = ~«Неужели не будет мне от тебя покоя?»~
@31670 = ~«Расскажи мне о себе».~
@31671 = ~«Что ты здесь делаешь?»~
@31672 = ~«Что ты можешь рассказать о Лотаре?»~
@31673 = ~«Что расскажешь об остальных черепах на полке?»~
@31674 = ~«Что расскажешь об остальных черепах на полке?»~
@31675 = ~«Может, и будет. Прощай».~
@31676 = ~«Хорошо. Я работал тогда в Общественном Фестхолле, штаб-квартире Чующих, в сенсориумах. Рейвел — да проклянут силы её чёрную душу — частенько заходила туда и подолгу общалась с камнями чувств. Она была мастером по решению загадок, и в этом мастерстве она превосходила лучшие умы. Но и она порой сталкивалась со сложностями, требующими ответов извне. Я слышал, там она искала разрешение загадки самого Сигила».~
@31677 = ~«Продолжай».~
@31678 = ~«Мне это всё надоело. Прощай».~
@31679 = ~«Она была страшна как смерть и без труда меняла внешность при помощи своей магии — как я слышал, время от времени она к этому прибегала. Её демоническая внешность отпугнула многих потенциальных фракционеров. И всё же я решился спросить у неё, чего она ищет в камнях и не может ли поделиться со мной хоть каплей своих знаний».~
@31680 = ~«Звучит так, будто это было большой ошибкой».~
@31681 = ~«Думаю, суть я уловил. Прощай».~
@31682 = ~«Так и есть. Она предложила мне сделку, поскольку жила загадками. Если она отвечает на мой вопрос, я должен согласиться ответить на один из её. Отвечу неправильно — моя жизнь принадлежит ей. Я согласился. Она мне сказала, что намерена раскрыть загадку Клетки и открыть её для всех желающих войти: сил, извергов, небожителей, модронов и слаади… не говоря уже о живущих на внутренних планах. Самой важной частью её плана было раскрыть тайну, которую ранее не смог раскрыть никто».~
@31683 = ~«И что произошло потом?»~
@31684 = ~«Ясно. Прощай».~
@31685 = ~«Она задала свой вопрос. Я не смог ответить на него, хотя она утверждала, что ответ прост, как нос на её лице. Собратья Чующие нашли меня наутро в сенсориуме, беспрерывно кричащим. Я умолял их убить меня, и они пошли мне навстречу. Никто даже не заикнулся, что я получил новые впечатления, так ужасно это было. И… вот я здесь. Теперь верни мне мой покой».~
@31686 = ~«Что это был за вопрос?»~
@31687 = ~«Не ответишь ещё на пару вопросов?»~
@31688 = ~«Спасибо за рассказ. Прощай».~
@31689 = ~«Вот он: „Что может изменить природу человека?“ Я долго думал и ответил: „Любовь“. И тогда она сказала, что люди слишком любят себя, чтобы такая простая вещь, как любовь, могла бы изменить их. А потом она… она… оставь меня».

Из глубины твоей памяти всплывает картина: ты стоишь перед фигурой с крючковатым носом, которая спрашивает тебя о том же… но свой ответ вспомнить не получается.~
@31690 = ~«Не ответишь ещё на пару вопросов?»~
@31691 = ~«Сочувствую. Прощай».~
@31692 = ~«Злой? Вот ещё! Я просто прагматик».~
@31693 = ~«Но разве не прекрасное решение? Оно всегда срабатывает. Яд и магия тоже хорошо работают, по моему опыту».~
@31694 = ~Череп говорит глубоким, сильным голосом с шутливыми интонациями: «Ты пришёл познать истину? У меня целый мешок истин».~
@31695 = ~«Расскажи мне о себе».~
@31696 = ~«Как ты сюда попал?»~
@31697 = ~«Что ты можешь рассказать о Лотаре?»~
@31698 = ~«Что ты можешь рассказать о других черепах здесь?»~
@31699 = ~«Не хочу зря тратить твоё время, забудь. Прощай».~
@31700 = ~«Пришёл за наставлениями об истинах мира? Я — тот, кто тебе нужен!»~
@31701 = ~«Расскажи мне о себе».~
@31702 = ~«Как ты сюда попал?»~
@31703 = ~«Что ты можешь рассказать о Лотаре?»~
@31704 = ~«Что ты можешь рассказать о других черепах здесь?»~
@31705 = ~«Не хочу зря тратить твоё время, забудь. Прощай».~
@31706 = ~«О себе? Я Штерн, один из величайших практиков персонального мира посредством усиленного перенаправления враждебности».~
@31707 = ~«Забавно, что ты об этом спрашиваешь. Мне дали одну чёрную книгу, чтобы я разгадал её секреты. Я постиг её могущество и существенно обострил грани своего восприятия, хотя и заплатил страшную цену — которую с охотой заплатил бы опять! Но разве мог я подумать, что книга предаст меня ради другого, скулящей крысы, напустившейся на меня с полчищами грызунов и содравшей мою плоть с костей. У крысы был ряд последователей, и каждого из них книга предавала, пока не очутилась в руках крысы-оборотня Мантуока. Если найдёшь эту книгу — познай её силы и избавься до того, как пострадаешь от предательства».~
@31708 = ~«Я буду осторожен. Расскажи мне о себе».~
@31709 = ~«Спасибо. Что ты можешь рассказать о Лотаре?»~
@31710 = ~«Хорошо… не расскажешь мне о других черепах здесь?»~
@31711 = ~«Печальный рассказ. Прощай».~
@31712 = ~Штерн, череп наёмного убийцы из коллекции Лотара, предостерёг меня относительно чёрной книги, которая находится у крысы-оборотня Мантуока.~
@31713 = ~«Что я могу рассказать о Лотаре? Да ровным счётом ничего. Даже жалкое существование, что я влачу теперь, намного лучше забвения, обещанного им, если я начну разбалтывать его секреты».~
@31714 = ~«Мне ты можешь рассказать…»~
@31715 = ~«Ну и ладно. Расскажи мне о себе».~
@31716 = ~«Хорошо. Тогда как ты попал сюда?»~
@31717 = ~«А о других черепах здесь не расскажешь?»~
@31718 = ~«Тогда забудь. Прощай».~
@31719 = ~«О черепах, которых могу рассказать, я не оброню ни единого доброго слова. Они не делились со мной переживаниями; на самом деле у нас почти не было случая пообщаться, пока ты не пришёл. Возможно, — в его голосе слышна усмешка. — в твоём присутствии случится что-нибудь особенное».~
@31720 = ~«Возможно. Расскажи мне о себе».~
@31721 = ~«Без сомнения. Как ты сюда попал?»~
@31722 = ~«Наверняка. Что ты можешь рассказать о Лотаре?»~
@31723 = ~«Точно, но с тобой вряд ли кто-то поделится. Прощай».~
@31724 = ~«Можешь называть как хочешь, Гримскальп, — Штерн снова поворачивается к тебе. — Я был одним из лучших… по крайней мере, так говорили».~
@31725 = ~«Тогда как ты попал сюда?»~
@31726 = ~«Что с тобой случилось?»~
@31727 = ~У тебя отчётливое ощущение, что череп Штерна над тобой глумится: «И получить всего лишь твою дружбу? Вот ещё. Тебе нечего мне предложить, ни из услуг, ни из вещей, что склонило бы меня предать Лотара. Убирайся!»~
@31728 = ~«Тогда просто ответь ещё на пару вопросов…»~
@31729 = ~«Тогда прощай».~
@31730 = ~«Нет». Череп словно засыпает — ты чувствуешь, как личность уходит из него.~
@31731 = ~«Ну и ладно».~
@31732 = ~Шипение исходит из зубов соседнего черепа: «Это значит, ты колдун, убийца и отравитель».~
@31733 = ~Голос черепа низкий и скрипучий, словно скрежет стали и кремня: «Я думаю… мы виделись раньше… незнакомец».~
@31734 = ~«Где ты меня видел?»~
@31735 = ~Некоторые люди просто рождаются большими. Некоторые из них используют свои внушительные физические данные для запугивания других. Они проходят через жизнь, терроризируя всех, кто слабее. Эти здоровяки склонны думать, что сила есть — ума не надо, и, к сожалению, им это сходит с рук слишком часто.~
@31736 = ~Власть и богатство порождают привилегии и частное право лишь для тех, кто знает, как использовать их должным образом. Если правильно ими распоряжаться, то можно породить ещё большую власть и богатство, тем самым навсегда сохраняя замкнутый круг. Менее удачливые в этот круг не допускаются, а зачастую и становятся его жертвами.

В Сигиле это означает, что надо стремиться принадлежать высокомерной породе людей, чей опыт ограничен тем, что «правильно» и «должно». Эта женщина — лучшее тому подтверждение.~
@31737 = ~Власть и богатство порождают привилегии и частное право лишь для тех, кто знает, как использовать их должным образом. Если правильно ими распоряжаться, то можно породить ещё большую власть и богатство, тем самым навсегда сохраняя замкнутый круг. Менее удачливые в этот круг не допускаются, а зачастую и становятся его жертвами.

В Сигиле это означает, что надо стремиться принадлежать высокомерной породе людей, чей опыт ограничен тем, что «правильно» и «должно». Этот мужчина — лучшее тому подтверждение.~
@31738 = ~У тебя нет имени. Ты очнулся на холодном каменном ложе в Мортуарии, находящемся в городе Сигил. Всё твоё тело покрыто многочисленными шрамами и татуировками, и ты ничего не помнишь. Кто сделал это с тобой? Ты не знаешь… пока. Но непременно выяснишь.~
@31739 = ~Это наиболее жалкие из всех самых жалких людей Сигила, ниже опускаться уже некуда. Смерть для большинства из них будет лучшим утешением. Они делают всё возможное, лишь бы выжить, и неважно, сколь низменным может быть такое существование.~
@31740 = ~Это наиболее жалкие из всех самых жалких людей Сигила, ниже опускаться уже некуда. Смерть для большинства из них будет лучшим утешением. Они делают всё возможное, лишь бы выжить, и неважно, сколь низменным может быть такое существование.~
@31741 = ~В Сигиле бабки-повитухи выполняют множество обязанностей. Они могут поделиться сведениями о приёме родов или посоветовать правильные травы для лечения лихорадки. Некоторые из них действительно обладают магической силой, надёжно спрятанной за фасадом показной простоты. Но все они могут оказаться полезными.~
@31742 = ~Наполовину люди, наполовину козлы, смотря с какой стороны подойти. Бариауры — раса воинов-кочевников, прямолинейных и наделённых исключительной жаждой жизни. Исходя из того, что ты видел, они избегают контактов с чужаками.~
@31743 = ~«Вполне возможно, но сейчас мне не до воспоминаний».~
@31744 = ~«Опять ты, да? Чего сейчас от меня хочешь?»~
@31745 = ~«Ты говорил, что мы виделись. Где?»~
@31746 = ~«Расскажи мне о себе».~
@31747 = ~«Как ты сюда попал?»~
@31748 = ~«Расскажи мне о Лотаре».~
@31749 = ~«Расскажи мне об остальных черепах здесь».~
@31750 = ~«Ничего. Прощай».~
@31751 = ~«Керст. Город-врата в Карцери».~
@31752 = ~«Керст? Город-врата? Карцери?»~
@31753 = ~«Что я там делал?»~
@31754 = ~«Я? Я Гримскальп. Раньше был Анархистом, членом Революционной Лиги. У нас были ячейки и секреты; мы хотели опрокинуть саму суть планов, чтобы каждый мог жить свободным. Мы строили тайные планы против нескольких фактолов и уже готовы были сделать ход, но были преданы другой фракцией. Я был смертельно ранен, и Лотар забрал меня в коллекцию ради моих секретов. Хорошо, что большинство из них уже потеряли актуальность, ведь от его чар нет защиты».~
@31755 = ~«Что ты можешь рассказать об Анархистах?»~
@31756 = ~«Расскажи мне о Лотаре».~
@31757 = ~«Расскажи мне об остальных черепах здесь».~
@31758 = ~«Спасибо. Прощай».~
@31759 = ~«Предательство. Я должен был его ожидать, учитывая, кто я… вернее, кем был».~
@31760 = ~«И кем ты был?»~
@31761 = ~«Возможно. Прощай».~
@31762 = ~«Я выболтал множество секретов, но ради этого идти на жертву не готов. Я видел такие ужасы в руках Лотара, что о строгости Гармониума вспоминаю со смехом. Он знает мои секреты куда лучше, чем я его, и будь я проклят, если выболтаю хоть один кому бы то ни было. Даже тебе. Особенно тебе».~
@31763 = ~«Почему? Что ты знаешь обо мне?»~
@31764 = ~«Почему? Что ты знаешь обо мне?»~
@31765 = ~«Тогда расскажи мне о себе».~
@31766 = ~«Как ты сюда попал?»~
@31767 = ~«А что расскажешь о других черепах здесь?»~
@31768 = ~«Разумно. Прощай».~
@31769 = ~«Они? Все они инструменты, хоть и не подозревают этого. Их мечты мелкие и личные, они не видят полной картины происходящего. Не видят ничего, кроме себя. Ничтожества. Я с ними не общаюсь».~
@31770 = ~«Ясно. Тогда расскажи о себе».~
@31771 = ~«И как ты тогда сюда попал?»~
@31772 = ~«А что скажешь о Лотаре?»~
@31773 = ~«Это всё, что я хотел узнать. Прощай».~
@31774 = ~«Ты что, бестолочь? Это же город-врата на окраине Внешних Земель, проход в тюремный план Карцери. Место изменников и предателей, где интриг больше, чем в подштанниках баатезу. Город стоит на самом пороге Карцери, и я не удивлюсь, если он рано или поздно соскользнёт».~
@31775 = ~«Соскользнёт? Что это значит?»~
@31776 = ~«И что я там делал?»~
@31777 = ~«Спасибо. Прощай».~
@31778 = ~«Что ты там делал? Молол какую-то чушь про пня, который пытается тебя убить… и болтался по самым скверным местам. Ты был явно крепко не в себе, так что мы с ребятами решили тебя убрать. Насадили на перо, а шмотки между собой поделили. Это было сразу после того, как нас предали, но кое-какие шмотки я успел припрятать».~
@31779 = ~«Что ты можешь рассказать о Керсте?»~
@31780 = ~«Где они?»~
@31781 = ~«Где они?»~
@31782 = ~«Где они?»~
@31783 = ~«О. Спасибо. Прощай».~
@31784 = ~«Я знаю, что ты почему-то важен для Лотара. Он хочет что-то в тебе разгадать, словно в какой-то головоломке. Ты его интересуешь, братишка, и он ждёт ответов на вопросы. Будь готов к слежке. Ещё я знаю о твоих дальних путешествиях: мы уже с тобой виделись».~
@31785 = ~«Что ты знаешь про меня?»~
@31786 = ~Некоторые люди посвящают свою жизнь искусству меча — думают мускулами. Другие ведут воровской образ жизни, позволяя своим пальцам шуршать в чужих карманах, и каждый день трясутся от страха быть пойманными. Но маги — совсем другое дело. Они ищут истоки энергии мультивселенной, проходящей через их тела, изучают тайны бытия и извилистые пути достижения своих пределов. Маги — опасные противники, ибо они многое понимают и постигают суть вещей. Одни маги ничего особенного из себя не представляют, а другие достигают истинного величия. И те, и другие потенциально опасны.~
@31787 = ~Высокомерная призрачная сущность, которая называет себя моей «смертностью», охотится за мной на протяжении уже нескольких жизней. Она посылает за мной тени, мучает меня и крадёт мою память, будучи сама надёжно укрыта стенами Крепости Сожалений. Более я не позволю этому чудовищу нанести мне вред.~
@31788 = ~Эта загадочная призрачная сущность погубила Рейвел, когда та находилась в заточении в лабиринте Чёрных Шипов. Неизвестно, что из себя представляет этот противник.~
@31789 = ~Высокомерная призрачная сущность, которая называет себя моей «смертностью», охотится за мной на протяжении уже нескольких жизней. Она посылает за мной тени, мучает меня и крадёт мою память, будучи сама надёжно укрыта стенами Крепости Сожалений. Более я не позволю этому чудовищу нанести мне вред.~
@31790 = ~Огромный железный голем работает в загадочной осадной башне прямо в центре Сигила. Коаксметал одержим идеей разрушения всего и вся. Смысл его существования состоит в изготовлении оружия.~
@31791 = ~~
@31792 = ~~
@31793 = ~Торговцы были всегда и везде. Их отчаянные попытки загрести побольше денег и материальных благ вызывают лишь жалость, а их жадность отражает состояние человеческой души. В Сигиле — как и везде — торговцы готовы продать всё, на что найдётся покупатель.~
@31794 = ~«Буду иметь в виду. Прощай».~
@31795 = ~«Я уже рассказал большую часть твоему приятелю. Ты почему-то важен для Лотара. Он хочет что-то в тебе разгадать, словно в какой-то головоломке. Ты его интересуешь, братишка, и он ждёт ответов на вопросы. Будь готов к слежке. Ещё я знаю о твоих дальних путешествиях: мы уже с тобой виделись»~
@31796 = ~«Что ты знаешь про меня?»~
@31797 = ~«Буду иметь в виду. Прощай».~
@31798 = ~«Мы — секретное общество, разделённое на ячейки. Каждая работает самостоятельно, получая директивы от сети информаторов и лидеров-которые-всегда-в-тени. Наша цель — разрушить властные структуры общества, освободить людей от лжи политиков и сил, позволить всем направлять жизни согласно собственной воле. Мы работаем в секретности, постоянно меняем установившийся порядок, чтобы избежать проникновения. Я работал несколько десятков лет назад, так что теперь не знаю никаких актуальных секретов — за исключением нескольких лиц, которые, возможно, уже сменили внешность».~
@31799 = ~«Какой-то параноидальный бред».~
@31800 = ~«Это всё, что я хотел узнать. Прощай».~
@31801 = ~«Если общество, к которому ты принадлежишь, расцветает на интригах, инфильтрации и ненависти, насаждаемых властными структурами, то ты просто обязан быть осторожным. Это не паранойя, когда они действительно выходят на твой след. Мы верим, что те, кто работают на два фронта, — непрофессионалы, — некоторое время череп невозмутимо рассматривает тебя. — Думаю, больше мне нечего тебе сказать. Прощай».~
@31802 = ~«Прощай».~
@31803 = ~«Ничего не скажу. Может быть, когда-нибудь я снова получу тело и заберу сам, а может, и нет. Но прямо сейчас мне доставляет неизъяснимое удовольствие видеть, как ты мучаешься. Удачи в поисках», — череп умолкает, и никакими уговорами не получается вытащить из него ни слова.~
@31804 = ~«Ублюдок».~
@31805 = ~Ты чувствуешь, что череп тщательно тебя оценивает: «Ты ведь из братвы, не так ли? У меня чутьё на такие вещи — по крайнем мере было когда-то. Думаю, ты из наших. Ладно. Шмотки на складе. Просто спроси у хозяина и скажи, что я тебя послал. Только не говори, что я мёртв, тогда он без вопросов отдаст».~
@31806 = ~«Я запомню. Спасибо, хоть я и не слишком счастлив слышать, что ты меня убил. Прощай».~
@31807 = ~«Когда верования в городе-вратах становятся слишком близки к граничному плану, силы этих верований может хватить, чтобы город был полностью поглощён планом. Это случается достаточно часто, по крайней мере, когда замешаны Анархисты», — последнее он произносит с некой зловещей гордостью.~
@31808 = ~«Расскажи мне об Анархистах».~
@31809 = ~«Спасибо. Прощай».~
@31810 = ~Странной формы череп громко стучит зубами перед тем, как заговорить с тобой: «М-могу п-помочь?»~
@31811 = ~«Кто ты?»~
@31812 = ~«Как ты сюда попал?»~
@31813 = ~«Что ты можешь рассказать о Лотаре?»~
@31814 = ~«Что ты можешь сказать про остальные черепа на этой полке?»~
@31815 = ~«Нет. Прощай».~
@31816 = ~«Т-ты оп-пять?»~
@31817 = ~«Кто ты?»~
@31818 = ~«Как ты сюда попал?»~
@31819 = ~«Что ты можешь рассказать о Лотаре?»~
@31820 = ~«Что ты можешь сказать про остальные черепа на этой полке?»~
@31821 = ~«Ненадолго. Прощай».~
@31822 = ~«Я Г-г-гоатскомб. Я б-был крысой-оборотнем».~
@31823 = ~«КРЫСОЙ-оборотнем? Сколько же вообще этих оборотней?»~
@31824 = ~«П-п-просто с-стыд. Я был в форме крысы, ис-скал ж-ж-жратву в баре „Горящий труп“ и… с-с-странно, никогда не думал, что в этой з-забегаловке есть с-с-серебряные вилки… Мантуок н-нашёл меня в агонии, и вот я з-здесь».~
@31825 = ~«Что ты можешь рассказать о Мантуоке?»~
@31826 = ~«Что ты можешь рассказать о других черепах здесь?»~
@31827 = ~«Что ты можешь рассказать о Лотаре?»~
@31828 = ~«Ясно. Прощай».~
@31829 = ~Череп Гоатскомба впадает в гробовое молчание. Если бы у него были глаза, то они бы наверняка вращались в ужасе вокруг своей оси. «Уходи… отсюда…» — шепчет он и отказывается продолжать разговор.~
@31830 = ~«Тогда прощай».~
@31831 = ~«Они п-придурки все. П-п-просто потому, что они ч-человеческие, они д-д-думают, что л-л-лучше меня… Н-Н-НЕНАВИЖУ их-х».~
@31832 = ~«Довольно здравое мнение. Расскажешь мне о себе?»~
@31833 = ~«Мило. Но как ты попал сюда?»~
@31834 = ~«Тогда тебе должен больше нравиться Лотар?»~
@31835 = ~«Браво. Прощай».~
@31836 = ~«О, д-д-довольно много. В-в-вороны, волки, м-м-медведи, б-барсуки… даже к-к-крокодилы! Это д-довольно интересно. Как будто все звери З-з-зверинца имеют д-д-двойников-оборотней».~
@31837 = ~«А что за крысы-оборотни здесь обитают?»~
@31838 = ~«Как можно убить оборотня?»~
@31839 = ~«Да уж. Прощай».~
@31840 = ~«Этот п-п-подлый захудалый колдунишка! П-пьянь п-подзаборная! Это я с-сделал его таким. Д-д-давно, когда он был п-простым вонючим д-д-двуногим. Я его н-нашёл и отгрыз н-ногу. На вкус была как маринованное м-м-мясо. Я был п-пьян несколько д-дней. П-потом он объявился. Достал какую-то п-причудливую к-книжку… и в-вот теперь я п-просто украшение на п-п-полке. Ублюдок».~
@31841 = ~«Ты знаешь его секреты?»~
@31842 = ~«Как его можно убить?»~
@31843 = ~«Жизнь сурова. Прощай».~
@31844 = ~«М-м-мантуок и его шайка! Я сделал его таким, и ч-ч-чем он отплатил? П-пошёл и п-продал меня Л-лотару. Ну ничего… я разб-болтал хозяину все его секреты. Мантуок думает, ч-что он в б-безопасности. Но Лотар з-знает всё».~
@31845 = ~«Что ты можешь рассказать о Мантуоке?»~
@31846 = ~«Что за секреты?»~
@31847 = ~«Как его можно убить?»~
@31848 = ~«Хорошо. Прощай».~
@31849 = ~«Уб-б-бить ликантропа п-просто. Всего лишь н-найди серебряное или м-м-магическое оружие и заколи его. Обычное н-н-не сработает. Я тут п-побывал в п-переделке: идиоты утыкали м-меня стрелами. Н-н-ничего, только уколы б-болели. Я был похож на к-к-кактус!»~
@31850 = ~«Спасибо. Прощай».~
@31851 = ~«Его с-с-секрет в т-том, что он р-работает и на Лотара, и на М-м-многих-как-Один, общий разум ч-черепокрыс. Н-не знаю, ч-что этот подлец п-планирует, н-но… н-неважно, я ведь в л-любом случае Лотару всё с-с-сказал».~
@31852 = ~«Ясно. Спасибо и прощай».~
@31853 = ~Женщина-покупатель~
@31854 = ~Мужчина-покупатель~
@31855 = ~Работник рынка~
@31856 = ~Анзе~
@31857 = ~Аалек~
@31858 = ~Циндер~
@31859 = ~Дриксель~
@31860 = ~Корвус~
@31861 = ~Лазло~
@31862 = ~Карина~
@31863 = ~Страхан Рунная Тень~
@31864 = ~Глаза Лотара горят яростью. «Убиваешь моих слуг, да? Дай мне череп, — он тщательно осматривает череп и говорит. — Я чую через его кость запах предательства. Осторожный проныра, но всё же недостаточно осторожный, м-м? Я вытащу из него его секреты. Не беспокойся, я узнаю причину его двуличия. У тебя есть ко мне вопросы?»~
@31865 = ~«У меня много вопросов».~
@31866 = ~Этот узкоглазый остролицый мужчина оглядывает окрестности с выражением рассеянного безразличия, иногда опуская взгляд вниз и ковыряя ногти. Несмотря на богатый наряд из шёлка и бархата, он умудряется выглядеть отталкивающе и более чем опасно.~
@31867 = ~«Ни за что».~
@31868 = ~«Ты думаешь, я брожу по району в поисках незнакомцев кому бы тайны разболтать? Отвали сейчас же».~
@31869 = ~«Хорошо. По рукам».~
@31870 = ~Он делает вид, что не обращает на тебя внимания.~
@31871 = ~«Хе», — мужчина некоторое время молчит, затем криво улыбается. «Хорошо же, — он проходится по тебе изучающим взглядом. — Я наставник в Фестхолле. Имя Хэвлок, Эли Хэвлок. Я разведчик-ветеран, преподаю искусство уловки».~
@31872 = ~Эли недовольно хмурится: «Не знаю. Достаточно я уже учил посредственных карманников и зевак Чующих». Почти про себя он бормочет: «Вообще без понятия, зачем согласился этим заниматься».~
@31873 = ~«Хм-м-м…»~
@31874 = ~Лотар поручил мне отыскать другой череп взамен того, которого не оказалось в моей могиле-ловушке.~
@31875 = ~Лотар сказал мне найти другой череп взамен того, которого не оказалось в могиле-ловушке.~
@31876 = ~Гнилой Уильям предложил мне 200 монет за устранение Кристалл, главаря соперничающей банды в аллее Опасных Углов. Я согласился.~
@31877 = ~Гнилой Уильям предложил мне 300 монет за устранение Кристалл, главаря соперничающей банды в аллее Опасных Углов. Я согласился.~
@31878 = ~Гнилой Уильям попросил меня покончить с убийцей Чёрной Розой. Очевидно, тот скрывается где-то в аллее Опасных Углов.~
@31879 = ~Кристалл, главарь Ангелов-Лезвий с аллеи Опасных Углов, попросила меня ликвидировать её главного конкурента — человека по имени Гнилой Уильям. В обмен на это она обещала мне беспрепятственный проход по аллее.~
@31880 = ~Некий Байрон Пикит, похоже, занимается тёмными делишками. Вероятно, он убил купца по имени Зак и украл какие-то документы у его вдовы, Трист. Без этих документов Трист не может доказать, что она уплатила долг, и будет продана в рабство. Возможно, стоит этим заняться.~
@31881 = ~Я обещал помочь духу-защитнику, охраняющему Мавзолей. Похоже, в одну из внутренних палат проник некромант и запечатал туда вход с помощью мощной магии, которая защищает его от духа. Скорее всего, именно этот некромант виноват в пробуждении мертвецов, о которых говорил Норочи.~
@31882 = ~Лотар предложил мне посетить Фестхолл и поискать там ответы на мои вопросы о Рейвел Клубок-Загадок.~
@31883 = ~Эли кивает, обдумывая твои слова: «Да… не буду отрицать. Однако это как-то жалко смотрится с такой точки зрения».~
@31884 = ~На миг его брови от удивления взлетают вверх, затем гневно морщатся: «Ищешь неприятностей, а? Иди поиграй в тени Госпожи, пень. Отвали!»~
@31885 = ~«Хе! А ведь снова верно, — он по-дружески бьёт тебя по плечу. — Спасибо, паря». Внезапно он устремляет взгляд вдаль: «Ладно… хватит терять тут своё время. Я возвращаюсь в Фестхолл. Если захочешь потренироваться — найдёшь меня там».~
@31886 = ~«Не-а… достаточно уже я учил посредственных карманников и взломщиков-дилетантов».~
@31887 = ~Он поджимает губы и смотрит в небо: «Хм-м-м… есть варианты, я полагаю». Он переводит взгляд тебе прямо в глаза: «Скажу просто, паря: медяки. Ты хочешь потренироваться — это будет тебе стоить. Скорей я Госпожу за зад ущипну, чем стану тренировать всяких пней за бесплатно!»~
@31888 = ~Эли пожимает плечами: «Дьявол побери, даже и не знаю. Пять сотен, может быть… Я *ветеран* разведки, знаешь ли… пять кампаний на Войне Лжи. У меня есть чем поделиться…»~
@31889 = ~Он качает головой: «Нет. Пять — вот сколько мне надо, столько ты и заплатишь».~
@31890 = ~Он закатывает глаза: «Ты спятил, пень? Фига с два! Пять сотен, я сказал, ни медяком меньше».~
@31891 = ~«Надумаешь вернуться — цену знаешь: пять сотен. Пока, здоровяк».~
@31892 = ~«Тогда по рукам, — вы пожимаете руки. — А у тебя они есть?»~
@31893 = ~Он забирает у тебя свёртки медяков и прячет в тунику: «Встретимся в Фестхолле, там и поучишься. А пока прощай, здоровяк».~
@31894 = ~«Надумаешь вернуться — цену знаешь: три сотни медяков. Пока, здоровяк».~
@31895 = ~Он ухмыляется: «Да, это я…»~
@31896 = ~Этот узкоглазый мужчина с резкими чертами лица оглядывает окрестности с выражением рассеянного безразличия. Он замечает твоё приближение и поворачивается, хмурясь: «Всё ещё шныряешь по округе? Чего хотел?»~
@31897 = ~«Я думаю, это была ловушка для мародёров, которые грабят подобные склепы».~
@31898 = ~«Это была моя могила».~
@31899 = ~Эли смотрит, как ты подходишь, но выражение его лица разобрать невозможно. Ты даже сомневаешься, а видит ли он тебя через узкие щёлки своих чёрных глаз. «Хм-м?»~
@31900 = ~«В твоих словах есть некоторый смысл, однако… нечто в этом склепе свидетельствует о его куда большем значении. Я обдумаю это и тебе советую». Он отворачивается, но почти сразу же поворачивается обратно к тебе: «Принеси мне другой череп, и наше предыдущее соглашение останется в силе. И не пытайся подсунуть мне первый попавшийся череп — в этих вопросах я настоящий знаток. Возвращайся, когда найдёшь нечто ценное для меня».~
@31901 = ~«Хорошо. До свидания».~
@31902 = ~«Твоя могила? ТВОЯ могила?» — он внимательно тебя изучает. «Надо бы разузнать об этом подробнее. Тогда принеси мне другой череп, поскольку твой явно у тебя на плечах, и мы посмотрим, какие ответы я могу дать. Наше соглашение остаётся в силе. И не пытайся подсунуть мне первый попавшийся череп — в этих вопросах я настоящий знаток. Возвращайся, когда найдёшь нечто ценное для меня».~
@31903 = ~«А медяки-то у тебя есть?»~
@31904 = ~«Я иду в тренировочный зал разведчиков в Фестхолл, здоровяк. Если хочешь поговорить или потренироваться — встретимся там. Счастливо».~
@31905 = ~«Хорошо. До свидания».~
@31906 = ~«Ого, гляньте-ка, кто пришёл! — по лицу Эли мелькает хищная улыбка. — Добро пожаловать на наши танцульки, здоровяк. Готов к тренировке?»~
@31907 = ~«Хорошо, хорошо. Вот… давай посмотрим, сможешь ли ты выхватить это у меня из руки, здоровяк», — он протягивает руку, в его ладони лежит медяк.~
@31908 = ~Ты резко выстреливаешь рукой и хватаешь монету с ладони так быстро, что и сам удивлён не меньше, чем Эли. «Силы небесные! А ты быстрее, чем кажешься, здоровяк…»~
@31909 = ~Ты выбрасываешь руку вперёд… но Эли слишком быстр. «Всё же неплохо, здоровяк. Продолжим».~
@31910 = ~Твоя попытка забрать монету у Эли выходит смехотворной. Он хмурится, печально покачивая головой.~
@31911 = ~«Прости, здоровяк… не хотелось бы тебе этого говорить, но ты слишком медлителен для такого рода деятельности. Лучше попытай счастья в чём-нибудь другом… прощай».~
@31912 = ~«Прости, здоровяк… не хотелось бы тебе этого говорить, но ты слишком медлителен для такого рода деятельности. Слушай, неправильно будет брать твои медяки, вот… возьми назад. Лучше попытай счастья в чём-нибудь другом… прощай».~
@31913 = ~«Можем начинать, здоровяк. Я научу тебя шести основным хитростям искусства уловки: скрытное передвижение, использование теней как укрытия, вскрытие замков и обчистка карманов, обнаружение и обезвреживание ловушек, устройство засад и удар врагу в спину из укрытия».~
@31914 = ~«Очень важно умение бесшумно двигаться, прячась в тенях. Схватки со многими врагами можно избежать, просто оставаясь вне их видимости. К тому же нападение из укрытия даёт разведчику существенное преимущество, но об этом чуть позже. Но запомни, здоровяк: разведчик не может скрыться, если неприятель уже видит его».~
@31915 = ~«Часто бывает и так, что ворота, преграждающие дорогу разведчику, заперты или документы, жизненно важные для выполнения задания, спрятаны под замок. В такие моменты на помощь приходит умение вскрывать замки. Всегда следует проверять такие замки на ловушки, но об этом я расскажу позже».~
@31916 = ~«Порой противник носит с собой документы или предметы, необходимые разведчику для выполнения задания. В такой ситуации приходится прибегать к обчистке карманов, подкрадываться поближе и аккуратно вытаскивать всё нужное. Однако разведчик всегда должен быть готов сражаться или бежать, если попытка не удастся».~
@31917 = ~«Часто враг расставляет ловушки на территории, которую должен пересечь разведчик, или защищает ими контейнеры, которые надо открыть. Такие ловушки обычно очень хорошо замаскированы, разведчику необходима крайняя осторожность при малейшем подозрении и требуется использовать все свои умения для поиска. Будь терпелив… иногда на обнаружение ловушки уходит несколько минут».~
@31918 = ~«Если разведчик *нашёл* такую ловушку, её нужно обойти или попытаться обезвредить. При снятии ловушек необходима предельная осторожность, поскольку всегда есть шанс, что ловушка сработает при неосторожном вмешательстве».~
@31919 = ~«И последнее, чему я тебя научу, — финальный козырь в рукаве разведчика… удар сзади. Если разведчик нападает на врага из укрытия, первый удар будет точнее и *опаснее*. Чем опытнее разведчик, тем опаснее его удар из теней. Однако помни… как только разведчик ударит из укрытия, он сразу же обнаружит себя».~
@31920 = ~Эли кивает: «Хорошо, здоровяк… во-первых, ты должен расслабиться. Ты слишком скован. Порой тебе придётся действовать инстинктивно, не раздумывая, доверившись своим чувствам…»

Так начинается твоё обучение на вора.~
@31921 = ~Эли кивает: «Далее, ты ведь понимаешь, что тебе придётся бросить твоё нынешнее ремесло, верно? Готов к этому?»~
@31922 = ~После долгой тренировки Эли тебе кивает, явно довольный результатами: «Должен сказать, здоровяк, ни разу ещё мне не попадался такой способный ученик. Мне порой даже казалось, что ты это всё уже делал раньше!»~
@31923 = ~После долгой тренировки Эли тебе кивает, явно довольный результатами: «Должен сказать, здоровяк, ни разу ещё мне не попадался такой способный ученик. Мне порой даже казалось, что ты это всё уже делал раньше!» При этих словах Эли ты неожиданно понимаешь, что действительно *делал* это раньше… и когда-то владел всеми этими навыками, а тренировка лишь вернула их к жизни.~
@31924 = ~После долгой тренировки Эли тебе кивает, явно довольный результатами: «Должен сказать, здоровяк, ни разу ещё мне не попадался такой способный ученик. Мне порой даже казалось, что ты это всё уже делал раньше!» При этих словах Эли ты неожиданно понимаешь, что действительно *делал* это раньше… и когда-то владел всеми этими навыками.~
@31925 = ~Как только слабые воспоминания о крадущихся шагах в тёмных залах и начинённых смертью ловушках всплывают в твоей голове, восстановленная память позволяет «усвоить» гораздо больше, чем преподал Эли.~
@31926 = ~«Немногому я могу тебя научить, здоровяк, если ты уже обучался. Однако я всегда могу показать тебе дорогу, если ты сбился с пути разведчика».~
@31927 = ~«Далее, ты ведь понимаешь, что тебе придётся бросить твоё нынешнее ремесло, верно? Готов к этому?»~
@31928 = ~«Замечательно! Тогда приступим к тренировкам… поднимем твои забытые умения на должный уровень!»~
@31929 = ~«Ты быстро учишься, здоровяк, вот что я хочу сказать, — он с интересом рассматривает тебя сквозь тёмные щелочки своих глаз, а потом трясёт головой. — Да, так и есть. Теперь ты полностью готов».~
@31930 = ~Эли прерывается, чтобы кивнуть тебе: «Привет, здоровяк. Что-то понадобилось?»~
@31931 = ~Мужчина тыкает тебя пальцем: «Следи за собой, пень… любой местный убил бы тебя за это или вызвал бы твердоголовых. А теперь свали отсюда, пока я не передумал и не достал оружие».~
@31932 = ~Эли едко смеётся, сотрясая головой: «Неплохая попытка, здоровяк… совсем не плохая».~
@31933 = ~Эли едко смеётся, сотрясая головой: «Неплохая попытка, здоровяк… совсем не плохая».~
@31934 = ~«Да, да… а теперь отстань, пока твои ужимки не начали меня раздражать».~
@31935 = ~Он качает головой: «Неверно, здоровяк. Даже я бы допустил, что рано или поздно битвы не избежать. Полагаться на одно лишь воровство было бы ошибкой».~
@31936 = ~Он качает головой: «Ни один разведчик, даже я, не развил искусство скрываться до такой степени. А от некоторых врагов вообще нельзя спрятаться: тебя выдаст твой запах или даже всего лишь мысли».~
@31937 = ~«Приветствую…»~
@31938 = ~Оставить его в покое.~
@31939 = ~«Чуть позже. Ты Эли Хэвлок?»~
@31940 = ~«Не сейчас. У меня кое-какие вопросы…»~
@31941 = ~«На твоём месте я бы последил за языком».~
@31942 = ~Уйти.~
@31943 = ~«А для *чего* тогда ты здесь? Чтобы грубить прохожим?»~
@31944 = ~«А для *чего* тогда ты здесь? Чтобы грубить прохожим?»~
@31945 = ~«На твоём месте я бы последил за языком».~
@31946 = ~Уйти.~
@31947 = ~Схватить его и вытрясти ответы.~
@31948 = ~Уйти.~
@31949 = ~«Ты имеешь в виду воровство?»~
@31950 = ~«Не мог бы ты меня обучить?»~
@31951 = ~«Ясно. Прощай, Эли».~
@31952 = ~«Прими мои извинения, я не хотел обидеть. Не мог бы ты меня обучить?»~
@31953 = ~«Как бы то ни было, не мог бы ты меня обучить?»~
@31954 = ~«Ясно. Прощай, Эли».~
@31955 = ~«Возможно, обучая других, ты даёшь им знать о своих собственных умениях».~
@31956 = ~«Как ещё мне тебя уговорить?»~
@31957 = ~«Тогда прощай».~
@31958 = ~«В то же время ты защищаешь право твоего занятия называться благородным, убеждая других, что ты не обычный вор, а разведчик и шпион, мастер уловок».~
@31959 = ~«Я так не думаю. Представителей твоей профессии часто не понимают, смешивая вас с бандитами и грабителями. Нет ничего плохого в том, чтобы рассеять заблуждения».~
@31960 = ~«Ты прав, жалкое зрелище».~
@31961 = ~Уйти.~
@31962 = ~«Может, там и увидимся, Эли. Счастливо».~
@31963 = ~«Как ещё мне тебя уговорить?»~
@31964 = ~«Тогда прощай».~
@31965 = ~«Сколько?»~
@31966 = ~«Забудь. Прощай».~
@31967 = ~«Давай, помогу тебе с этим!»~
@31968 = ~«Да у меня лучшие цены в округе!»~
@31969 = ~«Будешь бестолочью, если пойдёшь куда-нибудь ещё, пень!»~
@31970 = ~«Ты похож на человека, которому стоит найти оружие получше, здоровяк!»~
@31971 = ~«По рукам».~
@31972 = ~«Как насчёт трёх сотен?»~
@31973 = ~«Как насчёт трёх сотен?»~
@31974 = ~«Ну ты, давай сюда, потрать хоть часть своих медяков с пользой!»~
@31975 = ~«Как насчёт двух сотен?»~
@31976 = ~«Продаётся оружие! Продаётся оружие!»~
@31977 = ~«Именем всех сил и их матерей, что это *такое*, ад побери?»~
@31978 = ~«Забудь. Прощай».~
@31979 = ~«Ладно, по рукам».~
@31980 = ~«Забудь. Прощай».~
@31981 = ~«Ладно, а как насчёт трёх сотен?»~
@31982 = ~«Ладно, а как насчёт трёх сотен?»~
@31983 = ~«Забудь. Прощай».~
@31984 = ~Уйти.~
@31985 = ~«Да… вот, держи».~
@31986 = ~«Нет… по крайней мере не сейчас».~
@31987 = ~«Да… вот, держи».~
@31988 = ~«Нет… по крайней мере не сейчас».~
@31989 = ~«Вообще-то прямо сейчас я не готов к тренировкам. До свидания».~
@31990 = ~«Увидимся, Эли. До свидания».~
@31991 = ~«Пока, Эли».~
@31992 = ~«Кви-Сай не хочет обучать меня как воина… говорит, я могу просто украсть у противника оружие, оставив его беззащитным. Что думаешь по этому поводу?»~
@31993 = ~«Кви-Сай по-прежнему не хочет обучать меня как воина… говорит, я могу скрыться от врага и таким образом стать для него неуязвимым. Что думаешь по этому поводу?»~
@31994 = ~«Можешь обучить меня как вора?»~
@31995 = ~«Это всё, что я хотел узнать. Прощай».~
@31996 = ~«Хочу знать, не ты ли Эли Хэвлок».~
@31997 = ~«У меня кое-какие вопросы…»~
@31998 = ~«Ничего. Прощай».~
@31999 = ~«Кви-Сай не хочет обучать меня как воина… говорит, я могу просто украсть у противника оружие, оставив его беззащитным. Что думаешь по этому поводу?»~
@32000 = ~«Кви-Сай по-прежнему не хочет обучать меня как воина… говорит, я могу скрыться от врага и таким образом стать для него неуязвимым. Что думаешь по этому поводу?»~
@32001 = ~«Эли… не мог бы ты обучить меня?»~
@32002 = ~«Просто проходил мимо. Прощай, Эли».~
@32003 = ~«Все пять сотен… вот они».~
@32004 = ~«Нет… по крайней мере не сейчас».~
@32005 = ~«Все три сотни… вот они».~
@32006 = ~«Нет… по крайней мере не сейчас».~
@32007 = ~«Вообще-то прямо сейчас я не готов к тренировкам. До свидания».~
@32008 = ~«Счастливо, Эли».~
@32009 = ~«Не сейчас. Кви-Сай не хочет обучать меня как воина… говорит, я могу просто украсть у противника оружие, оставив его беззащитным. Что думаешь по этому поводу?»~
@32010 = ~«Не сейчас. Кви-Сай по-прежнему не хочет обучать меня как воина… говорит, я могу скрыться от врага и таким образом стать для него неуязвимым. Что думаешь по этому поводу?»~
@32011 = ~«Готов».~
@32012 = ~«Готов».~
@32013 = ~«Нет, не сейчас, Эли. До свидания».~
@32014 = ~Выхватить монету.~
@32015 = ~Схватить монету.~
@32016 = ~Попытаться схватить монету.~
@32017 = ~«Спасибо».~
@32018 = ~«Хорошо…»~
@32019 = ~«Что?»~
@32020 = ~«Что?»~
@32021 = ~«Я… понимаю. В таком случае прощай, Эли».~
@32022 = ~«Я… понимаю. В таком случае прощай, Эли».~
@32023 = ~«Я… понимаю. В таком случае прощай, Эли».~
@32024 = ~«Продолжай…»~
@32025 = ~«Думаю, основы я понял, Эли. Давай приступим к тренировке».~
@32026 = ~«Продолжай…»~
@32027 = ~«Думаю, основы я понял, Эли. Давай приступим к тренировке».~
@32028 = ~«Продолжай…»~
@32029 = ~«Продолжай…»~
@32030 = ~«Думаю, основы я понял, Эли. Давай приступим к тренировке».~
@32031 = ~«Продолжай…»~
@32032 = ~«Думаю, основы я понял, Эли. Давай приступим к тренировке».~
@32033 = ~«Продолжай…»~
@32034 = ~«Хорошо, Эли. Давай приступим к тренировке».~
@32035 = ~Усвоить всё, что получится.~
@32036 = ~Усвоить всё, что получится.~
@32037 = ~Усвоить всё, что получится.~
@32038 = ~Усвоить всё, что получится.~
@32039 = ~«Да».~
@32040 = ~«Нет, лучше не стоит. Может, в другой раз… прощай, Эли».~
@32041 = ~«Может, так и было, Эли, и я просто забыл. Спасибо и прощай».~
@32042 = ~«Может, так и было, Эли, и я просто забыл. Спасибо и прощай».~
@32043 = ~«Может, так и было, Эли, и я просто забыл. Спасибо и прощай».~
@32044 = ~Уйти.~
@32045 = ~«Я бы хотел вернуться на путь уловок, Эли».~
@32046 = ~«Понимаю. Прощай, Эли».~
@32047 = ~«Да, я больше не хочу быть воином».~
@32048 = ~«Да, я больше не хочу быть магом».~
@32049 = ~«Вообще-то не прямо сейчас. До свидания, Эли».~
@32050 = ~Тренироваться, чтобы снова стать вором.~
@32051 = ~«Спасибо, Эли. Прощай».~
@32052 = ~«Кви-Сай не хочет обучать меня как воина… говорит, я могу просто украсть у противника оружие, оставив его беззащитным. Что думаешь по этому поводу?»~
@32053 = ~«Кви-Сай по-прежнему не хочет обучать меня как воина… говорит, я могу скрыться от врага и таким образом стать для него неуязвимым. Что думаешь по этому поводу?»~
@32054 = ~«Нет… просто шёл мимо. Прощай, Эли».~
@32055 = ~«Давай, достань свой меч, я вложу его в твой череп вместо ножен».~
@32056 = ~Уйти.~
@32057 = ~«Хм… спасибо».~
@32058 = ~«Хм… спасибо».~
@32059 = ~«Хм… спасибо».~
@32060 = ~«Спасибо, Эли. Прощай».~
@32061 = ~«Прощай, Эли».~
@32062 = ~«Спасибо, Эли. Прощай».~
@32063 = ~«Спасибо, Эли. Прощай».~
@32064 = ~От этой молодой женщины разит спиртным. Несмотря на её тёмную кожу, ты замечаешь, что её лицо — красивое, но жестокое — раскраснелось. Она стройна, но мускулиста, на ней прозрачные шёлковые одежды и экзотические драгоценности. Многочисленные шрамы покрывают её бёдра и предплечья, похоже, это следы боевых ран.~
@32065 = ~«Приветствую…»~
@32066 = ~Молодой вельможа ухмыляется при твоём приближении, но не говорит ни слова.~
@32067 = ~«Приветствую…»~
@32068 = ~Привет, Доктор Ник!~ [TESTBEAT]
@32069 = ~Он подчёркнуто тебя игнорирует.~
@32070 = ~Молодой вельможа старательно избегает встречаться с тобой взглядом, но тихонько хихикает в ладонь, тряся головой.~
@32071 = ~Он вращает глазами и делает знак убираться прочь, не желая отвечать на твоё приветствие и единым словом.~
@32072 = ~Молодой вельможа вежливо кивает тебе в ответ, но отказывается завязывать разговор.~
@32073 = ~Оставить его в покое.~
@32074 = ~Уйти.~
@32075 = ~«Приветствую…»~
@32076 = ~Оставить его в покое.~
@32077 = ~Уйти.~
@32078 = ~Уйти.~
@32079 = ~Human Male Thug Damage 1~ [CON_06]
@32080 = ~::Пьяный смех::~
@32081 = ~Human Female Townie Damage 1~ [CON_07]
@32082 = ~«Эй, *уважаемый*… я буду с тобой говорить».~
@32083 = ~«*Уважаемый*, минутку твоего внимания!»~
@32084 = ~Human Male Townie Death~ [CON_08]
@32085 = ~«Разрази меня Госпожа, неужели трупы теперь гуляют по улицам Сигила?»~
@32086 = ~Human Female Townie Death~ [CON_09]
@32087 = ~«Что так воняет *падалью*?!»~
@32088 = ~«Глянь-ка! Вот так скотина!»~
@32089 = ~Dustmen Male Damage 1~ [CON_05]
@32090 = ~Dustmen Male Death~ [CON_08]
@32091 = ~Dustmen Female Damage 1~ [CON_07]
@32092 = ~Dustmen Female Death~ [CON_09]
@32093 = ~Abishai Damage 1~ [ABISH06]
@32094 = ~Abishai Battle Cry 1 (Approach 1)~ [ABISH01]
@32095 = ~Cranium Rat Death~ [CRRAT08]
@32096 = ~Drone Heavy Battle Cry 1 (Approach 1)~ [DRONH01]
@32097 = ~Drone Heavy Battle Cry 2 (Approach 2)~ [DRONH02]
@32098 = ~Cranium Rat Damage 2~ [CRRAT07]
@32099 = ~Skeleton Worker Battle Cry 1 (Approach 1)~ [SKELW01]
@32100 = ~Cornugon Death~ [CORNU08]
@32101 = ~Cranium Rat Battle Cry 1 (Approach 1)~ [CRRAT01]
@32102 = ~Giant Armored Skeleton Battle Cry 1 (Approach 1)~ [ARMSK01]
@32103 = ~Cornugon Battle Cry 2 (Approach 2)~ [CORNU02]
@32104 = ~Cornugon Damage 2~ [CORNU07]
@32105 = ~Abishai Battle Cry 2 (Approach 2)~ [ABISH02]
@32106 = ~Прекратить слушать и уйти.~
@32107 = ~Он начинает вещать мрачным тоном: «Смерть. Она ждёт всех нас в конце жизненного пути». Кашлянув, он драматично поднимает брови, вздымает руки и продолжает: «Смерть — это *не* конец! Это лишь начало!»~
@32108 = ~Слушать дальше.~
@32109 = ~Покинуть лекционный зал.~
@32110 = ~«Ибо когда вы умрёте, вы не прекратите своего существования, нет! Вовсе нет! Внешние планы пригласят вас к себе! А потом — новая жизнь… такая, какой вы *никогда* не знали. Она ожидает вас там!»~
@32111 = ~Слушать дальше.~
@32112 = ~Прекратить слушать и уйти.~
@32113 = ~«И вы сбросите драный плащ этой жизни и станете одним из правоверных, просящим! И как у *просящего* на этом Внешнем плане, ваш жизненный путь тогда *поистине* начнётся!»~
@32114 = ~Прекратить слушать и уйти.~
@32115 = ~Слушать дальше.~
@32116 = ~«Если вы были настоящим джентльменом, если всегда были милосердны и добры к вашим друзьям, возможно, озарённые светом склоны горы Селестия примут вас после смерти. Душа ваша отойдёт в тот мир и поселится в качестве просящего в золоте восходов, в нежных лучах солнца…» — он мечтательно вздыхает.~
@32117 = ~Слушать дальше.~
@32118 = ~Прекратить слушать и уйти.~
@32119 = ~«Возможно, вы жили, предавая других, чтобы шагнуть вперёд по карьерной лестнице, постоянно лгали, убивали исподтишка, не останавливаясь ни перед чем ради достижения собственной цели. Тогда холодный, кроваво-красный Карцери, план, куда попадут все отступники, когда придёт их черёд, станет для вас клеткой. Как просящего на этом плане вас ждёт жизнь, полная предателей и предательств, лжи и лгунов. Вы познаете, что такое жизнь без доверия».~
@32120 = ~Слушать дальше.~
@32121 = ~Прекратить слушать и уйти.~
@32122 = ~Он зловеще склоняется и стреляет взглядом во все стороны: «А *может*, вы прожили жизнь, полную кровожадного зла, были высокомерны со своими близкими, унижали других и делали всё как заблагорассудится, не заботясь о том, кому и как вы причинили боль…»~
@32123 = ~Слушать дальше.~
@32124 = ~Прекратить слушать и уйти.~
@32125 = ~«…тогда, возможно, один из Нижних планов — Баатор или крутящийся хаос уровней Бездны — вот что вас ждёт! Зло, сама *суть* зла, — вот те души, что приходят на этот план. И большинство из них обречено на бессмысленную жестокость и страдания или рабство в кошмарной… — он переходит на драматический шёпот, — …Кровавой Войне».~
@32126 = ~Слушать дальше.~
@32127 = ~Прекратить слушать и уйти.~
@32128 = ~«Неважно, куда вы отправитесь, знайте: вы начнёте *новую* жизнь. Новую жизнь, мои сигильцы!»~
@32129 = ~Слушать дальше.~
@32130 = ~Прекратить слушать и уйти.~
@32131 = ~«Вы сможете начать заново, не отягощённые своей памятью или прошлым. И вашей „душе“ не надо ни шоколада, ни мармелада, а только… — тут он улыбается собственной шутке, — *слиться* с тем новым планом, на котором вы окажетесь, став *одним целым* с идеалами и даже с самой материей плана!»~
@32132 = ~Слушать дальше.~
@32133 = ~Прекратить слушать и уйти.~
@32134 = ~«Вы будете одним из обитателей, одним из просящих на этом плане или, в идеале, одним из тех камней, из которых создан план! Такова цель *всех* просящих! И дабы добиться этого, вы… — он начинает хлопать в ладоши, акцентируя внимание, — …ДОЛЖНЫ *хлоп!* СЛЕДОВАТЬ *хлоп!* СВОИМ *хлоп!* ИДЕАЛАМ!»~
@32135 = ~Слушать дальше.~
@32136 = ~Прекратить слушать и уйти.~
@32137 = ~«Своим идеалам! Добро или зло, порядок или хаос, а может, что-то между ними! Как только вы приблизитесь к мировоззрению плана, ваш путь подойдёт к концу и вы станете частью… *самого*… плана! Это существование прекрасно, мои сигильцы!»~
@32138 = ~Слушать дальше.~
@32139 = ~Прекратить слушать и уйти.~
@32140 = ~«И именно это, мои слушатели, ждёт вас *после* „смерти“! Относитесь внимательно уже сейчас к тому, как вы живёте. Но знайте, что *не* забвение ждёт вас после этой жизни!»~
@32141 = ~Слушать дальше.~
@32142 = ~Прекратить слушать и уйти.~
@32143 = ~«А теперь я отвечу на любые ваши вопросы. Есть желающие?»~
@32144 = ~«У меня есть вопрос…»~
@32145 = ~Ждать молча.~
@32146 = ~«Если вопросов нет, то я закончу… на сегодня. Я ещё буду читать лекции в этом зале, и, может быть, пройдут годы… и я встречу *вас* как просящего за Вратами Смерти!»~
@32147 = ~Прекратить слушать и уйти.~
@32148 = ~Оратор, слегка нахмурившись, поворачивается к Морте. Он тянет голову, стараясь разглядеть, кто говорит: «Вопрос? Может быть, вопрос от того, кто ещё жив?»~
@32149 = ~Он кивает так, словно сумел поставить тебя на место: «Прекрасно. А теперь я отвечу на любые ваши вопросы. Кто-нибудь желает?»~
@32150 = ~«У меня есть вопрос…»~
@32151 = ~Ждать молча.~
@32152 = ~Он даёт тебе знак продолжать.~
@32153 = ~«Что определяет план, на который попадёшь после смерти?»~
@32154 = ~~
@32155 = ~~
@32156 = ~~
@32157 = ~«А что, если кто-то не может умереть?»~
@32158 = ~«Объясни мне, что такое „мировоззрение“».~
@32159 = ~«Пыльные говорят, что *этой* жизнью всё и закончится, когда мы умрём».~
@32160 = ~«Докажи, что твои слова правда».~
@32161 = ~«Расскажи мне о Кровавой Войне».~
@32162 = ~«Я хотел бы спросить об одном из упомянутых планов».~
@32163 = ~«Вообще-то неважно. Нет вопросов».~
@32164 = ~«Если больше нет вопросов…»~
@32165 = ~Приготовиться уйти.~
@32166 = ~Приготовиться уйти.~
@32167 = ~Приготовиться уйти.~
@32168 = ~«Ваше мировоззрение, разумеется! Хорошим суждено отправится на Верхние планы, а *плохие* будут заброшены на Нижние… — он закатывает глаза, драматично прижав ладони к сердцу, — …да будут силы милосердны к их душам».~
@32169 = ~«А куда отправляются нейтральные?»~
@32170 = ~«Я хочу спросить о другом…»~
@32171 = ~«Это всё, что я хотел узнать».~
@32172 = ~Он поднимает бровь. «Замечательный вопрос, просто замечательный! — он поворачивается к слушателям и поднимает палец вверх. — Ответ таков: душа прожившего жизнь в полном нейтралитете, безо всякой склонности к добру или злу, становится просящей во *Внешних Землях*, окружающих Сигил. Их судьбы не принадлежат ни одному из планов, кроме земель, лежащих под нашими небесами, частью которых является Шпиль».~
@32173 = ~«Я хочу спросить о другом…»~
@32174 = ~«Это всё, что я хотел узнать».~
@32175 = ~«Просящий — это то, чем вы становитесь, прибыв на новый план после своей смерти. И, как просящий, вы оставляете вашу память и вашу прошлую жизнь, сосредотачиваясь исключительно на новой. А цель этой самой новой жизни — это?..» — он с улыбкой ожидает твоего ответа.~
@32176 = ~«Слиться с планом».~
@32177 = ~«Сам отвечай на свой вопрос. Не пытайся меня проверять».~
@32178 = ~«Не относись ко мне свысока, говнюк».~
@32179 = ~«Превосходно! Похоже, некоторые из моих слов действительно пробились сквозь этот ваш череп!» Слушатели хихикают.~
@32180 = ~«Я хочу спросить о другом…»~
@32181 = ~«Слыхал про Грызя?»~
@32182 = ~«Это всё, что я хотел узнать».~
@32183 = ~«Хм. В таком случае можете оставаться невежей и дальше».~
@32184 = ~«Неважно у него получилось, да?»~
@32185 = ~«Я хочу спросить о другом…»~
@32186 = ~«Это всё, что я хотел узнать».~
@32187 = ~«Ну, он не вернулся со своей последней вылазки».~
@32188 = ~Похоже, вопрос вызывает у него некий дискомфорт: «Ну… да».~
@32189 = ~«Чую, мертвяк уже».~
@32190 = ~«Как?»~
@32191 = ~«Ага, жаль парня, верно?»~
@32192 = ~«А что происходит, когда они умирают?»~
@32193 = ~«Я хочу спросить о другом…»~
@32194 = ~«Это всё, что я хотел узнать».~
@32195 = ~«Конечно…»~
@32196 = ~«Почему ты всё ещё здесь?»~
@32197 = ~Теперь он чувствует себя ещё неудобнее: «Ну… любыми обычными способами, на самом деле».~
@32198 = ~«А что происходит, когда они умирают?»~
@32199 = ~«Я хочу спросить о другом…»~
@32200 = ~«М-м?»~
@32201 = ~«Это всё, что я хотел узнать».~
@32202 = ~«…кто-нибудь идёт и находит этого пня, лежащего там внизу, и мы сможем наварить неплохие деньги».~
@32203 = ~Его неловкость явно растёт: «Ну… вы сливаетесь с планом».~
@32204 = ~«А что, если просящий умрёт на каком-то другом плане, а не на своём родном?»~
@32205 = ~«А как они могут умереть?»~
@32206 = ~«Ха-ха-ха! Мои карманы явно ЛЕГЧЕ, чем обычно».~
@32207 = ~«Я хочу спросить о другом…»~
@32208 = ~«Это всё, что я хотел узнать».~
@32209 = ~Он выглядит совсем выбитым из колеи. «Э-э… ну, тогда *это* и есть конец жизни, тогда… э-э, но ведь ни один просящий не хочет покидать свой родной план, друг! — он оглядывается и понимает, что попал в ловушку. — Чтобы сделать так, э-э, им надо захотеть по-настоящему умереть».~
@32210 = ~«Хм. У меня другой вопрос…»~
@32211 = ~«Эх, ну, он был полезным парнем, этот Грызь. Для многого годился».~
@32212 = ~«Ясно. Ну, это всё, что я хотел узнать».~
@32213 = ~Он поднимает бровь: «Прошу прощения? Что?»~
@32214 = ~«Я *спросил*, почему просящие теряют память после смерти?»~
@32215 = ~«Особенно для прироста медяков в моём кармане!»~
@32216 = ~«Забудь. У меня другой вопрос…»~
@32217 = ~«Неважно. У меня нет вопросов».~
@32218 = ~«Вы что, хотите увековечить вашу любовь? Я бы мог в этом помочь, да…»~
@32219 = ~Он чувствует себя не в своей тарелке: «Э-э… ну, вы понимаете, кто захочет нести такой груз, как воспоминания?» Слушатели начинают перешёптываться.~
@32220 = ~«Я».~
@32221 = ~«И всё-таки *почему* они теряют свои воспоминания?»~
@32222 = ~«Хм. У меня другой вопрос…»~
@32223 = ~«Ясно. Ну, это всё, что я хотел узнать».~
@32224 = ~Оратор ухмыляется: «Достаточно посмотреть на вас, сэр, и всё становится ясно!» Слушатели хихикают.~
@32225 = ~«Так *почему* же они теряют свои воспоминания?»~
@32226 = ~«Хм. У меня другой вопрос…»~
@32227 = ~«Ясно. Ну, это всё, что я хотел узнать».~
@32228 = ~«Я…» — он хмурится, начинает что-то говорить, останавливается. Затем продолжает, тщательно подбирая слова: «Я представляю это себе так, что вам надо начать с нуля, ваша душа просящего чиста, когда вы прибываете на новый план».~
@32229 = ~«Но для чего это нужно, если весь опыт твоей жизни определяет, на каком плане тебе предстоит остаться?»~
@32230 = ~«Кто-нибудь хочет заключить пари?»~
@32231 = ~«Это не ответ».~
@32232 = ~«Это… ужасно. Какая-то дурацкая шутка».~
@32233 = ~«Хм. У меня другой вопрос…»~
@32234 = ~«Ох, проваливай, Сборщик. Возвращайся назад, в катакомбы».~
@32235 = ~«Ясно. Ну, это всё, что я хотел узнать».~
@32236 = ~Он явно не находит себе места. «Ну… я… — он прерывается. — Хм-м. Я не знаю».~
@32237 = ~«Это не ответ».~
@32238 = ~«Ладно… у меня другой вопрос…»~
@32239 = ~«Ясно. Ну, это всё, что я хотел узнать».~
@32240 = ~Он немного злится: «А у вас самого есть *лучший* ответ, друг мой? Может, вы им с нами поделитесь?» Слушатели поворачиваются к вам.~
@32241 = ~«Не помню, где и когда, но я слышал о том, что воспоминания переходят на Астральный план в виде „ядра памяти“».~
@32242 = ~«Нет… у меня нет ответа».~
@32243 = ~Кто-то из зала кричит: «Он прав!»

Оратор поворачивается, чтобы увидеть говорящего. «Ну да, может быть. Что ж, тогда возникает вопрос: важнее ли воспоминания о жизни, чем новая жизнь?»~
@32244 = ~Правда: «Да, важнее».~
@32245 = ~Правда: «Нет».~
@32246 = ~«Не знаю».~
@32247 = ~Он сердито говорит: «Ну тогда всё просто: не умирайте, друг мой». В зале слышатся смешки.~
@32248 = ~«Хм. У меня другой вопрос…»~
@32249 = ~«Ясно. Ну, это всё, что я хотел узнать».~
@32250 = ~Он отвешивает подчёркнутый поклон: «Ну вот, что и требовалось доказать!»~
@32251 = ~«Хм. У меня другой вопрос…»~
@32252 = ~«Допустим. Ладно, это всё, что я хотел узнать».~
@32253 = ~Он ухмыляется: «Да, это именно тот ответ, которого я от вас *ожидал*».~
@32254 = ~«Хм. У меня другой вопрос…»~
@32255 = ~«У меня больше нет вопросов».~
@32256 = ~«Но по сравнению с жизнью, что ожидает вас на новом плане, это незначительно!»~
@32257 = ~«Но для чего это нужно, если весь опыт твоей жизни определяет, на каком плане тебе предстоит остаться?»~
@32258 = ~«Это не ответ».~
@32259 = ~«Хм. У меня другой вопрос…»~
@32260 = ~«Ясно. Ну, это всё, что я хотел узнать».~
@32261 = ~Он смеётся: «Чепуха! *Все* умирают, друг мой. Даже боги».~
@32262 = ~«Я не могу умереть».~
@32263 = ~«А если *предположить*, что кто-то не может умереть?»~
@32264 = ~«Хм. У меня другой вопрос…»~
@32265 = ~«Ясно. Ну, это всё, что я хотел узнать».~
@32266 = ~«О, поистине! Вы только посмотрите, редкий случай: один из великих бессмертных почтил нас своим присутствием! Приветствую тебя, о бессмертный!» Слушатели откровенно смеются.~
@32267 = ~«Могу доказать».~
@32268 = ~«Забудь. У меня другой вопрос…»~
@32269 = ~«Неважно. У меня больше нет вопросов».~
@32270 = ~«Вот это да! Весёлое дельце! — всё больше слушателей начинают хохотать. — Вот это цирк! Уважаемые зрители, обратите ваше внимание. По-моему, у нас будет сегодня наглядное пособие к моим лекциям! Поднимитесь сюда, о бессмертный, и мы посмотрим, кто прав, а кто мёртв!»~
@32271 = ~Устроить показное самоубийство с возвращением.~
@32272 = ~«Вообще-то забудь».~
@32273 = ~«В таком случае, основываясь на том, что я *сказал*, он никогда не достигнет Внешних планов и никогда не станет просящим».~
@32274 = ~«Я не могу умереть».~
@32275 = ~«Хм. У меня другой вопрос…»~
@32276 = ~«Ясно. Ну, это всё, что я хотел узнать».~
@32277 = ~«Прошу прощения, если не объяснил это с самого начала: „мировоззрение“ — это ваши душевные склонности, к добру или злу, к порядку или хаосу. Мировоззрение — это ваш образ *жизни*. И от него многое зависит! Ваш подход к жизни определяет место вашего назначения после смерти».~
@32278 = ~«Я хочу спросить о другом…»~
@32279 = ~«Это всё, что я хотел узнать».~
@32280 = ~Оратор саркастически хихикает… и не он один. Среди слушателей тоже раздаются смешки. «Друг мой, на свете бесчисленное множество просящих, которые не согласятся с… „философией“ Пыльных. *Пыльные* — также среди них».~
@32281 = ~«Я хочу спросить о другом…»~
@32282 = ~«Это всё, что я хотел узнать».~
@32283 = ~«А? — похоже, лектор возвращается с небес на землю. — И как же мне это сделать?»~
@32284 = ~«Умри. Здесь. Сейчас».~
@32285 = ~«Забудь. У меня другой вопрос…»~
@32286 = ~«Неважно. У меня больше нет вопросов».~
@32287 = ~Аудитория затихает. Почувствовав напряжение, оратор нервно сглатывает: «Ну, знаете…» Внезапно он ухмыляется: «Если вы попробуете первым, я сделаю то же самое». Слушатели хихикают.~
@32288 = ~«Согласен».~
@32289 = ~«Забудь. У меня другой вопрос…»~
@32290 = ~«Неважно. У меня больше нет вопросов».~
@32291 = ~«Превосходно!» — на мгновение лицо оратора каменеет, затем радостно вспыхивает. «Поднимитесь сюда, друг мой! — он поворачивается к аудитории, его лицо сияет. — Какая редкая удача, сигильцы! Сегодня — первый и единственный случай, когда мы с вами сможем увидеть живую демонстрацию того, как становятся просящими».~
@32292 = ~Устроить показное самоубийство с возвращением.~
@32293 = ~«Вообще-то забудь».~
@32294 = ~Оратор бледнеет и делает шаг назад: «О силы!..»~
@32295 = ~«Я думаю, будет справедливо, если ты докажешь *свою* точку зрения прямо сейчас…»~
@32296 = ~«Твоя очередь».~
@32297 = ~Просто улыбнуться ему.~
@32298 = ~«Э-э… — аудитория наблюдает с нездоровым интересом. — Ну, знаете…»~
@32299 = ~«Давай, умри. Здесь. Сейчас. Докажи, что ты прав. Начни новую жизнь как просящий».~
@32300 = ~Блеф: «Лучше сделай это сам, а не то я помогу тебе».~
@32301 = ~Правда: «Лучше сделай это сам, а не то я помогу тебе».~
@32302 = ~Он сглатывает: «Сейчас… э-э… хм-м-м». Затем робко предлагает: «Кхе. Должен признать, я ещё не *вполне* готов расстаться с этой жизнью».~
@32303 = ~Убить его.~
@32304 = ~Изобразить попытку убить его, остановившись лишь *в миллиметре* от его шеи.~
@32305 = ~«Значит, эта великолепная новая жизнь на Внешних планах не такая уж и замечательная, как предполагалось?»~
@32306 = ~«Так я и *думал*, ты напыщенный обманщик и пустозвон».~
@32307 = ~Оратор вздрагивает, закрывает глаза руками и визжит… судя по звукам, он обмочился.~
@32308 = ~«Значит, эта великолепная новая жизнь на Внешних планах не такая уж и замечательная, как предполагалось?»~
@32309 = ~«Так я и *думал*, ты напыщенный обманщик и пустозвон».~
@32310 = ~Хотя оратор и понимает, что ему грозит обвинение в лицемерии, но альтернатива пугает его ещё больше. «Пожалуй, нет. Кхе, — он быстро кивает слушателям. — Э… ну да. Уж конечно, не *сейчас*».~
@32311 = ~«Как я и думал. У меня другой вопрос…»~
@32312 = ~«Именно так я и думал. Вопросов больше не имею».~
@32313 = ~«Э-э… да, — оратор выглядит испуганным и побеждённым, его голоса почти не слышно. — Хм-м-м. Да».~
@32314 = ~«Я хочу спросить о другом…»~
@32315 = ~«Вопросов больше не имею».~
@32316 = ~«Неужели вы ничего об этом не слышали, о бестолочь? Война баатезу с танар'ри? У меня нет столетий, чтобы в полной мере описать это противостояние. Спросите о нём кого-нибудь другого, ведь это не относится к теме нашей лекции».~
@32317 = ~«Я хочу спросить о другом…»~
@32318 = ~«У меня больше нет вопросов».~
@32319 = ~«О? И каком же?»~
@32320 = ~«Бездна…»~
@32321 = ~«Баатор…»~
@32322 = ~«Карцери…»~
@32323 = ~«Гора Селестия…»~
@32324 = ~«Неважно. У меня другой вопрос…»~
@32325 = ~«Вообще-то забудь. У меня больше нет вопросов».~
@32326 = ~«План, состоящий из более чем шести сотен слоёв гноящегося зла и хаоса. Родной дом этих извергов танар'ри! — он театрально потрясает руками. — Но вам стоит спросить кого-нибудь более сведущего в планах, чем я».~
@32327 = ~«Я хочу спросить о другом…»~
@32328 = ~«У меня больше нет вопросов».~
@32329 = ~«Девять строго упорядоченных планов законопослушного зла, — он театрально хихикает и жестикулирует. — Дом извергов баатезу! Попробуйте подписать с ними контракт — и на всю жизнь попадёте в цепи бесконечных интриг!» Он улыбается: «Но вам стоит спросить кого-нибудь более сведущего в планах, чем я».~
@32330 = ~«Я хочу спросить о другом…»~
@32331 = ~«У меня больше нет вопросов».~
@32332 = ~«План-тюрьма, жизнь в алых тонах, холодная и жестокая. Это дом всех предателей и лжецов… говорят, там заточили титанов после изгнания с Олимпа! — он театрально жестикулирует. — Но вам стоит спросить кого-нибудь более сведущего в планах, чем я».~
@32333 = ~«Я хочу спросить о другом…»~
@32334 = ~«У меня больше нет вопросов».~
@32335 = ~«Гора Селестия — план вечного добра и веры, — он складывает ладони в молитвенной позе. — Где дэвы летают в небесах, а архоны правят справедливо и благородно… образец добродетели!» Он улыбается: «Но вам стоит спросить кого-нибудь более сведущего в планах, чем я».~
@32336 = ~«Я хочу спросить о другом…»~
@32337 = ~«У меня больше нет вопросов».~
@32338 = ~«…тогда я закончу… на сегодня. Я ещё буду читать лекции в этом зале, и, может быть, пройдут годы… и я встречу *вас* как просящего за Вратами Смерти!»~
@32339 = ~Прекратить слушать и уйти.~
@32340 = ~Похоже, ему не терпится завершить лекцию: «…тогда я закончу… э-э, я ещё буду читать лекции в этом зале, так что… это… скажите всем своим друзьям».~
@32341 = ~Прекратить слушать и уйти.~
@32342 = ~Похоже, ему не терпится завершить лекцию: «…тогда я закончу… э-э, я ещё буду читать лекции в этом зале, так что… это… скажите всем своим друзьям».~
@32343 = ~Прекратить слушать и уйти.~
@32344 = ~Кто-то из зала выкрикивает: «Конечно! Чтобы они могли прийти посмотреть, как вы опять обгадите свою тунику!» Комната наполняется смехом…~
@32345 = ~«Э-э… хм-м».~
@32346 = ~Уйти.~
@32347 = ~~
@32348 = ~~
@32349 = ~~
@32350 = ~~
@32351 = ~~
@32352 = ~~
@32353 = ~~
@32354 = ~~
@32355 = ~~
@32356 = ~~
@32357 = ~~
@32358 = ~~
@32359 = ~~
@32360 = ~~
@32361 = ~~
@32362 = ~~
@32363 = ~~
@32364 = ~~
@32365 = ~~
@32366 = ~~
@32367 = ~«„Тайны“?! Погоди-ка! Мы ведь не собираемся на самом деле *слушать* то, что говорит этот пустозвон? Давай же… пойдём найдём малышку из Чующих, которая ещё ни разу не испытала всей страсти поцелуя черепа», — он нетерпеливо покачивает бровями.~
@32368 = ~«Успокойся, Морте. Мы остаёмся… по крайней мере на какое-то время».~
@32369 = ~Не обращать внимания на Морте и продолжать слушать.~
@32370 = ~«Ты прав, Морте, пойдём отсюда».~
@32371 = ~Морте шепчет: «Начало ещё больших страданий».~
@32372 = ~Тихо кивнуть Морте.~
@32373 = ~«Морте, успокойся».~
@32374 = ~Не обращать внимания на Морте и продолжать слушать.~
@32375 = ~«Точно. Уходим, Морте».~
@32376 = ~Морте шепчет: «Это уж точно».~
@32377 = ~Тихо кивнуть Морте.~
@32378 = ~«Морте, успокойся».~
@32379 = ~Не обращать внимания на Морте и продолжать слушать.~
@32380 = ~«И правда. Уходим, Морте».~
@32381 = ~Морте шепчет: «И в вечной скуке».~
@32382 = ~Тихо кивнуть Морте.~
@32383 = ~«Пожалуйста, Морте, тихо».~
@32384 = ~Не обращать внимания на Морте и продолжать слушать.~
@32385 = ~«Точно. Уходим, Морте».~
@32386 = ~Морте шепчет: «Похоже, я знаю, куда мы оба попадём после смерти».~
@32387 = ~Тихо кивнуть Морте.~
@32388 = ~«Морте, завязывай с болтовнёй».~
@32389 = ~Не обращать внимания на Морте и продолжать слушать.~
@32390 = ~«Точно. Уходим, Морте».~
@32391 = ~Морте шепчет: «Это ещё если тебе повезёт».~
@32392 = ~Тихо кивнуть Морте.~
@32393 = ~«Хватит, Морте».~
@32394 = ~Не обращать внимания на Морте и продолжать слушать.~
@32395 = ~«Точно. Уходим, Морте».~
@32396 = ~Морте шепчет: «И это называется стимул? Нам придётся всё делать *снова*? Ух, жду не дождусь, когда снова стану летающим черепом. Ура! К дьяволу его. Ну и олух. Говорит так, будто ни разу не умирал, точно?»~
@32397 = ~Тихо кивнуть Морте.~
@32398 = ~«Перестань, Морте. Потише».~
@32399 = ~Не обращать внимания на Морте и продолжать слушать.~
@32400 = ~«Точно. Уходим, Морте».~
@32401 = ~Морте шепчет: «Это всё одна большая горячая лапша нам на уши».~
@32402 = ~Тихо кивнуть Морте.~
@32403 = ~«Морте, успокойся».~
@32404 = ~Не обращать внимания на Морте и продолжать слушать.~
@32405 = ~«Точно. Уходим, Морте».~
@32406 = ~Морте произносит вслух: «Какая галиматья!»~
@32407 = ~Морте ныряет вниз, за пределы видимости лектора, потом поворачивается к тебе и шепчет: «Давай, шеф. Скажи ему, как всё бывает на самом деле».~
@32408 = ~«Да, у меня есть вопрос…»~
@32409 = ~«Никаких вопросов. Мой друг оговорился».~
@32410 = ~«Великолепно! Ещё одна смерть! Запишите меня!» По рядам слушателей проходит волна веселья. Оратор, похоже, злится.~
@32411 = ~«А что происходит, когда они умирают?»~
@32412 = ~«Я хочу спросить о другом…»~
@32413 = ~«Это всё, что я хотел узнать».~
@32414 = ~«Чё, ищешь работёнку? Есть у меня одно задание. Ты справишься… если только не против иметь дело с трупаками».~
@32415 = ~«Сколько тебе ещё осталось?»~
@32416 = ~«Нет, без бабок я туда не пойду…»~
@32417 = ~«Хм… убедись, что давление не слишком велико».~
@32418 = ~«Не обожгись!»~
@32419 = ~«Как успехи?»~
@32420 = ~«Неплохо».~
@32421 = ~«Осторожно».~
@32422 = ~«Убедись, что ты все делаешь правильно».~
@32423 = ~«Как это так получается?»~
@32424 = ~«Здесь проводник! Проводник!»~
@32425 = ~«Проводник! Доставлю куда угодно, всего один медяк!»~
@32426 = ~«Какие планы на сегодня?»~
@32427 = ~«Вычеркните это из моего списка».~
@32428 = ~«Что у нас следующее, по списку?»~
@32429 = ~«Надо убедится, что у нас достаточно материалов».~
@32430 = ~«Надо узнать, когда будет следующая смена».~
@32431 = ~Страж~
@32432 = ~Деревенский бандит~
@32433 = ~Деревенский бандит~
@32434 = ~Призрачная фигура материализуется из сумрака прохода и быстро перемещается, перекрывая твой путь. Она парит перед тобой, черты, когда-то бывшие человеческими, искажены гневом: «Осквернители! Немедленно покиньте это место!»~
@32435 = ~Воздух вокруг тебя неожиданно становится холоден, как лёд, как только появляется дух-защитник. Снова он парит перед тобой, его призрачные одежды развеваются, словно дуновением некоего лёгкого эфирного ветерка.~
@32436 = ~«Уходи немедленно! — гулкий голос эхом раскатывается по залам. — Это место не для живых. Уходи, пока ещё можешь».~
@32437 = ~«Какая наглость! — оглушительный рёв призрака заставляет прикрыть уши. — Ты был предупреждён… Я более не могу дозволить осквернять это священное место упокоения».~
@32438 = ~«Поищи ответы в другом месте. Здесь убежище для мёртвых. Я не дозволю более нарушать их сон вторжением ещё каких-то нахальных смертных!»~
@32439 = ~«Если хочешь знать… да, есть другой злоумышленник, который по-прежнему продолжает нарушать покой этих священных залов», — ярость в голосе призрака пропадает. Похоже, он опечален: «Души моих братьев и сестёр молят о покое».~
@32440 = ~«Он злобен и труслив, но обладает великой властью над мёртвыми. Он что-то ищет в этих залах… что это и для чего ему это нужно, я не могу сказать».~
@32441 = ~«Не могу. Этот трус заперся во внутренних палатах Мавзолея. Он воздвиг мощный защитный барьер, который преграждает мне вход в эти палаты. Именно оттуда он взывает к тёмным силам, чтобы поднять мёртвых братьев моих и заставить их повиноваться его злой воле».~
@32442 = ~Молчание духа тянется несколько долгих мгновений. Ты почти физически ощущаешь тяжесть его безжизненного взгляда. «Да… ты можешь преуспеть там, где я потерпел неудачу. Если обещаешь, что избавишь меня от этого мерзавца, я тебя пропущу. Что скажешь?»~
@32443 = ~«Да будет так, — призрак медленно растворяется в воздухе, пока не остаётся одно лишь эхо его бестелесного голоса. — Но учти… будь осторожен в этих залах, не то присоединишься к нам в вечном сне».~
@32444 = ~«Приветствую».~
@32445 = ~Немедленно уйти.~
@32446 = ~«Постой, призрак. У меня к тебе есть несколько вопросов…»~
@32447 = ~«Постой, призрак. Я бы хотел помочь тебе избавится от этого злоумышленника».~
@32448 = ~«Неважно. Прощай».~
@32449 = ~«Сначала ответь на пару вопросов…»~
@32450 = ~«Я иду, куда хочу… прочь с дороги, призрак».~
@32451 = ~«Как хочешь. Прощай».~
@32452 = ~«Более не можешь дозволить? А что, ещё кто-то был здесь?»~
@32453 = ~«Да, да. Лучше пойди, детишек поищи, может, они испугаются».~
@32454 = ~«С другой стороны… по-моему, лучше мне уйти. Счастливо».~
@32455 = ~«Ещё? А что, кто-то уже был здесь?»~
@32456 = ~«Я иду, куда хочу… прочь с дороги, призрак».~
@32457 = ~«Как хочешь. Прощай».~
@32458 = ~«А кто он, этот другой?»~
@32459 = ~«Так почему же ты его не выгонишь?»~
@32460 = ~«С другой стороны… по-моему, лучше мне уйти. Счастливо».~
@32461 = ~«Так почему же ты его не выгонишь?»~
@32462 = ~«С другой стороны… по-моему, лучше мне уйти. Счастливо».~
@32463 = ~«Возможно, я бы мог тебе помочь…»~
@32464 = ~«Мне кажется, тебе нужна помощь одного осквернителя, чтобы избавиться от другого».~
@32465 = ~«С другой стороны… по-моему, лучше мне уйти. Счастливо».~
@32466 = ~«Обещаю».~
@32467 = ~«С другой стороны… по-моему, лучше мне уйти. Счастливо».~
@32468 = ~Как только ты входишь в коридор, перед тобой материализуется дух-защитник. Выражение его призрачного лица выглядит вполне доброжелательным: «Благодарю тебя. Ты оказал мне неоценимую услугу. Души моих подопечных снова спят спокойно. Иди с миром… друг». Он исчезает, оставляя тебя одного в пустынных залах Мавзолея.~
@32469 = ~Уйти.~
@32470 = ~Ты видишь человека среднего роста в длинных одеждах насыщенного чёрного цвета. Его волосы тщательно уложены, а аккуратная профессорская бородка подчёркивает приятные черты. Заметив тебя, он откладывает в сторону книгу, в которой что-то писал, и, улыбаясь, уверенно шагает к тебе. «Впечатляет… должен признать, не думал, что ты сможешь сюда добраться».~
@32471 = ~«Кто я такой — это тебя не касается. А вот чего я хочу — это должно волновать тебя гораздо больше», — произнося эти слова, он осматривает тебя с головы до ног, словно очарован тобой.~
@32472 = ~Он делает шаг назад и выгибает бровь дугой: «Я хочу… твоей крови».~
@32473 = ~Человек начинает отвечать, но внезапно останавливается. На его лице появляется дьявольская усмешка, и он начинает хохотать. «Да… я думаю, так оно и есть», — он хохочет ещё больше над собственной, одному ему понятной шуткой. Ты замечаешь, что его руки начинают двигаться. Медленно они порхают вперёд и назад, оставляя запутанные следы в воздухе.~
@32474 = ~«Правда? Ну, на здоровье, попытайся», — он самодовольно улыбается и поднимает руки. Медленно они порхают вперёд и назад, оставляя запутанные следы в воздухе.~
@32475 = ~«Боюсь, никуда ты не пойдёшь», — он самодовольно улыбается и поднимает руки. Медленно они порхают вперёд и назад, оставляя запутанные следы в воздухе.~
@32476 = ~«Счастлив тебя разочаровать… это ты виноват во всей этой истории с ходячими мертвецами?»~
@32477 = ~«Грязный некромант! Я пришёл, чтобы положить конец осквернению тобой этого места».~
@32478 = ~«Прошу прощения за беспокойство. Прощай».~
@32479 = ~«Ладно… так чего же ты хочешь?»~
@32480 = ~«Ты ошибаешься. Меня *не волнует*, чего ты хочешь… я здесь, чтобы убить тебя».~
@32481 = ~«Неважно. Мне надо идти».~
@32482 = ~«Это что, угроза?»~
@32483 = ~«Какое совпадение… я тоже вроде как за кровью пришёл, за твоей. Приготовься умереть!»~
@32484 = ~«Хм… меня это не интересует. Прощай».~
@32485 = ~Атаковать.~
@32486 = ~Истинная Тень~
@32487 = ~Ку'у Йин~
@32488 = ~Радин~
@32489 = ~Ухир~
@32490 = ~Бандит из Мусорных трущоб~
@32491 = ~«Что за чудовище породило *тебя*, братец? — её лицо искажает гримаса отвращения, затем она грубо хохочет. — А какая вонь! Ты кто, один из ублюдков смерти?» Ты замечаешь длинный изогнутый нож, висящий на бедре, её рука лежит на рукояти.~
@32492 = ~«Что за чудовище породило *тебя*, братец? — её лицо искажает гримаса отвращения, затем она грубо хохочет. — А какая вонь! Ты кто, один из ублюдков смерти?» Ты замечаешь длинный изогнутый нож, висящий на бедре, её рука лежит на рукояти.~
@32493 = ~«О, на *это* стоит посмотреть. Скажи-ка мне вот что, „братец“: это ты воняешь как канавы Улья? Или это канавы воняют как *ты*?»~
@32494 = ~Женщина удивлённо моргает.~
@32495 = ~Мгновение она настороженно смотрит на тебя, потом на её лице появляется улыбка. «Наверно, у тебя от ран что-то в голове попуталось, а, братец? — она усмехается. — Я не твоя подруга, да никогда бы и не связалась с таким, как ты».~
@32496 = ~Мгновение она ошарашенно слушает тебя, затем рычит и тянется к оружию.~
@32497 = ~От возмущения у неё даже перехватывает дыхание: «Дурак… ты что, спятил? Стража скорее поверит мне, чем тебе!»~
@32498 = ~Она зло смотрит на тебя, скрипя зубами: «Лучше надейся, что мы не встретимся в другом месте, *собака!*» Затем отворачивается, готовая бежать прочь.~
@32499 = ~Она зло смотрит на тебя, скрипя зубами: «Давай забудем всё это и разойдёмся».~
@32500 = ~«О, конечно. Но сперва… — она прерывается, её губы складываются в злую усмешку, — …один вопрос: может ли кто-нибудь стать таким уродом, как ты, всего за одну жизнь?»~
@32501 = ~Мгновение она слушает тебя, явно застигнутая врасплох, затем рычит и тянется к кинжалу…~
@32502 = ~«Не поворачивайся ко мне спиной, собака. Само твоё присутствие здесь, на этой улице, оскорбляет меня. Ты должен мне возместить, — она выставляет вперёд одну ногу. — Вылижи мой сапог, исчезни с глаз моих, и я тебе всё прощу».~
@32503 = ~Как только ты отворачиваешься и собираешься уходить, она рычит и выхватывает кинжал…~
@32504 = ~Её пронзительный хохот, злорадный и глумливый, отдаётся эхом по всей улице. «А теперь оставайся здесь, трус. Посмеешь заговорить со мной ещё раз, и мой клинок вырежет твоё сердце раньше, чем до меня долетят твои слова».~
@32505 = ~«Свиньи! — визжит она. — Я убью вас обоих!»~
@32506 = ~Как только ты встаёшь перед женщиной на колени, она кладёт руки на бёдра и запрокидывает голову. Её пронзительный хохот, злорадный и глумливый, отдаётся эхом по всей улице.~
@32507 = ~Ты делаешь попытку… но она ловко отступает за пределы досягаемости. «За это ты заплатишь своей *жизнью*, собака!» — она вытаскивает кинжал…~
@32508 = ~Ты хватаешь её ногу и погружаешь зубы в голень. Она визжит от боли, отскакивает в сторону, выхватывая кинжал, похоже, твой укус её отрезвил: «О силы, ты что, *ПСИХ?!*»~
@32509 = ~Она заметно содрогается, смесь недоверия и отвращения расползается по её лицу. «Фу! Надеюсь больше никогда тебя не увидеть! Чудовище…» — она отворачивается и уходит.~
@32510 = ~Ты хватаешь её за лодыжки и дёргаешь так, что земля уходит из-под её ног. На мгновение она повисает в воздухе с раскрытым от неожиданности ртом — затем падает на дорогу, болезненно *стукаясь* о мощёную улицу. На ноги она вскакивает с горящими яростью глазами: «Я тебя *убью!*» Она выхватывает кинжал…~
@32511 = ~«Дело в самом кошмарном *уродстве*, братец, — она с отвращением ухмыляется. — Просто посмотришь на тебя, так уже тошнота подступает».~
@32512 = ~«О нет, нет… я никогда не смогу стать такой, как ты, братец. Очень *немногие* едят собственное дерьмо».~
@32513 = ~«Думаю, дружок, правильный вопрос в том, что это так *воняет*? — она принюхивается к воздуху и морщит нос от отвращения. — Ну конечно, думаю, это ты! Наверняка ты, червивый остаток человека!»~
@32514 = ~«Что за чудовище породило *тебя*, дружок? — её лицо искажает гримаса отвращения, внезапно она начинает хохотать. — А какая вонь! Ты кто, один из ублюдков смерти?» Ты замечаешь длинный изогнутый нож, висящий на бедре, её рука лежит на рукояти…~
@32515 = ~Мгновение девушка выглядит сбитой с толку, потом узнаёт Падшую Грейс. Кажется, она испугана и смущена: «Мадам Грейс! Стыдно сказать, но… я вас не заметила, и это при всём благородстве вашего внешнего вида, очевидном даже тупице».~
@32516 = ~Она выглядит пристыженной: «Да, мадам… я сожалею о тех словах, которые были произнесены в вашем присутствии».~
@32517 = ~«Гм… — она хмурится, но потом самообладание возвращается к ней. — В любом случае, мадам, что привело вас сюда? Какие-то важные дела?»~
@32518 = ~Сархава низко кланяется. «Тогда позвольте мне принести извинения, мадам Грейс. Вам и вашим компаньонам. Мне не следовало так говорить. Это всё из-за спиртного. Я такого наговорила, и мне очень стыдно за унижение перед моим старым учителем», — она кланяется, отворачивается и уходит.~
@32519 = ~«Ну-ну… что тут у нас? Маленькая тифлинг, королева сточной канавы, только что выползла из Улья? — женщина причмокивает и надувает губы, словно разговаривает с маленьким ребёнком. — Неужели ты потерялась, маленькая тифлинг? Ой, гляньте! Да у неё хвост! Как… мило!»~
@32520 = ~«Эй, отродье, не стоит этого делать, — женщину, кажется, не особо беспокоит, что Анна обнажила оружие, она неодобрительно щёлкает языком. — Будь осторожнее, а то я отрежу тебе хвостик и скормлю его моим собачкам».~
@32521 = ~«Ты мерзкое отродье Нижних планов, сучка, которую даже танар'ри не станет держать в своём загоне!» — она выхватывает клинок.~
@32522 = ~«А *это* ещё что?! Гит? Так *далеко* от круговерти выгребных ям Лимбо, этого сортира всех планов?» — её глаза сужаются в ожидании ответа Дак'кона.~
@32523 = ~Она хмурится: «Я думала, твоему племени комфортнее среди плотоядных жаб, которые резвятся в Лимбо, гит».~
@32524 = ~Минуту она ждёт ответа, а затем продолжает попытки разозлить Дак'кона: «Почему бы тебе, не вернуться в Лимбо, гит?» Она немного задумывается, поглаживая подбородок. «Или ваш народец живёт на Астральном плане? Я всё время путаю — гитиянки, гитцерай, кто вас там разберёт…»~
@32525 = ~Неожиданно улыбка озаряет её лицо. «О! Расскажи-ка мне какую-нибудь шутку, гит! — она хлопает в ладоши от восторга. — Озари меня прославленным юмором своей расы, *гитиянки*!»~
@32526 = ~Она откровенно глумится над Дак'коном: «А когда я тебя увидела на улицах Сигила, гит, юная Сархава посмотрела на это убожество и сказала: „Да это даже не стоит того, чтобы на него плюнули“. Вы — никто, просто безбожные собаки *гитиянки*, вы можете лишь сношаться с лягушками». Она хватается за рукоять кинжала: «Вытаскивай свой тупой ножик, уродец».~
@32527 = ~Она ждёт, но Дак'кон всё ещё молчит. «Я бы хотела, чтобы пожиратели разума по-прежнему держали вас в рабстве, гит, и избавили мультивселенную от опасности вашего распространения».~
@32528 = ~Дак'кон по-прежнему молчит как камень. Женщина рычит и готовится к броску: «Отправляйся в Баатор, трус!»~
@32529 = ~Женщина, явно застигнутая врасплох, не отвечает.~
@32530 = ~«Что… кто… да как ты сме…»~
@32531 = ~«Я… я…»~
@32532 = ~Женщина выхватывает свой клинок и бросается на Морте, рыча, как разъяренный зверь.~
@32533 = ~Женщина отказывается с тобой разговаривать.~
@32534 = ~Женщина ухмыляется и вытягивает носок ноги вперёд: «Вернулся ещё попробовать мой сапог, пёс? Ну так ты его не получишь! Разве я тебе не говорила больше со мной не заговаривать? Пошёл прочь, пока я клинок не достала».~
@32535 = ~Сархава приветствует тебя кивком головы, но не говорит ни слова.~
@32536 = ~«Приветствую…»~
@32537 = ~«Приветствую…»~
@32538 = ~«Приветствую…»~
@32539 = ~«Приветствую…»~
@32540 = ~Держаться от неё подальше.~
@32541 = ~«*Что* ты сказала, девчонка?»~
@32542 = ~Блеф: «Адана? Это ты?»~
@32543 = ~«Да что с тобой?»~
@32544 = ~«Я не ищу с тобой ссоры. Давай забудем всё это и разойдёмся».~
@32545 = ~Напасть на неё.~
@32546 = ~Игнорировать её и уйти.~
@32547 = ~«*Что* ты сказала, девчонка?»~
@32548 = ~Блеф: «Адана? Это ты?»~
@32549 = ~«Да что с тобой?»~
@32550 = ~«Я не ищу с тобой ссоры. Давай забудем всё это и разойдёмся».~
@32551 = ~Напасть на неё.~
@32552 = ~Игнорировать её и уйти.~
@32553 = ~«Адана? Ты меня разве не помнишь?»~
@32554 = ~«Я же сказал тебе, Адана: я никогда не любил тебя и никогда не буду. То, прямо скажем, небольшое удовольствие, которое ты мне доставила, никак не сравнить с кошмаром твоего присутствия. А теперь оставь меня».~
@32555 = ~«О… мои извинения. Я думал, что ты Адана, но ты страшнее в два раза и пахнешь ещё хуже, чем она».~
@32556 = ~«Неважно. Прощай».~
@32557 = ~«О… мои извинения. Я думал, что ты Адана, но ты страшнее в два раза и пахнешь ещё хуже, чем она».~
@32558 = ~«Неважно. Прощай».~
@32559 = ~Сразиться с ней.~
@32560 = ~Позвать стражу.~
@32561 = ~«Ты очевидно пьяна, а по шрамам видно, что много дерёшься… и, вероятно, уже имеешь кое-какую известность в подобного рода вещах. Так что вряд ли».~
@32562 = ~«Ты очевидно пьяна, а по шрамам видно, что много дерёшься. Так что вряд ли».~
@32563 = ~«О, я надеюсь, *встретимся*…»~
@32564 = ~Зевнуть со скучающим видом, пока она не ушла.~
@32565 = ~«Прощай».~
@32566 = ~«Согласен, ты и так уже потратила море моего времени. Бывай».~
@32567 = ~«Согласен. Прощай».~
@32568 = ~«Да… и ты ходячее тому доказательство».~
@32569 = ~Напасть на неё.~
@32570 = ~Уйти.~
@32571 = ~Сразиться с ней.~
@32572 = ~Позвать стражу.~
@32573 = ~Встать на колени и лизать её сапог.~
@32574 = ~Встать на колени и лизать её сапог.~
@32575 = ~Встать на колени и лизать её сапог.~
@32576 = ~Склониться к её сапогу, ожидая возможности ударить.~
@32577 = ~Напасть на неё.~
@32578 = ~Не обращать внимания на её угрозы и уйти.~
@32579 = ~Сразиться с ней.~
@32580 = ~Позвать стражу.~
@32581 = ~«Ладно, с меня хватит. Давай посмотрим, как ты обращаешься с этим ножиком, девочка».~
@32582 = ~Уйти.~
@32583 = ~Откусить кусок её ноги.~
@32584 = ~Откусить кусок её ноги.~
@32585 = ~Дернуть её за ноги.~
@32586 = ~Дернуть её за ноги.~
@32587 = ~Просто облизать её сапог.~
@32588 = ~Сразиться с ней.~
@32589 = ~Позвать стражу.~
@32590 = ~Улыбнуться и слизнуть кровь с губ.~
@32591 = ~«Сегодня я не лижу сапоги, девчонка. А теперь уходи, пока я не откусил кусок покрупнее».~
@32592 = ~Просто уйти.~
@32593 = ~Пощёлкать ей вслед зубами.~
@32594 = ~Пощёлкать ей вслед зубами.~
@32595 = ~«Прощай».~
@32596 = ~«Прощай».~
@32597 = ~Молча смотреть вслед.~
@32598 = ~Молча смотреть вслед.~
@32599 = ~Сразиться с ней.~
@32600 = ~Позвать стражу.~
@32601 = ~«Не это ли сказала твоя мамаша, когда ты родилась?»~
@32602 = ~«Уйду-ка я лучше, девочка, пока с тобой не случилось то же, что и со мной».~
@32603 = ~Напасть на неё.~
@32604 = ~Игнорировать её и уйти.~
@32605 = ~«Ещё раз откроешь рот, девчонка, и я прослежу, чтобы ты его попробовала».~
@32606 = ~«Если бы мне захотелось дерьма, я бы его из твоей головы выдавил, девка».~
@32607 = ~Напасть на неё.~
@32608 = ~Игнорировать её и уйти.~
@32609 = ~Блеф: «Погоди-ка… я тебя узнал. Адана!»~
@32610 = ~Блеф: «Погоди-ка… я тебя узнал. Адана!»~
@32611 = ~«Да что с тобой?»~
@32612 = ~«Я не ищу с тобой ссоры. Давай забудем всё это и разойдёмся».~
@32613 = ~Напасть на неё.~
@32614 = ~Игнорировать её и уйти.~
@32615 = ~«Очевидно, ты гораздо хуже тупицы, девчонка».~
@32616 = ~Позволить Грейс продолжить разговор.~
@32617 = ~Уйти.~
@32618 = ~«Довольно, девчонка. Извинись перед ней, пока я не начал отрезать кусочки от *тебя*».~
@32619 = ~«Довольно, девчонка. Извинись перед ней, пока я не начал отрезать кусочки от *тебя*».~
@32620 = ~Позволить Анне разобраться с ней.~
@32621 = ~«Не бери в голову, Анна. Она того не стоит».~
@32622 = ~«Спрячь этот клинок, девка, или я его у тебя между рёбер спрячу».~
@32623 = ~«Спрячь этот клинок, девка, или я его у тебя между рёбер спрячу».~
@32624 = ~Позвать стражу.~
@32625 = ~Не вмешиваться в события.~
@32626 = ~«Возможно, *тебе* будет комфортнее в Мортуарии, девчонка».~
@32627 = ~«Возможно, *тебе* будет комфортнее в Мортуарии, девчонка».~
@32628 = ~Позволить Дак'кону разобраться с ней.~
@32629 = ~Ждать развития событий.~
@32630 = ~«Этого более чем достаточно, девочка. Замолчи».~
@32631 = ~«Этого более чем достаточно, девочка. Замолчи».~
@32632 = ~Напасть на неё.~
@32633 = ~«Атакуй её, Дак'кон».~
@32634 = ~Подождать реакции Дак'кона.~
@32635 = ~«Этого более чем достаточно, девочка. Замолчи».~
@32636 = ~«Этого более чем достаточно, девочка. Замолчи».~
@32637 = ~Напасть на неё.~
@32638 = ~«Атакуй её, Дак'кон».~
@32639 = ~Подождать реакции Дак'кона.~
@32640 = ~Помочь Дак'кону в схватке.~
@32641 = ~Позвать стражу.~
@32642 = ~Не вмешиваться в события.~
@32643 = ~Помочь Морте в схватке.~
@32644 = ~Позвать стражу.~
@32645 = ~Не вмешиваться в события.~
@32646 = ~Уйти.~
@32647 = ~«С меня хватит, девка… доставай свой клинок».~
@32648 = ~Остаться и сразиться с ней.~
@32649 = ~Уйти.~
@32650 = ~Уйти.~
@32651 = ~«Что скажешь, шеф, заткнуть рот этой психованной чувихе?»~
@32652 = ~«Мне нравятся твои безумные методы, шеф».~
@32653 = ~Когда ты встаёшь перед ней на колени, Морте выкрикивает: «Шеф! Да ты меня разыгрываешь! В смысле, если только ты *чего-нибудь* не задумал…»~
@32654 = ~«Ну, в этом есть смысл… но всё же…»~
@32655 = ~Морте хихикает и щёлкает зубами: «Да ты прям настоящий дамский угодник, ага, шеф?»~
@32656 = ~«Ой-ой…»~
@32657 = ~Морте подмигивает тебе и кричит женщине: «Эй, ты! Да, ты там, маленькая дерзкая уличная девка… смотри на меня, когда я с тобой разговариваю! Что же тебя так огорчило, а?»~
@32658 = ~«Ой, неужели маленькая Принцесса Пустыни надела свои брючки потому, что султан на самом деле хотел сына? Скажи-ка мне, „Принцесса Пустыни“, ты всегда такая по ночам — пьяная и драчливая, с кучкой таких же пьяных подхалимов, ищешь собственные, не очень удачные способы доказать что-то своему разочарованному отцу?»~
@32659 = ~«Ты правда думаешь, что, избив всех вокруг, наконец почувствуешь себя лучше? Почувствуешь, что чего-то *стоишь*? Ведь на деле ты ДЕШЁВКА! Если это и есть твой жалкий и мелочный способ лучше понять, кто ты *такая*, то советую тебе просто сдаться, пойти домой и продаться в гарем кому-нибудь из придворных!»~
@32660 = ~Морте поворачивается к тебе: «Понимаешь, шеф, я-то *знаю*, что здесь сейчас случится. Мы *все* знаем, что Морте в таком не ошибается. О нет, маленькой и гордой Принцессе Пустыни сбили спесь прилюдно, какое унижение…»~
@32661 = ~«Никакой жалости, Морте».~
@32662 = ~«Нет, Морте… я сам с ней разберусь».~
@32663 = ~Не обращать внимания на Морте и лизать ей сапог.~
@32664 = ~«Я просто не хочу неприятностей, Морте. Если я не буду осторожен, она может вызвать стражу».~
@32665 = ~«Ты прав, Морте. Уходим».~
@32666 = ~«Забудь, Морте. Послушай, мадам… давай прекратим это, пока я сам не вызвал стражу».~
@32667 = ~«Ты прав, Морте. Уходим».~
@32668 = ~Как только ты встаёшь перед женщиной на колени, Анна яростно шипит: «Ты ж это не *всерьёз*! Просто распотроши эту жеманную шлюшку, дурак! Вот… я это сделаю за тебя…»~
@32669 = ~Ты пытаешься защитить женщину; Анна останавливается, огорошенно уставившись на тебя: «Что… ты… ты совсем *спятил*?»~
@32670 = ~Анна, скорчив презрительную гримасу, плюёт ей под ноги. Удивительно, но женщина даже не пытается атаковать. «Отвратительно, вот что… просто отвратительно», — Анна принимается бормотать что-то себе под нос; ты можешь разобрать слова «вялый» и «ствол».~
@32671 = ~Анна злобно смотрит на Грейс и Сархаву.~
@32672 = ~Анна вспыхивает, и в мгновение ока в её кулаках появляются клинки.~
@32673 = ~«Ага, у маленькой девочки острый язычок, — Анна сплёвывает и проводит одним клинком по другому. — Мне охота посмотреть, как мило будут смотреться твои побрякушки и шлюхино тряпьё, када будешь валяться мёртвой!»~
@32674 = ~«Анна, постой!»~
@32675 = ~«Всего за один медяк я покажу дорогу! Проводник!»~
@32676 = ~«*Не-е-ет!*»~
@32677 = ~«Я тя убью, обещаю!»~
@32678 = ~«Я тя ща порежу, будь уверен!»~
@32679 = ~«Я насажу твоё сердце на нож, трус!»~
@32680 = ~«Ты сдохнешь, пидор!»~
@32681 = ~«А-а-ргх…»~
@32682 = ~«Фьють… сюда».~
@32683 = ~«Безмолвно повествуют стены хаос пророчеств».~
@32684 = ~«Надписи говорят, словно пророки в залах».~
@32685 = ~«Я? Откуда мне знать, что ТЫ этого не делал, четырёхногая куча дерьма!»~
@32686 = ~«Ну, ну, ну…»~
@32687 = ~«Возьмём чуток меди с этого пня?»~
@32688 = ~«Кто ты?»~
@32689 = ~«Анна, постой!»~
@32690 = ~Встать между Анной и женщиной.~
@32691 = ~Напасть на неё вместе с Анной.~
@32692 = ~Дать Анне порезвиться.~
@32693 = ~«Тут не Улей, Анна… мы не можем просто взять и убить кого нам заблагорассудится. Случись что, и стражу вызовут, моргнуть не успеешь».~
@32694 = ~«Ладно тебе, Анна, просто пошли отсюда».~
@32695 = ~«Послушай, мадам… нам не нужны неприятности. Давай прекратим это, пока я сам не вызвал стражу».~
@32696 = ~«Ладно тебе, Анна, просто пошли отсюда».~
@32697 = ~«Юная Сархава? Сархава Вьюл, неужели это ты?»~
@32698 = ~Падшая Грейс отвешивает самый незаметный из возможных поклонов: «Ты только что произнесла мастерски выбранные слова, совсем не те, что мы слышали ранее».~
@32699 = ~«А я сожалею, что они вообще были произнесены, — её тон практически не меняется, но, похоже, еле уловимый упрёк заставляет девушку поморщиться, как от удара. — Больно видеть мою старую ученицу, опустившуюся до такого…»~
@32700 = ~«Это мои компаньоны. И я ожидаю, что к ним будет проявлена та же любезность, что и ко мне. Этим, вообще-то, должны отличаться люди… благородного происхождения».~
@32701 = ~Дождаться ответа.~
@32702 = ~Дождаться ответа.~
@32703 = ~Дак'кон и бровью не ведёт в ответ на слова женщины, он просто смотрит прямо перед собой.~
@32704 = ~Дак'кон по-прежнему ничего не отвечает, словно женщины для него попросту не существует.~
@32705 = ~Неожиданно Дак'кон говорит глубоким баритоном, словно поучая маленького ребёнка: «Когда Зертимон прошёл на пустошь Глины и дороги гитцерай пересеклись с человеческими, он сказал, что много удивительного в делах их, но также он сказал, что им предстоит трудный путь к преодолению собственного невежества…»~
@32706 = ~Дак'кон продолжает свою «шутку»: «Как и все люди, сказал Зертимон, они говорят о великом, но делают малое, и потому опасен их пример. Человечество — это кошмар во плоти, опасны люди без истории и возможности учиться на ошибках предков».~
@32707 = ~Прекратить слушать и уйти.~
@32708 = ~Внезапно мужчина окидывает аудиторию мрачным взглядом, словно что-то высматривая: «И ещё, если тут есть танар'ри или баатезу, то пусть валят отсюда ко всем чертям. Я не позволю вам, вспыльчивые ублюдки, навострять тут уши и не хочу потом слушать ваши дебильные доводы…»~
@32709 = ~Слушать дальше.~
@32710 = ~Прекратить слушать и уйти.~
@32711 = ~«…потому как это не спор о том, кто виноват, — за своей спиной ты слышишь звуки чего-то огромного, покидающего зал. — Просто я говорю о Кровавой Войне с точки зрения человека. Я не буду ни за ту, ни за другую сторону: *все* они сволочи, каждый по-своему».~
@32712 = ~Слушать дальше.~
@32713 = ~Прекратить слушать и уйти.~
@32714 = ~Оратор мрачнеет: «Так вот… те, кто остались, наверняка хотят услыхать кой-чего о Кровавой Войне… рассказы о *Войне*. Тута вы услышите обо всех её *кошмарах*, эт уж точно. Летающие крепости, сплетённые из человеческой кожи! Поля битвы размером с планы, где разгорелась Кровавая Война!»~
@32715 = ~Слушать дальше.~
@32716 = ~Слушать дальше.~
@32717 = ~Прекратить слушать и уйти.~
@32718 = ~Он скалит свои жёлтые зубы: «Рассказы про демонов, вонзающих клыки в других демонов! Грар-р-р! Снар-р-р!» Его рык стихает, и он выглядит неожиданно уставшим.~
@32719 = ~Слушать дальше.~
@32720 = ~Прекратить слушать и уйти.~
@32721 = ~«Ну а щас я скажу самое главное, и пусть это отложится в ваших черепушках: это всё куча вонючей ереси, что переполняет эту кузницу дерьма», — он с издёвкой сплёвывает, дико закатывая глаза.~
@32722 = ~Слушать дальше.~
@32723 = ~Прекратить слушать и уйти.~
@32724 = ~«Я вам *вот что* скажу: даже не пытайтесь *вообразить* тот размах, с которым ведётся Кровавая Война. Вы такого не видели, не слышали и не участвовали — просто *не с чем* сравнить. Время, число „легионов“, жестокость бойни… не с чем сравнить, пни. Охота себе такое представить? Забудьте. Мой совет? Всё просто: держитесь подальше от всего этого большого кровавого месилова».~
@32725 = ~Слушать дальше.~
@32726 = ~Прекратить слушать и уйти.~
@32727 = ~«Всё, что вам надо знать, — это что изверги режутся с извергами. Баатезу мочат танар'ри, танар'ри рубят в капусту баатезу. Прямо щас, — он снова сплёвывает. — Никто не побеждает. Да никто и не *может* победить. Самый большой пат по эту сторону вечности… и слава силам».~
@32728 = ~Слушать дальше.~
@32729 = ~Прекратить слушать и уйти.~
@32730 = ~«Вот так вот, — он пожимает плечами. — Вот так. А теперь я буду отвечать на вопросы, если они есть…»~
@32731 = ~Задать вопрос.~
@32732 = ~Промолчать.~
@32733 = ~«Ладно… вот ещё, самая малость. Некоторые из вас — Чующие. Так вот что я вам хочу сказать: не пытайтесь узнать на себе, что ж это за грёбаная Кровавая Война такая. Не будьте чокнутыми идиотами. Пользуйтесь камнями чувств, если надо знать, но ни в коем разе не суйтесь на Кровавую Войну взаправду».~
@32734 = ~Слушать дальше.~
@32735 = ~Прекратить слушать и уйти.~
@32736 = ~«Оно того не стоит. Оно… — на мгновение выражение страшной боли затмевает его лицо, кажется, будто оратор вот-вот разрыдается, — …совсем того не стоит. Это конец сегодняшней лекции, всем пока».~
@32737 = ~Уйти.~
@32738 = ~«Задавай свой вопрос, здоровяк».~
@32739 = ~«Можешь рассказать мне чуть больше о самой Кровавой Войне?»~
@32740 = ~«Из-за чего началась Кровавая Война?»~
@32741 = ~«Как нанимают для участия в Кровавой Войне?»~
@32742 = ~«Где проходят сражения Кровавой Войны?»~
@32743 = ~«Как выжить на Кровавой Войне?»~
@32744 = ~«Опиши танар'ри».~
@32745 = ~«Опиши баатезу».~
@32746 = ~«Так ты не расскажешь нам историй о Кровавой Войне?»~
@32747 = ~«Хочешь знать, как выжить на Кровавой Войне? Три правила, здоровяк», — он поднимает искалеченную руку, на которой осталось только два пальца.~
@32748 = ~«Продолжай…»~
@32749 = ~«Постой… позволь спросить кое о чём другом…»~
@32750 = ~«А впрочем, неважно. Вопросов больше нет».~
@32751 = ~«Во-первых, держаться от неё подальше. Во-вторых, держаться от неё на адски подальше. И наконец… находиться от неё охренеть как далеко».~
@32752 = ~«Продолжай…»~
@32753 = ~«Постой… позволь спросить кое о чём другом…»~
@32754 = ~«А впрочем, неважно. Вопросов больше нет».~
@32755 = ~«Если однажды ты проснёшься, а Война у твоего порога, то позволь соображалке отвесить себе дюжий пинок, чтоб бежать так быстро и далеко, как только сможешь. Не можешь бежать — ложись, лежи *очень тихо* и молись, чтоб не заметили, — на мгновение он прерывается. — Вот только нет такого места, где можно спрятаться, и нет такого далека, куда от неё можно сбежать».~
@32756 = ~«Но если бежать некуда, почему же изверги не сражаются на улицах Сигила?»~
@32757 = ~«Что-нибудь ещё?»~
@32758 = ~«Позволь спросить о другом…»~
@32759 = ~«У меня больше нет вопросов».~
@32760 = ~«Да, вот ещё: что б ты ни делал, не *говори* о Кровавой Войне *ни с кем* из извергов… да и с дэвом или архоном, если на то пошло. Просто не заговаривай на эту тему и точка, ведь никогда не знаешь, с кем ты — ад его дери — разговариваешь. А они все просто бесятся от разговоров о Войне. Это ж смысл их жизни».~
@32761 = ~«Что-нибудь ещё?»~
@32762 = ~«Позволь спросить о другом…»~
@32763 = ~«У меня больше нет вопросов».~
@32764 = ~Он кивает: «Не лезь в портал, если только не знаешь охрененно точно, куда он ведёт. Не слыхал, наверно, историй о бестолковых путешественниках по планам, входивших в портал и кончавших свои дни в самом сердце мясорубки Кровавой Войны. А знаешь, почему не слыхал? Да потому что все они мертвы, мертвы, *мертвы*».~
@32765 = ~«Что-нибудь ещё?»~
@32766 = ~Опустить её тело.~
@32767 = ~«Позволь спросить о другом…»~
@32768 = ~«У меня больше нет вопросов».~
@32769 = ~«И ни в коем разе не подписывай никаких контрактов. Неважно, сколько бабок они тебе покажут в шляпе. Верная смерть и подписание договора о вылазке на Кровавую Войну — одно и то же, здоровяк».~
@32770 = ~«Почему это?»~
@32771 = ~«Позволь спросить о другом…»~
@32772 = ~«У меня больше нет вопросов».~
@32773 = ~«Скорее всего, при подписании контракта тебя просто надуют и контракт закончится вместе с твоей жизнью. И даже смерть не принесёт избавления, потому что тогда ты окажешься на Нижних планах и вылезешь оттуда чем-то ещё более кошмарным, чем был изначально. И тогда ты попадёшь в их лапы на всю оставшуюся вечность».~
@32774 = ~«А как *ты* выбрался из всего этого? Как освободился от контракта?»~
@32775 = ~«Значит, смерть в Кровавой Войне — самое ужасное?»~
@32776 = ~«Позволь спросить о другом…»~
@32777 = ~«У меня больше нет вопросов».~
@32778 = ~«Если ты был злым, конечно. Если душа у тебя добрая — ты отправишься к своей загробной жизни на другой план. Но всё равно ты будешь мёртв. А что касается меня, то у меня в душе полно дерьма, от которого я бы хотел избавиться, так что если б я погиб на Нижних планах, я б попал как кур в ощип».~
@32779 = ~«Мы попадаем на другие планы после смерти? Не мог бы ты мне это разъяснить?»~
@32780 = ~«А как *ты* выбрался из всего этого? Как освободился от контракта?»~
@32781 = ~«Позволь спросить о другом…»~
@32782 = ~«У меня больше нет вопросов».~
@32783 = ~«Если хошь просветиться на эту тему — про смерть тут другой лектор, с ним потолкуй. Я не смогу так складно всё объяснить, как он. Правда, он полный кретин и, скорее всего, ошпарит тебя кипятком, что брызжет у него изо рта».~
@32784 = ~«А как *ты* выбрался из всего этого? Как освободился от контракта?»~
@32785 = ~«Позволь спросить о другом…»~
@32786 = ~«У меня больше нет вопросов».~
@32787 = ~Глаз~
@32788 = ~«Ой, слушай, здоровяк: они бились здесь… несколько раз. Порой нам достаются кое-какие „издержки“ Войны. Наша Госпожа Боли, благослови её стальное сердце, гасит эти вспышки…»~
@32789 = ~«Продолжай…»~
@32790 = ~«Постой… позволь спросить кое о чём другом…»~
@32791 = ~«А впрочем, неважно. Вопросов больше нет».~
@32792 = ~«…*порой*», — он ухмыляется. «Бывали такие кошмарные времена… такие времена, что дрожали-от-ужаса-так-блин-страшно. Времена, когда войска успевали прожечь и протоптать свой путь сквозь жилые кварталы Сигила, прежде чем Госпожа решала подмести в доме, — он щёлкает языком и цинично подмигивает. — Так что она не всегда так уж стремится остановить Кровавую Войну, как может показаться, ясно?»~
@32793 = ~«Почему изверги просто не захватят Сигил?»~
@32794 = ~«Позволь спросить о другом…»~
@32795 = ~Увеличительное стекло~
@32796 = ~Шлем~
@32797 = ~Татуировка~
@32798 = ~Грудная клетка~
@32799 = ~Зубы~
@32800 = ~Палец~
@32801 = ~Рука~
@32802 = ~Запястье~
@32803 = ~Арбалет~
@32804 = ~Арбалетная стрела~
@32805 = ~«У меня больше нет вопросов».~
@32806 = ~Он смеётся, но смех переходит в жуткий кашель. «Не пойми меня неправильно: и танар'ри, и баатезу люто хотят дорваться до Сигила. Это ж лучшее поле боя во всей долбаной мультивселенной, ведь Клетка — эт Город Дверей, которые ведут *куда угодно*. Нельзя с этим не считаться. А если уж участвуешь в Кровавой Войне и хошь победить, так ты просто *обязан* захватить её».~
@32807 = ~«Продолжай…»~
@32808 = ~«Постой… позволь спросить кое о чём другом…»~
@32809 = ~«А впрочем, неважно. Вопросов больше нет».~
@32810 = ~Он снова заходится в приступе кашля. «Правда, изверги не смогут *заполучить* её, пока на страже Госпожа. Она крепче гвоздей, а клинки её вонзаются в плоть глубже, чем клыки извергов. Она этих злыдней гнёт в бараний рог, просто не поверишь. Одна единственная молчаливая Госпожа, с руками, вечно спрятанными в рукавах, в одиночку сдерживает натиск целой Кровавой Войны», — он едко смеётся.~
@32811 = ~«Но ведь извергам по-прежнему разрешено находиться в Сигиле?»~
@32812 = ~«Позволь спросить о другом…»~
@32813 = ~«У меня больше нет вопросов».~
@32814 = ~«О, эт уж точно. Им нельзя буянить на улицах… слишком часто. А так, в качестве нейтральной территории Сигил позволяет им потрещать языками без попыток убить друг друга. Порой они тут даже договариваются друг с другом. Правда, мир — штука недолговечная…»~
@32815 = ~«Продолжай…»~
@32816 = ~«Постой… позволь спросить кое о чём другом…»~
@32817 = ~«Неважно. Вопросов больше нет».~
@32818 = ~«И хоть им и нельзя мочить друг друга на улицах, это не значит, что шпионы, вербовщики и убийцы здесь не водятся. Их оружие на этой территории — ложь и словоблудие, пень. Порой там сплошь околесица и громкая трескотня. Ещё здесь есть безопасные дома. Места, где они могут остыть перед новой резнёй…»~
@32819 = ~«Продолжай…»~
@32820 = ~«Постой… позволь спросить кое о чём другом…»~
@32821 = ~«А впрочем, неважно. Вопросов больше нет».~
@32822 = ~«И вербовать они тоже любят. Ищут, как правило, мальчишек без особых моральных устоев, для которых планы ещё в новинку. Таких они стараются призвать в свою великую армию, — он прерывается и вглядывается тебе в лицо. — Наверно, они и тебя уже вербовали, а, здоровяк? Похоже, ты уже хлебнул из котла Войны».~
@32823 = ~«Сомневаюсь».~
@32824 = ~«Может быть».~
@32825 = ~«Сомневаюсь».~
@32826 = ~Главные ворота Мортуария~
@32827 = ~Главный зал~
@32828 = ~Лестница на второй этаж~
@32829 = ~Северо-западный мемориальный зал~
@32830 = ~Центральный зал~
@32831 = ~Лестница на второй этаж~
@32832 = ~Юго-восточный мемориальный зал~
@32833 = ~Юго-западная препарационная~
@32834 = ~Вход в Мавзолей~
@32835 = ~Лестница вверх/вниз~
@32836 = ~Приёмная~
@32837 = ~Комната для бальзамирования~
@32838 = ~Лестница вверх/вниз~
@32839 = ~Юго-восточная препарационная~
@32840 = ~Южное хранилище~
@32841 = ~Лестница на второй этаж~
@32842 = ~Северное хранилище~
@32843 = ~Крематорий~
@32844 = ~Лестница на второй этаж~
@32845 = ~Лестница к кабинкам Борделя~
@32846 = ~Покои Ивес~
@32847 = ~Покои Кимази~
@32848 = ~Покои Долоры~
@32849 = ~Покои Кезай-Серрис~
@32850 = ~Покои Мариссы~
@32851 = ~К Внутренней палате~
@32852 = ~Покои Вивьен~
@32853 = ~Покои Экко~
@32854 = ~Бандит из Мусорных трущоб~
@32855 = ~Прочный кристаллический резервуар с несколькими замороженными внутри рыбами.~
@32856 = ~Воздух, вырывающийся из пасти этой гигантской печи, до невозможности горяч. Попробуешь пройти хоть пару шагов вдоль арки, и твои волосы и плоть моментально сгорят.~
@32857 = ~Правая серьга~
@32858 = ~Кастет~
@32859 = ~Медные монеты~
@32860 = ~Документ о займе~
@32861 = ~Укус Тропотоки~
@32862 = ~Кулак зомби, слабый (Lunge)~
@32863 = ~Предмет иммунитета +1~
@32864 = ~Серьга Анархиста #1~
@32865 = ~Серьга Анархиста #2~
@32866 = ~Серьга Анархиста #3~
@32867 = ~Дневник Страхана~
@32868 = ~Ключ от жилища~
@32869 = ~Лунный топор~
@32870 = ~Это невидимое оружие, используемое Тропотокой. Оно причиняет 2-16 пунктов рубящего урона.~
@32871 = ~КЛЮЧ ОТ ЖИЛИЩА
Вес: 0

Этот маленький плоский ключ изготовлен из кованого железа, и не совсем ясно, к чему он может подойти.~
@32872 = ~Это невидимое дробящее оружие для большого существа уровня 4-6.~
@32873 = ~Это невидимое дробящее оружие для среднего существа уровня 1-3.~
@32874 = ~Это невидимое дробящее оружие для среднего существа уровня 7-9.~
@32875 = ~Это невидимое дробящее оружие для среднего существа уровня 10-13.~
@32876 = ~Это невидимое колющее оружие для среднего существа уровня 1-3.~
@32877 = ~Это невидимое колющее оружие для среднего существа уровня 4-6.~
@32878 = ~Это невидимое колющее оружие для среднего существа уровня 7-9.~
@32879 = ~Это невидимое колющее оружие для среднего существа уровня 10-13.~
@32880 = ~Это невидимое рубящее оружие для среднего существа уровня 1-3.~
@32881 = ~Это невидимое рубящее оружие для среднего существа уровня 4-6.~
@32882 = ~ДНЕВНИК СТРАХАНА
Вес: 1

Этот переплетённый в кожу том потрескался и поистёрся от времени. На его поверхности выжжено что-то вроде герба. Ты можешь разглядеть несколько сцепленных треугольников рядом с инициалами С. Р. Т. Письмена на страницах сильно потускнели, но несколько последних записей, похоже, были добавлены совсем недавно:

«2-й день 127-го года правления Фактола Хашкара:

Наконец-то я нашёл её! Пропавшая страница Гримуара Ап'тардж теперь в моих руках. Как я и думал, она содержит список необходимых компонентов для заклинания окончательного превращения. У меня есть все компоненты, кроме одного. Капля крови бессмертного — это всё, что стоит между мной и вечной силой нежизни. Но где мне найти такую редкость? Наверное, я должен поискать ответ в предсказаниях.

14-й день 127-го года правления Фактола Хашкара:

После нескольких дней обременительных заклинаний предсказания я всё-таки получил ответ. Предсказание открыло мне, что я смогу найти бессмертного в древнем мавзолее, расположенном в районе Улья. Я должен поспешить. Надо найти это создание и добыть его кровь, прежде чем двигаться дальше.

15-й день 127-го года правления Фактола Хашкара:

Я добрался до мавзолея. На меня сразу же напал призрак, охраняющий останки тех, кто был здесь погребён. Я сумел ускользнуть от него и укрылся в том, что, по-видимому, является внутренним святилищем. Защита из простейших охранных заклинаний помогла предотвратить дальнейшее вмешательство в мои дела этого сверхъестественного олуха. Мне пришлось поднять нескольких местных усопших, чтобы они искали бессмертного. Если предсказание было верным и бессмертный действительно где-то здесь, то он, скорее всего, погребён в одном из множества склепов, тянущихся вдоль этих залов. Теперь это лишь вопрос времени.

17-й день 127-го года правления Фактола Хашкара:

Я тут не один. Кто-то проник в мавзолей и столкнулся с моими слугами. Может быть, это именно тот, кого я ищу? Предсказание лишь открыло мне, что я найду его здесь. Могло ли случиться так, что моё присутствие в этом месте и подтолкнуло того, кого я ищу, разыскивать МЕНЯ? Какой изумительный поворот, мне придётся…»

Чернила этой последней записи ещё не успели высохнуть.~
@32883 = ~РЖАВЫЙ КИНЖАЛ
Урон: 1-3 колющий
Особенности: 
Оружие *хрупкое*, может сломаться при ударе
Фактор скорости: 2
Вес: 1
Навык: клинок
Недоступно: священникам

Это маленький ржавый кинжал. Его лезвие частично сколото, а рукоятка болтается; вряд ли он долго прослужит.~
@32884 = ~«Может быть».~
@32885 = ~«Может быть. Позволь мне ещё кое о чём спросить…»~
@32886 = ~«Возможно. Как бы то ни было, у меня больше нет вопросов».~
@32887 = ~«Война отметила тебя шрамами, здоровяк. Ты должен *знать*. И должен знать, что *никогда* не захочешь вернуться».~
@32888 = ~«И часто они вербуют?»~
@32889 = ~«Постой… позволь спросить кое о чём другом…»~
@32890 = ~«Неважно. Вопросов больше нет».~
@32891 = ~Он мрачно кивает: «Можешь на этот счёт не сомневаться. Сигил — лучший источник пушечного мяса на планах. Даст сто очков вперёд любой планете со всеми её аборигенами… слишком там много работы».~
@32892 = ~«Итак, ещё какие-нибудь советы по выживанию на Войне?»~
@32893 = ~«Позволь спросить о другом…»~
@32894 = ~«У меня больше нет вопросов».~
@32895 = ~«Если только от тебя не захотят избавиться, то твои шансы невелики. Я ни разу не слыхал, чтоб это удалось провернуть новобранцу со злым сердцем или кому угодно, кого они не захотят выпускать из когтей. Перехитрить танар'ри — это рискованно, но можно… баатезу намного опаснее в делах, касающихся контрактов. Подписался под одним — считай, получил проклятье на всю жизнь…»~
@32896 = ~«Продолжай…»~
@32897 = ~«Постой… позволь спросить кое о чём другом…»~
@32898 = ~«А впрочем, неважно. Вопросов больше нет».~
@32899 = ~«Ты можешь попробовать отделаться магарычем, рискни подмазать, и, может, у тебя получится свалить… но куда ты отправишься? Ад ведь не один, их так много…»~
@32900 = ~«А умереть в Кровавой Войне, значит, *особенно* опасно?»~
@32901 = ~«И всё-таки как ты сбежал с Кровавой Войны?»~
@32902 = ~«Позволь спросить о другом…»~
@32903 = ~«У меня больше нет вопросов».~
@32904 = ~«В двух словах это будет звучать примерно так: Кровавая Война идёт уже дьявол знает сколько веков, всю ближайшую вечность, и будет продолжаться, пока вся эта ближайшая вечность не попадёт в книгу мёртвых. Танар'ри, воины *хаоса* и зла, старательно вышибают дерьмо — оно, кстати, у них зелёное — из баатезу, воинов *порядка* и зла. Они мочат друг друга хрен-те сколько лет по одной причине: каждый отстаивает свою точку зрения на то, каким *должно* быть зло. Правда, потрясающе? Ха!»~
@32905 = ~«Как думаешь, что будет, если кто-нибудь остановит Кровавую Войну?»~
@32906 = ~«Позволь спросить о другом…»~
@32907 = ~«У меня больше нет вопросов».~
@32908 = ~«Ты не сможешь оказать на Войну хоть какого-то грёбаного влияния! Она охеренно *велика*. Ты — камешек, песчинка в океане, которая сама находится в другом океане, которая в другом океане и так далее. И как у песчинки, твоя цель — не быть замеченным и тихо залечь на дно…»~
@32909 = ~«Продолжай…»~
@32910 = ~«Постой… позволь спросить кое о чём другом…»~
@32911 = ~«А впрочем, неважно. Вопросов больше нет».~
@32912 = ~«Если б ты мог оказать влияние — а ты *не можешь* — то не стоило б и *пытаться*, потому как планы тогда просто полетят в тартарары».~
@32913 = ~«Планы полетят в тартарары? Почему?»~
@32914 = ~«Позволь спросить о другом…»~
@32915 = ~«У меня больше нет вопросов».~
@32916 = ~Он поднимает свои руки, изображая колонны. «Кровавая Война — она как огромная грёбаная опора, подпирающая планы… выкинь её — и многие планы улетят вслед за ней. Война несёт на своей спине огромную кипу вещей, — внезапно он кричит как осёл, затем едко смеётся. — Она — самое громадное и кошмарное вьючное животное планов…»~
@32917 = ~«Продолжай…»~
@32918 = ~«Постой… позволь спросить кое о чём другом…»~
@32919 = ~«Неважно. Вопросов больше нет».~
@32920 = ~Он цинично усмехается. «Кроме того, некоторые считают, что война *прекрасно* подходит для ведения дел, — он неискренне смеётся, затем кажется, будто вот-вот расплачется. — М-да… не бери в голову… ещё вопросы?»~
@32921 = ~«Ты в порядке? Похоже, это для тебя больной вопрос…»~
@32922 = ~«Да, у меня ещё вопрос…»~
@32923 = ~«Нет, больше вопросов нет».~
@32924 = ~Мужчина печально улыбается: «Да уж, да уж… послушай, здоровяк, я не святоша, да и прикидываться не хочу, но запомни: не подпускай зла к своей душе. Если умрёшь со злобой в сердце — дух твой попадёт на Нижние планы, там ты станешь просящим…»~
@32925 = ~«Продолжай…»~
@32926 = ~«Постой… позволь спросить кое о чём другом…»~
@32927 = ~«А впрочем, неважно. Вопросов больше нет».~
@32928 = ~«И как думаешь, что случится потом? Просящие в Бездне и Бааторе превращаются в рядовых… и сражаются в Кровавой Войне всю оставшуюся им вечность, — он хихикает, покачивая головой. — Вот и ответ, почему баатезу и танар'ри развращают всё, к чему бы ни прикоснулись: да потому что им нужно больше войск. Заруби на носу: не допускай зла в своё сердце, пень».~
@32929 = ~«Позволь спросить о другом…»~
@32930 = ~«У меня больше нет вопросов».~
@32931 = ~«Ладно, слушай: давай я тебе объясню, что для них значит „мясо“. Они собирают вместе кучу подлых смертных наёмников и дают им задание покрошить друг друга вообще ни за что, просто так, в какой-нибудь бессмысленной битве за кусок забытой силами земли. И как думаешь, куда *все* эти души отправляются?»~
@32932 = ~«Куда?»~
@32933 = ~«Постой… позволь спросить кое о чём другом…»~
@32934 = ~«Вообще-то неважно. Вопросов больше нет».~
@32935 = ~«Их души падают на тот самый план зла, за который они сражались. Там души вырывают из котла плана и снова бросают в бой, уже как лемуров или манов… или какими там ещё отродьями становятся эти мерзкие кучи дерьма. И чем больше таких грёбаных просящих они получат, тем больше у них войск».~
@32936 = ~«Позволь спросить о другом…»~
@32937 = ~«У меня больше нет вопросов».~
@32938 = ~«Понимаю, вполне законный интерес к тому, как вообще заварилась вся эта кровавая каша, что именно заставляет извергов сцепляться рогами, кусать и рвать друг друга на мелкие куски, пока ещё есть живые…»~
@32939 = ~«Продолжай…»~
@32940 = ~«Постой… позволь спросить кое о чём другом…»~
@32941 = ~«А впрочем, неважно. Вопросов больше нет».~
@32942 = ~«Всё просто: они встретились, — он вздыхает. — Танар'ри и баатезу однажды встретились и затеяли драку, как два пьяных остолопа. Вот так, очень просто». Он хмурится: «Ну…»~
@32943 = ~«Продолжай…»~
@32944 = ~«Постой… позволь спросить кое о чём другом…»~
@32945 = ~«Неважно. Вопросов больше нет».~
@32946 = ~«Щас представь себе: два пьяных *священника*, каждый из которых верит, что *только* он знает, как надо жить. Теперь набей этих священников клыками, когтями, рогами и жестокостью на семерых и посади их в одну адски крохотную клетку… и получишь хорошее представление, какая тут вспыхнет пламенная любовь. И вот тебе на! Начало Кровавой Войны».~
@32947 = ~«Но почему две расы, приверженцы *зла*, сражаются друг с другом?»~
@32948 = ~«Позволь спросить о другом…»~
@32949 = ~«У меня больше нет вопросов».~
@32950 = ~«Одни считают, что зло должно быть правильным и упорядоченным. Другие же — что зло должно нести хаос и свирепствовать по всем планам. Все они зло, но это не значит, что они во всём заодно. Вражда, вражда… каждая раса хочет уничтожить другую, чтоб остался лишь один „сорт“ зла, их собственный. Они ненавидят друг друга, словно… словно…»~
@32951 = ~«Продолжай…»~
@32952 = ~«Постой… позволь спросить кое о чём другом…»~
@32953 = ~«Неважно. Вопросов больше нет».~
@32954 = ~Мужчина кивает: «Обычно они платят не столько, сколько танар'ри, но и не нарушают письменных соглашений. Баатезу хитры и даже ещё в сотни, сотни, *сотни сотен* раз хитрее. А уж контракты заключают с начала времён. Они знают, как навешать лапши на уши. Подпиши что-нибудь — и ты, скорее всего, будешь ободран как липка и намертво застрянешь в их легионах…»~
@32955 = ~«Продолжай…»~
@32956 = ~«Постой… позволь спросить кое о чём другом…»~
@32957 = ~«Неважно. Вопросов больше нет».~
@32958 = ~«Они охрененно умеют составлять планы. Вкладывают больше мысли и приготовлений в одно важное сражение, чем человеческие армии во всю военную кампанию, — он шмыгает носом и скребёт подбородок. — Обычно они собирают свои силы на Авернусе, первом уровне Баатора».~
@32959 = ~«Каков он, этот Авернус?»~
@32960 = ~«Каков он, этот Авернус?»~
@32961 = ~«Какие войска участвуют в Кровавой Войне?»~
@32962 = ~«Позволь спросить о другом…»~
@32963 = ~«У меня больше нет вопросов».~
@32964 = ~«Авернус? Хм… — он кривит лицо, словно воспоминание причиняет ему физические муки. — Это место населяют проклятые и те, кто на них охотится. Земли, словно язвами покрытые красными пятнами ядовитых песков и пожаров. Вот таким я запомнил уровень Авернус на Бааторе. Жуткое место».~
@32965 = ~«Какие войска участвуют в Кровавой Войне?»~
@32966 = ~«Позволь спросить о другом…»~
@32967 = ~«У меня больше нет вопросов».~
@32968 = ~«Всякие, даже не считая разных смертных пней со всех планов. Абишаи и корнугоны, лемуры и напперибо, суккубы… список можно продолжать до бесконечности».~
@32969 = ~«Расскажи мне об абишаях».~
@32970 = ~«Расскажи мне о корнугонах».~
@32971 = ~«Расскажи мне о лемурах».~
@32972 = ~«Расскажи мне о напперибо».~
@32973 = ~«Расскажи мне о суккубах».~
@32974 = ~«Расскажи мне о суккубах».~
@32975 = ~«Позволь спросить о другом…»~
@32976 = ~«У меня больше нет вопросов».~
@32977 = ~«Они — пехота в армиях баатезу. Они бывают разными, те, у которых чешуя чёрная, — самые слабые и самые распространённые».~
@32978 = ~«Какие ещё войска участвуют в Кровавой Войне?»~
@32979 = ~«Позволь спросить о другом…»~
@32980 = ~«У меня больше нет вопросов».~
@32981 = ~«Корнугоны *дьявольски* крепки, здоровяк. Нечасто увидишь их сразу нескольких вместе. Хотя порой из них и формируют элитные отряды. Обычно они ведут в бой войска послабже, типа абишаев или смертных наёмников».~
@32982 = ~«Какие ещё войска участвуют в Кровавой Войне?»~
@32983 = ~«Позволь спросить о другом…»~
@32984 = ~«У меня больше нет вопросов».~
@32985 = ~«Лемуры — это такие… твари… которые похожи на растаявших людей. Маленькие занудные бедолаги, которые регенерируют, даже если нарубить из них салат. Они не боятся боли или опасности и никогда не убегают с поля боя. Хороши разве что для смерти на передовых позициях».~
@32986 = ~«Какие ещё войска участвуют в Кровавой Войне?»~
@32987 = ~«Позволь спросить о другом…»~
@32988 = ~«У меня больше нет вопросов».~
@32989 = ~«Мелкие жирные трусливые создания с такими маленькими-маленькими головами. Глухие, слепые и тупые, они существуют исключительно для смерти на передовой. Ещё их трудно убить… даже маленький их кусочек вырастет до целого, если ему позволить».~
@32990 = ~«Какие ещё войска участвуют в Кровавой Войне?»~
@32991 = ~«Позволь спросить о другом…»~
@32992 = ~«У меня больше нет вопросов».~
@32993 = ~«Прекрасное, но смертельно опасное зло танар'ри — вот кто они такие. Они соблазняют смертных, а потом тащат их в Бездну». Он кивает Падшей Грейс: «Извините, леди, я не хотел вас обидеть».~
@32994 = ~Не обращать внимания на Сборщика и идти дальше.~
@32995 = ~«Я так не думаю…»~
@32996 = ~Подавить воспоминание.~
@32997 = ~«Прекрасное, но смертельно опасное зло танар'ри — вот кто они такие. Они соблазняют смертных, а потом тащат их в Бездну… больше просящих — больше мяса для войны».~
@32998 = ~«Какие ещё войска участвуют в Кровавой Войне?»~
@32999 = ~«Позволь спросить о другом…»~
@33000 = ~«У меня больше нет вопросов».~
@33001 = ~«Таких мест много… *как правило*, Нижние планы. По всей длине реки Стикс… на девяти уровнях Баатора, в четырёх топках Геенны, в Серой Пустоши, на холодном красном Карцери, тюремном плане, и бесконечном колодце зла — Бездне», — почему-то «Серая Пустошь» звучит для тебя очень знакомо…~
@33002 = ~«Расскажи мне о Серой Пустоши».~
@33003 = ~«Позволь спросить о другом…»~
@33004 = ~«У меня больше нет вопросов».~
@33005 = ~«Её ещё называют „Сумрачной“, — он рефлекторно вздрагивает и пожимает плечами. — Серая во всех смыслах. Цвета там выжигают глаз, они кричат, слишком громко кричат; наружу выходят твои сны и льются на землю, потерянные навсегда. И правят там лишь ночные ведьмы… Серые Леди Пустоши».~
@33006 = ~«Позволь спросить о другом…»~
@33007 = ~«У меня больше нет вопросов».~
@33008 = ~Мужчина кивает: «Танар'ри платят лучше, чем баатезу. Но тебе понадобятся два, а то и три лица и целая куча глаз по всему телу, ведь к ним нельзя повернуться спиной даже на миг. Они хаос во плоти: непостоянные и вечно с прихотью в сердцах. Доверие и умение держать слово — не их конёк…»~
@33009 = ~«Продолжай…»~
@33010 = ~«Постой… позволь спросить кое о чём другом…»~
@33011 = ~«Неважно. Вопросов больше нет».~
@33012 = ~Он шмыгает носом, затем пожимает плечами: «Им плевать, что творится, пока хоть *что-то* творится и оно злое. По-моему, они дерутся с баатезу, просто чтоб не начать резать друг друга».~
@33013 = ~«Позволь спросить о другом…»~
@33014 = ~«У меня больше нет вопросов».~
@33015 = ~«Знаешь, всегда сыщется какой-нибудь кожеголовый пень, который ищет работёнку в Кровавой Войне. Им нужны бабки, хотят быстренько оттрубить, а потом начать нормальную жизнь. Возможно, и я был одним из таких кожеголовых. Может, и я был наёмником и услышал, что на Войне можно сделать бабки. Я заинтересовался…»~
@33016 = ~«Продолжай…»~
@33017 = ~«Постой… позволь спросить кое о чём другом…»~
@33018 = ~«А впрочем, неважно. Вопросов больше нет».~
@33019 = ~«И вот что я обо всём этом понял: мы что-то вроде муравьёв, бегающих вокруг пятки танцующего сбрендившего бога. Я видел больших парней, которые считали себя крутыми солдатами… — он качает головой. — *Бумажные* солдатики. Война — это *топка*, которая на них работает. Она их подымает и *сжигает*».~
@33020 = ~«И как же ты выжил на Кровавой Войне?»~
@33021 = ~«Позволь спросить о другом…»~
@33022 = ~«У меня больше нет вопросов».~
@33023 = ~Он сцепляет пальцы, стараясь подыскать нужные слова. «Понимаешь, они умеют ненавидеть совсем не так, как ненавидим *мы*. Мы не знаем, что такое *настоящая* ненависть. У нас в языке только одно, *одно* слово для „ненависти“. А у них… — его голос срывается, — …тысячи тысяч, их значения запутаны и извращены, как… их тела. *Вот* почему они сражаются».~
@33024 = ~«Позволь спросить о другом…»~
@33025 = ~«У меня больше нет вопросов».~
@33026 = ~Его лицо мрачнеет: «Я… ну, это то, о чём я не хочу рассказывать, парень. Достаточно сказать, что для побега с Войны сделаешь всё, выбирать не приходится».~
@33027 = ~«Тогда я хотел бы спросить о другом…»~
@33028 = ~«Тогда у меня больше нет вопросов».~
@33029 = ~«Война отметила тебя шрамами, здоровяк. Ты должен *знать*. И должен знать, что *никогда* не захочешь вернуться». У тебя начинает стучать в висках, когда ты задумываешься над словами мужчины… и на поверхность всплывает воспоминание…~
@33030 = ~Попробовать вспомнить.~
@33031 = ~Попробовать вспомнить.~
@33032 = ~Попробовать вспомнить.~
@33033 = ~Характер:~
@33034 = ~Показать видео~
@33035 = ~«Здоровяк? Эй, ты как, в порядке?»~
@33036 = ~Лекционный зал постепенно исчезает, уступая место кошмарному видению, просачивающемуся наружу из самых дальних уголков твоей памяти… видению места, где времена года не похожи ни на что из виденного или слышанного тобой ранее. Место, где никто не слышит молитв, камнем падающих на землю… кроваво-красные вспышки молний пересекают то, что когда-то было небом, а теперь кипит под твоими ногами и вопит от твоих прикосновений…~
@33037 = ~Ты следуешь во главе большого отряда людей, бежишь сквозь каньон, стены которого дрожат во мгле и бьются как сердце. На тебе нет никакой одежды, только твоя собственная кровь. Наконец вы останавливаетесь в месте, где пепельно-серая почва скользит подобно клубку змей, свивающихся в кольца вокруг лодыжек и зло перешёптывающихся с землёй. Вы целую вечность в молчании идёте сквозь эту бесцветную землю, где усталость *оживает* и охотится на тебя словно тень над пустошью, изводя тебя отчаянием…~
@33038 = ~[нет текста]~
@33039 = ~Со временем ты и твои измотанные товарищи подходите к ведьме, сидящей на куче огромных извивающихся личинок. Она указывает сломанным когтем на что-то, покрытое слизью. Ты даёшь знак одному из своих людей пойти вперёд и поговорить с ней, скрипучий голос ведьмы доносится до твоих ушей…~
@33040 = ~Ветеран из Голодных Псов~
@33041 = ~~
@33042 = ~Как только ты входишь на эту территорию, к тебе направляется потрёпанный Сборщик средних лет. «Я… — он быстро тебя осматривает и ухмыляется, — …тебя не знаю».~
@33043 = ~Сборщик продолжает пялиться на тебя.~
@33044 = ~«Приветствую».~
@33045 = ~«Меня не волнует, что ты там ищешь, пень, — он сплёвывает. — Зато волнует, что ты всё ещё дышишь рядом со мной».~
@33046 = ~Когда ты приближаешься к Сборщику, он награждает тебя взглядом, полным отвращения. «Ни слова больше, здоровяк. В этих местах ты трёпом вряд ли чего добьёшься, — Сборщик достаёт из кармана нож. — Боюсь, единственная твоя твёрдая валюта здесь — это твой труп».~
@33047 = ~«Проблема, как мне кажется, пень… что ты продолжаешь дышать рядом со мной», — он сплёвывает.~
@33048 = ~Ты уже собираешься уходить, но замечаешь, как сборщик достаёт из кармана нож: «Не знаю, о чём ты там думал, спускаясь сюда, здоровяк, но единственное место, куда ты отсюда попадёшь, — это Мортуарий».~
@33049 = ~«Да и я не припомню, чтобы мы были знакомы».~
@33050 = ~«Просто мимо проходил».~
@33051 = ~Не обращать внимания на Сборщика и идти дальше.~
@33052 = ~«Ты тут дневника не видел?»~
@33053 = ~«Я ищу мужчину по имени Фарод».~
@33054 = ~«Какая-то проблема?»~
@33055 = ~Не обращать внимания на Сборщика и идти дальше.~
@33056 = ~«Я буду говорить с ним», — произносит она, затем хихикает. Её глаза вспыхивают, когда она указывает на тебя: «Тот красавчик, что ведёт вашу потрёпанную колонну. Я буду говорить только с ним». …И это всё, что ты можешь вспомнить.~
@33057 = ~У этого приземистого, сгорбленного старика всё ещё заметны широкие плечи и крепкие, покрытые шрамами руки рабочего или воина. Словно аура его окружают усталость и отчаяние. Кажется, он как раз собирается читать лекцию.~
@33058 = ~«Если ты меня не пропустишь, Сборщик, то один из нас отправится в Мортуарий, и это точно буду не я».~
@33059 = ~Лицо Гизиса мрачнеет: «Отвяжись! Я об этом и слова больше не скажу!»~
@33060 = ~[нет текста]~
@33061 = ~[нет текста]~
@33062 = ~[нет текста]~
@33063 = ~Лицо мужчины краснеет от ярости: «Следи за языком, здоровяк! Это ложь! Грязная, грязная ложь! Ты что, *придурок*, трепаться с извергом о Войне и верить каждому её слову?!»~
@33064 = ~«Я скажу тебе, что случилось, пень! — он вздыхает и слегка успокаивается. — Я был в Роте Пылающих Ликов… в число воинов изначально входило пятьдесят три смертных наёмника, хотя осталось нас только девять. Мы встали лагерем где-то в Авернусе и ждали подкрепления перед следующей битвой…»~
@33065 = ~«Ну, мой контракт тогда уже почти истёк, и… фактически я должен был уйти после этой битвы. Проблема была в том, что если бы я там умер, то стал бы ихним навсегда: слишком много грязи, слишком много зла скопилось в моей душе. И я бы кончил просящим в Бааторе, вечным солдатом на Войне», — он вздрагивает, задумавшись.~
@33066 = ~«И я вместе с двумя своими приятелями бежал. Бежал как пёс, так оно всё и случилось. Мы мчались по всему плану уже несколько дней, когда наткнулись на эту колонну из живых голов… жуткое зрелище, скажу я тебе… они бормотали и шипели, звали нас, просили подойти поближе. Ночью я тайком ушёл от своих и пошёл к колонне».~
@33067 = ~Гизис закрывает глаза и трёт виски. «Я… я спросил у колонны, как мне выйти на свободу, как сбежать из Баатора… и она сказала мне: в обмен на двух моих братьев, — на мгновение он замолкает, кусая костяшки пальцев в попытках сдержать слёзы. — Для меня… тогда… это был просто счёт».~
@33068 = ~Он кивает: «Не знаю, смогу ли когда-нибудь простить себя. Сейчас я всего лишь солдат, который ищет, где бы умереть. Я стараюсь соскрести налёт зла со своей души, очистить того Гизиса, который сидит внутри меня, прежде чем умру и вернусь на Кровавую Войну. Я читаю здесь лекции, чтобы предостеречь от всего этого других. Не хочу, чтобы кому-то ещё пришлось делать выбор типа моего».~
@33069 = ~Он кивает: «Не знаю, смогу ли когда-нибудь простить себя. Сейчас я всего лишь солдат, который ищет, где бы умереть. Я стараюсь соскрести налёт зла со своей души, очистить того Гизиса, который сидит внутри меня, прежде чем умру и вернусь на Кровавую Войну. Я читаю здесь лекции, чтобы предостеречь от всего этого других. Не хочу, чтобы кому-то ещё пришлось делать выбор типа моего».~
@33070 = ~«Я же не говорю, что это было правильно, пень, но ты не можешь отрицать, что так на моём месте поступил бы почти каждый. Я называю это *выживанием*, не убийством… а теперь оставь меня. Старый Гизис не скажет *тебе* больше ни слова».~
@33071 = ~Гизис кривит лицо, качая головой: «Ты… ты отвратителен, пень. Вот, бери всё, что у меня есть, все твоё… только не трепись. Чую, когда я снова окажусь в той кровавой бане, я знаю, кто будет там вместе со мной…» Он отдаёт тебе мешочек монет и пригоршню других предметов.~
@33072 = ~~
@33073 = ~«Кровавая Война? Это даже скучнее, чем слушать болтовню Старейшин о законах. Давай найдём каких-нибудь молоденьких девчонок из Чующих, которых надо научить тому, что такое настоящая страсть!» — он поводит бровями в предвкушении.~
@33074 = ~«Нет, Морте… я хочу послушать».~
@33075 = ~Не обращать внимания на Морте, продолжать слушать.~
@33076 = ~«Ладно, Морте, пошли».~
@33077 = ~НАСТРОЙКА ОБРАТНОЙ СВЯЗИ~
@33078 = ~Титры~
@33079 = ~Сила средняя.~
@33080 = ~«Мне не так уж сложно поверить в то, что женщина может остановить Кровавую Войну».~
@33081 = ~«Никаких обид. Ты совершенно прав».~
@33082 = ~«Но ведь извергам по-прежнему разрешено находиться в Сигиле?»~
@33083 = ~«Позволь спросить о другом…»~
@33084 = ~«У меня больше нет вопросов».~
@33085 = ~«Какие ещё войска участвуют в Кровавой Войне?»~
@33086 = ~«Позволь спросить о другом…»~
@33087 = ~«У меня больше нет вопросов».~
@33088 = ~«Вообще-то вопросов нет».~
@33089 = ~«Почему изверги просто не захватят Сигил?»~
@33090 = ~Похоже, твои угрозы возымели действие. «Убирайся отсюда, здоровяк! — шипит он. — И на твоём месте я б оглядывался почаще».~
@33091 = ~В ответ на твои угрозы, Сборщик вытаскивает из кармана нож: «Не согласен с тобой, пень. Это ТЫ скоро станешь бабками в моём кармане!»~
@33092 = ~Похоже, твои слова малость остудили пыл Сборщика, и он от тебя отворачивается: «Берегись, здоровяк. С тобой тут чаще будут говорить ножи, а не языки. А если ты тут ещё задержишься, я свой тоже достану».~
@33093 = ~«Если ты меня не пропустишь, Сборщик, то один из нас отправится в Мортуарий и это точно буду не я».~
@33094 = ~«Сбор трупов, пока они ещё живы, звучит как отличный способ встретится с Госпожой».~
@33095 = ~«Тогда я отойду подальше, пень».~
@33096 = ~Напасть на Сборщика.~
@33097 = ~«Если ты меня не пропустишь, Сборщик, то один из нас отправится в Мортуарий, и это точно буду не я».~
@33098 = ~«Да… я в полном порядке. Так что, часто изверги набирают новобранцев?»~
@33099 = ~«Я в порядке. Позволь мне спросить кое о чём другом…»~
@33100 = ~«Всё хорошо. У меня больше нет вопросов».~
@33101 = ~«Если ты меня не пропустишь, Сборщик, то один из нас отправится в Мортуарий, и это точно буду не я».~
@33102 = ~Продолжить вспоминать…~
@33103 = ~«Сбор трупов, пока они ещё живы, звучит как отличный способ встретится с Госпожой».~
@33104 = ~«Тогда я отойду подальше, пень».~
@33105 = ~Напасть на Сборщика.~
@33106 = ~Не обращать внимания на Сборщика и идти дальше.~
@33107 = ~«Я так не думаю…»~
@33108 = ~«И тебе того же…»~
@33109 = ~«Рискни…»~
@33110 = ~«Как скажешь…»~
@33111 = ~~
@33112 = ~Продолжить вспоминать…~
@33113 = ~Продолжить вспоминать…~
@33114 = ~Остаться на лекции.~
@33115 = ~Остаться на лекции.~
@33116 = ~~
@33117 = ~~
@33118 = ~~
@33119 = ~~
@33120 = ~~
@33121 = ~~
@33122 = ~~
@33123 = ~~
@33124 = ~«Так она мне сказала. Я же не сказал, что поверил ей».~
@33125 = ~«Тогда что случилось?»~
@33126 = ~«Забудь, что я говорил. У меня другие вопросы…»~
@33127 = ~«Продолжай…»~
@33128 = ~«Знаешь, остальное я дослушаю в другой раз».~
@33129 = ~«И что случилось?»~
@33130 = ~«Знаешь, остальное я дослушаю в другой раз».~
@33131 = ~«И?..»~
@33132 = ~«Знаешь, остальное я дослушаю в другой раз».~
@33133 = ~«По мне, так всё равно что ты их убил».~
@33134 = ~«Ужасный выбор».~
@33135 = ~«Ясно… но по мне, так всё равно что ты их убил».~
@33136 = ~«Ясно… но по мне, так всё равно что ты их убил».~
@33137 = ~«Я тебя понимаю, Гизис».~
@33138 = ~«Возможно, Гизис, мне стоит об этом рассказать. Уверен, людям будет интересно узнать, как *на самом деле* ты прошёл Кровавую Войну».~
@33139 = ~«Это хорошо».~
@33140 = ~«Мне что, нужно разжёвывать, старик? Это шантаж. Беру в обмен на молчание что угодно, желательно ценное».~
@33141 = ~«Неважно… забудь, что я наговорил».~
@33142 = ~«В ближайшее время этому не бывать, Гизис. А теперь заканчивай лекцию».~
@33143 = ~~
@33144 = ~Покупатель~
@33145 = ~Кузнец~
@33146 = ~Разрисованный бандит~
@33147 = ~Маг из Голодных Псов~
@33148 = ~Слепой бандит~
@33149 = ~Головорез из Голодных Лающих Псов~
@33150 = ~Ветеран из Голодных Псов~
@33151 = ~Колдун~
@33152 = ~Мужчина отступает, на его лице смесь страха и отвращения: «Уйди… уйди прочь! Оставь меня!»~
@33153 = ~Отпустить его.~
@33154 = ~Глаза мужчины расширяются по мере твоего приближения, он отстраняется от тебя: «У меня нет ничего ценного, здоровяк. Клянусь! Оставь меня в покое!»~
@33155 = ~Отпустить его.~
@33156 = ~«Отцепись! Я не хочу иметь с тобой ничего общего!»~
@33157 = ~Уйти.~
@33158 = ~Мужчина всеми силами старается не обращать на тебя внимания. Чем больше ты пытаешься привлечь его внимание, тем яснее становиться, что он не желает с тобой разговаривать.~
@33159 = ~Уйти.~
@33160 = ~«Похоже, ты долго жил в Улье или ещё где похуже, здоровяк. А теперь отвянь и оставь меня в покое!»~
@33161 = ~Уйти.~
@33162 = ~«Выглядишь развалиной, пень. Сними койку в Ночлежке, если надо отдохнуть… она как раз в центре этого района. А теперь оставь меня! Я не хочу тратить время на твои вопросы».~
@33163 = ~Уйти.~
@33164 = ~«Ты ещё не был в баре „Собиратели пыли“, пень? Ты мне как раз напоминаешь тамошних работяг…» — он злобно смеётся.~
@33165 = ~Уйти.~
@33166 = ~Мужчина жуёт что-то напоминающее крысу на палочке: «Что, пень? Никогда не видел запечённую крысу, что ли? Тебе пойдёт, и на вкус вполне себе! Если голоден, поговори с Криденом… он стоит сразу перед входом в управление по паразитам и эпидемиям».~
@33167 = ~Уйти.~
@33168 = ~«Не видал ещё Голодных Псов? Я б на твоём месте избегал этих воющих, пакостных сволочей… проклятые ублюдки!»~
@33169 = ~Уйти.~
@33170 = ~«Не знаю я ничего полезного, пень… уйди».~
@33171 = ~Уйти.~
@33172 = ~Мужчина осматривает тебя и рисует полукруг у себя над сердцем: «Я занимаюсь своими делами, кореш, и ты лучше тоже займись своими. Прощай».~
@33173 = ~Отпустить его.~
@33174 = ~При твоём приближении мужчина хмурится: «У меня нет времени греметь шкатулкой с незнакомцами, здоровяк. К тому же это не самое безопасное занятие в Улье. Всего тебе».~
@33175 = ~«Тогда прощай».~
@33176 = ~«Я тебе вот что скажу, жизнь в Улье — сплошной бардак».~
@33177 = ~Уйти.~
@33178 = ~«Выглядишь развалиной, пень. Сними койку в Ночлежке, если надо отдохнуть… она как раз в центре этого района. А теперь оставь меня! Я не хочу тратить время на твои вопросы».~
@33179 = ~Уйти.~
@33180 = ~«Ты ещё не был в баре „Собиратели пыли“, пень? Ты мне как раз напоминаешь тамошних работяг…» — он злобно смеётся.~
@33181 = ~Уйти.~
@33182 = ~Мужчина жуёт что-то напоминающее крысу на палочке: «Что, пень? Никогда не видел запечённую крысу, что ли? Тебе пойдёт, и на вкус вполне себе! Если голоден, поговори с Криденом… он стоит сразу перед входом в управление по паразитам и эпидемиям».~
@33183 = ~«Я здесь, чтобы навестить Дейонарру».~
@33184 = ~«Я попробую. Счастливо».~
@33185 = ~«Я здесь, чтобы навестить Дейонарру».~
@33186 = ~«Я ищу Соэго».~
@33187 = ~«Я ищу Соэго».~
@33188 = ~«Я уже его нашёл, но всё равно спасибо. Счастливо».~
@33189 = ~Ложь: «Э-э… с Аданом. Он ещё работает здесь, или?..»~
@33190 = ~Ложь: «Э-э… с Аданом. Он ещё работает здесь, или?..»~
@33191 = ~«Э, ни с кем. Я оговорился».~
@33192 = ~«Слыхал про аллею Опасных Углов? Когда-то там был целый район, да вот сожгли его весь дотла. Там теперь никого, кроме бандитов, и нету».~
@33193 = ~«Да, был я там».~
@33194 = ~Уйти.~
@33195 = ~«Есть тут один тип, Вонючка, он занятные байки заливать здоров. Если сможешь выдержать вонь этого засранца».~
@33196 = ~«Может, я его и поищу. Счастливо».~
@33197 = ~«Да, я его уже видел. Счастливо».~
@33198 = ~«„Горящий труп“ — моя любимая таверна в Улье… порой, правда, там становится жарковато, всякие там тлеющие трупы и всё такое».~
@33199 = ~«Сейчас там трупов нет, точно. Счастливо».~
@33200 = ~«Да, я там уже был. Счастливо».~
@33201 = ~Уйти.~
@33202 = ~Мужчина тебе кивает: «Привет, здоровяк. Я б тебе помог, если б мог… но я просто ничего полезного для тебя не знаю».~
@33203 = ~«Всё равно спасибо. Прощай».~
@33204 = ~«Спасибо за информацию. Я с ним поговорю».~
@33205 = ~«Ненавижу это место… хотел бы я подкопить бабок и свалить из Улья подобру-поздорову. Послушай моего совета, здоровяк, и убирайся отсюда, если сможешь».~
@33206 = ~Уйти.~
@33207 = ~«Будь осторожен здесь, пень… насилие — это образ жизни Улья».~
@33208 = ~Уйти.~
@33209 = ~«Выглядишь развалиной, пень. Сними койку в Ночлежке, если надо отдохнуть… она как раз в центре этого района. А теперь оставь меня! Я не хочу тратить время на твои вопросы».~
@33210 = ~Уйти.~
@33211 = ~«Я слыхал о тебе, пень… ты тут вынюхивал насчёт Фарода, ага? Если ещё его ищешь, поспрошай к северу отсюда, на Площади Мусорщиков».~
@33212 = ~«Я попробую. Счастливо».~
@33213 = ~«Я уже его нашёл, но всё равно спасибо. Счастливо».~
@33214 = ~«Есть тут в нашей округе один кореш, Порфирон… может научить мужика драться, не вру».~
@33215 = ~«Тогда, наверное, я пойду и поищу его. Прощай».~
@33216 = ~«Да, я его уже видел. Счастливо».~
@33217 = ~«Глянь на Столб, если хочешь выяснить, что здесь и где. Он прям перед баром „Собиратели пыли“ стоит».~
@33218 = ~Уйти.~
@33219 = ~«Слыхал про аллею Опасных Углов? Когда-то там был целый район, да вот сожгли его весь дотла. Там теперь никого, кроме бандитов, и нету».~
@33220 = ~«Да, я там уже был. Счастливо».~
@33221 = ~Уйти.~
@33222 = ~«Куча народу сюда ходит оплакивать мёртвых… у Мемориала есть странный Пыльный, который может сказать, живы ли те, кого ищешь, или может вписать их имена на плиту, если хошь, чтоб о них память осталась».~
@33223 = ~«Почти каждый Пыльный в Сигиле заходит иногда в бар „Собиратели пыли“. Так что если ищешь кого-то конкретного, то лучше всего начать оттуда».~
@33224 = ~«Я ищу Соэго».~
@33225 = ~Уйти.~
@33226 = ~«Я ищу Соэго».~
@33227 = ~Ложь: «Э-э… с Аданом. Он ещё работает здесь, или?..»~
@33228 = ~Мужчина жуёт что-то напоминающее крысу на палочке: «Что, пень? Никогда не видел запечённую крысу, что ли? Тебе пойдёт, и на вкус вполне себе! Если голоден, поговори с Криденом… он стоит сразу перед входом в управление по паразитам и эпидемиям».~
@33229 = ~Ложь: «Э-э… с Аданом. Он ещё работает здесь, или?..»~
@33230 = ~Уйти.~
@33231 = ~«Э, ни с кем. Я оговорился».~
@33232 = ~«Есть тут один тип, Вонючка, он занятные байки заливать здоров. Если сможешь выдержать вонь этого засранца».~
@33233 = ~«Может, я его и поищу. Счастливо».~
@33234 = ~«Да, я его уже видел. Счастливо».~
@33235 = ~«На местном рынке можно найти практически всё, что угодно».~
@33236 = ~Уйти.~
@33237 = ~«Прислушивался когда-нибудь к тому, что говорит эта Порфира на рынке? Это ж такое начнётся в Сигиле, если она правду говорит… хотя все считают, что она просто психованная».~
@33238 = ~Уйти.~
@33239 = ~«Слыхал про аллею Опасных Углов? Когда-то там был целый район, да вот сожгли его весь дотла. Там теперь никого, кроме бандитов, и нету».~
@33240 = ~«Да, был я там».~
@33241 = ~Уйти.~
@33242 = ~«Не видал ещё Голодных Псов? Я б на твоём месте избегал этих воющих, пакостных сволочей… проклятые ублюдки!»~
@33243 = ~Уйти.~
@33244 = ~«„Горящий труп“ — моя любимая таверна в Улье… порой, правда, там становится жарковато, всякие там тлеющие трупы и всё такое».~
@33245 = ~«Спасибо за информацию. Я с ним поговорю».~
@33246 = ~«Сейчас там трупов нет, точно. Счастливо».~
@33247 = ~«Да, я там уже был. Счастливо».~
@33248 = ~Уйти.~
@33249 = ~«Встречал уже этого пустоголового „плачущего“ бедолагу? Вот жопа-то… как будто здесь есть кому дело до этих деревьев. Хотел бы я знать, какой кожеголовый идиот их сюда притащил!»~
@33250 = ~Уйти.~
@33251 = ~«Ты тут повнимательнее за своим кошельком смотри, здоровяк… тут частенько по карманам шарят, знаешь ли».~
@33252 = ~«Спасибо. Прощай».~
@33253 = ~«Тут время от времени одна сумасшедшая бегает… слыхал, что она просто бестолочь, которая съехала с катушек, пытаясь вернутся домой».~
@33254 = ~«Угу… думаю она уже дома, или скоро там будет. Счастливо».~
@33255 = ~«Да, встречал её, Ингресс зовут. Счастливо».~
@33256 = ~Уйти.~
@33257 = ~«Если у тебя есть время и бабки, пойди, поговори с Гаохой на рынке».~
@33258 = ~Уйти.~
@33259 = ~«Какие у тебя интересные татуировки, здоровяк. Тут татуировочный салон есть неподалёку… заправляет там всем дабус!»~
@33260 = ~«Знаю. Его зовут Фелл. Счастливо».~
@33261 = ~«Да, я там уже был. Счастливо».~
@33262 = ~«Возможно, как-нибудь зайду туда. Счастливо».~
@33263 = ~«Тлиум! Вот уж не думал снова тебя увидеть. Сколько прошло-то? Четыре года? Выглядишь ты… ну, не важно. Вот, та сотня медяков, что я тебе должен. Я б их и раньше вернул, но ты как будто исчез из Сигила! Ну мне пора, исчезаю, Тлиум… всего тебе!»~
@33264 = ~«Э-э…»~
@33265 = ~Дать ему уйти.~
@33266 = ~Глаза мужчины округляются, а всё его лицо мигом белеет: «С-с-силы небесные и адские… говорили же мне, что ты вернёшься, а я им не в-верил!» Внезапно он бросается наутёк.~
@33267 = ~Попробовать схватить его.~
@33268 = ~Дать ему уйти.~
@33269 = ~Человек странно косится на тебя: «Моррик? Это ты?»~
@33270 = ~Соврать: «Да… я Моррик».~
@33271 = ~«Может быть…»~
@33272 = ~«Нет, извини».~
@33273 = ~«Тогда извини, здоровяк. Всего тебе».~
@33274 = ~«Прощай».~
@33275 = ~«Ты же сказал, что никогда больше не вернёшься в Сигил?.. Если Аматаэль узнает, что ты вернулся, — конец тебе! Как бы то ни было, у меня всё ещё сохранился тот свиток, что ты мне дал. Вот… возьми и уходи, пока кто-нибудь не увидел нас вместе».~
@33276 = ~«Но…»~
@33277 = ~«Спасибо… прощай».~
@33278 = ~Мужчина, давясь смехом, указывает на Морте: «Ого, смотрите! Летающий череп!»~
@33279 = ~«Ты что, совсем нюх потерял?! Хочешь без зубов остаться, черепушка?» — мужчина угрожающе наступает на Морте.~
@33280 = ~Остановить его.~
@33281 = ~Позволить Морте разобраться.~
@33282 = ~Ты становишься между Морте и этим человеком; он зло на тебя смотрит и отступает: «Только время терять!» Затем разворачивается, чтобы уйти.~
@33283 = ~Отпустить его.~
@33284 = ~Мужчина зло смотрит на Морте, потом на тебя и качает головой: «Только время терять!» Он разворачивается, чтобы уйти.~
@33285 = ~Отпустить его.~
@33286 = ~«Анна! Чё ты делаешь в *этой* куче потных говнюков? Я думал ты хочешь быть *моей* девушкой…» — тип громко гогочет, шлёпая себя по ляжкам.~
@33287 = ~«А, это всё только разговорчики, Анна… *только* разговорчики… тебе ж *никогда* не найти другого такого мужика, который *по-настоящему* бы тебя удовлетворял! Иди сюда, щас я тебя поцелую взасос, моя маленькая грязная принцесса тифлингов!» — он пытается облапать Анну.~
@33288 = ~Этому мужчине больше нечего тебе сказать.~
@33289 = ~Уйти.~
@33290 = ~Ничего важного этот мужчина больше сообщить не может.~
@33291 = ~Уйти.~
@33292 = ~От мужчины больше не получается добиться ничего интересного.~
@33293 = ~Уйти.~
@33294 = ~Этому мужчине больше нечего тебе сказать.~
@33295 = ~Уйти.~
@33296 = ~«Не тявкай, тошнотворный придурок! Разве я не сказала те в прошлый раз, чтоб ты и не пытался больше со мной заговаривать? И вообще, откуда ты узнал, как меня зовут?!»~
@33297 = ~«Только не говори, что я тебя не предупреждала, ты труп!» — клинки Анны внезапно бьют по протянутым рукам мужчины…~
@33298 = ~Напасть на него самому.~
@33299 = ~Дать порезвиться Анне.~
@33300 = ~Морте дико вращает глазами и орёт на всю улицу: «Ого! Смотрите! Говорящая куча дерьма!»~
@33301 = ~Морте отлетает к тебе и при этом говорит мужчине: «Вообще-то я обращался к этому здоровенному, разукрашенному пню, чувак… а не к тебе! Без обид, а?»~
@33302 = ~«Берегись, Морте…»~
@33303 = ~Не обращать на Морте внимания.~
@33304 = ~Глаза женщины расширяются от страха, по мере твоего приближения: «Убирайся! Уходи! Оставь меня в покое, а то я начну кричать, клянусь, я начну!»~
@33305 = ~Отпустить её.~
@33306 = ~При твоём приближении женщина начинает оглядываться по сторонам, словно пытаясь найти, за кого бы спрятаться: «Я… я ничего не знаю, здоровяк. Прошу, оставь меня в покое!»~
@33307 = ~Уйти.~
@33308 = ~«Приставай к кому-нибудь другому, сволочь! Мне на таких как ты время тратить жалко…»~
@33309 = ~Уйти.~
@33310 = ~Женщина упорно отказывается говорить с тобой.~
@33311 = ~Уйти.~
@33312 = ~Когда женщина понимает, что ты идёшь к ней, она бледнеет и начинает нащупывать кинжал: «У меня ничего для тебя нет! Убирайся!»~
@33313 = ~Уйти.~
@33314 = ~«Ты тот самый пень, который искал Фарода! Ну как, нашёл? Если нет, поищи к северу отсюда, место называется Площадь Мусорщиков».~
@33315 = ~«Я попробую. Счастливо».~
@33316 = ~«Если окажешься в баре „Собиратели пыли“, пень, не удивляйся, если кто-то потребует тя прислуживать!» — женщина фыркает и начинает давиться от смеха.~
@33317 = ~Уйти.~
@33318 = ~Женщина откусывает маленькими кусочками что-то больше всего напоминающее крысу на палочке. Увидев, что ты её разглядываешь, она подозрительно щурится: «Если хочешь такую же, поговори с Криденом, а не на меня пялься! Он стоит сразу перед входом в управление по паразитам и эпидемиям».~
@33319 = ~Уйти.~
@33320 = ~«Если увидишь воющих психов, бегающих вокруг, — держись в стороне! Эта банда Голодных Псов меня пугает, ужас…»~
@33321 = ~Уйти.~
@33322 = ~«Я не знаю ничего, что те поможет… просто оставь меня в покое».~
@33323 = ~Уйти.~
@33324 = ~Женщина подымает брови, когда ты к ней подходишь. «Я с чужаками не связываюсь, пень… и лучше б ты так же делал, не лезь в неприятности, ага? Всего тебе».~
@33325 = ~«Прощай».~
@33326 = ~Женщина хмурится, когда ты к ней приближаешься: «У меня нет ни времени, ни желания разговаривать с незнакомцами в Улье, пень… это в любом случае небезопасно. Пока».~
@33327 = ~«Тогда прощай».~
@33328 = ~Женщина печально вздыхает: «Нет ничего хуже, чем жизнь в Улье. Можно попасть в книгу мёртвых только за то, что косо посмотрел на какого-нибудь пня».~
@33329 = ~Уйти.~
@33330 = ~«Похоже, тебе стоит немного отдохнуть в ночлежке, здоровяк. Если тебя это интересует — она в центре этой части Улья».~
@33331 = ~Уйти.~
@33332 = ~«Если окажешься в баре „Собиратели пыли“, пень, не удивляйся, если кто-то потребует тя прислуживать!» — женщина фыркает и начинает давиться от смеха.~
@33333 = ~Уйти.~
@33334 = ~Женщина откусывает маленькими кусочками что-то больше всего напоминающее крысу на палочке. Увидев, что ты её разглядываешь, она подозрительно щурится: «Если хочешь такую же, поговори с Криденом, а не на меня пялься! Он стоит сразу перед входом в управление по паразитам и эпидемиям».~
@33335 = ~Уйти.~
@33336 = ~«Если увидишь воющих психов, бегающих вокруг, — держись в стороне! Эта банда Голодных Псов меня пугает, ужас…»~
@33337 = ~Уйти.~
@33338 = ~«Ты тот самый пень, который искал Фарода! Ну как, нашёл? Если нет, поищи к северу отсюда, место называется Площадь Мусорщиков».~
@33339 = ~«Я попробую. Счастливо».~
@33340 = ~«Я уже его нашёл, но всё равно спасибо. Счастливо».~
@33341 = ~«Лучше не ходи в эту сожжённую аллею к юго-западу отсюда, если, конечно, не ищешь неприятностей на свою голову».~
@33342 = ~«Да, я там уже был. Счастливо».~
@33343 = ~Уйти.~
@33344 = ~«Лучше не ходи в эту сожжённую аллею к юго-западу отсюда, если, конечно, не ищешь неприятностей на свою голову».~
@33345 = ~«Да, я там уже был. Счастливо».~
@33346 = ~Уйти.~
@33347 = ~«Есть тут такой бедолага по имени Вонючка… если подкинешь ему монетку-другую, да дыханье задержишь, он наплетёт тебе забавных небылиц».~
@33348 = ~«Может, я его и поищу. Счастливо».~
@33349 = ~«Да, я его уже видел. Счастливо».~
@33350 = ~Уйти.~
@33351 = ~«Ещё не был в „Горящем трупе“? Приятная таверна, вот только горящий человек меня чуток нервирует».~
@33352 = ~«Его уже там нет. Счастливо».~
@33353 = ~«Приветствую, красавчик, — женщина одаривает тебя кокетливой улыбкой. — Слушай… я тут хотела пойти выпить, чуть позже… как насчёт присоединиться?»~
@33354 = ~«Может, в другой раз… сейчас я слишком занят. Извини».~
@33355 = ~«Мне невыносима мысль, что придётся растить ребёнка здесь. Возможно, когда-нибудь моя семья сможет уехать из этого кошмарного места».~
@33356 = ~Уйти.~
@33357 = ~Женщина улыбается: «Нет, я ничем не могу тебе помочь… хотела бы, но нет».~
@33358 = ~«Всё равно спасибо. Прощай».~
@33359 = ~«Похоже, тебе стоит немного отдохнуть в ночлежке, здоровяк. Если тебя это интересует — она в центре этой части Улья».~
@33360 = ~Уйти.~
@33361 = ~«Да, я его уже видел. Счастливо».~
@33362 = ~«Ты тот самый пень, который искал Фарода! Ну как, нашёл? Если нет, поищи к северу отсюда, место называется Площадь Мусорщиков».~
@33363 = ~«Я попробую. Счастливо».~
@33364 = ~«Я уже его нашёл, но всё равно спасибо. Счастливо».~
@33365 = ~«Встречала тут как-то одного татуированного, Порфирон вроде зовут. Сказал мне, что он кто-то вроде монаха, боец… правда драться он не желает».~
@33366 = ~«Тогда, наверное, я пойду и поищу его. Прощай».~
@33367 = ~«Если хошь найти дорогу, здоровяк, тут есть Столб перед баром „Собиратели пыли“».~
@33368 = ~Уйти.~
@33369 = ~Уйти.~
@33370 = ~«Лучше не ходи в эту сожжённую аллею к юго-западу отсюда, если, конечно, не ищешь неприятностей на свою голову».~
@33371 = ~«Да, я там уже был. Счастливо».~
@33372 = ~Уйти.~
@33373 = ~«Народ валит помянуть покойничков к Мемориалу Пыльных… там есть Пыльный, который тока так занесёт для тя имя на Мемориал или скажет, не умер ли тот, кого ты ищешь».~
@33374 = ~«Да, его зовут „Смерть-Имён“. Прощай».~
@33375 = ~«Пыльные не ходят ни в одну таверну в Улье… кроме бара „Собиратели пыли“. Там почти никого и нету, *кроме* этих Пыльных».~
@33376 = ~Уйти.~
@33377 = ~Женщина откусывает маленькими кусочками что-то больше всего напоминающее крысу на палочке. Увидев, что ты её разглядываешь, она подозрительно щурится: «Если хочешь такую же, поговори с Криденом, а не на меня пялься! Он стоит сразу перед входом в управление по паразитам и эпидемиям».~
@33378 = ~Уйти.~
@33379 = ~«Да, я его уже видел. Счастливо».~
@33380 = ~«Есть тут такой бедолага по имени Вонючка… если подкинешь ему монетку-другую, да дыханье задержишь, он наплетёт тебе забавных небылиц».~
@33381 = ~«Может, я его и поищу. Счастливо».~
@33382 = ~«Ты на рынке-то был, здоровяк? Там есть почти всё, что надо человеку».~
@33383 = ~Уйти.~
@33384 = ~«Надеюсь, Порфира ошибается, сильно надеюсь… если не слышал пророчеств этой женщины, сходи на рынок, её крик там обычно далеко слышно…»~
@33385 = ~Уйти.~
@33386 = ~Уйти.~
@33387 = ~«Лучше не ходи в эту сожжённую аллею к северо-востоку отсюда, если, конечно, не ищешь неприятностей на свою голову».~
@33388 = ~«Да, я там уже был. Счастливо».~
@33389 = ~«Если увидишь воющих психов, бегающих вокруг, — держись в стороне! Эта банда Голодных Псов меня пугает, ужас…»~
@33390 = ~«Да, я там уже был. Счастливо».~
@33391 = ~Уйти.~
@33392 = ~Уйти.~
@33393 = ~«Ещё не был в „Горящем трупе“? Приятная таверна, вот только горящий человек меня чуток нервирует».~
@33394 = ~«Его уже там нет. Счастливо».~
@33395 = ~«Я тут встретила на днях одного типа, по имени „Плачущий-по-Деревьям“… по-моему, он двинулся на поиске себе помощника, чтоб ухаживать за деревьями. Мож, ему лучше попробовать людям помочь, а?»~
@33396 = ~Уйти.~
@33397 = ~«Всё, чем я могу помочь, здоровяк, так это предупредить о местном ворье… карманников в этой части Улья пруд пруди».~
@33398 = ~«Спасибо. Прощай».~
@33399 = ~«Да, встречал её, Ингресс зовут. Счастливо».~
@33400 = ~Уйти.~
@33401 = ~«Я тут видала одну несчастную спятившую девчонку, она носилась и причитала о каких-то прошлых временах. Это чудо, что с такой пустой головой она не умерла от голода или её не убили».~
@33402 = ~«Угу… думаю она уже дома, или скоро там будет. Счастливо».~
@33403 = ~«Держись подальше от Гаохи, того, что на рынке! Мой муж всё время возвращается без бабок, когда заключает пари с этим трижды проклятым гитом!»~
@33404 = ~Уйти.~
@33405 = ~«Нет, я там ни разу не был».~
@33406 = ~«Может быть. Прощай».~
@33407 = ~«Какие странные татуировки! Некоторые похожи на те, что делают в салоне в Улье. Это где ещё хозяин дабус, знаешь его?»~
@33408 = ~«Да, знаю; его зовут Фелл».~
@33409 = ~«Да, я знаю это место».~
@33410 = ~«Зашиби меня Госпожа! Я видела тебя раньше, здоровяк, но и подумать не могла, что увижу снова! Похоже, Сигил меньше, чем кажется».~
@33411 = ~«Ты меня знаешь?»~
@33412 = ~Терпеливо ждать.~
@33413 = ~Она нервно улыбается: «Знаю? Нет, я же сказала, что только видела. Это было в прошлом году… поздно ночью, почти в антипик… я искала свою сестру, когда ты появился, спешил безумно. Споткнулся, выронил вот это прямо мне под ноги и убежал. Я сохранила его на счастье, как будто сама судьба уронила». Она достаёт грозного вида кинжал: «Вот… видишь, мы с тобой снова встретились. Возьми обратно, здоровяк. Счастливо».~
@33414 = ~«Спасибо… прощай».~
@33415 = ~Похоже, женщина тебя моментально узнаёт; она пятится назад в ужасе. «После всех этих лет… ах ты *ублюдок*! Да чтоб тебя все изверги в Бааторе имели! Однажды ты пожалеешь о том, что сделал с Аэрин… *клянусь* в этом во имя всех сил!» Она обращается в бегство.~
@33416 = ~«Подожди…»~
@33417 = ~Дать ей уйти.~
@33418 = ~Дать ей уйти.~
@33419 = ~«Но…»~
@33420 = ~«Надо же, уж не мой ли это тёмный спаситель! Всё-таки нашёл время заглянуть ко мне… а я уж было подумала, ты никогда не появишься, красавчик», — она начинает рыться в своей поясной сумочке.~
@33421 = ~«Погоди… думаю, ты ошибаешься…»~
@33422 = ~«Нет, здоровяк… с тех пор прошло уже порядочно времени, но всё же мне будет лучше, если нас не увидят болтающими друг с другом. У него есть друзья, понимаешь, и, думаю, они кое-что подозревают о том, что произошло на самом деле. Нам не стоит больше разговаривать».~
@33423 = ~Морте вращает глазами и орёт: «Ого! Смотрите! Говорящая какашка!»~
@33424 = ~«Хороший и мёртвый, он именно такой, как ты мне сказал… и таким он мне больше нравится. Вот твоя кровавая награда, здоровяк… это кольцо, что я тебе обещала. Прощай».~
@33425 = ~«Погоди… у меня к тебе есть вопрос…»~
@33426 = ~«Нет, здоровяк… времени с тех пор прошло уже порядочно, но всё ж будет лучше, если меня не увидят в твоей компании. У него есть друзья, и я думаю, они подозревают, что же произошло на самом деле. Лучше нам не разговаривать больше».~
@33427 = ~«Но…»~
@33428 = ~Уйти.~
@33429 = ~Морте подлетает к тебе, и при этом говорит человеку: «Вообще-то я обращался к этому здоровенному, разукрашенному пню, чувак… а не к тебе! Без драки, пожалуйста, ага?»~
@33430 = ~«Берегись, Морте…»~
@33431 = ~Она странно на тебя смотрит, потом косится на татуировки, покрывающие твои руки. Наконец она пожимает плечами: «Как будет угодно, здоровяк. Всего тебе…»~
@33432 = ~Отпустить её.~
@33433 = ~Не обращать на Морте внимания.~
@33434 = ~Этой женщине больше нечего тебе сказать.~
@33435 = ~«Не тявкай, тошнотворный придурок! Разве я не сказала те в прошлый раз, чтоб ты и не пытался больше со мной заговаривать? И вообще, откуда ты узнал, как меня зовут!»~
@33436 = ~Этой женщине больше нечего сообщить важного.~
@33437 = ~«Только не говори, что я тебя не предупреждала, ты труп!» Клинки Анны внезапно бьют по протянутым рукам мужчины…~
@33438 = ~Напасть на него самому.~
@33439 = ~Дать Анне порезвиться.~
@33440 = ~Сила выше средней.~
@33441 = ~Сила значительно выше средней: +<STAT_STRVAL1> к урону в ближнем бою.~
@33442 = ~Исключительная сила: +<STAT_STRVAL1> к атаке и +<STAT_STRVAL2> к урону в ближнем бою.~
@33443 = ~Несравненная сила: +<STAT_STRVAL1> к атаке и +<STAT_STRVAL2> к урону в ближнем бою.~
@33444 = ~Интеллект средний.~
@33445 = ~Интеллект выше среднего.~
@33446 = ~Интеллект исключительный.~
@33447 = ~Интеллект гения.~
@33448 = ~«Я уже его нашёл, но всё равно спасибо. Счастливо».~
@33449 = ~«Да, я там уже был. Счастливо».~
@33450 = ~«Тогда прощай».~
@33451 = ~Уйти.~
@33452 = ~Мудрость средняя.~
@33453 = ~Мудрость выше среднего.~
@33454 = ~Исключительная мудрость и сила воли.~
@33455 = ~Несравненная мудрость.~
@33456 = ~Ловкость средняя.~
@33457 = ~Ловкость выше средней.~
@33458 = ~Исключительная ловкость: улучшение +<STAT_DEXVAL1> к классу защиты.~
@33459 = ~Несравненная ловкость: улучшение +<STAT_DEXVAL1> к классу защиты.~
@33460 = ~Телосложение среднее.~
@33461 = ~Телосложение выше среднего.~
@33462 = ~Исключительное телосложение: +<STAT_CONVAL1> пунктов здоровья за уровень.~
@33463 = ~Несравненное телосложение: +<STAT_CONVAL1> пунктов здоровья за уровень.~
@33464 = ~Харизма ниже средней.~
@33465 = ~Харизма средняя.~
@33466 = ~Харизма выше средней.~
@33467 = ~Харизма исключительная.~
@33468 = ~Несравненная харизма.~
@33469 = ~Ничего интересного женщина больше сказать не может.~
@33470 = ~Этой женщине больше нечего тебе сказать.~
@33471 = ~Уйти.~
@33472 = ~«Нет. Прощай».~
@33473 = ~Долора~
@33474 = ~Мает~
@33475 = ~Тарин~
@33476 = ~Биш~
@33477 = ~Разрисованный бандит~
@33478 = ~Маг из Голодных Псов~
@33479 = ~«Тогда прощай».~
@33480 = ~Уйти.~
@33481 = ~«Дык! На новый клинок мне хватит!»~
@33482 = ~«Слыхал, ты недавно ночью столкнулся с Шивом».~
@33483 = ~«А то, я его неплохо порезал, как надо!»~
@33484 = ~«Подходящее имечко у Гнилого, а?»~
@33485 = ~«Ага, воняет той же гнилью, что и Сборщики! Ха! Ха! Ха!»~
@33486 = ~«Ты всё ещё возишься с той девчонкой-тифлингом?»~
@33487 = ~«Эй, не лезь не в своё дело, слышал?!»~
@33488 = ~«Маловато что-то безмозглых пней в последнее время тут шляется».~
@33489 = ~«Точняк. Я уж подумываю, придётся из аллеи вылазки за бабками делать».~
@33490 = ~«Выглядишь, будто тебя тебя на свалке у Мусорщиков откопали!»~
@33491 = ~«Иди к дьяволу!»~
@33492 = ~«Ик! Ты что, со Сборщиком щас спишь, пень?»~
@33493 = ~«Заткни хлебало, воняет, ублюдок!»~
@33494 = ~«Здоровяк, ты на живого похож меньше, чем Пыльный!»~
@33495 = ~«Отвали, пидор хренов!»~
@33496 = ~«Слыхал я, у Кристалл есть штучки для задниц типа тебя!»~
@33497 = ~«Вот как? Ну, я б вначале её спросил, прежде чем о себе напоминать!»~
@33498 = ~«Эй, ты!»~
@33499 = ~«Мой брат и мой парень… они дерутся! То есть пока ещё только ругаются, но я точно знаю, вмиг до кровопролитья дойдёт! Помоги их разнять, умоляю!»~
@33500 = ~«Тысяча благодарностей, приятель! Вон там они как раз!»~
@33501 = ~«Могу медяков дать, приятель… по крайней мере сотню… только помоги их разнять!»~
@33502 = ~«Спасибо, здоровяк, что остановил драку. Я так боялась, что они поубивают друг друга, и не хотела потерять ни брата, ни моего дорогого Маета».~
@33503 = ~Лицо женщины моментально мрачнеет. «Ты типа думаешь, где находишься, здоровяк, в районе Госпожи? Будь у меня медяки, я б потратила их на еду для семьи! Так что извиняй, нет у меня никакой *награды*… кроме моей признательности», — женщина хмурится и отворачивается от тебя.~
@33504 = ~«Пожалуйста, здоровяк! Останови их!»~
@33505 = ~«Спасибо, здоровяк, что остановил драку. Я так боялась, что они поубивают друг друга, и не хотела потерять ни брата, ни моего дорогого Маета».~
@33506 = ~Она кивает и вынимает из складок своего платья потемневший серебряный браслет: «Вот, здоровяк… все мои сокровища. Правда жизни их обоих того стоят…» Женщина печально вздыхает.~
@33507 = ~Глаза женщины радостно загораются: «Спасибо, здоровяк! И пусть тень Госпожи никогда тебя не накроет!»~
@33508 = ~«Ещё раз спасибо, здоровяк, что остановил эту драку».~
@33509 = ~«Что происходит?»~
@33510 = ~«Прости, но это не мои проблемы. Счастливо».~
@33511 = ~«Тотчас же поговорю с ними…»~
@33512 = ~«Я могу их разнять, но задарма не работаю…»~
@33513 = ~«Прости, но это не мои проблемы. Счастливо».~
@33514 = ~«Вернусь, когда поговорю с ними».~
@33515 = ~«Вернусь, когда поговорю с ними».~
@33516 = ~«С другой стороны, это не моё дело. Счастливо».~
@33517 = ~«Рад был помочь. Счастливо».~
@33518 = ~«В таком случае не помешала бы некоторая награда за мои скромные заслуги…»~
@33519 = ~Уйти.~
@33520 = ~«Постараюсь…»~
@33521 = ~«Вообще-то, я думаю, это вовсе не мои проблемы. Прощай».~
@33522 = ~«Рад был помочь. Прощай».~
@33523 = ~«В таком случае не помешала бы некоторая награда за мои скромные заслуги…»~
@33524 = ~«Без проблем. А теперь я заберу свою награду…»~
@33525 = ~«Постой… забери свой браслет обратно. Тебе ещё пригодится».~
@33526 = ~«Прощай».~
@33527 = ~«Конечно… прощай».~
@33528 = ~«Не проблема. Прощай».~
@33529 = ~От этого паршиво выглядящего головореза пахнет неприятностями.~
@33530 = ~Мужчина оглядывает тебя с ног до головы и плюёт тебе под ноги: «Ты чё? Нарываешься на драку, а?»~
@33531 = ~«Плохи твои дела, придурок… считай нарвался!» — мужчина выхватывает нож с длинным лезвием…~
@33532 = ~«Приветствую…»~
@33533 = ~«Стой!»~
@33534 = ~Оставить его в покое.~
@33535 = ~«Ну да… ты готов?»~
@33536 = ~«Ба, пень, снова привет!»~
@33537 = ~«Нет. У меня к тебе пара вопросов…»~
@33538 = ~«Нет уж, прощай».~
@33539 = ~«Это отучит тебя подкрадываться к расписанным во сне!»~
@33540 = ~Драться.~
@33541 = ~Бежать.~
@33542 = ~Мрачное сердитое выражение словно приросло к лицу этого головореза, искажая его черты. Когда ты приближаешься, он прищуривает глаза.~
@33543 = ~«Заткни своё помойное хайло, ты, уродливый ублюдок! Кто те вообще разрешил тут вонять?! Отвалил по-быстрому, пока мне рожа твоя не надоела и не пустил те кровь!»~
@33544 = ~«Только попробуй, и у самого дырок добавится».~
@33545 = ~«Приветствую…»~
@33546 = ~Оставить его в покое.~
@33547 = ~Уйти.~
@33548 = ~«Подвязки Шивы! *Это* ещё что за вонючка?»~
@33549 = ~«Может, нам стоит откатить этот жалкий труп обратно за награду, а?» — он смотрит на своего друга и покачивает бровями.~
@33550 = ~Мужчина удивлённо поднимает брови: «Эй! Он говорит убираться с дороги…»~
@33551 = ~Мужчина поднимает руки: «Да ладно тебе! Мы ж просто пошутили! Иди своей дорогой…»~
@33552 = ~Лицо мужчины неожиданно мрачнеет, рот искривляет усмешка. «Посмотрим, как ты с этим справишься, покойничек!»~
@33553 = ~«Эй, хватит греметь шкатулкой, чувак. Оставь этого пня в покое. Пошли».~
@33554 = ~Оба мужчины вытаскивают свои ножи…~
@33555 = ~«Ну ты кожеголовый! Он же просто… просто…»~
@33556 = ~«Ого! Глянь-ка на *это*!»~
@33557 = ~«Хм… выглядит так, будто у Пылюков один из трупов сбежал!» — мужчина зло фыркает.~
@33558 = ~«И почему это мы *должны*, а?»~
@33559 = ~«Ага, здоровяк… пошутили, просто пошутили».~
@33560 = ~Оба мужчины вытаскивают свои ножи…~
@33561 = ~«Не нужны проблемы?! Какая досада, ведь…»~
@33562 = ~«Не нужны проблемы?! Какая досада, ведь ты только что крупно в них вляпался!»~
@33563 = ~«Э-э… — мужчина глядит на друга. — Эй, чувак, ты ж не думаешь, что он правда…»~
@33564 = ~Мужик пятится назад: «К несчастью связываться с трупаками Пыльных, чувак… сваливаем…» Мужчины обращаются в бегство.~
@33565 = ~«Очень смешно… а теперь убирайся с дороги».~
@33566 = ~«Прочь с дороги, а не то я убью вас обоих».~
@33567 = ~«Прочь с дороги, а не то я убью вас обоих».~
@33568 = ~«Мне не нужны проблемы… просто позволь пройти».~
@33569 = ~«Мне не нужны проблемы… просто позволь пройти».~
@33570 = ~Застонать, как нежить: «Э-э-э-э-э…»~
@33571 = ~Дать им уйти.~
@33572 = ~Дать им бой.~
@33573 = ~Убежать.~
@33574 = ~Пустить слюну и смотреть на них голодными глазами.~
@33575 = ~«Прочь с дороги, а не то я убью вас обоих».~
@33576 = ~«Прочь с дороги, а не то я убью вас обоих».~
@33577 = ~«Просто позвольте мне пройти. Мне не нужны проблемы».~
@33578 = ~«Просто позвольте мне пройти. Мне не нужны проблемы».~
@33579 = ~«Потому что если не уберётесь — я убью вас обоих».~
@33580 = ~«Потому что если не уберётесь — я убью вас обоих».~
@33581 = ~«Потому что мне не нужны проблемы… просто позвольте пройти».~
@33582 = ~«Потому что мне не нужны проблемы… просто позвольте пройти».~
@33583 = ~«Что ж… я всё равно убью вас обоих».~
@33584 = ~Дать им уйти.~
@33585 = ~Дать им бой.~
@33586 = ~Убежать.~
@33587 = ~Это один из двух кричащих и машущих друг перед другом оружием мужчин. Создаётся впечатление, что в любой момент они могут вцепиться друг другу в глотку…~
@33588 = ~Мужчина поворачивает к тебе лицо, раскрасневшееся от яростного осыпания противника проклятиями: «Чё те надо?! Не видишь разве, я *занят*, придурок!»~
@33589 = ~«Не твоё дело, пень. Уматывай!»~
@33590 = ~«Нет, не можешь! Этот сукин сын продолжает совать свой нос в мою жизнь с Элис, пора его уродливую носяру укоротить! Но это не твоя забота, так что держись подальше!»~
@33591 = ~Мужчина неожиданно умолкает. «Тебя Элис позвала, а? Понятия не имею, кто ты такой, пень, но мне интересно, как ты собираешься нас остановить!»~
@33592 = ~«Парень, ты чё, *спятил*? Посмотри на себя… может, ты здоровый и весь в шрамах, но мне на тебя плевать! Заткни свою шкатулку и *отвали*!»~
@33593 = ~«Почему б те не заняться своим делом?! Иди засунь голову в кучу дерьма, пень!»~
@33594 = ~Мужчина некоторое время рассматривает тебя с головы до ног. «Э-э… чё уж там… уверен, у нас с тем малым найдётся лучший способ разобраться. А кроме того, и Элис будет счастливей…»~
@33595 = ~Мужчина на секунду хмурит брови, затем кивает. «Ты прав, здоровяк… я ж дрался чтоб дать ей шанс избавиться от опеки её брата, а потом просто наплевал на её мольбы, — он вздыхает. — Думаю, мы с тем малым решим наши дела как-нить по-другому…»~
@33596 = ~Парень Элис кивает и улыбается: «Спасиб те, что прекратил эту потасовку… ты славный малый, так и знай».~
@33597 = ~«Спасибо. Прощай».~
@33598 = ~«Приветствую…»~
@33599 = ~Держаться от них подальше.~
@33600 = ~«Твоя возлюбленная хотела, чтобы я не допустил вашей драки».~
@33601 = ~«Интересно, зачем вам двоим драться».~
@33602 = ~«Тогда прощай».~
@33603 = ~«Твоя возлюбленная хотела, чтобы я не допустил вашей драки».~
@33604 = ~«Могу я как-то помочь разрешить спор?»~
@33605 = ~«Тогда прощай».~
@33606 = ~«Твоя возлюбленная хотела, чтобы я не допустил вашей драки».~
@33607 = ~«Тогда прощай».~
@33608 = ~«Избив вас обоих до крови, если понадобится».~
@33609 = ~«Избив вас обоих до крови, если понадобится».~
@33610 = ~«Избив вас обоих до крови, если понадобится».~
@33611 = ~«Избив вас обоих до крови, если понадобится».~
@33612 = ~«Послушай, Элис не хочет, чтобы кто-либо из вас пострадал… разве вы не можете решить свои проблемы, не пугая её до смерти?»~
@33613 = ~«Послушай, Элис не хочет, чтобы кто-либо из вас пострадал… разве вы не можете решить свои проблемы, не пугая её до смерти?»~
@33614 = ~«Вот и мне тоже. Прощай».~
@33615 = ~«Послушай, Элис не хочет, чтобы кто-либо из вас пострадал… Разве вы не можете решить свои проблемы, не пугая её до смерти?»~
@33616 = ~«Послушай, Элис не хочет, чтобы кто-либо из вас пострадал… Разве вы не можете решить свои проблемы, не пугая её до смерти?»~
@33617 = ~«Прекрасно… прощай».~
@33618 = ~«Прекратите драку, а то я вас обоих в кровь изобью».~
@33619 = ~«Прекратите драку, а то я вас обоих в кровь изобью».~
@33620 = ~«Прекратите драку, а то я вас обоих в кровь изобью».~
@33621 = ~«Прекратите драку, а то я вас обоих в кровь изобью».~
