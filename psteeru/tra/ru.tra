@35144 = ~Оставить труп в покое.~
@35145 = ~Труп не реагирует. Похоже, она слишком «далеко», чтобы отвечать на любые твои вопросы.~
@35146 = ~Несмотря на высохшую и загрубевшую кожу этого трупа, нет сомнения, что когда-то она была прекрасной женщиной средних лет. Тот, кто работал над этим трупом, явно испытывал к ней жалость. Это видно по ровным маленьким стежкам, стягивающим её красивые губы, и по вытатуированному изысканным шрифтом номеру «832» на её лбу.~
@35147 = ~«Так… чем занимаемся в последнее время?»~
@35148 = ~Труп продолжает пялиться на тебя.~
@35149 = ~«Тогда прощай».~
@35150 = ~«Эй. Ты видел, как она смотрела на меня? А? Ты это видел? Как она огибала взглядом изгиб моей затылочной кости?»~
@35151 = ~«О *чём* ты?»~
@35152 = ~«Чт… ты чё, СЛЕПОЙ?! Она меня изучала! Она меня бесстыдно ХОТЕЛА».~
@35153 = ~«Может, хотела, чтобы ты *ушёл*. Она была так поглощена МНОЙ, что не обращала внимания на какую-то глупую болтающуюся башку с большим ртом».~
@35154 = ~«Тобой? Ага, конечно! Уж поверь мне, девочкам под могильной плитой плевать на „физические данные“, на „у меня есть тело“ и „я весь в шрамах и вообще весь из себя крутой“. Им нужны парни с ХАРАКТЕРОМ. Такие, как я, шеф. А трупы вроде ТЕБЯ — обычны, как медяки».~
@35155 = ~«Как скажешь, Морте. Пошли».~
@35156 = ~«Я думаю, ты это себе навоображал. Она зомби. Труп. Мёртвая особа. Скорее всего, она тебя даже не почувствовала».~
@35157 = ~«Ну да, ну да, конечно. Если бы ты был мёртв не меньше моего, то понимал бы сигналы. Может, они слишком ТРУДНОУЛОВИМЫ для тебя, и вот почему я буду проводить СВОИ ночи с какой-нибудь сладкой мёртвой крошкой, пока ты тут ходишь со своими „Э-э?“, „А ш-што происходит?“, „Где мои вус-вус-воспоминания?“»~
@35158 = ~«Как скажешь, Морте. Пошли».~
@35159 = ~«Я думаю, тебе и твоему воображению стоит отдохнуть друг от друга».~
@35160 = ~«Как скажешь, Морте. Пошли».~
@35161 = ~«Ты имеешь в виду этот пустой загробный взгляд?»~
@35162 = ~«Тогда прощай».~
@35163 = ~«Тогда прощай».~
@35164 = ~«Так… чем занимаемся в последнее время?»~
@35165 = ~«Я знаю, что ты не зомби. Ты тут никого не одурачишь».~
@35166 = ~Использовать на трупе свою способность «Разговор с мёртвыми».~
@35167 = ~Этот труп не отвечает. Кажется, она находится слишком далеко отсюда, чтобы ответить.~
@35168 = ~«Тогда прощай».~
@35169 = ~«Тогда прощай».~
@35170 = ~«Тогда прощай».~
@35171 = ~«Приятно было пообщаться. Прощай».~
@35172 = ~Оставить труп в покое.~
@35173 = ~«Приятно было пообщаться. Прощай».~
@35174 = ~Оставить труп в покое.~
@35175 = ~«Приятно было пообщаться. Прощай».~
@35176 = ~Оставить труп в покое.~
@35177 = ~Этот труп не отвечает. Кажется, она находится слишком далеко отсюда, чтобы ответить.~
@35178 = ~Похоже, это труп довольно пожилой, даже можно сказать престарелой женщины. Если не принимать во внимание зловоние бальзамирующей жидкости, швы, стягивающие её рот, и номер «679», пришитый к правой щеке, то, скорее всего, она выглядит почти так же, как и в последние годы своей жизни.~
@35179 = ~«Так… чем занимаемся в последнее время?»~
@35180 = ~Труп продолжает пялиться на тебя.~
@35181 = ~«Тогда прощай».~
@35182 = ~«Эй. Ты видел, как она смотрела на меня? А? Ты это видел? Как она огибала взглядом изгиб моей затылочной кости?»~
@35183 = ~«О *чём* ты?»~
@35184 = ~«Чт… ты чё, СЛЕПОЙ?! Она меня изучала! Она меня бесстыдно ХОТЕЛА».~
@35185 = ~«Может, хотела, чтобы ты *ушёл*. Она была так поглощена МНОЙ, что не обращала внимания на какую-то глупую болтающуюся башку с большим ртом».~
