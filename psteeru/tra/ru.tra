@35738 = ~«Спасибо, прощай».~
@35739 = ~«У меня другие вопросы…»~
@35740 = ~«Спасибо, прощай».~
@35741 = ~«О? Почему это?»~
@35742 = ~«У меня есть ещё вопросы…»~
@35743 = ~«Ясно. Мне пора идти. Прощай».~
@35744 = ~«И какого рода тайны?»~
@35745 = ~«У меня есть ещё вопросы…»~
@35746 = ~«Ясно. Мне пора идти. Прощай».~
@35747 = ~«У меня другие вопросы…»~
@35748 = ~«Думаю, перестанут. Прощай».~
@35749 = ~«Пытаюсь отыскать для неё один пропавший документ».~
@35750 = ~«Неважно, у меня к тебе другие вопросы».~
@35751 = ~«Ничего. Прощай».~
@35752 = ~«Убийцами Милосердия?»~
@35753 = ~«Они могли что-нибудь упустить».~
@35754 = ~«Я хочу спросить о другом…»~
@35755 = ~«Мне пора идти. Прощай».~
@35756 = ~«Они могли что-нибудь упустить».~
@35757 = ~«Ясно. Я хочу спросить о другом…»~
@35758 = ~«Кто-то похитил документ и затем уничтожил. Таким образом долг будет оплачен дважды…»~
@35759 = ~«Кто-то похитил документ… А может, даже уничтожил».~
@35760 = ~~
@35761 = ~~
@35762 = ~Думаю, Байрон Пикит похитил некоторые документы у женщины по имени Трист. А без них она не может доказать, что уже выплатила ссуду, и её продадут в рабство для покрытия долга.~
@35763 = ~«Да… досадно. Так скажи мне, почему Трист продали в рабство? Неужели она не могла вернуть тебе деньги в виде займа?»~
@35764 = ~«Ну, если какое-то доказательство всё же есть, то я собираюсь его найти».~
@35765 = ~«У меня другие вопросы…»~
@35766 = ~«Думаю, я услышал достаточно. Прощай».~
@35767 = ~Я сказал Байрону Пикиту, что собираюсь найти пропавшие бумаги Трист.~
@35768 = ~«Я хотел спросить о другом…»~
@35769 = ~«Ясно. Думаю, я пойду. Прощай».~
@35770 = ~Уйти.~
@35771 = ~Уйти.~
@35772 = ~«У меня на то свои причины».~
@35773 = ~«Он украл мой череп».~
@35774 = ~«Неважно, прощай».~
@35775 = ~Уйти.~
@35776 = ~«И всё же мне нужно его найти».~
@35777 = ~«Он что, настолько крут?»~
@35778 = ~«Ясно. Мне пора идти. Прощай».~
@35779 = ~«И всё же мне нужно его найти».~
@35780 = ~«Ясно. Мне пора идти. Прощай».~
@35781 = ~«Почему?»~
@35782 = ~«Спасибо, я должен идти. Прощай».~
@35783 = ~«Где мне найти этого Лотара?»~
@35784 = ~«Спасибо, прощай».~
@35785 = ~«У меня кое-какие вопросы…»~
@35786 = ~«У меня кое-какие вопросы…»~
@35787 = ~«Я хочу поговорить с тобой о Трист».~
@35788 = ~«Неважно, прощай».~
@35789 = ~«Расскажи мне об открытом рынке».~
@35790 = ~«Я хочу спросить о другом…»~
@35791 = ~«Спасибо, прощай».~
@35792 = ~Ты видишь неистовствующего аукциониста. Он суетится и постоянно что-то кричит, зазывает народ и топает ногами. Похоже, он несколько склонен к мелодраме, и из-за этого его лицо принимает странные выражения при каждом взмахе руки…~
@35793 = ~Он бросает на тебя взгляд и даёт толпе знак, что делает перерыв. «Что ж, и тебе дарую тысячу приветствий, сэр! — а затем он замечает твои шрамы и восклицает: — Знаешь, хватило одного моего проницательного взгляда на тебя, сэр, чтобы понять: я вижу человека, ищущего целительные амулеты».~
@35794 = ~Он окидывает тебя изумлённым взглядом и указывает на себя обеими руками. «Есть ли у меня, Дерана, амулеты? — он выдерживает эффектную паузу. — Нет, сэр, у меня их нет… но, не стоит из-за этого расстраиваться. У меня есть масса другого на продажу». Он указывает на группу скованных цепями людей на аукционном помосте позади себя.~
@35795 = ~Он трясёт головой: «Нет, сэр! Это работающие по контракту слуги, а не рабы. По большей части они виновны в незначительных преступлениях. Доход от продажи пойдёт на оплату их долга городу. После окончания срока их службы они снова будут свободными гражданами».~
@35796 = ~Он награждает тебя ослепительной улыбкой. «Я не забиваю себе голову такими мыслями. Моя задача — продать их по контракту согласно постановлению суда города Сигил, — он понижает голос и наклоняется к тебе. — Ну и, конечно, получить процент от прибыли. За услуги, ну ты понимаешь». Он выпрямляется.~
@35797 = ~Он качает головой: «Тогда ты только напрасно тратишь время, своё и моё».~
@35798 = ~Он широко улыбается и разражается смехом. «Прекрасно, тогда предъяви мне эти доказательства», — он протягивает тебе руку.~
@35799 = ~Он открывает документ и бегло его просматривает. Через минуту он складывает документ, убирает его в карман рубашки и вздыхает: «По-видимому, суд должен принести леди Трист свои извинения, сэр. С этого момента она свободна, а я сделаю всё необходимое, чтобы её положение и собственность были ей возвращены».~
@35800 = ~«Нет, тебе спасибо. Мало кто сделал бы то, что сделал ты, сэр, — он кланяется тебе. — Извини, мне нужно поговорить с леди Трист. Счастливо». Он направляется к Трист.~
@35801 = ~Он излишне подчёркнуто пожимает плечами: «Точно не знаю, но думаю, что воровство, оскорбление действием или неспособность расплатиться по долгам. Это самые распространённые правонарушения».~
@35802 = ~Он трясёт головой: «Нет времени языком махать, дружище. Надо дело делать! Говори побыстрее!»~
@35803 = ~Точка отсчёта.~
@35804 = ~Он смотрит на тебя в притворном беспокойстве: «Я бы сказал, что это очень даже опасно, дружище… у меня нет ни малейшего желания подвергать тебя опасности».~
@35805 = ~Он неистово хохочет: «Отлично, дружище. Лотар — Повелитель, хозяин знаменитых Костей Ночи. Библиотеки, где сами мертвецы служат хранилищами тайных знаний. Все мертвецы Сигила и планов нашёптывают ему свои секреты в Зале Черепов».~
@35806 = ~«Поищи к югу и востоку от рыночного квартала… ты наверняка найдёшь разрушенное здание, а там отыщешь ведущую вниз лестницу из костей. Эта лестница и должна привести тебя в Зал Черепов».~
@35807 = ~Он улыбается: «Не-а, дружище, больше я тебе ничем помочь не смогу. Я и так сказал больше чем следовало и о том, о чём не следовало. Пора мне вернуться к моим клиентам». Он отворачивается.~
@35808 = ~«Череп? — он выглядит смущённым. — Спрос на них невелик, по крайней мере на те, что отделены от тела…» Он хмурится, затем поворачивается к тебе, его голос драматично понижается: «Если только, конечно…»~
@35809 = ~«Ну, пропавшие черепа могут быть очень серьёзным делом, очень опасным делом. Понимаешь, если кому-то нужно продать череп, то купят его лишь несколько избранных людей в Сигиле…» — он делает паузу. «И почти наверняка, дружище, одним из них окажется… — он кидает осторожные взгляды налево и направо, затем заговорщически шепчет тебе, — …сам Лотар, Повелитель Костей!»~
@35810 = ~Он широко разводит руками: «Это Нижний район, сэр. Дом простых людей и почти ничего более. Пожалуй, единственное, что стоит упомянуть, — это Кузница, открытый рынок и осадная башня».~
@35811 = ~Он разводит руки в стороны и смотрит в небо. «Мастерская созидания, где сталь и души превращаются в произведения искусства, и в тех стенах само созидание может быть изменено… — он переводит взгляд обратно на тебя. — Так говорят Боготы».~
@35812 = ~Он улыбается: «Благородная фракция: все могут стать богами, если, конечно, смогут узнать достаточно в течение своей жизни, тогда они вырастут, станут совершеннее, станут лучшими душами! Можно ли придумать более благородную фракцию?»~
@35813 = ~«Самая настоящая загадка, даже для меня. Просто появилась однажды. Никто не может туда войти, и никто ещё её не покидал».~
@35814 = ~«Рынок раскинулся к югу отсюда, там каждый найдёт почти всё, что необходимо. Рекомендую посетить».~
@35815 = ~Он смеётся и разводит руки, словно хочет охватить ими весь город. «Великий город золота, город, двери которого ведут куда угодно… — он улыбается и приподнимает бровь, — …и в который ведут двери откуда угодно! О Сигиле нельзя рассказать, его надо познавать на собственном опыте!»~
@35816 = ~Ты видишь аукциониста Дерана. Он улыбается при твоём приближении: «Приятно снова встретиться! Что я могу сделать для тебя в этот изумительный, напоённый ароматами смога день?»~
@35817 = ~Он печально улыбается тебе: «Я не стану отвечать на твои вопросы, сэр. Я и так подверг нас обоих опасности и не вижу причин продолжать в том же духе…»~
@35818 = ~«Моё имя Деран, дружище! Не может быть, чтобы ты обо мне не слышал. Ты меня поистине ранишь! — его улыбка разрастается, когда он пытается изобразить ранение. — Нет никого другого, кто давал бы людям возможность стать ближе друг к другу». Он указывает на группу скованных цепями людей на аукционном помосте позади себя: «Кого-нибудь хочешь, дружище?»~
@35819 = ~Мгновение он хмурится, затем пожимает плечами: «Хорошо, сэр. Так что насчёт Трист?»~
@35820 = ~Аукционист хмурится. «Конечно, сэр… если ты удовлетворяешь требованиям суда Сигила и можешь оплатить контракт», — он тебе улыбается.~
@35821 = ~Он начинает перечислять, загибая пальцы на руке: «Во-первых, необходимо быть гражданином города Сигил. Во-вторых, необходимо предъявить доказательства постоянного проживания в Сигиле и возможности содержать слугу. И наконец, покупатель не должен быть судим сам».~
@35822 = ~Он ослепляет тебя своей улыбкой и показывает на толпу рядом: «Я начну торги с пяти сотен медных монет, сэр».~
@35823 = ~Он изображает печаль и трясёт головой: «Она должна быть продана с аукциона лицу, предлагающему самую высокую цену, сэр. Таков закон».~
@35824 = ~Он смеётся и смотрит на тебя: «Как судебный исполнитель, я могу выступить перед судом с новыми свидетельствами по делу Трист, и дело может быть пересмотрено. У тебя есть доказательства?»~
@35825 = ~Он кивает: «Собираешься ли ты искать таковые доказательства от имени мисс Трист?»~
@35826 = ~Он всматривается в твоё лицо, пытаясь определить серьёзность твоих намерений: «Ладно. Пока я не буду продавать Трист, сэр. Удачи в твоём предприятии. А теперь оставь меня, чтобы мы могли заняться каждый своим делом».~
@35827 = ~Аукционист вздыхает, затем хмурится. «А ты бы на её месте что говорил? — он качает головой. — Я слышал её историю, сэр. Но хоть леди и вызывает у меня сочувствие, я ничего не могу сделать без доказательств её невиновности».~
@35828 = ~Лестница, поднимающаяся на третий этаж~
@35829 = ~Лестница, спускающаяся на второй этаж~
@35830 = ~Лестница, спускающаяся на первый этаж~
@35831 = ~Лестница, поднимающаяся на второй этаж~
@35832 = ~На улицу Протяжных Вздохов~
@35833 = ~Назад в Улей~
@35834 = ~«Приветствую».~
@35835 = ~Не обращать на него внимания.~
@35836 = ~«У тебя есть амулеты?»~
@35837 = ~«У меня кое-какие вопросы…»~
@35838 = ~«Неважно. Прощай».~
@35839 = ~«Ты продаёшь рабов?»~
@35840 = ~«Я хочу задать тебе пару вопросов…»~
@35841 = ~«Мне пора идти. Прощай».~
@35842 = ~Правда: «Всё равно для меня это работорговля».~
@35843 = ~Правда: «Похоже на хороший способ оплаты их долгов обществу».~
@35844 = ~Правда: «Неважно, мне, в общем-то, всё равно».~
@35845 = ~«Ты сказал, что они преступники. И какие же преступления они совершили?»~
@35846 = ~«Я хочу задать тебе пару вопросов…»~
@35847 = ~«Мне пора идти. Прощай».~
@35848 = ~«Ясно… у меня другие вопросы…»~
@35849 = ~«Мне пора идти. Прощай».~
@35850 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@35851 = ~«У меня был череп, но его украли. Не знаешь, кто бы мог это сделать?»~
@35852 = ~«Я бы хотел спросить тебя о Трист».~
@35853 = ~«Кто ты?»~
@35854 = ~«Не расскажешь мне об этом районе?»~
@35855 = ~«Не расскажешь мне о Сигиле?»~
@35856 = ~«Мне пора идти. Прощай».~
@35857 = ~«Знаешь, я люблю опасность. Подвергай смело».~
@35858 = ~«Ясно. Я хотел спросить о другом…»~
@35859 = ~«Я должен идти. Прощай».~
@35860 = ~«Где мне найти это место?»~
@35861 = ~«Спасибо. У меня другие вопросы…»~
@35862 = ~«Мне пора идти. Прощай».~
@35863 = ~«Ясно. Прощай».~
@35864 = ~«Продолжай…»~
@35865 = ~«Расскажи мне о Кузнице».~
@35866 = ~«Расскажи мне об осадной башне».~
@35867 = ~«Расскажи мне об открытом рынке».~
@35868 = ~«У меня ещё кое-какие вопросы…»~
@35869 = ~«Спасибо, прощай».~
@35870 = ~«Боготы?»~
@35871 = ~«Расскажи мне об осадной башне».~
@35872 = ~«Расскажи мне об открытом рынке».~
@35873 = ~«У меня ещё кое-какие вопросы…»~
@35874 = ~«Спасибо, прощай».~
@35875 = ~«Расскажи мне об осадной башне».~
@35876 = ~«Расскажи мне об открытом рынке».~
@35877 = ~«У меня ещё кое-какие вопросы…»~
@35878 = ~«Спасибо, прощай».~
@35879 = ~«Расскажи мне о Кузнице».~
@35880 = ~«Расскажи мне об открытом рынке».~
@35881 = ~«У меня ещё кое-какие вопросы…»~
@35882 = ~«Спасибо, прощай».~
@35883 = ~«Расскажи мне о Кузнице».~
@35884 = ~«Расскажи мне об осадной башне».~
@35885 = ~«У меня ещё кое-какие вопросы…»~
@35886 = ~«Спасибо, прощай».~
@35887 = ~«У меня ещё кое-какие вопросы…»~
@35888 = ~«Спасибо, прощай».~
@35889 = ~«У меня кое-какие вопросы…»~
@35890 = ~«У меня кое-какие вопросы…»~
@35891 = ~«Я хотел бы спросить тебя о Трист».~
@35892 = ~«Ничего, прощай».~
@35893 = ~Уйти.~
@35894 = ~«Ты продаёшь рабов?»~
@35895 = ~«Я хотел спросить о другом…»~
@35896 = ~«Нет, спасибо. Прощай».~
@35897 = ~«Могу я приобрести контракт на неё?»~
@35898 = ~«Она говорит, что её обвинили ложно».~
@35899 = ~«У меня есть доказательства её невиновности».~
@35900 = ~«Неважно. Счастливо».~
@35901 = ~«Каковы требования?»~
@35902 = ~«Неважно. Прощай».~
@35903 = ~«Ясно. И сколько стоит контракт на неё?»~
@35904 = ~«А если я смогу доказать, что она невиновна?»~
@35905 = ~«Неважно. Прощай».~
@35906 = ~«А что, если я хочу выкупить её контракт напрямую, без торгов?»~
@35907 = ~«Ясно. Какие требования предъявляют к покупателям?»~
@35908 = ~«А если я смогу доказать, что она невиновна?»~
@35909 = ~«Неважно. Прощай».~
@35910 = ~«Не сегодня».~
@35911 = ~«Да».~
@35912 = ~«Да».~
@35913 = ~«Не знаю…»~
@35914 = ~«Спасибо, прощай».~
@35915 = ~«А что, если я смогу доказать её невиновность?»~
@35916 = ~«Хорошо, я собираюсь ей помочь».~
@35917 = ~«Ты прав, счастливо».~
@35918 = ~Дать ему документ.~
@35919 = ~«Неважно. Прощай».~
@35920 = ~«Спасибо, Деран».~
@35921 = ~«Прощай».~
@35922 = ~Мужчина слегка поворачивается на твоё приветствие, ровно настолько, чтобы видеть тебя. Ты обращаешь внимание на его бледное лицо и измождённый вид. Он окидывает тебя пустым взглядом. Владелец магазина, похоже, ничего этого не замечает и продолжает изливать потоки бессмысленных слов.~
@35923 = ~Не обращать на него внимания.~
@35924 = ~«У меня вопросы…»~
@35925 = ~«Ты… в порядке?»~
@35926 = ~«Прощай».~
@35927 = ~Мужчина медленно поворачивается обратно к хозяину магазина и кивает в ответ на какую-то реплику. Тебе кажется, что кивок запоздал и разговор уже пошёл дальше, но лавочник не придаёт этому значения. Затем мужчина медленно переключает своё внимание обратно и тупо пялится на тебя.~
@35928 = ~«Ты… в порядке?»~
@35929 = ~«Неважно. Прощай».~
@35930 = ~Мужчина, продолжая глазеть на тебя, медленно кивает. Ты ожидаешь ответа, но он ничего не говорит, только смотрит. Ты уже собираешься разочаровано отвернуться, как вдруг улавливаешь какой-то гнилостный запах, похоже, исходящий от него.~
@35931 = ~Подойти поближе и принюхаться.~
@35932 = ~Не обращать внимания и уйти.~
@35933 = ~Ты наклоняешься к нему и неуверенно принюхиваешься. Как только ты это делаешь, запах тлена заполняет твои ноздри, запах, врезавшийся в память ещё в Мортуарии. Так пахнет мёртвая плоть, поддерживаемая магией.~
@35934 = ~«Ты зомби, да?»~
@35935 = ~«Ты зомби, да?»~
@35936 = ~Мужчина снова медленно кивает тебе, затем переключает своё внимание на хозяина. Он игнорирует все твои дальнейшие попытки общения.~
@35937 = ~«Прощай».~
@35938 = ~Создание продолжает таращиться на тебя пустым взглядом. Медленно, словно прикладывая огромные усилия, оно отвечает тебе. Только благодаря твоей способности говорить с мёртвыми ты понимаешь его слова: «Да… я… Димтри».~
@35939 = ~«Зачем ты здесь, Димтри?»~
@35940 = ~«У меня вопросы…»~
@35941 = ~«Прощай».~
@35942 = ~Димтри медленно бросает взгляд на хозяина магазина и делает слабое движение рукой в его сторону. Приняв это за проявление интереса, лавочник удваивает усилия в пересказе очередной своей истории бедному созданию. Димтри снова обращает взгляд к тебе: «Хэмрис… он говорит… Хэмрис никогда не замолкает… Ходит по городу… надоел хозяину, надоел всем… Хозяин создал Димтри… велел Димтри говорить с Хэмрисом… Теперь Хэмрис остаётся в магазине… Хозяин счастлив… город счастлив. Димтри — нет…»~
@35943 = ~«Могу я тебе чем-нибудь помочь, Димтри?»~
@35944 = ~«Я хочу тебя кое о чём спросить…»~
@35945 = ~«Счастливо, Димтри».~
@35946 = ~Создание замолкает, затем возобновляет свою медленную речь. Ты почти слышишь умоляющий тон в его голосе. «Да… найди хозяина… Себастьяна… Попроси отпустить меня… Прошу… — на минуту он переключает своё внимание на Хэмриса. — Прошу…»~
@35947 = ~«Почему бы мне просто не положить конец твоим страданиям?»~
@35948 = ~«Ну, не знаю… я подумаю. У меня к тебе вопросы…»~
@35949 = ~«Прощай».~
@35950 = ~Димтри с трудом качает головой: «Нет… хозяин возрождает… Надо просить хозяина… Себастьяна… прошу». Он ждёт твоего ответа.~
@35951 = ~«Конечно, Димтри. Посмотрим, что я могу для тебя сделать».~
@35952 = ~«Прости, Димтри. Это не моё дело, понимаешь?»~
@35953 = ~«Ну, не знаю… я подумаю. У меня к тебе вопросы…»~
@35954 = ~«Прощай».~
@35955 = ~Я согласился помочь Димтри, зомби. Мне нужно найти некоего Себастьяна и попросить того освободить Димтри от его нынешних обязанностей.~
@35956 = ~Ты почти физически ощущаешь чувство облегчения, исходящее от зомби. «Димтри… благодарит тебя, друг…»~
@35957 = ~«Всегда пожалуйста. У меня пара вопросов…»~
@35958 = ~«Счастливо, Димтри».~
@35959 = ~Ты чувствуешь, как разочарование сгущается в воздухе, когда Димтри отворачивается от тебя. Он снова принимается кивать хозяину магазина, который за всё время вашей беседы даже не замедлил словесный ливень.~
@35960 = ~Уйти.~
@35961 = ~Создание едва заметно пожимает плечами: «Знаю… мало… Димтри вызвал… хозяин… Знаю тьму… покой… отдых… Потом Хэмрис… Извини… помог бы тебе… если б мог…»~
@35962 = ~«Не знаешь, где найти Себастьяна?»~
@35963 = ~«Ясно. Тогда пока».~
@35964 = ~Высокий измождённый мужчина по-прежнему занят разговором с хозяином магазина. Хотя говорит только хозяин.~
@35965 = ~«Приветствую».~
@35966 = ~«Просто хотел выразить соболезнование… прощай».~
@35967 = ~«У меня вопросы…»~
@35968 = ~Не обращать на него внимания.~
@35969 = ~Димтри слегка поворачивается при твоём приближении. Ожидание буквально витает в воздухе вокруг него: «Ты… нашёл хозяина? Димтри свободен?»~
@35970 = ~«Не знаешь, где найти Себастьяна?»~
@35971 = ~«Пока нет, Димтри. Но я продолжаю над этим работать. До встречи».~
@35972 = ~Создание замолкает. «Не знаю… Помню голос… приказ быть здесь… Иду… Хэмрис… Больше ничего… Извини».~
@35973 = ~«Ясно, тогда до свидания».~
@35974 = ~Димтри слегка поворачивается при твоём приближении. Ожидание буквально витает в воздухе вокруг него: «Ты… нашёл хозяина? Димтри свободен?»~
@35975 = ~«Да, Димтри. Теперь я знаю, как тебя освободить».~
@35976 = ~«Не сейчас, мне надо идти. До свидания».~
@35977 = ~Димтри поворачивается к тебе лицом и протягивает руки: «Прошу, друг…»~
@35978 = ~Произнести слова из книги Себастьяна.~
@35979 = ~«Не сейчас. Прощай».~
@35980 = ~Ты собираешься с мыслями и осторожно произносишь те самые слова. Потом протягиваешь руку и слегка касаешься лба Димтри.~
@35981 = ~«Покойся с миром, Димтри».~
@35982 = ~Вздохнув, зомби распадается у твоих ног. Кажется, ты слышишь мимолётное *спасибо, друг*, когда он падает на землю.~
@35983 = ~Уйти.~
@35984 = ~Димтри поворачивается к тебе: «Ты… поможешь? Найди… Себастьяна… освободи меня…»~
@35985 = ~«Да, я помогу тебе».~
@35986 = ~«Нет, это не мои проблемы».~
@35987 = ~«Не знаю, я подумаю. Счастливо».~
@35988 = ~Я встретил молодую женщину по имени Карина. Пожалуй, она слишком много болтает и порой всякий вздор, но, в целом, довольно милая. Она мне сказала, что очень одинока.~
@35989 = ~Ты почти физически ощущаешь чувство облегчения, исходящее от зомби. «Димтри… благодарит тебя, друг…»~
@35990 = ~«Где мне найти Себастьяна?»~
@35991 = ~«Всегда пожалуйста. Прощай».~
@35992 = ~Димтри поворачивается к тебе. «Почему ты здесь… Ты отказался помочь… Ты передумал… найди Себастьяна… освободи меня… прошу».~
@35993 = ~«Да, я помогу тебе».~
@35994 = ~«Нет, это не мои проблемы».~
@35995 = ~«Не знаю, я подумаю. Счастливо».~
@35996 = ~Эта высокая стройная женщина, потягивающая вино из маленькой керамической чашки, похоже, кого-то ищет. Черты её лица элегантны и экзотичны, а уши, хотя и частично прикрыты волосами, заметно заострены на концах.~
@35997 = ~~
@35998 = ~«Приветствую».~
@35999 = ~~
@36000 = ~~
@36001 = ~Ты видишь молодую женщину. На её хмуром лице выражение разочарования. Она усмехается при твоём приближении: «И чего же тебе надо?»~
@36002 = ~«Приветствую».~
@36003 = ~Не обращать на неё внимания.~
@36004 = ~Она хмурится и упирает руки в бока: «Отвали, пень! Катись подальше короткой дорожкой».~
@36005 = ~«Что это значит?»~
@36006 = ~«У меня вопросы…»~
@36007 = ~«У тебя проблемы с общением».~
@36008 = ~«Замечательно, думаю, я пойду. Прощай».~
@36009 = ~Женщина скалит зубы и показывает тебе непристойный жест: «Это значит *исчезни*, пьянь! Мне нечего тебе сказать». Она смотрит на тебя вызывающе.~
@36010 = ~«У меня пара вопросов…»~
@36011 = ~«Замечательно, думаю, я пойду. Прощай».~
@36012 = ~Она злобно усмехается: «И я тебе отвечу: хватайся за палочку и ковыляй отсюда!» Она снова награждает тебя непристойным жестом, уже другим.~
@36013 = ~«У тебя проблемы с общением».~
@36014 = ~«Замечательно, думаю, я пойду. Прощай».~
@36015 = ~Она хохочет: «Ага, и я не разбежалась ничего менять. А теперь уматывай туда, где всегда темно!»~
@36016 = ~«Замечательно, думаю, я пойду. Прощай».~
@36017 = ~Ты видишь молодую женщину. На её хмуром лице выражение разочарования. Она усмехается при твоём приближении: «И чего тебе надо теперь?»~
@36018 = ~«У меня вопросы…»~
@36019 = ~«Ничего, прощай».~
@36020 = ~Парень по имени Лазло сказал, что знает о портале возле осадной башни. Он расположен на подъёмном мосту или напоминающем его сооружении, он не смог описать точно. Интересно, куда ведёт портал?~
@36021 = ~Ленни держит долговую расписку Трист на складе. Я могу получить её у клерка.~
@36022 = ~Ленни держит доказательства незаконной деятельности Байрона Пикита на складе. Он предложил мне отдать их кому-нибудь из Гармониума, кому бы я доверял. Я могу получить доказательства, поговорив с клерком.~
@36023 = ~Корвус сказал, что Байрон Пикит подозревается в преступной деятельности. Похоже, он стоит за большей частью преступлений, совершаемых на открытом рынке Нижнего района.~
@36024 = ~По словам Корвуса, он достаточно доверяет Ленни, чтобы не бояться повернуться к тому спиной.~
@36025 = ~Корвус сказал, что Ленни — вор-профессионал, которому неоднократно удавалось избежать поимки. Ещё он сказал, что Ленни не чужды нравственные принципы, так что тот никому не станет причинять вреда.~
@36026 = ~Корвус, похоже, сходит с ума по Карине. Я сказал ему, что она одинока и нуждается в друге.~
@36027 = ~Стражник Гармониума Корвус, похоже, сходит с ума по Карине. Я сказал ему, что она одинока и нуждается в друге.~
@36028 = ~Похоже, на складе какие-то проблемы. Если мне нужны планы гробницы, придётся выяснить, в чём же дело, и разобраться со всем этим.~
@36029 = ~Думаю, я нанял отца Хэмриса, чтобы он построил для меня гробницу, а потом убил его. Не знаю, зачем я это сделал…~
@36030 = ~У Краддока пропал один из его работников, пьяница по имени Джелай. Он говорит, что тот, скорее всего, слоняется пьяным где-нибудь рядом с баром «Горящий труп».~
@36031 = ~Похоже, на складе какие-то проблемы. Если мне нужна подушка из гроба, придётся выяснить, в чём же дело, и разобраться со всем этим.~
@36032 = ~Моими усилиями Сибил смогла безопасно скрыться из логова головорезов. Правда, мне всё время почему-то кажется, что скоро она опять вляпается в какую-нибудь неприятность.~
@36033 = ~В логове головорезов я наткнулся на девчушку по имени Сибил. Выяснилось, что она застряла в логове из-за банды Хаоситектов, у которой что-то вроде общего сбора в комнате, выходящей на улицу Протяжных Вздохов. Она рассказала мне о другой двери, через которую можно пройти, не столкнувшись с бандитами. Я согласился найти ключ от этой двери. Ключ носит с собой один из бандитов, ошивающийся на верхних этажах логова.~
@36034 = ~Ты видишь женщину, лениво перебирающую товары.~
@36035 = ~«Приветствую».~
@36036 = ~Игнорировать женщину.~
@36037 = ~Она смотрит в твою сторону. «Да, здоровяк?»~
@36038 = ~«У меня есть несколько вопросов…»~
@36039 = ~«Неважно. Прощай».~
@36040 = ~Знаком руки она предлагает тебе убраться. «У меня нет времени на это, здоровяк. Оставь меня в покое». Она отворачивается.~
@36041 = ~Уйти.~
@36042 = ~Покупательница, завидев тебя, поворачивается спиной. Она не обращает внимания на твои попытки заговорить с ней.~
@36043 = ~Уйти.~
@36044 = ~Ты видишь мужчину, не спеша перебирающего товары.~
@36045 = ~«Приветствую».~
@36046 = ~Не обращать на него внимания.~
@36047 = ~Он скользит по тебе взглядом: «Да, здоровяк?»~
@36048 = ~«У меня кое-какие вопросы…»~
@36049 = ~«Неважно. Прощай».~
@36050 = ~Мужчина хмурится и отмахивается от тебя: «У меня нет на это времени, здоровяк. Оставь меня в покое». Он отворачивается.~
@36051 = ~Уйти.~
@36052 = ~Завидев тебя, покупатель поворачивается спиной. Он не обращает внимания на попытки заговорить с ним.~
@36053 = ~Уйти.~
@36054 = ~Ты видишь рептилию со змееподобным телом, четырёхпалыми ступнями, кожистыми крыльями и головой дракона. Чешуя, покрывающая тело этого создания, мерзко-зелёного оттенка. Оно стоит вертикально на задних лапах, балансируя с помощью цепкого хвоста. При твоём приближении глаза существа сужаются в щелочки и оно начинает шипеть.~
@36055 = ~«Приветствую».~
@36056 = ~Не обращать внимания на существо.~
@36057 = ~Воздух вокруг существа становится горячим, а чешуя начинает тускло мерцать. Оно окидывает тебя голодным взглядом и кажется готовым нанести удар. Внезапно оно с шипением выпускает поток раскалённого воздуха и слегка расслабляется. «С-с-с-с-с! Уйди. Грос-с-сук не говорит, с-сказано ждать… С-с-с-с-с…» — оно свирепо смотрит на тебя, размахивая хвостом взад-вперёд.~
@36058 = ~«Я от Себастьяна».~
@36059 = ~«Что ты за существо?»~
@36060 = ~«Прощай».~
@36061 = ~Существо ещё немного расслабляется, а воздух остывает. Оно протягивает тебе когтистую лапу. «С-с-с-с-с. Дай Грос-с-суку информацию», — оно выжидающе смотрит на тебя.~
@36062 = ~«Какую информацию?»~
@36063 = ~«Нет, Себастьян послал меня убить тебя».~
@36064 = ~«У меня её с собой нет, пойду возьму. До свидания».~
@36065 = ~Трудно понять выражение лица рептилии, но совершенно очевидно, что ты уже порядком надоел Гросуку. Он начинает яростно размахивать хвостом, воздух снова накаляется: «Нет вопрос-с-с-сов. Дай Грос-с-суку информацию или умри. Грос-с-сук тогда возьмёт информацию с-с-с твоего тела».~
@36066 = ~«Мне надо знать, какая именно часть информации предназначена для тебя. Понимаешь, я выполняю поручения не для одного человека…»~
@36067 = ~«Вообще-то Себастьян послал меня убить тебя».~
@36068 = ~«У меня её с собой нет, пойду возьму. До свидания».~
@36069 = ~Он смотрит на тебя какое-то время, размышляя. Наконец указывает на башню поблизости: «Ос-с-садная башня. С-с-с-с. Как попас-с-сть внутрь. С-с-себастьян с-сказал, что узнает путь…» Гросук делает шаг к тебе и протягивает лапу: «Теперь давай!»~
@36070 = ~«А, эта информация. Очень жаль, Себастьян решил доставить её лично. Скоро он будет здесь».~
@36071 = ~~
@36072 = ~Воздух вокруг Гросука становится всё горячее, а чешуя тускло мерцает. Он снова бросает на тебя голодный взгляд и кажется готовым ударить. Открывает пасть, в которой можно увидеть несколько рядов зубов, острых как бритва: «Нет… Грос-с-сук думает, ты лжёшь! Дашь информацию с-с-сразу — Грос-с-сук убьёт быс-стро, а не медленно. Не дашь… у Грос-с-сука много времени. Вынет вс-с-сё изнутри тебя. Даже пос-с-смотреть тебе дас-с-ст!»~
@36073 = ~«Погоди, нет у меня того, что тебе нужно, но есть кое-что, стоящее моей жизни, как мне кажется».~
@36074 = ~«Вот и ладно, всё равно Себастьян послал меня, чтобы убить тебя».~
@36075 = ~Гросук склоняет голову набок и пристально на тебя смотрит. На какое-то время он с головой уходит в свои мысли. «Грос-с-сук с-с-слушает. Хорошая информация — ты живёшь, — он скалит зубы в неком подобии улыбки. — Не хорошая — ты умираешь. Грос-с-сук даёт с-слово».~
@36076 = ~«Себастьян не может выполнить условия твоего договора. Он и меня-то сюда послал, чтобы убить тебя».~
@36077 = ~«А откуда мне знать, что ты сдержишь своё слово?»~
@36078 = ~«Забудь, всё равно Себастьян послал меня, чтобы убить тебя».~
@36079 = ~Гросук минуту глазеет на тебя, а затем разражается потоком разочарованного шипения. Его когти сжимаются и разжимаются, а хвост хлещет взад-вперёд. Ты замечаешь, как из хвоста у него периодически появляется зазубренное жало. «Да. Информация хорошая. Грос-с-сук дал с-слово, ты живёшь. Грос-с-сук благодарит. Грос-с-сук теперь уйдёт, надо говорить с-с-с С-с-себас-стьяном».~
@36080 = ~«Прощай».~
@36081 = ~Существо пристально смотрит на тебя: «Это с-с-соглашение, ты и Грос-с-сук. Грос-с-сук живёт с-с-соглашениями. Теперь говори».~
@36082 = ~«Себастьян не может выполнить условия твоего договора. Он и меня-то сюда послал, чтобы убить тебя».~
@36083 = ~«Забудь, всё равно Себастьян послал меня, чтобы убить тебя».~
@36084 = ~Без малейшего колебания существо бросается на тебя.~
@36085 = ~Защищаться.~
@36086 = ~Кажется, все мускулы на теле существа напрягаются, когда оно разражается штормом шипящих звуков. Оно начинает подбираться к тебе, потом останавливается. Глаза его источают потоки ненависти, когда оно заговаривает с тобой: «Грос-с-сук не говорит. С-с-с-с-с-с. Тебе везёт, человек. Ты уходишь, и тебе вс-с-сё ещё везёт. Ты ос-с-стаёшься — Грос-с-сук кромс-с-сает!»~
@36087 = ~Передразнить: «Грос-с-с-сук не говорит? Грос-с-сук вроде уже много вс-с-сего с-с-с-сказал для того, кто не говорит».~
@36088 = ~«Я от Себастьяна».~
@36089 = ~«Тогда прощай».~
@36090 = ~Существо склоняет голову набок и пристально смотрит на тебя широко распахнутыми от удивления глазами. Мгновением позже его глаза превращаются в щёлки, наполненные яростью, а тело начинает дрожать от напряжения стальных мышц. Ты слышишь хруст и, глянув вниз, видишь, как его когти погружаются в камень под ногами. Воздух вокруг существа раскаляется и уже почти светится. «Уйди… немедленно. С-с-с-с-с-с-с!»~
@36091 = ~Напасть.~
@36092 = ~Уйти.~
@36093 = ~Ты видишь Гросука, абишая. Похоже, он не очень рад твоему присутствию: «С-с-с-с-с… Ты, с-снова пришёл. Уйди. Грос-с-сук убьёт».~
@36094 = ~«Ты не самое дружелюбное существо на свете, да?»~
@36095 = ~«Я от Себастьяна».~
@36096 = ~«Отлично, пока».~
@36097 = ~Гросук пристально смотрит на тебя, пощёлкивая когтями. Его глаза превращаются в пылающие щели, когда он нагибается, чтобы взглянуть тебе в лицо: «Нет, Грос-с-сук не дружит. Теперь уходи!»~
@36098 = ~«Отлично, пока».~
@36099 = ~Ты видишь привлекательную молодую женщину, одетую в простое платье. Она слоняется по рынку, всё подряд рассматривая, но ничего не покупая. Ты замечаешь, что люди её избегают, хоть и стараются не выставлять это напоказ. Когда ты подходишь, её лицо озаряется радостной улыбкой.~
@36100 = ~«Приветствую».~
@36101 = ~Не обращать на неё внимания.~
@36102 = ~Её улыбка становится ещё шире: «Привет, я Карина. Приятно встретиться, здоровяк». Она продолжает улыбаться, ожидая твоего ответа.~
@36103 = ~«У меня пара вопросов…»~
@36104 = ~Она кивает: «Хорошо. И что же ты хочешь знать?»~
@36105 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@36106 = ~«У меня был череп, но его украли. Не знаешь, кто бы это мог сделать?»~
@36107 = ~«Где бы мне купить оружие?»~
@36108 = ~«Где бы мне купить магические принадлежности?»~
@36109 = ~«Ты, хм… не прочь поболтать, да?»~
@36110 = ~«Неважно. Прощай».~
@36111 = ~Она хмурится. «Лотар… я не знаю никого по имени Лотар. Даже не припоминаю, чтобы слышала такое имя, — она глядит на тебя обеспокоенно. — Ты сказал Повелитель Костей? Звучит зловеще, правда? Для чего кому-то надо называться таким именем?»~
@36112 = ~~
@36113 = ~«Ну… просто это производит впечатление…»~
@36114 = ~«Ну… чтобы все боялись, наверное».~
@36115 = ~~
@36116 = ~«Череп? Зачем он тебе? Это как-то мрачновато, разве не так? А да, если тебе нужен череп, ты можешь найти его в Мортуарии… ну, может, и нет. Теперь, когда я об этом подумала, я вспомнила, что там не очень-то любят раздавать такие вещи… в любом случае я не знаю, кому бы понадобился твой череп. А зачем череп тебе?»~
@36117 = ~~
@36118 = ~«Он мой друг».~
@36119 = ~«Это очень ценная часть моей собственности».~
@36120 = ~~
@36121 = ~Она улыбается и показывает на один из прилавков: «Анзе вон там торгует оружием. Всяким оружием. А ты воин? Ой, какая я глупая, конечно же, воин. В смысле, кем же ты ещё можешь быть со всеми этими шрамами… ой, прости, наверное, не стоило о них говорить. Для тебя они не очень больная тема, я надеюсь?»~
@36122 = ~~
@36123 = ~«Нет, я к ним уже привык».~
@36124 = ~«Вообще-то больная, так что не будем к ним больше возвращаться».~
@36125 = ~~
@36126 = ~Она улыбается и показывает на один из прилавков: «Аалек вон там продаёт всякие волшебные штучки. А ты маг? Ты вроде на них не похож, но, наверное, внешность может быть обманчива. Ведь если подумать об этом как следует, то я и не знаю, как настоящие маги выглядят. Ведь они по-другому выглядят, да?»~
@36127 = ~~
@36128 = ~«Да. Они носят мантии с забавными символами и остроконечные шляпы».~
@36129 = ~«Нет, на самом деле, нет».~
@36130 = ~~
@36131 = ~Она кивает: «Да… по-моему, я понимаю, что ты имеешь в виду. В этом определённо что-то есть. Хм-м. Это даже как-то захватывает, если подумать достаточно долго». Похоже, она теряется в собственных мыслях.~
@36132 = ~«У меня ещё кое-какие вопросы…»~
@36133 = ~Она озадаченно смотрит на тебя: «Правда? Череп? Звучит таинственно. Я ещё ни разу не слышала о ком-то, кто дружил с черепом. Люди заводят домашних животных и всё такое, но не черепа. Но ведь ты и не сказал, что это было домашнее животное, ты же сказал друг, это звучит ещё таинственней». Она задумывается.~
@36134 = ~«У меня ещё кое-какие вопросы…»~
@36135 = ~Она с облегчением вздыхает: «О, хорошо… я не хотела задеть твои чувства или чьи-нибудь ещё. Просто надо быть поосторожнее с тем, что говоришь, верно? Я хочу сказать, что люди бывают разные, и никогда не знаешь. Что одного не заденет, то заденет другого. Так что… как бы то ни было». Она замолкает, чтобы перевести дыхание и улыбнуться.~
@36136 = ~«У меня ещё кое-какие вопросы…»~
@36137 = ~«Правда? Здорово узнать. В смысле, я боюсь магов, так что было бы неплохо знать, как они выглядят на самом деле. Наверное, это всё из-за тех сил, которыми они обладают. Они делают такие невероятные вещи, но никогда не скажешь точно, на что они похожи. Воины, и священники, и… и… ну ты понимаешь, другие могущественные люди, — они и выглядят могущественными со всеми этими вещами, которые с собой носят, по всему видно, что они могущественны. Но не маги», — она замолкает.~
@36138 = ~«Я хотел спросить о другом…»~
@36139 = ~Похоже, она крепко задумывается, барабаня пальцем подбородок. Наконец она кивает: «Да… думаю, ты прав. У меня холодок от одной только мысли об этом. „Повелитель Костей“ — очень страшный титул. Не думаю, что мне захочется связываться с кем-нибудь под таким именем». Она задумывается ещё крепче.~
@36140 = ~«У меня ещё кое-какие вопросы…»~
@36141 = ~Она пожимает плечами: «А, ну… хорошо, значит, тебе нужен череп, это нормально. Люди собирают порой очень странные вещи. Я ничего не собираю, но знаю многих, которые собирают. Хотя ты единственный из тех, кого я знаю, кто собирает черепа. Может, и мне что-нибудь начать собирать…»~
@36142 = ~«У меня ещё кое-какие вопросы…»~
@36143 = ~Похоже, она действительно огорчена. «Прости. Надеюсь, ты простишь меня, я не хотела никого оскорбить или задеть чьи-то чувства. В смысле, я же не люблю, когда меня оскорбляют, так почему я должна оскорблять кого-то другого? Наверное, другому это тоже не понравится… если только он не какой-нибудь ненормальный… или что-то в этом духе», — она смотрит на тебя невинным взглядом.~
@36144 = ~«Я хотел спросить о другом…»~
@36145 = ~Твои слова будоражат её, она показывает на тебя пальцем: «Вот видишь! Именно то, что я имела в виду. Они обладают такими удивительными силами и совершают такие невероятные вещи, но этого никогда не скажешь, просто взглянув на них. Так они могут подобраться к тебе. Вот, например, священники или воины, они ходят со всеми этими своими причиндалами, так что по ним это сразу видно и ясно, что надо быть осторожной. Но не маги». Она окидывает тебя изучающим взглядом.~
@36146 = ~«У меня ещё кое-какие вопросы…»~
@36147 = ~Она шаркает ножкой и обеспокоено смотрит на тебя. «Я, э… ну… мне говорят, что я иногда разговариваю слегка многовато, и, ну… люди меня избегают… и у меня нет друзей, и мужчины у меня тоже нет… порой мне так одиноко…» — она говорит всё тише и тише, пока совсем не замолкает. И стоит, уставившись себе под ноги.~
@36148 = ~«Ну, я понимаю, почему так выходит».~
@36149 = ~«Знаешь, я думаю, что ты неплохой человек, Карина. Ты мне нравишься».~
@36150 = ~«Прощай».~
@36151 = ~Сперва она продолжает стоять и смотреть в землю. Затем ты слышишь её тихие всхлипывания. Она отворачивается от тебя и уходит.~
@36152 = ~Уйти.~
@36153 = ~Она бросает на тебя полный надежды взгляд: «Правда? Огромное тебе спасибо… я даже не знаю твоего имени».~
@36154 = ~Ложь: «Я Адан».~
@36155 = ~«Я и сам его не помню».~
@36156 = ~«Счастливо, Карина».~
@36157 = ~Она улыбается: «Спасибо, Адан. Приятно знать, что у меня есть друг».~
@36158 = ~«Счастливо, Карина».~
@36159 = ~Он хмурится, начинает что-то говорить, потом передумывает. Пожимает плечами: «А что такого в имени? Просто приятно знать, что у меня есть друг». С этими словами она улыбается.~
@36160 = ~«Счастливо, Карина».~
@36161 = ~Ты видишь Карину. Она тебе улыбается: «Привет снова. Милый денёк, не правда ли?»~
@36162 = ~«У меня пара вопросов…»~
@36163 = ~«Неважно. Прощай».~
@36164 = ~Карина оживлённо улыбается: «Привет, друг. Приятно снова тебя встретить».~
@36165 = ~«Просто хотел поздороваться, Карина. Всего тебе хорошего».~
@36166 = ~Карина замечает тебя и лицо её озаряет счастливая улыбка. «Привет! — похоже, что она сейчас лопнет от волнения. — Огромное тебе спасибо, здоровяк! Я так благодарна тебе за то, что ты сделал».~
@36167 = ~«А что я такого сделал, Карина?»~
@36168 = ~Она смеётся: «Ты послал ко мне Корвуса. Я знаю, ведь он мне рассказал. Он боялся ко мне подойти, думал, что у меня толпа поклонников… ну, что я тебе хотела сказать, так это спасибо». Она тебя обнимает.~
@36169 = ~«Не за что, Карина. Я вам обоим желаю счастья».~
@36170 = ~«Спасибо тебе, здоровяк. Надеюсь, ты тоже найдёшь счастье в своей жизни».~
@36171 = ~«Прощай».~
@36172 = ~В углу комнаты ты видишь прячущуюся в тени фигуру. Когда ты приближаешься, на свет выходит молодая женщина. Она одета в свободную тунику, которая, вместе с короткой стрижкой и хрупким телосложением, придаёт ей слегка мальчишеский вид. «На твоём месте я бы туда не ходила», — кивает она в сторону двери в южной стене.~
@36173 = ~При звуках твоего голоса она вздрагивает и прикладывает палец к губам. Немного выждав, она отвечает тебе полушёпотом: «Целая куча этих воющих безумцев, вот что. Похоже, у них что-то вроде сходки. В аллею не выйдешь, пока они не уберутся».~
@36174 = ~«Меня зовут Сибил», — шепчет она, затем плюёт в ладонь и протягивает её для рукопожатия.~
@36175 = ~«Тут что, эхо завелось? Да, воющих безумцев. Они из Голодных Лающих Псов — банды психованных Хаоситектов, головорезов, наводнивших эту часть Улья».~
@36176 = ~«Ты что, не понял? Псы — они ещё большие психи, чем обычные Хаоситы. Член фракции или нет, но войдёшь туда — и ты труп, уж будь уверен».~
@36177 = ~«Я насчитала дюжину. Правда, считала сквозь щель в двери, так что могла чуток ошибиться».~
@36178 = ~«Слушай, можешь играть в героя сколько угодно, но не ввязывай в это меня. Я останусь здесь. И если толпа этих диких животных каким-то чудом не растопчет твои внутренности, может, мы с тобой ещё увидимся», — она отворачивается и ныряет назад, в спасительную безопасность теней.~
@36179 = ~«Должен быть и другой способ пробраться мимо этого зверья, не нарвавшись на схватку. Туда ведёт ещё одна дверь. Насколько я смогла разглядеть, вдоль той самой стены, где дверь, деревянные ящики штабелями. Наверно, можно проскользнуть от *той* двери к выходу на другой стороне комнаты. Тут только одна заминка выходит…»~
@36180 = ~«Дверь-то закрыта… я проверяла. Думаю, ключ у одного из бандюков наверху. А я ещё не настолько с катушек не съехала, чтобы шариться там», — она складывает руки на груди и выжидательно смотрит на тебя.~
@36181 = ~«А как ты думаешь, что я тут делаю? Прячусь я. Забралась сюда в поисках… еды, — ты замечаешь, что при этих словах её рука инстинктивно дёргается в сторону кошелька, висящего на поясе. — Вот только в соседнюю комнату ввалилась толпа лающих кретинов и решила устроить там вечеринку напротив выхода. И вот сижу тут, как крыса в ловушке».~
@36182 = ~«Тут что, эхо завелось? Да, лающих кретинов. Они из Голодных Лающих Псов — банды психованных Хаоситектов, головорезов, наводнивших Улей».~
@36183 = ~«Ты что, не понял? Псы — они ещё большие психи, чем обычные Хаоситы. Член фракции или нет, но войдёшь туда — и ты труп, уж будь уверен».~
@36184 = ~Она открывает рот, собираясь что-то возразить, но резко останавливается. Внимательно посмотрев на тебя, она пожимает плечами: «Ладно, ладно… пусть я воровка. Надо же жить как-то. В любом случае какая тебе разница? Ты явно не из Гармониума и определённо не из той стаи».~
@36185 = ~«Ха! Ничего не получится. Эти звери сначала раскроят череп, а потом спросят, чего ты хотел. Кроме того… я могу тебе помочь».~
@36186 = ~«Снова ты? — Сибил смотрит на тебя с раздражением и, одновременно, с облегчением. — Гореть мне в Бааторе, парень! Как думаешь, а шуметь ещё больше сможешь? Я слышала, как ты топаешь от самого холла».~
@36187 = ~«Откуда мне знать? Почему бы тебе не пойти и не попробовать открыть ту дверь? А я отсюда посмотрю, в щёлочку. Если доберёшься до аллеи целым, я проскользну за тобой».~
@36188 = ~«Должна тебе сказать, здоровяк… впечатляет. Я была уверена, что эти зверюги сжуют тебя и не поморщатся. Ну, думаю, надо сказать тебе спасибо, — на мгновение она замолкает, затем достаёт из кошелька маленький зелёный камушек. — Вот… он был у одного из Псов. Увидимся, здоровяк».~
@36189 = ~«Почему? Что там за дверью?»~
@36190 = ~«Кто ты?»~
@36191 = ~Не обращать на девушку внимания и идти дальше.~
@36192 = ~«Воющих безумцев?»~
@36193 = ~«Кто ты?»~
@36194 = ~«Спасибо за предупреждение. Прощай».~
@36195 = ~«Что ты тут делаешь?»~
@36196 = ~«Спасибо за предупреждение, Сибил. Счастливо».~
@36197 = ~«Хаоситекты? Вообще-то я член этой фракции… они меня пропустят».~
@36198 = ~«Сколько их там?»~
@36199 = ~«Спасибо за предупреждение. Прощай».~
@36200 = ~«Кто ты?»~
@36201 = ~«Сколько их там?»~
@36202 = ~«Спасибо за предупреждение. Прощай».~
@36203 = ~«Дюжина или около того? Вряд ли это можно назвать вызовом».~
@36204 = ~«Похоже, придётся прорываться с боем».~
@36205 = ~«А нет другого пути в аллею?»~
@36206 = ~«Спасибо за предупреждение. Прощай».~
@36207 = ~«С другой стороны… может, мне и не стоит туда идти».~
@36208 = ~«Тогда прощай».~
@36209 = ~«И что за заминка?»~
@36210 = ~«Всегда есть проблемы… иначе было бы неинтересно».~
@36211 = ~«Тогда забудь. У меня хватает своих проблем».~
@36212 = ~«Если там есть ключ… я его найду. Счастливо».~
@36213 = ~«Забудь. Посмотрю, что у меня получится с этими безумцами».~
@36214 = ~«Лающих кретинов?»~
@36215 = ~«Ну-ну, искала еду, значит? А что там в кошельке?»~
@36216 = ~«Врёшь. Ты воровка».~
@36217 = ~«Спасибо за предупреждение. Прощай».~
@36218 = ~«Хаоситекты? Вообще-то я член этой фракции… они меня пропустят».~
@36219 = ~«Сколько их там?»~
@36220 = ~«Спасибо за предупреждение. Прощай».~
@36221 = ~«Сколько их там?»~
@36222 = ~«Спасибо за предупреждение. Прощай».~
@36223 = ~«Ты права… я ни к тем, ни к другим не принадлежу. А не знаешь другого пути в аллею?»~
@36224 = ~«Я всегда могу сдать тебя бандитам… может, за это они меня пропустят».~
@36225 = ~«Сколько их там?»~
@36226 = ~«Неважно. Прощай».~
@36227 = ~«Помочь? Как?»~
@36228 = ~«Мне не нужна помощь какой-то мелкой воровки из сточной канавы. Лучше я сдам тебя бандитам».~
@36229 = ~«Забудь. Посмотрю, что у меня получится с этими сумасшедшими».~
@36230 = ~«Что за дверью?»~
@36231 = ~«Кто ты?»~
@36232 = ~«Это тот самый ключ, о котором ты говорила?»~
@36233 = ~«Я позаботился о тех головорезах, что преграждали выход. Теперь ты можешь уйти».~
@36234 = ~«Неважно. Прощай».~
@36235 = ~«Тогда прощай».~
@36236 = ~«Счастливо, Сибил».~
@36237 = ~«Расскажи мне об этом Лотаре».~
@36238 = ~Ты видишь мужчину средних лет в пыльной одежде. По-видимому, он не пышет здоровьем. У него бледная жёлтая кожа, а на руках гнойники.~
@36239 = ~Он поворачивается и окидывает тебя взглядом ввалившихся глаз. Его глаза подозрительно сужаются и продолжают стрелять по сторонам. «Тебе чего?» — спрашивает он скрипучим голосом.~
@36240 = ~Он переключает внимание на тебя: «На кой мне надоедаешь? Я что, на проводника смахиваю?»~
@36241 = ~Мужчина смотрит на тебя и фыркает: «Вот везёт-то мне… теперь слушай сюда. У меня на это всё времени нету, ясно?» Он отворачивается.~
@36242 = ~Он вздыхает: «Что-то хотел спросить? Валяй».~
@36243 = ~«Ничего такого, что могила не исправит, — он кашляет и смотрит вверх. — Воздух в нашем районе в последнее время совсем никуда. Насколько я понимаю, всё устаканивается, как только останавливается Великая Кузница… или ветер дует от Шпиля».~
@36244 = ~«Всё из-за порталов по большей части», — он заходится в приступе кашля, затем снова смотрит на тебя.~
@36245 = ~«Тут куча дверей на Нижние планы. Через них-то сюда и плохой воздух, и ароматы эти прут, хрен его знает, с какого уровня Бездны. Вот потому-то это и *Нижний* район, — смеётся он. — Гулять тут — как по сковородке: соль, дым, трубы… сплошной покров жёлтого дыма и едкого сернистого газа, вот чем дышит этот район». Он улыбается, и ты замечаешь нехватку зубов во рту. «Мило, да?»~
@36246 = ~«Посерёдке района. Легко найти по трубам. Эти Боготы кучу всего там делают из железа; ничего особо потрясающего, но печка дымит. Неплохая добавка к нашим ароматам».~
@36247 = ~«Верующие. Они там живут, в Великой Кузнице, куют, поют и орут свои глупости, что станут силами через десять по десять и ещё хрен-те сколько раз по десять жизней, — он закатывает глаза, затем харкает чем-то коричневым. — Всё, что для этого надо, — страдать, подчиняться и упорно работать… я страдаю раза в два сильнее и ни хрена никакой силой не стану, понимаешь, пень?» Он невесело смеётся.~
@36248 = ~«Порой, когда ветер дует от шпиля Сигила, смог рассеивается… — он смотрит вверх и кашляет, — …но не надолго».~
@36249 = ~«Гм… — он смотрит на тебя как на сумасшедшего. — Ты что, бестолочь? Магазины, склады, мастерские, все тут кучкуются». Он щурится, глаза его слегка затуманены: «Ищешь что-то определённое?»~
@36250 = ~Мгновение он внимательно осматривает тебя, затем понимающе кивает. «Что, железо закалки требует, ага? — его смех обрывается новым приступом кашля. — Тут такого добра нету; пошарься по ночлежкам в других районах. Если ты, конечно, тут за этим».~
@36251 = ~Он снова смеётся, и это выливается в ещё больший приступ кашля. «Прости, здоровяк. Не бери в голову. Что, собственно, ищешь-то?»~
@36252 = ~«Искать здесь работу — дохлый номер. Её и тем, кто тут живёт-то, не хватает».~
@36253 = ~«Если прикупить пару-тройку вещиц решил, а то и покрупнее отовариться, то я б на твоём месте на рынок сходил», — на него снова нападает кашель.~
@36254 = ~Он лукаво улыбается: «Там можно покупать и продавать, пень. Это же рынок, о чём тут ещё заливать?»~
@36255 = ~«Хм… — он на минуту задумывается. — Ну, есть башня. О ней тут разговоры постоянно ходят».~
@36256 = ~«Ха! — он смеётся, но смех быстро сменяется кашлем. — Одна из самых жутких загадок этого района… говорят, однажды, много-много лет назад, она просто свалилась на Сигил, и никто не знает, как она сюда попала, откуда взялась, и как в эту хрень попасть. Занимает место и служит видом из окна… и все эти пятна от кислоты, следы оружия… похоже, она видала не одну сотню войн, это уж точно».~
@36257 = ~Он ненадолго задумывается, затем пожимает плечами: «Нет, ничего интересного не приходит».~
@36258 = ~Он нервничает и осматривается по сторонам: «Ага… слыхал о таком. Знаешь, не лезь к нему. Его хата — местечко под названием *Кости Ночи* или похожая дребедень».~
@36259 = ~Он хмурится. «Знаешь, у нас пошёл опасный базар… если б я *собирался* что-то сказать, а я не собираюсь, я б посоветовал искать разрушенное здание в этом районе. Может, там что-нить и найдёшь? — он свирепо смотрит на тебя. — Но ты от меня ничего такого не слышал, ага?»~
@36260 = ~Похоже, он чувствует себя не в своей тарелке. «Что, череп пропал? Ну, ты этого от меня, конечно, не слышал, но тут есть народ… — он оглядывается, — …который зарабатывает сбором голов мертвецов. Работают они на громилу по имени Лотар. Называют его *Повелитель Костей*».~
@36261 = ~Мужчина хмурится. «Кто-нить, к кому валят задавать херову кучу дурацких вопросов…» — он пристально на тебя смотрит.~
@36262 = ~Ты видишь мужчину средних лет в пыльной одежде. «Вернулся? — он хмуро смотрит на тебя. — А теперь чего?»~
@36263 = ~Он отвешивает тебе лёгкий поклон. «Зовут Корур. В своё время я был нехилым воякой… — он вздыхает. — Ну, эти деньки прошли, но я всё ещё знаю пару трюков».~
@36264 = ~«Ну… почему бы и нет. Ты уверен, что хочешь сменить работёнку?»~
@36265 = ~«Приветствую».~
@36266 = ~Не обращать на него внимания.~
@36267 = ~«У меня кое-какие вопросы…»~
@36268 = ~«Неважно, прощай».~
@36269 = ~«Тебя хоть найти можно».~
@36270 = ~«Ты вроде выглядишь знающим, а знания мне не помешают».~
@36271 = ~«Что значит проводник?»~
@36272 = ~«Неважно, прощай».~
@36273 = ~Уйти.~
@36274 = ~«Кто ты?»~
@36275 = ~«Ты как себя чувствуешь, нормально?»~
@36276 = ~«Что ты можешь рассказать об этом районе?»~
@36277 = ~«Есть тут что-нибудь интересное в округе?»~
@36278 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@36279 = ~«У меня был череп, но его украли. Не знаешь, кто бы мог это сделать?»~
@36280 = ~~
@36281 = ~«Что тут с воздухом?»~
@36282 = ~«Расскажи мне о Кузнице».~
@36283 = ~«Что там насчёт ветра?»~
@36284 = ~«Ясно. У меня кое-какие вопросы…»~
@36285 = ~«Мне пора идти. Прощай».~
@36286 = ~«Что ты имеешь в виду?»~
@36287 = ~«Ясно. У меня другие вопросы…»~
@36288 = ~«Мне пора идти. Прощай».~
@36289 = ~«Ну, да… ты упоминал Кузницу».~
@36290 = ~«Так что ты про ветер сказал?»~
@36291 = ~«Я хотел спросить о другом…»~
@36292 = ~«Мне пора идти. Прощай».~
@36293 = ~«Боготы?»~
@36294 = ~«Так что тут с воздухом?»~
@36295 = ~«Ты что-то про ветер говорил, не напомнишь?»~
@36296 = ~«У меня другие вопросы…»~
@36297 = ~«Мне пора идти. Прощай».~
@36298 = ~«Что тут с воздухом?»~
@36299 = ~«Ты что-то про ветер говорил, не напомнишь?»~
@36300 = ~«У меня другие вопросы…»~
@36301 = ~«Мне пора идти. Прощай».~
@36302 = ~«Так что тут с воздухом?»~
@36303 = ~«Расскажи мне о Кузнице».~
@36304 = ~«Я хотел спросить о другом…»~
@36305 = ~«Мне пора идти. Прощай».~
@36306 = ~«Чем тут можно заняться?»~
@36307 = ~«Я хотел спросить о другом…»~
@36308 = ~«Мне пора идти. Прощай».~
@36309 = ~«Извини?»~
@36310 = ~«Хочу подзаработать немного».~
@36311 = ~«Хотел бы прикупить кое-чего».~
@36312 = ~«У меня ещё вопросы».~
@36313 = ~«Мне пора идти. Прощай».~
@36314 = ~«Хочу подзаработать немного».~
@36315 = ~«Хотел бы прикупить кое-чего».~
@36316 = ~«У меня ещё вопросы».~
@36317 = ~«Мне пора идти. Прощай».~
@36318 = ~«Хотел бы прикупить кое-чего».~
@36319 = ~«Я хотел спросить о другом…»~
@36320 = ~«Мне пора идти. Прощай».~
@36321 = ~«Что ты можешь рассказать о рынке?»~
@36322 = ~«Я хотел спросить о другом…»~
@36323 = ~«Я хотел спросить о другом…»~
@36324 = ~«Мне пора идти. Прощай».~
@36325 = ~«Я хотел спросить о другом…»~
@36326 = ~«Мне пора идти. Прощай».~
@36327 = ~«Расскажи мне о башне».~
@36328 = ~«Ничего больше в голову не приходит?»~
@36329 = ~«У меня к тебе ещё вопросы…»~
@36330 = ~«Мне пора идти. Прощай».~
@36331 = ~«Ничего больше в голову не приходит?»~
@36332 = ~«У меня к тебе ещё вопросы…»~
@36333 = ~«Мне пора идти. Прощай».~
@36334 = ~«У меня к тебе ещё вопросы…»~
@36335 = ~«Мне пора идти. Прощай».~
@36336 = ~«Где мне это место найти?»~
@36337 = ~«Спасибо. У меня ещё кое-какие вопросы…»~
@36338 = ~«Мне пора идти. Прощай».~
@36339 = ~«Где мне найти этого Лотара?»~
@36340 = ~«Спасибо, прощай».~
@36341 = ~«У меня другие вопросы…»~
@36342 = ~«Мне пора идти. Прощай».~
@36343 = ~«У меня кое-какие вопросы…»~
@36344 = ~«Можешь научить меня воинскому искусству?»~
@36345 = ~«Можешь научить меня воинскому искусству?»~
@36346 = ~«Ясно. У меня кое-какие вопросы…»~
@36347 = ~«Да, уверен».~
@36348 = ~Он поворачивается и слегка улыбается, на время прервав свою работу: «Привет… нужна помощь?»~
@36349 = ~«Ага, ага, я с удовольствием помогу, чем могу… — похоже, парень рад прервать свой труд у печи. — Что хочешь спросить?»~
@36350 = ~«Это место?» — он оглядывается. «Это открытый рынок. Тут весь день тусуется масса всякого продающего и покупающего народу. Я тут уже давно, работаю под присмотром своего папы, — в его голосе появляется холодок. — Однажды мне достанется его ларёк, ага».~
@36351 = ~Он гордо показывает на печь. «Это печь, она нужна для… — он пожимает плечами. — Да без понятия, зачем она нужна, но папа говорит, что она должна всё время быть загружена и хорошо гореть». Он вытирает пот с бровей и оглядывается.~
@36352 = ~Он кивает. «Его зовут Анзе, вон место моего папы, — он указывает на прилавок справа от печи. — Если у него нет того, чего тебе надо, он может подсказать, где это найти».~
@36353 = ~Он ненадолго задумывается. «Тут много чего есть: еда, выпивка, оружие, магия… а может, ищешь припасы?»~
@36354 = ~«Ага, есть тут и магия, — он оглядывает местность и указывает на дальний прилавок. — Там место Аалека, у него кое-что должно быть».~
@36355 = ~«Тогда тебе поможет мой папа, вон его прилавок, — он указывает на прилавок справа от печи. — Его зовут Анзе».~
@36356 = ~Он странно на тебя смотрит, затем пожимает плечами: «Тогда тебе надо пойти к Хэмрису. По-моему, его магазин к юго-востоку отсюда».~
@36357 = ~Он кивает. «О, ага, это и есть Нижний район. Здесь живут обычные люди, вроде меня и моего папы, — его глаза округляются, и он выглядит взволнованным. — А ты в курсе, почему его назвали Нижним?»~
@36358 = ~«Ну, когда его основали, тут была куча порталов в Нижние планы, целая туча, как дырки в сыре, вот поэтому, я думаю, название и прилипло», — он гордо улыбается.~
@36359 = ~Он пожимает плечами. «Для меня это такая же загадка, как и для тебя, здоровяк. Не уверен, была ли тут причина, или просто стечение обстоятельств. Может, Госпожа так пожелала, а может, просто случайность», — он снова пожимает плечами.~
@36360 = ~Его глаза слегка округляются. «Ага, точно. Многие просто задерживаются тут по дороге…» — он нервно сглатывает и беспокойно озирается.~
@36361 = ~«Ага, видел…» — он замолкает и снова сглатывает. «Вот на прошлой неделе я видел пару абишаев, они пришли через портал. Долго говорили, а потом один из них ушёл порталом обратно. А тот, что остался, он всё ещё здесь…» — он хмурится.~
@36362 = ~«Точно не знаю, для меня это звучало просто как шипение или типа того, но вроде как говорили о башне», — он пожимает плечами.~
@36363 = ~«Ага, самое странное зрелище в районе. Никто точно не знает, сколько она уже тут стоит… и внутрь попасть невозможно, прикинь. Закрыта она покруче пояса верности. Хотел бы я знать, что там внутри… — он ненадолго задумывается. — Абишаи показывали на башню и портал. Бьюсь об заклад, они ищут ключ».~
@36364 = ~«Ключ от портала, ведущего в башню. У каждого портала есть ключ, только так и можно его открыть. Ключом может быть жест, предмет или даже мысль… многие пытались попасть в башню. Без разницы, сколько стараешься — ничего не выходит».~
@36365 = ~Он пожимает плечами: «Не знаю, здоровяк. Может быть…»~
@36366 = ~Он на минуту призадумывается. «Сзади башни есть похожая на подъёмный мост штуковина, это к востоку от рынка. Вон там она…» — он смотрит вдаль.~
@36367 = ~«Центр планов, город, в котором пересекаются все дороги. И в нём никогда не скучно, правда. Госпожа Боли здесь — закон, а остальные просто пытаются выжить в её тени», — он разражается хриплым смехом, переходящим в кашель.~
@36368 = ~«Я про неё мало знаю… она не допускает в Сигил силы и извергов, а ещё ни с кем не разговаривает и не договаривается… кроме, может быть, дабусов. И она очень быстро запишет тебя в книгу мёртвых, если вздумаешь поклоняться ей или причинишь вред Сигилу. Её лицо и клинки вокруг него будут последним, что ты увидишь в жизни…»~
@36369 = ~При упоминании лица в окружении клинков на тебя накатывают воспоминания. На какое-то мгновение ты оказываешься стоящим в тёмной аллее, тяжело дыша. К тебе приближается необычайно красивая женщина с венцом из клинков и смертельным холодом в глазах… внезапно видение исчезает, и ты снова оказываешься рядом с парнем.~
@36370 = ~«Это болезнь, ага. Всё от плохого воздуха. Дым и гарь от фабрики; тут порой бывает очень трудно дышать, — он пожимает плечами. — А иногда выходить на улицу вообще небезопасно, особенно когда смог застаивается слишком долго… глаза могут повылазить, в буквальном смысле».~
@36371 = ~«Без понятия. Порой ветер дует от шпиля и очищает город от смога, но это случается не так часто, как хотелось бы, — он моргает, оглядывается и пожимает плечами. — Мне кажется, так угодно Госпоже. Смысла в этом немного. А если хорошенько подумать, то даже и ещё меньше».~
@36372 = ~«Смотреть особо не на что… разве только Великая Кузница впечатляет, можешь сам убедиться… это дом Верующих, прикинь, — он отбрасывает раздумья в сторону. — Почти все самые удивительные зрелища в Верхних районах. Может, лучше там посмотреть? Я слыхал, там есть бордель, Фестхолл и всякие другие места поинтереснее. Правда, точно я не знаю. Всю жизнь тут провёл».~
@36373 = ~«Центр района. Впечатляющее сооружение, это уж точно. Не пропустишь, просто иди на север. Узнаешь по большим воротам», — он отмечает место на твоей карте.~
@36374 = ~«У них целая куча имён: Верующие, Боготы, Верующие в Источник… обычно их все называют просто Боготами. У них хата в Великой Кузнице, и, похоже, дела у них там неплохо идут. Они славные парни. Верят, что все могут стать великими, прямо как силы, стоит только приложить усилия. Может, придётся начинать жизнь сначала много раз, но однажды ты им станешь».~
@36375 = ~Он улыбается: «О, я… и мой папа… мы Индепы… мы из фракции, которая вообще даже не фракция… у нас считается, что люди свободны поступать как им хочется. Так что мы довольно-таки вольная компания и не особо хорошо относимся к другим фракциям».~
@36376 = ~Он бросает на тебя взгляд. «Фракции управляют большей частью Сигила и повседневными делами. Их много: есть Мёртвые, Пыльные, они занимаются мертвецами на улицах, ещё есть Старейшины, они издают законы, и Чующие… в общем фракций много. Здесь, в Нижнем районе, мы чаще всего имеем дело с Верующими, Боготами, — он кивает куда-то в сторону. — У них хата в Великой Кузнице, да и люди они приятные».~
@36377 = ~Он пожимает плечами: «Да почти ничего. Даже и не интересовался, просто был Индепом и всё. В домах фракций есть куча народу, они тебе всё по полочкам разложат. Пойди да поговори с ними».~
@36378 = ~Он выглядит сильно взволнованным: «Череп пропал, да уж! Спорим, я знаю, что с ним случилось… в округе есть чувак — маг или священник, кто там его разберёт, — который собирает черепа, они у него на полках стоят, словно книги. Они мертвы, но его магия может заставить их отвечать на вопросы, пусть даже они давно в книге мёртвых».~
@36379 = ~Он хмурится. «Не уверен, так-то. Слышал, он зависает в каком-то разрушенном доме неподалёку, но я там никогда не был, — он щёлкает пальцами. — Другие могу знать… попробуй спросить Себастьяна».~
@36380 = ~Он неопределённо машет рукой на запад. «Вернись на площадь, а потом немного на север и на запад. Себастьян обычно возле такой штуки, она ещё на разводной мост похожа».~
@36381 = ~«Приятно снова встретиться. Есть ещё вопросы? Говори, может, чем и помогу».~
@36382 = ~В арке перед тобой есть что-то… до боли знакомое. Воздух между колоннами охвачен странным, пробирающим до костей холодом, словно сама арка ведёт в другое, более холодное пространство. Откуда-то ты ЗНАЕШЬ, что это и есть портал в Крепость Сожалений… теперь тебе остаётся только его открыть.~
@36383 = ~Сжать зубы и содрать кусок кожи с левого предплечья…~
@36384 = ~Отойти от портала… пока.~
@36385 = ~Не обращать на него внимания.~
@36386 = ~«Да, у меня вопросы…»~
@36387 = ~«Нет, прощай».~
@36388 = ~«Что это за место?»~
@36389 = ~«Не расскажешь мне об этом районе?»~
@36390 = ~~
@36391 = ~«Что ты можешь рассказать о Сигиле?»~
@36392 = ~«Почему тут у всех жёлтая кожа?»~
@36393 = ~«На что тут в округе стоит посмотреть?»~
@36394 = ~«Я потерял череп… не знаешь никого, кому бы он мог понадобиться?»~
@36395 = ~«Мне пора идти. Прощай».~
@36396 = ~«А что ты тут делаешь?»~
@36397 = ~~
@36398 = ~«У меня кое-какие вопросы…»~
@36399 = ~«Твой отец — один из местных торговцев?»~
@36400 = ~«Ясно. У меня ещё вопросы…»~
@36401 = ~«Мне пора идти. Прощай».~
@36402 = ~«Какие товары тут можно купить?»~
@36403 = ~Ты видишь стройную девушку-тифлинга, стоящую к тебе спиной. Ты замечаешь, что её руки и перевёрнутый стол перед ней перепачканы свежим слоем чего-то, напоминающего розовую краску. Похоже, она не обращает внимания на твоё приближение.~
@36404 = ~При звуках твоего голоса девушка поворачивает голову. Её лицо, хоть местами грязное и забрызгано розовой краской, всё же поразительно прекрасно. Она озаряет тебя широкой озорной улыбкой, а затем возвращается к своему импровизированному полотну.~
@36405 = ~Девушка-тифлинг кажется полностью поглощённой своей картиной. На тебя она совсем не обращает внимания.~
@36406 = ~«Приветствую».~
@36407 = ~Игнорировать девушку и идти дальше.~
@36408 = ~«У меня пара вопросов…»~
@36409 = ~Оставить девушку наедине с её картиной.~
@36410 = ~Оставить девушку наедине с её картиной.~
@36411 = ~«Где тут торгуют магическим товаром?»~
@36412 = ~«Где мне купить оружие?»~
@36413 = ~«Где мне купить подушку для гроба?»~
@36414 = ~«У меня к тебе другие вопросы…»~
@36415 = ~«Мне пора идти. Прощай».~
@36416 = ~«Где мне купить оружие?»~
@36417 = ~«Где мне купить подушку для гроба?»~
@36418 = ~«У меня к тебе другие вопросы…»~
@36419 = ~«Мне пора идти. Прощай».~
@36420 = ~«Где тут торгуют магическим товаром?»~
@36421 = ~«Где мне купить подушку для гроба?»~
@36422 = ~«У меня к тебе другие вопросы…»~
@36423 = ~«Мне пора идти. Прощай».~
@36424 = ~«Где тут торгуют магическим товаром?»~
@36425 = ~«Где мне купить оружие?»~
@36426 = ~«У меня к тебе другие вопросы…»~
@36427 = ~«Мне пора идти. Прощай».~
@36428 = ~«Нет. И почему же его назвали Нижним?»~
@36429 = ~«Мне всё равно, почему. Я тебя о другом хотел спросить…»~
@36430 = ~«Мне пора идти. Прощай».~
@36431 = ~«А почему здесь так много порталов на Нижние планы?»~
@36432 = ~«Какие-нибудь создания выходили из этих порталов?»~
@36433 = ~«У меня ещё вопросы…»~
@36434 = ~«Какие-нибудь создания выходят из этих порталов?»~
@36435 = ~«Что-то ты нервничаешь, сам их видел?»~
@36436 = ~«Башня?»~
@36437 = ~«У меня ещё вопросы…»~
@36438 = ~«А где точно этот портал?»~
@36439 = ~«О чём говорили абишаи?»~
@36440 = ~«Я хотел спросить о другом…»~
@36441 = ~«Мне пора идти. Прощай».~
@36442 = ~«Расскажи мне об этой Башне».~
@36443 = ~«Да, немного».~
@36444 = ~«Я хотел спросить о другом…»~
@36445 = ~«Мне пора идти. Прощай».~
@36446 = ~«У меня другие вопросы…»~
@36447 = ~«Мне пора идти. Прощай».~
@36448 = ~«Что ты можешь рассказать о Госпоже Боли?»~
@36449 = ~«Мне пора идти. Прощай».~
@36450 = ~«Интересно…»~
@36451 = ~«Я хотел спросить о другом…»~
@36452 = ~«Мне пора идти. Прощай».~
@36453 = ~«С этим можно что-нибудь сделать?»~
@36454 = ~«Я хотел спросить о другом…»~
@36455 = ~«Мне пора идти. Прощай».~
@36456 = ~«Расскажи мне о Кузнице».~
@36457 = ~«Расскажи мне о Верующих».~
@36458 = ~«У меня другие вопросы…»~
@36459 = ~«Мне пора идти. Прощай».~
@36460 = ~«Расскажи мне о Верующих».~
@36461 = ~«Ясно. У меня другие вопросы».~
@36462 = ~«Мне пора идти. Прощай».~
@36463 = ~«Расскажи мне о Кузнице».~
@36464 = ~«Так они ещё одна местная фракция. А ты в какой-нибудь состоишь?»~
@36465 = ~«Интересно. У меня другие вопросы…»~
@36466 = ~«Мне пора идти. Прощай».~
@36467 = ~«Для чего нужны все эти фракции?»~
@36468 = ~«У меня ещё кое-какие вопросы…»~
@36469 = ~«Мне пора идти. Прощай».~
@36470 = ~«А что ты можешь сказать об остальных фракциях?»~
@36471 = ~«У меня ещё кое-какие вопросы…»~
@36472 = ~«Мне пора идти. Прощай».~
@36473 = ~«А что ты можешь сказать об этой Кузнице?»~
@36474 = ~«Ясно. У меня к тебе другие вопросы…»~
@36475 = ~«Мне пора идти. Прощай».~
@36476 = ~«Где бы мне его найти?»~
@36477 = ~«Где мне найти Себастьяна?»~
@36478 = ~«Ясно. У меня другие вопросы…»~
@36479 = ~«Мне пора идти. Прощай».~
@36480 = ~«Спасибо. У меня другие вопросы…»~
@36481 = ~«Мне пора идти. Прощай».~
@36482 = ~«Да, пара вопросов есть…»~
@36483 = ~«Нет, прощай».~
@36484 = ~Ты видишь диковатого молодого человека в поношенной одежде. Его глаза бегают, оглядывая окрестности. Он замечает тебя и настороженно следит за твоим приближением.~
@36485 = ~Он осматривает тебя с головы до ног, затем оглядывается. Вернувшись взглядом к тебе, он злобно усмехается: «Лучше бы у тебя была хорошая причина беспокоить Ленни, пень».~
@36486 = ~Он смеётся тебе в лицо. «Я не проводник. Если есть вопросы — спроси кого-нибудь из них, — его улыбка становится шире. — Лучше отвали, пока я не пустил тебе кровь».~
@36487 = ~Улыбка исчезает с его лица, он хмурится: «Нет, я не отвечаю на вопросы, пень. Я же тебе сказал — пойди найди проводника, вот и иди». Он смотрит враждебно.~
@36488 = ~Ленни прекращает улыбаться и внимательно тебя осматривает. Его глаза задерживаются на твоих шрамах, и он сглатывает. Внезапно он хмурит брови и, похоже, нервничает: «Пикит… послал тебя? Зачем?»~
@36489 = ~Он хмурится: «Что ещё за вопросы…» Ты замечаешь, как он напрягся.~
@36490 = ~Мгновение он колеблется, а затем слегка расслабляется. Похоже, он ждал какого-то другого вопроса. Он улыбается: «Похищенный череп, да? Это работа парней Лотара, не моя».~
@36491 = ~Он злобно усмехается. «Повелитель Костей, так его зовут, им он и является. Он верховный священник из верховных священников какой-то крупной силы, не знаю, какой, — он смеётся. — Поселился в месте под названием Кости Ночи».~
@36492 = ~Он хмурится. «Вот уж не думаю, что горю желанием отвечать на этот вопрос… — он пристально смотрит на тебя какое-то время, затем пожимает плечами. — Разрушенное здание к югу от осадной башни, не заметить его сложно». Он снова злобно ухмыляется.~
@36493 = ~Ленни с трудом проглатывает комок, подступивший к горлу, и таращит на тебя глаза. Ты замечаешь, как напряглись его мускулы. Он с беспечным видом кладёт одну руку на бедро, но видно, что он как сжатая пружина и готов драпать. «Понятия не имею, о чём ты говоришь, пень. Лучше проваливай».~
@36494 = ~Он снова с трудом сглатывает, и уголок его глаза начинает подёргиваться. Он пробегает взглядом по шрамам, покрывающим твоё тело, затем пытается встретиться с тобой взглядом — и не может. «Бумаги… я… я уничтожил их после того, как стянул. В точности так, как мне Байрон сказал», — наконец он встречается с тобой взглядом.~
@36495 = ~Он смотрит всего мгновение, а затем резко разворачивается, чтобы убежать.~
@36496 = ~Едва только он разворачивается, ты в броске хватаешь его за руку. Он пытается сопротивляться, но по силе тебе не ровня. Наконец он затихает в твой стальной хватке. «Ладно, я их не уничтожал! Я отдам их, только отпусти меня». Ты ослабляешь захват.~
@36497 = ~Едва только он разворачивается, ты пытаешься в броске схватить его. Он ловко уворачивается и уходит в сторону. Видя ускользающую жертву, ты делаешь последний отчаянный прыжок к нему. Поймать его не удаётся, но ты умудряешься сбить его своей массой с ног. Побег не удался. «Ладно, я их не уничтожал! Я отдам их, только отпусти меня».~
@36498 = ~Он выдыхает: «У… у меня их с собой нет». Ты хмуришься и замечаешь, как его лицо охватывает страх: «Клянусь тебе! Нет их у меня! Я их отдал на хранение!» Он продолжает глазеть на тебя, тяжело дыша.~
@36499 = ~Он печально качает головой: «Мы не сможем: они на складе, а он прямо сейчас закрыт. Говорят, там что-то вроде смены руководства… не знаю, правда или нет. В любом случае я не могу забрать бумаги». Он робко смотрит на тебя.~
@36500 = ~Он пожимает плечами: «Замечательно. Думаю, эта змея Пикит снова выиграет…» Он смотрит на тебя вызывающе.~
@36501 = ~«Иди на склад и скажи клерку: *Я пришёл за ссудой*, тогда он отдаст тебе бумаги. Пока, пень», — внезапно он срывается и убегает.~
@36502 = ~Он фыркает и вызывающе на тебя смотрит. «Я их сохранил, чтобы заложить твоего босса Пикита и отмазать Трист! — он качает головой. — Задницу мою можешь шантажировать…»~
@36503 = ~«Да, заложить, — мгновение он смотрит на тебя, потом до него доходит, что ты не понимаешь. — Это значит, что я хотел его предать, сдать Гармониуму».~
@36504 = ~Он фыркает и вызывающе на тебя смотрит: «Я их сохранил, чтобы заложить твоего босса Пикита и отмазать Трист!»~
@36505 = ~Он смотрит на тебя с некой гордостью. «Может, я и вор, но у меня есть свои принципы. Я не стану убивать какого-нибудь бедного малого и не стану делать то, что Пикит сделал с Трист и её мужем, — он качает головой и смотрит в сторону. — Я сказал твоему боссу, что зря он так поступает, а он только посмеялся».~
@36506 = ~Он глазеет на тебя с недоверием. «Серьёзно? Я думал… но ведь ты сказал… — он внимательно тебя оглядывает, а потом начинает смеяться. — Ты меня обвёл, да так, что я сам тебе всё и выложил!» Он качает головой и смотрит на тебя с уважением: «Хорошая работа, здоровяк».~
@36507 = ~Он печально качает головой: «Мы не сможем: они на складе, а он прямо сейчас закрыт. Говорят, там что-то вроде смены руководства… не знаю, правда или нет. В любом случае я не могу забрать бумаги». Он робко смотрит на тебя: «Именно из-за этого я и не смог сам помочь Трист. Не мог забрать эти грёбаные бумаги».~
@36508 = ~Он тебе улыбается: «Иди на склад и скажи клерку: *Я пришёл за ссудой*, тогда он отдаст тебе бумаги Трист. А если после этого ты скажешь ему: *Я оставил в дураках Пикита*, будет тебе ещё и приз…»~
@36509 = ~Он смеётся. «Доказательства, здоровяк. Они на очень долгий срок освободят улицы от присутствия Пикита, если ты их отдашь кому следует… — на мгновение он задумывается. — Если в Гармониуме есть кто-то, кому ты можешь доверять, — отдай их ему».~
@36510 = ~Он хмурится: «Что ты имеешь в виду?»~
@36511 = ~«Ты точно хочешь оставить свою нынешнюю специальность и стать вором?»~
@36512 = ~Он оглядывается и пожимает плечами. «Это Нижний район, дом простых людей. Тут не такая безнадёга, как в Улье, но и не такая малина, как в районе Клерков, — он снова оглядывается. — Что тут ещё скажешь?»~
@36513 = ~Он качает головой и улыбается. «Думаю, ты это назвал бы трущобами Сигила. Там живёт море бедолаг, которым некуда больше отправиться, кроме как в книгу мёртвых, — он прерывается. — Больше тут сказать нечего».~
@36514 = ~Он улыбается. «Название говорит само за себя, пень. Клерки, клерки и ещё клерки. Если хочешь бумагу накатать, или чтобы на тебя самого накатали бумаженцию — это то самое место, куда стоит пойти, — он пожимает плечами. — Больше тут ничего не скажешь».~
@36515 = ~Он улыбается и разражается смехом. «Многие считают Сигил центром мультивселенной. Лично я считаю, что если вселенная — это жопа, то этот город — та самая дырка, а придурки, живущие в нём, — что-то вроде дерьма», — он снова улыбается.~
@36516 = ~Ты видишь Ленни. Когда ты подходишь, он насмешливо улыбается: «Ну здравствуй, пень. Чему обязан удовольствием видеть тебя снова?»~
@36517 = ~Ты видишь Ленни. Он не очень-то счастлив тебя видеть: «Чего тебе надо, пень?»~
@36518 = ~Он хмурится. «Больше никаких вопросов и никаких ответов. Иди к своему боссу, Пикиту, и скажи, чтобы он оставил меня в покое», — он свирепо на тебя смотрит.~
@36519 = ~Он недоверчиво таращит на тебя глаза. «Серьёзно? Я думал… но ты ж сам сказал… — он внимательно тебя оглядывает, а потом начинает смеяться. — Ты меня обвёл, да так, что я сам тебе всё и выложил!» Он качает головой и смотрит на тебя с уважением: «Хорошая работа, здоровяк». Он прерывается. «Ты не против посмеяться над Пикитом?»~
@36520 = ~Он улыбается: «Да, посмеяться… убрать с улиц, избавиться от него, в общем, нагадить ему по полной».~
@36521 = ~Он пожимает плечами: «Ну, тогда говорить больше не о чём. Прощай, пень».~
@36522 = ~Ты видишь Ленни. Он улыбается, завидев тебя: «Привет, здоровяк. Чем могу помочь?»~
@36523 = ~«Я уже сказал тебе всё, что знал, здоровяк. И больше ответов у меня не предвидится».~
@36524 = ~Ты видишь Ленни. Завидев тебя, он улыбается. «Привет, здоровяк. Я слышал про Байрона и счастливее я уже стать просто не смогу, — он усмехается. — Чем могу помочь?»~
@36525 = ~«Приветствую».~
@36526 = ~Не обращать на него внимания.~
@36527 = ~«У меня пара вопросов…»~
@36528 = ~«Неважно, прощай».~
@36529 = ~«Просто хотел задать тебе пару вопросов…»~
@36530 = ~«А если я скажу, что меня послал Байрон Пикит?»~
@36531 = ~«Неважно, прощай».~
@36532 = ~«Ладно, прощай».~
@36533 = ~«Он сказал, что ты можешь ответить мне на пару вопросов…»~
@36534 = ~«Забудь, ничего важного. Прощай».~
@36535 = ~«У меня украли череп, и я хочу его вернуть. Не знаешь, кто бы мог это сделать?»~
@36536 = ~«Хотел спросить тебя насчёт тех бумаг, что ты украл у Трист».~
@36537 = ~«Хотел бы обучиться воровскому делу. Не можешь меня научить?»~
@36538 = ~«Что ты можешь рассказать об этом районе?»~
@36539 = ~«Неважно. Прощай».~
@36540 = ~«А кто такой Лотар?»~
@36541 = ~«Я слышал о Лотаре, Мне его просто нужно найти».~
@36542 = ~«Я хотел спросить о другом…»~
@36543 = ~«Спасибо, прощай».~
@36544 = ~«Где это?»~
@36545 = ~«Ясно. У меня другие вопросы…»~
@36546 = ~«Спасибо, прощай».~
@36547 = ~«У меня ещё кое-какие вопросы…»~
@36548 = ~«Хорошо, пока».~
@36549 = ~Злобно усмехнуться: «Ты знаешь, о чём я говорю, Ленни. Ты украл для Байрона кое-какие бумаги у Трист. Я пришёл их забрать».~
@36550 = ~Правда: «Дай мне бумаги, которые ты украл у Трист, или я тебя убью».~
@36551 = ~Блеф: «Дай мне бумаги, которые ты украл у Трист, или я тебя убью».~
@36552 = ~«Хватит с меня. Прощай».~
@36553 = ~«Правда? Почему же ты тогда так нервничаешь, а, Ленни? Попробую догадаться: Байрон думает, что ты уничтожил бумаги, но, возможно, это не так. Может, ты их сохранил? Небольшой компромат, а?»~
@36554 = ~«Почему же ты тогда так нервничаешь, Ленни? Думаю, ты врёшь».~
@36555 = ~«Понимаю. Тогда мне пора идти. Счастливо».~
@36556 = ~Схватить его, пока не удрал.~
@36557 = ~Схватить его, пока не удрал.~
@36558 = ~Отпустить его.~
@36559 = ~«Отдай их, Ленни».~
@36560 = ~«Зачем ты их оставил, Ленни? Надо полагать, для шантажа».~
@36561 = ~«Так ты их сохранил. Зачем?»~
@36562 = ~«Отдай их, Ленни».~
@36563 = ~«Зачем ты их оставил, Ленни? Надо полагать, для шантажа».~
@36564 = ~«Так ты их сохранил. Зачем?»~
@36565 = ~«Тогда пошли возьмём их».~
@36566 = ~«Я об этом уже позаботился, думаю, мы сможем их получить».~
@36567 = ~«Я с этим разберусь и заберу бумаги сам».~
@36568 = ~«Хватит с меня. Прощай».~
@36569 = ~«Просто пойдём и возьмём бумаги, Ленни».~
@36570 = ~«На самом деле в этот раз выиграет Трист, Ленни».~
@36571 = ~Уйти.~
@36572 = ~«Заложить?»~
@36573 = ~«Почему ты решил его заложить?»~
@36574 = ~«Между прочим, Пикит мне не босс».~
@36575 = ~«Почему ты решил его заложить?»~
@36576 = ~«Между прочим, Пикит мне не босс».~
@36577 = ~«Заложить?»~
@36578 = ~«Почему ты решил его заложить?»~
@36579 = ~«Между прочим, Пикит мне не босс».~
@36580 = ~«Между прочим, Пикит мне не босс».~
@36581 = ~«Пошли возьмём бумаги, Ленни».~
@36582 = ~«Пошли возьмём бумаги, Ленни».~
@36583 = ~«Я об этом уже позаботился, думаю, мы сможем их получить».~
@36584 = ~«Я с этим разберусь и заберу бумаги сам».~
@36585 = ~«Хватит с меня. Прощай».~
@36586 = ~«Приз?»~
@36587 = ~«Его больше нет на улицах, Ленни. Байрон мёртв».~
@36588 = ~«Не твоё дело».~
@36589 = ~«Я не работаю на Пикита, Ленни».~
@36590 = ~«Да…»~
@36591 = ~«Что ты можешь рассказать об Улье?»~
@36592 = ~«Что ты можешь рассказать о районе Клерков?»~
@36593 = ~«Я хотел спросить о другом…»~
@36594 = ~«Спасибо, мне пора идти. Счастливо».~
@36595 = ~«Что ты можешь рассказать о районе Клерков?»~
@36596 = ~«Я хотел спросить о другом…»~
@36597 = ~«Спасибо, мне пора идти. Счастливо».~
@36598 = ~«Что ты можешь рассказать об Улье?»~
@36599 = ~«Я хотел спросить о другом…»~
@36600 = ~«Спасибо, мне пора идти. Счастливо».~
@36601 = ~«Я хотел спросить о другом…»~
@36602 = ~«Спасибо, мне пора идти. Счастливо».~
@36603 = ~«У меня пара вопросов…»~
@36604 = ~«Мне пора идти. Прощай».~
@36605 = ~«У меня пара вопросов…»~
@36606 = ~«Я хотел бы обучиться воровскому делу. Можешь меня научить?»~
@36607 = ~«Ничего, прощай».~
@36608 = ~«Пикит мне не босс».~
@36609 = ~«Мне надо обучиться воровскому делу. Можешь меня научить?»~
@36610 = ~«Отлично, пока».~
@36611 = ~«Посмеяться?»~
@36612 = ~«Да, я бы был не против».~
@36613 = ~«Нет, теперь мне уже неважно, я получил то, за чем приходил».~
@36614 = ~«Я так не думаю, прощай».~
@36615 = ~«Да, я бы был не против».~
@36616 = ~«Нет, теперь мне уже неважно, я получил то, за чем приходил».~
@36617 = ~«Я так не думаю, прощай».~
@36618 = ~«Прощай».~
@36619 = ~«У меня пара вопросов…»~
@36620 = ~«Мне надо обучиться воровскому делу. Можешь меня научить?»~
@36621 = ~«Ничем, прощай».~
@36622 = ~«Ладно, пока».~
@36623 = ~«У меня пара вопросов…»~
@36624 = ~«Мне надо обучиться воровскому делу. Можешь меня научить?»~
@36625 = ~«Ничем, прощай».~
@36626 = ~Заклинание было искажено планом [Безымянный]~ [NAM125]
@36627 = ~Заклинание было искажено планом [Морте]~
@36628 = ~Заклинание было искажено планом [Анна]~
@36629 = ~Заклинание было искажено планом [Дак'кон]~ [DAK150]
@36630 = ~Заклинание было искажено планом [Падшая Грейс]~ [FFG286]
@36631 = ~Заклинание было искажено планом [Нордом]~
@36632 = ~Заклинание было искажено планом [Игнус]~ [IGN205]
@36633 = ~Заклинание было искажено планом [Вейлор]~
@36634 = ~Заклинание было искажено планом [Общий, другие NPC]~
@36635 = ~Заклинание было прервано [Безымянный]~ [NAM123]
@36636 = ~Заклинание было прервано [Морте]~
@36637 = ~Заклинание было прервано [Анна]~
@36638 = ~Заклинание было прервано [Дак'кон]~ [DAK148]
@36639 = ~Заклинание было прервано [Падшая Грейс]~ [FFG287]
@36640 = ~Заклинание было прервано [Нордом]~
@36641 = ~Заклинание было прервано [Игнус]~ [IGN202]
@36642 = ~Заклинание было прервано [Вейлор]~
@36643 = ~Заклинание было прервано [Общий, другие NPC]~
@36644 = ~Удар в спину! 2x [Анна]~ [ANA524B]
@36645 = ~Игнорировать его.~
@36646 = ~«Хэмрис к твоим услугам, член Гармониума и модельер подушек для свежепреставившихся. Мне кажется, я тебя знаю, или я ошибаюсь?.. Посмотрим, надо сосредоточиться… — на секунду он задумывается. — Позволь рассказать, в Гармониуме я поднаторел в именах. Знал всех во всём районе…»~
@36647 = ~Ложь: «Моё имя — Адан».~
@36648 = ~«У меня кое-какие вопросы…»~
@36649 = ~«Мне пора идти. Прощай».~
@36650 = ~Хэмрис кивает: «Спрашивай». Он широко тебе улыбается.~
@36651 = ~«Я бы хотел купить подушку для гроба».~
@36652 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@36653 = ~«У меня был череп, и его украли. Не знаешь, кто бы мог это сделать?»~
@36654 = ~«Я потерял дневник. Ничего такого не видел?»~
@36655 = ~«Я слышал, твой отец умер. Не мог бы ты рассказать, что произошло?»~
@36656 = ~«Кто этот твой друг?»~
@36657 = ~«Не расскажешь мне об этом районе?»~
@36658 = ~«Что ты можешь рассказать о Сигиле?»~
@36659 = ~«Мне пора идти. Прощай».~
@36660 = ~Он тебе кивает: «А! Так ты за покупками. Уверяю, я люблю эту работу, так что продукт высшего качества. Моя настоящая работа в том, чтобы делать гробы… причём делать их качественно. Это акт совершенного созидания, каждая частица является неотъемлемой частью целого. Для философии Гармониума это звучит почти как метафора… мы создаём порядок, это и есть красота…»~
@36661 = ~«Мне просто нужна подушка…»~
@36662 = ~Он снова кивает. «Я беру по пятьдесят медяков за основные доски конструкции, хотя, конечно, цена не покрывает затрат времени. Обычно их либо белят, либо красят в цвет, выбранный заказчиком. Сами доски обычно шестнадцать пядей толщиной или даже толще, в зависимости от природы трупа и того, человеческий он или нет. Или от озабоченности, встанет ли покойник снова», — смеётся он.~
@36663 = ~«Мне просто нужна подушка…»~
@36664 = ~Он опять кивает. «Некоторые предпочитают байтопийскую сосну. Это замечательный традиционный материал, но мне больше нравится тяжёлый арборийский дуб, просто потому, что это очень плотный материал. Даже двенадцать дюймов этого дерева прочнее, чем шестнадцать пядей сосны…» — он на мгновение останавливается.~
@36665 = ~«Я сказал, мне просто нужна подушка…»~
@36666 = ~«С меня хватит. Прощай».~
@36667 = ~Он ещё раз кивает: «Потом мне надо двадцать по двадцать стальных шурупов для дерева, размерами примерно шесть на один с четвертью дюйма или около того. Они тут продаются во многих магазинах, так что приобрести их несложно. Мне также понадобятся какие-нибудь металлические булавки для отделки внутренностей, лучше всего брать их упаковками. Потом встаёт вопрос о досках для отделки углов, но это зависит от пожеланий заказчика».~
@36668 = ~«Ты меня слышишь? Я же сказал, мне просто нужна подушка!»~
@36669 = ~«С меня хватит. Прощай».~
@36670 = ~Он задумчиво потирает подбородок. «Как правило, я оставляю естественный цвет дерева в качестве внутренней расцветки гроба, но порой, за дополнительную плату, разумеется, я окрашиваю его либо делаю гравировку… обычно там не требуется тонкая отделка, но я обладаю нужной квалификацией и такое нужно отдельно прописывать в договоре… — он переводит дыхание и продолжает: — А ещё ручки, но это вообще отдельный разговор…» Он многозначительно кивает.~
@36671 = ~Вздохнуть: «И что насчёт ручек?»~
@36672 = ~«Если ты не заткнёшься и не дашь мне подушку, я тебя ударю… больно».~
@36673 = ~«С меня хватит. Прощай».~
@36674 = ~«Ручки — это очень важный вопрос. Всё, что связано с ручками, зависит от одного: как будут нести гроб. Если будут специалисты, несущие гроб на плечах, то нет никакой нужды беспокоится о ручках. Профессионалы их не используют, знаешь ли. Но если гроб будут нести друзья или члены семьи, тогда без них никак не обойтись. Понадобятся либо металлические, либо верёвочные ручки…» — он удовлетворённо смотрит на тебя.~
@36675 = ~«Это здорово и всё такое, но я пришёл сюда за подушкой. У тебя они есть?»~
@36676 = ~«Давай рассмотрим пример: по-моему, самый прекрасный гроб из всех, что я видел, был сделан из чистой сосны. Не знаю, привезли ли его из Байтопии или ещё откуда… но в любом случае он был аккуратно вырезан и отделан красным деревом. Правда, эффект портила толстая конопляная верёвка, окружавшая всё это дело. Конечно, за что-то гроб надо было нести, но так бездарно испортить внешний вид этой верёвкой…» — Хэмрис качает головой.~
@36677 = ~«Не сомневаюсь, это всё крайне интересно, но мне нужна всего лишь подушка…»~
@36678 = ~«С меня хватит. Прощай».~
@36679 = ~«Теперь встаёт вопрос о замерах. Это может быть достаточно сложно, особенно когда клиенты не считают нужным сообщать мне расу покойного или забывают такие детали, как ширина бёдер… что, кстати, очень важно. Также, если клиент ещё в добром здравии, я прикидываю объём на глаз, ещё до смерти клиента, ну ты понимаешь? — он прочищает горло. — И наконец, сама конструкция…»~
@36680 = ~«Хэмрис…»~
@36681 = ~«Есть много способов присоединения стенок к основанию и друг к другу. Можно, конечно, использовать боковины и стяжки, но на них уходит много дерева. Можно применить метод „зубы изверга“ и сделать вырезы на скрепляемых сторонах так, что они войдут одни в другие, как челюсть изверга. Требует несколько больше работы и тщательности, но результат того стоит», — он снова смолкает, чтобы перевести дух.~
@36682 = ~«Хэмрис…»~
@36683 = ~«Затем крышка. На крышке должна быть оправа, так называемая губа. Делается она из полосы дерева, крепящейся к гробу или вырезанной по краю. Сначала сверлятся направляющие отверстия в основании, затем дырки под болты в крышке, которые можно размещать на расстоянии в пол-ладони…» — такое впечатление, что он только в начале списка и не собирается останавливаться.~
@36684 = ~«Если ты не заткнёшься и не дашь мне подушку, я тебя ударю… больно».~
@36685 = ~«С меня хватит. Прощай».~
@36686 = ~Кажется, ты наконец привлёк его внимание. Он смущённо хмурится: «Пардон?»~
@36687 = ~«Я сказал, что мне нужна подушка для гроба. И это всё. Только подушка. У тебя есть?»~
@36688 = ~Он облегчённо улыбается. «Подушка? А, я-то думал, нужен целый гроб, — он снова трёт подбородок. — Мне очень жаль, но у меня вышел запас подушек. И я не знаю, когда они у меня снова будут, с этим закрытием склада и вообще…»~
@36689 = ~«Склада?»~
@36690 = ~«Да, ты упоминал, что есть проблема. Повтори, в чём именно она заключается?»~
@36691 = ~«У меня другие вопросы…»~
@36692 = ~«С меня хватит. Прощай».~
@36693 = ~«Да… склад, где я храню материалы и товар, испытывает некоего рода внутренние проблемы. Смена управления или подобная ерунда. А я не успел вовремя пополнить свои запасы», — он хмурится. «Гармониум никогда бы не позволил событиям выйти из-под контроля настолько, чтобы начали страдать заказчики… — его голос стихает, он задумчиво смотрит на тебя. — Может, ты посмотришь, что там можно сделать?»~
@36694 = ~«Я уже договорился со складом, просто пойду туда и возьму подушку».~
@36695 = ~«По-видимому, у меня нет выбора, если мне нужна подушка. Схожу выясню».~
@36696 = ~«Это не моё дело… почему бы тебе самому не разобраться?»~
@36697 = ~«Я подумаю. У меня ещё кое-какие вопросы».~
@36698 = ~«Мне пора, счастливо».~
@36699 = ~Он широко улыбается. «Прекрасно. Если ты решишь эту проблему, можешь взять подушку бесплатно… — на его лице вновь появляется *лекторское* выражение. — Это, конечно, не очень существенная плата, но позволь мне рассказать о конструкции этих подушек…»~
@36700 = ~«Нет, спасибо! Лучше я прямо сейчас пойду разбираться. Счастливо».~
@36701 = ~«В другой раз, у меня вопросы…»~
@36702 = ~Он хмурится. «Я пробовал, но у меня ничего не получилось. Я ставил вопрос в Гармониуме, но и они не смогли помочь мне в этот раз», — он смотрит на тебя невинными глазами и в бессилии разводит руками. «Если тебе и в самом деле нужна подушка…» — он смотрит выжидающе.~
@36703 = ~«Хорошо. Я разберусь с этим».~
@36704 = ~«Я подумаю. У меня вопросы…»~
@36705 = ~«Забудь. Прощай».~
@36706 = ~Он щёлкает пальцами: «Конечно! Адан! Я так и думал, что знаю тебя. Как бы то ни было, что угодно?» Он внимательно осматривает тебя, затем улыбается, заметив замечательный, по его мнению, объект для шутки. «По-моему, уважаемый, тебе отчаянно необходим гроб и как можно скорее», — похоже, он в восторге от своего остроумия.~
@36707 = ~«У меня кое-какие вопросы…»~
@36708 = ~«Мне пора идти. Прощай».~
@36709 = ~Он задумчиво хмурится. «Не могу сказать, чтобы я о нём когда-нибудь слышал. Повелитель Костей, говоришь? Броское имя, — он улыбается. — Кстати, можешь считать это и моим титулом, столько работать с трупами, как я. Конечно, я знаю, что в основном они покрыты плотью, но сколько раз мне приходилось делать гробы для одних костей, кто бы знал. Однажды был один приятель, у которого кости были чем-то очищены, я так и не понял, чем…»~
@36710 = ~Прервать: «У меня ещё вопрос…»~
@36711 = ~«Мне пора идти. Прощай».~
@36712 = ~Он поднимает бровь и пожимает плечами. «Понятия не имею, кто мог такое сделать. Знаешь, сейчас редко хоронят черепа. Я не совсем понимаю, кому нужно хоронить один череп в целом гробу, хотя бывали случаи, когда заказывали гробы ну очень странной конструкции. Порой, опять же, бывает так, что приходится хоронить один череп, поскольку прочие части тела найти не удаётся. Вот, помню, был один человек, чьё тело было так изувечено Хаоситектами, что…»~
@36713 = ~Прервать: «Кто такие Хаоситекты?»~
@36714 = ~Прервать: «У меня ещё вопрос…»~
@36715 = ~«Мне пора идти. Прощай».~
@36716 = ~Он ненадолго прерывается перед ответом. «На твой вопрос так просто не ответишь, дружище. Это одна из фракций Сигила, которая верит в хаос, — он ещё ненадолго задумывается, затем пожимает плечами. — Большую часть времени с ними невозможно разговаривать, они говорят незаконченными предложениями и перескакивают с одной темы на другую. Их разум, если он у них есть, должен быть сплошной неразберихой. Так вот, как я уже говорил…»~
@36717 = ~Прервать: «У меня ещё вопрос…»~
@36718 = ~«Мне пора идти. Прощай».~
@36719 = ~Он пожимает плечами. «Не могу сказать, что видел такое… ну, кроме моего собственного дневника. Люблю записывать мысли и замечания, в результате получается замечательное чтиво, вспомнить, о чём думал месяц назад», — он кивает тебе, словно ты уже согласился с его словами.~
@36720 = ~«Это здорово, но…»~
@36721 = ~Он продолжает бубнить: «Я говорил с несколькими печатниками из района Клерков о возможности издания своих дневников. Мне сказали, что они очень глубоко освещают различные аспекты городской жизни, особенно это касается моих записей, посвящённых стажировке в Гармониуме. Даже будучи людьми неподготовленными, многие согласились с тем, что у меня сильный стиль… но довольно об этом. Будет намного проще, если ты сам послушаешь: я могу прочитать тебе несколько весьма впечатляющих отрывков…»~
@36722 = ~«Ладно уж, читай».~
@36723 = ~«Не сейчас, у меня ещё вопросы».~
@36724 = ~«На сегодня хватит, прощай».~
@36725 = ~Хэмрис читает тебе несколько отрывков из своего однообразного дневника, все скучны как на подбор. Ты уже собираешься искать повод для бегства, как он упоминает что-то об исчезновении своего отца, что именно, ты не вполне улавливаешь. Но почему-то это тебя зацепляет.~
@36726 = ~«Погоди, ты сказал, что твой отец исчез?»~
@36727 = ~«Это всё здорово, но у меня другие вопросы…»~
@36728 = ~«Ну, на сегодня хватит, счастливо».~
@36729 = ~Хэмрис поднимает руку, отметая твою попытку встрять, и заканчивает чтение очередного отрывка из очередной части своего дурацкого дневника. «Так что ты думаешь? На удивление глубокий подход к вопросу, особенно для простого члена Гармониума, а?» — он улыбается. Похоже, твоих попыток прервать повествование он просто не заметил.~
@36730 = ~«Да, очень проницательно. Так ты сказал, что твой отец исчез?»~
@36731 = ~«Вообще-то твои дневники… слишком глубоки для восприятия в один присест. Я бы хотел тебя кое о чём спросить…»~
@36732 = ~«Я уже достаточно наслушался твоего голоса, на эту жизнь точно хватит. Прощай».~
@36733 = ~Он кивает: «О, да. Много-много лет назад. Мой отец был талантливым каменщиком, он не только сооружал саркофаги, но был ещё и замечательным проектировщиком гробниц. Люди со всего Сигила…» Комната вокруг тебя растворяется, а сознание переполняют воспоминания…~
@36734 = ~Расслабиться и постараться вспомнить.~
@36735 = ~Отогнать воспоминания прочь и продолжить беседу с Хэмрисом.~
@36736 = ~Ты оказываешься в этом же самом магазине, говоришь с пожилым мужчиной, а в углу играет ребёнок. На стойке между тобой и мужчиной лежит стопка планов. Похоже, он объясняет тебе некоторые сложности устройства гробницы. Твоё видение рассеивается, как только ты пытаешься разглядеть детали планов.~
@36737 = ~Продолжить.~
@36738 = ~Когда видение возвращается, ты уже стоишь в пещере у входа в гробницу. Над входом ты видишь девиз: «Спроектировано для Вечности», лозунг тщательно выбит на камне. Хозяин магазина стоит рядом с тобой, на его лице широкая улыбка. Взмахом руки он предлагает тебе следовать за ним в гробницу. Ты быстро догоняешь его и идёшь сзади, вытаскивая на ходу клинок…~
@36739 = ~Продолжить.~
@36740 = ~Ты снова оказываешься в магазине Хэмриса. Он смотрит на тебя с некоторым беспокойством: «С тобой всё в порядке, уважаемый?»~
@36741 = ~«Расскажи мне, что случилось с твоим отцом».~
@36742 = ~«Я в порядке. Хочу тебя кое о чём спросить…»~
@36743 = ~«Нет, мне надо уходить. Счастливо».~
@36744 = ~«Однажды он просто испарился, оставив массу невыполненных заказов. И выбраться из долгов было крайне сложно, более того, я до сих пор плачу по разным счетам. И хотя у меня есть кое-какие способности к работе…» — он незаметно вздыхает и устремляет взгляд куда-то вдаль.~
@36745 = ~«Продолжай».~
@36746 = ~Он пожимает плечами. «Прости, я просто задумался… Исчезновение отца и послужило причиной моего вступления в ряды Гармониума и последующего ухода из этих рядов. Сперва я горел желанием найти его, позднее я почувствовал желание продолжать работу его жизни, — он вздыхает. — Я так и не нашёл ответов на те вопросы, что меня мучили. Случившееся так и осталось загадкой…» Постепенно его голос стихает.~
@36747 = ~«Твой отец хранил планы гробниц, которые он построил?»~
@36748 = ~«У меня вопросы…»~
@36749 = ~«Я тебя покидаю, счастливо».~
@36750 = ~Он на мгновение задумывается. «Да, он их хранил. Когда я достиг совершеннолетия и наследовал дело, я изучил все его записи. Они, кстати, довольно обширные. А почему ты спрашиваешь?»~
@36751 = ~«Если я опишу тебе гробницу, сможешь сказать мне, была ли это работа твоего отца?»~
@36752 = ~«Просто спросил. У меня ещё вопросы…»~
@36753 = ~«Неважно. Прощай».~
@36754 = ~Он задумчиво хмурится, затем пожимает плечами: «Могу попробовать. Подготовка в Гармониуме дала мне неплохую память, так что если ты предоставишь достаточно подробностей, то я смогу вспомнить, отцовская ли это работа». Он смотрит на тебя в ожидании.~
@36755 = ~Описать гробницу из воспоминаний.~
@36756 = ~«Я хочу спросить о другом…»~
@36757 = ~«Забудь, мне пора идти. Счастливо».~
@36758 = ~Он на некоторое время задумывается. «Никаких сомнений, что гробница, о которой ты говоришь, — это работа моего отца. Упомянутый тобой девиз является отличительным знаком нашей семьи уже много поколений, — он прерывается и странно на тебя смотрит. — Эта гробница, где она находится?»~
@36759 = ~Описать местонахождение.~
@36760 = ~«Я хочу спросить о другом…»~
@36761 = ~«Забудь, мне пора идти. Счастливо».~
@36762 = ~Ты детально описываешь местоположение, сам удивляясь своему знанию местности. Хэмрис смотрит на тебя с озабоченным видом: «Странно, я не помню, чтобы в семейных архивах было упоминание даже о получении им разрешения на строительство гробницы в этом месте. Пыльные очень осторожно относятся к правам на строительство и землевладение, особенно под территорией Сигила…»~
@36763 = ~«Тебе знакомо это место?»~
@36764 = ~«Я хочу спросить о другом…»~
@36765 = ~«Забудь, мне пора идти. Счастливо».~
@36766 = ~Он охотно кивает. «О, да. Похоже на катакомбы Затопленных Народов, — он выдерживает небольшую паузу. — Я лично там никогда не был, но много раз слышал описание этой местности в мою бытность в Гармониуме».~
@36767 = ~«Я хочу знать, сохранил ли твой отец планы этой гробницы».~
@36768 = ~«Я хочу спросить о другом…»~
@36769 = ~«Забудь, мне пора идти. Счастливо».~
@36770 = ~«Да… я храню свой товар и документы на складе. В любом случае у них там некоего рода внутренние проблемы. Смена управления или подобная ерунда. В последнее время я не в состоянии пополнить свой ассортимент и уже сомневаюсь, что смогу получить у них свои документы, — он хмурится. — Гармониум никогда бы не позволил событиям выйти из-под контроля настолько, чтобы начали страдать заказчики…» Его голос стихает, он задумывается. Затем снова обращается к тебе: «Может, ты поможешь мне разрешить эту проблему?»~
@36771 = ~«Склад?»~
@36772 = ~«Да, ты говорил о проблеме. Не повторишь, в чём она заключается?»~
@36773 = ~«У меня другие вопросы…»~
@36774 = ~«Забудь, мне пора идти. Счастливо».~
@36775 = ~«Да… там возникла какая-то *сложная ситуация*, что бы это ни значило. Я не смогу получить у них товар, пока они со всем не разберутся, — он снова хмурится. — Так что, поможешь мне?»~
@36776 = ~«Я уже договорился со складом, просто пойду туда и возьму планы».~
@36777 = ~«По-видимому, у меня нет выбора, если мне нужны планы. Схожу выясню».~
@36778 = ~«Это не моё дело… почему бы тебе самому не разобраться?»~
@36779 = ~«Я подумаю. У меня ещё кое-какие вопросы».~
@36780 = ~«Мне пора, счастливо».~
@36781 = ~Он широко улыбается. «Прекрасно. Если ты решишь эту проблему, то получишь планы бесплатно… — на его лице вновь появляется *лекторское* выражение. — Тебе это может показаться недостаточной платой, но позволь мне рассказать о трудностях, с которыми сталкиваются при составлении подобных планов…»~
@36782 = ~«Нет, спасибо! Лучше я прямо сейчас пойду разбираться. Счастливо».~
@36783 = ~«В другой раз, у меня вопросы…»~
@36784 = ~Он хмурится. «Я пытался, но не достиг больших успехов. Я ставил вопрос в Гармониуме, но и они не смогли помочь мне в этот раз», — он смотрит на тебя невинными глазами и в бессилии разводит руками. «Если тебе действительно нужны планы…» — он смотрит выжидающе.~
@36785 = ~«Хорошо. Я разберусь с этим».~
@36786 = ~«Я подумаю. У меня вопросы…»~
@36787 = ~«Забудь. Прощай».~
@36788 = ~Он хмурится. «Он исчез некоторое время назад, я могу лишь предполагать, что он мёртв. Где ты об этом слышал?»~
@36789 = ~«Я не помню. Так ты говоришь, он исчез?»~
@36790 = ~«Неважно, у меня другие вопросы…»~
@36791 = ~«Мне пора идти. Прощай».~
@36792 = ~Он переводит взгляд на посетителя. «Димтри? — он пожимает плечами, будто никогда раньше не задумывался о приятеле. — Спокойный, много не говорит… так ведь, Димтри?» Димтри не отвечает, уставившись на него пустым взглядом. Спустя несколько секунд следует кивок. Хэмрис пожимает плечами и снова поворачивается к тебе: «Появился здесь пару недель назад, с тех пор стал регулярным посетителем. Ничего не покупает, но проблем от него тоже нет, так что я разрешаю ему оставаться. Кажется вполне безобидным. Когда я служил в Гармониуме, частью нашей работы была опека над людьми, мы давали им убежище от хаоса на улицах, поднимали на ноги…»~
@36793 = ~«Ты ведь знаешь, что он зомби?»~
@36794 = ~«Ясно, у меня к тебе ещё вопросы…»~
@36795 = ~«Мне пора идти. Прощай».~
@36796 = ~Он хмурится, переводит взгляд на Димтри, затем снова на тебя: «Что за ерунду ты там мелешь? Димтри не зомби. Конечно, он тихий и мало двигается, но это потому, что умеет слушать…»~
@36797 = ~Ударить Димтри: «Смотри, Хэмрис, он точно зомби».~
@36798 = ~«Неважно. У меня к тебе ещё вопросы…»~
@36799 = ~«Мне пора идти. Прощай».~
@36800 = ~Хэмрис смотрит на тебя потрясённо: «Да кто, именем Гармониума, ты такой?!..» Ты бьёшь Димтри прямо по черепу. С силой. Тот даже не моргает. Хэмрис весь краснеет и переходит на крик: «Ты слишком далеко зашёл! Я не позволю тебе бить моих покупателей! Властью Гармониума я арестую тебя…» Он замолкает и недоумённо глазеет на Димтри, который по-прежнему никак не реагирует.~
@36801 = ~«Он зомби, Хэмрис…»~
@36802 = ~Хэмрис в замешательстве глазеет на Димтри: «Интересно, отчего он умер». Тебе начинает казаться, что Хэмрис просто не понимает. «Ещё вчера он казался вполне живым, — не найдя подходящих слов, он хмыкает. — Ну что ж, кажется, старому доброму Димтри понадобится гроб. Хорошо, что он умер здесь. Вопрос в том, какой же нужен гроб…» У него вид человека, готового начать читать лекцию.~
@36803 = ~«У меня вопросы…»~
@36804 = ~«Я ухожу. Прощай».~
@36805 = ~«Да, Нижний район… — он наклоняется вперёд, словно объясняет что-то маленькому ребёнку, — …вообще-то не только новички, но и жители района мало о нём знают: большинство думает, этот район получил такое название только потому, что он менее престижен, чем другие районы, но это совсем не так. Совсем. Ты знаешь, откуда произошло это название? М-м?» Он выжидающе на тебя смотрит.~
@36806 = ~«Из-за всех этих порталов на Нижние планы?»~
@36807 = ~«Нет, не знаю».~
@36808 = ~«Мне без разницы, откуда оно произошло. Лучше расскажи, на что тут можно посмотреть?»~
@36809 = ~Он кивает, хотя кажется слегка расстроенным, что ты знаешь. «В самом деле. Эти порталы к Нижним планам — причина смога в здешнем небе… — он смотрит вверх, как будто представляя небо над головой, — …но думаю, ты уже знаешь с какими препятствиями тебе придётся столкнуться в этом районе».~
@36810 = ~«Да, у меня к тебе другие вопросы…»~
@36811 = ~«Нет, расскажи мне».~
@36812 = ~«Это из-за порталов на Нижние планы! Они причина всего этого смога, переполняющего район, выбрасывают ядовитые газы и всё такое. К счастью, ветер от Шпиля помогает избавиться от худших дымов, но всё равно они несут болезни в район всем со слабым сложением, — он с грустью качает головой. — К счастью, моя служба в Гармониуме подготовила меня ко всякого рода тяжёлым условиям, а после моего путешествия на Нижние планы смог этого района мне переносить несложно, правда…»~
@36813 = ~«Что стоит посмотреть в районе?»~
@36814 = ~«Ясно. У меня ещё вопросы…»~
@36815 = ~«Мне пора идти. Прощай».~
@36816 = ~Он широко улыбается. «Много, много интересного. С чего бы начать… Если мы остановимся около каждой из печей, кузниц, пивоварен, виноделен, разбросанных среди многочисленных мусорных костров, не говоря уже о хижинах алхимиков, крематориях, лечебницах и котельных, это и будет обзор района, можно сказать. Да, здесь есть Кузница, осадная башня и…» — он запинается и замолкает, задумавшись.~
@36817 = ~«Расскажи мне о Кузнице».~
@36818 = ~«Расскажи мне об осадной башне».~
@36819 = ~«У меня другие вопросы…»~
@36820 = ~«Мне пора идти. Прощай».~
@36821 = ~«Великая Кузница — это штаб-квартира Верующих в Источник, в широких кругах также известных под именем „Боготов“ из-за их веры в то, что каждый может достичь божественности, — он качает головой. — Великая Кузница вполне отражает их философию: большое неуклюжее здание, не производящее ничего, кроме дыма». Он смеётся: «Когда ты в последний раз слышал, чтобы кто-нибудь из Верующих в Источник неожиданно стал силой? Ни разу за всю историю фракций».~
@36822 = ~«Расскажи мне о Боготах».~
@36823 = ~«Расскажи мне об осадной башне».~
@36824 = ~«У меня другие вопросы…»~
@36825 = ~«Мне пора идти. Прощай».~
@36826 = ~«Та железная развалина в шрамах? Она загадка района, но у меня есть по этому поводу определённые соображения. Во-первых, она не всегда была здесь, как я понимаю. Башня просто появилась однажды ночью, и никто не видел, как она сюда попала. Ты видел её снаружи, а? Башня повидала битвы, такие битвы, какие многим и не вообразить. Я краем глаза видел Кровавую Войну, даже сталкивался с парой-тройкой танар'ри, когда дела шли совсем плохо и со мной были лишь несколько ребят из Гармониума… и те шрамы на башне выглядят так, словно их собирали не один век», — на мгновение он прерывается.~
@36827 = ~«Продолжай».~
@36828 = ~«Теперь слушай внимательно: опыт позволяет мне распознать некоторые шрамы, украшающие стены башни. Есть кислотные повреждения, вероятнее всего, результат колдовства, местами — выщербины от клинков танар'ри, другие похожи на следы взрывов или хлыстов корнугонов. Однако большая часть оружия, воткнутого в стены, мне неизвестна, а я знаком с великим множеством оружия, производимого в различных мирах и планах. Становится интересно, что же там внутри. Громила, что вскроет эту башню, наверно, получит в свои руки целый музей. Любопытно?» — он глазеет на тебя.~
@36829 = ~«Расскажи мне о Кузнице».~
@36830 = ~«У меня другие вопросы…»~
@36831 = ~«Мне пора идти. Прощай».~
@36832 = ~«Вообще-то, друг, „Боготы“ — это то, как фракцию называют в просторечии; настоящее название их организации — Верующие в Источник. Они придерживаются интересной, но с некоторыми недостатками, философии: верят в то, что каждый может достичь божественного статуса, просто приложив к этому усилия…» — он снисходительно качает головой, подыскивая правильные слова.~
@36833 = ~«Продолжай».~
@36834 = ~«Как подтвердила моя стажировка в Гармониуме, большинство никогда не возвысятся до божественности, как бы они этого ни хотели и сколько бы ни прилагали усилий…» — он усмехается. «Тем не менее, Верующие в Источник довольно много работают… — он пожимает плечами, — …и их маленькая фракция довольно приятна».~
@36835 = ~«Расскажи мне об осадной башне».~
@36836 = ~«Не расскажешь мне что-нибудь о других фракциях?»~
@36837 = ~«У меня другие вопросы…»~
@36838 = ~«Мне пора идти. Прощай».~
@36839 = ~«Сигил…» — он переводит дыхание. «Сигил — город, который находится в центре всего, как полагают многие. Это город дверей. Здесь буквально тысячи порталов. Это дом для самой Госпожи Боли, — он пожимает плечами. — Сигил… это тема, про которую можно написать несколько томов, сотни томов…»~
@36840 = ~«Расскажи мне о Госпоже Боли».~
@36841 = ~«Ты упомянул порталы. Знаешь что-нибудь о них?»~
@36842 = ~«У меня другие вопросы…»~
@36843 = ~«Мне пора идти. Прощай».~
@36844 = ~«Госпожа Боли… — Хэмрис подаётся вперёд и слегка понижает голос. — Одна из величайших тайн мультивселенной, с этим каждый согласится. Я думаю, она доказала, что женщины, вне всякого сомнения, самые опасные существа в мультивселенной…» Он вздыхает.~
@36845 = ~«Продолжай».~
@36846 = ~«Некоторые называют её богиней, силой, которая сделала Сигил своим домом. По правде говоря, она нарушает законы любых известных мне сил. Силы нуждаются в почитателях, дающих им их могущество, а Госпожа не любит, когда перед ней преклоняются. Когда люди оказываются в её тени, их плоть раздирает на части невидимыми лезвиями. Я повидал в этой жизни немало ужасных вещей — у иного от них подкосились бы коленки и дух вон. Но ничто не сравнится со зрелищем, которое представляют собой жертвы Госпожи».~
@36847 = ~«Интересно, а что-нибудь ещё можешь рассказать?»~
@36848 = ~«У меня другие вопросы…»~
@36849 = ~«Мне пора идти. Прощай».~
@36850 = ~«Далее, она не принимает тех, кто в Сигиле пытается изображать из себя бога. Ты, возможно, не знаешь, но ни одна из сил не может войти в Сигил: ни Зевс, ни Ра — никто. Дело в том, что присутствие Госпожи каким-то образом держит их на расстоянии. Никто не может войти, и это их братию страшно бесит. Сигил — лакомый кусочек для каждого, поэтому остальные силы всегда пытались пробраться сюда. Но безуспешно».~
@36851 = ~«Продолжай».~
@36852 = ~«Даже более того. Госпожа не только держит их за пределами, она не позволяет ни одному жителю наносить городу вред. Разумеется, наша фракция Гармониум помогает ей, поскольку мы любим порядок. Но время от времени какому-нибудь тупому отморозку приходит в голову начать разборки на улице: убивать дабусов, наводить в городе хаос или колдовать заклинания массового поражения. Плохая идея на самом деле. Это всё очень расстраивает Госпожу. Ей не нравится, когда её город разрушают. За это она может убить тебя… или сослать в лабиринт… или и то и другое».~
@36853 = ~«Сослать в лабиринт?»~
@36854 = ~«У меня другие вопросы…»~
@36855 = ~«Мне пора идти. Прощай».~
@36856 = ~«Ты не слышал о лабиринтах? — он смотрит на тебя недоумённо. — Да ты ещё совсем зелёный. У Госпожи есть межпространственные тюрьмы, в которые она помещает особо отличившихся правонарушителей. Берёт небольшие кусочки Сигила, придаёт им форму лабиринтов и отрезает от города. Возвращаешься однажды ночью домой или заходишь в арку своего дома, и неожиданно всё меняется. Ты оказываешься в незнакомом месте. Ты в ловушке. Говорят, из каждого такого лабиринта есть выход, но ты сдохнешь, прежде чем найдёшь его».~
@36857 = ~«У меня другие вопросы…»~
@36858 = ~«Мне пора идти. Прощай».~
@36859 = ~Он улыбается тебе в предвкушении разговора: «Ну конечно, друг. Я могу рассказать тебе немного о Гармониуме, об Убийцах Милосердия или Старейшинах. С кого мне начать?»~
@36860 = ~«Старейшины».~
@36861 = ~«Гармониум».~
@36862 = ~«Убийцы Милосердия».~
@36863 = ~«У меня другие вопросы…»~
@36864 = ~«Мне пора идти. Прощай».~
@36865 = ~Он кивает головой с видом знатока: «Братство Порядка — вот настоящее название фракции. Они посвящают себя закону и познанию, проводят большую часть своего времени, изучая разнообразные аспекты закона. Причём речь не только о человеческих законах. Нет, их интересы гораздо глубже. Они хотят знать абсолютно всё. Из-за любви к закону они часто служат в судах Сигила и выступают в роли судей, адвокатов, юристов и тому подобных».~
@36866 = ~«Расскажи мне о другой фракции…»~
@36867 = ~«У меня другие вопросы…»~
@36868 = ~«Мне пора идти. Прощай».~
@36869 = ~Он гордо заявляет: «Основной фракцией Сигила является, конечно, Гармониум. Мы — фракция, посвятившая себя охране закона и порядка в Сигиле, и нет ничего важнее этой задачи. Прогресса можно достичь только при наличии порядка и гармонии. Некоторые думают иначе, но у них нет нашей решимости, поэтому они проиграют».~
@36870 = ~«Расскажи мне о другой фракции…»~
@36871 = ~«У меня другие вопросы…»~
@36872 = ~«Мне пора идти. Прощай».~
@36873 = ~Он улыбается: «Убийцы Милосердия стоят на страже справедливости. Для них справедливость — это всё. Она абсолютна и совершенна. Они посвящают свои жизни восстановлению справедливости, но это нужно делать осторожно и в соответствии с законом. Они верят, что установление справедливости в мультивселенной очистит её от злых сил и сделает совершенной».~
@36874 = ~«Расскажи мне о другой фракции…»~
@36875 = ~«У меня другие вопросы…»~
@36876 = ~«Мне пора идти. Прощай».~
@36877 = ~Он смеётся. «Порталы? Знаю ли я о порталах? — он делает паузу. — Ну, не лично, но знаком с некоторыми общеизвестными вещами. Полагаю, их можно найти практически в любом районе… порталы — странные штуки, иногда они перемещаются. А иной раз они как будто просто исчезают… За ними тяжело уследить». Он пожимает плечами.~
@36878 = ~«У меня другие вопросы…»~
@36879 = ~«Мне пора идти. Прощай».~
@36880 = ~«А, привет. Не за гробом в магазин пришёл?» — он приветливо улыбается.~
@36881 = ~«У меня вопросы…»~
@36882 = ~«Мне пора идти. Прощай».~
@36883 = ~Хэмрис тебе улыбается: «Ещё раз добрый день, уважаемый. Не надумал помочь мне в ситуции со складом?»~
@36884 = ~«Да, я помогу тебе».~
@36885 = ~«Нет, я всё ещё думаю. Прощай».~
@36886 = ~«У меня вопросы…»~
@36887 = ~Хэмрис тебе улыбается: «Ещё раз добрый день, уважаемый. Не передумал с помощью мне в ситуции со складом?»~
@36888 = ~«Да, я помогу тебе».~
@36889 = ~«Нет. Прощай».~
@36890 = ~«У меня вопросы…»~
@36891 = ~Хэмрис тебе улыбается: «Ещё раз добрый день, уважаемый. Не разобрался ещё в ситуции со складом?»~
@36892 = ~«Нет, я над этим работаю. Прощай».~
@36893 = ~«Нет, но у меня к тебе вопросы…»~
@36894 = ~Хэмрис тебе улыбается: «Ещё раз добрый день, здоровяк. Ты добыл подушку, которую искал?»~
@36895 = ~«У меня вопросы…»~
@36896 = ~~
@36897 = ~Хэмрис тебе улыбается: «Ещё раз добрый день, уважаемый. Не надумал помочь мне в ситуции со складом?»~
@36898 = ~«УХОДИ. НЕ ИСПЫТЫВАЙ НАШЕ ТЕРПЕНИЕ».~
@36899 = ~«Уходи? Но…»~
@36900 = ~«МЫ ЗНАЕМ. УХОДИ НЕМЕДЛЕННО».~
@36901 = ~«О многоголосый повелитель, этот нарушитель может сказать много интересного».~
@36902 = ~«Не позволяй ложным воспоминаниям сломить тебя».~
@36903 = ~«Мы разорвали нити жизни, которые нас связывали. Впервые мы свободны».~
@36904 = ~«Мы свободны делать ошибки. Мы свободны НЕ делать ошибок».~
@36905 = ~«Наши жизни сейчас настолько же наполнены смыслом, как были всегда».~
@36906 = ~«Не поддавайся желанию творить зло. Такое существование — для нас подарок… не позволим нашим старым привязанностям управлять нами».~
@36907 = ~«Сохрани умиротворённость духа, как у Безмолвного Короля. Он очень тобой доволен».~
@36908 = ~«Возвращайся к своей работе».~
@36909 = ~«Не… не знаю… ж-ж-жёт…»~
@36910 = ~«Помоги этим людям заплатить долг обществу. Учавствуй в торгах!»~
@36911 = ~«Сарос! Рад видеть тебя!»~
@36912 = ~«Да, я помогу тебе».~
@36913 = ~«Нет, я всё ещё думаю. Прощай».~
@36914 = ~«У меня вопросы…»~
@36915 = ~Хэмрис тебе улыбается: «Ещё раз добрый день, уважаемый. Не передумал с помощью мне в ситуции со складом?»~
@36916 = ~«Да, я помогу тебе».~
@36917 = ~«Нет, я всё ещё думаю. Прощай».~
@36918 = ~«У меня вопросы…»~
@36919 = ~Он широко улыбается: «Отлично. Могу я помочь ещё чем-нибудь?»~
@36920 = ~«У меня вопросы…»~
@36921 = ~«Нет, прощай».~
@36922 = ~«Хм… тогда прощай».~
@36923 = ~«Хм… тогда прощай».~
@36924 = ~Удар в спину! 3x [Анна]~ [ANA522D]
@36925 = ~Удар в спину! 4x [Анна]~ [ANA522A]
@36926 = ~Удар в спину! 5x [Анна]~ [ANA522D]
@36927 = ~Удар в спину! 6x [Анна]~ [ANA522A]
@36928 = ~Удар в спину! 2x [Общий, другие NPC]~
@36929 = ~Удар в спину! 3x [Общий, другие NPC]~
@36930 = ~Удар в спину! 4x [Общий, другие NPC]~
@36931 = ~Удар в спину! 5x [Общий, другие NPC]~
@36932 = ~Удар в спину! 6x [Общий, другие NPC]~
@36933 = ~Замок взломан [Безымянный]~ [NAM105]
@36934 = ~Замок взломан [Морте]~ [MRT415C]
