@59159 = ~В северо-восточную часть Улья~
@59160 = ~В юго-западную часть Улья~
@59161 = ~Ночлежка~
@59162 = ~В северо-западную часть Улья~
@59163 = ~Хата Шергрейва~
@59164 = ~Хижина бабки-повитухи~
@59165 = ~К Мусорным трущобам~
@59166 = ~Забитая мусором арка~
@59167 = ~Дак'кон оборачивается к тебе. Его глаза — как блестящие угольки, его клинок мерцает, металл переливается, как плёнка масла на поверхности пруда. Когда Дак'кон говорит, его голос спокоен и силён… как никогда раньше: «Какова твоя воля?»~ [DAK205]
@59168 = ~«Есть вещи, которые я хочу *познать*, Дак'кон…»~
@59169 = ~«Сейчас ничего, Дак'кон. Пошли».~
@59170 = ~Дак'кон оборачивается к тебе. Его глаза — как блестящие угольки, на мгновение они отражаются в металле клинка, затем он кивает: «Какова твоя воля?»~ [DAK205]
@59171 = ~«Есть вещи, которые я хочу *познать*, Дак'кон…»~
@59172 = ~«Сейчас ничего, Дак'кон. Пошли».~
@59173 = ~Дак'кон медленно оборачивается. Его глаза — как два мёртвых чёрных камня, лицо мертвенно-бледное, а клинок цвета засохшей крови. Он говорит старческим… надломленным голосом: «Какова твоя воля?»~ [DAK205]
@59174 = ~«Есть вещи, которые я хочу *познать*, Дак'кон…»~
@59175 = ~«Сейчас ничего, Дак'кон. Пошли».~
@59176 = ~«Я буду слушать тебя».~
@59177 = ~«Ты выглядишь… непривычно для меня. Кто ты?»~
@59178 = ~«У меня вопросы о гитцерай…»~
@59179 = ~«Хочу поговорить о наших странствиях…»~
@59180 = ~«Давай обсудим твоё учение».~
@59181 = ~«Дак'кон… Рейвел назвала тебя рабом. Что она имела в виду?»~
@59182 = ~«Дак'кон, что такое „Шра'кт'лор“?»~
@59183 = ~«Дак'кон, расскажи ещё раз, как я спас тебя в Шра'кт'лоре».~
@59184 = ~«Говоришь, *я* дал тебе Круг Зертимона, Дак'кон?»~
@59185 = ~«Расскажи о другом „мне“… инкарнации, которую ты знал. Каков он был?»~
@59186 = ~«Как ты оказался мне обязанным, Дак'кон?»~
@59187 = ~«Неважно, Дак'кон. Пошли».~
@59188 = ~«Гитцерай».~
@59189 = ~«Гитцерай?»~
@59190 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59191 = ~«Ясно. Пошли».~
@59192 = ~«Гитцерай — один из Народа».~
@59193 = ~«Один из народа?»~
@59194 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59195 = ~«Ясно. Пошли».~
@59196 = ~«Гитцерай».~
@59197 = ~«Да, но кто именно эти гитцерай?»~
@59198 = ~«Ну… ладно тогда. Есть другие вещи, которые я хотел бы *познать*…»~
@59199 = ~«Ясно. Пошли».~
@59200 = ~Дак'кон молчит секунду, потом произносит: «Наша история и не должна быть *известна* тебе. Мы до смерти истечём кровью от лезвия времени, прежде чем я изложу хотя бы крупицу истории Народа».~
@59201 = ~«Я не нуждаюсь в изучении вашей истории… но хотел бы узнать о том, что вы представляете из себя сейчас».~
@59202 = ~«У меня другие вопросы о гитцерай…»~
@59203 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59204 = ~«Ясно. Пошли».~
@59205 = ~Дак'кон на мгновение замолкает. «*Знай* это и прими как ответ: мы — Народ, который сделал своим домом меняющийся план Лимбо», — ловким движением Дак'кон выхватывает из-за спины клинок и выставляет перед собой.~
@59206 = ~Ждать и смотреть, что будет дальше.~
@59207 = ~«Неважно. У меня другие вопросы о гитцерай…»~
@59208 = ~«Вообще-то, есть другие вещи, которые я хотел бы *познать*…»~
@59209 = ~«Хорошо, Дак'кон. Пошли».~
@59210 = ~«Вот, мы придаём форму материи Лимбо силой наших разумов. Мы создаём города своими мыслями». Ты видишь, как от центра лезвия по металлу разбегаются волны. Высота волн и движение их гребней соответствуют изменениям интонации Дак'кона. «В хаосе, где мы обитаем, только наше *знание* хранит нас. Мы — гитцерай».~
@59211 = ~«Какой у тебя странный клинок… он движется в такт твоим словам».~
@59212 = ~«Неважно. У меня другие вопросы о гитцерай…»~
@59213 = ~«Понял. Есть другие вещи, которые я хотел бы *познать*…»~
@59214 = ~«Ясно. Пошли».~
@59215 = ~«Его *знают* под именем „Сигил“. Среди Народа его *знают* как город, который не *знает* сам себя».~
@59216 = ~«Не знает сам себя? Что ты имеешь в виду?»~
@59217 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59218 = ~«Ясно. Пошли».~
@59219 = ~«Город существует, но не *знает* себя. В его *незнании* — изъян его существования».~
@59220 = ~«И как изъян проявляется?»~
@59221 = ~«Ты говоришь так, будто город живой».~
@59222 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59223 = ~«Ясно. Пошли».~
@59224 = ~«Он может не иметь сознания и *знания* себя в том смысле, как *знаем* себя ты или я, но он живёт. Растёт, меняется и затрагивает разум всех, кто живёт здесь».~
@59225 = ~«Почему ты сказал, что город не знает сам себя?»~
@59226 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59227 = ~«Ясно. Пошли».~
@59228 = ~«Город существует, сопротивляясь сам себе. Он разместился в стороне от планов, но пытается быть везде одновременно. Его стены — двери, но эти двери заперты. Такое существование говорит о нём как о создании, не *знающем* себя. В *незнании* себя — его изъян».~
@59229 = ~«Когда ты говорил, что город везде одновременно, что ты имел в виду?»~
@59230 = ~«Его стены — двери?»~
@59231 = ~Правда: «А что, если это *вовсе* не изъян города? Неживому не нужно стремиться к порядку и познавать себя. Что, если эти противоречия — проявления невидимых тебе сил?»~
@59232 = ~Правда: «А что, если это *вовсе* не изъян города? Неживому не нужно стремиться к порядку и познавать себя. Что, если эти противоречия — проявления невидимых тебе сил?»~
@59233 = ~Правда: «А что, если это *вовсе* не изъян города и ты просто не знаешь причины этих противоречий? Порядок проявляется во всём. Возможно, здесь мы имеем дело с глубинным порядком, который ты не можешь постичь».~
@59234 = ~Правда: «А что, если это *вовсе* не изъян города и ты просто не знаешь причины этих противоречий? Порядок проявляется во всём. Возможно, здесь мы имеем дело с глубинным порядком, который ты не можешь постичь».~
@59235 = ~«Ты говоришь так, будто город живой».~
@59236 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59237 = ~«Ясно. Пошли».~
@59238 = ~«Отвечаю на твой вопрос вопросом: что, если город имеет изъян и ты видишь все его противоречия вокруг себя?»~
@59239 = ~Правда: «Отвечу на *твой* вопрос вопросом: ты утверждаешь, что в существовании города есть изъян. Ты принял это утверждение вместо того, чтобы исследовать ту вероятность, что здесь мы имеем дело с чем-то большим. Не означает ли это, что изъян как раз в тебе… и что ты ищешь не знание, а только приемлемый ответ?»~
@59240 = ~Правда: «Отвечу на *твой* вопрос вопросом: ты утверждаешь, что в существовании города есть изъян. Ты принял это утверждение вместо того, чтобы исследовать ту вероятность, что здесь мы имеем дело с чем-то большим. Не означает ли это, что изъян как раз в тебе… и что ты ищешь не знание, а только приемлемый ответ?»~
@59241 = ~«Когда ты говорил, что город везде одновременно, что ты имел в виду?»~
@59242 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59243 = ~«Ясно. Пошли».~
@59244 = ~Дак'кон замолкает. «Нет *знания* в ответах на вопросы, которые мы задали. Город всё ещё существует. Это всё».~
@59245 = ~«Но я бы сказал, что мы *познаём* себя с помощью вопросов, которые себе задаём или не задаём. Если мы перестанем задавать вопросы и примем только то, что можем воспринять…»~
@59246 = ~«Но я бы сказал, что мы *познаём* себя с помощью вопросов, которые себе задаём или не задаём. Если мы перестанем задавать вопросы и примем только то, что можем воспринять…»~
@59247 = ~«Хорошо. Есть другие вещи, которые я хотел бы *познать*…»~
@59248 = ~«Тогда неважно. Пошли».~
@59249 = ~«Тогда мы прекратим попытки *узнать* себя, — голос Дак'кона немного меняется, становится сильнее. — Такие слова были сказаны ранее. Я слышал их и *знаю* их».~
@59250 = ~«Где ты их слышал?»~
@59251 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59252 = ~«Неважно. Пошли».~
@59253 = ~«Слова мои. Когда-то я *знал* их и *знал* их смысл. Я забыл их, пока ты не произнёс», — взгляд Дак'кона устремляется вдаль сквозь тебя, его клинок перестаёт блестеть, отсвечивая всеми цветами, и становится полупрозрачным.~
@59254 = ~«Дак'кон, как вышло, что я знаю твои слова?»~
@59255 = ~«Дак'кон, слышал ли я эти слова от тебя, когда мы путешествовали вместе?»~
@59256 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59257 = ~«Неважно. Пошли».~
@59258 = ~«Я произносил слова, но они мне не принадлежат. Другие *знают* их, и *знание* о них лежит в основе всех вещей. Люди называет это *мудростью*».~
@59259 = ~«Хорошо. Есть другие вещи, которые я хотел бы *познать*…»~
@59260 = ~«Ясно. Пошли».~
@59261 = ~«Много раз мы обсуждали смысл этих слов. Тогда, когда годы не столь сильно давили на нас. Многое я забыл с тех пор».~
@59262 = ~«Дак'кон, кем был я… тот, другой я?»~
@59263 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59264 = ~«Ясно. Пошли».~
@59265 = ~Взгляд Дак'кона устремляется сквозь тебя, он умолкает.~
@59266 = ~«Дак'кон?»~
@59267 = ~«Тогда забудь. Есть другие вещи, которые я хотел бы *познать*…»~
@59268 = ~«Может, лучше не говорить об этом. Пошли».~
@59269 = ~Дак'кон сказал, что знал одну из моих предыдущих инкарнаций… и не может сказать о нём ничего хорошего. Он назвал его способным, но эгоистичным и вероломным в своих поступках. Я начинаю удивляться, сколько же вреда мои другие «я» причинили планам.~
@59270 = ~«*Знай*, что он был другим. *Знай*, что разница между вами была не в коже, не во владении оружием и не в одежде. *Знай*, что разница лежала в мышлении и в том, что он делал, помыслив. Его ВОЛЯ становилась материей. *Знай*, что он смотрел на других и не видел их. Он *знал* лишь то, как они могут служить ему. Его сердце было вероломным и холодным, и никогда ничто не согревало его».~
@59271 = ~«Это коснулось тебя, Дак'кон? Предавал ли он тебя?»~
@59272 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59273 = ~«Поговорим об этом в другой раз. Пошли».~
@59274 = ~Клинок Дак'кона становится тупым, сплошь чёрным, а на лезвиях словно вырастают зубцы. Лицо Дак'кона каменеет, и он цедит сквозь зубы: «Нет моей *воли*, чтобы ты *знал* об этом».~
@59275 = ~«*Расскажи* мне, Дак'кон. Предавал ли он тебя?»~
@59276 = ~«Хорошо. Есть другие вещи, которые я хотел бы *познать*…»~
@59277 = ~«Тогда не будем об этом. Пошли».~
@59278 = ~«*Знай*, было МНОГО предательств. И предательство в отношении меня свершено моими руками. Ничьими другими».~
@59279 = ~«*Расскажи* мне, Дак'кон. Что это было за предательство?»~
@59280 = ~«Неважно. Есть другие вещи, которые я хотел бы *познать*…»~
@59281 = ~«Поговорим об этом в другой раз. Пошли».~
@59282 = ~«Я отдал ему моё СЛОВО. Я отдал ему СЕБЯ».~
@59283 = ~«О чём ты?»~
@59284 = ~«Неважно. Есть другие вещи, которые я хотел бы *познать*…»~
@59285 = ~«Поговорим об этом в другой раз. Пошли».~
@59286 = ~Дак'кон раскрыл мне природу своего рабства… когда я спас его жизнь, он обещал служить мне до моей смерти. Но он не знал, что я бессмертен, таким образом он отдал мне свою жизнь.~
@59287 = ~«Народ не позволяет другим порабощать себя ни делами, ни цепями. Если мы оказываемся в клетке, то ДЕЙСТВУЕМ, чтобы обрести свободу, даже если действие вынуждает временно выносить другую клетку. Ты оказал мне великую услугу. Сделав это, ты поработил меня. Я попытался освободиться. *Знай*, что я отдал своё слово и свою волю в твоё распоряжение до самой твоей смерти».~
@59288 = ~«Но… я не могу умереть».~
@59289 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59290 = ~«Поговорим об этом в другой раз. Пошли».~
@59291 = ~«Это было *неизвестно* мне. Я отдал ему своё *слово*. Я отдал ему *себя*. *Знай*, что мне больше нечего теперь отдать, кроме своей жизни. *Знай*, теперь я следую за тобой лишь в надежде умереть».~
@59292 = ~«Что за услуга так… сковала тебя?»~
@59293 = ~«Дак'кон, так быть не должно… Я могу освободить тебя. Я не желаю, чтобы ты был рабом, считай долг уплаченным».~
@59294 = ~«Дак'кон, так быть не должно… Я могу освободить тебя. Я не желаю, чтобы ты был рабом, считай долг уплаченным».~
@59295 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59296 = ~«Так другой я вырвал у тебя обещание служить ему до самой смерти, и ты не знал, что он бессмертен? Отлично, пошли… раб».~
@59297 = ~«Так другой я вырвал у тебя обещание служить ему до самой смерти, и ты не знал, что он бессмертен? Отлично, пошли… раб».~
@59298 = ~«Поговорим об этом в другой раз. Пошли».~
@59299 = ~«Ты спас этому жизнь. В обмен, твоя жизнь стала моей».~
@59300 = ~«Как я спас тебе жизнь?»~
@59301 = ~«Дак'кон, так быть не должно… Я могу освободить тебя. Я не желаю, чтобы ты был рабом, считай долг уплаченным».~
@59302 = ~«Дак'кон, так быть не должно… Я могу освободить тебя. Я не желаю, чтобы ты был рабом, считай долг уплаченным».~
@59303 = ~«Так другой я вырвал у тебя обещание служить ему до самой смерти, и ты не знал, что он бессмертен? Отлично, пошли… раб».~
@59304 = ~«Так другой я вырвал у тебя обещание служить ему до самой смерти, и ты не знал, что он бессмертен? Отлично, пошли… раб».~
@59305 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59306 = ~«Поговорим об этом в другой раз. Пошли».~
@59307 = ~«На крутящемся плане Лимбо Народ создаёт своими мыслями города из хаоса. *Знай*, что там нет места для разделённого ума», — Дак'кон поднимает клинок и держит перед собой. Он пристально смотрит на клинок, и тот *обостряется* почти до толщины листа бумаги.~
@59308 = ~«Продолжай…»~
@59309 = ~«Я услышал достаточно. Есть другие вещи, которые я хотел бы *познать*…»~
@59310 = ~«Поговорим об этом в другой раз. Пошли».~
@59311 = ~«Разделённый разум — мятущийся разум. Разделённый разум ломает стены и ослабляет камень, — пока Дак'кон говорит, его клинок словно понемногу разъедает ржавчина, метал дымится и тает по краям. — Много разделённых умов могут *разрушить* город».~
@59312 = ~«Я понял. Продолжай…»~
@59313 = ~«Я услышал достаточно. Есть другие вещи, которые я хотел бы *познать*…»~
@59314 = ~Гитиянки злобно смотрит на тебя и молчит. Когда ты пытаешься заговорить с ним, он сплёвывает на землю и отворачивается.~
@59315 = ~«Поговорим об этом в другой раз. Пошли».~
@59316 = ~«Долго я *познавал* слова Зертимона. Многие *познали* слова Зертимона от меня. *Зерты* защищают общество от угроз как для тела, так и для разума. Они — путеводные камни в хаосе. Но так случилось, что я говорил слова Зертимона без *знания* их. Так случилось, что я больше не *знал* самого себя».~
@59317 = ~«Тогда прощай».~
@59318 = ~«Так… ты сомневался в словах?»~
@59319 = ~«Я услышал достаточно. Есть другие вещи, которые я хотел бы *познать*…»~
@59320 = ~«Поговорим об этом в другой раз. Пошли».~
@59321 = ~Ты видишь медленно вышагивающего гитиянки с желтоватой кожей, худым лицом и неприятным взглядом. Ты почти чувствуешь его ярость. При твоём приближении он поднимает на тебя взгляд. «Что тебе надо?», — раздражённо ворчит он.~
@59322 = ~«Нет, — голос Дак'кона резок, и его клинок в ответ становится *острее*. — Я *познал* слова. Когда они пришли в моё сердце, я подумал, что, может, другие *знают* слова не так, как *знал* их Зертимон. Так родилось разделение. Когда мой разум стал двумя, когда мой разум разделился, то те, кто смотрели на меня как на путеводный камень, разделились. Многие гитцерай, многие десятки сотен… усомнились. Шра'кт'лор умер в тот день».~
@59323 = ~«Я слышал, тебе нужна помощь».~
@59324 = ~«Значит… те, кто следовал за тобой, тоже усомнились, и город ослаб».~
@59325 = ~«Я услышал достаточно. Есть другие вещи, которые я хотел бы *познать*…»~
@59326 = ~«Поговорим об этом в другой раз. Пошли».~
@59327 = ~«Кто ты?»~
@59328 = ~«Что ты можешь рассказать о Керсте?»~
@59329 = ~«Ничего не слышал о дэве в Керсте?»~
@59330 = ~«Пришли враги Зертимона. *Знай*, они ненавидели его слова и Народ укрепил свои клинки против них. *Знай*, они почувствовали ослабленный город и напали на него. Многие гитцерай погибли в хаосе и под клинками врагов, — лезвие клинка словно волдыри покрывают маленькие металлические капельки. — *Знай*, это случилось давно».~
@59331 = ~«Ничего. Забудь».~
@59332 = ~«Что случилось с тобой?»~
@59333 = ~Назад на Площадь Мусорщиков~
@59334 = ~«Я Ан'изиус, и ты должен обращаться ко мне Ваша Честь. Я — один из высших лиц города и заслужил подобное уважение, — он внимательно тебя оглядывает. — Ты не отсюда. Чего ты хочешь?»~
@59335 = ~«Я слышал, тебе нужна помощь».~
@59336 = ~Назад в Улей~
@59337 = ~«Что случилось с тобой?»~
@59338 = ~«Я ищу дэва».~
@59339 = ~«Я кое-что потерял».~
@59340 = ~Назад за пределы Керста~
@59341 = ~«Ничего. Прощай».~
@59342 = ~«Ладно. Есть другие вещи, которые я хотел бы *познать*…»~
@59343 = ~Портал назад во двор Фарода~
@59344 = ~«Поговорим об этом в другой раз. Пошли».~
@59345 = ~Он усмехается: «Спрашивай тех, у кого есть время. Моя голова занята государственными вопросами».~
@59346 = ~«Я слышал, тебе нужна помощь».~
@59347 = ~«Когда я выпал за стены Шра'кт'лора, *знай*, что моё я было сломлено. Мой клинок стал дымом, мой разум был разделён. Я дрейфовал по морям Лимбо и желал утонуть. Я умирал днями, мой разум распадался, и смерть наконец пришла ко мне. У неё была твоя кожа и твой голос».~
@59348 = ~«Мой голос?»~
@59349 = ~«Я услышал достаточно. Есть другие вещи, которые я хотел бы *познать*…»~
@59350 = ~«Государственными вопросами?»~
@59351 = ~«Поговорим об этом в другой раз. Пошли».~
@59352 = ~«И всё же, кто ты?»~
@59353 = ~«Ты просил, чтобы я слушал тебя».~
@59354 = ~«Я ищу дэва».~
@59355 = ~«Что я сказал?»~
@59356 = ~«Так и поступлю. Прощай».~
@59357 = ~«Неважно. Есть другие вещи, которые я хотел бы *познать*…»~
@59358 = ~~
@59359 = ~«Поговорим об этом в другой раз. Пошли».~
@59360 = ~Дак'кон молчит. «Я слышал твои слова. Хаос всё ещё царил в моём разуме. Но я снова *познал* себя».~
@59361 = ~«Так ты получил Круг от меня?»~
@59362 = ~«Хорошо. Есть другие вещи, которые я хотел бы *познать*…»~
@59363 = ~«Поговорим об этом в другой раз. Пошли».~
@59364 = ~«Да. В *познании* его слов я *познал* себя».~
@59365 = ~«Но спасло ли это твою жизнь, Дак'кон? Или разделило её сильнее после изучения Круга?»~
@59366 = ~«Хорошо. Есть другие вещи, которые я хотел бы *познать*…»~
@59367 = ~«Это всё, что я хотел знать. Пошли».~
@59368 = ~«Дак'кон, *зерт* Шра'кт'лора-Утонувшего, последний владелец клинка *карач*. *Знай*, что я пришёл к тебе со словами Зертимона, высеченными не в хаосе, но в камне, во имя Неразорванного Круга. *Знай*, что они истинны, и *знай*, что твоему разуму не нужно больше оставаться разделённым. Всё, что тебе нужно сделать — коснуться камня, и ты снова *познаешь* себя».~
@59369 = ~«Так ты получил Круг от *меня*?»~
@59370 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59371 = ~«Это всё, что я хотел знать. Пошли».~
@59372 = ~Оказалось, именно я был тем, кто дал Дак'кону Неразорванный Круг Зертимона.~
@59373 = ~Дак'кон мгновение молчит, но его клинок корчится, словно от боли. Затем Дак'кон говорит медленно и мрачно: «Это разделило меня».~
@59374 = ~«Тогда *спас* ли я твою жизнь, Дак'кон? Или просто усилил боль, которую ты чувствовал? Эти слова… слова Зертимона… похоже, лишь сильнее разделили тебя. Я чувствую это, когда ты говоришь об учении».~
@59375 = ~«Так я и думал. Есть другие вещи, которые я хотел бы *познать*…»~
@59376 = ~«Не будем больше об этом. Пошли».~
@59377 = ~Дак'кон молчит.~
@59378 = ~«Я хочу сказать, что НИКОИМ ОБРАЗОМ не спасал тебя, Дак'кон… Я просто оттянул твою смерть. Если бы ты умер в Шра'кт'лоре, то познал бы покой».~
@59379 = ~«Твои слова несут тяжесть истины. Смерть, которой я умер бы в Шра'кт'лоре, была бы последней. С тех пор каждый новый день для меня — новая смерть».~
@59380 = ~«Ты больше не обязан служить мне, Дак'кон. Я вовсе не спас твою жизнь, я лишь дважды убил тебя. Ты ничего мне не должен».~
@59381 = ~«Таков порядок вещей. Есть другие вещи, которые я хотел бы *познать*…»~
@59382 = ~«Поговорим об этом позже. Пошли».~
@59383 = ~Дак'кон ждёт.~
@59384 = ~«Можешь ещё раз рассказать мне о народе гитцерай?»~
@59385 = ~«Ты делаешь особое ударение на „знании“. Почему?»~
@59386 = ~«Что это у тебя за клинок?»~
@59387 = ~«У меня вопросы о языке гитцерай…»~
@59388 = ~«Вместо этого у меня пара других вопросов…»~
@59389 = ~«Неважно, Дак'кон. Пошли».~
@59390 = ~Дак'кон ждёт.~
@59391 = ~«Что ты можешь рассказать о Сигиле?»~
@59392 = ~«Не знаешь мужчину по имени Фарод?»~
@59393 = ~«Я потерял дневник. Не знаешь, где он может быть?»~
@59394 = ~«Когда Фелл описывал татуировку на моей руке, ты сказал, что знаешь символы».~
@59395 = ~«Ты сказал, что когда-то я путешествовал с четырьмя другими. Кто они были?»~
@59396 = ~«Вместо этого у меня пара других вопросов…»~
@59397 = ~«Неважно, Дак'кон. Пошли».~
@59398 = ~«Нет… — лицо Дак'кона искажает гримаса боли, глаза смотрят сквозь тебя. — Твоё слово не имеет веса, и твоё слово не освободит меня. Слово, сковывающее меня, — моё. Страдания — мои. Лишь моё сердце *знает* сковывающие цепи. Слова их не снимут».~
@59399 = ~«Есть ли способ освободить тебя?»~
@59400 = ~«Тогда забудь. Есть другие вещи, которые я хотел бы *познать*…»~
@59401 = ~Его глаза сужаются: «Дэв? Зачем тебе дэв, и почему ты ищешь его в Керсте?»~
@59402 = ~«Я пришёл за мечом».~
@59403 = ~«Поговорим об этом позже, тема ещё не закрыта. Пошли».~
@59404 = ~Дак'кон говорит, что единственный способ освободить его от рабства — умереть окончательной смертью. Я пока не знаю, как мне это осуществить.~
@59405 = ~«Забудь. Прощай».~
@59406 = ~«Ты должен умереть окончательной смертью. Но твой путь и путь смерти не пересекаются. *Нет* решения у этой задачи».~
@59407 = ~«Да. Я уже стащил твои бинты. Неужели ты думаешь, что сможешь предотвратить похищение меча, если подобное взбредёт мне в голову?»~
@59408 = ~~
@59409 = ~Клятва: «Я клянусь, что найду способ, Дак'кон. Я найду то, что освободит тебя».~
@59410 = ~«Я считаю, что он знает, в чём секрет моей смертности».~
@59411 = ~«Я слышал, один здесь был. Ничего об этом не знаешь?»~
@59412 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59413 = ~«Забудь. Я слышал, тебе нужна помощь».~
@59414 = ~«Поговорим об этом позже, тема ещё не закрыта. Пошли».~
@59415 = ~«Забудь. Мне надо идти. Прощай».~
@59416 = ~Я поклялся Дак'кону, что найду способ освободить его от рабства. Вместо того, чтобы воодушевить, клятва только погрузила его в большее уныние.~
@59417 = ~«И что бы это могло быть? Возможно, как глава города я смогу тебе помочь».~
@59418 = ~«Как главе этого города тебе могут быть небезынтересны *мои услуги*. Я слышал, тебе нужна помощь».~
@59419 = ~«Я потерял свою смертность. Мне нужно найти её».~
@59420 = ~«Ничего важного. Я сам всё найду».~
@59421 = ~«Ничего важного. Прощай».~
@59422 = ~Он внимательно осматривает тебя, словно оценивает и выносит про себя суждение о твоей персоне: «Ничего такого, в чём было бы нужно твоё содействие. Теперь отойди, не мешай мне думать».~
@59423 = ~«Я слышал, тебе нужна помощь».~
@59424 = ~«Хорошо. Прощай».~
@59425 = ~Голос Дак'кона прерывается, словно он заболел: «*Знай*, ты добавил другие слова к моим». Выражение лица у него болезненное, взгляд встречается с твоим: «Теперь ты сковал нас обоих».~
@59426 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59427 = ~Он смотрит на тебя так, словно ты перешёл грань безумия. «Тебе и вправду нужна помощь. Всего хорошего», — он чопорно отворачивается от тебя.~
@59428 = ~«Поговорим об этом позже, тема ещё не закрыта. Пошли».~
@59429 = ~~
@59430 = ~«Сам город построен из дверей. Эти двери ведут куда угодно».~
@59431 = ~«Прощай».~
@59432 = ~«Где эти двери?»~
@59433 = ~«Так почему ты сказал, что в городе есть изъян?»~
@59434 = ~«Не то чтобы я над этим задумывался, — он продолжает глазеть на тебя. — Прошу прощения, но мои мысли заняты государственными вопросами».~
@59435 = ~«У меня другие вопросы о наших путешествиях…»~
@59436 = ~«Государственными вопросами?»~
@59437 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59438 = ~«Понял. Прощай».~
@59439 = ~«Ясно. Пошли».~
@59440 = ~Вход в Мортуарий~
@59441 = ~«Тогда зачем ты прервал мои размышления? Тебя надо бы заковать в кандалы! Уходи!» — он отворачивается от тебя.~
@59442 = ~«Они повсюду в городе… — Дак'кон на секунду замолкает. — Говорят, каждое ограниченное пространство в Городе-известном-как-Сигил — дверь, которая куда-то ведёт».~
@59443 = ~Монумент Пыльных~
@59444 = ~«Я слышал, тебе нужна помощь».~
@59445 = ~«Не понимаю».~
@59446 = ~Бар «Собиратели пыли»~
@59447 = ~«Так почему ты сказал, что в городе есть изъян?»~
@59448 = ~«Тогда прощай».~
@59449 = ~В юго-восточную часть Улья~
@59450 = ~«У меня другие вопросы о наших путешествиях…»~
@59451 = ~«Превосходно. Ты наверняка найдёшь то, что ищешь, если посидишь в заключении под Керстом. Стража!» — вокруг тебя возникают стражники, и ты получаешь тяжёлый удар по затылку. В глазах темнеет…~
@59452 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59453 = ~На аллею Опасных Углов~
@59454 = ~«Проклятие…»~
@59455 = ~«Ясно. Пошли».~
@59456 = ~«Представь дверь дома. Убери дверь. Рама останется. Пространство внутри рамы останется дверью».~
@59457 = ~«Но это просто… открытое пространство».~
@59458 = ~Мавзолей~
@59459 = ~«Так почему ты сказал, что в городе есть изъян?»~
@59460 = ~Он заметно напрягается: «И что же ты слышал?»~
@59461 = ~«Так почему ты сказал, что в городе есть изъян?»~
@59462 = ~«Только то, что у тебя проблемы с политическими противниками».~
@59463 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59464 = ~На долю секунды его глаза расширяются, потом снова сужаются: «Ясно. И ты намерен мне помочь?»~
@59465 = ~«Ясно. Пошли».~
@59466 = ~«Многие двери ты не можешь увидеть. Ты можешь пройти сквозь них, как сквозь воздух, и не *знать*, что это такое. Они скрыты от твоего взгляда и прикосновения».~
@59467 = ~«И эти невидимые двери *повсюду* в Сигиле?»~
@59468 = ~«Смотря что тебе нужно».~
@59469 = ~«Так почему ты сказал, что в городе есть изъян?»~
@59470 = ~«У меня другие вопросы о наших путешествиях…»~
@59471 = ~«Да».~
@59472 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59473 = ~«Нет».~
@59474 = ~«Ясно. Пошли».~
@59475 = ~«Говорят, каждое ограниченное пространство в Городе-известном-как-Сигил — дверь. Точно они *неизвестны*. Двери движутся. Двери меняются. Двери исчезают. И все они закрыты».~
@59476 = ~«Закрыты?»~
@59477 = ~«Так почему ты сказал, что в городе есть изъян?»~
@59478 = ~«У меня другие вопросы о наших путешествиях…»~
@59479 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59480 = ~«Ясно. Пошли».~
@59481 = ~«Дверь неощутима, как воздух, пока у тебя нет ключа, который бы её отпирал. Когда ты получишь ключ, ты *узнаешь* дверь».~
@59482 = ~«Как узнать, что из себя представляет ключ?»~
@59483 = ~«Так почему ты сказал, что в городе есть изъян?»~
@59484 = ~«У меня другие вопросы о наших путешествиях…»~
@59485 = ~«Тогда ты мне бесполезен. Убирайся!» — он прогоняет тебя взмахом кисти руки и теряет к разговору интерес.~
@59486 = ~«Прощай».~
@59487 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59488 = ~«Ясно. Пошли».~
@59489 = ~«У каждой двери — свой ключ. Некоторые ключи *известны*, некоторые — *неизвестны*».~
@59490 = ~«Это деликатный вопрос. Соперничество требует образования. Сразу успокою, если ты вдруг из брезгливых: тебе не придётся убивать её».~
@59491 = ~«А что за ключи?»~
@59492 = ~«Так почему ты сказал, что в городе есть изъян?»~
@59493 = ~«Тогда можешь на меня рассчитывать».~
@59494 = ~«У меня другие вопросы о наших путешествиях…»~
@59495 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59496 = ~«Забудь об этом».~
@59497 = ~«Ясно. Пошли».~
@59498 = ~«Ключей не меньше, чем дверей. Ключ — не всегда предмет из металла. Ключом может быть удар двух мечей, капля крови из языка умирающего, память о прошедшей любви или злое проклятие небесам. Когда дверь встречается с ключом, она проявляется».~
@59499 = ~«Вот что ты должен сделать: женщина, Сиабха… она продаёт своё влияние выгодным покупателям, подрывая мои отношения с бюргером. Я хочу, чтобы ты её скомпрометировал. Всё, что тебе нужно, — сказать капитану стражи этого города, что она наняла тебя убить меня. За это я тебя вознагражу. Ты найдёшь её — если решишься, конечно, — возле здания администрации».~
@59500 = ~«Звучит так, будто найти все эти двери и ключи может быть очень сложно».~
@59501 = ~«Так почему ты сказал, что в городе есть изъян?»~
@59502 = ~«Я скоро вернусь».~
@59503 = ~«У меня другие вопросы о наших путешествиях…»~
@59504 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59505 = ~Ан'изиус, чиновник-гитиянки в Керсте, хочет опозорить свою политическую соперницу, солгав о ней капитану стражи. Её имя Сиабха, а встретить её можно около здания администрации во Внутреннем Керсте.~
@59506 = ~«Ясно. Пошли».~
@59507 = ~«Попытки были, но все неудачные. Когда город меняется, меняются и двери. Никакое *знание* не остаётся *знанием* долго».~
@59508 = ~«Так почему ты сказал, что в городе есть изъян?»~
@59509 = ~«У меня другие вопросы о наших путешествиях…»~
@59510 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59511 = ~«Ясно. Пошли».~
@59512 = ~«Для всего существующего, живого или нет, существование определяется *знанием* себя».~
@59513 = ~«А если кто-то не знает себя?»~
@59514 = ~«Ясно. У меня другие вопросы о гитцерай…»~
@59515 = ~Ты видишь медленно вышагивающего гитиянки с желтоватой кожей, худым лицом и неприятным взглядом. Ты почти чувствуешь его ярость. При твоём приближении он поднимает на тебя взгляд. «Что тебе надо?» — раздражённо ворчит он.~
@59516 = ~«У меня к тебе пара вопросов…»~
@59517 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59518 = ~«Ясно. Пошли».~
@59519 = ~Глаза гитиянки сужаются: «Я отбросил ненависть, которую испытывал по отношению к вашему народу. Я поднялся над мелкой враждой между двумя нашими расами. За это меня изгнали, но в сердце своём я превзошёл их. Можешь ли ты сказать то же самое?»~
@59520 = ~«Когда разум не *знает* себя — он имеет изъян. Когда разум с изъяном — изъян имеет и обладатель. Когда личность с изъяном — изъян передаётся всему, чего она касается, — Дак'кон выдерживает паузу. — Говорят, всё, что видит личность с изъяном, её руки ломают».~
@59521 = ~«А ты знаешь себя?»~
@59522 = ~«Ясно. У меня другие вопросы о гитцерай…»~
@59523 = ~«Есть другие вещи, которые я хотел бы *познать*…»~
@59524 = ~«Ясно. Пошли».~
@59525 = ~Дак'кон замолкает. Взгляд его угольно-чёрных глаз устремляется в ту же даль, что и при вашей первой встрече.~
@59526 = ~«Ладно, вы двое… прекратите. У меня вопросы».~
@59527 = ~«Забудь. Мы уходим».~
@59528 = ~«Я снова спрашиваю: ты знаешь себя?»~
@59529 = ~«У меня другие вопросы о гитцерай…»~
@59530 = ~«Какие?»~
@59531 = ~«Неважно. Есть другие вещи, которые я хотел бы *познать*…»~
@59532 = ~«Поговорим об этом в другой раз. Пошли».~
@59533 = ~«Я слышал, тебе нужна помощь».~
@59534 = ~Когда Дак'кон начинает говорить снова, его голос меняется; слова рождают эхо, как будто большой камень падает в пропасть. Похоже, он как-то усиливает слова, исходящие из его груди. «Нет моей *воли*, чтобы ты это *знал*».~
@59535 = ~«Может быть, я слишком мягко изложил это как вопрос. Расскажи мне».~
@59536 = ~«Ладно. У меня другие вопросы о гитцерай…»~
@59537 = ~«Кто ты?»~
@59538 = ~«Ладно. Есть другие вещи, которые я хотел бы *познать*…»~
@59539 = ~«Ясно. Пошли».~
@59540 = ~«Что ты можешь рассказать о Керсте?»~
@59541 = ~Слова исходят из Дак'кона медленно, как будто одно цепляется за другое. «Так… случилось, что я не *знаю* себя».~
@59542 = ~«Ничего не слышал о дэве в Керсте?»~
@59543 = ~«Почему?»~
@59544 = ~«Никаких. Забудь».~
@59545 = ~Голос Дак'кона падает до шёпота, похожего на шелест песчинок: «Я не *знаю* почему. Я *знаю*, что это произошло, но не *знаю*, как и когда… и как *познать* себя снова».~
@59546 = ~«Ясно. У меня другие вопросы о гитцерай…»~
@59547 = ~«Что тебе нужно, пёс?»~
@59548 = ~«Тогда забудь. Есть другие вещи, которые я хотел бы *познать*…»~
@59549 = ~«Я передумал. Я помогу тебе. Что нужно сделать?»~
@59550 = ~«Поговорим в другой раз. Пошли».~
@59551 = ~«Это клинок *карач*. Это вещь, по которой остальные *знают* положение владельца».~
@59552 = ~«*Карач*? Что это означает?»~
@59553 = ~«Ничего. Прощай».~
@59554 = ~«Он выполнен из странного металла… то, как он движется туда-сюда, почти завораживает».~
@59555 = ~«Какое положение он означает?»~
@59556 = ~«У меня другие вопросы о гитцерай…»~
@59557 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59558 = ~«Ну? Как твои успехи?»~
@59559 = ~«Поговорим в другой раз. Пошли».~
@59560 = ~«Твоя конкурентка предложила удвоить сумму, если я сдам тебя».~
@59561 = ~«Клинок — символ, носимый *зертами*. *Зерт* — тот, кто *знает* слово Зертимона. В *познании* слов Зертимона они *познают* себя».~
@59562 = ~«Я поговорил с капитаном стражи. Он сказал, что пошлёт отряд препроводить её в тюрьму».~
@59563 = ~«Зертимон?»~
@59564 = ~«Так из чего этот клинок?»~
@59565 = ~«У меня другие вопросы о гитцерай…»~
@59566 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59567 = ~«Поговорим в другой раз. Пошли».~
@59568 = ~«Я работаю. У меня кое-какие вопросы…»~
@59569 = ~«Зертимон создал нашу расу. Он *знал* гитцерай раньше, чем они *узнали* себя. Он создал Народ. Дал им сознание».~
@59570 = ~«Так из чего этот клинок?»~
@59571 = ~«У меня другие вопросы о гитцерай…»~
@59572 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59573 = ~«Поговорим в другой раз. Пошли».~
@59574 = ~«Я работаю. Ещё вернусь».~
@59575 = ~Дак'кон на секунду замолкает, как будто в поиске правильных слов. «Ближайший перевод в твоём языке — „материя хаоса“. Народ может придавать ей форму своими мыслями».~
@59576 = ~«Народ?»~
@59577 = ~«Придавать форму своими мыслями?»~
@59578 = ~Ан'изиус щедро заплатил мне за то, что я сдал Сиабху страже Керста, — вполне достаточно, чтобы оправдать маленькую ложь.~
@59579 = ~«У меня другие вопросы о гитцерай…»~
@59580 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59581 = ~«Поговорим в другой раз. Пошли».~
@59582 = ~«Что? Да я сам удвою сумму!»~
@59583 = ~«Гитцерай».~
@59584 = ~«Что такое гитцерай?»~
@59585 = ~«Хорошо, по рукам».~
@59586 = ~«Так что такое гитцерай?»~
@59587 = ~«И ты говоришь, что гитцерай могут придавать форму этому *карачу*… своими мыслями?»~
@59588 = ~«Посмотрим. До свидания».~
@59589 = ~«У меня другие вопросы о твоём народе…»~
@59590 = ~«Тогда я кое-что тебе должен, — он протягивает тяжёлый мешочек с монетами. — Теперь исчезни».~
@59591 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59592 = ~«Прощай».~
@59593 = ~«Это всё, что я хотел знать. Пошли».~
@59594 = ~«*Карач* выкован не жаром и молотом, а *знанием* себя. Это зеркало, которое отражает волю владельца на поверхности и лезвии. Когда владелец *знает* себя, лезвие сильно — твёрже и сильней стали. Когда он не *знает* себя, лезвие как вода — бесформенное и слабое».~
@59595 = ~«Так иди же! Иди! Или прикажу с тебя шкуру спустить!»~
@59596 = ~«Какое положение означает клинок?»~
@59597 = ~«У меня другие вопросы о гитцерай…»~
@59598 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59599 = ~«До свидания».~
@59600 = ~«Это всё, что я хотел знать. Пошли».~
@59601 = ~«Нам больше нечего сказать друг другу. Наши совместные дела закончились. Нельзя вызывать подозрений. Оставь меня».~
@59602 = ~«Моё *знание* Искусства, как его *знают* люди, ограничено, — клинок Дак'кона плавно скользит в руке, он водит им перед собой круговыми движениями. — Но я достаточно *знаю*. Я научу тебя».~
@59603 = ~«Хорошо. Прощай».~
@59604 = ~«Отлично…»~
@59605 = ~«Зачем ты беспокоишь меня?»~
@59606 = ~«Я слышал, тебе нужна помощь».~
@59607 = ~«Такой мне *неизвестен*».~
@59608 = ~«У меня другие вопросы о наших путешествиях…»~
@59609 = ~«Кто ты?»~
@59610 = ~«Что ты можете рассказать о Керсте?»~
@59611 = ~«Ничего не слышал о дэве в Керсте?»~
@59612 = ~«Неважно. Забудь».~
@59613 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59614 = ~«Это всё, что я хотел знать. Пошли».~
@59615 = ~«Местоположение таких вещей я не *знаю*».~
@59616 = ~«У меня другие вопросы о наших путешествиях…»~
@59617 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59618 = ~«Это всё, что я хотел знать. Пошли».~
@59619 = ~Дак'кон морщит лоб, как будто его ударили. «Нет моей *воли* говорить об этом месте».~
@59620 = ~«Дак'кон, *скажи* мне. Что такое Шра'кт'лор?»~
@59621 = ~«Тогда забудь. Есть другие вещи, которые я хотел бы *познать*…»~
@59622 = ~«Значит, не будем больше об этом. Пошли».~
@59623 = ~Дак'кон на мгновение замолкает. «*Знай*, это место моей первой смерти».~
@59624 = ~«Что это за место?»~
@59625 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59626 = ~«Поговорим об этом в другой раз. Пошли».~
@59627 = ~«Это один из величайших домов Народа. Он перенёс много ран за свою жизнь. Одна из них нанесена моей рукой».~
@59628 = ~«Что ты имеешь в виду?»~
@59629 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59630 = ~«Поговорим об этом в другой раз. Пошли».~
@59631 = ~TEMP~
@59632 = ~TEMP~
@59633 = ~TEMP~
@59634 = ~TEMP~
@59635 = ~Его низкий голос вырывается из слоёв жира: «Меня зовут Кассиус. Я был величайшим оружием мёртвого Владыки Бездны, и его наследники до сих пор меня ищут. Я — ужасный секрет в сердце хаотичных планов и я — хранитель этого клинка».~
@59636 = ~Произнося эти слова, ты чувствуешь, как странное гложущее чувство охватывает твой затылок, в глазах всё расплывается… ты глубоко вдыхаешь и берёшь себя в руки. По какой-то странной причине ты чувствуешь тошноту, как будто земля начала вращаться вокруг тебя.~
@59637 = ~Его голос как из бочки: «Этот меч снабжает энергией тюрьму Керста. Его извлечение освободит всех заключённых, приговорённых к забвению здесь. Моя обязанность — не допустить этого события. Тебе нужен клинок?»~
@59638 = ~«Как… ты выжил, Дак'кон?»~
@59639 = ~«Когда-то я был одним из самых эффективных оружий в Бездне, выкованным по воле моего хозяина. Я могу принимать гибельную для любого создания форму. Я сразил больше врагов своего мёртвого хозяина, чем у большинства мгновений в жизни. Мой брат, моя бледная тень, мой Ксекиель всё ещё убивает в глубинах Бездны».~
@59640 = ~«Когда я выпал за стены Шра'кт'лора, *знай*, что моё я было сломлено. Мой клинок стал дымом, мой разум был разделён. Я дрейфовал по морям Лимбо и желал утонуть. Я умирал днями, мой разум распадался».~
@59641 = ~«Мой хозяин утонул в сердце Бездны, пока я расправлялся с очередным врагом. Когда я вернулся после убийства, хозяина не было, а его наследники пришли за мной. Ни один из них не смог покорить меня, и я ушёл. Эта работа доставляет удовольствие. Я убиваю всех, кто приходит. Нисколько не обременительная задача».~
@59642 = ~«Как же ты уцелел?»~
@59643 = ~Он внимательно тебя изучает. Спустя мгновение он заявляет: «Я бы мог, хотя это будет славная битва. Ты хочешь, чтобы я тебя убил?»~
@59644 = ~«Скажи мне, что ты пришёл за клинком, и я тебя уничтожу».~
@59645 = ~Голос Кассиуса выкатывается из глубин его толстой груди: «Ты ищешь клинок?»~
@59646 = ~«Если пожелаешь получить настоящую сущность клинка, ты должен вернуться, и мы устроим поединок за него. Так или иначе мы устроим поединок».~
@59647 = ~«Как же ты уцелел?»~
@59648 = ~«Тогда вот правила. Ты должен выбрать одно из трёх: сила, ум или скорость. Если тебе не удастся победить в одном из них — я тебя уничтожу».~
@59649 = ~«Тогда мы сразимся. Победишь — получишь клинок с моего трупа. Проиграешь — и я попирую твоими косточками».~
@59650 = ~«Я услышал достаточно. Есть другие вещи, которые я хотел бы *познать*…»~
@59651 = ~«Тогда я загадаю тебе три загадки. Не отгадаешь — я уничтожу тебя, сделаю волынку из твоего черепа и сыграю песню пытки на твоей вечной душе».~
@59652 = ~«Поговорим в другой раз. Пошли».~
@59653 = ~«Тогда ты должен украсть рулон бинтов из тайника в моём теле. Если тебе удастся — поговори со мной снова и я достану клинок из тайника. Потерпишь неудачу — и агония, которую я у тебя вызову, сравнится только с огнями Ямы. Желаешь начать?»~
@59654 = ~Когда Дак'кон рассказывал мне о Шра'кт'лоре, у меня на секунду закружилась голова. Почему-то мне кажется, я что-то *знаю* об этом месте… но не знаю, что.~
@59655 = ~«Тогда вытащи бинты. Иначе я предложу тебе искать клинок другим путём».~
@59656 = ~«Я страдал. Как только я приблизился к смерти, я *познал* себя. Я выжил. Это всё».~
@59657 = ~«Начнём с классической загадки: что на рассвете ходит на четырёх ногах, в полдень — на двух, а на закате — на трёх?»~
@59658 = ~«Ясно. Есть другие вещи, которые я хотел бы *познать*…»~
@59659 = ~«Неверно. Ты погибнешь в невыносимой агонии».~
@59660 = ~«Не будем больше об этом. Пошли».~
@59661 = ~«Верно. Следующая загадка: я страдаю, но ни слова не промолвлю. Хоть и пуст я, но не наполнюсь никогда. Что я такое?»~
@59662 = ~«Да. Третья загадка: что летит и на месте стоять не может? Что пожирает всё, чего касается, но никогда не ест? Что нельзя одолжить, но можно потерять? Что все тратят, но никто не может заработать?»~
@59663 = ~«Ты превзошёл меня. Внешний вид ввёл меня в заблуждение, что твой ум подобен твоей истерзанной внешности. Я не выполнил свой долг и передаю клинок тебе. Я должен покинуть это место».~
@59664 = ~Дак'кон ждёт.~
@59665 = ~«Твой внешний вид скрывает твои таланты. Ты воистину очень ловок, чтобы я мог остановить тебя. Вот ключ. Я должен уйти отсюда, чтобы скрыть свой позор».~
@59666 = ~«Можешь научить меня языку твоего народа?»~
@59667 = ~«Что такое „Выбор Т'ча“?»~
@59668 = ~«Ещё раз, что такое „Выбор Т'ча“?»~
@59669 = ~«Что такое „К'атзн'ии-у-Ворот“?»~
@59670 = ~«Ты был *оружием*?»~
@59671 = ~«Ты не выглядишь таким уж опасным…»~
@59672 = ~«Что значит „Ач'али-Утопшая“?»~
@59673 = ~«Я пришёл за мечом».~
@59674 = ~«Ясно. Прощай».~
@59675 = ~«Вообще-то, у меня были другие вопросы о гитцерай…»~
@59676 = ~«Неважно. Есть другие вещи, которые я хотел бы *познать*…»~
@59677 = ~«Обсудим язык в другой раз. Пошли».~
@59678 = ~Дак'кон морщит лоб, его глаза сужаются: «Я хочу *знать*, как ты *познал* это выражение».~
@59679 = ~«Его произнёс ты, когда мы встретились с тем гитцерай. Я бы хотел *знать*, что ты под этим подразумевал».~
@59680 = ~«Забудь. У меня другие вопросы по поводу языка…»~
@59681 = ~«Не имеет значения. У меня другие вопросы о гитцерай…»~
@59682 = ~«Неважно. Есть другие вещи, которые я хотел бы *познать*…»~
@59683 = ~«Поговорим об этом в другой раз. Пошли».~
@59684 = ~«*Известно* много значений этого выражения».~
@59685 = ~«Тогда скажи мне одно из них».~
@59686 = ~«У меня другие вопросы о языке…»~
@59687 = ~«Не имеет значения. У меня другие вопросы о гитцерай…»~
@59688 = ~«Тогда забудь. Есть другие вещи, которые я хотел бы *познать*…»~
@59689 = ~«Поговорим об этом в другой раз. Пошли».~
@59690 = ~«„Выбор Т'ча“ говорят о том, у кого нет выбора в своих действиях».~
@59691 = ~«Значит, когда я просил тебя поговорить с гитцерай, у тебя не было выбора, кроме как выполнять? Почему?»~
@59692 = ~«Значит, когда я просил тебя поговорить с гитцерай, у тебя не было выбора, кроме как выполнять? Потому что ты мой раб?»~
@59693 = ~«У меня другие вопросы о языке…»~
@59694 = ~«Не имеет значения. У меня другие вопросы о гитцерай…»~
@59695 = ~«Хорошо. Есть другие вещи, которые я хотел бы *познать*…»~
@59696 = ~«Это всё, что я хотел знать. Пошли».~
@59697 = ~Клинок Дак'кона покрывается рябью, и ты видишь, как его края сереют и теряют очертания. Его лицо искажается, и он цедит сквозь зубы: «Нет моей *воли* говорить об этом».~
@59698 = ~«Я хочу услышать… вообще-то, в том разговоре ты сказал много вещей, которые меня заинтересовали».~
@59699 = ~«У меня другие вопросы о языке…»~
@59700 = ~«Не имеет значения. У меня другие вопросы о гитцерай…»~
@59701 = ~«Хорошо. Есть другие вещи, которые я хотел бы *познать*…»~
@59702 = ~«Тогда не будет больше об этом. Пошли».~
@59703 = ~«*Знай*, что твоя воля — это моя *воля*. Когда ты говоришь, *знай*, что я должен тебя слушать. *Знай*, что твои слова могут задержать мой клинок или направить его кому-либо в глотку».~
@59704 = ~«Что? Но почему?»~
@59705 = ~«Да».~
@59706 = ~«Нет».~
@59707 = ~«На самом деле мне просто хочется уйти».~
@59708 = ~«У меня другие вопросы о языке…»~
@59709 = ~«У меня другие вопросы о гитцерай…»~
@59710 = ~«Почему ты ушёл?»~
@59711 = ~«Верно. Я пришёл за мечом».~
@59712 = ~«Хорошо. Я как раз уходил».~
@59713 = ~«Не будем больше об этом. Есть другие вещи, которые я хотел бы *познать*…»~
@59714 = ~«Я услышал достаточно. Пошли».~
@59715 = ~«Я пришёл за клинком».~
@59716 = ~Дак'кон смотрит будто бы сквозь тебя, словно встретиться с твоим взглядом невозможно: «Твой путь — мой путь. Я прикован к тебе».~
@59717 = ~«А меня убить можешь?»~
@59718 = ~«Ты — мой раб?»~
@59719 = ~«Ясно. Прощай».~
@59720 = ~На слове «раб» лицо Дак'кона перекашивает от боли, как будто его ударили… как будто слово — это кинжал, ударивший в самое сердце его страданий.~
@59721 = ~«Но… почему, Дак'кон?»~
@59722 = ~«На самом деле я всего лишь пришёл за клинком».~
@59723 = ~«*Знай*, что это… длинная история, и *знай*, что разговорами ничего не добьёшься».~
@59724 = ~«Хотелось бы посмотреть».~
@59725 = ~«Я бы хотел её услышать».~
@59726 = ~«Нет. Вообще-то я ухожу».~
@59727 = ~«Ладно, не имеет значения. У меня другие вопросы по поводу языка…»~
@59728 = ~«Хорошо, у меня другие вопросы о гитцерай…»~
@59729 = ~«Я пришёл за клинком».~
@59730 = ~«Забудь. Я ухожу».~
@59731 = ~«Тогда забудь. Есть другие вещи, которые я хотел бы *познать*…»~
@59732 = ~«Тогда не будет больше о этом. Пошли».~
@59733 = ~«Сначала расскажи мне о себе».~
@59734 = ~«Да».~
@59735 = ~«Да. Я уже стащил твои бинты, неужели ты думаешь, что сможешь предотвратить похищение меча, если подобное взбредёт мне в голову?»~
@59736 = ~«Хорошо. Прощай».~
@59737 = ~Чтобы получить клинок, я решился на испытание силы. Кассиус силён и угрожает попировать моими костями, если я потерплю неудачу.~
@59738 = ~Я начинаю испытание ума с Кассиусом, состоящее из трёх загадок. Если мне удастся его победить, я получу клинок. Если не отгадаю — он обещает сделать инструмент из моего черепа и души.~
@59739 = ~Я начинаю испытание скорости с Кассиусом, хранителем меча. Если я смогу утащить рулон бинтов с его тела, мне надо будет поговорить с ним снова и он отдаст меч. Если не удастся — он угрожает мне уничтожением.~
@59740 = ~Я победил Кассиуса, хранителя клинка в тюрьме Керста, в поединке ума. Его вопросы были удивительно лёгкими.~
@59741 = ~Я победил Кассиуса, хранителя клинка в тюрьме Керста, в поединке скорости. Он был поразительно медленным.~
@59742 = ~Очевидно, я не понимаю значения Первого Круга в Неразорванном Круге Зертимона, или так мне говорит Дак'кон. Думаю, смысл слов выходит за рамки написанного на камне… придётся приложить к учению Зертимона собственную мудрость, прежде чем я постигну Путь Зертимона.~
@59743 = ~Проявив мудрость, я понял Первый Круг Зертимона. Дак'кон, в свою очередь, открыл мне следующий Круг Зертимона. Полагаю, он планирует преподавать мне Неразорванный Круг этапами, открывая каждый круг, как только я постигну предыдущий.~
@59744 = ~Дак'кон согласился обучить меня Пути Зертимона. Он открыл мне Неразорванный Круг Зертимона и сказал изучить его, чтобы *познать* историю его Народа.~
@59745 = ~Отвратительно толстый мужчина в центре тюрьмы вызвал меня на поединок за клинок. Он сказал, что содержит сущность клинка и если меч мне нужен, я должен противостоять ему.~
@59746 = ~«Я выбираю силу».~
@59747 = ~«Я выбираю ум».~
@59748 = ~«Я выбираю скорость».~
@59749 = ~«Забудь. Я вернусь позже».~
@59750 = ~Зубы удалены~ [MRT582A]
@59751 = ~«Отлично».~
@59752 = ~«В таком случае я выбираю ум».~
@59753 = ~«В таком случае я выбираю скорость».~
@59754 = ~«Знаешь, забудь».~
@59755 = ~«*Знай* это: когда произнесено „К'атзн'ии-у-Ворот“, и произносящий при этом задаёт вопрос, ты ответишь на свои вопросы и на заданный тем, с кем говоришь».~
@59756 = ~«Что это значит? Что за „К'атзн'ии“?»~
@59757 = ~«Хорошо, загадывай свои загадки».~
@59758 = ~«У меня другие вопросы о языке…»~
@59759 = ~«Ясно. У меня другие вопросы о гитцерай…»~
@59760 = ~«Хорошо. Есть другие вещи, которые я хотел бы *познать*…»~
@59761 = ~«В таком случае я выбираю силу».~
@59762 = ~«В таком случае я выбираю скорость».~
@59763 = ~«Понятно. Пошли».~
@59764 = ~«Знаешь, забудь».~
@59765 = ~«Отлично».~
@59766 = ~«В таком случае я выбираю силу».~
@59767 = ~«В таком случае я выбираю ум».~
@59768 = ~«Знаешь, забудь».~
@59769 = ~«Хорошо. Посмотрим, что тут можно сделать».~
@59770 = ~Ты знаешь ответ: «Человек, который ползает на всех четырёх после рождения, ходит на двух ногах в молодости и опирается на трость в старости».~
@59771 = ~«Человек?»~
@59772 = ~«Раненый навозный жук?»~
@59773 = ~«Медведь?»~
@59774 = ~«Танар'ри, меняющий форму?»~
@59775 = ~«Подожди!»~
@59776 = ~Драться.~
@59777 = ~Ты знаешь ответ: «Ты — голод?»~
@59778 = ~«Призрак?»~
@59779 = ~«Заключённый без языка?»~
@59780 = ~«Голод?»~
@59781 = ~«Луна?»~
@59782 = ~Ты знаешь ответ: «Это время».~
@59783 = ~«Это время?»~
@59784 = ~«Это огонь?»~
@59785 = ~«Это сила?»~
@59786 = ~«Это магия?»~
@59787 = ~«Спасибо».~
@59788 = ~«Что ж, прощай».~
@59789 = ~Назад в Улей~
@59790 = ~Внутренняя комната Мавзолея~
@59791 = ~Обратно в Мавзолей.~
@59792 = ~В северо-западную часть Улья~
@59793 = ~Рынок~
@59794 = ~Офис контроля паразитов и болезней~
@59795 = ~В юго-восточную часть Улья~
@59796 = ~На аллею Опасных Углов~
@59797 = ~В юго-западную часть Улья~
@59798 = ~В северо-восточную часть Улья~
@59799 = ~В подвал~
@59800 = ~В северо-восточную часть Улья~
@59801 = ~В юго-западную часть Улья~
@59802 = ~Нарисованная дверь в логово головорезов~
@59803 = ~Бар «Горящий труп»~
@59804 = ~Мастерская татуировщика Фелла~
@59805 = ~Логово головорезов~
@59806 = ~Назад в юго-восточную часть Улья~
@59807 = ~На улицу Протяжных Вздохов~
@59808 = ~Лестница на верхний уровень~
@59809 = ~Лестница на нижний уровень~
@59810 = ~Лестница на верхний уровень~
@59811 = ~Лестница на нижний уровень~
@59812 = ~Улица Протяжных Вздохов~
@59813 = ~В Верхний район~
@59814 = ~Точка прибытия~
@59815 = ~Кристалл~
@59816 = ~ПЯТЫЙ КРУГ ЗЕРТИМОНА
Позволяет записать «Сила одного» в книгу заклинаний
Дистанция: прикосновение
Длительность: 30 минут за уровень
Время чтения: 2
Зона действия: существо, которого коснулись
Спасбросок: нет
Вес: 1
Доступно: магам и Безымянному

На каменной пластине Пятого Круга Зертимона высечено:

«Зертимон был первым, кто *познал* путь свободы. Но не он был первым, кто *познал* путь восстания».

«*Знание* о восстании первым пришло к королеве-воительнице Гит, одной из Народа. Она служила *иллитидам* во многих Псевдомирах как солдат, она *познала* войну и война вошла в её сердце. Она *познала*, как можно организовать других, чтобы покорить врагов. Она *познала* пути силы и *познала* умение перенимать оружие завоевателей, чтобы обернуть его против них. Её разум был сосредоточен, её воля и её клинок были одним целым».

«В цикле, котором Зертимон *узнал* Гит, Зертимон перестал *знать* себя. Её слова были подобны огненным стрелам, зажигавшим сердца всех слушателей. Слушая её слова, он пожелал *познать* войну. Он не *знал*, что его беспокоит, но *знал*, что хочет присоединить свой клинок к клинку Гит. Он желал дать выход своей ненависти и разделить свою боль с *иллитидами*».

«Гит была одной из Народа, но её *знание* себя было большим, чем когда-либо у Зертимона. Она *знала* пути плоти, она *знала* *иллитидов* и в *знании* себя она обрела *познание* того, как победить их в битве. Сила её *знания* была столь велика, что все, кто принял её путь, *познали* себя».

«Гит была всего лишь одна. Но её сила была такова, что заставляла других *познать* свою силу. И Зертимон положил свою сталь к её ногам».~
@59817 = ~ШЕСТОЙ КРУГ ЗЕРТИМОНА
Позволяет записать «Баланс всего» в книгу заклинаний
Дистанция: только заклинатель
Длительность: до получения количества ударов, равного уровню / 4 или 5 секунд / уровень
Время чтения: 3
Зона действия: после активации радиус 10 футов
Спасбросок: нет
Вес: 1
Доступно: магам, Дак'кону и Безымянному

На каменной пластине Шестого Круга Зертимона высечено:

«На Сожжённых Полях Зертимон сказал Гит, что не может быть двух небес. И его слова породили войну».

«Так случилось, что Народ одержал победу над своими хозяевами *иллитидами*. Он *познал* свободу. Но прежде чем отблески зелёного огня погасли на поле боя, Гит заговорила о продолжении войны. Многие, ещё не остыв от битвы, полные жажды крови, согласились. Она говорила не просто о победе над *иллитидами*, но об уничтожении всех *иллитидов* на всех планах. После уничтожения *иллитидов*, они понесли бы войну другим встреченным расам».

«В сердце Гит бушевала ярость. Она жила войной и в войне *познала* себя. Всё, что видели её глаза, она хотела завоевать».

«Зертимон говорил об основах, противоречащих воле Гит. Он сказал, что Народ уже *познал* свободу. Теперь он должен *познать* себя снова и исправить нанесённый Народу урон. За его словами билось множество сердец тех из Народа, кто устал от войны против *иллитидов*».

«*Знай*, что сердце Гит не было в этом вопросе единым с сердцем Зертимона. Она сказала, что война будет продолжена. *Иллитиды* будут уничтожены. Их плоть прекратит существование. И тогда Народ объявит Псевдомиры своими владениями. Гит сказала Зертимону, что они должны быть под одним небом в этом деле. И слова были подобны обнажённой стали».

«Зертимон изрёк Пророчество Двух Небес. И его слова породили войну».~
@59818 = ~СЕДЬМОЙ КРУГ ЗЕРТИМОНА
Позволяет записать «Снаряд терпения» в книгу заклинаний
Дистанция: ?
Длительность: ?
Время чтения: ?
Зона действия: ?
Спасбросок: особый
Вес: 1
Доступно: магам, Дак'кону и Безымянному

На каменной пластине Седьмого Круга Зертимона высечено:

«*Знай*, что Восстание Народа против *иллитидов* ковалось множество циклов. Много Народа жило и умерло от клинка времени, прежде чем Восстание обрело свою форму».

«Восстание было заложено на медленном основании. Была собрана сталь, чтобы оставить след на плоти *иллитидов*. Были созданы средства *познания* передвижений *иллитидов*: сначала слабые и неточные, потом более уверенные, словно дитя, пробующее свой голос. Когда передвижения стали *известны*, за *иллитидами* стали следить. Наблюдая за ними, Народ *познал* пути их разума».

«Когда пути *иллитидов* были *познаны*, многие из Народа собрались и научились секрету скрывать свой разум, чтобы не выдать намерений использовать свою волю в качестве оружия. Они обучились писанию стали и, самое важное, обрели *знание* свободы».

«Подобным вещам быстро не научиться. *Познание* большинства путей было медленным, а время давило на всех тяжким грузом на протяжении всего обучения. От *познания* своего отражения на поверхности клинка, через *познание* сокрытия воли, к *познанию* видения себя, — всё это и многое другое прошёл Народ. И однажды он *познал* целое».~
@59819 = ~ВОСЬМОЙ КРУГ ЗЕРТИМОНА
Позволяет записать «Концентрация Зертимона» в книгу заклинаний
Дистанция: 50 футов
Длительность: 5 секунд за уровень
Время чтения: 3
Зона действия: 1 существо
Спасбросок: нет
Вес: 1
Доступно: магам, Дак'кону и Безымянному

На каменной пластине Восьмого Круга Зертимона высечено:

«*Знай*, что разделённый разум разделяет и личность. Воля и рука твои должны составлять единое целое. *Познав* себя, обретаешь силу».

«*Знай*, если сердцем *познал* истинность направления своих действий — не предавай его, пусть даже путь ведёт к невзгодам. *Знай*, что без страданий Восстание никогда не смогло бы поднять головы и Народ никогда не *познал* бы себя».

«*Знай*, нет ничего во всех Мирах, что могло бы противостоять сплочённости. Когда все *знают* единую цель, когда все руки ведёт единая воля и все деяния с единым намерением, то могут быть сдвинуты даже планы».

«Разделённый разум — тот, что не *знает* себя. Когда разум разделён, он рассекает тело надвое. Когда у кого-то единая цель, его тело становится сильнее. В *познании* себя обретаешь силу».~
@59820 = ~КЛИНОК ЭНТРОПИИ
Урон: 3-23 дробящий
Зачаровано: +1
THAC0: +2
Фактор скорости: 1
Вес: 1
Навык: клинок
