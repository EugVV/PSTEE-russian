@53194 = ~Аккуратно изучить веточки, попытаться понять природу их ауры.~
@53195 = ~Ты осторожно изучаешь веточки, внезапно тебя поражает ощущение, что они были выращены с какой-то целью. Похоже, в них таится некий магический потенциал, но ты не понимаешь, как его высвободить.~
@53196 = ~Оставить веточки в покое.~
@53197 = ~Оставить веточки в покое.~
@53198 = ~Осмотреть веточки.~
@53199 = ~Оставить веточки в покое.~
@53200 = ~На полу лабиринта перед тобой мёртвый круг… новых ветвей не появляется, и ты думаешь, что они и не вырастут теперь, когда Рейвел встретила свой конец.~
@53201 = ~Оставить круг в покое.~
@53202 = ~Эта особа буквально дёргается от возбуждения, её глаза горят в злобном предчувствии. Твоё приближение встречает поворот головы и ухмылка: «Чего?»~
@53203 = ~«Что здесь происходит?»~
@53204 = ~«Ничего. Прощай».~
@53205 = ~«Поговори с Джуджогом, если хочешь поучаствовать в деле. Теперь сдрисни!»~
@53206 = ~«Погоди… кто такой Джуджог?»~
@53207 = ~«Хорошо. Прощай».~
@53208 = ~В ответ следует раздражённый взгляд и пространный жест: «Стражник вон там, весь в броне».~
@53209 = ~Уйти.~
@53210 = ~Эта личность в панике, кричит и вряд ли способна мыслить здраво: «Джуджог мёртв! Что же нам делать? Надо убираться отсюда!»~
@53211 = ~Уйти.~
@53212 = ~Этот крупный стражник рычит приказы собравшимся вокруг него гражданским. Когда ты его прерываешь, он свирепо смотрит на тебя сквозь прорези в шлеме: «Чё те надо, бродяга? И не тяни, не вишь, мы тута работаем».~
@53213 = ~«Что здесь происходит?»~
@53214 = ~«Неважно. Прощай».~
@53215 = ~«А на что это похоже, придурок?! Мы собираемся грабануть этот склад. Хочешь присоединиться иль как? Не боись, никакой жопы не будет… мы делаем это по *праву*, и командую тут я».~
@53216 = ~«Если мы прекратим беспорядки, это поможет городу вернуться во Внешние Земли. Вскоре Керст переполнят чудовища, и как думаешь, долго ты сможешь наслаждаться награбленным?»~
@53217 = ~«Если мы прекратим беспорядки, это поможет городу вернуться во Внешние Земли. Вскоре Керст переполнят чудовища, и как думаешь, долго ты сможешь наслаждаться награбленным?»~
@53218 = ~«Если мы прекратим беспорядки, это поможет городу вернуться во Внешние Земли. Вскоре Керст переполнят чудовища, и как думаешь, долго ты сможешь наслаждаться награбленным?»~
@53219 = ~«То, что ты делаешь, только ухудшает проблему. Вместо грабежа, возьми этих людей и помоги оборонять стены, чтобы город мог вернуться во Внешние Земли».~
@53220 = ~«То, что ты делаешь, только ухудшает проблему. Вместо грабежа, возьми этих людей и помоги оборонять стены, чтобы город мог вернуться во Внешние Земли».~
@53221 = ~«Стоять! Пока я здесь, грабежа не будет».~
@53222 = ~«Мне не до того. Прощай».~
@53223 = ~Стражник приподнимает забрало своего шлема, чтобы плюнуть тебе под ноги: «Ха! Вали с глаз долой, придурок, у нас намечается шикарный куш».~
@53224 = ~«Если мы прекратим беспорядки, это поможет городу вернуться во Внешние Земли. Вскоре Керст переполнят чудовища, и как думаешь, долго ты сможешь наслаждаться награбленным?»~
@53225 = ~«Если мы прекратим беспорядки, это поможет городу вернуться во Внешние Земли. Вскоре Керст переполнят чудовища, и как думаешь, долго ты сможешь наслаждаться награбленным?»~
@53226 = ~«Если мы прекратим беспорядки, это поможет городу вернуться во Внешние Земли. Вскоре Керст переполнят чудовища, и как думаешь, долго ты сможешь наслаждаться награбленным?»~
@53227 = ~«Стоять! Пока я здесь, грабежа не будет».~
@53228 = ~«Тогда прощай».~
@53229 = ~Ты чувствуешь его насмешку даже сквозь забрало. «О, *пока ты здесь*, ага? Ну, тогда… — он заносит своё массивное оружие. — Щас мы это исправим».~
@53230 = ~«Если мы прекратим беспорядки, это поможет городу вернуться во Внешние Земли. Вскоре Керст переполнят чудовища, и как думаешь, долго ты сможешь наслаждаться награбленным?»~
@53231 = ~«Если мы прекратим беспорядки, это поможет городу вернуться во Внешние Земли. Вскоре Керст переполнят чудовища, и как думаешь, долго ты сможешь наслаждаться награбленным?»~
@53232 = ~«Если мы прекратим беспорядки, это поможет городу вернуться во Внешние Земли. Вскоре Керст переполнят чудовища, и как думаешь, долго ты сможешь наслаждаться награбленным?»~
@53233 = ~Защищаться.~
@53234 = ~«Но… а, дьявол, ты прав, — он орёт собравшимся вокруг него мародёрам: — Хорош! Вы его слышали, валим! А если кто вякнет об этом, когда город вернётся… он труп! А теперь пошли! Живей!» Он снова поворачивается к тебе: «А чё до *тебя*, так твой котелок варит явно лучше, чем выглядит. Молодец».~
@53235 = ~«Спасибо. Прощай».~
@53236 = ~Я смог уговорить группу горожан — во главе со стражником, подумать только, — прекратить грабёж и отправиться на защиту города.~
@53237 = ~Ты видишь испуганного жителя Керста. «Спасибо за помощь… Не знаю, что бы я делал… они бы убили меня… — он ещё некоторое время бормочет благодарности, а потом говорит: — Я готов помочь. Этот город не сделал из меня эгоиста. Снова и снова спасибо. До встречи».~
@53238 = ~«Не стоит благодарности. До встречи».~
@53239 = ~*Жалкое хныканье*~
@53240 = ~«ДА-А-А…»~
@53241 = ~«Теперь говори, жалкое создание: где-е-е?»~
@53242 = ~«МЫ УБЬЁМ И ТЕБЯ!»~
@53243 = ~«КТО ТЫ?»~
@53244 = ~«КАК ЖИВОТНОМУ!»~
@53245 = ~«ПУСТИМ КРОВЬ!»~
@53246 = ~«ДА, ДОЛЖНЫ УБИТЬ ТЕБЯ!»~
@53247 = ~«ДУМАЮ, ТЕПЕРЬ МЫ ДОЛЖНЫ УБИТЬ ТЕБЯ…»~
@53248 = ~«ДЕЛАЙ, ЧТО МЫ ГОВОРИМ, ИЛИ УБЬЁМ!»~
@53249 = ~«ОТВЕРНИСЬ И МОЛЧИ!»~
@53250 = ~«МОЛЧИ, ИЛИ УБЬЁМ!»~
@53251 = ~«Я СКАЗАЛ, МОЛЧИ!»~
@53252 = ~«МОЛЧАТЬ!»~
@53253 = ~«СТОЙ СПОКОЙНО!»~
@53254 = ~Убрать кожу…~
@53255 = ~Ты прокалываешь кончик своего указательного пальца и, прежде чем ранка успевает затянуться, выдавливаешь несколько капель крови. Пока ты готовишься записать сожаление, серия образов проносится в твоей голове…~
@53256 = ~Сожаление: «Я сожалею о том, что случилось с моими товарищами…»~
@53257 = ~Сожаление: «Я сожалею о своих действиях…»~
@53258 = ~Сожаление: «Я сожалею о своём прошлом…»~
@53259 = ~Сожаление: «Я сожалею о событиях, приведших к этому…»~
@53260 = ~Убрать кожу…~
@53261 = ~Ты шепчешь слова про себя, но сожаление эхом отдаётся в твоей голове: «Я сожалею, что…»~
@53262 = ~«…всем моим товарищам пришлось страдать, чтобы я смог попасть сюда».~
@53263 = ~«…пытался продать Морте Вришике».~
@53264 = ~«…пытался продать Анну Вришике».~
@53265 = ~«…пытался продать Дак'кона Вришике».~
@53266 = ~«…пытался продать Падшую Грейс Вришике».~
@53267 = ~«…пытался продать Нордома Вришика».~
@53268 = ~«…не продал Морте Вришике».~
@53269 = ~«…не продал Анну Вришике».~
@53270 = ~«…не продал Дак'кона Вришике».~
@53271 = ~«…не продал Нордома Вришике».~
@53272 = ~«…продал Морте Вришике».~
@53273 = ~«…продал Анну Вришике».~
@53274 = ~«…продал Дак'кона Вришике».~
@53275 = ~«…продал Нордома Вришике».~
@53276 = ~«…всё это время держал Дак'кона в рабстве».~
@53277 = ~«…научил Игнуса использовать силу для нанесения вреда другим».~
@53278 = ~«…предал Морте, оставив его в Колонне Черепов».~
@53279 = ~«…Дак'кон погиб».~
@53280 = ~«…Анна погибла».~
@53281 = ~«…Морте погиб».~
@53282 = ~«…Падшая Грейс погибла».~
@53283 = ~«…Игнус погиб».~
@53284 = ~«…Нордом погиб».~
@53285 = ~*Бурчит*~
@53286 = ~«…Вейлор погиб».~
@53287 = ~Подумать, о чём ещё можно пожалеть…~
@53288 = ~Убрать кожу…~
@53289 = ~Ты шепчешь слова про себя, но сожаление эхом отдаётся в твоей голове: «Я сожалею, что…»~
@53290 = ~«…не убил больше народу».~
@53291 = ~«…не освободил Коаксметала из осадной башни».~
@53292 = ~«…освободил Коаксметала из осадной башни».~
@53293 = ~~
@53294 = ~~
@53295 = ~«…пришлось убить Рейвел».~
@53296 = ~ВОЗМОЖНОСТИ ПРЕДМЕТА~
@53297 = ~«…мотался по всем планам, в то время как этот долбаный портал был здесь, когда я очнулся В ПЕРВЫЙ РАЗ».~
@53298 = ~Подумать, о чём ещё можно пожалеть…~
@53299 = ~Убрать кожу…~
@53300 = ~Ты шепчешь слова про себя, но сожаление эхом отдаётся в твоей голове: «Я сожалею…»~
@53301 = ~«…что вообще просил о бессмертии».~
@53302 = ~«…что убил Фина Андли. Если бы я не стал бессмертным, моя параноидальная инкарнация его бы не убила…»~
@53303 = ~«…о том вреде, который мои предыдущие инкарнации причинили себе и окружающим».~
@53304 = ~«…о смертях, причиной которых я стал здесь и во в всей мультивселенной».~
@53305 = ~«…что лгал Дейонарре, чтобы заставить её присоединиться ко мне в странствиях».~
@53306 = ~«…об убийстве Дейонарры в Крепости Сожалений».~
@53307 = ~«…о страданиях, в которые я вверг Янниса, доведя его дочь до смерти».~
@53308 = ~Подумать, о чём ещё можно пожалеть…~
@53309 = ~Убрать кожу…~
@53310 = ~Ты шепчешь слова про себя, но сожаление эхом отдаётся в твоей голове: «Я сожалею, что…»~
@53311 = ~«…мне *так долго* пришлось искать свою смертность».~
@53312 = ~«…мне пришлось забрать много жизней, чтобы попасть сюда».~
@53313 = ~«…здесь нет никого, кто разделил бы со мной этот момент».~
@53314 = ~«…у меня нет сожалений, которые можно записать на этом куске кожи».~
@53315 = ~Подумать, о чём ещё можно пожалеть…~
@53316 = ~Убрать кожу…~
@53317 = ~Ты корябаешь свои сожаления на куске собственной кожи… но палец заживает слишком быстро, и тебе приходится снова вскрывать ранку и выдавливать новые капли крови. Спустя пару минут ты заканчиваешь, кровь поблескивает на куске кожи… комбинация из твоей плоти, твоей крови и твоего сожаления.~
@53318 = ~«Думаю, это должно сработать…»~
@53319 = ~«Думаю, это должно сработать…»~
@53320 = ~Через пару минут раздумий ранка на пальце полностью затягивается, тебе приходится снова вскрыть её и выдавить ещё немного крови. Когда ты собираешься записать сожаление, серия образов проносится в твоей голове…~
@53321 = ~Сожаление: «Я сожалею о том, что случилось с моими товарищами…»~
@53322 = ~Сожаление: «Я сожалею о своих действиях…»~
@53323 = ~Сожаление: «Я сожалею о своём прошлом…»~
@53324 = ~Сожаление: «Я сожалею о событиях, приведших к этому…»~
@53325 = ~Убрать кожу…~
@53326 = ~Привлечь внимание Колонны.~
@53327 = ~Отойти от Колонны, пока тебя не заметили.~
@53328 = ~Ты делаешь ещё один осторожный шаг к колонне, и все слышимые разговоры резко *смолкают*. Десятки голов, покрывающих поверхность колонны, медленно и в унисон поворачиваются в твою сторону. Они молча внимают тебе, их зловонное дыхание клубится вокруг тебя.~
@53329 = ~«У меня вопросы, Колонна…»~
@53330 = ~«У меня вопросы, Колонна…»~
@53331 = ~«У меня вопросы, Колонна…»~
@53332 = ~«У меня вопросы, Колонна…»~
@53333 = ~«У меня вопросы, Колонна…»~
@53334 = ~«Я просто проходил мимо. Прощай».~
@53335 = ~Головы на поверхности колонны одновременно говорят, их голоса сливаются в общий голос создания — ужасающую булькающую трескотню, попутно несущую едкие испарения и мерзостную вонь гниения из их ртов: «ЭТОТ ЗАПАХ, ТАКОЙ СИЛЬНЫЙ. СКОРО ОН ПЕРЕСЕЧЁТ ПЛАНЫ, И ПРИДЁТ БЕЛ».~
@53336 = ~«Запах?.. Что ты имеешь в виду?»~
@53337 = ~«Запах?.. Что ты имеешь в виду?»~
@53338 = ~Глаза всех голов с влажным хлюпаньем поворачиваются в глазницах и пялятся на Падшую Грейс: «ЗАПАХ… ЕЁ МУСКУС… *МУСКУС* ТАНАР'РИ. *РАЗНЕСЁТ* СЛАДКО-ГОРЬКИЙ АРОМАТ И ПРИВЛЕЧЁТ БААТЕЗУ, СКОРО. БЕЛ, ИХ ГОСПОДИН, БУДЕТ ОЧЕНЬ ЗОЛ».~
@53339 = ~«Ясно…»~
@53340 = ~«Ясно…»~
@53341 = ~Глаза всех голов с влажным хлюпаньем поворачиваются в глазницах и пялятся на Анну: «ЗАПАХ… ЕЁ МУСКУС… *МУСКУС* ОТРОДЬЯ ТАНАР'РИ. *РАЗНЕСЁТ* СЛАДКО-ГОРЬКИЙ АРОМАТ И ПРИВЛЕЧЁТ БААТЕЗУ, СКОРО. БЕЛ, ИХ ГОСПОДИН, БУДЕТ ОЧЕНЬ ЗОЛ».~
@53342 = ~«Ясно…»~
@53343 = ~«Ясно…»~
@53344 = ~Некоторые головы продолжают шумно принюхиваться, но большинство снова обращают взгляд на тебя: «ЕСЛИ ЕСТЬ У ТЕБЯ *ВОПРОСЫ*, ТЕБЕ ЛУЧШЕ *ПОСПЕШИТЬ*». Несколько голов косятся на тебя и издают булькающие звуки, кажется, они смеются над тобой.~
@53345 = ~«Как я уже сказал, у меня…»~
@53346 = ~«Как я уже сказал, у меня есть вопросы…»~
@53347 = ~Прежде чем ты успеваешь закончить, часть колонны содрогается и на поверхности проступает новая голова. После того, как часть зловонной слизи сползает вниз, ты узнаёшь Фарода. Он сплёвывает ртом, полным кровавых кист и хрипит: «Анна, дорогое моё дитя! Ты ли это?»~
@53348 = ~Пока Фарод говорит, большинство остальных голов помалкивают… только некоторые из них что-то бормочут под нос и бросают косые взгляды на Анну и голову её приёмного отца. «Я был неправ насчёт сферы, дорогая моя девочка. Её было недостаточно, и вот видишь, как всё закончилось… Умоляю, любимая Анна! Спаси своего бедного отца! Спаси меня! Ну пожалуйста, спаси! Спаси ме…» — не прекращая говорить, голова Фарода начинает погружаться внутрь колонны…~
@53349 = ~~
@53350 = ~~
@53351 = ~~
@53352 = ~«ХВАТИТ, — вопят вонючие головы колонны. — МЫ УСТАЛИ ОТ ТВОЕГО БЕССОДЕРЖАТЕЛЬНОГО ЛЕПЕТА И ХОТИМ ЗНАТЬ О ТВОЁМ ДЕЛЕ К НАМ».~
@53353 = ~«Вопросы. У меня вопросы…»~
@53354 = ~«Неважно. Прощай».~
@53355 = ~Ты делаешь ещё один осторожный шаг к колонне, и все слышимые разговоры резко *смолкают*. Десятки голов, покрывающих поверхность колонны, медленно и в унисон поворачиваются в твою сторону. Они молча внимают тебе, их зловонное дыхание клубится вокруг тебя… пока они не замечают прячущегося за твоей спиной Морте.~
@53356 = ~Головы на поверхности колонны одновременно говорят, их голоса сливаются в общий голос создания — ужасающую булькающую трескотню, попутно несущую едкие испарения и мерзостную вонь гниения из их ртов: «ОПЯТЬ *ТЫ*… ЭТО И ВПРАВДУ БЫЛО ДАВНО». Многие головы начинают тараторить и истекать слюной, скандируя: «…череп, череп, череп…» Они радостно облизывают губы, их глаза не отрываются от Морте.~
@53357 = ~«Что ты имеешь в виду?»~
@53358 = ~«ТИХО! МЫ ГОВОРИМ НЕ С ТОБОЙ, А С ЧЕРЕПОМ. С ВОЗВРАЩЕНИЕМ, МАЛЫШ. ТЫ НАКОНЕЦ РЕШИЛ ВЕРНУТЬСЯ В СВОЮ ОБИТЕЛЬ, ПРИНЯТЬ СВОЮ ОКОНЧАТЕЛЬНУЮ СУДЬБУ, ЧТОБЫ СНОВА ИСПОЛНЯТЬ СВОЙ СВЯЩЕННЫЙ ДОЛГ?» Несколько голов вырываются вперёд из центра Колонны, скрежеща сломанными зубами и завывая: «Да, вернись! Вернись к нам, череп! Череп…»~
@53359 = ~Головы медленно смещаются по поверхности колонны, кивая и бурча перед тем, как снова заговаривают общим жутким голосом: «ЗАДАВАЙ НАМ СВОИ ВОПРОСЫ И БУДЬ ГОТОВ ВЫСЛУШАТЬ НАШИ ТРЕБОВАНИЯ: ЗА ПОЛУЧЕННЫЕ ОТВЕТЫ ТЫ ОКАЖЕШЬ НАМ УСЛУГУ».~
@53360 = ~«Что ты такое?»~
@53361 = ~«Как мне добраться до Крепости Сожалений?»~
@53362 = ~«Кто я?»~
@53363 = ~«Кто мой убийца?»~
@53364 = ~«Как мне покинуть это место?»~
@53365 = ~«Неважно. Прощай».~
@53366 = ~«Неважно. Прощай».~
@53367 = ~Головы булькают и хрипят гниющими губами: «МЫ ОТВЕТИМ НА ЭТОТ ВОПРОС ЗА УСЛУГУ…»~
@53368 = ~«Хорошо, твои требования, Колонна?»~
@53369 = ~«Хорошо, твои требования, Колонна?»~
@53370 = ~«Хорошо, твои требования, Колонна?»~
@53371 = ~«Хорошо, твои требования, Колонна?»~
@53372 = ~«Хорошо, твои требования, Колонна?»~
@53373 = ~«Хорошо, твои требования, Колонна?»~
@53374 = ~«Хорошо, твои требования, Колонна?»~
@53375 = ~«Хорошо, твои требования, Колонна?»~
@53376 = ~«Неважно. Прощай».~
@53377 = ~«Неважно. Прощай».~
@53378 = ~Головы в один голос прерывают: «МОЛЧАТЬ! ТЫ УНИЖАЕШЬ НАШЕ БЛАГОРОДНОЕ ПОЛОЖЕНИЕ ТАКИМ НЕБРЕЖНЫМ ТОНОМ!» А одна особо отвратительная голова вопит: «И называть *всех* нас лжецами — это…» После чего скрывается в недрах колонны.~
@53379 = ~«Я хочу спросить о другом…»~
@53380 = ~«Тогда я ухожу. Прощай».~
@53381 = ~«Тогда я ухожу. Прощай».~
@53382 = ~Головы булькают и хрипят гниющими губами: «МЫ ОТВЕТИМ НА ЭТОТ ВОПРОС ЗА УСЛУГУ…»~
@53383 = ~«Каковы твои требования, Колонна?»~
@53384 = ~«Каковы твои требования, Колонна?»~
@53385 = ~«Каковы твои требования, Колонна?»~
@53386 = ~«Каковы твои требования, Колонна?»~
@53387 = ~«Каковы твои требования, Колонна?»~
@53388 = ~«Каковы твои требования, Колонна?»~
@53389 = ~«Неважно. Прощай».~
@53390 = ~«Неважно. Прощай».~
@53391 = ~Головы колонны как одна обращают жадный взгляд к Морте: «ЧЕРЕП… В ОПЛАТУ МЫ ТРЕБУЕМ ЧЕРЕП. ВЕРНИ ЕГО НАМ, И ТЫ ПОЛУЧИШЬ СВОЙ ОТВЕТ».~
@53392 = ~«БРОСАЙ СВОИ НИЧТОЖНЫЕ ПРОТЕСТЫ, ЧЕРЕП! НЕ ТЕБЕ ВЫБИРАТЬ! — все головы колонны медленно поворачиваются лицом к тебе, их глаза прищурены. — ОН СЛИШКОМ ДОЛГО БЕГАЛ ОТ СВОЕЙ СУДЬБЫ, ОН *НАШ*. ВЕРНИ ЕГО НАМ, И МЫ БУДЕМ ОЧЕНЬ ХОРОШО РАСПОЛОЖЕНЫ К ТЕБЕ ЗА ТАКОЙ ПОДАРОК… МЫ ХОТИМ НАСЛАДИТЬСЯ ЕГО ВОПЛЯМИ…»~
@53393 = ~«Хорошо… можешь забрать его, Колонна».~
@53394 = ~«Хорошо… можешь забрать его, Колонна».~
@53395 = ~«Подарок? Какие *ещё* подарки ты примешь?»~
@53396 = ~«Подарок? Какие *ещё* подарки ты примешь?»~
@53397 = ~«Подарок? Какие *ещё* подарки ты примешь?»~
@53398 = ~«Подарок? Какие *ещё* подарки ты примешь?»~
@53399 = ~«Подарок? Какие *ещё* подарки ты примешь?»~
@53400 = ~«Неважно. Прощай».~
@53401 = ~«Неважно. Прощай».~
@53402 = ~«ДА-А-А…» — колонна начинает кипеть и пузыриться, головы выскакивают на поверхность, воют и бормочут, а затем поглощаются. Одна тараторит и вопит: «Не могу дождаться его воплей!» Другая: «К дьяволу вопли! *Страдания* — это лучше для столь раздражающего типа, как он! Я выгрызу его зубы, выплюну их в его мозг и как следует перемешаю!» И ещё одна: «О! О! Я выем его глаза!»~
@53403 = ~Колонна оборачивается к тебе, глаза голов прищурены: «У ТЕБЯ ЕСТЬ *ЗНАНИЕ*, КОТОРЫМ МЫ ЖЕЛАЕМ ОБЛАДАТЬ. ГДЕ НАХОДИТСЯ ИЗВЕРГ, ФЬЮЛЛ ДВУЛИЧНЫЙ? СКАЖИ НАМ, И МЫ ОТВЕТИМ НА ТВОЙ ВОПРОС». Зловоние горячего дыхания колонны окутывает тебя, пока она ждёт ответа…~
@53404 = ~«Во Внешних Землях, где Уль-Горис, отец всех гористро, был убит во время Кратерной Войны. Фьюлл живёт в его скелете».~
@53405 = ~«Во Внешних Землях, где Уль-Горис, отец всех гористро, был убит во время Кратерной Войны. Фьюлл живёт в его скелете».~
@53406 = ~Ложь: «Он… спрятался где-то во Внешних Землях. Под большой горой».~
@53407 = ~Ложь: «Фьюлл хорошо спрятался на псевдо-плане, созданном одним давно умершим магом. Он лишь изредка появляется в Сигиле, и именно там я встретил его».~
@53408 = ~«Не скажу. Какие *ещё* подарки ты примешь?»~
@53409 = ~«Не скажу. Какие *ещё* подарки ты примешь?»~
@53410 = ~«Не скажу. Какие *ещё* подарки ты примешь?»~
@53411 = ~«Не скажу. Какие *ещё* подарки ты примешь?»~
@53412 = ~«Неважно. Прощай».~
@53413 = ~«Неважно. Прощай».~
@53414 = ~Головы колонны какое-то время молчат, уворачиваясь от струй зловонного пара, исторгаемого щелями на её омерзительной поверхности. Наконец они отвечают: «В ТВОЁМ РАСПОРЯЖЕНИИ ЕСТЬ ПРЕДМЕТ, КОТОРЫМ МЫ ЖЕЛАЕМ ОБЛАДАТЬ. ЭТО КУБ МОДРОНОВ. ОТДАЙ ЕГО НАМ, И МЫ ОТВЕТИМ НА ТВОИ ВОПРОСЫ».~
@53415 = ~«Вот… держи».~
@53416 = ~«Я не могу его отдать. Какие *ещё* подарки ты примешь?»~
@53417 = ~«Я не могу его отдать. Какие *ещё* подарки ты примешь?»~
@53418 = ~«Я не могу его отдать. Какие *ещё* подарки ты примешь?»~
@53419 = ~«Неважно. Прощай».~
@53420 = ~«Неважно. Прощай».~
@53421 = ~Головы колонны фыркают, их глаза стреляют по сторонам. Внезапно все они останавливаются на Падшей Грейс: «ОНА ПОДОЙДЁТ… ДА. ТАНАР'РИ. ОТДАЙ ЕЁ НАМ… МЫ ПОГЛОТИМ ЕЁ ЖИВЬЁМ, ИСКУПАЕМСЯ В ЕЁ СЛАДКОЙ КРОВИ… ТОГДА МЫ ОТВЕТИМ НА ТВОЙ ВОПРОС». Часть голов начинает стонать от вожделения, обращаясь к Грейс: «Да, танар'ри, сладкий суккуб, грешница, отдайся нам…»~
@53422 = ~«Хорошо. Можешь забирать её».~
@53423 = ~«На такое я не пойду. Какие *ещё* подарки ты примешь?»~
@53424 = ~«На такое я не пойду. Какие *ещё* подарки ты примешь?»~
@53425 = ~«Неважно. Прощай».~
@53426 = ~«Неважно. Прощай».~
@53427 = ~Тяжёлый грохот исходит от колонны; всё больше голов всплывают на её растревоженную поверхность, впиваясь в тебя кроваво-красными глазами. Наконец их взгляды падают на Анну: «ОТРОДЬЕ ИЗВЕРГА! ОТДАЙ НАМ ДЕВЧОНКУ-ТИФЛИНГА, ДА… МЫ РАЗОРВЁМ ЕЁ НА ЧАСТИ ВНУТРИ КОЛОННЫ, НАСЛАДИМСЯ ЕЁ СЛАДОСТЬЮ, ОГНЕННОЙ КРОВЬЮ… ТОГДА МЫ ОТВЕТИМ НА ТВОИ ВОПРОСЫ».~
@53428 = ~«Хорошо. Можешь забирать её».~
@53429 = ~«На такое я не пойду. Какие *ещё* подарки ты примешь?»~
@53430 = ~«Неважно. Прощай».~
@53431 = ~«Неважно. Прощай».~
@53432 = ~Рты всех голов на колонне искривляются в нездоровой, порочной ухмылке; они фыркают и давятся, смеясь над тобой: «У ТЕБЯ НЕТ *НИЧЕГО* ДЛЯ НАС… КРОМЕ САМОГО СЕБЯ. ИДИ СЮДА, БЕССМЕРТНЫЙ… ДАЙ НАМ ПОПРОБОВАТЬ ВКУС ТВОЕЙ НЕУМИРАЮЩЕЙ КРОВИ. ТОГДА МЫ ОТВЕТИМ НА ТВОЙ ВОПРОС». Головы клацают в унисон зубами, облизывают в предвкушении рассохшиеся губы…~
@53433 = ~«Хорошо. Я согласен на твои требования, Колонна».~
@53434 = ~«Неважно. Прощай».~
@53435 = ~«Неважно. Прощай».~
@53436 = ~Колонна Черепов разрастается в стороны, каждая её голова усмехается над тобой. Они плюются в тебя словами: «НЕ ПЫТАЙСЯ ЛГАТЬ НАМ, ТУПИЦА. ГДЕ *ФЬЮЛЛ*? СКАЖИ НАМ, МЫ ПРОСТИМ ТВОЙ ОБМАН И ОТВЕТИМ НА ТВОЙ ВОПРОС».~
@53437 = ~«Во Внешних Землях, где Уль-Горис, отец всех гористро, был убит во время Кратерной Войны. Фьюлл живёт в его скелете».~
@53438 = ~«Во Внешних Землях, где Уль-Горис, отец всех гористро, был убит во время Кратерной Войны. Фьюлл живёт в его скелете».~
@53439 = ~«Не скажу. Какие *ещё* подарки ты примешь?»~
@53440 = ~«Не скажу. Какие *ещё* подарки ты примешь?»~
@53441 = ~«Не скажу. Какие *ещё* подарки ты примешь?»~
@53442 = ~«Не скажу. Какие *ещё* подарки ты примешь?»~
@53443 = ~«Неважно. Прощай».~
@53444 = ~«Неважно. Прощай».~
@53445 = ~Ты бросаешь куб Колонне Черепов, и огромная зловонная пасть открывается перед тобой, чтобы принять его. Мгновение спустя пасть захлопывается и куб исчезает, тебе почему-то кажется, что навсегда. Головы счастливо урчат, медленно перемещаясь по поверхности колонны.~
@53446 = ~«ТОГДА ПОДОЙДИ… ДА, БЛИЖЕ…» — с твоим приближением головы словно втягиваются вглубь колонны…~
@53447 = ~Подойти ближе.~
@53448 = ~«Вообще-то я передумал. До встречи».~
@53449 = ~«Вообще-то я передумал. До встречи».~
@53450 = ~Ты делаешь к колонне всего один шаг, но внезапно обнаруживаешь, что придвинулся к её шевелящейся поверхности намного ближе, нежели казалось. Прежде чем ты успеваешь среагировать, она наваливается на тебя тебе волной переломанных костей и гнилого, изъеденного червями мяса. Омерзительная тьма поглощает тебя, а головы начинают пожирать тебя живьём…~
@53451 = ~Погрузиться во тьму…~
@53452 = ~Ты обнаруживаешь себя стоящим перед Колонной Черепов, страдающим от боли и не уверенным в том, что, собственно, произошло. Единственное, в чём ты уверен, — это что твоё тело каким-то образом *ослабело* от только что перенесённого тяжкого испытания. Безобразные головы смотрят на тебя, ухмыляясь и облизывая губы…~
@53453 = ~Колонна какое-то время смакует твой подарок, головы облизываются и перешёптываются.~
@53454 = ~«И каков ответ?..»~
@53455 = ~«И каков ответ?..»~
@53456 = ~«И каков ответ?..»~
@53457 = ~«И каков ответ?..»~
@53458 = ~Колонна Черепов сказала, что она состоит из голов тех, чья ложь привела к смерти других. Она может ответить на множество вопросов, но в обмен требует немалой платы.~
@53459 = ~Колонна Черепов сказала, что ключом к порталу, ведущему в Крепость Сожалений, является «сожаление». Вполне уместно. Но она, однако, не знает пути к самому порталу.~
@53460 = ~«МЫ ТЕ, КТО В СВОЕЙ ДАВНО ЗАБЫТОЙ СМЕРТНОЙ ЖИЗНИ ДАЛИ СОВЕТ, ПРИВЕДШИЙ ДРУГИХ К СМЕРТИ. НЕКОТОРЫЕ ЗОВУТ НАС „ЛЖЕЦАМИ“, НО ЧТО ЕСТЬ „ПРАВДА“, КАК НЕ ДРУГОЕ ИМЯ ЛЖИ? ПРАВДА СТОЛЬ ЧАСТО ПРИКРЫВАЕТ ОБМАН… — головы бормочут и кивают друг другу в знак согласия, потом снова оборачиваются к тебе. — МЫ ЗНАЕМ МНОГО… НО И МНОГО ПОТРЕБУЕМ У ТЕХ, КТО НАС СПРОСИТ».~
@53461 = ~«Я хочу спросить о другом…»~
@53462 = ~«Это всё, что я хотел узнать. Прощай».~
@53463 = ~«Это всё, что я хотел узнать. Прощай».~
@53464 = ~«УЖЕ ВЛАДЕЕШЬ ТЫ КЛЮЧОМ, И НУЖНО ЛИШЬ МЕСТО РАСПОЛОЖЕНИЯ ПОРТАЛА, ВЕДУЩЕГО ТУДА. МЫ НЕ ЗНАЕМ, ГДЕ РАСПОЛОЖЕН ПОРТАЛ, НО МОЖЕМ СКАЗАТЬ ТЕБЕ ЕГО КЛЮЧ: „СОЖАЛЕНИЕ“». Множество голов колонны начинает выть и стонать: «Да, сожаление! Сожаление!»~
@53465 = ~«Сожаление?»~
@53466 = ~~
@53467 = ~~
@53468 = ~~
@53469 = ~«ДА… ТЫ ДОЛЖЕН ПОЧУВСТВОВАТЬ СОЖАЛЕНИЕ, ЧТОБЫ ПРОРВАТЬСЯ В КРЕПОСТЬ. ЗАПИШИ ЕГО НА КУСКЕ СВОЕЙ ПЛОТИ, И ПУТЬ ЧЕРЕЗ ПОРТАЛ ДЛЯ ТЕБЯ ОТКРОЕТСЯ».~
@53470 = ~«А портал… говоришь, ты *не знаешь*, где он?»~
@53471 = ~~
@53472 = ~~
@53473 = ~«ДА… ТОЛЬКО ТРОЕ ЗНАЮТ ПУТЬ. ПЕРВЫМ БЫЛ ТЫ… ХОТЯ ТЕПЕРЬ ТЫ ЗАБЫЛ. ВТОРОЙ НАХОДИТСЯ ЗА ПОРТАЛОМ И НЕ ВЫЙДЕТ ОТТУДА. ТРЕТИЙ…»~
@53474 = ~«Третий?..»~
@53475 = ~~
@53476 = ~~
@53477 = ~~
@53478 = ~«…С ТРЕТЬИМ ТЫ УЖЕ ВСТРЕЧАЛСЯ. ОН ЗНАЕТ О ТВОИХ ОБСТОЯТЕЛЬСТВАХ, КРЕПОСТИ И ТВОЕЙ ПОТРЕБНОСТИ ПОПАСТЬ ТУДА… НО НЕ ПОМОЖЕТ ТЕБЕ. ЕГО ЩИТ ВЫКОВАН ИЗ ХОЛОДНОГО МЕТАЛЛА ЛЖИ И ОБМАНА, ПРОСТЫМИ СЛОВАМИ ЕГО НЕ ПРОБИТЬ. ТЕБЕ ПРИДЁТСЯ СРАЖАТЬСЯ С НИМ».~
@53479 = ~«Кто это?»~
@53480 = ~~
@53481 = ~~
@53482 = ~~
@53483 = ~Некоторое время головы молчат, одаряя тебя злобными самодовольными ухмылками. Наконец они произносят: «ТЫ *ВСТРЕЧАЛ* ЛЖЕЦА — И НЕ ВПЕРВЫЕ. ЛЖЕЦ ЗНАЛ… НО НЕ СКАЗАЛ ТЕБЕ. *МЕЛКОЕ* ПРЕДАТЕЛЬСТВО МЕЖДУ ДВУМЯ БЕССМЕРТНЫМИ…» Некоторые гниющие головы закатывают глаза и хихикают над тобой.~
@53484 = ~«Фьюлл Двуличный?»~
@53485 = ~«Лотар?»~
@53486 = ~«Рейвел?»~
@53487 = ~«Триас?»~
@53488 = ~~
@53489 = ~~
@53490 = ~~
@53491 = ~Колонна Черепов сказала, что Триас, которого она называет «Триас Предатель», должен знать, где находится портал в Крепость Сожалений.~
@53492 = ~Головы сдавленно смеются в отвратительном веселье: «РАЗУМЕЕТСЯ, НЕТ. УГАДЫВАЙ СНОВА…»~
@53493 = ~«Фьюлл Двуличный?»~
@53494 = ~«Лотар?»~
@53495 = ~«Рейвел?»~
@53496 = ~«Триас?»~
@53497 = ~~
@53498 = ~~
@53499 = ~~
@53500 = ~Колонна Черепов сказала, что Триас, которого она называет «Триас Предатель», должен знать, где находится портал в Крепость Сожалений.~
@53501 = ~«О, ДА… ОДНАКО МЫ ЗНАЕМ ЕГО ПОД *ПОЛНЫМ* ИМЕНЕМ: ТРИАС ПРЕДАТЕЛЬ!» — колонна радостно трясётся, куча гниющих голов шатается туда-сюда, словно издеваясь над твоим затруднительным положением. Некоторые головы насмешливо напевают: «Предатель… Предатель… Триас Предатель…»~
@53502 = ~«Но… он сказал, что не знает…»~
@53503 = ~«Зачем ему лгать мне?»~
@53504 = ~«Откуда он мог это узнать?»~
@53505 = ~«Я хочу спросить о другом…»~
@53506 = ~«Это всё, что я хотел узнать. Прощай».~
@53507 = ~«Это всё, что я хотел узнать. Прощай».~
@53508 = ~«ОН *СОЛГАЛ* ТЕБЕ, — некоторые головы косят глаза, булькают и давятся, потешаясь над тобой. — ОСТЕРЕГАЙСЯ СЛОВ, ПРОПИТАННЫХ МЁДОМ: ОНИ ПРИВЛЕКАЮТ ВСЕВОЗМОЖНЫХ ОС».~
@53509 = ~«Зачем ему лгать мне?»~
@53510 = ~«Откуда он мог это узнать?»~
@53511 = ~«Я хочу спросить о другом…»~
@53512 = ~«Это всё, что я хотел узнать. Прощай».~
@53513 = ~«Это всё, что я хотел узнать. Прощай».~
@53514 = ~«НЕ НАМ ОТВЕЧАТЬ НА ЭТОТ ВОПРОС. ТЫ ДОЛЖЕН НАЙТИ ЕГО И СПРОСИТЬ САМ».~
@53515 = ~«Откуда он мог это узнать?»~
@53516 = ~«Я хочу спросить о другом…»~
@53517 = ~«Это всё, что я хотел узнать. Прощай».~
@53518 = ~«Это всё, что я хотел узнать. Прощай».~
@53519 = ~«ТРИАС РАЗГОВАРИВАЛ С ТОБОЙ ОДНАЖДЫ, ДАВНЫМ-ДАВНО, КОГДА ТЫ ЕЩЁ ЗНАЛ ПУТЬ. ТЫ ГОВОРИЛ ОТ ЧИСТОГО СЕРДЦА, А ТРИАС — КАК И ВСЕ ВЕЛИКИЕ ПРЕДАТЕЛИ — СЛУШАЛ В ОБА УХА, ЗАВОЁВЫВАЯ ТВОЁ ДОВЕРИЕ. РАЗГОВОР БЫЛ КОРОТКИМ, НО НАПОЛНЕННЫМ *СМЫСЛОМ*. СМЫСЛ И СМЕРТЬ — ВОТ ЧЕГО ТЫ ИЩЕШЬ… ДЛЯ НОРМАЛЬНОГО ЧЕЛОВЕКА ЭТИ ВЕЩИ РАЗЛИЧАЮТСЯ. НО ДЛЯ ТЕБЯ… ОДНО И ТО ЖЕ».~
@53520 = ~«Зачем ему лгать мне?»~
@53521 = ~«Я хочу спросить о другом…»~
@53522 = ~«Это всё, что я хотел узнать. Прощай».~
@53523 = ~«Это всё, что я хотел узнать. Прощай».~
@53524 = ~«НЕ *КТО*, А ЧТО. ТЫ БЫЛ РАЗДЕЛЁН. ТЫ — ОДИН ИЗ МНОГИХ И ОДИН ВО МНОГИХ. КАЖДЫЙ ИЗ КОТОРЫХ — НЕВАЖНО, ХОРОШИЙ ИЛИ ПЛОХОЙ — ЧУДОВИЩЕ, ОТБРАСЫВАЮЩЕЕ ТЕНЬ НА СУЩЕСТВОВАНИЕ».~
@53525 = ~«Тень… на существование?»~
@53526 = ~«Тень… на существование?»~
@53527 = ~Колонна Черепов сказала, что я «отбрасываю тени на существование» — каждый раз, когда я умираю, вместо меня умирает другой. Те, кто умирают таким образом, становятся созданиями тени, видимо, они собираются и поджидают меня в Крепости Сожалений.~
@53528 = ~«О, ДА, — головы колонны гротескно ухмыляются и прищуриваются. — КАЖДЫЙ РАЗ, КОГДА ТЫ УМИРАЕШЬ, „БЕССМЕРТНЫЙ“, ТЫ ОТБРАСЫВАЕШЬ ТЕНЬ… ПРИ КАЖДОЙ ТВОЕЙ СМЕРТИ *ДРУГОЙ* УМИРАЕТ ВМЕСТО ТЕБЯ. ЭТИ ТЕНИ… ОНИ СОБИРАЮТСЯ ВНУТРИ КРЕПОСТИ СОЖАЛЕНИЙ, ПОДЖИДАЯ ТЕБЯ. СКОЛЬКО РАЗ ТЫ УМИРАЛ, БЕЗЫМЯННЫЙ? СКОЛЬКО СОТЕН… ТЫСЯЧ… УМЕРЛО ИЗ-ЗА *ТЕБЯ*?» Колонна содрогается в омерзительном веселье; её головы поворачиваются к тебе и с насмешкой гукают. Внезапно волосы у тебя на шее встают дыбом… ты оборачиваешься, чтобы увидеть Вейлора, взирающего на тебя; его глаза горят ярче, чем ты когда-либо видел…~
@53529 = ~«Вейлор?..»~
@53530 = ~«О, ДА, — головы колонны гротескно ухмыляются и прищуриваются. — КАЖДЫЙ РАЗ, КОГДА ТЫ УМИРАЕШЬ, „БЕССМЕРТНЫЙ“, ТЫ ОТБРАСЫВАЕШЬ ТЕНЬ… ПРИ КАЖДОЙ ТВОЕЙ СМЕРТИ *ДРУГОЙ* УМИРАЕТ ВМЕСТО ТЕБЯ. ЭТИ ТЕНИ… ОНИ СОБИРАЮТСЯ ВНУТРИ КРЕПОСТИ СОЖАЛЕНИЙ, ПОДЖИДАЯ ТЕБЯ. СКОЛЬКО РАЗ ТЫ УМИРАЛ, БЕЗЫМЯННЫЙ? СКОЛЬКО СОТЕН… ТЫСЯЧ… УМЕРЛО ИЗ-ЗА *ТЕБЯ*?» Колонна содрогается в омерзительном веселье; её головы поворачиваются к тебе и с насмешкой гукают.~
@53531 = ~«Это всё, что ты можешь сказать, Колонна?»~
@53532 = ~«Я хочу спросить о другом…»~
@53533 = ~«Это всё, что я хотел узнать. Прощай».~
@53534 = ~«Это всё, что я хотел узнать. Прощай».~
@53535 = ~Головы внезапно обрывают свой смех: «НЕТ. ТЫ НОСИЛ МНОГО ИМЁН; КАЖДОЕ ОСТАВИЛО ШРАМ НА ТВОЕЙ ПЛОТИ:»~
@53536 = ~«Продолжай…»~
@53537 = ~«Погоди… у меня другой вопрос…»~
@53538 = ~«Неважно. Прощай».~
@53539 = ~«Неважно. Прощай».~
@53540 = ~«ПОТЕРЯВШИЙСЯ… БЕССМЕРТНЫЙ… КОНЕЦ ИНКАРНАЦИЙ… ЧЕЛОВЕК ТЫСЯЧИ СМЕРТЕЙ… ПРИГОВОРЁННЫЙ К ЖИЗНИ… НЕУПОКОЕННЫЙ… ОДИН ИЗ МНОГИХ… ПЛЕНЁННЫЙ ЖИЗНЬЮ… ВЛЕКУЩИЙ ТЕНЕЙ… ИЗРАНЕННЫЙ… ПРИНОСЯЩИЙ СТРАДАНИЯ… ЙЕМЕТ…»~
@53541 = ~Слушать дальше.~
@53542 = ~«Погоди… у меня другой вопрос…»~
@53543 = ~«Неважно. Прощай».~
@53544 = ~«Неважно. Прощай».~
@53545 = ~«ТЫ — ПОСЕРЕБРЁННОЕ СТЕКЛО, КОТОРОЕ ТРЕСНУЛО… РАЗБИЛОСЬ, И ЧАСТИ ЕГО РАЗЛЕТЕЛИСЬ ПО ИСТОРИИ. ТОЛЬКО ОДИН ОСКОЛОК ХРАНИТ СУТЬ. ОН ВОЗВРАЩАЕТСЯ К ТЕБЕ, И ТЫ СНОВА ЖИВЁШЬ. ГРЯДЁТ РАСПЛАТА. РАСПЛАТИВШИСЬ, ТЫ ПОЛУЧИШЬ ШАНС. БЕЗ ШАНСА ТЫ ОБРЕЧЁН…»~
@53546 = ~«Продолжай…»~
@53547 = ~«Погоди… у меня другой вопрос…»~
@53548 = ~«Неважно. Прощай».~
@53549 = ~«Неважно. Прощай».~
@53550 = ~«ТЫ ПОТЕРЯЛ ТО, ЧТО НИКОГДА НЕ ДОЛЖНО БЫТЬ ОТДЕЛЕНО ОТ ЧЕЛОВЕКА. ТВОЯ СМЕРТНОСТЬ БЫЛА ОТОБРАНА У ТЕБЯ… УТРАЧЕНА. ОНА СУЩЕСТВУЕТ, НО ТЕБЕ НУЖНО НАЙТИ ЕЁ ПРЕЖДЕ, ЧЕМ ТЫ ПОТЕРЯЕШЬ И САМОГО СЕБЯ».~
@53551 = ~«У меня вопрос о другом…»~
@53552 = ~«Это всё, что я хотел узнать. Прощай».~
@53553 = ~«Это всё, что я хотел узнать. Прощай».~
@53554 = ~«ПОКИНЬ ЭТО МЕСТО И НАПРАВЛЯЙСЯ ПРЯМО НА ЗАПАД ВДОЛЬ ВАЛУНОВ РАЗРУШЕННОЙ ДОЛИНЫ. В КОНЦЕ КОНЦОВ ТЫ ДОСТИГНЕШЬ ДАЛЬНЕГО КРАЯ ДОЛИНЫ; НАЙДИ ТАМ МЕСТО МЕЖДУ КАМНЯМИ, ОБРАЗУЮЩЕЕ ПОРТАЛ. КЛЮЧОМ К НЕМУ БУДЕТ ОБСИДИАН, ОБОЖЖЁННЫЙ ПЛАМЕНЕМ АВЕРНУСА, — ОКОЛО ПОРТАЛА ЕГО МНОГО. ПОЛОЖИ ОСКОЛОК ОБСИДИАНА В РОТ И УКУСИ ТАК, ЧТОБЫ ОН ПОРЕЗАЛ ЯЗЫК; ЭТО И БУДЕТ ТВОИМ КЛЮЧОМ».~
@53555 = ~«У меня вопрос о другом…»~
@53556 = ~«Это всё, что я хотел узнать. Прощай».~
@53557 = ~«Это всё, что я хотел узнать. Прощай».~
@53558 = ~Колонна странно молчалива; некоторые головы просто отводят взгляд, остальные вздрагивают с болезненным выражением на лице. Наконец они собираются с мыслями и снова гворят: «МЫ… НЕ ЗНАЕМ. ТЕ ГОЛОВЫ, В КОТОРЫХ СОДЕРЖАЛОСЬ ЭТО ЗНАНИЕ, БЫЛИ УНИЧТОЖЕНЫ, ВЫТАЩЕНЫ ИЗ НАС. МЫ НЕ МОЖЕМ ОТВЕТИТЬ НА ЭТОТ ВОПРОС».~
@53559 = ~«В таком случае у меня другой вопрос…»~
@53560 = ~«Тогда прощай».~
@53561 = ~«Тогда прощай».~
@53562 = ~Колонна останавливает тебя неожиданным требованием: «СТОЙ! ОТДАЙ НАМ ЧЕРЕП. МЫ *НЕ ПОЗВОЛИМ* ЕМУ УЙТИ. ОН *НАШ*. ОН *НЕ ДОЛЖЕН* ПОКИНУТЬ АВЕРНУС». Головы начинают ворковать и насмехаться над Морте: «Да, Череп, не стесняйся… возвращайся, Череп… здесь хорошо, Череп… иди, иди к нам… это не больно, Череп… это так здорово, быть без тела, жить в одной колонне с тысячью таких же гниющих лжецов, как ты…»~
@53563 = ~Схватить Морте и засунуть его в Колонну Черепов.~
@53564 = ~«Забудь об этом, Колонна. Прощай».~
@53565 = ~~
@53566 = ~Взбешённые головы колонны принимаются завывать и вопить на все планы. Сама земля начинает ходить под твоими ногами от жуткой какофонии, грозящей тебя оглушить…~
@53567 = ~Уйти… быстро.~
@53568 = ~Головы колонны плюются, фыркают и хохочут с адским весельем, пока вопящего Морте затягивает прямо вглубь этой штуки, где, без сомнения, он обречён на вечные мучения от „рук“ других голов. Когда эта суматоха немного успокаивается, головы начинают ворковать и перешёптываться друг с другом. Внезапно Морте прорывается на поверхность: «А-а-а-а! Забери меня отсюда! Пожалуйста! Пожалуйста! Я не буду больше лгать, кля!..» — и также внезапно, как появился, он скрывается внутри колонны.~
@53569 = ~«И каков ответ?..»~
@53570 = ~«И каков ответ?..»~
@53571 = ~«И каков ответ?..»~
@53572 = ~«И каков ответ?..»~
@53573 = ~«Прощай, Колонна».~
@53574 = ~Я засунул Морте назад в Колонну Черепов… излишне упоминать, что он этому не обрадовался.~
@53575 = ~И снова ты стоишь перед Колонной Черепов. Бесчисленное множество гниющих голов, громоздящихся огромной кучей, постоянно ворочается и колыхается, попутно перебраниваясь, воя, говоря, крича и шепча что-то друг другу. Головы то и дело всплывают на поверхность откуда-то из зловонного центра, тогда как другие погружаются обратно в недра жуткой колонны.~
@53576 = ~Привлечь внимание Колонны.~
@53577 = ~Привлечь внимание Колонны.~
@53578 = ~Привлечь внимание Колонны.~
@53579 = ~Отойти от Колонны, пока тебя не заметили.~
@53580 = ~И снова ты стоишь перед Колонной Черепов. Бесчисленное множество гниющих голов, громоздящихся огромной кучей, постоянно ворочается и колыхается, попутно перебраниваясь, воя, говоря, крича и шепча что-то друг другу. Головы то и дело всплывают на поверхность откуда-то из зловонного центра, тогда как другие погружаются обратно в недра жуткой колонны.~
@53581 = ~Привлечь внимание Колонны.~
@53582 = ~Отойти от Колонны, пока тебя не заметили.~
@53583 = ~Ты делаешь ещё один осторожный шаг к колонне, и все слышимые разговоры резко *смолкают*. Десятки голов, покрывающих поверхность колонны, медленно и в унисон поворачиваются в твою сторону. Они молча внимают тебе, как вдруг на поверхность с душераздирающим криком прорывается Морте: «А-а-а-а! Шеф! Забери меня отсюда! Пожалуйста! Пожалуйста!»~
@53584 = ~Игнорировать Морте, подождать, пока он снова исчезнет.~
@53585 = ~Попытаться вытащить Морте.~
@53586 = ~Повернуться и уйти.~
@53587 = ~Морте прорывается сквозь покрывающие его вонючую слизь и кровь и умоляет о спасении: «Шеф, пожалуйста, я умоляю тебя! Ты должен вытащить меня отсюда, пожалуйста. Я никогда не буду больше лгать, кля!..» И также внезапно, как появился, он скрывается внутри колонны.~
@53588 = ~«У меня вопросы, Колонна…»~
@53589 = ~«У меня вопросы, Колонна…»~
@53590 = ~«У меня вопросы, Колонна…»~
@53591 = ~«У меня вопросы, Колонна…»~
@53592 = ~«У меня вопросы, Колонна…»~
@53593 = ~«Я просто проходил мимо. Прощай».~
@53594 = ~Твои руки быстро выстреливают вперёд и хватают Морте, прежде чем его засасывает обратно внутрь колонны. Головы завывают от ярости: «НЕТ! НЕТ! СТОЙ! ТЫ НЕ МОЖЕШЬ СНОВА ЗАБРАТЬ ЕГО!» Головы набрасываются на тебя, сильно кусая за руки ужасными острыми зубами…~
@53595 = ~Продолжить драться, вырывая Морте из колонны.~
@53596 = ~Использовать своё мастерство в Искусстве, чтобы направить первозданную энергию на освобождение Морте.~
@53597 = ~Сделать вид, что сдаёшься, отвлечь внимание обманным движением, а потом выдрать Морте из колонны, прежде чем та сообразит, что происходит.~
@53598 = ~Продолжить драться, вырывая Морте из колонны.~
@53599 = ~Продолжить драться, вырывая Морте из колонны.~
@53600 = ~Сдаться и позволить Морте погрузиться в колонну.~
@53601 = ~Колонна Черепов устраивает нешуточную битву, но ты доказываешь, что ей не по зубам такой могущественный воин. Отбиваясь от нападающих голов, пиная их ногами, колошматя руками, отталкивая своей головой и даже кусая их, ты с треском лопающейся плоти освобождаешь Морте из колонны. Однако битва оставляет на тебе свои следы… ты ощущаешь, что как-то ослаб.~
@53602 = ~«Видишь, Морте? Не… о чём… волноваться…»~
@53603 = ~Колонна Черепов устраивает нешуточную битву, но твоя магия оказывается ей не по зубам. Ты направляешь на колонну чистую несфокусированную энергию, отбрасывая её прочь и освобождая Морте. Однако битва оставляет на тебе свои следы… ты ощущаешь, что как-то ослаб.~
@53604 = ~«Видишь, Морте? Не… о чём… волноваться…»~
@53605 = ~Видя, что колонна собирается затеять нешуточную битву, ты делаешь вид, что сдаёшься. Как только Морте начинает погружаться внутрь колонны и та снова заговаривает, ты бросаешься вперёд и хватаешь Морте. Только одна голова успевает укусить тебя, оставив глубокую рану на предплечье, прежде чем ты вырываешь Морте… ты тыкаешь голову пальцем в глаз и освобождаешь наконец своего старого товарища. Но укус поганой головы, очевидно, оставил свой след… ты ощущаешь, что как-то ослаб.~
@53606 = ~«Видишь, Морте? Не… о чём… волноваться…»~
@53607 = ~Колонна Черепов, не желая лишиться Морте, устраивает нешуточную битву. В конце концов тебе приходится уступить. Когда вопящий Морте снова погружается в глубины колонны, ты отступаешь, твои руки покрыты кровоточащими ранами там, где головы колонны с каждым укусом выдирали куски твоей плоти. Даже теперь они смеются над тобой, бросая плотоядные взгляды и слизывая твою кровь со своих гниющих губ…~
@53608 = ~«У меня вопросы, Колонна…»~
@53609 = ~«У меня вопросы, Колонна…»~
@53610 = ~«У меня вопросы, Колонна…»~
@53611 = ~«У меня вопросы, Колонна…»~
@53612 = ~«У меня вопросы, Колонна…»~
@53613 = ~Уйти.~
@53614 = ~Колонна Черепов, не желая лишиться Морте, устраивает нешуточную битву. В конце концов тебе приходится уступить. Когда вопящий Морте снова погружается в глубины колонны, ты отступаешь, твои руки покрыты кровоточащими ранами там, где головы колонны с каждым укусом выдирали куски твоей плоти. Даже когда ты валишься на землю, умирая, они смеются над тобой, бросая плотоядные взгляды и слизывая твою кровь со своих гниющих губ…~
@53615 = ~Умереть.~
@53616 = ~Головы колонны скрежещут зубами и плюются в тебя желчью, шипя от ярости: «ОН НАШ! НАШ! НАШ!» Внезапно они успокаиваются: «ПРЕКРАСНО. НАСЛАЖДАЙСЯ СВОЕЙ ПОБЕДОЙ, „БЕССМЕРТНЫЙ“. ТАК ИЛИ ИНАЧЕ МЫ СНОВА ЗАПОЛУЧИМ ЕГО».~
@53617 = ~«Посмотрим. У меня вопросы, Колонна…»~
@53618 = ~«Посмотрим. У меня вопросы, Колонна…»~
@53619 = ~«Посмотрим. У меня вопросы, Колонна…»~
@53620 = ~«Посмотрим. У меня вопросы, Колонна…»~
@53621 = ~«Посмотрим. У меня вопросы, Колонна…»~
@53622 = ~«Конечно-конечно. Прощай».~
@53623 = ~«О, просто *здорово*».~
@53624 = ~Как только ты делаешь шаг в сторону Колонны, Морте шипит тебе: «Ш-ш-ш! Шеф! Шеф… слушай, эта штука не должна меня видеть. Тебе придётся отвести меня отсюда… бросить где-нибудь и подобрать позже…»~
@53625 = ~«Забудь, Морте. Я не собираюсь откладывать беседу с ней…»~
@53626 = ~«Ну… я не хочу об этом говорить. Давай просто свалим отсюда, а?» — голос Морте дрожит от страха, его глаза бегают между тобой и огромной колонной голов.~
@53627 = ~«Почему, Морте? Что случилось?»~
@53628 = ~«Ладно. Тогда уходим».~
@53629 = ~«Я не могу позволить тебе держать так много в секрете, Морте. Ты должен сказать мне, что случилось».~
@53630 = ~«Никаких отговорок, Морте. *Сейчас же* говори, что случилось, или ты *хочешь*, чтобы мы спросили Колонну?»~
@53631 = ~«Ладно. Тогда уходим».~
@53632 = ~Морте вздыхает, избегая встречаться с тобой взглядом. Наконец он сдаётся: «Ладно, ладно… я скажу тебе. Есть колонна в Авернусе, первом уровне Баатора, построенная из голов тех, кто своей ложью довёл до смерти других. Ну… это она и есть. Видишь ли, в ней я однажды оказался. Представь себе».~
@53633 = ~Морте сказал, что это я вытащил его из Колонны много лет назад. Правда, он точно не понимает как. Он также объяснил, что потерял все знания, накопленные Колонной, в тот момент, когда я его вытаскивал… это объясняет, почему он отнюдь не *столь* полезен, каким должен быть по утверждению моей предыдущей инкарнации.~
@53634 = ~Эта особа выглядит раздражённой тем, что её отвлекли столь увлекательного судилища: «Да?»~
@53635 = ~Джасилия~
@53636 = ~Я пришёл в Управление по контролю за паразитами и болезнями, чтобы встретиться с Финеасом Т. Лортом. Он выглядел довольно обескураженным и бессвязно бормотал о том, что в его подвале завелась крыса-оборотень. Я согласился убить это существо за вознаграждение.~
@53637 = ~Ты сжимаешь зубы, вонзаешь ногти в левое предплечье и с сухим звуком разрыва сдираешь кусок собственной кожи. Холод между колоннами становится сильнее, почти обжигает, словно в портале образовалась трещина…~
@53638 = ~~
@53639 = ~~
@53640 = ~Ты снова стоишь перед аркой; пробирающий до костей холод охватывает воздух между двумя чёрными колоннами, словно сама арка служит вместилищем для чуждого ледяного пространства. Это портал в Крепость Сожалений… теперь всё, что тебе осталось сделать, — это записать своё сожаление на куске собственной кожи, содранной с предплечья.~
@53641 = ~Проколоть указательный палец и написать своей кровью сожаление на этом куске кожи…~
@53642 = ~Отойти от портала… пока.~
@53643 = ~Этот лоскут кожи был содран с твоего левого предплечья. Её рубцеватая серая поверхность напоминает тебе кожу зомби и вообще больше похожа дублёную шкуру, чем на человеческую кожу.~
@53644 = ~Проколоть указательный палец и написать своей кровью сожаление на этом куске кожи…~
@53645 = ~Убрать кожу…~
@53646 = ~Ты прокалываешь кончик своего указательного пальца и, прежде чем ранка успевает затянуться, выдавливаешь несколько капель крови. Пока ты готовишься записать сожаление, серия образов проносится в твоей голове…~
@53647 = ~Сожаление: «Я сожалею о том, что случилось с моими товарищами…»~
@53648 = ~Сожаление: «Я сожалею о своих действиях…»~
@53649 = ~Сожаление: «Я сожалею о своём прошлом…»~
@53650 = ~Сожаление: «Я сожалею о событиях, приведших к этому…»~
@53651 = ~Позволить ране зажить без писанины и убрать кусок кожи.~
@53652 = ~Отвернуться от надписи.~
@53653 = ~Ты шепчешь слова про себя, но сожаление эхом отдаётся в твоей голове: «Я сожалею, что…»~
@53654 = ~Осмотреть панель.~
@53655 = ~«…всем моим товарищам пришлось страдать, чтобы я смог попасть сюда».~
@53656 = ~Панель изготовлена таким образом, что может утапливаться в стену.~
@53657 = ~Нажать на панель.~
@53658 = ~Оставить панель в покое.~
@53659 = ~Ты нажимаешь на панель, и она легко уходит в стену. За спиной слышен щелчок саркофага.~
@53660 = ~Отвернуться от надписи.~
@53661 = ~Оказывается, Морте появился из так называемой Колонны Черепов. Эта колонна из живых отрубленных голов находится в Авернусе, первом уровне Баатора. Она состоит из голов лжецов, чья ложь привела других к смерти.~
@53662 = ~«Итак… ты был одной из этих голов?»~
@53663 = ~«Итак… ты был одной из этих голов?»~
@53664 = ~«Ага. Я когда-то… сделал одно-два преувеличения. Одно из моих указаний как раз и привело к твоей смерти. Одно из них. Может, несколько. Точно я не знаю: теперь эти воспоминания ушли».~
@53665 = ~«Ясно…»~
@53666 = ~«Ага. Я когда-то… сделал одно-два преувеличения. Одно из моих указаний…»~
@53667 = ~Морте невозмутимо продолжает: «…одно из моих *указаний* как раз и привело к твоей смерти. Одно из них. Может, несколько. Точно я не знаю: теперь эти воспоминания ушли».~
@53668 = ~Морте уставился на твои ботинки — ты никогда ещё не видел его столь жалким. «Эти воспоминания, они… слушай, шеф, я даже не помню, каково это: *быть* человеком. Я не помню жизни до Колонны…»~
@53669 = ~~
@53670 = ~«ОНИ ПРИШЛИ ОТ ТОГО, КОГО ТЫ ЗНАЕШЬ, И ДОЛЖНЫ ВЕРНУТЬСЯ К НЕМУ:»~
@53671 = ~«К ФЬЮЛЛУ ДВУЛИЧНОМУ. ОН ДАЖЕ СЕЙЧАС СКРЫВАЕТСЯ ВО ВНЕШНИХ ЗЕМЛЯХ, ТАМ, ГДЕ ПАЛ В КРАТЕРНОЙ ВОЙНЕ ВЕЛИКИЙ ИЗВЕРГ».~
@53672 = ~«А-а-а… тогда к Фьюллу, приспешники мои-и-и!»~
@53673 = ~Прочитать кое-что о наследстве.~
@53674 = ~~
@53675 = ~Продолжить чтение, освежить память.~
@53676 = ~Игнорировать надпись и осмотреть панель.~
@53677 = ~Отвернуться от надписи.~
@53678 = ~«Не потеряй свой дневник, иначе мы снова погрузимся в воды Стикса. И что бы ты ни делал, НИКОГДА никому НЕ говори, КТО ты или ЧТО с тобой случилось, а то они устроят тебе скорое паломничество в крематорий. Делай, как я говорю: ПРОЧТИ дневник, а потом НАЙДИ Фарода».~
@53679 = ~Продолжить чтение.~
@53680 = ~Продолжить чтение.~
@53681 = ~Отвернуться от надписи.~
@53682 = ~К твоему удивлению, тут есть ещё одна строка, которую Морте не прочёл тебе в Мортуарии: «Не доверяй черепу».~
@53683 = ~Осмотреть панель.~
@53684 = ~Отвернуться от надписи.~
@53685 = ~Панель изготовлена таким образом, что может утапливаться в стену.~
@53686 = ~Нажать на панель.~
@53687 = ~Оставить панель в покое.~
@53688 = ~Ты нажимаешь на панель, и она легко уходит в стену. За спиной слышен щелчок саркофага.~
@53689 = ~Отвернуться от надписи.~
@53690 = ~И ещё одна строка: «Не доверяй черепу».~
@53691 = ~Осмотреть панель.~
@53692 = ~Отвернуться от надписи.~
@53693 = ~«То, что ты делаешь, только ухудшает проблему. Вместо грабежа, возьми этих людей и помоги оборонять стены, чтобы город мог вернуться во Внешние Земли».~
@53694 = ~«То, что ты делаешь, только ухудшает проблему. Вместо грабежа, возьми этих людей и помоги оборонять стены, чтобы город мог вернуться во Внешние Земли».~
@53695 = ~«Слушай, пень, лучше тебе убраться отсюда… если до тебя доходит, что хорошо, а что плохо».~
@53696 = ~«Тогда прощай».~
@53697 = ~«Может, ты плохо слышишь? Проваливай отсюда. Больше повторять не буду».~
@53698 = ~«Ладно. Я ухожу».~
@53699 = ~«У тебя был шанс, пень. Стоило уйти, пока мог», — головорез нападает!~
@53700 = ~Драться.~
@53701 = ~«Тебе здесь никто не рад, пень. Проваливай, пока не получил».~
@53702 = ~«Прощай».~
@53703 = ~«Последний шанс уйти самому, чужак. Вали вон в ту дверь или огребёшь уйму неприятностей».~
@53704 = ~«Прощай».~
@53705 = ~«Захотелось приключений на свой зад, ага, пень? Надо было уходить, пока мог». Сверкает сталь!~
@53706 = ~Защищаться.~
@53707 = ~Осмотреть панель.~
@53708 = ~Отвернуться от надписи.~
@53709 = ~Работа очень тонкая. Панель врезана в стену с такой точностью, что сразу видно руку настоящего мастера. Кажется, панель может уйти в стену и дальше.~
@53710 = ~Нажать на панель.~
@53711 = ~Оставить панель в покое.~
@53712 = ~Панель утапливается в стену лёгким прикосновением руки. За спиной слышен щелчок саркофага.~
@53713 = ~Отвернуться от надписи.~
@53714 = ~Продолжить чтение.~
@53715 = ~Отвернуться от надписи.~
@53716 = ~Неужели это какой-то вид кармического цикла? Как я слышал, некоторые инкарнации совершали ужасные преступления, тогда как другие не делали ничего, кроме добра. Эти инкарнации предназначались для наказания? Не знаю. Вот и вся правда, которую я могу предложить в этих записях: я не знаю.~
@53717 = ~Продолжить чтение.~
@53718 = ~Отвернуться от надписи.~
@53719 = ~И в какой момент *я* отделился от *мы*? И в какой момент я освободился от оков действий моих предыдущих инкарнаций? С какого момента мне позволено быть *собой*, без груза этих предыдущих жизней?~
@53720 = ~Осмотреть панель.~
@53721 = ~Отвернуться от надписи.~
@53722 = ~Панель великолепно изготовлена и с точностью врезана в стену. Похоже, её можно утопить в стену дальше.~
@53723 = ~Нажать на панель.~
@53724 = ~Оставить панель в покое.~
@53725 = ~Панель без усилий уходит в стену. За спиной слышен щелчок саркофага.~
@53726 = ~Отвернуться от надписи.~
@53727 = ~Продолжить чтение.~
@53728 = ~Отвернуться от надписи.~
@53729 = ~Всё, чего я добился, — это время. Нападения неизбежно начнутся снова, даже с большей яростью, чем раньше. Уловки бесполезны. Так или иначе убийца снова узнает о том, что я жив. И неважно, на каких планах я прячусь, он найдёт меня… со временем.~
@53730 = ~Осмотреть панель.~
@53731 = ~Отвернуться от надписи.~
@53732 = ~Похоже, панель можно утопить в стену.~
@53733 = ~Нажать на панель.~
@53734 = ~Оставить панель в покое.~
@53735 = ~Панель плавно уходит в стену. За спиной слышен щелчок саркофага.~
@53736 = ~Отвернуться от надписи.~
@53737 = ~Джуджог~
@53738 = ~Продолжить чтение.~
@53739 = ~Отвернуться от надписи.~
@53740 = ~Как кто-то может быть бессмертным и в то же время умирать?~
@53741 = ~Продолжить чтение.~
@53742 = ~Отвернуться от надписи.~
@53743 = ~Он сказал мне, что с каждой смертью разум мой ослабевает. Я спросил, почему это может быть, но он не смог ответить. Он был бесполезен. Я убил его, чтобы другие инкарнации не страдали больше от его бесполезности.~
@53744 = ~Осмотреть панель.~
@53745 = ~Оставить панель в покое.~
@53746 = ~Надпись вырезана грубо и портит тонкую отделку панели. При близком рассмотрении приходит мысль, что панель можно утопить в стену.~
@53747 = ~Нажать на панель.~
@53748 = ~Оставить панель в покое.~
@53749 = ~Панель легко уходит в стену. За спиной слышен щелчок саркофага.~
@53750 = ~Отвернуться от надписи.~
@53751 = ~Продолжить чтение.~
@53752 = ~Отвернуться от надписи.~
@53753 = ~ПОТЕРЯВШИЙСЯ… БЕССМЕРТНЫЙ… КОНЕЦ ИНКАРНАЦИЙ… ЧЕЛОВЕК ТЫСЯЧИ СМЕРТЕЙ… ПРИГОВОРЁННЫЙ К ЖИЗНИ… НЕУПОКОЕННЫЙ… ОДИН ИЗ МНОГИХ… ПЛЕНЁННЫЙ ЖИЗНЬЮ… ВЛЕКУЩИЙ ТЕНЕЙ… ИЗРАНЕННЫЙ… ПРИНОСЯЩИЙ СТРАДАНИЯ… ЙЕМЕТ…~
@53754 = ~Продолжить чтение.~
@53755 = ~Отвернуться от надписи.~
@53756 = ~Я устал.~
@53757 = ~Осмотреть панель.~
@53758 = ~Оставить панель в покое.~
@53759 = ~Панель великолепно изготовлена, сразу видно работу мастера. Похоже, она может быть утоплена в стену.~
@53760 = ~Нажать на панель.~
@53761 = ~Оставить панель в покое.~
@53762 = ~Панель уходит в стену с тихим шипящим звуком. За спиной слышен щелчок саркофага.~
@53763 = ~Отвернуться от надписи.~
@53764 = ~Продолжить чтение.~
@53765 = ~Отвернуться от надписи.~
@53766 = ~Я — Безымянный.~
@53767 = ~Осмотреть панель.~
@53768 = ~Отвернуться от надписи.~
@53769 = ~Панель прекрасно изготовлена. Кажется, она может быть утоплена в стену.~
@53770 = ~Нажать на панель.~
@53771 = ~Оставить панель в покое.~
@53772 = ~Без малейшего звука панель уходит в стену. За спиной слышен щелчок саркофага.~
@53773 = ~Отвернуться от надписи.~
@53774 = ~«Импульс»~
@53775 = ~Безумный житель Керста~
@53776 = ~Амарисса~
@53777 = ~Клинок энтропии~
@53778 = ~Сердитый житель Керста~
@53779 = ~Чиновник Керста~
@53780 = ~«Пень, ты щас вошёл не в ту дверь. Это твоя последняя ошибка».~
@53781 = ~Драться.~
@53782 = ~Открыть саркофаг.~
@53783 = ~Открыть саркофаг.~
@53784 = ~Открыть саркофаг.~
@53785 = ~Ты открываешь саркофаг… чтобы обнаружить одинокий ключ, лежащий внутри. Здесь нет ни тела, ни, самое главное, черепа.~
@53786 = ~«Не думаю, что Лотар будет рад узнать…»~
@53787 = ~Мгновение ты молча смотришь на содержимое саркофага.~
@53788 = ~Взять ключ и уйти.~
@53789 = ~Ты открываешь саркофаг… чтобы обнаружить одинокий ключ, лежащий внутри. Здесь нет тела, нет вообще ничего, достойного внимания.~
@53790 = ~Взять ключ и уйти.~
@53791 = ~Саркофаг пуст. Ничего с прошлого раза не изменилось.~
@53792 = ~Уйти.~
@53793 = ~~
@53794 = ~Морте смотрит на Дак'кона, потом на тебя. «Да, наверное. И это довольно крутой поворот, когда ты умираешь. Ты… забываешь. Подозреваю, при жизни я не был образцовым членом общества… но дьявол побери, а кто был? — Морте снова вздыхает. — Просто я ничего не могу с этим поделать. Нет ничего хуже, чем всё время быть честным. Но слушай, шеф, если эта колонна голов *увидит* меня, они захотят меня назад, а это будет *плохо*. Я не могу этого допустить!»~
@53795 = ~«Забудь, Морте. Я не собираюсь откладывать беседу с ней…»~
@53796 = ~«Погоди… а как ты освободился из Колонны?»~
@53797 = ~«Постой-ка… почему ты ещё в Мортуарии не сказал, что знал меня?»~
@53798 = ~«Один момент. Как давно ты меня знаешь, Морте?»~
@53799 = ~«Ладно. Пошли, Морте».~
@53800 = ~«В любом случае, подозреваю, при жизни я не был образцовым членом общества… но дьявол побери, а кто был? — Морте снова вздыхает. — Просто я ничего не могу с этим поделать. Нет ничего хуже, чем всё время быть честным. Но слушай, шеф, если эта колонна голов *увидит* меня, они захотят меня назад, а это будет *плохо*. Я не могу этого допустить!»~
@53801 = ~«Забудь, Морте. Я не собираюсь откладывать беседу с ней…»~
@53802 = ~«Погоди… а как ты освободился из Колонны?»~
@53803 = ~«Постой-ка… почему ты ещё в Мортуарии не сказал, что знал меня?»~
@53804 = ~«Один момент. Как давно ты меня знаешь, Морте?»~
@53805 = ~«Ладно. Пошли, Морте».~
@53806 = ~«Хорошо, шеф… уломал. Я пробился на поверхность Колонны — а ты уже был тут, знаешь ли, — вопил и кричал до тех пор, пока ты не заметил меня. Я умолял освободить меня, клялся, что до конца твоих дней буду сопровождать тебя и делиться своими знаниями, полученными из Колонны… тогда я просто не представлял, сколько это будет длиться».~
@53807 = ~«А что же со всеми знаниями Колонны?..»~
@53808 = ~«А, это… ну, я также не знал, что расстанусь со всеми знаниями, накопленными Колонной, едва меня извлекут из неё. Разорви меня сила, как же *это* тебя всегда бесило! Но ты всё равно держал меня при себе. И сперва я чувствовал „привязанность“ к тебе… может, твоя магия превратила меня в нечто вроде близкого друга. Но после пары сотен лет я понял, что это нечто *большее*… нечто более глубокое. Не просто долг признательности, хотя и без него не обошлось, ясно дело. Я просто чувствовал *связь* с тобой. Может, это всё твои мучения, шеф, твои страдания. Не знаю. А может, мне самому так захотелось ещё в колонне».~
@53809 = ~«Теперь я собираюсь поговорить с Колонной…»~
@53810 = ~«Почему ты ещё в Мортуарии не сказал, что знал меня?»~
@53811 = ~«Так сколько ты меня знаешь, Морте?»~
@53812 = ~«Хорошо. Давай уйдём, Морте».~
@53813 = ~Внезапно Морте переходит к защите: «Потому что я не *знал*, кем ты будешь! Некоторые из твоих инкарнаций были абсолютно помешанными, буйными! Однажды ты решил, что *я* — твой собственный череп, и гонялся за мной вокруг Шпиля, пытаясь разбить и проглотить меня… к счастью, тебя сбило проезжавшей мимо повозкой. Другой ты, „добропорядочный и законопослушный“, пытался засунуть меня обратно в Колонну, ибо я, видите ли, ей принадлежал, — Морте ухмыляется. — *Вот* почему. Кроме того, твоё незнание не принесло вреда…»~
@53814 = ~«Теперь я собираюсь поговорить с Колонной…»~
@53815 = ~«Как ты освободился из Колонны?»~
@53816 = ~«Так сколько ты меня знаешь, Морте?»~
@53817 = ~«Хорошо. Давай уйдём, Морте».~
@53818 = ~«Не знаю. Века, полагаю. Я каждый раз делал всё возможное, чтобы ты нашёл сам себя, но… — Морте вздыхает, потом поднимается, чтобы встретиться с тобой взглядом. — Ты редко заходил так далеко, шеф. Я серьёзно, только четыре или пять раз. Может быть, пришло время… „тебе“, который всё это начал, наконец разобраться, что происходит».~
@53819 = ~«Теперь я собираюсь поговорить с Колонной…»~
@53820 = ~«Как ты освободился из Колонны?»~
@53821 = ~«Почему ты ещё в Мортуарии не сказал, что знал меня?»~
@53822 = ~«Хорошо. Давай уйдём, Морте».~
@53823 = ~«О, нет…»~
@53824 = ~Морте трясётся от страха, его зубы клацают: «Я не могу вернуться, шеф! Не могу! Не могу! Не могу!»~
@53825 = ~«Он не вернётся к тебе. Но у меня есть вопросы, Колонна Черепов…»~
@53826 = ~«Он не вернётся к тебе. Но у меня есть вопросы, Колонна Черепов…»~
@53827 = ~«Он не вернётся к тебе, Колонна Черепов. Но у меня есть вопросы…»~
@53828 = ~«Давай просто уйдём, Морте. Пошли».~
@53829 = ~«Да *ладно*, шеф, разве я не *рассказал* тебе, что это такое?! Она составлена из голов лжецов, чьи „советы“ отправили других на смерть. Они могут ответить почти на любой вопрос — они знают гораздо больше, чем просто „много“, — но запросят немереную плату за свои ответы. Не задавай им подобных вопросов!»~
@53830 = ~«Не возвращай меня туда, шеф. Пожалуйста!»~
@53831 = ~«Шеф?! Нет! Нет! Ты *не можешь*! Не надо!»~
@53832 = ~«Не волнуйся, Морте, позже я заберу тебя».~
@53833 = ~«Не волнуйся, Морте, позже я заберу тебя».~
@53834 = ~«Не волнуйся, Морте, позже я заберу тебя».~
@53835 = ~«Не волнуйся, Морте, позже я заберу тебя».~
@53836 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53837 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53838 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53839 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53840 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53841 = ~«Давай просто уйдём, Морте. Пошли».~
@53842 = ~Морте смотрит на тебя скептически: «Ты *уверен*? *Клянёшься*? Эй, да что я такое говорю?! Нет! Ни за что! Да ладно, ты *не можешь* отправить меня туда!»~
@53843 = ~Схватить Морте и засунуть его в Колонну Черепов.~
@53844 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53845 = ~~
@53846 = ~~
@53847 = ~~
@53848 = ~~
@53849 = ~Мгновение Морте молча смотрит на тебя, разинув рот. «ЧЕГО?! Не выйдет! Ты не настолько силён, как тогда… слушай, забудь, ты не можешь этого сделать, так быть не должно! Да ладно, ты *не можешь* отправить меня туда!»~
@53850 = ~Схватить Морте и засунуть его в Колонну Черепов.~
@53851 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53852 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53853 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53854 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53855 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53856 = ~«Давай просто уйдём, Морте. Пошли».~
@53857 = ~«Эй там… погоди! Не так быстро! Колонна… я могу сказать тебе, где находится Фьюлл Двуличный! Ну же, ты ведь хочешь это знать? Что, если он скажет тебе это в обмен на меня? А? Что скажешь?»~
@53858 = ~«Остановись, Морте. Мы не сдадим Фьюлла».~
@53859 = ~Ждать ответа Колонны.~
@53860 = ~«Что? Ты *спятил*?! Продаёшь *меня*, а не этого *ИЗВЕРГА*?! Единственная причина, по которой он помог тебе, — это что он был связан контрактом, этим проклятием! Как насчёт *меня*? Кто вытащил тебя из Мортуария, друг? Кто стоял — э-э, висел — за твоей спиной, когда ты лицом к лицу встретился с тем, что ждало тебя в Крепости Чего-бы-то-ни-было?! А?! А?! НЕ ТОЛСТОЗАДЫЙ ХРЕНОВ ФЬЮЛЛ, ЭТО УЖ ТОЧНО!»~
@53861 = ~«Хорошо, хорошо. Что скажешь, Колонна?»~
@53862 = ~«Извини, Морте. Ты отправишься туда».~
@53863 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53864 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53865 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53866 = ~«Хорошо, Морте. Колонна Черепов, какую ещё плату ты примешь?»~
@53867 = ~«Давай просто уйдём, Морте. Пошли».~
@53868 = ~Святая конфета~
@53869 = ~«…пытался продать Морте Вришике».~
@53870 = ~«…пытался продать Анну Вришике».~
@53871 = ~«…пытался продать Дак'кона Вришике».~
@53872 = ~«…пытался продать Падшую Грейс Вришике».~
@53873 = ~«…пытался продать Нордома Вришике».~
@53874 = ~«…не продал Морте Вришике».~
@53875 = ~«…не продал Анну Вришике».~
@53876 = ~~
@53877 = ~Конфета Механуса~
@53878 = ~«…не продал Дак'кона Вришикe».~
@53879 = ~«…не продал Нордома Вришике».~
@53880 = ~«…продал Морте Вришике».~
@53881 = ~«…продал Анну Вришике».~
@53882 = ~«…продал Дак'кона Вришике».~
@53883 = ~«…продал Нордома Вришике».~
@53884 = ~«…всё это время держал Дак'кона в рабстве».~
@53885 = ~«…научил Игнуса использовать силу для нанесения вреда другим».~
@53886 = ~«…предал Морте, оставив его в Колонне Черепов».~
@53887 = ~«…Дак'кон погиб».~
@53888 = ~«…Анна погибла».~
@53889 = ~«…Морте погиб».~
@53890 = ~«…Падшая Грейс погибла».~
@53891 = ~«…Игнус погиб».~
@53892 = ~«…Нордом погиб».~
@53893 = ~«…Вейлор погиб».~
@53894 = ~Подумать, о чём ещё можно пожалеть…~
@53895 = ~Позволить ране зажить без писанины и убрать кусок кожи.~
@53896 = ~Ты шепчешь слова про себя, но сожаление эхом отдаётся в твоей голове: «Я сожалею, что…»~
@53897 = ~«…не убил больше народу».~
@53898 = ~«…не освободил Коаксметала из осадной башни».~
@53899 = ~«…не освободил Коаксметала из осадной башни».~
@53900 = ~«…освободил Коаксметала из осадной башни».~
@53901 = ~~
@53902 = ~~
@53903 = ~«…пришлось убить Рейвел».~
@53904 = ~«…мотался по всем планам, в то время как этот долбаный портал был здесь, когда я очнулся В ПЕРВЫЙ РАЗ».~
@53905 = ~Подумать, о чём ещё можно пожалеть…~
@53906 = ~Позволить ране зажить без писанины и убрать кусок кожи.~
@53907 = ~Ты шепчешь слова про себя, но сожаление эхом отдаётся в твоей голове: «Я сожалею…»~
@53908 = ~«…что просил о бессмертии».~
@53909 = ~«…что убил Фина Андли. Если бы я не стал бессмертным, моя параноидальная инкарнация его бы не убила…»~
@53910 = ~«…о том вреде, который мои предыдущие инкарнации причинили себе и окружающим».~
@53911 = ~«…о смертях, причиной которых я стал здесь и во всей мультивселенной».~
@53912 = ~«…что лгал Дейонарре, чтобы заставить её присоединиться ко мне в моих странствиях».~
@53913 = ~«…об убийстве Дейонарры в Крепости Сожалений».~
@53914 = ~«…о страданиях, в которые я вверг Янниса, доведя его дочь до смерти».~
@53915 = ~Подумать, о чём ещё можно пожалеть…~
@53916 = ~Позволить ране зажить без писанины и убрать кусок кожи.~
@53917 = ~Ты шепчешь слова про себя, но сожаление эхом отдаётся в твоей голове: «Я сожалею, что…»~
@53918 = ~«…мне *так долго* пришлось искать свою смертность».~
@53919 = ~«…мне пришлось забрать много жизней, чтобы попасть сюда».~
@53920 = ~«…здесь нет никого, кто разделил бы со мной этот момент».~
@53921 = ~«…у меня нет сожалений, которые можно записать на этом куске кожи».~
@53922 = ~Подумать, о чём ещё можно пожалеть…~
@53923 = ~Позволить ране зажить без писанины и убрать кусок кожи.~
@53924 = ~Ты корябаешь свои сожаления на куске собственной кожи… но палец заживает слишком быстро, и тебе приходится снова вскрывать ранку и выдавливать новые капли крови. Спустя пару минут ты заканчиваешь, кровь поблескивает на куске кожи… комбинация из твоей плоти, твоей крови и твоего сожаления.~
@53925 = ~Хрустящая конфета~
@53926 = ~Наблюдать за сохнущей кровью…~
@53927 = ~Наблюдать за сохнущей кровью…~
@53928 = ~Пока ты наблюдаешь, как сохнет твоё кровавое сожаление, тебя окатывает волной холода. Ты поднимаешь взгляд: чёрные колонны арки мягко светятся, пятнышки таинственного синего света стекают с их граней и формируют между колоннами блестящий мерцающий занавес. За занавесом ты с трудом можешь разглядеть выветренную каменную мостовую, ведущую во тьму.~
@53929 = ~«Все готовы?»~
@53930 = ~«Все готовы?»~
@53931 = ~«Все готовы?»~
@53932 = ~«Все готовы?»~
@53933 = ~«Папа?! Чё ты тут ваще делаешь?»~
@53934 = ~«Все готовы?»~
@53935 = ~«Все готовы?»~
@53936 = ~«Все готовы?»~
@53937 = ~«Все готовы?»~
@53938 = ~«Все готовы?»~
@53939 = ~«Все готовы?»~
@53940 = ~Шагнуть сквозь занавес с куском кожи с сожалением в руках.~
@53941 = ~Шагнуть сквозь занавес с куском кожи с сожалением в руках.~
@53942 = ~Шагнуть сквозь занавес с куском кожи с сожалением в руках.~
@53943 = ~Уйти от портала.~
@53944 = ~МИНАВРОЗИЙСКИЙ ШОКОЛАД
Вызывает: «Проклятие роя»
Вес: 0

У съевшего кусочек этого фигурного горького шоколада из глотки вырвется наружу огромное облако озлобленных насекомых.~
@53945 = ~Минаврозийский шоколад~
@53946 = ~Благословлённая конфета~
@53947 = ~Держа в руке кусок кожи, на котором записано сожаление, ты приближаешься к двум колоннам, ведущим в Крепость. Тебя окатывает волной холода, а чёрные колонны арки начинают мягко светиться, пятнышки таинственного синего света стекают с их граней и формируют между колоннами блестящий мерцающий занавес. За занавесом ты с трудом можешь разглядеть выветренную каменную мостовую, ведущую во тьму.~
@53948 = ~«Все готовы?»~
@53949 = ~«Все готовы?»~
@53950 = ~«Все готовы?»~
@53951 = ~«Все готовы?»~
@53952 = ~«Все готовы?»~
@53953 = ~Вонючий шоколад~
@53954 = ~«Все готовы?»~
@53955 = ~СЧАСТЛИВАЯ КОНФЕТА
Вызывает: «Удача»
Вес: 0

Это кусочек шоколада в форме месяца с начинкой из восхитительного зефирного крема. Съевший его становится необычайно удачливым.~
@53956 = ~«Все готовы?»~
@53957 = ~«Все готовы?»~
@53958 = ~«Все готовы?»~
@53959 = ~«Все готовы?»~
@53960 = ~Держать кусок кожи с сожалением на нём и приготовиться шагнуть сквозь занавес.~
@53961 = ~Держать кусок кожи с сожалением на нём и приготовиться шагнуть сквозь занавес.~
@53962 = ~Держать кусок кожи с сожалением на нём и приготовиться шагнуть сквозь занавес.~
@53963 = ~Уйти от портала.~
@53964 = ~И лишь тишина в ответ: никого из твоих товарищей нет достаточно близко, чтобы услышать.~
@53965 = ~Держать кусок кожи с сожалением на нём и приготовиться шагнуть сквозь занавес.~
@53966 = ~Разыскать товарищей перед путешествием через портал.~
@53967 = ~Через пару минут раздумий ранка на пальце полностью затягивается, тебе приходится снова вскрыть её и выдавить ещё немного крови. Когда ты собираешься записать сожаление, серия образов проносится в твоей голове…~
@53968 = ~ВОНЮЧИЙ ШОКОЛАД
Вызывает: «Облако-убийца»
Вес: 0

Этот дурно пахнущий и липкий кусочек шоколада заставит проглотившего отрыгнуть большое облако ядовитого газа.~
@53969 = ~Сожаление: «Я сожалею о том, что случилось с моими товарищами…»~
@53970 = ~Сожаление: «Я сожалею о своих действиях…»~
@53971 = ~Сожаление: «Я сожалею о своём прошлом…»~
@53972 = ~Сожаление: «Я сожалею о событиях, приведших к этому…»~
@53973 = ~Убрать кожу…~
@53974 = ~Анна напряжённо глазеет на колонну, её глаза сужены, кулаки сжаты, хвост мечется из стороны в сторону. Смесь ярости и муки отражается на её дрожащем лице.~
@53975 = ~«Анна… ты в порядке?»~
@53976 = ~Правда: «Хотел бы я чем-то ему помочь, Анна. Это трагичный исход для любого».~
@53977 = ~Правда: «Печально, Анна, но он заслужил такую судьбу. Постарайся не очень переживать за него».~
@53978 = ~Правда: «Рад видеть там этого ублюдка. „Отец“ он тебе, Анна, или нет, но так и должно было произойти».~
@53979 = ~Промолчать.~
@53980 = ~Промолчать.~
@53981 = ~~
@53982 = ~Анна ухмыляется, сплёвывает и отворачивается от кучи гниющих голов. Она пожимает плечами, но не хочет встречаться с тобой взглядом: «Неважно».~
@53983 = ~~
@53984 = ~~
@53985 = ~~
@53986 = ~~
@53987 = ~~
@53988 = ~~
@53989 = ~~
@53990 = ~«Твой путь — мой путь».~
@53991 = ~«Морте? Ты готов?»~
@53992 = ~«Морте? Ты готов?»~
@53993 = ~«Ладно… посмотрим, что там за этим порталом».~
@53994 = ~«Ладно… посмотрим, что там за этим порталом».~
@53995 = ~«Ладно… посмотрим, что там за этим порталом».~
@53996 = ~Дрожащая конфета~
@53997 = ~Дак'кон выглядит сломленным. Кажется, каждая его часть протестует, но он кивает. «Твой путь — мой путь… — его лицо на глазах становится окончательно осунувшимся. — Я следую за тобой только потому, что смогу умереть».~
@53998 = ~ДРОЖАЩАЯ КОНФЕТА
Вызывает: «Сила»
Вес: 0

Этот тяжёлый кусок цельного шоколада трясётся и вздрагивает у тебя в руках. Когда конфету съедают, мускулы съевшего пульсируют подобными сильными спазмами, увеличивая на некоторое время его физическую силу.~
@53999 = ~«Это всё, что я прошу… скоро твоё желание исполнится. Морте?»~
@54000 = ~«Это всё, что я прошу… скоро твоё желание исполнится. Морте?»~
@54001 = ~«Скоро твоё желание исполнится. Ладно, посмотрим, что там за этим порталом…»~
@54002 = ~«Скоро твоё желание исполнится. Ладно, посмотрим, что там за этим порталом…»~
@54003 = ~«Скоро твоё желание исполнится. Ладно, посмотрим, что там за этим порталом…»~
@54004 = ~Еле уловимо, почти что незаметно клинок Дак'кона мерцает, лезвие тупеет. Когда бросаешь на Дак'кона взгляд, его руки прижаты к бокам, словно он приготовился к бою.~
@54005 = ~Мятная конфета~
@54006 = ~МЯТНАЯ КОНФЕТА
Вызывает: «Друзья»
Вес: 0

Эта маленькая круглая твёрдая конфетка делает дыхание по-зимнему прохладным, мятным и свежим. Харизма съевшего такую конфетку на некоторое время значительно повышается.~
@54007 = ~«*Знай*, что я ходил твоим путём много раз, — Дак'кон говорит медленно, словно взвешивая каждое слово; его клинок становится расплывчато-серым, будто мысли Дак'кона блуждают. — Часть твоего пути *известна* мне. Пятеро шли этим путём в Крепость. Каждый умер своей смертью».~
@54008 = ~«Но… кто они были? Как они умерли?»~
@54009 = ~«Я умер смертью веры. Череп умер смертью мужества. Женщина умерла смертью горести. Слепой лучник умер последней и самой лёгкой смертью — смертью тела. Ты… ты умер смертью памяти».~
@54010 = ~«Но… кто были мои товарищи?»~
@54011 = ~«Он был тем, кто *знал* о своих целях, не видя их. Много теней пало под дождём его стрел».~
@54012 = ~«Там была тьма, и каждая тень была Шра'кт'лором, — Дак'кон понижает голос до шёпота, а его безжизненные чёрные глаза смотрят куда-то сквозь тебя. — Они — страдающие создания. Раны твоего духа *известны* им. Они нападут на тебя через них».~
@54013 = ~«Тени *страдают*. Они *познали* страдание. Они *знают*, как мучить тебя тем, что ранило твоё сердце. Когда ты встретишься с ними, *знай*, что ты встретился с тем, что однажды уже убило тебя».~
@54014 = ~«Дак'кон… Морте, вы со мной выжили. Что стало с лучником и Дейонаррой?»~
@54015 = ~«Лучник умер смертью тела. Женщина умерла смертью духа. Я не мог спасти её, ибо на её спасение не было твоей ВОЛИ. На её могиле не было слёз. Никто не *знал*, что надо оплакивать её уход».~
@54016 = ~«Но… почему я не хотел её спасения?»~
@54017 = ~«Я говорил Хезвигу сбросить вес!»~
@54018 = ~«Твои желания были *известны* только тебе».~
@54019 = ~«Хорошо, слушайте оба: я хочу знать всё, что вы можете рассказать мне о Крепости…»~
@54020 = ~«Хорошо, слушайте оба: я хочу знать всё, что вы можете рассказать мне о Крепости…»~
@54021 = ~«Ничто там не живёт. Её стены — тьма».~
@54022 = ~«Хорошо. Прежде чем я пройду через портал, ответьте: есть ли ЧТО-НИБУДЬ ЕЩЁ, чем вы хотели бы поделиться и что могло бы мне ПОМОЧЬ?»~
@54023 = ~«Я зашла так далеко, и было бы просто неприлично отступить перед самой развязкой, — её губ касается лёгкая улыбка. — Даже если ты вежливо попросишь не ходить с тобой, я не соглашусь».~
@54024 = ~«Похоже, у меня нет выбора. Итак… Анна?»~
@54025 = ~«Похоже, у меня нет выбора. Итак… Анна?»~
@54026 = ~«Похоже, у меня нет выбора. Итак… Дак'кон?»~
@54027 = ~«Похоже, у меня нет выбора. Итак… Дак'кон?»~
@54028 = ~«Похоже, у меня нет выбора. Итак… Морте?»~
@54029 = ~«Похоже, у меня нет выбора. Итак… Морте?»~
@54030 = ~«Ладно… посмотрим, что там за этим порталом».~
@54031 = ~«Ладно… посмотрим, что там за этим порталом».~
@54032 = ~«Ладно… посмотрим, что там за этим порталом».~
@54033 = ~«Это из-за того, что сказала Рейвел в лабиринте, — голос Грейс мягкий и тихий, такой тихий, что его почти не слышно. — Не так ли, Морте?»~
@54034 = ~«Это из-за того, что сказала Рейвел в лабиринте. И символа, который Фелл описал для нас, — голос Грейс мягкий и тихий, такой тихий, что его почти не слышно. — Не так ли, Морте?»~
@54035 = ~«…и обезьяна сказала: „Это были вовсе не волшебные орешки!“»~
@54036 = ~«Ты слышал историю об обезьяне, белке и волшебных орешках?»~
@54037 = ~«Надеюсь, я никогда больше не буду тебя злить на тренировочных упражнениях!»~
@54038 = ~«Я слышал, он почти завязал после того случая».~
@54039 = ~«Тебе надо было видеть его лицо, когда я обвинил его».~
@54040 = ~Анна поворачивается, её глаза горят. «Он был моим *папой*, — она скалит зубы. — Я его *ненавидела*. Он видел во мне только способ собрать больше тел, больше и больше хлама для своего хранилища. „Анна, дорогая“, „Анна, детка, ты — драгоценнейшая вещь в моём хранилище“, — врал он. Всё врал и врал. Он был слаб мозгами и слабак ваще. И вонял как разложившийся труп, а мысли у него были как у стервятника, пожирающего этот труп».~
@54041 = ~~
@54042 = ~~
@54043 = ~~
@54044 = ~~
@54045 = ~~
@54046 = ~~
@54047 = ~Анна понижает голос, но огонь в её глазах разгорается ярче: «И он был единственным, кто проявил ко мне хоть намёк на доброту. Ты *это* хотел услышать, да? Теперь *доволен*, ага?»~
@54048 = ~~
@54049 = ~~
@54050 = ~Анна ухмыляется, сплёвывает и отворачивается от кучи разлагающихся голов. Она пожимает плечами, но не хочет встречаться взглядом ни с Грейс, ни с тобой: «Неважно».~
@54051 = ~«Ты имеешь в виду *соврал*!» — шипит Анна.~
@54052 = ~«Ты чё, идиотина?! Это черепушки тех, кто, набрехавши, отправил других пней на смерть. Они могут ответить почти на все вопросы, но за ответ сдерут с тя *столько*, что мало не покажется. Не задавай им вопросов типа такого!»~
@54053 = ~~
@54054 = ~~
@54055 = ~~
@54056 = ~«Анна, ты любила Фарода?»~
@54057 = ~Промолчать.~
@54058 = ~«Анна, ты любила Фарода?»~
@54059 = ~Промолчать.~
@54060 = ~~
@54061 = ~~
@54062 = ~«Она может *взять* меня, да?! Я так не думаю, грёбаный идиот! Ты чем думал, когда это нёс? — внезапно она умолкает, прищурившись на тебя. — Тень Госпожи! Лучше б те не думать об этом всерьёз… если ты меня кинуть хочешь, я тя сама этой штуке скормлю, клянусь…»~
@54063 = ~Правда: «Я серьёзно. Отправляйся в неё, Анна, или я сам тебя туда засуну».~
@54064 = ~«Да, плохая мысль. Колонна, какие *ещё* подарки ты примешь?»~
@54065 = ~«Конечно, я шучу. Пошли».~
@54066 = ~«Конечно, я шучу. Пошли».~
@54067 = ~«Анна, мне очень жаль…»~
@54068 = ~«Колонна Черепов — это колонна живых голов, составленная из голов тех, чья ложь привела к смерти других. Она может ответить на множество вопросов, поскольку много знает, но за свои ответы она ожидает немалой платы. Не стоит задавать подобных вопросов».~
@54069 = ~Падшую Грейс, похоже, твоё заявление не трогает, она просто переводит взгляд с Колонны на тебя: «Я никогда не позволю Колонне Черепов заполучить меня… но я уверена, ты и так об этом знаешь и просто шутишь. Вряд ли ты хочешь так расплатиться с Колонной…»~
@54070 = ~Правда: «Я серьёзно. Отправляйся в неё, Грейс, или я сам тебя туда затолкаю».~
@54071 = ~«Хорошо. Какие *ещё* подарки ты примешь, Колонна?»~
@54072 = ~«Хорошо. Какие *ещё* подарки ты примешь, Колонна?»~
@54073 = ~«*Конечно*, я шутил. Пошли».~
@54074 = ~«*Конечно*, я шутил. Пошли».~
@54075 = ~Грейс замолкает и настороженно разглядывает тебя: «Ты уверен, что желаешь избрать именно этот путь? Ты и вправду отдашь меня Колонне Черепов?»~
@54076 = ~«Да, отдам».~
@54077 = ~«Нет, не отдам. Колонна, какие *ещё* подарки ты примешь?»~
@54078 = ~«Нет, не отдам. Колонна, какие *ещё* подарки ты примешь?»~
@54079 = ~«Нет, не отдам. Пошли».~
@54080 = ~«Нет, не отдам. Пошли».~
@54081 = ~~
@54082 = ~Глаза Падшей Грейс становятся суровыми и холодными как лёд, но выражение её лица не меняется. «Тогда я должна попрощаться с тобой, Безымянный. Если тебе доведётся проходить через Баатор, то, возможно, мы снова встретимся», — с этими словами она начинает растворяться в облаке зеленоватого дыма.~
@54083 = ~«Грейс…»~
@54084 = ~Дак'кон, глядя в пустоту, тихо произносит: «Это подобно попытке удержать воду в руках».~
@54085 = ~Дак'кон тихо говорит тебе: «Колонна Черепов состоит из живых голов тех, чья *осознанная* ложь привела других на смерть. Она может ответить на множество вопросов, так как немало знает, но и плату за ответы требует немалую. Не стоит задавать ей подобных вопросов».~
@54086 = ~«Спасибо, прямо сейчас ничем. До встречи».~
@54087 = ~«Ничем. Прощай».~
@54088 = ~*ТЫ. Это ТЫ. Как ДОЛГО длилась моя охота, Безымянный? И как долго я находился РЯДОМ с тобой, прежде чем раскрылся ОБМАН?* Когда он вздымает свой топор, чистая *сила* струится сквозь него… его преданность, его невероятная убеждённость превращают Вейлора в буквальное, физическое олицетворение справедливости. *Сама СУДЬБА привела меня столь близко к тебе, ПРЕСТУПНИК. Да восторжествует ПРАВОСУДИЕ. Ты ПАДЁШЬ под ударом моего клинка, бессмертный, даже если мне придётся ВЕЧНО противостоять твоим сопротивляющимся останкам.*~
@54089 = ~Защищаться.~
@54090 = ~Попытаться убежать.~
@54091 = ~Перекрученный механизм Энолл-Эва~
@54092 = ~ПЕРЕКРУЧЕННЫЙ МЕХАНИЗМ ЭНОЛЛ-ЭВА
(Малый артефакт)
Особенности:
   Позволяет выучить: «Дупликация Энолл-Эва»
Вес: 2
Доступно: магам

Тяжёлый механизм, находящийся в центре этой запутанной кучи хлама, содержит последние алгебраические размышления Энолл-Эва, недавно дезинтегрированного Созидающего Директора Рубикона. На этих скрученных деталях написано сложное математическое уравнение модронов, открытое при попытке математически вычислить изменение лабиринта Рубикона. Вероятно, близость Лимбо имела воздействие на мысли Энолл-Эва, которое вдохновило недалёкого модрона подумать о чём-то возвышенном и чрезвычайно опасном.

Однажды «рассчитанное» (произнесённое), уравнение Энолл-Эва позволяет всем последующим действиям быть удвоенными или дублированными. Во время боя все физические или магические атаки дублируются, удваивая также урон.

Как эта вещь оказалась внутри корпуса Нордома — неизвестно. Мордон-бродяга вероятно подобрал её при сборе брошенных предметов в лабиринте Рубикона.~
