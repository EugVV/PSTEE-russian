@29123 = ~«Нет, сегодня у меня нет желания тренироваться. Прощай».~
@29124 = ~«Да, обучи меня».~
@29125 = ~«Да, обучи меня».~
@29126 = ~«Нет… чему ещё ты можешь меня обучить?»~
@29127 = ~«Нет, сегодня у меня нет желания тренироваться. Прощай».~
@29128 = ~«Да, обучи меня».~
@29129 = ~«Да, обучи меня».~
@29130 = ~~
@29131 = ~«Нет… чему ещё ты можешь меня обучить?»~
@29132 = ~«Нет, сегодня у меня нет желания тренироваться. Прощай».~
@29133 = ~«Тогда обучи меня».~
@29134 = ~«Да, я хочу специализироваться на молоте».~
@29135 = ~«Нет. Чему ещё ты можешь меня обучить?»~
@29136 = ~«Можешь сделать из меня воина?»~
@29137 = ~«Тогда у меня кое-какие вопросы…»~
@29138 = ~«В таком случае прощай».~
@29139 = ~«Да, я больше не хочу изучать Искусство. Сделай из меня воина».~
@29140 = ~«Да, я больше не хочу быть вором. Сделай из меня воина».~
@29141 = ~«Вообще-то нет. Однако у меня кое-какие вопросы…»~
@29142 = ~«Не сейчас. Прощай».~
@29143 = ~«„Путь Камня“?»~
@29144 = ~«У меня другие вопросы…»~
@29145 = ~«Это всё, что я хотел узнать. Прощай».~
@29146 = ~«Неуязвимости? Тогда тебя будет невозможно победить в бою…»~
@29147 = ~«Это всё, что я хотел узнать. Прощай».~
@29148 = ~«Можешь рассказать, что тебе уже удалось постичь?»~
@29149 = ~«Ясно. У меня другие вопросы…»~
@29150 = ~«Это всё, что я хотел узнать. Прощай».~
@29151 = ~Слушать и учиться Пути Камня.~
@29152 = ~Слушать и пытаться понять Путь Камня.~
@29153 = ~«Спасибо, Кви-Сай. У меня были другие вопросы…»~
@29154 = ~«Спасибо, Кви-Сай. Прощай».~
@29155 = ~«Всё равно спасибо, Кви-Сай. У меня были другие вопросы…»~
@29156 = ~«Всё равно спасибо, Кви-Сай. Прощай».~
@29157 = ~Друзья~
@29158 = ~Слепота~
@29159 = ~[нет текста]~
@29160 = ~Снять проклятие~
@29161 = ~Поднять мёртвого~
@29162 = ~Ужас~
@29163 = ~Удача~
@29164 = ~Концентрация Зертимона~
@29165 = ~Стук~
@29166 = ~Размытие~
@29167 = ~Женщина небрежно кивает и спрашивает тебя голосом, холодным как лёд: «Да? Что вам нужно? И следите за выражениями, поскольку я — Дилиженс, Четвёртый Магистрат района».~
@29168 = ~«Именно так я и думаю! Если бы только Акт о Подобающем Одеянии прошёл, то людям вашего сорта не было бы позволено шататься здесь — полуобнажёнными и грязными».~
@29169 = ~Она скептически осматривает тебя, после чего кивает: «Ваши аргументы… не лишены здравого смысла, сэр. Хотя вы не можете отрицать, что выглядите как неумытый бродяга и забияка».~
@29170 = ~«О, но следовало бы! Как легко винить в каждом своём промахе окружающую среду и свою жизнь! По вашим манерам я могу заключить, что вы вполне образованны, но вот ваша внешность указывает мне на то, что вы ведёте довольно-таки распущенный образ жизни, полный бессмысленного насилия. Почему бы вам не осесть в Сигиле, не стать добропорядочным гражданином, вместо того чтобы бродяжничать по улицам и драться?»~
@29171 = ~«О? Как это так?» — её холодность отступает перед удивлением.~
@29172 = ~«И всё же я прошу вас попытаться».~
@29173 = ~Ты заканчиваешь рассказывать свою историю.

Дилиженс выглядит ошеломлённой: «Это… это история из историй, сэр».~
@29174 = ~«Да-да… верно, — она слегка улыбается… тебя удивляет, что она вообще на такое способна. — Желаю вам удачи, сэр, во всех ваших делах. Пусть поиски ваши будут успешны».~
@29175 = ~«Так вы хотите сказать, что вы не просто бродяга, который шатается по городу, расспрашивает всех встречных и нередко ввязывается в кровавые драки с тем, кто не так поглядел?»~
@29176 = ~Дилиженс смотрит на тебя холодно: «Вы мне лжёте. Я не желаю больше тратить на вас время, сэр. Если вы ещё раз ко мне подойдёте — я позову стражу. Убирайтесь, сейчас же».~
@29177 = ~«Стража!»~
@29178 = ~Слабый намёк на улыбку касается её губ: «Я столь быстра в суждениях, сэр, исключительно потому, что я — магистрат по торговле. Я не желаю больше тратить на вас время. Если вы ещё хоть раз попытаетесь со мной заговорить, мне придётся вызвать стражу. Убирайтесь, сейчас же».~
@29179 = ~Её глаза сужаются до щёлок: «Не стоит со мной шутить, сэр, я терпеть не могу подобного. Так что вам от меня нужно?»~
@29180 = ~Дилиженс просто смотрит на тебе, на её лице заметно слабое выражение отвращения.~
@29181 = ~Дилиженс ухмыляется: «Я не гид, сэр, который развлекает прохожих и отвечает на их вопросы ради горстки монет. Если нужны ответы на вопросы, обратитесь по другому адресу. У меня важные государственные дела».~
@29182 = ~«Ни единого. Теперь оставьте меня в покое! Позволите себе ещё хоть одно слово или даже просто снова приблизится ко мне, и я вызову стражу».~
@29183 = ~«Ответ тот же, сэр. У меня нет времени на ваши вопросы».~
@29184 = ~«Погодите… по вашим манерам я могу заключить, что вы вполне образованны, но вот внешность указывает мне на то, что вы ведёте довольно-таки распущенный образ жизни, полный бессмысленного насилия. Почему бы вам не осесть в Сигиле, не стать добропорядочным гражданином, вместо того чтобы бродяжничать по улицам и драться?»~
@29185 = ~«Нет, не так быстро… постойте! — прищурившись, она смотрит на тебя. — Кто вы?»~
@29186 = ~«Хм-м. Отлично, „Адан“. Прощайте».~
@29187 = ~«Вы без причины остановили меня прямо на улице, заставили терпеть своё присутствие и после этого имеете *наглость* утверждать, что это не моё дело? Я думаю, это как раз моё дело!»~
@29188 = ~«Да ладно, вы ведь не рассчитываете отделаться так просто? Сообщите мне ваше имя!»~
@29189 = ~Она спокойно, с кислой гримасой на лице разглядывает тебя. Наконец произносит: «Отлично. Покиньте меня и постарайтесь больше не встревать в неприятности».~
@29190 = ~«Ваши слова хорошо подобраны, но это же просто безумие, — она хмурит брови. — Так это правда — что вы забыли, кто вы такой? Расскажите же мне прямо, не бросайте слов на ветер».~
@29191 = ~Мгновение спустя она издаёт раздражённый вздох: «По вашим манерам я могу заключить, что вы вполне образованны, но вот ваша внешность указывает мне на то, что вы ведёте довольно-таки распущенный образ жизни, полный бессмысленного насилия. Почему бы вам не осесть в Сигиле, не стать добропорядочным гражданином, вместо того чтобы бродяжничать по улицам и драться?»~
@29192 = ~Он качает головой: «Боюсь, я довольно-таки занятая женщина, сэр. Моя должность Четвёртого Магистрата оставляет мне крайне мало времени для того, чтобы отвечать на вопросы прохожих. Однако я уверена, какой-нибудь другой гражданин не откажется вам помочь».~
@29193 = ~Она бросает на тебя удивлённый взгляд, но ничего не говорит.~
@29194 = ~Она заканчивает фразу за тебя: «И это, насколько я могу себе представить, привлекло внимание Гармониума? Вас беспокоит их назойливое внимание, так?»~
@29195 = ~Она покачивает головой, цокая языком, как будто ты нерадивый ребёнок: «Я подумаю, что можно предпринять, сэр, но вы должны обещать мне не провоцировать в будущем подобного рода конфликтов».~
@29196 = ~Дилиженс хмурится, когда ты к ней подходишь: «Вы кажетесь знакомым…» Её лицо становится кислым, как от лимона: «А, да… вот теперь я вас вспомнила».~
@29197 = ~Дилиженс бросает на тебя взгляд, полный отвращения: «Я же предупреждала вас о том, чтобы вы ко мне даже близко не приближались. И разве я не говорила, что позову стражу?»~
@29198 = ~Дилиженс кивает при твоём приближении: «Приветствую вас снова, сэр».~
@29199 = ~Женщина в шоке отступает, завидев тебя: «Вы что, *безумец*, приближаться к Четвёртому Магистрату района с такой репутацией?! Стража! Стража!»~
@29200 = ~«Приветствую…»~
@29201 = ~Оставить её в покое.~
@29202 = ~«Кто-кто?»~
@29203 = ~«У меня кое-какие вопросы…»~
@29204 = ~«Что-то не так в моей наружности?»~
@29205 = ~«Ничего. Прощай».~
@29206 = ~«Я вполне чист, мадам, и… не хочу сказать ничего обидного, но в некоторых культурных традициях могли бы найти *твою* одежду оскорбительной».~
@29207 = ~«Не слишком ли поспешно судить о ком-либо, только исходя из внешности?»~
@29208 = ~«Это последний крик моды в Улье, знаешь ли. Попробуй, может, тебе понравится».~
@29209 = ~«Ясно. Я хотел спросить…»~
@29210 = ~«Хм-м. Мне бы надо идти. Прощай».~
@29211 = ~«Моя внешность — всего лишь результат окружающей среды и тяжёлой жизни, мадам. Не стоит призывать меня к ответу за неприятности, которые выпали на мою долю».~
@29212 = ~«Нет, не могу. В любом случае прощай».~
@29213 = ~«Выбор не за мной, могу уверить».~
@29214 = ~«Я подумаю. Прощай».~
@29215 = ~«Это довольно сложно объяснить…»~
@29216 = ~Рассказать ей свою историю… или то, что тебе о ней известно.~
@29217 = ~«Неважно. Прощай».~
@29218 = ~Рассказать ей свою историю… или то, что тебе о ней известно.~
@29219 = ~«Нет, лучше не буду. Это довольно личное дело. Прощай».~
@29220 = ~«Если бы это была только история, мадам. Это моя жизнь, и шрамы на мне подтверждают каждое моё слово. Я думаю, ты их заметила».~
@29221 = ~«Не так ли? Прощай».~
@29222 = ~«Спасибо. У меня кое-какие вопросы…»~
@29223 = ~«Благодарю. Прощай, леди Дилиженс».~
@29224 = ~«Всё это второстепенно, мадам. Я вполне чист, и… не хочу сказать ничего обидного, но в некоторых культурных традициях могли бы найти *твою* одежду оскорбительной».~
@29225 = ~«Ну… э…»~
@29226 = ~Ложь: «Это неправда».~
@29227 = ~«Но…»~
@29228 = ~Уйти.~
@29229 = ~Напасть на неё.~
@29230 = ~Плюнуть на всё и убежать.~
@29231 = ~«Но…»~
@29232 = ~Уйти.~
@29233 = ~«Прости мне мою глупость, мадам, но я вполне чист, и… не хочу сказать ничего обидного, но в некоторых культурных традициях могли бы найти *твою* одежду оскорбительной».~
@29234 = ~«Не слишком ли поспешно судить о ком-либо, только исходя из внешности?»~
@29235 = ~«У меня кое-какие вопросы…»~
@29236 = ~«Хм-м. Мне бы надо идти. Прощай».~
@29237 = ~«У меня кое-какие вопросы…»~
@29238 = ~«Что-то не так в моей наружности?»~
@29239 = ~«Мне пора идти».~
@29240 = ~«Я ничего такого не говорил, мадам. Скорее ты выглядишь весьма знающей леди, и я понадеялся, что ты не откажешься помочь мне советом».~
@29241 = ~«Всего один вопросик?»~
@29242 = ~«Тогда прощай».~
@29243 = ~«Но…»~
@29244 = ~Уйти.~
@29245 = ~«Приношу свои извинения, мадам, и благодарю за уделённое время. Прощай».~
@29246 = ~«Отлично, пока».~
@29247 = ~«Хм-м. Посмотрим, будет ли эта деталь работать».~
@29248 = ~«Дурацкий ключ не подходит!»~
@29249 = ~«Не работает? ::Вздох:: Придётся взять другую».~
@29250 = ~«Немного подкрутим тут…»~
@29251 = ~«Может, это подойдёт…»~
@29252 = ~«Ну-ка, быстро принеси мне вон те запчасти!»~
@29253 = ~«Хм-м… похоже, это может сработать».~
@29254 = ~«Может, это…»~
@29255 = ~«Не, это не подойдёт».~
@29256 = ~«Попробуй вот эту часть».~
@29257 = ~«И эта не подходит? ::Вздох:: Я притащу тебе другую».~
@29258 = ~«Попробуй этот инструмент».~
@29259 = ~«Нет, так неправильно».~
@29260 = ~«Лучше бы эта жутко скучная работа стала моим билетом к восхождению».~
@29261 = ~«Эти пни Стражи Судьбы должны понять, что жизнь — это не одно сплошное разрушение!»~
@29262 = ~«Несмотря на мои ошибки Омбидиас был достаточно добр, чтобы направить меня на верный путь».~
@29263 = ~«Не как долго ты живёшь, но КАК ты живёшь — вот что определяет твой путь к просветлению».~
@29264 = ~«Берегись. Говорят, Пыльные освободили из тюрьмы Фоснату'у».~
@29265 = ~*ХРЯСЬ*~
@29266 = ~«Выбор не за мной, уверяю».~
@29267 = ~«Я подумаю. Прощай».~
@29268 = ~«Я не знаю».~
@29269 = ~Ложь: «Моё имя — Адан».~
@29270 = ~Ложь: «Моё имя — Адан».~
@29271 = ~«Не твоё дело».~
@29272 = ~Уйти.~
@29273 = ~«Я… не знаю».~
@29274 = ~Ложь: «Моё имя — Адан».~
@29275 = ~Ложь: «Моё имя — Адан».~
@29276 = ~«Это довольно обескураживающая ситуация, но я прошу проявить немного терпения. Я действительно не знаю, как меня зовут. Я себя не помню».~
@29277 = ~«Я правда не знаю. Я потерял память».~
@29278 = ~Уйти.~
@29279 = ~«Клянусь, мадам, это правда».~
@29280 = ~«Выбор не за мной, уверяю».~
@29281 = ~«Я подумаю. Прощай».~
@29282 = ~«До того, как мы расстанемся, мадам, не будет ли с моей стороны дерзостью попросить об услуге?»~
@29283 = ~«Тогда прощай, леди Дилиженс».~
@29284 = ~«В своих странствиях я обидел некоторых местных граждан…»~
@29285 = ~«Да, мадам».~
@29286 = ~«Весьма благодарен, леди Дилиженс. Прощай».~
@29287 = ~«Мадам… боюсь, в прошлую нашу встречу я не выказал должного уважения. Искренне прошу меня простить».~
@29288 = ~«У меня кое-какие вопросы…»~
@29289 = ~«Мне пора идти».~
@29290 = ~«Леди Дилиженс… погоди, прошу. Боюсь, в прошлую нашу встречу я не выказал должного уважения. Искренне прошу меня простить».~
@29291 = ~«Но я хотел спросить…»~
@29292 = ~«Тогда я ухожу. Прощай».~
@29293 = ~«Рад встрече, леди Дилиженс. У меня кое-какие вопросы…»~
@29294 = ~«Какая приятная встреча, миледи. Могу ли я осмелиться просить об одолжении?»~
@29295 = ~«Просто проходил мимо. Прощай».~
@29296 = ~Напасть на неё.~
@29297 = ~Плюнуть на всё и убежать.~
@29298 = ~«Челове-ечишка-а! УМРИ-И-И!» — крыса-оборотень бросается на тебя.~
@29299 = ~Враждебно настроенный крысолюд шипит: «Что ты хотел, человек?»~
@29300 = ~Крыса-оборотень осматривает тебя сверху донизу. «Не твоё дело, человечишка», — он тихо хихикает.~
@29301 = ~«Владыка… где-то поблизости. Нет сомнения… он за тобой наблюдает, — он подёргивает усами. — Уходи, я больше не буду с тобой разговаривать!»~
@29302 = ~«Тут наш выводок. И не ходи здесь всё время — мы не хотим тебя видеть, человечина».~
@29303 = ~«Мантуок? Что тебе надо от Мантуока? Я думаю, Мантуок найдёт тебе, если ты ему понадобишься», — он хихикает и отступает.~
@29304 = ~«Проклятье, я всего лишь хотел поговорить!»~
@29305 = ~«Кто ты?»~
@29306 = ~«Где Лотар?»~
@29307 = ~«Что это за место?»~
@29308 = ~«Ты знаешь Мантуока?»~
@29309 = ~«Ничего. Прощай».~
@29310 = ~«Отлично, но где Лотар?»~
@29311 = ~«Что это за место?»~
@29312 = ~«А где Мантуок?»~
@29313 = ~«Забудь об этом».~
@29314 = ~«Ну ладно».~
@29315 = ~«Насчёт этого не волнуйся. Вряд ли я смогу долго выносить эту вонь. Пока».~
@29316 = ~«Да не вопрос. Это не особо приятное место. Прощай».~
@29317 = ~«Тогда скажи мне, где я могу найти Лотара».~
@29318 = ~«Расскажи мне об этом месте».~
@29319 = ~«Хорошо. Прощай».~
@29320 = ~Ты видишь получеловеческий-полукрысиный гибрид. Его красные глаза светятся коварством, а голос, исходящий из глотки, маслянистый и вкрадчивый: «Итак… двуногий прокрался в дом прислужников Лотара. Чего ты хочешь, человек, и куда собираешься пройти? Подойди медленно, нарушитель, и говори Мантуоку только правду».~
@29321 = ~Крыса-оборотень качает головой при упоминании о Лотаре и шипит: «Послал безволосого, чтобы выполнять работу родичей? Невозможно!»~
@29322 = ~Мантуок опять шипит: «Тогда убирайся, вернёшься с черепом в руках». Он прерывается и смотрит на тебя подозрительно: «У тебя ведь ещё нет черепа?»~
@29323 = ~Крыса-оборотень хватает кусок отравленного сыра и осторожно нюхает, подозрительно на тебя глядя. Потом жадно пожирает сыр, и вдруг спазм сотрясает его тело. Он падает на землю, начинает задыхаться и дёргаться в агонии. «Хр-р…»~
@29324 = ~Мантуок смотрит на тебя подозрительно, потом выхватывает из твоей протянутой руки сыр и начинает его жадно пожирать со словами: «Иди, чужак. Мы поговорим попозже, когда ты вернёшься». Он погружается в дегустацию сыра.~
@29325 = ~«Я — Мантуок. Голос Многих-как-Один и агент Лотара, Повелителя Костей. Я задаю тебе вопросы — ты отвечаешь. Что тебе здесь нужно?»~
@29326 = ~«Всё, что здесь происходит, касается меня. Говори, а не то мои собратья крысы сожрут твою плоть».~
@29327 = ~Мантуок сжимает губы и хихикает под нос: «Ну что ж. Тогда я испробую твоей крови и выведаю секреты из твоей плоти. Крысы! Ко мне!» Он наносит удар.~
@29328 = ~«В этом месте, мясо, я задаю вопросы, а не отвечаю на них. Чего. Тебе. Надо?»~
@29329 = ~«Ты ищешь Лотара, хотя пришёл сюда из его святая святых? Уходи, а я забуду, что видел тебя».~
@29330 = ~«Болтливый череп? Тьфу. Что за пустая трата времени. Будем надеятся, ты сделаешь что-нибудь для хозяина за возвращение своего друга, поскольку иного пути его вернуть уж точно нет».~
@29331 = ~«Это совершенно неприемлемо. Если ты входишь к родичам — у тебя должна быть цель».~
@29332 = ~«Да. Уходи. И не возвращайся, а то будешь страдать».~
@29333 = ~Мантуок обдумывает твои слова, пристально тебя разглядывая. «Не думай, что я забуду твои слова, человек. Иди к хозяину, если хочешь, но помни, что до конца твоих дней за тобой будут следить». Он отходит в сторону.~
@29334 = ~«Так ты принёс тот череп, который нужен хозяину?»~
@29335 = ~«А почему бы и нет? Хозяин знает секреты силы, а Многие знают секреты города. Возможно, однажды мне удастся натравить их друг на друга и стать самым могущественным. Многие-как-Один видят большую пользу в таком сотрудничестве. А обращение жителей Похороненной деревни позволяет расширить влияние и Многих-как-Один, и Лотара. Кругом выгода, нет? Так… что тебе здесь нужно?»~
@29336 = ~Он выхватывает сыр у тебя из рук и мгновенно его проглатывает. «Теперь о черепе, человек… ты его добыл?»~
@29337 = ~«Он тот самый, который просил хозяин?»~
@29338 = ~Мантуок кривит губы: «Тогда непременно тащи его хозяину. Он будет очень рад тебя видеть».~
@29339 = ~«Отдай его мне, а уж я отнесу хозяину. Мы больше не нуждаемся в твоих услугах».~
@29340 = ~«Ты не понял… — челюсти Мантуока сжимаются и разжимаются, а хост мотается из стороны в сторону. — Это не просьба. Отдавай мне череп. Нам же не нужны неприятности… особенно здесь, двуногий. С такими неприятностями даже тебе будет разобраться затруднительно».~
@29341 = ~«Так *принеси* его, двуногий, и не возвращайся с пустыми руками. Не заставляй хозяина ждать».~
@29342 = ~«Нет, человеческая тварь, думаю, не мне суждено умереть сегодня. Ради хозяина я вырву череп из твоих холодных, мёртвых пальцев».~
@29343 = ~«Тогда мне придётся убить тебя и закопать твоё тело с черепом в таком месте, где их никогда не найдут».~
@29344 = ~Мантуок берёт у тебя череп и критически обнюхивает. «Много, много мест в катакомбах, двуногий, нет? Много мест, куда можно заточить на целую вечность, и откуда никто не услышит, хоть закричись. В одно из таких мест тебя бросят и оставят страдать, — он поворачивается к своим товарищам, крысам-оборотням. — Бейте двуногого, пока не упадёт. А тело тащите в катакомбы и похороните заживо».~
@29345 = ~«Тогда ты не оставляешь мне выбора, — он поворачивается к своим товарищам, крысам-оборотням. — Бейте его, пока не упадёт. А тело тащите в катакомбы и замуруйте заживо. Пусть останется погребённым навечно».~
@29346 = ~«Это не болезнь! Это благословение! Я куда круче тебя, существо, больше трупа, чем человека».~
@29347 = ~Пока ты говоришь, его глаза начинают яростно блестеть. Без лишних слов он бросается на тебя.~
@29348 = ~«Нет, мы выше. Мы хищники и охотники на двуногих. А ты — наша пища!»~
@29349 = ~Он поворачивается к своим товарищам, крысам-оборотням: «Бейте двуногого, пока не упадёт. А тело тащите в катакомбы и замуруйте заживо. Пусть останется погребённым навечно».~
@29350 = ~«Ты вернулся, человечишка. Что тебе нужно?»~
@29351 = ~«Я выполняю поручение Лотара. Мне нужно добыть череп».~
@29352 = ~«Кто ты?»~
@29353 = ~«Ищу, кто здесь главный».~
@29354 = ~«Я ищу моего друга Морте».~
@29355 = ~«Просто осматриваю достопримечательности».~
@29356 = ~«Он сказал, что вы бесполезны и ему нужен кто-то достойный доверия. Это я».~
@29357 = ~«Тем не менее».~
@29358 = ~«Не хочешь сыра, Мантуок?» — протянуть ему отравленный сыр.~
@29359 = ~Офицер Гармониума~
@29360 = ~Бармен~
@29361 = ~Посетитель кафе~
@29362 = ~Друзилла~
@29363 = ~«Не хочешь сыра, Мантуок?»~
@29364 = ~Протянуть ему отравленный сыр: «Мантуок, сыр будешь?»~
@29365 = ~Протянуть ему сыр: «Мантуок, сыр будешь?»~
@29366 = ~«Вообще-то, есть».~
@29367 = ~«Пока нет. Но я вернусь с ним».~
@29368 = ~«Прощай, крыска».~
@29369 = ~«Гори в аду, Мантуок».~
@29370 = ~«Приятного аппетита, Мантуок».~
@29371 = ~«Кто такой Многие-как-Один?»~
@29372 = ~«Кто такой Лотар?»~
@29373 = ~«Так ты двойной агент? А как же верность?»~
@29374 = ~«Просто осматриваю достопримечательности».~
@29375 = ~«Ищу хозяина этого места».~
@29376 = ~«Я ищу моего друга Морте».~
@29377 = ~«Мои дела тебя не касаются».~
@29378 = ~«Просто осматриваю достопримечательности».~
@29379 = ~«Я ищу хозяина этого места».~
@29380 = ~«Я ищу моего друга Морте».~
@29381 = ~«Как я сказал, это не твоё дело».~
@29382 = ~«Ну давай, Мантуок».~
@29383 = ~«Просто осматриваю достопримечательности».~
@29384 = ~«Ищу хозяина этого места».~
@29385 = ~«Ищу хозяина этого места».~
@29386 = ~«Я ищу моего друга Морте».~
@29387 = ~«Мои дела тебя не касаются».~
@29388 = ~«Хорошо».~
@29389 = ~«Буду иметь в виду. Прощай».~
@29390 = ~«Тогда я ухожу».~
@29391 = ~«Как скажешь. Прощай».~
@29392 = ~«Буду иметь в виду».~
@29393 = ~«У меня есть череп».~
@29394 = ~«Да, от скелета».~
@29395 = ~«Да, от зомби».~
@29396 = ~«Да, от упыря».~
@29397 = ~«Да, от крысы-оборотня».~
@29398 = ~«Да, от древнего скелета».~
@29399 = ~«Ещё нет».~
@29400 = ~«Убирайся с дороги, Мантуок, или я убью тебя на месте».~
@29401 = ~«Не хочешь сыра, Мантуок?» — протянуть ему отравленный сыр.~
@29402 = ~«Не хочешь сыра, Мантуок?»~
@29403 = ~«Просто осматриваю достопримечательности».~
@29404 = ~«Ищу хозяина этого места».~
@29405 = ~«Я ищу моего друга Морте».~
@29406 = ~«Мои дела тебя не касаются».~
@29407 = ~«У меня есть череп».~
@29408 = ~«Да, от скелета».~
@29409 = ~«Да, от зомби».~
@29410 = ~«Да, от упыря».~
@29411 = ~«Да, от крысы-оборотня».~
@29412 = ~«Да, от древнего скелета».~
@29413 = ~«Ещё нет».~
@29414 = ~«Убирайся с дороги, Мантуок, или я убью тебя на месте».~
@29415 = ~«Не хочешь ещё сыра, Мантуок?» — протянуть ему отравленный сыр.~
@29416 = ~«Да».~
@29417 = ~«Нет».~
@29418 = ~«Спасибо, Мантуок».~
@29419 = ~«Нет, думаю, я сам ему отдам».~
@29420 = ~«Не хочешь сыра, Мантуок?» — протянуть ему отравленный сыр.~
@29421 = ~«Не хочешь сыра, Мантуок?»~
@29422 = ~Отдать ему безымянный череп: «Вот, бери».~
@29423 = ~Отдать ему череп Харгримма: «Вот, бери».~
@29424 = ~Отдать ему череп Тухлой Мэри: «Вот, бери».~
@29425 = ~Отдать ему череп Акасты: «Вот, бери».~
@29426 = ~Отдать ему череп Соэго: «Вот, бери».~
@29427 = ~Отдать ему череп Безмолвного Короля: «Вот, бери».~
@29428 = ~«Может, твоя дурацкая болезнь ухудшила твой слух? Я же сказал, что сам отнесу череп Лотару».~
@29429 = ~«А я сказал: сам отдам Лотару череп».~
@29430 = ~«Дай мне пройти, или я убью тебя на месте».~
@29431 = ~«Не хочешь сыра, Мантуок?» — протянуть ему отравленный сыр.~
@29432 = ~«Не хочешь сыра, Мантуок?»~
@29433 = ~«Лотар обещал мне безопасный проход. Будешь стоять на моём пути — он услышит об этом от меня или от моего черепа, если тебе удастся меня убить».~
@29434 = ~Отдать ему безымянный череп: «Вот, бери».~
@29435 = ~Отдать ему череп Харгримма: «Вот, бери».~
@29436 = ~Отдать ему череп Тухлой Мэри: «Вот, бери».~
@29437 = ~Отдать ему череп Акасты: «Вот, бери».~
@29438 = ~Отдать ему череп Соэго: «Вот, бери».~
@29439 = ~Отдать ему череп Безмолвного Короля: «Вот, бери».~
@29440 = ~«Его ожидание не продлится долго».~
@29441 = ~«Попробуй».~
@29442 = ~«Попробуй, Мантуок».~
@29443 = ~«Ах ты сукин…»~
@29444 = ~«Ах ты сукин…»~
@29445 = ~«Насколько знаю, все ваши преимущеста — жить в канализации, питаться отбросами и случайными трупами, чтобы выжить, и прикрывать яркими тряпками свои голые чешуйчатые хвосты. Вы паразиты, тени людей, безнадёжно мечтающие вернуть человечность. Жалкие твари».~
@29446 = ~«Ты не ровня мне».~
@29447 = ~«Лучше ты один, нежели с друзьями…»~
@29448 = ~«Вы для меня — всего лишь учебная мишень».~
@29449 = ~«Не терпится увидеть вашу попытку».~
@29450 = ~«Я выполняю поручение Лотара. Мне нужно добыть череп».~
@29451 = ~«Ищу, кто здесь главный».~
@29452 = ~«Я ищу моего друга Морте».~
@29453 = ~«Просто осматриваю достопримечательности».~
@29454 = ~Мировоззрение изменилось [Безымянный]~
@29455 = ~Этот старик что-то жуёт и тихо про себя бормочет. В какой-то миг предмет у него во рту лопается с громким *ХЛОП*, затем старик его проглатывает. Его густые грубые белые брови на мгновение морщатся, поднимаются и морщатся снова: «Хм-м-м…»~
@29456 = ~«Приветствую…»~
@29457 = ~Оставить его в покое.~
@29458 = ~Не глядя на тебя, мужчина лезет в карман на тунике, достаёт оттуда шарик золотисто-коричневого цвета, секунду осматривает его и с хрустом отправляет в рот.~
@29459 = ~«Я сказал „приветствую“…»~
@29460 = ~Оставить его в покое.~
@29461 = ~Мужчина хмурится и отмахивается от тебя, он кивает сам себе и кажется полностью погружённым в дегустацию того, что жуёт.~
@29462 = ~«У меня… кое-какие вопросы…»~
@29463 = ~Оставить его в покое.~
@29464 = ~Мужчина ухмыляется, потом делает в твою сторону неприличный жест… и внезапно застывает, как будто подавившись… его щёки надуваются, он натужно кашляет и наконец выплёвывает большую чёрную муху, которая, расправив крылья, начинает кружить по комнате. «*Проклятые* минаврозийские сласти!» — орёт он, грозя кулаком насекомому. Потом поворачивается к тебе: «Чего?!»~
@29465 = ~«Хотел спросить о тебе…»~
@29466 = ~«У меня вопрос об этом месте…»~
@29467 = ~«Что ты знаешь о Рейвел Клубок-Загадок?»~
@29468 = ~«Ничего, прощай».~
@29469 = ~Он с хрустом кладёт в рот небольшой красный леденец. «Ты что, всегда таскаешься и пристаёшь к могущественным магам с невежественной болтовнёй?! Болтовня, трёп, белиберда, АБРАКАДАБРА!» — на последнем слове леденец вылетает у него изо рта и шлёпается на пол. Он с грустью на тот взирает.~
@29470 = ~«Хм-м… мне жаль твой леденец».~
@29471 = ~Поднять его и съесть.~
@29472 = ~~
@29473 = ~Он с недоверием стонет и стучит себя по лбу: «Ничего? *ПРОЩАЙ*?»~
@29474 = ~«Он был такой *вкусный*», — хнычет мужчина. Неожиданно он смотрит на тебя и рычит. «ЖАЛЬ тебе?! Ещё бы тебе не *жалеть*, сраный жук навозный! Маги заслуживают уважения, а быдло вроде тебя должно знать своё место! — он даже подпрыгивает от ярости. — Знать своё место! Своё место!»~
@29475 = ~«Успокойся, я только хотел задать пару вопросов…»~
@29476 = ~Схватить леденец и съесть.~
@29477 = ~~
@29478 = ~Ты хватаешь леденец и начинаешь его грызть с нескрываемым аппетитом. Вкус у него пикантный и сладкий. У мага просто отпадает челюсть: «Мой… мой восхитительный изысканный леденец из байтопийских фруктов!»~
@29479 = ~«Неплохо. А ещё есть?»~
@29480 = ~«Успокойся, я только хотел задать пару вопросов…»~
@29481 = ~~
@29482 = ~~
@29483 = ~«Что?! *Ещё*?! Дьяволы мира, да у меня сейчас инфаркт будет от такой наглости! Кто… кто тебе сказал, что ты *заслуживаешь* ещё один леденец, невоспитанный наглый тупица?!»~
@29484 = ~«Я и не *заслуживаю*, я просто *хочу*. Ну же, давай его сюда».~
@29485 = ~«Да ладно тебе… просто дай мне ещё один».~
@29486 = ~«Забудь».~
@29487 = ~«Я тебе ничего не дам! И тебе это *понравится*! — он с хрустом бросает леденец себе в рот и застывает в восхищении. — М-м-м-м. *Ка-а-ак* вкусно». Он посасывает леденец и закатывает глаза в экстазе: «*Та-а-а-ак* восхитительно!»~
@29488 = ~«Я *хочу* ещё один, и ты *дашь* мне его. Ну же, давай его сюда».~
@29489 = ~«Ну ладно… забудь».~
@29490 = ~«Именно! Забыть! Забыть тебя, наглый пустоголовый придурок! Теперь исчезни!»~
@29491 = ~«Но… я хотел кое-что спросить…»~
@29492 = ~~
@29493 = ~«Да мне *НАЧХАТЬ*, ты, отвратительная невоспитанная тварь! — его глаза выкатываются из орбит, а палец упирается в тебя. — Теперь проваливай отсюда! ПОШЁЛ! ОТСЮДА! ВОН! И не возвращайся, пока не научишься оказывать уважение старшим… без даров не приходи!» Неожиданно он склоняется ближе и страстно шепчет: «Конфеты или шоколад было бы неплохо! Но ничего простенького, запомни, — только *экзотика*. Теперь исчезни!»~
@29494 = ~«Погоди… у меня тут есть импортный шоколад. Могу тебе его подарить…»~
@29495 = ~«Как ты *смеешь*, наглая скотина, *домогаться* моих сладостей, как будто это право даровано тебе высшими силами? Может, мне ещё *преклонить* колени по твоей прихоти, о Великий? Следует ли мне покрыть лучшие сласти амброзией и, упав к ногам твоего святейшества, смиренно просить принять их?!» Он топает ногой с каждым произнесённым словом: «Нет! Нет! Нет!»~
@29496 = ~«Да ладно тебе… просто дай мне ещё один».~
@29497 = ~«Ну и ладно. Забудь».~
@29498 = ~Физиономия мага всё более скисает по мере твоего приближения. «Невероятно! Ты что, решил отравить сладость моей жизни своим постоянным присутствием? Ты, болван вонючий! — он прерывается, чтобы съесть несколько маленьких драже. — О силы, молю вас, научите этого нахала хоть толике *манер*!»~
@29499 = ~«Я принёс тебе импортный шоколад в качестве подарка».~
@29500 = ~«Вообще-то у меня кое-какие вопросы».~
@29501 = ~«Мне пора идти».~
@29502 = ~«О? — он мгновенно сменяет гнев на милость. — Очень мило с твоей стороны, очень по-человечески! Можно взглянуть?»~
@29503 = ~Показать ему шоколадного квазита.~
@29504 = ~«Вообще-то нет».~
@29505 = ~«Не всё сразу. Прощай».~
@29506 = ~Он отшатывается, совершенно поражённый: «ЧТО?!»~
@29507 = ~«Я пошутил. Вот, держи…»~
@29508 = ~«Не думаю, что ты этого заслуживаешь. Ты был так груб».~
@29509 = ~«Принесу попозже. Пока».~
@29510 = ~«Ты… *что*? — его начинает потряхивать. — Невероятно! Нелепо! Смешно! *ГРУБО* было бы сначала превратить тебя в тарелку бааторианских пряных бобов, потом сожрать их и испортить воздух по всему Сигилу при помощи небольшого испускания кишечных газов! Вот *ЭТО* было бы действительно грубо, уверяю тебя. Я же был к тебе *крайне* добр!»~
@29511 = ~«В любом случае ты ничего не получишь, пока не извинишься».~
@29512 = ~«Я пошутил. Вот, держи…»~
@29513 = ~«Потом принесу. Прощай».~
@29514 = ~Он немедленно стихает, но подозрительно сверкает глазами: «Ты же, по крайней мере, дашь мне сначала *посмотреть* на свой подарок?»~
@29515 = ~Дать ему только взглянуть на шоколадного квазита.~
@29516 = ~«Да я просто шутил. Вот, бери…»~
@29517 = ~«Потом принесу. Прощай».~
@29518 = ~Ермолка мага с хлопком взлетает на несколько футов над его головой и приземляется обратно. «О… о боже. Это… это же?..» — он облизывает губы и жадно тянется к шоколадному квазиту.~
@29519 = ~«О нет. Извинись. Прямо сейчас».~
@29520 = ~«О нет. Извинись. Прямо сейчас».~
@29521 = ~Отдать ему шоколадного квазита.~
@29522 = ~«Потом принесу. Прощай».~
@29523 = ~Он кривит лицо, закусывает губу и молча потрясает кулаками. Наконец останавливается, смахивает с одежды ворсинку и медленно произносит: «Хорошо, сэр. Я извиняюсь». Ты замечаешь, что руку он держит за спиной.~
@29524 = ~«Хм-м. Хорошо, вот твой шоколадный квазит».~
@29525 = ~«Потом принесу. Прощай».~
@29526 = ~Он кривит лицо, закусывает губу и молча потрясает кулаками. Наконец останавливается, смахивает с одежды ворсинку и медленно произносит: «Хорошо, сэр. Я извиняюсь». Ты замечаешь, что руку он держит за спиной.~
@29527 = ~«Молчать, ты, болтливый… о! Я хочу сказать, ничего подобного!» — маг улыбается, с невинным выражением лица демонстрируя тебе руку.~
@29528 = ~«Хм-м. Хорошо, вот твой шоколадный квазит».~
@29529 = ~«Потом принесу. Прощай».~
@29530 = ~Он берёт у тебя шоколад. «О… какая редкость. И какой изысканный вкус… просто объедение», — он откусывает сразу большой кусок и прячет остатки в тунику.~
@29531 = ~«У меня были вопросы…»~
@29532 = ~«Хорошо. Прощай».~
@29533 = ~Он хмурит брови, слизывая шоколад с пальцев. «Кто тебе сказал, что меня можно беспокоить пустыми вопросами?! — он смотрит на тебя осуждающе. — Ладно же… говори… зачем ты меня беспокоишь… или исчезни!» Он достаёт из рукава хрустящие молочные шарики в шоколаде и начинает есть.~
@29534 = ~«Кто ты?»~
@29535 = ~«Я бы хотел приобрести кое-какие заклинания».~
@29536 = ~~
@29537 = ~«А можно конфет?»~
@29538 = ~Он закатывает глаза, помахивая тебе рукой, чтобы ты продолжал.~
@29539 = ~«Я хочу купить конфет».~
@29540 = ~«Что ты можешь рассказать мне об этом месте?»~
@29541 = ~«Что ты знаешь о Рейвел Клубок-Загадок?»~
@29542 = ~«Неважно. Прощай».~
@29543 = ~«Кто ты?»~
@29544 = ~«Я бы хотел приобрести кое-какие заклинания».~
@29545 = ~~
@29546 = ~«А можно конфет?»~
@29547 = ~«Я хочу купить конфет».~
@29548 = ~«Что ты можешь рассказать мне об этом месте?»~
@29549 = ~«Что ты знаешь о Рейвел Клубок-Загадок?»~
@29550 = ~«Неважно. Прощай».~
@29551 = ~«Я… Квелл, — он величественно поднимает руку, удерживая тебя от ответной любезности, — …и не утруждайся представлением, ты, должно быть, самое наглое и надоедливое существо на этой стороне Сигила, о каком мне когда-либо приходилось слышать!»~
@29552 = ~«Истинное *удовольствие* встретиться с тобой. Хвала силам, если не придётся долго ждать, пока твои похождения сведут тебя в могилу, избавив меня от мучительной необходимости тратить на тебя слова! Я с радостью обменял бы свои огромные магические силы на низшее заклинание, которое смогло бы привнести в твой толстый череп хоть капельку „манер“!»~
@29553 = ~«Манер? А как насчёт того шоколада, который я тебе принёс?»~
@29554 = ~«Огромные магические силы? А меня ты не мог бы подучить?»~
@29555 = ~«У меня ещё вопросы…»~
@29556 = ~«Это всё, что я хотел узнать. Прощай».~
@29557 = ~Он открывает рот, чтобы заговорить, поднимает руку с вытянутым пальцем, потом останавливается: «Хм-м. Тут ты прав, любезный». Он пожимает плечами и запускает в рот очередной леденец.~
@29558 = ~«Как я и думал. У меня ещё вопросы…»~
@29559 = ~«Именно. Прощай».~
@29560 = ~Похоже, он сбит с толку: «Я? Шляпа? Да что ты придуриваешься! Я не ношу шляп!» Он морщит губы и, сузив глаза, искоса бросает на тебя подозрительный взгляд.~
@29561 = ~«А что у тебя такое вокруг головы?»~
@29562 = ~«Нет, но у меня другие вопросы…»~
@29563 = ~«Неважно… прощай».~
@29564 = ~«Полный бред! У меня на голове нет ничего… ни-че-го. Да! И прошу, не возвращайся к этой теме, спасибо».~
@29565 = ~«Хм-м. У меня другие вопросы…»~
@29566 = ~«Неважно… прощай».~
@29567 = ~«Конфет?! И ещё раз, для лучшего восприятия: *конфет*?! Молю, ответь, что заставляет тебя думать, будто я *дам* конфету такому низкому дерзкому нахалу, как ты, а?» — он сердито топает ногой и ждёт твоего ответа со скрещеными на груди руками.~
@29568 = ~«А может, тогда *продашь*?»~
@29569 = ~«Забудь. У меня ещё вопросы…»~
@29570 = ~«Ничего. Прощай».~
@29571 = ~«Ну… я бы *мог*. Но должен тебя предупредить! Я не продаю обычных сладостей, а только шоколадки… *силы*!» — он растягивает последнее слово, жадно потирая руки…~
@29572 = ~«Шоколадки… силы?»~
@29573 = ~Он кивает: «Конечно. Они отнюдь не *дёшевы*, чтобы ты знал. Так что если у тебя нет денег, я рекомендую отстать от меня *немедленно*. Хочешь посмотреть, что у меня есть, а?» Он наклоняет голову и хитро на тебя смотрит.~
@29574 = ~«Да».~
@29575 = ~«Нет, но у меня ещё вопросы…»~
@29576 = ~«Нет, спасибо. Прощай».~
@29577 = ~«Ты находишься в Фестхолле, причём в качестве исключения… и это *огромное* исключение, что *тебя* протащили в… частный сенсориум. Поговори с мужчиной по имени Сплинтер, если у тебя ещё остались дурацкие вопросы об этом месте. Он находится в фойе Фестхолла».~
@29578 = ~«Позволь мне спросить кое о чём другом…»~
@29579 = ~«Это всё, что я хотел узнать. Прощай».~
@29580 = ~Как только ты упоминаешь её имя, он проглатывает леденец с громким *гульп*, вздрагивая от боли: «Что тут рассказывать?! Зачем? Такие вещи, такие истории лучше держать в пыльных книгах и на задворках памяти старцев! Зло, зло! Какое имя, какое имя… и сколь тёмные легенды роятся вокруг него, как мухи над трупом».~
@29581 = ~«И всё же я хочу, чтобы ты мне рассказал».~
@29582 = ~«Неважно, у меня были другие вопросы…»~
@29583 = ~«Забудь, что я спрашивал. Прощай».~
@29584 = ~Он закатывает глаза, бросая очередную конфету в рот: «Она — ночная ведьма, мальчик мой, которая пришла в Сигил…  средоточие зла и злобного смеха, вот кто она была, живущая магией теней и готовая к столкновению с Госпожой Боли. Чокнутая, чокнутая, чокнутая старая ведьма… добилась только заточения в лабиринт. Сейчас она, вероятно, мертва».~
@29585 = ~«Магия теней?»~
@29586 = ~«Как мне её найти?»~
@29587 = ~«Как мне её найти?»~
@29588 = ~«Лабиринт?»~
@29589 = ~«Госпожа Боли?»~
@29590 = ~«У меня другие вопросы…»~
@29591 = ~«Это всё, что я хотел узнать. Прощай».~
@29592 = ~«Да-да, да… — кажется, он говорит о ней крайне неохотно. — Рейвел занималась… нет, не занималась, скорее, *непревзойдённо* разбиралась во всех школах магии. Она знала магию теней, магию иллюзий и сущностей теней… теней, остающихся от мёртвых».~
@29593 = ~«Как мне её найти?»~
@29594 = ~«Как мне её найти?»~
@29595 = ~«У меня другие вопросы…»~
@29596 = ~«Это всё, что я хотел узнать. Прощай».~
@29597 = ~«Как тебе ЧТО?!» — конфета выкатывается у него прямо изо рта и падает на пол. Прежде чем ты успеваешь полюбоваться на неё, он хватает и бросает обратно в рот, неодобрительно поглядывая в твою сторону.~
@29598 = ~«Зачем… зачем ты об этом *спрашиваешь*? С *УМА* сошёл? Что тебе надо от такой злой твари?»~
@29599 = ~«Она что-то знает о моём прошлом».~
@29600 = ~«Неважно. Так что ты говорил о „магии теней“?»~
@29601 = ~«Забудь. У меня другие вопросы…»~
@29602 = ~«Забудь, что я спрашивал. Прощай».~
@29603 = ~«Сомнительно… она была заточена в лабиринт много веков назад. Она мертва, наверняка уже записана в книгу мёртвых. А даже если она каким-то, *каким-то* невероятным образом ещё цепляется за жизнь своими длинными чёрными кровавыми когтями, как ты думаешь, *возможно ли*, что она знает о *тебе*? Даже если бы она не была шипящим образом хихикающего зла, с чего бы ей даже *хотеть* тебе помочь?»~
@29604 = ~«Мне остаётся только надеяться, что она жива и захочет помочь».~
@29605 = ~«Забудь. У меня другие вопросы…»~
@29606 = ~«Забудь, что я спрашивал. Прощай».~
@29607 = ~«Во имя шести сисек Лиши и её вздутого живота, ты просто швыряешь горящую свечу своей надежды в воющие ветры Пандемониума! *Горит-горит-и-пши-ик!* Не будь большим дураком, чем тебе пристало!»~
@29608 = ~«Мне нужно найти её. И неважно, жива она или мертва».~
@29609 = ~«Забудь. У меня другие вопросы…»~
@29610 = ~«Забудь, что я спрашивал. Прощай».~
@29611 = ~«И что же ты собираешься делать, если она мертва, что вероятнее всего? Позволь спросить, каков твой план? Ты ведь всё рассчитал, не так ли? — Квелл просто плюётся словами. — Нонсенс, чушь! Что ты будешь *делать*, если она в книге мёртвых, а?»~
@29612 = ~«Не знаю, что-нибудь придумаю».~
@29613 = ~«А ты как думаешь, что мне делать?»~
@29614 = ~«Забудь. У меня другие вопросы…»~
@29615 = ~«Забудь, что я спрашивал. Прощай».~
@29616 = ~«О боги, боги, боги… это лучший план, какой я когда-либо слышал! Чистейший, ослепительно-белый гений мысли! Нет идей, как попасть в лабиринт, нет идей, как оттуда выйти, нет идей, если она мертва… и, естественно, нет идей, что делать, если она всё же жива. С тем же успехом я мог бы обсуждать всю эту безумную глупость, льющуюся из тебя, с лемуром!»~
@29617 = ~«Так ты расскажешь, как попасть в её лабиринт?»~
@29618 = ~«Забудь. У меня другие вопросы…»~
@29619 = ~«Забудь, что я спрашивал. Прощай».~
@29620 = ~«Помешанный! Безумец! Бестолочь! Неужели ты не услышал ни единого моего слова?! Она заключена в межпространственном *лабиринте* за попытку одолеть саму *ГОСПОЖУ БОЛИ*! Это значит, что она в десять раз более безумная, чем ты. И как минимум в сто раз более могущественная! А также, вероятнее всего, она мертва, мертва, мертва, трижды мертва, а… а если, по счастливой случайности, она жива… то мёртвым будешь *ты*!»~
@29621 = ~«Я понял, но мне действительно нужна твоя помощь. Ты расскажешь, как до неё добраться, или нет?»~
@29622 = ~«Забудь. У меня другие вопросы…»~
@29623 = ~«Забудь, что я спрашивал. Прощай».~
@29624 = ~Квелл молчит, покусывая губу. Спустя минуту он начинает шарить по складкам туники в поисках конфеты, затем бросает её в рот. «Ты серьёзно? Вот сейчас серьёзно? Почему так серьёзно, так по-бааторски, так упрямо? — он вздыхает. — Ладно, родился бестолочью — бестолочью и умрёшь».~
@29625 = ~«Да?..»~
@29626 = ~«Все лабиринты имеют порталы, это я *знаю* точно. Портал на вход, портал на выход… так Госпожа придаёт им форму. Я не знаю ни положения порталов, ни их внешний вид, но мне говорили, что ключом является… часть самой Рейвел».~
@29627 = ~«Часть Рейвел? Но если она ЗАТОЧЕНА в лабиринте, то как мне…»~
@29628 = ~«Тогда тебе придётся раздобыть. Попробуй найти что-нибудь, запятнанное Рейвел… это всё, что я знаю! Всё! И не беспокой меня больше этим! Если хочешь покапать кому-нибудь на мозги чем-то вроде этого, сходи в Бордель Безумной Интеллектуальной Страсти. Одна из местных дамочек наверняка связана с кем-то, кто сможет тебе помочь».~
@29629 = ~«Спасибо. У меня ещё вопросы…»~
@29630 = ~«Спасибо за помощь. Прощай».~
@29631 = ~«Первый блестящий вопрос за всё время разговора! Я? *Я* думаю, тебе лучше бросить свою дурацкую затею проникать в лабиринт, чтобы потрепаться с ночными ведьмами. Лучше всего для тебя — это вприпрыжку бежать в тот самый склеп, из которого ты вылез! В этом будет гораздо больше смысла, чем понапрасну злить Госпожу, уверяю».~
@29632 = ~«Так ты расскажешь, как попасть в её лабиринт?»~
@29633 = ~«Забудь. У меня другие вопросы…»~
@29634 = ~«Забудь, что я спрашивал. Прощай».~
@29635 = ~«*Подучить* тебя? Ха! Ты что, *маг*?»~
@29636 = ~«Да».~
@29637 = ~«Нет, но надеюсь, ты поможешь мне стать магом».~
@29638 = ~«Забудь. У меня другие вопросы…»~
@29639 = ~«Забудь, что я спрашивал. Прощай».~
@29640 = ~Он смеётся над тобой: «О-о-о, если бы я только знал заклинание Могучий Пинок под Зад Сапогом Бигби, чтобы скастовать его на тебя! НЕТ! Я, безусловно, *не стану* обучать тебя на мага, тебя, безмозглого невежду! Сделать это — значит унизить само Искусство!»~
@29641 = ~«Тогда у меня другие вопросы…»~
@29642 = ~«Тогда забудь. Прощай».~
@29643 = ~«Ох! Что ещё мультивселенная приготовила для тебя на сегодня, Квелл! Иди сюда, покажи свою книгу заклинаний».~
@29644 = ~Дать ему посмотреть.~
@29645 = ~«Нет, лучше я спрошу тебя ещё кое о чём».~
@29646 = ~«В другой раз. Прощай».~
@29647 = ~Он вырывает у тебя книгу и с яростью на неё пялится: «Что это ещё за мусор?! Говорю тебе, дрянь! Дрянь, дрянь, дрянь! Как ты вообще что-то читаешь с этих испачканных страниц… ты что, используешь её как подставку под кружку или выпивку пролитую промокаешь? Да на ней кровь, страницы склеились! Тебе что, наплевать на свою книгу заклинаний?! Как я вообще могу учить человека, который не уважает Искусство?!»~
@29648 = ~«Разве внешний вид имеет значение?»~
@29649 = ~«Я держу там свои заклинания. Её внешний вид не имеет никакого значения».~
@29650 = ~«Забудь. У меня другие вопросы…»~
@29651 = ~«Забудь, что я спрашивал. Прощай».~
@29652 = ~«Внешний вид твоей книги заклинаний должен отражать твоё уважение к содержащейся в ней силе. Эта дрянная маленькая книжонка подходит разве что для букваря! *Настоящие* заклинания должны быть записаны специальными дорогими чернилами на чистых листах веленевой бумаги острым золотым пером! Всё должно быть в надлежащем порядке, иначе лучше и не начинать! — он начинает прыгать, как сумасшедший. — Всё должно быть в полном порядке! В по-ряд-ке!»~
@29653 = ~«Ясно. Так ты меня научишь или нет?»~
@29654 = ~«Забудь. У меня другие вопросы…»~
@29655 = ~«Забудь обо всём. Прощай».~
@29656 = ~«Неслыханно! Абсурд! Где ты услышал такой смехотворный бред? Кто вообще *учил* тебя Искусству?»~
@29657 = ~«Меббет, повитуха с Площади Мусорщиков».~
@29658 = ~«Забудь. У меня другие вопросы…»~
@29659 = ~«Забудь обо всём. Прощай».~
@29660 = ~«Так пусть имена этих выскочек покроются позором на веки вечные за такую неописуемую ересь! Посмотри только на эти заклинания! Что за протухшим дерьмом они разбрасываются, грязная магия со знахарскими именами и трепотнёй мумбо-юмбо! Банальная, мелкая магия для зажигания свеч с помпезными именами!»~
@29661 = ~«Разве внешний вид имеет значение?»~
@29662 = ~«Забудь. У меня другие вопросы…»~
@29663 = ~«Забудь обо всём. Прощай».~
@29664 = ~Он закрывает глаза и некоторое время массирует виски. Наконец он говорит холодным голосом: «Очевидно, что я не буду учить тебя ничему. Однако у меня есть несколько заклинаний, которые ты можешь *приобрести*. Хочешь их посмотреть? М-м?»~
@29665 = ~«Да, конечно».~
@29666 = ~«Не сейчас. У меня были ещё вопросы…»~
@29667 = ~«Нет, спасибо. Прощай».~
@29668 = ~Квелл раздражённо смотрит, как ты приближаешься. «Проклятье! Нигде не спрятаться! — он громко вздыхает. — Что ж, выкладывай побыстрее! Что тебе *сейчас* от меня нужно, м-м?» Он бросает конфету в рот и выжидающе на тебя смотрит.~
@29669 = ~«У меня кое-какие вопросы…»~
@29670 = ~«Ничего, просто проходил мимо. Прощай».~
@29671 = ~Он мрачно кивает: «Госпожа Боли… она „управляет“ городом Сигилом, держит силы на расстоянии и всё такое прочее. Одно из наказаний, которое она припасла, — это заключение в лабиринт всех, кто переходит ей дорогу. Она отрезает кусок Сигила, закручивает его в петлю и отправляет незнамо куда вместе с обидчиком Госпожи, запертым внутри. И он пропал, пропал для планов навсегда!»~
@29672 = ~«Что ты говорил о „магии теней“?»~
@29673 = ~«Как мне её найти?»~
@29674 = ~«Как мне её найти?»~
@29675 = ~«У меня другие вопросы…»~
@29676 = ~«Это всё, что я хотел узнать. Прощай».~
@29677 = ~«Эй, шеф, он скрестил пальцы!»~
@29678 = ~Салабеш Оникс~
@29679 = ~Главарь головорезов~
@29680 = ~Головорез района Клерков~
@29681 = ~Немель~
@29682 = ~Эльвин~
@29683 = ~Посыльный~
@29684 = ~Посланник Джолми~
@29685 = ~Артист-лицедей~
@29686 = ~Артист-лицедей~
@29687 = ~Малманер~
@29688 = ~Предсказательница~
@29689 = ~Элобранда~
@29690 = ~Старый поэт~
@29691 = ~Пьяный повеса~
@29692 = ~Сархава Вьюл~
@29693 = ~Подхалим Сархавы~
@29694 = ~Тренирующийся маг~
@29695 = ~Привратник Фестхолла~
@29696 = ~Тренирующийся маг~
@29697 = ~Тренирующийся вор~
@29698 = ~Тренирующийся вор~
@29699 = ~Тренирующийся воин~
@29700 = ~Тренирующийся воин~
@29701 = ~Гид Чующих~
@29702 = ~Куратор галереи искусств~
@29703 = ~Игнорировать мужчину и осмотреть помещение.~
@29704 = ~«Хорошо. Чем могу быть полезен?»~
@29705 = ~«Прости, с тобой всё в порядке?»~
@29706 = ~«Прости, с тобой всё в порядке?»~
@29707 = ~«Ты в порядке?»~
@29708 = ~«Ты в порядке?»~
@29709 = ~«Мы встречались?»~
@29710 = ~«Так кто ты?»~
@29711 = ~«Так что это за место?»~
@29712 = ~«Ещё раз, кто такой адвокат?»~
@29713 = ~Слуга Вришики~
@29714 = ~«Можешь рассказать мне о наследстве?»~
@29715 = ~«Вот завещание Дейонарры, как и было обещано».~
@29716 = ~Прыщ~
@29717 = ~«Расскажи мне о пожаре».~
@29718 = ~Кильн~
@29719 = ~«Можешь рассказать мне о своей дочери?»~
@29720 = ~Настройки аудио~
@29721 = ~«Яннис, я узнал, что произошло с Дейонаррой».~
@29722 = ~Настройки игры~
@29723 = ~Привязка клавиш~
@29724 = ~«Пока ничем. Мне пора идти… прощай».~
@29725 = ~Ты видишь Янниса…  как только ты входишь, он поворачивается к тебе и пристально смотрит усталым взглядом. Под глазами у него тёмные мешки, он выглядит, словно давно не спал.~
@29726 = ~Полный экран~
@29727 = ~«Привет, Яннис».~
@29728 = ~Не обращать на него внимания.~
@29729 = ~«Опять ты, — Яннис слегка хмурится и пристально смотрит на тебя. — Чего ты теперь от меня хочешь?»~
@29730 = ~«У меня к тебе вопросы…»~
@29731 = ~«Ничего, спасибо».~
@29732 = ~Ты видишь Янниса… он поворачивается к тебе, и его глаза озаряет надежда: «А! Наконец-то! Ну как, тебе удалось убедить их предоставить мне доступ в сенсориум?»~
@29733 = ~«Да, тебе согласились дать доступ к камню чувств твоей дочери».~
@29734 = ~«Есть вопросы, на которые мне нужны ответы».~
@29735 = ~«Пока нет. Но я вернусь с новостями. Прощай».~
@29736 = ~Мужчина щурится, словно пытается тебя вспомнить: «Да? Чем могу быть полезен?»~
@29737 = ~«Кто ты?»~
@29738 = ~«Прости, зашёл не в ту дверь. Прощай».~
@29739 = ~«Я Яннис, — он рассматривает тебя и хмурится. — Ты меня искал?»~
@29740 = ~«Не знаю… что это за место?»~
@29741 = ~«Мои извинения… конечно, ты же упоминал об этом раньше. Возможно, ты поможешь мне ещё в одном вопросе?»~
@29742 = ~«Прости, зашёл не в ту дверь. Прощай».~
@29743 = ~«Как уже говорил, я Яннис. Тебе что-нибудь нужно?»~
@29744 = ~«Не уверен… что это за место?»~
@29745 = ~«Мои извинения… конечно, ты же упоминал об этом раньше. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29746 = ~«Прости, зашёл не в ту дверь. Прощай».~
@29747 = ~«Я адвокат, а это — моя контора, — в голосе Янниса появляются нотки раздражения. — Тебе нужна консультация? Если нет, возможно, лучше утолять любопытство где-нибудь в другом месте».~
@29748 = ~«Адвокат?»~
@29749 = ~«Адвокат?»~
@29750 = ~«Адвокат?»~
@29751 = ~«Прости, что побеспокоил. Прощай».~
@29752 = ~«Я адвокат. Это моя контора. Сюда приходят те, кому нужна консультация».~
@29753 = ~«Какого рода консультация?»~
@29754 = ~«Какого рода консультация?»~
@29755 = ~«Понял. Возможно, тогда ты поможешь мне в одном вопросе?..»~
@29756 = ~«Прости, что побеспокоил. Прощай».~
@29757 = ~Яннис всё больше хмурится. «Адвокат предоставляет консультации, помогает другим ориентироваться в лабиринте законов Сигила, улаживает дела о наследстве и разделе имущества после смерти, защищает в суде тех, кто был ложно обвинён… — он прерывается. — Тебя интересует что-то из этого?»~
@29758 = ~«Наследство?»~
@29759 = ~«Полагаю, у тебя есть для меня наследство».~
@29760 = ~«Я пришёл забрать наследство одной молодой женщины».~
@29761 = ~«Мне нужна консультация».~
@29762 = ~«Нет, не сегодня. Прощай».~
@29763 = ~«Адвокат помогает другим ориентироваться в лабиринте законов Сигила, улаживает дела о наследстве и разделе имущества после смерти, защищает в суде тех, кто был ложно обвинён… — он прерывается. — Тебя что-то из этого интересует?»~
@29764 = ~«Наследство?»~
@29765 = ~«Полагаю, у тебя есть для меня наследство».~
@29766 = ~«Я пришёл забрать наследство одной молодой женщины».~
@29767 = ~«Мне нужна консультация».~
@29768 = ~«Нет, не сегодня. Прощай».~
@29769 = ~«Это род соглашения, которое вступает в действие после смерти клиента. Оно указывает, как должно быть распределено имущество покойного. Своего рода последняя воля».~
@29770 = ~«А это похоже на договоры Пыльных?»~
@29771 = ~«Полагаю, у тебя есть для меня наследство».~
@29772 = ~«Я пришёл забрать наследство одной молодой женщины».~
@29773 = ~«Ясно. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29774 = ~«Это всё, что я хотел узнать. Прощай».~
@29775 = ~«О силы, нет! Договоры Пыльных, хотя и вступают в действие после смерти клиента, передают Пыльным только тело клиента. Не самый приятный бизнес, хотя некоторые бедняки подписывают подобные договоры ради средств к существованию».~
@29776 = ~«А можно каким-либо образом разорвать договор с Пыльными?»~
@29777 = ~«Прости… не объяснишь мне ещё раз, что такое наследство?»~
@29778 = ~«Ясно. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29779 = ~«Спасибо. Это всё, что я хотел узнать. Прощай».~
@29780 = ~Он слегка хмурится: «А что, у тебя есть подписанный? Если подпись поставлена, ничего или почти ничего не поделаешь. Договоры Пыльных весьма однозначно предписывают, как поступить с телом после смерти. Насколько я знаю, единственный способ разорвать договор — это физически уничтожить его».~
@29781 = ~«Ясно. Я что-нибудь должен за эту информацию?»~
@29782 = ~«Прости… не объяснишь мне ещё раз, что такое наследство?»~
@29783 = ~«Ясно. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29784 = ~«Спасибо. Это всё, что я хотел узнать. Прощай».~
@29785 = ~«В самом деле? Хорошо… ты помнишь, о каком именно наследстве идёт речь?»~
@29786 = ~«Наследство номер „51-АА“, я полагаю».~
@29787 = ~«Наследство молодой женщины под номером „687-КС“».~
@29788 = ~«Наследство молодой женщины под номером „687-КС“».~
@29789 = ~«Вообще-то не сейчас. Возможно, ты сможешь ещё кое-чем мне помочь…»~
@29790 = ~«Нет. Думаю, я ошибся. Не бери в голову».~
@29791 = ~Он удивлённо смотрит на тебя, как только ты называешь номер наследства. «Довольно старое дело… ты уверен?.. — его лицо выдаёт потрясение. — Я надеюсь, это не одно из тех, которые сгорели…»~
@29792 = ~«Насколько старое?»~
@29793 = ~«Сгорели?»~
@29794 = ~«Можешь проверить, сохранилось ли наследство?»~
@29795 = ~«Вообще-то не бери в голову. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29796 = ~«Наверное, я ошибся насчёт наследства. Неважно».~
@29797 = ~«Ну… — Яннис задумывается. — По крайней мере несколько десятков лет».~
@29798 = ~«Ты говорил, оно могло сгореть? Что ты имел в виду?»~
@29799 = ~«Можешь проверить, сохранилось ли наследство?»~
@29800 = ~«Вообще-то не бери в голову. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29801 = ~«Наверное, я ошибся насчёт наследства. Неважно».~
@29802 = ~Яннис выглядит грустным. «Да, несколько лет назад контора стала жертвой бессмысленного акта вандализма. Сюда вломились. Похоже, единственной целью было сжечь мои правовые документы. К огромной досаде, многое было утеряно. Сигил может быть весьма… жестоким испытанием веры… — при упоминании Сигила он будто бы становится на дюйм короче. — Вандал уничтожил только определённые документы. Незаменимые».~
@29803 = ~«Насколько старо наследство?»~
@29804 = ~«Можешь проверить, сохранилось ли наследство?»~
@29805 = ~«Можешь рассказать о пожаре что-нибудь ещё?»~
@29806 = ~«Вообще-то не бери в голову. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29807 = ~«Наверное, я ошибся насчёт наследства. Неважно».~
@29808 = ~Он кивает: «Да, конечно. Минутку…»~
@29809 = ~«Хорошо, я подожду».~
@29810 = ~«Вообще-то не бери в голову. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29811 = ~«Нет, думаю, я ошибся насчёт наследства. Не бери в голову».~
@29812 = ~Яннис возвращается и кивает: «Да, к счастью, оно было нетронуто огнём. Все статьи целы».~
@29813 = ~«Могу я его забрать? Я получатель».~
@29814 = ~«Вообще-то не бери в голову. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29815 = ~«Спасибо. Я всего лишь хотел посмотреть, цело ли оно. Прощай».~
@29816 = ~«Конечно… подпишись здесь и здесь… на пунктирной линии…»~
@29817 = ~«Здесь? И здесь? Хорошо…»~
@29818 = ~«И здесь, это последнее из канцелярской работы. Вот все вещи, что были в хранилище… эта бумага похожа на расписку из Кузницы, но вот только слишком старая, чтобы можно было сказать с уверенностью. Покойный заказывал что-то в Кузнице?»~
@29819 = ~«Я точно не знаю. Возможно… я уже начинаю думать, может иметь место всё что угодно. Где находится Кузница?»~
@29820 = ~«В Нижнем районе. Она за большими воротами. Как увидишь много стражи Боготов у ворот — знай, ты на месте».~
@29821 = ~«Хорошо. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29822 = ~«Спасибо. Я пойду».~
@29823 = ~«Я не из тех, кто берёт деньги за помощь такого рода… — он слегка улыбается. — Я адвокат, а не циничный торгаш, и жадности нет ходу в мой офис».~
@29824 = ~«Спасибо… я очень признателен. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29825 = ~«Спасибо. Прощай».~
@29826 = ~«Это… — его глаза удивлённо распахиваются, — …наследство моей *дочери*?!» Он выглядит ошеломлённым: «Откуда ты знаешь мою дочь?!»~
@29827 = ~«Не знаю. Надеюсь, бумага даст ответ».~
@29828 = ~«Это дело закона, а не твоё».~
@29829 = ~«Не твоё дело. Можешь проверить, существует ли оно ещё?»~
@29830 = ~«Наверное, я ошибся. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29831 = ~«Прости, это не то наследство. Извини за беспокойство… прощай».~
@29832 = ~«Зачем ей… — Яннис теряет дар речи. — Кто ты, сэр, что внесён в наследство моей дочери?»~
@29833 = ~«Возможно, я когда-то знал её… но забыл».~
@29834 = ~«Как уже сказал, я не знаю. Надеюсь, сама бумага даст ответ».~
@29835 = ~«Это дело закона, а не твоё».~
@29836 = ~«Не твоё дело. Можешь проверить, существует ли оно ещё?»~
@29837 = ~«Наверное, я ошибся. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29838 = ~«Прости, это не то наследство. Извини за беспокойство… прощай».~
@29839 = ~Яннис пристально вглядывается в твои черты: «Почему-то ты *кажешься* мне знакомым…»~
@29840 = ~«Ты знаешь, кто я?»~
@29841 = ~«Если у тебя сохранилось наследство, то оно может дать ответы на вопросы».~
@29842 = ~«Не будешь так добр принести мне наследство? Это вопрос закона, а не тема для дискуссии».~
@29843 = ~«Наверное, я ошибся. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29844 = ~«Прости, мне пора».~
@29845 = ~«Должен признать — нет», — Яннис вздыхает.~
@29846 = ~«Если у тебя сохранилось наследство, то оно может дать ответы на вопросы».~
@29847 = ~«Не будешь так добр принести мне наследство? Это вопрос закона, а не тема для дискуссии».~
@29848 = ~«Наверное, я ошибся. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29849 = ~«Прости, мне пора».~
@29850 = ~«Конечно, конечно… подожди минуту, я сейчас вернусь».~
@29851 = ~«Хорошо, подожду».~
@29852 = ~Яннис пристально смотрит на тебя минуту, затем сужает глаза. «Конечно, — его голос становится ледяным. — Если тебе не составит сложности немного подождать, я принесу наследство».~
@29853 = ~«Отлично».~
@29854 = ~«Все статьи согласно перечню…» — Яннис держит в руках три свитка. «Я даже не знал, что она оставила здесь наследство… — он смотрит на бумаги как загипнотизированный. — Вот. Могу я… могу я это прочитать, сэр?»~
@29855 = ~«Это дело *личное*, и как адвокат, ты должен меня понять».~
@29856 = ~«Дай я сначала сам прочитаю, а потом приму решение».~
@29857 = ~«Конечно. Держи».~
@29858 = ~«Конечно… — Яннис выглядит сокрушённым. — Но, пожалуйста, я умоляю тебя… у меня осталось так мало в память о дочери».~
@29859 = ~Ложь: «У тебя будет шанс почитать. Между тем у меня к тебе ещё одно дело…»~
@29860 = ~Клятва: «Обещаю, у тебя будет шанс почитать. Однако пока у меня к тебе ещё одно дело…»~
@29861 = ~«Я понимаю. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29862 = ~Ложь: «Я не забуду. Вернусь, как только прочитаю наследство».~
@29863 = ~Клятва: «Я не забуду. Вернусь, как только прочитаю наследство».~
@29864 = ~«Я понимаю. Прощай».~
@29865 = ~Яннис берёт свиток и некоторое время изучает его. После долгого молчания он поднимает глаза и говорит: «Ты… многое значил для моей дочери. Она была готова отдать тебе свою жизнь».~
@29866 = ~«Боюсь, так всё и случилось».~
@29867 = ~«Думаю, так всё и случилось».~
@29868 = ~Я согласился помочь старому психу из ночлежки, Нестору, найти его вилку. Бедняга явно совсем спятил, таскает в своём кармане оторванное ухо, говорит с ним, словно то может его слышать. Думаю, не будет вреда, если я найду для него эту вилку.~
@29869 = ~Я вернул Нестору вилку и помог ему вернуться домой. Таким образом, моя часть сделки с Арло выполнена. Теперь я могу отдыхать в ночлежке бесплатно.~
@29870 = ~Я выполнил просьбу Арло и избавился от Нестора. Владелец трущоб, похоже, был несколько шокирован способом, каким я разделался с психом, но всё же разрешил мне ночевать в ночлежке бесплатно.~
@29871 = ~Я позволил Яннису прочитать завещание Дейонарры. Похоже, её последние слова принесли ему некоторое утешение.~
@29872 = ~Я согласился помочь Арло, хозяину ночлежки, избавиться от сумасшедшего старика Нестора. Похоже, этот приятель решил обосноваться в ночлежке, и никто не может заставить его уйти.~
@29873 = ~Яннис отдаёт тебе свиток: «Спасибо, сэр. Я ценю твою доброту».~
@29874 = ~«Это наименьшее, что я мог для тебя сделать. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29875 = ~«Я глубоко скорблю о смерти твоей дочери. Надеюсь, тебе стало легче после того, как прочитал её записи. Прощай».~
@29876 = ~Мужчина некоторое время тебя изучает, хмуро задумавшись. Морщины на его лице красноречивей любых слов, и ты поражаешься, насколько же глубокий отпечаток забот наложило на него время. «Нет… однако ты кажешься знакомым…»~
@29877 = ~«Однако?..»~
@29878 = ~«Неважно. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29879 = ~«Не имеет значения, мне пора идти».~
@29880 = ~Он продолжает изучать твои черты, затем качает головой: «Должен заключить, что в твоих чертах лица есть что-то для меня знакомое, сэр. Заранее прошу у прощения за любые неудобства, которые могла причинить моя слабеющая память… у меня было много забот в последнее время. Не *встречались* ли мы раньше?»~
@29881 = ~Правда: «Думаю, да. Я и самого себя не могу полностью вспомнить».~
@29882 = ~Ложь: «Нет, я обознался. Мы никогда не встречались раньше».~
@29883 = ~«Забот?»~
@29884 = ~«Забот?»~
@29885 = ~«Забот?»~
@29886 = ~«Неважно. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29887 = ~«Не имеет значения, мне пора идти».~
@29888 = ~«Хм-м. К нашему обоюдному разочарованию, по-видимому».~
@29889 = ~«Неважно. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29890 = ~«Не имеет значения, мне пора идти».~
@29891 = ~«Хм-м. Ну что ж, хорошо».~
@29892 = ~«Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29893 = ~«Я должен идти. Прощай».~
@29894 = ~«Тут особо и нечего рассказывать… это был странный и очень небольшой пожар. Не могу сказать, что среди сгоревших документов было что-то очень ценное, но кто-то явно хотел, чтобы они были уничтожены».~
@29895 = ~«Возможно, я был в ответе за этот пожар».~
@29896 = ~«Возможно, я был в ответе за этот пожар».~
@29897 = ~«Хм… удалось выяснить, кто за это в ответе?»~
@29898 = ~«Удалось выяснить, кто за это в ответе?»~
@29899 = ~«Можешь сказать, что именно сгорело?»~
@29900 = ~«Ясно. Расскажи мне о своей дочери».~
@29901 = ~«Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29902 = ~«Я скорблю о твоей потере. Позволь откланяться. Прощай».~
@29903 = ~«Ты? Что ты имеешь в виду?»~
@29904 = ~Правда: «Возможно… возможно, пожар устроил я… в прошлом, когда был немного не в себе. Я сожалею, прости меня, если можешь».~
@29905 = ~Ложь: «Это было магическое воздействие, которое заставило меня поступить подобным образом. Я просто не отдавал себе отчёта в своих действиях».~
@29906 = ~«Прости, оговорился. Расскажи мне о твоей дочери».~
@29907 = ~«Прошу прощения, я ничего такого сказать не хотел. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29908 = ~«Неважно. Прощай».~
@29909 = ~«Нет… — лицо Янниса каменеет. — Я слышал отчётливо. Ты сказал, что в ответе за пожар. Почему ты заявляешь, что мог такое сотворить? Ты сошёл с ума?!»~
@29910 = ~Правда: «Возможно… возможно, пожар устроил я… в прошлом, когда был немного не в себе. Я сожалею, прости меня, если можешь».~
@29911 = ~Ложь: «Это было магическое воздействие, которое заставило меня поступить подобным образом. Я просто не отдавал себе отчёта в своих действиях».~
@29912 = ~«Никогда не повышай на меня голоса, а не то здесь вспыхнет такой пожар, который для кого-то может оказаться фатальным».~
@29913 = ~Лицо Янниса застывает в гримасе ярости: «Ты… *негодяй* из Сигила! Я давно хотел встретиться с тобой лицом к лицу! Ты нанёс ущерб моему дому и ценным вещам, которое служили для меня источником воспоминаний, а теперь ты, как ночной вампир, вылезаешь из своего логова и СМЕЕШЬ мне угрожать?»~
@29914 = ~Правда: «Возможно… возможно, пожар устроил я… в прошлом, когда был немного не в себе. Я сожалею, прости меня, если можешь».~
@29915 = ~Ложь: «Это было магическое воздействие, которое заставило меня поступить подобным образом. Я просто не отдавал себе отчёта в своих действиях».~
@29916 = ~Свернуть ему шею.~
@29917 = ~Свернуть ему шею.~
@29918 = ~Свернуть ему шею.~
@29919 = ~«Смею. И что ты намерен с этим делать, старик?»~
@29920 = ~Яннис уворачивается и отскакивает, затем начинает кричать: «Стража! Помогите! На меня напали!»~
@29921 = ~«Проклятье…»~
@29922 = ~Твои руки легко охватывают виски Янниса, и ты резко поворачиваешь его голову налево.~
@29923 = ~«У меня нет времени на твои нотации, старик».~
@29924 = ~Лёгкий треск, и тело Янниса обмякает в твоих руках.~
@29925 = ~«Покойся в мире…»~
@29926 = ~«Покойся в мире…»~
@29927 = ~К твоему удивлению, это действие было инстинктивным, как будто ты раньше делал это много раз… с этой мыслью происходит всплеск в памяти, но слишком слабый, что-либо уловить не выходит.~
@29928 = ~Оставить тело, уйти.~
@29929 = ~Яннис переходит на крик: «Стража! На помощь! Нападение! Помогите!»~
@29930 = ~«Проклятье…»~
@29931 = ~«Проклятье…»~
@29932 = ~«Но… — Яннис на время почти теряет дар речи. — Но… зачем? Многие вещи из тех, что сгорели… они были дороги для меня… незаменимы!»~
@29933 = ~«Похоже, один из этих документов или воспоминания, связанные с ним, были чем-то опасны для моего второго *я*. Не знаю, доберусь ли когда-нибудь до разгадки».~
@29934 = ~«По правде говоря, я не знаю».~
@29935 = ~«Второе я? О чём ты?»~
@29936 = ~«У меня… некое раздвоение личности: иногда я теряю над собой контроль и становлюсь как будто кем-то другим. Я совершенно неуправляем в эти моменты».~
@29937 = ~«По правде говоря, я не знаю».~
@29938 = ~Ложь: «Это было магическое воздействие, которое заставило меня поступить подобным образом. Я просто не отдавал себе отчёта в своих действиях».~
@29939 = ~«Не знаешь? Я что, разговариваю с ребёнком? Как ты можешь не осознавать, что делаешь?!»~
@29940 = ~«У меня… некое раздвоение личности: иногда я теряю над собой контроль и становлюсь как будто кем-то другим. Я совершенно неуправляем в эти моменты».~
@29941 = ~Ложь: «Это было магическое воздействие, которое заставило меня поступить подобным образом. Я просто не отдавал себе отчёта в своих действиях».~
@29942 = ~Яннис хмурится… минуту обдумывает твои слова, потом говорит: «Я слышал, что подобного рода магическое *обеты* можно наложить на человека… — на минуту он замолкает. — И ты *выбрал* путь принятия ответственности за это преступление…»~
@29943 = ~«Я просто прошу простить меня за преступление, которое совершил».~
@29944 = ~«Я всего лишь прошу прощения и готов загладить свою вину, если это будет в моих силах».~
@29945 = ~«Ну… не совсем принятия ответственности. В конце концов, я не мог контролировать свои действия».~
@29946 = ~Я солгал Яннису, что устроил пожар в его конторе, находясь под магическим воздействием. Он поверил моей лжи и сказал, что не держит на меня зла.~
@29947 = ~Яннис хмурится, глубоко задумавшись над твоими словами: «Я слышал о подобного рода казусах… временная амнезия в результате вторжения другой, подсознательной личности. Но ты всё же берёшь на себя ответственность за преступление…»~
@29948 = ~«Да, это похоже на мой случай. Как бы то ни было, прошу простить меня за то, что я совершил».~
@29949 = ~«Я всего лишь прошу прощения и готов загладить свою вину, если это будет в моих силах».~
@29950 = ~«Ну… не совсем беру ответственность. В конце концов, я не мог контролировать свои действия».~
@29951 = ~Я сказал Яннису, что принимаю на себя ответственность за пожар в его конторе, и попросил у него прощения. Яннис принял мои извинения и сказал, что не держит на меня зла.~
@29952 = ~«Я… — Яннис на секунду хмурится, после чего черты его лица расслабляются. — Здесь нечего прощать… Я давно уже примирился с моей потерей и не держу ни на кого зла. Документы, которые сгорели, в сущности, не представляли ценности».~
@29953 = ~«А что это были за документы?»~
@29954 = ~«В большинстве своём завещания о наследстве. И довольно старые».~
@29955 = ~«Завещания о наследстве?»~
@29956 = ~«Нет, ни Гармониуму, ни Убийцам Милосердия не удалось определить, кто это сделал».~
@29957 = ~«Возможно, я был в ответе за этот пожар».~
@29958 = ~«Возможно, я был в ответе за этот пожар».~
@29959 = ~«Можешь сказать, что именно сгорело?»~
@29960 = ~«Ясно. Расскажи мне о своей дочери».~
@29961 = ~«Очень жаль. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29962 = ~«Я скорблю о твоей потере. Позволь откланяться. Прощай».~
@29963 = ~«Некоторое количество старых завещаний о наследстве и ещё несколько сувениров и памятных подарков, которые имели ценность только для меня».~
@29964 = ~«Возможно, я был в ответе за этот пожар».~
@29965 = ~«Возможно, я был в ответе за этот пожар».~
@29966 = ~«Завещаний о наследстве?»~
@29967 = ~«Ясно. Расскажи мне о своей дочери».~
@29968 = ~«Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29969 = ~«Я скорблю о твоей потере. Позволь откланяться. Прощай».~
@29970 = ~«Ты должен меня простить. В последнее время у меня было много неприятностей… несколько прошлых лет определённо были для меня временем испытаний».~
@29971 = ~«Могу я чем-нибудь помочь?»~
@29972 = ~«Какого рода неприятности?»~
@29973 = ~«Ясно. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29974 = ~«Прости, что побеспокоил… надеюсь, твои дела пойдут на лад. Прощай».~
@29975 = ~«Нет-нет, здесь практически ничего нельзя предпринять, — он качает головой. — Но я, несомненно, благодарен за предложение. Спасибо».~
@29976 = ~«Возможно, тебе помогло бы излить душу и рассказать о своих неприятностях».~
@29977 = ~«Возможно, тебе помогло бы излить душу и рассказать о своих неприятностях».~
@29978 = ~«Возможно, тебе помогло бы излить душу и рассказать о своих неприятностях».~
@29979 = ~«Что за неприятности у тебя были?»~
@29980 = ~«Что за неприятности у тебя были?»~
@29981 = ~«Что за неприятности у тебя были?»~
@29982 = ~«Хорошо. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29983 = ~«Надеюсь, твои дела пойдут на лад. Прощай».~
@29984 = ~Яннис тяжело вздыхает: «Я не хотел бы отягощать тебя… не так давно я потерял свою дочь. Также был пожар… но это уже совершенно другая история».~
@29985 = ~«Расскажи мне о своей дочери».~
@29986 = ~«Расскажи мне о своей дочери».~
@29987 = ~«Пожар?»~
@29988 = ~«Ясно. Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29989 = ~«Я скорблю о твоей потере. Позволь откланяться. Прощай».~
@29990 = ~Яннис вздыхает: «Не хотелось бы отягощать тебя ещё больше… как уже говорил, не так давно я потерял свою дочь. Также был пожар… но это уже совершенно другая история».~
@29991 = ~«Расскажи мне больше о своей дочери».~
@29992 = ~«Расскажи мне больше о своей дочери».~
@29993 = ~«Пожар?»~
@29994 = ~«Пожалуй, ты можешь ещё кое-чем мне помочь…»~
@29995 = ~«Я скорблю о твоей потере. Позволь откланяться. Прощай».~
