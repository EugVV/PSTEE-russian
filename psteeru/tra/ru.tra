@19672 = ~Закл. <LEVEL>-го ур-ня~
@19673 = ~Опыт~
@19674 = ~Следующий уровень~
@19675 = ~Этот истекающий слюной желтоглазый упырь воняет кровью и падалью. Он ковыряется в кривых зубах длинными грязными когтями, постоянно нюхая воздух вокруг. Его кожа болезненно-зелёного цвета и покрыта гнойными, мокнущими язвами.~
@19676 = ~Упырь сужает глаза и рычит на тебя. Из его пасти выкатывается язык, по крайней мере в две ладони длиной…~
@19677 = ~Упырь не спускает с тебя голодного взгляда. Он сжимает и разжимает когтистые кулаки, словно борется с желанием прыгнуть на тебя и сожрать.~
@19678 = ~Он шипит на тебя: «Молчать, мяс-со! Не говорить! Я не с-слушать мясо-тварь! Я слышу только твоё сердце, кровь в твоих мясных жилах, сладкую, восхитительную кровь… вкусное, жирное мясо-сердце… — слюна капает из его пасти на пыльные камни пола. — МОЛЧАТЬ!»~
@19679 = ~Упырь шипит, как только ты подходишь: «Прочь! Уходи! Я не *говорить* с мясо-тварь, я не *слушать*, мяс-со! ИДТИ!»~
@19680 = ~Этот истекающий слюной желтоглазый упырь воняет кровью и падалью. Он ковыряется в кривых зубах длинными грязными когтями, постоянно нюхая воздух вокруг. Его кожа болезненно-зелёного цвета и покрыта гнойными, мокнущими язвами.~
@19681 = ~«Э-э… даже и не знаю, стоит ли тебе говорить с этим… существом».~
@19682 = ~«Некогда они были людьми… они или их предки пожирали трупы. И вот кем они стали. Мерзкие твари, шеф… теперь они скорее животные. *Опасные* животные».~
@19683 = ~«Приветствую…»~
@19684 = ~Оставить упыря в покое.~
@19685 = ~«У меня вопросы…»~
@19686 = ~«Пойду я, пожалуй. Счастливо оставаться».~
@19687 = ~«Успокойся и отвечай на мои вопросы».~
@19688 = ~«Тогда прощай».~
@19689 = ~«Тогда прощай».~
@19690 = ~Уйти.~
@19691 = ~«Почему нет, Морте?»~
@19692 = ~«Ну ладно, пошли».~
@19693 = ~Не обращать внимание на Морте и приветствовать упыря.~
@19694 = ~«Ну ладно, пошли».~
@19695 = ~«И всё же я поговорю с ним».~
@19696 = ~Эта упыриха воняет кровью и падалью. Черви и мелкие жучки кишат в её длинных волосах, свисающих сосульками на жёлтые глаза. Она смахивает волосы со лба ужасного вида когтями. Её кожа болезненно-зелёного цвета и покрыта гнойными, мокнущими язвами.~
@19697 = ~Упыриха сужает глаза и рычит на тебя. Из её пасти выкатывается язык, по крайней мере в две ладони длиной…~
@19698 = ~Упыриха не спускает с тебя голодного взгляда. Она сжимает и разжимает когтистые кулаки, словно борется с желанием прыгнуть на тебя и сожрать.~
@19699 = ~Она визжит на тебя: «Молчать, мясо! Не говорить! Я не с-слушать мясо-тварь! Я слышу только твоё сердце, кровь в твоих мясных жилах, сладкую, восхитительную кровь… вкусное, жирное мясо-сердце… — слюна капает из её пасти на пыльные камни пола. — МОЛЧАТЬ!»~
@19700 = ~Упыриха визжит, как только ты подходишь: «Прочь! Уходи! Я не *говорить* с мясо-тварь, я не *слушать*, мясо! ИДТИ!»~
@19701 = ~Эта упыриха воняет кровью и падалью. Черви и мелкие жучки кишат в её длинных волосах, свисающих сосульками на жёлтые глаза. Она смахивает волосы со лба ужасного вида когтями. Её кожа болезненно-зелёного цвета и покрыта гнойными, мокнущими язвами.~
@19702 = ~«Э-э… даже и не знаю, стоит ли тебе говорить с этим… существом».~
@19703 = ~«Некогда они были людьми… они или их предки пожирали трупы. И вот кем они стали. Мерзкие твари, шеф… теперь они скорее животные. *Опасные* животные».~
@19704 = ~«Это не совсем то же самое, шеф…»~
@19705 = ~«Приветствую…»~
@19706 = ~Оставить упыря в покое.~
@19707 = ~«У меня вопросы…»~
@19708 = ~«Пойду я, пожалуй. Счастливо оставаться».~
@19709 = ~«Успокойся и отвечай на мои вопросы».~
@19710 = ~«Тогда прощай».~
@19711 = ~«Тогда прощай».~
@19712 = ~Уйти.~
@19713 = ~«Морте, ты меня удивляешь… она же нежить, женщина. Тебе обычно больше ничего и не надо».~
@19714 = ~«Почему нет, Морте?»~
@19715 = ~«Ну ладно, пошли».~
@19716 = ~Не обращать внимание на Морте и приветствовать упыря.~
@19717 = ~«Ну ладно, пошли».~
@19718 = ~«И всё же я поговорю с ней».~
@19719 = ~Нет ни малейшего остатка мяса на костях этого старого оживлённого трупа… только несколько цветных тряпок, больше похожих на украшения, чем на одежду.~
@19720 = ~«И тебе привет», — спокойный, отстранённый голос исходит из черепа вместе с клубами пыли.~
@19721 = ~«Я отвечу, на какие смогу, — он говорит, а из сочленений челюсти сыплется песок. — Спрашивай, у нас достаточно времени на разговор».~
@19722 = ~«Это то, что мы называем Мёртвыми Народами… наша земля и дом. Мы глубоко под городом Сигил. Здесь всего лишь малая часть нашей цивилизации, граница… Мёртвые Народы простираются глубоко, глубоко во тьму».~
@19723 = ~«Это место неживых, владения Безмолвного Короля. Здесь живут зомби, а также упыри. Дальше к востоку — катакомбы черепокрыс. А иногда и живущие, такие, как Соэго, спускаются к нам».~
@19724 = ~Скелет медленно кивает, кости его шеи тихо скрипят: «Спрашивай».~
@19725 = ~Скелет кивает: «Мы — самые старые из нежити и наиболее свободные от плоти. Мы прикладываем все усилия, чтобы учить и наставлять других, поддерживаем здесь общественный порядок».~
@19726 = ~«Сильные, но медленные разумом и телом, они сохранили больше, чем мы, человеческого — свои эмоции. В нашем обществе они служат разнорабочими, а возглавляет их Тухлая Мэри — самая заботливая и сообразительная из них».~
@19727 = ~«Упыри — сильные, жестокие и вечно голодные создания, ведомые своим отвратительным матриархом Акастой. В Мёртвых Народах упыри служат в качестве охраны… но их поведение несколько нестабильно. Только страх перед Безмолвным Королём и численностью другой нежити держит их в узде. Без нашего могущественного повелителя, командующего упырями, мы… как и наши подопечные… наверняка пали бы пред ними».~
@19728 = ~«О ком ты хочешь спросить?»~
@19729 = ~«Наш повелитель и наставник. Его называют Безмолвным Королём, поскольку говорит он только в моменты крайней нужды, — скелет жестикулирует при разговоре, его старые суставы похрустывают. — Спроси о нём Харгримма, нашего верховного священника. Он расскажет тебе больше».~
@19730 = ~«Паразиты, чей интеллект растёт с увеличением их количества в непосредственной близости. В прошлом они доставили нам немало беспокойства, тревожа кости тихих, наших подопечных. Но ныне они не покидают восточной части катакомб. Упыри изловили и пожрали достаточное их количество, чтобы остановить мародёрство, хотя бы на время».~
@19731 = ~«Он в некотором роде миссионер Пыльных, хотел убедить нас сдаться перед лицом Истинной Смерти. Сейчас, насколько я понимаю, он один из наших подопечных».~
@19732 = ~«Он в некотором роде миссионер Пыльных, хочет убедить нас сдаться перед лицом Истинной Смерти. Сейчас его можно найти в церкви, что в северных пределах этих холодных, пыльных залов. Поговори с ним сам, если желаешь узнать больше».~
@19733 = ~«А что живущие делают там, в верхнем мире? Мы проживаем тут свои жизни в тишине тьмы. Мы работаем, охраняем покой наших подопечных, тихих, от грабительских действий других».~
@19734 = ~«Тихие… мёртвые, которые ничего не делают, лишь спят. Мы защищаем их, караулим их покой».~
@19735 = ~Скелет скрипит плечами, двигая их вверх-вниз: «Нет, не видел. Возможно, тебе стоит поговорить с Харгриммом. Он знает многое…»~
@19736 = ~Скелет скребёт подбородок, челюсть слегка трясётся вверх-вниз: «Упырям дозволено есть расхитителей гробниц. Но Безмолвный Король считает, что просто шатающихся тут нарушителей, вроде тебя, стоит отставлять томиться здесь в заключении, пока не попадут под наше попечение. Это лучше, чем если их сожрут упыри. Попробуй спросить нашего священника Харгримма — он лично общается с Безмолвным Королём».~
@19737 = ~Скелет кивает: «Станут нашими подопечными. Присоединятся к тихим».~
@19738 = ~«И снова приветствую. Уже освоил свой новый дом?»~
@19739 = ~«Многие, — он указывает по сторонам пожелтевшим, пыльным пальцем. — Голодные неуправляемые упыри, крысы, а больше всего — живущие. Слуги человека по имени Фарод из похороненной деревни часто спускаются сюда и тревожат покой тихих. Я не знаю зачем, да и неважно… но их мерзкое нашествие необходимо остановить».~
@19740 = ~Скелет грациозно кивает: «О ком?»~
@19741 = ~«Он наш верховный священник. Только он беседует с Безмолвным Королём и несёт нам слово и закон повелителя. Обычно он здесь, в преддверии тронного зала Безмолвного Короля».~
@19742 = ~«Она медлительна, но заботлива и мудра. Она как мать для всех зомби. Её можно найти в зале к западу от входа в Мёртвые Народы».~
@19743 = ~«Она матриарх стаи упырей, называющих себя Губители. Они служат Мёртвым Народам стражами и защитниками… пока что. Акаста присматривает за залом, где вход в земли Мёртвых Народов».~
@19744 = ~«Приветствую…»~
@19745 = ~ЧЕЛОВЕК~
@19746 = ~Человек~
@19747 = ~ВОИН~
@19748 = ~Воин~
@19749 = ~ВОР~
@19750 = ~МАГ~
