@37087 = ~Оружие не действует на цель [Безымянный]~ [NAM207]
@37088 = ~Оружие не действует на цель [Морте]~ [MRT453G]
@37089 = ~Оружие не действует на цель [Анна]~ [ANA560B]
@37090 = ~Оружие не действует на цель [Дак'кон]~ [DAK201]
@37091 = ~Оружие не действует на цель [Падшая Грейс]~ [FFG314]
@37092 = ~Оружие не действует на цель [Нордом]~ [NOR281]
@37093 = ~Оружие не действует на цель [Игнус]~ [IGN246]
@37094 = ~Оружие не действует на цель [Вейлор]~ [VHA253]
@37095 = ~Память восстановлена [Только Безымянный]~ [NAM077]
@37096 = ~Дневник обновлён [Только Безымянный]~ [NAM157]
@37097 = ~Маскировка снята~
@37098 = ~Надпись: «Наконец я тебя поймал. Больше ты не сможешь меня мучить, ведь ни один смертный не выберется из этих стен. Ищи ключи и раздели объятия смерти с каждым, кого найдёшь. Только тогда ты будешь свободен».~
@37099 = ~Шкаф~
@37100 = ~Ты видишь молодую женщину с бледной желтоватой кожей. Она занята осмотром товара на прилавке.~
@37101 = ~Она бросает на тебя взгляд через плечо, затем поворачивается лицом: «Ага, и тебя тоже. Чего хошь?»~
@37102 = ~Она выглядит несколько раздражённой, но награждает тебя улыбкой: «Чем смогу — помогу. Чего тебе надо знать?»~
@37103 = ~Её глаза расширяются, и она быстро рисует полукруг над сердцем. «Ничем не помогу. Ходят байки, он где-то в районе, но где — без понятия».~
@37104 = ~Она выглядит обеспокоенной: «Не-а, здоровяк. Нормальные люди избегают неприятностей. Не ходи его искать».~
@37105 = ~Секунду она хмурится, затем смотрит на тебя с тревогой: «Ага. Слыхала я, есть любители подобного, но я тут ничем не помогу».~
@37106 = ~Она погружается в раздумья, затем пожимает плечами: «Спроси у парня возле печи. Он большой любитель потрепаться. Может, он чего и слышал».~
@37107 = ~Она показывает в сторону прилавков: «Его продаёт Анзе. Тебе стоит поговорить с ним».~
@37108 = ~Она показывает в сторону прилавков: «Аалек имеет дело с Искусством. Тебе надо поговорить с ним»~
@37109 = ~Она хмурится: «Не хочу показаться грубой, но у меня нет времени на такие разговоры. Спроси парня возле печи. Он всё время болтает с незнакомцами».~
@37110 = ~Она поворачивается к тебе и улыбается: «Ещё раз добрый день, здоровяк. Чего надо?»~
@37111 = ~«Приветствую».~
@37112 = ~Не обращать на неё внимания.~
@37113 = ~«У меня пара вопросов…»~
@37114 = ~«Неважно, прощай».~
@37115 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@37116 = ~«У меня был череп, но его украли. Не знаешь, кто бы мог это сделать?»~
@37117 = ~«Где бы мне купить оружие?»~
@37118 = ~«Где бы мне купить магические принадлежности?»~
@37119 = ~«Неважно. Прощай».~
@37120 = ~«Не в курсе, кто может об этом знать?»~
@37121 = ~«Ладно. У меня есть ещё вопросы…»~
@37122 = ~«Прощай».~
@37123 = ~«Я хотел спросить о другом…»~
@37124 = ~«Прощай».~
@37125 = ~«Не в курсе, кто может об этом знать?»~
@37126 = ~«Я хотел спросить о другом…»~
@37127 = ~«Прощай».~
@37128 = ~«Я хотел спросить о другом…»~
@37129 = ~«Прощай».~
@37130 = ~«Я хотел спросить о другом…»~
@37131 = ~«Прощай».~
@37132 = ~«Я хотел спросить о другом…»~
@37133 = ~«Прощай».~
@37134 = ~«Хорошо. Прощай».~
@37135 = ~«У меня пара вопросов…»~
@37136 = ~«Прощай».~
@37137 = ~Ты видишь пожилую женщину, одетую в простые одежды. Её жёлтая кожа сморщилась от старости. Она со скучающим видом смотрит, как ты приближаешься.~
@37138 = ~«И тебе здравствуй, юноша. Что тебе нужно от старой Белле?»~
@37139 = ~Она хмурится, её лицо практически исчезает в морщинах. «Немного времени у меня найдётся, но поторапливайся».~
@37140 = ~«Лотар… не припоминаю такого имени. Ничем не могу помочь».~
@37141 = ~«Нет», — она качает головой и изображает на лице скуку.~
@37142 = ~«Пропавший череп… — она сухо смеётся. — Ну, не могу сказать, что когда-либо слышала подобное. Не знаю, что тебе сказать».~
@37143 = ~Она вздыхает: «Послушай, юнец. Я здесь за покупками, а ты не торговец. Понял, к чему клоню?»~
@37144 = ~«Что ж, у меня нет ответов. Всего хорошего», — она отворачивается.~
@37145 = ~Ты видишь пожилую женщину, одетую в простые одежды. Её жёлтая кожа сморщилась от старости. Она со скучающим видом смотрит, как ты приближаешься. «Зачем ты так настойчиво надоедаешь мне? Убирайся!» — она отворачивается.~
@37146 = ~«Приветствую».~
@37147 = ~Не обращать на неё внимания.~
@37148 = ~«У меня вопросы…»~
@37149 = ~«Ничего. Прощай».~
@37150 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@37151 = ~«У меня был череп, но его украли. Не знаешь, кто бы мог это сделать?»~
@37152 = ~«Не могла бы ты рассказать мне об этом районе?»~
@37153 = ~«Неважно. Прощай».~
@37154 = ~«Ясно. А не знаешь кого-нибудь, кто мог бы помочь?»~
@37155 = ~«Прощай».~
@37156 = ~«Я хотел спросить о другом…»~
@37157 = ~«Прощай».~
@37158 = ~«Ясно. А не знаешь никого, кто мог бы мне помочь?»~
@37159 = ~«Прощай».~
@37160 = ~«У меня другой вопрос…»~
@37161 = ~«Ясно. Прощай».~
@37162 = ~«Прощай».~
@37163 = ~Уйти.~
@37164 = ~Ты видишь привлекательную, хорошо одетую молодую женщину. Похоже, она прогуливается без цели, рассматривая различный товар.~
@37165 = ~Она оглядывает тебя с головы до ног и хмурится: «Я не разговариваю с сомнительными типами. Судя по твоему виду, ты прекрасно вписываешься в эту категорию. Проваливай, пень».~
@37166 = ~Её недовольство усиливается, она упирает руки в бёдра: «Мне плевать, пень. Отстань от меня, или я позову стражу!»~
@37167 = ~Она показывает тебе грубый жест: «Так и быть… Стража! Стража!»~
@37168 = ~Женщина поворачивается к тебе лицом и тут же узнаёт. Она хмурится: «Что нужно, чтобы ты отстал от меня, пень?»~
@37169 = ~Женщина показывает тебе грубый жест. «Не хочу я отвечать на твои идиотские вопросы. Поищи другую дурочку, — она отмахивается от тебя. — Теперь уходи, или я позову стражу!»~
@37170 = ~Женщина поворачивается к тебе лицом и тут же узнаёт. Она хмурится. «Что нужно, чтобы ты отстал от меня, пень? — она вздыхает и с отвращением вздымает руки. — Однажды я уже вызывала стражу. Ничто не помешает сделать это ещё раз… тем более, это приносит результат».~
@37171 = ~«Приветствую».~
@37172 = ~Не обращать на неё внимания.~
@37173 = ~«У меня вопросы…»~
@37174 = ~«Хорошо, прощай».~
@37175 = ~~
@37176 = ~~
@37177 = ~~
@37178 = ~Уйти до их появления.~
@37179 = ~«Ответь на пару вопросов…»~
@37180 = ~«Извини, уже ухожу. Прощай».~
@37181 = ~«Так зови…»~
@37182 = ~«Хорошо, прощай».~
@37183 = ~«Так зови…»~
@37184 = ~«Хорошо, прощай».~
@37185 = ~Ты видишь ничем не примечательную женщину. Она всего лишь один из покупателей на рынке.~
@37186 = ~Она поворачивается, заслышав твоё приветствие: «Да…»~
@37187 = ~Она со скукой смотрит на тебя: «Хорошо…»~
@37188 = ~«Никогда о нём не слышала. Я бы запомнила титул *Повелитель Костей*. Такое не забывают», — она продолжает смотреть скучающим взглядом.~
@37189 = ~Несколько секунд она смотрит на тебя в упор. «Потерял череп… ну что ж, такое не каждый день услышишь. Не знаю, что и сказать тебе», — она пожимает плечами.~
@37190 = ~Она бросает на тебя скучающий взгляд, затем вскользь оглядывает рынок: «Всё здесь, здоровяк. Просто потрать немного времени и спроси продавцов. Уверена, ты найдёшь, что тебе нужно».~
@37191 = ~Она вздыхает: «Не многое… но это единственный дом, который есть у меня или остальных местных. Приходится любить его, ведь покинуть не судьба».~
@37192 = ~Она поворачивается, заметив твоё приближение, и недовольно на тебя смотрит. «Я уже потратила на тебя своё время. Больше мне нечего тебе дать, здоровяк», — она отворачивается.~
@37193 = ~«Приветствую».~
@37194 = ~Не обращать на неё внимания.~
@37195 = ~«У меня вопросы…»~
@37196 = ~«Неважно».~
@37197 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@37198 = ~«У меня был череп, но его украли. Не знаешь, кто бы мог это сделать?»~
@37199 = ~«Где бы мне купить оружие?»~
@37200 = ~«Где бы мне купить магические принадлежности?»~
@37201 = ~«Что ты можешь мне рассказать об этом районе?»~
@37202 = ~«Неважно. Прощай».~
@37203 = ~«У меня к тебе ещё вопросы…»~
@37204 = ~«Прощай».~
@37205 = ~«У меня к тебе ещё вопросы…»~
@37206 = ~«Прощай».~
@37207 = ~«У меня к тебе ещё вопросы…»~
@37208 = ~«Прощай».~
@37209 = ~«У меня к тебе ещё вопросы…»~
@37210 = ~«Прощай».~
@37211 = ~Уйти.~
@37212 = ~Ты видишь молодого мужчину с бледной желтоватой кожей. Он занят осмотром товара на прилавке.~
@37213 = ~Он бросает на тебя взгляд через плечо, затем поворачивается лицом: «Ага, и тя тоже. Что надо?»~
@37214 = ~Он выглядит раздражённым, но всё же дружелюбно улыбается: «Чем смогу — помогу. Что хотел узнать?»~
@37215 = ~Его глаза расширяются, рука быстрым движением описывает полукруг над сердцем. «Тут я те не помощник. Болтали, он где-то в районе, но где — я без понятия».~
@37216 = ~Он выглядит обеспокоенным: «Не-а, здоровяк. Нормальные люди избегают проблем и даже не пытаются искать подобного рода вещи».~
@37217 = ~Секунду он хмурится, затем смотрит на тебя с тревогой: «Ага, слыхал я, кое-кому такое нравится, но я ничем не могу те помочь».~
@37218 = ~Он некоторое время думает, затем пожимает плечами: «Спроси Лазло, парня у печи. Он большой любитель потрепаться. Может, он что и слышал».~
@37219 = ~Он показывает в сторону прилавков: «Его продаёт Анзе. Тебе стоит с ним поговорить».~
@37220 = ~Он показывает в сторону прилавков: «Аалек имеет дело с Искусством. Поговори с ним».~
@37221 = ~Он хмурится: «Слушай, здоровяк, не хочу показаться грубым, но на такие базары у меня нет времени. Спроси Лазло, что у печи. Он всегда болтает с незнакомцами».~
@37222 = ~Он поворачивается в твою сторону и улыбается: «Ещё раз добрый день, здоровяк. Что надо?»~
@37223 = ~«У меня пара вопросов…»~
@37224 = ~«У меня пара вопросов…»~
@37225 = ~«У меня пара вопросов…»~
@37226 = ~«Приветствую».~
@37227 = ~Не обращать на него внимания.~
@37228 = ~«Неважно, прощай».~
@37229 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@37230 = ~«У меня был череп, но его украли. Не знаешь, кто бы мог это сделать?»~
@37231 = ~«Где бы мне купить оружие?»~
@37232 = ~«Где бы мне купить магические принадлежности?»~
@37233 = ~«Что ты можешь рассказать об этом районе?»~
@37234 = ~«Неважно. Прощай».~
@37235 = ~«Не в курсе, кто может об этом знать?»~
@37236 = ~«Ладно. У меня есть ещё вопросы…»~
@37237 = ~«Я хотел спросить о другом…»~
@37238 = ~«Прощай».~
@37239 = ~«Не в курсе, кто может об этом знать?»~
@37240 = ~«Я хотел спросить о другом…»~
@37241 = ~«Я хотел спросить о другом…»~
@37242 = ~«Прощай».~
@37243 = ~~
@37244 = ~«Я хотел спросить о другом…»~
@37245 = ~«Я хотел спросить о другом…»~
@37246 = ~«Прощай».~
@37247 = ~«Хорошо. Прощай».~
@37248 = ~«Прощай».~
@37249 = ~Ты видишь пожилого, просто одетого мужчину. Его бледная, жёлтая кожа сморщилась от старости. Со скучающим видом он смотрит, как ты приближаешься.~
@37250 = ~«Здравствуй и ты, юноша. Что тебе от меня нужно?»~
@37251 = ~Он хмурится, его лицо практически исчезает в морщинах: «Немного времени у меня есть, но поспеши».~
@37252 = ~«Лотар… не припомню такого имени. Ничем не могу помочь. Поспрашивай вокруг, кто-нибудь обязательно знает».~
@37253 = ~Он качает головой: «Нет. Мы простые люди и не суём свой нос в чужие дела». Он всем видом показывает, что ты ему надоел.~
@37254 = ~«Пропал череп… — он сухо смеётся. — Ну знаешь, не могу сказать, что я о таком слышал. Даже и не знаю, что тебе сказать».~
@37255 = ~Он вздыхает и глядит на тебя устало: «Послушай, юноша. Я тут за покупками, а ты на продавца не похож. Понял, к чему это я? Если нет, уходи!»~
@37256 = ~«Что ж, а у меня не будет ответов. Удачного дня», — он отворачивается.~
@37257 = ~Ты видишь пожилого, просто одетого мужчину. Его бледная, жёлтая кожа сморщилась от старости. Он со скучающим видом смотрит, как ты приближаешься. «Снова ты? Уходи!» — он отворачивается.~
@37258 = ~Уйти.~
@37259 = ~Ты слишком далеко, чтобы с точностью разглядеть этот объект.~
@37260 = ~«Приветствую».~
@37261 = ~Не обращать на него внимания.~
@37262 = ~«У меня кое-какие вопросы…»~
@37263 = ~«Ничего. Прощай».~
@37264 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@37265 = ~«У меня был череп, но его украли. Не знаешь, кто бы мог это сделать?»~
@37266 = ~«Не мог бы ты рассказать мне об этом районе?»~
@37267 = ~«Неважно. Прощай».~
@37268 = ~«Ясно. А не знаешь, кто мог бы мне помочь?»~
@37269 = ~«Прощай».~
@37270 = ~«Я хотел спросить о другом…»~
@37271 = ~«Прощай».~
@37272 = ~«Прощай».~
@37273 = ~«Ясно. А не знаешь никого, кто мог бы мне помочь?»~
@37274 = ~«У меня другой вопрос…»~
@37275 = ~«Ясно. Прощай».~
@37276 = ~«Прощай».~
@37277 = ~ЗАПРОС ПЫЛЬНОГО
Вес: 0

Заметка на куске сухого пергамента гласит:

«Свяжитесь с некромантом, отвечающим за оживление контрактного работника 42. Я знаю, он уже осматривал скелета, но я уверен, что первичное поднятие тела не было выполнено должным образом. Работник ещё реагирует на команды, но после выполнения задания он продолжает двигаться по одному и тому же замкнутому маршруту, как делал это раньше.

Дхалл недавно проинформировал меня, что работник 42 ходил по той же траектории, когда был зомби несколько десятилетий назад. Возможно, в нём ещё остались отголоски души или же из-за солидного возраста скелета магия, что его подняла, начала ослабевать. Один из Посвящённых предположил, что он может следовать приказу, данному ему в прошлом вышестоящим Пыльным, но я не нашёл никаких подтверждающих документов.

Какова бы ни была причина его поведения, проблему надо решить или заменить работника».~
@37278 = ~Это невидимое рубящее оружие для среднего существа уровня 1-3.~
@37279 = ~Это невидимое рубящее оружие для среднего существа уровня 1-3.~
@37280 = ~Это невидимое дробящее оружие для среднего существа уровня 1-3.~
@37281 = ~ДНЕВНИК СТРАХАНА
Вес: 1

Этот переплетённый в кожу том потрескался и поистёрся от времени. На его поверхности выжжено что-то вроде герба. Ты можешь разглядеть несколько сцепленных треугольников рядом с инициалами С. Р. Т. Письмена на страницах сильно потускнели, но несколько последних записей, похоже, были добавлены совсем недавно:

«2-й день 127-го года правления Фактола Хашкара:

Наконец-то я нашёл её! Пропавшая страница Гримуара Ап'тардж теперь в моих руках. Как я и думал, она содержит список необходимых компонентов для заклинания окончательного превращения. У меня есть всё компоненты, кроме одного. Капля крови бессмертного — это всё, что стоит между мной и вечной силой нежизни. Но где мне найти такую редкость? Наверное, я должен поискать ответ в предсказаниях.

14-й день 127-го года правления Фактола Хашкара:

После нескольких дней обременительных заклинаний предсказания я всё-таки получил ответ. Предсказание открыло мне, что я смогу найти бессмертного в древнем мавзолее, расположенном в районе Улья. Я должен поспешить. Надо найти это создание и добыть его кровь, прежде чем двигаться дальше.

15-й день 127-го года правления Фактола Хашкара:

Я добрался до мавзолея. На меня сразу же напал призрак, охраняющий останки тех, кто был здесь погребён. Я сумел ускользнуть от него и укрылся в том, что, по-видимому, является внутренним святилищем. Защита из простейших охранных заклинаний помогла предотвратить дальнейшее вмешательство в мои дела этого сверхъестественного олуха. Мне пришлось поднять нескольких местных усопших, чтобы они искали бессмертного. Если предсказание было верным и бессмертный действительно где-то здесь, то он, скорее всего, погребён в одном из множества склепов, тянущихся вдоль этих залов. Теперь это лишь вопрос времени.

17-й день 127-го года правления Фактола Хашкара:

Я тут не один. Кто-то проник в мавзолей и столкнулся с моими слугами. Может быть, это именно тот, кого я ищу? Предсказание лишь открыло мне, что я найду его здесь. Могло ли случиться так, что моё присутствие в этом месте и подтолкнуло того, кого я ищу, разыскивать МЕНЯ? Какой изумительный поворот, мне придётся…»

Чернила этой последней записи ещё не успели высохнуть.~
@37282 = ~Ты видишь высокого мужчину в латной броне. Доспехи у него необычной конструкции, со сверкающими шипами на плечах, локтях и предплечьях. Он кивает тебе, но продолжает блуждать глазами по рынку: «Добрый день, гражданин. Я стражник Корвус».~
@37283 = ~«Приветствую».~
@37284 = ~Не обращать на него внимания.~
@37285 = ~«Могу я чем-то помочь, гражданин?» — он смотрит на тебя приветливо, но временами поглядывает поверх твоего плеча.~
@37286 = ~«У меня кое-какие вопросы…»~
@37287 = ~«Не думаю. Прощай».~
@37288 = ~Он кивает: «Если это в моих силах, я помогу тебе, гражданин». Он выжидающе осматривает рынок.~
@37289 = ~«Кто ты?»~
@37290 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@37291 = ~«У меня был череп, но его украли. Не знаешь, кто бы мог это сделать?»~
@37292 = ~«Ты знаешь некоего Ленни?»~
@37293 = ~«Не знаешь человека по имени Байрон Пикит?»~
@37294 = ~«Ты знаешь, что на складе объявилось несколько анархистов?»~
@37295 = ~«Мне нужно приобрести оружие».~
@37296 = ~«Мне нужны магические товары».~
@37297 = ~Постараться понять, на что он смотрит.~
@37298 = ~Постараться понять, на что он смотрит.~
@37299 = ~Он отвешивает тебе лёгкий поклон. «Я Корвус, стражник Гармониума, гражданин. Помогаю поддерживать порядок на рынке», — он быстро оглядывается, затем смотрит на тебя.~
@37300 = ~«Расскажи мне о Гармониуме».~
@37301 = ~«Я хочу спросить о другом…»~
@37302 = ~«Наши убеждения просты: мы — свет. Мы — Путь. Мы — Порядок. Мы — Истина. Мы наводим и охраняем порядок здесь, в Сигиле. Мы патрулируем город», — он снова смотрит по сторонам.~
@37303 = ~«Что ты можешь рассказать о других фракциях?»~
@37304 = ~«Ясно. Я хотел спросить о другом…»~
@37305 = ~«Я мало о них знаю, гражданин. Прости меня, но тебе лучше задать этот вопрос их представителям», — он улыбается и оглядывает рынок.~
@37306 = ~«Я хочу спросить о другом…»~
@37307 = ~Он останавливается на тебе глазами и хмурится: «Я бы не советовал беспокоить Лотара, гражданин. Сомневаюсь, что тебе действительно стоит его искать».~
@37308 = ~«Почему?»~
@37309 = ~«И всё же мне нужно его найти».~
@37310 = ~«Ясно. У меня другие вопросы…»~
@37311 = ~«Тогда прощай».~
@37312 = ~Он хмурит брови, вглядываясь вдаль. «Я реалист и к тому же офицер Гармониума, гражданин. Как реалист я понимаю, что существуют те, кто выше закона. Такова суровая правда жизни», — он прерывается.~
@37313 = ~«Продолжай».~
@37314 = ~«Некоторые не боятся закона, так как имеют обширные связи в этом городе. Другие — из-за их огромной силы и страха, который они внушают людям. Лотар — это сила, с которой стоит считаться, гражданин. Он недосягаем, пойми мои слова правильно».~
@37315 = ~«И всё же мне нужно его найти».~
@37316 = ~«Ясно. У меня другие вопросы…»~
@37317 = ~«Тогда прощай».~
@37318 = ~Он вздыхает и окидывает взглядом рынок. «Хорошо, гражданин. Он живёт в разрушенном доме к югу отсюда. Удачи тебе».~
@37319 = ~«У меня к тебе ещё пара вопросов…»~
@37320 = ~«Спасибо. Прощай».~
@37321 = ~Минуту он пристально смотрит на тебя и наконец отвечает: «Это похоже на одну из проделок Лотара, Повелителя Костей».~
@37322 = ~«Где мне найти этого „Лотара“?»~
@37323 = ~«Поговори с Анзе, гражданин. Он сможет тебе помочь. Он прямо за печью».~
@37324 = ~«У меня ещё кое-какие вопросы…»~
@37325 = ~«Спасибо. Прощай».~
@37326 = ~«Тебе нужно поговорить с Аалеком, гражданин. Он сможет тебе помочь. Он на другом конце рынка».~
@37327 = ~«У меня ещё кое-какие вопросы…»~
@37328 = ~«Спасибо. Прощай».~
@37329 = ~Ты оглядываешься и замечаешь Карину, гуляющую неподалёку. Корвус, кажется, не спускает с неё глаз.~
@37330 = ~«Её зовут Карина».~
@37331 = ~Не обращать внимания.~
@37332 = ~Он отрывается и переводит взгляд на тебя: «Прости, гражданин, ты её знаешь?» Он снова смотрит на Карину: «Такая прекрасная молодая особа с ангельским голоском…»~
@37333 = ~«Да, к тому же она одинока… я уверен, она будет рада познакомиться с джентльменом…»~
@37334 = ~«Конечно. Я почти уверен, что все её ухажёры говорят то же самое…»~
@37335 = ~«У меня к тебе ещё вопросы…»~
@37336 = ~Его взгляд перескакивает на тебя, затем снова на Карину. «Подожди минутку, гражданин», — он обходит тебя и направляется к Карине.~
@37337 = ~«Помни, что жизнь — это не просто страдания, а экзамен, который надо выдержать».~
@37338 = ~«Вселенная — это учебная аудитория».~
@37339 = ~«Во всех нас есть искра божья».~
@37340 = ~«Хорошо обращайся со своими близкими — однажды они могут стать богами».~
@37341 = ~«Сколько предложишь за этого прекрасного слугу?»~
@37342 = ~«Хорошо».~
@37343 = ~Корвус возвращается к тебе, широко улыбаясь. «Спасибо, друг. Удивительная девушка…» — его глаза немного затуманены.~
@37344 = ~«На здоровье, у меня к тебе пара вопросов…»~
@37345 = ~«Прощай, Корвус».~
@37346 = ~Он вздыхает и переключает внимание на тебя. Выглядит он сейчас не очень-то счастливым. «Ты что-то говорил, гражданин?»~
@37347 = ~«Я хотел задать тебе пару вопросов…»~
@37348 = ~Ты видишь Корвуса, стражника Гармониума. «Ещё раз здравствуй, гражданин. Чем могу служить?» — он смотрит поверх твоего плеча, как будто кого-то ищет.~
@37349 = ~«У меня кое-какие вопросы…»~
@37350 = ~Постараться понять, на что он смотрит.~
@37351 = ~Постараться понять, на что он смотрит.~
@37352 = ~«Я узнал, что у Карины никого нет. Думаю, она будет рада познакомиться с джентльменом…»~
@37353 = ~«Думаю, ничем. Прощай».~
@37354 = ~Ты оглядываешься и замечаешь молодую женщину, прогуливающуюся по рынку. Корвус, кажется, не сводит с неё глаз.~
@37355 = ~«У меня кое-какие вопросы…»~
@37356 = ~«Ты выглядишь довольно занятым. Кого ты выглядываешь?»~
@37357 = ~Ты видишь стражника Гармониума. Он выглядит очень расстроенным и еле контролирует себя: «Прости меня, гражданин. Я не могу с тобой разговаривать в этот раз… я переживаю тяжёлую утрату и хочу, чтобы меня оставили одного».~
@37358 = ~Уйти.~
@37359 = ~Ты видишь Корвуса, стражника Гармониума. Он выглядит очень расстроенным и еле контролирует себя: «Прости меня, гражданин. Я не могу с тобой разговаривать в этот раз… я переживаю тяжёлую утрату и хочу, чтобы меня оставили одного».~
@37360 = ~Уйти.~
@37361 = ~Ты видишь Корвуса, стражника Гармониума. Он улыбается, завидев твоё приближение, и отвешивает тебе лёгкий поклон: «Здравствуй, друг. Надеюсь, у тебя всё хорошо».~
@37362 = ~«У меня кое-какие вопросы…»~
@37363 = ~«Как дела у вас с Кариной?»~
@37364 = ~«Мне пора идти. Прощай».~
@37365 = ~Он широко улыбается: «У нас всё хорошо, спасибо. Я твой должник, друг».~
@37366 = ~«У меня кое-какие вопросы…»~
@37367 = ~«Рад был помочь. Прощай».~
@37368 = ~Он задумчиво хмурится: «Ленни… да, я знаю вора с таким именем. Обычно его можно найти около осадной башни».~
@37369 = ~«Что ты можешь о нём рассказать?»~
@37370 = ~«Что ты можешь о нём рассказать?»~
@37371 = ~«Спасибо. Мне нужно идти, прощай».~
@37372 = ~Надпись: Какая бы малость ни осталась от моей жизни, она вытекает из тела сквозь эту дыру. Мир может гореть, планы могут гореть, только отдайте мне жизнь! Я зверски уничтожу эту жизнь, разорву её на куски, раздавлю, утоплю в крови так, что и вы не сможете ей жить! Гори мир, гори вселенная, ведь я не могу умереть!~
@37373 = ~«Официально — ничего, — на мгновение он задумывается, затем продолжает. — Неофициально — он вор; хороший вор, можно сказать, профессионал. Хотя он и вор, у него есть нравственные принципы: ни разу он не был заподозрен в убийстве или разбое. Ему неоднократно удавалось уйти от закона…» Он замолкает.~
@37374 = ~«Что-нибудь ещё?»~
@37375 = ~«У меня другие вопросы…»~
@37376 = ~«Спасибо. Мне нужно идти, прощай».~
@37377 = ~«Да… можно не бояться повернуться спиной к Ленни. Такое я могу сказать об очень немногих, но Ленни — один из них, — он пожимает плечами. — Это всё, друг».~
@37378 = ~«У меня другие вопросов…»~
@37379 = ~«Спасибо. Мне нужно идти, прощай».~
@37380 = ~Он хмурится и кивает головой: «Да, я знаком с Байроном».~
@37381 = ~«Что ты можешь о нём рассказать?»~
@37382 = ~«Что ты можешь о нём рассказать?»~
@37383 = ~«У меня есть доказательства того, что он причастен к преступлениям в Сигиле».~
@37384 = ~«Спасибо. Мне нужно идти, прощай».~
@37385 = ~«Официально — ничего, — на мгновение он задумывается, затем продолжает. — Неофициально — подозревают, что он стоит за всеми преступлениями на рынке. Мы считаем его виновным в убийстве купца по имени Зак. Список преступлений, в которых его подозревают, очень велик». Он замолкает.~
@37386 = ~«Что-нибудь ещё?»~
@37387 = ~«У меня есть доказательства того, что он причастен к преступлениям в Сигиле».~
@37388 = ~«У меня есть ещё вопросы…»~
@37389 = ~«Спасибо. Мне нужно идти, прощай».~
@37390 = ~НАСТРОЙКА АВТОПАУЗЫ~
@37391 = ~Корвус говорит, что никогда не повернётся спиной к Байрону Пикиту и не останется с ним наедине.~
@37392 = ~«Да… я бы никогда не повернулся спиной к Байрону Пикиту и несколько раз бы подумал, прежде чем остаться с ним один на один, — он пожимает плечами. — Это всё, друг».~
@37393 = ~«У меня есть доказательства того, что он причастен к преступлениям в Сигиле».~
@37394 = ~«У меня другие вопросы…»~
@37395 = ~«Спасибо. Мне нужно идти, прощай».~
@37396 = ~Он строго на тебя смотрит. «Всё, что я знаю об этом человеке, — дело Гармониума, гражданин. Я не могу обсуждать такого рода дела с незнакомцами. Возможно, если я узнаю тебя получше…»~
@37397 = ~«У меня другие вопросы…»~
@37398 = ~«Спасибо. Мне нужно идти, прощай».~
@37399 = ~Он смотрит на тебя с интересом: «Можно ознакомиться с этими доказательствами?»~
@37400 = ~Дать ему бумаги.~
@37401 = ~Дать ему бумаги.~
@37402 = ~«Дай мне сначала подумать. У меня кое-какие вопросы…»~
@37403 = ~Я дал Корвусу, стражнику Гармониума, доказательство причастности Байрона Пикита к преступлениям. Он арестовал Байрона и обещал проследить, чтобы того должным образом судили.~
@37404 = ~Корвус тщательно изучает бумаги, складывает их и прячет. Затем с улыбкой кивает тебе. «Прекрасная работа, гражданин. Эти документы содержат множество подробностей. Я лично прослежу, чтобы Байрон Пикит предстал перед судом, — он отдаёт тебе честь и уходит. — Скоро вернусь».~
@37405 = ~«Хорошо».~
@37406 = ~Он возвращается, широко улыбаясь. «Дело сделано. Пикит уже в тюрьме. Доказательства представлены суду, и скоро состоится слушание, — он отвешивает тебе лёгкий поклон. — Благодарю ещё раз».~
@37407 = ~«Рад был помочь. У меня к тебе кое-какие вопросы…»~
@37408 = ~«Спасибо. Мне нужно идти. Прощай».~
@37409 = ~Надпись: «Я знаю, ты чувствуешь себя так, будто нахлебался мутных вод Стикса, но тебе нужно собраться. Кто-то пытается окончательно записать тебя в книгу мёртвых. Важно узнать, почему они хотят это сделать. Если ты сейчас читаешь это, значит, я потерпел неудачу. Теперь дело за тобой.

Часть того, что ты здесь прочтёшь, будет трудно переварить. И не важно, насколько запутанным это может казаться, тебе нужно делать так, как я говорю. Среди твоих вещей есть дневник, который прольёт немного света на это тёмное дело. Фарод расскажет тебе всё остальное, если он, конечно, ещё не попал в книгу мёртвых.

Не потеряй свой дневник, иначе мы снова погрузимся в воды Стикса, понял? И поверь, что бы ты ни делал, никогда никому не говори, кто ты и что с тобой случилось или откуда ты пришёл, иначе они устроят тебе скорое паломничество в крематорий на стихийный план Огня».~
@37410 = ~На этом экране можно настроить обратную связь во время игры. Выбор настройки покажет её описание.~
@37411 = ~Этот ползунок управляет количеством отображаемых маркеров персонажей. Маркер — это цветной круг, находящийся под ногами каждого персонажа.~
@37412 = ~Ты видишь высокого мужчину в латной броне. Доспехи у него необычной конструкции, со сверкающими шипами на плечах, локтях и предплечьях. При твоём приближении он кивает: «Доброго дня, гражданин».~
@37413 = ~«Приветствую».~
@37414 = ~Не обращать на него внимания.~
@37415 = ~«Чем могу помочь, гражданин?» — он приветливо смотрит на тебя.~
@37416 = ~«У меня кое-какие вопросы…»~
@37417 = ~«Думаю, ничем. Прощай».~
@37418 = ~Он улыбается: «Конечно, гражданин».~
@37419 = ~«Кто ты?»~
@37420 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@37421 = ~«У меня был череп, но его украли. Не знаешь, кто бы мог это сделать?»~
@37422 = ~«Мне нужно приобрести оружие».~
@37423 = ~«Мне нужны магические товары».~
@37424 = ~Он отвешивает тебе лёгкий поклон: «Я стражник Гармониума Дриксель, гражданин. Слежу за порядком на рынке».~
@37425 = ~«Расскажи мне о Гармониуме».~
@37426 = ~«У меня другой вопрос…»~
@37427 = ~Он доволен уделённым ему вниманием. «Наши убеждения просты: мы — свет. Мы — Путь. Мы — Порядок. Мы — Истина, — его выражение лица ожесточается. — У меня даже не возникало вопроса о том, к кому присоединиться. Понимаешь, некоторые пни говорят о сражении с хаосом, восстановлении порядка и мира, но у них ни на что подобное духу не хватит. А мы, Гармониум, действуем. Поддерживаем порядок на улицах Сигила и на планах». Он многозначительно кивает тебе.~
@37428 = ~«Продолжай».~
@37429 = ~«Ясно. Я хотел спросить о другом…»~
@37430 = ~Его прямо раздувает от гордости с каждым словом: «И порядок мы поддерживаем не с помощью слов. Мы сражаемся, и жестоко сражаемся ради сохранения и установления порядка. Чёрные торговцы, рыцари наживы, Индепы, Анархисты, Хаоситекты, изверги танар'ри… всем лучше остерегаться Гармониума. Хаос может существовать только там, где его терпят!»~
@37431 = ~«Что ты можешь сказать о других фракциях?»~
@37432 = ~«Ясно. Я хотел спросить о другом…»~
@37433 = ~Он пожимает плечами с выражением скуки на лице: «Ничего. Они не являются частью Истины, как Гармониум. Я ими не интересовался».~
@37434 = ~«У меня другой вопрос…»~
@37435 = ~Он ошарашенно на тебя смотрит, собирается что-то сказать, останавливается, заговаривает снова: «А, ну… никто точно не знает, где Лотар, гражданин. Он не нарушил ни одного известного нам закона, поэтому Гармониум его не беспокоит… советую и тебе поступить так же».~
@37436 = ~«Почему?»~
@37437 = ~«И всё же мне нужно его найти».~
@37438 = ~«Ясно. У меня другой вопрос…»~
@37439 = ~«Тогда прощай».~
@37440 = ~Он смотрит на тебя раздражённо: «Потому что, пень. Не стоит связываться с настолько могущественным, как Лотар, без хорошей на то причины и поддержки множества друзей! Вот почему».~
@37441 = ~«И всё же мне нужно его найти».~
@37442 = ~«Ясно. У меня другой вопрос…»~
@37443 = ~«Тогда прощай».~
@37444 = ~Он долго смотрит на тебя, прежде чем ответить: «Хорошо. Ты найдёшь вход в его жилище в старом разрушенном здании, здесь, в районе». Его взгляд уже не столько на тебе останавливается, сколько словно проходит сквозь.~
@37445 = ~«Спасибо. У меня другие вопросы…»~
@37446 = ~Он долго смотрит на тебя, прежде чем ответить: «Похоже, здесь приложил руку Лотар, Повелитель Костей». Он нервно оглядывается вокруг и тихо говорит: «Ну, не сам Лотар, а кто-то из его приспешников. Лотар старается не пачкать рук».~
@37447 = ~Определяет частоту появления стрелок, указывающих направление нахождения персонажа. Стрелка появляется на экране, когда один из членов группы получает урон или находится за пределами обозримого экрана и его портрет выделен.~
@37448 = ~«Где мне найти этого „Лотара“?»~
@37449 = ~Он обводит рукой рынок: «На рынке много купцов, гражданин. Ты найдёшь у них всё, что тебе нужно».~
@37450 = ~«Я хотел спросить о другом…»~
@37451 = ~Надпись: очень важно записывать свои путешествия, чтобы чему-нибудь научиться. Но ещё важнее, чтобы те источники информации, которые ты используешь, чтобы открыть эту тайну, сразу после их открытия были защищены. Если основные фигуры, документы и предсказания каким-то образом были разрушены смертью или какой-либо иной силой, тогда ты никогда не узнаешь, кто ты и как дошёл до такой жизни.~
@37452 = ~«Спасибо, прощай».~
@37453 = ~Определяет, будут ли во время боя отображаться текстовые сообщения бросков атаки.~
@37454 = ~Дриксель отвешивает тебе лёгкий поклон: «Ещё раз добрый день, гражданин. Чем могу служить?»~
@37455 = ~«У меня кое-какие вопросы…»~
@37456 = ~«Неважно. Прощай».~
@37457 = ~Определяет, будут ли отображаться на экране во время боя другие сообщения, например, модификаторы ударов в спину, иммунитет к оружию и критические удары.~
@37458 = ~Определяет, будет ли отображаться на экране сообщение при произнесении персонажем заклинания.~
@37459 = ~«Спасибо. Прощай».~
@37460 = ~Определяет, будет ли отображаться на экране прочие текстовые сообщения, относящиеся состоянию персонажа, такие как урон и определение мировоззрения.~
@37461 = ~Надпись: Я подозреваю, что мы будем продолжать умирать и рождаться, пока не достигнем правильной жизни. Хотя я не знаю, что я должен для этого сделать. Отсюда берут начало злость и неудовлетворенность.

Это что, что-то вроде замкнутого круга? Как я выяснил, некоторые воплощения совершали ужасные преступления, но были и воплощения в которых мы совершали лишь добро. Были ли эти воплощения наказанием? Я не знаю. И это единственная правда, которую я могу сказать точно в этих записях: Я не знаю.

В какой точке *я* отделяется от *мы?* В какой точке существования я отделяюсь от того, что совершали мои прошлые воплощения? В какой точке мне позволено быть *Я*, без груза прошлых деяний?~
@37462 = ~Определяет, будут ли отображаться на экране сообщения о прочих игровых ситуациях, таких как неудачное вскрытие замка, потеря предмета, приобретение опыта и обновление дневника.~
@37463 = ~Отметка маркерами~
@37464 = ~Надпись: Я потерял жизни, из-за моего убийцы. Я не могу его обмануть, значит я должен убить его. Я пробовал сбить его со следа. Я оставлял фальшивые тела, специально изготовленные так, чтобы успокоить его. Я прятался. Я убегал на самые дальние планы, в надежде использовать расстояние, как преграду. Я построил гробницу, напичкал её ловушками и затаился, в надежде убить убийцу. Всё, что я приобрел — это время.

Атаки неизбежно начинались вновь, ещё более яростные. Бесполезно пытаться обмануть. Каким-то образом убийца всегда знает, что я жив. И не имеет значения, на каких планах скрываться. Он найдёт меня. В конце концов.~
@37465 = ~Ты видишь элегантно одетого стареющего мужчину. У него ясные глаза и располагающая улыбка. При твоём приближении он одаривает лёгким поклоном: «Добрый день, здоровяк. Я Себастьян. Чем могу быть полезен?»~
@37466 = ~«Приветствую».~
@37467 = ~Не обращать на него внимания.~
@37468 = ~«И я тебя приветствую, здоровяк…» — он останавливается на полуслове, заметив твои шрамы. Его глаза путешествуют от шрама к шраму, а брови поднимаются от удивления. Затем он снова смотрит тебе в глаза: «Я собирался спросить, что могу для тебя сделать, но в этом уже нет надобности. Думаю, я знаю, зачем ты пришёл ко мне, здоровяк».~
@37469 = ~«У меня кое-какие вопросы…»~
@37470 = ~«Вообще-то я хочу поговорить о Димтри».~
@37471 = ~«Что… хочешь сказать, ты можешь помочь мне избавиться от шрамов?»~
@37472 = ~«Неважно. Прощай».~
@37473 = ~Широко улыбаясь, он отвешивает тебе лёгкий поклон: «Спрашивай, здоровяк».~
@37474 = ~«Кто ты?»~
@37475 = ~«Что это за место?»~
@37476 = ~«Что здесь происходит?»~
@37477 = ~«У меня был говорящий череп, и его похитили. Не поможешь мне?»~
@37478 = ~«Вообще-то я хочу поговорить о Димтри».~
@37479 = ~«У меня сложилось впечатление, что ты можешь вылечить мои шрамы».~
@37480 = ~«Мне нужно идти. Прощай».~
@37481 = ~«Я Себастьян… маг в некотором роде. Я оказываю услуги тем, кто может за них заплатить».~
@37482 = ~«Какого рода услуги?»~
@37483 = ~«Ты неохотно используешь слово *маг*. Почему?»~
@37484 = ~«У меня ещё вопросы…»~
@37485 = ~«Мне нужно идти. Прощай».~
@37486 = ~Он коротко улыбается и пожимает плечами: «Конфиденциальные услуги, здоровяк. Я известен своей осторожностью и безупречным исполнением дел. Люди приходят ко мне с просьбами. Если я могу их выполнить, я выполняю. Если нет — то нет. В любом случае я храню молчание».~
@37487 = ~«Ты неохотно используешь слово *маг*. Почему?»~
@37488 = ~«У меня ещё вопросы…»~
@37489 = ~«Мне нужно идти. Прощай».~
@37490 = ~Он кивает. «Да… я не маг, здоровяк, но Искусство в своих целях использую. Я забросил обучение обычной магии и пошёл своим путём, — он прерывается и пожимает плечами. — Проще звать меня магом, чем спорить по этому поводу».~
@37491 = ~«Какого рода услуги ты оказываешь?»~
@37492 = ~«У меня ещё вопросы…»~
@37493 = ~«Мне нужно идти. Прощай».~
@37494 = ~Он смотрит на тебя вопросительно: «Ты имеешь в виду этот рынок или этот район Сигила?»~
@37495 = ~«Рынок».~
@37496 = ~«Этот район».~
@37497 = ~«Не бери в голову. У меня другие вопросы…»~
@37498 = ~«Мне нужно идти. Прощай».~
@37499 = ~«Это обычный рынок, здоровяк. Здесь очень много всего продаётся. Заклинания, зелья, информация, женщины, мужчины… Почти всё что угодно, если ты способен заплатить».~
@37500 = ~«Расскажи мне об этом районе».~
@37501 = ~«У меня ещё вопросы…»~
@37502 = ~«Мне нужно идти. Прощай».~
@37503 = ~«Это Нижний район, здоровяк, дом для обычных людей и промышленная часть Сигила. Не трущобы Улья, но нет здесь и роскоши, как в районе Госпожи».~
@37504 = ~«Расскажи мне о рынке».~
@37505 = ~«Почему район называют Нижним?»~
@37506 = ~«Почему район называют Нижним?»~
@37507 = ~«У меня ещё вопросы…»~
@37508 = ~«Мне нужно идти. Прощай».~
@37509 = ~Он коротко смеётся и пожимает плечами: «Зависит от точки зрения, здоровяк. Богатые говорят, это потому, что он дом для обывателей или людей *низшего* класса. Если спросишь у тех, кто здесь живёт, то это из-за порталов… и одного инцидента».~
@37510 = ~«Инцидента?»~
@37511 = ~«У меня ещё кое-какие вопросы…»~
@37512 = ~«Мне нужно идти. Прощай».~
@37513 = ~«Да… — он хмурится и в раздумьях прерывается. — Много лет назад он был известен под названием Первичный район. Сюда селили людей, только что появившихся в городе, в остальные части Сигила доступ им не разрешали. Накладывали и другие ограничения… И вот однажды какой-то пень решил поднять своего рода восстание. Оно ни к чему не приводило, конечно, пока он не сделал необычайное открытие…»~
@37514 = ~«Продолжай».~
@37515 = ~«Дело в том, что в этой части города очень много порталов, большинство из которых ведут на Нижние планы. Так вот, этот ненормальный пень нашёл способ все их открыть. Это позволило каждому желающему проникать через порталы в город. Обстановка накалилась; последовала ужасная война. Как бы то ни было, поэтому место и называется *Нижним* районом. Из-за порталов».~
@37516 = ~«Себастьян, каким образом этот человек открыл все порталы?»~
@37517 = ~«Ясно. Я хотел спросить о другом…»~
@37518 = ~«Мне нужно идти. Прощай».~
@37519 = ~«Он воспользовался предметом, который сделал сам или заказал. Как это называлось… — на минуту он задумывается. — А, вспомнил. Ключ, Зачарованный Тенью…» От одного упоминания о ключе мурашки бегут по коже, мир вокруг тебя замирает и всё становится серым. Ты чувствуешь, как старые воспоминания пытаются проложить путь в твоё сознание.~
@37520 = ~Расслабиться и позволить воспоминаниям высвободиться.~
@37521 = ~Расслабиться и позволить воспоминаниям высвободиться.~
@37522 = ~Я кое-что вспомнил о восстании в Нижнем районе. Я либо послужил его причиной, либо играл в нём важную роль. Точнее не знаю.~
@37523 = ~Он пожимает плечами. «Никто не знает. Ключ не могут найти уже долгое время. Многие полагают, ключ забрала Госпожа Боли, чтобы не позволить никому воспользоваться им вновь».~
@37524 = ~«Итак, чем же закончилось восстание?»~
@37525 = ~На минуту он задумывается. «Ну… все, кроме руководителя восстания, были записаны в книгу мёртвых. Руководитель и существа как будто испарились, конечно, это дело рук Госпожи. Выжившие бежали из района. Испарения Нижних планов стали загрязнять воздух, как ты, наверное, заметил. Как бы то ни было, район оставался заброшенным, пока не была построена Кузница».~
@37526 = ~«Что ты можешь рассказать о Кузнице?»~
@37527 = ~«Я хотел спросить о другом…»~
@37528 = ~«Мне нужно идти. Прощай».~
@37529 = ~Он хмурится: «Это дом Боготов, здоровяк. Если тебя интересует информация о них, предлагаю отправиться в Кузницу и спросить их самих».~
@37530 = ~«Ясно. Я хотел спросить о другом…»~
@37531 = ~«Мне нужно идти. Прощай».~
@37532 = ~Он подозрительно смотрит на тебя. «Что ты имеешь в виду, здоровяк? — он оглядывается вокруг и разводит руки, будто хочет обхватить весь район. — Жизнь, здоровяк. Обычная жизнь, ничего больше».~
@37533 = ~«Ладно, у меня к тебе другие вопросы…»~
@37534 = ~«Мне нужно идти. Прощай».~
@37535 = ~Он некоторое время пристально смотрит на тебя, прежде чем ответить: «Череп… ну, если бы я осмелился предположить, я бы сказал, что твой череп принадлежит теперь Повелителю Костей. Это означает, что тебе стоит завести себе другой череп, здоровяк».~
@37536 = ~«Что ты можешь рассказать о Повелителе Костей?»~
@37537 = ~«Где мне найти этого Повелителя Костей?»~
@37538 = ~«Ясно. Прощай».~
@37539 = ~Он хмурится и оглядывается по сторонам. «Его зовут Лотар, и ему не нравится повышенное внимание других. Я о нём ничего не знаю и не могу ответить ни на один твой вопрос, — ты замечаешь в его глазах намёк на страх. — Давай сменим тему разговора, здоровяк».~
@37540 = ~«Где мне найти этого Повелителя Костей?»~
@37541 = ~«Ладно, у меня к тебе другие вопросы…»~
@37542 = ~«Прощай».~
@37543 = ~Он нервно осматривается по сторонам. «Разрушенный дом где-то в этом районе ведёт в его покои. Больше я ничего не знаю, — ты замечаешь явный страх в его глазах. — Давай сменим тему, парень».~
@37544 = ~«Что ты можешь рассказать о Повелителе Костей?»~
@37545 = ~«Ладно, у меня к тебе другие вопросы…»~
@37546 = ~«Прощай».~
@37547 = ~Он пристально смотрит на тебя, потом вздыхает: «Что по поводу Димтри, здоровяк?»~
@37548 = ~«Он хочет освободиться от проклятия».~
@37549 = ~«Просто хотел сделать тебе комплимент за хорошо проделанную работу».~
@37550 = ~«Неважно. Прощай».~
@37551 = ~Он удивлённо смотрит на тебя, затем отмахивается. «В это довольно трудно поверить, здоровяк. Димтри не имеет ментальных способностей что-либо желать, — на мгновение он хмурится. — Неужели тебя втянул этот идиот Хэмрис?»~
@37552 = ~«Нет».~
@37553 = ~Надпись: Ничего тут не поделаешь. Воспоминания ушли и, возможно, никогда не вернутся. С каждой смертью я теряю частицу себя. Как бессмертный может умереть? Мне сказали, что с каждой смертью мой разум слабеет. Я спросил, как такое возможно, но он не смог ответить. Он был бесполезен. Я зарезал его, чтобы ни одна инкарнация больше не смогла воспользоваться его бесполезностью.~
@37554 = ~«Подумай сам, Себастьян. Хэмрис не знает, что Димтри — зомби, не говоря уже о том, кто его создал. Верно?»~
@37555 = ~«Какое это имеет значение?»~
@37556 = ~Он задумчиво смотрит на тебя. «Хм-м. Хэмрису просто не хватит мозгов. Сомневаюсь, что он сможет выяснить, кто это сделал, — он вздыхает и в раздражении пожимает плечами. — Это значит, что бедняга Димтри соображает лучше, чем я думал». Он смотрит в сторону и глубоко задумывается.~
@37557 = ~«Так ты освободишь Димтри?»~
@37558 = ~Он вздыхает и погружается в свои мысли. «Да… ты прав, конечно. Хэмрис не мог тебя прислать. Похоже, бедняга Димтри соображает лучше, чем я задумывал. Да разрази меня чума за мою глупость!»~
@37559 = ~«Так ты освободишь Димтри?»~
@37560 = ~Он смотрит на тебя в замешательстве, лицо посещают противоречивые эмоции. Затем он вздыхает и в раздражении поднимает руки. «Прости, не могу, — он смотрит на тебя умоляющим взглядом. — Хотел бы, поверь, но не могу. Я выполнил договор, создав Димтри, и не могу его нарушить вне зависимости от того, правильно это или нет. Я человек слова, моя репутация требует этого».~
@37561 = ~Правда: «Я понимаю твою дилемму и согласен с тобой. Могу ли я освободить его?»~
@37562 = ~Правда: «Мне плевать на твои договоры. То, что ты сделал, — неправильно, и Димтри должен быть освобождён».~
@37563 = ~«С кем ты заключил договор? Может, у меня получится убедить их освободить его».~
@37564 = ~«Да мне на самом деле всё равно. Я просто согласился попытаться помочь ему. Прощай».~
@37565 = ~«Это будет непросто…» — он поворачивается и начинает копаться в какой-то коробке. Через некоторое время он достаёт книгу и кладёт её перед тобой. «Во-первых, у тебя должны быть хоть какие-то магические способности. Во-вторых, ты должен суметь должным образом прочитать слова на странице 23».~
@37566 = ~«Продолжай».~
@37567 = ~«И наконец тебе нужно дотронуться до Димтри, когда почувствуешь, что сила этих слов сконцентрировалась в тебе, — он снова отворачивается и копается уже в другой коробке. — Однако я не могу позволить тебе прочитать эту книгу. Это будет равносильно нарушению слова». Он продолжает копаться в коробке, игнорируя тебя.~
@37568 = ~Надпись: Они сказали — ты был разделён. Ты один из многих. У тебя множество имён, и каждое оставило шрамы на твоём теле:

Потерявшийся
Бессмертный
Конец Инкарнаций
Человек Тысячи Смертей
Приговорённый к Жизни
Неупокоенный
Один из Многих
Пленённый Жизнью
Влекущий Теней
Израненный
Приносящий Страдания
Бигби
Герой

Я начинаю уставать.~
@37569 = ~Прочитать книгу и уйти.~
@37570 = ~Уйти, не обращая внимания на книгу.~
@37571 = ~Я узнал заклинание, нужное для освобождения зомби Димтри. Себастьян позволил мне прочитать его в своей книге, хотя и сделал вид, что не видел, чем я занимаюсь.~
@37572 = ~Он тебе улыбается: «На мне магическое обязательство не разглашать подобную информацию, здоровяк. Поэтому люди и приходят ко мне. Они знают, что если я подпишу договор, он будет выполнен с должной осмотрительностью».~
@37573 = ~Правда: «Я понимаю, так и нужно вести дела. Могу я вместо тебя освободить его?»~
@37574 = ~Правда: «Мне плевать на твои договоры. То, что ты сделал, — неправильно, и Димтри должен быть освобождён».~
@37575 = ~«Ничего страшного. Я не особенно хочу с этим связываться. Прощай».~
@37576 = ~Он улыбается и пожимает плечами. «Возможно, здоровяк, возможно», — он наклоняется ближе и внимательно изучает твои шрамы. Проводит по нескольким из них пальцем, бормоча что-то под нос. Наконец он смотрит тебе в глаза: «Да, здоровяк, я могу тебе помочь. Полностью излечить тебя не получится, но я могу немного улучшить твоё… состояние».~
@37577 = ~«И твоя цена?»~
@37578 = ~«Хорошо. У меня к тебе ещё кое-какие вопросы…»~
@37579 = ~Надпись: Бойся имен. Имена имеют силу отличия. Имена могут быть использованы в качестве оружия. Они крюк, с помощью которого тебя можно протащить через все планы. Оставайся безымянным и будешь в безопасности.

Я Безымянный.~
@37580 = ~«Ах да… цена», — он поглаживает подбородок и пристально на тебя смотрит. Ты чувствуешь, что тебя оценивают. Затем он явно приходит к какому-то решению: «Я думаю, у меня есть для тебя работа».~
@37581 = ~«Продолжай».~
@37582 = ~«Забудь. У меня к тебе другие вопросы…»~
@37583 = ~«Мне не нужна никакая работа. Прощай».~
@37584 = ~«Я подписал договор с одним существом. А выполнить договор сейчас не могу, это… выше моих сил. Однако существо не желает разрывать договор. Вместо этого он припугнул, что убьёт меня, если я не выполню условия договора».~
@37585 = ~«Дай угадаю: ты хочешь, чтобы я разрешил твою проблему».~
@37586 = ~Отображение указателей~
@37587 = ~«Мне это неинтересно. У меня к тебе ещё кое-какие вопросы…»~
@37588 = ~Броски атаки~
@37589 = ~«Не нравится мне, куда всё клонится. Прощай».~
@37590 = ~Боевая информация~
@37591 = ~Он вздыхает: «Да, сам я этого сделать не могу. Моя репутация требует исполнения договора, или я столкнусь с неприятными последствиями. В этой ситуации я полагаюсь на твоё сострадание. Ты мне поможешь?»~
@37592 = ~Произнесение заклинания~
@37593 = ~«О каком существе идёт речь?»~
@37594 = ~Состояние персонажа~
@37595 = ~«Для какой работы ты был нанят?»~
@37596 = ~Прочие сообщения~
@37597 = ~«Абишай по имени Гросук, здоровяк», — он замолкает, чтобы оценить твою реакцию. «Я знаю, это трудная задача, но думаю, что ты с ней справишься. К тому же я предлагаю тебе приличное вознаграждение», — он показывает на твои шрамы.~
@37598 = ~Персонаж ранен~
@37599 = ~«Для какой работы ты был нанят?»~
@37600 = ~«Ясно, предложение меня заинтересовало».~
@37601 = ~Он качает головой: «Я не могу поведать тебе эту информацию, здоровяк. Связан магическим обязательством. Поэтому люди и приходят ко мне. Они знают, что если я подпишу договор, он будет выполнен с должной осмотрительностью».~
@37602 = ~«О каком существе идёт речь?»~
@37603 = ~«Ясно, предложение меня заинтересовало».~
@37604 = ~Он с надеждой смотрит на тебя: «Ты сделаешь это, здоровяк?»~
@37605 = ~«Я уже убил его».~
@37606 = ~«Да, расскажи мне всё в деталях».~
@37607 = ~«Нет, я не хочу в это ввязываться».~
@37608 = ~«Я не знаю, но обещаю подумать».~
@37609 = ~Маг по имени Себастьян хотел нанять меня убить абишая. Взамен он обещал помочь мне избавиться от шрамов. К счастью, я уже обтяпал дельце, и Себастьян в благодарность помог мне.~
@37610 = ~Маг по имени Себастьян хочет, чтобы я убил для него абишая. Взамен он обещал помочь мне избавиться от шрамов. Я согласился.~
@37611 = ~Он улыбается и с облегчением вздыхает: «Спасибо, здоровяк. Это существо — абишай по имени Гросук. Тебе понадобится магическое оружие, чтобы его убить, так что пробегись по магазинам, если нет своего. Заклинатель тоже может нанести ему урон. Гросук на востоке, за осадной башней».~
@37612 = ~«Осадной башней?»~
@37613 = ~«Хорошо, но у меня ещё пара вопросов…»~
@37614 = ~«Хорошо. До свидания».~
@37615 = ~Он старается скрыть своё разочарование за улыбкой: «Я всё понимаю, здоровяк. Могу я ещё чем-нибудь помочь?»~
@37616 = ~«Да, у меня ещё вопросы…»~
@37617 = ~«Нет, прощай».~
@37618 = ~Себастьян улыбается, завидев твоё приближение: «Добрый день, здоровяк. Ты подумал над моим предложением и решил принять его?»~
@37619 = ~«Вообще-то я хочу поговорить о Димтри».~
@37620 = ~«Да, расскажи мне всё в деталях».~
@37621 = ~«Я всё ещё думаю. Прощай».~
@37622 = ~Себастьян улыбается, завидев твоё приближение: «Добрый день, здоровяк. Пожалуйста, скажи мне, что ты передумал и поможешь с моей проблемой».~
@37623 = ~«Вообще-то я хочу поговорить о Димтри».~
@37624 = ~«Да, расскажи мне всё в деталях».~
@37625 = ~«Нет. Прощай».~
@37626 = ~Себастьян улыбается, завидев твоё приближение: «Добрый день, здоровяк. Ты выполнил поручение?»~
@37627 = ~«Вообще-то я хочу поговорить о Димтри».~
@37628 = ~«Нет, я ещё в процессе».~
@37629 = ~Себастьян улыбается, завидев твоё приближение. «Добрый день, здоровяк. Ты выполнил поручение?»~
@37630 = ~«Да, я пришёл за тем, что мне причитается».~
@37631 = ~«Один момент, здоровяк», — Себастьян лезет в полы своей одежды и достаёт маленький хрустальный шар. Минуту он всматривается в него, прежде чем опять обратиться к тебе: «Нет предела моей благодарности, здоровяк. Я должен исполнить свою часть договора. Ты готов?»~
@37632 = ~«Да».~
@37633 = ~«Дело сделано, здоровяк. Спасибо ещё раз», — Себастьян низко кланяется тебе.~
@37634 = ~«Спасибо и прощай, Себастьян».~
@37635 = ~Себастьян улыбается: «Добрый день, здоровяк. Чем могу помочь?»~
@37636 = ~«Вообще-то я хочу поговорить о Димтри».~
@37637 = ~«Ничем, Себастьян. Прощай».~
@37638 = ~Он улыбается и с облегчением вздыхает: «Спасибо, здоровяк. Это существо — абишай по имени Гросук. Его можно найти на востоке, за осадной башней».~
@37639 = ~«Хорошо. До свидания».~
@37640 = ~Себастьян улыбается, завидев твоё приближение: «Добрый день, здоровяк. Рад снова тебя видеть».~
@37641 = ~«У меня кое-какие вопросы…»~
@37642 = ~«Себастьян, можешь обучить меня Искусству?»~
@37643 = ~«Неважно. Прощай».~
@37644 = ~Мир вокруг угасает, и ты оказываешься на тёмных улицах Сигила. Твоё сердце бешено бьётся, словно хочет выпрыгнуть из груди; дыхание сбивается. Кажется, ты часами бежал без перерыва и всё не можешь остановиться…~
@37645 = ~Продолжить.~
@37646 = ~Ты поворачиваешь за угол и вбегаешь в аллею, наконец замедляя свой бег. Прислоняешься к ближайшей стене и чувствуешь, что силы покинули тебя. Ты стараешься перевести дыхание и вдруг ощущаешь, как что-то больно упёрлось в ладонь. Ты смотришь вниз, разжимаешь кулак и видишь самоцвет, впившийся в плоть.~
@37647 = ~Продолжить.~
@37648 = ~Твоё тело сгибается к стене, пока лоб не касается её холодной, сырой поверхности. Глаза сами собой закрываются, и ты заставляешь себя глубоко вздохнуть. Как только силы возвращаются, раздаётся слабый шум, ты резко возвращаешься к полному сознанию. И поворачиваешься, чтобы посмотреть вглубь аллеи.~
@37649 = ~Продолжить.~
@37650 = ~Сначала ты ничего не замечаешь, только призрачные видения, результат игры света и тени. Ты уже собираешься отвернуться, когда улавливаешь еле заметное движение. Женщина медленно и плавно движется из-за угла, останавливается и поворачивается к тебе лицом. Твой взгляд скользит от её тонкой талии к полной груди, а затем к окружённому клинками лицу. Даже в темноте ты можешь видеть её холодные, бесчувственные глаза…~
@37651 = ~Продолжить.~
@37652 = ~Воспоминания уходят, и нормальное зрение возвращается. Ты стоишь на рынке перед Себастьяном. Он озабоченно смотрит на тебя, но озабоченность проходит, когда он замечает твоё «возвращение»: «Я думал, мы тебя уже потеряли, здоровяк».~
@37653 = ~«Что стало с этим Ключом, Зачарованный Тенью?»~
@37654 = ~«Очень интересно. У меня другие вопросы…»~
@37655 = ~Его лицо светлеет: «Ну спасибо тебе, здоровяк. Всегда приятно найти кого-то, кто может оценить весь юмор подобной ситуации».~
@37656 = ~«Сначала скажи, зачем ты это сделал?»~
@37657 = ~«Да… у меня к тебе кое-какие вопросы…»~
@37658 = ~«Что ж, мне нужно идти. Прощай».~
@37659 = ~«Ох… — он смеётся, качает головой, а затем пытается придать лицу серьёзное выражение. — Хэмрис обожает звук собственного голоса, здоровяк. Бывало, он слонялся по рынку часами, заставляя людей затыкать уши от его бесконечной болтовни. Дела шли плохо. Димтри служит ему добровольным компаньоном и, что самое важное, удерживает его в магазине».~
@37660 = ~«Ясно. У меня к тебе ещё вопросы…»~
@37661 = ~«Ох… — он смеётся, качает головой, а затем пытается придать лицу серьёзное выражение. — Хэмрис обожает звук собственного голоса, здоровяк. Бывало, он слонялся по рынку часами, заставляя людей затыкать уши от его бесконечной болтовни. Дела шли плохо, так как покупатели бежали от него. Димтри служит ему добровольным компаньоном и слушателем его многочисленных историй, а что самое важное, удерживает его в магазине».~
@37662 = ~«Ясно. Что ж, тогда не бери в голову. У меня к тебе кое-какие вопросы…»~
@37663 = ~«Даже если так, то, что ты сделал, всё равно неправильно. Тебе нужно освободить Димтри».~
@37664 = ~Он вздыхает и погружается в мысли. «Да… ты прав, конечно. Да разразит меня чума за мою глупость!»~
@37665 = ~«Так ты освободишь его?»~
@37666 = ~«Да, она за рынком. Долбаная штука просто появилась однажды, несколько лет назад. Никто не знает зачем, и никто не способен проникнуть внутрь, чтобы выяснить».~
@37667 = ~«Ясно. Я хотел спросить о другом…»~
@37668 = ~«Хорошо. Прощай».~
@37669 = ~Ты концентрируешься и собираешься с мыслями. Реальный мир медленно оживает и обретает цвет. Воспоминания угасают…~
@37670 = ~«Что стало с этим Ключом, Зачарованный Тенью?»~
@37671 = ~«Очень интересно, но у меня к тебе ещё вопросы…»~
@37672 = ~«Один момент, здоровяк», — Себастьян лезет в полы своей одежды и достаёт маленький хрустальный шар. Минуту он всматривается в него, прежде чем опять обратиться к тебе: «Нет предела моей благодарности, здоровяк. Хотя мы и не пришли к соглашению, я помогу тебе избавиться от шрамов. Ты готов?»~
@37673 = ~«Да. Спасибо».~
@37674 = ~Он улыбается: «Дело сделано, здоровяк. Ещё раз спасибо».~
@37675 = ~«У меня кое-какие вопросы…»~
@37676 = ~«У меня кое-какие вопросы…»~
@37677 = ~«Мне пора идти. Прощай».~
@37678 = ~«Ты уверен, что хочешь отказаться от своей нынешней профессии и взяться за Искусство в качестве мага?»~
@37679 = ~«Спасибо, я должен идти. Прощай».~
@37680 = ~ВОРОВСКИЕ УМЕНИЯ~
@37681 = ~Персонаж тяжело ранен~
@37682 = ~Персонаж мёртв~
@37683 = ~На персонажа напали~
@37684 = ~Оружие непригодно~
@37685 = ~Цель исчезла~
@37686 = ~Конец раунда~
@37687 = ~На этом экране можно настроить управление автоматической паузой во время игры. Выбор настройки покажет её описание.~
@37688 = ~При включений этой настройки игра будет вставать на паузу, если персонажа ударили в схватке.~
@37689 = ~При включений этой настройки игра будет вставать на паузу, если у персонажа останется менее 30% от максимального количества пунктов здоровья.~
@37690 = ~При включений этой настройки игра будет вставать на паузу, если любой персонаж погибнет.~
@37691 = ~При включений этой настройки игра будет вставать на паузу, если любой персонаж выбран в качестве цели другим враждебным существом.~
@37692 = ~При включений этой настройки игра будет вставать на паузу, если оружие персонажа становится непригодным для боя. Например, такое может случиться, когда оружие сломается или у него кончатся заряды.~
@37693 = ~При включений этой настройки игра будет вставать на паузу, если атакуемая персонажем цель становится недоступна. Такое может случиться, если цель станет невидимой или исчезнет иным образом.~
@37694 = ~При включений этой настройки игра будет вставать на паузу, если любой персонаж закончил свой раунд в бою.~
@37695 = ~На вашем рабочем столе не установлена 16-битная глубина цвета. В результате кино не будет проигрываться в оконном режиме. К тому же многие эффекты заклинаний будут не правильно выглядеть. Лучше всего перейти в полнооконный режим, или переключить рабочий стол на 16-битную глубину цвета, если вы хотите запустить игру в оконном режиме. Продолжить при текущей глубине цвета?~
@37696 = ~Найти «Фарода».~
@37697 = ~Найти вилку Нестора.~
@37698 = ~По просьбе Арло, хозяина ночлежки, избавиться от Нестора.~
@37699 = ~По просьбе духа-защитника уничтожить осквернителя в Мавзолее.~
@37700 = ~Лотар вернул мне Морте несмотря на то, что я отказался от этого болтуна. Он ожидает меня наверху, в том месте, где я вошёл во владения Лотара.~
@37701 = ~В Мортуарии я встретил Пыльную по имени Ай-Вин, которая занималась бальзамированием трупов. Мало того, что у неё длиннющие когти и кожа цвета свиного сала, так она ещё близорукая и глуховатая, поэтому приняла меня за зомби. Ай-Вин попросила принести сосуд с бальзамирующей жидкостью и нитку с иголкой, скорее всего, для сшивания трупа, лежавшего перед ней на столе. Так получилось, что я уже нашёл и то, и другое, поэтому отдал ей всё это.~
@37702 = ~В Мортуарии я встретил Пыльную по имени Ай-Вин, которая занималась бальзамированием трупов. Мало того, что у неё длиннющие когти и кожа цвета свиного сала, так она ещё близорукая и глуховатая, поэтому приняла меня за зомби. Ай-Вин попросила принести сосуд с бальзамирующей жидкостью и нитку с иголкой, скорее всего, для сшивания трупа, лежавшего перед ней на столе. Должно быть, эти предметы находятся где-то в Мортуарии. Возможно, в одной из прилежащих комнат.~
@37703 = ~В логове головорезов я встретил старого слепого Хаоситекта. Он рассказал мне о секретной двери, которая позволит пройти на улицу Протяжных Вздохов, не нарываясь на собравшихся в главном зале Голодных Лающих Псов. Дверь, предположительно, находится в примыкающей к залу юго-западной комнате.~
@37704 = ~Женщина по имени Трист будет продана в рабство, если пропавший документ не будет найден. Я согласился помочь ей.~
@37705 = ~Я убил вторгшегося в мавзолей некроманта, о котором говорил дух-защитник. После разрушения некромантских чар мёртвые больше не гуляют по коридорам Мавзолея. Норочи будет доволен.~
@37706 = ~Он оглядывает тебя с головы до ног и награждает презрительным взглядом: «Я не общаюсь с сомнительными типами. Судя по твоей наружности, ты вполне подходишь под эту категорию. Проваливай, пень».~
@37707 = ~Ты видишь прекрасно одетого молодого красавца. Кажется, он слоняется без дела, просто осматривая товары. Он замечает твоё приближение, но внимания не обращает.~
@37708 = ~Он хмурится и грозит тебе пальцем, словно отчитывает ребёнка: «Мне всё равно, пень. Отстань от меня, или я позову стражу!»~
@37709 = ~Он делает грубый жест. «Ну как хочешь… Стража! Стража!»~
@37710 = ~Мужчина поворачивается к тебе лицом и тут же узнаёт. Его лицо мрачнеет: «Что тебе стоит просто оставить меня в покое, пень?»~
@37711 = ~Мужчина делает грубый жест. «Не хочу я отвечать на твои идиотские вопросы. Поищи себе мудреца, — он отмахивается от себя. — Теперь оставь меня в покое, или я позову стражу!»~
@37712 = ~Мужчина поворачивается к тебе лицом и тут же узнаёт. Его лицо мрачнеет. «Что тебе стоит просто оставить меня в покое, пень? — он вздыхает и с раздражением вздымает руки. — Я уже однажды вызывал стражу, я всегда могу повторить… так как это приносит результат».~
@37713 = ~«Приветствую».~
@37714 = ~Игнорировать его.~
@37715 = ~«У меня вопросы…»~
@37716 = ~«Хорошо, прощай».~
@37717 = ~«Так зови…»~
@37718 = ~«Хорошо, прощай».~
@37719 = ~Приготовиться защищаться…~
@37720 = ~Уйти до их появления.~
@37721 = ~«Если ты ответишь на пару вопросов…»~
@37722 = ~«Извини, уже ухожу. Прощай».~
@37723 = ~«Так зови…»~
@37724 = ~«Хорошо, прощай».~
@37725 = ~«Так зови…»~
@37726 = ~«Хорошо, прощай».~
@37727 = ~Ты видишь неприметного мужчину. Он выглядит обычным покупателем на рынке. Со скучающим видом он бродит среди других таких же покупателей.~
@37728 = ~Он поворачивается, услышав твоё приветствие, и его выражение лица, и без того скучающее, становится совсем кислым: «Да…»~
@37729 = ~Он смотрит на тебя слегка раздражённо: «Ладно…»~
@37730 = ~«Никогда о нём не слышал. Я бы запомнил прозвище *Повелитель Костей*. О таком не забывают», — раздражение в его взгляде усиливается.~
@37731 = ~Он долго на тебя смотрит. «Украли череп… это что-то новенькое. А я-то думал, сигильское ворьё обычно скрывается с чем-то более ценным. Даже не знаю, что сказать», — он пожимает плечами.~
@37732 = ~Он со скукой смотрит на тебя, затем окидывает взглядом рынок. «Прямо здесь, парень, — он неопределённо машет рукой. — Просто удели немного времени и расспроси купцов. Уверен, ты узнаешь, что тебе нужно».~
@37733 = ~Он вздыхает: «Не так много… но это единственный дом, который у меня есть. Думаю, мне стоит научиться любить его, ведь тут я и останусь».~
@37734 = ~Он поворачивается к тебе и хмурится. «Я уже потратил на тебя массу своего времени. Больше мне тебе дать нечего, парень», — он отворачивается.~
@37735 = ~Уйти.~
@37736 = ~Ты видишь стражника Гармониума. Он тщательно осматривает окрестности, делая обход патрулируемой территории. Похоже, он вовсе не заинтересован в разговоре с тобой.~
@37737 = ~«Приветствую».~
@37738 = ~Не обращать на него внимания.~
@37739 = ~«У меня кое-какие вопросы…»~
@37740 = ~«Неважно».~
@37741 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@37742 = ~«У меня был череп, но его украли. Не знаешь, кто бы мог это сделать?»~
@37743 = ~«Где бы мне купить оружие?»~
@37744 = ~«Где бы мне купить магические принадлежности?»~
@37745 = ~«Что ты можешь мне рассказать об этом районе?»~
@37746 = ~«Неважно. Прощай».~
@37747 = ~«У меня к тебе ещё вопросы…»~
@37748 = ~«Прощай».~
@37749 = ~«У меня к тебе ещё вопросы…»~
@37750 = ~«Прощай».~
@37751 = ~«У меня к тебе ещё вопросы…»~
@37752 = ~«Прощай».~
@37753 = ~«У меня к тебе ещё вопросы…»~
@37754 = ~«Прощай».~
@37755 = ~Оставить его в покое.~
@37756 = ~Ты видишь стражницу Гармониума. Она тщательно осматривает окрестности, делая обход патрулируемой территории. Похоже, она вовсе не заинтересована в разговоре с тобой.~
@37757 = ~Оставить её в покое.~
@37758 = ~Ты видишь мужчину с печальным лицом. Он смотрит на тебя безнадёжным взглядом.~
@37759 = ~Он оглядывается вокруг, затем останавливает взгляд на тебе: «Что-то нужно, пень?»~
@37760 = ~Он качает головой: «Слушай, пень, я не в той ситуации, чтобы отвечать на твои глупые вопросы. Убирайся!»~
@37761 = ~Он свирепо на тебя смотрит: «Это аукционный квартал, бестолочь. Меня продают как раба! А теперь задвинься».~
@37762 = ~Он глядит на тебя раздражённо: «У меня такая прекрасная натура, что, думаю, я смогу делать деньги, продавая себя. Теперь как насчёт того, чтобы сделать этот вопрос последним, ты, тупой хер!»~
@37763 = ~Он злится, но затем овладевает собой. «Порезал одного малого, доволен? Я напился, мы подрались, и я всадил в него перо, — он вздыхает. — Спасибо силам за то, что он не помер. Иначе бы я в тюрягу загремел».~
@37764 = ~Он хмурится. «Ты что, полная бестолочь? Перо — это нож, идиот, — он отворачивается от тебя. — Больше я не отвечу ни на один твой вопрос. Убирайся».~
@37765 = ~Он хмурится. «Да, в тюрьму. Если загремишь туда, то это на добрую часть жизни и не особо приятно. Рабом быть не так плохо, и срок мотать не так долго, — он отворачивается. — Больше я не отвечу ни на один твой вопрос. Убирайся».~
@37766 = ~Он хмурится. «Да… тот бедолага, которого я порезал, был моим другом и не настаивал на обвинении. Но мне всё равно пришлось иметь дело с судом, и меня приговорили к продаже, — он отворачивается. — Больше я не отвечу ни на один твой вопрос. Убирайся».~
@37767 = ~Он улыбается: «Это означает: топай подальше через односторонний портал и никогда не возвращайся!»~
@37768 = ~Ты видишь мужчину с печальным лицом. Он смотрит на тебя безнадёжным взглядом. «Только не ты опять. Что тебе стоит оставить меня в покое?»~
@37769 = ~Он зло смотрит на тебя: «Мне нечего тебе ответить. Отвали, пьянь!»~
@37770 = ~«Приветствую».~
@37771 = ~Не обращать на него внимания.~
@37772 = ~«У меня вопросы…»~
@37773 = ~«Неважно. Прощай».~
@37774 = ~«Почему? Что здесь происходит?»~
@37775 = ~«Прекрасно, прощай».~
@37776 = ~«За что тебя продают?»~
@37777 = ~«Что означает „задвинься“?»~
@37778 = ~«Прекрасно, прощай».~
@37779 = ~«Я хочу знать настоящую причину твоей продажи».~
@37780 = ~«Прекрасно. Прощай».~
@37781 = ~«Что такое перо?»~
@37782 = ~«В тюрягу?»~
@37783 = ~«Ясно. Так тебя продают в рабство за то, что ты подрался?»~
@37784 = ~«Ясно. Прощай».~
@37785 = ~«Ясно. Прощай».~
@37786 = ~«Ясно. Прощай».~
@37787 = ~«Ясно. Так за что же тебя продают?»~
@37788 = ~«Прекрасно, прощай».~
@37789 = ~«У меня вопросы…»~
@37790 = ~«Неважно. Прощай».~
@37791 = ~«Прекрасно, прощай».~
@37792 = ~Ты видишь слегка полноватого пожилого мужчину, одетого не очень опрятно. У него озабоченный вид, и он постоянно оглядывается по сторонам. Ты замечаешь, что он тяжело дышит и сильно потеет.~
@37793 = ~Мужчина подпрыгивает от испуга и озабоченно смотрит на тебя. «Да, здоровяк? — он слегка отстраняется, словно боится, что ты его ударишь. — Что я могу для тебя сделать?»~
@37794 = ~«Вопросы? — он мотает головой. — Ты… ведь здесь не товар осмотреть?» Пот ручьями течёт с его лба.~
@37795 = ~Он испуганно смотрит на тебя. «Я… разве ты здесь не для того, чтобы купить слугу?» — его дыхание становится немного легче.~
@37796 = ~Он смотрит на тебя озабоченно и настороженно. Ты видишь, как его глаза перепрыгивают от шрама к шраму и он весь покрывается потом: «Я… я уверен, что не гожусь тебе в слуги, здоровяк». Ваши взгляды сталкиваются.~
@37797 = ~Он тяжело сглатывает, его руки начинают трястись. «Я вёл малоподвижный образ жизни, здоровяк. Ты же, однако, кажешься мне человеком… действия. Я сомневаюсь, что смогу удовлетворить твои нужды…» — его явно переполняет тревога, дыхание становится ещё более порывистым.~
@37798 = ~Мужчина вздыхает с облегчением и улыбается: «В таком случае доброго дня тебе, здоровяк». Он отворачивается.~
@37799 = ~Некоторое время мужчина не отрывает от тебя взгляд, его руки неистово трясутся. Он открывает рот что-то сказать, но слова застревают у него в горле. Глаза расширяются от удивления, он хватается за грудь и тихо сползает на землю.~
@37800 = ~Некоторое время мужчина не отрывает от тебя взгляд, его руки неистово трясутся. Он открывает рот что-то сказать, но слова застревают у него в горле. Глаза расширяются от удивления, он хватается за грудь и тихо сползает на землю.~
@37801 = ~Он кивает: «Да, здоровяк. Те, кого ты здесь видишь, повинны в мелких преступлениях. Наше наказание — беспрекословная служба на период времени, зависящий от тяжести вменяемого преступления. Ты собираешься кого-нибудь купить?»~
@37802 = ~Он отрицательно качает головой и грустно на тебя смотрит: «Мне нечего тебе ответить, здоровяк. Я прошу оставить меня в покое». Он отворачивается.~
@37803 = ~Ты видишь всё того же полноватого пожилого мужчину. Он выглядит озабоченным и всё время оглядывается по сторонам. Ты замечаешь, что он тяжело дышит и сильно потеет. Он слабо улыбается: «Я смотрю, ты вернулся, здоровяк. Чем могу тебе помочь?»~
@37804 = ~«Приветствую».~
@37805 = ~Не обращать на него внимания.~
@37806 = ~«У меня вопросы…»~
@37807 = ~«Неважно. Прощай».~
@37808 = ~Камень чувств~
@37809 = ~«Что за товар?»~
@37810 = ~«Просто хочу задать пару вопросов…»~
@37811 = ~«Он уже мёртв».~
@37812 = ~«Неважно. Прощай».~
@37813 = ~«Да».~
@37814 = ~«Он тоже мёртв».~
@37815 = ~«Нет».~
@37816 = ~«Тебя продают?»~
@37817 = ~«Неважно».~
@37818 = ~«Да? И почему же?»~
@37819 = ~«Да, я думаю, ты прав».~
@37820 = ~«Да, я думаю, ты прав».~
@37821 = ~«Нет, я думаю, ты подойдёшь».~
@37822 = ~«У меня вопросы…»~
@37823 = ~«Прощай».~
@37824 = ~Уйти, пока никто не заметил.~
@37825 = ~«Да».~
@37826 = ~«Нет».~
@37827 = ~Уйти.~
@37828 = ~«У меня вопросы…»~
@37829 = ~«Неважно. Прощай».~
@37830 = ~Витражное стекло~
@37831 = ~«Она уже мертва».~
@37832 = ~«Она уже мертва».~
@37833 = ~«Она уже мертва».~
@37834 = ~«Она уже мертва».~
@37835 = ~«Она уже мертва».~
@37836 = ~«Он уже мёртв. Я хочу получить свою награду».~
@37837 = ~Боевой рог~
@37838 = ~«Гнилой Уильям уже мёртв. Я убил и его, и Кристалл».~
@37839 = ~«Гнилой Уильям уже мёртв».~
@37840 = ~Рубиновая статуэтка~
@37841 = ~«Она и Гнилой Уильям уже мертвы».~
@37842 = ~Живая цепь~
@37843 = ~«Она уже мертва».~
@37844 = ~Картина~
@37845 = ~Ты видишь худого молодого человека с крысиными чертами лица. Кажется, он внимательно изучает окружающих. Он замечает тебя и награждает безжизненным взглядом.~
@37846 = ~Он продолжает пялиться на тебя, разглядывая с головы до ног. Наконец ваши взгляды встречаются. «Да, приветствую».~
@37847 = ~Он улыбается дежурной улыбкой: «Да?»~
@37848 = ~Мгновение он смотрит на тебя пустым взглядом. «Это аукцион. Здесь продают рабов».~
@37849 = ~Кузнец~
@37850 = ~Воин~
@37851 = ~Птицы~
@37852 = ~Он глазеет на тебя без единой эмоции: «На мне висит долг, с которым я не могу расплатиться. Меня продают, чтобы покрыть его».~
@37853 = ~Он медлит перед ответом. «Рабство повсюду, большинство его просто не замечает. Мы рабы своих чувств, потребностей в пище и воздухе, потребностей выделительной системы, даже законов, по которым мы управляем собой… — он пожимает плечами. — Все мы рабы».~
@37854 = ~Статуя~
@37855 = ~Он кивает: «Признавая своё рабское положение по отношению к безразличной мультивселенной, ты делаешь шаг к свободе».~
@37856 = ~Он качает головой. «Только ты сможешь ответить на свой вопрос. Ты должен найти это в себе…» — он замолкает и продолжает смотреть на тебя тем же отрешённым взглядом.~
@37857 = ~Он пожимает плечами: «В таком случае ты раб своего невежества, когда поймёшь это, ты сделаешь первый шаг к освобождению».~
@37858 = ~Он сверлит тебя взглядом. «Это Нижний район. Дом для удачливых: для тех, кто не живёт в трущобах Улья. Дом для неудачников: для тех, кто не может позволить себе величие района Госпожи. Здесь живут те, кто надеется, кто желает для себя большего. Это также дом для тех, кто потерял надежду, кто не видит дальше своего отчаяния…» — он пожимает плечами.~
@37859 = ~Он пожимает плечами. «Районы похожи на пьесу и играющих в ней актёров. Декорации меняются от сцены к сцене, но действующие лица остаются прежними. Ты можешь обойти Сигил вдоль и поперёк и убедишься, что это правда», — он смотрит на тебя отрешённым взглядом.~
@37860 = ~Он окидывает окрестности бесстрастным оценивающим взглядом. «Сигил такой, каким ты его видишь. Для некоторых — это центр всего, а для других — средоточие ничего. Для некоторых — это начало всех дорог, для других же — конец, — он без выражения смотрит на тебя. — А что он для тебя?»~
@37861 = ~Эта дверь кажется запертой изнутри.~
@37862 = ~Он раскидывает руки, будто хочет обнять весь мир, и смотрит на тебя пустыми глазами. «Каждая вещь имеет значение; все вещи никчёмны. На всё стоит посмотреть, — он опускает руки. — Мы видим мир как личности, и как личности мы определяем его для себя. Что имеет значение для меня — может быть никчёмным для другого. Следовательно, на каждую вещь стоит посмотреть, чтобы построить вселенную, в котором мы решаем жить».~
@37863 = ~Он наклоняет голову в сторону и медлит с ответом. «Повелитель Костей не любит посетителей. Если ему нужно твоё присутствие, он пошлёт за тобой».~
@37864 = ~«Он Верховный Священник смерти и поэтому сам бессмертен. Он имеет власть над жизнью со смертью и осознанно распоряжается ею, — на минуту мужчина задумывается. — Он обладает неоспоримой властью в Сигиле, его лучше не беспокоить по пустякам».~
@37865 = ~Он отворачивается и смотрит вдаль. «В его покоях, Костях Ночи. Это недалеко отсюда, но я не знаю, где именно, — он смотрит на тебя безжизненными глазами. — Продолжай поиски. Ты найдёшь его, или он найдёт тебя. Две дороги, ведущие в одно место».~
@37866 = ~Он качает головой: «То, чем ты владеешь, преходяще. Будь благодарен за то, что у тебя ещё есть».~
@37867 = ~Он медленно кивает: «Да. Я думаю, это дело рук Лотара, Повелителя Костей».~
@37868 = ~Ты видишь худого молодого человека с крысиными чертами лица. Он замечает тебя и награждает безжизненным взглядом: «Наши пути снова пересеклись».~
@37869 = ~«Приветствую».~
@37870 = ~Не обращать на него внимания.~
@37871 = ~«У меня вопросы…»~
@37872 = ~«Неважно. Прощай».~
@37873 = ~«Что это за место?»~
@37874 = ~«Не мог бы ты рассказать мне об этом районе?»~
@37875 = ~«Не расскажешь мне о других районах?»~
@37876 = ~«Что ты можешь рассказать о Сигиле?»~
@37877 = ~«Тут есть на что посмотреть?»~
@37878 = ~«Я ищу кое-кого по имени Лотар или Повелитель Костей…»~
@37879 = ~«Я потерял череп… не знаешь никого, кому бы такое могло понадобиться?»~
@37880 = ~«Мне пора идти. Прощай».~
@37881 = ~«За что тебя продают?»~
@37882 = ~«Не знал, что в Сигиле существует рабство».~
@37883 = ~«Я хотел спросить о другом…»~
@37884 = ~«Мне пора идти. Прощай».~
@37885 = ~«Не знал, что в Сигиле существует рабство».~
@37886 = ~«Я хотел спросить о другом…»~
@37887 = ~«Мне пора идти. Прощай».~
@37888 = ~«Понимаю, к чему ты клонишь».~
@37889 = ~«Я с тобой не согласен».~
@37890 = ~«Ясно. У меня ещё кое-какие вопросы…»~
@37891 = ~«Какой шаг?»~
@37892 = ~«Ясно. У меня ещё кое-какие вопросы…»~
@37893 = ~«Мне пора идти. Прощай».~
@37894 = ~«Ясно. У меня ещё кое-какие вопросы…»~
@37895 = ~«Мне пора идти. Прощай».~
@37896 = ~«Какой шаг?»~
@37897 = ~«Ясно. У меня ещё кое-какие вопросы…»~
@37898 = ~«Мне пора идти. Прощай».~
@37899 = ~«Хм… ясно. У меня ещё кое-какие вопросы…»~
@37900 = ~«Мне пора идти. Прощай».~
@37901 = ~«Да… что ж… у меня ещё кое-какие вопросы…»~
@37902 = ~«Думаю, мне пора идти, прощай».~
@37903 = ~«Я не уверен… У меня ещё кое-какие вопросы…»~
@37904 = ~«Прощай».~
@37905 = ~«Э-э… у меня ещё кое-какие вопросы…»~
@37906 = ~«Мне действительно нужно идти. Прощай».~
@37907 = ~«Что ты можешь о нём рассказать?»~
@37908 = ~«Не знаешь, где мне его найти?»~
@37909 = ~«Он посылал за мной и украл то, что принадлежит мне».~
@37910 = ~«Прощай».~
@37911 = ~«Не знаешь, где мне его найти?»~
@37912 = ~«Прощай».~
@37913 = ~«У меня ещё кое-какие вопросы…»~
@37914 = ~«Прощай».~
@37915 = ~«Не знаешь, где мне его найти?»~
@37916 = ~«Что ты можешь о нём рассказать?»~
@37917 = ~«У меня ещё кое-какие вопросы…»~
@37918 = ~«Прощай».~
@37919 = ~«Что ты можешь о нём рассказать?»~
@37920 = ~«Где мне его найти?»~
@37921 = ~«У меня ещё кое-какие вопросы…»~
@37922 = ~«Прощай».~
@37923 = ~«У меня вопросы…»~
@37924 = ~«Неважно. Прощай».~
@37925 = ~Ты видишь стражника Гармониума. Он подозрительно смотрит, как ты приближаешься.~
@37926 = ~Он кивает тебе: «Добрый день, гражданин».~
@37927 = ~Он отрицательно качает головой: «Я на дежурстве, гражданин. У меня нет времени отвечать на вопросы. Пожалуйста, обратись к кому-нибудь другому».~
@37928 = ~Он хмурится: «У меня нет на твои вопросы и минуты, гражданин. Иди своей дорогой».~
@37929 = ~Ты видишь стражника Гармониума. Он хмурится, увидев тебя: «Ещё раз добрый день, гражданин».~
@37930 = ~«Приветствую».~
@37931 = ~Игнорировать его.~
@37932 = ~«У меня кое-какие вопросы…»~
@37933 = ~«Прощай».~
@37934 = ~«Это займёт всего минуту твоего времени».~
@37935 = ~«Хорошо. Прощай».~
@37936 = ~«Хорошо. Прощай».~
@37937 = ~«У меня кое-какие вопросы…»~
@37938 = ~«Прощай».~
@37939 = ~Ты видишь стражника Гармониума. Он отмахивается, завидев твоё приближение: «Иди своей дорогой, гражданин. Нечего тебе здесь делать».~
@37940 = ~Он хмурится. «Что ты не понял в словах „иди своей дорогой“? — он смотрит на тебя сердито. — Не на что здесь глазеть, уходи».~
@37941 = ~Он насмешливо смотрит на тебя. «О, да у тебя накопились вопросы. Что ж, это всё на свете меняет… — в его взгляде появляется злость. — Послушай, у меня нет времени на вопросы. Иди своей дорогой».~
@37942 = ~«Я не могу уделить тебе ни минуты, гражданин. Иди своей дорогой», — он отмахивается от тебя.~
@37943 = ~Ты видишь стражника Гармониума. Он хмурится, заметив твоё приближение: «У меня нет времени для общения, гражданин. Иди своей дорогой».~
@37944 = ~«Приветствую».~
@37945 = ~Игнорировать его.~
@37946 = ~«У меня кое-какие вопросы…»~
@37947 = ~«Отлично, пока».~
@37948 = ~«Это займёт всего минуту твоего времени».~
@37949 = ~«Хорошо. Прощай».~
@37950 = ~«Хорошо. Прощай».~
@37951 = ~«У меня кое-какие вопросы…»~
@37952 = ~«Прощай».~
@37953 = ~Ты видишь стражника Гармониума. Он со скучающим видом наблюдает за твоим приближением.~
@37954 = ~Он кивает тебе: «И я тебя тоже, гражданин».~
@37955 = ~«Я новичок в Гармониуме и в этом округе, гражданин. Я не смогу ответить на твои вопросы», — он виновато улыбается.~
@37956 = ~Он кивает. «Эти люди были признаны виновными в малозначительных преступлениях. Их приговорили к нескольким годам рабства, и сейчас они выставлены на продажу, — он делает паузу. — Это всё, что я могу сказать, гражданин».~
@37957 = ~Он отрицательно качает головой: «Мне нужно быть бдительным при исполнении своих обязанностей, гражданин. Я вынужден просить тебя уйти».~
@37958 = ~Ты видишь стражника Гармониума. Он кивает, заметив твоё приближение: «Здравствуй ещё раз, гражданин. Чем могу помочь?»~
@37959 = ~«Приветствую».~
@37960 = ~«Неважно. Прощай».~
@37961 = ~«Приветствую».~
@37962 = ~Игнорировать его.~
@37963 = ~«У меня кое-какие вопросы…»~
@37964 = ~«Прощай».~
@37965 = ~«Можешь хотя бы сказать мне, что здесь происходит?»~
@37966 = ~«Хорошо, прощай».~
@37967 = ~«Ясно. Могу я задать ещё вопрос?»~
@37968 = ~«Спасибо. Прощай».~
@37969 = ~«Отлично, пока».~
@37970 = ~«У меня кое-какие вопросы…»~
@37971 = ~~
@37972 = ~Ты видишь молодую женщину, пытающуюся привлечь твоё внимание. Одета она дёшево, но в манере вести себя сквозит изящество, выделяющее её из окружающей толпы. При близком рассмотрении ты замечаешь, что у неё чистая гладкая кожа, не имеющая желтоватого оттенка, как у жителей этого района. Заметив твоё приближение, она улыбается.~
@37973 = ~«Приветствую».~
@37974 = ~Игнорировать её.~
@37975 = ~«Благодарю силы за то, что ты обратил на меня внимание. Мне нужны услуги наёмника… — она замолкает и осматривает тебя внимательнее. — Если судить по внешнему виду, то ты вполне подходящая кандидатура».~
@37976 = ~«Внешность может быть обманчива».~
@37977 = ~«Что конкретно тебе от меня нужно?»~
@37978 = ~«Не нравится мне всё это. Прощай».~
@37979 = ~На её лице появляется выражение беспокойства: «Да, здоровяк. Прости меня, не хотела тебя оскорбить. Я нахожусь… в отчаянном положении. Я исчерпала все доступные мне ресурсы, чтобы исправить положение, но…»~
@37980 = ~«Что конкретно тебе от меня нужно?»~
@37981 = ~«Не нравится мне всё это. Прощай».~
@37982 = ~Она кивает тебе. «Дело в том, что меня должны продать в рабство за преступление, которого я не совершала. Мне нужен защитник, который поможет доказать мою невиновность и освободить от такой судьбы…» — она замолкает и выжидательно на тебя смотрит.~
@37983 = ~«Расскажи мне в точности, что происходит».~
@37984 = ~«Не нравится мне всё это. Прощай».~
@37985 = ~Она на минуту задумывается. «Это долгая история, здоровяк, пожалуйста, выслушай её всю».~
@37986 = ~«Продолжай».~
@37987 = ~«У меня нет на это времени. Прощай».~
@37988 = ~Она вздыхает и начинает свой рассказ: «Мой муж недавно умер и оставил мне своё дело. Я не умею вести дела, поэтому решила продать его. Вскоре после этого со мной связался ростовщик, заявивший, что мой муж не выплатил ему долг…» Она прерывается, чтобы собраться с мыслями.~
@37989 = ~«Продолжай».~
@37990 = ~«Я проверила все документы мужа и обнаружила, что он действительно брал деньги в долг, но недавно полностью его выплатил. Я объяснила это ростовщику, и через несколько дней он попросил предоставить ему копию документа… а я не смогла нигде его найти», — она выглядит озабоченной и снова делает паузу, чтобы подумать.~
@37991 = ~«Продолжай».~
@37992 = ~«Итак, когда я не смогла предъявить доказательства, что долг был выплачен, ростовщик отдал дело на рассмотрение в суд. Мои сбережения были изъяты и зачислены в счёт долга. Так как они не покрыли всей суммы долга, меня продают в рабство, чтобы выплатить оставшуюся сумму», — она смотрит на тебя с несчастным видом.~
@37993 = ~«Я не понимаю, зачем продавать тебя в рабство?»~
@37994 = ~«Думаю, я услышал достаточно. Ближе к делу».~
@37995 = ~Она пожимает плечами: «Это делается по многим причинам. Во-первых, это очищает тюрьмы от всех, кроме самых опасных преступников. Во-вторых, продажа виновного оплачивает любой вред, затраты или любые имеющиеся в деле расходы. И наконец, виновный всё же отбывает срок наказания и в конечном счёте выходит на свободу… предположительно, став лучшим гражданином».~
@37996 = ~«Это всё очень увлекательно, но я не вижу, чем могу тебе помочь».~
@37997 = ~~
@37998 = ~«Мне… мне нужен кто-то, чтобы найти пропавший документ, который доказывает выплату долга. Или если бы ты смог купить мой контракт, я бы не осталась у тебя в долгу… — она смотрит на тебя умоляюще. — Я не смогу провести следующие пять лет моей жизни в этой местности, здоровяк. Это убьёт меня! Ты, конечно, заметил болезнь, которой поражён здесь каждый?»~
@37999 = ~«Нет, о какой болезни ты говоришь?»~
@38000 = ~«Да, жёлтая кожа и кашель…»~
@38001 = ~«Это не мои проблемы. Прощай».~
@38002 = ~Она показывает на окружающих людей: «Посмотри на них, здоровяк. Замечаешь жёлтый цвет их кожи? Постоянный кашель? Теперь посмотри на облака дыма, которые считаются здесь воздухом… — она указывает на пространство у себя над головой. — Это убивает тебя, если ты не можешь оплатить лекаря. А я вряд ли смогу себе его позволить, будучи рабыней».~
@38003 = ~«Так вот почему у всех такая жёлтая кожа…»~
@38004 = ~«Это не мои проблемы. Прощай».~
@38005 = ~Она кивает: «Да, здоровяк. Пожалуйста, неужели в твоём сердце нет ни капли жалости…» Она нервно смотрит на тебя: «Пожалуйста…»~
@38006 = ~«Что я получу, если помогу тебе?»~
@38007 = ~Правда: «Тебя признали виновной в законном суде, и только закон сможет тебе помочь».~
@38008 = ~«Хорошо, я помогу тебе. Но мне нужно задать кое-какие вопросы…»~
@38009 = ~«Нет, я не хочу в это ввязываться».~
@38010 = ~«Мне надо подумать. Прощай».~
@38011 = ~Она с готовностью кивает головой: «Спрашивай что хочешь, здоровяк».~
@38012 = ~«Как зовут ростовщика?»~
@38013 = ~«С кем мне поговорить о твоём контракте?»~
@38014 = ~«А не могла ты положить документ о выплате в другое место?»~
@38015 = ~«Как думаешь, документ о выплате мог быть украден?»~
@38016 = ~«Ты рассказывала обо всём этом в суде?»~
@38017 = ~«Думаю, мне пора. До свидания».~
@38018 = ~«Мне хорошо знакомо его имя, здоровяк. После всего того, через что мне довелось пройти, вряд ли я его когда-нибудь забуду… — она смотрит вдаль и вздрагивает. — Его зовут Байрон Пикит». Чуть помолчав, она добавляет: «А его компаньон — некто по имени Ленни».~
@38019 = ~«Кто такой этот Ленни?»~
@38020 = ~«Где мне найти Байрона?»~
@38021 = ~«У меня к тебе ещё кое-какие вопросы…»~
@38022 = ~«Мне пора идти. Прощай».~
@38023 = ~На минуту она задумывается. «Его можно отыскать на рынке или возле него. Прости, но я не вполне уверена».~
@38024 = ~«Ты упоминала Ленни. Кто он такой?»~
@38025 = ~«У меня к тебе ещё кое-какие вопросы…»~
@38026 = ~«Мне пора идти. Прощай».~
@38027 = ~«Должно быть, с аукционистом Дераном. Он обычно тут, на помосте», — она указывает на переднюю часть платформы.~
@38028 = ~«У меня к тебе ещё кое-какие вопросы…»~
@38029 = ~«Мне пора идти. Прощай».~
@38030 = ~Она качает головой: «Нет, здоровяк. Я человек очень дотошный. Я хранила документы в закрытом ящике стола моего мужа. И их никто никогда не выносил из комнаты…»~
@38031 = ~«У меня к тебе ещё кое-какие вопросы…»~
@38032 = ~«Мне пора идти. Прощай».~
@38033 = ~Она пожимает плечами: «Не знаю. Зачем кому-то его похищать и оставлять все ценности? Я не вижу в этом смысла».~
@38034 = ~«Ну… ростовщик мог похитить документ, чтобы получить выплаты по долгу дважды…»~
@38035 = ~«Ну… это было всего лишь предположение…»~
@38036 = ~«У меня к тебе ещё кое-какие вопросы…»~
@38037 = ~«Мне пора идти. Прощай».~
@38038 = ~Она смотрит на тебя потрясённо. «Это… это кошмарная мысль! — она колеблется, затем начинает задумчиво барабанить пальцами по подбородку. — Но и самая остроумная, здоровяк. Этот Байрон Пикит просто ободрал меня как рыцарь наживы».~
@38039 = ~«Рыцарь наживы?»~
@38040 = ~«У меня к тебе ещё кое-какие вопросы…»~
@38041 = ~«Мне пора идти. Прощай».~
@38042 = ~Она вопросительно смотрит на тебя: «Вор или мошенник, здоровяк. Их называют рыцарями наживы или чёрными торговцами».~
@38043 = ~«У меня к тебе ещё кое-какие вопросы…»~
@38044 = ~«Мне пора идти. Прощай».~
@38045 = ~Она кивает. «О да, здоровяк. Я многим объясняла свою ситуацию. Но ты пока первый и единственный, кто захотел мне помочь», — она тепло тебе улыбается.~
@38046 = ~«У меня к тебе ещё кое-какие вопросы…»~
@38047 = ~«Мне пора идти. Прощай».~
@38048 = ~Она пожимает плечами: «Стоящая мысль, здоровяк. И по существу».~
@38049 = ~«У меня к тебе ещё кое-какие вопросы…»~
@38050 = ~«У меня к тебе ещё кое-какие вопросы…»~
@38051 = ~Некоторое время она беспомощно смотрит на тебя, затем её лицо охватывает выражение беспокойства. «У меня… у меня ведь и дать тебе нечего, здоровяк. Я всё потеряла, — теперь она выглядит отчаявшейся. — Прошу, не оставляй меня на произвол судьбы…»~
@38052 = ~«Хорошо, я помогу тебе. Но мне нужно задать кое-какие вопросы…»~
@38053 = ~«Нет, я не хочу в это ввязываться».~
@38054 = ~«Мне надо подумать. Прощай».~
@38055 = ~Ты видишь Трист. Она смотрит на тебя с отчаянием в глазах: «Снова здравствуй, здоровяк. Можно кое о чём с тобой поговорить?»~
@38056 = ~«Хорошо».~
@38057 = ~«Сейчас у меня нет времени. Прощай».~
@38058 = ~Ты видишь Трист. Она смотрит на тебя с отчаянием в глазах: «Снова здравствуй, здоровяк. Возможно, ты пришёл мне помочь?»~
@38059 = ~«Всё ещё ищешь того, кто согласится тебе помочь?»~
@38060 = ~«Расскажи-ка мне свою историю снова».~
@38061 = ~«Меня это не интересует. Прощай».~
@38062 = ~Ты видишь Трист. Она смотрит на тебя с отчаянием в глазах: «Снова здравствуй, здоровяк. Возможно, ты пришёл мне помочь? Неужели всё-таки передумал?»~
@38063 = ~«Всё ещё ищешь того, кто согласится тебе помочь?»~
@38064 = ~«Расскажи-ка мне свою историю снова».~
@38065 = ~«Нет, меня это по-прежнему не интересует. Прощай».~
@38066 = ~Ты видишь Трист. При твоём приближении она улыбается с надеждой во взгляде: «Ты нашёл документ, здоровяк? Можешь меня освободить?»~
@38067 = ~«Да, я отдам его Дерану, и он тебя освободит».~
@38068 = ~«Мне надо задать тебе ещё пару вопросов…»~
@38069 = ~Чувство колоссального облегчения озаряет её лицо. Кажется, что она вот-вот потеряет сознание, но быстро приходит в себя. «Благодарю тебя, здоровяк. Прошу тебя, вернись ко мне после того, как поговоришь с Дераном».~
@38070 = ~«Обязательно. Прощай».~
@38071 = ~Трист тепло приветствует тебя: «Ты — мой спаситель, здоровяк. А я — твоя вечная должница».~
@38072 = ~«Счастлив был помочь тебе, Трист».~
@38073 = ~«Больше ко мне со своими проблемами не обращайся. Это было как гвоздь в заднице».~
@38074 = ~«Спасибо тебе, здоровяк», — она окидывает тебя взглядом и на мгновение задумывается. «Ты спас меня от верной смерти. Медленной, мучительной смерти…» — на этих словах она задумчиво хмурится. «Прошу, подожди меня здесь, я сейчас вернусь», — она уходит.~
@38075 = ~«Хорошо, Трист».~
@38076 = ~~
@38077 = ~Ты видишь приближающуюся Трист, она улыбается и машет тебе рукой: «Снова здравствуй, здоровяк. Спасибо, что подождал». Недолго думая, она вынимает из складок платья кошелёк. «Благодаря документам, что ты предоставил, суд восстановил мой статус и моё финансовое положение. Вот небольшая, но вполне заслуженная награда», — она протягивает кошелёк.~
@38078 = ~«Спасибо тебе, Трист».~
@38079 = ~Она улыбается: «Нет, это тебе спасибо. Счастливо, здоровяк».~
@38080 = ~«Прощай».~
@38081 = ~Она хмурится, затем кивает: «Да, здоровяк, могу себе представить. Ещё раз спасибо тебе и прощай».~
@38082 = ~«Прощай».~
@38083 = ~На мгновение она задумывается. «Это был маленький человек дикого вида. Он несколько раз приходил в суд. Всегда садился позади Пикита и порой о чём-то с ним шептался», — она прерывается. Похоже, она ушла в свои мысли.~
@38084 = ~«Продолжай».~
@38085 = ~Она хмурится. «Я его помню, потому что ему всегда было словно неудобно в своей одежде. Она на нём сидела как новая, словно он её никогда не носил, — она снова прерывается. — Однажды Пикит сказал, чтобы тот сидел спокойно и не ёрзал. Он назвал его Ленни».~
@38086 = ~«Где я могу найти Ленни?»~
@38087 = ~«У меня к тебе ещё кое-какие вопросы…»~
@38088 = ~«Мне пора идти. Прощай».~
@38089 = ~Подумав, она пожимает плечами: «Вообще-то я не уверена… муж как-то говорил, что шпану можно встретить к юго-востоку от рынка, возле осадной башни, как я поняла».~
@38090 = ~«Где мне найти Байрона?»~
@38091 = ~«У меня к тебе ещё кое-какие вопросы…»~
@38092 = ~«Мне пора идти. Прощай».~
@38093 = ~На её лице появляется печать беспокойства. «Конечно, ты понимаешь, здоровяк, что порой даже закон может ошибаться? И если от этого пострадает невиновный… то это будет ужасной ошибкой правосудия, — она выглядит уже отчаявшейся. — Прошу, не оставляй меня…»~
@38094 = ~«Хорошо, я помогу тебе. Но мне нужно задать кое-какие вопросы…»~
@38095 = ~«Нет, я не хочу в это ввязываться».~
@38096 = ~«Мне надо подумать. Прощай».~
@38097 = ~Какая бы малость ни осталась от моей жизни, она вытекает из тела сквозь эту дыру. Мир может гореть, планы могут гореть, только отдайте мне жизнь! Я зверски уничтожу эту жизнь, разорву её на куски, раздавлю, утоплю в крови так, что и вы не сможете ей жить! Гори мир, гори вселенная, ведь я не могу умереть!~
@38098 = ~Отвернуться от надписи.~
@38099 = ~Эта надпись похожа на указания с твоей спины, которые Морте прочитал тебе в Мортуарии:

«Я знаю, ты чувствуешь себя так, будто нахлебался мутных вод Стикса, но тебе нужно СОБРАТЬСЯ. Среди твоих вещей должен быть ДНЕВНИК, который прольёт немного света на это тёмное дело. ФАРОД расскажет тебе оставшуюся часть истории, если, конечно, он ещё не попал в книгу мёртвых».~
@38100 = ~Готово.~
@38101 = ~Крайне важно вести записи о своих путешествиях так, чтобы по ним потом можно было учиться. Однако ещё важнее защитить источники информации, которыми ты пользуешься для раскрытия этой загадки, по мере их нахождения. Ведь если ключевые фигуры, документы или оракулы будут каким-то образом уничтожены, то ты никогда не узнаешь, кто или что ты есть и как ты стал таким.~
@38102 = ~Готово~
@38103 = ~Подозреваю, мы так и будем умирать и возрождаться, пока не сможем наконец прожить жизнь *правильно*. Хотя и не знаю, что для этого нужно. И это ввергает меня в печаль.~
@38104 = ~Готово.~
@38105 = ~Я потерял не одну жизнь из-за моего убийцы. Не могу обмануть его, так что должен убить. Я пробовал сбить его со следа. Оставлял фальшивые тела, изготовленные так, чтобы он успокоился. Бродил по множеству внешних планов в надежде использовать расстояние как щит. Построил эту гробницу и наполнил её ловушками, чтобы заманить его и убить. Я спрятался.~
@38106 = ~Готово.~
@38107 = ~Ничего тут не поделаешь. Воспоминания ушли и, возможно, никогда не вернутся. С каждой смертью я теряю частицу себя.~
@38108 = ~Готово.~
@38109 = ~Так они сказали: ты был разделён. Ты один из многих. Ты носишь много имён, и каждое из них оставило свои шрамы на плоти.~
@38110 = ~Готово.~
@38111 = ~Бойся имён. В них сила отождествления. Другие могут использовать имя как оружие. Имя — словно верёвка, что тянется за тобой. По ней тебя можно выследить даже на самом дальнем плане. Оставайся безымянным и ты будешь в безопасности.~
@38112 = ~Готово.~
@38113 = ~«Мне пора идти. Прощай».~
@38114 = ~«Она уже мертва».~
@38115 = ~Пиво~
@38116 = ~Ты видишь мужчину в годах, одетого в грязное тряпьё. Подойдя ближе, ты замечаешь, что у него нет обоих глаз. Рваная ткань век провалилась в пустые глазницы, придавая его чертам жутковатое сходство с разлагающимся черепом.~
@38117 = ~Старик поворачивается в твоём направлении, протягивая руки, словно чувствуя тебя: «Тьма чья в голосе? Дружеские слова я тебе скажу, и назови хаос».~
@38118 = ~«А-а… хаос — ты это, как я и моя», — слепой старик улыбается и осторожно делает шаг тебе навстречу. Ты замечаешь, что он подволакивает одну ногу.~
@38119 = ~«Нет, в порядке будет со мной всё. Просто чуть-чуть порезали, всего и только», — с этими словами он приподнимает край своих изорванных одежд, прикрывавших ноги, открывая твоему взору кошмарную рану, идущую от колена до пояса.~
@38120 = ~«Отведал одного из Голодных Псов клинок. Собрались в главном зале на пути они. Воющие — рычащие — рыскающие».~
@38121 = ~~
@38122 = ~«Они — хаоса порок. Братья все, как один, но никому не братья».~
@38123 = ~Ключ от гробницы два~
@38124 = ~КЛЮЧ ОТ ГРОБНИЦЫ ДВА
Вес: 0

Это ключ от портала.~
@38125 = ~Ключ от гробницы один~
@38126 = ~КЛЮЧ ОТ ГРОБНИЦЫ ОДИН
Вес: 0

Почему-то этот ключ кажется тебе смутно знакомым… взяв его, ты тут же вспоминаешь его назначение: он позволяет перенестись в одну из зал гробницы в катакомбах Плачущих Камней, но только если использовать его в коридоре возле входа; внутри залов он становится бесполезным. Если тебе удастся как-то попасть назад, ко входу, то ты сможешь использовать ключ снова для перемещения в какое-то другое место…~
@38127 = ~Старик качает головой: «Значения не имеет. Атакуют всех и вся они. Так хаос говорит им. И тебя порежут тоже они, пойдёшь туда если».~
@38128 = ~Просмотр видео возможен только при 16-битной глубине цвета. Пожалуйста, переключитесь на 16-битную глубину цвета в установках рабочего стола, если хотите смотреть видео.~
@38129 = ~Старый Хаосит смолкает на мгновение, его невидящий взгляд устремлён в пустоту. «Много, они … сильны и жестоки. Но путь другой есть. Секретный путь, знают его только я и моя. Выход безопасный в аллею».~
@38130 = ~«Тьма — не свет, а свет — не тьма. Яркие, блестящие монеты тьму могут всё же осветить», — для выразительности старик потирает пальцы друг об друга.~
@38131 = ~Ты кладёшь десять монет в руку старика. Он замирает, потом подбрасывает монеты на ладони, словно проверяя их вес. Подумав, он возвращает их тебе: «Мало. Жизнь неужели не стоит десяти монет больше?»~
@38132 = ~Ты даёшь старику монеты, и он поспешно прячет их в карман. «Дверь найди, в юго-западной комнате скрытую. Ведёт она в дальнюю часть главного зала, рядом с выходом в аллею».~
@38133 = ~Старик выглядит оскорблённым твоими угрозами. «Не друг ты, и друзей нет у тебя тут! Друзья есть у меня, и друзей я зову!» — он делает глубокий вдох, собираясь закричать.~
@38134 = ~Ты моментально наваливаешься на слепца. Одной рукой зажав ему рот, чтобы не кричал, другой ты обхватываешь его затылок и резко поворачиваешь голову, пока не слышится хруст ломаемой шеи.~
@38135 = ~«Воришка? Здесь? Кто-то *крал* у Тиресиаса… может, о нём и говоришь ты, — старик потирает подбородок, обдумывая твоё предложение. — Согласен… тьма на тьму. Говоришь первым ты».~
@38136 = ~Тиресиас довольно кивает: «Молодая воровка, говоришь? Посмотрю на неё я».~
@38137 = ~«Да, Тиресиас знает путь. Выход в аллею есть из главного зала на юге, но пройти не сможешь ты. Голодные Псы собираются там и проход перекрывают».~
@38138 = ~Старик склоняет голову на бок, его незрячие глазницы смотрят в пустоту: «Хаос не ты. Нет! Обед! Бред!»~
@38139 = ~«Ходи, не говори. Разговор закончен. Закончен до конца!» — он поворачивается к тебе спиной, явно не собираясь продолжать разговор.~
@38140 = ~«В юго-западной комнате секретная дверь есть. Не через дверь напротив, ведёт та к Псам».~
@38141 = ~«Приветствую».~
@38142 = ~Оставить старика в покое.~
@38143 = ~«Слова говорят хаос мои. Не бойся, я *собрат* по Хаоситектов фракции».~
@38144 = ~«Голос… говорит — парит — дурит».~
@38145 = ~«Мне сказать слова хаоса, и ты назовёшь меня другом? Эти ребусы действительно так необходимы?»~
@38146 = ~«А?»~
@38147 = ~«Э-э… неважно. Прощай».~
@38148 = ~«Что с твоей ногой… ты ранен?»~
@38149 = ~«Не знаешь, как мне пройти на улицу Протяжных Вздохов?»~
@38150 = ~«Ты говорил, что знаешь, как пройти мимо Голодных Псов в аллею?»~
@38151 = ~«Так где, ты говоришь, секретная дверь?»~
@38152 = ~«Да… ну, мне пора идти. Счастливо».~
@38153 = ~«Что случилось?»~
@38154 = ~«Не знаешь, как мне пройти на улицу Протяжных Вздохов?»~
@38155 = ~«Да… ну, мне пора идти. Счастливо».~
@38156 = ~Видео~
@38157 = ~«Расскажи мне об этих Голодных Псах».~
@38158 = ~«Голодные Лающие Псы? Сколько их там?»~
@38159 = ~«Ясно. Тогда прощай».~
@38160 = ~«Но если они Хаоситекты, то почему на тебя напали?»~
@38161 = ~«Сколько их там?»~
@38162 = ~«Ясно. Тогда прощай».~
@38163 = ~«Сколько их там?»~
@38164 = ~«Забудь. Я сам найду дорогу».~
@38165 = ~«Ясно. Тогда прощай».~
@38166 = ~«Что за секретный путь?»~
@38167 = ~«Забудь. Я сам найду дорогу».~
@38168 = ~Дать слепому десять медяков.~
@38169 = ~Дать слепому двадцать медяков.~
@38170 = ~«Ни черта ты не получишь. Выкладывай мне всё, что знаешь… или я тебе покажу истинную тьму».~
@38171 = ~«Как насчёт тьмы на тьму? Я могу рассказать тебе кое-что о воришке, скрывающейся здесь, в логове».~
@38172 = ~«Забудь. Я сам найду дорогу».~
@38173 = ~Дать ему двадцать медяков.~
@38174 = ~«Желаешь поторговаться? Хорошо… как насчёт того, чтобы выложить мне всё, что знаешь. Взамен я сохраню тебе жизнь».~
@38175 = ~«Как насчёт тьмы на тьму? Я могу рассказать тебе кое-что о воришке, скрывающейся здесь, в логове».~
@38176 = ~«Забудь. Я сам найду дорогу».~
@38177 = ~«Спасибо за помощь. Счастливо».~
@38178 = ~Сломать ему шею, прежде чем он позовёт на помощь.~
@38179 = ~Напасть на него.~
@38180 = ~Немедленно уйти.~
@38181 = ~«Слишком всё просто».~
@38182 = ~«Ваш вор — всего лишь молодая девушка. Она прячется в прихожей, рядом с дверью в главный зал».~
@38183 = ~«А с другой стороны, вот двадцать монет. Давай, говори».~
@38184 = ~«С другой стороны, почему бы тебе не выложить мне всё, что знаешь… а я тебе позволю жить».~
@38185 = ~«Неважно. Прощай».~
@38186 = ~«Ладно. А теперь расскажи мне о том секретном проходе».~
@38187 = ~«Найди дверь потайную в юго-западной комнате. Откроется она в дальнем конце главного зала, рядом с выходом в аллею».~
@38188 = ~«Почему-то я в этом сомневаюсь. А теперь говори мне всё, что знаешь, старик».~
@38189 = ~«Расскажи мне об этих Голодных Псах».~
@38190 = ~«Голодные Лающие Псы? Сколько их там?»~
@38191 = ~«Ясно. Тогда прощай».~
@38192 = ~«Э-э… не вижу никакого смысла».~
@38193 = ~«Тут что, все с ума посходили?»~
@38194 = ~Не обращать внимания на его бормотание и уйти.~
@38195 = ~«Слушай, старик, лучше отвечай прямо или недосчитаешься ещё чего-нибудь, кроме глаз».~
@38196 = ~«Похоже, тут мне ничего не светит. Прощай».~
@38197 = ~«Спасибо за помощь. Счастливо».~
@38198 = ~«Спасибо за помощь. Счастливо».~
@38199 = ~После того как я дал Ай-Вин нитку и бальзамирующую жидкость, она зашила мои раны и промыла кожу бальзамирующей жидкостью. Странно, но я почувствовал себя… здоровее, что ли.~
@38200 = ~При виде того, как Ай-Вин сшивает труп своими когтями, пришли сразу два воспоминания… в одном из них я играл на каком-то струнном инструменте, а в другом я похищал чей-то кошелёк. Может, я когда-то был музыкантом или карманником?.. Не могу вспомнить. Тем не менее, одного лишь воспоминания о краже кошелька было достаточно для восстановления кое-каких навыков.~
@38201 = ~Наблюдая за Ай-Вин, сшивающей труп своими когтями, мне пришли сразу два воспоминания… в одном из них я играл на каком-то струнном инструменте, а в другом похищал чей-то кошелёк. Может, я когда-то был музыкантом или карманником?.. Не могу вспомнить.~
@38202 = ~Я принёс Ай-Вин нитку и бальзамирующую жидкость. Непохоже, что она слишком этому обрадовалась.~
@38203 = ~Я убедил Ай-Вин дать мне ключ от комнаты для бальзамирования.~
@38204 = ~Лотар вернул мне Морте. Он ожидает меня наверху, в том месте, где я вошёл во владения Лотара.~
@38205 = ~По-видимому, Пыльная, бальзамирующая трупы в Мортуарии, — «тифлинг», то есть у неё в жилах течёт кровь демонов. Как правило, кровь демонов влияет на их тела, а порой и на разум. Со слов Морте выходит, что тут довольно много тифлингов… а это значит, что и извергов тоже немало.~
@38206 = ~Я сказал Многим-как-Один, что Безмолвный Король слишком силён для него. Коллективный разум черепокрыс не увидел лжи в моих словах, но запретил мне возвращаться в Дом Мысли под страхом смерти. Что ж, ещё посмотрим.~
@38207 = ~Упыри захватили Мёртвые Народы, и это мешает укрепиться там черепокрысам. Они меня изгнали, предупредив о страшных последствиях в случае моего возвращения.~
@38208 = ~Я сказал Многим-как-Один, что Безмолвный Король — всего лишь скелет, не обладающий никакой силой. Крысы пообещали немедленно захватить катакомбы под Сигилом.~
@38209 = ~У этой сногсшибательной молодой женщины кожа цвета отполированной меди. Полупрозрачное белое платье, лишь слегка удерживаемое золотыми пряжками, аккуратно облегает её соблазнительные формы.~
@38210 = ~Она улыбается и делает реверанс, но ничего не отвечает.~
@38211 = ~Она качает головой и печально улыбается.~
@38212 = ~Она смотрит на тебя и поднимает бровь.~
@38213 = ~Она кивает, мило улыбнувшись.~
@38214 = ~Она надувает губки и качает головой.~
@38215 = ~Её глаза вспыхивают, и она улыбается. Затем кивает тебе.~
@38216 = ~Она просто смотрит на тебя.~
@38217 = ~Она тихо вздыхает и кивает.~
@38218 = ~Она мило улыбается, а затем качает головой.~
@38219 = ~Глаза её расширяются от удивления… затем она одаривает тебя лучезарной улыбкой, закатывает глаза и мотает головой.~
@38220 = ~Она странно смотрит на тебя и медленно качает головой…~
@38221 = ~Тут она медлит, открывает рот, потом хмурится. После секундного замешательства она качает головой.~
@38222 = ~Она сердито качает головой.~
@38223 = ~Она энергично кивает и, хлопнув в ладоши, улыбается тебе.~
@38224 = ~Точка отсчёта.~
@38225 = ~Точка отсчёта.~
@38226 = ~Точка отсчёта.~
@38227 = ~Точка отсчёта.~
@38228 = ~Она качает головой, на лице её написано разочарование. Внезапно она смотрит на тебя умоляюще, словно ожидая ответа.~
@38229 = ~Она пожимает плечами и мрачнеет.~
@38230 = ~Экко медленно кивает тебе и улыбается с благодарностью в глазах.~
@38231 = ~Экко хмурится и сужает глаза. Минуту она смотрит в сторону, вздыхает, а потом кивает тебе.~
@38232 = ~Когда ты подходишь, Экко делает реверанс, а её аккуратно накрашенные губы складываются в тончайшую из улыбок.~
@38233 = ~Когда ты подходишь, Экко смотрит с надеждой, покусывая нижнюю губу.~
@38234 = ~Точка отсчёта.~
@38235 = ~Точка отсчёта.~
@38236 = ~Она качает головой, пожимает плечами и виновато улыбается.~
@38237 = ~Экко качает головой: «Нет, я и понятия не имею. Ты говорил с Ненни? Она всё всегда знает, слышит и видит».~
@38238 = ~Она поднимает бровь и скептически на тебя смотрит.~
@38239 = ~Она кивает и берёт у тебя бутыль. Осторожно вынимает язык из солевого раствора, замирает на мгновение, а затем, поборов отвращение, отправляет его в рот… внезапно её глаза расширяются, а между губ мелькает ярко-алая вспышка!~
@38240 = ~Экко открывает рот, закрывает, потом открывает ещё раз… и говорит! «Я… я снова могу говорить! Как здорово! Теперь я ПРОКЛЯНУ ТЕБЯ НА ВЕКИ ВЕЧНЫЕ, ТЫ, ГНИЮЩИЙ ЧЕРВЬ! НА КОЛЕНИ ПРЕДО МНОЙ, НАСЕКОМОЕ!»~
@38241 = ~Экко взвизгивает и закрывает рот обеими руками… глаза её округляются от ужаса.~
@38242 = ~Она убирает руку ото рта и кивает. «Похоже, я должна СОЖРАТЬ ТВОЮ ОБОЛОЧКУ И ОТПРАВИТЬ ТВОЮ ДУШУ В БЕЗДНУ НАВЕКИ! ТЫ БУДЕШЬ МОИМ РАБОМ, ПОКА САМИ ПЛАНЫ НЕ ОБРАТЯТСЯ В ПРАХ! ТЫ МОЙ, МОЙ, МО…» — Экко снова закрывает рот руками и начинает тихонько плакать.~
@38243 = ~Взгляд Экко подобен кинжалу, губы кривятся в усмешке.~
@38244 = ~Когда ты подходишь, Экко кивает и смотрит с надеждой.~
@38245 = ~Экко кивает, улыбается и берёт у тебя флакон. Она роняет несколько блестящих капель голубой жидкости на язык: «Я… я верю, слёзы помогут. Да… да! Я снова могу говорить своим собственным голосом! О, как я тебе благодарна!» Экко сжимает тебе руку и с благодарностью склоняет голову, глаза её наполняются слезами радости.~
@38246 = ~Экко кивает и показывает листок бумаги… это оказывается вексель на сумму в тысячу монет, которые владелец может получить от Борделя. Она вопросительно на тебя смотрит.~
@38247 = ~«О… я об этом как-то не подумала! Да-да… вот… — Экко вынимает несколько завёрнутых в пергамент столбиков монет. — Этого должно быть более чем достаточно. И ещё раз благодарю!» Она сердечно улыбается.~
@38248 = ~Экко сияет от счастья: «Ещё раз благодарю!» Она подходит и шепчет тебе в ухо, запах её духов опьяняет… «Твоя доброта прямо противоположна внешности». Она целует тебя в щёку, отходит и лезет в кошелёк: «Вот, друг мой… сколько бы ни стоили слёзы, это должно окупить расходы. Я настаиваю, чтобы ты взял».~
@38249 = ~Экко сияет от счастья: «Ещё раз благодарю!» Она подходит и шепчет в твоё ухо, запах её духов опьяняет… «Твоя доброта прямо противоположна внешности». Она целует тебя в щёку и с улыбкой отходит.~
@38250 = ~Экко кивает, смахивая остатки слёз. Она вынимает из кошелька и протягивает тебе несколько завёрнутых в пергамент столбиков монет: «Вот награда, сэр… честно заработанная».~
@38251 = ~Она кивает. «Конечно, — её голос холоден. — Вот, держи». Она протягивает тебе ещё несколько свёртков.~
@38252 = ~Экко радостно машет тебе рукой: «Приветствую, сэр, счастлива снова встретиться!»~
@38253 = ~Когда ты подходишь, Экко холодно кивает.~
@38254 = ~«Бордель — это своего рода школа, где молодые женщины… „проститутки“… — она криво улыбается, — …изучают искусство общения и его более тонкие проявления, как сказала бы мадам Грейс. Впоследствии ученицы, как правило, становятся Чующими. Бордель работает на деньги постоянных клиентов, которые приходят сюда, ища в обществе женщин чего-то большего, чем простое физическое удовольствие».~
@38255 = ~Экко кивает и понижает голос: «Я действительно знаю… есть не только она, у неё есть *дети*!»~
@38256 = ~«Одна из них порой бывает здесь… Кезай-Серрис. Она дочь Рейвел, хоть и отказывается принять этот факт. Но кто её может за это винить? — на мгновение Экко замолкает, задумавшись. — При мне она этого ни разу не признала, но всё же я уверена, что она её дочь».~
@38257 = ~Точка отсчёта.~
@38258 = ~«Я здесь ученица, как и все „проститутки“. Мы изучаем искусство общения, чтобы стимулировать разум… чтобы лучше понимать себя и других, чтобы придумывать новые способы познания других», — она замолкает, задумавшись.~
@38259 = ~«Ну… я так *долго* не могла разговаривать. И многие клиенты приходили ко мне в поисках внимательного слушателя, кого-то, кто выслушал бы их, не перебивая. Теперь же, когда я снова могу говорить, я думаю, мне пришла пора… покинуть Бордель и стать Чующей».~
@38260 = ~Она озадаченно смотрит на тебя, прежде чем покачать головой.~
@38261 = ~Экко выглядит озадаченной: «Я… не знаю никакой десятой ученицы. Может, она новенькая? Во всяком случае, даже если она есть, я её не встречала».~
@38262 = ~«Член Общества Восприятия. Спроси Падшую Грейс или кого-нибудь в Фестхолле, если хочешь узнать о них побольше».~
@38263 = ~~
@38264 = ~~
@38265 = ~«Я уже в неё влюбился!»~
@38266 = ~«И-их-ха!»~
@38267 = ~«А писать или изъясняться жестами можешь?»~
@38268 = ~«А?»~
@38269 = ~«Приветствую…»~
@38270 = ~«И снова привет…»~
@38271 = ~Оставить её в покое.~
@38272 = ~«У меня пара вопросов…»~
@38273 = ~«Мне пора идти. Прощай».~
@38274 = ~«Тебя зовут „Экко“?»~
@38275 = ~Хватит квасить, пень; я тебе говорю, хватит. Пойди домой, проспись.~
@38276 = ~«Могу я спросить, почему ты не можешь общаться?»~
@38277 = ~~
@38278 = ~«Ты знаешь *какой-нибудь* способ вернуть твой голос?»~
@38279 = ~«Кто ты?»~
@38280 = ~«Тебя зовут „Экко“?»~
