@38429 = ~~
@38430 = ~Оставить её в покое.~
@38431 = ~Эта высокая элегантная женщина с резкими чертами лица и царскими манерами — поразительный пример аристократической красоты. Её одежды вышиты серебряными нитками, маленький пузырёк висит у неё на ожерелье. Она надушена экзотическими эротичными духами с невероятно притягательным запахом.~
@38432 = ~~
@38433 = ~~
@38434 = ~Она оглядывает тебя, выгнув дугой бровь, и, как тебе кажется, свысока: «Приветствую. Меня зовут Вивьен, верно ли я предполагаю, что меня звали?»~
@38435 = ~«Нет, у меня всего лишь пара вопросов…»~
@38436 = ~«Нет. Прощай».~
@38437 = ~Эта женщина-упырь держится с большим достоинством, чем остальные. Да и глаза у неё чище и не такие дикие: «Могу я… помочь тебе, мясо?»~
@38438 = ~«Кто вы? Что вы здесь делаете?»~
@38439 = ~«Что это за место?»~
@38440 = ~«Нет, спасибо. Прощай».~
@38441 = ~«Я? Я… Алайна. А это мои упырёш-шки. Мы разс-сведчики и охотники. Мы ищ-щем новые территории… и новую *еду*. А теперь моя очередь с-спрашивать… что ТЫ тут делаеш-шь?»~
@38442 = ~«Я ищу бронзовую сферу».~
@38443 = ~«Я ищу графин воды».~
@38444 = ~«Я ищу склеп со множеством ловушек».~
@38445 = ~«Просто гуляю».~
@38446 = ~«Не знаю».~
@38447 = ~«Это З-затопленные Народы. Это наш-ша охотничья территория. Это… мес-сто где мы, охотницы, правим. Что тебе здес-сь нужно?»~
@38448 = ~«Я ищу бронзовую сферу».~
@38449 = ~«Я ищу графин воды».~
@38450 = ~«Я ищу склеп со множеством ловушек».~
@38451 = ~«Просто гуляю».~
@38452 = ~«Не знаю».~
@38453 = ~«Бронзовую… с-сферу? Мы такого… не находили. Может, на дальних концах этих земель ты и найдёш-шь её».~
@38454 = ~«У меня ещё пара вопросов…»~
@38455 = ~«Спасибо. Прощай».~
@38456 = ~«Здес-сь воды нет, но на вос-стоке земля влажная. Можш-шет найдёш-шь её там».~
@38457 = ~«У меня ещё пара вопросов…»~
@38458 = ~«Спасибо. Прощай».~
@38459 = ~«С-склепы тут кругом, и мы защ-щищаем их жителей. Я тебе не с-скажу».~
@38460 = ~«Найти её для меня очень важно».~
@38461 = ~«Найти её очень важно».~
@38462 = ~«Ладно. Тогда, может, ответишь на другие вопросы…»~
@38463 = ~«Хорошо. Тогда прощай».~
@38464 = ~«Это… плохое мес-сто для прогулок. Много опас-сностей. Безопас-сные пределы обозначены тотемами… ес-сли не заходить за них, будеш-шь жить. Следи за обитателями этих земель: они смертельны, и их вс-сё больше и больш-ше».~
@38465 = ~«Что это за обитатели?»~
@38466 = ~«Спасибо. Ответь мне на пару вопросов…»~
@38467 = ~«Спасибо. Прощай».~
@38468 = ~«Не знаеш-шь? Не знаеш-шь? Может… тебе лучш-ше уйти. Тут… опасно… для с-существ из мяс-са».~
@38469 = ~«Опасно? Насколько опасно?»~
@38470 = ~«У меня просто пара вопросов…»~
@38471 = ~«Спасибо. Прощай».~
@38472 = ~«Я… отвечу, ес-сли смогу».~
@38473 = ~«Кто вы? Что вы здесь делаете?»~
@38474 = ~«Что ты мне можешь сказать об этом месте?»~
@38475 = ~«Я ищу бронзовую сферу».~
@38476 = ~«Я ищу графин воды».~
@38477 = ~«Я ищу склеп со множеством ловушек».~
@38478 = ~«Забудь. Прощай».~
@38479 = ~Капитан упырей холодно смотрит на тебя, оценивая: «Ищ-щи на юго-вос-стоке от с-сюда. Не трогай других жш-шителей этих гробниц, иначе *пожалееш-ш-шь*».~
@38480 = ~«Благодарю. У меня ещё пара вопросов…»~
@38481 = ~«Спасибо. Прощай».~
@38482 = ~Капитан упырей холодно смотрит на тебя, в её глазах разгорается пламя: «Меня *НЕ* волнует, насколько это ваш-шно для тебя. Я тебе *НЕ СКАЖУ*».~
@38483 = ~«Ладно-ладно. Просто ответь тогда на другие вопросы».~
@38484 = ~«Скажи или умрёшь».~
@38485 = ~«В любом случае спасибо. Прощай».~
@38486 = ~«Эти места нас-с-селяют… трокопотоки, белые, рогатые с-с-существа с неизмеримым аппетитом и врождённой жес-стокос-стью. Ещё здесь час-с-сто селятся варгуйльи, и их становится вс-с-сё больше, благодаря тем глупцам, что забираютс-с-ся так далеко в катакомбы».~
@38487 = ~«Ясно… можешь ответить ещё на пару вопросов?»~
@38488 = ~«Спасибо за совет. Прощай».~
@38489 = ~«Вернулс-ся, да? Чего тебе нуш-шно?»~
@38490 = ~«Нужны ответы на кое-какие вопросы…»~
@38491 = ~«Ничего. Прощай».~
@38492 = ~«С-с-с… сущес-с-ство из мяс-с-са, тут тебе не мес-с-сто».~
@38493 = ~«Что ты здесь делаешь?»~
@38494 = ~«Что это за место?»~
@38495 = ~«Кто ты?»~
@38496 = ~«Тогда я пойду. Счастливо».~
@38497 = ~«Мы хотим рас-с-сширить наш-ш дом. Уничтожить врагов… найти еду и не трогать шагающ-щ-щее мяс-с-со, да? Безмолвный Король с-с-сказал нам… никакого ш-ш-шагающего мяс-са».~
@38498 = ~«Кто такой Безмолвный Король?»~
@38499 = ~«Что это за место?»~
@38500 = ~«Кто ты?»~
@38501 = ~«Спасибо. Прощай».~
@38502 = ~«Это? Это З-з-затопленные Народс-с-сы. Это наш-ш-ши новые ох-хотничьи угодья. Это… это наш-ша кладовая».~
@38503 = ~«Ясно. Прощай».~
@38504 = ~«Мы ес-с-сть разведчики, раз-зведчики Мёртвых-х Народов».~
@38505 = ~«Что вы разведываете?»~
@38506 = ~«Ясно. Тогда прощай».~
@38507 = ~«С-с-с! — упырь разочарованно шипит. — Безмолвный Король наш-ш правитель. Акас-с-ста — наш-ш-ш лидер! С-с-скоро мы найдём баланс-с-с меж-жду ними!»~
@38508 = ~«Так кто же ты такой?»~
@38509 = ~«Ясно. Прощай».~
@38510 = ~«С-с-с… мяс-со вернулос-с-сь…»~
@38511 = ~«Что ты здесь делаешь?»~
@38512 = ~«Что это за место?»~
@38513 = ~«Кто ты?»~
@38514 = ~«Тогда я пойду. Счастливо».~
@38515 = ~Эта женщина-упырь держится с большим достоинством, чем остальные. Да и глаза у неё чище и не такие дикие. «Чем могу… помочь тебе, мяс-со?»~
@38516 = ~«Кто ты? Что здесь делаешь?»~
@38517 = ~«Я? Я… Алайна. А это мои упыри. Мы разведчики и охотники. Ищ-щем новые земли… ищ-щем новую *еду*. А теперь моя очередь с-с-спрашивать… что ТЫ тут делаеш-шь?»~
@38518 = ~«Ищу бронзовую сферу».~
@38519 = ~«Бронзовую… с-сферу? Мы такого… не находили. Может, на дальних концах этих земель ты и найдёш-шь её».~
@38520 = ~«У меня была ещё пара вопросов…»~
@38521 = ~«Я… отвечу, на какие с-с-смогу».~
@38522 = ~«Кто ты? Что здесь делаешь?»~
@38523 = ~«Что можешь рассказать об этом месте?»~
@38524 = ~«Это З-затопленные Народы. Наш-ши охотничьи угодья. Это… мес-с-сто, где правим мы, охотники. Что тебе здес-с-сь нужно?»~
@38525 = ~«Я ищу бронзовую сферу».~
@38526 = ~«Я ищу графин воды».~
@38527 = ~«Здес-сь нет воды, но на вос-стоке земля влажная. Может, там ты найдёш-шь её».~
@38528 = ~«У меня была ещё пара вопросов…»~
@38529 = ~«Спасибо. Прощай».~
@38530 = ~«Я ищу склеп, изобилующий ловушками».~
@38531 = ~«Тут кругом с-с-склепы, и мы защищ-щаем их обитателей… я тебе не с-с-скажу».~
@38532 = ~«Для меня очень важно найти её».~
@38533 = ~Командир упырей холодно смотрит на тебя, оценивая. «Ищ-щи на юго-востоке от с-с-сюда. Не трогай других обитателей этих с-склепов, иначе *пожалееш-шь*».~
@38534 = ~«Благодарю. У меня ещё пара вопросов…»~
@38535 = ~«Спасибо. Прощай».~
@38536 = ~«Её очень важно найти».~
@38537 = ~Командир упырей холодно смотрит на тебя, её глаза разгораются: «Меня *НЕ* волнует, насколько это важно для тебя, мяс-с-со. Я тебе *НЕ* с-скажу».~
@38538 = ~«Ладно, ладно. Просто ответь тогда на другие вопросы».~
@38539 = ~«Говори или умрёшь».~
@38540 = ~«В любом случае спасибо. Счастливо».~
@38541 = ~«Ладно. Тогда ответь на другие вопросы…»~
@38542 = ~«Хорошо. Тогда прощай».~
@38543 = ~«Просто брожу тут».~
@38544 = ~«Это… плохое мес-с-сто, чтобы бродить. Много опас-с-сностей. Безопас-сные пределы обозначены тотемами… ес-сли не заходить за них, будеш-шь жить. Берегис-сь обитателей этих земель… они с-смертельны, и их вс-сё больше и больш-ше».~
@38545 = ~«Что за обитатели?»~
@38546 = ~«Эти места наводняют… трокопотаки, белые, рогатые с-с-существа с неизмеримым аппетитом и врождённой жес-стокос-стью. Ещё здесь час-с-сто селятся варгуйльи, и их с-становится вс-с-сё больше благодаря глупцам, что забираютс-с-ся так далеко в катакомбы».~
@38547 = ~«Ясно… можешь ответить ещё на пару вопросов?»~
@38548 = ~«Спасибо за сведения. Счастливо».~
@38549 = ~«Спасибо. Ответь мне на пару вопросов…»~
@38550 = ~«Спасибо. Прощай».~
@38551 = ~«Не знаю».~
@38552 = ~«Не знаеш-шь? Не знаеш-шь? Может… тебе лучш-ше уйти. Тут… опас-сно… для с-существ из мяс-с-са».~
@38553 = ~«Опасно? Насколько опасно?»~
@38554 = ~«У меня только пара вопросов…»~
@38555 = ~«Спасибо. Прощай».~
@38556 = ~«Я ищу бронзовую сферу».~
@38557 = ~«Я ищу графин воды».~
@38558 = ~«Я ищу склеп, изобилующий ловушками».~
@38559 = ~«Забудь. Прощай».~
@38560 = ~«Спасибо. Прощай».~
@38561 = ~«Ищу графин воды».~
@38562 = ~«Ищу склеп, изобилующий ловушками».~
@38563 = ~«Просто брожу тут».~
@38564 = ~«Не знаю».~
@38565 = ~«Что это за место?»~
@38566 = ~«Нет, спасибо. Прощай».~
@38567 = ~«Вернулс-с-ся, да? Чего тебе нужно?»~
@38568 = ~«Нужны ответы на кое-какие вопросы…»~
@38569 = ~«Ничего. Прощай».~
