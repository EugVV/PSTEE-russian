@36964 = ~Ловушка не обезврежена [Вейлор]~ [VHA234]
@36965 = ~Найдена ловушка [Безымянный]~ [NAM099]
@36966 = ~Найдена ловушка [Морте]~ [MRT427A]
@36967 = ~Найдена ловушка [Анна]~ [ANA481C]
@36968 = ~Найдена ловушка [Дак'кон]~ [DAK179]
@36969 = ~Найдена ловушка [Падшая Грейс]~
@36970 = ~Найдена ловушка [Нордом]~ [NOR244]
@36971 = ~Найдена ловушка [Игнус]~ [IGN228]
@36972 = ~Найдена ловушка [Вейлор]~ [VHA236]
@36973 = ~Скрыться в тенях не удалось [Безымянный]~ [NAM162]
@36974 = ~Скрыться в тенях не удалось [Морте]~ [MRT413B]
@36975 = ~Скрыться в тенях не удалось [Анна]~ [ANA518A]
@36976 = ~Скрыться в тенях не удалось [Дак'кон]~ [DAK199]
@36977 = ~Скрыться в тенях не удалось [Падшая Грейс]~
@36978 = ~Скрыться в тенях не удалось [Нордом]~ [NOR228]
@36979 = ~Скрыться в тенях не удалось [Игнус]~ [IGN221]
@36980 = ~Скрыться в тенях не удалось [Вейлор]~ [VHA224]
@36981 = ~Скрыться в тенях не удалось [Общий, другие NPC]~
@36982 = ~Скрыться в тенях удалось [Безымянный]~ [NAM174]
@36983 = ~Скрыться в тенях удалось [Морте]~ [MRT430D]
@36984 = ~Скрыться в тенях удалось [Анна]~ [ANA421C]
@36985 = ~Скрыться в тенях удалось [Дак'кон]~ [DAK181]
