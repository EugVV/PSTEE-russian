@8939  = ~«Хорошо. У меня кое-какие вопросы…»~
@8940  = ~Оставить мужчину в покое.~
@8941  = ~Ждать и слушать ответ Дак'кона.~
@8942  = ~«Дак'кон, забудь. Пошли».~
@8943  = ~Попытаться перевести…~
@8944  = ~«Дак'кон, забудь. Пошли».~
@8945  = ~Ждать и слушать ответ Дак'кона.~
@8946  = ~«Дак'кон, забудь. Пошли».~
@8947  = ~Прервать: «Дак'кон подчиняется мне. Он мой раб».~
@8948  = ~Прервать: «Да, Дак'кон выполняет мои приказы. Он мой слуга».~
@8949  = ~Прервать: «Я его командир. Дак'кон сопровождает меня в странствиях».~
@8950  = ~Ждать и слушать, что скажет Дак'кон…~
@8951  = ~Ждать и слушать, что скажет Дак'кон…~
@8952  = ~«Дак'кон, забудь. Пошли».~
@8953  = ~Слушать.~
@8954  = ~«Дак'кон, забудь. Пошли».~
@8955  = ~«Твой взгляд начинает действовать мне на нервы. Обращайся ко мне, а не к моему рабу. Ты будешь отвечать на мои вопросы или нет?»~
@8956  = ~«Я предпочёл бы, чтобы ты обращался ко мне, а не к моему товарищу. Ты ответишь на мои вопросы или нет?»~
@8957  = ~«Что-то не так?»~
@8958  = ~«Забудь об этом, Дак'кон. Пошли».~
@8959  = ~«Что, страшно, собака гитиянки? Ну-ка ударь, если посмеешь».~
@8960  = ~«Что, страшно, собака гит? Ну-ка ударь, если посмеешь».~
@8961  = ~Дать ему уйти.~
@8962  = ~Напасть на гита, когда отвернётся.~
@8963  = ~«Говори со мной, а не с ним, гит».~
@8964  = ~«Что-то не так?»~
@8965  = ~Ждать и слушать, что скажет Дак'кон.~
@8966  = ~«Забудь об этом, Дак'кон. Пошли».~
@8967  = ~«Давай же. Ударь меня, гит. Увидишь, что будет».~
@8968  = ~«Если он хоть шаг ко мне сделает, Дак'кон, я хочу, чтобы ты его убил».~
@8969  = ~«Успокойтесь все. Я просто хотел задать пару вопросов».~
@8970  = ~Ждать и слушать, что скажет Дак'кон…~
@8971  = ~Ждать и слушать, что скажет Дак'кон…~
@8972  = ~Напасть на гита, пока он отвлёкся.~
@8973  = ~«Давай же, собака гитиянки. Ударь меня, если не страшно».~
@8974  = ~«Давай же, собака гит. Ударь меня, если не страшно».~
@8975  = ~Ждать, чем всё это кончится…~
@8976  = ~Ждать, чем всё это кончится…~
@8977  = ~Напасть на гита, пока он отвлёкся.~
@8978  = ~«Родич Зерчаи кланяется тебе».~
@8979  = ~«Приветствую, звучащий клинок».~
@8980  = ~«Приветствую».~
@8981  = ~Оставить гита в покое.~
@8982  = ~Ложь: «Ты обвиняешь человека, который путешествует с гитцерай-*зертом*, в убийстве гитцерай? Должно быть, ты меня с кем-то спутал».~
@8983  = ~Ложь: «Должно быть, это ошибка. Я никогда не убивал никого из твоего народа».~
@8984  = ~Ложь: «Я никого не убивал. Наверное, ты меня с кем-то перепутал».~
@8985  = ~Напасть на него первым.~
@8986  = ~Проигнорировать гита и уйти.~
@8987  = ~Ложь: «Просто подумай, это же огромный город. Я не тот, кого ты ищешь. Я не причинил вреда ни тебе, ни твоему народу».~
@8988  = ~Напасть на него первым.~
@8989  = ~«На самом деле, в первый раз ты был прав. Я просто ждал, когда ты ослабишь бдительность…»~
@8990  = ~«На самом деле, в первый раз ты был прав. Я просто ждал, когда ты ослабишь бдительность…»~
@8991  = ~«Уж будь добр. Прощай».~
@8992  = ~«Скажи ему, что он ошибся, Дак'кон».~
@8993  = ~Напасть на него, пока он смотрит на Дак'кона.~
@8994  = ~«О да, это так. Знай своё место, Дак'кон. Ты мой раб и *будешь* служить мне».~
@8995  = ~«О да, это так. Я ни мгновения больше не буду стоять здесь и выслушивать ваше гитское гавканье».~
@8996  = ~«Если я кого обидел, то прошу прощения. Ты простишь меня?»~
@8997  = ~«Неважно, Дак'кон. Пошли».~
@8998  = ~Ждать, что будет делать гит.~
@8999  = ~«Мы вместе, гит. Тебе лучше уступить».~
@9000  = ~«Ещё один шаг ко мне, гит, и он бросится на тебя. А если ты пробьёшься через него, клянусь, я убью тебя. Сдавайся».~
@9001  = ~«Довольно. Прощайся с жизнью, гит».~
@9002  = ~Ждать, что будет делать гит.~
@9003  = ~«Мы вместе, гит. Тебе лучше уступить. Последний раз предупреждаю».~
@9004  = ~«Ещё один шаг ко мне, гит, и он бросится на тебя. А если ты пробьёшься через него, клянусь, я убью тебя. Сдавайся».~
@9005  = ~«Довольно. Прощайся с жизнью, гит».~
@9006  = ~Ждать…~
@9007  = ~«Твой выбор, гит. Ты хочешь, чтобы сегодня пролилась кровь?»~
@9008  = ~«Довольно. Прощайся с жизнью, гит».~
@9009  = ~«Что он говорит, Дак'кон?»~
@9010  = ~«Дак'кон, забудь. Пошли».~
@9011  = ~Слушать.~
@9012  = ~«Дак'кон, забудь. Пошли».~
@9013  = ~Слушать.~
@9014  = ~«Дак'кон, забудь. Пошли».~
@9015  = ~Ждать.~
@9016  = ~«Дак'кон, забудь. Пошли».~
@9017  = ~«Если бы ты спросил его…»~
@9018  = ~«Дак'кон, забудь. Пошли».~
@9019  = ~«Видишь? Может, теперь уберёшь свой ковыряльник?»~
@9020  = ~Напасть на гита, пока он смотрит на Дак'кона.~
@9021  = ~«Что он сказал?»~
@9022  = ~«Неважно, Дак'кон. Пошли».~
@9023  = ~«Гита?»~
@9024  = ~«Гита?»~
@9025  = ~«Я пока не готов уйти. Сначала я собираюсь задать ему кое-какие вопросы…»~
@9026  = ~Оставить гита в покое.~
@9027  = ~«Я пока не готов уйти. Сначала я собираюсь задать ему кое-какие вопросы…»~
@9028  = ~Оставить гита в покое.~
@9029  = ~«С гитами?»~
@9030  = ~«С гитами?»~
@9031  = ~«Я пока не готов уйти. Сначала я собираюсь задать ему кое-какие вопросы…»~
@9032  = ~Оставить гита в покое.~
@9033  = ~«Я пока не готов уйти. Сначала я собираюсь задать ему кое-какие вопросы…»~
@9034  = ~Оставить гита в покое.~
@9035  = ~«Я пока не готов уйти. Сначала я собираюсь задать ему кое-какие вопросы…»~
@9036  = ~Оставить гита в покое.~
@9037  = ~Отойти в сторону и дать ему пройти.~
@9038  = ~Краддок~
@9039  = ~Пьяный~
@9040  = ~Гвоздичка~
@9041  = ~Профира~
@9042  = ~Рабочий~
@9043  = ~Криден~
@9044  = ~Завсегдатай «Горящего трупа»~
@9045  = ~Бариаур~
@9046  = ~Гитский торговец~
@9047  = ~Вонючий бомж из Улья~
@9048  = ~Торговец из Улья~
@9049  = ~Надсмотрщик~
@9050  = ~Оружейник~
@9051  = ~Мусорщица из Улья~
@9052  = ~Пьяный~
@9053  = ~Предсказательница~
@9054  = ~Смотритель работ~
@9055  = ~Ведьма~
@9056  = ~Человек с дикими глазами~
@9057  = ~Управляющий Боготов~
@9058  = ~Рабочий~
@9059  = ~Завсегдатай из Убийц Милосердия~
@9060  = ~Дух мимолётно улыбается, как от удовольствия. Затем успокаивается, убирает одну руку за спину и произносит мягким напевным голосом:

«Суянг джианн шир нан бай йих нан;
Донг фенг ву ли бэй хуа тсарн;
Чуен тсарн дау сйй сй фанг джинн;
Ла Джиу чонг хуэй лей ший ган».

Произнеся всё это, он терпеливо ждёт твоего ответа.~
@9061  = ~Ты открываешь было рот, чтобы задать вопрос, но не успеваешь — дух произносит мягким напевным голосом:

«Суянг джианн шир нан бай йих нан;
Донг фенг ву ли бэй хуа тсарн;
Чуен тсарн дау сйй сй фанг джинн;
Ла Джиу чонг хуэй лей ший ган».

Произнеся всё это, он терпеливо ждёт твоего ответа.~
@9062  = ~Дух на миг замолкает, как бы в раздумье. Затем он произносит с сильным акцентом, но глубоким и чистым голосом: «Прости меня, досточтимый сэр. Немало времени прошло с тех пор, когда мне приходилось говорить на твоём языке. Без сомнения, мой дух был вызван для того, чтобы ты вопросил его. Что же ты хочешь узнать от меня?»~
@9063  = ~«Кто я — очень трудно сказать… а вот кем я *был*, ответить проще. Я был известен как Чуань Беи, наставник и телохранитель Лю Ксикси, дочери Цензора Чи'аня».~
@9064  = ~«Я происхожу из места, называемого Шоу Лунг… места, которое я когда-то считал центром Вселенной, — кажется, он находит эту мысль несколько забавной. — Столько мест, столько миров. Когда-то я полагал себя высокообразованным человеком, но на самом деле к моменту смерти знал так мало…»~
@9065  = ~«Я был убит одним из тех, с кем попал в этот мир. Я выслеживал его в этом городе много-много недель — тогда-то я и выучил ваш язык — но он нашёл меня раньше. Он был убийца-профессионал, он застал меня врасплох и зарезал во сне».~
@9066  = ~«Это здание? Ничего особенного; я слышал о нём и знал, что моё тело должно служить его обитателям, но это и всё.

Почти так же мало я знаю и об этом великом городе, „Сигиле“. Недели, проведённые здесь, были заняты поиском тех, с кем я оказался заброшен в этот мир, и изучением языка; хотя и с болью в сердце, но я не мог выделить время ни на что другое. Иначе я мог бы узнать так много о мириадах чудес этого места…»~
@9067  = ~«Нет, это имя ничего мне не говорит. Прости, но я ничем не могу помочь тебе в этом».~
@9068  = ~На миг в голосе духа проскальзывает боль:

«Я… мой дух обитает в мире Прославленного Судьи, Йен-Ван-Йе: во Дворце Правосудия».~
@9069  = ~«Да, там, откуда я родом, это не так уж необычно. Мой долг был всё время находиться рядом с госпожой Лю и не только оберегать её, но и давать ей уроки. Я был не только мастером меча, но и известным учёным. Хотя, быть может, если бы я больше совершенствовался во владении оружием, то послужил бы ей лучше…»~
@9070  = ~«Внушительно? Да, возможно, даже слишком для меня. Я… не оправдал надежд госпожи Лю и господина Цензора, возложенных на меня».~
@9071  = ~Дух кивает с неожиданной для высохшего тела грацией: «Спрашивай, о чём ты хочешь узнать».~
@9072  = ~«Видишь ли… — дух на миг останавливается в раздумье, сложив иссохшие руки вместе. — Когда я прибыл, то после недолгого ожидания меня препровождали в окончательное, *подлинное* место моего назначения. Однако, когда меня вели через Дворец, возникли небольшие волнения, и мои провожатые оставили меня одного в боковой комнате, пообещав, что тотчас же вернутся».~
@9073  = ~«Я расскажу тебе всю мою историю. Как наставник и телохранитель Лю Ксикси, я должен был обеспечивать её безопасность и образование. В один чудный вечер мы стояли на балконе, выходившем во двор, и я рассказывал ей о различных созвездиях».~
@9074  = ~«Ах, это. В одну из ночей ко мне подошла на улице молодая женщина. Она принадлежала к организации, называвшей себя Пыльными, то есть к той самой, которой принадлежит этот комплекс. Она предложила мне небольшую сумму денег за то, чтобы моё тело можно было… использовать… здесь после моей кончины».~
@9075  = ~«Языкознание всегда вызывало во мне жгучий интерес. Когда я стал учёным, выяснилось, что я могу усваивать новые языки почти без труда».~
@9076  = ~«Видишь ли… за мной так никто и не пришёл. Я терпеливо ждал несколько дней, но никого не дождался. Наконец я оставил комнату и отправился бродить по Дворцу, надеясь что встречу кого-нибудь, кто направит меня… — он вздыхает, распространяя слабый запах жидкости для бальзамирования. — В этом дворце девять тысяч и одна комната, и в каждой из комнат, в которую я входил, меня просто направляли в другую комнату. Похоже, я до поры до времени выпал из поля зрения».~
@9077  = ~«Я не могу сказать. Это было такое разочарование!» — он на короткое время прерывается, чтобы вновь обрести спокойствие, окоченевшие суставы и сухожилия трупа слегка потрескивают.~
@9078  = ~«Разумеется. Когда мы стояли там, с крыши на балкон вдруг спрыгнули двое убийц, они, скорее всего, хотели убить или похитить госпожу Лю. Призывая стражу, я выхватил клинок и бросился на её защиту. Завязалась драка, опоры балкона от сотрясения обрушились, и мы четверо упали в Нефритовый портал».~
@9079  = ~«Правда, сначала… эта мысль показалась мне дикой. Но после продолжительной беседы с той женщиной я понял, что они — Пыльные — придерживаются почти такого же отношения к смерти, что и я сам. Моё тело? Всего лишь оболочка, ничего больше. Я полагаю, их так называемая „Истинная Смерть“, и есть то возвышенное состояние, которого я сам жажду достичь… полное освобождение и отчуждение от материального мира. Если же моё тело, служившее мне смертной оболочкой, сможет послужить ещё и здесь, тем лучше», — дух учтиво улыбается тебе.~
@9080  = ~«О! Нижайше прошу прощения за упущение… Нефритовый портал — это круглый бассейн в нашем дворе. Выложенный плитками зелёного и белого камня, он называется порталом за то, что иногда в его мерцающей воде можно увидеть отражения каких-то других мест».~
@9081  = ~«Твоё предложение более чем великодушно. Однако, я опасаюсь, что ты ничем не можешь мне помочь… Я убеждён, что когда-нибудь мне улыбнётся удача на моём пути. Тем не менее, ещё раз спасибо тебе».~
@9082  = ~Дух холодно смотрит на тебя, в глазах трупа горит призрачный огонь; похоже, ты обидел его.~
@9083  = ~«О, это… а… то были стихи. Их трудно перевести на ваш язык. Возможно, у тебя есть другие вопросы?» — он смущённо улыбается.~
@9084  = ~«Как я уже говорил, мы упали в Нефритовый портал. Я никогда не мог предположить, что этот бассейн — *действительно* портал в подлинном смысле слова, но так оно и оказалось! Внезапно я обнаружил себя лежащим в каком-то незнакомом переулке со сломанной ногой. На время придя в себя, я лишь успел заметить, как убийцы убегают прочь, а один из них несёт Лю Ксикси на плече».~
@9085  = ~«Хорошо», — он на миг задумывается, сводит вместе тонкие костлявые пальцы. Вскорости он произносит в чётком, бодром ритме:

«Его трудно встретить и трудно покинуть.
Северный ветер ослаб; сотни цветов завяли.
Когда умрут шелковичные черви, шёлка больше не будет.
Когда воск свечи станет пеплом, кончатся слёзы».

Он учтиво улыбается тебе.~
@9086  = ~«Хорошо, мне стыдно говорить, но то была тонкая попытка намекнуть… намекнуть, что лучше бы тебе оставить души умерших в покое. Я не желаю более иметь что-либо общее с этим… — дух делает размашистый жест, как бы охватывая всё вокруг себя, — …миром».~
@9087  = ~«А… ну… нет. Я не хотел говорить так прямо; ты видишь, что я стараюсь избегать конфликтов. Но я не желаю более иметь что-либо общее с этим… — дух делает размашистый жест, как бы охватывая всё вокруг себя, — …миром».~
@9088  = ~«Это почти всё. Я с трудом хромал до тех пор, пока не нашёл лекаря, который вылечил мою ногу. Я оставил ему за это все свои деньги, а было их немного. У лекаря и у других я выучился здешнему языку, и всё это время я рыскал в поисках двух убийц и своей подопечной».~
@9089  = ~«Я выследил одного из них, но он ничего не сказал. Я казнил его и сохранил голову в шёлковом мешке, чтобы принести её Цензору, когда я верну его дочь, — минуту он хмурится, затем продолжает. — Второй убийца… ускользнул от меня. Даже больше: он зарезал меня, прежде чем я смог убить его и освободить мою подопечную. Печально, но теперь всё это в прошлом».~
@9090  = ~«Нет, но я был уверен, что найду путь. Теперь это, конечно, спорный вопрос».~
@9091  = ~«Твоё предложение говорит о врождённом благородстве… однако с тех пор, как я погиб, прошло семьдесят пять лет или даже больше. Мой убийца давно мёртв, и Ксикси, вероятно, тоже».~
@9092  = ~«Убийца был внешне похож на меня, а на его лбу была татуировка в виде цветущего лотоса, — видя твоё замешательство, он добавляет. — Это такой цветок с семью лепестками. Лю Ксикси — юная девушка; ей всего четырнадцать лет. Может быть, она или тот убийца знают путь назад и знают, как снова активировать портал».~
@9093  = ~«Ты добрый и благородный человек. Однако не стоит делать это ради меня… помоги ей и её отцу».~
@9094  = ~«Я определённо не ожидал встретиться с тобой снова, — дух учтиво кланяется, но без всякого выражения. — Что тебе нужно от меня?»~
@9095  = ~Оставить труп в покое.~
@9096  = ~«У меня есть несколько вопросов…»~
@9097  = ~Оставить дух в покое.~
@9098  = ~«Я… э-э…»~
@9099  = ~«Я понятия не имею, о чём ты говоришь… ты вообще понимаешь меня?»~
@9100  = ~«Я не могу тебя понять. Прощай».~
@9101  = ~«Я… э-э…»~
@9102  = ~«Я понятия не имею, о чём ты говоришь… ты вообще понимаешь меня?»~
@9103  = ~«Я не могу тебя понять. Прощай».~
@9104  = ~«Кто ты?»~
@9105  = ~«Откуда ты?»~
@9106  = ~«Как ты попал сюда? В смысле, в виде зомби».~
@9107  = ~«Где ты… то есть где сейчас находится… твой дух?»~
@9108  = ~«Что ты знаешь об этом месте?»~
@9109  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@9110  = ~«Ничего, неважно».~
@9111  = ~«Наставник *и* телохранитель?»~
@9112  = ~«Хм-м. Звучит внушительно».~
@9113  = ~«Ясно. У меня другие вопросы…»~
@9114  = ~«Это всё, что я хотел узнать. Прощай».~
@9115  = ~«Как ты попал сюда из этого „Шоу Лунга“?»~
@9116  = ~«Ясно. У меня другие вопросы…»~
@9117  = ~«Это всё, что я хотел узнать. Прощай».~
@9118  = ~«Попал в этот мир?»~
@9119  = ~«Ты выслеживал убийц?»~
@9120  = ~«Понятно, но знаешь ли ты, как попало сюда твоё тело?»~
@9121  = ~«Ты очень хорошо владеешь языком, если учил его всего несколько недель».~
@9122  = ~«Ясно. У меня другие вопросы…»~
@9123  = ~«Это всё, что я хотел узнать. Прощай».~
@9124  = ~«Твоё тело должно было служить обитателям этого места? Как так?»~
@9125  = ~«Оказался заброшен в этот мир?»~
@9126  = ~«Ты очень хорошо владеешь языком, если учил его всего несколько недель».~
@9127  = ~«Ясно. У меня другие вопросы…»~
@9128  = ~«Ладно. Может быть, мы ещё поговорим с тобой».~
@9129  = ~«Я понял. У меня другие вопросы…»~
@9130  = ~«Ладно. Может быть, мы ещё поговорим с тобой».~
@9131  = ~«Что-то не так? Это такое плохое место?»~
@9132  = ~«Я понял. У меня другие вопросы…»~
@9133  = ~«Это всё, что я хотел узнать. Прощай».~
@9134  = ~«Послужил бы ей лучше? Ты как-то подвёл её?»~
@9135  = ~«Быть может. У меня другие вопросы…»~
@9136  = ~«Это всё, что я хотел узнать. Прощай».~
@9137  = ~«Как так?»~
@9138  = ~«У меня другие вопросы…»~
@9139  = ~«Ясно. Может быть, мы ещё поговорим с тобой».~
@9140  = ~«Кто ты?»~
@9141  = ~«Откуда ты?»~
@9142  = ~«Как ты попал сюда? В смысле, в виде зомби».~
@9143  = ~«Где ты… то есть где сейчас находится… твой дух?»~
@9144  = ~«Что ты знаешь об этом месте?»~
@9145  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@9146  = ~«Что ты сказал, когда только появился здесь?»~
@9147  = ~«Неважно. Прощай».~
@9148  = ~«И?..»~
@9149  = ~«Окончательное место назначения? И куда тебя должны были препроводить?»~
@9150  = ~«Подожди… я хочу спросить тебя, а потом ты продолжишь свой рассказ».~
@9151  = ~«Может быть, я дослушаю твою историю в другой раз. Прощай».~
@9152  = ~«Пожалуйста, продолжай».~
@9153  = ~«Наставник *и* телохранитель?»~
@9154  = ~«Может быть, я дослушаю твою историю в другой раз. Прощай».~
@9155  = ~«И это не показалось тебе несколько странным?»~
@9156  = ~«Ясно. Ещё вопрос, если позволишь…»~
@9157  = ~«Это всё, что я хотел узнать. Прощай».~
@9158  = ~«Это многое объясняет. Ещё вопрос…»~
@9159  = ~«Я понял. Спасибо, что поговорил со мной. Прощай».~
@9160  = ~«Ясно. Но у меня другие вопросы…»~
@9161  = ~«Могу я тебе чем-нибудь помочь?»~
@9162  = ~«Бедный дурачок… интересно, как долго тебе позволят так бродить?!»~
@9163  = ~«Желаю тебе удачи. Прощай».~
@9164  = ~«Пожалуйста, продолжай свой рассказ».~
@9165  = ~«Могу представить… Я хотел спросить о другом…»~
@9166  = ~«Может быть, я дослушаю твою историю в другой раз. Прощай».~
@9167  = ~«Что? Нефритовый портал?»~
@9168  = ~«Подожди… Я хочу спросить тебя, а потом ты продолжишь свой рассказ».~
@9169  = ~«Может быть, я дослушаю твою историю в другой раз. Прощай».~
@9170  = ~«Я понял твои аргументы. Ещё вопрос…»~
@9171  = ~«Интересно. Пожалуй, мне лучше уйти; прощай».~
@9172  = ~«Ясно. Продолжай свою историю».~
@9173  = ~«Перед тем как ты продолжишь, у меня есть ещё вопросы…»~
@9174  = ~«Это всё, что я хотел сейчас узнать. Прощай».~
@9175  = ~«Разумеется. Я хотел спросить о другом…»~
@9176  = ~«Не беспокойся. Пожалуй, мне лучше уйти; прощай».~
@9177  = ~«Прошу прощения. Могу я спросить тебя о другом?»~
@9178  = ~Уйти, оставив дух витать здесь.~
@9179  = ~«Да… да, есть».~
@9180  = ~«Нет… но кажется, мне хотелось бы узнать об этих стихах побольше».~
@9181  = ~«Нет. На самом деле мне лучше бы уйти. Прощай».~
@9182  = ~«Странно. Продолжай, прошу тебя».~
@9183  = ~«О. Прежде чем ты продолжишь свой рассказ, я хочу спросить…»~
@9184  = ~«Ясно. Спасибо тебе, но я лучше пойду».~
@9185  = ~«А… у меня есть ещё вопрос».~
@9186  = ~«Интересно. И что это значит?»~
@9187  = ~«Ты имеешь в виду, что я должен оставить твой дух в покое? Я обидел тебя тем, что вызвал сюда?»~
@9188  = ~«О. Спасибо, что объяснил. Прощай».~
@9189  = ~«Хм-м. Ясно. Я хотел спросить тебя ещё кое о чём».~
@9190  = ~«Я понял. Тогда прощай».~
@9191  = ~«Хм-м. Ясно. Я хотел спросить тебя ещё кое о чём…»~
@9192  = ~«Я понял. Тогда прощай».~
@9193  = ~«И ты их не нашёл?»~
@9194  = ~«Хм-м. Знаешь, это просто удивительно, как быстро ты выучил язык…»~
@9195  = ~«О. Прежде чем ты продолжишь свой рассказ, я хочу спросить…»~
@9196  = ~«Я дослушаю твой рассказ в другой раз; прощай».~
@9197  = ~«А ты нашёл способ вернуться на родину, если бы спас эту… „Кси-кси“?»~
@9198  = ~«Любопытная история. Но у меня есть ещё вопросы…»~
@9199  = ~«Впечатляет. А теперь я лучше покину тебя. Прощай».~
@9200  = ~«А вдруг они до сих пор в городе. Быть может, я мог бы найти эту девушку и помочь ей».~
@9201  = ~«Тебе просто забыть о своём долге, раз ты уже умер. Не знаю, смог бы я вот так вот всё оставить».~
@9202  = ~«Интересно. Я хочу спросить тебя…»~
@9203  = ~«Хм-м. Прощай. Удачи тебе».~
@9204  = ~~
@9205  = ~«Хм-м. Ладно, неважно. Я хотел спросить о другом…»~
@9206  = ~«Тогда неважно. Прощай».~
@9207  = ~«Если я увижу её, я сделаю всё, чтобы помочь, в память о тебе».~
@9208  = ~«Забудь. У меня нет на это времени».~
@9209  = ~«Хорошо. Я хотел спросить о другом…»~
@9210  = ~«Это всё, что мне нужно. Прощай».~
@9211  = ~«Хорошо. Я хотел спросить о другом…»~
@9212  = ~«Я понял. Прощай, дух».~
@9213  = ~«Вопрос…»~
@9214  = ~«Ничего; я покидаю тебя».~
@9215  = ~Посмертный договор Ангияра~
@9216  = ~Древковое оружие~
@9217  = ~Кулон Йемета~
@9218  = ~Поддельный посмертный договор~
@9219  = ~Посмертный договор Медноглазого~
@9220  = ~Отгонять нежить~
@9221  = ~Проверочное Описание~
@9222  = ~Место горя~
@9223  = ~0100dab1~
@9224  = ~Дух внезапно обращает на тебя внимание. Он дружески, обезоруживающе улыбается, все швы на губах при этом расходятся. Удивлённый, он касается губ рукой, пожимает плечами и кивает в знак приветствия: «Где… где я? Такое странное место. Мы знакомы?» Он деликатно откашливается, потирая окоченевшую шею.~
@9225  = ~Все дружеские манеры духа тут же пропадают. Он секунду хмуро смотрит на тебя, обрывки швов лохмотьями свисают с его серых, сморщенных губ: «Хорошо, спрашивай, что хотел». Он с нескрываемой скукой смотрит вдаль.~
@9226  = ~«Меня звали Асонье. Могу я удалиться?»~
@9227  = ~«Не припомню. Ещё что-нибудь?»~
@9228  = ~Дух пожимает плечами и поднимает глаза вверх. «Не могу сказать. В любом случае какое это имеет значение?» — он скорбно поджимает губы и одаривает тебя пристальным взглядом. В его глазах горит призрачный свет и глубоко запрятанный гнев. «Тебе ещё что-нибудь нужно от меня?»~
@9229  = ~«Мой дух обитает в Арборее… — он на миг замолкает. — И сейчас я жажду вернуться туда, в свой дом, подальше от твоего эгоистичного, невежливого и довольно надоедливого любопытства. Так я могу удалиться?»~
@9230  = ~Дух раздражённо смотрит на тебя: «Ничего, конечно!» Он недовольно качает головой, обрывки швов при этом раскачиваются.~
@9231  = ~«Нет», — кажется, дух обращает на тебя всё меньше внимания.~
@9232  = ~Дух громко вздыхает, наполняя воздух запахом формалина: «Да, да… спрашивай».~
@9233  = ~«Твои догадки будут ничуть не хуже моих, невзрачный. Пожалуй, я пойду, с твоего позволения».~
@9234  = ~Он какое-то время обдумывает твои слова, затем разражается смехом: «Да! В этом был бы смысл, не так ли? А мы знакомы?» Он склоняет голову набок и с интересом смотрит на тебя. Похоже, для него всё это забавная игра.~
@9235  = ~Дух пожимает плечами и улыбается с лёгким смешком: «Наверно, ты прав! О чём же ты хотел у меня спросить?» Он с отсутствующим видом выдирает обрывки швов из губ и бросая нитки на пол, одну за другой.~
@9236  = ~«Меня звали Асонье. А тебя как зовут?»~
@9237  = ~«Я из многих мест! По правде говоря, я не знаю, откуда родом. При жизни я с удовольствием путешествовал и называл домом многие места. Теперь же предо мной лежит вся Арборея…» — дух так и лучится счастьем.~
@9238  = ~Улыбка духа угасает, и на мгновение он выглядит озадаченным. «Странно… не знаю! На самом деле я не помню, как умер», — он пожимает плечами. «Неважно!» — он опять расцветает улыбкой, удивительно яркой для высохшего лица зомби.~
@9239  = ~«Арборея! Более чудесного места я и пожелать не мог. Нигде в своей смертной жизни я не встречал места, в которое бы так влюбился… столь прекрасного… — на некоторое время он умолкает, погружённый в приятные мысли. — Красота земель, народа — просто изумительна. Правду тебе скажу, я уже рвусь обратно!»~
@9240  = ~«Не так много. Я подписал договор с Пыльной просто из прихоти… она показала мне на это кошмарное строение и сказала, что моё тело после смерти будет оживлено и из него сделают рабочего. Я подумал: зачем оно мне в следующей жизни — так почему бы и нет? А это серебро можно потратить на женщин и вино!» — он приходит в восторг от этой мысли, и призрачный свет в его глазах радостно вспыхивает.~
@9241  = ~Дух на секунду задумывается: «Нет, боюсь, я никогда о нём не слышал. Он твой друг?»~
@9242  = ~Он выглядит удивлённым: «Как странно! Жаль, правда. Но я же должен *как-то* звать тебя, нет?» Дух выжидательно смотрит на тебя.~
@9243  = ~«Конечно. Спрашивай!» — он любезно улыбается, с интересом ожидая вопроса. Теперь он оборвал уже все нитки, и его улыбка выглядит не так дико.~
@9244  = ~Дух, чувствуя твою неудовлетворённость, сердечно смеётся: «Бедняжка! Значит пусть будет Адан, друг. Ты хотел меня о чём-то спросить?»~
@9245  = ~«Что, Сигиле?» Ты киваешь в ответ, и улыбка на лице трупа становится ещё шире: «О, не буду портить тебе удовольствие! Иди и сам познакомься с ним! Затеряйся среди улиц, забегаловок, толп народа… но осторожно! Это место не только удивительное, но и опасное. Но так даже интереснее, да?»~
@9246  = ~Оставить дух в покое.~
@9247  = ~«Вопросы здесь задаю *я*, дух».~
@9248  = ~«Ты… то бишь твои останки… в морге».~
@9249  = ~«Нет, не думаю, чтобы мы были знакомы. Я хотел спросить тебя…»~
@9250  = ~«Сомнительно. Прощай».~
@9251  = ~«Кто ты?»~
@9252  = ~«Откуда ты?»~
@9253  = ~«Как ты попал сюда? В смысле, в виде зомби».~
@9254  = ~«Где ты… то есть где сейчас пребывает… твой дух?»~
@9255  = ~«Что ты знаешь об этом месте?»~
@9256  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@9257  = ~«Ничего, неважно».~
@9258  = ~«Нет, я хотел спросить о другом…»~
@9259  = ~«Это всё, что я хотел узнать. Прощай».~
@9260  = ~«Да, я хотел спросить о другом…»~
@9261  = ~«Это всё, что я хотел узнать. Прощай».~
@9262  = ~«Да, я хотел спросить о другом…»~
@9263  = ~«Это всё, что я хотел узнать. Прощай».~
@9264  = ~«Нет, я хотел спросить о другом…»~
@9265  = ~«Да, иди. Прощай».~
@9266  = ~«Тогда как твой труп оказался здесь, в качестве чернорабочего в этих унылых залах?»~
@9267  = ~«Я хочу спросить о другом…»~
@9268  = ~«Это всё, что я хотел узнать. Прощай».~
@9269  = ~«Тогда я хочу спросить о другом…»~
@9270  = ~«Это всё, что я хотел узнать. Прощай».~
@9271  = ~«Кто ты?»~
@9272  = ~«Откуда ты?»~
@9273  = ~«Как ты попал сюда? В смысле, в виде зомби».~
@9274  = ~«Где ты… то есть где сейчас пребывает… твой дух?»~
@9275  = ~«Что ты знаешь об этом месте?»~
@9276  = ~«Не знаешь кого-нибудь по имени Фарод?»~
@9277  = ~«Неважно, забудь».~
@9278  = ~«Нет, я хотел спросить о другом…»~
@9279  = ~«Это всё, что я хотел узнать. Прощай».~
@9280  = ~«Нет, не думаю, чтобы мы были знакомы. Я хотел спросить тебя…»~
@9281  = ~«Сомнительно. Прощай».~
@9282  = ~«Кто ты?»~
